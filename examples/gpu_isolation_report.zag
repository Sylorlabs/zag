// Reports whether a Linux DRM PCI device is a distinct reset/fault domain.
// Usage: ./znc examples/gpu_isolation_report.zag -o /tmp/gpu-isolation
//        /tmp/gpu-isolation /sys/class/drm/card1/device
// Exit 0 means destructive-test isolation was proved; exit 2 means it was not.

@import("../std/linux_gpu_isolation.zag")

fn print_bool(name_: []u8, value: bool) void {
    _zag_print(name_);
    if (value) { _zag_println("yes"); } else { _zag_println("no"); }
}

fn main() i32 {
    if (_zag_argc() != 2) {
        _zag_println("usage: gpu-isolation <PCI-device-sysfs-root>");
        return 64;
    }
    let result: LinuxGpuIsolation = linux_gpu_isolation_probe(_zag_arg(1));
    _zag_print("classification: ");
    _zag_println(linux_gpu_isolation_name(result.level));
    print_bool("device-is-vf: ",result.device_is_vf);
    print_bool("iommu-group: ",result.iommu_group);
    print_bool("flr-reset: ",result.flr_reset);
    print_bool("process-cleaner: ",result.process_cleaner);
    print_bool("partition-controls: ",result.partition_controls);
    print_bool("destructive-test-safe: ",result.destructive_test_safe);
    if (result.destructive_test_safe) { return 0; }
    return 2;
}
