// std/opencl_loader.zag — pure-Zag FFI adapter to the system OpenCL loader.
//
// STATUS: NOT RUNTIME-VERIFIED. The dispatch logic and FFI declarations are
// written, but available() returns false and no C test harness exists. This
// file uses `type` aliases and `[N]T` array syntax that the current Zag parser
// does not accept — it is documentation/reference code, not compilable Zag.
//
// A contributor with a working OpenCL ICD is needed to:
//   1. Write a C runtime test harness (like tests/vulkan_runtime_test.c)
//   2. Hook up available() to actually probe for libOpenCL.so.1
//   3. Run the SPIR-V kernel and verify output
//
// See docs/V2_TARGET_SUPPORT.md for the contributor call.
//
// This is the compatibility-tier runtime adapter for opencl-compat. It loads
// libOpenCL.so.1 (or platform equivalent) via @cabi extern declarations and
// creates a minimal OpenCL context, command queue, buffer, and program to
// submit a SPIR-V compute kernel with bounded dispatch dimensions, then reads
// back results.
//
// This module is NON-CERTIFIED. It uses CompatLoad and CompatDispatch effects
// and is forbidden in @kernel, @realtime, and @pure functions. It is a
// fallback below native and virtual execution, and below vulkan-compat.
//
// OpenCL 2.x supports SPIR-V as an intermediate format via
// clCreateProgramWithIL. However, not all OpenCL implementations support IL
// upload — notably NVIDIA's OpenCL 3.0 driver does NOT implement
// clCreateProgramWithIL (returns CL_INVALID_OPERATION). The loader probes
// CL_DEVICE_IL_VERSION before attempting IL upload and falls back to source
// compilation if IL is unavailable.
//
// The SPIR-V binary emitted by the opencl-compat encoder uses Kernel
// capability (not Shader), Physical64 addressing, and OpenCL memory model —
// it is distinct from the vulkan-compat SPIR-V binary.

// ── OpenCL type aliases ─────────────────────────────────────────────────────
type cl_platform_id = *u8;
type cl_device_id = *u8;
type cl_context = *u8;
type cl_command_queue = *u8;
type cl_program = *u8;
type cl_kernel = *u8;
type cl_mem = *u8;
type cl_event = *u8;

// OpenCL result codes (subset)
fn cl_success() i32 { return 0; }
fn cl_invalid_value() i32 { return -30; }
fn cl_invalid_operation() i32 { return -59; }
fn cl_out_of_host_memory() i32 { return -6; }
fn cl_out_of_resources() i32 { return -5; }
fn cl_build_program_failure() i32 { return -11; }

// OpenCL device info queries (subset)
fn cl_device_il_version() u32 { return 4146; }   // CL_DEVICE_IL_VERSION (OpenCL 2.1+)
fn cl_device_version() u32 { return 4143; }       // CL_DEVICE_VERSION
fn cl_device_address_bits() u32 { return 4142; }  // CL_DEVICE_ADDRESS_BITS

// OpenCL device types
fn cl_device_type_default() u64 { return 1; }
fn cl_device_type_cpu() u64 { return 2; }
fn cl_device_type_gpu() u64 { return 4; }
fn cl_device_type_accelerator() u64 { return 8; }
fn cl_device_type_all() u64 { return 0xFFFFFFFF; }

// ── OpenCL loader extern declarations ───────────────────────────────────────
// These are resolved at link time via --dynamic --needed libOpenCL.so.1.
// Only the subset needed for bounded compute dispatch is declared.

extern fn clGetPlatformIDs(num_entries: u32, platforms: *cl_platform_id, num_platforms: *u32) i32 @cabi;
extern fn clGetDeviceIDs(platform: cl_platform_id, device_type: u64, num_entries: u32, devices: *cl_device_id, num_devices: *u32) i32 @cabi;
extern fn clGetDeviceInfo(device: cl_device_id, param_name: u32, param_value_size: u64, param_value: *u8, param_value_size_ret: *u64) i32 @cabi;
extern fn clCreateContext(properties: *u8, num_devices: u32, devices: *cl_device_id, pfn_notify: *u8, user_data: *u8, errcode_ret: *i32) cl_context @cabi;
extern fn clReleaseContext(context: cl_context) i32 @cabi;
extern fn clCreateCommandQueueWithProperties(context: cl_context, device: cl_device_id, properties: *u8, errcode_ret: *i32) cl_command_queue @cabi;
extern fn clReleaseCommandQueue(command_queue: cl_command_queue) i32 @cabi;
extern fn clCreateBuffer(context: cl_context, flags: u64, size: u64, host_ptr: *u8, errcode_ret: *i32) cl_mem @cabi;
extern fn clReleaseMemObject(memobj: cl_mem) i32 @cabi;
extern fn clCreateProgramWithIL(context: cl_context, il: *u8, length: u64, errcode_ret: *i32) cl_program @cabi;
extern fn clCreateProgramWithSource(context: cl_context, count: u32, strings: *[]u8, lengths: *u64, errcode_ret: *i32) cl_program @cabi;
extern fn clBuildProgram(program: cl_program, num_devices: u32, device_list: *cl_device_id, options: *u8, pfn_notify: *u8, user_data: *u8) i32 @cabi;
extern fn clReleaseProgram(program: cl_program) i32 @cabi;
extern fn clCreateKernel(program: cl_program, kernel_name: *u8, errcode_ret: *i32) cl_kernel @cabi;
extern fn clReleaseKernel(kernel: cl_kernel) i32 @cabi;
extern fn clSetKernelArg(kernel: cl_kernel, arg_index: u32, arg_size: u64, arg_value: *u8) i32 @cabi;
extern fn clEnqueueNDRangeKernel(command_queue: cl_command_queue, kernel: cl_kernel, work_dim: u32, global_work_offset: *u64, global_work_size: *u64, local_work_size: *u64, num_events: u32, event_wait_list: *cl_event, event: *cl_event) i32 @cabi;
extern fn clEnqueueReadBuffer(command_queue: cl_command_queue, buffer: cl_mem, blocking_read: u32, offset: u64, size: u64, ptr: *u8, num_events: u32, event_wait_list: *cl_event, event: *cl_event) i32 @cabi;
extern fn clEnqueueWaitForEvents(command_queue: cl_command_queue, num_events: u32, event_list: *cl_event) i32 @cabi;
extern fn clFinish(command_queue: cl_command_queue) i32 @cabi;
extern fn clReleaseEvent(event: cl_event) i32 @cabi;

// OpenCL buffer flags
fn cl_mem_read_write() u64 { return 1; }
fn cl_mem_write_only() u64 { return 2; }
fn cl_mem_read_only() u64 { return 4; }
fn cl_mem_use_host_ptr() u64 { return 8; }
fn cl_mem_alloc_host_ptr() u64 { return 16; }
fn cl_mem_copy_host_ptr() u64 { return 32; }

// ── OpenCL compat context ───────────────────────────────────────────────────
struct ZagOpenCLCompatContext {
    platform: cl_platform_id,
    device: cl_device_id,
    context: cl_context,
    queue: cl_command_queue,
    available: bool,
    il_supported: bool,    // true if clCreateProgramWithIL is available
    address_bits: u32,     // 32 or 64, determines Physical32 vs Physical64
    error_code: i32,
    error_msg: [128]u8,
}

// Opens a minimal OpenCL compute context. Returns a context with
// available=true if a GPU device was found. Probes CL_DEVICE_IL_VERSION
// to determine whether SPIR-V IL upload is supported (NVIDIA's OpenCL 3.0
// driver does not implement clCreateProgramWithIL). Also queries
// CL_DEVICE_ADDRESS_BITS to select Physical32 vs Physical64 addressing.
fn zag_opencl_compat_open() ZagOpenCLCompatContext @compatLoad {
    let ctx: ZagOpenCLCompatContext = ZagOpenCLCompatContext{
        .platform = null as cl_platform_id,
        .device = null as cl_device_id,
        .context = null as cl_context,
        .queue = null as cl_command_queue,
        .available = false,
        .il_supported = false,
        .address_bits = 64,
        .error_code = 0,
        .error_msg = [128]u8{0},
    };
    // Get first platform.
    let plat_count: u32 = 0;
    let rc: i32 = clGetPlatformIDs(0, null as *cl_platform_id, &plat_count);
    if (rc != cl_success() || plat_count == 0) {
        ctx.error_code = -100;
        return ctx;
    }
    let plat: cl_platform_id = null as cl_platform_id;
    rc = clGetPlatformIDs(1, &plat, null as *u32);
    if (rc != cl_success()) {
        ctx.error_code = -101;
        return ctx;
    }
    ctx.platform = plat;
    // Get first GPU device.
    let dev_count: u32 = 0;
    rc = clGetDeviceIDs(plat, cl_device_type_gpu(), 0, null as *cl_device_id, &dev_count);
    if (rc != cl_success() || dev_count == 0) {
        ctx.error_code = -102;
        return ctx;
    }
    let dev: cl_device_id = null as cl_device_id;
    rc = clGetDeviceIDs(plat, cl_device_type_gpu(), 1, &dev, null as *u32);
    if (rc != cl_success()) {
        ctx.error_code = -103;
        return ctx;
    }
    ctx.device = dev;
    // Query CL_DEVICE_ADDRESS_BITS to select Physical32 vs Physical64.
    let addr_bits: u32 = 64;
    let addr_ret: u64 = 0;
    rc = clGetDeviceInfo(dev, cl_device_address_bits(), 4, &addr_bits as *u8, &addr_ret);
    if (rc == cl_success() && (addr_bits == 32 || addr_bits == 64)) {
        ctx.address_bits = addr_bits;
    }
    // Query CL_DEVICE_IL_VERSION to check if SPIR-V IL upload is supported.
    // If this query fails (e.g., OpenCL 1.x or NVIDIA's incomplete 3.0),
    // il_supported stays false and the loader falls back to source compilation.
    let il_buf: [256]u8 = [256]u8{0};
    let il_ret: u64 = 0;
    rc = clGetDeviceInfo(dev, cl_device_il_version(), 256, &il_buf[0] as *u8, &il_ret);
    if (rc == cl_success() && il_ret > 0) {
        // Check if the IL version string contains "SPIR-V"
        let i: u32 = 0;
        let found_spirv: bool = false;
        while (i + 6 < il_ret) {
            if (il_buf[i] == 'S' && il_buf[i + 1] == 'P' && il_buf[i + 2] == 'I' &&
                il_buf[i + 3] == 'R' && il_buf[i + 4] == '-' && il_buf[i + 5] == 'V') {
                found_spirv = true;
            }
            i = i + 1;
        }
        ctx.il_supported = found_spirv;
    }
    // Create context.
    let err: i32 = 0;
    ctx.context = clCreateContext(null as *u8, 1, &dev, null as *u8, null as *u8, &err);
    if (err != cl_success()) {
        ctx.error_code = err;
        return ctx;
    }
    // Create command queue.
    ctx.queue = clCreateCommandQueueWithProperties(ctx.context, dev, null as *u8, &err);
    if (err != cl_success()) {
        ctx.error_code = err;
        clReleaseContext(ctx.context);
        ctx.context = null as cl_context;
        return ctx;
    }
    ctx.available = true;
    return ctx;
}

// Closes an OpenCL compat context and releases all resources.
fn zag_opencl_compat_close(ctx: *ZagOpenCLCompatContext) void @compatLoad {
    if (ctx.queue != null as cl_command_queue) {
        clReleaseCommandQueue(ctx.queue);
        ctx.queue = null as cl_command_queue;
    }
    if (ctx.context != null as cl_context) {
        clReleaseContext(ctx.context);
        ctx.context = null as cl_context;
    }
    ctx.available = false;
}

// Dispatches a SPIR-V compute kernel via OpenCL.
// If ctx.il_supported is true, creates a program from SPIR-V IL via
// clCreateProgramWithIL. If IL is not supported (e.g., NVIDIA OpenCL 3.0),
// falls back to clCreateProgramWithSource with an OpenCL C source string.
// Creates a kernel, sets arguments, enqueues a bounded NDRange, and reads
// back results.
// Returns cl_success() (0) on success, a negative OpenCL result code on error.
fn zag_opencl_compat_dispatch(
    ctx: *ZagOpenCLCompatContext,
    spirv_code: *u8,
    spirv_size: u64,
    opencl_source: *u8,       // fallback OpenCL C source (used if IL unsupported)
    opencl_source_len: u64,
    kernel_name: *u8,
    output_buffer: *i32,
    output_count: u32,
    value: i32,
    count: i32,
    global_work_size: u64,
    local_work_size: u64,
    timeout_ns: u64,
) i32 @compatDispatch {
    if (!ctx.available) { return -200; }
    // Create program: IL if supported, source as fallback.
    let err: i32 = 0;
    let program: cl_program = null as cl_program;
    if (ctx.il_supported) {
        program = clCreateProgramWithIL(ctx.context, spirv_code, spirv_size, &err);
        if (err != cl_success()) {
            // IL upload failed despite the device reporting support —
            // fall through to source compilation.
            program = null as cl_program;
        }
    }
    if (program == null as cl_program && opencl_source != null as *u8) {
        // Fallback: compile from OpenCL C source.
        let srcs: [1][]u8 = [1][]u8{opencl_source[0:opencl_source_len]};
        let lens: [1]u64 = [1]u64{opencl_source_len};
        program = clCreateProgramWithSource(ctx.context, 1, &srcs[0], &lens[0], &err);
        if (err != cl_success()) { return err; }
    }
    if (program == null as cl_program) { return -202; } // no IL and no source
    // Build the program.
    let build_rc: i32 = clBuildProgram(program, 1, &ctx.device, null as *u8, null as *u8, null as *u8);
    if (build_rc != cl_success()) {
        clReleaseProgram(program);
        return build_rc;
    }
    // Create kernel.
    let kernel: cl_kernel = clCreateKernel(program, kernel_name, &err);
    if (err != cl_success()) {
        clReleaseProgram(program);
        return err;
    }
    // Create output buffer.
    let buf_size: u64 = (output_count as u64) * 4;
    let out_mem: cl_mem = clCreateBuffer(ctx.context, cl_mem_read_write() | cl_mem_copy_host_ptr(), buf_size, output_buffer as *u8, &err);
    if (err != cl_success()) {
        clReleaseKernel(kernel);
        clReleaseProgram(program);
        return err;
    }
    // Set kernel arguments: out (pointer), value (i32), count (i32).
    let arg_rc: i32 = clSetKernelArg(kernel, 0, 8, &out_mem as *u8);
    if (arg_rc != cl_success()) { clReleaseMemObject(out_mem); clReleaseKernel(kernel); clReleaseProgram(program); return arg_rc; }
    arg_rc = clSetKernelArg(kernel, 1, 4, &value as *u8);
    if (arg_rc != cl_success()) { clReleaseMemObject(out_mem); clReleaseKernel(kernel); clReleaseProgram(program); return arg_rc; }
    arg_rc = clSetKernelArg(kernel, 2, 4, &count as *u8);
    if (arg_rc != cl_success()) { clReleaseMemObject(out_mem); clReleaseKernel(kernel); clReleaseProgram(program); return arg_rc; }
    // Enqueue NDRange kernel.
    let gws: u64 = global_work_size;
    let lws: u64 = local_work_size;
    let enq_rc: i32 = clEnqueueNDRangeKernel(ctx.queue, kernel, 1, null as *u64, &gws, &lws, 0, null as *cl_event, null as *cl_event);
    if (enq_rc != cl_success()) { clReleaseMemObject(out_mem); clReleaseKernel(kernel); clReleaseProgram(program); return enq_rc; }
    // Wait for completion.
    let finish_rc: i32 = clFinish(ctx.queue);
    if (finish_rc != cl_success()) { clReleaseMemObject(out_mem); clReleaseKernel(kernel); clReleaseProgram(program); return finish_rc; }
    // Read back results.
    let read_rc: i32 = clEnqueueReadBuffer(ctx.queue, out_mem, 1, 0, buf_size, output_buffer as *u8, 0, null as *cl_event, null as *cl_event);
    // Cleanup.
    clReleaseMemObject(out_mem);
    clReleaseKernel(kernel);
    clReleaseProgram(program);
    return read_rc;
}

// Checks if the OpenCL loader is available on the current system.
fn zag_opencl_compat_available() bool @compatLoad {
    // A full implementation would attempt to load libOpenCL.so.1 and
    // call clGetPlatformIDs. For now, return false.
    return false;
}
