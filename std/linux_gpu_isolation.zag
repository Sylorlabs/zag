// linux_gpu_isolation.zag — fail-closed Linux GPU isolation discovery.
//
// A render-node context or GPUVM protects address spaces, but it is not a
// separate reset/fault domain. A virtual CRTC is also not a virtual GPU. This
// module reads kernel-owned sysfs evidence and only reports destructive-test
// isolation when an active SR-IOV VF, an IOMMU group, and FLR reset support are
// all visible. Consumers must keep submission disabled for every weaker level.

@import("rt.zag")

fn gpu_isolation_none() i32 { return 0; }
fn gpu_isolation_process_clean() i32 { return 1; }
fn gpu_isolation_partition_controls() i32 { return 2; }
fn gpu_isolation_active_vf() i32 { return 3; }
fn gpu_isolation_reset_domain() i32 { return 4; }

struct LinuxGpuIsolation {
    sriov_total_vfs: i64,
    sriov_active_vfs: i64,
    device_is_vf: bool,
    iommu_group: bool,
    flr_reset: bool,
    process_cleaner: bool,
    partition_controls: bool,
    level: i32,
    destructive_test_safe: bool,
}

fn gpu_iso_path(root: []u8, leaf: []u8) []u8 {
    let mid: []u8 = _zag_str_concat(root, "/");
    let out: []u8 = _zag_str_concat(mid, leaf);
    _zag_str_free(mid);
    return out;
}

fn gpu_iso_exists(root: []u8, leaf: []u8) bool {
    let p: []u8 = gpu_iso_path(root,leaf);
    let r: bool = _zag_file_exists(p) == 1;
    _zag_str_free(p);
    return r;
}

fn gpu_iso_int(root: []u8, leaf: []u8) i64 {
    let p: []u8 = gpu_iso_path(root,leaf);
    let raw: []u8 = _zag_read_file(p);
    _zag_str_free(p);
    if (raw.len <= 0) { return 0; }
    return _zag_str_to_i64(raw);
}

fn gpu_iso_contains(s: []u8, needle: []u8) bool {
    if (needle.len == 0) { return true; }
    let i: i32 = 0;
    while (i + needle.len <= s.len) {
        let equal: bool = true;
        let j: i32 = 0;
        while (j < needle.len) {
            if (s[i+j] != needle[j]) { equal = false; }
            j = j + 1;
        }
        if (equal) { return true; }
        i = i + 1;
    }
    return false;
}

fn linux_gpu_isolation_probe(root: []u8) LinuxGpuIsolation {
    let total: i64 = gpu_iso_int(root,"sriov_totalvfs");
    let active: i64 = gpu_iso_int(root,"sriov_numvfs");
    let is_vf: bool = gpu_iso_exists(root,"physfn");
    let iommu: bool = gpu_iso_exists(root,"iommu_group");
    let reset_path: []u8 = gpu_iso_path(root,"reset_method");
    let reset: []u8 = _zag_read_file(reset_path);
    _zag_str_free(reset_path);
    let flr: bool = reset.len > 0 && gpu_iso_contains(reset,"flr");
    let cleaner: bool = gpu_iso_int(root,"enforce_isolation") > 0 &&
        gpu_iso_exists(root,"run_cleaner_shader");
    let partitions: bool = gpu_iso_exists(root,"current_compute_partition") ||
        gpu_iso_exists(root,"available_compute_partition") ||
        gpu_iso_exists(root,"current_memory_partition") ||
        gpu_iso_exists(root,"available_memory_partition");
    let level: i32 = gpu_isolation_none();
    if (cleaner) { level = gpu_isolation_process_clean(); }
    if (partitions) { level = gpu_isolation_partition_controls(); }
    if (is_vf) { level = gpu_isolation_active_vf(); }
    let safe: bool = is_vf && iommu && flr;
    if (safe) { level = gpu_isolation_reset_domain(); }
    return LinuxGpuIsolation{
        .sriov_total_vfs=total, .sriov_active_vfs=active, .device_is_vf=is_vf,
        .iommu_group=iommu, .flr_reset=flr,
        .process_cleaner=cleaner, .partition_controls=partitions,
        .level=level, .destructive_test_safe=safe,
    };
}

fn linux_gpu_isolation_name(level: i32) []u8 {
    if (level == gpu_isolation_process_clean()) { return "process-cleaner-only"; }
    if (level == gpu_isolation_partition_controls()) { return "partition-controls-only"; }
    if (level == gpu_isolation_active_vf()) { return "active-vf-unproven-reset"; }
    if (level == gpu_isolation_reset_domain()) { return "vf-iommu-flr-reset-domain"; }
    return "shared-device-no-fault-isolation";
}
