// Bounded Zag Script text input. The returned bytes live in ScriptContext and
// are reclaimed by the generated Script shutdown boundary.

extern fn _zag_read_fd(fd:i64,buf:*i8,n:i64)i64
extern fn _zag_print(text:[]u8)void

fn script_input(context:*opaque,prompt:[]u8)[]u8 {
    _zag_print(prompt);
    let capacity:i32=4096;
    let raw:*i8=_zag_script_alloc(context,capacity as i64);
    if(raw==null as *i8){_zag_eprintln("Zag Script memory limit exceeded by input");return raw[0..0];}
    let count:i64=_zag_read_fd(0,raw,capacity as i64);
    if(count<=0){return raw[0..0];}
    let used:i32=count as i32;
    while(used>0&&(raw[used-1]==10||raw[used-1]==13)){used=used-1;}
    return raw[0..used];
}
