// Root-only Zag Script file convenience. A regular file is sized first, then
// read directly into ScriptContext-owned storage. The native bridge allocates
// only a bounded NUL path (at most Linux PATH_MAX), never a second full-file
// staging buffer. Strict Zag continues to call `_zag_read_file` directly and is
// unaffected.

fn script_read_file(context: *opaque, path: []u8) []u8 {
    if (path.len < 0 || path.len > 4096) {
        _zag_eprintln("Zag Script read_file path exceeds the bounded Linux path limit");
        return (null as *i8)[0..(0 - 1)];
    }
    let size: i64 = _zag_script_file_size(path);
    if (size < 0) {
        return (null as *i8)[0..(0 - 1)];
    }
    if (size > 2147483647) {
        _zag_eprintln("Zag Script read_file result exceeds the maximum slice length");
        return (null as *i8)[0..0];
    }
    let raw: *i8 = _zag_script_alloc(context, size);
    if (raw == null as *i8) {
        _zag_eprintln("Zag Script memory limit exceeded by read_file result");
        return (null as *i8)[0..0];
    }
    let read_count: i64 = _zag_script_read_file_into(path, raw, size);
    if (read_count == 0 - 2) {
        _zag_eprintln("Zag Script read_file source changed or grew during the bounded read");
        return (null as *i8)[0..0];
    }
    if (read_count < 0) {
        _zag_eprintln("Zag Script read_file failed after size preflight");
        return (null as *i8)[0..(0 - 1)];
    }
    return raw[0..read_count as i32];
}
