// Native macOS/Apple-Silicon live-reload runtime.
//
// This is deliberately separate from hot_rt.zag: it uses Mach-O PIE image
// discovery, Darwin mprotect/nanosleep syscalls, 16 KiB ARM64 pages, and the
// documented libSystem instruction-cache invalidation API. No ELF address,
// Linux syscall number, or emulation path is shared with this implementation.

extern fn _zag_darwin_syscall(num:i64,a1:i64,a2:i64,a3:i64,a4:i64,a5:i64,a6:i64)i64
extern fn _zag_code_anchor() i64
extern fn _zag_slice_ptr(s:[]u8)*i8
extern fn _zag_read_file(path:[]u8)[]u8
extern fn _zag_write_file(path:[]u8,content:[]u8)i32
extern fn _zag_file_exists(path:[]u8)i32
extern fn sys_icache_invalidate(start:*i8,len:i64) void

fn HM_PAGE()i64{return 16384;}
fn HM_CODE_OFF()i64{return 4096;}
fn HM_PATCH()[]u8{return ".zag_hotpatch";}
fn HM_STOP()[]u8{return ".zag_hotstop";}

struct HMTimespec { sec:i64, nsec:i64 }

// Scan backwards from an ADR-derived executable address to the mapped Mach-O
// header. `feedfacf` is little-endian as cf fa ed fe in memory.  The loader
// slide is therefore discovered from the live process, not guessed.
fn hm_image_base()i64{
    let p:i64=_zag_code_anchor();
    p=p-(p%HM_PAGE());
    while(p>=HM_PAGE()){
        let b:*u8=p as *u8;
        if(b[0]==207 as u8&&b[1]==250 as u8&&b[2]==237 as u8&&b[3]==254 as u8){return p;}
        p=p-HM_PAGE();
    }
    return 0;
}

fn hm_sleep(ms:i64)void{
    let ts:HMTimespec=HMTimespec{.sec=ms/1000,.nsec=(ms%1000)*1000000};
    let _rc:i64=_zag_darwin_syscall(240,(&ts) as i64,0,0,0,0,0);
}

fn hm_apply(code:[]u8)i32{
    let n:i64=code.len as i64;
    let image:i64=hm_image_base();
    if(image==0||n<=0){return 0;}
    let span:i64=HM_CODE_OFF()+n;
    let pages:i64=((span+HM_PAGE()-1)/HM_PAGE())*HM_PAGE();
    // SYS_mprotect is 74 on Darwin; W^X is opened only for the replacement.
    if(_zag_darwin_syscall(74,image,pages,7,0,0,0)!=0){return 0;}
    let text:*i8=(image+HM_CODE_OFF()) as *i8;
    // Keep the copy in Zag so this runtime has no libc memcpy dependency and
    // can be emitted by the self-contained Mach-O backend.
    let src:*i8=_zag_slice_ptr(code);
    let i:i32=0;
    while(i<n as i32){text[i]=src[i];i=i+1;}
    sys_icache_invalidate(text,n);
    if(_zag_darwin_syscall(74,image,pages,5,0,0,0)!=0){return 0;}
    return 1;
}

fn zag_hot_poll()i32{
    if(_zag_file_exists(HM_PATCH())==0){return 0;}
    let patch:[]u8=_zag_read_file(HM_PATCH());
    if(patch.len<=0){return 0;}
    let ok:i32=hm_apply(patch);
    let _consumed:i32=_zag_write_file(HM_PATCH(),"");
    return ok;
}

fn zag_hot_should_continue()bool{return _zag_file_exists(HM_STOP())==0;}
fn zag_hot_wait()void{let _applied:i32=zag_hot_poll();hm_sleep(200);}
