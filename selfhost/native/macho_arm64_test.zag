// Pure-Zag regression for the SHA-256 implementation used by Mach-O signing.

@import("link/macho_arm64.zag")

fn main() i32 {
    let h: ArrayList[u8] = macho_sha256("abc");
    if (h.len != 32) { return 1; }
    let expected: ArrayList[u8] = make[u8](32);
    push[u8](&expected,186); push[u8](&expected,120); push[u8](&expected,22);  push[u8](&expected,191);
    push[u8](&expected,143); push[u8](&expected,1);   push[u8](&expected,207); push[u8](&expected,234);
    push[u8](&expected,65);  push[u8](&expected,65);  push[u8](&expected,64);  push[u8](&expected,222);
    push[u8](&expected,93);  push[u8](&expected,174); push[u8](&expected,34);  push[u8](&expected,35);
    push[u8](&expected,176); push[u8](&expected,3);   push[u8](&expected,97);  push[u8](&expected,163);
    push[u8](&expected,150); push[u8](&expected,23);  push[u8](&expected,122); push[u8](&expected,156);
    push[u8](&expected,180); push[u8](&expected,16);  push[u8](&expected,255); push[u8](&expected,97);
    push[u8](&expected,242); push[u8](&expected,0);   push[u8](&expected,21);  push[u8](&expected,173);
    let i: i32 = 0;
    while (i < 32) {
        if (get[u8](h, i) != get[u8](expected, i)) { return i + 2; }
        i = i + 1;
    }
    return 0;
}
