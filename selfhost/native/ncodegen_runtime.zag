// selfhost/native/ncodegen_runtime.zag — RUNTIME DETECTION for the native
// codegen. Extracted from ncodegen.zag for modularity.
//
// Contains: posit-usage, sat/fixed-usage, and rns-usage detection functions
// that drive the automatic inclusion of numeric runtime sources. These depend
// on type predicates (cg_is_posit_ty, cg_is_quire_ty, cg_is_sat_ty, etc.) from
// ncodegen_types.zag, and on builtin function mappers (cg_posit_builtin_fn,
// cg_quire_builtin_fn) and cg_norm_type which remain in ncodegen.zag.

@import("isa.zag")
@import("../parse.zag")   // AST (Node/Param/Bin/Call/FnDecl/...) + ArrayList + @strEq + _zag_str_to_i64
@import("ncodegen_types.zag")   // cg_is_posit_ty, cg_is_quire_ty, cg_is_sat_ty, cg_is_fixed_ty, cg_is_rns_ty, cg_norm_type

// ── posit-usage detection (drives the runtime auto-include) ──────────────────
// True iff a type STRING denotes a posit type (possibly behind a leading '*').
fn cg_ty_is_posit(t: []u8) i32 {
    let s: []u8 = t;
    if (s.len > 1) { if (s[0] == '*') { s = s[1..]; } }
    if (cg_is_posit_ty(s) == 1) { return 1; }
    // ROUND 3: a quire is a posit accumulator — its runtime lives in (and reuses)
    // the posit source, so quire usage must pull in the posit+quire include too.
    if (cg_is_quire_ty(s) == 1) { return 1; }
    return 0;
}
// True iff an EXPRESSION subtree references a posit @-builtin (call callee) — the
// shallow signal that a program uses posits even without a `: pN` annotation.
fn cg_expr_uses_posit(n: *Node) i32 {
    switch (n.*) {
        .call => |c| {
            switch (c.callee.*) {
                .id => |cid| {
                    if (cid.name.len > 1) {
                        if (cid.name[0] == '@') {
                            if (cg_posit_builtin_fn(cid.name[1..]).len > 0) { return 1; }
                            // ROUND 3: a quire builtin (@quireZero/FMA/ToPosit) also
                            // needs the posit+quire runtime.
                            if (cg_quire_builtin_fn(cid.name[1..]).len > 0) { return 1; }
                        }
                    }
                }
                else => { }
            }
            let i: i32 = 0;
            while (i < len[*Node](c.args)) {
                if (cg_expr_uses_posit(get[*Node](c.args, i)) == 1) { return 1; }
                i = i + 1;
            }
            return 0;
        }
        .bin => |b| {
            if (cg_expr_uses_posit(b.l) == 1) { return 1; }
            if (cg_expr_uses_posit(b.r) == 1) { return 1; }
            return 0;
        }
        .un  => |u| { return cg_expr_uses_posit(u.e); }
        else => { return 0; }
    }
}
// Walk a statement body looking for a posit-typed `let` or a posit builtin call.
fn cg_body_uses_posit(body: ArrayList[*Node]) i32 {
    let i: i32 = 0;
    while (i < len[*Node](body)) {
        switch (get[*Node](body, i).*) {
            .let_   => |l| {
                if (l.has_dty == 1) { if (cg_ty_is_posit(l.dty) == 1) { return 1; } }
                if (cg_expr_uses_posit(l.expr) == 1) { return 1; }
            }
            .assign => |a| { if (cg_expr_uses_posit(a.expr) == 1) { return 1; } }
            .estmt  => |e| { if (cg_expr_uses_posit(e.expr) == 1) { return 1; } }
            .ret    => |r| { if (r.has_expr == 1) { if (cg_expr_uses_posit(r.expr) == 1) { return 1; } } }
            .if_    => |x| {
                if (cg_expr_uses_posit(x.cond) == 1) { return 1; }
                if (cg_body_uses_posit(x.then_body) == 1) { return 1; }
                if (x.has_els == 1) { if (cg_body_uses_posit(x.els_body) == 1) { return 1; } }
            }
            .while_ => |w| {
                if (cg_expr_uses_posit(w.cond) == 1) { return 1; }
                if (cg_body_uses_posit(w.body) == 1) { return 1; }
            }
            .unsafe_ => |u| { if (cg_body_uses_posit(u.body) == 1) { return 1; } }
            else => { }
        }
        i = i + 1;
    }
    return 0;
}
// True iff the whole program uses any posit feature (a posit type in a param /
// return / let, or a posit @-builtin call). The compiler's OWN source never has
// these — it only manipulates the strings "p32"/"@floatToPosit" as VALUES — so
// znc-compiling-znc never triggers the include and the fixpoint stays exact.
fn cg_decls_use_posit(decls: ArrayList[*Node]) i32 {
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                let pj: i32 = 0;
                while (pj < len[Param](f.params)) {
                    if (cg_ty_is_posit(get[Param](f.params, pj).pty) == 1) { return 1; }
                    pj = pj + 1;
                }
                if (cg_ty_is_posit(f.ret) == 1) { return 1; }
                if (f.is_extern == 0) { if (cg_body_uses_posit(f.body) == 1) { return 1; } }
            }
            else => { }
        }
        i = i + 1;
    }
    return 0;
}

// ── ROUND 2: sat/fixed-usage detection (drives the rt2 auto-include) ─────────
// True iff a type STRING denotes a SAT or FIXED scalar — possibly behind a
// leading '*' (pointer) or '[]' (slice element). Arbitrary-width uN/iN does NOT
// need the runtime (masked inline by ncodegen), so it does NOT count here.
fn cg_ty_is_satfixed(t: []u8) i32 {
    let s: []u8 = t;
    if (s.len > 1) { if (s[0] == '*') { s = s[1..]; } }
    if (s.len > 2) { if (s[0] == 91 && s[1] == 93) { s = s[2..]; } }   // "[]E" → E
    if (cg_is_sat_ty(s) == 1) { return 1; }
    if (cg_is_fixed_ty(s) == 1) { return 1; }
    return 0;
}
fn cg_expr_uses_satfixed(n: *Node) i32 {
    switch (n.*) {
        .cast_ => |c| {
            if (cg_ty_is_satfixed(cg_norm_type(c.target)) == 1) { return 1; }
            return cg_expr_uses_satfixed(c.expr);
        }
        .call => |c| {
            let i: i32 = 0;
            while (i < len[*Node](c.args)) {
                if (cg_expr_uses_satfixed(get[*Node](c.args, i)) == 1) { return 1; }
                i = i + 1;
            }
            return 0;
        }
        .bin => |b| {
            if (cg_expr_uses_satfixed(b.l) == 1) { return 1; }
            if (cg_expr_uses_satfixed(b.r) == 1) { return 1; }
            return 0;
        }
        .un  => |u| { return cg_expr_uses_satfixed(u.e); }
        else => { return 0; }
    }
}
fn cg_body_uses_satfixed(body: ArrayList[*Node]) i32 {
    let i: i32 = 0;
    while (i < len[*Node](body)) {
        switch (get[*Node](body, i).*) {
            .let_   => |l| {
                if (l.has_dty == 1) { if (cg_ty_is_satfixed(l.dty) == 1) { return 1; } }
                if (cg_expr_uses_satfixed(l.expr) == 1) { return 1; }
            }
            .assign => |a| { if (cg_expr_uses_satfixed(a.expr) == 1) { return 1; } }
            .estmt  => |e| { if (cg_expr_uses_satfixed(e.expr) == 1) { return 1; } }
            .ret    => |r| { if (r.has_expr == 1) { if (cg_expr_uses_satfixed(r.expr) == 1) { return 1; } } }
            .if_    => |x| {
                if (cg_expr_uses_satfixed(x.cond) == 1) { return 1; }
                if (cg_body_uses_satfixed(x.then_body) == 1) { return 1; }
                if (x.has_els == 1) { if (cg_body_uses_satfixed(x.els_body) == 1) { return 1; } }
            }
            .while_ => |w| {
                if (cg_expr_uses_satfixed(w.cond) == 1) { return 1; }
                if (cg_body_uses_satfixed(w.body) == 1) { return 1; }
            }
            .unsafe_ => |u| { if (cg_body_uses_satfixed(u.body) == 1) { return 1; } }
            else => { }
        }
        i = i + 1;
    }
    return 0;
}
// True iff the whole program uses a sat/fixed type (in a param / return / let /
// cast / slice element). The compiler's OWN source never names these (only as
// string VALUES), so znc-compiling-znc never triggers the include → exact fixpoint.
fn cg_decls_use_satfixed(decls: ArrayList[*Node]) i32 {
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                let pj: i32 = 0;
                while (pj < len[Param](f.params)) {
                    if (cg_ty_is_satfixed(get[Param](f.params, pj).pty) == 1) { return 1; }
                    pj = pj + 1;
                }
                if (cg_ty_is_satfixed(f.ret) == 1) { return 1; }
                if (f.is_extern == 0) { if (cg_body_uses_satfixed(f.body) == 1) { return 1; } }
            }
            else => { }
        }
        i = i + 1;
    }
    return 0;
}

// ── ROUND 3: rns-usage detection (drives the rt3 auto-include) ───────────────
// True iff a type STRING denotes rns_3 (possibly behind '*' or a '[]' element).
fn cg_ty_is_rns(t: []u8) i32 {
    let s: []u8 = t;
    if (s.len > 1) { if (s[0] == '*') { s = s[1..]; } }
    if (s.len > 2) { if (s[0] == 91 && s[1] == 93) { s = s[2..]; } }   // "[]E" → E
    return cg_is_rns_ty(s);
}
fn cg_body_uses_rns(body: ArrayList[*Node]) i32 {
    let i: i32 = 0;
    while (i < len[*Node](body)) {
        switch (get[*Node](body, i).*) {
            .let_   => |l| { if (l.has_dty == 1) { if (cg_ty_is_rns(l.dty) == 1) { return 1; } } }
            .if_    => |x| {
                if (cg_body_uses_rns(x.then_body) == 1) { return 1; }
                if (x.has_els == 1) { if (cg_body_uses_rns(x.els_body) == 1) { return 1; } }
            }
            .while_ => |w| { if (cg_body_uses_rns(w.body) == 1) { return 1; } }
            .unsafe_ => |u| { if (cg_body_uses_rns(u.body) == 1) { return 1; } }
            else => { }
        }
        i = i + 1;
    }
    return 0;
}
// True iff the whole program uses rns_3 (in a param / return / let). The compiler's
// OWN source never names rns_3 (only the type STRING as a value), so the native
// self-hosting fixpoint stays exact.
fn cg_decls_use_rns(decls: ArrayList[*Node]) i32 {
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                let pj: i32 = 0;
                while (pj < len[Param](f.params)) {
                    if (cg_ty_is_rns(get[Param](f.params, pj).pty) == 1) { return 1; }
                    pj = pj + 1;
                }
                if (cg_ty_is_rns(f.ret) == 1) { return 1; }
                if (f.is_extern == 0) { if (cg_body_uses_rns(f.body) == 1) { return 1; } }
            }
            else => { }
        }
        i = i + 1;
    }
    return 0;
}
