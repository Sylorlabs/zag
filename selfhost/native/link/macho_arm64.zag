// selfhost/native/macho_arm64.zag — self-contained arm64 Mach-O writer.
//
// Emits a PIE MH_EXECUTE with __TEXT/__DATA/__LINKEDIT, LC_MAIN, dyld and
// libSystem load commands, and a deterministic embedded ad-hoc SHA-256 code
// signature. No assembler, linker, codesign process, C runtime, or SDK is used.

@import("../../../std/list.zag")
@import("../../../std/rt.zag")

fn MACHO_BASE() i64 { return 4294967296; }       // 0x1_0000_0000
fn MACHO_CODE_OFF() i64 { return 4096; }
fn MACHO_PAGE() i64 { return 16384; }            // Apple arm64 VM page
fn MACHO_HASH_PAGE() i64 { return 4096; }        // CodeDirectory page

fn macho_align(n: i64, a: i64) i64 {
    let r: i64 = n % a;
    if (r == 0) { return n; }
    return n + a - r;
}

fn macho_code_vmaddr() i64 { return MACHO_BASE() + MACHO_CODE_OFF(); }
fn macho_data_fileoff(code_len: i32) i64 {
    return macho_align(MACHO_CODE_OFF() + (code_len as i64), MACHO_PAGE());
}
fn macho_data_vmaddr(code_len: i32) i64 { return MACHO_BASE() + macho_data_fileoff(code_len); }

fn mo_b(buf: *ArrayList[u8], v: i64) void { push[u8](buf, (v & 255) as u8); }
fn mo_le(buf: *ArrayList[u8], v0: i64, n: i32) void {
    let v: i64 = v0;
    let i: i32 = 0;
    while (i < n) { mo_b(buf, v); v = v / 256; i = i + 1; }
}
fn mo_be(buf: *ArrayList[u8], v: i64, n: i32) void {
    let p: i64 = 1;
    let i: i32 = 1;
    while (i < n) { p = p * 256; i = i + 1; }
    i = 0;
    while (i < n) { mo_b(buf, v / p); p = p / 256; i = i + 1; }
}
fn mo_zero(buf: *ArrayList[u8], n: i64) void {
    let i: i64 = 0;
    while (i < n) { mo_b(buf, 0); i = i + 1; }
}
fn mo_pad_to(buf: *ArrayList[u8], off: i64) void {
    while ((buf.*.len as i64) < off) { mo_b(buf, 0); }
}
fn mo_name16(buf: *ArrayList[u8], s: []u8) void {
    let i: i32 = 0;
    while (i < 16) {
        if (i < s.len) { mo_b(buf, s[i] as i64); } else { mo_b(buf, 0); }
        i = i + 1;
    }
}
fn mo_bytes(buf: *ArrayList[u8], s: []u8) void {
    let i: i32 = 0;
    while (i < s.len) { mo_b(buf, s[i] as i64); i = i + 1; }
}
fn mo_list_bytes(buf: *ArrayList[u8], s: ArrayList[u8]) void {
    let i: i32 = 0;
    while (i < s.len) { mo_b(buf, get[u8](s, i) as i64); i = i + 1; }
}

// ── SHA-256 (pure Zag, unsigned-32 arithmetic represented in i64) ──────────

fn sh_u32(x: i64) i64 { return x & 4294967295; }
fn sh_pow2(n: i32) i64 {
    let p: i64 = 1;
    let i: i32 = 0;
    while (i < n) { p = p * 2; i = i + 1; }
    return p;
}
fn sh_ror(x0: i64, n: i32) i64 {
    let x: i64 = sh_u32(x0);
    let p: i64 = sh_pow2(n);
    return sh_u32((x / p) + (x % p) * sh_pow2(32 - n));
}
fn sh_shr(x: i64, n: i32) i64 { return sh_u32(x) / sh_pow2(n); }

fn sh_constants() ArrayList[i64] {
    let k: ArrayList[i64] = make[i64](64);
    push[i64](&k,1116352408); push[i64](&k,1899447441); push[i64](&k,3049323471); push[i64](&k,3921009573);
    push[i64](&k,961987163); push[i64](&k,1508970993); push[i64](&k,2453635748); push[i64](&k,2870763221);
    push[i64](&k,3624381080); push[i64](&k,310598401); push[i64](&k,607225278); push[i64](&k,1426881987);
    push[i64](&k,1925078388); push[i64](&k,2162078206); push[i64](&k,2614888103); push[i64](&k,3248222580);
    push[i64](&k,3835390401); push[i64](&k,4022224774); push[i64](&k,264347078); push[i64](&k,604807628);
    push[i64](&k,770255983); push[i64](&k,1249150122); push[i64](&k,1555081692); push[i64](&k,1996064986);
    push[i64](&k,2554220882); push[i64](&k,2821834349); push[i64](&k,2952996808); push[i64](&k,3210313671);
    push[i64](&k,3336571891); push[i64](&k,3584528711); push[i64](&k,113926993); push[i64](&k,338241895);
    push[i64](&k,666307205); push[i64](&k,773529912); push[i64](&k,1294757372); push[i64](&k,1396182291);
    push[i64](&k,1695183700); push[i64](&k,1986661051); push[i64](&k,2177026350); push[i64](&k,2456956037);
    push[i64](&k,2730485921); push[i64](&k,2820302411); push[i64](&k,3259730800); push[i64](&k,3345764771);
    push[i64](&k,3516065817); push[i64](&k,3600352804); push[i64](&k,4094571909); push[i64](&k,275423344);
    push[i64](&k,430227734); push[i64](&k,506948616); push[i64](&k,659060556); push[i64](&k,883997877);
    push[i64](&k,958139571); push[i64](&k,1322822218); push[i64](&k,1537002063); push[i64](&k,1747873779);
    push[i64](&k,1955562222); push[i64](&k,2024104815); push[i64](&k,2227730452); push[i64](&k,2361852424);
    push[i64](&k,2428436474); push[i64](&k,2756734187); push[i64](&k,3204031479); push[i64](&k,3329325298);
    return k;
}

fn macho_sha256(src: []u8) ArrayList[u8] {
    let total: i32 = (((src.len + 9) + 63) / 64) * 64;
    let msg: ArrayList[u8] = make[u8](total);
    let i: i32 = 0;
    while (i < src.len) { push[u8](&msg, src[i]); i = i + 1; }
    push[u8](&msg, 128);
    while (msg.len < total) { push[u8](&msg, 0); }
    let bitlen: i64 = (src.len as i64) * 8;
    i = 0;
    while (i < 8) {
        let shift: i32 = (7 - i) * 8;
        set[u8](&msg, total - 8 + i, ((bitlen / sh_pow2(shift)) & 255) as u8);
        i = i + 1;
    }

    let h: ArrayList[i64] = make[i64](8);
    push[i64](&h,1779033703); push[i64](&h,3144134277); push[i64](&h,1013904242); push[i64](&h,2773480762);
    push[i64](&h,1359893119); push[i64](&h,2600822924); push[i64](&h,528734635); push[i64](&h,1541459225);
    let k: ArrayList[i64] = sh_constants();
    let off: i32 = 0;
    while (off < total) {
        let w: ArrayList[i64] = make[i64](64);
        i = 0;
        while (i < 16) {
            let b: i32 = off + i * 4;
            let v: i64 = (get[u8](msg,b) as i64) * 16777216 + (get[u8](msg,b+1) as i64) * 65536 +
                         (get[u8](msg,b+2) as i64) * 256 + (get[u8](msg,b+3) as i64);
            push[i64](&w, v); i = i + 1;
        }
        while (i < 64) {
            let x: i64 = get[i64](w,i-15);
            let y: i64 = get[i64](w,i-2);
            let s0: i64 = sh_ror(x,7) ^ sh_ror(x,18) ^ sh_shr(x,3);
            let s1: i64 = sh_ror(y,17) ^ sh_ror(y,19) ^ sh_shr(y,10);
            push[i64](&w, sh_u32(get[i64](w,i-16) + s0 + get[i64](w,i-7) + s1));
            i = i + 1;
        }
        let a: i64=get[i64](h,0); let b: i64=get[i64](h,1); let c: i64=get[i64](h,2); let d: i64=get[i64](h,3);
        let e: i64=get[i64](h,4); let f: i64=get[i64](h,5); let g: i64=get[i64](h,6); let hh: i64=get[i64](h,7);
        i = 0;
        while (i < 64) {
            let s1: i64 = sh_ror(e,6) ^ sh_ror(e,11) ^ sh_ror(e,25);
            let ch: i64 = (e & f) ^ ((4294967295 ^ e) & g);
            let t1: i64 = sh_u32(hh + s1 + ch + get[i64](k,i) + get[i64](w,i));
            let s0: i64 = sh_ror(a,2) ^ sh_ror(a,13) ^ sh_ror(a,22);
            let maj: i64 = (a & b) ^ (a & c) ^ (b & c);
            let t2: i64 = sh_u32(s0 + maj);
            hh=g; g=f; f=e; e=sh_u32(d+t1); d=c; c=b; b=a; a=sh_u32(t1+t2);
            i = i + 1;
        }
        set[i64](&h,0,sh_u32(get[i64](h,0)+a)); set[i64](&h,1,sh_u32(get[i64](h,1)+b));
        set[i64](&h,2,sh_u32(get[i64](h,2)+c)); set[i64](&h,3,sh_u32(get[i64](h,3)+d));
        set[i64](&h,4,sh_u32(get[i64](h,4)+e)); set[i64](&h,5,sh_u32(get[i64](h,5)+f));
        set[i64](&h,6,sh_u32(get[i64](h,6)+g)); set[i64](&h,7,sh_u32(get[i64](h,7)+hh));
        off = off + 64;
    }
    let out: ArrayList[u8] = make[u8](32);
    i = 0;
    while (i < 8) { mo_be(&out, get[i64](h,i), 4); i = i + 1; }
    return out;
}

fn mo_segment(buf: *ArrayList[u8], name: []u8, vmaddr: i64, vmsize: i64,
              fileoff: i64, filesize: i64, prot: i32, nsects: i32) void {
    mo_le(buf,25,4); mo_le(buf,72 + nsects * 80,4); mo_name16(buf,name);
    mo_le(buf,vmaddr,8); mo_le(buf,vmsize,8); mo_le(buf,fileoff,8); mo_le(buf,filesize,8);
    mo_le(buf,prot,4); mo_le(buf,prot,4); mo_le(buf,nsects,4); mo_le(buf,0,4);
}
fn mo_section(buf: *ArrayList[u8], sect: []u8, seg: []u8, addr: i64, size: i64,
              off: i64, align_pow: i32, flags: i64) void {
    mo_name16(buf,sect); mo_name16(buf,seg); mo_le(buf,addr,8); mo_le(buf,size,8);
    mo_le(buf,off,4); mo_le(buf,align_pow,4); mo_le(buf,0,4); mo_le(buf,0,4);
    mo_le(buf,flags,4); mo_le(buf,0,4); mo_le(buf,0,4); mo_le(buf,0,4);
}

fn mo_signature(image: []u8, text_limit: i64) ArrayList[u8] {
    let ident: []u8 = "zag";
    let cd_header: i32 = 88;
    let ident_off: i32 = cd_header;
    let hash_off: i32 = ((ident_off + ident.len + 1 + 7) / 8) * 8;
    let nslots: i32 = (((image.len as i64) + MACHO_HASH_PAGE() - 1) / MACHO_HASH_PAGE()) as i32;
    let cd_len: i32 = hash_off + nslots * 32;
    let super_len: i32 = 20 + cd_len;
    let sig_len: i32 = ((super_len + 15) / 16) * 16;
    let sig: ArrayList[u8] = make[u8](sig_len);
    mo_be(&sig,4208856256,4); mo_be(&sig,super_len,4); mo_be(&sig,1,4); // CSMAGIC_EMBEDDED_SIGNATURE
    mo_be(&sig,0,4); mo_be(&sig,20,4);
    mo_be(&sig,4208856066,4); mo_be(&sig,cd_len,4); mo_be(&sig,132096,4); // CodeDirectory v0x20400
    mo_be(&sig,131074,4); mo_be(&sig,hash_off,4); mo_be(&sig,ident_off,4);
    mo_be(&sig,0,4); mo_be(&sig,nslots,4); mo_be(&sig,image.len,4);
    mo_b(&sig,32); mo_b(&sig,2); mo_b(&sig,0); mo_b(&sig,12);
    mo_be(&sig,0,4); mo_be(&sig,0,4); mo_be(&sig,0,4); mo_be(&sig,0,4); mo_be(&sig,0,8);
    mo_be(&sig,0,8); mo_be(&sig,text_limit,8); mo_be(&sig,1,8);
    mo_bytes(&sig,ident); mo_b(&sig,0); mo_pad_to(&sig,20 + hash_off);
    let slot: i32 = 0;
    while (slot < nslots) {
        let lo: i32 = slot * (MACHO_HASH_PAGE() as i32);
        let hi: i32 = lo + (MACHO_HASH_PAGE() as i32);
        if (hi > image.len) { hi = image.len; }
        let digest: ArrayList[u8] = macho_sha256(image[lo..hi]);
        mo_list_bytes(&sig,digest);
        slot = slot + 1;
    }
    mo_pad_to(&sig,sig_len);
    return sig;
}

fn write_macho_arm64_data_debug(path: []u8, text: ArrayList[u8], entry_off: i32, data: ArrayList[u8],
                                abbrev: ArrayList[u8], info: ArrayList[u8], line: ArrayList[u8]) i32 {
    let code_off: i64 = MACHO_CODE_OFF();
    let data_off: i64 = macho_data_fileoff(text.len);
    let debug_len: i64 = (abbrev.len + info.len + line.len) as i64;
    let has_debug: i32 = (debug_len > 0) as i32;
    let debug_off: i64 = macho_align(data_off + (data.len as i64), 16);
    let sig_off: i64 = macho_align(debug_off + debug_len, MACHO_PAGE());
    let text_size: i64 = data_off;
    let data_size: i64 = debug_off - data_off;
    let nslots: i64 = (sig_off + MACHO_HASH_PAGE() - 1) / MACHO_HASH_PAGE();
    let hash_off: i64 = 96;
    let cd_len: i64 = hash_off + nslots * 32;
    let super_len: i64 = 20 + cd_len;
    let sig_size: i64 = macho_align(super_len,16);
    let link_size: i64 = macho_align(sig_size,MACHO_PAGE());
    let buf: ArrayList[u8] = make[u8]((sig_off + sig_size) as i32);
    let uuid_source: ArrayList[u8] = make[u8](text.len + data.len + abbrev.len + info.len + line.len);
    mo_list_bytes(&uuid_source,text);
    mo_list_bytes(&uuid_source,data);
    mo_list_bytes(&uuid_source,abbrev); mo_list_bytes(&uuid_source,info); mo_list_bytes(&uuid_source,line);
    let uuid_hash: ArrayList[u8] = macho_sha256(uuid_source.data[0..uuid_source.len]);

    // mach_header_64
    mo_le(&buf,4277009103,4); mo_le(&buf,16777228,4); mo_le(&buf,0,4); mo_le(&buf,2,4);
    let ncmds: i32 = 10 + has_debug;
    let sizeofcmds: i32 = 624 + has_debug * 312;
    mo_le(&buf,ncmds,4); mo_le(&buf,sizeofcmds,4); mo_le(&buf,2097285,4); mo_le(&buf,0,4);

    mo_segment(&buf,"__PAGEZERO",0,MACHO_BASE(),0,0,0,0);
    mo_segment(&buf,"__TEXT",MACHO_BASE(),text_size,0,text_size,5,1);
    mo_section(&buf,"__text","__TEXT",MACHO_BASE()+code_off,text.len,code_off,2,2147484672);
    mo_segment(&buf,"__DATA",MACHO_BASE()+data_off,data_size,data_off,data_size,3,1);
    mo_section(&buf,"__data","__DATA",MACHO_BASE()+data_off,data.len,data_off,3,0);
    if (has_debug == 1) {
        mo_segment(&buf,"__DWARF",MACHO_BASE()+debug_off,debug_len,debug_off,debug_len,1,3);
        mo_section(&buf,"__debug_abbrev","__DWARF",MACHO_BASE()+debug_off,abbrev.len,debug_off,0,0);
        mo_section(&buf,"__debug_info","__DWARF",MACHO_BASE()+debug_off+(abbrev.len as i64),info.len,debug_off+(abbrev.len as i64),0,0);
        mo_section(&buf,"__debug_line","__DWARF",MACHO_BASE()+debug_off+(abbrev.len as i64)+(info.len as i64),line.len,debug_off+(abbrev.len as i64)+(info.len as i64),0,0);
    }
    mo_segment(&buf,"__LINKEDIT",MACHO_BASE()+sig_off,link_size,sig_off,sig_size,1,0);

    mo_le(&buf,14,4); mo_le(&buf,32,4); mo_le(&buf,12,4); mo_bytes(&buf,"/usr/lib/dyld"); mo_b(&buf,0);
    while ((buf.len % 8) != 0) { mo_b(&buf,0); }
    mo_pad_to(&buf,32+72+152+152+has_debug*312+72+32);
    mo_le(&buf,50,4); mo_le(&buf,24,4); mo_le(&buf,1,4); mo_le(&buf,720896,4); mo_le(&buf,720896,4); mo_le(&buf,0,4);
    // LC_UUID is required by modern dyld. Deriving it from program content
    // preserves byte-for-byte reproducible builds without an external tool.
    mo_le(&buf,27,4); mo_le(&buf,24,4);
    let ui: i32 = 0;
    while (ui < 16) { mo_b(&buf,get[u8](uuid_hash,ui) as i64); ui = ui + 1; }
    mo_le(&buf,2147483688,4); mo_le(&buf,24,4); mo_le(&buf,code_off + (entry_off as i64),8); mo_le(&buf,0,8);
    mo_le(&buf,12,4); mo_le(&buf,56,4); mo_le(&buf,24,4); mo_le(&buf,2,4); mo_le(&buf,0,4); mo_le(&buf,65536,4);
    mo_bytes(&buf,"/usr/lib/libSystem.B.dylib"); mo_b(&buf,0); while ((buf.len % 8) != 0) { mo_b(&buf,0); }
    mo_le(&buf,29,4); mo_le(&buf,16,4); mo_le(&buf,sig_off,4); mo_le(&buf,sig_size,4);

    if (buf.len > code_off) { return 1; }
    mo_pad_to(&buf,code_off); mo_list_bytes(&buf,text); mo_pad_to(&buf,data_off); mo_list_bytes(&buf,data);
    if (has_debug == 1) { mo_pad_to(&buf,debug_off); mo_list_bytes(&buf,abbrev); mo_list_bytes(&buf,info); mo_list_bytes(&buf,line); }
    mo_pad_to(&buf,sig_off);
    let sig: ArrayList[u8] = mo_signature(buf.data[0..buf.len],text_size);
    mo_list_bytes(&buf,sig);
    return _zag_write_exec(path,buf.data[0..buf.len]);
}

fn write_macho_arm64_data(path: []u8, text: ArrayList[u8], entry_off: i32, data: ArrayList[u8]) i32 {
    let empty: ArrayList[u8] = make[u8](0);
    return write_macho_arm64_data_debug(path,text,entry_off,data,empty,empty,empty);
}

// Emit regular dyld bind opcodes for the import-pointer table.  This is the
// native Mach-O mechanism: dyld writes resolved libSystem addresses into our
// writable slots before LC_MAIN runs.  No ELF PLT/GOT or compatibility loader
// is involved.
fn mo_has_prefix(value: []u8, prefix: []u8) i32 {
    if (value.len < prefix.len) { return 0; }
    let i: i32 = 0; while (i < prefix.len) { if (value[i] != prefix[i]) { return 0; } i = i + 1; }
    return 1;
}

// dylib ordinal 1 is libSystem, 2 is Metal.framework, and 3 is libobjc.
// Keep this mapping narrow and explicit: a symbol never falls through from a
// framework to libSystem merely because an import name happens to be unknown.
fn mo_import_ordinal(name: []u8) i32 {
    if (mo_has_prefix(name,"MTL") == 1) { return 2; }
    if (mo_has_prefix(name,"objc_") == 1 || mo_has_prefix(name,"sel_") == 1) { return 3; }
    return 1;
}

// Zag source may declare ABI-specialized Objective-C send entry points (for
// example, one whose trailing parameters are MTLSize values).  They all bind
// to libobjc's single objc_msgSend symbol; the suffix exists only to give the
// source type checker a distinct, accurate call signature.
fn mo_bind_symbol(name: []u8) []u8 {
    if (mo_has_prefix(name,"objc_msgSend_") == 1) { return "objc_msgSend"; }
    return name;
}

fn mo_bind_stream(names: ArrayList[[]u8], data_len: i32, needs_metal:i32) ArrayList[u8] {
    let out: ArrayList[u8] = make[u8](names.len * 24 + 8);
    let i: i32 = 0;
    while (i < names.len) {
        let ordinal:i32=mo_import_ordinal(names.data[i]);
        // Metal is optional, so libobjc occupies ordinal 2 in a pure ObjC
        // image and ordinal 3 only when Metal.framework was emitted first.
        if(ordinal==3){ordinal=2+needs_metal;}
        mo_b(&out, 16 + ordinal); // SET_DYLIB_ORDINAL_IMM
        mo_b(&out, 64);                         // SET_SYMBOL_TRAILING_FLAGS_IMM(0)
        let symbol:[]u8=mo_bind_symbol(names.data[i]);
        if (symbol.len > 0 && symbol[0] == '_') { mo_bytes(&out,symbol); }
        else { mo_b(&out,95); mo_bytes(&out,symbol); } // Darwin C ABI leading '_'
        mo_b(&out,0);
        mo_b(&out,81);                          // SET_TYPE_IMM(BIND_TYPE_POINTER)
        mo_b(&out,114);                         // SET_SEGMENT_AND_OFFSET_ULEB(__DATA)
        let off: i32 = data_len + i * 8;
        // all generated data is well below 128 bytes in the supported import
        // mode; retain proper ULEB continuation for larger programs.
        let v: i32 = off;
        while (v >= 128) { mo_b(&out,(v % 128) + 128); v = v / 128; }
        mo_b(&out,v);
        mo_b(&out,144);                         // DO_BIND
        i = i + 1;
    }
    mo_b(&out,0);                               // DONE
    return out;
}

fn mo_need_metal(names: ArrayList[[]u8]) i32 { let i:i32=0;while(i<names.len){if(mo_import_ordinal(names.data[i])==2){return 1;}i=i+1;}return 0; }
fn mo_need_objc(names: ArrayList[[]u8]) i32 { let i:i32=0;while(i<names.len){if(mo_import_ordinal(names.data[i])==3){return 1;}i=i+1;}return 0; }
fn mo_dylib_cmd_size(path: []u8) i32 { return macho_align((24 + path.len + 1) as i64,8) as i32; }
fn mo_load_dylib(buf: *ArrayList[u8], path: []u8) void {
    let size:i32=mo_dylib_cmd_size(path);
    mo_le(buf,12,4);mo_le(buf,size,4);mo_le(buf,24,4);mo_le(buf,2,4);mo_le(buf,0,4);mo_le(buf,65536,4);
    mo_bytes(buf,path);mo_b(buf,0);while((buf.*.len%8)!=0){mo_b(buf,0);}
}

fn write_macho_arm64_dynamic(path: []u8, text: ArrayList[u8], entry_off: i32,
                              data: ArrayList[u8], imports: ArrayList[[]u8]) i32 {
    if (imports.len == 0) { return write_macho_arm64_data(path,text,entry_off,data); }
    let code_off: i64 = MACHO_CODE_OFF();
    let data_off: i64 = macho_data_fileoff(text.len);
    let import_bytes: i32 = imports.len * 8;
    let data_len: i32 = data.len + import_bytes;
    let needs_metal:i32=mo_need_metal(imports);
    let needs_objc:i32=mo_need_objc(imports);
    let bind: ArrayList[u8] = mo_bind_stream(imports,data.len,needs_metal);
    let libsystem:[]u8="/usr/lib/libSystem.B.dylib";
    let metal:[]u8="/System/Library/Frameworks/Metal.framework/Versions/A/Metal";
    let libobjc:[]u8="/usr/lib/libobjc.A.dylib";
    let dylib_bytes:i32=mo_dylib_cmd_size(libsystem)+needs_metal*mo_dylib_cmd_size(metal)+needs_objc*mo_dylib_cmd_size(libobjc);
    // Link-edit data has its own page-aligned file/VM mapping.  Keeping the
    // dyld stream in the post-__DATA padding leaves a conventional contiguous
    // __LINKEDIT mapping for the loader instead of a mismatched file/VM pair.
    let bind_off: i64 = macho_align(data_off + (data_len as i64),MACHO_PAGE());
    let sig_off: i64 = macho_align(bind_off + (bind.len as i64),16);
    let text_size: i64 = data_off;
    let data_size: i64 = macho_align(data_len as i64,MACHO_PAGE());
    let nslots: i64 = (sig_off + MACHO_HASH_PAGE() - 1) / MACHO_HASH_PAGE();
    let sig_size: i64 = macho_align(20 + 96 + nslots * 32,16);
    let link_size: i64 = macho_align(sig_off + sig_size - bind_off,MACHO_PAGE());
    let buf: ArrayList[u8] = make[u8]((sig_off + sig_size) as i32);
    let uuid_source: ArrayList[u8] = make[u8](text.len + data.len + bind.len);
    mo_list_bytes(&uuid_source,text); mo_list_bytes(&uuid_source,data); mo_list_bytes(&uuid_source,bind);
    let uuid_hash: ArrayList[u8] = macho_sha256(uuid_source.data[0..uuid_source.len]);

    mo_le(&buf,4277009103,4); mo_le(&buf,16777228,4); mo_le(&buf,0,4); mo_le(&buf,2,4);
    mo_le(&buf,11+needs_metal+needs_objc,4); mo_le(&buf,616+dylib_bytes,4); mo_le(&buf,2097285,4); mo_le(&buf,0,4);
    mo_segment(&buf,"__PAGEZERO",0,MACHO_BASE(),0,0,0,0);
    mo_segment(&buf,"__TEXT",MACHO_BASE(),text_size,0,text_size,5,1);
    mo_section(&buf,"__text","__TEXT",MACHO_BASE()+code_off,text.len,code_off,2,2147484672);
    mo_segment(&buf,"__DATA",MACHO_BASE()+data_off,data_size,data_off,data_len,3,1);
    mo_section(&buf,"__data","__DATA",MACHO_BASE()+data_off,data_len,data_off,3,0);
    mo_segment(&buf,"__LINKEDIT",MACHO_BASE()+bind_off,link_size,bind_off,sig_off+sig_size-bind_off,1,0);
    mo_le(&buf,14,4); mo_le(&buf,32,4); mo_le(&buf,12,4); mo_bytes(&buf,"/usr/lib/dyld"); mo_b(&buf,0);
    while ((buf.len % 8) != 0) { mo_b(&buf,0); }
    mo_le(&buf,50,4); mo_le(&buf,24,4); mo_le(&buf,1,4); mo_le(&buf,720896,4); mo_le(&buf,720896,4); mo_le(&buf,0,4);
    mo_le(&buf,27,4); mo_le(&buf,24,4);
    let ui: i32 = 0; while (ui < 16) { mo_b(&buf,get[u8](uuid_hash,ui) as i64); ui = ui + 1; }
    mo_le(&buf,2147483688,4); mo_le(&buf,24,4); mo_le(&buf,code_off + (entry_off as i64),8); mo_le(&buf,0,8);
    mo_load_dylib(&buf,libsystem);
    if(needs_metal==1){mo_load_dylib(&buf,metal);}
    if(needs_objc==1){mo_load_dylib(&buf,libobjc);}
    // LC_DYLD_INFO_ONLY: rebase, weak-bind and lazy-bind streams are empty;
    // bind is the regular import stream located in __LINKEDIT.
    mo_le(&buf,2147483682,4); mo_le(&buf,48,4);
    mo_le(&buf,0,4); mo_le(&buf,0,4); mo_le(&buf,bind_off,4); mo_le(&buf,bind.len,4);
    mo_le(&buf,0,4); mo_le(&buf,0,4); mo_le(&buf,0,4); mo_le(&buf,0,4); mo_le(&buf,0,4); mo_le(&buf,0,4);
    mo_le(&buf,29,4); mo_le(&buf,16,4); mo_le(&buf,sig_off,4); mo_le(&buf,sig_size,4);
    if (buf.len > code_off) { return 1; }
    mo_pad_to(&buf,code_off); mo_list_bytes(&buf,text); mo_pad_to(&buf,data_off); mo_list_bytes(&buf,data);
    mo_zero(&buf,import_bytes as i64); mo_pad_to(&buf,bind_off); mo_list_bytes(&buf,bind); mo_pad_to(&buf,sig_off);
    let sig: ArrayList[u8] = mo_signature(buf.data[0..buf.len],text_size);
    mo_list_bytes(&buf,sig);
    return _zag_write_exec(path,buf.data[0..buf.len]);
}
