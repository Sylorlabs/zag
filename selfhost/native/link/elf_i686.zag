// Deterministic bounded ELF lookup: relocation-local first, then an included
// regular strong definition, merged strong COMMON, regular weak, and weak
// COMMON in input/symbol-table order.
fn i686_resolve_symbol(syms:ArrayList[I686Sym],obj:i32,idx:i32,name:[]u8)i32{
    let i:i32=0;
    while(i<syms.len){if(syms.data[i].obj==obj&&syms.data[i].idx==idx&&syms.data[i].bind==0&&syms.data[i].output>=0){return i;}i=i+1;}
    i=0;
    while(i<syms.len){if(syms.data[i].bind==1&&syms.data[i].shndx!=65522&&syms.data[i].output>=0&&@strEq(syms.data[i].name,name)){return i;}i=i+1;}
    i=0;
    while(i<syms.len){if(syms.data[i].bind==1&&syms.data[i].shndx==65522&&syms.data[i].output>=0&&@strEq(syms.data[i].name,name)){return i;}i=i+1;}
    i=0;
    while(i<syms.len){if(syms.data[i].bind==2&&syms.data[i].shndx!=65522&&syms.data[i].output>=0&&@strEq(syms.data[i].name,name)){return i;}i=i+1;}
    i=0;
    while(i<syms.len){if(syms.data[i].bind==2&&syms.data[i].shndx==65522&&syms.data[i].output>=0&&@strEq(syms.data[i].name,name)){return i;}i=i+1;}
    return -1;
}

