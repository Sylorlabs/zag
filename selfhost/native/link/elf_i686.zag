// Archive extraction is intentionally driven by strong global definitions
// only. A weak definition cannot satisfy an archive demand or pull a member
// into the output by itself.
fn i686_obj_defines(o:I686Obj,name:[]u8)i32{let s:i32=1;while(s<o.shnum){if(i686_shv(o,s,4)==2){let n:i32=i686_shv(o,s,20)/16;let i:i32=1;while(i<n){let e:i32=i686_shv(o,s,16)+i*16;if(i686_rd16(o.data,e+14)!=0&&((o.data[e+12] as i32)/16)==1&&@strEq(i686_sym_name(o,s,i),name)){return 1;}i=i+1;}}s=s+1;}return 0;}
fn i686_has_def(objs:ArrayList[I686Obj],name:[]u8)i32{let i:i32=0;while(i<objs.len){if(objs.data[i].included==1&&i686_obj_defines(objs.data[i],name)==1){return 1;}i=i+1;}return 0;}
