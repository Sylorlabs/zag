fn i686_add_undefs(o:I686Obj,names:*ArrayList[[]u8])void{let s:i32=1;while(s<o.shnum){if(i686_shv(o,s,4)==2){let n:i32=i686_shv(o,s,20)/16;let i:i32=1;while(i<n){let e:i32=i686_shv(o,s,16)+i*16;if(i686_rd16(o.data,e+14)==0&&((o.data[e+12] as i32)/16)==1){let nm:[]u8=i686_sym_name(o,s,i);let seen:i32=0;let q:i32=0;while(q<names.*.len){if(@strEq(names.*.data[q],nm)){seen=1;}q=q+1;}if(seen==0){push[[]u8](names,nm);}}i=i+1;}}s=s+1;}}
