// selfhost/native/elf_arm64.zag — ELF64 AArch64 executable writer (static, no libc).

@import("../../../std/list.zag")
@import("../../../std/rt.zag")

fn AVBASE() i64 { return 4194304; }
fn AHDRS2() i64 { return 176; }
fn ADVBASE() i64 { return 67108864; }
// 64 KiB, not 4096: arm64 kernels run with 4K, 16K, or 64K pages, and execve
// requires p_offset ≡ p_vaddr (mod PAGE_SIZE) for every PT_LOAD. Aligning the
// data segment's file offset to 64K keeps the binary loadable under all three
// (both vbases are 64K multiples). Same reason aarch64 ld defaults to
// max-page-size=65536. qemu-user won't catch a violation — its loader copies
// instead of mmapping — so don't lower this because tests still pass.
fn APAGE()  i64 { return 65536; }

fn aelf_eb(buf: *ArrayList[u8], b: i32) void { push[u8](buf, (b % 256) as u8); }

fn aelf_emit_le(buf: *ArrayList[u8], v: i64, n: i32) void {
    let x: i64 = v;
    let k: i32 = 0;
    while (k < n) {
        let b: i64 = x & 255;
        aelf_eb(buf, b as i32);
        x = (x - b) / 256;
        k = k + 1;
    }
}

// EM_AARCH64 = 183
fn write_elf_arm64_data(path: []u8, text: ArrayList[u8], entry_off: i32, data: ArrayList[u8]) i32 {
    let tlen: i64 = text.len as i64;
    let dlen: i64 = data.len as i64;
    let code_filesz: i64 = AHDRS2() + tlen;
    let entry: i64 = AVBASE() + AHDRS2() + (entry_off as i64);
    let used: i64 = AHDRS2() + tlen;
    let pad: i64 = (APAGE() - (used % APAGE())) % APAGE();
    let data_file_off: i64 = used + pad;

    let buf: ArrayList[u8] = make[u8](192 + text.len + (pad as i32) + data.len);

    // e_ident (16 bytes) — byte-for-byte same layout as elf.zag write_elf_exec_data
    aelf_eb(&buf, 127);
    aelf_eb(&buf, 69);
    aelf_eb(&buf, 76);
    aelf_eb(&buf, 70);
    aelf_eb(&buf, 2);
    aelf_eb(&buf, 1);
    aelf_eb(&buf, 1);
    let pad_i: i32 = 0;
    while (pad_i < 9) {
        aelf_eb(&buf, 0);
        pad_i = pad_i + 1;
    }

    aelf_emit_le(&buf, 2, 2);
    aelf_emit_le(&buf, 183, 2);          // e_machine = EM_AARCH64
    aelf_emit_le(&buf, 1, 4);
    aelf_emit_le(&buf, entry, 8);
    aelf_emit_le(&buf, 64, 8);
    aelf_emit_le(&buf, 0, 8);
    aelf_emit_le(&buf, 0, 4);
    aelf_emit_le(&buf, 64, 2);
    aelf_emit_le(&buf, 56, 2);
    aelf_emit_le(&buf, 2, 2);
    aelf_emit_le(&buf, 0, 2);
    aelf_emit_le(&buf, 0, 2);
    aelf_emit_le(&buf, 0, 2);

    aelf_emit_le(&buf, 1, 4);
    aelf_emit_le(&buf, 5, 4);
    aelf_emit_le(&buf, 0, 8);
    aelf_emit_le(&buf, AVBASE(), 8);
    aelf_emit_le(&buf, AVBASE(), 8);
    aelf_emit_le(&buf, code_filesz, 8);
    aelf_emit_le(&buf, code_filesz, 8);
    aelf_emit_le(&buf, APAGE(), 8);

    aelf_emit_le(&buf, 1, 4);
    aelf_emit_le(&buf, 6, 4);            // PF_R|PF_W: arena allocator globals live here
    aelf_emit_le(&buf, data_file_off, 8);
    aelf_emit_le(&buf, ADVBASE(), 8);
    aelf_emit_le(&buf, ADVBASE(), 8);
    aelf_emit_le(&buf, dlen, 8);
    aelf_emit_le(&buf, dlen, 8);
    aelf_emit_le(&buf, APAGE(), 8);

    let i: i32 = 0;
    while (i < text.len) {
        aelf_eb(&buf, get[u8](text, i) as i32);
        i = i + 1;
    }
    let p: i64 = 0;
    while (p < pad) { aelf_eb(&buf, 0); p = p + 1; }
    let d: i32 = 0;
    while (d < data.len) {
        aelf_eb(&buf, get[u8](data, d) as i32);
        d = d + 1;
    }
    return _zag_write_exec(path, buf.data[0..buf.len]);
}