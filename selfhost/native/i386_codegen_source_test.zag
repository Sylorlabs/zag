// Low-memory source-backend harness.  The currently installed self-hosted
// compiler builds this ordinary x86-64 program; the resulting test program
// then executes the checked i386 lowering source from this worktree.  That
// validates backend changes without first replacing `znc` or running a full
// bootstrap cycle.
@import("i386_codegen.zag")

// The integer harness intentionally does not pull the full native and WASM
// float parsers into this small validation binary.  Any accidental float input
// fails closed at the existing `invalid float literal` boundary.
fn zf64_bits_core(_text:[]u8, errflag:*i32) i64 {
    errflag.*=1;
    return 0;
}
fn w_f64_to_f32_bits(_bits:i64) i32 { return 0; }

fn main() i32 {
    if (_zag_argc()!=3&&_zag_argc()!=4) {
        _zag_eprintln("usage: i386_codegen_source_test <input.zag> <output> [--obj]");
        return 2;
    }
    let object_mode:i32=0;
    if (_zag_argc()==4) {
        if (!@strEq(_zag_arg(3),"--obj")) { return 2; }
        object_mode=1;
    }
    let src:[]u8=_zag_read_file(_zag_arg(1));
    if (src.len<0) { return 3; }
    let decls:ArrayList[*Node]=parse_program(src);
    let lower:I386Lower=I386Lower{
        .ir=make[I32IR](32),
        .locals=make[I386Local](8),
        .funcs=make[I386Fn](8),
        .structs=make[StructDecl](4),
        .strings=make[[]u8](4),
        .object_relocs=make[I686CodeReloc](4),
        .failed=0,
        .next_label=0,
        .next_slot=0,
        .break_label=-1,
        .continue_label=-1,
        .current_error_fn=0,
        .expected_ty="",
        .current_ret_ty="",
        .sret_target=-1,
        .object_mode=object_mode,
    };
    if (lower_i386_i32_program(decls,&lower)!=0) { return 4; }
    let text:ArrayList[u8]=encode_i386_i32(&lower);
    if (object_mode==1) {
        let code:I686ObjectCode=i386_object_code(&lower,text);
        if (write_i686_object_code(_zag_arg(2),code)!=0) { return 5; }
        return 0;
    }
    if (write_i686_text(_zag_arg(2),text)!=0) { return 5; }
    return 0;
}
