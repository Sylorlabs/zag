@import("arch/x86/x86.zag")
@import("link/elf.zag")
@import("ncodegen.zag")

fn main() i32 {
    let src: []u8 = "struct ProcessResult { handle: *opaque } fn status(r: ProcessResult) i32 { return _zag_process_result_status(r.handle); } fn state(r: ProcessResult) i32 { return _zag_process_result_state(r.handle); } fn output(r: ProcessResult) []u8 { return _zag_process_result_output(r.handle); } fn main() i32 { let h: *opaque = _zag_process_result_abi_new(23, 2, \"partial\"); let r: ProcessResult = ProcessResult{ .handle = h }; if (status(r) != 23 || state(r) != 2) { return 1; } let s: []u8 = output(r); if (!@strEq(s, \"partial\")) { return 2; } return 0; }";
    let decls: ArrayList[*Node] = parse_program_dir(src, "selfhost/native");
    let errors: i32 = 0;
    let data: ArrayList[u8] = make[u8](16);
    let program: ArrayList[Instr] = lower_program(decls, &errors, &data);
    if (errors != 0) { return 1; }
    let code: ArrayList[u8] = encode(program);
    if (write_elf_exec_data("/tmp/zag_process_result_abi", code, 0, data) != 0) { return 2; }
    return 0;
}
