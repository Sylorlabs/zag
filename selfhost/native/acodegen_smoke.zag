@import("arch/aarch64/acodegen.zag")
@import("arch/aarch64/aarch64.zag")
@import("../parse.zag")
@import("../../std/rt.zag")

fn main() i32 {
    let src: []u8 = "fn main() i32 { return 42; }";
    let decls: ArrayList[*Node] = parse_program(src);
    let data: ArrayList[u8] = make[u8](16);
    let nerr: i32 = 0;
    let prog: ArrayList[AInstr] = aload_program(decls, &nerr, &data);
    let code: ArrayList[u8] = aencode(prog);
    _zag_write_file("/tmp/code.bin", code.data[0..code.len]);
    return code.len;
}