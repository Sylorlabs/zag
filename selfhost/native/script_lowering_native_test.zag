@import("arch/x86/x86.zag")
@import("link/elf.zag")
@import("ncodegen.zag")

fn build_script(path: []u8, src: []u8) i32 {
    let unit: CompilationUnit = parse_compilation_unit_dir(src, ".");
    return build_script_unit(path, unit);
}

fn build_script_limit(path: []u8, src: []u8, limit_bytes: i64) i32 {
    let unit: CompilationUnit = parse_compilation_unit_dir_with_script_limit(src, ".", limit_bytes);
    return build_script_unit(path, unit);
}

fn build_script_unit(path: []u8, unit: CompilationUnit) i32 {
    if (unit.profile != ModuleProfile.script) { return 10; }
    let found_body: i32 = 0;
    let wrapper_order_ok: i32 = 0;
    let i: i32 = 0;
    while (i < len[*Node](unit.decls)) {
        switch (get[*Node](unit.decls, i).*) {
            .fn_decl => |f| {
                if (@strEq(f.name, "__zag_compiler_script_body_7f3a")) { found_body = 1; }
                if (@strEq(f.name, "main") && len[*Node](f.body) == 4) {
                    switch (get[*Node](f.body, 0).*) {
                        .let_ => |init| {
                            switch (init.expr.*) {
                                .call => |c0| { switch (c0.callee.*) { .id => |id0| {
                                    if (@strEq(id0.name, "_zag_script_context_init") &&
                                        len[*Node](c0.args) == 3) { wrapper_order_ok = 1; }
                                } else => { } } }
                                else => { }
                            }
                        }
                        else => { }
                    }
                    switch (get[*Node](f.body, 2).*) {
                        .estmt => |stop| { switch (stop.expr.*) { .call => |c2| { switch (c2.callee.*) {
                            .id => |id2| { if (@strEq(id2.name, "_zag_script_context_shutdown") == 0) { wrapper_order_ok = 0; } }
                            else => { wrapper_order_ok = 0; }
                        } } else => { wrapper_order_ok = 0; } } }
                        else => { wrapper_order_ok = 0; }
                    }
                }
            }
            else => { }
        }
        i = i + 1;
    }
    if (found_body == 0 || wrapper_order_ok == 0) { return 11; }
    let nerr: i32 = 0;
    let data: ArrayList[u8] = make[u8](16);
    let prog: ArrayList[Instr] = lower_program(unit.decls, &nerr, &data);
    if (nerr != 0) { return 12; }
    let code: ArrayList[u8] = encode(prog);
    return write_elf_exec_data(path, code, 0, data);
}

fn regular_limit_noop_bytes() i32 {
    let src: []u8 = "fn main() i32 { return 37; }";
    let a: CompilationUnit = parse_compilation_unit_dir(src, ".");
    let b: CompilationUnit = parse_compilation_unit_dir(src, ".");
    if (compilation_unit_set_script_memory_limit(&b, 1048576) == 0) { return 20; }
    let ea: i32 = 0; let eb: i32 = 0;
    let da: ArrayList[u8] = make[u8](4); let db: ArrayList[u8] = make[u8](4);
    let ca: ArrayList[u8] = encode(lower_program(a.decls, &ea, &da));
    let cb: ArrayList[u8] = encode(lower_program(b.decls, &eb, &db));
    if (ea != 0 || eb != 0 || ca.len != cb.len || da.len != db.len) { return 21; }
    let i: i32 = 0; while (i < ca.len) { if (ca.data[i] != cb.data[i]) { return 22; } i = i + 1; }
    return 0;
}

fn script_limit_validation() i32 {
    let low: CompilationUnit = parse_compilation_unit_dir("script; return 0;", ".");
    if (compilation_unit_set_script_memory_limit(&low, 1048575) == 0) { return 23; }
    let high: CompilationUnit = parse_compilation_unit_dir("script; return 0;", ".");
    if (compilation_unit_set_script_memory_limit(&high, 2147483649) == 0) { return 24; }
    let minimum: CompilationUnit = parse_compilation_unit_dir("script; return 0;", ".");
    if (compilation_unit_set_script_memory_limit(&minimum, 1048576) != 0) { return 25; }
    let maximum: CompilationUnit = parse_compilation_unit_dir("script; return 0;", ".");
    if (compilation_unit_set_script_memory_limit(&maximum, 2147483648) != 0) { return 26; }
    return 0;
}

fn script_context_init_arg(unit:CompilationUnit, index:i32) i64 {
    let i:i32 = 0;
    while (i < len[*Node](unit.decls)) {
        switch (get[*Node](unit.decls, i).*) {
            .fn_decl => |f| {
                if (@strEq(f.name, "main") && len[*Node](f.body) > 0) {
                    switch (get[*Node](f.body, 0).*) {
                        .let_ => |binding| { switch (binding.expr.*) {
                            .call => |call| { switch (call.callee.*) {
                                .id => |id| {
                                    if (@strEq(id.name, "_zag_script_context_init") &&
                                        len[*Node](call.args) == 3 && index >= 0 && index < 3) {
                                        switch (get[*Node](call.args, index).*) {
                                            .ilit => |literal| {
                                                return _zag_str_to_i64(literal.text);
                                            }
                                            else => { }
                                        }
                                    }
                                }
                                else => { }
                            } }
                            else => { }
                        } }
                        else => { }
                    }
                }
            }
            else => { }
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn script_context_policy_validation() i32 {
    let configured:CompilationUnit =
        parse_compilation_unit_dir("script; return 0;", ".");
    if (script_context_init_arg(configured, 1) != 7 ||
        script_context_init_arg(configured, 2) !=
            script_execution_policy_bits(1, 1, 1, 1)) { return 27; }
    let native_bits:i64 = script_execution_policy_bits(1, 2, 1, 1);
    if (compilation_unit_set_script_runtime_policy(&configured, 4,
        native_bits) != 0) { return 28; }
    if (script_context_init_arg(configured, 1) != 4 ||
        script_context_init_arg(configured, 2) != native_bits) { return 29; }
    if (compilation_unit_set_script_runtime_policy(&configured, 16,
        native_bits) == 0) { return 30; }
    if (compilation_unit_set_script_runtime_policy(&configured, 4,
        script_execution_policy_bits(1, 2, 2, 1)) == 0) { return 31; }
    let regular:CompilationUnit =
        parse_compilation_unit_dir("fn main() i32 { return 0; }", ".");
    if (compilation_unit_set_script_runtime_policy(&regular, 7,
        script_execution_policy_bits(1, 1, 1, 1)) == 0) { return 32; }
    let bounded_heap_bits:i64=script_execution_policy_bits(2,1,1,1);
    if(compilation_unit_set_script_runtime_policy(&configured,7,
        bounded_heap_bits)!=0){return 33;}
    if(script_context_init_arg(configured,2)!=bounded_heap_bits){return 34;}
    if(compilation_unit_set_script_runtime_policy(&configured,7,
        script_execution_policy_bits(3,1,1,1))==0){return 35;}
    return 0;
}

fn main() i32 {
    let rc1: i32 = build_script("/tmp/zag_script_top_return",
        "script; return 23;");
    if (rc1 != 0) { return rc1; }
    let rc2: i32 = build_script("/tmp/zag_script_uncaught",
        "script; error { Failure } fn fail() !i32 { return error.Failure; } let value: i32 = try fail(); return value;");
    if (rc2 != 0) { return rc2; }
    let rc3: i32 = build_script("/tmp/zag_script_alloc_limit",
        "script; let boundary: *i8 = script_alloc(67108864); let denied: *i8 = script_alloc(1); let used: i64 = script_alloc_used(); if (boundary != null && denied == null && used == 67108864) { return 0; } return 5;");
    if (rc3 != 0) { return rc3; }
    let rc4: i32 = build_script("/tmp/zag_script_explicit_alloc",
        "script; fn script_alloc(n: i64) *i8 { return 0 as *i8; } let p: *i8 = script_alloc(1); if (p == null) { return 19; } return 6;");
    if (rc4 != 0) { return rc4; }
    let rc5: i32 = build_script_limit("/tmp/zag_script_custom_limit",
        "script; let boundary: *i8 = script_alloc(1048576); let denied: *i8 = script_alloc(1); let used: i64 = script_alloc_used(); if (boundary != null && denied == null && used == 1048576) { return 0; } return 8;",
        1048576);
    if (rc5 != 0) { return rc5; }
    let regular_rc: i32 = regular_limit_noop_bytes();
    if (regular_rc != 0) { return regular_rc; }
    let validation_rc: i32 = script_limit_validation();
    if (validation_rc != 0) { return validation_rc; }
    let policy_rc:i32 = script_context_policy_validation();
    if (policy_rc != 0) { return policy_rc; }
    _zag_println("script lowering native generator: PASS");
    return 0;
}
