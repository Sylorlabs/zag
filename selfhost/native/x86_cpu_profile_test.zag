@import("arch/x86/x86_cpu_profile.zag")

fn expect(ok: i32, label: []u8, failures: *i32) void {
    if (ok == 1) { return; }
    _zag_print("FAIL x86 cpu profile: ");
    _zag_println(label);
    failures.* = failures.* + 1;
}

fn main() i32 {
    let failures: i32 = 0;
    let generic: X86CpuProfile = parse_x86_cpu_profile("generic");
    expect(generic.valid == 1, "generic resolves", &failures);
    expect(generic.request_kind == 1, "generic request kind", &failures);
    expect(@strEq(generic.canonical, "x86-64-v1"), "generic canonical name", &failures);
    expect(@strEq(generic.cache_key, "linux-x86_64|x86-64-v1|sse2"), "stable cache key", &failures);
    expect(generic.features.sse2 == 1, "baseline advertises encoder-supported SSE2", &failures);
    expect(generic.features.sse3 + generic.features.ssse3 + generic.features.sse41 +
        generic.features.sse42 + generic.features.popcnt + generic.features.avx +
        generic.features.avx2 + generic.features.fma + generic.features.bmi1 +
        generic.features.bmi2 + generic.features.avx512 == 0,
        "unsupported optional features remain disabled", &failures);

    let named: X86CpuProfile = parse_x86_cpu_profile("--cpu=x86-64-v1");
    expect(named.valid == 1 && named.request_kind == 3, "named profile parses", &failures);
    expect(@strEq(named.cache_key, generic.cache_key), "aliases share cache identity", &failures);
    expect(@strEq(x86_profile_report_json(named), x86_profile_report_json(generic)),
        "report is deterministic across aliases", &failures);

    let fixture: []u8 = "processor : 0\nflags : fpu sse sse2 ssse3 avx avx2 lm\n";
    let native: X86CpuProfile = x86_native_profile_from_cpuinfo("native", fixture);
    expect(native.valid == 1 && native.request_kind == 2, "native resolves from Linux flags", &failures);
    expect(native.features.sse2 == 1 && native.features.ssse3 == 0 && native.features.avx == 0,
        "native permits only implemented encoder features", &failures);
    expect(@strEq(native.detection, "linux-proc-cpuinfo"), "native records discovery authority", &failures);
    expect(@strEq(native.cache_key, "linux-x86_64|native|permitted=sse2"),
        "native cache identity records permitted features", &failures);
    expect(x86_has_token(x86_cpuinfo_flags(fixture), "avx") == 1 &&
        x86_has_token(x86_cpuinfo_flags(fixture), "av") == 0,
        "feature matching uses complete tokens", &failures);
    let missing: X86CpuProfile = x86_native_profile_from_cpuinfo("native", "model name : test\n");
    expect(missing.valid == 0 && missing.features.sse2 == 0 && missing.cache_key.len == 0,
        "missing Linux flags fail closed", &failures);
    let weak: X86CpuProfile = x86_native_profile_from_cpuinfo("native", "flags : sse sse2\n");
    expect(weak.valid == 0, "missing long-mode baseline fails closed", &failures);

    let unknown: X86CpuProfile = parse_x86_cpu_profile("zen99");
    expect(unknown.valid == 0 && unknown.request_kind == 0, "unknown profile rejected", &failures);

    let hw_only: X86Detection = x86_gate_avx(1 << 28, 6, 1 << 5);
    expect(hw_only.avx_usable == 0 && hw_only.avx2_usable == 0,
        "raw AVX hardware bit is insufficient without OSXSAVE", &failures);
    let no_ymm: X86Detection = x86_gate_avx((1 << 28) | (1 << 27), 2, 1 << 5);
    expect(no_ymm.avx_usable == 0 && no_ymm.avx2_usable == 0,
        "OSXSAVE is insufficient without XCR0 YMM state", &failures);
    let qualified: X86Detection = x86_gate_avx((1 << 28) | (1 << 27), 6, 1 << 5);
    expect(qualified.avx_usable == 1 && qualified.avx2_usable == 1,
        "AVX2 requires CPU AVX, OSXSAVE, XMM/YMM state, and AVX2", &failures);
    let live: X86Detection = x86_detect_raw();
    expect(live.available == 1, "raw CPUID discovery executes on x86-64", &failures);
    expect(live.avx2_usable <= live.avx_usable,
        "live AVX2 usability implies AVX usability", &failures);

    if (failures == 0) { _zag_println("x86 cpu profile: pass=25 fail=0"); }
    return failures;
}
