// Smoke test: SUB SP,SP,#16 should encode as FF 43 00 D1 (first byte 255).
@import("arch/aarch64/aarch64.zag")
@import("arch/aarch64/aisa.zag")
fn main() i32 {
    let prog: ArrayList[AInstr] = make[AInstr](8);
    push[AInstr](&prog, ai_label(1));
    push[AInstr](&prog, ai_call(2));
    push[AInstr](&prog, ai_label(2));
    push[AInstr](&prog, ai_mov_imm(A_X0(), 42));
    push[AInstr](&prog, ai_ret());
    let code: ArrayList[u8] = aencode(prog);
    return get[u8](code, 3) as i32;
}