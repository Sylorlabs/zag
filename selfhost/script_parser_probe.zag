@import("parse.zag")

fn main() i32 {
    if (_zag_argc() != 2) { return 2; }
    let src: []u8 = _zag_read_file(_zag_arg(1));
    if (src.len < 0) { return 3; }
    let unit: CompilationUnit = parse_compilation_unit_dir(src, ".");
    if (unit.profile == ModuleProfile.script) { return 0; }
    return 4;
}
