// Exact-key profile ingestion and bounded backend-region planning.
// Profile data is advisory and can never authorize a semantic rewrite.
@import("zagd_store.zag")
@import("semantic_manifest_format.zag")

struct ZagdProfileSample { region:[]u8, count:i64 }
struct ZagdProfile { samples:ArrayList[ZagdProfileSample], valid:i32 }
struct ZagdBackendFeatures { popcnt:i32, bmi1:i32, packed_simd:i32 }
struct ZagdBackendRegionPlan { region:[]u8, kind:i32, selected:i32, supported:i32, reason:[]u8 }
// Foreground profile consumption is deliberately metadata-only until the
// backend has an exact declaration-to-machine-region map.  `codegen_effect`
// remains zero for every result, including a valid hit: profile evidence may
// be reported and used to prioritize later analysis, but can neither select an
// instruction nor alter the foreground machine-cache key.
struct ZagdForegroundProfileUse {
    valid:i32,
    metadata_consumed:i32,
    hot_regions:i32,
    eligible_regions:i32,
    codegen_effect:i32,
    reason:[]u8,
}

fn zagd_backend_none()i32{return 0;}
fn zagd_backend_popcnt()i32{return 1;}
fn zagd_backend_bmi1_andn()i32{return 2;}
fn zagd_backend_packed_simd()i32{return 3;}

fn zp_safe_region(s:[]u8)i32{if(s.len==0||s.len>128){return 0;}let i:i32=0;while(i<s.len){let c:u8=s[i];if(!((c>='a'&&c<='z')||(c>='A'&&c<='Z')||(c>='0'&&c<='9')||c=='_'||c=='.'||c=='-')){return 0;}i=i+1;}return 1;}
fn zp_line_value(line:[]u8,key:[]u8)[]u8{if(line.len>key.len&&@strEq(line[0..key.len],key)&&line[key.len]=='='){return line[key.len+1..];}return "";}
fn zp_checksum_valid(text:[]u8)i32{let marker:[]u8="checksum_first=";let mark:i32=0-1;let i:i32=0;while(i+marker.len<=text.len){if((i==0||text[i-1]=='\n')&&@strEq(text[i..i+marker.len],marker)){mark=i;}i=i+1;}if(mark<0){return 0;}let value:[]u8=zagd_record_value(text,"checksum_first");if(mark+marker.len+value.len+1!=text.len){return 0;}return (zagd_parse_nonnegative(value)==zagd_content_hash(text[0..mark]).first) as i32;}

// Shared semantic identity for daemon production and foreground validation.
// Keep this independent of a host CPU query: the caller supplies the already
// resolved compiler version and target cache key.
fn zagd_profile_semantic_identity(text:[]u8,compiler:[]u8,target_key:[]u8)ZagdHash{
    let view:SemanticManifestView=semantic_manifest_decode(text);
    if(view.valid==0||compiler.len==0||target_key.len==0){return zagd_hash_empty();}
    let artifact:ZagdHash=semantic_manifest_artifact_identity(text,compiler,target_key);
    let header:ArrayList[u8]=make[u8](128);
    smf_append(&header,"zagd-plan-semantics-v2\nartifact=");
    smf_append_i64(&header,artifact.first);smf_append(&header,"\t");
    smf_append_i64(&header,artifact.second);smf_append(&header,"\t");
    smf_append_i64(&header,artifact.bytes);
    smf_append(&header,"\nprofile=");smf_append(&header,smf_value(text,"profile"));
    let identity:ZagdHash=zagd_content_hash(header.data[0..header.len]);free[u8](&header);
    let start:i32=0;let i:i32=0;
    while(i<=text.len){
        if(i==text.len||text[i]=='\n'){
            let line:[]u8=text[start..i];
            if(line.len>12&&@strEq(line[0..12],"module_node=")){
                let node:[]u8=line[12..];let tab:i32=0;
                while(tab<node.len&&node[tab]!='\t'){tab=tab+1;}
                if(tab==node.len){return zagd_hash_empty();}
                identity=zagd_hash_extend(identity,"module=");
                identity=zagd_hash_extend(identity,node[0..tab]);
            }else if(line.len>12&&@strEq(line[0..12],"import_edge=")){
                identity=zagd_hash_extend(identity,line);
            }
            start=i+1;
        }
        i=i+1;
    }
    return identity;
}

fn zpf_bad(reason:[]u8)ZagdForegroundProfileUse{
    return ZagdForegroundProfileUse{.valid=0,.metadata_consumed=0,.hot_regions=0,
        .eligible_regions=0,.codegen_effect=0,.reason=reason};
}
fn zpf_key_count(text:[]u8,key:[]u8)i32{
    let count:i32=0;let start:i32=0;let i:i32=0;
    while(i<=text.len){
        if(i==text.len||text[i]=='\n'){
            let line:[]u8=text[start..i];
            if(line.len>key.len&&@strEq(line[0..key.len],key)&&line[key.len]=='='){count=count+1;}
            start=i+1;
        }
        i=i+1;
    }
    return count;
}
fn zpf_single(text:[]u8,key:[]u8)i32{return (zpf_key_count(text,key)==1) as i32;}
fn zpf_hash(value:[]u8)ZagdHash{
    return ZagdHash{.first=zagd_parse_nonnegative(zstore_tab_field(value,0)),
        .second=zagd_parse_nonnegative(zstore_tab_field(value,1)),
        .bytes=zagd_parse_nonnegative(zstore_tab_field(value,2))};
}
fn zpf_hash_valid(value:[]u8)i32{
    let tabs:i32=0;let i:i32=0;while(i<value.len){if(value[i]=='\t'){tabs=tabs+1;}i=i+1;}
    let h:ZagdHash=zpf_hash(value);
    return (tabs==2&&h.first>=0&&h.second>=0&&h.bytes>=0) as i32;
}
fn zpf_checksum_valid(text:[]u8)i32{
    let mark:i32=zagd_find_checksum(text);if(mark<0){return 0;}
    if(zpf_single(text,"checksum_first")==0||zpf_single(text,"checksum_second")==0||
        zpf_single(text,"checksum_bytes")==0){return 0;}
    let bytes_value:[]u8=zagd_record_value(text,"checksum_bytes");
    let i:i32=mark;
    // The three checksum lines must be the exact suffix; trailing or reordered
    // bytes are rejected rather than ignored.
    while(i<text.len&&text[i]!='\n'){i=i+1;}if(i>=text.len){return 0;}
    let second_start:i32=i+1;let second:[]u8="checksum_second=";
    if(second_start+second.len>text.len||!@strEq(text[second_start..second_start+second.len],second)){return 0;}
    i=second_start;while(i<text.len&&text[i]!='\n'){i=i+1;}if(i>=text.len){return 0;}
    let bytes_start:i32=i+1;let bytes_key:[]u8="checksum_bytes=";
    if(bytes_start+bytes_key.len>text.len||!@strEq(text[bytes_start..bytes_start+bytes_key.len],bytes_key)){return 0;}
    i=bytes_start;while(i<text.len&&text[i]!='\n'){i=i+1;}
    if(i+1!=text.len||!@strEq(text[bytes_start+bytes_key.len..i],bytes_value)){return 0;}
    let sum:ZagdHash=zagd_content_hash(text[0..mark]);
    return (zagd_parse_nonnegative(zagd_record_value(text,"checksum_first"))==sum.first&&
        zagd_parse_nonnegative(zagd_record_value(text,"checksum_second"))==sum.second&&
        zagd_parse_nonnegative(bytes_value)==sum.bytes) as i32;
}
fn zpf_row_field(row:[]u8,key:[]u8)[]u8{
    let start:i32=0;let i:i32=0;
    while(i<=row.len){
        if(i==row.len||row[i]=='\t'){
            let field:[]u8=row[start..i];
            if(field.len>key.len&&@strEq(field[0..key.len],key)&&field[key.len]=='='){return field[key.len+1..];}
            start=i+1;
        }
        i=i+1;
    }
    return "";
}
fn zpf_row_field_count(row:[]u8,key:[]u8)i32{
    let count:i32=0;let start:i32=0;let i:i32=0;
    while(i<=row.len){
        if(i==row.len||row[i]=='\t'){
            let field:[]u8=row[start..i];
            if(field.len>key.len&&@strEq(field[0..key.len],key)&&field[key.len]=='='){count=count+1;}
            start=i+1;
        }
        i=i+1;
    }
    return count;
}
fn zpf_manifest_declared(text:[]u8,name:[]u8)i32{
    let start:i32=0;let i:i32=0;
    while(i<=text.len){
        if(i==text.len||text[i]=='\n'){
            let line:[]u8=text[start..i];
            if(@strEq(smf_decl_name(line),name)){return 1;}
            start=i+1;
        }
        i=i+1;
    }
    return 0;
}
fn zpf_region_seen(text:[]u8,before:i32,name:[]u8)i32{
    let start:i32=0;let i:i32=0;
    while(i<before){
        if(text[i]=='\n'){
            let line:[]u8=text[start..i];
            if(line.len>7&&@strEq(line[0..7],"region=")){
                let row:[]u8=line[7..];let tab:i32=0;while(tab<row.len&&row[tab]!='\t'){tab=tab+1;}
                if(@strEq(row[0..tab],name)){return 1;}
            }
            start=i+1;
        }
        i=i+1;
    }
    return 0;
}

// Decode a v3 profile plan for foreground metadata use. Every identity is
// checked against current foreground inputs. A valid result still has
// `codegen_effect=0`; stale or corrupt evidence is a silent optimization miss.
fn zagd_foreground_profile_consume(text:[]u8,semantic_text:[]u8,
    compiler_version:[]u8,compiler_identity:ZagdHash,target_key:[]u8)ZagdForegroundProfileUse{
    if(text.len<=0||text.len>65536){return zpf_bad("missing-or-oversized-plan");}
    if(compiler_version.len==0||compiler_identity.bytes<=0||target_key.len==0){
        return zpf_bad("foreground-input-unavailable");
    }
    if(zpf_single(text,"format")==0||zpf_single(text,"advisory")==0||
        zpf_single(text,"executable_authority")==0||zpf_single(text,"foreground_consumption")==0||
        zpf_single(text,"codegen_effect")==0||zpf_single(text,"mode")==0||
        zpf_single(text,"source_changes")==0||zpf_single(text,"compiler")==0||
        zpf_single(text,"foreground_compiler_identity")==0||zpf_single(text,"target_cache_key")==0||
        zpf_single(text,"semantic_source")==0||zpf_single(text,"semantic_graph")==0||
        zpf_single(text,"semantic_graph_complete")==0||zpf_single(text,"profile_source_identity")==0||
        zpf_single(text,"target_identity")==0||zpf_single(text,"semantic_identity")==0||
        zpf_single(text,"profile_compiler_identity")==0||zpf_single(text,"profile_payload_identity")==0||
        zpf_single(text,"profile_samples")==0||zpf_single(text,"hot_regions")==0||
        zpf_single(text,"eligible_regions")==0||
        zpf_checksum_valid(text)==0){return zpf_bad("invalid-plan");}
    if(!@strEq(zagd_record_value(text,"format"),"zagd-profile-plan-v3")||
        !@strEq(zagd_record_value(text,"advisory"),"true")||
        !@strEq(zagd_record_value(text,"executable_authority"),"false")||
        !@strEq(zagd_record_value(text,"foreground_consumption"),"metadata-only")||
        !@strEq(zagd_record_value(text,"codegen_effect"),"none")||
        !@strEq(zagd_record_value(text,"mode"),"deep")||
        !@strEq(zagd_record_value(text,"source_changes"),"false")){
        return zpf_bad("invalid-authority");
    }
    if(!@strEq(zagd_record_value(text,"compiler"),compiler_version)||
        zpf_hash_valid(zagd_record_value(text,"foreground_compiler_identity"))==0||
        zagd_hash_equal(zpf_hash(zagd_record_value(text,"foreground_compiler_identity")),compiler_identity)==0){
        return zpf_bad("stale-compiler");
    }
    let manifest:SemanticManifestView=semantic_manifest_decode(semantic_text);
    if(manifest.valid==0||manifest.graph_complete!=1||
        zagd_parse_nonnegative(zagd_record_value(text,"semantic_graph_complete"))!=1){
        return zpf_bad("incomplete-semantic-graph");
    }
    if(zpf_hash_valid(zagd_record_value(text,"semantic_source"))==0||
        zagd_hash_equal(zpf_hash(zagd_record_value(text,"semantic_source")),manifest.source)==0){
        return zpf_bad("stale-source");
    }
    if(zpf_hash_valid(zagd_record_value(text,"semantic_graph"))==0||
        zagd_hash_equal(zpf_hash(zagd_record_value(text,"semantic_graph")),manifest.graph_identity)==0){
        return zpf_bad("stale-graph");
    }
    let target:ZagdHash=zagd_content_hash(target_key);
    if(!@strEq(zagd_record_value(text,"target_cache_key"),target_key)||
        zpf_hash_valid(zagd_record_value(text,"target_identity"))==0||
        zagd_hash_equal(zpf_hash(zagd_record_value(text,"target_identity")),target)==0){
        return zpf_bad("stale-target");
    }
    let semantic_identity:ZagdHash=zagd_profile_semantic_identity(semantic_text,compiler_version,target_key);
    if(semantic_identity.bytes<=0||zpf_hash_valid(zagd_record_value(text,"profile_source_identity"))==0||
        zpf_hash_valid(zagd_record_value(text,"semantic_identity"))==0||
        zagd_hash_equal(zpf_hash(zagd_record_value(text,"profile_source_identity")),semantic_identity)==0||
        zagd_hash_equal(zpf_hash(zagd_record_value(text,"semantic_identity")),semantic_identity)==0){
        return zpf_bad("stale-semantic-identity");
    }
    if(zpf_hash_valid(zagd_record_value(text,"profile_compiler_identity"))==0||
        zpf_hash_valid(zagd_record_value(text,"profile_payload_identity"))==0){
        return zpf_bad("invalid-profile-provenance");
    }
    let profile_samples:i64=zagd_parse_nonnegative(zagd_record_value(text,"profile_samples"));
    let claimed_hot:i64=zagd_parse_nonnegative(zagd_record_value(text,"hot_regions"));
    let claimed_eligible:i64=zagd_parse_nonnegative(zagd_record_value(text,"eligible_regions"));
    if(profile_samples<0||profile_samples>256||claimed_hot<0||claimed_hot>16||
        claimed_hot>profile_samples||claimed_eligible<0||claimed_eligible>claimed_hot){
        return zpf_bad("invalid-region-count");
    }
    let hot:i32=0;let eligible:i32=0;let start:i32=0;let i:i32=0;
    while(i<=text.len){
        if(i==text.len||text[i]=='\n'){
            let line:[]u8=text[start..i];
            if(line.len>7&&@strEq(line[0..7],"region=")){
                let row:[]u8=line[7..];let tab:i32=0;while(tab<row.len&&row[tab]!='\t'){tab=tab+1;}
                let name:[]u8=row[0..tab];
                if(tab==row.len||zp_safe_region(name)==0||zpf_region_seen(text,start,name)==1||
                    zpf_row_field_count(row,"count")!=1||zpf_row_field_count(row,"backend_kind")!=1||
                    zpf_row_field_count(row,"semantic_declared")!=1||
                    zpf_row_field_count(row,"instruction_permitted")!=1||
                    zpf_row_field_count(row,"decision")!=1||zpf_row_field_count(row,"reason")!=1){
                    return zpf_bad("invalid-region-row");
                }
                let count:i64=zagd_parse_nonnegative(zpf_row_field(row,"count"));
                let kind:i64=zagd_parse_nonnegative(zpf_row_field(row,"backend_kind"));
                let declared:i64=zagd_parse_nonnegative(zpf_row_field(row,"semantic_declared"));
                let permitted:i64=zagd_parse_nonnegative(zpf_row_field(row,"instruction_permitted"));
                let decision:[]u8=zpf_row_field(row,"decision");
                if(count<=0||kind<0||kind>zagd_backend_packed_simd()||
                    (declared!=0&&declared!=1)||(permitted!=0&&permitted!=1)||
                    (!@strEq(decision,"advisory_only")&&!@strEq(decision,"rejected"))){
                    return zpf_bad("invalid-region-row");
                }
                if(declared==1&&zpf_manifest_declared(semantic_text,name)==0){
                    return zpf_bad("stale-region");
                }
                if(@strEq(decision,"advisory_only")){
                    if(declared!=1||permitted!=1){return zpf_bad("invalid-region-authority");}
                    eligible=eligible+1;
                }else if(declared==1&&permitted==1){
                    return zpf_bad("inconsistent-region-decision");
                }
                hot=hot+1;if(hot>16){return zpf_bad("invalid-region-count");}
            }
            start=i+1;
        }
        i=i+1;
    }
    if(hot!=claimed_hot||eligible!=claimed_eligible){return zpf_bad("invalid-region-count");}
    return ZagdForegroundProfileUse{.valid=1,.metadata_consumed=1,.hot_regions=hot,
        .eligible_regions=eligible,.codegen_effect=0,.reason="validated-metadata-only"};
}

// Required identity fields bind samples to one compiler/source/target. Unknown,
// stale, truncated, oversized, or malformed records are misses.
fn zagd_profile_decode(text:[]u8,compiler:ZagdHash,source:ZagdHash,target:ZagdHash,max_samples:i32)ZagdProfile{
    let out:ZagdProfile=ZagdProfile{.samples=make[ZagdProfileSample](4),.valid=0};if(max_samples<1||max_samples>4096||!@strEq(zagd_record_value(text,"format"),"zagd-profile-v1")||zagd_parse_nonnegative(zagd_record_value(text,"compiler_first"))!=compiler.first||zagd_parse_nonnegative(zagd_record_value(text,"compiler_second"))!=compiler.second||zagd_parse_nonnegative(zagd_record_value(text,"source_first"))!=source.first||zagd_parse_nonnegative(zagd_record_value(text,"source_second"))!=source.second||zagd_parse_nonnegative(zagd_record_value(text,"target_first"))!=target.first||zagd_parse_nonnegative(zagd_record_value(text,"target_second"))!=target.second||zp_checksum_valid(text)==0){return out;}
    let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];let value:[]u8=zp_line_value(line,"hot");if(value.len>0){let tab:i32=0-1;let j:i32=0;while(j<value.len){if(value[j]=='\t'){tab=j;}j=j+1;}if(tab<1||out.samples.len>=max_samples){return out;}let region:[]u8=value[0..tab];let count:i64=zagd_parse_nonnegative(value[tab+1..]);if(zp_safe_region(region)==0||count<=0){return out;}push[ZagdProfileSample](&out.samples,ZagdProfileSample{.region=region,.count=count});}start=i+1;}i=i+1;}out.valid=1;return out;
}

fn zp_before(a:ZagdProfileSample,b:ZagdProfileSample)i32{if(a.count>b.count){return 1;}if(a.count<b.count){return 0;}let n:i32=a.region.len;if(b.region.len<n){n=b.region.len;}let i:i32=0;while(i<n){if(a.region[i]<b.region[i]){return 1;}if(a.region[i]>b.region[i]){return 0;}i=i+1;}return (a.region.len<b.region.len) as i32;}
fn zagd_select_hot_regions(profile:ZagdProfile,budget:i32)ArrayList[ZagdProfileSample]{let out:ArrayList[ZagdProfileSample]=make[ZagdProfileSample](4);if(profile.valid==0||budget<1){return out;}let used:ArrayList[i32]=make[i32](profile.samples.len+1);let i:i32=0;while(i<profile.samples.len){push[i32](&used,0);i=i+1;}while(out.len<budget&&out.len<profile.samples.len){let best:i32=0-1;i=0;while(i<profile.samples.len){if(used.data[i]==0&&(best<0||zp_before(profile.samples.data[i],profile.samples.data[best])==1)){best=i;}i=i+1;}if(best<0){break;}used.data[best]=1;push[ZagdProfileSample](&out,profile.samples.data[best]);}free[i32](&used);return out;}

// Only optional instructions already emitted and tested by ncodegen may become
// selected plans. Packed SIMD is recorded as unsupported until a packed encoder
// and differential tests exist; CPUID alone never selects it.
fn zagd_backend_plan(hot:ArrayList[ZagdProfileSample],features:ZagdBackendFeatures)ArrayList[ZagdBackendRegionPlan]{let out:ArrayList[ZagdBackendRegionPlan]=make[ZagdBackendRegionPlan](hot.len+1);let i:i32=0;while(i<hot.len){let r:[]u8=hot.data[i].region;if(@strEq(r,"popcount")){push[ZagdBackendRegionPlan](&out,ZagdBackendRegionPlan{.region=r,.kind=zagd_backend_popcnt(),.selected=features.popcnt,.supported=features.popcnt,.reason="implemented POPCNT lowering"});}else if(@strEq(r,"andn")){push[ZagdBackendRegionPlan](&out,ZagdBackendRegionPlan{.region=r,.kind=zagd_backend_bmi1_andn(),.selected=features.bmi1,.supported=features.bmi1,.reason="implemented BMI1 ANDN lowering"});}else if(@strEq(r,"simd-packed")){push[ZagdBackendRegionPlan](&out,ZagdBackendRegionPlan{.region=r,.kind=zagd_backend_packed_simd(),.selected=0,.supported=0,.reason="packed SIMD encoder not implemented"});}else{push[ZagdBackendRegionPlan](&out,ZagdBackendRegionPlan{.region=r,.kind=zagd_backend_none(),.selected=0,.supported=0,.reason="no validated backend candidate"});}i=i+1;}return out;}

// A profile label is never enough to name a candidate.  It must also name a
// function declaration in the exact semantic manifest that the daemon has
// already accepted.  This is deliberately a narrow line reader rather than a
// source-text search: comments, strings, imported filenames, and a merely
// similar prefix do not establish a region identity.
fn zagd_profile_manifest_declared(semantic_text:[]u8,region:[]u8)i32{
    let start:i32=0;let i:i32=0;
    while(i<=semantic_text.len){
        if(i==semantic_text.len||semantic_text[i]=='\n'){
            let line:[]u8=semantic_text[start..i];
            if(line.len>8&&@strEq(line[0..8],"decl_fn=")){
                let end:i32=8;while(end<line.len&&line[end]!='\t'){end=end+1;}
                if(@strEq(line[8..end],region)){return 1;}
            }
            start=i+1;
        }
        i=i+1;
    }
    return 0;
}

// This is an evidence filter, not instruction selection.  Existing lowering
// remains wholly owned by the foreground compiler and its explicit --cpu
// target.  A profile row whose region no longer exists is retained only as a
// rejected advisory fact with a deterministic reason.
fn zagd_backend_plan_validated(hot:ArrayList[ZagdProfileSample],features:ZagdBackendFeatures,semantic_text:[]u8)ArrayList[ZagdBackendRegionPlan]{
    let out:ArrayList[ZagdBackendRegionPlan]=zagd_backend_plan(hot,features);
    let i:i32=0;
    while(i<out.len){
        if(zagd_profile_manifest_declared(semantic_text,out.data[i].region)==0){
            out.data[i].selected=0;
            out.data[i].supported=0;
            out.data[i].reason="profile region absent from current semantic manifest";
        }
        i=i+1;
    }
    return out;
}
