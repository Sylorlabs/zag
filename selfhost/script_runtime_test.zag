@import("script_runtime.zag")

fn sr_expect(ok: i32, label: []u8, failures: *i32) void {
    if (ok == 1) { return; }
    _zag_print("FAIL script runtime: ");
    _zag_println(label);
    failures.* = failures.* + 1;
}

fn main() i32 {
    let failures: i32 = 0;
    let fake_args: ArrayList[[]u8] = make[[]u8](2);
    push[[]u8](&fake_args, "app.zag");
    push[[]u8](&fake_args, "input.txt");
    let ctx: ScriptContext = script_context_init_with(8, fake_args);

    sr_expect(len[[]u8](ctx.args) == 2, "arguments represented in context", &failures);
    sr_expect(@strEq(get[[]u8](ctx.args, 1), "input.txt"), "argument order preserved", &failures);
    sr_expect(ctx.capabilities.bits == 3 && ctx.capabilities.filesystem_read == 1 &&
        ctx.capabilities.network == 0 &&
        ctx.capabilities.process == 0 && ctx.capabilities.environment_read == 0 &&
        ctx.capabilities.device == 0,
        "capabilities are concrete and conservative", &failures);
    sr_expect(ctx.environment.read_only == 1 && ctx.environment.lookup_available == 0,
        "environment policy is read-only and denied by default", &failures);
    sr_expect(ctx.limits.max_memory_bytes == 8 && ctx.limits.process_timeout_ms == 30000,
        "limits are concrete", &failures);
    sr_expect(ctx.execution.allocator_id == 1 && ctx.execution.cpu_id == 1 &&
        ctx.execution.device_id == 1 && ctx.execution.layout_id == 1 &&
        ctx.allocator.policy_id == ctx.execution.allocator_id,
        "validated execution policy is retained by allocator state", &failures);
    sr_expect(ctx.error_reporter.uncaught_to_stderr == 1 &&
        ctx.error_reporter.include_source == 1 &&
        ctx.error_reporter.include_operation == 1 &&
        ctx.error_reporter.failure_exit_status == 1,
        "error reporter policy is explicit", &failures);

    let native_policy: ScriptExecutionPolicy = ScriptExecutionPolicy{
        .allocator_id = 1, .cpu_id = 2, .device_id = 1, .layout_id = 1 };
    let restricted: ScriptContext =
        script_context_init_policy_with(8, fake_args, 4, native_policy);
    sr_expect(restricted.capabilities.bits == 4 &&
        restricted.capabilities.filesystem_read == 0 &&
        restricted.capabilities.filesystem_write == 0 &&
        restricted.capabilities.process == 1 &&
        restricted.execution.cpu_id == 2,
        "configured capability and CPU policy metadata is preserved", &failures);

    let environment_enabled: ScriptContext =
        script_context_init_policy_with(8, fake_args, 8, native_policy);
    sr_expect(environment_enabled.capabilities.environment_read == 1 &&
        environment_enabled.environment.read_only == 1 &&
        environment_enabled.environment.lookup_available == 1,
        "environment lookup metadata requires an explicit capability", &failures);

    let heap_policy:ScriptExecutionPolicy=ScriptExecutionPolicy{
        .allocator_id=2,.cpu_id=1,.device_id=1,.layout_id=1};
    let heap_ctx:ScriptContext=
        script_context_init_policy_with(64,fake_args,3,heap_policy);
    let heap_value:ScriptAllocation=script_alloc(&heap_ctx,5);
    sr_expect(heap_value.ok==1&&heap_ctx.allocator.used_bytes==21,
        "bounded heap charges payload plus ownership header",&failures);
    let heap_empty:ScriptAllocation=script_alloc(&heap_ctx,0);
    sr_expect(heap_empty.ok==1&&heap_ctx.allocator.used_bytes==37,
        "bounded heap zero request still consumes header budget",&failures);
    let heap_over:ScriptAllocation=script_alloc(&heap_ctx,12);
    sr_expect(heap_over.ok==0&&heap_ctx.allocator.used_bytes==37,
        "bounded heap header charge participates in limit failure",&failures);

    let first: ScriptAllocation = script_alloc(&ctx, 5);
    sr_expect(first.ok == 1 && first.bytes.len == 5, "bounded allocation succeeds", &failures);
    sr_expect(ctx.allocator.used_bytes == 5 && ctx.allocator.allocation_count == 1,
        "successful allocation accounted", &failures);
    let over: ScriptAllocation = script_alloc(&ctx, 4);
    sr_expect(over.ok == 0 && @strEq(over.diagnostic, "script memory limit exceeded"),
        "limit failure is explicit", &failures);
    sr_expect(ctx.allocator.used_bytes == 5 && ctx.allocator.failed_allocations == 1,
        "failed allocation does not consume budget", &failures);
    let rest: ScriptAllocation = script_alloc(&ctx, 3);
    sr_expect(rest.ok == 1 && ctx.allocator.used_bytes == 8, "remaining budget usable", &failures);

    let wide_ctx: ScriptContext = script_context_init_with(3000000000, fake_args);
    let oversized: ScriptAllocation = script_alloc(&wide_ctx, 2147483648);
    sr_expect(oversized.ok == 0 && oversized.bytes.len == 0 &&
        wide_ctx.allocator.used_bytes == 0, "native representation overflow rejected without allocation", &failures);

    script_shutdown(&ctx);
    sr_expect(ctx.runtime.running == 0 && ctx.runtime.output_flushed == 1 &&
        ctx.runtime.shutdown_complete == 1, "shutdown and flush state deterministic", &failures);
    script_shutdown(&ctx);
    sr_expect(ctx.runtime.shutdown_complete == 1, "shutdown is idempotent", &failures);
    let late: ScriptAllocation = script_alloc(&ctx, 0);
    sr_expect(late.ok == 0 && late.diagnostic.len > 0, "allocation after shutdown rejected", &failures);

    if (failures == 0) { _zag_println("script runtime: pass=20 fail=0"); }
    return failures;
}
