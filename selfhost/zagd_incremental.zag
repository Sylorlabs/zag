// Persisted declaration fingerprints for zagd light mode. This cache is
// advisory only: malformed, stale, or unknown facts force conservative work.
@import("zagd.zag")
@import("zagd_linux.zag")

struct ZagdDeclFingerprint { name:[]u8, kind:i32, public:i32, parse:ZagdHash, signature:ZagdHash, layout:ZagdHash, body:ZagdHash, callers:ZagdHash, codegen_region:ZagdHash }
struct ZagdIncrementalFile { path:[]u8, content:ZagdHash, parse:ZagdHash, declarations:ArrayList[ZagdDeclFingerprint], root:ZagdHash, target:ZagdHash, valid:i32, advisory:i32, executable_authority:i32 }
// A project index is deliberately advisory.  Every entry is revalidated from
// source bytes before it can influence an incremental decision; it never owns
// executable output or makes a foreground build depend on the daemon.
// The lexical fingerprints below are only a cheap parser cache. They do not
// constitute a dependency graph. `graph_identity` is bound later to the
// checksum-validated foreground semantic manifest; without a complete bind no
// index may claim localized dependency reuse.
struct ZagdIncrementalIndex { files:ArrayList[ZagdIncrementalFile], graph_identity:ZagdHash, graph_complete:i32, valid:i32, advisory:i32, executable_authority:i32 }
struct ZagdIncrementalDecision { change:i32, reuse_parse:i32, invalidate_types:i32, invalidate_layouts:i32, invalidate_functions:i32, invalidate_callers:i32, invalidate_codegen:i32 }

fn zi_num(s:[]u8)i64{if(s.len==0){return 0-1;}let n:i64=0;let i:i32=0;while(i<s.len){if(s[i]<'0'||s[i]>'9'){return 0-1;}n=n*10+(s[i] as i64)-48;i=i+1;}return n;}
fn zi_value(text:[]u8,key:[]u8)[]u8{let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>key.len&&@strEq(line[0..key.len],key)&&line[key.len]=='='){return line[key.len+1..];}start=i+1;}i=i+1;}return "";}
fn zi_tab(line:[]u8,want:i32)[]u8{let f:i32=0;let start:i32=0;let i:i32=0;while(i<=line.len){if(i==line.len||line[i]=='\t'){if(f==want){return line[start..i];}f=f+1;start=i+1;}i=i+1;}return "";}
fn zi_hash_text(h:ZagdHash)[]u8{return _zag_str_concat(_zag_i64_to_str(h.first),_zag_str_concat("\t",_zag_str_concat(_zag_i64_to_str(h.second),_zag_str_concat("\t",_zag_i64_to_str(h.bytes)))));}
fn zi_hash(line:[]u8,at:i32)ZagdHash{return ZagdHash{.first=zi_num(zi_tab(line,at)),.second=zi_num(zi_tab(line,at+1)),.bytes=zi_num(zi_tab(line,at+2))};}
fn zi_safe(s:[]u8)i32{if(s.len==0){return 0;}let i:i32=0;while(i<s.len){if(s[i]=='\n'||s[i]=='\r'||s[i]=='\t'||s[i]=='='){return 0;}i=i+1;}return 1;}
fn zi_bad()ZagdIncrementalFile{return ZagdIncrementalFile{.path="",.content=zagd_hash_empty(),.parse=zagd_hash_empty(),.declarations=make[ZagdDeclFingerprint](1),.root=zagd_hash_empty(),.target=zagd_hash_empty(),.valid=0,.advisory=1,.executable_authority=0};}
fn zi_index_bad()ZagdIncrementalIndex{return ZagdIncrementalIndex{.files=make[ZagdIncrementalFile](8),.graph_identity=zagd_hash_empty(),.graph_complete=0,.valid=0,.advisory=1,.executable_authority=0};}
fn zagd_incremental_index_find(index:ZagdIncrementalIndex,path:[]u8)i32{let i:i32=0;while(i<index.files.len){if(@strEq(index.files.data[i].path,path)){return i;}i=i+1;}return 0-1;}
fn zagd_incremental_index_get(index:ZagdIncrementalIndex,path:[]u8)ZagdIncrementalFile{let found:i32=zagd_incremental_index_find(index,path);if(found<0){return zi_bad();}return index.files.data[found];}
fn zagd_incremental_index_put(index:*ZagdIncrementalIndex,file:ZagdIncrementalFile)void{let found:i32=zagd_incremental_index_find(index.*,file.path);if(found<0){push[ZagdIncrementalFile](&index.*.files,file);}else{free[ZagdDeclFingerprint](&index.*.files.data[found].declarations);index.*.files.data[found]=file;}}
fn zagd_incremental_index_remove(index:*ZagdIncrementalIndex,path:[]u8)i32{let found:i32=zagd_incremental_index_find(index.*,path);if(found<0){return 0;}free[ZagdDeclFingerprint](&index.*.files.data[found].declarations);let i:i32=found;while(i+1<index.*.files.len){index.*.files.data[i]=index.*.files.data[i+1];i=i+1;}index.*.files.len=index.*.files.len-1;return 1;}

fn zi_space(c:u8)i32{return (c==' '||c=='\t'||c=='\r'||c=='\n') as i32;}
fn zi_ident(c:u8)i32{return ((c>='a'&&c<='z')||(c>='A'&&c<='Z')||(c>='0'&&c<='9')||c=='_') as i32;}
fn zi_word(s:[]u8,at:i32,w:[]u8)i32{if(at+w.len>s.len||(at>0&&zi_ident(s[at-1])==1)||(at+w.len<s.len&&zi_ident(s[at+w.len])==1)){return 0;}let i:i32=0;while(i<w.len){if(s[at+i]!=w[i]){return 0;}i=i+1;}return 1;}
fn zi_canonical(s:[]u8)ZagdHash{let h:ZagdHash=zagd_hash_empty();let i:i32=0;let quote:u8=0;let escape:i32=0;let block:i32=0;while(i<s.len){let c:u8=s[i];if(block>0){if(i+1<s.len&&c=='/'&&s[i+1]=='*'){block=block+1;i=i+2;}else if(i+1<s.len&&c=='*'&&s[i+1]=='/'){block=block-1;i=i+2;}else{i=i+1;}continue;}if(quote!=0){h=zagd_hash_extend(h,s[i..i+1]);if(escape==1){escape=0;}else if(c=='\\'){escape=1;}else if(c==quote){quote=0;}i=i+1;continue;}if(i+1<s.len&&c=='/'&&s[i+1]=='/'){i=i+2;while(i<s.len&&s[i]!='\n'){i=i+1;}continue;}if(i+1<s.len&&c=='/'&&s[i+1]=='*'){block=1;i=i+2;continue;}if(zi_space(c)==1){i=i+1;continue;}if(c=='"'||c=='\''){quote=c;}h=zagd_hash_extend(h,s[i..i+1]);i=i+1;}if(quote!=0||block!=0){return ZagdHash{.first=0-1,.second=0,.bytes=0};}return h;}
fn zi_calls(s:[]u8)ZagdHash{let h:ZagdHash=zagd_hash_empty();let i:i32=0;let block:i32=0;let quote:u8=0;let escape:i32=0;while(i<s.len){let c:u8=s[i];if(block>0){if(i+1<s.len&&c=='/'&&s[i+1]=='*'){block=block+1;i=i+2;}else if(i+1<s.len&&c=='*'&&s[i+1]=='/'){block=block-1;i=i+2;}else{i=i+1;}continue;}if(quote!=0){if(escape==1){escape=0;}else if(c=='\\'){escape=1;}else if(c==quote){quote=0;}i=i+1;continue;}if(i+1<s.len&&c=='/'&&s[i+1]=='/'){i=i+2;while(i<s.len&&s[i]!='\n'){i=i+1;}continue;}if(i+1<s.len&&c=='/'&&s[i+1]=='*'){block=1;i=i+2;continue;}if(c=='"'||c=='\''){quote=c;i=i+1;continue;}if((c>='a'&&c<='z')||(c>='A'&&c<='Z')||c=='_'){let start:i32=i;i=i+1;while(i<s.len&&zi_ident(s[i])==1){i=i+1;}let j:i32=i;while(j<s.len&&zi_space(s[j])==1){j=j+1;}if(j<s.len&&s[j]=='('){h=zagd_hash_extend(h,s[start..i]);}}else{i=i+1;}}return h;}

fn zagd_incremental_extract(path:[]u8,source:[]u8,facts:ZagdSourceFacts,target:[]u8)ZagdIncrementalFile{
    let out:ZagdIncrementalFile=ZagdIncrementalFile{.path=path,.content=facts.content,.parse=facts.semantic,.declarations=make[ZagdDeclFingerprint](4),.root=facts.root_profile,.target=zagd_content_hash(target),.valid=facts.valid,.advisory=1,.executable_authority=0};if(facts.valid!=1){return out;}
    let i:i32=0;while(i<source.len){if(i+1<source.len&&source[i]=='/'&&source[i+1]=='/'){i=i+2;while(i<source.len&&source[i]!='\n'){i=i+1;}continue;}if(i+1<source.len&&source[i]=='/'&&source[i+1]=='*'){let bd:i32=1;i=i+2;while(i<source.len&&bd>0){if(i+1<source.len&&source[i]=='/'&&source[i+1]=='*'){bd=bd+1;i=i+2;}else if(i+1<source.len&&source[i]=='*'&&source[i+1]=='/'){bd=bd-1;i=i+2;}else{i=i+1;}}if(bd!=0){out.valid=0;return out;}continue;}if(source[i]=='"'||source[i]=='\''){let q:u8=source[i];let esc:i32=0;i=i+1;while(i<source.len){let c:u8=source[i];i=i+1;if(esc==1){esc=0;}else if(c=='\\'){esc=1;}else if(c==q){break;}}continue;}let start:i32=i;let pub:i32=0;if(zi_word(source,i,"pub")==1){pub=1;i=i+3;while(i<source.len&&zi_space(source[i])==1){i=i+1;}}let kind:i32=0;let kw:i32=0;if(zi_word(source,i,"fn")==1){kind=1;kw=2;}else if(zi_word(source,i,"struct")==1){kind=2;kw=6;}if(kind==0){i=start+1;continue;}i=i+kw;while(i<source.len&&zi_space(source[i])==1){i=i+1;}let ns:i32=i;while(i<source.len&&zi_ident(source[i])==1){i=i+1;}if(i==ns){out.valid=0;return out;}let name:[]u8=source[ns..i];let open:i32=i;let oq:u8=0;let oe:i32=0;let ob:i32=0;while(open<source.len){let c:u8=source[open];if(ob>0){if(open+1<source.len&&c=='/'&&source[open+1]=='*'){ob=ob+1;open=open+2;}else if(open+1<source.len&&c=='*'&&source[open+1]=='/'){ob=ob-1;open=open+2;}else{open=open+1;}continue;}if(oq!=0){if(oe==1){oe=0;}else if(c=='\\'){oe=1;}else if(c==oq){oq=0;}open=open+1;continue;}if(open+1<source.len&&c=='/'&&source[open+1]=='/'){open=open+2;while(open<source.len&&source[open]!='\n'){open=open+1;}continue;}if(open+1<source.len&&c=='/'&&source[open+1]=='*'){ob=1;open=open+2;continue;}if(c=='"'||c=='\''){oq=c;open=open+1;continue;}if(c=='{'||c==';'){break;}open=open+1;}if(open>=source.len||source[open]!='{'){out.valid=0;return out;}let close:i32=open+1;let d:i32=1;let quote:u8=0;let escape:i32=0;let block:i32=0;while(close<source.len&&d>0){let c:u8=source[close];if(block>0){if(close+1<source.len&&c=='/'&&source[close+1]=='*'){block=block+1;close=close+2;}else if(close+1<source.len&&c=='*'&&source[close+1]=='/'){block=block-1;close=close+2;}else{close=close+1;}continue;}if(quote!=0){if(escape==1){escape=0;}else if(c=='\\'){escape=1;}else if(c==quote){quote=0;}close=close+1;continue;}if(close+1<source.len&&c=='/'&&source[close+1]=='/'){close=close+2;while(close<source.len&&source[close]!='\n'){close=close+1;}continue;}if(close+1<source.len&&c=='/'&&source[close+1]=='*'){block=1;close=close+2;continue;}if(c=='"'||c=='\''){quote=c;}else if(c=='{'){d=d+1;}else if(c=='}'){d=d-1;}close=close+1;}if(d!=0||quote!=0||block!=0){out.valid=0;return out;}let header:ZagdHash=zi_canonical(source[start..open]);let whole:ZagdHash=zi_canonical(source[start..close]);let body:ZagdHash=zi_canonical(source[open+1..close-1]);if(header.first<0||whole.first<0||body.first<0){out.valid=0;return out;}let layout:ZagdHash=zagd_hash_empty();if(kind==2){layout=whole;}let calls:ZagdHash=zagd_hash_empty();if(kind==1){calls=zi_calls(source[open+1..close-1]);}push[ZagdDeclFingerprint](&out.declarations,ZagdDeclFingerprint{.name=name,.kind=kind,.public=pub,.parse=whole,.signature=header,.layout=layout,.body=body,.callers=calls,.codegen_region=body});i=close;}
    return out;
}

fn zagd_incremental_encode(f:ZagdIncrementalFile)[]u8{
    if(f.valid!=1||f.advisory!=1||f.executable_authority!=0||zi_safe(f.path)==0){return "";}
    let body:[]u8="format=zagd-incremental-v1\nadvisory=true\nexecutable_authority=false\ncomplete=true\n";
    body=_zag_str_concat(body,_zag_str_concat("path=",_zag_str_concat(f.path,"\ncontent=")));body=_zag_str_concat(body,_zag_str_concat(zi_hash_text(f.content),"\nparse="));body=_zag_str_concat(body,_zag_str_concat(zi_hash_text(f.parse),"\nroot="));body=_zag_str_concat(body,_zag_str_concat(zi_hash_text(f.root),"\ntarget="));body=_zag_str_concat(body,_zag_str_concat(zi_hash_text(f.target),"\n"));
    let i:i32=0;while(i<f.declarations.len){let d:ZagdDeclFingerprint=f.declarations.data[i];if(zi_safe(d.name)==0){return "";}body=_zag_str_concat(body,"decl=");body=_zag_str_concat(body,d.name);body=_zag_str_concat(body,"\t");body=_zag_str_concat(body,_zag_i64_to_str(d.kind));body=_zag_str_concat(body,"\t");body=_zag_str_concat(body,_zag_i64_to_str(d.public));body=_zag_str_concat(body,"\t");body=_zag_str_concat(body,zi_hash_text(d.parse));body=_zag_str_concat(body,"\t");body=_zag_str_concat(body,zi_hash_text(d.signature));body=_zag_str_concat(body,"\t");body=_zag_str_concat(body,zi_hash_text(d.layout));body=_zag_str_concat(body,"\t");body=_zag_str_concat(body,zi_hash_text(d.body));body=_zag_str_concat(body,"\t");body=_zag_str_concat(body,zi_hash_text(d.callers));body=_zag_str_concat(body,"\t");body=_zag_str_concat(body,zi_hash_text(d.codegen_region));body=_zag_str_concat(body,"\n");i=i+1;}
    let sum:ZagdHash=zagd_content_hash(body);return _zag_str_concat(body,_zag_str_concat("checksum=",_zag_str_concat(zi_hash_text(sum),"\n")));
}

fn zagd_incremental_decode(text:[]u8)ZagdIncrementalFile{
    let out:ZagdIncrementalFile=zi_bad();if(!@strEq(zi_value(text,"format"),"zagd-incremental-v1")||!@strEq(zi_value(text,"advisory"),"true")||!@strEq(zi_value(text,"executable_authority"),"false")||!@strEq(zi_value(text,"complete"),"true")){return out;}
    let marker:[]u8="checksum=";let mark:i32=0-1;let i:i32=0;while(i+marker.len<=text.len){if((i==0||text[i-1]=='\n')&&@strEq(text[i..i+marker.len],marker)){mark=i;}i=i+1;}let checksum_text:[]u8=zi_value(text,"checksum");if(mark<0||mark+marker.len+checksum_text.len+1!=text.len){return out;}let want:ZagdHash=zi_hash(checksum_text,0);if(zagd_hash_equal(want,zagd_content_hash(text[0..mark]))==0){return out;}
    out.path=zi_value(text,"path");if(zi_safe(out.path)==0){return out;}out.content=zi_hash(zi_value(text,"content"),0);out.parse=zi_hash(zi_value(text,"parse"),0);out.root=zi_hash(zi_value(text,"root"),0);out.target=zi_hash(zi_value(text,"target"),0);
    let start:i32=0;i=0;while(i<=mark){if(i==mark||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>5&&@strEq(line[0..5],"decl=")){let p:[]u8=line[5..];let d:ZagdDeclFingerprint=ZagdDeclFingerprint{.name=zi_tab(p,0),.kind=zi_num(zi_tab(p,1)) as i32,.public=zi_num(zi_tab(p,2)) as i32,.parse=zi_hash(p,3),.signature=zi_hash(p,6),.layout=zi_hash(p,9),.body=zi_hash(p,12),.callers=zi_hash(p,15),.codegen_region=zi_hash(p,18)};if(zi_safe(d.name)==0||d.kind<0||d.public<0||d.public>1||d.parse.first<0||d.codegen_region.first<0){return zi_bad();}push[ZagdDeclFingerprint](&out.declarations,d);}start=i+1;}i=i+1;}out.valid=1;return out;
}

fn zagd_incremental_index_encode(index:ZagdIncrementalIndex)[]u8{
    if(index.valid!=1||index.advisory!=1||index.executable_authority!=0||index.graph_complete<0||index.graph_complete>1||index.graph_identity.first<0){return "";}
    let body:[]u8="format=zagd-incremental-index-v2\nadvisory=true\nexecutable_authority=false\ncomplete=true\n";
    body=_zag_str_concat(body,_zag_str_concat("graph_identity=",_zag_str_concat(zi_hash_text(index.graph_identity),_zag_str_concat("\ngraph_complete=",_zag_str_concat(_zag_i64_to_str(index.graph_complete),"\n")))));
    let i:i32=0;while(i<index.files.len){let f:ZagdIncrementalFile=index.files.data[i];if(f.valid!=1||f.advisory!=1||f.executable_authority!=0||zi_safe(f.path)==0){return "";}body=_zag_str_concat(body,"file=");body=_zag_str_concat(body,f.path);body=_zag_str_concat(body,"\t");body=_zag_str_concat(body,zi_hash_text(f.content));body=_zag_str_concat(body,"\t");body=_zag_str_concat(body,zi_hash_text(f.parse));body=_zag_str_concat(body,"\t");body=_zag_str_concat(body,zi_hash_text(f.root));body=_zag_str_concat(body,"\t");body=_zag_str_concat(body,zi_hash_text(f.target));body=_zag_str_concat(body,"\n");let j:i32=0;while(j<f.declarations.len){let d:ZagdDeclFingerprint=f.declarations.data[j];if(zi_safe(d.name)==0){return "";}body=_zag_str_concat(body,"decl=");body=_zag_str_concat(body,f.path);body=_zag_str_concat(body,"\t");body=_zag_str_concat(body,d.name);body=_zag_str_concat(body,"\t");body=_zag_str_concat(body,_zag_i64_to_str(d.kind));body=_zag_str_concat(body,"\t");body=_zag_str_concat(body,_zag_i64_to_str(d.public));body=_zag_str_concat(body,"\t");body=_zag_str_concat(body,zi_hash_text(d.parse));body=_zag_str_concat(body,"\t");body=_zag_str_concat(body,zi_hash_text(d.signature));body=_zag_str_concat(body,"\t");body=_zag_str_concat(body,zi_hash_text(d.layout));body=_zag_str_concat(body,"\t");body=_zag_str_concat(body,zi_hash_text(d.body));body=_zag_str_concat(body,"\t");body=_zag_str_concat(body,zi_hash_text(d.callers));body=_zag_str_concat(body,"\t");body=_zag_str_concat(body,zi_hash_text(d.codegen_region));body=_zag_str_concat(body,"\n");j=j+1;}i=i+1;}
    let sum:ZagdHash=zagd_content_hash(body);return _zag_str_concat(body,_zag_str_concat("checksum=",_zag_str_concat(zi_hash_text(sum),"\n")));
}

// The daemon writes this record repeatedly while it is alive.  Keep the
// legacy encoder above for compatibility tests, but use this one in the
// long-running path: append-only storage means one record allocation instead
// of retaining every intermediate concat buffer.
fn zi_append_hash(out:*ArrayList[u8],h:ZagdHash)void{zagd_text_append_i64(out,h.first);zagd_text_append_byte(out,'\t');zagd_text_append_i64(out,h.second);zagd_text_append_byte(out,'\t');zagd_text_append_i64(out,h.bytes);}
fn zi_append_field(out:*ArrayList[u8],key:[]u8,value:[]u8)void{zagd_text_append(out,key);zagd_text_append_byte(out,'=');zagd_text_append(out,value);zagd_text_append_byte(out,'\n');}
fn zagd_incremental_index_encode_compact(index:ZagdIncrementalIndex)[]u8{
    if(index.valid!=1||index.advisory!=1||index.executable_authority!=0||index.graph_complete<0||index.graph_complete>1||index.graph_identity.first<0){return "";}
    let out:ArrayList[u8]=zagd_text(1024);
    zagd_text_append(&out,"format=zagd-incremental-index-v2\nadvisory=true\nexecutable_authority=false\ncomplete=true\ngraph_identity=");zi_append_hash(&out,index.graph_identity);zagd_text_append(&out,"\ngraph_complete=");zagd_text_append_i64(&out,index.graph_complete);zagd_text_append_byte(&out,'\n');
    let i:i32=0;while(i<index.files.len){let f:ZagdIncrementalFile=index.files.data[i];if(f.valid!=1||f.advisory!=1||f.executable_authority!=0||zi_safe(f.path)==0){free[u8](&out);return "";}zagd_text_append(&out,"file=");zagd_text_append(&out,f.path);zagd_text_append_byte(&out,'\t');zi_append_hash(&out,f.content);zagd_text_append_byte(&out,'\t');zi_append_hash(&out,f.parse);zagd_text_append_byte(&out,'\t');zi_append_hash(&out,f.root);zagd_text_append_byte(&out,'\t');zi_append_hash(&out,f.target);zagd_text_append_byte(&out,'\n');let j:i32=0;while(j<f.declarations.len){let d:ZagdDeclFingerprint=f.declarations.data[j];if(zi_safe(d.name)==0){free[u8](&out);return "";}zagd_text_append(&out,"decl=");zagd_text_append(&out,f.path);zagd_text_append_byte(&out,'\t');zagd_text_append(&out,d.name);zagd_text_append_byte(&out,'\t');zagd_text_append_i64(&out,d.kind);zagd_text_append_byte(&out,'\t');zagd_text_append_i64(&out,d.public);zagd_text_append_byte(&out,'\t');zi_append_hash(&out,d.parse);zagd_text_append_byte(&out,'\t');zi_append_hash(&out,d.signature);zagd_text_append_byte(&out,'\t');zi_append_hash(&out,d.layout);zagd_text_append_byte(&out,'\t');zi_append_hash(&out,d.body);zagd_text_append_byte(&out,'\t');zi_append_hash(&out,d.callers);zagd_text_append_byte(&out,'\t');zi_append_hash(&out,d.codegen_region);zagd_text_append_byte(&out,'\n');j=j+1;}i=i+1;}
    let sum:ZagdHash=zagd_content_hash(out.data[0..out.len]);zagd_text_append(&out,"checksum=");zi_append_hash(&out,sum);zagd_text_append_byte(&out,'\n');return out.data[0..out.len];
}

fn zagd_incremental_index_decode(text:[]u8)ZagdIncrementalIndex{
    let out:ZagdIncrementalIndex=zi_index_bad();if(!@strEq(zi_value(text,"format"),"zagd-incremental-index-v2")||!@strEq(zi_value(text,"advisory"),"true")||!@strEq(zi_value(text,"executable_authority"),"false")||!@strEq(zi_value(text,"complete"),"true")){return out;}
    let marker:[]u8="checksum=";let mark:i32=0-1;let i:i32=0;while(i+marker.len<=text.len){if((i==0||text[i-1]=='\n')&&@strEq(text[i..i+marker.len],marker)){mark=i;}i=i+1;}let checksum_text:[]u8=zi_value(text,"checksum");if(mark<0||mark+marker.len+checksum_text.len+1!=text.len){return out;}let want:ZagdHash=zi_hash(checksum_text,0);if(zagd_hash_equal(want,zagd_content_hash(text[0..mark]))==0){return out;}
    out.graph_identity=zi_hash(zi_value(text,"graph_identity"),0);out.graph_complete=zi_num(zi_value(text,"graph_complete")) as i32;if(out.graph_identity.first<0||out.graph_complete<0||out.graph_complete>1){return out;}
    let start:i32=0;i=0;while(i<=mark){if(i==mark||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>5&&@strEq(line[0..5],"file=")){let p:[]u8=line[5..];let f:ZagdIncrementalFile=zi_bad();f.path=zi_tab(p,0);f.content=zi_hash(p,1);f.parse=zi_hash(p,4);f.root=zi_hash(p,7);f.target=zi_hash(p,10);f.valid=1;if(zi_safe(f.path)==0||f.content.first<0||f.parse.first<0||f.root.first<0||f.target.first<0||zagd_incremental_index_find(out,f.path)>=0){free[ZagdDeclFingerprint](&f.declarations);return out;}push[ZagdIncrementalFile](&out.files,f);}else if(line.len>5&&@strEq(line[0..5],"decl=")){let p:[]u8=line[5..];let path:[]u8=zi_tab(p,0);let found:i32=zagd_incremental_index_find(out,path);let d:ZagdDeclFingerprint=ZagdDeclFingerprint{.name=zi_tab(p,1),.kind=zi_num(zi_tab(p,2)) as i32,.public=zi_num(zi_tab(p,3)) as i32,.parse=zi_hash(p,4),.signature=zi_hash(p,7),.layout=zi_hash(p,10),.body=zi_hash(p,13),.callers=zi_hash(p,16),.codegen_region=zi_hash(p,19)};if(found<0||zi_safe(d.name)==0||d.kind<0||d.public<0||d.public>1||d.parse.first<0||d.codegen_region.first<0){return out;}push[ZagdDeclFingerprint](&out.files.data[found].declarations,d);}start=i+1;}i=i+1;}
    out.valid=1;return out;
}

fn zagd_incremental_decide(old:ZagdIncrementalFile,new:ZagdIncrementalFile)ZagdIncrementalDecision{
    let d:ZagdIncrementalDecision=ZagdIncrementalDecision{.change=zagd_change_unknown(),.reuse_parse=0,.invalidate_types=1,.invalidate_layouts=1,.invalidate_functions=1,.invalidate_callers=1,.invalidate_codegen=1};
    if(old.valid!=1||new.valid!=1||old.advisory!=1||new.advisory!=1||old.executable_authority!=0||new.executable_authority!=0){return d;}
    if(zagd_hash_equal(old.target,new.target)==0){d.change=zagd_change_target_profile();return d;}if(zagd_hash_equal(old.root,new.root)==0){d.change=zagd_change_root_profile();return d;}
    if(zagd_hash_equal(old.content,new.content)==1){d.change=zagd_change_none();d.reuse_parse=1;d.invalidate_types=0;d.invalidate_layouts=0;d.invalidate_functions=0;d.invalidate_callers=0;d.invalidate_codegen=0;return d;}
    if(zagd_hash_equal(old.parse,new.parse)==1){d.change=zagd_change_nonsemantic();d.reuse_parse=1;d.invalidate_types=0;d.invalidate_layouts=0;d.invalidate_functions=0;d.invalidate_callers=0;d.invalidate_codegen=0;return d;}
    if(old.declarations.len!=new.declarations.len){d.change=zagd_change_public_shape();return d;}
    let private_body:i32=0;let reordered:i32=0;let i:i32=0;while(i<old.declarations.len){let a:ZagdDeclFingerprint=old.declarations.data[i];let found:i32=0-1;let j:i32=0;while(j<new.declarations.len){if(@strEq(a.name,new.declarations.data[j].name)&&a.kind==new.declarations.data[j].kind){found=j;}j=j+1;}if(found<0){d.change=zagd_change_public_shape();return d;}if(found!=i){reordered=1;}let b:ZagdDeclFingerprint=new.declarations.data[found];if(a.public!=b.public||zagd_hash_equal(a.signature,b.signature)==0||zagd_hash_equal(a.layout,b.layout)==0){d.change=zagd_change_public_shape();return d;}if(zagd_hash_equal(a.body,b.body)==0||zagd_hash_equal(a.callers,b.callers)==0||zagd_hash_equal(a.codegen_region,b.codegen_region)==0){private_body=1;}i=i+1;}
    if(reordered==1){return d;}if(private_body==1){d.change=zagd_change_private_body();d.invalidate_types=0;d.invalidate_layouts=0;return d;}d.change=zagd_change_nonsemantic();d.reuse_parse=1;d.invalidate_types=0;d.invalidate_layouts=0;d.invalidate_functions=0;d.invalidate_callers=0;d.invalidate_codegen=0;return d;
}
