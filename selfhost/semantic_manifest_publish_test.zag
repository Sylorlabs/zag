@import("parse.zag")
@import("sema.zag")
@import("semantic_manifest_publish.zag")
extern fn _zag_read_file(path:[]u8)[]u8
fn main()i32{
    let root:[]u8="/tmp/zag-semantic-publish-test";smp_mkdir(root);
    let src:[]u8="pub fn api(x:i32) i32 { return x; }";
    let u:CompilationUnit=parse_compilation_unit_dir(src,".");
    let e:map.StringMap[i32]=analyze(u.decls);
    if(semantic_manifest_publish(root,"app.zag",src,u,e)==0){return 1;}
    let text:[]u8=_zag_read_file(_zag_str_concat(root,"/.zag-cache/zagd/semantic.record"));
    if(semantic_manifest_decode(text).valid==0||!@strEq(smf_value(text,"detail_level"),"full")){return 2;}

    // Cross the merged-source threshold without adding expression complexity.
    // The selected record must remain an exact compact graph rather than the
    // former incomplete memory-ceiling summary.
    let large:ArrayList[u8]=make[u8](524289);let i:i32=0;while(i<524289){push[u8](&large,' ');i=i+1;}
    push[ResolvedModule](&u.modules,ResolvedModule{.path="large.zag",.source=large.data[0..large.len]});
    let bounded:[]u8=smp_bounded_manifest("app.zag",src,u,e);
    let expected:*SemanticManifest=semantic_manifest_build_compact("app.zag",src,u.profile,u.decls,e,u.modules,u.imports);
    let view:SemanticManifestView=semantic_manifest_decode(bounded);
    if(view.valid==0||view.graph_complete!=1||!@strEq(smf_value(bounded,"detail_level"),"compact")){return 3;}
    if(zagd_hash_equal(view.graph_identity,semantic_manifest_decode(expected.*.text).graph_identity)==0){return 4;}
    if(!sm_text_has(bounded,"module_node=large.zag\t")||sm_text_has(bounded,"expr_fact=")||bounded.len>8388608){return 5;}
    free[u8](&large);
    _zag_println("semantic manifest publish: pass=6 fail=0");return 0;
}
