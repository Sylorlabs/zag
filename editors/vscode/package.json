{
  "name": "zag-lang",
  "displayName": "Zag Language",
  "description": "Zag language support: syntax highlighting, diagnostics, completion, hover, and go-to-definition via the Zag LSP server.",
  "version": "0.1.0",
  "publisher": "sylorlabs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sylorlabs/zag.git"
  },
  "files": [
    "out/**",
    "syntaxes/**",
    "language-configuration.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:zag"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "zag",
        "aliases": ["Zag", "zag"],
        "extensions": [".zag"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zag",
        "scopeName": "source.zag",
        "path": "./syntaxes/zag.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Zag",
      "properties": {
        "zag.serverPath": {
          "type": "string",
          "default": "zag-lsp",
          "description": "Path to the Zag LSP server binary."
        },
        "zag.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Trace LSP communication in the Output panel."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "check": "tsc --noEmit -p ./",
    "compile": "npm run check && esbuild extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node18 --sourcemap",
    "watch": "esbuild extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node18 --sourcemap --watch",
    "package": "SOURCE_DATE_EPOCH=946684800 vsce package --out zag-lang.vsix",
    "pretest": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2",
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "esbuild": "0.28.2",
    "typescript": "^5.3.0"
  }
}
