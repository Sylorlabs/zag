@import("../std/gpu.zag")

fn check(name:[]u8,ok:bool,failures:*i32) void {
    if(ok){_zag_print("  ok  ");}else{_zag_print("  XX  ");failures.*=failures.*+1;}
    _zag_println(name);
}

fn tuple() ZagGpuTuple {
    return ZagGpuTuple{.device=0x731F,.gfx_ip=1000,.gfx_discovery=0x0A010A,.gfx_rings=1,
        .compute_ip=1000,.compute_discovery=0x0A010A,.compute_rings=15,.mec_firmware=92,.sdma_firmware=64,
        .kernel=618,.compiler=2,.runtime=3};
}

fn certification() ZagGpuCertification {
    return ZagGpuCertification{.tuple=tuple(),.reset_isolated=true,.memory_sync_verified=true,
        .kernel_log_clean=true,.fills=10000,.ownership_transfers=10000,.dispatches=1000000,
        .soak_seconds=86400,.mismatches=0,.timeouts=0,.resets=0,.faults=0,.leaks=0};
}

fn benefit() ZagGpuBenefit {
    return ZagGpuBenefit{.samples=50,.cpu_ns=100000,.gpu_ns=70000,
        .representative=true,.raw_samples_retained=true};
}

fn virtual_certification()ZagGpuVirtualCertification{
    return ZagGpuVirtualCertification{.tuple=tuple(),.compiler_manifest_verified=true,
        .memory_sync_verified=true,.fills=10000,.ownership_transfers=10000,
        .dispatches=1000000,.logical_soak_seconds=86400,.wall_soak_seconds=5,
        .golden_scenes=1,.randomized_scenes=64,.mismatches=0,.timeouts=0,
        .resets=0,.faults=0,.leaks=0};
}

fn main() i32 {
    let failures:i32=0;
    check("backend names parse without forcing one execution mode",
        zag_gpu_backend_parse("auto")==zag_gpu_backend_auto()&&
        zag_gpu_backend_parse("cpu")==zag_gpu_backend_cpu()&&
        zag_gpu_backend_parse("virtual")==zag_gpu_backend_virtual()&&
        zag_gpu_backend_parse("physical")==zag_gpu_backend_physical(),&failures);
    let br:ZagGpuBackendRequest=ZagGpuBackendRequest{.requested=zag_gpu_backend_auto(),
        .virtual_available=true,.physical_available=true,.physical_certified=false,
        .physical_display_bound=true,.physical_reset_isolated=false,.physical_acknowledged=false};
    check("auto safely chooses virtual on an uncertified display GPU",
        zag_gpu_backend_choose(br).selected==zag_gpu_backend_virtual(),&failures);
    br.requested=zag_gpu_backend_cpu();check("CPU remains an explicit user choice",
        zag_gpu_backend_choose(br).selected==zag_gpu_backend_cpu()&&!zag_gpu_backend_choose(br).fallback,&failures);
    br.requested=zag_gpu_backend_virtual();check("virtual remains an explicit user choice",
        zag_gpu_backend_choose(br).selected==zag_gpu_backend_virtual()&&!zag_gpu_backend_choose(br).fallback,&failures);
    br.requested=zag_gpu_backend_physical();check("unacknowledged shared physical choice is refused",
        zag_gpu_backend_choose(br).code==204,&failures);
    br.physical_acknowledged=true;check("acknowledged physical mode remains available by explicit choice",
        zag_gpu_backend_choose(br).selected==zag_gpu_backend_physical(),&failures);
    let c:ZagGpuCertification=certification();let b:ZagGpuBenefit=benefit();
    let vc:ZagGpuVirtualCertification=virtual_certification();
    let vd:ZagGpuDecision=zag_gpu_virtual_cert_decide(tuple(),vc);
    check("complete virtual evidence is admitted only as host-contained code 100",vd.allowed&&vd.code==100&&vd.reason.len>40,&failures);
    let short_virtual:ZagGpuVirtualCertification=virtual_certification();short_virtual.dispatches=999999;
    check("virtual campaign thresholds are exact",zag_gpu_virtual_cert_decide(tuple(),short_virtual).code==103,&failures);
    let bad_virtual:ZagGpuVirtualCertification=virtual_certification();bad_virtual.mismatches=1;
    check("one virtual mismatch quarantines its tuple",zag_gpu_virtual_cert_decide(tuple(),bad_virtual).code==104,&failures);
    let d:ZagGpuDecision=zag_gpu_auto_decide(tuple(),c,b,200);
    check("exact certified tuple with reviewable benefit may promote",d.allowed&&d.code==0&&d.benefit_permille==300,&failures);
    let other:ZagGpuTuple=tuple();other.runtime=4;
    let mismatch:ZagGpuDecision=zag_gpu_auto_decide(other,c,b,200);
    check("tuple mismatch fails with an actionable stable reason",!mismatch.allowed&&mismatch.code==1&&mismatch.next_action.len>20,&failures);
    let ring_changed:ZagGpuTuple=tuple();ring_changed.compute_rings=7;
    check("ring topology is part of the exact certification tuple",zag_gpu_auto_decide(ring_changed,c,b,200).code==1,&failures);
    let discovery_changed:ZagGpuTuple=tuple();discovery_changed.gfx_discovery=0x0A010B;
    check("IP discovery revision is part of the exact certification tuple",zag_gpu_auto_decide(discovery_changed,c,b,200).code==1,&failures);
    let unisolated:ZagGpuCertification=certification();unisolated.reset_isolated=false;
    check("reset isolation is mandatory even with all counters complete",zag_gpu_auto_decide(tuple(),unisolated,b,200).code==2,&failures);
    let partial:ZagGpuCertification=certification();partial.dispatches=999999;
    check("campaign thresholds fail closed without rounding",zag_gpu_auto_decide(tuple(),partial,b,200).code==5,&failures);
    let anomaly:ZagGpuCertification=certification();anomaly.faults=1;
    check("one physical anomaly quarantines promotion",zag_gpu_auto_decide(tuple(),anomaly,b,200).code==6,&failures);
    let hidden:ZagGpuBenefit=benefit();hidden.raw_samples_retained=false;
    check("summary-only performance numbers cannot promote",zag_gpu_auto_decide(tuple(),c,hidden,200).code==7,&failures);
    let slow:ZagGpuBenefit=benefit();slow.gpu_ns=90000;
    let below:ZagGpuDecision=zag_gpu_auto_decide(tuple(),c,slow,200);
    check("benefit threshold reports the measured permille",!below.allowed&&below.code==9&&below.benefit_permille==100,&failures);
    let bundle:Gfx1010VmBundle=gfxvm_bad_bundle();let result:Gfx1010VmResult=gfxvm_error(2);
    let diag:ZagGpuDiagnostic=zag_gpu_diagnostic(bundle,result);let report:[]u8=zag_gpu_diagnostic_text(diag);
    check("VM diagnostics name the failure and provide the next inspection",_zag_strcmp(diag.error_name,"invalid-command-stream")==1&&diag.hint.len>30&&report.len>60,&failures);
    let campaign:ZagGpuCampaign=ZagGpuCampaign{.version=1,.target=1000000,.completed=450000,
        .last_fence=450000,.seed=77,.elapsed_ms=12345,.mismatches=0,.timeouts=0,.resets=0,.faults=0};
    check("campaign checkpoint saves only internally consistent state",zag_gpu_campaign_save("/tmp/zag_gpu_campaign.state",campaign),&failures);
    let resumed:ZagGpuCampaign=zag_gpu_campaign_load("/tmp/zag_gpu_campaign.state");
    check("campaign checkpoint resumes exact progress and seed",resumed.version==1&&resumed.completed==450000&&resumed.last_fence==450000&&resumed.seed==77,&failures);
    let _bad:i32=_zag_write_file("/tmp/zag_gpu_campaign.state","ZAGGPU1 1 10 9 8 0 0 0 0 0 0\n");
    check("corrupt fence continuity is rejected",zag_gpu_campaign_load("/tmp/zag_gpu_campaign.state").version==0,&failures);
    let virtual:ZagGpuExecutionRequest=ZagGpuExecutionRequest{.tier=zag_gpu_tier_virtual(),
        .display_bound=true,.reset_isolated=false,.process_isolation=false,.driver_recovery=false,
        .compiler_proved_straight_line=true,.manifest_verified=true,.workgroups=1000000,
        .instructions=59000000,.writable_bytes=256,.deadline_ms=0,
        .allow_shared_display_override=false,.acknowledge_reset_or_system_hang=false};
    check("exact-ISA virtual work is host-contained even on a display machine",zag_gpu_execution_decide(virtual).allowed,&failures);
    let memory:ZagGpuExecutionRequest=virtual;memory.tier=zag_gpu_tier_memory_only();memory.workgroups=0;memory.instructions=0;
    check("memory-only hardware access forbids hidden command submission",zag_gpu_execution_decide(memory).allowed,&failures);
    memory.instructions=1;check("memory-only tier rejects even one claimed instruction",zag_gpu_execution_decide(memory).code==21,&failures);
    let physical:ZagGpuExecutionRequest=virtual;physical.tier=zag_gpu_tier_physical_bounded();physical.workgroups=1;
    physical.instructions=59;physical.writable_bytes=4;physical.deadline_ms=50;
    physical.driver_recovery=true;physical.process_isolation=true;
    check("watchdogs and process cleanup cannot promote a display GPU to a reset domain",zag_gpu_execution_decide(physical).code==23,&failures);
    physical.allow_shared_display_override=true;physical.acknowledge_reset_or_system_hang=true;
    let overridden:ZagGpuDecision=zag_gpu_execution_decide(physical);
    check("an informed user may explicitly choose bounded shared-display execution",overridden.allowed&&overridden.code==28,&failures);
    physical.tier=zag_gpu_tier_destructive();
    check("shared-display override never authorizes destructive certification",zag_gpu_execution_decide(physical).code==27,&failures);
    physical.tier=zag_gpu_tier_physical_bounded();physical.allow_shared_display_override=false;
    physical.acknowledge_reset_or_system_hang=false;
    physical.display_bound=false;physical.reset_isolated=true;
    check("isolated proof-carrying bounded physical request is admitted",zag_gpu_execution_decide(physical).allowed,&failures);
    if(failures==0){_zag_println("GPU standard library: ALL PASS");return 0;}
    _zag_println("GPU standard library: FAILURES");return 1;
}
