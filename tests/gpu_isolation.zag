@import("../std/linux_gpu_isolation.zag")

fn check(name_: []u8, ok: bool, failures: *i32) void {
    if (ok) { _zag_print("  ok  "); } else { _zag_print("  XX  "); failures.* = failures.* + 1; }
    _zag_println(name_);
}

fn main() i32 {
    let failures: i32 = 0;
    let root: []u8 = "/tmp/zag_gpu_isolation_fixture";
    let _mk: i32 = _zag_exec_cmd("rm -rf /tmp/zag_gpu_isolation_fixture && mkdir -p /tmp/zag_gpu_isolation_fixture");
    let _reset: i32 = _zag_write_file(gpu_iso_path(root,"reset_method"),"bus\n");
    let base: LinuxGpuIsolation = linux_gpu_isolation_probe(root);
    check("a shared device never claims reset isolation",
        base.level == gpu_isolation_none() && !base.destructive_test_safe,&failures);

    let _enforce: i32 = _zag_write_file(gpu_iso_path(root,"enforce_isolation"),"1\n");
    let _cleaner: i32 = _zag_write_file(gpu_iso_path(root,"run_cleaner_shader"),"\n");
    let process: LinuxGpuIsolation = linux_gpu_isolation_probe(root);
    check("cleaner-shader process isolation is not a fault domain",
        process.level == gpu_isolation_process_clean() && !process.destructive_test_safe,&failures);

    let _partition: i32 = _zag_write_file(gpu_iso_path(root,"current_compute_partition"),"SPX\n");
    let partitioned: LinuxGpuIsolation = linux_gpu_isolation_probe(root);
    check("partition controls alone remain unsafe for destructive testing",
        partitioned.level == gpu_isolation_partition_controls() && !partitioned.destructive_test_safe,&failures);

    let _total: i32 = _zag_write_file(gpu_iso_path(root,"sriov_totalvfs"),"8\n");
    let _active: i32 = _zag_write_file(gpu_iso_path(root,"sriov_numvfs"),"1\n");
    let _iommu: i32 = _zag_write_file(gpu_iso_path(root,"iommu_group"),"18\n");
    let _flr: i32 = _zag_write_file(gpu_iso_path(root,"reset_method"),"flr bus\n");
    let pf: LinuxGpuIsolation = linux_gpu_isolation_probe(root);
    check("a PF hosting VFs is not itself an isolated VF",
        !pf.device_is_vf && !pf.destructive_test_safe,&failures);
    let _physfn: i32 = _zag_write_file(gpu_iso_path(root,"physfn"),"../../../0000:01:00.0\n");
    let vf: LinuxGpuIsolation = linux_gpu_isolation_probe(root);
    check("a VF with its own IOMMU group and FLR admits a reset domain",
        vf.device_is_vf && vf.level == gpu_isolation_reset_domain() && vf.destructive_test_safe,&failures);
    check("isolation levels have explicit non-marketing names",
        _zag_strcmp(linux_gpu_isolation_name(base.level),"shared-device-no-fault-isolation") == 1 &&
        _zag_strcmp(linux_gpu_isolation_name(vf.level),"vf-iommu-flr-reset-domain") == 1,&failures);

    if (failures == 0) { _zag_println("GPU ISOLATION: ALL PASS"); return 0; }
    _zag_println("GPU ISOLATION: FAILURES"); return 1;
}
