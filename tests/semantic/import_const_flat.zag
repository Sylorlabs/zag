@import("import_const_values.zag")

const LOCAL_I64: i64 = 1099511627818;

fn shadow(IMPORTED_I64: i64) i64 { return IMPORTED_I64; }
fn forward_value() i64 { return FORWARD_I64; }

const FORWARD_I64: i64 = 1099511627819;

fn main() i32 {
    if (LOCAL_I64 != 1099511627818) { return 1; }
    if (IMPORTED_I64 != 1099511627818) { return 2; }
    if (shadow(7) != 7) { return 3; }
    if (forward_value() != 1099511627819) { return 4; }
    return 42;
}
