struct WidePacket {
    unsigned_value:u64,
    signed_value:i64,
    tag:i32,
}

pub fn external_wide_mix(a:u64, b:i64, c:i32) u64 {
    return a+(b as u64)+(c as u64);
}

pub fn external_wide_product(a:u64, b:u64) u64 {
    return a*b;
}

pub fn external_signed_divmod(a:i64, b:i64) i64 {
    return (a/b)+(a%b);
}

pub fn transform_wide_packet(packet:WidePacket, delta:u64) WidePacket {
    let result:WidePacket=WidePacket{
        .unsigned_value=packet.unsigned_value+delta,
        .signed_value=packet.signed_value+(delta as i64),
        .tag=packet.tag+35,
    };
    return result;
}
