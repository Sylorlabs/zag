// Caller-side SysV i386 aggregate witness. `wide` deliberately begins at byte
// offset 4: i386 aligns f64 to four bytes, represents it in two little-endian
// words, and gives this complete flat struct a 20-byte cdecl argument area.
struct FloatPacket {
    head:f32,
    wide:f64,
    tail:f32,
    tag:i32,
}

extern fn transform_float_packet(packet:FloatPacket) FloatPacket;

fn main() i32 {
    let input:FloatPacket=FloatPacket{
        .head=1.0,
        .wide=2.0,
        .tail=3.0,
        .tag=4,
    };
    input.head=input.head+0.5;
    input.wide=input.wide+0.25;
    input.tail=input.tail-0.5;
    input.tag=input.tag+1;

    let output:FloatPacket=transform_float_packet(input);
    let copied:FloatPacket=output;
    let assigned:FloatPacket=FloatPacket{
        .head=0.0,
        .wide=0.0,
        .tail=0.0,
        .tag=0,
    };
    assigned=copied;

    if (assigned.head!=3.0) { return 1; }
    if (assigned.wide!=4.5) { return 2; }
    if (assigned.tail!=4.0) { return 3; }
    if (assigned.tag!=12) { return 4; }
    return 42;
}
