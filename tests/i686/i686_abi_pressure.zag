// Exercises the i386 stack-spill discipline under a small register set:
// six right-to-left arguments, nested calls, a large local frame, and the
// printing helper that temporarily uses EBX/ESI/EDI around SYS_write.
fn combine(a:i32, b:i32, c:i32, d:i32, e:i32, f:i32) i32 {
    let printed:i32 = _zag_println_i32(a);
    if (printed < 0) { return 1; }
    return a + b + c + d + e + f;
}

fn wrap(value:i32) i32 {
    let saved0:i32 = 1; let saved1:i32 = 2; let saved2:i32 = 3;
    let saved3:i32 = 4; let saved4:i32 = 5; let saved5:i32 = 6;
    let result:i32 = combine(value, saved0, saved1, saved2, saved3, saved4);
    return result + saved5;
}

fn main() i32 {
    let answer:i32 = wrap(21);
    if (answer != 42) { return 1; }
    return 42;
}
