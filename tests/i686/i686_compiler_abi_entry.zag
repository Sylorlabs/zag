// Cross-object SysV i386 ABI witness.  The callee is intentionally in a
// separate compiler-produced object so this covers both R_386_PC32 resolution
// and the right-to-left, caller-cleaned stack-argument boundary.
extern fn external_combine(a:i32, b:i32, c:i32, d:i32, e:i32, f:i32) i32;

fn main() i32 {
    return external_combine(21, 1, 2, 3, 4, 11);
}
