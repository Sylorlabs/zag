// Callee-side witness for recursively flattened field views and hidden-sret.
struct Numbers {
    signed8:i8,
    unsigned8:u8,
    signed16:i16,
    unsigned16:u16,
    ready:bool,
    count:i32,
    ratio:f32,
    total:f64,
}
struct Link { pointer:*i32, size:usize }
struct Payload { numbers:Numbers, link:Link }
struct Envelope { payload:Payload, code:i32 }

pub fn transform_envelope(value:Envelope) Envelope {
    let numbers:Numbers=Numbers{
        .signed8=value.payload.numbers.signed8+(1 as i8),
        .unsigned8=value.payload.numbers.unsigned8+(1 as u8),
        .signed16=value.payload.numbers.signed16+(1 as i16),
        .unsigned16=value.payload.numbers.unsigned16+(1 as u16),
        .ready=value.payload.numbers.ready,
        .count=value.payload.numbers.count+2,
        .ratio=value.payload.numbers.ratio*2.0,
        .total=value.payload.numbers.total*2.0,
    };
    let link:Link=Link{
        .pointer=value.payload.link.pointer,
        .size=value.payload.link.size+1,
    };
    let payload:Payload=Payload{.numbers=numbers,.link=link};
    let result:Envelope=Envelope{.payload=payload,.code=value.code+7};
    return result;
}
