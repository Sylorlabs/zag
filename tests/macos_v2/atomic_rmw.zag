fn main() i32 {
    let value: i64 = 5;
    unsafe {
        let p: *mut i64 = (&value) as *mut i64;
        let old_add: i64 = @atomicFetchAdd64Order(p, 7, 4);
        let old_sub: i64 = @atomicFetchSub64(p, 2);
        let old_and: i64 = @atomicFetchAnd64(p, 7);
        let old_or: i64 = @atomicFetchOr64Order(p, 32, 3);
        let old_xor: i64 = @atomicFetchXor64(p, 3);
        let old_exchange: i64 = @atomicExchange64Order(p, 42, 4);
        let cas_hit: i64 = @atomicCompareExchange64Order(p, 42, 43, 4, 4);
        let cas_miss: i64 = @atomicCompareExchange64(p, 42, 99);
        let final_value: i64 = @atomicLoad64Order(p, 4);
        @atomicStore64Order(p, 42, 4);
        if (old_add != 5 || old_sub != 12 || old_and != 10 || old_or != 2 || old_xor != 34 || old_exchange != 33 || cas_hit != 42 || cas_miss != 43 || final_value != 43) { return 1; }
    }
    return 42;
}
