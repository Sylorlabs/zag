@import("../../std/list.zag")

struct Event {
    value: i32,
}

struct Core {
    events: ArrayList[*Event],
}

fn make_core() Core {
    let events: ArrayList[*Event] = make[*Event](2);
    push[*Event](&events, new(Event{ .value = 41 }));
    push[*Event](&events, new(Event{ .value = 42 }));
    return Core{ .events = events };
}
