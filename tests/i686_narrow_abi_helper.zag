// Compiler-produced callee side of the narrow SysV i386 ABI witness.
// Casts observe the callee's signed/unsigned parameter view; narrow returns
// force the backend to publish a fully normalized EAX value.
pub fn external_narrow_args(a:i8, b:u8, c:i16, d:u16, e:bool) i32 {
    if ((a as i32) != -128) { return 1; }
    if ((b as i32) != 255) { return 2; }
    if ((c as i32) != -32768) { return 3; }
    if ((d as i32) != 65535) { return 4; }
    if (e == false) { return 5; }
    return 7;
}

pub fn external_i8() i8 {
    let value:i8 = 0 as i8;
    value = 128 as i8;
    return value;
}
pub fn external_u8() u8 {
    let value:u8 = 0 as u8;
    value = 511 as u8;
    return value;
}
pub fn external_i16() i16 {
    let value:i16 = 0 as i16;
    value = 32768 as i16;
    return value;
}
pub fn external_u16() u16 {
    let value:u16 = 0 as u16;
    value = 131071 as u16;
    return value;
}
pub fn external_bool() bool {
    let value:bool = false;
    value = 9 as bool;
    return value;
}
