script;

let numbers = list(1, 2, 3);
if (script_list_append(&numbers, 4) != 0) { return 1; }
if (script_list_len(numbers) != 4) { return 2; }
if (script_list_get(numbers, 0) != 1 || script_list_get(numbers, 3) != 4) { return 3; }
let i: i32 = 5;
while (i <= 1000) {
    if (script_list_append(&numbers, i) != 0) { return 4; }
    i = i + 1;
}
if (script_list_len(numbers) != 1000 || script_list_get(numbers, 999) != 1000) { return 5; }
// Geometric growth: 4+8+...+1024 i32 slots, well below quadratic use.
if (script_alloc_used() > 20000) { return 6; }
return 0;
