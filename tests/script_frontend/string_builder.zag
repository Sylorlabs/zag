script;

let builder = string_builder(4096);
let i: i32 = 0;
while (i < 1000) {
    if (string_builder_append(&builder, "abcd") != 0) { return 1; }
    i = i + 1;
}
if (string_builder_len(&builder) != 4000) { return 2; }
if (string_builder_append(&builder, string_builder_output(&builder)) == 0) { return 3; }
if (string_builder_len(&builder) != 4000 || string_builder_failed(&builder) == 0) { return 4; }
let output: []u8 = string_builder_output(&builder);
if (output.len != 4000 || output[0] != 97 || output[3999] != 100) { return 5; }
return 0;
