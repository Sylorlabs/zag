// Native ARM64 memory-order witness. Both fences lower to AArch64 DMB and
// execute in a signed Mach-O process, not through the Linux futex path.
fn main() i32 {
    let value:i64=7;
    unsafe {
        let _seq:i64=@atomicFence(4);
        let _full:i64=@memoryFence();
    }
    if(value==7){return 42;}
    return 1;
}
