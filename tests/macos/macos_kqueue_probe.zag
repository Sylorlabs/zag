// Darwin raw-syscall ABI probe used by the native recursive watcher.
@import("../std/list.zag")
extern fn _zag_raw_syscall(num:i64,a1:i64,a2:i64,a3:i64,a4:i64,a5:i64,a6:i64)i64
extern fn _zag_darwin_syscall(num:i64,a1:i64,a2:i64,a3:i64,a4:i64,a5:i64,a6:i64)i64
extern fn _zag_slice_ptr(s:[]u8)*i8
extern fn strlen(value:*i8)i64
extern fn _zag_darwin_open(path:[]u8,flags:i64)i64
struct Kevent { ident:i64, filter:i16, flags:u16, fflags:u32, data:i64, udata:i64 }

fn main() i32 {
    let kq:i64 = _zag_darwin_syscall(362,0,0,0,0,0,0);
    if (kq < 0) { return 1; }
    let dot:ArrayList[u8]=make[u8](2); push[u8](&dot,'/'); push[u8](&dot,0 as u8);
    let ptr:*i8=_zag_slice_ptr(dot.data[0..dot.len]);
    if (ptr[0] != '/') { return 4; }
    if (ptr[1] != 0) { return 5; }
    if (strlen(ptr) != 1) { return 7; }
    let wrote:i64=_zag_darwin_syscall(4,1,ptr as i64,1,0,0,0);
    if (wrote != 1) { return 6; }
    let source:[]u8="/";
    let fd:i64 = _zag_darwin_open(source,0);
    if (fd < 0) { return 2; }
    let ev:Kevent=Kevent{.ident=fd,.filter=(-4) as i16,.flags=33 as u16,.fflags=127 as u32,.data=0,.udata=0};
    let rc:i64=_zag_darwin_syscall(363,kq,(&ev) as i64,1,0,0,0);
    if (rc < 0) { return (0 - rc) as i32; }
    let _fd_closed:i64 = _zag_darwin_syscall(6,fd,0,0,0,0,0);
    let _closed:i64 = _zag_darwin_syscall(6,kq,0,0,0,0,0);
    return 42;
}
