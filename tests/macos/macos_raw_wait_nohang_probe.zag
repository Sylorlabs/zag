extern fn _zag_raw_syscall(num:i64,a1:i64,a2:i64,a3:i64,a4:i64,a5:i64,a6:i64)i64

fn main() i32 {
    let pid:i64=_zag_raw_syscall(57,0,0,0,0,0,0);
    if(pid<0){return 10;}
    if(pid==0){
        let ts:*i64=new(0); ts[0]=0;ts[1]=100000000;
        let _n:i64=_zag_raw_syscall(35,ts as i64,0,0,0,0,0);
        return 0;
    }
    let status:*i64=new(0);
    let first:i64=_zag_raw_syscall(61,pid,status as i64,1,0,0,0);
    if(first<0){return 20+(0-first) as i32;}
    let final:i64=_zag_raw_syscall(61,pid,status as i64,0,0,0,0);
    if(final!=pid){return 30;}
    return 42;
}
