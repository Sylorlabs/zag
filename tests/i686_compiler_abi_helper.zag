// Keep the argument use in a second compiler-produced object.  A nested
// helper call makes the external ABI boundary coexist with another ordinary
// i386 call and its caller stack cleanup.
fn add(left:i32, right:i32) i32 {
    return left + right;
}

pub fn external_combine(a:i32, b:i32, c:i32, d:i32, e:i32, f:i32) i32 {
    let left:i32 = add(a, b);
    let right:i32 = add(c, d);
    return left + right + e + f;
}
