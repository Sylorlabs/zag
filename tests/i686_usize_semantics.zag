fn quotient(value:usize, divisor:usize) usize {
    return value / divisor;
}

fn remainder(value:usize, divisor:usize) usize {
    return value % divisor;
}

fn main() i32 {
    let maximum:usize = 4294967295;
    let from_signed:usize = (-1) as usize;
    let signed_max:usize = 2147483647;
    if (from_signed != maximum) { return 6; }
    if (maximum < signed_max) { return 7; }
    if (maximum <= signed_max) { return 1; }
    if (signed_max > maximum) { return 8; }
    if (signed_max >= maximum) { return 9; }
    if (quotient(maximum, 10) != 429496729) { return 2; }
    if (remainder(maximum, 10) != 5) { return 3; }
    let wrapped:usize = maximum + 1;
    if (wrapped != 0) { return 4; }
    let signed:i32 = maximum as i32;
    if (signed != -1) { return 5; }
    return 42;
}
