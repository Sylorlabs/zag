// End-to-end two-word integer witness for the Linux/i386 backend.  It covers
// both signed and unsigned ordering, carry/borrow, bitwise operations, shifts,
// wrapping boundaries, locals/assignment, and casts in both directions.
fn main() i32 {
    let all:u64=18446744073709551615;
    let carry:u64=4294967295+1;
    if (carry!=4294967296) { return 1; }
    let borrow:u64=carry-1;
    if (borrow!=4294967295) { return 2; }

    let wrapped:u64=all+1;
    if (wrapped!=0) { return 3; }
    if (all<=carry) { return 4; }

    let high:u64=(1 as u64)<<63;
    if (high!=9223372036854775808) { return 5; }
    if ((high>>63)!=1) { return 6; }
    if (((high|255)^15)!=9223372036854776048) { return 7; }
    if ((all&4294967295)!=4294967295) { return 8; }

    let min:i64=-9223372036854775808;
    let max:i64=9223372036854775807;
    if (min>=max) { return 9; }
    if ((min>>63)!=-1) { return 10; }
    if ((max+1)!=min) { return 11; }
    if ((min-1)!=max) { return 12; }

    let signed:i64=(-7 as i32) as i64;
    if (signed!=-7) { return 13; }
    let unsigned:u64=(255 as u8) as u64;
    if (unsigned!=255) { return 14; }
    if ((all as i32)!=-1) { return 15; }
    if (((4294967296 as u64) as bool)==false) { return 16; }

    let assigned:u64=0;
    assigned=high;
    if (assigned!=high) { return 17; }
    let signed_byte:i8=255 as i8;
    if ((signed_byte as i64)!=-1) { return 18; }
    let unsigned_half:u16=65535;
    if ((unsigned_half as u64)!=65535) { return 19; }
    let size:usize=4294967295;
    if ((size as u64)!=4294967295) { return 20; }
    if ((all as usize)!=4294967295) { return 21; }
    if ((65535 as u64) as i16!=-1) { return 22; }
    let seven:i64=7;
    if (-seven!=-7) { return 23; }
    if ((0xffffffffffffffff as u64)!=all) { return 24; }
    if ((0xdeadbeef as u64)!=3735928559) { return 25; }
    if (((4294967297 as u64)*(4294967297 as u64))!=8589934593) { return 26; }
    if ((min*-1)!=min) { return 27; }
    if ((all/4294967296)!=4294967295) { return 28; }
    if ((all%4294967296)!=4294967295) { return 29; }
    if ((all/9223372036854775809)!=1) { return 30; }
    if ((all%9223372036854775809)!=9223372036854775806) { return 31; }
    if ((-100 as i64)/7!=-14) { return 32; }
    if ((-100 as i64)%7!=-2) { return 33; }
    if ((100 as i64)/-7!=-14) { return 34; }
    if ((100 as i64)%-7!=2) { return 35; }
    if ((min/-1)!=min) { return 36; }
    if ((min%-1)!=0) { return 37; }
    if ((all*all)!=1) { return 38; }
    if ((high*2)!=0) { return 39; }
    if (((-3 as i64)*7)!=-21) { return 40; }
    if ((high/3)!=3074457345618258602) { return 41; }
    if ((high%3)!=2) { return 43; }
    if ((min/3)!=-3074457345618258602) { return 44; }
    if ((min%3)!=-2) { return 45; }
    if ((min/max)!=-1) { return 46; }
    if ((min%max)!=-1) { return 47; }
    let sample:u64=1234567890123456789;
    if ((sample/12345)!=100005499402467) { return 48; }
    if ((sample%12345)!=1674) { return 49; }
    let one:u64=1;
    if ((all/one)!=all) { return 50; }
    if ((all%one)!=0) { return 51; }
    if ((0 as u64)/all!=0) { return 52; }
    if ((min/7)!=-1317624576693539401) { return 53; }
    if ((min%7)!=-1) { return 54; }
    return 42;
}
