@import("../std/linux_drm.zag")

fn check(name:[]u8,ok:bool,f:*i32)void{
    if(ok){_zag_print("  ok  ");}else{_zag_print("  XX  ");f.*=f.*+1;}_zag_println(name);
}

fn main() i32 {
    let failures:i32=0;
    let missing:LinuxDrmProbe=linux_drm_probe("/dev/dri/renderD999");
    check("missing render node fails closed",!missing.ok&&_zag_strcmp(missing.error_code,"E_DRM_OPEN")==1,&failures);
    let live:LinuxDrmProbe=linux_drm_probe("/dev/dri/renderD128");
    _zag_print("  info driver='");_zag_print(live.driver_name);_zag_print("' len=");
    _zag_print(_zag_i64_to_str(live.driver_name.len as i64));_zag_print(" error=");
    _zag_println(live.error_code);
    check("raw openat/ioctl/close queries the live kernel DRM driver",live.ok&&live.driver_name.len>0,&failures);
    check("the current render node is the expected AMDGPU kernel driver",linux_drm_is_amdgpu(live),&failures);
    let gfx:LinuxAmdgpuHwIp=linux_amdgpu_hw_ip(live.render_node,0);
    _zag_print("  info gfx ok=");if(gfx.ok){_zag_print("yes");}else{_zag_print(gfx.error_code);}
    _zag_print(" version=");_zag_print(_zag_i64_to_str(gfx.version_major as i64));_zag_print(".");
    _zag_print(_zag_i64_to_str(gfx.version_minor as i64));_zag_print(" rings=");_zag_println(_zag_i64_to_str(gfx.available_rings as i64));
    check("direct AMDGPU_INFO reports the live GFX10 IP and rings",gfx.ok&&gfx.version_major==10&&gfx.available_rings>0,&failures);
    let compute:LinuxAmdgpuHwIp=linux_amdgpu_hw_ip(live.render_node,1);
    _zag_print("  info compute ok=");if(compute.ok){_zag_print("yes");}else{_zag_print(compute.error_code);}
    _zag_print(" version=");_zag_print(_zag_i64_to_str(compute.version_major as i64));_zag_print(".");
    _zag_print(_zag_i64_to_str(compute.version_minor as i64));_zag_print(" rings=");_zag_println(_zag_i64_to_str(compute.available_rings as i64));
    check("direct AMDGPU_INFO reports the live compute IP and rings",compute.ok&&compute.version_major==10&&compute.available_rings>0,&failures);
    check("unsupported AMDGPU IP types fail before ioctl",!linux_amdgpu_hw_ip(live.render_node,9).ok,&failures);
    let device:LinuxAmdgpuDeviceInfo=linux_amdgpu_device_info(live.render_node);
    _zag_print("  info device=");_zag_print(_zag_i64_to_str(device.device_id as i64));
    _zag_print(" va=");_zag_print(_zag_i64_to_str(device.va_offset));_zag_print("..");
    _zag_print(_zag_i64_to_str(device.va_max));_zag_print(" align=");_zag_println(_zag_i64_to_str(device.va_alignment as i64));
    check("direct AMDGPU device info identifies Navi10 and bounded GPUVM parameters",device.ok&&device.device_id==0x731F&&device.active_cus>0&&device.wave_size==32&&device.va_alignment>0&&device.va_max>device.va_offset,&failures);
    let gpuvm:LinuxAmdgpuGpuVmResult=linux_amdgpu_gpuvm_roundtrip(live.render_node);
    check("bounded GTT BO maps and unmaps in GPUVM without a context or submission",gpuvm.ok&&gpuvm.mapped&&gpuvm.unmapped&&gpuvm.gem_closed,&failures);
    let memory:LinuxAmdgpuMemoryResult=linux_amdgpu_memory_roundtrip(live.render_node,4096);
    check("bounded GTT GEM create mmap CPU roundtrip unmap and close succeeds without submission",memory.ok&&memory.exact_readback&&memory.gem_closed,&failures);
    check("memory-only tier rejects unreviewed allocation sizes before ioctl",!linux_amdgpu_memory_roundtrip(live.render_node,8192).ok,&failures);
    if(failures==0){
        _zag_print("LINUX DRM DISCOVERY: ALL PASS driver=");_zag_print(live.driver_name);
        _zag_print(" version=");_zag_print(_zag_i64_to_str(live.version_major as i64));
        _zag_print(".");_zag_print(_zag_i64_to_str(live.version_minor as i64));
        _zag_print(".");_zag_println(_zag_i64_to_str(live.version_patchlevel as i64));
        return 0;
    }
    return 1;
}
