struct P { x: i32 }
union V { p: P, n: i32, s: []u8 }
fn tag_val(v: V) i32 {
    switch (v) { .p => |c| { return c.*.x; } .n => |m| { return m; } .s => |t| { return t.len; } }
    return 0;
}
fn main() i32 {
    let v: V = V{ .n = 30 };
    let a: i32 = tag_val(v);
    v = V{ .s = "abcdefgh" };
    let b: i32 = tag_val(v);
    v = V{ .p = P{ .x = 4 } };
    return a + b + tag_val(v);   // 30+8+4 = 42
}
