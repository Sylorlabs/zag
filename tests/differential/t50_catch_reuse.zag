error { A, B }
fn f(x: i32) !i32 { if (x == 0) { return error.A; } return x; }
fn g(x: i32) !i32 { if (x == 0) { return error.B; } return x * 2; }
fn main() i32 {
    let a: i32 = f(0) catch |e| e + 10;    // code(A)+10
    let b: i32 = g(0) catch |e| e + 20;    // code(B)+20
    let c: i32 = f(5) catch |e| e;         // 5
    print_int(a); print_int(b); print_int(c);
    return a + b + c;
}
