fn main() i32 {
    let c: i32 = 0;
    if (!@strEq("abc", "abcd")) { c = c + 1; }
    if (!@strEq("abcd", "abc")) { c = c + 1; }
    if (@strEq("", "")) { c = c + 1; }
    if (!@strEq("", "x")) { c = c + 1; }
    let s: []u8 = "abc";
    if (@strEq(s[0..0], "")) { c = c + 37; }
    return c + 1;
}
