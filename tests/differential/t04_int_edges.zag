fn main() i32 {
    let a: i64 = 9223372036854775807;
    let b: i64 = a + 1;                       // wraps to i64 min
    let c: i64 = (0 - 7) / 2;                 // -3 (trunc toward zero)
    let d: i64 = (0 - 7) % 2;                 // -1
    let e: i64 = 7 / (0 - 2);                 // -3
    print_int(b); print_int(c); print_int(d); print_int(e);
    return 0;
}
