// Callee-side witness for field loads, x87 arithmetic, local aggregate
// initialization, and hidden-sret publication of the mixed float layout.
struct FloatPacket {
    head:f32,
    wide:f64,
    tail:f32,
    tag:i32,
}

pub fn transform_float_packet(packet:FloatPacket) FloatPacket {
    let result:FloatPacket=FloatPacket{
        .head=packet.head*2.0,
        .wide=packet.wide*2.0,
        .tail=packet.tail+1.5,
        .tag=packet.tag+7,
    };
    return result;
}
