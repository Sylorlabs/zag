// Executable characterization of the existing unbounded primitive. This is not
// a bounded-process API: capture blocks until the child closes stdout.
fn main() i32 {
    let start: i64 = _zag_clock_monotonic_ms();
    let output: []u8 = _zag_exec_capture("sleep 0.08; printf done");
    let elapsed: i64 = _zag_clock_monotonic_ms() - start;
    if (!@strEq(output, "done")) { return 1; }
    // A hypothetical 10ms wrapper around this primitive cannot enforce its
    // deadline: control returns only after the child has completed.
    if (elapsed < 50) { return 2; }
    return 0;
}
