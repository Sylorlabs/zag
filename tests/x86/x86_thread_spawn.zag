// A real Linux/x86-64 spawn/join witness.  Four independent child entries
// atomically increment a zero-initialized global; all handles are consumed by
// join before the parent observes the result.
global let thread_counter:i64;
global let thread_gate:i32;

fn increment_worker() void {
    unsafe {
        let gate:*mut i32 = (&thread_gate) as *mut i32;
        let _wait:i64 = @atomicWait32(gate, 0);
        let p:*mut i64 = (&thread_counter) as *mut i64;
        let _old:i64 = @atomicFetchAdd64(p, 1);
    }
}

fn main() i32 {
    unsafe {
        let a:*opaque = @threadSpawn(increment_worker);
        let b:*opaque = @threadSpawn(increment_worker);
        let c:*opaque = @threadSpawn(increment_worker);
        let d:*opaque = @threadSpawn(increment_worker);
        // Let every child reach the kernel wait path before releasing the gate.
        // A mismatched late arrival returns -EAGAIN and still rechecks safely.
        thread_gate = 1;
        let gate:*mut i32 = (&thread_gate) as *mut i32;
        let _woken:i64 = @atomicWake32(gate, 4);
        @threadJoin(a);
        @threadJoin(b);
        @threadJoin(c);
        @threadJoin(d);
        let p:*const i64 = (&thread_counter) as *const i64;
        if (@atomicLoad64(p) == 4) { return 42; }
        return 1;
    }
}
