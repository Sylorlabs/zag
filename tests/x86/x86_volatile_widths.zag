fn main()i32{
    let half:u16=0;
    let dword:u32=0;
    unsafe {
        let hp:*mut u16=(&half) as *mut u16;
        let dp:*mut u32=(&dword) as *mut u32;
        @volatileStore16(hp, 131071);
        @volatileStore32(dp, 4294967295);
        let h:u16=@volatileLoad16(hp);
        let d:u32=@volatileLoad32(dp);
        if(h!=65535){return 1;}
        if(d!=4294967295){return 2;}
    }
    return 42;
}
