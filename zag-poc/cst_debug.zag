@import("selfhost/script_syntax.zag")
fn p(n:i32)void{_zag_print(_zag_i64_to_str(n as i64));_zag_print(" ");}
fn main()i32{
 let s:[]u8="script;\n// x\nprintln(\".allocator .device .layout\");\n";
 let c:ZsCst=script_syntax_cst(s);
 let li:i32=0;while(li<c.lines.len){let l:ZsCstLine=c.lines.data[li];p(li);p(l.kind);p(l.content_start);p(l.content_end);p(l.token_start);p(l.token_end);_zag_println("");li=li+1;}
 let b:ZsExprTokenBounds=zs_cst_expr_token_bounds(s,c.tokens,13,51);p(b.first);p(b.last);p(b.valid);_zag_println("");
 let n:ZsNormalized=script_syntax_normalize_with_origins(s);_zag_println(n.source);return 0;
}
