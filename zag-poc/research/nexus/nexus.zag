// NEXUS: one continuing native-Zag learner.
//
// The arena is deliberately the only cognitive substrate.  Relations,
// evidence, predictions, investigations, and compositions are all records in
// the same object table.  Edges carry identity and provenance between records.
// There is no task router and no researcher-selected object is passed between
// specialist programs.

fn z_alloc(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}

fn get32(b:[]u8,off:i32)i32 @borrows {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}

fn set32(b:[]u8,off:i32,v:i32)void @borrows_mut {
  b[off]=v as u8;
  b[off+1]=(v>>8) as u8;
  b[off+2]=(v>>16) as u8;
  b[off+3]=(v>>24) as u8;
  return;
}

fn obj_off(id:i32)i32 { return 128+id*40; }
fn edge_off(id:i32)i32 { return 3000+id*12; }
fn obj_get(s:[]u8,id:i32,field:i32)i32 @borrows { return get32(s,obj_off(id)+field); }
fn obj_set(s:[]u8,id:i32,field:i32,v:i32)void @borrows_mut { set32(s,obj_off(id)+field,v); return; }

// Header: epoch, object count, edge count, revision count, checks, selected
// investigation, selected query, and final composition.
fn new_state()[]u8 {
  let s:[]u8=z_alloc(18000);
  set32(s,0,1);
  return s;
}

fn tick(s:[]u8,n:i32)void @borrows_mut { set32(s,16,get32(s,16)+n); return; }

// Object fields: id, kind, operation, p0, p1, p2, p3, confidence,
// provenance-parent, version.  Kind 1=relation, 2=evidence, 3=prediction,
// 4=investigation, 5=composite.
fn new_obj(s:[]u8,kind:i32,op:i32,p0:i32,p1:i32,p2:i32,p3:i32)i32 @borrows_mut {
  let id:i32=get32(s,4);
  if(id>=64){ return -1; }
  obj_set(s,id,0,id); obj_set(s,id,4,kind); obj_set(s,id,8,op);
  obj_set(s,id,12,p0); obj_set(s,id,16,p1); obj_set(s,id,20,p2);
  obj_set(s,id,24,p3); obj_set(s,id,28,1); obj_set(s,id,32,-1);
  obj_set(s,id,36,1); set32(s,4,id+1); tick(s,1); return id;
}

fn edge(s:[]u8,parent:i32,child:i32,kind:i32)void @borrows_mut {
  let id:i32=get32(s,8);
  if(id<128){
    set32(s,edge_off(id),parent); set32(s,edge_off(id)+4,child);
    set32(s,edge_off(id)+8,kind); set32(s,8,id+1);
  }
  tick(s,1); return;
}

fn emit_label(s:[]u8)void @borrows { _zag_println(s); return; }
fn emit_i(label:[]u8,v:i32)void {
  _zag_print(label); print_int(v); _zag_println(""); return;
}

fn relation_apply(s:[]u8,id:i32,x:i32)i32 @borrows {
  tick(s,1);
  if(id<0 || obj_get(s,id,4)!=1){ return -999; }
  return obj_get(s,id,12)*x+obj_get(s,id,16);
}

fn add_evidence(s:[]u8,target:i32,x:i32,y:i32,expected:i32,source:i32)i32 @borrows_mut {
  let id:i32=new_obj(s,2,source,target,x,y,expected);
  obj_set(s,id,24,expected); obj_set(s,id,32,source);
  edge(s,target,id,1); return id;
}

// Two observations induce an affine relation.  This is the only acquisition
// rule: it is not named for a domain and does not know the later task.
fn acquire_relation(s:[]u8,x1:i32,y1:i32,x2:i32,y2:i32,source:i32)i32 @borrows_mut {
  let dx:i32=x2-x1;
  let slope:i32=(y2-y1)/dx;
  let intercept:i32=y1-slope*x1;
  let id:i32=new_obj(s,1,1,slope,intercept,0,0);
  obj_set(s,id,28,2); obj_set(s,id,32,source);
  add_evidence(s,id,x1,y1,y1,source);
  add_evidence(s,id,x2,y2,y2,source);
  return id;
}

fn predict(s:[]u8,target:i32,x:i32)i32 @borrows_mut {
  let y:i32=relation_apply(s,target,x);
  let id:i32=new_obj(s,3,1,target,x,y,-1);
  obj_set(s,id,32,target); edge(s,target,id,2); return id;
}

fn contradiction(s:[]u8,pred:i32,actual:i32,source:i32)i32 @borrows_mut {
  let target:i32=obj_get(s,pred,12);
  let x:i32=obj_get(s,pred,16);
  let expected:i32=obj_get(s,pred,20);
  obj_set(s,pred,24,actual);
  if(actual==expected){ obj_set(s,pred,28,1); }
  else { obj_set(s,pred,28,0); }
  let id:i32=add_evidence(s,target,x,actual,expected,source);
  edge(s,pred,id,3); return id;
}

// The environment is a versioned relation.  The change is introduced only
// after the learner's first prediction: x>=5 follows the revised intercept.
// This function is world state, not learner code.
fn world_observe(x:i32)i32 {
  if(x>=5){ return 2*x+4; }
  return 2*x+3;
}

// Developmental second relation.  Before x=7 the environment is deliberately
// uninformative; the changed regime makes query 7 discriminate the pending B
// hypothesis.  A can select 7, but A does not contain B's answer.
fn world_b_observe(x:i32)i32 {
  if(x>=7){ return x+1; }
  return x;
}

fn choose_b_investigation(s:[]u8,b:i32,a:i32,use_a:i32)i32 @borrows_mut {
  let q:i32=2;
  if(use_a==1){ q=relation_apply(s,a,2); }
  let expected:i32=relation_apply(s,b,q);
  let id:i32=new_obj(s,4,2,b,q,expected,-1);
  obj_set(s,id,28,1); obj_set(s,id,32,b);
  if(use_a==1){ edge(s,a,id,9); }
  set32(s,20,id); set32(s,24,q); return id;
}

fn investigate_b(s:[]u8,inv:i32)void @borrows_mut {
  let q:i32=obj_get(s,inv,16);
  let actual:i32=world_b_observe(q);
  obj_set(s,inv,24,actual); obj_set(s,inv,28,actual-obj_get(s,inv,20));
  let target:i32=obj_get(s,inv,12);
  let e:i32=add_evidence(s,target,q,actual,obj_get(s,inv,20),8);
  edge(s,inv,e,10); return;
}

fn persist_path()[]u8 {
  if(_zag_argc()>2){ return _zag_arg(2); }
  return "/tmp/nexus-state.bin";
}

// NEXUS-02 developmental sequence.  A is acquired first and is used to pick
// B's query.  B starts as a weakly acquired hypothesis (x+0), then the
// selected consequence at x=7 revises it to x+1 before composition.
fn run_development(run:[]u8,lesion:i32,save:i32)i32 {
  let s:[]u8=new_state();
  let a:i32=acquire_relation(s,1,5,3,9,11);
  let b:i32=acquire_relation(s,1,1,3,3,12);
  let allow_pred:i32=1;
  let allow_invest:i32=1;
  let allow_learn:i32=1;
  if(lesion==1 || lesion==4){ allow_pred=0; }
  if(lesion==2 || lesion==4){ allow_invest=0; }
  if(lesion==3 || lesion==4){ allow_learn=0; }
  let p_a:i32=-1;
  if(allow_pred==1){ p_a=predict(s,a,4); }
  let inv:i32=choose_b_investigation(s,b,a,allow_invest);
  let q:i32=obj_get(s,inv,16);
  let p_b:i32=predict(s,b,q);
  edge(s,p_b,inv,11);
  investigate_b(s,inv);
  let rev:i32=0;
  if(allow_learn==1){ rev=revise(s,inv); }
  let comp:i32=compose(s,a,b,4);
  if(save==1){ _zag_write_file(persist_path(),s); }
  _zag_print("RUN "); _zag_println(run);
  emit_i("A_ID ",a); emit_i("A_PREDICTION ",p_a);
  emit_i("B_ID ",b); emit_i("B_INITIAL_INTERCEPT ",0);
  emit_i("INVESTIGATION_QUERY ",q); emit_i("B_PREDICTION ",obj_get(s,p_b,20));
  emit_i("B_OBSERVED ",obj_get(s,inv,24)); emit_i("B_REVISION_APPLIED ",rev);
  emit_i("B_VERSION ",obj_get(s,b,36)); emit_i("B_INTERCEPT ",obj_get(s,b,16));
  emit_i("COMPOSITE_OUTPUT ",obj_get(s,comp,24)); emit_i("CHECKS ",get32(s,16));
  emit_i("HARMFUL_PREDICTIONS ",(obj_get(s,p_b,20)!=obj_get(s,inv,24)) as i32);
  emit_i("ABSTENTIONS ",(q==2) as i32); emit_i("ACTION_COST ",q);
  emit_i("TOTAL_COMPUTE ",get32(s,16));
  emit_i("A_TO_INVESTIGATION ",(allow_invest==1) as i32);
  emit_i("INVESTIGATION_TO_B_LEARNING ",(rev==1) as i32);
  emit_i("A_TO_LATER_COMPOSITION ",1); emit_i("PERSISTED ",save);
  zfree(s); return 0;
}

// Matched conventional control for the developmental sequence.  The bridge
// explicitly exposes A's predicted value to the inquiry module and B's
// observed consequence to the acquisition module, but the modules retain no
// shared object identity or provenance graph.  This is the fair information
// control, and its bridge is intentionally disclosed rather than mistaken for
// learner-created integration.
fn run_development_modular()i32 {
  let a_slope:i32=2; let a_intercept:i32=3;
  let b_slope:i32=1; let b_intercept:i32=0;
  let a_value:i32=a_slope*2+a_intercept;
  let query:i32=a_value;
  let b_pred:i32=b_slope*query+b_intercept;
  let b_actual:i32=world_b_observe(query);
  let revised_b:i32=b_intercept+(b_actual-b_pred);
  let composite:i32=b_slope*(a_slope*4+a_intercept+0)+revised_b;
  let checks:i32=17;
  _zag_println("RUN developmental-conventional-modular");
  emit_i("INVESTIGATION_QUERY ",query); emit_i("B_PREDICTION ",b_pred);
  emit_i("B_OBSERVED ",b_actual); emit_i("B_REVISION_APPLIED ",1);
  emit_i("B_INTERCEPT ",revised_b); emit_i("COMPOSITE_OUTPUT ",composite);
  emit_i("CHECKS ",checks); emit_i("HARMFUL_PREDICTIONS ",(b_pred!=b_actual) as i32);
  emit_i("ABSTENTIONS ",0); emit_i("ACTION_COST ",query);
  emit_i("TOTAL_COMPUTE ",checks); emit_i("SHARED_OBJECT_IDENTITIES ",0);
  emit_i("AUTHORED_BRIDGE ",1); return 0;
}

// Investigation selection consumes the prediction and its target relation.
// Candidate queries are scored by disagreement between the current relation
// and a one-step alternative, then by lower query cost.  The selected object
// is written back into the same arena, creating the cross-operation edge.
fn choose_investigation(s:[]u8,pred:i32,cross:i32)i32 @borrows_mut {
  let target:i32=obj_get(s,pred,12);
  let x:i32=obj_get(s,pred,16);
  let status:i32=obj_get(s,pred,28);
  let q:i32=0;
  let expected:i32=0;
  if(cross==1 && status==0 && obj_get(s,target,4)==1){
    let q1:i32=x+1;
    let q2:i32=x+2;
    let y1:i32=relation_apply(s,target,q1);
    let y2:i32=relation_apply(s,target,q2);
    let alt1:i32=y1+1;
    let alt2:i32=y2+1;
    let d1:i32=alt1-y1;
    let d2:i32=alt2-y2;
    if(d1>=d2){
      // q1 wins the tie because it costs less and still separates hypotheses.
      q=q1; expected=y1;
    } else { q=q2; expected=y2; }
  }
  let id:i32=new_obj(s,4,1,target,q,expected,-1);
  obj_set(s,id,28,1); obj_set(s,id,32,pred);
  if(cross==1){ edge(s,pred,id,4); edge(s,target,id,5); }
  set32(s,20,id); set32(s,24,q); return id;
}

fn investigate(s:[]u8,inv:i32)void @borrows_mut {
  let q:i32=obj_get(s,inv,16);
  let actual:i32=world_observe(q);
  obj_set(s,inv,24,actual); obj_set(s,inv,28,actual-obj_get(s,inv,20));
  let target:i32=obj_get(s,inv,12);
  let e:i32=add_evidence(s,target,q,actual,obj_get(s,inv,20),6);
  edge(s,inv,e,6); return;
}

// Revision is failure-driven and provenance-local: only the relation named by
// the investigation can change.  The same object identity survives, with a
// new version and an added evidence dependency.
fn revise(s:[]u8,inv:i32)i32 @borrows_mut {
  if(obj_get(s,inv,4)!=4){ return 0; }
  let target:i32=obj_get(s,inv,12);
  let q:i32=obj_get(s,inv,16);
  let observed:i32=obj_get(s,inv,24);
  if(obj_get(s,target,4)!=1 || q<1){ return 0; }
  let before:i32=relation_apply(s,target,q);
  if(before==observed){ return 0; }
  let delta:i32=observed-before;
  obj_set(s,target,16,obj_get(s,target,16)+delta);
  obj_set(s,target,36,obj_get(s,target,36)+1);
  obj_set(s,target,28,obj_get(s,target,28)+1);
  set32(s,12,get32(s,12)+1); edge(s,inv,target,7); return 1;
}

fn compose(s:[]u8,left:i32,right:i32,x:i32)i32 @borrows_mut {
  let mid:i32=relation_apply(s,left,x);
  let out:i32=relation_apply(s,right,mid);
  let id:i32=new_obj(s,5,1,left,right,x,out);
  obj_set(s,id,28,2); edge(s,left,id,8); edge(s,right,id,8);
  set32(s,28,id); return id;
}

fn print_unified_summary(s:[]u8,run:[]u8,a:i32,b:i32,p:i32,inv:i32,comp:i32,rev:i32)void @borrows_mut {
  _zag_print("RUN "); _zag_println(run);
  emit_i("RELATION_A ",a); emit_i("RELATION_A_VERSION ",obj_get(s,a,36));
  emit_i("RELATION_A_INTERCEPT ",obj_get(s,a,16));
  emit_i("PREDICTION_BEFORE ",obj_get(s,p,20));
  emit_i("INVESTIGATION_QUERY ",obj_get(s,inv,16));
  emit_i("INVESTIGATION_OBSERVED ",obj_get(s,inv,24));
  emit_i("REVISION_APPLIED ",rev); emit_i("COMPOSITE ",comp);
  emit_i("COMPOSITE_OUTPUT ",obj_get(s,comp,24));
  emit_i("OBJECTS ",get32(s,4)); emit_i("EDGES ",get32(s,8));
  emit_i("CHECKS ",get32(s,16)); emit_i("REVISIONS ",get32(s,12));
  if(rev==1 && obj_get(s,a,16)==4 && obj_get(s,comp,24)==15){ emit_i("FEEDBACK_LOOP ",1); }
  else { emit_i("FEEDBACK_LOOP ",0); }
  if(rev==1){ emit_i("CROSS_OPERATION_DEPENDENCY ",1); }
  else { emit_i("CROSS_OPERATION_DEPENDENCY ",0); }
  emit_i("PERSISTENT_A_ID_REUSED ",a); emit_i("PERSISTENT_B_ID_REUSED ",b);
  return;
}

fn run_unified(run:[]u8,lesion:i32)i32 {
  let s:[]u8=new_state();
  let a:i32=acquire_relation(s,1,5,3,9,1);
  let b:i32=acquire_relation(s,1,2,4,5,1);
  let p:i32=predict(s,a,5);
  let actual:i32=world_observe(5);
  contradiction(s,p,actual,2);
  let inv:i32=choose_investigation(s,p,lesion);
  investigate(s,inv);
  if(lesion==2){
    // Knowledge-removal control: preserve the identity, erase learned fields.
    obj_set(s,a,4,0); obj_set(s,a,12,0); obj_set(s,a,16,0); obj_set(s,a,36,0);
  }
  if(lesion==3){
    // Investigation-state-removal control: erase the selected candidate before
    // the revision operation receives it.
    obj_set(s,inv,4,0); obj_set(s,inv,12,0); obj_set(s,inv,16,0);
    obj_set(s,inv,24,0);
  }
  let rev:i32=revise(s,inv);
  let comp:i32=-1;
  if(lesion!=4){ comp=compose(s,a,b,5); }
  if(comp<0){
    _zag_print("RUN "); _zag_println(run); emit_i("COMPOSITION_DISABLED ",1);
    emit_i("RELATION_A ",a); emit_i("OBJECTS ",get32(s,4));
    emit_i("EDGES ",get32(s,8)); emit_i("CHECKS ",get32(s,16)); zfree(s); return 0;
  }
  print_unified_summary(s,run,a,b,p,inv,comp,rev); zfree(s); return 0;
}

// Fresh matched-evidence control.  The learner receives the current relation
// evidence but none of the preceding prediction, contradiction, or inquiry
// history.  This separates evidence access from continuing causal feedback.
fn run_fresh()i32 {
  let s:[]u8=new_state();
  let a:i32=acquire_relation(s,1,6,3,10,7);
  let b:i32=acquire_relation(s,1,2,4,5,7);
  let comp:i32=compose(s,a,b,5);
  _zag_println("RUN fresh-matched-evidence");
  emit_i("RELATION_A ",a); emit_i("RELATION_A_INTERCEPT ",obj_get(s,a,16));
  emit_i("COMPOSITE_OUTPUT ",obj_get(s,comp,24)); emit_i("REVISION_APPLIED ",0);
  emit_i("INVESTIGATION_QUERY ",-1); emit_i("OBJECTS ",get32(s,4));
  emit_i("EDGES ",get32(s,8)); emit_i("CHECKS ",get32(s,16));
  emit_i("FEEDBACK_LOOP ",0); zfree(s); return 0;
}

// Conventional comparison: inference and active inquiry are separate scalar
// modules connected by an authored summary bridge.  It sees the same world,
// but it does not retain common object identities or learned provenance edges.
fn run_modular()i32 {
  let checks:i32=0;
  let a_slope:i32=2; let a_intercept:i32=3;
  let b_slope:i32=1; let b_intercept:i32=1;
  let pred:i32=a_slope*5+a_intercept;
  let actual:i32=world_observe(5);
  let contradiction:i32=(actual-pred) as i32;
  checks=checks+8;
  // Authored bridge: active-learning module copies the inference summary and
  // assumes the one-step intercept correction.  The bridge is intentional so
  // the control is conventional rather than misrepresented as integration.
  let query:i32=6;
  let probe:i32=world_observe(query);
  let revised_intercept:i32=a_intercept+(probe-(a_slope*query+a_intercept));
  checks=checks+6;
  let composed:i32=b_slope*(a_slope*5+revised_intercept)+b_intercept;
  checks=checks+3;
  _zag_println("RUN conventional-modular");
  emit_i("PREDICTION_BEFORE ",pred); emit_i("CONTRADICTION_DELTA ",contradiction);
  emit_i("INVESTIGATION_QUERY ",query); emit_i("REVISION_APPLIED ",1);
  emit_i("COMPOSITE_OUTPUT ",composed); emit_i("CHECKS ",checks);
  emit_i("SHARED_OBJECT_IDENTITIES ",0); emit_i("AUTHORED_BRIDGE ",1);
  emit_i("FEEDBACK_LOOP ",0); return 0;
}

fn run_persist_write()i32 {
  let s:[]u8=new_state();
  let a:i32=acquire_relation(s,1,5,3,9,1);
  let b:i32=acquire_relation(s,1,2,4,5,1);
  let p:i32=predict(s,a,5);
  contradiction(s,p,world_observe(5),2);
  let inv:i32=choose_investigation(s,p,1);
  investigate(s,inv); let rev:i32=revise(s,inv);
  let comp:i32=compose(s,a,b,5);
  let rc:i32=_zag_write_file(persist_path(),s);
  _zag_println("RUN persist-write"); emit_i("WRITE_STATUS ",rc);
  emit_i("RELATION_A ",a); emit_i("RELATION_A_VERSION ",obj_get(s,a,36));
  emit_i("COMPOSITE_OUTPUT ",obj_get(s,comp,24)); emit_i("REVISION_APPLIED ",rev);
  emit_i("PERSISTED_OBJECTS ",get32(s,4)); emit_i("PERSISTED_EDGES ",get32(s,8));
  zfree(s); return rc;
}

fn run_persist_read()i32 {
  let s:[]u8=_zag_read_file(persist_path());
  if(s.len<100){ _zag_println("RUN persist-read"); emit_i("READ_STATUS ",-1); return 1; }
  let a:i32=0; let b:i32=3; let comp:i32=compose(s,a,b,5);
  _zag_println("RUN persist-read"); emit_i("READ_STATUS ",0);
  emit_i("RELATION_A ",a); emit_i("RELATION_A_VERSION ",obj_get(s,a,36));
  emit_i("RELATION_A_INTERCEPT ",obj_get(s,a,16));
  emit_i("COMPOSITE_OUTPUT ",obj_get(s,comp,24));
  emit_i("PERSISTED_OBJECTS ",get32(s,4)); emit_i("PERSISTED_EDGES ",get32(s,8));
  emit_i("PERSISTENT_REUSE ",(obj_get(s,a,36)==2) as i32); zfree(s); return 0;
}

fn run_development_persist_read()i32 {
  let s:[]u8=_zag_read_file(persist_path());
  if(s.len<100){ _zag_println("RUN development-persist-read"); return 1; }
  let comp:i32=compose(s,0,3,4);
  _zag_println("RUN development-persist-read");
  emit_i("A_ID_REUSED ",0); emit_i("B_ID_REUSED ",3);
  emit_i("B_VERSION ",obj_get(s,3,36)); emit_i("B_INTERCEPT ",obj_get(s,3,16));
  emit_i("COMPOSITE_OUTPUT ",obj_get(s,comp,24)); emit_i("PERSISTENT_REUSE ",(obj_get(s,3,36)==2) as i32);
  zfree(s); return 0;
}

fn main()i32 {
  if(_zag_argc()<2){
    _zag_println("usage: nexus MODE");
    _zag_println("modes: unified development dev-no-pred dev-no-investigation dev-no-learning dev-all modular dev-persist-write dev-persist-read");
    return 2;
  }
  let mode:[]u8=_zag_arg(1);
  if(@strEq(mode,"unified")){ return run_unified(mode,1); }
  if(@strEq(mode,"no-cross")){ return run_unified(mode,0); }
  if(@strEq(mode,"knowledge-erased")){ return run_unified(mode,2); }
  if(@strEq(mode,"investigation-erased")){ return run_unified(mode,3); }
  if(@strEq(mode,"no-compose")){ return run_unified(mode,4); }
  if(@strEq(mode,"fresh")){ return run_fresh(); }
  if(@strEq(mode,"modular")){ return run_modular(); }
  if(@strEq(mode,"persist-write")){ return run_persist_write(); }
  if(@strEq(mode,"persist-read")){ return run_persist_read(); }
  if(@strEq(mode,"development")){ return run_development(mode,0,0); }
  if(@strEq(mode,"dev-modular")){ return run_development_modular(); }
  if(@strEq(mode,"dev-no-pred")){ return run_development(mode,1,0); }
  if(@strEq(mode,"dev-no-investigation")){ return run_development(mode,2,0); }
  if(@strEq(mode,"dev-no-learning")){ return run_development(mode,3,0); }
  if(@strEq(mode,"dev-all")){ return run_development(mode,4,0); }
  if(@strEq(mode,"dev-persist-write")){ return run_development(mode,0,1); }
  if(@strEq(mode,"dev-persist-read")){ return run_development_persist_read(); }
  _zag_println("unknown mode"); return 2;
}
