# UNCOMPILED / UNEXECUTED; proposed E0010 diagnostic. NOT APPLIED.
# Context verified against parse.zag at 1d7d405679e043ff220b1df20852f1a07729349a.
diff --git a/zag-poc/selfhost/parse.zag b/zag-poc/selfhost/parse.zag
--- a/zag-poc/selfhost/parse.zag
+++ b/zag-poc/selfhost/parse.zag
@@ -1,6 +1,14 @@
+    if (at_op(p, "~")) {
+        let tilde: Token = adv(p);
+        diag_emit("E0010","unsupported unary bitwise NOT operator `~`",
+            p.*.origin,tilde.line,tilde.col,tilde.val.len,
+            "unary bitwise NOT is not supported",
+            "use supported bitwise operators instead",p.*.source);
+        _zag_exit(1);
+    }
     if (at_op(p, "-") || at_op(p, "!") || at_op(p, "&")) {
         let op: []u8 = adv(p).val;
         return parser_mark(p,mk_un(op, parse_unary(p)),start);
     }
     return parse_postfix(p);
 }
