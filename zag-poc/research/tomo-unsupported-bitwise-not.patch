diff --git a/zag-poc/selfhost/parse.zag b/zag-poc/selfhost/parse.zag
--- a/zag-poc/selfhost/parse.zag
+++ b/zag-poc/selfhost/parse.zag
@@ -1,6 +1,13 @@
+    if (at_op(p, "~")) {
+        let tok: Token = adv(p);
+        diag_emit("E0001", "unsupported bitwise NOT operator `~`",
+            p.*.origin, tok.line, tok.col, tok.val.len,
+            "unary bitwise NOT is not supported", "remove `~` or use a supported expression", p.*.source);
+        _zag_exit(1);
+    }
     if (at_op(p, "-") || at_op(p, "!") || at_op(p, "&")) {
         let op: []u8 = adv(p).val;
         return parser_mark(p,mk_un(op, parse_unary(p)),start);
     }
     return parse_postfix(p);
 }
