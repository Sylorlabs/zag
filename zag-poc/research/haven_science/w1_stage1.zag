// LCG PRNG and likelihood table for Haven Science w1 stage1

// LCG state
fn lcg_next(state: i32) i32 {
    let a: i32 = 1664525
    let c: i32 = 1013904223
    let m: i32 = 2147483647
    let next: i32 = (a * state + c) % m
    return next
}

// Extract a single bit from state
fn lcg_bit(state: i32) i32 {
    return state & 1
}

// Generate random number in range [0, n)
fn lcg_range(state: i32, n: i32) i32 {
    return state % n
}

// Likelihood function: returns integer percent for hypothesis h, action a, outcome (x,y)
// h: 0..3, a: 0..5 (0=observe, 1=do X=0, 2=do X=1, 3=do Y=0, 4=do Y=1, 5=noop)
fn lik(h: i32, a: i32, x: i32, y: i32) i32 {
    if (h == 0) {
        if (a == 0) {
            if (y == x) {
                return 45
            } else {
                return 5
            }
        } else if (a == 1) {
            if (x != 0) {
                return 0
            } else if (y == 0) {
                return 90
            } else {
                return 10
            }
        } else if (a == 2) {
            if (x != 1) {
                return 0
            } else if (y == 1) {
                return 90
            } else {
                return 10
            }
        } else if (a == 3) {
            if (y != 0) {
                return 0
            } else {
                return 50
            }
        } else if (a == 4) {
            if (y != 1) {
                return 0
            } else {
                return 50
            }
        } else {
            return 25
        }
    } else if (h == 1) {
        if (a == 0) {
            if (x == y) {
                return 45
            } else {
                return 5
            }
        } else if (a == 1) {
            if (x != 0) {
                return 0
            } else {
                return 50
            }
        } else if (a == 2) {
            if (x != 1) {
                return 0
            } else {
                return 50
            }
        } else if (a == 3) {
            if (y != 0) {
                return 0
            } else if (x == 0) {
                return 90
            } else {
                return 10
            }
        } else if (a == 4) {
            if (y != 1) {
                return 0
            } else if (x == 1) {
                return 90
            } else {
                return 10
            }
        } else {
            return 25
        }
    } else if (h == 2) {
        if (a == 0) {
            if (x == y) {
                return 41
            } else {
                return 9
            }
        } else if (a == 1) {
            if (x != 0) {
                return 0
            } else {
                return 50
            }
        } else if (a == 2) {
            if (x != 1) {
                return 0
            } else {
                return 50
            }
        } else if (a == 3) {
            if (y != 0) {
                return 0
            } else {
                return 50
            }
        } else if (a == 4) {
            if (y != 1) {
                return 0
            } else {
                return 50
            }
        } else {
            return 25
        }
    } else {
        if (a == 0) {
            return 25
        } else if (a == 1) {
            if (x != 0) {
                return 0
            } else {
                return 50
            }
        } else if (a == 2) {
            if (x != 1) {
                return 0
            } else {
                return 50
            }
        } else if (a == 3) {
            if (y != 0) {
                return 0
            } else {
                return 50
            }
        } else if (a == 4) {
            if (y != 1) {
                return 0
            } else {
                return 50
            }
        } else {
            return 25
        }
    }
}

fn main() void {
    let h: i32 = 0
    while (h < 4) {
        let a: i32 = 0
        while (a < 6) {
            let sum: i32 = 0
            let x: i32 = 0
            while (x < 2) {
                let y: i32 = 0
                while (y < 2) {
                    let p: i32 = lik(h, a, x, y)
                    sum = sum + p
                    y = y + 1
                }
                x = x + 1
            }
            if (sum == 100) {
                print_i32(1)
            } else {
                print_i32(0)
                print_i32(h)
                print_i32(a)
                print_i32(sum)
            }
            a = a + 1
        }
        h = h + 1
    }

    let state: i32 = 12345
    let i: i32 = 0
    while (i < 5) {
        state = lcg_next(state)
        let bit: i32 = lcg_bit(state)
        print_i32(bit)
        i = i + 1
    }
}
