// UNCOMPILED / UNEXECUTED — numeric conversion hypothesis probe.
// In zag-poc with a rebuilt ./znc, for an authorized executor:
//   ./znc research/tomo_numeric_conversion_probe.zag -o /tmp/tomo-numeric-probe --no-zagd --no-foreground-cache
//   /tmp/tomo-numeric-probe; echo "exit=$?"
// Predicted exit=0 IF all tested conversions implement the hypotheses below.
// Compiler rejection, a different exit code, or a crash is evidence to inspect,
// not proof of a defect. Capture compiler identity, target, output and status.
// Results 11-17 identify the first failing expectation. Earlier failures
// prevent later checks; split the fixture to isolate multiple mismatches.

fn main() i32 {
    let big:i64 = 4294967297;
    let narrow_local:i32 = big;
    if (narrow_local != 1) { return 11; }

    let narrow_assignment:i32 = 0;
    narrow_assignment = big;
    if (narrow_assignment != 1) { return 12; }

    let negative:i64 = -2147483649;
    let negative_local:i32 = negative;
    if (negative_local != 2147483647) { return 13; }

    let negative_assignment:i32 = 0;
    negative_assignment = negative;
    if (negative_assignment != 2147483647) { return 14; }

    let explicitly_cast:i32 = big as i32;
    if (explicitly_cast != 1) { return 15; }

    let source:i32 = -7;
    let widened:i64 = source;
    if (widened != -7) { return 16; }

    let explicit_widened:i64 = source as i64;
    if (explicit_widened != -7) { return 17; }
    return 0;
}
