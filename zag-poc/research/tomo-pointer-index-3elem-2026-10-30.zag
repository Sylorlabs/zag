// SOURCE-ONLY / UNCOMPILED / UNEXECUTED.
// Three-element index/address regression candidate.  The v1 spec does not
// support pointer arithmetic: this tests &values[k], not values + k.
// Native exit 0 is expected; exit 1 denotes allocation failure and 2-6
// identify which supported indexing/address-of check failed. Not yet verified.
fn main() i32 {
    let values:*usize = _zag_malloc(24);
    if (values == null) { return 1; }
    values[0] = 19;
    values[1] = 23;
    values[2] = 31;
    let second:*usize = &values[1];
    let third:*usize = &values[2];
    if (values[0] != 19) { _zag_free(values); return 2; }
    if (values[1] != 23) { _zag_free(values); return 3; }
    if (values[2] != 31) { _zag_free(values); return 4; }
    if (second[0] != 23) { _zag_free(values); return 5; }
    if (third[0] != 31) { _zag_free(values); return 6; }
    _zag_free(values);
    return 0;
}
