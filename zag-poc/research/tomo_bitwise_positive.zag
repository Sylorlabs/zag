// UNCOMPILED / UNEXECUTED: proposed positive regression for the candidate tilde diagnostic.
fn main() i32 {
    let a: i32 = 6;
    let b: i32 = 3;
    if ((a ^ b) != 5) { return 1; }
    if ((a & b) != 2) { return 2; }
    if ((a | b) != 7) { return 3; }
    if ((-a) != -6) { return 4; }
    let p: *i32 = &a;
    if (p.* != 6) { return 5; }
    if (!false) { return 0; }
    return 6;
}
