// Data-dependent control flow, identical bounded i64 arithmetic in all variants.
script;
let x: i64 = 17;
let checksum: i64 = 0;
let i: i64 = 0;
while (i < __ITERATIONS__) {
    x = (x * 109 + 1021) % 65521;
    if (x % 4 == 0) {
        checksum = (checksum + x * 7 + 3) % 1000000007;
    } else if (x % 4 == 1) {
        checksum = (checksum + x * 11 + 5) % 1000000007;
    } else if (x % 4 == 2) {
        checksum = (checksum + x * 13 + 7) % 1000000007;
    } else {
        checksum = (checksum + x * 17 + 9) % 1000000007;
    }
    i = i + 1;
}
println(checksum);
return 0;
