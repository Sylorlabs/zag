// Function-call-heavy recurrence; compilers may inline according to their optimizers.
script;
fn advance(x: i64) i64 { return (x * 109 + 1021) % 65521; }
fn accumulate(checksum: i64, x: i64) i64 {
    return (checksum + x * 7 + 3) % 1000000007;
}
let x: i64 = 17;
let checksum: i64 = 0;
let i: i64 = 0;
while (i < __ITERATIONS__) {
    x = advance(x);
    checksum = accumulate(checksum, x);
    i = i + 1;
}
println(checksum);
return 0;
