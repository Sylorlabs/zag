// benchmarks/cases/loop_chain.zag
// Scalar integer dependency-chain benchmark. No memory traffic or SIMD path:
// each iteration depends on the previous value, so this measures ordinary
// integer lowering, loop control, and process output.
fn main() i32 {
    let value: i32 = 123456789;
    let i: i32 = 0;
    while (i < 50000000) {
        value = value * 1664525 + 1013904223;
        value = value & 2147483647;
        i = i + 1;
    }
    if (value != 686528917) { return 1; }
    _zag_println(_zag_i64_to_str(value as i64));
    return 0;
}
