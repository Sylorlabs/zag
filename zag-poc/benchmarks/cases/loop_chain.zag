// benchmarks/cases/loop_chain.zag
// Scalar integer dependency-chain benchmark. No memory traffic or SIMD path.
// The recurrence is bounded: value is at most 2^24-1, and its largest
// multiply-add intermediate is below the signed 32-bit limit.
fn main() i32 {
    let value: i32 = 1234567;
    let i: i32 = 0;
    while (i < 50000000) {
        value = value * 33 + 17;
        value = value & 16777215;
        i = i + 1;
    }
    if (value != 14333703) { return 1; }
    _zag_println(_zag_i64_to_str(value as i64));
    return 0;
}
