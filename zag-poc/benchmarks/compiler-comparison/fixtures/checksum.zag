struct State {
    value: u64,
    checksum: u64,
    minimum: u64,
    maximum: u64,
}

fn fold0(x: u64) u64 { return (x + 17) % 1000000007; }
fn fold1(x: u64) u64 { return (x * 3 + 5) % 1000000007; }
fn fold2(x: u64) u64 { return (x ^ (x >> 7)) % 1000000007; }
fn fold3(x: u64) u64 { return (x * 11 + 97) % 1000000007; }
fn fold4(x: u64) u64 { return (x + (x >> 3) + 23) % 1000000007; }
fn fold5(x: u64) u64 { return (x * 13 + 101) % 1000000007; }
fn fold6(x: u64) u64 { return (x ^ (x << 5)) % 1000000007; }
fn fold7(x: u64) u64 { return (x * 19 + 7) % 1000000007; }

fn mix(x: u64) u64 {
    return fold7(fold6(fold5(fold4(fold3(fold2(fold1(fold0(x))))))));
}

fn advance(state: *State) void {
    state.*.value = (state.*.value * 48271 + 1) % 2147483647;
    let item: u64 = mix(state.*.value);
    state.*.checksum = (state.*.checksum + item) % 1000000007;
    if (item < state.*.minimum) { state.*.minimum = item; }
    if (item > state.*.maximum) { state.*.maximum = item; }
}

fn run(rounds: i32) u64 {
    let state: State = State{
        .value = 1234567,
        .checksum = 0,
        .minimum = 1000000007,
        .maximum = 0,
    };
    let i: i32 = 0;
    while (i < rounds) {
        advance(&state);
        i = i + 1;
    }
    return (state.checksum + state.minimum + state.maximum) % 1000000007;
}

fn main() i32 {
    let result: u64 = run(2000000);
    if (result != 115663923) { return 1; }
    _zag_println(_zag_i64_to_str(result as i64));
    return 0;
}
