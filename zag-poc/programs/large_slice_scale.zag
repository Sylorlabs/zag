// programs/large_slice_scale.zag — one slice far past the 2^25-byte mark.
//
// Regression guard. A `[]u8` slice must behave identically at any length: the
// element count is a value, not a width that some internal field can clip. A
// single 88 MiB slice (the S100 audit-ledger size: 1,048,576 entries x 21
// words x 4 bytes) must allocate, report its exact length, bounds-check
// correctly, and store correct bytes at offsets on both sides of 2^25.
//
// The failure this guards against is silent: a clipped or wrapped length turns
// a legitimate allocation into a zero-length slice, and the first read then
// reports "slice index out of bounds" at index 0 — an index that cannot be out
// of bounds, which reads as an impossible runtime bug rather than a capacity
// problem. This program fails loudly instead.

// Verify one allocation of `n` bytes. `stride` thins the corruption sweep so a
// very large slice stays fast in CI; planted markers are always checked.
fn verify(n: i32, stride: i32) i32 {
    let p: *i8 = _zag_malloc(n);
    if (p == null as *i8) { return 1; }
    let a: []u8 = (p as *u8)[0..n];
    if (a.len != n) { _zag_free(p); return 2; }

    let i: i32 = 0;
    while (i < n) { a[i] = 0; i = i + 1; }

    // Plant markers on both sides of the 2^25 boundary.
    a[0] = 65;
    a[n - 1] = 90;
    a[n / 2] = 5;
    let at_2_25: i32 = 0;
    let at_36m: i32 = 0;
    // Only plant these when they cannot collide with n-1 or n/2 above.
    if (n > 33554433) { a[33554432] = 2; at_2_25 = 1; }
    if (n > 37748737) { a[37748736] = 4; at_36m = 1; }

    if (a[0] != 65) { _zag_free(p); return 3; }
    if (a[n - 1] != 90) { _zag_free(p); return 4; }
    if (a[n / 2] != 5) { _zag_free(p); return 5; }
    if (at_2_25 == 1 && a[33554432] != 2) { _zag_free(p); return 6; }
    if (at_36m == 1 && a[37748736] != 4) { _zag_free(p); return 7; }

    // Sweep: every unplanted byte must still read zero.
    i = 0;
    while (i < n) {
        if (a[i] != 0) {
            if (!(i == 0 || i == n - 1 || i == n / 2 ||
                  (at_2_25 == 1 && i == 33554432) ||
                  (at_36m == 1 && i == 37748736))) {
                _zag_free(p);
                return 8;
            }
        }
        i = i + stride;
    }

    _zag_free(p);
    return 0;
}

// Write `n` bytes of a known pattern, read the file back with _zag_read_file,
// and compare every byte. Exercises the realloc-doubling read loop at scale.
fn roundtrip_file(n: i32) i32 {
    let src: []u8 = (_zag_malloc(n) as *u8)[0..n];
    if (src.len != n) { return 1; }
    let i: i32 = 0;
    while (i < n) { src[i] = (i % 251) as u8; i = i + 1; }
    if (_zag_write_file("/tmp/zag_large_slice_ledger.bin", src) != 0) { return 2; }

    let back: []u8 = _zag_read_file("/tmp/zag_large_slice_ledger.bin");
    if (back.len != n) { return 3; }
    i = 0;
    while (i < n) {
        if (back[i] != (i % 251) as u8) { return 4; }
        i = i + 1;
    }
    return 0;
}

fn main() i32 {
    // 2^25 + 1 — the first length above the folklore ceiling.
    let small: i32 = verify(33554433, 1);
    if (small != 0) {
        _zag_print("2^25+1: FAIL ");
        _zag_print(_zag_i64_to_str(small as i64));
        _zag_print("\n");
        return small;
    }
    _zag_print("2^25+1: PASS\n");

    // 88 MiB — the full S100 audit ledger as a single slice.
    let big: i32 = verify(88080384, 1024);
    if (big != 0) {
        _zag_print("88MiB: FAIL ");
        _zag_print(_zag_i64_to_str(big as i64));
        _zag_print("\n");
        return big;
    }
    _zag_print("88MiB: PASS\n");

    // Loading a ledger from disk grows its buffer by realloc doubling, a
    // different path from one malloc. Verify it end to end, byte for byte.
    let rt: i32 = roundtrip_file(88080384);
    if (rt != 0) {
        _zag_print("read_file 88MiB: FAIL ");
        _zag_print(_zag_i64_to_str(rt as i64));
        _zag_print("\n");
        return rt;
    }
    _zag_print("read_file 88MiB: PASS\n");

    _zag_print("=== DONE ===");
    return 0;
}
