// A real script-level source scanner: no imports or strict-Zag escape hatch.
script;

if (args_len() != 2) { return 2; }
let data = read_file(arg(1));
if (data.len < 0) { return 2; }

let i: i32 = 0;
let count: i32 = 0;
let in_comment: i32 = 0;
while (i < data.len) {
    if (i + 1 < data.len && data[i] == 47 && data[i + 1] == 47) { in_comment = 1; }
    if (data[i] == 10) { in_comment = 0; }
    if (in_comment == 0 && i + 7 <= data.len && data[i] == 112 && data[i + 1] == 117 && data[i + 2] == 98 && data[i + 3] == 32 && data[i + 4] == 102 && data[i + 5] == 110 && data[i + 6] == 32) { count = count + 1; }
    i = i + 1;
}
println(count);
return 0;
