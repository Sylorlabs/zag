// examples/heap_lifecycle.zag — new/delete heap object lifecycle (V1 spec).
//
// `new(T{..})` returns *T; `delete(p)` releases via _zag_free (native mmap heap).

struct Node {
    val: i32,
    next: *Node,
}

fn main() i32 {
    let a: *Node = new(Node{ .val = 10, .next = 0 as *Node });
    let b: *Node = new(Node{ .val = 32, .next = a });
    let sum: i32 = b.*.val + b.*.next.*.val;
    delete(a);
    delete(b);
    return sum;
}