script;

// Fixed capacity makes allocation and worst-case memory explicit while the
// Script context supplies the bounded default allocator.
let names = string_builder(128);
if (string_builder_append(&names, "Ada") != 0) { return 1; }
if (string_builder_append(&names, ", Grace") != 0) { return 1; }
println(string_builder_output(&names));
return 0;
