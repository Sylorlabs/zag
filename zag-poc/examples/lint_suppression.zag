// Suppression test file — demonstrates // znc:allow and // znc:allow-file.
// The B0103 lint would fire on `unused` but is suppressed by the file-level allow.
// znc:allow-file B0103

fn has_unused() i32 {
    let unused: i32 = 42;      // B0103 suppressed by file-level allow
    return 1;
}

fn has_dead_code() i32 {
    return 0;
    let x: i32 = 1;            // B0101 NOT suppressed — should still fire
}

fn has_self_assign() i32 {
    let y: i32 = 5;
    y = y;                     // A0105 suppressed by line-level allow
    // znc:allow A0105
    return y;
}

fn main() i32 {
    return has_unused() + has_dead_code() + has_self_assign();
}
