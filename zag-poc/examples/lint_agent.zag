// Agent-bug lint test file — triggers A0101, A0102, A0105, A0106, A0107, A0108,
// A0109 (default), and A0110, A0112 (pedantic).
// Run: ./znc examples/lint_agent.zag -o /tmp/lint_agent
// Run: ./znc --analyze-pedantic examples/lint_agent.zag -o /tmp/lint_agent

fn compute(x: i32) i32 {
    return x * 2;
}

fn off_by_one(buf: []i32, n: i32) i32 {
    let i: i32 = 0;
    let sum: i32 = 0;
    while (i <= n) {           // A0101: <= with indexing
        sum = sum + buf[i];
        i = i + 1;
    }
    return sum;
}

fn ignored_return() void {
    compute(5);                // A0102: ignored non-void return
}

fn self_assign(x: i32) i32 {
    let y: i32 = x;
    y = y;                     // A0105: self-assignment
    return y;
}

fn dead_computation(x: i32) void {
    x + 1;                     // A0106: dead computation
}

fn dead_loop_inc(n: i32) i32 {
    let i: i32 = 0;
    while (i > n) {            // A0107: > condition but body increments
        i = i + 1;
    }
    return i;
}

fn dup_condition(x: i32) i32 {
    if (x > 0) {
        return 1;
    }
    if (x > 0) {               // A0108: duplicate condition
        return 2;
    }
    return 0;
}

fn div_by_zero(x: i32) i32 {
    let y: i32 = x / 0;        // A0109: division by zero
    return y;
}

fn shift_too_far(x: i32) i32 {
    // A0110 (pedantic): shift by >= 32
    let y: i32 = x << 32;
    return y;
}

fn symmetric_dup(x: i32, y: i32) i32 {
    // A0112 (pedantic): symmetric condition across consecutive ifs
    if (x < y) {
        return 1;
    }
    if (y > x) {
        return 2;
    }
    return 0;
}

fn main() i32 {
    let buf: []i32 = zalloc(4);
    let r: i32 = off_by_one(buf, 3);
    ignored_return();
    r = r + self_assign(1);
    dead_computation(1);
    r = r + dead_loop_inc(0);
    r = r + dup_condition(1);
    r = r + div_by_zero(1);
    r = r + shift_too_far(1);
    r = r + symmetric_dup(1, 2);
    zfree(buf);
    return r;
}
