// Bloat lint test file — triggers B0101, B0103, B0104, B0105, B0107, B0108,
// B0109, B0110, B0113 (default), and B0102, B0111, B0112, B0115, B0120 (pedantic).
// Run: ./znc examples/lint_bloat.zag -o /tmp/lint_bloat
// Run: ./znc --analyze-pedantic examples/lint_bloat.zag -o /tmp/lint_bloat

fn is_ready(x: i32) i32 {
    // B0105: verbose boolean return
    if (x > 0) {
        return 1;
    } else {
        return 0;
    }
}

fn dead_after_return(x: i32) i32 {
    return x;
    let y: i32 = 10;  // B0101: unreachable
    y = y + 1;
}

fn unused_and_overwritten() i32 {
    let tmp: i32 = 5;       // B0103: never read
    let z: i32 = 1;
    z = 2;                   // B0104: previous assignment overwritten before read
    return z;
}

fn double_negation(x: i32) i32 {
    if (!!x == 1) {          // B0107: double negation
        return 1;
    }
    return 0;
}

fn negated_comparison(a: i32, b: i32) i32 {
    if (!(a == b)) {         // B0108: negated comparison
        return 1;
    }
    return 0;
}

fn tautological(x: i32) i32 {
    if (x == x) {            // B0110: tautological self-comparison
        return 1;
    }
    if (x == true) {         // B0109: redundant boolean literal
        return 1;
    }
    return 0;
}

fn identical_branches(x: i32) i32 {
    // B0113: if/else identical bodies
    if (x > 0) {
        return 1;
    } else {
        return 1;
    }
}

fn dead_branch() i32 {
    // B0102 (pedantic): condition is always true
    if (1 == 1) {
        return 1;
    } else {
        return 0;
    }
}

fn empty_block(x: i32) i32 {
    // B0111 (pedantic): empty if-then block
    if (x > 0) {
    }
    return 0;
}

fn duplicated_statements() i32 {
    // B0112 (pedantic): duplicated adjacent statements
    let y: i32 = 5;
    let y: i32 = 5;
    return y;
}

fn repeated_calls(a: i32, b: i32, c: i32) i32 {
    // B0120 (pedantic): same call repeated 3+ times
    let r: i32 = abs_val(a) + abs_val(b) + abs_val(c);
    return r;
}

fn abs_val(x: i32) i32 {
    if (x < 0) { return 0 - x; }
    return x;
}

fn main() i32 {
    let r: i32 = is_ready(5);
    r = r + dead_after_return(1);
    r = r + unused_and_overwritten();
    r = r + double_negation(1);
    r = r + negated_comparison(1, 2);
    r = r + tautological(3);
    r = r + identical_branches(1);
    r = r + dead_branch();
    r = r + empty_block(1);
    r = r + duplicated_statements();
    r = r + repeated_calls(-1, 2, -3);
    return r;
}
