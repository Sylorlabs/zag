// Native live code hot-reload demo (no restart, in-memory state survives).
//
//   1. build:   znc build --hot examples/hot_demo.zag -o hot_demo
//   2. run:     ./hot_demo                      # prints label()*1000 + i, climbing
//   3. edit `label` below (keep it the same SIZE — e.g. change 1 → 7)
//   4. patch:   znc hot-patch examples/hot_demo.zag
//
// The running process swaps in the new `label` on its next zag_hot_wait() WITHOUT
// restarting: the leading digit of the printed value flips while the counter `i`
// keeps climbing — proof that live state survived the code swap.
//
// Stop it cleanly with:  touch .zag_hotstop   (or just Ctrl-C).

@import("../selfhost/native/hot_rt.zag")

// The hot-swappable function. Edit the returned value and `znc hot-patch`.
fn label() i32 {
    return 1;
}

fn main() i32 {
    let i: i32 = 0;
    while (zag_hot_should_continue()) {
        // Printed value = label()*1000 + i. The leading digit flips when `label`
        // is hot-patched; `i` proves in-memory state survived the swap.
        print_i32(label() * 1000 + i);
        i = i + 1;
        zag_hot_wait();
    }
    return 0;
}
