// A data-dependent positive step does not prove loop direction. In particular,
// the analyzer must not parse a non-literal expression as -1 and report A0107.
fn consume(remaining0: i64, step: i64) i64 {
    let remaining: i64 = remaining0;
    while (remaining > 0) {
        if (step > 0) {
            remaining = remaining - step;
        } else {
            return remaining;
        }
    }
    return remaining;
}

fn main() i32 {
    return consume(4, 2) as i32;
}
