// std/range.zag -- allocation-free bounded i64 range iteration.
//
// The stop value is exclusive. A zero step or negative item budget is invalid.
// Direction mismatches are empty ranges. Every terminal state is explicit;
// callers never need a sentinel value to distinguish exhaustion from a limit.

struct RangeI64 {
    next_value: i64,
    stop: i64,
    step: i64,
    max_items: i32,
    emitted: i32,
    status: i64,
}

struct RangeNextI64 {
    status: i64,
    value: i64,
    index: i32,
}

fn range_status_ready() i64 { return 0; }
fn range_status_item() i64 { return 1; }
fn range_status_exhausted() i64 { return 2; }
fn range_status_limit() i64 { return 3; }
fn range_status_invalid() i64 { return 4; }

fn range_i64(start: i64, stop: i64, step: i64,
             max_items: i32) RangeI64 {
    let status: i64 = range_status_ready();
    if (step == 0 || max_items < 0) { status = range_status_invalid(); }
    if (status == range_status_ready() &&
        ((step > 0 && start >= stop) || (step < 0 && start <= stop))) {
        status = range_status_exhausted();
    }
    return RangeI64{
        .next_value = start,
        .stop = stop,
        .step = step,
        .max_items = max_items,
        .emitted = 0,
        .status = status,
    };
}

fn range_next_i64(range: *RangeI64) RangeNextI64 {
    let terminal: RangeNextI64 = RangeNextI64{
        .status = range.*.status,
        .value = 0,
        .index = range.*.emitted,
    };
    if (range.*.status != range_status_ready()) { return terminal; }

    if ((range.*.step > 0 && range.*.next_value >= range.*.stop) ||
        (range.*.step < 0 && range.*.next_value <= range.*.stop)) {
        range.*.status = range_status_exhausted();
        terminal.status = range_status_exhausted();
        return terminal;
    }
    if (range.*.emitted >= range.*.max_items) {
        range.*.status = range_status_limit();
        terminal.status = range_status_limit();
        return terminal;
    }

    let result: RangeNextI64 = RangeNextI64{
        .status = range_status_item(),
        .value = range.*.next_value,
        .index = range.*.emitted,
    };
    range.*.emitted = range.*.emitted + 1;

    // If the mathematical next value leaves i64, it has necessarily crossed
    // the exclusive stop (which itself is representable). Mark exhaustion
    // without performing an overflowing machine addition.
    let maximum: i64 = 9223372036854775807;
    let minimum: i64 = (0 - 9223372036854775807) - 1;
    if (range.*.step > 0 &&
        range.*.next_value > maximum - range.*.step) {
        range.*.status = range_status_exhausted();
    } else if (range.*.step < 0 &&
               range.*.next_value < minimum - range.*.step) {
        range.*.status = range_status_exhausted();
    } else {
        range.*.next_value = range.*.next_value + range.*.step;
    }
    return result;
}

fn range_status_i64(range: RangeI64) i64 { return range.status; }
fn range_emitted_i64(range: RangeI64) i32 { return range.emitted; }

// Stateless indexed access for contexts that cannot lend a local by pointer.
// Work is bounded by item_index + 1 and by max_items; terminal statuses are the
// same as repeated range_next_i64 calls.
fn range_item_i64(start: i64, stop: i64, step: i64, max_items: i32,
                  item_index: i32) RangeNextI64 {
    if (item_index < 0) {
        return RangeNextI64{
            .status = range_status_invalid(),
            .value = 0,
            .index = item_index,
        };
    }
    let range: RangeI64 = range_i64(start, stop, step, max_items);
    let i: i32 = 0;
    while (i <= item_index) {
        let result: RangeNextI64 = range_next_i64(&range);
        if (result.status != range_status_item() || i == item_index) {
            return result;
        }
        i = i + 1;
    }
    return RangeNextI64{
        .status = range_status_invalid(),
        .value = 0,
        .index = item_index,
    };
}
