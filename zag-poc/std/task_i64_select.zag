// Bounded non-consuming selector for the Linux/x86-64 TaskI64 ABI.
//
// This is the smallest scheduler-shaped seam that can be implemented without
// changing the proven affine handle ABI: a caller supplies up to eight task
// handles, and the selector observes the first ready task.  It never consumes
// or releases a handle; the caller must still await every handle exactly once.
// The fixed set is intentional.  This is not a generic future, executor, or
// dynamic task collection, and it does not imply portable async support.

@import("std:task_i64") as task

struct TaskI64SelectSet {
    h0: *opaque,
    h1: *opaque,
    h2: *opaque,
    h3: *opaque,
    h4: *opaque,
    h5: *opaque,
    h6: *opaque,
    h7: *opaque,
    count: i32,
}

struct TaskI64SelectResult {
    ok: i32,
    code: i64,
    index: i32,
    state: i32,
    value: i64,
    cancellation_requested: i32,
}

fn task_i64_select_status_ok() i64 { return 0; }
fn task_i64_select_status_invalid_set() i64 { return 0 - 7711; }
fn task_i64_select_status_invalid_timeout() i64 { return 0 - 7712; }

fn task_i64_select_invalid(code:i64) TaskI64SelectResult {
    return TaskI64SelectResult{.ok = 0, .code = code, .index = 0 - 1,
        .state = task.task_i64_poll_invalid(), .value = 0,
        .cancellation_requested = 0};
}

// Return an address word rather than a pointer borrowed from `set`; the
// ownership checker must not treat a handle field as an escaping borrow.
fn task_i64_select_handle_address(set:@borrows *TaskI64SelectSet, index:i32) i64 {
    unsafe {
        if (index == 0) { return set.*.h0 as i64; }
        if (index == 1) { return set.*.h1 as i64; }
        if (index == 2) { return set.*.h2 as i64; }
        if (index == 3) { return set.*.h3 as i64; }
        if (index == 4) { return set.*.h4 as i64; }
        if (index == 5) { return set.*.h5 as i64; }
        if (index == 6) { return set.*.h6 as i64; }
        if (index == 7) { return set.*.h7 as i64; }
        return 0;
    }
}

fn task_i64_select_valid(set:@borrows *TaskI64SelectSet) i32 {
    unsafe {
        if (set == null as *TaskI64SelectSet || set.*.count < 1 ||
            set.*.count > 8) { return 0; }
    }
    let i:i32 = 0;
    while (i < set.*.count) {
        let address:i64 = task_i64_select_handle_address(set, i);
        let handle:*opaque;
        unsafe { handle = address as *opaque; }
        if (task.task_i64_valid(handle) == 0) { return 0; }
        let j:i32 = 0;
        while (j < i) {
            if (address == task_i64_select_handle_address(set, j)) { return 0; }
            j = j + 1;
        }
        i = i + 1;
    }
    return 1;
}

fn task_i64_select_scan(set:@borrows *TaskI64SelectSet)
    TaskI64SelectResult {
    let i:i32 = 0;
    while (i < set.*.count) {
        let address:i64 = task_i64_select_handle_address(set, i);
        let handle:*opaque;
        unsafe { handle = address as *opaque; }
        let observed:task.TaskI64PollResult = task.task_i64_poll(handle);
        if (observed.state == task.task_i64_poll_ready()) {
            return TaskI64SelectResult{.ok = observed.ok,
                .code = observed.code, .index = i, .state = observed.state,
                .value = observed.value,
                .cancellation_requested = observed.cancellation_requested};
        }
        i = i + 1;
    }
    return TaskI64SelectResult{.ok = 1,
        .code = task_i64_select_status_ok(), .index = 0 - 1,
        .state = task.task_i64_poll_pending(), .value = 0,
        .cancellation_requested = 0};
}

// Observe at most eight disjoint TaskI64 handles for a bounded interval.
// A zero timeout performs one scan; a timeout returns a pending result with
// index=-1.  A ready result contains the selected handle's borrowed value.
// No handle ownership changes, so every input remains the caller's affine
// responsibility and must be consumed with @taskAwait exactly once.
fn task_i64_select(set:@borrows *TaskI64SelectSet, timeout_ms:i32)
    TaskI64SelectResult {
    if (task_i64_select_valid(set) == 0) {
        return task_i64_select_invalid(task_i64_select_status_invalid_set());
    }
    if (timeout_ms < 0 || timeout_ms > 5000) {
        return task_i64_select_invalid(task_i64_select_status_invalid_timeout());
    }
    let observed:TaskI64SelectResult = task_i64_select_scan(set);
    if (observed.state != task.task_i64_poll_pending() || timeout_ms == 0) {
        return observed;
    }
    let started:i64 = _zag_clock_monotonic_ms();
    let elapsed:i64 = 0;
    while (elapsed < timeout_ms as i64) {
        unsafe {
            let _yielded:i64 = _zag_raw_syscall(24, 0, 0, 0, 0, 0, 0);
        }
        let next:TaskI64SelectResult = task_i64_select_scan(set);
        if (next.state != task.task_i64_poll_pending()) { return next; }
        elapsed = _zag_clock_monotonic_ms() - started;
        if (elapsed < 0) { elapsed = 0; }
    }
    return task_i64_select_scan(set);
}
