// Thin Linux userspace adapter boundary for the shared std:driver core.
// The initial supported path is an explicit virtual-device/emulator backend;
// physical device acquisition remains unavailable until a device-specific
// evidence bundle exists. There is no libc, guessed device ABI, or host-memory
// fallback hidden in this adapter.

@import("std:driver") as driver
@import("std:driver_linux") as linux

pub struct LinuxUserspaceAdapter {
    target: i32,
    kernel_series: i32,
    evidence: i32,
    emulator: i32,
    qemu: i32,
    physical_device: i32,
}

pub fn adapter(target: i32, series: i32, evidence: i32, emulator: i32,
               qemu: i32, physical_device: i32) LinuxUserspaceAdapter {
    return LinuxUserspaceAdapter{ .target = target, .kernel_series = series,
        .evidence = evidence,
        .emulator = emulator, .qemu = qemu,
        .physical_device = physical_device };
}

pub fn adapter_contract_valid(adapter: @borrows *LinuxUserspaceAdapter) i32 {
    let supported: linux.LinuxSupport = linux.linux_support(
        adapter.*.target, adapter.*.kernel_series, adapter.*.evidence,
        adapter.*.emulator, adapter.*.qemu, 0);
    // The capability bits are evidence claims, not target validation: an
    // unsupported target makes every bit zero and would otherwise compare
    // equal to an unavailable (zero) adapter. Keep the exact target/series
    // boundary explicit and leave missing evidence to probe's unsupported
    // result rather than turning it into a forged supported row.
    return (linux.linux_target_supported(adapter.*.target) != 0 &&
        linux.linux_kernel_series_supported(adapter.*.kernel_series) != 0 &&
        supported.physical_device == 0 && adapter.*.physical_device == 0) as i32;
}

pub fn probe(adapter: @borrows *LinuxUserspaceAdapter) driver.DriverStatus @driver_init {
    if (adapter_contract_valid(adapter) == 0) {
        return driver.DriverStatus{ .code = driver.driver_invalid_argument(), .detail = 0 };
    }
    if (adapter.*.evidence == 0 || adapter.*.emulator == 0 ||
        adapter.*.physical_device != 0) {
        return driver.DriverStatus{ .code = driver.driver_unsupported(),
            .detail = adapter.*.target as i64 };
    }
    return driver.DriverStatus{ .code = driver.driver_ok(),
        .detail = adapter.*.target as i64 };
}
