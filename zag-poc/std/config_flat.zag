// std/config_flat.zag -- allocation-free bounded flat application config.
//
// The accepted format is deliberately small: blank lines, whole-line `#`
// comments, and one ASCII key = byte-string value per line.  Values are
// borrowed slices into the caller-owned input.  There are no sections,
// includes, interpolation, environment expansion, or implicit type coercions.

struct ConfigFlatEntry {
    key: []u8,
    value: []u8,
    line: i32,
}

struct ConfigFlatParseResult {
    ok: i32,
    code: i64,
    count: i32,
    error_line: i32,
}

struct ConfigFlatValue {
    found: i32,
    value: []u8,
}

struct ConfigFlatI64Result {
    ok: i32,
    value: i64,
}

fn config_flat_status_ok() i64 { return 0; }
fn config_flat_status_invalid_argument() i64 { return 0 - 7301; }
fn config_flat_status_malformed() i64 { return 0 - 7302; }
fn config_flat_status_duplicate() i64 { return 0 - 7303; }
fn config_flat_status_limit() i64 { return 0 - 7304; }

fn config_flat_max_input_bytes() i32 { return 65536; }
fn config_flat_max_entries() i32 { return 128; }
fn config_flat_max_key_bytes() i32 { return 64; }
fn config_flat_max_value_bytes() i32 { return 4096; }

fn config_flat_space(byte: u8) i32 {
    return (byte == ' ' || byte == '\t' || byte == '\r') as i32;
}

fn config_flat_trim(input: []u8) []u8 {
    let start: i32 = 0;
    let end: i32 = input.len;
    while (start < end && config_flat_space(input[start]) != 0) {
        start = start + 1;
    }
    while (end > start && config_flat_space(input[end - 1]) != 0) {
        end = end - 1;
    }
    return input[start..end];
}

fn config_flat_key_valid(key: []u8) i32 {
    if (key.len <= 0 || key.len > config_flat_max_key_bytes()) { return 0; }
    let i: i32 = 0;
    while (i < key.len) {
        let byte: u8 = key[i];
        let alpha: bool = (byte >= 'a' && byte <= 'z') ||
            (byte >= 'A' && byte <= 'Z');
        let digit: bool = byte >= '0' && byte <= '9';
        if (!alpha && !digit && byte != '_' && byte != '-' && byte != '.') {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

fn config_flat_value_valid(value: []u8) i32 {
    if (value.len > config_flat_max_value_bytes()) { return 0; }
    let i: i32 = 0;
    while (i < value.len) {
        if (value[i] == 0 || value[i] == '\n' ||
            (value[i] < 32 && value[i] != '\t')) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn config_flat_failure(code: i64, line: i32) ConfigFlatParseResult {
    return ConfigFlatParseResult{
        .ok = 0, .code = code, .count = 0, .error_line = line,
    };
}

fn config_flat_parse_bounded(input: []u8, entries: *ConfigFlatEntry,
                             entry_capacity: i32) ConfigFlatParseResult {
    if (entries == null as *ConfigFlatEntry || entry_capacity <= 0 ||
        entry_capacity > config_flat_max_entries()) {
        return config_flat_failure(config_flat_status_invalid_argument(), 0);
    }
    if (input.len < 0 || input.len > config_flat_max_input_bytes()) {
        return config_flat_failure(config_flat_status_limit(), 0);
    }

    let count: i32 = 0;
    let line_start: i32 = 0;
    let line_number: i32 = 1;
    while (line_start <= input.len) {
        let line_end: i32 = line_start;
        while (line_end < input.len && input[line_end] != '\n') {
            line_end = line_end + 1;
        }
        let line: []u8 = config_flat_trim(input[line_start..line_end]);
        if (line.len > 0 && line[0] != '#') {
            let equals: i32 = 0 - 1;
            let i: i32 = 0;
            while (i < line.len && equals < 0) {
                if (line[i] == '=') { equals = i; }
                i = i + 1;
            }
            if (equals < 0) {
                return config_flat_failure(
                    config_flat_status_malformed(), line_number
                );
            }
            let key: []u8 = config_flat_trim(line[0..equals]);
            let value: []u8 = config_flat_trim(line[equals + 1..line.len]);
            if (config_flat_key_valid(key) == 0 ||
                config_flat_value_valid(value) == 0) {
                return config_flat_failure(
                    config_flat_status_malformed(), line_number
                );
            }
            let previous: i32 = 0;
            while (previous < count) {
                if (@strEq(entries[previous].key, key)) {
                    return config_flat_failure(
                        config_flat_status_duplicate(), line_number
                    );
                }
                previous = previous + 1;
            }
            if (count >= entry_capacity) {
                return config_flat_failure(
                    config_flat_status_limit(), line_number
                );
            }
            entries[count].key = key;
            entries[count].value = value;
            entries[count].line = line_number;
            count = count + 1;
        }
        if (line_end == input.len) { break; }
        line_start = line_end + 1;
        line_number = line_number + 1;
    }
    return ConfigFlatParseResult{
        .ok = 1, .code = config_flat_status_ok(), .count = count,
        .error_line = 0,
    };
}

fn config_flat_find(entries: *ConfigFlatEntry, count: i32,
                    key: []u8) ConfigFlatValue {
    if (entries == null as *ConfigFlatEntry || count < 0 ||
        count > config_flat_max_entries() || config_flat_key_valid(key) == 0) {
        return ConfigFlatValue{ .found = 0, .value = "" };
    }
    let i: i32 = 0;
    while (i < count) {
        if (@strEq(entries[i].key, key)) {
            return ConfigFlatValue{ .found = 1, .value = entries[i].value };
        }
        i = i + 1;
    }
    return ConfigFlatValue{ .found = 0, .value = "" };
}

fn config_flat_bool(value: []u8, output: *i32) i32 {
    if (output == null as *i32) { return 0; }
    if (@strEq(value, "true")) { output.* = 1; return 1; }
    if (@strEq(value, "false")) { output.* = 0; return 1; }
    return 0;
}

fn config_flat_i64(value: []u8) ConfigFlatI64Result {
    if (value.len <= 0) { return ConfigFlatI64Result{ .ok=0, .value=0 }; }
    let negative: i32 = 0;
    let i: i32 = 0;
    if (value[0] == '-') { negative = 1; i = 1; }
    if (i == value.len) { return ConfigFlatI64Result{ .ok=0, .value=0 }; }
    let parsed: i64 = 0;
    let maximum: i64 = 9223372036854775807;
    let minimum: i64 = (0 - 9223372036854775807) - 1;
    while (i < value.len) {
        if (value[i] < '0' || value[i] > '9') {
            return ConfigFlatI64Result{ .ok=0, .value=0 };
        }
        let digit: i64 = value[i] as i64 - 48;
        if (negative == 1) {
            if (parsed < minimum / 10) {
                return ConfigFlatI64Result{ .ok=0, .value=0 };
            }
            parsed = parsed * 10;
            if (parsed < minimum + digit) {
                return ConfigFlatI64Result{ .ok=0, .value=0 };
            }
            parsed = parsed - digit;
        } else {
            if (parsed > (maximum - digit) / 10) {
                return ConfigFlatI64Result{ .ok=0, .value=0 };
            }
            parsed = parsed * 10 + digit;
        }
        i = i + 1;
    }
    return ConfigFlatI64Result{ .ok=1, .value=parsed };
}
