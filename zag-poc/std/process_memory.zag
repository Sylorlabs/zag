// std/process_memory.zag -- bounded Linux self-memory telemetry.
//
// The only readable object is the compile-time fixed `/proc/self/status` path.
// No caller path, descriptor, syscall number, or arbitrary byte authority is
// accepted. The caller supplies bounded scratch and retains its ownership.

@import("rt.zag")

struct ProcessMemoryResult {
    ok: i32,
    code: i64,
    resident_bytes: i64,
    peak_resident_bytes: i64,
    bytes_read: i32,
    read_calls: i32,
}

fn process_memory_status_ok() i64 { return 0; }
fn process_memory_status_invalid_argument() i64 { return 0 - 7301; }
fn process_memory_status_limit() i64 { return 0 - 7302; }
fn process_memory_status_incomplete() i64 { return 0 - 7303; }
fn process_memory_status_malformed() i64 { return 0 - 7304; }

fn process_memory_failure(code: i64, bytes_read: i32,
                          calls: i32) ProcessMemoryResult {
    return ProcessMemoryResult{
        .ok = 0, .code = code,
        .resident_bytes = 0, .peak_resident_bytes = 0,
        .bytes_read = bytes_read, .read_calls = calls,
    };
}

fn process_memory_fixed_path() *u8 {
    let address: i64 = _zag_raw_syscall(9, 0, 4096, 3, 34, 0 - 1, 0);
    if (address < 0) { return null as *u8; }
    let path: *u8 = address as *u8;
    let source: []u8 = "/proc/self/status";
    let i: i32 = 0;
    while (i < source.len) { path[i] = source[i]; i = i + 1; }
    path[source.len] = 0;
    return path;
}

fn process_memory_release_path(path: *u8) i64 {
    if (path == null as *u8) { return process_memory_status_invalid_argument(); }
    return _zag_raw_syscall(11, path as i64, 4096, 0, 0, 0, 0);
}

fn process_memory_prefix(bytes: @borrows []u8, offset: i32,
                         prefix: []u8) i32 {
    if (offset < 0 || offset + prefix.len > bytes.len) { return 0; }
    let i: i32 = 0;
    while (i < prefix.len) {
        if (bytes[offset + i] != prefix[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn process_memory_kib_line(bytes: @borrows []u8, offset: i32,
                           prefix: []u8) i64 {
    if (process_memory_prefix(bytes, offset, prefix) == 0) { return 0 - 1; }
    let i: i32 = offset + prefix.len;
    while (i < bytes.len && (bytes[i] == ' ' || bytes[i] == '\t')) {
        i = i + 1;
    }
    if (i >= bytes.len || bytes[i] < '0' || bytes[i] > '9') { return 0 - 1; }
    let value: i64 = 0;
    while (i < bytes.len && bytes[i] >= '0' && bytes[i] <= '9') {
        let digit: i64 = (bytes[i] - '0') as i64;
        if (value > (9223372036854775807 - digit) / 10) { return 0 - 1; }
        value = value * 10 + digit;
        i = i + 1;
    }
    while (i < bytes.len && (bytes[i] == ' ' || bytes[i] == '\t')) {
        i = i + 1;
    }
    if (i + 2 > bytes.len || bytes[i] != 'k' || bytes[i + 1] != 'B' ||
        value > 9223372036854775807 / 1024) { return 0 - 1; }
    return value * 1024;
}

fn process_memory_parse(bytes: @borrows []u8, calls: i32) ProcessMemoryResult {
    let byte_count: i32 = bytes.len;
    let resident: i64 = 0 - 1;
    let peak: i64 = 0 - 1;
    let line: i32 = 0;
    let i: i32 = 0;
    while (i <= bytes.len) {
        if (i == bytes.len || bytes[i] == '\n') {
            if (resident < 0) {
                resident = process_memory_kib_line(bytes, line, "VmRSS:");
            }
            if (peak < 0) {
                peak = process_memory_kib_line(bytes, line, "VmHWM:");
            }
            line = i + 1;
        }
        i = i + 1;
    }
    if (resident < 0 || peak < 0 || peak < resident) {
        return process_memory_failure(process_memory_status_malformed(),
            byte_count, calls);
    }
    return ProcessMemoryResult{
        .ok = 1, .code = process_memory_status_ok(),
        .resident_bytes = resident, .peak_resident_bytes = peak,
        .bytes_read = byte_count, .read_calls = calls,
    };
}

fn process_memory_read(scratch: @borrows_mut []u8) ProcessMemoryResult {
    if (scratch.len < 4096 || scratch.len > 65536) {
        return process_memory_failure(
            process_memory_status_invalid_argument(), 0, 0);
    }
    let path: *u8 = process_memory_fixed_path();
    if (path == null as *u8) {
        return process_memory_failure(0 - 12, 0, 0);
    }
    // O_RDONLY | O_NOFOLLOW | O_CLOEXEC. The path is fixed and accepts no
    // caller-controlled component.
    let fd: i64 = _zag_raw_syscall(257, 0 - 100, path as i64,
        655360, 0, 0, 0);
    let unmap: i64 = process_memory_release_path(path);
    if (fd < 0) { return process_memory_failure(fd, 0, 0); }
    if (unmap < 0) {
        let _close: i64 = _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
        return process_memory_failure(unmap, 0, 0);
    }

    let base: *i8 = _zag_slice_ptr(scratch);
    if (base == null as *i8) {
        let _close: i64 = _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
        return process_memory_failure(
            process_memory_status_invalid_argument(), 0, 0);
    }
    let total: i32 = 0;
    let calls: i32 = 0;
    let eof: i32 = 0;
    while (total < scratch.len && calls < 16 && eof == 0) {
        let rc: i64 = _zag_read_fd(fd, (base as i64 + total) as *i8,
            scratch.len - total);
        calls = calls + 1;
        if (rc == (0 - 4)) { }
        else if (rc < 0) {
            let _close: i64 = _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
            return process_memory_failure(rc, total, calls);
        } else if (rc == 0) { eof = 1; }
        else if (rc > (scratch.len - total) as i64) {
            let _close: i64 = _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
            return process_memory_failure(
                process_memory_status_incomplete(), total, calls);
        } else { total = total + rc as i32; }
    }
    let close_rc: i64 = _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    if (close_rc < 0) { return process_memory_failure(close_rc, total, calls); }
    if (eof == 0) {
        return process_memory_failure(process_memory_status_limit(), total, calls);
    }
    return process_memory_parse(scratch[0..total], calls);
}
