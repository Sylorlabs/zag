// Deterministic byte checksums used by portable binary formats.

fn checksum_crc32(bytes: []u8) i64 {
    let crc: i64 = 4294967295;
    let i: i32 = 0;
    while (i < bytes.len) {
        crc = crc ^ (bytes[i] as i64);
        let bit: i32 = 0;
        while (bit < 8) {
            if ((crc & 1) != 0) {
                crc = (crc >> 1) ^ 3988292384;
            } else {
                crc = crc >> 1;
            }
            bit = bit + 1;
        }
        i = i + 1;
    }
    return (crc ^ 4294967295) & 4294967295;
}

fn checksum_adler32(bytes: []u8) i64 {
    let modulus: i64 = 65521;
    let a: i64 = 1;
    let b: i64 = 0;
    let i: i32 = 0;
    while (i < bytes.len) {
        a = (a + bytes[i] as i64) % modulus;
        b = (b + a) % modulus;
        i = i + 1;
    }
    return ((b << 16) | a) & 4294967295;
}
