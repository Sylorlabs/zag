// Bounded cancellation-aware waits composed over std:channel_mpmc_i64.
//
// The underlying queue remains MPMC try-only.  These adapters poll its finite
// operations between 10 ms nanosleep slices and a caller-owned one-shot
// CancelTokenI64.  They do not add a scheduler, generic element transport,
// fairness, or concurrent close semantics.

@import("std:channel_mpmc_i64") as base
@import("std:cancel_token_i64") as cancel

struct ChannelMpmcI64CancelTimespec {
    seconds: i64,
    nanoseconds: i64,
}

struct ChannelMpmcI64CancelSendResult {
    ok: i32,
    code: i64,
    attempts: i32,
    elapsed_ms: i64,
}

struct ChannelMpmcI64CancelReceiveResult {
    ok: i32,
    code: i64,
    value: i64,
    attempts: i32,
    elapsed_ms: i64,
}

fn channel_mpmc_i64_cancel_status_ok() i64 { return 0; }
fn channel_mpmc_i64_cancel_status_invalid_argument() i64 { return 0 - 7911; }
fn channel_mpmc_i64_cancel_status_invalid_state() i64 { return 0 - 7912; }
fn channel_mpmc_i64_cancel_status_cancelled() i64 { return 0 - 7913; }
fn channel_mpmc_i64_cancel_status_limit() i64 { return 0 - 7914; }

fn channel_mpmc_i64_cancel_max_attempts() i32 { return 512; }

fn channel_mpmc_i64_cancel_elapsed(start: i64) i64 {
    let elapsed: i64 = _zag_clock_monotonic_ms() - start;
    if (elapsed < 0) { return 0; }
    return elapsed;
}

fn channel_mpmc_i64_cancel_sleep_ms(milliseconds: i32) void {
    let delay: ChannelMpmcI64CancelTimespec =
        ChannelMpmcI64CancelTimespec{
            .seconds = (milliseconds as i64) / 1000,
            .nanoseconds = ((milliseconds as i64) % 1000) * 1000000,
        };
    let _slept: i64 = _zag_raw_syscall(35, (&delay) as i64, 0, 0, 0, 0, 0);
}

fn channel_mpmc_i64_cancel_send_wait(
    channel: @borrows_mut *base.ChannelMpmcI64,
    token: @borrows *cancel.CancelTokenI64,
    value: i64,
    timeout_ms: i32) ChannelMpmcI64CancelSendResult {
    let start: i64 = _zag_clock_monotonic_ms();
    if (channel == null as *base.ChannelMpmcI64 ||
        token == null as *cancel.CancelTokenI64 || timeout_ms < 0 ||
        timeout_ms > 5000 || base.channel_mpmc_i64_valid(channel) == 0) {
        return ChannelMpmcI64CancelSendResult{
            .ok = 0, .code = channel_mpmc_i64_cancel_status_invalid_argument(),
            .attempts = 0, .elapsed_ms = 0,
        };
    }
    if (cancel.cancel_token_i64_is_requested(token) < 0) {
        return ChannelMpmcI64CancelSendResult{
            .ok = 0, .code = channel_mpmc_i64_cancel_status_invalid_state(),
            .attempts = 0, .elapsed_ms = 0,
        };
    }
    let attempts: i32 = 0;
    while (attempts < channel_mpmc_i64_cancel_max_attempts()) {
        if (cancel.cancel_token_i64_is_requested(token) == 1) {
            return ChannelMpmcI64CancelSendResult{
                .ok = 0, .code = channel_mpmc_i64_cancel_status_cancelled(),
                .attempts = attempts,
                .elapsed_ms = channel_mpmc_i64_cancel_elapsed(start),
            };
        }
        let elapsed: i64 = channel_mpmc_i64_cancel_elapsed(start);
        if (timeout_ms == 0 || elapsed >= timeout_ms) {
            let probe: base.ChannelMpmcI64OpResult =
                base.channel_mpmc_i64_try_send(channel, value);
            if (probe.ok == 1) {
                return ChannelMpmcI64CancelSendResult{
                    .ok = 1, .code = channel_mpmc_i64_cancel_status_ok(),
                    .attempts = attempts,
                    .elapsed_ms = channel_mpmc_i64_cancel_elapsed(start),
                };
            }
            return ChannelMpmcI64CancelSendResult{
                .ok = 0, .code = probe.code, .attempts = attempts,
                .elapsed_ms = channel_mpmc_i64_cancel_elapsed(start),
            };
        }
        let probe: base.ChannelMpmcI64OpResult =
            base.channel_mpmc_i64_try_send(channel, value);
        if (probe.ok == 1) {
            return ChannelMpmcI64CancelSendResult{
                .ok = 1, .code = channel_mpmc_i64_cancel_status_ok(),
                .attempts = attempts + 1,
                .elapsed_ms = channel_mpmc_i64_cancel_elapsed(start),
            };
        }
        if (probe.code != base.channel_mpmc_i64_status_full() &&
            probe.code != base.channel_mpmc_i64_status_contention()) {
            return ChannelMpmcI64CancelSendResult{
                .ok = 0, .code = probe.code, .attempts = attempts + 1,
                .elapsed_ms = channel_mpmc_i64_cancel_elapsed(start),
            };
        }
        channel_mpmc_i64_cancel_sleep_ms(10);
        attempts = attempts + 1;
    }
    return ChannelMpmcI64CancelSendResult{
        .ok = 0, .code = channel_mpmc_i64_cancel_status_limit(),
        .attempts = attempts, .elapsed_ms =
            channel_mpmc_i64_cancel_elapsed(start),
    };
}

fn channel_mpmc_i64_cancel_receive_wait(
    channel: @borrows_mut *base.ChannelMpmcI64,
    token: @borrows *cancel.CancelTokenI64,
    timeout_ms: i32) ChannelMpmcI64CancelReceiveResult {
    let start: i64 = _zag_clock_monotonic_ms();
    if (channel == null as *base.ChannelMpmcI64 ||
        token == null as *cancel.CancelTokenI64 || timeout_ms < 0 ||
        timeout_ms > 5000 || base.channel_mpmc_i64_valid(channel) == 0) {
        return ChannelMpmcI64CancelReceiveResult{
            .ok = 0, .code = channel_mpmc_i64_cancel_status_invalid_argument(),
            .value = 0, .attempts = 0, .elapsed_ms = 0,
        };
    }
    if (cancel.cancel_token_i64_is_requested(token) < 0) {
        return ChannelMpmcI64CancelReceiveResult{
            .ok = 0, .code = channel_mpmc_i64_cancel_status_invalid_state(),
            .value = 0, .attempts = 0, .elapsed_ms = 0,
        };
    }
    let attempts: i32 = 0;
    while (attempts < channel_mpmc_i64_cancel_max_attempts()) {
        if (cancel.cancel_token_i64_is_requested(token) == 1) {
            return ChannelMpmcI64CancelReceiveResult{
                .ok = 0, .code = channel_mpmc_i64_cancel_status_cancelled(),
                .value = 0, .attempts = attempts,
                .elapsed_ms = channel_mpmc_i64_cancel_elapsed(start),
            };
        }
        let elapsed: i64 = channel_mpmc_i64_cancel_elapsed(start);
        if (timeout_ms == 0 || elapsed >= timeout_ms) {
            let probe: base.ChannelMpmcI64OpResult =
                base.channel_mpmc_i64_try_receive(channel);
            if (probe.ok == 1) {
                return ChannelMpmcI64CancelReceiveResult{
                    .ok = 1, .code = channel_mpmc_i64_cancel_status_ok(),
                    .value = probe.value, .attempts = attempts,
                    .elapsed_ms = channel_mpmc_i64_cancel_elapsed(start),
                };
            }
            return ChannelMpmcI64CancelReceiveResult{
                .ok = 0, .code = probe.code, .value = 0,
                .attempts = attempts,
                .elapsed_ms = channel_mpmc_i64_cancel_elapsed(start),
            };
        }
        let probe: base.ChannelMpmcI64OpResult =
            base.channel_mpmc_i64_try_receive(channel);
        if (probe.ok == 1) {
            return ChannelMpmcI64CancelReceiveResult{
                .ok = 1, .code = channel_mpmc_i64_cancel_status_ok(),
                .value = probe.value, .attempts = attempts + 1,
                .elapsed_ms = channel_mpmc_i64_cancel_elapsed(start),
            };
        }
        if (probe.code != base.channel_mpmc_i64_status_empty() &&
            probe.code != base.channel_mpmc_i64_status_contention()) {
            return ChannelMpmcI64CancelReceiveResult{
                .ok = 0, .code = probe.code, .value = 0,
                .attempts = attempts + 1,
                .elapsed_ms = channel_mpmc_i64_cancel_elapsed(start),
            };
        }
        channel_mpmc_i64_cancel_sleep_ms(10);
        attempts = attempts + 1;
    }
    return ChannelMpmcI64CancelReceiveResult{
        .ok = 0, .code = channel_mpmc_i64_cancel_status_limit(), .value = 0,
        .attempts = attempts,
        .elapsed_ms = channel_mpmc_i64_cancel_elapsed(start),
    };
}
