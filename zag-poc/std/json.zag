// std/json.zag — statically typed JSON scalar and bounded value codecs.
//
// The scalar helpers remain the smallest API for programs with a known shape.
// JsonDocument is the general JSON representation: values are stored in a flat
// indexed tree, so callers still make every kind check explicit. Parsing and
// encoding have depth, value-count, input-byte, and output-byte limits. Every
// returned JsonDocument owns allocations, including a failed partial parse;
// call json_document_free on both success and failure.
//
// Strings cross the API as UTF-8 byte slices. Escaped Unicode is decoded to
// UTF-8; raw malformed UTF-8, malformed escapes, and lone surrogates fail.
// Parse failures are explicit `ok = 0` results and are never changed into an
// empty string, zero, false, or null.

@import("list.zag")

struct JsonStringResult { ok: i32, value: []u8 }
struct JsonIntResult { ok: i32, value: i64 }
struct JsonBoolResult { ok: i32, value: i32 }
struct JsonFloatResult { ok: i32, value: f64 }
struct JsonNullResult { ok: i32 }
struct JsonIntArrayResult { ok: i32, values: ArrayList[i64] }
struct JsonStringObjectResult { ok: i32, keys: ArrayList[[]u8], values: ArrayList[[]u8] }

struct JsonValue {
    kind: i32,
    boolean: i32,
    text: []u8,
    first_child: i32,
    child_count: i32,
}

struct JsonDocument {
    ok: i32,
    root: i32,
    nodes: ArrayList[JsonValue],
    children: ArrayList[i32],
    edge_keys: ArrayList[[]u8],
    owned_text: ArrayList[[]u8],
}

struct JsonEncodeResult { ok: i32, value: []u8 }

struct JsonParseContext {
    src: []u8,
    index: i32,
    max_depth: i32,
    max_values: i32,
    doc: *JsonDocument,
}

fn json_kind_invalid() i32 { return 0 - 1; }
fn json_kind_null() i32 { return 0; }
fn json_kind_bool() i32 { return 1; }
fn json_kind_number() i32 { return 2; }
fn json_kind_string() i32 { return 3; }
fn json_kind_array() i32 { return 4; }
fn json_kind_object() i32 { return 5; }

fn json_default_max_depth() i32 { return 64; }
fn json_default_max_bytes() i32 { return 1048576; }
fn json_default_max_values() i32 { return 65536; }
fn json_default_max_output_bytes() i32 { return 4194304; }

fn json_is_ws(c: u8) i32 {
    if (c == 32 || c == 9 || c == 10 || c == 13) { return 1; }
    return 0;
}

fn json_trim_bounds(src: []u8) []u8 {
    let lo: i32 = 0;
    let hi: i32 = src.len;
    while (lo < hi && json_is_ws(src[lo]) == 1) { lo = lo + 1; }
    while (hi > lo && json_is_ws(src[hi - 1]) == 1) { hi = hi - 1; }
    return src[lo..hi];
}

fn json_hex(c: u8) i32 {
    if (c >= 48 && c <= 57) { return (c - 48) as i32; }
    if (c >= 65 && c <= 70) { return (c - 65) as i32 + 10; }
    if (c >= 97 && c <= 102) { return (c - 97) as i32 + 10; }
    return 0 - 1;
}

fn json_append_utf8(out: *ArrayList[u8], cp: i32) i32 {
    if (cp < 0 || cp > 1114111 || (cp >= 55296 && cp <= 57343)) { return 0; }
    if (cp <= 127) { push[u8](out, cp as u8); }
    else if (cp <= 2047) {
        push[u8](out, (192 + cp / 64) as u8);
        push[u8](out, (128 + cp % 64) as u8);
    } else if (cp <= 65535) {
        push[u8](out, (224 + cp / 4096) as u8);
        push[u8](out, (128 + (cp / 64) % 64) as u8);
        push[u8](out, (128 + cp % 64) as u8);
    } else {
        push[u8](out, (240 + cp / 262144) as u8);
        push[u8](out, (128 + (cp / 4096) % 64) as u8);
        push[u8](out, (128 + (cp / 64) % 64) as u8);
        push[u8](out, (128 + cp % 64) as u8);
    }
    return 1;
}

fn json_utf8_valid(value: []u8) i32 {
    let i: i32 = 0;
    while (i < value.len) {
        let c: i32 = value[i] as i32;
        if (c <= 127) { i = i + 1; continue; }
        if (c >= 194 && c <= 223) {
            if (i + 1 >= value.len || value[i + 1] < 128 || value[i + 1] > 191) { return 0; }
            i = i + 2;
            continue;
        }
        if (c >= 224 && c <= 239) {
            if (i + 2 >= value.len) { return 0; }
            let b1: i32 = value[i + 1] as i32;
            let b2: i32 = value[i + 2] as i32;
            if (b2 < 128 || b2 > 191) { return 0; }
            if (c == 224) { if (b1 < 160 || b1 > 191) { return 0; } }
            else if (c == 237) { if (b1 < 128 || b1 > 159) { return 0; } }
            else if (b1 < 128 || b1 > 191) { return 0; }
            i = i + 3;
            continue;
        }
        if (c >= 240 && c <= 244) {
            if (i + 3 >= value.len) { return 0; }
            let b1: i32 = value[i + 1] as i32;
            let b2: i32 = value[i + 2] as i32;
            let b3: i32 = value[i + 3] as i32;
            if (b2 < 128 || b2 > 191 || b3 < 128 || b3 > 191) { return 0; }
            if (c == 240) { if (b1 < 144 || b1 > 191) { return 0; } }
            else if (c == 244) { if (b1 < 128 || b1 > 143) { return 0; } }
            else if (b1 < 128 || b1 > 191) { return 0; }
            i = i + 4;
            continue;
        }
        return 0;
    }
    return 1;
}

fn json_hex_digit(value: i32) u8 {
    if (value < 10) { return (48 + value) as u8; }
    return (65 + value - 10) as u8;
}

fn json_stringify_string(value: []u8) []u8 {
    let out: ArrayList[u8] = make[u8](value.len + 8);
    push[u8](&out, 34);
    let i: i32 = 0;
    while (i < value.len) {
        let c: u8 = value[i];
        if (c == 34 || c == 92) { push[u8](&out, 92); push[u8](&out, c); }
        else if (c == 8) { push[u8](&out, 92); push[u8](&out, 98); }
        else if (c == 12) { push[u8](&out, 92); push[u8](&out, 102); }
        else if (c == 10) { push[u8](&out, 92); push[u8](&out, 110); }
        else if (c == 13) { push[u8](&out, 92); push[u8](&out, 114); }
        else if (c == 9) { push[u8](&out, 92); push[u8](&out, 116); }
        else if (c < 32) {
            push[u8](&out, 92); push[u8](&out, 117);
            push[u8](&out, 48); push[u8](&out, 48);
            push[u8](&out, json_hex_digit((c as i32) / 16));
            push[u8](&out, json_hex_digit((c as i32) % 16));
        }
        else { push[u8](&out, c); }
        i = i + 1;
    }
    push[u8](&out, 34);
    return out.data[0..out.len];
}

fn json_stringify_string_checked(value: []u8) JsonEncodeResult {
    if (json_utf8_valid(value) == 0) { return JsonEncodeResult{ .ok = 0, .value = "" }; }
    return JsonEncodeResult{ .ok = 1, .value = json_stringify_string(value) };
}

fn json_string_parse_fail(out: *ArrayList[u8]) JsonStringResult {
    free[u8](out);
    return JsonStringResult{ .ok = 0, .value = "" };
}

fn json_string_result_free(result: *JsonStringResult) void {
    if (result.*.ok == 1) { _zag_free(_zag_slice_ptr(result.*.value)); }
    result.*.ok = 0; result.*.value = "";
}

fn json_stringify_int(value: i64) []u8 { return _zag_i64_to_str(value); }

fn json_stringify_bool(value: i32) []u8 {
    if (value == 0) { return "false"; }
    return "true";
}

fn json_stringify_null() []u8 { return "null"; }

fn json_parse_string(src: []u8) JsonStringResult {
    let text: []u8 = json_trim_bounds(src);
    if (text.len < 2 || text[0] != 34 || text[text.len - 1] != 34) {
        return JsonStringResult{ .ok = 0, .value = "" };
    }
    let out: ArrayList[u8] = make[u8](text.len);
    let i: i32 = 1;
    while (i + 1 < text.len) {
        let c: u8 = text[i];
        if (c == 34 || c < 32) { return json_string_parse_fail(&out); }
        if (c != 92) { push[u8](&out, c); i = i + 1; }
        else {
            if (i + 2 >= text.len) { return json_string_parse_fail(&out); }
            let e: u8 = text[i + 1];
            if (e == 34 || e == 92 || e == 47) { push[u8](&out, e); }
            else if (e == 98) { push[u8](&out, 8); }
            else if (e == 102) { push[u8](&out, 12); }
            else if (e == 110) { push[u8](&out, 10); }
            else if (e == 114) { push[u8](&out, 13); }
            else if (e == 116) { push[u8](&out, 9); }
            else if (e == 117) {
                if (i + 5 >= text.len) { return json_string_parse_fail(&out); }
                let h0:i32=json_hex(text[i+2]);let h1:i32=json_hex(text[i+3]);let h2:i32=json_hex(text[i+4]);let h3:i32=json_hex(text[i+5]);
                if(h0<0||h1<0||h2<0||h3<0){return json_string_parse_fail(&out);}
                let cp:i32=h0*4096+h1*256+h2*16+h3;i=i+6;
                if(cp>=55296&&cp<=56319){
                    if(i+5>=text.len||text[i]!=92||text[i+1]!=117){return json_string_parse_fail(&out);}
                    let l0:i32=json_hex(text[i+2]);let l1:i32=json_hex(text[i+3]);let l2:i32=json_hex(text[i+4]);let l3:i32=json_hex(text[i+5]);
                    if(l0<0||l1<0||l2<0||l3<0){return json_string_parse_fail(&out);}
                    let low:i32=l0*4096+l1*256+l2*16+l3;if(low<56320||low>57343){return json_string_parse_fail(&out);}
                    cp=65536+(cp-55296)*1024+(low-56320);i=i+6;
                }else if(cp>=56320&&cp<=57343){return json_string_parse_fail(&out);}
                if(json_append_utf8(&out,cp)==0){return json_string_parse_fail(&out);}
            }
            else { return json_string_parse_fail(&out); }
            if(e!=117){i = i + 2;}
        }
    }
    if (json_utf8_valid(out.data[0..out.len]) == 0) { return json_string_parse_fail(&out); }
    return JsonStringResult{ .ok = 1, .value = out.data[0..out.len] };
}

fn json_parse_int(src: []u8) JsonIntResult {
    let text: []u8 = json_trim_bounds(src);
    if (text.len == 0) { return JsonIntResult{ .ok = 0, .value = 0 }; }
    let i: i32 = 0;
    let neg: i32 = 0;
    if (text[i] == 45) { neg = 1; i = i + 1; }
    if (i >= text.len) { return JsonIntResult{ .ok = 0, .value = 0 }; }
    if (text[i] == 48 && i + 1 < text.len) { return JsonIntResult{ .ok = 0, .value = 0 }; }
    let value: i64 = 0;
    let minimum: i64 = (0 - 9223372036854775807) - 1;
    while (i < text.len) {
        let c: u8 = text[i];
        if (c < 48 || c > 57) { return JsonIntResult{ .ok = 0, .value = 0 }; }
        let digit: i64 = c as i64 - 48;
        if (neg == 1) {
            // Accumulate negative so INT64_MIN is representable. Check before
            // multiply/subtract; malformed JSON must never become a wrapped
            // but apparently successful integer.
            if (value < (minimum + digit) / 10) {
                return JsonIntResult{ .ok = 0, .value = 0 };
            }
            value = value * 10 - digit;
        } else {
            if (value > (9223372036854775807 - digit) / 10) {
                return JsonIntResult{ .ok = 0, .value = 0 };
            }
            value = value * 10 + digit;
        }
        i = i + 1;
    }
    return JsonIntResult{ .ok = 1, .value = value };
}

fn json_parse_bool(src: []u8) JsonBoolResult {
    let text: []u8 = json_trim_bounds(src);
    if (@strEq(text, "true")) { return JsonBoolResult{ .ok = 1, .value = 1 }; }
    if (@strEq(text, "false")) { return JsonBoolResult{ .ok = 1, .value = 0 }; }
    return JsonBoolResult{ .ok = 0, .value = 0 };
}

fn json_parse_null(src: []u8) JsonNullResult {
    if (@strEq(json_trim_bounds(src), "null")) { return JsonNullResult{ .ok = 1 }; }
    return JsonNullResult{ .ok = 0 };
}

fn json_parse_float(src: []u8) JsonFloatResult {
    let text: []u8 = json_trim_bounds(src);
    if (text.len == 0) { return JsonFloatResult{ .ok = 0, .value = 0.0 }; }
    let i: i32 = 0;
    let neg: i32 = 0;
    if (text[i] == 45) { neg = 1; i = i + 1; }
    if (i >= text.len) { return JsonFloatResult{ .ok = 0, .value = 0.0 }; }
    let whole: f64 = 0.0;
    if (text[i] == 48) { i = i + 1; if (i < text.len && text[i] >= 48 && text[i] <= 57) { return JsonFloatResult{ .ok = 0, .value = 0.0 }; } }
    else {
        if (text[i] < 49 || text[i] > 57) { return JsonFloatResult{ .ok = 0, .value = 0.0 }; }
        while (i < text.len && text[i] >= 48 && text[i] <= 57) { whole = whole * 10.0 + ((text[i] - 48) as f64); i = i + 1; }
    }
    let value: f64 = whole;
    if (i < text.len && text[i] == 46) {
        i = i + 1;
        if (i >= text.len || text[i] < 48 || text[i] > 57) { return JsonFloatResult{ .ok = 0, .value = 0.0 }; }
        let scale: f64 = 0.1;
        while (i < text.len && text[i] >= 48 && text[i] <= 57) { value = value + ((text[i] - 48) as f64) * scale; scale = scale / 10.0; i = i + 1; }
    }
    let exponent: i32 = 0;
    if (i < text.len && (text[i] == 101 || text[i] == 69)) {
        i = i + 1; let exponent_negative: i32 = 0;
        if (i < text.len && (text[i] == 43 || text[i] == 45)) { if (text[i] == 45) { exponent_negative = 1; } i = i + 1; }
        if (i >= text.len || text[i] < 48 || text[i] > 57) { return JsonFloatResult{ .ok = 0, .value = 0.0 }; }
        while (i < text.len && text[i] >= 48 && text[i] <= 57) { if (exponent > 308) { return JsonFloatResult{ .ok = 0, .value = 0.0 }; } exponent = exponent * 10 + ((text[i] - 48) as i32); i = i + 1; }
        let power: f64 = 1.0; let e: i32 = 0; while (e < exponent) { power = power * 10.0; e = e + 1; }
        if (exponent_negative == 1) { value = value / power; } else { value = value * power; }
    }
    if (i != text.len) { return JsonFloatResult{ .ok = 0, .value = 0.0 }; }
    if (neg == 1) { value = 0.0 - value; }
    return JsonFloatResult{ .ok = 1, .value = value };
}

fn json_skip_ws(src:[]u8,index:i32)i32{let i:i32=index;while(i<src.len&&json_is_ws(src[i])==1){i=i+1;}return i;}

// Statically typed composite helpers. These deliberately parse homogeneous
// shapes rather than introducing a dynamic "anything" JSON value.
fn json_parse_int_array(src:[]u8)JsonIntArrayResult{
    let values:ArrayList[i64]=make[i64](4);let i:i32=json_skip_ws(src,0);
    if(i>=src.len||src[i]!=91){return JsonIntArrayResult{.ok=0,.values=values};}i=json_skip_ws(src,i+1);
    if(i<src.len&&src[i]==93){i=json_skip_ws(src,i+1);return JsonIntArrayResult{.ok=(i==src.len) as i32,.values=values};}
    while(i<src.len){let start:i32=i;if(src[i]==45){i=i+1;}while(i<src.len&&src[i]>=48&&src[i]<=57){i=i+1;}let parsed:JsonIntResult=json_parse_int(src[start..i]);if(parsed.ok==0){return JsonIntArrayResult{.ok=0,.values=values};}push[i64](&values,parsed.value);i=json_skip_ws(src,i);if(i>=src.len){return JsonIntArrayResult{.ok=0,.values=values};}if(src[i]==93){i=json_skip_ws(src,i+1);return JsonIntArrayResult{.ok=(i==src.len) as i32,.values=values};}if(src[i]!=44){return JsonIntArrayResult{.ok=0,.values=values};}i=json_skip_ws(src,i+1);}
    return JsonIntArrayResult{.ok=0,.values=values};
}

fn json_int_array_result_free(result: *JsonIntArrayResult) void {
    free[i64](&result.*.values); result.*.ok = 0;
}

fn json_string_end(src:[]u8,start:i32)i32{if(start>=src.len||src[start]!=34){return 0-1;}let i:i32=start+1;while(i<src.len){if(src[i]==92){i=i+2;}else if(src[i]==34){return i+1;}else{i=i+1;}}return 0-1;}

fn json_parse_string_object(src: []u8) JsonStringObjectResult {
    let keys: ArrayList[[]u8] = make[[]u8](4);
    let values: ArrayList[[]u8] = make[[]u8](4);
    let i: i32 = json_skip_ws(src, 0);
    if (i >= src.len || src[i] != 123) {
        return JsonStringObjectResult{ .ok = 0, .keys = keys, .values = values };
    }
    i = json_skip_ws(src, i + 1);
    if (i < src.len && src[i] == 125) {
        i = json_skip_ws(src, i + 1);
        return JsonStringObjectResult{ .ok = (i == src.len) as i32, .keys = keys, .values = values };
    }
    while (i < src.len) {
        let end_key: i32 = json_string_end(src, i);
        if (end_key < 0) { return JsonStringObjectResult{ .ok = 0, .keys = keys, .values = values }; }
        let key: JsonStringResult = json_parse_string(src[i..end_key]);
        if (key.ok == 0) { return JsonStringObjectResult{ .ok = 0, .keys = keys, .values = values }; }
        i = json_skip_ws(src, end_key);
        if (i >= src.len || src[i] != 58) {
            json_string_result_free(&key);
            return JsonStringObjectResult{ .ok = 0, .keys = keys, .values = values };
        }
        i = json_skip_ws(src, i + 1);
        let end_value: i32 = json_string_end(src, i);
        if (end_value < 0) {
            json_string_result_free(&key);
            return JsonStringObjectResult{ .ok = 0, .keys = keys, .values = values };
        }
        let value: JsonStringResult = json_parse_string(src[i..end_value]);
        if (value.ok == 0) {
            json_string_result_free(&key);
            return JsonStringObjectResult{ .ok = 0, .keys = keys, .values = values };
        }
        push[[]u8](&keys, key.value); push[[]u8](&values, value.value);
        i = json_skip_ws(src, end_value);
        if (i >= src.len) { return JsonStringObjectResult{ .ok = 0, .keys = keys, .values = values }; }
        if (src[i] == 125) {
            i = json_skip_ws(src, i + 1);
            return JsonStringObjectResult{ .ok = (i == src.len) as i32, .keys = keys, .values = values };
        }
        if (src[i] != 44) { return JsonStringObjectResult{ .ok = 0, .keys = keys, .values = values }; }
        i = json_skip_ws(src, i + 1);
    }
    return JsonStringObjectResult{ .ok = 0, .keys = keys, .values = values };
}

fn json_string_object_result_free(result: *JsonStringObjectResult) void {
    let i: i32 = 0;
    while (i < result.*.keys.len) {
        _zag_free(_zag_slice_ptr(result.*.keys.data[i]));
        _zag_free(_zag_slice_ptr(result.*.values.data[i]));
        i = i + 1;
    }
    free[[]u8](&result.*.keys); free[[]u8](&result.*.values); result.*.ok = 0;
}

fn json_node(kind: i32) JsonValue {
    return JsonValue{
        .kind = kind,
        .boolean = 0,
        .text = "",
        .first_child = 0,
        .child_count = 0,
    };
}

fn json_document_empty() JsonDocument {
    return JsonDocument{
        .ok = 0,
        .root = 0 - 1,
        .nodes = make[JsonValue](8),
        .children = make[i32](8),
        .edge_keys = make[[]u8](8),
        .owned_text = make[[]u8](8),
    };
}

fn json_copy_range(src: []u8, start: i32, end: i32) []u8 {
    let out: ArrayList[u8] = make[u8](end - start);
    let i: i32 = start;
    while (i < end) { push[u8](&out, src[i]); i = i + 1; }
    return out.data[0..out.len];
}

fn json_document_own(doc: *JsonDocument, value: []u8) void {
    push[[]u8](&doc.*.owned_text, value);
}

fn json_document_add(ctx: *JsonParseContext, value: JsonValue) i32 {
    if (ctx.*.doc.*.nodes.len >= ctx.*.max_values) { return 0 - 1; }
    let index: i32 = ctx.*.doc.*.nodes.len;
    push[JsonValue](&ctx.*.doc.*.nodes, value);
    return index;
}

fn json_match_at(src: []u8, start: i32, value: []u8) i32 {
    if (start < 0 || start + value.len > src.len) { return 0; }
    let i: i32 = 0;
    while (i < value.len) {
        if (src[start + i] != value[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

// Return the first byte after a syntactically valid JSON number, or -1.
// The exact number lexeme is retained in JsonValue.text, avoiding a lossy or
// overflowing conversion when callers only need to inspect or re-encode JSON.
fn json_number_end(src: []u8, start: i32) i32 {
    let i: i32 = start;
    if (i < src.len && src[i] == 45) { i = i + 1; }
    if (i >= src.len) { return 0 - 1; }
    if (src[i] == 48) {
        i = i + 1;
        if (i < src.len && src[i] >= 48 && src[i] <= 57) { return 0 - 1; }
    } else {
        if (src[i] < 49 || src[i] > 57) { return 0 - 1; }
        i = i + 1;
        while (i < src.len && src[i] >= 48 && src[i] <= 57) { i = i + 1; }
    }
    if (i < src.len && src[i] == 46) {
        i = i + 1;
        if (i >= src.len || src[i] < 48 || src[i] > 57) { return 0 - 1; }
        while (i < src.len && src[i] >= 48 && src[i] <= 57) { i = i + 1; }
    }
    if (i < src.len && (src[i] == 101 || src[i] == 69)) {
        i = i + 1;
        if (i < src.len && (src[i] == 43 || src[i] == 45)) { i = i + 1; }
        if (i >= src.len || src[i] < 48 || src[i] > 57) { return 0 - 1; }
        while (i < src.len && src[i] >= 48 && src[i] <= 57) { i = i + 1; }
    }
    return i;
}

fn json_parse_node(ctx: *JsonParseContext, depth: i32) i32 {
    ctx.*.index = json_skip_ws(ctx.*.src, ctx.*.index);
    if (ctx.*.index >= ctx.*.src.len) { return 0 - 1; }
    let c: u8 = ctx.*.src[ctx.*.index];

    if (c == 34) {
        let end: i32 = json_string_end(ctx.*.src, ctx.*.index);
        if (end < 0) { return 0 - 1; }
        let parsed: JsonStringResult = json_parse_string(ctx.*.src[ctx.*.index..end]);
        if (parsed.ok == 0) { return 0 - 1; }
        json_document_own(ctx.*.doc, parsed.value);
        let value: JsonValue = json_node(json_kind_string());
        value.text = parsed.value;
        let index: i32 = json_document_add(ctx, value);
        if (index < 0) { return 0 - 1; }
        ctx.*.index = end;
        return index;
    }

    if (c == 110 && json_match_at(ctx.*.src, ctx.*.index, "null") == 1) {
        let index: i32 = json_document_add(ctx, json_node(json_kind_null()));
        if (index >= 0) { ctx.*.index = ctx.*.index + 4; }
        return index;
    }
    if (c == 116 && json_match_at(ctx.*.src, ctx.*.index, "true") == 1) {
        let value: JsonValue = json_node(json_kind_bool()); value.boolean = 1;
        let index: i32 = json_document_add(ctx, value);
        if (index >= 0) { ctx.*.index = ctx.*.index + 4; }
        return index;
    }
    if (c == 102 && json_match_at(ctx.*.src, ctx.*.index, "false") == 1) {
        let value: JsonValue = json_node(json_kind_bool()); value.boolean = 0;
        let index: i32 = json_document_add(ctx, value);
        if (index >= 0) { ctx.*.index = ctx.*.index + 5; }
        return index;
    }

    if (c == 45 || (c >= 48 && c <= 57)) {
        let end: i32 = json_number_end(ctx.*.src, ctx.*.index);
        if (end < 0) { return 0 - 1; }
        let text: []u8 = json_copy_range(ctx.*.src, ctx.*.index, end);
        json_document_own(ctx.*.doc, text);
        let value: JsonValue = json_node(json_kind_number()); value.text = text;
        let index: i32 = json_document_add(ctx, value);
        if (index < 0) { return 0 - 1; }
        ctx.*.index = end;
        return index;
    }

    if (c == 91) {
        if (depth >= ctx.*.max_depth) { return 0 - 1; }
        let node_index: i32 = json_document_add(ctx, json_node(json_kind_array()));
        if (node_index < 0) { return 0 - 1; }
        let direct: ArrayList[i32] = make[i32](4);
        let closed: i32 = 0;
        ctx.*.index = json_skip_ws(ctx.*.src, ctx.*.index + 1);
        if (ctx.*.index < ctx.*.src.len && ctx.*.src[ctx.*.index] == 93) {
            ctx.*.index = ctx.*.index + 1; closed = 1;
        } else {
            while (ctx.*.index < ctx.*.src.len) {
                let child: i32 = json_parse_node(ctx, depth + 1);
                if (child < 0) { free[i32](&direct); return 0 - 1; }
                push[i32](&direct, child);
                ctx.*.index = json_skip_ws(ctx.*.src, ctx.*.index);
                if (ctx.*.index >= ctx.*.src.len) { free[i32](&direct); return 0 - 1; }
                if (ctx.*.src[ctx.*.index] == 93) { ctx.*.index = ctx.*.index + 1; closed = 1; break; }
                if (ctx.*.src[ctx.*.index] != 44) { free[i32](&direct); return 0 - 1; }
                ctx.*.index = json_skip_ws(ctx.*.src, ctx.*.index + 1);
                if (ctx.*.index >= ctx.*.src.len || ctx.*.src[ctx.*.index] == 93) {
                    free[i32](&direct); return 0 - 1;
                }
            }
        }
        if (closed == 0) { free[i32](&direct); return 0 - 1; }
        let first: i32 = ctx.*.doc.*.children.len;
        let i: i32 = 0;
        while (i < direct.len) {
            push[i32](&ctx.*.doc.*.children, direct.data[i]);
            push[[]u8](&ctx.*.doc.*.edge_keys, "");
            i = i + 1;
        }
        ctx.*.doc.*.nodes.data[node_index].first_child = first;
        ctx.*.doc.*.nodes.data[node_index].child_count = direct.len;
        free[i32](&direct);
        return node_index;
    }

    if (c == 123) {
        if (depth >= ctx.*.max_depth) { return 0 - 1; }
        let node_index: i32 = json_document_add(ctx, json_node(json_kind_object()));
        if (node_index < 0) { return 0 - 1; }
        let direct: ArrayList[i32] = make[i32](4);
        let keys: ArrayList[[]u8] = make[[]u8](4);
        let closed: i32 = 0;
        ctx.*.index = json_skip_ws(ctx.*.src, ctx.*.index + 1);
        if (ctx.*.index < ctx.*.src.len && ctx.*.src[ctx.*.index] == 125) {
            ctx.*.index = ctx.*.index + 1; closed = 1;
        } else {
            while (ctx.*.index < ctx.*.src.len) {
                let end: i32 = json_string_end(ctx.*.src, ctx.*.index);
                if (end < 0) { free[i32](&direct); free[[]u8](&keys); return 0 - 1; }
                let key: JsonStringResult = json_parse_string(ctx.*.src[ctx.*.index..end]);
                if (key.ok == 0) { free[i32](&direct); free[[]u8](&keys); return 0 - 1; }
                json_document_own(ctx.*.doc, key.value);
                ctx.*.index = json_skip_ws(ctx.*.src, end);
                if (ctx.*.index >= ctx.*.src.len || ctx.*.src[ctx.*.index] != 58) {
                    free[i32](&direct); free[[]u8](&keys); return 0 - 1;
                }
                ctx.*.index = ctx.*.index + 1;
                let child: i32 = json_parse_node(ctx, depth + 1);
                if (child < 0) { free[i32](&direct); free[[]u8](&keys); return 0 - 1; }
                push[i32](&direct, child); push[[]u8](&keys, key.value);
                ctx.*.index = json_skip_ws(ctx.*.src, ctx.*.index);
                if (ctx.*.index >= ctx.*.src.len) { free[i32](&direct); free[[]u8](&keys); return 0 - 1; }
                if (ctx.*.src[ctx.*.index] == 125) { ctx.*.index = ctx.*.index + 1; closed = 1; break; }
                if (ctx.*.src[ctx.*.index] != 44) { free[i32](&direct); free[[]u8](&keys); return 0 - 1; }
                ctx.*.index = json_skip_ws(ctx.*.src, ctx.*.index + 1);
                if (ctx.*.index >= ctx.*.src.len || ctx.*.src[ctx.*.index] == 125) {
                    free[i32](&direct); free[[]u8](&keys); return 0 - 1;
                }
            }
        }
        if (closed == 0) { free[i32](&direct); free[[]u8](&keys); return 0 - 1; }
        let first: i32 = ctx.*.doc.*.children.len;
        let i: i32 = 0;
        while (i < direct.len) {
            push[i32](&ctx.*.doc.*.children, direct.data[i]);
            push[[]u8](&ctx.*.doc.*.edge_keys, keys.data[i]);
            i = i + 1;
        }
        ctx.*.doc.*.nodes.data[node_index].first_child = first;
        ctx.*.doc.*.nodes.data[node_index].child_count = direct.len;
        free[i32](&direct); free[[]u8](&keys);
        return node_index;
    }
    return 0 - 1;
}

fn json_parse_value_bounded(src: []u8, max_depth: i32, max_bytes: i32,
                            max_values: i32) JsonDocument {
    let doc: JsonDocument = json_document_empty();
    if (max_depth < 0 || max_depth > 1024 || max_bytes < 0 ||
        max_values < 1 || src.len > max_bytes) { return doc; }
    let ctx: JsonParseContext = JsonParseContext{
        .src = src,
        .index = 0,
        .max_depth = max_depth,
        .max_values = max_values,
        .doc = &doc,
    };
    let root: i32 = json_parse_node(&ctx, 0);
    ctx.index = json_skip_ws(src, ctx.index);
    if (root < 0 || ctx.index != src.len) { return doc; }
    doc.root = root; doc.ok = 1;
    return doc;
}

fn json_parse_value(src: []u8) JsonDocument {
    return json_parse_value_bounded(src, json_default_max_depth(),
        json_default_max_bytes(), json_default_max_values());
}

fn json_document_root(doc: JsonDocument) i32 {
    if (doc.ok == 0 || doc.root < 0 || doc.root >= doc.nodes.len) { return 0 - 1; }
    return doc.root;
}

fn json_value_at(doc: JsonDocument, index: i32) JsonValue {
    if (index < 0 || index >= doc.nodes.len) { return json_node(json_kind_invalid()); }
    return doc.nodes.data[index];
}

fn json_value_child(doc: JsonDocument, index: i32, child: i32) i32 {
    let value: JsonValue = json_value_at(doc, index);
    if ((value.kind != json_kind_array() && value.kind != json_kind_object()) ||
        child < 0 || child >= value.child_count || value.first_child < 0 ||
        value.first_child > doc.children.len - value.child_count) { return 0 - 1; }
    return doc.children.data[value.first_child + child];
}

fn json_value_object_key(doc: JsonDocument, index: i32, member: i32) []u8 {
    let value: JsonValue = json_value_at(doc, index);
    if (value.kind != json_kind_object() || member < 0 || member >= value.child_count ||
        value.first_child < 0 || value.first_child > doc.edge_keys.len - value.child_count) { return ""; }
    return doc.edge_keys.data[value.first_child + member];
}

fn json_object_find(doc: JsonDocument, index: i32, key: []u8) i32 {
    let value: JsonValue = json_value_at(doc, index);
    if (value.kind != json_kind_object()) { return 0 - 1; }
    let i: i32 = 0;
    while (i < value.child_count) {
        if (@strEq(json_value_object_key(doc, index, i), key)) {
            return json_value_child(doc, index, i);
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn json_encode_byte(out: *ArrayList[u8], value: u8, max_bytes: i32) i32 {
    if (out.*.len >= max_bytes) { return 0; }
    push[u8](out, value); return 1;
}

fn json_encode_text(out: *ArrayList[u8], value: []u8, max_bytes: i32) i32 {
    if (value.len > max_bytes - out.*.len) { return 0; }
    let i: i32 = 0;
    while (i < value.len) { push[u8](out, value[i]); i = i + 1; }
    return 1;
}

fn json_encode_string(out: *ArrayList[u8], value: []u8, max_bytes: i32) i32 {
    if (json_utf8_valid(value) == 0 || json_encode_byte(out, 34, max_bytes) == 0) { return 0; }
    let i: i32 = 0;
    while (i < value.len) {
        let c: u8 = value[i];
        if (c == 34 || c == 92) {
            if (json_encode_byte(out, 92, max_bytes) == 0 || json_encode_byte(out, c, max_bytes) == 0) { return 0; }
        } else if (c == 8 || c == 12 || c == 10 || c == 13 || c == 9) {
            let escaped: u8 = 116;
            if (c == 8) { escaped = 98; }
            else if (c == 12) { escaped = 102; }
            else if (c == 10) { escaped = 110; }
            else if (c == 13) { escaped = 114; }
            if (json_encode_byte(out, 92, max_bytes) == 0 || json_encode_byte(out, escaped, max_bytes) == 0) { return 0; }
        } else if (c < 32) {
            if (json_encode_text(out, "\\u00", max_bytes) == 0 ||
                json_encode_byte(out, json_hex_digit((c as i32) / 16), max_bytes) == 0 ||
                json_encode_byte(out, json_hex_digit((c as i32) % 16), max_bytes) == 0) { return 0; }
        } else if (json_encode_byte(out, c, max_bytes) == 0) { return 0; }
        i = i + 1;
    }
    return json_encode_byte(out, 34, max_bytes);
}

fn json_encode_value(doc: JsonDocument, index: i32, depth: i32,
                     max_depth: i32, max_bytes: i32, out: *ArrayList[u8]) i32 {
    if (index < 0 || index >= doc.nodes.len) { return 0; }
    let value: JsonValue = doc.nodes.data[index];
    if (value.kind == json_kind_null()) { return json_encode_text(out, "null", max_bytes); }
    if (value.kind == json_kind_bool()) {
        if (value.boolean == 0) { return json_encode_text(out, "false", max_bytes); }
        if (value.boolean == 1) { return json_encode_text(out, "true", max_bytes); }
        return 0;
    }
    if (value.kind == json_kind_number()) {
        if (json_number_end(value.text, 0) != value.text.len) { return 0; }
        return json_encode_text(out, value.text, max_bytes);
    }
    if (value.kind == json_kind_string()) { return json_encode_string(out, value.text, max_bytes); }
    if (value.kind != json_kind_array() && value.kind != json_kind_object()) { return 0; }
    if (depth >= max_depth || value.first_child < 0 || value.child_count < 0 ||
        value.first_child > doc.children.len - value.child_count ||
        value.first_child > doc.edge_keys.len - value.child_count) { return 0; }
    let object: i32 = (value.kind == json_kind_object()) as i32;
    if (json_encode_byte(out, (91 + object * 32) as u8, max_bytes) == 0) { return 0; }
    let i: i32 = 0;
    while (i < value.child_count) {
        if (i > 0 && json_encode_byte(out, 44, max_bytes) == 0) { return 0; }
        if (object == 1) {
            if (json_encode_string(out, doc.edge_keys.data[value.first_child + i], max_bytes) == 0 ||
                json_encode_byte(out, 58, max_bytes) == 0) { return 0; }
        }
        if (json_encode_value(doc, doc.children.data[value.first_child + i], depth + 1,
                              max_depth, max_bytes, out) == 0) { return 0; }
        i = i + 1;
    }
    return json_encode_byte(out, (93 + object * 32) as u8, max_bytes);
}

fn json_stringify_value_bounded(doc: JsonDocument, index: i32, max_depth: i32,
                                max_bytes: i32) JsonEncodeResult {
    if (doc.ok == 0 || max_depth < 0 || max_depth > 1024 || max_bytes < 0) {
        return JsonEncodeResult{ .ok = 0, .value = "" };
    }
    let out: ArrayList[u8] = make[u8](64);
    if (json_encode_value(doc, index, 0, max_depth, max_bytes, &out) == 0) {
        free[u8](&out);
        return JsonEncodeResult{ .ok = 0, .value = "" };
    }
    return JsonEncodeResult{ .ok = 1, .value = out.data[0..out.len] };
}

fn json_stringify_value(doc: JsonDocument, index: i32) JsonEncodeResult {
    return json_stringify_value_bounded(doc, index, json_default_max_depth(),
        json_default_max_output_bytes());
}

fn json_encode_result_free(result: *JsonEncodeResult) void {
    if (result.*.ok == 1) { _zag_free(_zag_slice_ptr(result.*.value)); }
    result.*.ok = 0; result.*.value = "";
}

fn json_document_free(doc: *JsonDocument) void {
    let i: i32 = 0;
    while (i < doc.*.owned_text.len) {
        _zag_free(_zag_slice_ptr(doc.*.owned_text.data[i]));
        i = i + 1;
    }
    free[[]u8](&doc.*.owned_text);
    free[[]u8](&doc.*.edge_keys);
    free[i32](&doc.*.children);
    free[JsonValue](&doc.*.nodes);
    doc.*.ok = 0; doc.*.root = 0 - 1;
}
