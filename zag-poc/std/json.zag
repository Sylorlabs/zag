// std/json.zag — small statically typed JSON scalar codec.
//
// This foundation handles JSON string, integer, floating-point, boolean and
// null scalars. Parse failures are explicit `ok = 0` results; they are never
// changed into empty strings, zero, false, or null.

@import("list.zag")

struct JsonStringResult { ok: i32, value: []u8 }
struct JsonIntResult { ok: i32, value: i64 }
struct JsonBoolResult { ok: i32, value: i32 }
struct JsonFloatResult { ok: i32, value: f64 }
struct JsonNullResult { ok: i32 }

fn json_is_ws(c: u8) i32 {
    if (c == 32 || c == 9 || c == 10 || c == 13) { return 1; }
    return 0;
}

fn json_trim_bounds(src: []u8) []u8 {
    let lo: i32 = 0;
    let hi: i32 = src.len;
    while (lo < hi && json_is_ws(src[lo]) == 1) { lo = lo + 1; }
    while (hi > lo && json_is_ws(src[hi - 1]) == 1) { hi = hi - 1; }
    return src[lo..hi];
}

fn json_stringify_string(value: []u8) []u8 {
    let out: ArrayList[u8] = make[u8](value.len + 8);
    push[u8](&out, 34);
    let i: i32 = 0;
    while (i < value.len) {
        let c: u8 = value[i];
        if (c == 34 || c == 92) { push[u8](&out, 92); push[u8](&out, c); }
        else if (c == 10) { push[u8](&out, 92); push[u8](&out, 110); }
        else if (c == 13) { push[u8](&out, 92); push[u8](&out, 114); }
        else if (c == 9) { push[u8](&out, 92); push[u8](&out, 116); }
        else { push[u8](&out, c); }
        i = i + 1;
    }
    push[u8](&out, 34);
    return out.data[0..out.len];
}

fn json_stringify_int(value: i64) []u8 { return _zag_i64_to_str(value); }

fn json_stringify_bool(value: i32) []u8 {
    if (value == 0) { return "false"; }
    return "true";
}

fn json_stringify_null() []u8 { return "null"; }

fn json_parse_string(src: []u8) JsonStringResult {
    let text: []u8 = json_trim_bounds(src);
    if (text.len < 2 || text[0] != 34 || text[text.len - 1] != 34) {
        return JsonStringResult{ .ok = 0, .value = "" };
    }
    let out: ArrayList[u8] = make[u8](text.len);
    let i: i32 = 1;
    while (i + 1 < text.len) {
        let c: u8 = text[i];
        if (c == 34 || c < 32) { return JsonStringResult{ .ok = 0, .value = "" }; }
        if (c != 92) { push[u8](&out, c); i = i + 1; }
        else {
            if (i + 2 >= text.len) { return JsonStringResult{ .ok = 0, .value = "" }; }
            let e: u8 = text[i + 1];
            if (e == 34 || e == 92 || e == 47) { push[u8](&out, e); }
            else if (e == 110) { push[u8](&out, 10); }
            else if (e == 114) { push[u8](&out, 13); }
            else if (e == 116) { push[u8](&out, 9); }
            else { return JsonStringResult{ .ok = 0, .value = "" }; }
            i = i + 2;
        }
    }
    return JsonStringResult{ .ok = 1, .value = out.data[0..out.len] };
}

fn json_parse_int(src: []u8) JsonIntResult {
    let text: []u8 = json_trim_bounds(src);
    if (text.len == 0) { return JsonIntResult{ .ok = 0, .value = 0 }; }
    let i: i32 = 0;
    let neg: i32 = 0;
    if (text[i] == 45) { neg = 1; i = i + 1; }
    if (i >= text.len) { return JsonIntResult{ .ok = 0, .value = 0 }; }
    if (text[i] == 48 && i + 1 < text.len) { return JsonIntResult{ .ok = 0, .value = 0 }; }
    let value: i64 = 0;
    while (i < text.len) {
        let c: u8 = text[i];
        if (c < 48 || c > 57) { return JsonIntResult{ .ok = 0, .value = 0 }; }
        value = value * 10 + (c as i64 - 48);
        i = i + 1;
    }
    if (neg == 1) { value = 0 - value; }
    return JsonIntResult{ .ok = 1, .value = value };
}

fn json_parse_bool(src: []u8) JsonBoolResult {
    let text: []u8 = json_trim_bounds(src);
    if (@strEq(text, "true")) { return JsonBoolResult{ .ok = 1, .value = 1 }; }
    if (@strEq(text, "false")) { return JsonBoolResult{ .ok = 1, .value = 0 }; }
    return JsonBoolResult{ .ok = 0, .value = 0 };
}

fn json_parse_null(src: []u8) JsonNullResult {
    if (@strEq(json_trim_bounds(src), "null")) { return JsonNullResult{ .ok = 1 }; }
    return JsonNullResult{ .ok = 0 };
}

fn json_parse_float(src: []u8) JsonFloatResult {
    let text: []u8 = json_trim_bounds(src);
    if (text.len == 0) { return JsonFloatResult{ .ok = 0, .value = 0.0 }; }
    let i: i32 = 0;
    let neg: i32 = 0;
    if (text[i] == 45) { neg = 1; i = i + 1; }
    if (i >= text.len) { return JsonFloatResult{ .ok = 0, .value = 0.0 }; }
    let whole: f64 = 0.0;
    if (text[i] == 48) { i = i + 1; if (i < text.len && text[i] >= 48 && text[i] <= 57) { return JsonFloatResult{ .ok = 0, .value = 0.0 }; } }
    else {
        if (text[i] < 49 || text[i] > 57) { return JsonFloatResult{ .ok = 0, .value = 0.0 }; }
        while (i < text.len && text[i] >= 48 && text[i] <= 57) { whole = whole * 10.0 + ((text[i] - 48) as f64); i = i + 1; }
    }
    let value: f64 = whole;
    if (i < text.len && text[i] == 46) {
        i = i + 1;
        if (i >= text.len || text[i] < 48 || text[i] > 57) { return JsonFloatResult{ .ok = 0, .value = 0.0 }; }
        let scale: f64 = 0.1;
        while (i < text.len && text[i] >= 48 && text[i] <= 57) { value = value + ((text[i] - 48) as f64) * scale; scale = scale / 10.0; i = i + 1; }
    }
    let exponent: i32 = 0;
    if (i < text.len && (text[i] == 101 || text[i] == 69)) {
        i = i + 1; let exponent_negative: i32 = 0;
        if (i < text.len && (text[i] == 43 || text[i] == 45)) { if (text[i] == 45) { exponent_negative = 1; } i = i + 1; }
        if (i >= text.len || text[i] < 48 || text[i] > 57) { return JsonFloatResult{ .ok = 0, .value = 0.0 }; }
        while (i < text.len && text[i] >= 48 && text[i] <= 57) { if (exponent > 308) { return JsonFloatResult{ .ok = 0, .value = 0.0 }; } exponent = exponent * 10 + ((text[i] - 48) as i32); i = i + 1; }
        let power: f64 = 1.0; let e: i32 = 0; while (e < exponent) { power = power * 10.0; e = e + 1; }
        if (exponent_negative == 1) { value = value / power; } else { value = value * power; }
    }
    if (i != text.len) { return JsonFloatResult{ .ok = 0, .value = 0.0 }; }
    if (neg == 1) { value = 0.0 - value; }
    return JsonFloatResult{ .ok = 1, .value = value };
}
