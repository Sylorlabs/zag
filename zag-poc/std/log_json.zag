// std/log_json.zag -- allocation-free bounded JSON-line application logging.
//
// The encoder preflights the complete record, so validation and capacity
// failures do not mutate the caller's output buffer.  The byte-oriented v1
// contract accepts printable ASCII messages plus tab, CR, and LF; it does not
// claim a Unicode normalization or tracing system.

@import("rt.zag")

struct LogJsonEncodeResult {
    ok: i32,
    code: i64,
    length: i32,
}

struct LogJsonWriteResult {
    ok: i32,
    code: i64,
    transferred: i32,
    calls: i32,
}

fn log_json_status_ok() i64 { return 0; }
fn log_json_status_invalid_argument() i64 { return 0 - 7401; }
fn log_json_status_limit() i64 { return 0 - 7402; }
fn log_json_status_incomplete() i64 { return 0 - 7403; }

fn log_json_level_debug() i32 { return 0; }
fn log_json_level_info() i32 { return 1; }
fn log_json_level_warn() i32 { return 2; }
fn log_json_level_error() i32 { return 3; }
fn log_json_max_message_bytes() i32 { return 4096; }
fn log_json_max_record_bytes() i32 { return 8192; }

fn log_json_level_name(level: i32) []u8 {
    if (level == log_json_level_debug()) { return "debug"; }
    if (level == log_json_level_info()) { return "info"; }
    if (level == log_json_level_warn()) { return "warn"; }
    if (level == log_json_level_error()) { return "error"; }
    return "";
}

fn log_json_event_valid(event: []u8) i32 {
    if (event.len <= 0 || event.len > 64) { return 0; }
    let i: i32 = 0;
    while (i < event.len) {
        let byte: u8 = event[i];
        let alpha: bool = (byte >= 'a' && byte <= 'z') ||
            (byte >= 'A' && byte <= 'Z');
        let digit: bool = byte >= '0' && byte <= '9';
        if (!alpha && !digit && byte != '_' && byte != '-' && byte != '.') {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

fn log_json_message_size(message: []u8) i32 {
    if (message.len > log_json_max_message_bytes()) { return 0 - 1; }
    let size: i32 = 0;
    let i: i32 = 0;
    while (i < message.len) {
        let byte: u8 = message[i];
        if (byte == '"' || byte == '\\' || byte == '\n' ||
            byte == '\r' || byte == '\t') { size = size + 2; }
        else if (byte < 32 || byte > 126) { return 0 - 1; }
        else { size = size + 1; }
        i = i + 1;
    }
    return size;
}

fn log_json_digits(value: i64) i32 {
    let digits: i32 = 1;
    let remaining: i64 = value;
    while (remaining >= 10) { remaining = remaining / 10; digits = digits + 1; }
    return digits;
}

fn log_json_put(output: []u8, cursor: *i32, value: []u8) void {
    let i: i32 = 0;
    while (i < value.len) {
        output[cursor.*] = value[i];
        cursor.* = cursor.* + 1;
        i = i + 1;
    }
}

fn log_json_put_i64(output: []u8, cursor: *i32, value: i64) void {
    let digits: i32 = log_json_digits(value);
    let place: i64 = 1;
    let i: i32 = 1;
    while (i < digits) { place = place * 10; i = i + 1; }
    while (place > 0) {
        output[cursor.*] = ((value / place) % 10 + 48) as u8;
        cursor.* = cursor.* + 1;
        place = place / 10;
    }
}

fn log_json_put_message(output: []u8, cursor: *i32, message: []u8) void {
    let i: i32 = 0;
    while (i < message.len) {
        let byte: u8 = message[i];
        if (byte == '"') { log_json_put(output, cursor, "\\\""); }
        else if (byte == '\\') { log_json_put(output, cursor, "\\\\"); }
        else if (byte == '\n') { log_json_put(output, cursor, "\\n"); }
        else if (byte == '\r') { log_json_put(output, cursor, "\\r"); }
        else if (byte == '\t') { log_json_put(output, cursor, "\\t"); }
        else { output[cursor.*] = byte; cursor.* = cursor.* + 1; }
        i = i + 1;
    }
}

fn log_json_encode(output: []u8, seconds: i64, nanoseconds: i64,
                   level: i32, event: []u8,
                   message: []u8) LogJsonEncodeResult {
    let level_name: []u8 = log_json_level_name(level);
    let message_size: i32 = log_json_message_size(message);
    if (seconds < 0 || nanoseconds < 0 || nanoseconds >= 1000000000 ||
        level_name.len == 0 || log_json_event_valid(event) == 0 ||
        message_size < 0) {
        return LogJsonEncodeResult{
            .ok=0, .code=log_json_status_invalid_argument(), .length=0,
        };
    }
    let needed: i32 = 10 + log_json_digits(seconds) +
        11 + log_json_digits(nanoseconds) + 10 + level_name.len +
        11 + event.len + 13 + message_size + 3;
    if (needed > log_json_max_record_bytes() || output.len < needed) {
        return LogJsonEncodeResult{
            .ok=0, .code=log_json_status_limit(), .length=0,
        };
    }
    let cursor: i32 = 0;
    log_json_put(output, &cursor, "{\"ts_sec\":");
    log_json_put_i64(output, &cursor, seconds);
    log_json_put(output, &cursor, ",\"ts_nsec\":");
    log_json_put_i64(output, &cursor, nanoseconds);
    log_json_put(output, &cursor, ",\"level\":\"");
    log_json_put(output, &cursor, level_name);
    log_json_put(output, &cursor, "\",\"event\":\"");
    log_json_put(output, &cursor, event);
    log_json_put(output, &cursor, "\",\"message\":\"");
    log_json_put_message(output, &cursor, message);
    log_json_put(output, &cursor, "\"}\n");
    if (cursor != needed) {
        return LogJsonEncodeResult{
            .ok=0, .code=log_json_status_incomplete(), .length=0,
        };
    }
    return LogJsonEncodeResult{
        .ok=1, .code=log_json_status_ok(), .length=cursor,
    };
}

fn log_json_write_all_bounded(fd: i64, bytes: []u8,
                              max_calls: i32) LogJsonWriteResult {
    if (fd < 0 || bytes.len <= 0 || bytes.len > log_json_max_record_bytes() ||
        max_calls <= 0 || max_calls > 128) {
        return LogJsonWriteResult{
            .ok=0,.code=log_json_status_invalid_argument(),
            .transferred=0,.calls=0,
        };
    }
    let transferred: i32 = 0;
    let calls: i32 = 0;
    while (transferred < bytes.len && calls < max_calls) {
        let rc: i64 = _zag_raw_syscall(
            1, fd, (_zag_slice_ptr(bytes) as i64) + transferred,
            bytes.len - transferred, 0, 0, 0
        );
        calls = calls + 1;
        if (rc == (0 - 4)) { continue; }
        if (rc < 0) {
            return LogJsonWriteResult{
                .ok=0,.code=rc,.transferred=transferred,.calls=calls,
            };
        }
        if (rc == 0 || rc > (bytes.len - transferred) as i64) {
            return LogJsonWriteResult{
                .ok=0,.code=log_json_status_incomplete(),
                .transferred=transferred,.calls=calls,
            };
        }
        transferred = transferred + rc as i32;
    }
    if (transferred != bytes.len) {
        return LogJsonWriteResult{
            .ok=0,.code=log_json_status_incomplete(),
            .transferred=transferred,.calls=calls,
        };
    }
    return LogJsonWriteResult{
        .ok=1,.code=log_json_status_ok(),
        .transferred=transferred,.calls=calls,
    };
}
