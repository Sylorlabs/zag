// Versioned Linux adapter metadata for std:driver.
//
// These names are intentionally data, not guessed C declarations.  An
// adapter implementation must select one exact kernel series and target and
// then provide executable conformance evidence before it can claim support.

@import("std:driver") as driver

pub fn linux_kernel_6_1() i32 { return 61; }
pub fn linux_kernel_6_6() i32 { return 66; }
pub fn linux_target_x86_64() i32 { return 1; }
pub fn linux_target_arm64() i32 { return 2; }
pub fn linux_target_i686() i32 { return 3; }

pub fn linux_target_supported(target: i32) i32 {
    return (target == linux_target_x86_64() ||
        target == linux_target_arm64() || target == linux_target_i686()) as i32;
}

pub fn linux_kernel_series_supported(series: i32) i32 {
    return (series == linux_kernel_6_1() || series == linux_kernel_6_6()) as i32;
}

pub fn linux_context_probe() i32 { return driver.context_driver_init(); }
pub fn linux_context_control() i32 { return driver.context_driver_control(); }
pub fn linux_context_teardown() i32 { return driver.context_driver_teardown(); }
pub fn linux_context_irq() i32 { return driver.context_irq(); }

pub fn linux_effect_none() i32 { return 0; }
pub fn linux_effect_device() i32 { return 256; }
pub fn linux_effect_atomic_device() i32 { return 320; }
pub fn linux_ownership_borrow() i32 { return 1; }
pub fn linux_ownership_consume() i32 { return 2; }
pub fn linux_ownership_acquire() i32 { return 3; }

pub struct LinuxInterfaceTag {
    kernel_series: i32,
    api: i32,
    context: i32,
    effects: i32,
    ownership: i32,
    available: i32,
}

pub struct LinuxSupport {
    target: i32,
    kernel_series: i32,
    userspace: i32,
    kernel_module: i32,
    qemu: i32,
    emulator: i32,
    physical_device: i32,
}

pub fn linux_api_pci_probe() i32 { return 1; }
pub fn linux_api_pci_remove() i32 { return 2; }
pub fn linux_api_dma_map() i32 { return 3; }
pub fn linux_api_dma_unmap() i32 { return 4; }
pub fn linux_api_irq_request() i32 { return 5; }
pub fn linux_api_irq_free() i32 { return 6; }
pub fn linux_api_pm_suspend() i32 { return 7; }
pub fn linux_api_pm_resume() i32 { return 8; }

pub fn linux_api_context(api: i32) i32 {
    if (api == linux_api_pci_probe() || api == linux_api_irq_request()) {
        return linux_context_probe();
    }
    if (api == linux_api_pci_remove() || api == linux_api_dma_unmap() ||
        api == linux_api_irq_free()) { return linux_context_teardown(); }
    if (api == linux_api_dma_map() || api == linux_api_pm_suspend() ||
        api == linux_api_pm_resume()) { return linux_context_control(); }
    return 0;
}

pub fn linux_api_effects(api: i32) i32 {
    if (api == linux_api_irq_request()) { return linux_effect_atomic_device(); }
    if (linux_api_known(api) == 1) { return linux_effect_device(); }
    return -1;
}

pub fn linux_api_ownership(api: i32) i32 {
    if (api == linux_api_pci_probe() || api == linux_api_irq_request()) {
        return linux_ownership_acquire();
    }
    if (api == linux_api_pci_remove() || api == linux_api_dma_unmap() ||
        api == linux_api_irq_free()) { return linux_ownership_consume(); }
    if (linux_api_known(api) == 1) { return linux_ownership_borrow(); }
    return -1;
}

pub fn linux_api_contract_valid(api: i32, context: i32,
                                effects: i32, ownership: i32) i32 {
    return (linux_api_known(api) == 1 && context == linux_api_context(api) &&
        effects == linux_api_effects(api) && ownership == linux_api_ownership(api)) as i32;
}

pub fn linux_api_known(api: i32) i32 {
    if (api >= linux_api_pci_probe() && api <= linux_api_pm_resume()) { return 1; }
    return 0;
}

pub fn linux_interface_tag(series: i32, api: i32, context: i32,
                            effects: i32, ownership: i32) LinuxInterfaceTag {
    return LinuxInterfaceTag{
        .kernel_series = series,
        .api = api,
        .context = context,
        .effects = effects,
        .ownership = ownership,
        .available = (linux_api_contract_valid(api, context, effects, ownership) &&
            (series == linux_kernel_6_1() || series == linux_kernel_6_6())) as i32,
    };
}

pub fn linux_interface_available(tag: @borrows *LinuxInterfaceTag) i32 {
    return tag.*.available;
}

pub fn linux_unsupported_api(series: i32, api: i32) []u8 {
    if (series != linux_kernel_6_1() && series != linux_kernel_6_6()) {
        return "unsupported Linux kernel series: select 6.1 or 6.6 explicitly";
    }
    if (linux_api_known(api) == 0) {
        return "unsupported Linux driver API: no versioned std:driver binding exists";
    }
    return "";
}

pub fn linux_support(target: i32, series: i32, userspace: i32,
                     emulator: i32, qemu: i32, kernel_module: i32) LinuxSupport {
    let target_ok: i32 = linux_target_supported(target);
    let series_ok: i32 = linux_kernel_series_supported(series);
    return LinuxSupport{
        .target = target,
        .kernel_series = series,
        .userspace = (target_ok && series_ok && userspace != 0) as i32,
        .kernel_module = (target_ok && series_ok && kernel_module != 0) as i32,
        .qemu = (target_ok && series_ok && qemu != 0) as i32,
        .emulator = (target_ok && series_ok && emulator != 0) as i32,
        .physical_device = 0,
    };
}
