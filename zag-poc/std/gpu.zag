// gpu.zag — evidence-first GPU operation and promotion policy.
//
// This module deliberately separates software validation from physical-device
// certification.  A caller gets a stable reason, an actionable next step, and
// the exact counters behind every decision instead of a bare boolean.

@import("rt.zag")
@import("gfx1010_vm.zag")

struct ZagGpuTuple {
    device: i64,
    gfx_ip: i64,
    gfx_discovery: i64,
    gfx_rings: i64,
    compute_ip: i64,
    compute_discovery: i64,
    compute_rings: i64,
    mec_firmware: i64,
    sdma_firmware: i64,
    kernel: i64,
    compiler: i64,
    runtime: i64,
}

fn zag_gpu_tuple_equal(a: ZagGpuTuple, b: ZagGpuTuple) bool {
    return a.device==b.device && a.gfx_ip==b.gfx_ip &&
        a.gfx_discovery==b.gfx_discovery && a.gfx_rings==b.gfx_rings &&
        a.compute_ip==b.compute_ip && a.compute_discovery==b.compute_discovery &&
        a.compute_rings==b.compute_rings &&
        a.mec_firmware==b.mec_firmware && a.sdma_firmware==b.sdma_firmware &&
        a.kernel==b.kernel && a.compiler==b.compiler && a.runtime==b.runtime;
}

struct ZagGpuCertification {
    tuple: ZagGpuTuple,
    reset_isolated: bool,
    memory_sync_verified: bool,
    kernel_log_clean: bool,
    fills: i64,
    ownership_transfers: i64,
    dispatches: i64,
    soak_seconds: i64,
    mismatches: i64,
    timeouts: i64,
    resets: i64,
    faults: i64,
    leaks: i64,
}

// Host-contained certification is first-class evidence, but it is deliberately
// a different type from physical certification. It can prove compiler, command,
// ownership, fence, bounds, fallback, and long logical-time behavior. It can
// never be passed to zag_gpu_auto_decide and therefore cannot promote silicon.
struct ZagGpuVirtualCertification {
    tuple: ZagGpuTuple,
    compiler_manifest_verified: bool,
    memory_sync_verified: bool,
    fills: i64,
    ownership_transfers: i64,
    dispatches: i64,
    logical_soak_seconds: i64,
    wall_soak_seconds: i64,
    golden_scenes: i64,
    randomized_scenes: i64,
    mismatches: i64,
    timeouts: i64,
    resets: i64,
    faults: i64,
    leaks: i64,
}

fn zag_gpu_virtual_cert_decide(current:ZagGpuTuple,cert:ZagGpuVirtualCertification)ZagGpuDecision{
    if(!zag_gpu_tuple_equal(current,cert.tuple)){
        return zag_gpu_deny(101,"virtual certification tuple mismatch",
            "rerun the virtual campaign with the exact compiler kernels VM and runtime tuple");
    }
    if(!cert.compiler_manifest_verified||!cert.memory_sync_verified){
        return zag_gpu_deny(102,"virtual compiler manifest or ownership proof is incomplete",
            "validate every compiler bundle and every release submit fence acquire transition");
    }
    if(cert.fills<10000||cert.ownership_transfers<10000||cert.dispatches<1000000||
       cert.logical_soak_seconds<86400||cert.golden_scenes<1||cert.randomized_scenes<64){
        return zag_gpu_deny(103,"virtual certification campaign is incomplete",
            "resume to 10000 fills 10000 transfers 1000000 submissions 86400 logical seconds and 64 randomized scenes");
    }
    if(cert.mismatches!=0||cert.timeouts!=0||cert.resets!=0||cert.faults!=0||cert.leaks!=0){
        return zag_gpu_deny(104,"virtual certification recorded an anomaly",
            "preserve evidence quarantine the virtual tuple and diagnose before restarting");
    }
    return ZagGpuDecision{.allowed=true,.code=100,
        .reason="host-contained virtual certification complete; this is not physical silicon evidence",
        .next_action="use for safe logic validation only and keep physical automatic promotion disabled",
        .benefit_permille=0};
}

struct ZagGpuBenefit {
    samples: i64,
    cpu_ns: i64,
    gpu_ns: i64,
    representative: bool,
    raw_samples_retained: bool,
}

struct ZagGpuDecision {
    allowed: bool,
    code: i32,
    reason: []u8,
    next_action: []u8,
    benefit_permille: i64,
}

// Backend choice is policy, not a compiler mandate. Applications may expose
// these names through a CLI, environment variable, configuration file, or UI.
// `auto` is safe-by-default; explicit choices remain available to the user.
fn zag_gpu_backend_auto()i32{return 0;}
fn zag_gpu_backend_cpu()i32{return 1;}
fn zag_gpu_backend_virtual()i32{return 2;}
fn zag_gpu_backend_physical()i32{return 3;}
fn zag_gpu_backend_invalid()i32{return 4;}

fn zag_gpu_backend_parse(name:[]u8)i32{
    if(name.len==0||_zag_strcmp(name,"auto")==1){return zag_gpu_backend_auto();}
    if(_zag_strcmp(name,"cpu")==1||_zag_strcmp(name,"off")==1){return zag_gpu_backend_cpu();}
    if(_zag_strcmp(name,"virtual")==1||_zag_strcmp(name,"vm")==1){return zag_gpu_backend_virtual();}
    if(_zag_strcmp(name,"physical")==1||_zag_strcmp(name,"hardware")==1){return zag_gpu_backend_physical();}
    return zag_gpu_backend_invalid();
}

fn zag_gpu_backend_name(backend:i32)[]u8{
    if(backend==zag_gpu_backend_auto()){return "auto";}
    if(backend==zag_gpu_backend_cpu()){return "cpu";}
    if(backend==zag_gpu_backend_virtual()){return "virtual";}
    if(backend==zag_gpu_backend_physical()){return "physical";}
    return "invalid";
}

struct ZagGpuBackendRequest {
    requested:i32,
    virtual_available:bool,
    physical_available:bool,
    physical_certified:bool,
    physical_display_bound:bool,
    physical_reset_isolated:bool,
    physical_acknowledged:bool,
}

struct ZagGpuBackendChoice {
    ok:bool,
    selected:i32,
    code:i32,
    reason:[]u8,
    fallback:bool,
}

fn zag_gpu_backend_choose(r:ZagGpuBackendRequest)ZagGpuBackendChoice{
    if(r.requested==zag_gpu_backend_invalid()){
        return ZagGpuBackendChoice{.ok=false,.selected=zag_gpu_backend_cpu(),.code=201,
            .reason="unknown GPU backend; choose auto cpu virtual or physical",.fallback=true};
    }
    if(r.requested==zag_gpu_backend_cpu()){
        return ZagGpuBackendChoice{.ok=true,.selected=zag_gpu_backend_cpu(),.code=0,
            .reason="CPU backend explicitly selected",.fallback=false};
    }
    if(r.requested==zag_gpu_backend_virtual()){
        if(!r.virtual_available){return ZagGpuBackendChoice{.ok=false,.selected=zag_gpu_backend_cpu(),.code=202,
            .reason="virtual GPU backend is unavailable",.fallback=true};}
        return ZagGpuBackendChoice{.ok=true,.selected=zag_gpu_backend_virtual(),.code=0,
            .reason="host-contained virtual GPU explicitly selected",.fallback=false};
    }
    if(r.requested==zag_gpu_backend_physical()){
        if(!r.physical_available){return ZagGpuBackendChoice{.ok=false,.selected=zag_gpu_backend_cpu(),.code=203,
            .reason="physical GPU backend is unavailable",.fallback=true};}
        if((r.physical_display_bound||!r.physical_reset_isolated)&&!r.physical_acknowledged){
            return ZagGpuBackendChoice{.ok=false,.selected=zag_gpu_backend_cpu(),.code=204,
                .reason="physical GPU requires reset isolation or explicit shared-device acknowledgement",.fallback=true};
        }
        return ZagGpuBackendChoice{.ok=true,.selected=zag_gpu_backend_physical(),.code=0,
            .reason="physical GPU explicitly selected by the user",.fallback=false};
    }
    // Auto never silently takes an uncontained or uncertified physical path.
    if(r.physical_available&&r.physical_certified&&r.physical_reset_isolated&&!r.physical_display_bound){
        return ZagGpuBackendChoice{.ok=true,.selected=zag_gpu_backend_physical(),.code=0,
            .reason="auto selected an exact certified reset-isolated physical GPU",.fallback=false};
    }
    if(r.virtual_available){return ZagGpuBackendChoice{.ok=true,.selected=zag_gpu_backend_virtual(),.code=200,
        .reason="auto selected host-contained virtual GPU because physical promotion is unavailable",.fallback=true};}
    return ZagGpuBackendChoice{.ok=true,.selected=zag_gpu_backend_cpu(),.code=200,
        .reason="auto selected CPU because no safe GPU backend is available",.fallback=true};
}

// Execution tiers are capabilities, not optimistic labels. Virtual ISA runs
// on host-owned memory and cannot hang physical firmware. Memory-only may map a
// GPU-visible BO but submits no commands. Any shader-core execution shares the
// physical device's scheduler/firmware/reset domain and therefore requires a
// reset-isolated non-display device; a watchdog is recovery, not containment.
fn zag_gpu_tier_virtual() i32 { return 0; }
fn zag_gpu_tier_memory_only() i32 { return 1; }
fn zag_gpu_tier_physical_bounded() i32 { return 2; }
fn zag_gpu_tier_destructive() i32 { return 3; }

struct ZagGpuExecutionRequest {
    tier: i32,
    display_bound: bool,
    reset_isolated: bool,
    process_isolation: bool,
    driver_recovery: bool,
    compiler_proved_straight_line: bool,
    manifest_verified: bool,
    workgroups: i64,
    instructions: i64,
    writable_bytes: i64,
    deadline_ms: i64,
    allow_shared_display_override: bool,
    acknowledge_reset_or_system_hang: bool,
}

fn zag_gpu_execution_decide(r:ZagGpuExecutionRequest) ZagGpuDecision {
    if(r.tier==zag_gpu_tier_virtual()){
        if(!r.compiler_proved_straight_line||!r.manifest_verified){
            return zag_gpu_deny(20,"virtual kernel proof is incomplete",
                "compile a bounded reviewed profile and verify its manifest before VM execution");
        }
        return ZagGpuDecision{.allowed=true,.code=0,.reason="host-contained exact-ISA virtual execution",
            .next_action="execute against caller-owned bounded memory",.benefit_permille=0};
    }
    if(r.tier==zag_gpu_tier_memory_only()){
        if(r.workgroups!=0||r.instructions!=0){
            return zag_gpu_deny(21,"memory-only tier cannot submit instructions",
                "set workgroups and instructions to zero or request a physical tier");
        }
        return ZagGpuDecision{.allowed=true,.code=0,.reason="GPU-visible memory with no command submission",
            .next_action="map, round-trip, unmap, and close without creating a context",.benefit_permille=0};
    }
    if(r.tier!=zag_gpu_tier_physical_bounded()&&r.tier!=zag_gpu_tier_destructive()){
        return zag_gpu_deny(22,"unknown GPU execution tier","use a named Zag GPU execution tier");
    }
    let shared_override:bool=r.tier==zag_gpu_tier_physical_bounded()&&r.display_bound&&
        r.allow_shared_display_override&&r.acknowledge_reset_or_system_hang;
    if(r.tier==zag_gpu_tier_destructive()&&r.display_bound){
        return zag_gpu_deny(27,"destructive certification cannot use a display-bound device",
            "select an independently resettable non-display device");
    }
    if(r.display_bound&&!shared_override){
        return zag_gpu_deny(23,"physical shader execution shares the display GPU fault domain",
            "use virtual execution or explicitly acknowledge the shared-device reset and system-hang risk");
    }
    if(!r.reset_isolated&&!shared_override){
        return zag_gpu_deny(24,"physical device has no independent reset containment",
            "require a proved VF, IOMMU group, and FLR reset before shader submission");
    }
    if(!r.compiler_proved_straight_line||!r.manifest_verified){
        return zag_gpu_deny(25,"physical kernel is not proof-carrying and manifest-verified",
            "compile a straight-line bounded profile and verify every emitted instruction");
    }
    if(r.workgroups<1||r.workgroups>65535||r.instructions<1||r.instructions>100000000||
        r.writable_bytes<1||r.writable_bytes>268435456||r.deadline_ms<1||r.deadline_ms>3000){
        return zag_gpu_deny(26,"physical resource envelope is outside reviewed limits",
            "bound workgroups, instructions, writable bytes, and deadline within the reviewed envelope");
    }
    if(shared_override){
        return ZagGpuDecision{.allowed=true,.code=28,
            .reason="user-authorized bounded physical request; shared display fault domain is not contained",
            .next_action="capture logs and run one minimal dispatch; never record this as isolated certification",
            .benefit_permille=0};
    }
    return ZagGpuDecision{.allowed=true,.code=0,.reason="isolated proof-carrying bounded physical request",
        .next_action="capture kernel-log and fault counters before and after one submission",.benefit_permille=0};
}

fn zag_gpu_deny(code:i32, reason:[]u8, next:[]u8) ZagGpuDecision {
    return ZagGpuDecision{.allowed=false,.code=code,.reason=reason,
        .next_action=next,.benefit_permille=0};
}

fn zag_gpu_auto_decide(current: ZagGpuTuple, cert: ZagGpuCertification,
                       benefit: ZagGpuBenefit, minimum_permille: i64) ZagGpuDecision {
    if (!zag_gpu_tuple_equal(current,cert.tuple)) {
        return zag_gpu_deny(1,"certification tuple mismatch",
            "certify this exact device, GFX/compute IP discovery and rings, firmware, kernel, compiler, and runtime tuple");
    }
    if (!cert.reset_isolated) {
        return zag_gpu_deny(2,"device has no proven reset isolation",
            "use virtual execution or attach independently resettable non-display hardware");
    }
    if (!cert.memory_sync_verified) {
        return zag_gpu_deny(3,"memory synchronization is not physically verified",
            "run the bounded ordered-write/readback certification gate");
    }
    if (!cert.kernel_log_clean) {
        return zag_gpu_deny(4,"kernel log delta is not clean",
            "capture and resolve every new amdgpu fault, reset, timeout, and warning");
    }
    if (cert.fills<10000 || cert.ownership_transfers<10000 ||
        cert.dispatches<1000000 || cert.soak_seconds<86400) {
        return zag_gpu_deny(5,"physical certification campaign is incomplete",
            "resume until fills=10000 transfers=10000 dispatches=1000000 soak=86400s");
    }
    if (cert.mismatches!=0 || cert.timeouts!=0 || cert.resets!=0 ||
        cert.faults!=0 || cert.leaks!=0) {
        return zag_gpu_deny(6,"certification recorded an anomaly",
            "retain the evidence, quarantine the tuple, diagnose, then recertify from zero");
    }
    if (!benefit.representative || !benefit.raw_samples_retained || benefit.samples<30) {
        return zag_gpu_deny(7,"benefit evidence is not statistically reviewable",
            "retain at least 30 raw paired samples from a representative workload");
    }
    if (benefit.cpu_ns<=0 || benefit.gpu_ns<=0 || benefit.gpu_ns>=benefit.cpu_ns) {
        return zag_gpu_deny(8,"GPU path has no measured benefit",
            "keep CPU automatic and collect a workload where GPU wall time is lower");
    }
    let gain:i64=((benefit.cpu_ns-benefit.gpu_ns)*1000)/benefit.cpu_ns;
    if (gain<minimum_permille) {
        let d:ZagGpuDecision=zag_gpu_deny(9,"measured benefit is below policy threshold",
            "keep GPU opt-in or improve it before automatic promotion");
        d.benefit_permille=gain; return d;
    }
    return ZagGpuDecision{.allowed=true,.code=0,.reason="exact tuple certified with measured benefit",
        .next_action="automatic GPU use is permitted only while the tuple remains exact",
        .benefit_permille=gain};
}

struct ZagGpuDiagnostic {
    ok: bool,
    profile: []u8,
    error_code: i32,
    error_name: []u8,
    hint: []u8,
    workgroups: i64,
    instructions: i64,
    stores: i64,
    fence: i64,
}

fn zag_gpu_profile_name(profile:i32) []u8 {
    if(profile==1){return "fill";} if(profile==2){return "depth";}
    if(profile==3){return "blend";} return "unknown";
}

fn zag_gpu_error_name(code:i32) []u8 {
    if(code==0){return "ok";} if(code==1){return "invalid-kernel-bundle";}
    if(code==2){return "invalid-command-stream";} if(code==3){return "virtual-address-mismatch";}
    if(code==4){return "dispatch-bounds-or-parameter";} if(code==5){return "ownership-or-fence-order";}
    if(code==6){return "queue-quarantined";} return "unknown-error";
}

fn zag_gpu_error_hint(code:i32) []u8 {
    if(code==0){return "no action required";}
    if(code==1){return "rebuild with znc and verify the complete compiler-owned instruction profile";}
    if(code==2){return "inspect PM4 packets, register coverage, reserved bits, and dispatch dimensions";}
    if(code==3){return "bind the exact mapped shader, color, and depth virtual addresses";}
    if(code==4){return "check grid bounds, buffer lengths, fence value, depth, and alpha range";}
    if(code==5){return "release CPU ownership, submit one monotonic fence, then acquire that exact fence";}
    if(code==6){return "stop submissions and recreate the queue only after preserving fault evidence";}
    return "preserve the inputs and report this unclassified error";
}

fn zag_gpu_diagnostic(bundle:Gfx1010VmBundle, result:Gfx1010VmResult) ZagGpuDiagnostic {
    return ZagGpuDiagnostic{.ok=result.ok,.profile=zag_gpu_profile_name(bundle.profile),
        .error_code=result.error_code,.error_name=zag_gpu_error_name(result.error_code),
        .hint=zag_gpu_error_hint(result.error_code),.workgroups=result.workgroups,
        .instructions=result.instructions,.stores=result.stores,.fence=result.fence};
}

fn zag_gpu_diagnostic_text(d:ZagGpuDiagnostic) []u8 {
    let s:[]u8=_zag_str_concat("profile=",d.profile);
    s=_zag_str_concat(s," status="); s=_zag_str_concat(s,d.error_name);
    let wg:[]u8=_zag_i64_to_str(d.workgroups);
    s=_zag_str_concat(s," workgroups="); s=_zag_str_concat(s,wg); _zag_str_free(wg);
    let ins:[]u8=_zag_i64_to_str(d.instructions);
    s=_zag_str_concat(s," instructions="); s=_zag_str_concat(s,ins); _zag_str_free(ins);
    let st:[]u8=_zag_i64_to_str(d.stores);
    s=_zag_str_concat(s," stores="); s=_zag_str_concat(s,st); _zag_str_free(st);
    let fe:[]u8=_zag_i64_to_str(d.fence);
    s=_zag_str_concat(s," fence="); s=_zag_str_concat(s,fe); _zag_str_free(fe);
    s=_zag_str_concat(s," hint="); return _zag_str_concat(s,d.hint);
}

struct ZagGpuCampaign {
    version: i64,
    target: i64,
    completed: i64,
    last_fence: i64,
    seed: i64,
    elapsed_ms: i64,
    mismatches: i64,
    timeouts: i64,
    resets: i64,
    faults: i64,
}

fn zag_gpu_campaign_valid(c:ZagGpuCampaign) bool {
    return c.version==1 && c.target>0 && c.completed>=0 && c.completed<=c.target &&
        c.last_fence==c.completed && c.seed>=0 && c.elapsed_ms>=0 &&
        c.mismatches>=0 && c.timeouts>=0 && c.resets>=0 && c.faults>=0;
}

fn zag_gpu_campaign_encode(c:ZagGpuCampaign) []u8 {
    let s:[]u8="ZAGGPU1";
    let v:[]u8=_zag_i64_to_str(c.version);
    s=_zag_str_concat(s," ");s=_zag_str_concat(s,v);_zag_str_free(v);
    let t:[]u8=_zag_i64_to_str(c.target);
    s=_zag_str_concat(s," ");s=_zag_str_concat(s,t);_zag_str_free(t);
    let cp:[]u8=_zag_i64_to_str(c.completed);
    s=_zag_str_concat(s," ");s=_zag_str_concat(s,cp);_zag_str_free(cp);
    let lf:[]u8=_zag_i64_to_str(c.last_fence);
    s=_zag_str_concat(s," ");s=_zag_str_concat(s,lf);_zag_str_free(lf);
    let sd:[]u8=_zag_i64_to_str(c.seed);
    s=_zag_str_concat(s," ");s=_zag_str_concat(s,sd);_zag_str_free(sd);
    let el:[]u8=_zag_i64_to_str(c.elapsed_ms);
    s=_zag_str_concat(s," ");s=_zag_str_concat(s,el);_zag_str_free(el);
    let mm:[]u8=_zag_i64_to_str(c.mismatches);
    s=_zag_str_concat(s," ");s=_zag_str_concat(s,mm);_zag_str_free(mm);
    let tm:[]u8=_zag_i64_to_str(c.timeouts);
    s=_zag_str_concat(s," ");s=_zag_str_concat(s,tm);_zag_str_free(tm);
    let rs:[]u8=_zag_i64_to_str(c.resets);
    s=_zag_str_concat(s," ");s=_zag_str_concat(s,rs);_zag_str_free(rs);
    let fl:[]u8=_zag_i64_to_str(c.faults);
    s=_zag_str_concat(s," ");s=_zag_str_concat(s,fl);_zag_str_free(fl);
    return _zag_str_concat(s,"\n");
}

fn zag_gpu_campaign_save(path:[]u8,c:ZagGpuCampaign) bool {
    if(!zag_gpu_campaign_valid(c)){return false;}
    return _zag_write_file(path,zag_gpu_campaign_encode(c))==0;
}

struct ZagGpuParseInt { value:i64, next:i32, ok:bool }

fn zag_gpu_parse_int(s:[]u8,start:i32) ZagGpuParseInt {
    let i:i32=start; while(i<s.len&&(s[i]==32||s[i]==10||s[i]==13||s[i]==9)){i=i+1;}
    let begin:i32=i; while(i<s.len&&s[i]>=48&&s[i]<=57){i=i+1;}
    if(i==begin){return ZagGpuParseInt{.value=0,.next=start,.ok=false};}
    return ZagGpuParseInt{.value=_zag_str_to_i64(s[begin..i]),.next=i,.ok=true};
}

fn zag_gpu_campaign_decode(raw:[]u8) ZagGpuCampaign {
    let bad:ZagGpuCampaign=ZagGpuCampaign{.version=0,.target=0,.completed=0,
        .last_fence=0,.seed=0,.elapsed_ms=0,.mismatches=0,.timeouts=0,.resets=0,.faults=0};
    if(raw.len<8 || _zag_strcmp(raw[0..7],"ZAGGPU1")!=1){return bad;}
    let p:ZagGpuParseInt=zag_gpu_parse_int(raw,7);if(!p.ok){return bad;}let version:i64=p.value;
    p=zag_gpu_parse_int(raw,p.next);if(!p.ok){return bad;}let target:i64=p.value;
    p=zag_gpu_parse_int(raw,p.next);if(!p.ok){return bad;}let completed:i64=p.value;
    p=zag_gpu_parse_int(raw,p.next);if(!p.ok){return bad;}let fence:i64=p.value;
    p=zag_gpu_parse_int(raw,p.next);if(!p.ok){return bad;}let seed:i64=p.value;
    p=zag_gpu_parse_int(raw,p.next);if(!p.ok){return bad;}let elapsed:i64=p.value;
    p=zag_gpu_parse_int(raw,p.next);if(!p.ok){return bad;}let mismatches:i64=p.value;
    p=zag_gpu_parse_int(raw,p.next);if(!p.ok){return bad;}let timeouts:i64=p.value;
    p=zag_gpu_parse_int(raw,p.next);if(!p.ok){return bad;}let resets:i64=p.value;
    p=zag_gpu_parse_int(raw,p.next);if(!p.ok){return bad;}let faults:i64=p.value;
    let i:i32=p.next;while(i<raw.len&&(raw[i]==32||raw[i]==10||raw[i]==13||raw[i]==9)){i=i+1;}
    if(i!=raw.len){return bad;}
    let c:ZagGpuCampaign=ZagGpuCampaign{.version=version,.target=target,.completed=completed,
        .last_fence=fence,.seed=seed,.elapsed_ms=elapsed,.mismatches=mismatches,
        .timeouts=timeouts,.resets=resets,.faults=faults};
    if(!zag_gpu_campaign_valid(c)){return bad;}return c;
}

fn zag_gpu_campaign_load(path:[]u8) ZagGpuCampaign {
    let raw:[]u8=_zag_read_file(path);
    if(raw.len<0){return ZagGpuCampaign{.version=0,.target=0,.completed=0,.last_fence=0,
        .seed=0,.elapsed_ms=0,.mismatches=0,.timeouts=0,.resets=0,.faults=0};}
    return zag_gpu_campaign_decode(raw);
}
