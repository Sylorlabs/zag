// std/iterator.zag -- allocation-free bounded iteration over a borrowed slice.
//
// The iterator never owns the slice. The caller must keep the backing storage
// live and unchanged for the iteration. A null result is disambiguated through
// slice_iterator_status().

struct SliceIterator[T] {
    items: []T,
    index: i32,
    emitted: i32,
    max_items: i32,
    status: i64,
}

fn slice_iterator_status_ready() i64 { return 0; }
fn slice_iterator_status_exhausted() i64 { return 1; }
fn slice_iterator_status_limit() i64 { return 2; }
fn slice_iterator_status_invalid() i64 { return 3; }

fn slice_iterator_bounded[T](items: []T, max_items: i32) SliceIterator[T] @borrows {
    let status: i64 = slice_iterator_status_ready();
    if (max_items < 0) { status = slice_iterator_status_invalid(); }
    if (status == slice_iterator_status_ready() && items.len == 0) {
        status = slice_iterator_status_exhausted();
    }
    return SliceIterator[T]{
        .items = items,
        .index = 0,
        .emitted = 0,
        .max_items = max_items,
        .status = status,
    };
}

fn slice_iterator[T](items: []T) SliceIterator[T] @borrows {
    let status: i64 = slice_iterator_status_ready();
    if (items.len == 0) { status = slice_iterator_status_exhausted(); }
    return SliceIterator[T]{
        .items = items,
        .index = 0,
        .emitted = 0,
        .max_items = items.len,
        .status = status,
    };
}

fn slice_iterator_next[T](iterator: *SliceIterator[T]) ?T @borrows_mut {
    if (iterator.*.status != slice_iterator_status_ready()) { return null; }
    if (iterator.*.index >= iterator.*.items.len) {
        iterator.*.status = slice_iterator_status_exhausted();
        return null;
    }
    if (iterator.*.emitted >= iterator.*.max_items) {
        iterator.*.status = slice_iterator_status_limit();
        return null;
    }
    let value: T = iterator.*.items[iterator.*.index];
    iterator.*.index = iterator.*.index + 1;
    iterator.*.emitted = iterator.*.emitted + 1;
    return value;
}

fn slice_iterator_status[T](iterator: SliceIterator[T]) i64 @borrows {
    return iterator.status;
}
