// gpu_compat_contract.zag — shared typed launch/readback boundary.
//
// Vulkan, OpenGL, and OpenCL keep their native loader ABIs separate, but they
// must agree on the safety envelope presented to a Zag caller. These records
// make that envelope explicit before an adapter touches a driver. This is a
// bounded compatibility profile, not an arbitrary-kernel ABI.

struct ZagGpuCompatReadback {
    output_buffer:*i32,
    output_count:u32,
}

struct ZagGpuCompatLaunch {
    group_count_x:u32,
    group_count_y:u32,
    group_count_z:u32,
    local_work_size:u64,
    timeout_ns:u64,
}

fn zag_gpu_compat_validate_readback(readback:ZagGpuCompatReadback) i32 {
    if (readback.output_buffer==null as *i32) { return -202; }
    if (readback.output_count==0 || readback.output_count>1048576) { return -202; }
    return 0;
}

fn zag_gpu_compat_validate_launch(launch:ZagGpuCompatLaunch) i32 {
    if (launch.group_count_x==0 || launch.group_count_y==0 || launch.group_count_z==0) { return -201; }
    if (launch.group_count_x>1048576 || launch.group_count_y>1048576 || launch.group_count_z>1048576) { return -201; }
    if (launch.local_work_size>1048576) { return -201; }
    // Zero selects the adapter's bounded default; nonzero waits are capped.
    if (launch.timeout_ns>60000000000) { return -201; }
    return 0;
}

fn zag_gpu_compat_validate(readback:ZagGpuCompatReadback, launch:ZagGpuCompatLaunch) i32 {
    let readback_rc:i32=zag_gpu_compat_validate_readback(readback);
    if (readback_rc!=0) { return readback_rc; }
    return zag_gpu_compat_validate_launch(launch);
}
