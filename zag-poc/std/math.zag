// std/math.zag — portable f64 elementary functions written in Zag.
//
//   @import("std:math") as math
//   let r: f64 = math.sqrt(2.0);
//
// The native backends expose no transcendental builtins, so learners and
// numeric code previously had to hand-roll these. Every function here is pure
// Zag over ordinary f64 arithmetic (no unsafe, no allocation, no I/O) and is
// accurate to roughly 1e-15 relative error over the documented domain.
// Non-finite handling is deliberately simple and documented per function.

fn pi() f64 { return 3.141592653589793; }
fn e() f64 { return 2.718281828459045; }
fn ln2() f64 { return 0.6931471805599453; }

fn abs(x: f64) f64 {
    if (x < 0.0) { return 0.0 - x; }
    return x;
}

fn min(a: f64, b: f64) f64 {
    if (a < b) { return a; }
    return b;
}

fn max(a: f64, b: f64) f64 {
    if (a > b) { return a; }
    return b;
}

// True when x is NaN (the only value unequal to itself).
fn is_nan(x: f64) bool { return x != x; }

// Largest integral value <= x, for |x| < 2^62. Returns x unchanged outside.
fn floor(x: f64) f64 {
    if (x != x) { return x; }
    if (x >= 4611686018427387904.0 || x <= -4611686018427387904.0) { return x; }
    let t: f64 = (x as i64) as f64;
    if (t > x) { return t - 1.0; }
    return t;
}

fn ceil(x: f64) f64 {
    let f: f64 = floor(x);
    if (f < x) { return f + 1.0; }
    return f;
}

// Multiply x by 2^k without bit manipulation.
fn ldexp(x: f64, k: i32) f64 {
    let r: f64 = x;
    let n: i32 = k;
    while (n > 0) { r = r * 2.0; n = n - 1; }
    while (n < 0) { r = r * 0.5; n = n + 1; }
    return r;
}

// sqrt: x < 0 returns NaN; sqrt(0) = 0. Range-reduce by powers of four, then
// Newton iteration from a value in [0.25, 4).
fn sqrt(x: f64) f64 {
    if (x != x) { return x; }
    if (x < 0.0) { let z: f64 = 0.0; return z / z; }
    if (x == 0.0) { return 0.0; }
    let m: f64 = x;
    let scale: f64 = 1.0;
    let guard: i32 = 0;
    while (m >= 4.0) { m = m * 0.25; scale = scale * 2.0; guard = guard + 1; if (guard > 1100) { return x; } }
    while (m < 0.25) { m = m * 4.0; scale = scale * 0.5; }
    let g: f64 = 1.0;
    let i: i32 = 0;
    while (i < 8) { g = 0.5 * (g + m / g); i = i + 1; }
    return g * scale;
}

// exp: overflows to +inf above ~709.78, underflows to 0 below ~-745.
fn exp(x: f64) f64 {
    if (x != x) { return x; }
    if (x > 709.782712893384) { let z: f64 = 0.0; return 1.0 / z; }
    if (x < -745.1332191019411) { return 0.0; }
    // x = k*ln2 + r, |r| <= ln2/2
    let kf: f64 = floor(x / ln2() + 0.5);
    let r: f64 = x - kf * ln2();
    let term: f64 = 1.0;
    let sum: f64 = 1.0;
    let n: i32 = 1;
    while (n < 24) { term = term * r / (n as f64); sum = sum + term; n = n + 1; }
    return ldexp(sum, kf as i32);
}

// Natural logarithm: ln(0) = -inf, ln(x<0) = NaN.
fn ln(x: f64) f64 {
    if (x != x) { return x; }
    if (x < 0.0) { let z: f64 = 0.0; return z / z; }
    if (x == 0.0) { let z: f64 = 0.0; return -1.0 / z; }
    let m: f64 = x;
    let k: i32 = 0;
    while (m >= 2.0) { m = m * 0.5; k = k + 1; if (k > 2000) { return x; } }
    while (m < 1.0) { m = m * 2.0; k = k - 1; }
    // m in [1, 2): use sqrt(2) centring so |s| <= 0.1716
    if (m > 1.4142135623730951) { m = m * 0.5; k = k + 1; }
    let s: f64 = (m - 1.0) / (m + 1.0);
    let s2: f64 = s * s;
    let term: f64 = s;
    let sum: f64 = 0.0;
    let n: i32 = 1;
    while (n < 60) { sum = sum + term / (n as f64); term = term * s2; n = n + 2; }
    return 2.0 * sum + (k as f64) * ln2();
}

fn log2(x: f64) f64 { return ln(x) / ln2(); }
fn log10(x: f64) f64 { return ln(x) / 2.302585092994046; }

// pow for x > 0 (any real y), or integral y for any x.
fn pow(x: f64, y: f64) f64 {
    if (y == 0.0) { return 1.0; }
    let yi: f64 = floor(y);
    if (yi == y && abs(y) < 1.0e9) {
        let n: i64 = y as i64;
        let neg: bool = n < 0;
        if (neg) { n = 0 - n; }
        let base: f64 = x;
        let r: f64 = 1.0;
        while (n > 0) {
            if (n % 2 == 1) { r = r * base; }
            base = base * base;
            n = n / 2;
        }
        if (neg) { return 1.0 / r; }
        return r;
    }
    if (x < 0.0) { let z: f64 = 0.0; return z / z; }
    if (x == 0.0) { return 0.0; }
    return exp(y * ln(x));
}

fn tanh(x: f64) f64 {
    if (x > 20.0) { return 1.0; }
    if (x < -20.0) { return -1.0; }
    let e2: f64 = exp(2.0 * x);
    return (e2 - 1.0) / (e2 + 1.0);
}

fn sigmoid(x: f64) f64 {
    if (x >= 0.0) { return 1.0 / (1.0 + exp(0.0 - x)); }
    let ex: f64 = exp(x);
    return ex / (1.0 + ex);
}

// sin/cos with reduction to [-pi, pi]; accurate for |x| < ~1e9.
fn sin(x: f64) f64 {
    let tp: f64 = 2.0 * pi();
    let r: f64 = x - tp * floor(x / tp + 0.5);
    let r2: f64 = r * r;
    let term: f64 = r;
    let sum: f64 = r;
    let n: i32 = 1;
    while (n < 15) {
        term = 0.0 - term * r2 / (((2 * n) * (2 * n + 1)) as f64);
        sum = sum + term;
        n = n + 1;
    }
    return sum;
}

fn cos(x: f64) f64 { return sin(x + 0.5 * pi()); }
