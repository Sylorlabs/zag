@import("list.zag")
@import("checksum.zag")

enum ZlibStoreError {
    none,
    input_limit,
    truncated,
    unsupported_header,
    unsupported_block,
    length_mismatch,
    checksum_mismatch,
    trailing_data,
}

struct ZlibStoreEncodeResult {
    bytes: ArrayList[u8],
    error: ZlibStoreError,
}

struct ZlibStoreDecodeResult {
    bytes: ArrayList[u8],
    error: ZlibStoreError,
    error_offset: i64,
}

fn zlib_store_input_limit() i64 { return 268435456; }

fn zlib_store_push_u32_be(bytes: *ArrayList[u8], value: i64) void {
    push[u8](bytes, ((value >> 24) & 255) as u8);
    push[u8](bytes, ((value >> 16) & 255) as u8);
    push[u8](bytes, ((value >> 8) & 255) as u8);
    push[u8](bytes, (value & 255) as u8);
}

fn zlib_store_read_u32_be(bytes: []u8, offset: i32) i64 {
    return ((bytes[offset] as i64) << 24) |
        ((bytes[offset + 1] as i64) << 16) |
        ((bytes[offset + 2] as i64) << 8) |
        (bytes[offset + 3] as i64);
}

fn zlib_store_encode(input: []u8) ZlibStoreEncodeResult {
    if ((input.len as i64) > zlib_store_input_limit()) {
        return ZlibStoreEncodeResult{
            .bytes = make[u8](1), .error = ZlibStoreError.input_limit,
        };
    }
    let blocks: i64 = 1;
    if (input.len > 0) {
        blocks = ((input.len as i64) + 65534) / 65535;
    }
    let capacity: i64 = 2 + input.len as i64 + blocks * 5 + 4;
    let bytes: ArrayList[u8] = make[u8](capacity as i32);
    push[u8](&bytes, 120);
    push[u8](&bytes, 1);
    let offset: i32 = 0;
    let wrote_block: i32 = 0;
    while (offset < input.len || wrote_block == 0) {
        let remaining: i32 = input.len - offset;
        let length: i32 = remaining;
        if (length > 65535) { length = 65535; }
        let final_block: i32 = (offset + length == input.len) as i32;
        push[u8](&bytes, final_block as u8);
        push[u8](&bytes, (length & 255) as u8);
        push[u8](&bytes, ((length >> 8) & 255) as u8);
        let inverted: i32 = length ^ 65535;
        push[u8](&bytes, (inverted & 255) as u8);
        push[u8](&bytes, ((inverted >> 8) & 255) as u8);
        let i: i32 = 0;
        while (i < length) {
            push[u8](&bytes, input[offset + i]);
            i = i + 1;
        }
        offset = offset + length;
        wrote_block = 1;
    }
    zlib_store_push_u32_be(&bytes, checksum_adler32(input));
    return ZlibStoreEncodeResult{ .bytes = bytes, .error = ZlibStoreError.none };
}

fn zlib_store_encode_free(result: *ZlibStoreEncodeResult) void {
    free[u8](&result.*.bytes);
}

fn zlib_store_decode_fail(bytes: ArrayList[u8], error: ZlibStoreError,
    offset: i64) ZlibStoreDecodeResult {
    return ZlibStoreDecodeResult{
        .bytes = bytes, .error = error, .error_offset = offset,
    };
}

fn zlib_store_decode(input: []u8) ZlibStoreDecodeResult {
    let bytes: ArrayList[u8] = make[u8](64);
    if (input.len < 2) {
        return zlib_store_decode_fail(bytes, ZlibStoreError.truncated, input.len as i64);
    }
    if (input[0] != 120 || input[1] != 1) {
        return zlib_store_decode_fail(bytes, ZlibStoreError.unsupported_header, 0);
    }
    let offset: i32 = 2;
    let final_block: i32 = 0;
    while (final_block == 0) {
        if (offset >= input.len) {
            return zlib_store_decode_fail(bytes, ZlibStoreError.truncated, offset as i64);
        }
        let header: i32 = input[offset] as i32;
        if (header != 0 && header != 1) {
            return zlib_store_decode_fail(bytes, ZlibStoreError.unsupported_block,
                offset as i64);
        }
        final_block = header & 1;
        offset = offset + 1;
        if (offset + 4 > input.len) {
            return zlib_store_decode_fail(bytes, ZlibStoreError.truncated, offset as i64);
        }
        let length: i32 = (input[offset] as i32) |
            ((input[offset + 1] as i32) << 8);
        let inverted: i32 = (input[offset + 2] as i32) |
            ((input[offset + 3] as i32) << 8);
        if ((length ^ inverted) != 65535) {
            return zlib_store_decode_fail(bytes, ZlibStoreError.length_mismatch,
                offset as i64);
        }
        offset = offset + 4;
        if ((bytes.len as i64) + length as i64 > zlib_store_input_limit()) {
            return zlib_store_decode_fail(bytes, ZlibStoreError.input_limit,
                offset as i64);
        }
        if (offset + length > input.len) {
            return zlib_store_decode_fail(bytes, ZlibStoreError.truncated,
                input.len as i64);
        }
        let i: i32 = 0;
        while (i < length) {
            push[u8](&bytes, input[offset + i]);
            i = i + 1;
        }
        offset = offset + length;
    }
    if (offset + 4 > input.len) {
        return zlib_store_decode_fail(bytes, ZlibStoreError.truncated, input.len as i64);
    }
    let stored_adler: i64 = zlib_store_read_u32_be(input, offset);
    if (stored_adler != checksum_adler32(bytes.data[0..bytes.len])) {
        return zlib_store_decode_fail(bytes, ZlibStoreError.checksum_mismatch,
            offset as i64);
    }
    offset = offset + 4;
    if (offset != input.len) {
        return zlib_store_decode_fail(bytes, ZlibStoreError.trailing_data,
            offset as i64);
    }
    return ZlibStoreDecodeResult{
        .bytes = bytes, .error = ZlibStoreError.none, .error_offset = 0 - 1,
    };
}

fn zlib_store_decode_free(result: *ZlibStoreDecodeResult) void {
    free[u8](&result.*.bytes);
}
