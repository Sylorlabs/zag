// std/opengl_loader.zag — public OpenGL compatibility runtime.
//
// The implementation lives in opengl_runtime.zag so the loader name remains
// stable for existing programs while the executable adapter stays easy to
// audit.  It creates an EGL surfaceless OpenGL 4.3 context, compiles GLSL,
// dispatches one bounded SSBO workload, fences/reads it back, and cleans up.
@import("opengl_runtime.zag")
