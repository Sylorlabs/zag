// Thin Linux loadable-kernel-module adapter boundary for std:driver.
// Kbuild and the kernel own final linking and acquisition; no C driver logic
// or host userspace fallback is hidden in this module.

@import("std:driver") as driver
@import("std:driver_linux") as linux

pub struct LinuxKernelAdapter {
    target: i32,
    kernel_series: i32,
    qemu: i32,
    module_object: i32,
}

pub fn adapter(target: i32, series: i32, qemu: i32,
               module_object: i32) LinuxKernelAdapter {
    return LinuxKernelAdapter{ .target = target, .kernel_series = series,
        .qemu = qemu, .module_object = module_object };
}

pub fn adapter_contract_valid(adapter: @borrows *LinuxKernelAdapter) i32 {
    let supported: linux.LinuxSupport = linux.linux_support(
        adapter.*.target, adapter.*.kernel_series, 0, 0,
        adapter.*.qemu, adapter.*.module_object);
    // `LinuxSupport` capability bits are all zero for an unsupported row, so
    // comparing those zeroes with a caller-provided zero must not authorize
    // an unknown target or kernel series.
    return (linux.linux_target_supported(adapter.*.target) != 0 &&
        linux.linux_kernel_series_supported(adapter.*.kernel_series) != 0 &&
        supported.qemu != 0 && supported.physical_device == 0 &&
        adapter.*.module_object != 0) as i32;
}

pub fn load(adapter: @borrows *LinuxKernelAdapter) driver.DriverStatus @driver_init {
    if (adapter_contract_valid(adapter) == 0) {
        return driver.DriverStatus{ .code = driver.driver_invalid_argument(), .detail = 0 };
    }
    return driver.DriverStatus{ .code = driver.driver_unsupported(), .detail = adapter.*.target as i64 };
}

pub fn unload(adapter: @borrows *LinuxKernelAdapter) driver.DriverStatus @driver_teardown {
    if (adapter_contract_valid(adapter) == 0) {
        return driver.DriverStatus{ .code = driver.driver_invalid_argument(), .detail = 0 };
    }
    return driver.DriverStatus{ .code = driver.driver_unsupported(), .detail = adapter.*.kernel_series as i64 };
}
