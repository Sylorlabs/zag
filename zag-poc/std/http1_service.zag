// std/http1_service.zag -- bounded one-message TCP receive adapter.
//
// This correctness-oriented adapter reads one byte per bounded net_ipv4 call
// until http1's allocation-free prefix probe proves the exact message length.
// That avoids over-reading a following message and demonstrates a real stream
// service without changing net_ipv4's exact-read contract.  It is deliberately
// not a high-throughput server loop or an async scheduler.

@import("http1.zag") as http
@import("net_ipv4.zag") as net
@import("list.zag") as list

struct Http1ReceiveResult {
    ok: i32,
    code: i64,
    calls: i32,
    value: http.Http1Buffer,
}

fn http1_receive_failure(code: i64, calls: i32) Http1ReceiveResult {
    return Http1ReceiveResult{
        .ok = 0, .code = code, .calls = calls,
        .value = http.http1_empty_buffer(),
    };
}

fn http1_receive_take(result: *Http1ReceiveResult) http.Http1Buffer {
    if (result.*.ok == 0 || result.*.value.open == 0) {
        return http.http1_empty_buffer();
    }
    let value: http.Http1Buffer = result.*.value;
    result.*.value = http.http1_empty_buffer();
    result.*.ok = 0;
    result.*.code = http.http1_status_invalid_state();
    return value;
}

fn http1_receive_message_bounded(stream: *net.NetTcpStream,
                                 limits: http.Http1Limits,
                                 max_receive_calls: i32) Http1ReceiveResult {
    if (http.http1_limits_valid(limits) == 0 || max_receive_calls < 1 ||
        max_receive_calls > limits.max_message_bytes) {
        return http1_receive_failure(http.http1_status_invalid_argument(), 0);
    }
    let bytes: list.ArrayList[u8] = list.make[u8](limits.max_message_bytes);
    let calls: i32 = 0;
    while (calls < max_receive_calls && bytes.len < limits.max_message_bytes) {
        let receive: net.NetIoResult = net.net_tcp_recv_exact_bounded(
            stream, bytes.data[bytes.len..bytes.len + 1], 1, 1, 4, 1
        );
        calls = calls + receive.calls;
        if (receive.ok == 0) {
            list.free[u8](&bytes);
            return http1_receive_failure(receive.code, calls);
        }
        bytes.len = bytes.len + 1;
        let probe: http.Http1MessageProbe = http.http1_probe_message_bounded(
            bytes.data[0..bytes.len], limits
        );
        if (probe.ok != 0 && probe.complete != 0) {
            return Http1ReceiveResult{
                .ok = 1, .code = http.http1_status_ok(), .calls = calls,
                .value = http.Http1Buffer{ .bytes = bytes, .open = 1 },
            };
        }
        if (probe.ok == 0) {
            list.free[u8](&bytes);
            return http1_receive_failure(probe.code, calls);
        }
    }
    list.free[u8](&bytes);
    return http1_receive_failure(http.http1_status_limit(), calls);
}

fn http1_receive_message(stream: *net.NetTcpStream) Http1ReceiveResult {
    let limits: http.Http1Limits = http.http1_default_limits();
    return http1_receive_message_bounded(stream, limits, limits.max_message_bytes);
}
