// std/linux_epoll.zag -- bounded Linux x86-64 epoll and eventfd foundation.
//
// This module talks to the kernel directly.  It owns descriptors explicitly,
// limits one wait to at most 64 events and 5 seconds, and uses take helpers to
// invalidate successful constructor results.  The eventfd is nonblocking, so
// an empty consume reports a stable library status instead of sleeping.
//
// Resource values are move-by-convention until Zag has noncopyable structs.
// Do not copy an open LinuxEpoll or LinuxEventFd.  This is not a scheduler,
// async/await runtime, cancellation system, portable poller, or proof that an
// arbitrary descriptor protocol is race-free.

@import("rt.zag")

struct LinuxEpoll {
    fd: i64,
    open: i32,
    registrations: i32,
}

struct LinuxEventFd {
    fd: i64,
    open: i32,
}

struct LinuxEpollResult {
    ok: i32,
    code: i64,
    value: LinuxEpoll,
}

struct LinuxEventFdResult {
    ok: i32,
    code: i64,
    value: LinuxEventFd,
}

struct LinuxEpollEvent {
    events: i64,
    token: i64,
}

struct LinuxEpollWaitResult {
    ok: i32,
    code: i64,
    count: i32,
    wait_calls: i32,
    elapsed_ms: i64,
}

struct LinuxEventFdReadResult {
    ok: i32,
    code: i64,
    value: u64,
}

// Linux x86-64's epoll_event is packed to 12 bytes.  Two words let us encode
// the packed bytes explicitly without depending on Zag aggregate padding.
struct LinuxEpollKernelEvent {
    word0: u64,
    word1: u64,
}

fn linux_epoll_status_ok() i64 { return 0; }
fn linux_epoll_status_invalid_argument() i64 { return 0 - 7301; }
fn linux_epoll_status_invalid_state() i64 { return 0 - 7302; }
fn linux_epoll_status_limit() i64 { return 0 - 7303; }
fn linux_epoll_status_empty() i64 { return 0 - 7304; }

fn linux_epoll_readable() i64 { return 1; }

fn linux_epoll_invalid() LinuxEpoll {
    return LinuxEpoll{ .fd = 0 - 1, .open = 0, .registrations = 0 };
}

fn linux_eventfd_invalid() LinuxEventFd {
    return LinuxEventFd{ .fd = 0 - 1, .open = 0 };
}

fn linux_epoll_create() LinuxEpollResult {
    // epoll_create1(EPOLL_CLOEXEC)
    let fd: i64 = _zag_raw_syscall(291, 524288, 0, 0, 0, 0, 0);
    if (fd < 0) {
        return LinuxEpollResult{
            .ok = 0, .code = fd, .value = linux_epoll_invalid(),
        };
    }
    return LinuxEpollResult{
        .ok = 1, .code = linux_epoll_status_ok(),
        .value = LinuxEpoll{ .fd = fd, .open = 1, .registrations = 0 },
    };
}

fn linux_eventfd_create(initial: i64) LinuxEventFdResult {
    if (initial < 0 || initial > 4294967295) {
        return LinuxEventFdResult{
            .ok = 0, .code = linux_epoll_status_invalid_argument(),
            .value = linux_eventfd_invalid(),
        };
    }
    // eventfd2(EFD_NONBLOCK | EFD_CLOEXEC)
    let fd: i64 = _zag_raw_syscall(290, initial, 526336, 0, 0, 0, 0);
    if (fd < 0) {
        return LinuxEventFdResult{
            .ok = 0, .code = fd, .value = linux_eventfd_invalid(),
        };
    }
    return LinuxEventFdResult{
        .ok = 1, .code = linux_epoll_status_ok(),
        .value = LinuxEventFd{ .fd = fd, .open = 1 },
    };
}

fn linux_epoll_take(result: *LinuxEpollResult) LinuxEpoll {
    if (result == null as *LinuxEpollResult || result.*.ok == 0 ||
        result.*.value.open == 0) {
        return linux_epoll_invalid();
    }
    let value: LinuxEpoll = result.*.value;
    result.*.ok = 0;
    result.*.code = linux_epoll_status_invalid_state();
    result.*.value = linux_epoll_invalid();
    return value;
}

fn linux_eventfd_take(result: *LinuxEventFdResult) LinuxEventFd {
    if (result == null as *LinuxEventFdResult || result.*.ok == 0 ||
        result.*.value.open == 0) {
        return linux_eventfd_invalid();
    }
    let value: LinuxEventFd = result.*.value;
    result.*.ok = 0;
    result.*.code = linux_epoll_status_invalid_state();
    result.*.value = linux_eventfd_invalid();
    return value;
}

fn linux_epoll_close(poller: *LinuxEpoll) i64 {
    if (poller == null as *LinuxEpoll || poller.*.open == 0 ||
        poller.*.fd < 0) {
        return linux_epoll_status_invalid_state();
    }
    let fd: i64 = poller.*.fd;
    poller.*.fd = 0 - 1;
    poller.*.open = 0;
    poller.*.registrations = 0;
    return _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
}

fn linux_eventfd_close(event: *LinuxEventFd) i64 {
    if (event == null as *LinuxEventFd || event.*.open == 0 ||
        event.*.fd < 0) {
        return linux_epoll_status_invalid_state();
    }
    let fd: i64 = event.*.fd;
    event.*.fd = 0 - 1;
    event.*.open = 0;
    return _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
}

fn linux_epoll_kernel_event(events: i64, token: i64)
    LinuxEpollKernelEvent {
    let data: u64 = token as u64;
    return LinuxEpollKernelEvent{
        .word0 = (events as u64) | ((data & 4294967295) << 32),
        .word1 = data >> 32,
    };
}

fn linux_epoll_raw_u32(raw: *u8, offset: i32) u64 {
    return (raw[offset] as u64) |
        ((raw[offset + 1] as u64) << 8) |
        ((raw[offset + 2] as u64) << 16) |
        ((raw[offset + 3] as u64) << 24);
}

fn linux_epoll_raw_u64(raw: *u8, offset: i32) u64 {
    return linux_epoll_raw_u32(raw, offset) |
        (linux_epoll_raw_u32(raw, offset + 4) << 32);
}

fn linux_epoll_add_eventfd(poller: *LinuxEpoll, event: *LinuxEventFd,
                           token: i64) i64 {
    if (poller == null as *LinuxEpoll || event == null as *LinuxEventFd ||
        poller.*.open == 0 || event.*.open == 0 || poller.*.fd < 0 ||
        event.*.fd < 0) {
        return linux_epoll_status_invalid_state();
    }
    if (token <= 0) { return linux_epoll_status_invalid_argument(); }
    if (poller.*.registrations >= 64) { return linux_epoll_status_limit(); }
    let kernel_event: LinuxEpollKernelEvent =
        linux_epoll_kernel_event(linux_epoll_readable(), token);
    let rc: i64 = _zag_raw_syscall(
        233, poller.*.fd, 1, event.*.fd, (&kernel_event) as i64, 0, 0
    );
    if (rc == 0) { poller.*.registrations = poller.*.registrations + 1; }
    return rc;
}

fn linux_epoll_remove_eventfd(poller: *LinuxEpoll,
                              event: *LinuxEventFd) i64 {
    if (poller == null as *LinuxEpoll || event == null as *LinuxEventFd ||
        poller.*.open == 0 || event.*.open == 0 || poller.*.fd < 0 ||
        event.*.fd < 0) {
        return linux_epoll_status_invalid_state();
    }
    if (poller.*.registrations <= 0) {
        return linux_epoll_status_invalid_state();
    }
    let rc: i64 = _zag_raw_syscall(
        233, poller.*.fd, 2, event.*.fd, 0, 0, 0
    );
    if (rc == 0) { poller.*.registrations = poller.*.registrations - 1; }
    return rc;
}

fn linux_eventfd_signal(event: *LinuxEventFd, value: i64) i64 {
    if (event == null as *LinuxEventFd || event.*.open == 0 ||
        event.*.fd < 0) {
        return linux_epoll_status_invalid_state();
    }
    if (value <= 0) { return linux_epoll_status_invalid_argument(); }
    let word: u64 = value as u64;
    let rc: i64 = _zag_raw_syscall(
        1, event.*.fd, (&word) as i64, 8, 0, 0, 0
    );
    if (rc == 8) { return linux_epoll_status_ok(); }
    if (rc >= 0) { return linux_epoll_status_limit(); }
    return rc;
}

fn linux_eventfd_consume(event: *LinuxEventFd) LinuxEventFdReadResult {
    if (event == null as *LinuxEventFd || event.*.open == 0 ||
        event.*.fd < 0) {
        return LinuxEventFdReadResult{
            .ok = 0, .code = linux_epoll_status_invalid_state(), .value = 0,
        };
    }
    let word: u64 = 0;
    let rc: i64 = _zag_raw_syscall(
        0, event.*.fd, (&word) as i64, 8, 0, 0, 0
    );
    if (rc == 8) {
        return LinuxEventFdReadResult{
            .ok = 1, .code = linux_epoll_status_ok(), .value = word,
        };
    }
    if (rc == 0 - 11) {
        return LinuxEventFdReadResult{
            .ok = 0, .code = linux_epoll_status_empty(), .value = 0,
        };
    }
    if (rc >= 0) { rc = linux_epoll_status_limit(); }
    return LinuxEventFdReadResult{ .ok = 0, .code = rc, .value = 0 };
}

fn linux_epoll_wait(poller: *LinuxEpoll, events: *LinuxEpollEvent,
                    max_events: i32, timeout_ms: i32)
    LinuxEpollWaitResult {
    let start: i64 = _zag_clock_monotonic_ms();
    if (poller == null as *LinuxEpoll || poller.*.open == 0 ||
        poller.*.fd < 0) {
        return LinuxEpollWaitResult{
            .ok = 0, .code = linux_epoll_status_invalid_state(), .count = 0,
            .wait_calls = 0, .elapsed_ms = 0,
        };
    }
    if (events == null as *LinuxEpollEvent || max_events < 1 ||
        max_events > 64 || timeout_ms < 0 || timeout_ms > 5000) {
        return LinuxEpollWaitResult{
            .ok = 0, .code = linux_epoll_status_invalid_argument(), .count = 0,
            .wait_calls = 0, .elapsed_ms = 0,
        };
    }
    let raw_address: i64 = _zag_raw_syscall(9, 0, 4096, 3, 34, 0 - 1, 0);
    if (raw_address < 0) {
        return LinuxEpollWaitResult{
            .ok = 0, .code = raw_address, .count = 0,
            .wait_calls = 0, .elapsed_ms = 0,
        };
    }
    let raw: *u8 = raw_address as *u8;
    let rc: i64 = _zag_raw_syscall(
        232, poller.*.fd, raw_address, max_events, timeout_ms, 0, 0
    );
    let elapsed: i64 = _zag_clock_monotonic_ms() - start;
    if (rc >= 0 && rc <= max_events) {
        let i: i32 = 0;
        while (i < rc as i32) {
            let offset: i32 = i * 12;
            events[i] = LinuxEpollEvent{
                .events = linux_epoll_raw_u32(raw, offset) as i64,
                .token = linux_epoll_raw_u64(raw, offset + 4) as i64,
            };
            i = i + 1;
        }
    }
    let unmap_rc: i64 = _zag_raw_syscall(
        11, raw_address, 4096, 0, 0, 0, 0
    );
    if (rc < 0) {
        return LinuxEpollWaitResult{
            .ok = 0, .code = rc, .count = 0,
            .wait_calls = 1, .elapsed_ms = elapsed,
        };
    }
    if (rc > max_events || unmap_rc < 0) {
        let code: i64 = linux_epoll_status_limit();
        if (unmap_rc < 0) { code = unmap_rc; }
        return LinuxEpollWaitResult{
            .ok = 0, .code = code, .count = 0,
            .wait_calls = 1, .elapsed_ms = elapsed,
        };
    }
    return LinuxEpollWaitResult{
        .ok = 1, .code = linux_epoll_status_ok(), .count = rc as i32,
        .wait_calls = 1, .elapsed_ms = elapsed,
    };
}
