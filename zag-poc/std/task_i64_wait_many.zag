// Bounded typed wait-many transport for Linux/x86-64 TaskI64 handles.
//
// The set stores raw handle address words so the operation can observe up to
// eight disjoint affine tasks without borrowing pointer fields into an output
// record. It never consumes a handle: callers must still await every task
// exactly once. This is a bounded result collector, not a generic future,
// scheduler, destructor, or portable async runtime.

@import("std:task_i64") as task

struct TaskI64WaitManySet {
    h0: i64,
    h1: i64,
    h2: i64,
    h3: i64,
    h4: i64,
    h5: i64,
    h6: i64,
    h7: i64,
    count: i32,
}

struct TaskI64WaitManyResult {
    ok: i32,
    code: i64,
    state: i32,
    completed: i32,
    ready_mask: i32,
    cancellation_mask: i32,
    value0: i64,
    value1: i64,
    value2: i64,
    value3: i64,
    value4: i64,
    value5: i64,
    value6: i64,
    value7: i64,
}

fn task_i64_wait_many_status_ok() i64 { return 0; }
fn task_i64_wait_many_status_invalid_set() i64 { return 0 - 7741; }
fn task_i64_wait_many_status_invalid_timeout() i64 { return 0 - 7742; }
fn task_i64_wait_many_status_invalid_output() i64 { return 0 - 7743; }

fn task_i64_wait_many_address(set:@borrows *TaskI64WaitManySet,
    index:i32) i64 {
    unsafe {
        if (index == 0) { return set.*.h0; }
        if (index == 1) { return set.*.h1; }
        if (index == 2) { return set.*.h2; }
        if (index == 3) { return set.*.h3; }
        if (index == 4) { return set.*.h4; }
        if (index == 5) { return set.*.h5; }
        if (index == 6) { return set.*.h6; }
        if (index == 7) { return set.*.h7; }
        return 0;
    }
}

fn task_i64_wait_many_valid(set:@borrows *TaskI64WaitManySet) i32 {
    unsafe {
        if (set == null as *TaskI64WaitManySet || set.*.count < 1 ||
            set.*.count > 8) { return 0; }
    }
    let i:i32 = 0;
    while (i < set.*.count) {
        let address:i64 = task_i64_wait_many_address(set, i);
        let handle:*opaque;
        unsafe { handle = address as *opaque; }
        if (task.task_i64_valid(handle) == 0) { return 0; }
        let j:i32 = 0;
        while (j < i) {
            if (address == task_i64_wait_many_address(set, j)) { return 0; }
            j = j + 1;
        }
        i = i + 1;
    }
    return 1;
}

fn task_i64_wait_many_set_value(out:@borrows_mut *TaskI64WaitManyResult,
    index:i32, value:i64) void {
    if (index == 0) { out.*.value0 = value; }
    if (index == 1) { out.*.value1 = value; }
    if (index == 2) { out.*.value2 = value; }
    if (index == 3) { out.*.value3 = value; }
    if (index == 4) { out.*.value4 = value; }
    if (index == 5) { out.*.value5 = value; }
    if (index == 6) { out.*.value6 = value; }
    if (index == 7) { out.*.value7 = value; }
}

fn task_i64_wait_many_scan(set:@borrows *TaskI64WaitManySet,
    out:@borrows_mut *TaskI64WaitManyResult) i32 {
    let i:i32 = 0;
    while (i < set.*.count) {
        let address:i64 = task_i64_wait_many_address(set, i);
        let handle:*opaque;
        unsafe { handle = address as *opaque; }
        let observed:task.TaskI64PollResult = task.task_i64_poll(handle);
        if (observed.cancellation_requested == 1) {
            out.*.cancellation_mask = out.*.cancellation_mask | (1 << i);
        }
        if (observed.state == task.task_i64_poll_ready() &&
            (out.*.ready_mask & (1 << i)) == 0) {
            out.*.ready_mask = out.*.ready_mask | (1 << i);
            task_i64_wait_many_set_value(out, i, observed.value);
            out.*.completed = out.*.completed + 1;
        }
        i = i + 1;
    }
    return out.*.completed;
}

fn task_i64_wait_many(set:@borrows *TaskI64WaitManySet,
    timeout_ms:i32, out:@borrows_mut *TaskI64WaitManyResult) i64 {
    if (out == null as *TaskI64WaitManyResult) {
        return task_i64_wait_many_status_invalid_output();
    }
    if (task_i64_wait_many_valid(set) == 0) {
        out.*.ok = 0; out.*.code = task_i64_wait_many_status_invalid_set();
        out.*.state = task.task_i64_poll_invalid(); out.*.completed = 0;
        out.*.ready_mask = 0; out.*.cancellation_mask = 0;
        return task_i64_wait_many_status_invalid_set();
    }
    if (timeout_ms < 0 || timeout_ms > 5000) {
        out.*.ok = 0; out.*.code = task_i64_wait_many_status_invalid_timeout();
        out.*.state = task.task_i64_poll_invalid(); out.*.completed = 0;
        out.*.ready_mask = 0; out.*.cancellation_mask = 0;
        return task_i64_wait_many_status_invalid_timeout();
    }
    out.*.ok = 1; out.*.code = task_i64_wait_many_status_ok();
    out.*.state = task.task_i64_poll_pending(); out.*.completed = 0;
    out.*.ready_mask = 0; out.*.cancellation_mask = 0;
    out.*.value0 = 0; out.*.value1 = 0; out.*.value2 = 0; out.*.value3 = 0;
    out.*.value4 = 0; out.*.value5 = 0; out.*.value6 = 0; out.*.value7 = 0;
    let completed:i32 = task_i64_wait_many_scan(set, out);
    if (completed == set.*.count || timeout_ms == 0) {
        if (completed == set.*.count) { out.*.state = task.task_i64_poll_ready(); }
        return task_i64_wait_many_status_ok();
    }
    let started:i64 = _zag_clock_monotonic_ms();
    let elapsed:i64 = 0;
    while (elapsed < timeout_ms as i64) {
        unsafe {
            let _yielded:i64 = _zag_raw_syscall(24, 0, 0, 0, 0, 0, 0);
        }
        let next:i32 = task_i64_wait_many_scan(set, out);
        if (next == set.*.count) {
            out.*.state = task.task_i64_poll_ready();
            return task_i64_wait_many_status_ok();
        }
        elapsed = _zag_clock_monotonic_ms() - started;
        if (elapsed < 0) { elapsed = 0; }
    }
    task_i64_wait_many_scan(set, out);
    if (out.*.completed == set.*.count) {
        out.*.state = task.task_i64_poll_ready();
    }
    return task_i64_wait_many_status_ok();
}
