// std/cancel_token_i64.zag -- bounded cooperative cancellation primitive.
//
// A token is caller-owned storage containing one release/acquire i64 flag.
// It is one-shot: request changes 0 to 1, and a worker cooperatively polls the
// token. There is deliberately no reset, destructor, scheduler, or implicit
// cancellation propagation. The caller must keep the word and token alive
// until every worker has joined.

struct CancelTokenI64 {
    word: *i64,
    open: i32,
}

fn cancel_token_i64_ok() i64 { return 0; }
fn cancel_token_i64_invalid_argument() i64 { return 0 - 7601; }
fn cancel_token_i64_invalid_state() i64 { return 0 - 7602; }
fn cancel_token_i64_requested() i64 { return 1; }

fn cancel_token_i64_invalid() CancelTokenI64 {
    return CancelTokenI64{.word = null as *i64, .open = 0};
}

// Initialize a token over caller-owned, suitably aligned i64 storage. The
// release store publishes the initial state before a worker receives its
// address.
fn cancel_token_i64_init(destination: *CancelTokenI64, word: *i64) i64 {
    if (destination == null as *CancelTokenI64 || word == null as *i64) {
        return cancel_token_i64_invalid_argument();
    }
    if (destination.*.open != 0 || destination.*.word != null as *i64) {
        return cancel_token_i64_invalid_state();
    }
    unsafe {
        @atomicStore64Order(word as *mut i64, 0, 2);
    }
    destination.*.word = word;
    destination.*.open = 1;
    return cancel_token_i64_ok();
}

fn cancel_token_i64_valid(token: *CancelTokenI64) i32 {
    if (token == null as *CancelTokenI64 || token.*.open == 0 ||
        token.*.word == null as *i64) { return 0; }
    return 1;
}

// Request is idempotent. Release ordering ensures caller-side writes sequenced
// before the request are visible to an acquiring worker that observes state 1.
fn cancel_token_i64_request(token: *CancelTokenI64) i64 {
    if (cancel_token_i64_valid(token) == 0) {
        return cancel_token_i64_invalid_state();
    }
    unsafe {
        @atomicStore64Order(token.*.word as *mut i64,
            cancel_token_i64_requested(), 2);
    }
    return cancel_token_i64_ok();
}

fn cancel_token_i64_is_requested(token: *CancelTokenI64) i32 {
    if (cancel_token_i64_valid(token) == 0) { return 0 - 1; }
    unsafe {
        return (@atomicLoad64Order(token.*.word as *const i64, 1) != 0) as i32;
    }
}

// Invalidate after all workers have joined. The word remains caller-owned and
// is not freed by this helper.
fn cancel_token_i64_close(token: *CancelTokenI64) i64 {
    if (cancel_token_i64_valid(token) == 0) {
        return cancel_token_i64_invalid_state();
    }
    token.*.word = null as *i64;
    token.*.open = 0;
    return cancel_token_i64_ok();
}
