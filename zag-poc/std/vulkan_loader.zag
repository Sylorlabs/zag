// std/vulkan_loader.zag — public Vulkan compatibility runtime.
//
// The implementation lives in vulkan_runtime.zag so the loader name remains
// stable for existing programs while the executable adapter stays easy to
// audit.  It performs a bounded compute dispatch through the system Vulkan
// loader: instance/device selection, pipeline and descriptor setup, fence
// wait, mapped readback, and complete per-dispatch cleanup.  Native direct
// AMDGPU DRM remains a separate opt-in backend.
@import("vulkan_runtime.zag")
