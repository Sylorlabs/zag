// std/csv.zag — bounded CSV parser, encoder, and table utilities.
//
//   @import("std:csv") as csv
//   let result: csv.CsvTable = csv.csv_parse("a,b\nx,y");
//   let rows: i32 = csv.csv_row_count(result);
//
// Fields are byte slices: the codec preserves bytes and does not claim a text
// encoding. Quoted fields accept commas, CR/LF, and doubled quotes. Unquoted
// quotes and bytes after a closing quote are rejected. The default encoder uses
// CRLF record separators and quotes only when required.
//
// Effects: parser and table constructors use Alloc+Panic via _zag_malloc/_zag_realloc;
// element operations are pure. Use csv_free/csv_encode_result_free when done.

@import("list.zag")
@import("rt.zag")

struct CsvRow {
    cells: ArrayList[[]u8],
}

struct CsvTable {
    rows: ArrayList[CsvRow],
    ok: i32,
}

struct CsvEncodeResult {
    ok: i32,
    value: []u8,
}

fn csv_default_max_bytes() i32 { return 1048576; }
fn csv_default_max_rows() i32 { return 65536; }
fn csv_default_max_cells() i32 { return 262144; }
fn csv_default_max_field_bytes() i32 { return 1048576; }
fn csv_default_max_output_bytes() i32 { return 4194304; }

fn csv_row_new() CsvRow {
    return CsvRow{ .cells = make[[]u8](4) };
}

fn csv_append_cell(row: *CsvRow, cell: []u8) void {
    push[[]u8](&row.*.cells, cell);
}

fn csv_row_cell_count(row: CsvRow) i32 {
    return row.cells.len;
}

fn csv_row_get(row: CsvRow, col: i32) []u8 {
    return get[[]u8](row.cells, col);
}

fn csv_row_free(row: *CsvRow) void {
    let i: i32 = 0;
    while (i < row.*.cells.len) {
        let cell: []u8 = row.*.cells.data[i];
        _zag_free(_zag_slice_ptr(cell));
        i = i + 1;
    }
    free[[]u8](&row.*.cells);
}

fn csv_table_new() CsvTable {
    return CsvTable{ .rows = make[CsvRow](4), .ok = 1 };
}

fn csv_copy_slice(src: []u8, start: i32, end: i32) []u8 {
    let n: i32 = end - start;
    let cap: i32 = n;
    if (cap < 1) { cap = 1; }
    let out: ArrayList[u8] = make[u8](cap);
    let i: i32 = start;
    while (i < end) {
        push[u8](&out, src[i]);
        i = i + 1;
    }
    return out.data[0..out.len];
}

fn csv_parse_unquoted(src: []u8, start: i32, next: *i32) []u8 {
    let i: i32 = start;
    let n: i32 = src.len;
    while (i < n) {
        let c: u8 = src[i];
        if (c == 44 || c == 10 || c == 13) {
            next.* = i;
            return csv_copy_slice(src, start, i);
        }
        if (c == 34) {
            next.* = i;
            return csv_copy_slice(src, start, i);
        }
        i = i + 1;
    }
    next.* = n;
    return csv_copy_slice(src, start, n);
}

fn csv_parse_unquoted_bounded(src: []u8, start: i32, next: *i32,
                              ok: *i32, max_field_bytes: i32) []u8 {
    let i: i32 = start;
    while (i < src.len) {
        let c: u8 = src[i];
        if (c == 44 || c == 10 || c == 13) {
            next.* = i; return csv_copy_slice(src, start, i);
        }
        if (c == 34 || i - start >= max_field_bytes) {
            ok.* = 0; next.* = i; return csv_copy_slice(src, start, start);
        }
        i = i + 1;
    }
    next.* = src.len;
    return csv_copy_slice(src, start, src.len);
}

fn csv_parse_quoted(src: []u8, start: i32, next: *i32, ok: *i32) []u8 {
    let i: i32 = start + 1; // skip opening quote
    let out: ArrayList[u8] = make[u8](8);
    let n: i32 = src.len;
    let j: i32 = i;
    while (j < n) {
        let c: u8 = src[j];
        if (c == 34) {
            if (j + 1 < n && src[j + 1] == 34) {
                push[u8](&out, 34);
                j = j + 2;
                continue;
            }
            // Closing quote found. RFC-style fields end immediately at a
            // delimiter or record boundary; trailing spaces are data and must
            // therefore have appeared before the quote or in an unquoted cell.
            let k: i32 = j + 1;
            if (k < n && src[k] != 44 && src[k] != 10 && src[k] != 13) {
                ok.* = 0;
            }
            next.* = k;
            return out.data[0..out.len];
        }
        push[u8](&out, c);
        j = j + 1;
    }
    ok.* = 0;
    next.* = n;
    return out.data[0..out.len];
}

fn csv_parse_quoted_bounded(src: []u8, start: i32, next: *i32,
                            ok: *i32, max_field_bytes: i32) []u8 {
    let out: ArrayList[u8] = make[u8](8);
    let j: i32 = start + 1;
    while (j < src.len) {
        let c: u8 = src[j];
        if (c == 34) {
            if (j + 1 < src.len && src[j + 1] == 34) {
                if (out.len >= max_field_bytes) { ok.* = 0; next.* = j; return out.data[0..out.len]; }
                push[u8](&out, 34); j = j + 2; continue;
            }
            let k: i32 = j + 1;
            if (k < src.len && src[k] != 44 && src[k] != 10 && src[k] != 13) { ok.* = 0; }
            next.* = k; return out.data[0..out.len];
        }
        if (out.len >= max_field_bytes) { ok.* = 0; next.* = j; return out.data[0..out.len]; }
        push[u8](&out, c); j = j + 1;
    }
    ok.* = 0; next.* = src.len;
    return out.data[0..out.len];
}

fn csv_parse_cell(src: []u8, start: i32, next: *i32, ok: *i32) []u8 {
    if (start >= src.len) {
        next.* = src.len;
        return "";
    }
    if (src[start] == 34) {
        return csv_parse_quoted(src, start, next, ok);
    }
    return csv_parse_unquoted(src, start, next);
}

fn csv_parse_cell_bounded(src: []u8, start: i32, next: *i32, ok: *i32,
                          max_field_bytes: i32) []u8 {
    if (start >= src.len) { next.* = src.len; return ""; }
    if (src[start] == 34) {
        return csv_parse_quoted_bounded(src, start, next, ok, max_field_bytes);
    }
    return csv_parse_unquoted_bounded(src, start, next, ok, max_field_bytes);
}

fn csv_push_row(table: *CsvTable, row: CsvRow) void {
    if (row.cells.len == 0) {
        csv_row_free(&row);
        return;
    }
    push[CsvRow](&table.*.rows, row);
}

fn csv_push_row_bounded(table: *CsvTable, row: CsvRow, max_rows: i32) i32 {
    if (row.cells.len == 0) { csv_row_free(&row); return 1; }
    if (table.*.rows.len >= max_rows) { csv_row_free(&row); table.*.ok = 0; return 0; }
    push[CsvRow](&table.*.rows, row);
    return 1;
}

fn csv_parse_bounded(src: []u8, max_bytes: i32, max_rows: i32,
                     max_cells: i32, max_field_bytes: i32) CsvTable {
    let n: i32 = src.len;
    let i: i32 = 0;
    let row: CsvRow = csv_row_new();
    let table: CsvTable = csv_table_new();
    let total_cells: i32 = 0;
    if (max_bytes < 0 || max_rows < 1 || max_cells < 1 || max_field_bytes < 0 ||
        n > max_bytes) {
        table.ok = 0; csv_row_free(&row); return table;
    }
    while (i <= n) {
        if (i == n) {
            // A final comma denotes one final empty field. Empty input remains
            // a zero-row table; a blank physical line is handled below.
            if (n > 0 && src[n - 1] == 44) {
                if (total_cells >= max_cells) { table.ok = 0; }
                else {
                    let empty: []u8 = csv_copy_slice(src, n, n);
                    csv_append_cell(&row, empty); total_cells = total_cells + 1;
                }
            }
            csv_push_row_bounded(&table, row, max_rows);
            break;
        }
        if (total_cells >= max_cells) {
            table.ok = 0; csv_push_row_bounded(&table, row, max_rows); break;
        }
        let next: i32 = i;
        let next_start: *i32 = &next;
        let cell: []u8 = csv_parse_cell_bounded(src, i, next_start, &table.ok,
                                                max_field_bytes);
        csv_append_cell(&row, cell);
        total_cells = total_cells + 1;
        if (cell.len > max_field_bytes) { table.ok = 0; }
        let sep: i32 = next_start.*;
        if (sep >= n || table.ok == 0) {
            csv_push_row_bounded(&table, row, max_rows);
            break;
        }
        let c: u8 = src[sep];
        if (c == 44) {
            i = sep + 1;
            continue;
        }
        if (c == 10) {
            if (csv_push_row_bounded(&table, row, max_rows) == 0) { break; }
            row = csv_row_new();
            i = sep + 1;
            continue;
        }
        if (c == 13) {
            if (sep + 1 < n && src[sep + 1] == 10) {
                if (csv_push_row_bounded(&table, row, max_rows) == 0) { break; }
                row = csv_row_new();
                i = sep + 2;
                continue;
            }
            if (csv_push_row_bounded(&table, row, max_rows) == 0) { break; }
            row = csv_row_new();
            i = sep + 1;
            continue;
        }
        // Unexpected separator; best-effort parse and reject row shape.
        table.ok = 0;
        csv_push_row_bounded(&table, row, max_rows);
        break;
    }
    return table;
}

fn csv_parse(src: []u8) CsvTable {
    return csv_parse_bounded(src, csv_default_max_bytes(), csv_default_max_rows(),
        csv_default_max_cells(), csv_default_max_field_bytes());
}

fn csv_row_count(table: CsvTable) i32 {
    return table.rows.len;
}

fn csv_cell_count(table: CsvTable, row: i32) i32 {
    let row_values: CsvRow = get[CsvRow](table.rows, row);
    return row_values.cells.len;
}

fn csv_col_count(table: CsvTable) i32 {
    let c: i32 = 0;
    let i: i32 = 0;
    while (i < table.rows.len) {
        let row_cell_count: i32 = get[CsvRow](table.rows, i).cells.len;
        if (row_cell_count > c) {
            c = row_cell_count;
        }
        i = i + 1;
    }
    return c;
}

fn csv_get(table: CsvTable, row: i32, col: i32) []u8 {
    let cells: CsvRow = get[CsvRow](table.rows, row);
    return get[[]u8](cells.cells, col);
}

fn csv_encode_byte(out: *ArrayList[u8], value: u8, max_bytes: i32) i32 {
    if (out.*.len >= max_bytes) { return 0; }
    push[u8](out, value); return 1;
}

fn csv_encode_field(out: *ArrayList[u8], field: []u8, max_bytes: i32) i32 {
    let quoted: i32 = 0;
    let i: i32 = 0;
    while (i < field.len) {
        if (field[i] == 44 || field[i] == 34 || field[i] == 10 || field[i] == 13) { quoted = 1; }
        i = i + 1;
    }
    if (quoted == 0) {
        if (field.len > max_bytes - out.*.len) { return 0; }
        i = 0; while (i < field.len) { push[u8](out, field[i]); i = i + 1; }
        return 1;
    }
    if (csv_encode_byte(out, 34, max_bytes) == 0) { return 0; }
    i = 0;
    while (i < field.len) {
        if (field[i] == 34 && csv_encode_byte(out, 34, max_bytes) == 0) { return 0; }
        if (csv_encode_byte(out, field[i], max_bytes) == 0) { return 0; }
        i = i + 1;
    }
    return csv_encode_byte(out, 34, max_bytes);
}

fn csv_encode_bounded(table: CsvTable, max_bytes: i32, crlf: i32) CsvEncodeResult {
    if (table.ok == 0 || max_bytes < 0 || (crlf != 0 && crlf != 1)) {
        return CsvEncodeResult{ .ok = 0, .value = "" };
    }
    let out: ArrayList[u8] = make[u8](64);
    let ri: i32 = 0;
    while (ri < table.rows.len) {
        if (ri > 0) {
            if (crlf == 1 && csv_encode_byte(&out, 13, max_bytes) == 0) {
                free[u8](&out); return CsvEncodeResult{ .ok = 0, .value = "" };
            }
            if (csv_encode_byte(&out, 10, max_bytes) == 0) {
                free[u8](&out); return CsvEncodeResult{ .ok = 0, .value = "" };
            }
        }
        let row: CsvRow = table.rows.data[ri];
        let ci: i32 = 0;
        while (ci < row.cells.len) {
            if (ci > 0 && csv_encode_byte(&out, 44, max_bytes) == 0) {
                free[u8](&out); return CsvEncodeResult{ .ok = 0, .value = "" };
            }
            if (csv_encode_field(&out, row.cells.data[ci], max_bytes) == 0) {
                free[u8](&out); return CsvEncodeResult{ .ok = 0, .value = "" };
            }
            ci = ci + 1;
        }
        ri = ri + 1;
    }
    return CsvEncodeResult{ .ok = 1, .value = out.data[0..out.len] };
}

fn csv_encode(table: CsvTable) CsvEncodeResult {
    return csv_encode_bounded(table, csv_default_max_output_bytes(), 1);
}

fn csv_encode_lf(table: CsvTable) CsvEncodeResult {
    return csv_encode_bounded(table, csv_default_max_output_bytes(), 0);
}

fn csv_encode_result_free(result: *CsvEncodeResult) void {
    if (result.*.ok == 1) { _zag_free(_zag_slice_ptr(result.*.value)); }
    result.*.ok = 0; result.*.value = "";
}

fn csv_free(table: *CsvTable) void {
    let ri: i32 = 0;
    while (ri < table.*.rows.len) {
        let row: CsvRow = table.*.rows.data[ri];
        csv_row_free(&row);
        ri = ri + 1;
    }
    free[CsvRow](&table.*.rows);
    table.*.rows.data = null as *CsvRow;
    table.*.rows.len = 0;
    table.*.rows.cap = 0;
    table.*.ok = 1;
}
