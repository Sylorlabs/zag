// std/utf8.zag -- strict allocation-free UTF-8 validation and scalar codecs.
//
// Strings remain byte slices. These routines reject overlong encodings,
// surrogate code points, values above U+10FFFF, stray continuations, invalid
// lead bytes, and truncation. Encoding writes only after all arguments pass.

struct Utf8Decode {
    status: i64,
    scalar: i64,
    width: i32,
    next_index: i32,
}

struct Utf8Validation {
    status: i64,
    scalar_count: i32,
    error_offset: i32,
}

struct Utf8Iterator {
    bytes: []u8,
    index: i32,
    emitted: i32,
    max_scalars: i32,
    status: i64,
}

struct Utf8Encode {
    status: i64,
    width: i32,
    next_index: i32,
}

// A bounded NFC projection for the common Latin combining marks used by the
// compact Script profile.  The API is deliberately caller-buffer based: it
// never hides allocation or pretends to implement the complete Unicode
// normalization tables.  Unknown combining marks are preserved bytewise, and
// callers can distinguish a successful bounded projection from the remaining
// Unicode-version work through `changed` and the explicit status.
struct Utf8Normalize {
    status: i64,
    written: i32,
    scalar_count: i32,
    changed: i32,
    error_offset: i32,
}

// Bounded extended-grapheme view. Strings remain UTF-8 byte slices and this
// iterator never allocates or normalizes. The classifier below covers the
// stable cluster seams used by the Script profile: combining/variation marks,
// emoji modifiers and ZWJ sequences, regional-indicator pairs, Hangul syllable
// composition, Prepend/SpacingMark subsets, and CRLF. Unknown scalars remain
// ordinary cluster bases; full Unicode-version normalization and the complete
// GraphemeBreakProperty table are intentionally outside this bounded API.
struct Utf8Grapheme {
    status: i64,
    start_index: i32,
    next_index: i32,
    scalar_count: i32,
}

struct Utf8GraphemeCount {
    status: i64,
    cluster_count: i32,
    error_offset: i32,
}

fn utf8_status_ready() i64 { return 0; }
fn utf8_status_item() i64 { return 1; }
fn utf8_status_exhausted() i64 { return 2; }
fn utf8_status_limit() i64 { return 3; }
fn utf8_status_invalid_argument() i64 { return 0 - 8101; }
fn utf8_status_malformed() i64 { return 0 - 8102; }
fn utf8_status_truncated() i64 { return 0 - 8103; }
fn utf8_status_output_too_small() i64 { return 0 - 8104; }
fn utf8_status_invalid_scalar() i64 { return 0 - 8105; }

fn utf8_is_continuation(byte: i32) bool {
    return byte >= 128 && byte <= 191;
}

fn utf8_decode_error(status: i64, index: i32) Utf8Decode {
    return Utf8Decode{
        .status = status,
        .scalar = 0,
        .width = 0,
        .next_index = index,
    };
}

fn utf8_decode_at(bytes: []u8, index: i32) Utf8Decode @borrows {
    if (index < 0 || index > bytes.len) {
        return utf8_decode_error(utf8_status_invalid_argument(), index);
    }
    if (index == bytes.len) {
        return utf8_decode_error(utf8_status_exhausted(), index);
    }

    let b0: i32 = bytes[index] as i32;
    if (b0 <= 127) {
        return Utf8Decode{
            .status = utf8_status_item(),
            .scalar = b0 as i64,
            .width = 1,
            .next_index = index + 1,
        };
    }

    if (b0 >= 194 && b0 <= 223) {
        if (index > bytes.len - 2) {
            return utf8_decode_error(utf8_status_truncated(), index);
        }
        let b1: i32 = bytes[index + 1] as i32;
        if (!utf8_is_continuation(b1)) {
            return utf8_decode_error(utf8_status_malformed(), index);
        }
        return Utf8Decode{
            .status = utf8_status_item(),
            .scalar = (((b0 & 31) * 64) + (b1 & 63)) as i64,
            .width = 2,
            .next_index = index + 2,
        };
    }

    if (b0 >= 224 && b0 <= 239) {
        if (index > bytes.len - 3) {
            return utf8_decode_error(utf8_status_truncated(), index);
        }
        let b1: i32 = bytes[index + 1] as i32;
        let b2: i32 = bytes[index + 2] as i32;
        if (!utf8_is_continuation(b1) || !utf8_is_continuation(b2)) {
            return utf8_decode_error(utf8_status_malformed(), index);
        }
        if ((b0 == 224 && b1 < 160) || (b0 == 237 && b1 > 159)) {
            return utf8_decode_error(utf8_status_malformed(), index);
        }
        return Utf8Decode{
            .status = utf8_status_item(),
            .scalar = (((b0 & 15) * 4096) + ((b1 & 63) * 64) +
                       (b2 & 63)) as i64,
            .width = 3,
            .next_index = index + 3,
        };
    }

    if (b0 >= 240 && b0 <= 244) {
        if (index > bytes.len - 4) {
            return utf8_decode_error(utf8_status_truncated(), index);
        }
        let b1: i32 = bytes[index + 1] as i32;
        let b2: i32 = bytes[index + 2] as i32;
        let b3: i32 = bytes[index + 3] as i32;
        if (!utf8_is_continuation(b1) || !utf8_is_continuation(b2) ||
            !utf8_is_continuation(b3)) {
            return utf8_decode_error(utf8_status_malformed(), index);
        }
        if ((b0 == 240 && b1 < 144) || (b0 == 244 && b1 > 143)) {
            return utf8_decode_error(utf8_status_malformed(), index);
        }
        return Utf8Decode{
            .status = utf8_status_item(),
            .scalar = (((b0 & 7) * 262144) + ((b1 & 63) * 4096) +
                       ((b2 & 63) * 64) + (b3 & 63)) as i64,
            .width = 4,
            .next_index = index + 4,
        };
    }
    return utf8_decode_error(utf8_status_malformed(), index);
}

fn utf8_iterator_bounded(bytes: []u8, max_scalars: i32) Utf8Iterator @borrows {
    let status: i64 = utf8_status_ready();
    if (max_scalars < 0) { status = utf8_status_invalid_argument(); }
    if (status == utf8_status_ready() && bytes.len == 0) {
        status = utf8_status_exhausted();
    }
    return Utf8Iterator{
        .bytes = bytes,
        .index = 0,
        .emitted = 0,
        .max_scalars = max_scalars,
        .status = status,
    };
}

fn utf8_iterator(bytes: []u8) Utf8Iterator @borrows {
    // A valid non-empty scalar consumes at least one byte, so byte length is a
    // complete upper bound and cannot produce a false limit.
    let status: i64 = utf8_status_ready();
    if (bytes.len == 0) { status = utf8_status_exhausted(); }
    return Utf8Iterator{
        .bytes = bytes,
        .index = 0,
        .emitted = 0,
        .max_scalars = bytes.len,
        .status = status,
    };
}

fn utf8_next(iterator: *Utf8Iterator) Utf8Decode @borrows_mut {
    if (iterator.*.status != utf8_status_ready()) {
        return utf8_decode_error(iterator.*.status, iterator.*.index);
    }
    if (iterator.*.index >= iterator.*.bytes.len) {
        iterator.*.status = utf8_status_exhausted();
        return utf8_decode_error(utf8_status_exhausted(), iterator.*.index);
    }
    if (iterator.*.emitted >= iterator.*.max_scalars) {
        iterator.*.status = utf8_status_limit();
        return utf8_decode_error(utf8_status_limit(), iterator.*.index);
    }
    let decoded: Utf8Decode = utf8_decode_at(iterator.*.bytes, iterator.*.index);
    if (decoded.status != utf8_status_item()) {
        iterator.*.status = decoded.status;
        return decoded;
    }
    iterator.*.index = decoded.next_index;
    iterator.*.emitted = iterator.*.emitted + 1;
    return decoded;
}

// Stateless scalar-indexed access for callers that need a particular Unicode
// scalar without retaining an iterator. The index counts decoded scalar
// values, not bytes; malformed input before the requested value is returned at
// its byte offset. This remains allocation-free and bounded by scalar_index+1
// decode steps, with the same explicit statuses as utf8_next().
fn utf8_scalar_at(bytes: []u8, scalar_index: i32) Utf8Decode @borrows {
    if (scalar_index < 0) {
        return utf8_decode_error(utf8_status_invalid_argument(), scalar_index);
    }
    let iterator: Utf8Iterator = utf8_iterator(bytes);
    let i: i32 = 0;
    while (i <= scalar_index) {
        let decoded: Utf8Decode = utf8_next(&iterator);
        if (decoded.status != utf8_status_item() || i == scalar_index) {
            return decoded;
        }
        i = i + 1;
    }
    return utf8_decode_error(utf8_status_invalid_argument(), scalar_index);
}

fn utf8_validate_bounded(bytes: []u8, max_scalars: i32) Utf8Validation @borrows {
    let iterator: Utf8Iterator = Utf8Iterator{
        .bytes = bytes,
        .index = 0,
        .emitted = 0,
        .max_scalars = max_scalars,
        .status = utf8_status_ready(),
    };
    if (max_scalars < 0) { iterator.status = utf8_status_invalid_argument(); }
    if (iterator.status == utf8_status_ready() && bytes.len == 0) {
        iterator.status = utf8_status_exhausted();
    }
    if (iterator.status != utf8_status_ready() &&
        iterator.status != utf8_status_exhausted()) {
        return Utf8Validation{
            .status = iterator.status,
            .scalar_count = 0,
            .error_offset = 0,
        };
    }
    while (iterator.status == utf8_status_ready()) {
        let decoded: Utf8Decode = utf8_next(&iterator);
        if (decoded.status != utf8_status_item()) {
            if (decoded.status == utf8_status_exhausted()) { break; }
            return Utf8Validation{
                .status = decoded.status,
                .scalar_count = iterator.emitted,
                .error_offset = iterator.index,
            };
        }
    }
    return Utf8Validation{
        .status = iterator.status,
        .scalar_count = iterator.emitted,
        .error_offset = iterator.index,
    };
}

fn utf8_validate(bytes: []u8) Utf8Validation @borrows {
    let iterator: Utf8Iterator = Utf8Iterator{
        .bytes = bytes,
        .index = 0,
        .emitted = 0,
        .max_scalars = bytes.len,
        .status = utf8_status_ready(),
    };
    if (iterator.status == utf8_status_ready() && bytes.len == 0) {
        iterator.status = utf8_status_exhausted();
    }
    if (iterator.status != utf8_status_ready() &&
        iterator.status != utf8_status_exhausted()) {
        return Utf8Validation{
            .status = iterator.status,
            .scalar_count = 0,
            .error_offset = 0,
        };
    }
    while (iterator.status == utf8_status_ready()) {
        let decoded: Utf8Decode = utf8_next(&iterator);
        if (decoded.status != utf8_status_item()) {
            if (decoded.status == utf8_status_exhausted()) { break; }
            return Utf8Validation{
                .status = decoded.status,
                .scalar_count = iterator.emitted,
                .error_offset = iterator.index,
            };
        }
    }
    return Utf8Validation{
        .status = iterator.status,
        .scalar_count = iterator.emitted,
        .error_offset = iterator.index,
    };
}

fn utf8_is_valid(bytes: []u8) bool @borrows {
    return utf8_validate(bytes).status == utf8_status_exhausted();
}

fn utf8_grapheme_class(scalar: i64) i32 {
    // CR, LF, and the C0/C1 control ranges have their own break behavior.
    if (scalar == 13) { return 1; }
    if (scalar == 10) { return 2; }
    if ((scalar >= 0 && scalar <= 31) || (scalar >= 127 && scalar <= 159)) { return 3; }
    // Combining marks, variation selectors, and emoji skin-tone modifiers.
    if ((scalar >= 768 && scalar <= 879) ||
        (scalar >= 6832 && scalar <= 6911) ||
        (scalar >= 7424 && scalar <= 7615) ||
        (scalar >= 8400 && scalar <= 8431) ||
        (scalar >= 65056 && scalar <= 65071) ||
        (scalar >= 917760 && scalar <= 917999) ||
        (scalar >= 127995 && scalar <= 127999)) { return 4; }
    if (scalar == 8205) { return 5; } // ZERO WIDTH JOINER
    if (scalar >= 127462 && scalar <= 127487) { return 6; } // RI
    // A bounded Prepend subset. Keep this list exact; classifying an entire
    // script block as Prepend would incorrectly merge unrelated base letters.
    if ((scalar >= 1536 && scalar <= 1541) || scalar == 1757 || scalar == 1807 ||
        (scalar >= 2192 && scalar <= 2193) || scalar == 2274 || scalar == 3406 ||
        scalar == 69565 || scalar == 69837 ||
        (scalar >= 70082 && scalar <= 70083) || scalar == 70087 ||
        scalar == 70200 || (scalar >= 70340 && scalar <= 70345) ||
        scalar == 73030) { return 7; }
    // Common Indic SpacingMark ranges used by the bounded Script examples.
    if ((scalar >= 2366 && scalar <= 2368) || (scalar >= 2377 && scalar <= 2380) ||
        (scalar >= 2494 && scalar <= 2496) || (scalar >= 2503 && scalar <= 2504) ||
        (scalar >= 2507 && scalar <= 2508) || (scalar >= 2750 && scalar <= 2752) ||
        scalar == 2761 || (scalar >= 2763 && scalar <= 2764) ||
        (scalar >= 2878 && scalar <= 2880) || (scalar >= 2887 && scalar <= 2888) ||
        (scalar >= 2891 && scalar <= 2892) || (scalar >= 3006 && scalar <= 3007) ||
        (scalar >= 3009 && scalar <= 3010) || (scalar >= 3014 && scalar <= 3016) ||
        (scalar >= 3018 && scalar <= 3020) || (scalar >= 3134 && scalar <= 3136) ||
        (scalar >= 3142 && scalar <= 3144) || (scalar >= 3146 && scalar <= 3148)) { return 8; }
    // Hangul Jamo and precomposed syllables (UAX #29 GB6-GB8).
    if ((scalar >= 4352 && scalar <= 4447) ||
        (scalar >= 43360 && scalar <= 43388)) { return 9; } // L
    if ((scalar >= 4448 && scalar <= 4519) ||
        (scalar >= 55216 && scalar <= 55238)) { return 10; } // V
    if ((scalar >= 4520 && scalar <= 4607) ||
        (scalar >= 55243 && scalar <= 55291)) { return 11; } // T
    if (scalar >= 44032 && scalar <= 55203) {
        if (((scalar - 44032) % 28) == 0) { return 12; } // LV
        return 13; // LVT
    }
    return 0;
}

fn utf8_grapheme_hangul_join(previous: i32, current: i32) i32 {
    if (previous == 9 && (current == 9 || current == 10 || current == 12)) { return 1; }
    if ((previous == 10 || previous == 12) && (current == 10 || current == 11)) { return 1; }
    if ((previous == 11 || previous == 13) && current == 11) { return 1; }
    return 0;
}

fn utf8_grapheme_should_join(previous: i32, current: i32, regional_run: i32) i32 {
    if (previous == 1 && current == 2) { return 1; } // CRLF
    if (previous == 1 || previous == 2 || previous == 3 ||
        current == 1 || current == 2 || current == 3) { return 0; }
    if (current == 4 || current == 5 || current == 8 || previous == 5 || previous == 7) { return 1; }
    if (utf8_grapheme_hangul_join(previous, current) == 1) { return 1; }
    if (previous == 6 && current == 6 && (regional_run % 2) == 1) { return 1; }
    return 0;
}

fn utf8_grapheme_at(bytes: @borrows []u8, index: i32) Utf8Grapheme {
    if (index < 0 || index > bytes.len) {
        return Utf8Grapheme{.status = utf8_status_invalid_argument(), .start_index = index,
            .next_index = index, .scalar_count = 0};
    }
    if (index == bytes.len) {
        return Utf8Grapheme{.status = utf8_status_exhausted(), .start_index = index,
            .next_index = index, .scalar_count = 0};
    }
    let first: Utf8Decode = utf8_decode_at(bytes, index);
    if (first.status != utf8_status_item()) {
        return Utf8Grapheme{.status = first.status, .start_index = index,
            .next_index = first.next_index, .scalar_count = 0};
    }
    let cursor: i32 = first.next_index;
    let count: i32 = 1;
    let previous: i32 = utf8_grapheme_class(first.scalar);
    let regional_run: i32 = (previous == 6) as i32;
    let done: i32 = 0;
    while (cursor < bytes.len && done == 0) {
        let next: Utf8Decode = utf8_decode_at(bytes, cursor);
        if (next.status != utf8_status_item()) {
            return Utf8Grapheme{.status = next.status, .start_index = index,
                .next_index = cursor, .scalar_count = 0};
        }
        let current: i32 = utf8_grapheme_class(next.scalar);
        if (utf8_grapheme_should_join(previous, current, regional_run) == 0) {
            done = 1;
        } else {
            cursor = next.next_index;
            count = count + 1;
            if (current == 6) { regional_run = regional_run + 1; }
            else if (current != 4 && current != 5) { regional_run = 0; }
            previous = current;
        }
    }
    return Utf8Grapheme{.status = utf8_status_item(), .start_index = index,
        .next_index = cursor, .scalar_count = count};
}

fn utf8_grapheme_count_bounded(bytes: @borrows []u8, max_clusters: i32) Utf8GraphemeCount {
    if (max_clusters < 0) {
        return Utf8GraphemeCount{.status = utf8_status_invalid_argument(), .cluster_count = 0, .error_offset = 0};
    }
    if (bytes.len == 0) {
        return Utf8GraphemeCount{.status = utf8_status_exhausted(), .cluster_count = 0, .error_offset = 0};
    }
    let index: i32 = 0;
    let clusters: i32 = 0;
    while (index < bytes.len && clusters < max_clusters) {
        let item: Utf8Grapheme = utf8_grapheme_at(bytes, index);
        if (item.status != utf8_status_item()) {
            return Utf8GraphemeCount{.status = item.status, .cluster_count = clusters, .error_offset = item.next_index};
        }
        index = item.next_index;
        clusters = clusters + 1;
    }
    if (index < bytes.len) {
        return Utf8GraphemeCount{.status = utf8_status_limit(), .cluster_count = clusters, .error_offset = index};
    }
    return Utf8GraphemeCount{.status = utf8_status_exhausted(), .cluster_count = clusters, .error_offset = index};
}

fn utf8_grapheme_count(bytes: @borrows []u8) Utf8GraphemeCount {
    // Keep the unbounded convenience self-contained.  Besides avoiding an
    // unnecessary wrapper call, this preserves the exact borrowed-slice
    // contract through older module-qualified call resolution paths.
    if (bytes.len == 0) {
        return Utf8GraphemeCount{.status = utf8_status_exhausted(), .cluster_count = 0, .error_offset = 0};
    }
    let index: i32 = 0;
    let clusters: i32 = 0;
    while (index < bytes.len) {
        let item: Utf8Grapheme = utf8_grapheme_at(bytes, index);
        if (item.status != utf8_status_item()) {
            return Utf8GraphemeCount{.status = item.status, .cluster_count = clusters, .error_offset = item.next_index};
        }
        index = item.next_index;
        clusters = clusters + 1;
    }
    return Utf8GraphemeCount{.status = utf8_status_exhausted(), .cluster_count = clusters, .error_offset = index};
}

fn utf8_encoded_width(scalar: i64) i32 {
    if (scalar < 0 || scalar > 1114111 ||
        (scalar >= 55296 && scalar <= 57343)) { return 0; }
    if (scalar <= 127) { return 1; }
    if (scalar <= 2047) { return 2; }
    if (scalar <= 65535) { return 3; }
    return 4;
}

fn utf8_encode_at(output: []u8, index: i32, scalar: i64) Utf8Encode @borrows_mut {
    if (index < 0 || index > output.len) {
        return Utf8Encode{
            .status = utf8_status_invalid_argument(),
            .width = 0,
            .next_index = index,
        };
    }
    let width: i32 = utf8_encoded_width(scalar);
    if (width == 0) {
        return Utf8Encode{
            .status = utf8_status_invalid_scalar(),
            .width = 0,
            .next_index = index,
        };
    }
    if (index > output.len - width) {
        return Utf8Encode{
            .status = utf8_status_output_too_small(),
            .width = 0,
            .next_index = index,
        };
    }

    if (width == 1) {
        output[index] = scalar as u8;
    } else if (width == 2) {
        output[index] = (192 + (scalar / 64)) as u8;
        output[index + 1] = (128 + (scalar % 64)) as u8;
    } else if (width == 3) {
        output[index] = (224 + (scalar / 4096)) as u8;
        output[index + 1] = (128 + ((scalar / 64) % 64)) as u8;
        output[index + 2] = (128 + (scalar % 64)) as u8;
    } else {
        output[index] = (240 + (scalar / 262144)) as u8;
        output[index + 1] = (128 + ((scalar / 4096) % 64)) as u8;
        output[index + 2] = (128 + ((scalar / 64) % 64)) as u8;
        output[index + 3] = (128 + (scalar % 64)) as u8;
    }
    return Utf8Encode{
        .status = utf8_status_item(),
        .width = width,
        .next_index = index + width,
    };
}

// Return a precomposed scalar for one supported canonical combining pair, or
// -1 when the pair is outside this bounded table.  The table intentionally
// covers the common acute, grave, diaeresis, tilde, cedilla, and ring forms;
// it is not a claim of complete Unicode NFC coverage.
fn utf8_nfc_compose(base: i64, mark: i64) i64 {
    if (mark == 769) { // COMBINING ACUTE ACCENT
        if (base == 65) { return 193; } if (base == 67) { return 262; }
        if (base == 69) { return 201; } if (base == 73) { return 205; }
        if (base == 76) { return 313; } if (base == 78) { return 323; }
        if (base == 79) { return 211; } if (base == 82) { return 340; }
        if (base == 83) { return 346; }
        if (base == 85) { return 218; } if (base == 89) { return 221; }
        if (base == 97) { return 225; } if (base == 99) { return 263; }
        if (base == 101) { return 233; } if (base == 105) { return 237; }
        if (base == 108) { return 314; } if (base == 110) { return 324; }
        if (base == 111) { return 243; } if (base == 114) { return 341; }
        if (base == 115) { return 347; } if (base == 117) { return 250; }
        if (base == 121) { return 253; }
    }
    if (mark == 768) { // COMBINING GRAVE ACCENT
        if (base == 65) { return 192; } if (base == 69) { return 200; }
        if (base == 73) { return 204; } if (base == 79) { return 210; }
        if (base == 85) { return 217; } if (base == 97) { return 224; }
        if (base == 101) { return 232; } if (base == 105) { return 236; }
        if (base == 111) { return 242; } if (base == 117) { return 249; }
    }
    if (mark == 776) { // COMBINING DIAERESIS
        if (base == 65) { return 196; } if (base == 69) { return 203; }
        if (base == 73) { return 207; } if (base == 79) { return 214; }
        if (base == 85) { return 220; } if (base == 89) { return 376; }
        if (base == 97) { return 228; } if (base == 101) { return 235; }
        if (base == 105) { return 239; } if (base == 111) { return 246; }
        if (base == 117) { return 252; } if (base == 121) { return 255; }
    }
    if (mark == 771) { // COMBINING TILDE
        if (base == 65) { return 195; } if (base == 78) { return 209; }
        if (base == 79) { return 213; } if (base == 97) { return 227; }
        if (base == 110) { return 241; } if (base == 111) { return 245; }
    }
    if (mark == 778) { // COMBINING RING ABOVE
        if (base == 65) { return 197; } if (base == 97) { return 229; }
    }
    if (mark == 807) { // COMBINING CEDILLA
        if (base == 67) { return 199; } if (base == 83) { return 350; }
        if (base == 99) { return 231; } if (base == 115) { return 351; }
    }
    return 0 - 1;
}

fn utf8_nfc_is_supported_mark(scalar: i64) i32 {
    return (scalar == 769 || scalar == 768 || scalar == 776 ||
        scalar == 771 || scalar == 778 || scalar == 807) as i32;
}

fn utf8_normalize_nfc_bounded(input: []u8,
        output: []u8, max_scalars: i32) Utf8Normalize {
    if (max_scalars < 0) {
        return Utf8Normalize{.status = utf8_status_invalid_argument(), .written = 0,
            .scalar_count = 0, .changed = 0, .error_offset = 0};
    }
    if (input.len == 0) {
        return Utf8Normalize{.status = utf8_status_exhausted(), .written = 0,
            .scalar_count = 0, .changed = 0, .error_offset = 0};
    }
    let cursor: i32 = 0;
    let written: i32 = 0;
    let count: i32 = 0;
    let changed: i32 = 0;
    let pending: i64 = 0 - 1;

    // Emit is kept inline in the bounded loop so the output cursor is always
    // checked through the existing scalar encoder before bytes are written.
    while (cursor < input.len) {
        if (count >= max_scalars) {
            return Utf8Normalize{.status = utf8_status_limit(), .written = written,
                .scalar_count = count, .changed = changed, .error_offset = cursor};
        }
        let decoded: Utf8Decode = utf8_decode_at(input, cursor);
        if (decoded.status != utf8_status_item()) {
            return Utf8Normalize{.status = decoded.status, .written = written,
                .scalar_count = count, .changed = changed, .error_offset = cursor};
        }
        cursor = decoded.next_index;
        count = count + 1;
        if (pending < 0) {
            pending = decoded.scalar;
            continue;
        }
        let composed: i64 = utf8_nfc_compose(pending, decoded.scalar);
        if (composed >= 0) {
            pending = composed;
            changed = 1;
            continue;
        }

        let first: Utf8Encode = utf8_encode_at(output, written, pending);
        if (first.status != utf8_status_item()) {
            return Utf8Normalize{.status = first.status, .written = written,
                .scalar_count = count, .changed = changed, .error_offset = cursor};
        }
        written = first.next_index;
        if (utf8_nfc_is_supported_mark(decoded.scalar) == 1) {
            let mark: Utf8Encode = utf8_encode_at(output, written, decoded.scalar);
            if (mark.status != utf8_status_item()) {
                return Utf8Normalize{.status = mark.status, .written = written,
                    .scalar_count = count, .changed = changed, .error_offset = cursor};
            }
            written = mark.next_index;
            pending = 0 - 1;
        } else {
            pending = decoded.scalar;
        }
    }
    if (pending >= 0) {
        let last: Utf8Encode = utf8_encode_at(output, written, pending);
        if (last.status != utf8_status_item()) {
            return Utf8Normalize{.status = last.status, .written = written,
                .scalar_count = count, .changed = changed, .error_offset = input.len};
        }
        written = last.next_index;
    }
    return Utf8Normalize{.status = utf8_status_exhausted(), .written = written,
        .scalar_count = count, .changed = changed, .error_offset = input.len};
}
