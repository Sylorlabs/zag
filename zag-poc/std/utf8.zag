// std/utf8.zag -- strict allocation-free UTF-8 validation and scalar codecs.
//
// Strings remain byte slices. These routines reject overlong encodings,
// surrogate code points, values above U+10FFFF, stray continuations, invalid
// lead bytes, and truncation. Encoding writes only after all arguments pass.

struct Utf8Decode {
    status: i64,
    scalar: i64,
    width: i32,
    next_index: i32,
}

struct Utf8Validation {
    status: i64,
    scalar_count: i32,
    error_offset: i32,
}

struct Utf8Iterator {
    bytes: []u8,
    index: i32,
    emitted: i32,
    max_scalars: i32,
    status: i64,
}

struct Utf8Encode {
    status: i64,
    width: i32,
    next_index: i32,
}

fn utf8_status_ready() i64 { return 0; }
fn utf8_status_item() i64 { return 1; }
fn utf8_status_exhausted() i64 { return 2; }
fn utf8_status_limit() i64 { return 3; }
fn utf8_status_invalid_argument() i64 { return 0 - 8101; }
fn utf8_status_malformed() i64 { return 0 - 8102; }
fn utf8_status_truncated() i64 { return 0 - 8103; }
fn utf8_status_output_too_small() i64 { return 0 - 8104; }
fn utf8_status_invalid_scalar() i64 { return 0 - 8105; }

fn utf8_is_continuation(byte: i32) bool {
    return byte >= 128 && byte <= 191;
}

fn utf8_decode_error(status: i64, index: i32) Utf8Decode {
    return Utf8Decode{
        .status = status,
        .scalar = 0,
        .width = 0,
        .next_index = index,
    };
}

fn utf8_decode_at(bytes: []u8, index: i32) Utf8Decode @borrows {
    if (index < 0 || index > bytes.len) {
        return utf8_decode_error(utf8_status_invalid_argument(), index);
    }
    if (index == bytes.len) {
        return utf8_decode_error(utf8_status_exhausted(), index);
    }

    let b0: i32 = bytes[index] as i32;
    if (b0 <= 127) {
        return Utf8Decode{
            .status = utf8_status_item(),
            .scalar = b0 as i64,
            .width = 1,
            .next_index = index + 1,
        };
    }

    if (b0 >= 194 && b0 <= 223) {
        if (index > bytes.len - 2) {
            return utf8_decode_error(utf8_status_truncated(), index);
        }
        let b1: i32 = bytes[index + 1] as i32;
        if (!utf8_is_continuation(b1)) {
            return utf8_decode_error(utf8_status_malformed(), index);
        }
        return Utf8Decode{
            .status = utf8_status_item(),
            .scalar = (((b0 & 31) * 64) + (b1 & 63)) as i64,
            .width = 2,
            .next_index = index + 2,
        };
    }

    if (b0 >= 224 && b0 <= 239) {
        if (index > bytes.len - 3) {
            return utf8_decode_error(utf8_status_truncated(), index);
        }
        let b1: i32 = bytes[index + 1] as i32;
        let b2: i32 = bytes[index + 2] as i32;
        if (!utf8_is_continuation(b1) || !utf8_is_continuation(b2)) {
            return utf8_decode_error(utf8_status_malformed(), index);
        }
        if ((b0 == 224 && b1 < 160) || (b0 == 237 && b1 > 159)) {
            return utf8_decode_error(utf8_status_malformed(), index);
        }
        return Utf8Decode{
            .status = utf8_status_item(),
            .scalar = (((b0 & 15) * 4096) + ((b1 & 63) * 64) +
                       (b2 & 63)) as i64,
            .width = 3,
            .next_index = index + 3,
        };
    }

    if (b0 >= 240 && b0 <= 244) {
        if (index > bytes.len - 4) {
            return utf8_decode_error(utf8_status_truncated(), index);
        }
        let b1: i32 = bytes[index + 1] as i32;
        let b2: i32 = bytes[index + 2] as i32;
        let b3: i32 = bytes[index + 3] as i32;
        if (!utf8_is_continuation(b1) || !utf8_is_continuation(b2) ||
            !utf8_is_continuation(b3)) {
            return utf8_decode_error(utf8_status_malformed(), index);
        }
        if ((b0 == 240 && b1 < 144) || (b0 == 244 && b1 > 143)) {
            return utf8_decode_error(utf8_status_malformed(), index);
        }
        return Utf8Decode{
            .status = utf8_status_item(),
            .scalar = (((b0 & 7) * 262144) + ((b1 & 63) * 4096) +
                       ((b2 & 63) * 64) + (b3 & 63)) as i64,
            .width = 4,
            .next_index = index + 4,
        };
    }
    return utf8_decode_error(utf8_status_malformed(), index);
}

fn utf8_iterator_bounded(bytes: []u8, max_scalars: i32) Utf8Iterator @borrows {
    let status: i64 = utf8_status_ready();
    if (max_scalars < 0) { status = utf8_status_invalid_argument(); }
    if (status == utf8_status_ready() && bytes.len == 0) {
        status = utf8_status_exhausted();
    }
    return Utf8Iterator{
        .bytes = bytes,
        .index = 0,
        .emitted = 0,
        .max_scalars = max_scalars,
        .status = status,
    };
}

fn utf8_iterator(bytes: []u8) Utf8Iterator @borrows {
    // A valid non-empty scalar consumes at least one byte, so byte length is a
    // complete upper bound and cannot produce a false limit.
    let status: i64 = utf8_status_ready();
    if (bytes.len == 0) { status = utf8_status_exhausted(); }
    return Utf8Iterator{
        .bytes = bytes,
        .index = 0,
        .emitted = 0,
        .max_scalars = bytes.len,
        .status = status,
    };
}

fn utf8_next(iterator: *Utf8Iterator) Utf8Decode @borrows_mut {
    if (iterator.*.status != utf8_status_ready()) {
        return utf8_decode_error(iterator.*.status, iterator.*.index);
    }
    if (iterator.*.index >= iterator.*.bytes.len) {
        iterator.*.status = utf8_status_exhausted();
        return utf8_decode_error(utf8_status_exhausted(), iterator.*.index);
    }
    if (iterator.*.emitted >= iterator.*.max_scalars) {
        iterator.*.status = utf8_status_limit();
        return utf8_decode_error(utf8_status_limit(), iterator.*.index);
    }
    let decoded: Utf8Decode = utf8_decode_at(iterator.*.bytes, iterator.*.index);
    if (decoded.status != utf8_status_item()) {
        iterator.*.status = decoded.status;
        return decoded;
    }
    iterator.*.index = decoded.next_index;
    iterator.*.emitted = iterator.*.emitted + 1;
    return decoded;
}

fn utf8_validate_bounded(bytes: []u8, max_scalars: i32) Utf8Validation @borrows {
    let iterator: Utf8Iterator = Utf8Iterator{
        .bytes = bytes,
        .index = 0,
        .emitted = 0,
        .max_scalars = max_scalars,
        .status = utf8_status_ready(),
    };
    if (max_scalars < 0) { iterator.status = utf8_status_invalid_argument(); }
    if (iterator.status == utf8_status_ready() && bytes.len == 0) {
        iterator.status = utf8_status_exhausted();
    }
    if (iterator.status != utf8_status_ready() &&
        iterator.status != utf8_status_exhausted()) {
        return Utf8Validation{
            .status = iterator.status,
            .scalar_count = 0,
            .error_offset = 0,
        };
    }
    while (iterator.status == utf8_status_ready()) {
        let decoded: Utf8Decode = utf8_next(&iterator);
        if (decoded.status != utf8_status_item()) {
            if (decoded.status == utf8_status_exhausted()) { break; }
            return Utf8Validation{
                .status = decoded.status,
                .scalar_count = iterator.emitted,
                .error_offset = iterator.index,
            };
        }
    }
    return Utf8Validation{
        .status = iterator.status,
        .scalar_count = iterator.emitted,
        .error_offset = iterator.index,
    };
}

fn utf8_validate(bytes: []u8) Utf8Validation @borrows {
    let iterator: Utf8Iterator = Utf8Iterator{
        .bytes = bytes,
        .index = 0,
        .emitted = 0,
        .max_scalars = bytes.len,
        .status = utf8_status_ready(),
    };
    if (iterator.status == utf8_status_ready() && bytes.len == 0) {
        iterator.status = utf8_status_exhausted();
    }
    if (iterator.status != utf8_status_ready() &&
        iterator.status != utf8_status_exhausted()) {
        return Utf8Validation{
            .status = iterator.status,
            .scalar_count = 0,
            .error_offset = 0,
        };
    }
    while (iterator.status == utf8_status_ready()) {
        let decoded: Utf8Decode = utf8_next(&iterator);
        if (decoded.status != utf8_status_item()) {
            if (decoded.status == utf8_status_exhausted()) { break; }
            return Utf8Validation{
                .status = decoded.status,
                .scalar_count = iterator.emitted,
                .error_offset = iterator.index,
            };
        }
    }
    return Utf8Validation{
        .status = iterator.status,
        .scalar_count = iterator.emitted,
        .error_offset = iterator.index,
    };
}

fn utf8_is_valid(bytes: []u8) bool @borrows {
    return utf8_validate(bytes).status == utf8_status_exhausted();
}

fn utf8_encoded_width(scalar: i64) i32 {
    if (scalar < 0 || scalar > 1114111 ||
        (scalar >= 55296 && scalar <= 57343)) { return 0; }
    if (scalar <= 127) { return 1; }
    if (scalar <= 2047) { return 2; }
    if (scalar <= 65535) { return 3; }
    return 4;
}

fn utf8_encode_at(output: []u8, index: i32, scalar: i64) Utf8Encode @borrows_mut {
    if (index < 0 || index > output.len) {
        return Utf8Encode{
            .status = utf8_status_invalid_argument(),
            .width = 0,
            .next_index = index,
        };
    }
    let width: i32 = utf8_encoded_width(scalar);
    if (width == 0) {
        return Utf8Encode{
            .status = utf8_status_invalid_scalar(),
            .width = 0,
            .next_index = index,
        };
    }
    if (index > output.len - width) {
        return Utf8Encode{
            .status = utf8_status_output_too_small(),
            .width = 0,
            .next_index = index,
        };
    }

    if (width == 1) {
        output[index] = scalar as u8;
    } else if (width == 2) {
        output[index] = (192 + (scalar / 64)) as u8;
        output[index + 1] = (128 + (scalar % 64)) as u8;
    } else if (width == 3) {
        output[index] = (224 + (scalar / 4096)) as u8;
        output[index + 1] = (128 + ((scalar / 64) % 64)) as u8;
        output[index + 2] = (128 + (scalar % 64)) as u8;
    } else {
        output[index] = (240 + (scalar / 262144)) as u8;
        output[index + 1] = (128 + ((scalar / 4096) % 64)) as u8;
        output[index + 2] = (128 + ((scalar / 64) % 64)) as u8;
        output[index + 3] = (128 + (scalar % 64)) as u8;
    }
    return Utf8Encode{
        .status = utf8_status_item(),
        .width = width,
        .next_index = index + width,
    };
}
