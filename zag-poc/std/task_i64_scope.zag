// Bounded poll-driven cancellation scope over Linux/x86-64 TaskI64 handles.
//
// A scope owns no handles and never awaits them.  It stores raw address words
// for one parent and up to seven disjoint children, requests child cancellation whenever a poll
// observes the parent cancellation bit, and selects a ready child.  The
// caller keeps the active child address prefix dense while awaiting children,
// then awaits the parent.
// This is explicit poll-driven propagation, not a background scheduler,
// destructor, generic future, or portable async runtime.

@import("std:task_i64") as task
@import("std:task_i64_select") as select

struct TaskI64CancellationScope {
    parent: i64,
    child0: i64,
    child1: i64,
    child2: i64,
    child3: i64,
    child4: i64,
    child5: i64,
    child6: i64,
    count: i32,
}

struct TaskI64ScopeResult {
    ok: i32,
    code: i64,
    index: i32,
    state: i32,
    value: i64,
    parent_cancelled: i32,
    propagated: i32,
    child_cancelled_count: i32,
    cancellation_requested: i32,
}

fn task_i64_scope_status_ok() i64 { return 0; }
fn task_i64_scope_status_invalid_scope() i64 { return 0 - 7731; }
fn task_i64_scope_status_invalid_timeout() i64 { return 0 - 7732; }
fn task_i64_scope_status_cancel_failed() i64 { return 0 - 7733; }

fn task_i64_scope_invalid(code:i64) TaskI64ScopeResult {
    return TaskI64ScopeResult{.ok = 0, .code = code, .index = 0 - 1,
        .state = task.task_i64_poll_invalid(), .value = 0,
        .parent_cancelled = 0, .propagated = 0,
        .child_cancelled_count = 0, .cancellation_requested = 0};
}

fn task_i64_scope_child_address(scope:@borrows *TaskI64CancellationScope,
    index:i32) i64 {
    unsafe {
        if (index == 0) { return scope.*.child0 as i64; }
        if (index == 1) { return scope.*.child1 as i64; }
        if (index == 2) { return scope.*.child2 as i64; }
        if (index == 3) { return scope.*.child3 as i64; }
        if (index == 4) { return scope.*.child4 as i64; }
        if (index == 5) { return scope.*.child5 as i64; }
        if (index == 6) { return scope.*.child6 as i64; }
        return 0;
    }
}

fn task_i64_scope_valid(scope:@borrows *TaskI64CancellationScope) i32 {
    unsafe {
        if (scope == null as *TaskI64CancellationScope ||
            scope.*.parent == 0 || scope.*.count < 0 ||
            scope.*.count > 7) { return 0; }
    }
    let parent_address:i64 = scope.*.parent;
    let i:i32 = 0;
    while (i < scope.*.count) {
        let address:i64 = task_i64_scope_child_address(scope, i);
        let child:*opaque;
        unsafe { child = address as *opaque; }
        if (task.task_i64_valid(child) == 0 || address == parent_address) {
            return 0;
        }
        let j:i32 = 0;
        while (j < i) {
            if (address == task_i64_scope_child_address(scope, j)) {
                return 0;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return 1;
}

fn task_i64_scope_children(scope:@borrows *TaskI64CancellationScope)
    select.TaskI64SelectSet {
    unsafe {
    let children:select.TaskI64SelectSet = select.TaskI64SelectSet{
        .h0 = 0 as *opaque, .h1 = 0 as *opaque,
        .h2 = 0 as *opaque, .h3 = 0 as *opaque,
        .h4 = 0 as *opaque, .h5 = 0 as *opaque,
        .h6 = 0 as *opaque, .h7 = 0 as *opaque, .count = scope.*.count};
    let i:i32 = 0;
    while (i < scope.*.count) {
        let address:i64 = task_i64_scope_child_address(scope, i);
            if (i == 0) { children.h0 = address as *opaque; }
            if (i == 1) { children.h1 = address as *opaque; }
            if (i == 2) { children.h2 = address as *opaque; }
            if (i == 3) { children.h3 = address as *opaque; }
            if (i == 4) { children.h4 = address as *opaque; }
            if (i == 5) { children.h5 = address as *opaque; }
            if (i == 6) { children.h6 = address as *opaque; }
        i = i + 1;
    }
    return children;
    }
}

fn task_i64_scope_poll(scope:@borrows *TaskI64CancellationScope)
    TaskI64ScopeResult {
        if (task_i64_scope_valid(scope) == 0) {
        return task_i64_scope_invalid(task_i64_scope_status_invalid_scope());
    }
    let parent:*opaque;
    unsafe { parent = scope.*.parent as *opaque; }
    let parent_cancelled:i32 = task.task_i64_cancelled(parent);
    let propagated:i32 = 0;
    let cancelled_count:i32 = 0;
    if (parent_cancelled == 1) {
        let i:i32 = 0;
        while (i < scope.*.count) {
            let address:i64 = task_i64_scope_child_address(scope, i);
            let child:*opaque;
            unsafe { child = address as *opaque; }
            if (task.task_i64_cancel(child) != 0) {
                return task_i64_scope_invalid(task_i64_scope_status_cancel_failed());
            }
            i = i + 1;
        }
        propagated = (scope.*.count > 0) as i32;
    }
    let i:i32 = 0;
    while (i < scope.*.count) {
        let address:i64 = task_i64_scope_child_address(scope, i);
        let child:*opaque;
        unsafe { child = address as *opaque; }
        cancelled_count = cancelled_count + task.task_i64_cancelled(child);
        i = i + 1;
    }
    if (scope.*.count == 0) {
        return TaskI64ScopeResult{.ok = 1,
            .code = task_i64_scope_status_ok(), .index = 0 - 1,
            .state = task.task_i64_poll_pending(), .value = 0,
            .parent_cancelled = parent_cancelled, .propagated = propagated,
            .child_cancelled_count = cancelled_count,
            .cancellation_requested = 0};
    }
    let children:select.TaskI64SelectSet = task_i64_scope_children(scope);
    let selected:select.TaskI64SelectResult = select.task_i64_select(&children, 0);
    return TaskI64ScopeResult{.ok = selected.ok, .code = selected.code,
        .index = selected.index, .state = selected.state, .value = selected.value,
        .parent_cancelled = parent_cancelled, .propagated = propagated,
        .child_cancelled_count = cancelled_count,
        .cancellation_requested = selected.cancellation_requested};
}

// Poll-driven bounded wait. Parent cancellation is checked every yielded
// iteration, so child propagation does not wait for the full timeout.
fn task_i64_scope_wait(scope:@borrows *TaskI64CancellationScope,
    timeout_ms:i32) TaskI64ScopeResult {
    if (task_i64_scope_valid(scope) == 0) {
        return task_i64_scope_invalid(task_i64_scope_status_invalid_scope());
    }
    if (timeout_ms < 0 || timeout_ms > 5000) {
        return task_i64_scope_invalid(task_i64_scope_status_invalid_timeout());
    }
    let observed:TaskI64ScopeResult = task_i64_scope_poll(scope);
    if (observed.state != task.task_i64_poll_pending() || timeout_ms == 0) {
        return observed;
    }
    let started:i64 = _zag_clock_monotonic_ms();
    let elapsed:i64 = 0;
    while (elapsed < timeout_ms as i64) {
        unsafe {
            let _yielded:i64 = _zag_raw_syscall(24, 0, 0, 0, 0, 0, 0);
        }
        let next:TaskI64ScopeResult = task_i64_scope_poll(scope);
        if (next.state != task.task_i64_poll_pending()) { return next; }
        elapsed = _zag_clock_monotonic_ms() - started;
        if (elapsed < 0) { elapsed = 0; }
    }
    return task_i64_scope_poll(scope);
}
