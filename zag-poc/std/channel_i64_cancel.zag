// Cancellation-aware adapters for the bounded std:channel_i64 SPSC ring.
//
// These wrappers poll a caller-owned one-shot CancelTokenI64 between finite
// channel waits. They do not make a channel MPMC, interrupt an arbitrary
// syscall, or provide scheduler/task ownership.

@import("std:channel_i64") as base
@import("std:cancel_token_i64") as cancel

struct ChannelI64CancelSendResult {
    ok: i32,
    code: i64,
    wait_calls: i32,
    elapsed_ms: i64,
}

struct ChannelI64CancelReceiveResult {
    ok: i32,
    code: i64,
    value: i64,
    wait_calls: i32,
    elapsed_ms: i64,
}

fn channel_i64_cancel_status_ok() i64 { return 0; }
fn channel_i64_cancel_status_invalid_argument() i64 { return 0 - 7611; }
fn channel_i64_cancel_status_invalid_state() i64 { return 0 - 7612; }
fn channel_i64_cancel_status_cancelled() i64 { return 0 - 7613; }
fn channel_i64_cancel_status_limit() i64 { return 0 - 7614; }

fn channel_i64_cancel_elapsed(start: i64) i64 {
    let elapsed: i64 = _zag_clock_monotonic_ms() - start;
    if (elapsed < 0) { return 0; }
    return elapsed;
}

fn channel_i64_cancel_send_wait(channel: *base.ChannelI64,
    token: *cancel.CancelTokenI64, value: i64,
    timeout_ms: i32) ChannelI64CancelSendResult {
    let start: i64 = _zag_clock_monotonic_ms();
    if (channel == null as *base.ChannelI64 ||
        token == null as *cancel.CancelTokenI64 || timeout_ms < 0 ||
        timeout_ms > 5000 || base.channel_i64_valid(channel) == 0) {
        return ChannelI64CancelSendResult{.ok = 0,
            .code = channel_i64_cancel_status_invalid_argument(),
            .wait_calls = 0, .elapsed_ms = 0};
    }
    if (cancel.cancel_token_i64_is_requested(token) < 0) {
        return ChannelI64CancelSendResult{.ok = 0,
            .code = channel_i64_cancel_status_invalid_state(),
            .wait_calls = 0, .elapsed_ms = 0};
    }
    let attempts: i32 = 0;
    let waits: i32 = 0;
    while (attempts < 64) {
        if (cancel.cancel_token_i64_is_requested(token) == 1) {
            return ChannelI64CancelSendResult{.ok = 0,
                .code = channel_i64_cancel_status_cancelled(),
                .wait_calls = waits,
                .elapsed_ms = channel_i64_cancel_elapsed(start)};
        }
        let elapsed: i64 = channel_i64_cancel_elapsed(start);
        if (timeout_ms == 0 || elapsed >= timeout_ms) {
            let probe: base.ChannelI64SendResult =
                base.channel_i64_try_send(channel, value);
            if (probe.ok == 1) {
                return ChannelI64CancelSendResult{.ok = 1,
                    .code = channel_i64_cancel_status_ok(),
                    .wait_calls = waits,
                    .elapsed_ms = channel_i64_cancel_elapsed(start)};
            }
            return ChannelI64CancelSendResult{.ok = 0, .code = probe.code,
                .wait_calls = waits,
                .elapsed_ms = channel_i64_cancel_elapsed(start)};
        }
        let remaining: i64 = (timeout_ms as i64) - elapsed;
        let slice: i32 = 10;
        if (remaining < slice) { slice = remaining as i32; }
        if (slice < 1) { slice = 1; }
        let probe: base.ChannelI64SendResult =
            base.channel_i64_send_wait(channel, value, slice);
        waits = waits + probe.wait_calls;
        if (probe.ok == 1) {
            return ChannelI64CancelSendResult{.ok = 1,
                .code = channel_i64_cancel_status_ok(),
                .wait_calls = waits,
                .elapsed_ms = channel_i64_cancel_elapsed(start)};
        }
        if (probe.code != base.channel_i64_status_full() &&
            probe.code != base.channel_i64_status_timeout()) {
            return ChannelI64CancelSendResult{.ok = 0, .code = probe.code,
                .wait_calls = waits,
                .elapsed_ms = channel_i64_cancel_elapsed(start)};
        }
        attempts = attempts + 1;
    }
    return ChannelI64CancelSendResult{.ok = 0,
        .code = channel_i64_cancel_status_limit(), .wait_calls = waits,
        .elapsed_ms = channel_i64_cancel_elapsed(start)};
}

fn channel_i64_cancel_receive_wait(channel: *base.ChannelI64,
    token: *cancel.CancelTokenI64, timeout_ms: i32)
    ChannelI64CancelReceiveResult {
    let start: i64 = _zag_clock_monotonic_ms();
    if (channel == null as *base.ChannelI64 ||
        token == null as *cancel.CancelTokenI64 || timeout_ms < 0 ||
        timeout_ms > 5000 || base.channel_i64_valid(channel) == 0) {
        return ChannelI64CancelReceiveResult{.ok = 0,
            .code = channel_i64_cancel_status_invalid_argument(), .value = 0,
            .wait_calls = 0, .elapsed_ms = 0};
    }
    if (cancel.cancel_token_i64_is_requested(token) < 0) {
        return ChannelI64CancelReceiveResult{.ok = 0,
            .code = channel_i64_cancel_status_invalid_state(), .value = 0,
            .wait_calls = 0, .elapsed_ms = 0};
    }
    let attempts: i32 = 0;
    let waits: i32 = 0;
    while (attempts < 64) {
        if (cancel.cancel_token_i64_is_requested(token) == 1) {
            return ChannelI64CancelReceiveResult{.ok = 0,
                .code = channel_i64_cancel_status_cancelled(), .value = 0,
                .wait_calls = waits,
                .elapsed_ms = channel_i64_cancel_elapsed(start)};
        }
        let elapsed: i64 = channel_i64_cancel_elapsed(start);
        if (timeout_ms == 0 || elapsed >= timeout_ms) {
            let probe: base.ChannelI64ReceiveResult =
                base.channel_i64_try_receive(channel);
            if (probe.ok == 1) {
                return ChannelI64CancelReceiveResult{.ok = 1,
                    .code = channel_i64_cancel_status_ok(), .value = probe.value,
                    .wait_calls = waits,
                    .elapsed_ms = channel_i64_cancel_elapsed(start)};
            }
            return ChannelI64CancelReceiveResult{.ok = 0, .code = probe.code,
                .value = 0, .wait_calls = waits,
                .elapsed_ms = channel_i64_cancel_elapsed(start)};
        }
        let remaining: i64 = (timeout_ms as i64) - elapsed;
        let slice: i32 = 10;
        if (remaining < slice) { slice = remaining as i32; }
        if (slice < 1) { slice = 1; }
        let probe: base.ChannelI64ReceiveResult =
            base.channel_i64_receive_wait(channel, slice);
        waits = waits + probe.wait_calls;
        if (probe.ok == 1) {
            return ChannelI64CancelReceiveResult{.ok = 1,
                .code = channel_i64_cancel_status_ok(), .value = probe.value,
                .wait_calls = waits,
                .elapsed_ms = channel_i64_cancel_elapsed(start)};
        }
        if (probe.code != base.channel_i64_status_empty() &&
            probe.code != base.channel_i64_status_timeout()) {
            return ChannelI64CancelReceiveResult{.ok = 0, .code = probe.code,
                .value = 0, .wait_calls = waits,
                .elapsed_ms = channel_i64_cancel_elapsed(start)};
        }
        attempts = attempts + 1;
    }
    return ChannelI64CancelReceiveResult{.ok = 0,
        .code = channel_i64_cancel_status_limit(), .value = 0,
        .wait_calls = waits, .elapsed_ms = channel_i64_cancel_elapsed(start)};
}
