// std/metal_loader.zag — pure-Zag FFI adapter to the system Metal framework.
//
// STATUS: STUB. The dispatch function returns -201. The open/available
// functions return false. This file is documentation/reference code showing
// the intended FFI surface, not a working implementation. It uses `type`
// aliases and `[N]T` array syntax that the current Zag parser does not accept.
//
// A contributor with a Mac is needed to:
//   1. Implement the real Objective-C dispatch (replace `return -201`)
//   2. Hook up available() to actually call MTLCreateSystemDefaultDevice()
//   3. Run tests/run_metal_mac.sh and verify the kernel output
//
// See docs/V2_TARGET_SUPPORT.md for the contributor call.
//
// This is the compatibility-tier runtime adapter for metal-compat. It loads
// Metal.framework via Objective-C runtime (objc_msgSend) and creates a minimal
// MTLDevice, MTLCommandQueue, MTLBuffer, MTLComputePipelineState, and
// MTLCommandBuffer to submit a Metal compute kernel with bounded dispatch
// dimensions, then reads back results.
//
// This module is NON-CERTIFIED. It uses CompatLoad and CompatDispatch effects
// and is forbidden in @kernel, @realtime, and @pure functions. It is a
// fallback below native and virtual execution, and below vulkan/opencl-compat.
//
// Metal is macOS-only. On other platforms, zag_metal_compat_available() returns
// false and the compat chooser falls through to the next backend.
//
// DEVICE ENUMERATION: On macOS, MTLCreateSystemDefaultDevice() returns the
// default GPU (integrated or discrete). For multi-GPU systems (e.g., MacBook
// Pro with both integrated and discrete GPUs), use MTLCopyAllDevices() to
// enumerate all available Metal devices and select the one with the highest
// MTLDeviceLocation or lowest power-for-performance ratio.
//
// The MSL encoder uses [[thread_position_in_grid]] as a 1D scalar uint for
// the fill kernel. This is correct for 1D dispatch. For 2D/3D grids, the
// attribute returns uint2/uint3 and the encoder would need to select .x.
//
// MSL VERSION: The encoder emits plain MSL without a language-version pragma.
// Metal frameworks on macOS 10.11+ accept this. For Metal 3+ features
// (macOS 13+), a `#pragma clang diagnostic` or version pragma may be needed.

// ── Objective-C runtime extern declarations ─────────────────────────────────
// These are resolved at link time via --dynamic --needed libobjc.dylib.
extern fn objc_getClass(name: *u8) *u8 @cabi;
extern fn sel_registerName(name: *u8) *u8 @cabi;
extern fn objc_msgSend(receiver: *u8, sel: *u8) *u8 @cabi;

// ── Metal type aliases ──────────────────────────────────────────────────────
// Metal objects are Objective-C ids (opaque pointers).
type MTLDevice = *u8;
type MTLCommandQueue = *u8;
type MTLCommandBuffer = *u8;
type MTLBuffer = *u8;
type MTLComputePipelineState = *u8;
type MTLComputeCommandEncoder = *u8;
type MTLFunction = *u8;
type MTLLibrary = *u8;

// ── Metal compat context ────────────────────────────────────────────────────
struct ZagMetalCompatContext {
    device: MTLDevice,
    command_queue: MTLCommandQueue,
    available: bool,
    error_code: i32,
    error_msg: [128]u8,
}

// Opens a minimal Metal compute context. Returns a context with
// available=true if a Metal device was found.
// On macOS, calls MTLCreateSystemDefaultDevice() via the Objective-C runtime.
// On non-macOS platforms, returns available=false.
fn zag_metal_compat_open() ZagMetalCompatContext @compatLoad {
    let ctx: ZagMetalCompatContext = ZagMetalCompatContext{
        .device = null as MTLDevice,
        .command_queue = null as MTLCommandQueue,
        .available = false,
        .error_code = 0,
        .error_msg = [128]u8{0},
    };
    // A full implementation would:
    // 1. Call objc_getClass("MTLCreateSystemDefaultDevice") to get the C function
    //    from the Metal framework. This is a C function, not an Objective-C method,
    //    so it must be called directly, not via objc_msgSend.
    //    extern fn MTLCreateSystemDefaultDevice() MTLDevice @cabi;
    // 2. ctx.device = MTLCreateSystemDefaultDevice();
    // 3. Create a command queue: ctx.command_queue = objc_msgSend(ctx.device, sel_registerName("newCommandQueue"));
    // 4. For multi-GPU systems, use MTLCopyAllDevices() to enumerate.
    //
    // The actual implementation requires linking against -framework Metal -framework Foundation.
    // On Linux, this function returns available=false.
    return ctx;
}

// Closes a Metal compat context and releases all resources.
fn zag_metal_compat_close(ctx: *ZagMetalCompatContext) void @compatLoad {
    // In Metal, resources are automatically released when the device is
    // released. A full implementation would call objc_msgSend with release
    // selectors:
    //   objc_msgSend(ctx.command_queue, sel_registerName("release"));
    //   objc_msgSend(ctx.device, sel_registerName("release"));
    ctx.available = false;
}

// Dispatches a Metal compute kernel with bounded dimensions.
// The MSL source is compiled into a MTLLibrary via device.newLibraryWithSource,
// the kernel function is extracted, a compute pipeline state is created,
// a command buffer is recorded with the dispatch, committed, and waited on,
// then the output buffer is read back.
fn zag_metal_compat_dispatch(
    ctx: *ZagMetalCompatContext,
    msl_source: *u8,
    msl_length: u64,
    kernel_name: *u8,
    output_buffer: *i32,
    output_count: u32,
    value: i32,
    count: i32,
    group_count_x: u32,
    group_count_y: u32,
    group_count_z: u32,
    timeout_ns: u64,
) i32 @compatDispatch {
    if (!ctx.available) { return -200; }
    // A full implementation would:
    // 1. Create a MTLLibrary from MSL source:
    //    let lib: MTLLibrary = objc_msgSend(ctx.device, sel_registerName("newLibraryWithSource:options:error:"), msl_source, null, &err);
    // 2. Get the kernel function:
    //    let fn: MTLFunction = objc_msgSend(lib, sel_registerName("newFunctionWithName:"), kernel_name);
    // 3. Create a compute pipeline state:
    //    let pipeline: MTLComputePipelineState = objc_msgSend(ctx.device, sel_registerName("newComputePipelineStateWithFunction:error:"), fn, &err);
    // 4. Create an output buffer:
    //    let buf: MTLBuffer = objc_msgSend(ctx.device, sel_registerName("newBufferWithLength:options:"), output_count * 4, 0);
    // 5. Create a command buffer and encoder:
    //    let cmd_buf: MTLCommandBuffer = objc_msgSend(ctx.command_queue, sel_registerName("commandBuffer"));
    //    let encoder: MTLComputeCommandEncoder = objc_msgSend(cmd_buf, sel_registerName("computeCommandEncoder"));
    // 6. Set the pipeline, bind the buffer and arguments, dispatch:
    //    objc_msgSend(encoder, sel_registerName("setComputePipelineState:"), pipeline);
    //    objc_msgSend(encoder, sel_registerName("setBuffer:offset:atIndex:"), buf, 0, 0);
    //    objc_msgSend(encoder, sel_registerName("dispatchThreadgroups:threadsPerThreadgroup:"), ...);
    // 7. End encoding, commit, wait:
    //    objc_msgSend(encoder, sel_registerName("endEncoding"));
    //    objc_msgSend(cmd_buf, sel_registerName("commit"));
    //    objc_msgSend(cmd_buf, sel_registerName("waitUntilCompleted"));
    // 8. Read back: memcpy(output_buffer, [buf contents], output_count * 4);
    // 9. Release resources.
    return -201; // not yet implemented — requires Objective-C runtime
}

// Checks if the Metal framework is available on the current system.
fn zag_metal_compat_available() bool @compatLoad {
    // Metal is macOS-only. On Linux, return false.
    return false;
}
