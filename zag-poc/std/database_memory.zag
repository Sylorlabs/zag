// std/database_memory.zag -- pure-Zag in-memory i64 key/value driver.
//
// "In-memory" here is exact: this driver uses Zag-owned process memory only.
// It performs no filesystem, network, dynamic-library, or database I/O.

@import("rt.zag")
@import("database_kv.zag")

struct MemoryKvSlot {
    key: i64,
    value: i64,
    used: i32,
}

struct MemoryKv {
    entries: *MemoryKvSlot,
    capacity: i32,
    count: i32,
    open: i32,
    status: i32,
}

fn memory_kv_empty(status: i32) MemoryKv {
    return MemoryKv{
        .entries = null as *MemoryKvSlot,
        .capacity = 0,
        .count = 0,
        .open = 0,
        .status = status,
    };
}

fn memory_kv_open(capacity: i32) MemoryKv {
    if (!database_kv_capacity_valid(capacity)) {
        return memory_kv_empty(database_kv_invalid());
    }
    let entries: *MemoryKvSlot =
        _zag_malloc(capacity * @sizeOf[MemoryKvSlot]()) as *MemoryKvSlot;
    let i: i32 = 0;
    while (i < capacity) {
        entries[i].key = 0;
        entries[i].value = 0;
        entries[i].used = 0;
        i = i + 1;
    }
    return MemoryKv{
        .entries = entries,
        .capacity = capacity,
        .count = 0,
        .open = 1,
        .status = database_kv_ok(),
    };
}

fn memory_kv_find(database: *MemoryKv, key: i64) i32 {
    if (database.*.open == 0) { return 0 - 1; }
    let i: i32 = 0;
    while (i < database.*.capacity) {
        if (database.*.entries[i].used != 0 &&
            database.*.entries[i].key == key) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn memory_kv_put(database: *MemoryKv, key: i64, value: i64) i32 {
    if (database.*.open == 0) { return database_kv_invalid(); }
    let existing: i32 = memory_kv_find(database, key);
    if (existing >= 0) {
        database.*.entries[existing].value = value;
        return database_kv_ok();
    }
    if (database.*.count >= database.*.capacity) {
        return database_kv_limit();
    }
    let i: i32 = 0;
    while (i < database.*.capacity) {
        if (database.*.entries[i].used == 0) {
            database.*.entries[i].key = key;
            database.*.entries[i].value = value;
            database.*.entries[i].used = 1;
            database.*.count = database.*.count + 1;
            return database_kv_ok();
        }
        i = i + 1;
    }
    return database_kv_backend_error();
}

fn memory_kv_get(database: *MemoryKv, key: i64, value: *i64) i32 {
    value.* = 0;
    if (database.*.open == 0) { return database_kv_invalid(); }
    let index: i32 = memory_kv_find(database, key);
    if (index < 0) { return database_kv_missing(); }
    value.* = database.*.entries[index].value;
    return database_kv_ok();
}

fn memory_kv_delete(database: *MemoryKv, key: i64) i32 {
    if (database.*.open == 0) { return database_kv_invalid(); }
    let index: i32 = memory_kv_find(database, key);
    if (index < 0) { return database_kv_missing(); }
    database.*.entries[index].key = 0;
    database.*.entries[index].value = 0;
    database.*.entries[index].used = 0;
    database.*.count = database.*.count - 1;
    return database_kv_ok();
}

fn memory_kv_count(database: *MemoryKv, count: *i32) i32 {
    count.* = 0;
    if (database.*.open == 0) { return database_kv_invalid(); }
    count.* = database.*.count;
    return database_kv_ok();
}

fn memory_kv_close(database: *MemoryKv) i32 {
    if (database.*.open == 0) { return database_kv_invalid(); }
    _zag_free(database.*.entries as *i8);
    database.*.entries = null as *MemoryKvSlot;
    database.*.capacity = 0;
    database.*.count = 0;
    database.*.open = 0;
    database.*.status = database_kv_invalid();
    return database_kv_ok();
}
