// Pure-Zag Linux 6.6 adapter vocabulary.  No C declarations or fallback ABI
// are hidden here; executable support still requires the row-specific gate.
@import("std:driver_linux") as linux

pub fn kernel_series() i32 { return linux.linux_kernel_6_6(); }
pub fn interface_tag(api: i32, context: i32, effects: i32, ownership: i32) linux.LinuxInterfaceTag {
    return linux.linux_interface_tag(kernel_series(), api, context, effects, ownership);
}
pub fn unsupported_api(api: i32) []u8 { return linux.linux_unsupported_api(kernel_series(), api); }

// These are binding entry points, not guessed C declarations.  The compiler
// checks the series, context, effect, and ownership tuple on every exported
// interface; the adapter supplies the actual kernel-owned operation later.
pub @linux_api(66,1,5,256,3)
fn pci_probe_binding() i32 { return linux.linux_api_pci_probe(); }
pub @linux_api(66,2,7,256,2)
fn pci_remove_binding() i32 { return linux.linux_api_pci_remove(); }
pub @linux_api(66,3,6,256,1)
fn dma_map_binding() i32 { return linux.linux_api_dma_map(); }
pub @linux_api(66,4,7,256,2)
fn dma_unmap_binding() i32 { return linux.linux_api_dma_unmap(); }
pub @linux_api(66,5,5,320,3)
fn irq_request_binding() i32 { return linux.linux_api_irq_request(); }
pub @linux_api(66,6,7,256,2)
fn irq_free_binding() i32 { return linux.linux_api_irq_free(); }
pub @linux_api(66,7,6,256,1)
fn pm_suspend_binding() i32 { return linux.linux_api_pm_suspend(); }
pub @linux_api(66,8,6,256,1)
fn pm_resume_binding() i32 { return linux.linux_api_pm_resume(); }
