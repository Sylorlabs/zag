// std/set.zag -- homogeneous generic hash set.
//
// Set[K] is a small typed wrapper over std/hashmap.zag. Keys are borrowed: the
// set never copies or frees values referenced by K. The caller supplies the
// hash and equality functions and owns their semantic consistency.

@import("hashmap.zag") as hashmap

struct Set[K] {
    inner: hashmap.HashMap[K,i32],
}

fn set_make[K](capacity: i32, hash_fn: fn(K) i32,
               eq_fn: fn(K,K) bool) Set[K] {
    return Set[K]{
        .inner = hashmap.make[K,i32](capacity, hash_fn, eq_fn),
    };
}

// Returns true only when key was newly inserted.
fn set_add[K](set: *Set[K], key: K) bool {
    if (hashmap.has[K,i32](set.*.inner, key)) { return false; }
    hashmap.put[K,i32](&set.*.inner, key, 1);
    return true;
}

fn set_contains[K](set: Set[K], key: K) bool {
    return hashmap.has[K,i32](set.inner, key);
}

// Returns true only when a live key was removed.
fn set_remove[K](set: *Set[K], key: K) bool {
    return hashmap.del[K,i32](&set.*.inner, key);
}

fn set_count[K](set: Set[K]) i32 {
    return hashmap.count[K,i32](set.inner);
}

fn set_free[K](set: *Set[K]) void {
    hashmap.free[K,i32](&set.*.inner);
}

// Convenience wrapper for the common i32 case.
struct IntSet {
    inner: Set[i32],
}

fn int_set_make(capacity: i32) IntSet {
    return IntSet{
        .inner = set_make[i32](capacity, hashmap.hash_i32, hashmap.eq_i32),
    };
}

fn int_set_add(set: *IntSet, key: i32) bool {
    return set_add[i32](&set.*.inner, key);
}

fn int_set_contains(set: IntSet, key: i32) bool {
    return set_contains[i32](set.inner, key);
}

fn int_set_remove(set: *IntSet, key: i32) bool {
    return set_remove[i32](&set.*.inner, key);
}

fn int_set_count(set: IntSet) i32 {
    return set_count[i32](set.inner);
}

fn int_set_free(set: *IntSet) void {
    set_free[i32](&set.*.inner);
}
