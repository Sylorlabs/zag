// std/net_ipv6.zag — bounded Linux x86-64 IPv6 socket foundation.
//
// Addresses are two host-order u64 words (network numeric order), ports are
// host order, and scope is the IPv6 interface scope id. The module mirrors the
// explicit ownership and bounded-I/O rules of net_ipv4.zag. It deliberately
// does not provide hostname resolution, TLS, HTTP, async scheduling, or
// arbitrary socket-option access.

@import("rt.zag")

struct NetIpv6Endpoint {
    high: u64,
    low: u64,
    port: i32,
    scope: i32,
}

struct NetIpv6TcpListener { fd: i64, open: i32, local: NetIpv6Endpoint }
struct NetIpv6TcpStream { fd: i64, open: i32 }
struct NetIpv6UdpSocket { fd: i64, open: i32, local: NetIpv6Endpoint }

struct NetIpv6TcpListenerResult {
    ok: i32, code: i64, value: NetIpv6TcpListener,
}
struct NetIpv6TcpStreamResult {
    ok: i32, code: i64, value: NetIpv6TcpStream,
}
struct NetIpv6UdpSocketResult {
    ok: i32, code: i64, value: NetIpv6UdpSocket,
}
struct NetIpv6IoResult {
    ok: i32, code: i64, transferred: i32, calls: i32,
}
struct NetIpv6UdpReceiveResult {
    ok: i32, code: i64, transferred: i32, calls: i32,
    source: NetIpv6Endpoint,
}

// sockaddr_in6 is 28 bytes. The final u64 is over-allocated so the native
// stack object remains naturally aligned; every syscall is passed length 28.
struct NetIpv6KernelSockAddr {
    word0: u64,
    word1: u64,
    word2: u64,
    word3: u64,
}
struct NetIpv6KernelTimeval { seconds: i64, microseconds: i64 }

fn net6_status_ok() i64 { return 0; }
fn net6_status_invalid_argument() i64 { return 0 - 7101; }
fn net6_status_invalid_state() i64 { return 0 - 7102; }
fn net6_status_limit() i64 { return 0 - 7103; }
fn net6_status_eof() i64 { return 0 - 7104; }
fn net6_status_incomplete() i64 { return 0 - 7105; }
fn net6_status_truncated() i64 { return 0 - 7106; }

fn net6_ipv6_any() NetIpv6Endpoint {
    return NetIpv6Endpoint{.high=0,.low=0,.port=0,.scope=0};
}
fn net6_ipv6_loopback() NetIpv6Endpoint {
    return NetIpv6Endpoint{.high=0,.low=1,.port=0,.scope=0};
}
fn net6_ipv6_endpoint(high:u64,low:u64,port:i32,scope:i32) NetIpv6Endpoint {
    return NetIpv6Endpoint{.high=high,.low=low,.port=port,.scope=scope};
}
fn net6_invalid_listener() NetIpv6TcpListener {
    return NetIpv6TcpListener{.fd=0-1,.open=0,.local=net6_ipv6_any()};
}
fn net6_invalid_stream() NetIpv6TcpStream {
    return NetIpv6TcpStream{.fd=0-1,.open=0};
}
fn net6_invalid_udp() NetIpv6UdpSocket {
    return NetIpv6UdpSocket{.fd=0-1,.open=0,.local=net6_ipv6_any()};
}

fn net6_listener_take(result:*NetIpv6TcpListenerResult) NetIpv6TcpListener {
    if(result.*.ok==0||result.*.value.open==0){return net6_invalid_listener();}
    let value:NetIpv6TcpListener=result.*.value;
    result.*.value=net6_invalid_listener();result.*.ok=0;
    result.*.code=net6_status_invalid_state();return value;
}
fn net6_stream_take(result:*NetIpv6TcpStreamResult) NetIpv6TcpStream {
    if(result.*.ok==0||result.*.value.open==0){return net6_invalid_stream();}
    let value:NetIpv6TcpStream=result.*.value;
    result.*.value=net6_invalid_stream();result.*.ok=0;
    result.*.code=net6_status_invalid_state();return value;
}
fn net6_udp_take(result:*NetIpv6UdpSocketResult) NetIpv6UdpSocket {
    if(result.*.ok==0||result.*.value.open==0){return net6_invalid_udp();}
    let value:NetIpv6UdpSocket=result.*.value;
    result.*.value=net6_invalid_udp();result.*.ok=0;
    result.*.code=net6_status_invalid_state();return value;
}
fn net6_io(ok:i32,code:i64,transferred:i32,calls:i32) NetIpv6IoResult {
    return NetIpv6IoResult{.ok=ok,.code=code,.transferred=transferred,.calls=calls};
}
fn net6_udp_result(ok:i32,code:i64,transferred:i32,calls:i32,
                   source:NetIpv6Endpoint) NetIpv6UdpReceiveResult {
    return NetIpv6UdpReceiveResult{.ok=ok,.code=code,.transferred=transferred,
        .calls=calls,.source=source};
}
fn net6_endpoint_valid(endpoint:NetIpv6Endpoint,allow_zero_port:i32)i32 {
    if(endpoint.port<0||endpoint.port>65535||endpoint.scope<0){return 0;}
    if(allow_zero_port==0&&endpoint.port==0){return 0;}return 1;
}
fn net6_timeout_valid(timeout_ms:i32)i32 {
    return (timeout_ms>=1&&timeout_ms<=60000) as i32;
}
fn net6_swap16(value:u64)u64{return ((value&255)<<8)|((value>>8)&255);}
fn net6_swap64(value:u64)u64 {
    return ((value&255)<<56)|(((value>>8)&255)<<48)|
        (((value>>16)&255)<<40)|(((value>>24)&255)<<32)|
        (((value>>32)&255)<<24)|(((value>>40)&255)<<16)|
        (((value>>48)&255)<<8)|((value>>56)&255);
}
fn net6_kernel_address(endpoint:NetIpv6Endpoint) NetIpv6KernelSockAddr {
    return NetIpv6KernelSockAddr{
        .word0=10|(net6_swap16(endpoint.port as u64)<<16),
        .word1=net6_swap64(endpoint.high),.word2=net6_swap64(endpoint.low),
        .word3=endpoint.scope as u64};
}
fn net6_kernel_family(address:NetIpv6KernelSockAddr)i32 {
    return (address.word0&65535) as i32;
}
fn net6_endpoint_from_kernel(address:NetIpv6KernelSockAddr) NetIpv6Endpoint {
    return NetIpv6Endpoint{.high=net6_swap64(address.word1),
        .low=net6_swap64(address.word2),
        .port=net6_swap16((address.word0>>16)&65535) as i32,
        .scope=(address.word3&4294967295) as i32};
}
fn net6_socket(kind:i64)i64 {
    // AF_INET6=10, SOCK_CLOEXEC keeps descriptors out of later exec.
    return _zag_raw_syscall(41,10,kind|524288,0,0,0,0);
}
fn net6_close_fd(fd:i64)i64{return _zag_raw_syscall(3,fd,0,0,0,0,0);}
fn net6_set_timeouts(fd:i64,timeout_ms:i32)i64 {
    let timeout:NetIpv6KernelTimeval=NetIpv6KernelTimeval{
        .seconds=(timeout_ms/1000) as i64,
        .microseconds=((timeout_ms%1000)*1000) as i64};
    let p:*NetIpv6KernelTimeval=&timeout;
    let r:i64=_zag_raw_syscall(54,fd,1,20,p as i64,16,0);
    if(r<0){return r;}return _zag_raw_syscall(54,fd,1,21,p as i64,16,0);
}
fn net6_reuse(fd:i64)i64 {
    let enabled:i64=1;let p:*i64=&enabled;
    return _zag_raw_syscall(54,fd,1,2,p as i64,4,0);
}
fn net6_local(fd:i64,out:*NetIpv6Endpoint)i64 {
    let address:NetIpv6KernelSockAddr=NetIpv6KernelSockAddr{
        .word0=0,.word1=0,.word2=0,.word3=0};
    let length:i64=28;let p:*NetIpv6KernelSockAddr=&address;
    let lp:*i64=&length;let r:i64=_zag_raw_syscall(51,fd,p as i64,lp as i64,0,0,0);
    if(r<0){return r;}
    if(length<28||net6_kernel_family(address)!=10){return net6_status_incomplete();}
    out.*=net6_endpoint_from_kernel(address);return net6_status_ok();
}

fn net6_listen(endpoint:NetIpv6Endpoint,backlog:i32,
               timeout_ms:i32) NetIpv6TcpListenerResult {
    let bad:NetIpv6TcpListener=net6_invalid_listener();
    if(net6_endpoint_valid(endpoint,1)==0||backlog<1||backlog>128||
       net6_timeout_valid(timeout_ms)==0){
        return NetIpv6TcpListenerResult{.ok=0,.code=net6_status_invalid_argument(),.value=bad};
    }
    let fd:i64=net6_socket(1);if(fd<0){return NetIpv6TcpListenerResult{.ok=0,.code=fd,.value=bad};}
    let r:i64=net6_reuse(fd);if(r<0){let _=net6_close_fd(fd);return NetIpv6TcpListenerResult{.ok=0,.code=r,.value=bad};}
    let t:i64=net6_set_timeouts(fd,timeout_ms);if(t<0){let _=net6_close_fd(fd);return NetIpv6TcpListenerResult{.ok=0,.code=t,.value=bad};}
    let address:NetIpv6KernelSockAddr=net6_kernel_address(endpoint);
    let address_pointer:*NetIpv6KernelSockAddr=&address;
    let b:i64=_zag_raw_syscall(49,fd,address_pointer as i64,28,0,0,0);
    if(b<0){let _=net6_close_fd(fd);return NetIpv6TcpListenerResult{.ok=0,.code=b,.value=bad};}
    let l:i64=_zag_raw_syscall(50,fd,backlog,0,0,0,0);
    if(l<0){let _=net6_close_fd(fd);return NetIpv6TcpListenerResult{.ok=0,.code=l,.value=bad};}
    let local:NetIpv6Endpoint=net6_ipv6_any();let lr:i64=net6_local(fd,&local);
    if(lr<0){let _=net6_close_fd(fd);return NetIpv6TcpListenerResult{.ok=0,.code=lr,.value=bad};}
    return NetIpv6TcpListenerResult{.ok=1,.code=0,
        .value=NetIpv6TcpListener{.fd=fd,.open=1,.local=local}};
}
fn net6_connect(endpoint:NetIpv6Endpoint,timeout_ms:i32) NetIpv6TcpStreamResult {
    let bad:NetIpv6TcpStream=net6_invalid_stream();
    if(net6_endpoint_valid(endpoint,0)==0||net6_timeout_valid(timeout_ms)==0){
        return NetIpv6TcpStreamResult{.ok=0,.code=net6_status_invalid_argument(),.value=bad};
    }
    let fd:i64=net6_socket(1);if(fd<0){return NetIpv6TcpStreamResult{.ok=0,.code=fd,.value=bad};}
    let t:i64=net6_set_timeouts(fd,timeout_ms);if(t<0){let _=net6_close_fd(fd);return NetIpv6TcpStreamResult{.ok=0,.code=t,.value=bad};}
    let address:NetIpv6KernelSockAddr=net6_kernel_address(endpoint);
    let address_pointer:*NetIpv6KernelSockAddr=&address;
    let c:i64=_zag_raw_syscall(42,fd,address_pointer as i64,28,0,0,0);
    if(c<0){let _=net6_close_fd(fd);return NetIpv6TcpStreamResult{.ok=0,.code=c,.value=bad};}
    return NetIpv6TcpStreamResult{.ok=1,.code=0,.value=NetIpv6TcpStream{.fd=fd,.open=1}};
}
fn net6_accept(listener:*NetIpv6TcpListener,timeout_ms:i32) NetIpv6TcpStreamResult {
    let bad:NetIpv6TcpStream=net6_invalid_stream();
    if(listener.*.open==0||listener.*.fd<0){return NetIpv6TcpStreamResult{.ok=0,.code=net6_status_invalid_state(),.value=bad};}
    if(net6_timeout_valid(timeout_ms)==0){return NetIpv6TcpStreamResult{.ok=0,.code=net6_status_invalid_argument(),.value=bad};}
    let fd:i64=_zag_raw_syscall(288,listener.*.fd,0,0,524288,0,0);
    if(fd<0){return NetIpv6TcpStreamResult{.ok=0,.code=fd,.value=bad};}
    let t:i64=net6_set_timeouts(fd,timeout_ms);if(t<0){let _=net6_close_fd(fd);return NetIpv6TcpStreamResult{.ok=0,.code=t,.value=bad};}
    return NetIpv6TcpStreamResult{.ok=1,.code=0,.value=NetIpv6TcpStream{.fd=fd,.open=1}};
}
fn net6_listener_close(listener:*NetIpv6TcpListener)i64 {
    if(listener.*.open==0||listener.*.fd<0){return net6_status_invalid_state();}
    let fd:i64=listener.*.fd;listener.*.open=0;listener.*.fd=0-1;return net6_close_fd(fd);
}
fn net6_stream_close(stream:*NetIpv6TcpStream)i64 {
    if(stream.*.open==0||stream.*.fd<0){return net6_status_invalid_state();}
    let fd:i64=stream.*.fd;stream.*.open=0;stream.*.fd=0-1;return net6_close_fd(fd);
}
fn net6_udp_bind(endpoint:NetIpv6Endpoint,timeout_ms:i32) NetIpv6UdpSocketResult {
    let bad:NetIpv6UdpSocket=net6_invalid_udp();
    if(net6_endpoint_valid(endpoint,1)==0||net6_timeout_valid(timeout_ms)==0){
        return NetIpv6UdpSocketResult{.ok=0,.code=net6_status_invalid_argument(),.value=bad};
    }
    let fd:i64=net6_socket(2);if(fd<0){return NetIpv6UdpSocketResult{.ok=0,.code=fd,.value=bad};}
    let t:i64=net6_set_timeouts(fd,timeout_ms);if(t<0){let _=net6_close_fd(fd);return NetIpv6UdpSocketResult{.ok=0,.code=t,.value=bad};}
    let address:NetIpv6KernelSockAddr=net6_kernel_address(endpoint);
    let address_pointer:*NetIpv6KernelSockAddr=&address;
    let b:i64=_zag_raw_syscall(49,fd,address_pointer as i64,28,0,0,0);
    if(b<0){let _=net6_close_fd(fd);return NetIpv6UdpSocketResult{.ok=0,.code=b,.value=bad};}
    let local:NetIpv6Endpoint=net6_ipv6_any();let lr:i64=net6_local(fd,&local);
    if(lr<0){let _=net6_close_fd(fd);return NetIpv6UdpSocketResult{.ok=0,.code=lr,.value=bad};}
    return NetIpv6UdpSocketResult{.ok=1,.code=0,.value=NetIpv6UdpSocket{.fd=fd,.open=1,.local=local}};
}
fn net6_udp_close(socket:*NetIpv6UdpSocket)i64 {
    if(socket.*.open==0||socket.*.fd<0){return net6_status_invalid_state();}
    let fd:i64=socket.*.fd;socket.*.open=0;socket.*.fd=0-1;return net6_close_fd(fd);
}
fn net6_send(stream:*NetIpv6TcpStream,bytes:[]u8,max_calls:i32) NetIpv6IoResult {
    if(stream.*.open==0||stream.*.fd<0){return net6_io(0,net6_status_invalid_state(),0,0);}
    if(bytes.len>16777216||max_calls<1||max_calls>1048576){return net6_io(0,net6_status_invalid_argument(),0,0);}
    let sent:i32=0;let calls:i32=0;while(sent<bytes.len&&calls<max_calls){
        let amount:i32=bytes.len-sent;if(amount>16384){amount=16384;}calls=calls+1;
        let r:i64=_zag_raw_syscall(44,stream.*.fd,_zag_slice_ptr(bytes[sent..bytes.len]) as i64,amount,16384,0,0);
        if(r>0){if(r>amount){return net6_io(0,net6_status_incomplete(),sent,calls);}sent=sent+r as i32;}
        else if(r==0||r==0-4){if(r==0){return net6_io(0,net6_status_incomplete(),sent,calls);}}
        else{return net6_io(0,r,sent,calls);}
    }
    if(sent!=bytes.len){return net6_io(0,net6_status_limit(),sent,calls);}
    return net6_io(1,0,sent,calls);
}
fn net6_recv(stream:*NetIpv6TcpStream,output:[]u8,exact:i32,max_calls:i32) NetIpv6IoResult {
    if(stream.*.open==0||stream.*.fd<0){return net6_io(0,net6_status_invalid_state(),0,0);}
    if(exact<0||exact>output.len||exact>16777216||max_calls<1||max_calls>1048576){
        return net6_io(0,net6_status_invalid_argument(),0,0);
    }
    let got:i32=0;let calls:i32=0;while(got<exact&&calls<max_calls){
        let amount:i32=exact-got;if(amount>16384){amount=16384;}calls=calls+1;
        let r:i64=_zag_raw_syscall(45,stream.*.fd,_zag_slice_ptr(output[got..output.len]) as i64,amount,0,0,0);
        if(r>0){if(r>amount){return net6_io(0,net6_status_incomplete(),got,calls);}got=got+r as i32;}
        else if(r==0){return net6_io(0,net6_status_eof(),got,calls);}
        else if(r!=0-4){return net6_io(0,r,got,calls);}
    }
    if(got!=exact){return net6_io(0,net6_status_limit(),got,calls);}
    return net6_io(1,0,got,calls);
}
fn net6_udp_send(socket:*NetIpv6UdpSocket,destination:NetIpv6Endpoint,
                 bytes:[]u8) NetIpv6IoResult {
    if(socket.*.open==0||socket.*.fd<0){return net6_io(0,net6_status_invalid_state(),0,0);}
    if(net6_endpoint_valid(destination,0)==0||bytes.len>65507){return net6_io(0,net6_status_invalid_argument(),0,0);}
    let address:NetIpv6KernelSockAddr=net6_kernel_address(destination);let calls:i32=1;
    let address_pointer:*NetIpv6KernelSockAddr=&address;
    let r:i64=_zag_raw_syscall(44,socket.*.fd,_zag_slice_ptr(bytes) as i64,bytes.len,16384,address_pointer as i64,28);
    if(r==bytes.len){return net6_io(1,0,r as i32,calls);}
    if(r>=0){return net6_io(0,net6_status_incomplete(),r as i32,calls);}
    return net6_io(0,r,0,calls);
}
fn net6_udp_recv(socket:*NetIpv6UdpSocket,output:[]u8) NetIpv6UdpReceiveResult {
    let bad:NetIpv6Endpoint=net6_ipv6_any();
    if(socket.*.open==0||socket.*.fd<0){return net6_udp_result(0,net6_status_invalid_state(),0,0,bad);}
    if(output.len>65507){return net6_udp_result(0,net6_status_invalid_argument(),0,0,bad);}
    let address:NetIpv6KernelSockAddr=NetIpv6KernelSockAddr{.word0=0,.word1=0,.word2=0,.word3=0};
    let length:i64=28;let address_pointer:*NetIpv6KernelSockAddr=&address;
    let length_pointer:*i64=&length;
    let r:i64=_zag_raw_syscall(45,socket.*.fd,_zag_slice_ptr(output) as i64,output.len,32,address_pointer as i64,length_pointer as i64);
    if(r<0){return net6_udp_result(0,r,0,1,bad);}
    if(length<28||net6_kernel_family(address)!=10){return net6_udp_result(0,net6_status_incomplete(),0,1,bad);}
    let source:NetIpv6Endpoint=net6_endpoint_from_kernel(address);
    if(r>output.len){return net6_udp_result(0,net6_status_truncated(),output.len,1,source);}
    return net6_udp_result(1,0,r as i32,1,source);
}
