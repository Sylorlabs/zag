// gpu_platform.zag — compiler/runtime/driver boundary for Zag GPU execution.
//
// Zag owns source lowering, kernel formats, validation, runtime policy, and
// command construction. The operating system or vendor owns privileged device
// drivers, firmware, display, PCIe, interrupts, power, and reset handling.

@import("rt.zag")

fn zag_gpu_vendor_amd()i32{return 1;}
fn zag_gpu_vendor_nvidia()i32{return 2;}
fn zag_gpu_vendor_intel()i32{return 3;}
fn zag_gpu_vendor_unknown()i32{return 4;}
fn zag_gpu_vendor_apple()i32{return 5;}

fn zag_gpu_code_rdna_native()i32{return 1;}
fn zag_gpu_code_nvidia_native()i32{return 2;}
fn zag_gpu_code_intel_native()i32{return 3;}
fn zag_gpu_code_metal()i32{return 4;}

fn zag_gpu_driver_linux_amdgpu()i32{return 1;}
fn zag_gpu_driver_linux_nouveau()i32{return 2;}
fn zag_gpu_driver_linux_i915()i32{return 3;}
fn zag_gpu_driver_linux_xe()i32{return 4;}
fn zag_gpu_driver_macos_metal()i32{return 5;}

struct ZagGpuPlatformTarget{
    vendor:i32,
    code_format:i32,
    driver_abi:i32,
    compiler_implemented:bool,
    virtual_runtime_implemented:bool,
    runtime_implemented:bool,
    physical_certification_required:bool,
    rewrites_privileged_driver:bool,
    name:[]u8,
    reason:[]u8,
}

fn zag_gpu_target_gfx1010()ZagGpuPlatformTarget{
    return ZagGpuPlatformTarget{.vendor=zag_gpu_vendor_amd(),
        .code_format=zag_gpu_code_rdna_native(),.driver_abi=zag_gpu_driver_linux_amdgpu(),
        .compiler_implemented=true,.virtual_runtime_implemented=true,.runtime_implemented=false,
        .physical_certification_required=true,.rewrites_privileged_driver=false,
        .name="amdgpu-gfx1010",
        .reason="Zag-native RDNA1 bundle and VM are implemented; direct Linux AMDGPU submission is not yet complete"};
}

fn zag_gpu_target_nvidia_native()ZagGpuPlatformTarget{
    return ZagGpuPlatformTarget{.vendor=zag_gpu_vendor_nvidia(),
        .code_format=zag_gpu_code_nvidia_native(),.driver_abi=zag_gpu_driver_linux_nouveau(),
        .compiler_implemented=false,.virtual_runtime_implemented=false,.runtime_implemented=false,
        .physical_certification_required=true,.rewrites_privileged_driver=false,
        .name="nouveau-native",
        .reason="planned Zag-native NVIDIA ISA and direct Linux Nouveau DRM adapter"};
}

fn zag_gpu_target_intel_native()ZagGpuPlatformTarget{
    return ZagGpuPlatformTarget{.vendor=zag_gpu_vendor_intel(),
        .code_format=zag_gpu_code_intel_native(),.driver_abi=zag_gpu_driver_linux_xe(),
        .compiler_implemented=false,.virtual_runtime_implemented=false,.runtime_implemented=false,
        .physical_certification_required=true,.rewrites_privileged_driver=false,
        .name="intel-xe-native",
        .reason="planned Zag-native Intel ISA and direct Linux Xe DRM adapter"};
}

// Apple Silicon is deliberately a first-class platform identity rather than
// an AMD/DRM or unknown-device fallback.  No Metal shader compiler, Objective-C
// bridge, command queue, or readback witness exists yet, so it remains
// fail-closed until all four are implemented natively.
fn zag_gpu_target_apple_metal()ZagGpuPlatformTarget{
    return ZagGpuPlatformTarget{.vendor=zag_gpu_vendor_apple(),
        .code_format=zag_gpu_code_metal(),.driver_abi=zag_gpu_driver_macos_metal(),
        .compiler_implemented=false,.virtual_runtime_implemented=false,.runtime_implemented=false,
        .physical_certification_required=true,.rewrites_privileged_driver=false,
        .name="metal-apple-silicon",
        .reason="Apple Silicon requires a native Metal shader/compiler, command-queue, and readback adapter; Linux DRM is never used"};
}

fn zag_gpu_target_ready(t:ZagGpuPlatformTarget)bool{
    return t.compiler_implemented&&t.runtime_implemented&&!t.rewrites_privileged_driver;
}

fn zag_gpu_target_virtual_ready(t:ZagGpuPlatformTarget)bool{
    return t.compiler_implemented&&t.virtual_runtime_implemented&&!t.rewrites_privileged_driver;
}

fn zag_gpu_platform_boundary_valid(t:ZagGpuPlatformTarget)bool{
    if(t.rewrites_privileged_driver){return false;}
    if(t.code_format<zag_gpu_code_rdna_native()||t.code_format>zag_gpu_code_metal()){return false;}
    if(t.driver_abi<zag_gpu_driver_linux_amdgpu()||t.driver_abi>zag_gpu_driver_macos_metal()){return false;}
    return true;
}

// Portable selection is explicit and fail-closed. It never reports a planned
// compiler/runtime pair as operational and never substitutes MLIR as a shipped
// backend behind the caller's back.
fn zag_gpu_platform_select(vendor:i32,prefer_native:bool)ZagGpuPlatformTarget{
    if(vendor==zag_gpu_vendor_amd()&&prefer_native){return zag_gpu_target_gfx1010();}
    if(vendor==zag_gpu_vendor_nvidia()){return zag_gpu_target_nvidia_native();}
    if(vendor==zag_gpu_vendor_intel()){return zag_gpu_target_intel_native();}
    if(vendor==zag_gpu_vendor_apple()){return zag_gpu_target_apple_metal();}
    return ZagGpuPlatformTarget{.vendor=zag_gpu_vendor_unknown(),
        .code_format=zag_gpu_code_rdna_native(),.driver_abi=zag_gpu_driver_linux_amdgpu(),
        .compiler_implemented=false,.virtual_runtime_implemented=false,.runtime_implemented=false,
        .physical_certification_required=true,.rewrites_privileged_driver=false,
        .name="unsupported-native",
        .reason="no Zag-native ISA and direct kernel UAPI adapter exists for this GPU"};
}
