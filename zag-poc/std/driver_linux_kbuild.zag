// Pure-Zag description of the kernel-object boundary.
//
// Kbuild owns the final module link. This module contains no C shim, C
// driver, or guessed kernel ABI; it gives the shared core and release gate a
// typed vocabulary for the object evidence an adapter must provide.

@import("std:driver") as driver

pub fn object_format_et_rel() i32 { return 1; }
pub fn object_section_text() i32 { return 1; }
pub fn object_section_data() i32 { return 2; }
pub fn object_section_modinfo() i32 { return 3; }
pub fn object_section_symbols() i32 { return 4; }
pub fn object_section_debug() i32 { return 5; }
pub fn object_relocation_text() i32 { return 6; }
pub fn object_relocation_data() i32 { return 7; }

pub fn kbuild_owner_kernel_final_link() i32 { return 1; }
pub fn kbuild_c_driver_logic_forbidden() i32 { return 1; }
pub fn kbuild_target_supported(target: i32) i32 {
    return (target == driver.driver_target_x86_64() ||
        target == driver.driver_target_arm64() ||
        target == driver.driver_target_i686()) as i32;
}

pub struct KernelObjectContract {
    target: i32,
    kernel_series: i32,
    format: i32,
    has_text: i32,
    has_data: i32,
    has_modinfo: i32,
    has_symbols: i32,
    has_debug: i32,
    has_text_relocations: i32,
    has_data_relocations: i32,
    kernel_final_link: i32,
    c_driver_logic: i32,
    deterministic: i32,
}

pub fn kernel_object_contract(target: i32, kernel_series: i32,
                              format: i32, has_text: i32, has_data: i32,
                              has_modinfo: i32, has_symbols: i32,
                              has_debug: i32, has_text_relocations: i32,
                              has_data_relocations: i32,
                              kernel_final_link: i32, c_driver_logic: i32,
                              deterministic: i32) KernelObjectContract {
    return KernelObjectContract{
        .target = target, .kernel_series = kernel_series, .format = format,
        .has_text = has_text, .has_data = has_data,
        .has_modinfo = has_modinfo, .has_symbols = has_symbols,
        .has_debug = has_debug, .has_text_relocations = has_text_relocations,
        .has_data_relocations = has_data_relocations,
        .kernel_final_link = kernel_final_link,
        .c_driver_logic = c_driver_logic, .deterministic = deterministic,
    };
}

pub fn kernel_object_contract_valid(contract: KernelObjectContract) i32 {
    let series_ok: i32 = (contract.kernel_series == 61 ||
        contract.kernel_series == 66) as i32;
    return (kbuild_target_supported(contract.target) != 0 && series_ok != 0 &&
        contract.format == object_format_et_rel() &&
        contract.has_text != 0 && contract.has_data != 0 &&
        contract.has_modinfo != 0 && contract.has_symbols != 0 &&
        contract.has_debug != 0 && contract.has_text_relocations != 0 &&
        contract.has_data_relocations != 0 &&
        contract.kernel_final_link == kbuild_owner_kernel_final_link() &&
        contract.c_driver_logic == 0 && contract.deterministic != 0) as i32;
}
