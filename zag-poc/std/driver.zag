pub fn atomic_release[T](atomic: @consumes Atomic[T]) void @driver_teardown {
    unsafe { _zag_free(atomic.token as *i8); }
}

// ── typed atomic read-modify-write operations ───────────────────────────────
// The common emulator uses these helpers to model the operation atomically in
// its deterministic state machine.  A non-emulated handle never falls back to
// an ordinary load/store: the selected target adapter must provide the native
// lowering or the operation returns driver_unsupported().

pub fn atomic_exchange8(atomic: @borrows_mut *Atomic[u8], value: u8,
                        order: i32) AtomicRead8 @irq {
    if (atomic.*.width != atomic_width_8() || atomic_order_valid(order) == 0) {
        return AtomicRead8{ .status = driver_invalid_argument(), .value = 0 };
    }
    if (atomic.*.emulated != 0) {
        let old: u64 = atomic.*.value & mmio_value_mask(atomic.*.width);
        atomic.*.value = (value as u64) & mmio_value_mask(atomic.*.width);
        return AtomicRead8{ .status = driver_ok(),
            .value = old as u8 };
    }
    return AtomicRead8{ .status = driver_unsupported(), .value = 0 };
}

