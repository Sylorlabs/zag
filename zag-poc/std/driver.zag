// ── explicit synchronization capabilities ──────────────────────────────────

pub unsafe fn driver_mutex_new_emulated(irq_safe: i32) DriverMutex @driver_init {
    let token: *opaque = _zag_malloc(8) as *opaque;
    return DriverMutex{ .token = token, .irq_safe = (irq_safe != 0) as i32,
        .held = 0, .emulated = 1 };
}

pub fn driver_mutex_is_irq_safe(lock: @borrows *DriverMutex) i32 @driver_control {
    return lock.*.irq_safe;
}

pub fn driver_mutex_try_lock(lock: @borrows_mut *DriverMutex) DriverStatus @irq {
    if (lock.*.irq_safe == 0 || lock.*.emulated == 0) {
        return DriverStatus{ .code = driver_unsupported(), .detail = 0 };
    }
    if (lock.*.held != 0) {
        return DriverStatus{ .code = driver_busy(), .detail = 1 };
    }
    lock.*.held = 1;
    return DriverStatus{ .code = driver_ok(), .detail = 0 };
}

// A target adapter may supply an owned lock token after proving its
// implementation's IRQ-safety property.
pub unsafe fn driver_mutex_from_owned_token(token: @consumes *opaque,
                                            irq_safe: i32) DriverMutex @driver_init {
    return DriverMutex{ .token = token, .irq_safe = (irq_safe != 0) as i32,
        .held = 0, .emulated = 0 };
}

// This operation is intentionally marked @blocking.  An adapter may wait for
// ownership, but the deterministic emulator returns busy rather than spinning
// or allocating in the common core.
pub fn driver_mutex_lock(lock: @borrows_mut *DriverMutex) DriverStatus @driver_control @blocking {
    if (lock.*.emulated == 0) {
        return DriverStatus{ .code = driver_unsupported(), .detail = 0 };
    }
    if (lock.*.held != 0) {
        return DriverStatus{ .code = driver_busy(), .detail = 1 };
    }
    lock.*.held = 1;
    return DriverStatus{ .code = driver_ok(), .detail = 0 };
}

pub fn driver_mutex_unlock(lock: @borrows_mut *DriverMutex) DriverStatus @driver_control {
    if (lock.*.held == 0) {
        return DriverStatus{ .code = driver_stale_handle(), .detail = 0 };
    }
    lock.*.held = 0;
    return DriverStatus{ .code = driver_ok(), .detail = 0 };
}

pub fn driver_mutex_release(lock: @consumes DriverMutex) void @driver_teardown {
    unsafe { _zag_free(lock.token as *i8); }
}

// These declarations describe the typed adapter surface.  The common core
// calls them only through a selected userspace/kernel adapter; an adapter must
// provide the target-specific lowering and cannot silently substitute ordinary
// loads, stores, heap memory, or blocking work.
pub struct DriverAdapter {
    probe: fn() DriverStatus @driver_init,
    reset: fn() DriverStatus @driver_control,
    quiesce: fn() DriverStatus @driver_teardown,
}

pub struct DriverProfile {
    target: i32,
    kernel_series: i32,
    context: i32,
    effects: i32,
    supports_dma: i32,
    supports_irq: i32,
}
