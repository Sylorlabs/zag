    if (atomic.*.width != atomic_width_64() || atomic_load_order_valid(order) == 0) {
        return AtomicRead64{ .status = driver_invalid_argument(), .value = 0 };
    }
    if (atomic.*.emulated != 0) {
        return AtomicRead64{ .status = driver_ok(), .value = atomic.*.value };
    }
    return AtomicRead64{ .status = driver_unsupported(), .value = 0 };
}

pub fn atomic_load32_value(atomic: @borrows *Atomic[u32], order: i32) u32 @irq {
    let result: AtomicRead32 = atomic_load32(atomic, order);
    return result.value;
}

pub fn atomic_store8(atomic: @borrows_mut *Atomic[u8], value: u8, order: i32) DriverStatus @irq {
    if (atomic.*.width != atomic_width_8() || atomic_store_order_valid(order) == 0) {
        return DriverStatus{ .code = driver_invalid_argument(), .detail = value as i64 };
    }
    if (atomic.*.emulated != 0) {
        atomic.*.value = value as u64;
        return DriverStatus{ .code = driver_ok(), .detail = value as i64 };
    }
    return DriverStatus{ .code = driver_unsupported(), .detail = value as i64 };
}

