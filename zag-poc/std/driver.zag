    if (atomic.*.emulated != 0) {
        let old: u64 = atomic.*.value & mmio_value_mask(atomic.*.width);
        atomic.*.value = (old ^ value) & mmio_value_mask(atomic.*.width);
        return AtomicRead64{ .status = driver_ok(),
            .value = old };
    }
    return AtomicRead64{ .status = driver_unsupported(), .value = 0 };
}

pub fn atomic_compare_exchange8(atomic: @borrows_mut *Atomic[u8], expected: u8,
                                desired: u8, success: i32, failure: i32) AtomicCompare8 @irq {
    if (atomic.*.width != atomic_width_8() ||
        atomic_compare_orders_valid(success, failure) == 0) {
        return AtomicCompare8{ .status = driver_invalid_argument(), .observed = 0, .exchanged = 0 };
    }
    if (atomic.*.emulated != 0) {
        let exchanged: i32 = 0;
        let old: u64 = atomic.*.value & mmio_value_mask(atomic.*.width);
        if (old == (expected as u64 & mmio_value_mask(atomic.*.width))) {
            atomic.*.value = desired as u64 & mmio_value_mask(atomic.*.width);
            exchanged = 1;
        }
        return AtomicCompare8{ .status = driver_ok(), .observed = old as u8,
            .exchanged = exchanged };
    }
    return AtomicCompare8{ .status = driver_unsupported(), .observed = 0, .exchanged = 0 };
}

pub fn atomic_compare_exchange16(atomic: @borrows_mut *Atomic[u16], expected: u16,
                                 desired: u16, success: i32, failure: i32) AtomicCompare16 @irq {
    if (atomic.*.width != atomic_width_16() ||
        atomic_compare_orders_valid(success, failure) == 0) {
