    if (atomic.*.width != atomic_width_32() || atomic_load_order_valid(order) == 0) {
        return AtomicRead32{ .status = driver_invalid_argument(), .value = 0 };
    }
    if (atomic.*.emulated != 0) {
        return AtomicRead32{ .status = driver_ok(), .value = atomic.*.value as u32 };
    }
    return AtomicRead32{ .status = driver_unsupported(), .value = 0 };
}

