// std/os_macos.zag -- bounded Apple Silicon macOS clock and entropy services.
//
// Portable service parity uses Darwin's public libSystem interfaces.  The
// continuous clock and clonefile wrapper are intentionally macOS-specific
// capabilities: continuous time advances across system sleep, and clonefile
// exposes the filesystem's native copy-on-write cloning operation.

@import("rt.zag")

struct OsMacosTimespec {
    seconds: i64,
    nanoseconds: i64,
}

struct OsMacosClockResult {
    ok: i32,
    code: i64,
    seconds: i64,
    nanoseconds: i64,
}

struct OsMacosRandomResult {
    ok: i32,
    code: i64,
    transferred: i32,
    calls: i32,
}

extern fn clock_gettime(clock_id: i32, value: *u8) i32 @io;
extern fn arc4random_buf(output: *u8, bytes: i64) void @io;
extern fn mach_continuous_time() i64 @io;
extern fn clonefile(source: *i8, destination: *i8, flags: i32) i32 @io;

fn os_macos_status_ok() i64 { return 0; }
fn os_macos_status_invalid_argument() i64 { return 0 - 7201; }
fn os_macos_status_limit() i64 { return 0 - 7202; }
fn os_macos_status_system() i64 { return 0 - 7204; }

fn os_macos_clock_realtime() i32 { return 0; }
fn os_macos_clock_monotonic() i32 { return 6; }
fn os_macos_random_max_bytes() i32 { return 65536; }
fn os_macos_random_max_calls() i32 { return 128; }

fn os_macos_clock_failure(code: i64) OsMacosClockResult {
    return OsMacosClockResult{
        .ok = 0, .code = code, .seconds = 0, .nanoseconds = 0,
    };
}

fn os_macos_clock_read(clock_id: i32) OsMacosClockResult {
    if (clock_id != os_macos_clock_realtime() &&
        clock_id != os_macos_clock_monotonic()) {
        return os_macos_clock_failure(os_macos_status_invalid_argument());
    }
    let value: OsMacosTimespec = OsMacosTimespec{
        .seconds = 0, .nanoseconds = 0,
    };
    let rc: i32 = clock_gettime(clock_id, (&value) as *u8);
    if (rc != 0 || value.nanoseconds < 0 || value.nanoseconds >= 1000000000) {
        return os_macos_clock_failure(os_macos_status_system());
    }
    return OsMacosClockResult{
        .ok = 1,
        .code = os_macos_status_ok(),
        .seconds = value.seconds,
        .nanoseconds = value.nanoseconds,
    };
}

fn os_macos_realtime() OsMacosClockResult {
    return os_macos_clock_read(os_macos_clock_realtime());
}

fn os_macos_monotonic() OsMacosClockResult {
    return os_macos_clock_read(os_macos_clock_monotonic());
}

fn os_macos_random_failure(code: i64) OsMacosRandomResult {
    return OsMacosRandomResult{
        .ok = 0, .code = code, .transferred = 0, .calls = 0,
    };
}

fn os_macos_secure_random_fill_bounded(output: []u8,
                                       max_calls: i32) OsMacosRandomResult {
    if (output.len <= 0 || max_calls <= 0 ||
        max_calls > os_macos_random_max_calls()) {
        return os_macos_random_failure(os_macos_status_invalid_argument());
    }
    if (output.len > os_macos_random_max_bytes()) {
        return os_macos_random_failure(os_macos_status_limit());
    }
    let base: *u8 = _zag_slice_ptr(output) as *u8;
    if (base == null as *u8) {
        return os_macos_random_failure(os_macos_status_invalid_argument());
    }
    arc4random_buf(base, output.len as i64);
    return OsMacosRandomResult{
        .ok = 1, .code = os_macos_status_ok(),
        .transferred = output.len, .calls = 1,
    };
}

fn os_macos_secure_random_fill(output: []u8) OsMacosRandomResult {
    return os_macos_secure_random_fill_bounded(
        output, os_macos_random_max_calls()
    );
}

// Darwin/Mach continuous time includes time spent asleep, unlike ordinary
// CLOCK_MONOTONIC. Ticks are hardware-specific and meaningful within a boot.
fn os_macos_continuous_ticks() i64 {
    return mach_continuous_time();
}

fn os_macos_c_string(text: []u8) *i8 {
    let result: *i8 = _zag_malloc(text.len + 1) as *i8;
    if (result == null as *i8) { return null as *i8; }
    let i: i32 = 0;
    while (i < text.len) { result[i] = text[i] as i8; i = i + 1; }
    result[text.len] = 0;
    return result;
}

// Native APFS/filesystem copy-on-write clone. The destination must not exist.
fn os_macos_clonefile(source: []u8, destination: []u8) i32 {
    if (source.len <= 0 || destination.len <= 0 ||
        source.len > 4096 || destination.len > 4096) { return 0 - 1; }
    let i: i32 = 0;
    while (i < source.len) {
        if (source[i] == 0) { return 0 - 1; }
        i = i + 1;
    }
    i = 0;
    while (i < destination.len) {
        if (destination[i] == 0) { return 0 - 1; }
        i = i + 1;
    }
    let src: *i8 = os_macos_c_string(source);
    if (src == null as *i8) { return 0 - 1; }
    let dst: *i8 = os_macos_c_string(destination);
    if (dst == null as *i8) {
        _zag_free(src);
        return 0 - 1;
    }
    let rc: i32 = clonefile(src, dst, 0);
    _zag_free(src);
    _zag_free(dst);
    return rc;
}
