// std/cuda_loader.zag — pure-Zag FFI adapter to the system CUDA driver.
//
// STATUS: NOT RUNTIME-VERIFIED. The dispatch logic and FFI declarations are
// written, but available() returns false and no C test harness exists. This
// file uses `type` aliases and `[N]T` array syntax that the current Zag parser
// does not accept — it is documentation/reference code, not compilable Zag.
//
// A contributor with an NVIDIA GPU is needed to:
//   1. Write a C runtime test harness (like tests/vulkan_runtime_test.c)
//   2. Hook up available() to actually probe for libcuda.so.1
//   3. Run the PTX kernel and verify output
//
// See docs/V2_TARGET_SUPPORT.md for the contributor call.
//
// This is the compatibility-tier runtime adapter for cuda-compat. It loads
// libcuda.so.1 (or platform equivalent) via @cabi extern declarations and
// creates a minimal CUDA context, module, and kernel to submit a PTX compute
// kernel with bounded dispatch dimensions, then reads back results.
//
// This module is NON-CERTIFIED. It uses CompatLoad and CompatDispatch effects
// and is forbidden in @kernel, @realtime, and @pure functions. It is a
// fallback below native and virtual execution, and below vulkan/opencl/metal.
//
// PTX VERSION COMPATIBILITY: The encoder emits PTX 6.5 by default, which
// requires NVIDIA driver >= 390.x. If the installed driver is older,
// cuModuleLoadDataEx returns CUDA_ERROR_UNSUPPORTED_PTX_VERSION (218).
// The loader queries the driver version and rejects PTX that the driver
// cannot JIT-compile before attempting to load it.
//
// PTX is JIT-compiled to SASS by the driver. PTX targeting sm_70 runs on
// any Volta+ GPU, but the driver must support the PTX version.

// ── CUDA type aliases ───────────────────────────────────────────────────────
type CUdevice = i32;
type CUcontext = *u8;
type CUmodule = *u8;
type CUfunction = *u8;
type CUstream = *u8;
type CUdeviceptr = u64;

// CUDA result codes (subset)
fn cuda_success() i32 { return 0; }
fn cuda_error_no_device() i32 { return 100; }
fn cuda_error_invalid_value() i32 { return 11; }
fn cuda_error_out_of_memory() i32 { return 2; }
fn cuda_error_launch_failure() i32 { return 719; }
fn cuda_error_unsupported_ptx_version() i32 { return 218; }

// CUDA driver version query attribute
fn cu_driver_version() u32 { return 0; }  // CU_DEVICE_ATTRIBUTE_COMPUTE_CAPABILITY_MAJOR etc. not needed

// ── CUDA driver extern declarations ─────────────────────────────────────────
// These are resolved at link time via --dynamic --needed libcuda.so.1.
extern fn cuInit(flags: u32) i32 @cabi;
extern fn cuDriverGetVersion(version: *i32) i32 @cabi;
extern fn cuDeviceGetCount(count: *i32) i32 @cabi;
extern fn cuDeviceGet(device: *CUdevice, ordinal: i32) i32 @cabi;
extern fn cuDeviceGetName(name: *u8, len: i32, device: CUdevice) i32 @cabi;
extern fn cuDeviceGetAttribute(pi: *i32, attrib: i32, dev: CUdevice) i32 @cabi;
extern fn cuCtxCreate(ctx: *CUcontext, flags: u32, device: CUdevice) i32 @cabi;
extern fn cuCtxDestroy(ctx: CUcontext) i32 @cabi;
extern fn cuModuleLoadData(module: *CUmodule, image: *u8) i32 @cabi;
extern fn cuModuleLoadDataEx(module: *CUmodule, image: *u8, numOptions: u32, options: *u32, optValues: *u8) i32 @cabi;
extern fn cuModuleUnload(module: CUmodule) i32 @cabi;
extern fn cuModuleGetFunction(hfunc: *CUfunction, module: CUmodule, name: *u8) i32 @cabi;
extern fn cuMemAlloc(devptr: *CUdeviceptr, bytesize: u64) i32 @cabi;
extern fn cuMemFree(devptr: CUdeviceptr) i32 @cabi;
extern fn cuMemcpyHtoD(dst: CUdeviceptr, src: *u8, byteCount: u64) i32 @cabi;
extern fn cuMemcpyDtoH(dst: *u8, src: CUdeviceptr, byteCount: u64) i32 @cabi;
extern fn cuLaunchKernel(f: CUfunction, gridDimX: u32, gridDimY: u32, gridDimZ: u32, blockDimX: u32, blockDimY: u32, blockDimZ: u32, sharedMemBytes: u32, hStream: CUstream, kernelParams: *u8, extra: *u8) i32 @cabi;
extern fn cuStreamSynchronize(stream: CUstream) i32 @cabi;

// ── CUDA compat context ─────────────────────────────────────────────────────
struct ZagCudaCompatContext {
    device: CUdevice,
    context: CUcontext,
    driver_version: i32,   // e.g., 12000 = 12.0, returned by cuDriverGetVersion
    available: bool,
    error_code: i32,
    error_msg: [128]u8,
}

// Minimum driver version for PTX 6.5 is 390.x (encoded as 3900).
// PTX 7.5 requires driver >= 425.25 (encoded as 4252).
fn min_driver_for_ptx_6_5() i32 { return 3900; }
fn min_driver_for_ptx_7_5() i32 { return 4252; }

// Opens a minimal CUDA compute context. Queries the driver version for
// PTX compatibility checking.
fn zag_cuda_compat_open() ZagCudaCompatContext @compatLoad {
    let ctx: ZagCudaCompatContext = ZagCudaCompatContext{
        .device = 0,
        .context = null as CUcontext,
        .driver_version = 0,
        .available = false,
        .error_code = 0,
        .error_msg = [128]u8{0},
    };
    let rc: i32 = cuInit(0);
    if (rc != cuda_success()) {
        ctx.error_code = rc;
        return ctx;
    }
    // Query driver version for PTX compatibility checking.
    let drv_ver: i32 = 0;
    rc = cuDriverGetVersion(&drv_ver);
    if (rc != cuda_success()) {
        ctx.error_code = rc;
        return ctx;
    }
    ctx.driver_version = drv_ver;
    let dev_count: i32 = 0;
    rc = cuDeviceGetCount(&dev_count);
    if (rc != cuda_success() || dev_count == 0) {
        ctx.error_code = cuda_error_no_device();
        return ctx;
    }
    rc = cuDeviceGet(&ctx.device, 0);
    if (rc != cuda_success()) {
        ctx.error_code = rc;
        return ctx;
    }
    rc = cuCtxCreate(&ctx.context, 0, ctx.device);
    if (rc != cuda_success()) {
        ctx.error_code = rc;
        return ctx;
    }
    ctx.available = true;
    return ctx;
}

// Closes a CUDA compat context.
fn zag_cuda_compat_close(ctx: *ZagCudaCompatContext) void @compatLoad {
    if (ctx.context != null as CUcontext) {
        cuCtxDestroy(ctx.context);
        ctx.context = null as CUcontext;
    }
    ctx.available = false;
}

// Dispatches a PTX compute kernel via CUDA.
// Checks the driver version against the PTX version before loading.
// PTX 6.5 requires driver >= 390.x; PTX 7.5 requires driver >= 425.25.
// Returns cuda_success() (0) on success, a CUDA error code on failure.
fn zag_cuda_compat_dispatch(
    ctx: *ZagCudaCompatContext,
    ptx_source: *u8,
    ptx_length: u64,
    ptx_version_major: u32,  // e.g., 6 for PTX 6.5
    ptx_version_minor: u32,  // e.g., 5 for PTX 6.5
    kernel_name: *u8,
    output_buffer: *i32,
    output_count: u32,
    value: i32,
    count: i32,
    grid_dim_x: u32,
    block_dim_x: u32,
    timeout_ns: u64,
) i32 @compatDispatch {
    if (!ctx.available) { return -200; }
    // Check PTX version compatibility before loading.
    // PTX 6.5 needs driver >= 3900, PTX 7.5 needs driver >= 4252.
    let min_driver: i32 = min_driver_for_ptx_6_5();
    if (ptx_version_major >= 7 && ptx_version_minor >= 5) {
        min_driver = min_driver_for_ptx_7_5();
    } else if (ptx_version_major >= 7) {
        min_driver = min_driver_for_ptx_7_5();
    }
    if (ctx.driver_version < min_driver) {
        // Driver is too old to JIT-compile this PTX version.
        return cuda_error_unsupported_ptx_version();
    }
    // Load the PTX module.
    let module: CUmodule = null as CUmodule;
    let load_rc: i32 = cuModuleLoadData(&module, ptx_source);
    if (load_rc != cuda_success()) { return load_rc; }
    // Get the kernel function.
    let func: CUfunction = null as CUfunction;
    let func_rc: i32 = cuModuleGetFunction(&func, module, kernel_name);
    if (func_rc != cuda_success()) { cuModuleUnload(module); return func_rc; }
    // Allocate device memory for the output buffer.
    let buf_size: u64 = (output_count as u64) * 4;
    let dev_ptr: CUdeviceptr = 0;
    let alloc_rc: i32 = cuMemAlloc(&dev_ptr, buf_size);
    if (alloc_rc != cuda_success()) { cuModuleUnload(module); return alloc_rc; }
    // Set up kernel parameters: out (pointer), value (i32), count (i32).
    let params: [3]u64 = [3]u64{
        &dev_ptr as u64,
        &value as u64,
        &count as u64,
    };
    // Launch the kernel.
    let launch_rc: i32 = cuLaunchKernel(func, grid_dim_x, 1, 1, block_dim_x, 1, 1, 0, null as CUstream, &params[0] as *u8, null as *u8);
    if (launch_rc != cuda_success()) { cuMemFree(dev_ptr); cuModuleUnload(module); return launch_rc; }
    // Wait for completion.
    let sync_rc: i32 = cuStreamSynchronize(null as CUstream);
    if (sync_rc != cuda_success()) { cuMemFree(dev_ptr); cuModuleUnload(module); return sync_rc; }
    // Read back results.
    let read_rc: i32 = cuMemcpyDtoH(output_buffer as *u8, dev_ptr, buf_size);
    // Cleanup.
    cuMemFree(dev_ptr);
    cuModuleUnload(module);
    return read_rc;
}

// Checks if the CUDA driver is available on the current system.
fn zag_cuda_compat_available() bool @compatLoad {
    return false;
}
