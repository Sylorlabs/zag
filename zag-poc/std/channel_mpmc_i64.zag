// Bounded Linux x86-64 MPMC i64 channel.
//
// This is a deliberately small try-only queue. Any number of producers and
// consumers may call try_send/try_receive concurrently, while close remains a
// quiescent operation: callers must stop operations before closing the handle.
// Capacity is a power of two in 2..64. A one-slot MPMC ring cannot distinguish
// a published item from a released slot with this sequence layout, so it is
// rejected rather than exposing an ambiguous full/empty state. The queue uses
// one sequence word per
// slot and 64-bit acquire/release/CAS operations; it does not invent a
// scheduler, blocking wait, cancellation, fairness, or a lifetime for copied
// handles. A caller that needs waiting can compose this with epoll/futex and
// an explicit policy.

struct ChannelMpmcI64State {
    magic: i64,
    capacity: i64,
    mask: i64,
    enqueue_pos: i64,
    dequeue_pos: i64,
    closed: i64,
    reserved0: i64,
    reserved1: i64,
}

struct ChannelMpmcI64 {
    state: *ChannelMpmcI64State,
    open: i32,
}

struct ChannelMpmcI64Result {
    ok: i32,
    code: i64,
    value: ChannelMpmcI64,
}

struct ChannelMpmcI64OpResult {
    ok: i32,
    code: i64,
    value: i64,
    attempts: i32,
}

fn channel_mpmc_i64_status_ok() i64 { return 0; }
fn channel_mpmc_i64_status_invalid_argument() i64 { return 0 - 7901; }
fn channel_mpmc_i64_status_invalid_state() i64 { return 0 - 7902; }
fn channel_mpmc_i64_status_full() i64 { return 0 - 7903; }
fn channel_mpmc_i64_status_empty() i64 { return 0 - 7904; }
fn channel_mpmc_i64_status_closed() i64 { return 0 - 7905; }
fn channel_mpmc_i64_status_contention() i64 { return 0 - 7906; }
fn channel_mpmc_i64_status_limit() i64 { return 0 - 7907; }

fn channel_mpmc_i64_magic() i64 { return 0x4d504d4349413634; }

fn channel_mpmc_i64_invalid() ChannelMpmcI64 {
    return ChannelMpmcI64{.state=null as *ChannelMpmcI64State,.open=0};
}

fn channel_mpmc_i64_power_of_two(value:i32) i32 {
    if(value<2||value>64){return 0;}
    if(value==2||value==4||value==8||value==16||
       value==32||value==64){return 1;}
    return 0;
}

unsafe fn channel_mpmc_i64_slot(state:*ChannelMpmcI64State,index:i64)*i64 {
    // State occupies 64 bytes. Each slot is { sequence:i64, value:i64 }.
    return ((state as i64)+128+index*16) as *i64;
}

unsafe fn channel_mpmc_i64_cas(pointer:*mut i64,expected:i64,desired:i64)i64 {
    unsafe { return @atomicCompareExchange64Order(pointer,expected,desired,3,1); }
}

fn channel_mpmc_i64_valid(channel:@borrows *ChannelMpmcI64) i32 {
    if(channel==null as *ChannelMpmcI64||channel.*.open==0||
       channel.*.state==null as *ChannelMpmcI64State){return 0;}
    let state:*ChannelMpmcI64State=channel.*.state;
    if(state.*.magic!=channel_mpmc_i64_magic()||
       channel_mpmc_i64_power_of_two(state.*.capacity as i32)==0||
       state.*.mask!=state.*.capacity-1){return 0;}
    return 1;
}

fn channel_mpmc_i64_create(capacity:i32) ChannelMpmcI64Result {
    if(channel_mpmc_i64_power_of_two(capacity)==0){
        return ChannelMpmcI64Result{.ok=0,
            .code=channel_mpmc_i64_status_invalid_argument(),
            .value=channel_mpmc_i64_invalid()};
    }
    let address:i64=_zag_raw_syscall(9,0,4096,3,34,0-1,0);
    if(address<0){
        return ChannelMpmcI64Result{.ok=0,.code=address,
            .value=channel_mpmc_i64_invalid()};
    }
    unsafe {
    let state:*ChannelMpmcI64State=address as *ChannelMpmcI64State;
    state.*.magic=channel_mpmc_i64_magic();
    state.*.capacity=capacity as i64;
    state.*.mask=(capacity-1) as i64;
    state.*.enqueue_pos=0;
    state.*.dequeue_pos=0;
    state.*.closed=0;
    state.*.reserved0=0;
    state.*.reserved1=0;
    let i:i64=0;
    while(i<state.*.capacity){
        let slot:*i64=channel_mpmc_i64_slot(state,i);
        @atomicStore64Order(slot as *mut i64,i,2);
        slot[1]=0;
        i=i+1;
    }
    return ChannelMpmcI64Result{.ok=1,.code=channel_mpmc_i64_status_ok(),
        .value=ChannelMpmcI64{.state=state,.open=1}};
    }
}

fn channel_mpmc_i64_create_into(destination:@borrows_mut *ChannelMpmcI64,
                                capacity:i32) i64 {
    if(destination==null as *ChannelMpmcI64||
       channel_mpmc_i64_power_of_two(capacity)==0){
        return channel_mpmc_i64_status_invalid_argument();
    }
    if(destination.*.open!=0||destination.*.state!=null as *ChannelMpmcI64State){
        return channel_mpmc_i64_status_invalid_state();
    }
    let address:i64=_zag_raw_syscall(9,0,4096,3,34,0-1,0);
    if(address<0){return address;}
    unsafe {
    let state:*ChannelMpmcI64State=address as *ChannelMpmcI64State;
    state.*.magic=channel_mpmc_i64_magic();
    state.*.capacity=capacity as i64;
    state.*.mask=(capacity-1) as i64;
    state.*.enqueue_pos=0;state.*.dequeue_pos=0;state.*.closed=0;
    state.*.reserved0=0;state.*.reserved1=0;
    let i:i64=0;
    while(i<state.*.capacity){
        let slot:*i64=channel_mpmc_i64_slot(state,i);
        @atomicStore64Order(slot as *mut i64,i,2);slot[1]=0;i=i+1;
    }
    destination.*.state=state;destination.*.open=1;
    return channel_mpmc_i64_status_ok();
    }
}

fn channel_mpmc_i64_take(result:@retained_by_return *ChannelMpmcI64Result)
    ChannelMpmcI64 {
    if(result==null as *ChannelMpmcI64Result||result.*.ok==0||
       result.*.value.open==0){return channel_mpmc_i64_invalid();}
    let value:ChannelMpmcI64=result.*.value;
    result.*.ok=0;
    result.*.code=channel_mpmc_i64_status_invalid_state();
    result.*.value=channel_mpmc_i64_invalid();
    return value;
}

fn channel_mpmc_i64_try_send(channel:@borrows_mut *ChannelMpmcI64,
                             value:i64) ChannelMpmcI64OpResult {
    if(channel_mpmc_i64_valid(channel)==0){
        return ChannelMpmcI64OpResult{.ok=0,
            .code=channel_mpmc_i64_status_invalid_state(),.value=0,.attempts=0};
    }
    unsafe {
    let state_address:i64=channel.*.state as i64;
    let state:*ChannelMpmcI64State=state_address as *ChannelMpmcI64State;
    let closed_pointer:*const i64=(&state.*.closed) as *const i64;
    if(@atomicLoad64Order(closed_pointer,1)!=0){
        return ChannelMpmcI64OpResult{.ok=0,.code=channel_mpmc_i64_status_closed(),
            .value=0,.attempts=0};
    }
    let enqueue_pointer:*mut i64=(&state.*.enqueue_pos) as *mut i64;
    let enqueue_read:*const i64=enqueue_pointer as *const i64;
    let pos:i64=@atomicLoad64Order(enqueue_read,0);
    let attempt:i32=0;
    while(attempt<128){
        if(pos>9223372036854775000){
            return ChannelMpmcI64OpResult{.ok=0,.code=channel_mpmc_i64_status_limit(),
                .value=0,.attempts=attempt};
        }
        let slot:*i64=channel_mpmc_i64_slot(state,pos&state.*.mask);
        let sequence:i64=@atomicLoad64Order(slot as *const i64,1);
        let difference:i64=sequence-pos;
        if(difference==0){
            let observed:i64=channel_mpmc_i64_cas(enqueue_pointer,pos,pos+1);
            if(observed==pos){
                slot[1]=value;
                @atomicStore64Order(slot as *mut i64,pos+1,2);
                return ChannelMpmcI64OpResult{.ok=1,
                    .code=channel_mpmc_i64_status_ok(),.value=0,
                    .attempts=attempt+1};
            }
            pos=observed;
        }else if(difference<0){
            return ChannelMpmcI64OpResult{.ok=0,.code=channel_mpmc_i64_status_full(),
                .value=0,.attempts=attempt+1};
        }else{
            pos=@atomicLoad64Order(enqueue_read,0);
        }
        attempt=attempt+1;
    }
    return ChannelMpmcI64OpResult{.ok=0,.code=channel_mpmc_i64_status_contention(),
        .value=0,.attempts=attempt};
    }
}

fn channel_mpmc_i64_try_receive(channel:@borrows_mut *ChannelMpmcI64)
    ChannelMpmcI64OpResult {
    if(channel_mpmc_i64_valid(channel)==0){
        return ChannelMpmcI64OpResult{.ok=0,
            .code=channel_mpmc_i64_status_invalid_state(),.value=0,.attempts=0};
    }
    unsafe {
    let state_address:i64=channel.*.state as i64;
    let state:*ChannelMpmcI64State=state_address as *ChannelMpmcI64State;
    let dequeue_pointer:*mut i64=(&state.*.dequeue_pos) as *mut i64;
    let dequeue_read:*const i64=dequeue_pointer as *const i64;
    let pos:i64=@atomicLoad64Order(dequeue_read,0);
    let attempt:i32=0;
    while(attempt<128){
        if(pos>9223372036854775000){
            return ChannelMpmcI64OpResult{.ok=0,.code=channel_mpmc_i64_status_limit(),
                .value=0,.attempts=attempt};
        }
        let slot:*i64=channel_mpmc_i64_slot(state,pos&state.*.mask);
        let sequence:i64=@atomicLoad64Order(slot as *const i64,1);
        let difference:i64=sequence-(pos+1);
        if(difference==0){
            let observed:i64=channel_mpmc_i64_cas(dequeue_pointer,pos,pos+1);
            if(observed==pos){
                let value:i64=slot[1];
                @atomicStore64Order(slot as *mut i64,pos+state.*.mask+1,2);
                return ChannelMpmcI64OpResult{.ok=1,
                    .code=channel_mpmc_i64_status_ok(),.value=value,
                    .attempts=attempt+1};
            }
            pos=observed;
        }else if(difference<0){
            return ChannelMpmcI64OpResult{.ok=0,.code=channel_mpmc_i64_status_empty(),
                .value=0,.attempts=attempt+1};
        }else{
            pos=@atomicLoad64Order(dequeue_read,0);
        }
        attempt=attempt+1;
    }
    return ChannelMpmcI64OpResult{.ok=0,.code=channel_mpmc_i64_status_contention(),
        .value=0,.attempts=attempt};
    }
}

fn channel_mpmc_i64_close(channel:@borrows_mut *ChannelMpmcI64) i64 {
    if(channel_mpmc_i64_valid(channel)==0){
        return channel_mpmc_i64_status_invalid_state();
    }
    unsafe {
    let state_address:i64=channel.*.state as i64;
    let state:*ChannelMpmcI64State=state_address as *ChannelMpmcI64State;
    let closed_pointer:*mut i64=(&state.*.closed) as *mut i64;
    @atomicStore64Order(closed_pointer,1,2);
    let rc:i64=_zag_raw_syscall(11,state as i64,4096,0,0,0,0);
    if(rc==0){channel.*.state=null as *ChannelMpmcI64State;channel.*.open=0;}
    return rc;
    }
}
