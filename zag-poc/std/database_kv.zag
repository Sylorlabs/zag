// std/database_kv.zag -- bounded scalar database-driver contract.
//
// This is intentionally not a general SQL, document, or persistence API.  A
// conforming driver stores at most 64 i64 key/value pairs and reports every
// operation with one of the status functions below.  `get` and `count`
// implementations zero their output before returning a non-OK status.

fn database_kv_ok() i32 { return 0; }
fn database_kv_missing() i32 { return 1; }
fn database_kv_invalid() i32 { return 2; }
fn database_kv_limit() i32 { return 3; }
fn database_kv_backend_error() i32 { return 4; }

fn database_kv_max_capacity() i32 { return 64; }

fn database_kv_capacity_valid(capacity: i32) bool {
    return capacity > 0 && capacity <= database_kv_max_capacity();
}
