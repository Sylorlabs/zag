// std/dynamic_plugin.zag -- bounded Linux x86-64 runtime plugin loading.
//
// This deliberately supports one ABI only: a C function `i64 fn(i64)` from a
// caller-selected shared object.  The loader owns an internal two-word native
// function carrier until `dynamic_plugin_close`; callers cannot obtain or keep
// the raw symbol address.  Build consumers explicitly with:
//
//   znc app.zag --dynamic --needed libdl.so.2 -o app
//
// This is not a general shared-library, aggregate, callback, thread-safe, or
// hot-reload interface.

@import("rt.zag")

extern fn dlopen(filename: *u8, flags: i32) *u8 @io;
extern fn dlsym(handle: *u8, symbol: *u8) *u8 @io;
extern fn dlclose(handle: *u8) i32 @io;

fn dynamic_plugin_ok() i32 { return 0; }
fn dynamic_plugin_invalid() i32 { return 1; }
fn dynamic_plugin_open_failed() i32 { return 2; }
fn dynamic_plugin_symbol_failed() i32 { return 3; }
fn dynamic_plugin_close_failed() i32 { return 4; }

struct DynamicPluginI64 {
    handle: *u8,
    closure: *i64,
    open: i32,
    status: i32,
}

fn dynamic_plugin_empty(status: i32) DynamicPluginI64 {
    return DynamicPluginI64{
        .handle = null as *u8,
        .closure = null as *i64,
        .open = 0,
        .status = status,
    };
}

fn dynamic_plugin_path_valid(path: []u8) bool {
    if (path.len <= 0 || path.len > 4096) { return false; }
    let i: i32 = 0;
    while (i < path.len) {
        if (path[i] == 0) { return false; }
        i = i + 1;
    }
    return true;
}

fn dynamic_plugin_symbol_valid(symbol: []u8) bool {
    if (symbol.len <= 0 || symbol.len > 255) { return false; }
    let i: i32 = 0;
    while (i < symbol.len) {
        let c: u8 = symbol[i];
        let letter: bool = (c >= 'a' && c <= 'z') ||
            (c >= 'A' && c <= 'Z');
        let digit: bool = c >= '0' && c <= '9';
        if (!(letter || c == '_' || (i > 0 && digit))) { return false; }
        i = i + 1;
    }
    return true;
}

fn dynamic_plugin_c_string(text: []u8) *u8 {
    let result: *u8 = _zag_malloc(text.len + 1) as *u8;
    let i: i32 = 0;
    while (i < text.len) {
        result[i] = text[i];
        i = i + 1;
    }
    result[text.len] = 0;
    return result;
}

fn dynamic_plugin_load_i64(path: []u8, symbol: []u8) DynamicPluginI64 {
    if (!dynamic_plugin_path_valid(path) ||
        !dynamic_plugin_symbol_valid(symbol)) {
        return dynamic_plugin_empty(dynamic_plugin_invalid());
    }

    let c_path: *u8 = dynamic_plugin_c_string(path);
    // RTLD_NOW.  Lazy relocation would defer a malformed plugin failure until
    // the first call, outside the bounded construction result.
    let handle: *u8 = dlopen(c_path, 2);
    _zag_free(c_path as *i8);
    if (handle == null as *u8) {
        return dynamic_plugin_empty(dynamic_plugin_open_failed());
    }

    let c_symbol: *u8 = dynamic_plugin_c_string(symbol);
    let address: *u8 = dlsym(handle, c_symbol);
    _zag_free(c_symbol as *i8);
    if (address == null as *u8) {
        dlclose(handle);
        return dynamic_plugin_empty(dynamic_plugin_symbol_failed());
    }

    // Native Zag function values are a bounded {code, environment} carrier.
    // A C i64(i64) symbol has no environment, so the second word is zero.
    let closure: *i64 = _zag_malloc(16) as *i64;
    closure[0] = address as i64;
    closure[1] = 0;
    return DynamicPluginI64{
        .handle = handle,
        .closure = closure,
        .open = 1,
        .status = dynamic_plugin_ok(),
    };
}

fn dynamic_plugin_call_i64(plugin: *DynamicPluginI64, input: i64,
    output: *i64) i32 {
    if (plugin == null as *DynamicPluginI64 || output == null as *i64) {
        return dynamic_plugin_invalid();
    }
    output.* = 0;
    if (plugin.*.open == 0 || plugin.*.handle == null as *u8 ||
        plugin.*.closure == null as *i64) {
        return dynamic_plugin_invalid();
    }
    let entry: fn(i64) i64 = plugin.*.closure as fn(i64) i64;
    output.* = entry(input);
    return dynamic_plugin_ok();
}

fn dynamic_plugin_close(plugin: *DynamicPluginI64) i32 {
    if (plugin == null as *DynamicPluginI64 || plugin.*.open == 0 ||
        plugin.*.handle == null as *u8 ||
        plugin.*.closure == null as *i64) {
        return dynamic_plugin_invalid();
    }
    if (dlclose(plugin.*.handle) != 0) {
        plugin.*.status = dynamic_plugin_close_failed();
        return dynamic_plugin_close_failed();
    }
    _zag_free(plugin.*.closure as *i8);
    plugin.*.handle = null as *u8;
    plugin.*.closure = null as *i64;
    plugin.*.open = 0;
    plugin.*.status = dynamic_plugin_ok();
    return dynamic_plugin_ok();
}
