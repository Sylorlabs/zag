// std/os_linux.zag -- bounded Linux x86-64 clock and entropy services.
//
// These calls go directly to the Linux kernel.  Secure randomness is supplied
// only by getrandom(2); there is deliberately no timestamp, PRNG, device-file,
// or partial-success fallback.  Callers retain ownership of every buffer.

@import("rt.zag")

struct OsLinuxTimespec {
    seconds: i64,
    nanoseconds: i64,
}

struct OsLinuxClockResult {
    ok: i32,
    code: i64,
    seconds: i64,
    nanoseconds: i64,
}

struct OsLinuxRandomResult {
    ok: i32,
    code: i64,
    transferred: i32,
    calls: i32,
}

fn os_linux_status_ok() i64 { return 0; }
fn os_linux_status_invalid_argument() i64 { return 0 - 7201; }
fn os_linux_status_limit() i64 { return 0 - 7202; }
fn os_linux_status_incomplete() i64 { return 0 - 7203; }
fn os_linux_status_kernel_contract() i64 { return 0 - 7204; }

fn os_linux_clock_realtime() i32 { return 0; }
fn os_linux_clock_monotonic() i32 { return 1; }
fn os_linux_random_max_bytes() i32 { return 65536; }
fn os_linux_random_max_calls() i32 { return 128; }

fn os_linux_clock_failure(code: i64) OsLinuxClockResult {
    return OsLinuxClockResult{
        .ok = 0, .code = code, .seconds = 0, .nanoseconds = 0,
    };
}

fn os_linux_clock_read(clock_id: i32) OsLinuxClockResult {
    if (clock_id != os_linux_clock_realtime() &&
        clock_id != os_linux_clock_monotonic()) {
        return os_linux_clock_failure(os_linux_status_invalid_argument());
    }
    let value: OsLinuxTimespec = OsLinuxTimespec{
        .seconds = 0, .nanoseconds = 0,
    };
    let rc: i64 = _zag_raw_syscall(
        228, clock_id as i64, (&value) as i64, 0, 0, 0, 0
    );
    if (rc < 0) { return os_linux_clock_failure(rc); }
    if (rc != 0 || value.nanoseconds < 0 || value.nanoseconds >= 1000000000) {
        return os_linux_clock_failure(os_linux_status_kernel_contract());
    }
    return OsLinuxClockResult{
        .ok = 1,
        .code = os_linux_status_ok(),
        .seconds = value.seconds,
        .nanoseconds = value.nanoseconds,
    };
}

fn os_linux_realtime() OsLinuxClockResult {
    return os_linux_clock_read(os_linux_clock_realtime());
}

fn os_linux_monotonic() OsLinuxClockResult {
    return os_linux_clock_read(os_linux_clock_monotonic());
}

fn os_linux_random_failure(code: i64, transferred: i32,
                           calls: i32) OsLinuxRandomResult {
    return OsLinuxRandomResult{
        .ok = 0, .code = code, .transferred = transferred, .calls = calls,
    };
}

fn os_linux_secure_random_fill_bounded(output: []u8,
                                       max_calls: i32) OsLinuxRandomResult {
    if (output.len <= 0 || max_calls <= 0 ||
        max_calls > os_linux_random_max_calls()) {
        return os_linux_random_failure(os_linux_status_invalid_argument(), 0, 0);
    }
    if (output.len > os_linux_random_max_bytes()) {
        return os_linux_random_failure(os_linux_status_limit(), 0, 0);
    }

    let base: *i8 = _zag_slice_ptr(output);
    if (base == null as *i8) {
        return os_linux_random_failure(os_linux_status_invalid_argument(), 0, 0);
    }
    let transferred: i32 = 0;
    let calls: i32 = 0;
    while (transferred < output.len && calls < max_calls) {
        let remaining: i32 = output.len - transferred;
        let rc: i64 = _zag_raw_syscall(
            318, (base as i64) + transferred, remaining as i64, 0, 0, 0, 0
        );
        calls = calls + 1;
        if (rc == (0 - 4)) { // EINTR: bounded retry.
            continue;
        }
        if (rc < 0) {
            return os_linux_random_failure(rc, transferred, calls);
        }
        if (rc == 0) {
            return os_linux_random_failure(
                os_linux_status_incomplete(), transferred, calls
            );
        }
        if (rc > remaining as i64) {
            return os_linux_random_failure(
                os_linux_status_kernel_contract(), transferred, calls
            );
        }
        transferred = transferred + rc as i32;
    }
    if (transferred != output.len) {
        return os_linux_random_failure(
            os_linux_status_incomplete(), transferred, calls
        );
    }
    return OsLinuxRandomResult{
        .ok = 1,
        .code = os_linux_status_ok(),
        .transferred = transferred,
        .calls = calls,
    };
}

fn os_linux_secure_random_fill(output: []u8) OsLinuxRandomResult {
    return os_linux_secure_random_fill_bounded(
        output, os_linux_random_max_calls()
    );
}
