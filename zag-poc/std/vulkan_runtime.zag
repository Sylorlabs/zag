// std/vulkan_runtime.zag — bounded Vulkan compute runtime for Zag.
//
// This is the executable compatibility adapter for the Vulkan target.  It is
// deliberately scalar at the C ABI boundary: the current v2 ABI does not
// promise aggregate argument marshalling, so Vulkan records are represented
// by ordinary Zag structs whose fields match the 64-bit Linux Vulkan layout.
// The adapter owns the complete bounded path (instance, device, pipeline,
// submit, fence, and readback).  It is not the native direct-DRM backend.

@import("gpu_compat_contract.zag")

extern fn mmap(addr:*u8, len:i64, prot:i32, flags:i32, fd:i32, offset:i64) *u8 @cabi;
extern fn munmap(addr:*u8, len:i64) i32 @cabi @borrows_mut;

// All Vulkan handles and record addresses cross the C ABI as i64.  This keeps
// the import contract explicit and avoids pretending that a Zag aggregate is a
// portable C ABI aggregate.
extern fn vkCreateInstance(info:i64, allocator:i64, instance:i64) i32 @cabi;
extern fn vkDestroyInstance(instance:i64, allocator:i64) void @cabi;
extern fn vkEnumeratePhysicalDevices(instance:i64, count:i64, devices:i64) i32 @cabi;
extern fn vkGetPhysicalDeviceQueueFamilyProperties(physical:i64, count:i64, props:i64) void @cabi;
extern fn vkCreateDevice(physical:i64, info:i64, allocator:i64, device:i64) i32 @cabi;
extern fn vkDestroyDevice(device:i64, allocator:i64) void @cabi;
extern fn vkGetDeviceQueue(device:i64, family:u32, index:u32, queue:i64) void @cabi;
extern fn vkCreateCommandPool(device:i64, info:i64, allocator:i64, pool:i64) i32 @cabi;
extern fn vkDestroyCommandPool(device:i64, pool:i64, allocator:i64) void @cabi;
extern fn vkAllocateCommandBuffers(device:i64, info:i64, buffers:i64) i32 @cabi;
extern fn vkFreeCommandBuffers(device:i64, pool:i64, count:u32, buffers:i64) void @cabi;
extern fn vkBeginCommandBuffer(command:i64, info:i64) i32 @cabi;
extern fn vkEndCommandBuffer(command:i64) i32 @cabi;
extern fn vkCmdBindPipeline(command:i64, bind_point:u32, pipeline:u64) void @cabi;
extern fn vkCmdBindDescriptorSets(command:i64, bind_point:u32, layout:u64, first_set:u32, set_count:u32, sets:i64, dynamic_count:u32, dynamics:i64) void @cabi;
extern fn vkCmdPushConstants(command:i64, layout:u64, stages:u32, offset:u32, size:u32, values:i64) void @cabi;
extern fn vkCmdDispatch(command:i64, x:u32, y:u32, z:u32) void @cabi;
extern fn vkCreateBuffer(device:i64, info:i64, allocator:i64, buffer:i64) i32 @cabi;
extern fn vkDestroyBuffer(device:i64, buffer:u64, allocator:i64) void @cabi;
extern fn vkGetBufferMemoryRequirements(device:i64, buffer:u64, req:i64) void @cabi;
extern fn vkBindBufferMemory(device:i64, buffer:u64, memory:u64, offset:u64) i32 @cabi;
extern fn vkAllocateMemory(device:i64, info:i64, allocator:i64, memory:i64) i32 @cabi;
extern fn vkFreeMemory(device:i64, memory:u64, allocator:i64) void @cabi;
extern fn vkGetPhysicalDeviceMemoryProperties(physical:i64, props:i64) void @cabi;
extern fn vkMapMemory(device:i64, memory:i64, offset:i64, size:i64, flags:i64, mapped:i64) i32 @cabi;
extern fn vkUnmapMemory(device:i64, memory:i64) void @cabi;
extern fn vkCreateShaderModule(device:i64, info:i64, allocator:i64, shader:i64) i32 @cabi;
extern fn vkDestroyShaderModule(device:i64, shader:u64, allocator:i64) void @cabi;
extern fn vkCreateDescriptorSetLayout(device:i64, info:i64, allocator:i64, layout:i64) i32 @cabi;
extern fn vkDestroyDescriptorSetLayout(device:i64, layout:u64, allocator:i64) void @cabi;
extern fn vkCreatePipelineLayout(device:i64, info:i64, allocator:i64, layout:i64) i32 @cabi;
extern fn vkDestroyPipelineLayout(device:i64, layout:u64, allocator:i64) void @cabi;
extern fn vkCreateComputePipelines(device:i64, cache:i64, count:i64, info:i64, allocator:i64, pipeline:i64) i32 @cabi;
extern fn vkDestroyPipeline(device:i64, pipeline:u64, allocator:i64) void @cabi;
extern fn vkCreateDescriptorPool(device:i64, info:i64, allocator:i64, pool:i64) i32 @cabi;
extern fn vkDestroyDescriptorPool(device:i64, pool:u64, allocator:i64) void @cabi;
extern fn vkAllocateDescriptorSets(device:i64, info:i64, sets:i64) i32 @cabi;
extern fn vkUpdateDescriptorSets(device:i64, writes:i64, info:i64, copies:i64, copy_info:i64) void @cabi;
extern fn vkCreateFence(device:i64, info:i64, allocator:i64, fence:i64) i32 @cabi;
extern fn vkDestroyFence(device:i64, fence:u64, allocator:i64) void @cabi;
extern fn vkQueueSubmit(queue:i64, submits:i64, info:i64, fence:i64) i32 @cabi;
extern fn vkWaitForFences(device:i64, fences:i64, fence:i64, wait_all:i64, timeout:i64) i32 @cabi;
extern fn vkDeviceWaitIdle(device:i64) i32 @cabi;

struct ZagVulkanCompatContext {
    instance:i64,
    physical:i64,
    device:i64,
    queue:i64,
    queue_family:u32,
    command_pool:i64,
    available:bool,
    error_code:i32,
}

// A record whose slots are exactly the x86-64 Vulkan ABI slots.  The low and
// high halves of packed slots contain adjacent u32 fields where Vulkan has
// those fields next to one another.
struct VkInstanceInfo { s_type:i64, p_next:i64, flags:i64, app:i64, layer_count:i64, layers:i64, ext_count:i64, exts:i64 }
struct VkQueueInfo { s_type:i64, p_next:i64, flags_family:i64, queue_count:i64, priorities:i64 }
struct VkDeviceInfo { s_type:i64, p_next:i64, flags_count:i64, queues:i64, layer_count:i64, layers:i64, ext_count:i64, exts:i64, features:i64 }
struct VkCommandPoolInfo { s_type:i64, p_next:i64, flags_family:i64 }
struct VkMemoryReq { size:i64, alignment:i64, type_bits:i64 }
struct VkMemoryAlloc { s_type:i64, p_next:i64, size:i64, type_index:i64 }
struct VkDescriptorBinding { binding_type:i64, count_stage:i64, immutable:i64 }
struct VkComputePipelineInfo { s_type:i64, p_next:i64, flags:i64, stage_s_type:i64, stage_p_next:i64, stage_flags_stage:i64, stage_module:i64, stage_name:i64, stage_spec:i64, layout:i64, base_handle:i64, base_index:i64 }
struct VkSubmitInfo { s_type:i64, p_next:i64, wait_count:i64, wait_sems:i64, wait_stages:i64, command_count:i64, commands:i64, signal_count:i64, signal_sems:i64 }

fn vk_pack2(low:i64, high:i64) i64 { return low + high * 4294967296; }
fn vk_ok(rc:i32) bool { return rc == 0; }

fn zag_vulkan_compat_open() ZagVulkanCompatContext @compatLoad {
    let ctx:ZagVulkanCompatContext=ZagVulkanCompatContext{.instance=0,.physical=0,.device=0,.queue=0,.queue_family=0,.command_pool=0,.available=false,.error_code=0};
    unsafe {
        let ici:VkInstanceInfo=VkInstanceInfo{.s_type=1,.p_next=0,.flags=0,.app=0,.layer_count=0,.layers=0,.ext_count=0,.exts=0};
        let rc:i32=vkCreateInstance((&ici) as i64,0,(&ctx.instance) as i64);
        if (!vk_ok(rc)) { ctx.error_code=rc; return ctx; }
        let count:u32=0;
        let rc_count:i32=vkEnumeratePhysicalDevices(ctx.instance,(&count) as i64,0);
        if (!vk_ok(rc_count)||count==0) { vkDestroyInstance(ctx.instance,0); ctx.instance=0; ctx.error_code=-100; return ctx; }
        let physical:i64=0;
        let rc_devices:i32=vkEnumeratePhysicalDevices(ctx.instance,(&count) as i64,(&physical) as i64);
        if (!vk_ok(rc_devices)) { vkDestroyInstance(ctx.instance,0); ctx.instance=0; ctx.error_code=-101; return ctx; }
        ctx.physical=physical;
        let qcount:u32=0;
        vkGetPhysicalDeviceQueueFamilyProperties(physical,(&qcount) as i64,0);
        if (qcount==0) { vkDestroyInstance(ctx.instance,0); ctx.instance=0; ctx.error_code=-102; return ctx; }
        let qmem:*u8=mmap(null as *u8,(qcount as i64)*24,3,34,-1,0);
        vkGetPhysicalDeviceQueueFamilyProperties(physical,(&qcount) as i64,qmem as i64);
        let qwords:*i64=qmem as *i64;
        let qf:u32=0;
        let qi:u32=0;
        while (qi<qcount) {
            if ((qwords[(qi as i32)*3] & 2)!=0 && qwords[(qi as i32)*3+1]>0) { qf=qi; break; }
            qi=qi+1;
        }
        ctx.queue_family=qf;
        munmap(qmem,(qcount as i64)*24);
        let priority:i32=1065353216;
        let qci:VkQueueInfo=VkQueueInfo{.s_type=2,.p_next=0,.flags_family=vk_pack2(0,qf as i64),.queue_count=1,.priorities=(&priority) as i64};
        let dci:VkDeviceInfo=VkDeviceInfo{.s_type=3,.p_next=0,.flags_count=vk_pack2(0,1),.queues=(&qci) as i64,.layer_count=0,.layers=0,.ext_count=0,.exts=0,.features=0};
        let device:i64=0;
        let rc_device:i32=vkCreateDevice(physical,(&dci) as i64,0,(&device) as i64);
        if (!vk_ok(rc_device)) { vkDestroyInstance(ctx.instance,0); ctx.instance=0; ctx.error_code=rc_device; return ctx; }
        ctx.device=device;
        vkGetDeviceQueue(device,qf,0,(&ctx.queue) as i64);
        let cpci:VkCommandPoolInfo=VkCommandPoolInfo{.s_type=39,.p_next=0,.flags_family=vk_pack2(0,qf as i64)};
        let pool:i64=0;
        let rc_pool:i32=vkCreateCommandPool(device,(&cpci) as i64,0,(&pool) as i64);
        if (!vk_ok(rc_pool)) { vkDestroyDevice(device,0); ctx.device=0; vkDestroyInstance(ctx.instance,0); ctx.instance=0; ctx.error_code=rc_pool; return ctx; }
        ctx.command_pool=pool;
        ctx.available=true;
        return ctx;
    }
}

fn zag_vulkan_compat_close(ctx:*ZagVulkanCompatContext) void @compatLoad {
    unsafe {
        if (ctx.device!=0) { vkDeviceWaitIdle(ctx.device); }
        if (ctx.command_pool!=0) { vkDestroyCommandPool(ctx.device,ctx.command_pool,0); ctx.command_pool=0; }
        if (ctx.device!=0) { vkDestroyDevice(ctx.device,0); ctx.device=0; }
        if (ctx.instance!=0) { vkDestroyInstance(ctx.instance,0); ctx.instance=0; }
        ctx.available=false;
    }
}

// Resources used by one dispatch.  Defer invokes the cleanup helper even on
// an early error, which makes every failed Vulkan result a bounded cleanup.
struct VkDispatchResources {
    shader:u64, buffer:u64, memory:u64, set_layout:u64, pipeline_layout:u64,
    pipeline:u64, descriptor_pool:u64, descriptor_set:u64, command:u64, fence:u64,
}

fn vk_dispatch_cleanup(ctx:*ZagVulkanCompatContext, r:*VkDispatchResources) void {
    unsafe {
        if (r.fence!=0) { vkDestroyFence(ctx.device,r.fence,0); r.fence=0; }
        if (r.command!=0) { vkFreeCommandBuffers(ctx.device,ctx.command_pool,1,(&r.command) as i64); r.command=0; }
        if (r.descriptor_pool!=0) { vkDestroyDescriptorPool(ctx.device,r.descriptor_pool,0); r.descriptor_pool=0; }
        if (r.pipeline!=0) { vkDestroyPipeline(ctx.device,r.pipeline,0); r.pipeline=0; }
        if (r.pipeline_layout!=0) { vkDestroyPipelineLayout(ctx.device,r.pipeline_layout,0); r.pipeline_layout=0; }
        if (r.set_layout!=0) { vkDestroyDescriptorSetLayout(ctx.device,r.set_layout,0); r.set_layout=0; }
        if (r.memory!=0) { vkFreeMemory(ctx.device,r.memory,0); r.memory=0; }
        if (r.buffer!=0) { vkDestroyBuffer(ctx.device,r.buffer,0); r.buffer=0; }
        if (r.shader!=0) { vkDestroyShaderModule(ctx.device,r.shader,0); r.shader=0; }
    }
}

// Execute the canonical bounded storage-buffer dispatch.  The shader is the
// Vulkan SPIR-V emitted by `znc --target vulkan-compat`; push_constants holds
// its two i32 values and output_buffer receives the checked readback.
fn zag_vulkan_compat_dispatch(ctx:*ZagVulkanCompatContext, spirv_code:*u8, spirv_word_count:u32, output_buffer:*i32, output_count:u32, push_constants:*u8, push_constant_size:u32, group_count_x:u32, group_count_y:u32, group_count_z:u32, timeout_ns:u64) i32 @compatDispatch {
    if (!ctx.available) { return -200; }
    if (spirv_code==null as *u8 || spirv_word_count==0 || spirv_word_count>1048576) { return -201; }
    let contract_rc:i32=zag_gpu_compat_validate(
        ZagGpuCompatReadback{.output_buffer=output_buffer,.output_count=output_count},
        ZagGpuCompatLaunch{.group_count_x=group_count_x,.group_count_y=group_count_y,.group_count_z=group_count_z,.local_work_size=0,.timeout_ns=timeout_ns});
    if (contract_rc!=0) { return contract_rc; }
    if (push_constant_size>128 || (push_constant_size>0 && push_constants==null as *u8)) { return -203; }
    let r:VkDispatchResources=VkDispatchResources{.shader=0,.buffer=0,.memory=0,.set_layout=0,.pipeline_layout=0,.pipeline=0,.descriptor_pool=0,.descriptor_set=0,.command=0,.fence=0};
    defer vk_dispatch_cleanup(ctx,&r);
    unsafe {
        let smci:VkInstanceInfo=VkInstanceInfo{.s_type=15,.p_next=0,.flags=0,.app=(spirv_word_count as i64)*4,.layer_count=spirv_code as i64,.layers=0,.ext_count=0,.exts=0};
        let rc_sm:i32=vkCreateShaderModule(ctx.device,(&smci) as i64,0,(&r.shader) as i64);
        if (!vk_ok(rc_sm)) { return rc_sm; }
        let bci:VkDeviceInfo=VkDeviceInfo{.s_type=12,.p_next=0,.flags_count=0,.queues=(output_count as i64)*4,.layer_count=131072,.layers=0,.ext_count=0,.exts=0,.features=0};
        let rc_buf:i32=vkCreateBuffer(ctx.device,(&bci) as i64,0,(&r.buffer) as i64);
        if (!vk_ok(rc_buf)) { return rc_buf; }
        let req:VkMemoryReq=VkMemoryReq{.size=0,.alignment=0,.type_bits=0};
        vkGetBufferMemoryRequirements(ctx.device,r.buffer,(&req) as i64);
        let mp:*u8=mmap(null as *u8,1024,3,34,-1,0);
        vkGetPhysicalDeviceMemoryProperties(ctx.physical,mp as i64);
        let type_props:*i64=(mp as i64+4) as *i64;
        let type_bits:u32=req.type_bits as u32;
        let mem_type:u32=0;
        let mi:u32=0;
        while (mi<32) {
            if ((type_bits & (1<<mi))!=0 && (type_props[mi as i32] & 6)==6) { mem_type=mi; break; }
            mi=mi+1;
        }
        munmap(mp,1024);
        let mai:VkMemoryAlloc=VkMemoryAlloc{.s_type=5,.p_next=0,.size=req.size,.type_index=mem_type as i64};
        let memory_mem:*u8=mmap(null as *u8,8,3,34,-1,0);
        let memory_out:*u64=memory_mem as *u64;
        let rc_mem:i32=vkAllocateMemory(ctx.device,(&mai) as i64,0,memory_mem as i64);
        r.memory=memory_out.*;
        if (!vk_ok(rc_mem)) { return rc_mem; }
        let rc_bind:i32=vkBindBufferMemory(ctx.device,r.buffer,r.memory,0);
        munmap(memory_mem,8);
        if (!vk_ok(rc_bind)) { return rc_bind; }
        let binding:VkDescriptorBinding=VkDescriptorBinding{.binding_type=vk_pack2(0,7),.count_stage=vk_pack2(1,32),.immutable=0};
        let slci:VkDeviceInfo=VkDeviceInfo{.s_type=32,.p_next=0,.flags_count=vk_pack2(0,1),.queues=(&binding) as i64,.layer_count=0,.layers=0,.ext_count=0,.exts=0,.features=0};
        let rc_sl:i32=vkCreateDescriptorSetLayout(ctx.device,(&slci) as i64,0,(&r.set_layout) as i64);
        if (!vk_ok(rc_sl)) { return rc_sl; }
        let pcr:VkQueueInfo=VkQueueInfo{.s_type=vk_pack2(32,0),.p_next=8,.flags_family=0,.queue_count=0,.priorities=0};
        let plci:VkDeviceInfo=VkDeviceInfo{.s_type=30,.p_next=0,.flags_count=vk_pack2(0,1),.queues=(&r.set_layout) as i64,.layer_count=vk_pack2(1,0),.layers=(&pcr) as i64,.ext_count=0,.exts=0,.features=0};
        let rc_pl:i32=vkCreatePipelineLayout(ctx.device,(&plci) as i64,0,(&r.pipeline_layout) as i64);
        if (!vk_ok(rc_pl)) { return rc_pl; }
        let cp_mem:*u8=mmap(null as *u8,128,3,34,-1,0);
        let cp:*i64=cp_mem as *i64;
        let name_mem:*u8=(cp_mem as i64+120) as *u8;
        let name_word:*i64=name_mem as *i64;
        name_word[0]=1852399981;
        cp[0]=28; cp[1]=0; cp[2]=0; cp[3]=18; cp[4]=0; cp[5]=vk_pack2(0,32); cp[6]=r.shader; cp[7]=name_mem as i64; cp[8]=0; cp[9]=r.pipeline_layout; cp[10]=0; cp[11]=0;
        let pipe_mem:*u8=mmap(null as *u8,8,3,34,-1,0);
        let pipe_out:*u64=pipe_mem as *u64;
        let rc_pipe:i32=vkCreateComputePipelines(ctx.device,0,1,cp_mem as i64,0,pipe_mem as i64);
        r.pipeline=pipe_out.*;
        munmap(pipe_mem,8); munmap(cp_mem,128);
        if (!vk_ok(rc_pipe)) { return rc_pipe; }
        let pool_size:VkQueueInfo=VkQueueInfo{.s_type=vk_pack2(7,1),.p_next=0,.flags_family=0,.queue_count=0,.priorities=0};
        let dpci:VkDeviceInfo=VkDeviceInfo{.s_type=33,.p_next=0,.flags_count=vk_pack2(0,1),.queues=vk_pack2(1,0),.layer_count=(&pool_size) as i64,.layers=0,.ext_count=0,.exts=0,.features=0};
        let rc_dp:i32=vkCreateDescriptorPool(ctx.device,(&dpci) as i64,0,(&r.descriptor_pool) as i64);
        if (!vk_ok(rc_dp)) { return rc_dp; }
        let dsai:VkDeviceInfo=VkDeviceInfo{.s_type=34,.p_next=0,.flags_count=r.descriptor_pool,.queues=vk_pack2(1,0),.layer_count=(&r.set_layout) as i64,.layers=0,.ext_count=0,.exts=0,.features=0};
        let rc_ds:i32=vkAllocateDescriptorSets(ctx.device,(&dsai) as i64,(&r.descriptor_set) as i64);
        if (!vk_ok(rc_ds)) { return rc_ds; }
        let db_mem:*u8=mmap(null as *u8,24,3,34,-1,0);
        let db:*i64=db_mem as *i64;
        db[0]=r.buffer; db[1]=0; db[2]=-1;
        let wr_mem:*u8=mmap(null as *u8,64,3,34,-1,0);
        let wr:*i64=wr_mem as *i64;
        wr[0]=35; wr[1]=0; wr[2]=r.descriptor_set; wr[3]=0; wr[4]=vk_pack2(1,7); wr[5]=0; wr[6]=db_mem as i64; wr[7]=0;
        vkUpdateDescriptorSets(ctx.device,1,wr_mem as i64,0,0);
        munmap(wr_mem,64); munmap(db_mem,24);
        let cbai:VkDeviceInfo=VkDeviceInfo{.s_type=40,.p_next=0,.flags_count=ctx.command_pool,.queues=vk_pack2(0,1),.layer_count=(&r.command) as i64,.layers=0,.ext_count=0,.exts=0,.features=0};
        let rc_cb:i32=vkAllocateCommandBuffers(ctx.device,(&cbai) as i64,(&r.command) as i64);
        if (!vk_ok(rc_cb)) { return rc_cb; }
        let begin:VkInstanceInfo=VkInstanceInfo{.s_type=42,.p_next=0,.flags=1,.app=0,.layer_count=0,.layers=0,.ext_count=0,.exts=0};
        let rc_begin:i32=vkBeginCommandBuffer(r.command,(&begin) as i64);
        if (!vk_ok(rc_begin)) { return rc_begin; }
        vkCmdBindPipeline(r.command,1,r.pipeline);
        vkCmdBindDescriptorSets(r.command,1,r.pipeline_layout,0,1,(&r.descriptor_set) as i64,0,0);
        vkCmdPushConstants(r.command,r.pipeline_layout,32,0,push_constant_size,push_constants as i64);
        vkCmdDispatch(r.command,group_count_x,group_count_y,group_count_z);
        let rc_end:i32=vkEndCommandBuffer(r.command);
        if (!vk_ok(rc_end)) { return rc_end; }
        let submit:VkSubmitInfo=VkSubmitInfo{.s_type=4,.p_next=0,.wait_count=0,.wait_sems=0,.wait_stages=0,.command_count=vk_pack2(1,0),.commands=(&r.command) as i64,.signal_count=0,.signal_sems=0};
        let fci:VkCommandPoolInfo=VkCommandPoolInfo{.s_type=8,.p_next=0,.flags_family=0};
        let fence_mem:*u8=mmap(null as *u8,8,3,34,-1,0);
        let fence_out:*u64=fence_mem as *u64;
        let rc_f:i32=vkCreateFence(ctx.device,(&fci) as i64,0,fence_mem as i64);
        r.fence=fence_out.*;
        if (!vk_ok(rc_f)) { munmap(fence_mem,8); return rc_f; }
        let rc_submit:i32=vkQueueSubmit(ctx.queue,1,(&submit) as i64,r.fence as i64);
        if (!vk_ok(rc_submit)) { munmap(fence_mem,8); return rc_submit; }
        let wait:u64=timeout_ns;
        if (wait==0) { wait=1000000000; }
        let rc_wait:i32=vkWaitForFences(ctx.device,1,fence_mem as i64,1,wait as i64);
        if (!vk_ok(rc_wait)) { munmap(fence_mem,8); return rc_wait; }
        munmap(fence_mem,8);
        let mapped_mem:*u8=mmap(null as *u8,8,3,34,-1,0);
        let mapped_out:*u64=mapped_mem as *u64;
        let mapped:i64=0;
        let rc_map:i32=vkMapMemory(ctx.device,r.memory as i64,0,(output_count as i64)*4,0,mapped_mem as i64);
        mapped=mapped_out.* as i64;
        if (!vk_ok(rc_map)) { munmap(mapped_mem,8); return rc_map; }
        let src:*u8=mapped as *u8;
        let dst:*u8=output_buffer as *u8;
        let oi:u32=0;
        while (oi<output_count) {
            let si:i32=(oi as i32)*4;
            let di:i32=(oi as i32)*8;
            dst[di]=src[si]; dst[di+1]=src[si+1]; dst[di+2]=src[si+2]; dst[di+3]=src[si+3];
            dst[di+4]=0; dst[di+5]=0; dst[di+6]=0; dst[di+7]=0;
            oi=oi+1;
        }
        vkUnmapMemory(ctx.device,r.memory as i64);
        munmap(mapped_mem,8);
        vkDeviceWaitIdle(ctx.device);
        return 0;
    }
}

fn zag_vulkan_compat_available() bool @compatLoad {
    let ctx:ZagVulkanCompatContext=zag_vulkan_compat_open();
    let ok:bool=ctx.available;
    zag_vulkan_compat_close(&ctx);
    return ok;
}
