// std/worker_pool_i64.zag -- bounded Linux/x86-64 worker-pool foundation.
//
// The pool accepts a borrowed i64 slice, schedules at most eight captureless
// workers over at most 64 jobs, and joins every worker before returning.  Jobs
// claim disjoint indexes with an atomic fetch-add; the aggregate result is
// accumulated with an atomic fetch-add.  The caller owns the input slice and
// must keep it alive until this call returns.
//
// This is deliberately not a language async/await runtime, scheduler, MPMC
// channel, general cancellation system, or proof that arbitrary shared code
// is race free.  Its optional cancellation entry point is only cooperative
// and one-shot.  It is a synchronous, Linux/x86-64, i64-only pool with
// explicit bounds.

@import("std:rt")
@import("std:cancel_token_i64") as cancel

pub struct WorkerPoolI64Context {
    jobs: *i64,
    count: i64,
    next_index: i64,
    completed: i64,
    total: i64,
    gate: i32,
    failed: i32,
    cancel_address: i64,
    cancelled: i64,
}

pub struct WorkerPoolI64Result {
    ok: i32,
    code: i64,
    completed: i32,
    workers: i32,
    total: i64,
}

pub fn worker_pool_i64_status_ok() i64 { return 0; }
pub fn worker_pool_i64_status_invalid_argument() i64 { return 0 - 7801; }
pub fn worker_pool_i64_status_spawn_failed() i64 { return 0 - 7802; }
pub fn worker_pool_i64_status_join_failed() i64 { return 0 - 7803; }
pub fn worker_pool_i64_status_incomplete() i64 { return 0 - 7804; }
pub fn worker_pool_i64_status_cancelled() i64 { return 0 - 7805; }

fn worker_pool_i64_invalid() WorkerPoolI64Result {
    return WorkerPoolI64Result{
        .ok = 0, .code = worker_pool_i64_status_invalid_argument(),
        .completed = 0, .workers = 0, .total = 0,
    };
}

fn worker_pool_i64_worker(context_address: i64) void {
    let context: *WorkerPoolI64Context = null as *WorkerPoolI64Context;
    unsafe { context = context_address as *WorkerPoolI64Context; }
    if (context == null as *WorkerPoolI64Context) { return; }
    unsafe {
        let gate: *mut i32 = (&context.*.gate) as *mut i32;
        let _wait: i64 = @atomicWait32(gate, 0);
        while (1) {
            if (context.*.cancel_address != 0) {
                let cancel_word: *i64 = null as *i64;
                unsafe { cancel_word = context.*.cancel_address as *i64; }
                let requested: i64 = @atomicLoad64Order(
                    cancel_word as *const i64, 1);
                if (requested != 0) {
                    @atomicStore64Order((&context.*.cancelled) as *mut i64, 1, 2);
                    return;
                }
            }
            let next: *mut i64 = (&context.*.next_index) as *mut i64;
            let index: i64 = @atomicFetchAdd64(next, 1);
            if (index >= context.*.count) { return; }
            let value: i64 = context.*.jobs[index as i32];
            let square_plus_one: i64 = value * value + 1;
            let total: *mut i64 = (&context.*.total) as *mut i64;
            let _old_total: i64 = @atomicFetchAdd64(total, square_plus_one);
            let completed: *mut i64 = (&context.*.completed) as *mut i64;
            let _old_completed: i64 = @atomicFetchAdd64(completed, 1);
        }
    }
}

fn worker_pool_i64_unmap(context: *WorkerPoolI64Context) i64 {
    if (context == null as *WorkerPoolI64Context) { return 0; }
    unsafe {
        return _zag_raw_syscall(11, context as i64, 4096, 0, 0, 0, 0);
    }
}

// The raw pointer is intentional: this is the unsafe boundary for a caller
// that owns a stable i64 backing region for the duration of the call.  The
// pool copies the region before spawning workers and never retains it.  A
// non-null cancel word is a release/acquire one-shot token owned by the
// caller; workers poll it between finite jobs and every worker is still
// joined before this function returns.
fn worker_pool_i64_run_impl(jobs: *i64, count: i32, worker_count: i32,
    cancel_address: i64) WorkerPoolI64Result {
    if (jobs == null as *i64 || count < 1 || count > 64 ||
        worker_count < 1 || worker_count > 8) {
        return worker_pool_i64_invalid();
    }
    unsafe {
    let address: i64 = _zag_raw_syscall(9, 0, 4096, 3, 34, 0 - 1, 0);
    if (address < 0) {
        let bad: WorkerPoolI64Result = worker_pool_i64_invalid();
        return WorkerPoolI64Result{
            .ok = 0, .code = address, .completed = bad.completed,
            .workers = bad.workers, .total = bad.total,
        };
    }
    let context: *WorkerPoolI64Context = address as *WorkerPoolI64Context;
    // Keep the borrowed caller slice out of the shared context.  The pool
    // copies at most 64 values into the page it owns, so workers never retain
    // a caller view beyond this call.
    context.*.jobs = (address + 512) as *i64;
    context.*.count = count;
    context.*.next_index = 0;
    context.*.completed = 0;
    context.*.total = 0;
    context.*.gate = 0;
    context.*.failed = 0;
    context.*.cancel_address = cancel_address;
    context.*.cancelled = 0;
    let copy_index: i32 = 0;
    while (copy_index < count) {
        context.*.jobs[copy_index] = jobs[copy_index];
        copy_index = copy_index + 1;
    }

    let first: *opaque = null as *opaque;
    let second: *opaque = null as *opaque;
    let third: *opaque = null as *opaque;
    let fourth: *opaque = null as *opaque;
    let fifth: *opaque = null as *opaque;
    let sixth: *opaque = null as *opaque;
    let seventh: *opaque = null as *opaque;
    let eighth: *opaque = null as *opaque;
    let spawned: i32 = 0;
    let spawn_failed: i32 = 0;
    unsafe {
        first = @threadSpawn(worker_pool_i64_worker, address); spawned = 1;
        if (worker_count > 1) { second = @threadSpawn(worker_pool_i64_worker, address); spawned = 2; }
        if (worker_count > 2) { third = @threadSpawn(worker_pool_i64_worker, address); spawned = 3; }
        if (worker_count > 3) { fourth = @threadSpawn(worker_pool_i64_worker, address); spawned = 4; }
        if (worker_count > 4) { fifth = @threadSpawn(worker_pool_i64_worker, address); spawned = 5; }
        if (worker_count > 5) { sixth = @threadSpawn(worker_pool_i64_worker, address); spawned = 6; }
        if (worker_count > 6) { seventh = @threadSpawn(worker_pool_i64_worker, address); spawned = 7; }
        if (worker_count > 7) { eighth = @threadSpawn(worker_pool_i64_worker, address); spawned = 8; }
        if (first == null as *opaque ||
            (worker_count > 1 && second == null as *opaque) ||
            (worker_count > 2 && third == null as *opaque) ||
            (worker_count > 3 && fourth == null as *opaque) ||
            (worker_count > 4 && fifth == null as *opaque) ||
            (worker_count > 5 && sixth == null as *opaque) ||
            (worker_count > 6 && seventh == null as *opaque) ||
            (worker_count > 7 && eighth == null as *opaque)) { spawn_failed = 1; }
        context.*.gate = 1;
        let gate: *mut i32 = (&context.*.gate) as *mut i32;
        let _woken: i64 = @atomicWake32(gate, worker_count);
        @threadJoin(first);
        @threadJoin(second); @threadJoin(third);
        @threadJoin(fourth); @threadJoin(fifth);
        @threadJoin(sixth); @threadJoin(seventh);
        @threadJoin(eighth);
    }
    let completed: i32 = context.*.completed as i32;
    let total: i64 = context.*.total;
    let cancelled: i32 = (context.*.cancelled != 0) as i32;
    let unmap_rc: i64 = worker_pool_i64_unmap(context);
    if (unmap_rc != 0) {
        return WorkerPoolI64Result{
            .ok = 0, .code = worker_pool_i64_status_join_failed(),
            .completed = completed, .workers = worker_count, .total = total,
        };
    }
    if (spawn_failed == 1) {
        return WorkerPoolI64Result{
            .ok = 0, .code = worker_pool_i64_status_spawn_failed(),
            .completed = completed, .workers = worker_count, .total = total,
        };
    }
    if (completed != count) {
        if (cancelled == 1) {
            return WorkerPoolI64Result{
                .ok = 0, .code = worker_pool_i64_status_cancelled(),
                .completed = completed, .workers = worker_count, .total = total,
            };
        }
        return WorkerPoolI64Result{
            .ok = 0, .code = worker_pool_i64_status_incomplete(),
            .completed = completed, .workers = worker_count, .total = total,
        };
    }
    return WorkerPoolI64Result{
        .ok = 1, .code = worker_pool_i64_status_ok(),
        .completed = completed, .workers = worker_count, .total = total,
    };
    }
}

// Uncancelled compatibility entry point.
pub unsafe fn worker_pool_i64_run(jobs: *i64, count: i32, worker_count: i32)
    WorkerPoolI64Result {
    return worker_pool_i64_run_impl(jobs, count, worker_count, 0);
}

// Cooperative cancellation entry point.  Cancellation is checked before the
// first claim and between claims; it cannot interrupt an already-running
// arithmetic operation or an arbitrary syscall.  The token must remain live
// until the returned result, just like the caller's job backing region.
pub unsafe fn worker_pool_i64_run_cancel(jobs: *i64, count: i32, worker_count: i32,
    token: @borrows *cancel.CancelTokenI64) WorkerPoolI64Result {
    if (token == null as *cancel.CancelTokenI64 ||
        cancel.cancel_token_i64_valid(token) == 0) {
        return worker_pool_i64_invalid();
    }
    if (cancel.cancel_token_i64_is_requested(token) < 0) {
        return worker_pool_i64_invalid();
    }
    let cancel_address: i64 = 0;
    unsafe { cancel_address = token.*.word as i64; }
    return worker_pool_i64_run_impl(jobs, count, worker_count, cancel_address);
}
