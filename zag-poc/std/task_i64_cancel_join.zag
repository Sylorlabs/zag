// Explicit cancellation cleanup seam for the bounded TaskI64 ABI.
//
// This operation is consuming: it requests cooperative cancellation, samples
// the cancellation bit, awaits the worker, and writes one typed join record.
// It exists to make cancellation cleanup auditable at call sites; it is not a
// forced stop, destructor, generic future, or scheduler.

@import("std:task_i64") as task

fn task_i64_cancel_and_await_into(handle:@consumes *opaque,
    out:@borrows_mut *task.TaskI64JoinResult) i64 {
    unsafe {
        if (handle == null as *opaque) {
            if (out != null as *task.TaskI64JoinResult) {
                out.* = task.TaskI64JoinResult{.ok = 0,
                    .code = task.task_i64_poll_status_invalid_handle(),
                    .value = 0, .cancellation_requested = 0};
            }
            return task.task_i64_poll_status_invalid_handle();
        }
        let cancel_rc:i64 = @taskCancel(handle);
        let cancellation_requested:i32 = @taskCancelled(handle);
        let value:i64 = @taskAwait(handle);
        if (out == null as *task.TaskI64JoinResult) {
            return task.task_i64_poll_status_invalid_output();
        }
        let code:i64 = task.task_i64_poll_status_ok();
        if (cancel_rc != 0) {
            code = task.task_i64_poll_status_cancel_failed();
        }
        out.* = task.TaskI64JoinResult{.ok = (cancel_rc == 0) as i32,
            .code = code, .value = value,
            .cancellation_requested = cancellation_requested};
        return code;
    }
}
