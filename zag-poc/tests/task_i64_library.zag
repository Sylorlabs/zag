@import("std:task_i64") as task

fn worker(raw:i64) i64 {
    unsafe {
        let task:*opaque = raw as *opaque;
        let i:i64 = 0;
        while (i < 10000000) {
            if (@taskCancelled(task) == 1) { return 0 - 999; }
            let _yielded:i64 = _zag_raw_syscall(24,0,0,0,0,0,0);
            i = i + 1;
        }
        return @taskInput(task) + 1;
    }
}

fn immediate_worker(raw:i64) i64 {
    unsafe { return @taskInput(raw as *opaque) + 1; }
}

fn cancellable_worker(raw:i64) i64 {
    unsafe {
        let task:*opaque = raw as *opaque;
        let i:i64 = 0;
        while (i < 10000000) {
            if (@taskCancelled(task) == 1) { return 0 - 999; }
            let _yielded:i64 = _zag_raw_syscall(24,0,0,0,0,0,0);
            i = i + 1;
        }
        return @taskInput(task);
    }
}

fn main() i32 {
    unsafe {
        let handle:*opaque = @taskSpawn(worker, 41);
        if (task.task_i64_valid(handle) != 1) { return 1; }
        if (task.task_i64_ready(null as *opaque) != 0) { return 2; }
        let invalid_poll:task.TaskI64PollResult=task.task_i64_poll(null as *opaque);
        if (invalid_poll.ok != 0 ||
            invalid_poll.code != task.task_i64_poll_status_invalid_handle() ||
            invalid_poll.state != task.task_i64_poll_invalid()) { return 8; }
        if (task.task_i64_result_borrowed(null as *opaque) != 0) { return 28; }
        let invalid_wait:task.TaskI64PollResult =
            task.task_i64_wait(handle, -1);
        if (invalid_wait.ok != 0 ||
            invalid_wait.code != task.task_i64_poll_status_invalid_timeout() ||
            invalid_wait.state != task.task_i64_poll_invalid()) { return 24; }
        let immediate_wait:task.TaskI64PollResult =
            task.task_i64_wait(handle, 0);
        if (immediate_wait.ok != 1 ||
            (immediate_wait.state != task.task_i64_poll_pending() &&
             immediate_wait.state != task.task_i64_poll_ready())) { return 25; }
        let ready:i32=task.task_i64_ready(handle);
        if (ready != 0 && ready != 1) { return 3; }
        let first:task.TaskI64PollResult=task.task_i64_poll(handle);
        if (first.state != task.task_i64_poll_pending() && first.state != task.task_i64_poll_ready()) { return 9; }
        if (first.ok != 1 || first.code != task.task_i64_poll_status_ok()) { return 22; }
        if (first.cancellation_requested != 0) { return 19; }

        let completed:*opaque=@taskSpawn(immediate_worker, 41);
        let observed:task.TaskI64PollResult=task.task_i64_poll(completed);
        let attempts:i32=0;
        while (observed.state == task.task_i64_poll_pending() && attempts < 1000) {
            let _yielded:i64 = _zag_raw_syscall(24,0,0,0,0,0,0);
            observed=task.task_i64_poll(completed);
            attempts=attempts+1;
        }
        if (observed.ok != 1 || observed.code != task.task_i64_poll_status_ok() ||
            observed.state != task.task_i64_poll_ready() || observed.value != 42) { return 11; }
        if (observed.cancellation_requested != 0) { return 20; }
        let completed_join:task.TaskI64JoinResult = task.TaskI64JoinResult{
            .ok = 0, .code = 0, .value = 0, .cancellation_requested = 0};
        task.task_i64_await_into(completed, &completed_join);
        if (completed_join.ok != 1 || completed_join.code != 0 ||
            completed_join.value != 42 ||
            completed_join.cancellation_requested != 0) { return 12; }

        // Rejected null arguments are exercised as standalone calls because
        // the affine checker must conservatively treat every @consumes
        // argument as discharged. The implementation validates both
        // arguments before @taskAwait when there is no handle. A valid handle
        // is always discharged exactly once, even when output is null; the
        // runner also checks that invalid-output branch and the one-shot
        // await source contract.
        let invalid_handle:*opaque = 0 as *opaque;
        let invalid_join:task.TaskI64JoinResult = task.TaskI64JoinResult{
            .ok = 7, .code = 7, .value = 7, .cancellation_requested = 7};
        task.task_i64_await_into(invalid_handle, &invalid_join);
        let rejected_output:*opaque = @taskSpawn(immediate_worker, 7);
        task.task_i64_await_into(rejected_output, 0 as *task.TaskI64JoinResult);

        let waited:*opaque = @taskSpawn(immediate_worker, 99);
        let waited_result:task.TaskI64PollResult = task.task_i64_wait(waited, 1000);
        if (waited_result.ok != 1 ||
            waited_result.state != task.task_i64_poll_ready() ||
            waited_result.value != 100) { return 26; }
        let waited_value:i64 = @taskAwait(waited);
        if (waited_value != 100) { return 27; }

        if (task.task_i64_cancelled(handle) != 0) { return 4; }
        if (task.task_i64_cancel(handle) != 0) { return 5; }
        if (task.task_i64_cancelled(handle) != 1) { return 6; }
        let cancelled:task.TaskI64PollResult=task.task_i64_poll(handle);
        if (cancelled.state != task.task_i64_poll_pending() && cancelled.state != task.task_i64_poll_ready()) { return 10; }
        if (cancelled.ok != 1 || cancelled.code != task.task_i64_poll_status_ok()) { return 23; }
        if (cancelled.cancellation_requested != 1) { return 21; }
        let result:i64 = @taskAwait(handle);
        if (result != 0 - 999) { return 7; }

        let parent:*opaque = @taskSpawn(cancellable_worker, 100);
        let child:*opaque = @taskSpawn(cancellable_worker, 200);
        if (parent == null as *opaque || child == null as *opaque) { return 13; }
        let invalid_cascade:task.TaskI64CascadePollResult =
            task.task_i64_poll_cascaded(null as *opaque, child);
        if (invalid_cascade.state != task.task_i64_poll_invalid_parent_child() ||
            invalid_cascade.propagated != 0) { return 14; }
        let before_cancel:task.TaskI64CascadePollResult =
            task.task_i64_poll_cascaded(parent, child);
        if (before_cancel.parent_cancelled != 0 ||
            before_cancel.propagated != 0 || before_cancel.child_cancelled != 0) {
            return 15;
        }
        if (@taskCancel(parent) != 0) { return 16; }
        let cascaded:task.TaskI64CascadePollResult =
            task.task_i64_poll_cascaded(parent, child);
        if (cascaded.parent_cancelled != 1 || cascaded.propagated != 1 ||
            cascaded.child_cancelled != 1) { return 17; }
        let parent_result:i64 = @taskAwait(parent);
        let child_result:i64 = @taskAwait(child);
        if (parent_result != 0 - 999 || child_result != 0 - 999) { return 18; }
    }
    return 42;
}
