// Native Metal shader-library compilation smoke test.  Every call crosses the
// public Objective-C/Metal ABI; no Linux GPU or shader emulation is involved.
extern fn MTLCreateSystemDefaultDevice() *u8
extern fn objc_getClass(name:*i8) *u8
extern fn sel_registerName(name:*i8) *u8
extern fn objc_msgSend(receiver:*u8, selector:*u8, a2:*u8, a3:*u8, a4:*u8) *u8
extern fn _zag_slice_ptr(s:[]u8) *i8

fn main() i32 {
    let device:*u8=MTLCreateSystemDefaultDevice();
    if(device==null as *u8){return 1;}
    let ns:*u8=objc_getClass(_zag_slice_ptr("NSString\x00"));
    if(ns==null as *u8){return 2;}
    let make_string:*u8=sel_registerName(_zag_slice_ptr("stringWithUTF8String:\x00"));
    let source:*u8=objc_msgSend(ns,make_string,_zag_slice_ptr("#include <metal_stdlib>\nusing namespace metal;\nkernel void zag_fill(device uint *out [[buffer(0)]], uint id [[thread_position_in_grid]]) { out[id] = 0x2a; }\n\x00") as *u8,null as *u8,null as *u8);
    if(source==null as *u8){return 3;}
    let build:*u8=sel_registerName(_zag_slice_ptr("newLibraryWithSource:options:error:\x00"));
    let error:*u8=null as *u8;
    let library:*u8=objc_msgSend(device,build,source,null as *u8,(&error) as *u8);
    if(library==null as *u8){return 4;}
    return 42;
}
