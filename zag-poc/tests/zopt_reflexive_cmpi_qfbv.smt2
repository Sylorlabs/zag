; Integer equality and signed ordering of an SSA value with itself.
; Independent of overflow mode and signed width. No claims about cmpf/NaN,
; trapping operand producers, ZIR provenance or whole-pipeline soundness.
(set-logic QF_BV)
(declare-const x8 (_ BitVec 8))
(declare-const x64 (_ BitVec 64))

; eq -> true; ne -> false; slt/sgt -> false; sle/sge -> true.
(push 1)
(assert (not (= x8 x8)))
(check-sat)
(pop 1)
(push 1)
(assert (distinct x8 x8))
(check-sat)
(pop 1)
(push 1)
(assert (bvslt x8 x8))
(check-sat)
(pop 1)
(push 1)
(assert (bvsgt x8 x8))
(check-sat)
(pop 1)
(push 1)
(assert (not (bvsle x8 x8)))
(check-sat)
(pop 1)
(push 1)
(assert (not (bvsge x8 x8)))
(check-sat)
(pop 1)

(push 1)
(assert (not (= x64 x64)))
(check-sat)
(pop 1)
(push 1)
(assert (distinct x64 x64))
(check-sat)
(pop 1)
(push 1)
(assert (bvslt x64 x64))
(check-sat)
(pop 1)
(push 1)
(assert (bvsgt x64 x64))
(check-sat)
(pop 1)
(push 1)
(assert (not (bvsle x64 x64)))
(check-sat)
(pop 1)
(push 1)
(assert (not (bvsge x64 x64)))
(check-sat)
(pop 1)
