// Repeated command execution must reclaim the runtime's temporary C-string
// bridge.  This is intentionally small and libc-free: a long-lived daemon
// performs the same `_zag_exec_cmd` operation for semantic checks.
extern fn _zag_exec_cmd(command: []u8) i32
extern fn _zag_exec_capture(command: []u8) []u8
extern fn _zag_str_free(value: []u8) void
extern fn _zag_allocator_live_bytes() i64

fn main() i32 {
    let before:i64=_zag_allocator_live_bytes();
    let i:i32=0;
    while(i<512){
        if(_zag_exec_cmd("true")!=0){return 1;}
        i=i+1;
    }
    if(_zag_allocator_live_bytes()!=before){return 2;}
    i=0;
    while(i<32){
        let captured:[]u8=_zag_exec_capture("true");
        _zag_str_free(captured);
        if(_zag_allocator_live_bytes()!=before){return 3;}
        i=i+1;
    }
    return 0;
}
