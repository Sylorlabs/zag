@import("../std/gpu_platform.zag")

fn check(name:[]u8,ok:bool,f:*i32)void{
    if(ok){_zag_print("  ok  ");}else{_zag_print("  XX  ");f.*=f.*+1;}_zag_println(name);
}

fn main()i32{
    let f:i32=0;
    let amd=zag_gpu_platform_select(zag_gpu_vendor_amd(),true);
    check("GFX10.1 has Zag-native codegen and VM over the Linux AMDGPU boundary",amd.code_format==zag_gpu_code_rdna_native()&&amd.driver_abi==zag_gpu_driver_linux_amdgpu()&&zag_gpu_target_virtual_ready(amd),&f);
    check("GFX10.1 physical submission stays fail-closed until the direct DRM adapter is implemented",!zag_gpu_target_ready(amd),&f);
    let portable=zag_gpu_platform_select(zag_gpu_vendor_unknown(),false);
    check("unknown hardware has no userspace API fallback",_zag_strcmp(portable.name,"unsupported-native")==1&&!zag_gpu_target_ready(portable),&f);
    let nv=zag_gpu_platform_select(zag_gpu_vendor_nvidia(),true);
    check("NVIDIA workflow requires Zag-native ISA over the Nouveau kernel UAPI",nv.code_format==zag_gpu_code_nvidia_native()&&nv.driver_abi==zag_gpu_driver_linux_nouveau()&&!zag_gpu_target_ready(nv),&f);
    let intel=zag_gpu_platform_select(zag_gpu_vendor_intel(),true);
    check("Intel workflow requires Zag-native ISA over the Xe kernel UAPI",intel.code_format==zag_gpu_code_intel_native()&&intel.driver_abi==zag_gpu_driver_linux_xe()&&!zag_gpu_target_ready(intel),&f);
    check("no supported workflow rewrites privileged GPU drivers",zag_gpu_platform_boundary_valid(amd)&&zag_gpu_platform_boundary_valid(portable)&&zag_gpu_platform_boundary_valid(nv)&&zag_gpu_platform_boundary_valid(intel),&f);
    if(f==0){_zag_println("GPU PLATFORM: ALL PASS");return 0;}return 1;
}
