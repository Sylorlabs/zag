@import("std/allocator.zag")

fn work() !i32 {
    let system: SystemAllocator = system_allocator();
    let backing: Allocation = try system.allocate(64, 8);
    let arena: ArenaAllocator = try arena_allocator(backing);
    let block: ArenaBlock = try arena.allocate(8, 8);
    let alias: ArenaBlock = block;
    let released: Allocation = try arena.deinit();
    try system.deallocate(released);
    return 0;
}

fn main() i32 { return work() catch 9; }
