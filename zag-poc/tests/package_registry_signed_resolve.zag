@import("../selfhost/package_resolve.zag")

extern fn _zag_argc() i32
extern fn _zag_arg(i: i32) []u8

fn main() i32 {
    if (_zag_argc() != 2) { return 2; }
    let result: PackageImportResolution = package_import_resolve(
        "pkg:toolkit/src/toolkit.zag", _zag_arg(1));
    let ok: i32 = (result.matched == 1 &&
        result.error == PackageImportError.none && result.locked == 1 &&
        result.module_source_owned == 1 && result.module_source.len > 0) as i32;
    package_import_resolution_release(&result);
    if (ok == 1) {
        _zag_println("signed resolver: verified");
        return 0;
    }
    _zag_println("signed resolver: rejected");
    return 1;
}
