@import("std:database_kv") as contract
@import("std:sqlite_kv") as sqlite

extern fn _zag_argc() i32
extern fn _zag_arg(index:i32) []u8
extern fn _zag_allocator_live_bytes() i64

fn main() i32 {
    if (_zag_argc() != 2 && _zag_argc() != 3) { return 2; }
    let before: i64 = _zag_allocator_live_bytes();
    let invalid: sqlite.SqliteKv = sqlite.sqlite_kv_open_path("", 4);
    if (invalid.status != contract.database_kv_invalid() || invalid.open != 0) {
        return 3;
    }
    let database: sqlite.SqliteKv =
        sqlite.sqlite_kv_open_path(_zag_arg(1), 4);
    if (database.status != contract.database_kv_ok() || database.open != 1) {
        return 4;
    }
    let value: i64 = 0;
    if (_zag_argc() == 2) {
        if (sqlite.sqlite_kv_get(&database, 77, &value) !=
            contract.database_kv_missing()) { return 5; }
        if (sqlite.sqlite_kv_put(&database, 77, 1234567890123) !=
            contract.database_kv_ok()) { return 6; }
        if (sqlite.sqlite_kv_close(&database) != contract.database_kv_ok() ||
            _zag_allocator_live_bytes() != before) { return 7; }
        _zag_println("database sqlite persistence: write=ok");
        return 0;
    }
    if (sqlite.sqlite_kv_get(&database, 77, &value) !=
        contract.database_kv_ok() || value != 1234567890123) { return 8; }
    if (sqlite.sqlite_kv_put(&database, 77, 1234567890124) !=
        contract.database_kv_ok()) { return 9; }
    let count: i32 = 0;
    if (sqlite.sqlite_kv_count(&database, &count) !=
        contract.database_kv_ok() || count != 1) { return 10; }
    if (sqlite.sqlite_kv_close(&database) != contract.database_kv_ok() ||
        _zag_allocator_live_bytes() != before) { return 11; }
    _zag_println("database sqlite persistence: reopen=ok");
    return 0;
}
