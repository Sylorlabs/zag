@import("../selfhost/zagd_linux.zag")

fn check(ok: i32, failures: *i32) void { if (ok == 0) { failures.* = failures.* + 1; } }

fn main() i32 {
    let failures: i32 = 0;
    check(zagd_ignored_name(".zagd.status"), &failures);
    check(zagd_ignored_name(".git"), &failures);
    check(zagd_ignored_name(".zig-cache"), &failures);
    check(zagd_ignored_name("build"), &failures);
    check(zagd_ignored_name("write.tmp"), &failures);
    check(zagd_ignored_name("file.zag") == 0, &failures);
    check(zagd_ignored_name(".zagd.rescan"), &failures);
    check(zagd_has_suffix("agent.swp", ".swp"), &failures);
    check(zagd_source_name("file.zag"), &failures);
    check(zagd_source_name("file.zs"), &failures);
    check(zagd_source_name("file.zig") == 0, &failures);
    check(zagd_in_q_overflow() == 16384, &failures);
    check(zagd_event_requires_rescan(16384), &failures);
    check(zagd_event_requires_rescan(zagd_in_modify()) == 0, &failures);
    check(@strEq(zagd_join_path("/tmp/project", "a.zag"), "/tmp/project/a.zag"), &failures);
    return failures;
}
