// A Script-owned boolean list must not escape through an uncontracted
// aggregate sink.  This is intentionally a compile-time negative fixture.
script;

struct BoolPayload { values: ScriptList[bool] }
extern fn retain_bool_payload(value: BoolPayload) void

let values: ScriptList[bool] = json_bool_array("[true,false]");
let payload: BoolPayload = BoolPayload{ .values = values };
retain_bool_payload(payload);
return 0;
