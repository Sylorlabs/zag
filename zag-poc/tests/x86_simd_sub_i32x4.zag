// Four packed i32 lanes exercise the bounded SSE2 subtraction intrinsic.
// This stays raw-pointer based: Zag does not claim a vector value ABI.

fn main() i32 {
    unsafe {
    let lhs:*u8 = _zag_malloc(32) as *u8;
    let rhs:*u8 = _zag_malloc(32) as *u8;
    lhs[0]=10; lhs[1]=0; lhs[2]=0; lhs[3]=0;
    lhs[4]=50; lhs[5]=0; lhs[6]=0; lhs[7]=0;
    lhs[8]=44; lhs[9]=1; lhs[10]=0; lhs[11]=0;
    lhs[12]=0; lhs[13]=0; lhs[14]=0; lhs[15]=0;
    rhs[0]=7; rhs[1]=0; rhs[2]=0; rhs[3]=0;
    rhs[4]=20; rhs[5]=0; rhs[6]=0; rhs[7]=0;
    rhs[8]=40; rhs[9]=0; rhs[10]=0; rhs[11]=0;
    rhs[12]=1; rhs[13]=0; rhs[14]=0; rhs[15]=0;
    @simdSubI32x4(lhs as *mut i32,
                  lhs as *const i32,
                  rhs as *const i32);
    if (lhs[0] != 3) { return 10; }
    if (lhs[4] != 30) { return 11; }
    if (lhs[8] != 4 || lhs[9] != 1) { return 12; }
    // modulo-2^32 underflow: 0 - 1
    if (lhs[12] != 255 || lhs[13] != 255 || lhs[14] != 255 || lhs[15] != 255) { return 13; }
    _zag_free(lhs);
    _zag_free(rhs);
    return 0;
    }
}
