// Edition 2027 must reject passing an i64 value to an i32 parameter
// (previously silently truncated: 3000000000 -> -1294967296).
fn takes(n: i32) i64 { return n as i64; }
fn main() i32 {
    let big: i64 = 3000000000;
    let r: i64 = takes(big);
    if (r == 3000000000) { return 0; }
    return 1;
}
