// Accepted in edition 2027: explicit casts, fitting literals, widening.
fn takes(n: i32) i64 { return n as i64; }
fn takes8(b: u8) i64 { return b as i64; }
fn wide(n: i64) i64 { return n; }
fn main() i32 {
    let small: i64 = 1234;
    let s32: i32 = 7;
    let a: i64 = takes(small as i32);
    let b: i64 = takes(2147483647) + takes(-2147483648) + takes8(255) + takes8(0x7f);
    let c: i64 = wide(s32) + wide(3000000000);
    if (a != 1234) { return 1; }
    if (b != (2147483647 - 2147483648 + 255 + 127)) { return 2; }
    if (c != 3000000007) { return 3; }
    return 0;
}
