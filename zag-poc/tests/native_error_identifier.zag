error { ExpectedFailure }

struct Pair {
    first: i64,
    second: i64,
}

struct Envelope {
    pair: Pair,
    pointer: *i64,
}

fn local_field_from_error_union() !i64 {
    let source: Pair = Pair{ .first = 7, .second = 92 };
    let error: Pair = source;
    return error.second;
}

fn literal_failure() !i64 {
    return error.ExpectedFailure;
}

fn main() i32 {
    let scalar_source: i64 = 42;
    let error: i64 = scalar_source;
    if (error != 42) { return 1; }

    let pointed: i64 = 314;
    let source: Envelope = Envelope{
        .pair = Pair{ .first = 7, .second = 92 },
        .pointer = &pointed,
    };
    let error: Envelope = source;
    if (error.pair.first != 7 || error.pair.second != 92) { return 2; }
    if (error.pointer.* != 314) { return 3; }

    let field: i64 = local_field_from_error_union() catch 0;
    if (field != 92) { return 4; }
    let code: i64 = literal_failure() catch |caught| caught as i64;
    if (code <= 0) { return 5; }

    _zag_println("native error identifier: PASS");
    return 0;
}
