@import("std:rt")
@import("std:list") as list
@import("std:utf8") as utf8

fn main() i32 {
    let output: list.ArrayList[u8] = list.make[u8](96);
    output.len = 96;
    let i: i32 = 0;
    while (i < output.len) { output.data[i] = 0; i = i + 1; }

    let source: []u8 = "A\xcc\x81 a\xcc\x88 n\xcc\x83 c\xcc\xa7";
    let normalized: utf8.Utf8Normalize = utf8.utf8_normalize_nfc_bounded(
        source, output.data[0..output.len], 64);
    if (normalized.status != utf8.utf8_status_exhausted() ||
        normalized.changed != 1 || normalized.scalar_count != 11 ||
        @strEq(output.data[0..normalized.written],
            "\xc3\x81 \xc3\xa4 \xc3\xb1 \xc3\xa7") == 0) {
        list.free[u8](&output); return 1;
    }

    // Unsupported marks stay bytewise intact and do not get guessed into a
    // different normalization form.
    let unknown: []u8 = "x\xcd\xaf";
    let preserved: utf8.Utf8Normalize = utf8.utf8_normalize_nfc_bounded(
        unknown, output.data[0..output.len], 8);
    if (preserved.status != utf8.utf8_status_exhausted() || preserved.changed != 0 ||
        @strEq(output.data[0..preserved.written], unknown) == 0) {
        list.free[u8](&output); return 2;
    }

    let malformed: utf8.Utf8Normalize = utf8.utf8_normalize_nfc_bounded(
        "A\xc2", output.data[0..output.len], 8);
    if (malformed.status != utf8.utf8_status_truncated() || malformed.error_offset != 1) {
        list.free[u8](&output); return 3;
    }
    let limited: utf8.Utf8Normalize = utf8.utf8_normalize_nfc_bounded(
        "A\xcc\x81", output.data[0..output.len], 1);
    if (limited.status != utf8.utf8_status_limit() || limited.scalar_count != 1) {
        list.free[u8](&output); return 4;
    }
    let small: utf8.Utf8Normalize = utf8.utf8_normalize_nfc_bounded(
        source, output.data[0..2], 64);
    if (small.status != utf8.utf8_status_output_too_small()) {
        list.free[u8](&output); return 5;
    }
    list.free[u8](&output);
    return 0;
}
