@import("../selfhost/native/macho_dependency.zag")

fn check(condition: bool, label: []u8) i32 {
    if (!condition) { _zag_eprintln(_zag_str_concat("FAIL dependency: ",label)); return 1; }
    return 0;
}
fn trie_case(bytes: []u8, expected: i32, label: []u8) i32 {
    return check(mdep_trie_valid(bytes) == expected,label);
}
fn trie_cases() i32 {
    let failed: i32 = 0;
    failed = failed+trie_case("",1,"empty trie");
    failed = failed+trie_case("\0\0",1,"empty root");
    failed = failed+trie_case("\0\x01a\0\x05\x02\0\x2a\0",1,"one export");
    failed = failed+trie_case("\0\x01a\0\x05\x02\0\x2a\x01b\0\x0c\x02\0\x2b\0",1,"prefix export");
    failed = failed+trie_case("\0\x02a\0\x08b\0\x0c\x02\0\x2a\0\x02\0\x2b\0",1,"sibling exports");
    failed = failed+trie_case("\0\x01a\0\x05\x03\x08\x01\0\0",1,"reexport terminal");
    failed = failed+trie_case("\0\x01a\0\x05\x03\x10\x2a\x2b\0",1,"resolver terminal");
    failed = failed+trie_case("\0\x01a\0\0",0,"root cycle");
    failed = failed+trie_case("\0\x01a\0\x02",0,"overlapping node");
    failed = failed+trie_case("\0\x02a\0\x08b\0\x08\x02\0\x2a\0",0,"aliased child");
    failed = failed+trie_case("\0\x02a\0\x08a\0\x0c\x02\0\x2a\0\x02\0\x2b\0",0,"duplicate edges");
    failed = failed+trie_case("\0\x02a\0\x09ab\0\x0d\x02\0\x2a\0\x02\0\x2b\0",0,"ambiguous prefix edges");
    failed = failed+trie_case("\0\x01\0\x04\x02\0\x2a\0",0,"empty edge");
    failed = failed+trie_case("\0\x01a\0\x7f",0,"child outside trie");
    failed = failed+trie_case("\0\x01a",0,"unterminated edge");
    failed = failed+trie_case("\0\x01a\0\x05\x01\0\0",0,"missing terminal address");
    failed = failed+trie_case("\0\x01a\0\x05\x7f\0",0,"oversized terminal");
    failed = failed+trie_case("\0\x01a\0\x05\x02\0\x2a",0,"missing child count");
    failed = failed+trie_case("\0\x01a\0\x05\x03\x18\x01\0\0",0,"conflicting terminal modes");
    failed = failed+trie_case("\0\x01a\0\x05\x02\x40\x2a\0",0,"unknown terminal flags");
    failed = failed+trie_case("\x02\0\x2a\0",0,"empty exported name");
    failed = failed+trie_case("\0\x02a\0\x08b\0\x0c\x02\0\x2a\0\x02\x40\x2b\0",0,"malformed off-path terminal");
    failed = failed+trie_case("\x80\x80\x80\x80\x80\x80\x80\x80\x80\0",0,"overlong ULEB");
    return failed;
}
fn put_uint(bytes: *ArrayList[u8], offset: i32, value: i64, width: i32, big: i32) void {
    let i: i32 = 0;
    while (i < width) {
        let at: i32 = offset+i; if (big == 1) { at = offset+width-1-i; }
        bytes.*.data[at] = (value & 255) as u8; value = value/256; i = i+1;
    }
}
fn fat_case(image: []u8, width: i32, big: i32, damage: i32, name: []u8) i32 {
    let bytes: ArrayList[u8] = make[u8](4096+image.len);
    while (bytes.len < 4096+image.len) { push[u8](&bytes,0); }
    let i: i32 = 0; while (i < image.len) { bytes.data[4096+i] = image[i]; i = i+1; }
    let magic: i64 = 0xcafebabe; if (width == 8) { magic = 0xcafebabf; }
    put_uint(&bytes,0,magic,4,big); put_uint(&bytes,4,1,4,big);
    put_uint(&bytes,8,0x100000c,4,big); put_uint(&bytes,12,0,4,big);
    put_uint(&bytes,16,4096,width,big); put_uint(&bytes,16+width,image.len as i64,width,big);
    put_uint(&bytes,16+2*width,12,4,big);
    if (damage == 1) { put_uint(&bytes,4,0,4,big); }
    if (damage == 2) { put_uint(&bytes,16,8,width,big); }
    if (damage == 3) { put_uint(&bytes,16,4097,width,big); }
    if (damage == 4) { put_uint(&bytes,16+width,(image.len+1) as i64,width,big); }
    if (damage == 5) { put_uint(&bytes,12,2,4,big); }
    let parsed: MdDependency = mdep_parse(bytes.data[0..bytes.len]);
    let valid: bool = parsed.valid == 0;
    if (damage == 0) { valid = parsed.valid == 1 && mdep_has_export(parsed,name) == 1; }
    let result: i32 = check(valid,"FAT32/FAT64 endian selection and malformed-slice bounds");
    free[u8](&bytes); return result;
}
fn symbol_table_case(image: []u8, name: []u8) i32 {
    // The parser does not authenticate code signatures. Use a private mutated
    // metadata snapshot to exercise the documented no-export-trie fallback.
    let copy: []u8 = _zag_str_concat("",image);
    let count: i32 = mdep_uint(copy,16,4,0) as i32; let command: i32 = 0; let at: i32 = 32;
    while (command < count) {
        let kind: i64 = mdep_uint(copy,at,4,0);
        let field: i32 = -1;
        if (kind == 0x22 || kind == 0x80000022) { field = at+40; }
        if (kind == 0x80000033) { field = at+8; }
        if (field >= 0) { let i: i32 = 0; while (i < 8) { copy[field+i] = 0; i = i+1; } }
        at = at+(mdep_uint(copy,at+4,4,0) as i32); command = command+1;
    }
    let parsed: MdDependency = mdep_parse(copy);
    let failed: i32 = check(parsed.valid == 1 && parsed.exports.len == 0 &&
        mdep_has_export(parsed,name) == 1,"symbol-table fallback export");
    failed = failed+check(mdep_has_export(parsed,"__zag_missing_fallback__") == 0,"symbol-table fallback miss");
    let symbol: i32 = 0; let damaged: i32 = 0;
    while (symbol < parsed.symbol_count && damaged == 0) {
        at = parsed.symbols+symbol*16;
        let kind: i32 = copy[at+4] as i32;
        if ((kind & 0xe0) == 0 && (kind & 1) == 1 && (kind & 0xe) != 0) {
            copy[at] = 255; copy[at+1] = 255; copy[at+2] = 255; copy[at+3] = 255; damaged = 1;
        }
        symbol = symbol+1;
    }
    failed = failed+check(damaged == 1 && mdep_has_export(parsed,"__zag_missing_fallback__") == -1,"malformed symbol string index");
    _zag_str_free(copy); return failed;
}
fn main() i32 {
    if (_zag_argc() != 4) { return 2; }
    let bytes: []u8 = _zag_read_file(_zag_arg(1));
    let dependency: MdDependency = mdep_parse(bytes);
    let failed: i32 = check(dependency.valid == 1,"valid native dylib");
    if (dependency.valid != 1) { return 1; }
    failed = failed+check(mdep_has_export(dependency,_zag_arg(2)) == 1,"present export");
    failed = failed+check(mdep_has_export(dependency,"__zag_absent_symbol__") == 0,"absent export");
    let foreign: []u8 = _zag_read_file(_zag_arg(3));
    failed = failed+check(mdep_parse(foreign).valid == 0,"foreign target");
    let at: i32 = 0;
    while (at < 32) { failed = failed+check(mdep_parse(bytes[0..at]).valid == 0,"truncated header"); at = at+1; }
    let thin: []u8 = dependency.image;
    failed = failed+symbol_table_case(thin,_zag_arg(2));
    let width: i32 = 4;
    while (width <= 8) {
        let big: i32 = 0;
        while (big <= 1) {
            let damage: i32 = 0;
            while (damage <= 5) { failed = failed+fat_case(thin,width,big,damage,_zag_arg(2)); damage = damage+1; }
            big = big+1;
        }
        width = width+4;
    }
    let original: u8 = thin[12]; thin[12] = 2;
    failed = failed+check(mdep_parse(thin).valid == 0,"executable instead of library"); thin[12] = original;
    original = thin[4]; thin[4] = 7;
    failed = failed+check(mdep_parse(thin).valid == 0,"wrong CPU"); thin[4] = original;
    original = thin[8]; thin[8] = 2;
    failed = failed+check(mdep_parse(thin).valid == 0,"arm64e is not baseline arm64"); thin[8] = original;
    original = thin[36]; thin[36] = 0;
    let original_high: u8 = thin[37]; thin[37] = 0;
    failed = failed+check(mdep_parse(thin).valid == 0,"zero command size"); thin[36] = original; thin[37] = original_high;
    original = thin[20]; thin[20] = 255;
    failed = failed+check(mdep_parse(thin).valid == 0,"inconsistent command bytes"); thin[20] = original;
    if (dependency.exports.len > 0) {
        let root: u8 = dependency.exports[0]; dependency.exports[0] = 127;
        failed = failed+check(mdep_parse(thin).valid == 0,"malformed export terminal"); dependency.exports[0] = root;
    }
    failed = failed+trie_cases();
    if (failed != 0) { return 1; }
    _zag_println("Mach-O dependency: PASS thin/universal, four FAT encodings, symbol-table fallback, 32 header truncations, 23 trie cases, malformed commands");
    return 0;
}
