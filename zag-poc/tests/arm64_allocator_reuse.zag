extern fn _zag_malloc(n: i64) *u8;
extern fn _zag_realloc(p: *u8, n: i64) *u8;
extern fn _zag_free(p: *u8) void;
extern fn _zag_allocator_allocation_count() i64;
extern fn _zag_allocator_live_bytes() i64;

fn touch_pages(p: *u8, n: i64) void {
    let offset: i64 = 0;
    while (offset < n) {
        p[offset] = ((offset / 4096) % 251) as u8;
        offset = offset + 4096;
    }
    p[n - 1] = 42 as u8;
}

fn main() i32 {
    let baseline: i64 = _zag_allocator_live_bytes();
    let count_before: i64 = _zag_allocator_allocation_count();

    // 17 and 31 bytes occupy the same 32-byte physical class. A LIFO
    // recycle must return the exact pointer while publishing the new exact
    // logical length to telemetry and realloc's header.
    let first: *u8 = _zag_malloc(17);
    if (first == null as *u8) { return 1; }
    first[0] = 7 as u8;
    first[16] = 11 as u8;
    let first_address: i64 = first as i64;
    _zag_free(first);
    if (_zag_allocator_live_bytes() != baseline) { return 2; }

    let replacement: *u8 = _zag_malloc(31);
    if ((replacement as i64) != first_address) { return 3; }
    if (_zag_allocator_live_bytes() != baseline + 31) { return 4; }
    replacement[30] = 13 as u8;
    _zag_free(replacement);
    if (_zag_allocator_live_bytes() != baseline) { return 5; }

    // Realloc must copy the exact old request and return the old physical
    // block to its class after the copy.
    let old: *u8 = _zag_malloc(24);
    old[0] = 19 as u8;
    old[23] = 23 as u8;
    let grown: *u8 = _zag_realloc(old, 48);
    if (grown == null as *u8 || grown[0] != 19 as u8 ||
        grown[23] != 23 as u8) { return 6; }
    _zag_free(grown);
    if (_zag_allocator_live_bytes() != baseline) { return 7; }

    // Each request is above the 512 KiB class ceiling. Touching every page
    // makes retained mappings visible to the shell's maximum-RSS witness;
    // a correct dedicated path unmaps each block before the next loop.
    let iteration: i64 = 0;
    while (iteration < 48) {
        let large: *u8 = _zag_malloc(8388608);
        if (large == null as *u8) { return 8; }
        touch_pages(large, 8388608);
        _zag_free(large);
        if (_zag_allocator_live_bytes() != baseline) { return 9; }
        iteration = iteration + 1;
    }

    if (_zag_allocator_allocation_count() - count_before != 52) {
        return 10;
    }
    return 42;
}
