// Forty scalar locals force frame displacements past the signed-unscaled
// simm9 boundary (-256). Every value participates in the result so both deep
// stores and deep loads are observable at runtime.
fn main() i32 {
    let v00:i32=1; let v01:i32=1; let v02:i32=1; let v03:i32=1;
    let v04:i32=1; let v05:i32=1; let v06:i32=1; let v07:i32=1;
    let v08:i32=1; let v09:i32=1; let v10:i32=1; let v11:i32=1;
    let v12:i32=1; let v13:i32=1; let v14:i32=1; let v15:i32=1;
    let v16:i32=1; let v17:i32=1; let v18:i32=1; let v19:i32=1;
    let v20:i32=1; let v21:i32=1; let v22:i32=1; let v23:i32=1;
    let v24:i32=1; let v25:i32=1; let v26:i32=1; let v27:i32=1;
    let v28:i32=1; let v29:i32=1; let v30:i32=1; let v31:i32=1;
    let v32:i32=1; let v33:i32=1; let v34:i32=1; let v35:i32=1;
    let v36:i32=1; let v37:i32=1; let v38:i32=1; let v39:i32=1;
    return v00+v01+v02+v03+v04+v05+v06+v07+v08+v09+
        v10+v11+v12+v13+v14+v15+v16+v17+v18+v19+
        v20+v21+v22+v23+v24+v25+v26+v27+v28+v29+
        v30+v31+v32+v33+v34+v35+v36+v37+v38+v39+2;
}
