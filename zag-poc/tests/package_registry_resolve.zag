@import("../selfhost/package_resolve.zag")

extern fn _zag_write_file(path: []u8, content: []u8) i32
extern fn _zag_i64_to_str(v: i64) []u8 @alloc

fn reg_resolve_expect(ok: i32, label: []u8, failures: *i32) void {
    if (ok != 0) { _zag_print("ok  "); _zag_println(label); }
    else { failures.* = failures.* + 1; _zag_print("FAIL "); _zag_println(label); }
}

fn reg_resolve_hash_text(h: PackageRawChecksum) []u8 {
    let a: []u8 = _zag_i64_to_str(h.first);
    let b: []u8 = _zag_i64_to_str(h.second);
    let c: []u8 = _zag_i64_to_str(h.bytes);
    let cb: []u8 = _zag_str_concat(",", b);
    let ab: []u8 = _zag_str_concat(a, cb); _zag_str_free(cb);
    let cc: []u8 = _zag_str_concat(",", c);
    let abc: []u8 = _zag_str_concat(ab, cc); _zag_str_free(cc);
    _zag_str_free(a); _zag_str_free(b); _zag_str_free(c);
    _zag_str_free(ab);
    return abc;
}

fn reg_resolve_finalize(body: []u8) []u8 {
    let hash: []u8 = reg_resolve_hash_text(package_raw_checksum(body));
    let hash_line: []u8 = _zag_str_concat(hash, "\n");
    let line: []u8 = _zag_str_concat("checksum=", hash_line);
    _zag_str_free(hash_line);
    let out: []u8 = _zag_str_concat(body, line);
    _zag_str_free(hash); _zag_str_free(line);
    return out;
}

fn main() i32 {
    if (_zag_argc() != 2) { return 2; }
    let failures: i32 = 0;
    let root: []u8 = _zag_arg(1);
    let source_path: []u8 = package_import_join(root, "registry/src/toolkit.zag");
    let index_path: []u8 = package_import_join(root, "registry/index.zag");
    let manifest_path: []u8 = package_import_join(root, "zag.mod");
    // The two index entries intentionally point at the same module path but
    // carry different raw-byte checksums.  The on-disk source matches only
    // the higher 1.2.0 entry, so a wildcard resolver that accidentally picks
    // the lower 1.0.0 entry fails closed instead of merely reporting a match.
    let source: []u8 = "pub fn answer() i32 { return 43; }\n";
    let lower_source: []u8 = "pub fn answer() i32 { return 42; }\n";
    let manifest: []u8 = "name = \"registry-consumer\"\nversion = \"0.0.0\"\nedition = \"2026\"\n\n[deps]\ntoolkit = { path = \"registry/index.zag\", mode = \"registry\", version = \"1.*\" }\n";
    let lower_sum: []u8 = reg_resolve_hash_text(package_raw_checksum(lower_source));
    let lower_sum_line: []u8 = _zag_str_concat(lower_sum, "\n");
    let lower_prefix: []u8 = "format=zag-registry-index-v1\nauthority=local-file-v1\nsignature=none\nentry=toolkit\t1.0.0\tsrc/toolkit.zag\t";
    let lower_entry: []u8 = _zag_str_concat(lower_prefix, lower_sum_line);
    _zag_str_free(lower_sum_line); _zag_str_free(lower_sum);
    let sum: []u8 = reg_resolve_hash_text(package_raw_checksum(source));
    let sum_line: []u8 = _zag_str_concat(sum, "\n");
    let higher_prefix: []u8 = "entry=toolkit\t1.2.0\tsrc/toolkit.zag\t";
    let higher_checksum: []u8 = _zag_str_concat(sum,
        "\tsig/toolkit.ed25519\n");
    let higher_entry: []u8 = _zag_str_concat(higher_prefix, higher_checksum);
    let body: []u8 = _zag_str_concat(lower_entry, higher_entry);
    _zag_str_free(higher_entry);
    _zag_str_free(higher_checksum);
    _zag_str_free(lower_entry);
    _zag_str_free(sum_line);
    let index: []u8 = reg_resolve_finalize(body);
    let write_source: i32 = _zag_write_file(source_path, source);
    let write_manifest: i32 = _zag_write_file(manifest_path, manifest);
    let write_index: i32 = _zag_write_file(index_path, index);
    reg_resolve_expect(write_source == 0 && write_manifest == 0 && write_index == 0,
        "registry fixture writes successfully", &failures);
    let base: []u8 = package_import_join(root, "src");
    let resolved: PackageImportResolution = package_import_resolve(
        "pkg:toolkit/src/toolkit.zag", base);
    _zag_str_free(base);
    reg_resolve_expect(resolved.matched == 1 && resolved.error == PackageImportError.none &&
        resolved.path.len > 0 && package_raw_checksum_equal(resolved.checksum,
        package_raw_checksum(source)) == 1 &&
        @strEq(resolved.registry_version, "1.2.0") &&
        @strEq(resolved.registry_source, "src/toolkit.zag") &&
        @strEq(resolved.registry_artifact_signature, "sig/toolkit.ed25519") &&
        resolved.graph_authorized == 0,
        "registry wildcard retains the selected tuple before explicit graph admission",
        &failures);
    package_import_resolution_release(&resolved);
    // A successful resolution transfers the index path into the result's
    // owned lockfile snapshot. The release helper owns that allocation; do
    // not free the pre-resolution alias again below.
    index_path = "";

    let mutation_write: i32 = _zag_write_file(source_path,
        "pub fn answer() i32 { return 41; }\n");
    reg_resolve_expect(mutation_write == 0, "registry source mutation writes", &failures);
    let base_changed: []u8 = package_import_join(root, "src");
    let changed: PackageImportResolution = package_import_resolve(
        "pkg:toolkit/src/toolkit.zag", base_changed);
    _zag_str_free(base_changed);
    reg_resolve_expect(changed.error == PackageImportError.checksum_mismatch,
        "selected source mutation fails checksum validation", &failures);
    package_import_resolution_release(&changed);
    let restore_write: i32 = _zag_write_file(source_path, source);
    reg_resolve_expect(restore_write == 0, "registry source restoration writes", &failures);

    let bad_manifest: []u8 = "name = \"registry-consumer\"\nversion = \"0.0.0\"\nedition = \"2026\"\n\n[deps]\ntoolkit = { path = \"registry/index.zag\", mode = \"registry\", version = \"^2.0.0\" }\n";
    let bad_manifest_write: i32 = _zag_write_file(manifest_path, bad_manifest);
    reg_resolve_expect(bad_manifest_write == 0, "registry version mutation writes", &failures);
    let base_incompatible: []u8 = package_import_join(root, "src");
    let incompatible: PackageImportResolution = package_import_resolve(
        "pkg:toolkit/src/toolkit.zag", base_incompatible);
    _zag_str_free(base_incompatible);
    reg_resolve_expect(incompatible.error == PackageImportError.dependency_version_mismatch,
        "incompatible registry requirement fails closed", &failures);
    package_import_resolution_release(&incompatible);

    _zag_str_free(sum); _zag_str_free(body); _zag_str_free(index);
    _zag_str_free(source_path);
    if (index_path.len > 0) { _zag_str_free(index_path); }
    _zag_str_free(manifest_path);
    if (failures == 0) { _zag_println("package registry resolver: 7/7"); }
    return failures;
}
