// tests/vectorize_machine.zag — the smallest program the ZIR-direct route
// accepts that still contains a vectorizable loop.
//
// It is deliberately tiny.  The direct route resolves every SSA name through a
// linear slot lookup, so it is only used for small functions (see
// ZIR_NATIVE_MAX_WORDS in ncodegen.zag).  A fixture with an ArrayList in it
// would be routed through the AST bridge instead, and then the vector ops would
// be verified but never reach an encoder — which is exactly the gap this
// fixture exists to close.
//
// `sum_add_all` is never called: what matters is that it is lowered, and
// lowering emits every declared function whether or not main reaches it.

fn sum_add_all(a: *i32, n: i32) i32 {
    let s: i32 = 0;
    let i: i32 = 0;
    while (i < n) {
        s = s + a[i];
        i = i + 1;
    }
    return s;
}

fn main() i32 {
    return 0;
}
