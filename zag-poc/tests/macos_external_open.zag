// Native libSystem ABI check used by the macOS watcher implementation.
extern fn open(path: *i8, flags: i32) i32
extern fn close(fd: i32) i32
extern fn _zag_slice_ptr(s: []u8) *i8

fn main() i32 {
    let path: []u8 = "/\x00";
    let fd: i32 = open(_zag_slice_ptr(path), 0);
    if (fd < 0) { return 1; }
    if (close(fd) != 0) { return 2; }
    return 42;
}
