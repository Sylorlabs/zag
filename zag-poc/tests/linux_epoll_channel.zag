// Focused contract test for the bounded Linux epoll/eventfd and SPSC channel.

@import("std:linux_epoll") as poll
@import("std:channel_i64") as channel
@import("std:rt")

extern fn _zag_allocator_live_bytes() i64

struct TwoEpollEvents {
    first: poll.LinuxEpollEvent,
    second: poll.LinuxEpollEvent,
}

fn main() i32 {
    let baseline: i64 = _zag_allocator_live_bytes();

    let bad_event: poll.LinuxEventFdResult = poll.linux_eventfd_create(0 - 1);
    if (bad_event.ok != 0 ||
        bad_event.code != poll.linux_epoll_status_invalid_argument()) {
        return 1;
    }

    let epoll_created: poll.LinuxEpollResult = poll.linux_epoll_create();
    let event_created: poll.LinuxEventFdResult = poll.linux_eventfd_create(0);
    if (epoll_created.ok == 0 || event_created.ok == 0) { return 2; }
    let epoll: poll.LinuxEpoll = poll.linux_epoll_take(&epoll_created);
    let event: poll.LinuxEventFd = poll.linux_eventfd_take(&event_created);
    if (poll.linux_epoll_take(&epoll_created).open != 0 ||
        poll.linux_eventfd_take(&event_created).open != 0) { return 3; }

    let output: poll.LinuxEpollEvent = poll.LinuxEpollEvent{
        .events = 0, .token = 0,
    };
    if (poll.linux_epoll_wait(&epoll, &output, 0, 0).code !=
        poll.linux_epoll_status_invalid_argument()) { return 4; }
    if (poll.linux_epoll_wait(&epoll, &output, 65, 0).code !=
        poll.linux_epoll_status_invalid_argument()) { return 5; }
    if (poll.linux_epoll_wait(&epoll, &output, 1, 5001).code !=
        poll.linux_epoll_status_invalid_argument()) { return 6; }
    if (poll.linux_eventfd_signal(&event, 0) !=
        poll.linux_epoll_status_invalid_argument()) { return 7; }
    let empty_event: poll.LinuxEventFdReadResult =
        poll.linux_eventfd_consume(&event);
    if (empty_event.ok != 0 ||
        empty_event.code != poll.linux_epoll_status_empty()) { return 8; }
    if (poll.linux_epoll_add_eventfd(&epoll, &event, 0) !=
        poll.linux_epoll_status_invalid_argument()) { return 9; }
    if (poll.linux_epoll_add_eventfd(&epoll, &event, 4242) != 0) { return 10; }
    if (poll.linux_epoll_add_eventfd(&epoll, &event, 4242) != (0 - 17)) {
        return 11;
    }
    if (poll.linux_eventfd_signal(&event, 2) != 0 ||
        poll.linux_eventfd_signal(&event, 3) != 0) { return 12; }
    let ready: poll.LinuxEpollWaitResult =
        poll.linux_epoll_wait(&epoll, &output, 1, 1000);
    if (ready.ok == 0 || ready.count != 1 || ready.wait_calls != 1 ||
        output.events != poll.linux_epoll_readable() || output.token != 4242) {
        return 13;
    }
    let consumed: poll.LinuxEventFdReadResult =
        poll.linux_eventfd_consume(&event);
    if (consumed.ok == 0 || consumed.value != 5) { return 14; }
    let timed: poll.LinuxEpollWaitResult =
        poll.linux_epoll_wait(&epoll, &output, 1, 40);
    if (timed.ok == 0 || timed.count != 0 || timed.wait_calls != 1 ||
        timed.elapsed_ms < 25 || timed.elapsed_ms > 1000) { return 15; }
    let second_created: poll.LinuxEventFdResult = poll.linux_eventfd_create(0);
    if (second_created.ok == 0) { return 16; }
    let second_event: poll.LinuxEventFd =
        poll.linux_eventfd_take(&second_created);
    if (poll.linux_epoll_add_eventfd(&epoll, &second_event, 4343) != 0 ||
        poll.linux_eventfd_signal(&event, 7) != 0 ||
        poll.linux_eventfd_signal(&second_event, 9) != 0) { return 17; }
    let pair: TwoEpollEvents = TwoEpollEvents{
        .first = poll.LinuxEpollEvent{ .events = 0, .token = 0 },
        .second = poll.LinuxEpollEvent{ .events = 0, .token = 0 },
    };
    let two_ready: poll.LinuxEpollWaitResult =
        poll.linux_epoll_wait(&epoll, &pair.first, 2, 1000);
    if (two_ready.ok == 0 || two_ready.count != 2 ||
        pair.first.events != poll.linux_epoll_readable() ||
        pair.second.events != poll.linux_epoll_readable()) { return 18; }
    if (!((pair.first.token == 4242 && pair.second.token == 4343) ||
          (pair.first.token == 4343 && pair.second.token == 4242))) {
        return 19;
    }
    if (poll.linux_eventfd_consume(&event).value != 7 ||
        poll.linux_eventfd_consume(&second_event).value != 9) { return 20; }
    if (poll.linux_epoll_remove_eventfd(&epoll, &second_event) != 0 ||
        poll.linux_epoll_remove_eventfd(&epoll, &event) != 0) { return 21; }
    if (poll.linux_epoll_remove_eventfd(&epoll, &event) !=
        poll.linux_epoll_status_invalid_state()) { return 22; }
    if (poll.linux_eventfd_close(&second_event) != 0 ||
        poll.linux_eventfd_close(&second_event) !=
            poll.linux_epoll_status_invalid_state()) { return 23; }
    if (poll.linux_eventfd_close(&event) != 0 ||
        poll.linux_eventfd_close(&event) !=
            poll.linux_epoll_status_invalid_state()) { return 24; }
    if (poll.linux_eventfd_signal(&event, 1) !=
        poll.linux_epoll_status_invalid_state()) { return 25; }
    if (poll.linux_epoll_close(&epoll) != 0 ||
        poll.linux_epoll_close(&epoll) !=
            poll.linux_epoll_status_invalid_state()) { return 26; }
    if (poll.linux_epoll_wait(&epoll, &output, 1, 0).code !=
        poll.linux_epoll_status_invalid_state()) { return 27; }

    let zero_channel: channel.ChannelI64Result = channel.channel_i64_create(0);
    let large_channel: channel.ChannelI64Result = channel.channel_i64_create(65);
    if (zero_channel.ok != 0 || large_channel.ok != 0 ||
        zero_channel.code != channel.channel_i64_status_invalid_argument() ||
        large_channel.code != channel.channel_i64_status_invalid_argument()) {
        return 28;
    }
    let created: channel.ChannelI64Result = channel.channel_i64_create(2);
    if (created.ok == 0) { return 29; }
    let queue: channel.ChannelI64 = channel.channel_i64_take(&created);
    if (channel.channel_i64_take(&created).open != 0) { return 30; }
    let empty: channel.ChannelI64ReceiveResult =
        channel.channel_i64_try_receive(&queue);
    if (empty.ok != 0 || empty.code != channel.channel_i64_status_empty() ||
        empty.wait_calls != 0) { return 31; }
    if (channel.channel_i64_send_wait(&queue, 9, 0).ok == 0 ||
        channel.channel_i64_try_send(&queue, 11).ok == 0) { return 32; }
    let full: channel.ChannelI64SendResult =
        channel.channel_i64_try_send(&queue, 13);
    if (full.ok != 0 || full.code != channel.channel_i64_status_full() ||
        channel.channel_i64_count(&queue) != 2) { return 33; }
    let first: channel.ChannelI64ReceiveResult =
        channel.channel_i64_try_receive(&queue);
    let second: channel.ChannelI64ReceiveResult =
        channel.channel_i64_try_receive(&queue);
    if (first.ok == 0 || second.ok == 0 || first.value != 9 ||
        second.value != 11 || channel.channel_i64_count(&queue) != 0) {
        return 34;
    }
    let channel_timeout: channel.ChannelI64ReceiveResult =
        channel.channel_i64_receive_wait(&queue, 40);
    if (channel_timeout.ok != 0 ||
        channel_timeout.code != channel.channel_i64_status_timeout() ||
        channel_timeout.wait_calls < 1 || channel_timeout.wait_calls > 2 ||
        channel_timeout.elapsed_ms < 25 || channel_timeout.elapsed_ms > 1000) {
        return 35;
    }
    if (channel.channel_i64_receive_wait(&queue, 5001).code !=
        channel.channel_i64_status_invalid_argument()) { return 36; }
    if (channel.channel_i64_close(&queue) != 0 ||
        channel.channel_i64_close(&queue) !=
            channel.channel_i64_status_invalid_state()) { return 37; }
    if (channel.channel_i64_try_send(&queue, 1).code !=
        channel.channel_i64_status_invalid_state() ||
        channel.channel_i64_try_receive(&queue).code !=
            channel.channel_i64_status_invalid_state()) { return 38; }

    if (_zag_allocator_live_bytes() != baseline) { return 39; }
    return 0;
}
