@import("../selfhost/std/script_string_builder.zag") as sb

fn main() i32 {
    let memory: *i8 = _zag_malloc(8);
    let builder: sb.ScriptStringBuilder = sb.string_builder_from_buffer(memory, 8);
    if (sb.string_builder_append(&builder, "strict") != 0) { return 1; }
    if (!@strEq(sb.string_builder_output(&builder), "strict")) { return 2; }
    return 0;
}
