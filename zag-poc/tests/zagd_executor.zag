@import("../selfhost/zagd_benchmark.zag")
fn expect(v:bool,f:*i32)void{if(!v){f[0]=f[0]+1;}}
fn main()i32{let f:i32=0;let c:i32=0;let path:[]u8=_zag_arg(1);let slow:[]u8=_zag_arg(2);let noisy:[]u8=_zag_arg(3);let r:ZagdExecutionResult=zagd_execute_finalist(path,1000,67108864,1024,&c);expect(r.state==zagd_execution_exited()&&r.exit_code==7&&r.term_signal==0&&@strEq(r.stdout,"final-out")&&@strEq(r.stderr,"final-err\n"),&f);expect(zagd_execution_equivalent(r,r)==1,&f);let altered:ZagdExecutionResult=ZagdExecutionResult{.state=r.state,.exit_code=0,.term_signal=r.term_signal,.stdout=r.stdout,.stderr=r.stderr,.elapsed_ms=r.elapsed_ms};expect(zagd_execution_equivalent(r,altered)==0,&f);let m:ZagdExecutionResult=zagd_execute_finalist("/definitely/missing/zagd-finalist",1000,67108864,1024,&c);expect(m.state==zagd_execution_exited()&&m.exit_code==127,&f);let t:ZagdExecutionResult=zagd_execute_finalist(slow,20,67108864,1024,&c);expect(t.state==zagd_execution_timed_out()&&t.term_signal==9,&f);let o:ZagdExecutionResult=zagd_execute_finalist(noisy,1000,67108864,64,&c);expect(o.state==zagd_execution_output_limit(),&f);c=1;let x:ZagdExecutionResult=zagd_execute_finalist(path,1000,67108864,1024,&c);expect(x.state==zagd_execution_cancelled(),&f);return f;}
