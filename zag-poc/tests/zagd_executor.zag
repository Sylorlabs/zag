@import("../selfhost/zagd_benchmark.zag")

fn expect(value: bool, message: []u8, failures: *i32) void {
    if (!value) {
        _zag_eprintln(message);
        failures[0] = failures[0] + 1;
    }
}

fn main() i32 {
    let failures: i32 = 0;
    let cancelled: i32 = 0;
    let path: []u8 = _zag_arg(1);
    let slow: []u8 = _zag_arg(2);
    let noisy: []u8 = _zag_arg(3);

    let result: ZagdExecutionResult =
        zagd_execute_finalist(path, 1000, 67108864, 1024, &cancelled);
    expect(result.state == zagd_execution_exited() &&
        result.exit_code == 7 && result.term_signal == 0 &&
        @strEq(result.stdout, "final-out") &&
        @strEq(result.stderr, "final-err\n"),
        "executor: normal finalist result", &failures);
    expect(zagd_execution_equivalent(result, result) == 1,
        "executor: self equivalence", &failures);

    let altered: ZagdExecutionResult = ZagdExecutionResult{
        .state=result.state,
        .exit_code=0,
        .term_signal=result.term_signal,
        .stdout=result.stdout,
        .stderr=result.stderr,
        .elapsed_ms=result.elapsed_ms,
        .stdout_owned=0,
        .stderr_owned=0,
    };
    expect(zagd_execution_equivalent(result, altered) == 0,
        "executor: altered result inequivalence", &failures);

    let missing: ZagdExecutionResult =
        zagd_execute_finalist("/definitely/missing/zagd-finalist",
            1000, 67108864, 1024, &cancelled);
    expect(missing.state == zagd_execution_exited() &&
        missing.exit_code == 127,
        "executor: missing finalist exit", &failures);

    let timed: ZagdExecutionResult =
        zagd_execute_finalist(slow, 20, 67108864, 1024, &cancelled);
    expect(timed.state == zagd_execution_timed_out() &&
        timed.term_signal == 9,
        "executor: slow finalist timeout", &failures);

    let output_limited: ZagdExecutionResult =
        zagd_execute_finalist(noisy, 1000, 67108864, 64, &cancelled);
    expect(output_limited.state == zagd_execution_output_limit(),
        "executor: noisy finalist output limit", &failures);

    cancelled = 1;
    let cancelled_result: ZagdExecutionResult =
        zagd_execute_finalist(path, 1000, 67108864, 1024, &cancelled);
    expect(cancelled_result.state == zagd_execution_cancelled(),
        "executor: cancellation", &failures);

    zagd_execution_result_free(&result);
    zagd_execution_result_free(&missing);
    zagd_execution_result_free(&timed);
    zagd_execution_result_free(&output_limited);
    zagd_execution_result_free(&cancelled_result);
    return failures;
}
