// Typed consuming cancellation cleanup witness.

@import("std:task_i64") as task
@import("std:task_i64_cancel_join") as cancel_join

fn cancellable_worker(raw:i64) i64 {
    unsafe {
        let handle:*opaque = raw as *opaque;
        let i:i64 = 0;
        while (i < 10000000) {
            if (@taskCancelled(handle) == 1) { return 0 - 999; }
            let _yielded:i64 = _zag_raw_syscall(24, 0, 0, 0, 0, 0, 0);
            i = i + 1;
        }
        return @taskInput(handle);
    }
}

fn main() i32 {
    unsafe {
        let handle:*opaque = @taskSpawn(cancellable_worker, 41);
        if (handle == null as *opaque) { return 1; }
        let joined:task.TaskI64JoinResult = task.TaskI64JoinResult{
            .ok = 0, .code = 0, .value = 0, .cancellation_requested = 0};
        // znc:allow A0102 -- typed status is mirrored into `joined.code`.
        cancel_join.task_i64_cancel_and_await_into(handle, &joined);
        if (joined.code != task.task_i64_poll_status_ok() || joined.ok != 1 ||
            joined.code != task.task_i64_poll_status_ok() ||
            joined.value != 0 - 999 || joined.cancellation_requested != 1) {
            return 2;
        }

        let invalid_handle:*opaque = 0 as *opaque;
        let invalid_join:task.TaskI64JoinResult = task.TaskI64JoinResult{
            .ok = 7, .code = 7, .value = 7, .cancellation_requested = 7};
        // znc:allow A0102 -- invalid-handle status is mirrored into output.
        cancel_join.task_i64_cancel_and_await_into(invalid_handle, &invalid_join);
        if (invalid_join.code != task.task_i64_poll_status_invalid_handle() ||
            invalid_join.ok != 0) { return 3; }

        let rejected_output:*opaque = @taskSpawn(cancellable_worker, 7);
        // znc:allow A0102 -- invalid output is intentionally a consuming path.
        cancel_join.task_i64_cancel_and_await_into(
            rejected_output, 0 as *task.TaskI64JoinResult);
    }
    _zag_println("task-i64-cancel-join consumed=2 typed=1 invalid=2");
    return 0;
}
