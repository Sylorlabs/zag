// Focused witness for the bounded TaskI64 selector.  Selection is borrowed
// observation only: all three affine task handles are awaited exactly once.

@import("std:task_i64") as task
@import("std:task_i64_select") as select

struct Delay {
    seconds: i64,
    nanoseconds: i64,
}

fn delayed_worker(raw:i64) i64 {
    unsafe {
        let delay:Delay = Delay{.seconds = 0, .nanoseconds = 100000000};
        let _slept:i64 = _zag_raw_syscall(35, (&delay) as i64, 0, 0, 0, 0, 0);
        return @taskInput(raw as *opaque);
    }
}

fn immediate_worker(raw:i64) i64 {
    unsafe { return @taskInput(raw as *opaque) + 1; }
}

fn main() i32 {
    unsafe {
        let invalid:select.TaskI64SelectResult =
            select.task_i64_select(null as *select.TaskI64SelectSet, 0);
        if (invalid.ok != 0 ||
            invalid.code != select.task_i64_select_status_invalid_set()) {
            return 1;
        }

        let first:*opaque = @taskSpawn(delayed_worker, 10);
        let second:*opaque = @taskSpawn(immediate_worker, 41);
        if (first == null as *opaque || second == null as *opaque) { return 2; }
        let set:select.TaskI64SelectSet = select.TaskI64SelectSet{
            .h0 = first, .h1 = second,
            .h2 = null as *opaque, .h3 = null as *opaque,
            .h4 = null as *opaque, .h5 = null as *opaque,
            .h6 = null as *opaque, .h7 = null as *opaque, .count = 2};
        let selected:select.TaskI64SelectResult =
            select.task_i64_select(&set, 1000);
        if (selected.ok != 1 || selected.index != 1 ||
            selected.state != task.task_i64_poll_ready() ||
            selected.value != 42 || selected.cancellation_requested != 0) {
            return 3;
        }
        let duplicate:select.TaskI64SelectSet = select.TaskI64SelectSet{
            .h0 = first, .h1 = first,
            .h2 = null as *opaque, .h3 = null as *opaque,
            .h4 = null as *opaque, .h5 = null as *opaque,
            .h6 = null as *opaque, .h7 = null as *opaque, .count = 2};
        let duplicate_result:select.TaskI64SelectResult =
            select.task_i64_select(&duplicate, 0);
        if (duplicate_result.ok != 0 ||
            duplicate_result.code != select.task_i64_select_status_invalid_set()) {
            return 9;
        }
        if (@taskAwait(first) != 10 || @taskAwait(second) != 42) { return 4; }

        let third:*opaque = @taskSpawn(delayed_worker, 99);
        if (third == null as *opaque) { return 5; }
        let timeout_set:select.TaskI64SelectSet = select.TaskI64SelectSet{
            .h0 = third, .h1 = null as *opaque,
            .h2 = null as *opaque, .h3 = null as *opaque,
            .h4 = null as *opaque, .h5 = null as *opaque,
            .h6 = null as *opaque, .h7 = null as *opaque, .count = 1};
        let bad_timeout:select.TaskI64SelectResult =
            select.task_i64_select(&timeout_set, 5001);
        if (bad_timeout.ok != 0 ||
            bad_timeout.code != select.task_i64_select_status_invalid_timeout()) {
            return 10;
        }
        let pending:select.TaskI64SelectResult =
            select.task_i64_select(&timeout_set, 0);
        if (pending.ok != 1 || pending.index != 0 - 1 ||
            pending.state != task.task_i64_poll_pending()) { return 6; }
        let completed:select.TaskI64SelectResult =
            select.task_i64_select(&timeout_set, 1000);
        if (completed.ok != 1 || completed.index != 0 ||
            completed.state != task.task_i64_poll_ready() ||
            completed.value != 99) { return 7; }
        if (@taskAwait(third) != 99) { return 8; }
    }
    _zag_println("task-i64-select handles=3 ready=2 timeout=1");
    return 0;
}
