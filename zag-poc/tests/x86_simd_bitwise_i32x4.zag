// Exercise all three baseline SSE2 packed bitwise operations. The byte-level
// setup keeps Zag's scalar word-stride layout out of this raw packed region.
fn main() i32 {
    unsafe {
    let lhs:*u8 = _zag_malloc(32) as *u8;
    let rhs:*u8 = _zag_malloc(32) as *u8;
    let out:*u8 = _zag_malloc(32) as *u8;
    let i:i32=0;
    while(i<16){lhs[i]=(240+i) as u8;rhs[i]=(15+i) as u8;i=i+1;}
    @simdAndI32x4(out as *mut i32,lhs as *const i32,rhs as *const i32);
    if(out[0]!=0 || out[1]!=16 || out[15]!=30){return 10;}
    @simdOrI32x4(out as *mut i32,lhs as *const i32,rhs as *const i32);
    if(out[0]!=255 || out[1]!=241 || out[15]!=255){return 11;}
    @simdXorI32x4(out as *mut i32,lhs as *const i32,rhs as *const i32);
    if(out[0]!=255 || out[1]!=225 || out[15]!=225){return 12;}
    _zag_free(lhs);_zag_free(rhs);_zag_free(out);
    return 0;
    }
}
