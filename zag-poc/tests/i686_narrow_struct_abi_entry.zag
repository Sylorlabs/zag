// Caller-side witness for the Zag i686 word-slot aggregate ABI. Every narrow
// field is stored in a complete 32-bit slot but must preserve its declared
// sign/zero-extension or canonical-bool semantics across a separate ELF32
// object, a by-value call, and a hidden-sret result.
struct NarrowPacket {
    signed8:i8,
    unsigned8:u8,
    signed16:i16,
    unsigned16:u16,
    enabled:bool,
}

extern fn transform_narrow_packet(packet:NarrowPacket) NarrowPacket;

fn main() i32 {
    let input:NarrowPacket=NarrowPacket{
        .signed8=127,
        .unsigned8=254,
        .signed16=32767,
        .unsigned16=65535,
        .enabled=false,
    };
    input.signed8=input.signed8+(2 as i8);
    input.unsigned8=input.unsigned8+(3 as u8);
    input.signed16=input.signed16+(2 as i16);
    input.unsigned16=input.unsigned16+(2 as u16);
    input.enabled=9 as bool;

    let output:NarrowPacket=transform_narrow_packet(input);
    let copied:NarrowPacket=output;
    let assigned:NarrowPacket=NarrowPacket{
        .signed8=0,
        .unsigned8=0,
        .signed16=0,
        .unsigned16=0,
        .enabled=false,
    };
    assigned=copied;

    if ((assigned.signed8 as i32)!=-126) { return 1; }
    if ((assigned.unsigned8 as i32)!=2) { return 2; }
    if ((assigned.signed16 as i32)!=-32766) { return 3; }
    if ((assigned.unsigned16 as i32)!=2) { return 4; }
    if (assigned.enabled==false) { return 5; }
    return 42;
}
