script;
let name:[]u8="Zag";
let count:int=40;
let ready:bool=True;
let negative:i64=-7;
println("hello {name}!");
println("count {count + 2} ready {ready}");
println("negative {negative}");
println("float literal {1.5}");
println("negative float literal {-2.5}");
let rate:float=1.5;
let adjusted:f64=rate+0.25;
println("float variable {rate} adjusted {adjusted}");
let rounded:f64=1.2345678;
println("float rounded {rounded}");
println("eq=a=b");
println("{{ok}} {name}");
println("{{only}}");
let rendered:[]u8="left {name} right";
if rendered.len != 14:
    return 1
if script_alloc_used() <= 0:
    return 2
return 0;
