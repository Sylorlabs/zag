@import("std:dns_system") as resolver

extern fn _zag_allocator_live_bytes() i64

fn main() i32 {
    let baseline: i64 = _zag_allocator_live_bytes();
    let invalid_host: resolver.DnsSystemResult =
        resolver.dns_system_resolve("bad/name", "80", 0, 1);
    let invalid_service: resolver.DnsSystemResult =
        resolver.dns_system_resolve("localhost", "http/", 0, 1);
    let invalid_family: resolver.DnsSystemResult =
        resolver.dns_system_resolve("localhost", "80", 7, 1);
    if (invalid_host.ok != 0 || invalid_host.code !=
            resolver.dns_system_status_invalid_argument() ||
        invalid_service.ok != 0 || invalid_service.code !=
            resolver.dns_system_status_invalid_argument() ||
        invalid_family.ok != 0 || invalid_family.code !=
            resolver.dns_system_status_invalid_argument()) { return 1; }
    if (_zag_allocator_live_bytes() != baseline) { return 2; }
    let local: resolver.DnsSystemResult =
        resolver.dns_system_resolve("localhost", "80", 0, 1);
    if (local.ok != 1 || local.count <= 0 || local.count > 16) { return 3; }
    let saw_v4: i32 = 0; let i: i32 = 0;
    while (i < local.count) {
        let item: resolver.DnsSystemAddress = local.values.data[i];
        if (item.family == 2 && item.port == 80 && item.low != 0) { saw_v4 = 1; }
        i = i + 1;
    }
    if (saw_v4 == 0) { return 4; }
    resolver.dns_system_free(&local);
    if (local.count != 0 || local.values.data != null as *resolver.DnsSystemAddress) { return 5; }
    let named: resolver.DnsSystemResult =
        resolver.dns_system_resolve("localhost", "http", 2, 1);
    if (named.ok != 1 || named.count <= 0 ||
        named.values.data[0].port != 80) { return 9; }
    resolver.dns_system_free(&named);
    let loopback: resolver.DnsSystemResult =
        resolver.dns_system_resolve("::1", "443", 10, 1);
    if (loopback.ok != 1 || loopback.count <= 0) { return 6; }
    let saw_v6: i32 = 0; i = 0;
    while (i < loopback.count) {
        let item: resolver.DnsSystemAddress = loopback.values.data[i];
        if (item.family == 10 && item.port == 443 && item.high == 0 &&
            item.low == 1 && item.scope == 0) { saw_v6 = 1; }
        i = i + 1;
    }
    if (saw_v6 == 0) { return 7; }
    resolver.dns_system_free(&loopback);
    if (_zag_allocator_live_bytes() != baseline) { return 8; }
    _zag_println("dns system resolver: localhost + IPv6 loopback + fail-closed validation");
    return 0;
}
