@import("../selfhost/script_auto.zag")

fn at_config()ScriptAutoConfig {
    return ScriptAutoConfig{.bits=4,.variables=2,.work_budget=20000000,
        .source_id="test-source-graph",.compiler_id="test-compiler",.target_id="test-target"};
}
fn at_expect(ok:bool,label:[]u8,fail:*i32)void {
    if(ok){_zag_println(_zag_str_concat("ok  ",label));}
    else{_zag_eprintln(_zag_str_concat("FAIL ",label));fail.*=fail.*+1;}
}
fn at_reject(s:[]u8,c:ScriptAutoConfig)bool {
    let r:ScriptAutoResult=script_auto_optimize(s,c);let ok:bool=r.ok==0&&r.generated.len==0&&r.record.len==0;
    script_auto_result_free(&r);return ok;
}
fn main()i32 {
    let c:ScriptAutoConfig=at_config();
    if(_zag_argc()==3){
        let r:ScriptAutoResult=script_auto_optimize(_zag_arg(2),c);
        if(r.ok==0){_zag_eprintln(r.error);return 1;}
        if(@strEq(_zag_arg(1),"--emit")){_zag_print(r.generated);}
        else if(@strEq(_zag_arg(1),"--record")){_zag_print(r.record);}
        else{script_auto_result_free(&r);return 2;}
        script_auto_result_free(&r);return 0;
    }
    let fail:i32=0;
    let r:ScriptAutoResult=script_auto_optimize("x 0 + y 0 + *",c);
    at_expect(r.ok==1&&r.cost==3&&r.assignments==256&&r.candidates==1963,"bounded optimum and full domain",&fail);
    at_expect(r.candidate_index>0&&r.work_bound==1499392,"exact worst-case work bound",&fail);
    let again:ScriptAutoResult=script_auto_optimize("x 0 + y 0 + *",c);
    at_expect(@strEq(r.generated,again.generated)&&@strEq(r.record,again.record),"deterministic output and record",&fail);
    at_expect(script_auto_verify_record("x 0 + y 0 + *",c,r.record)==1,"record replay recomputes",&fail);
    let changed:ScriptAutoConfig=at_config();changed.target_id="different";
    at_expect(script_auto_verify_record("x 0 + y 0 + *",changed,r.record)==0,"target invalidates evidence",&fail);
    changed=at_config();changed.compiler_id="different";
    at_expect(script_auto_verify_record("x 0 + y 0 + *",changed,r.record)==0,"compiler invalidates evidence",&fail);
    changed=at_config();changed.source_id="different";
    at_expect(script_auto_verify_record("x 0 + y 0 + *",changed,r.record)==0,"graph invalidates evidence",&fail);
    at_expect(script_auto_verify_record("x y +",c,r.record)==0,"reference invalidates evidence",&fail);
    r.record[0]='X';
    at_expect(script_auto_verify_record("x 0 + y 0 + *",c,r.record)==0,"tampered certificate rejected",&fail);
    let identity:ScriptAutoResult=script_auto_optimize("x 0 +",c);
    at_expect(identity.ok==1&&identity.cost==1&&identity.candidate_index==17,"identity selects input leaf",&fail);
    let constant:ScriptAutoResult=script_auto_optimize("15 1 +",c);
    at_expect(constant.ok==1&&constant.cost==1&&constant.candidate_index==1,"modular constant folding",&fail);
    let tie:ScriptAutoResult=script_auto_optimize("x y +",c);
    at_expect(tie.ok==1&&tie.candidate_index==0&&tie.cost==3,"ties retain reference",&fail);
    let fallback:ScriptAutoResult=script_auto_optimize("x x * y +",c);
    at_expect(fallback.ok==1&&fallback.candidate_index==0&&fallback.cost==5,"reference outside shallow grammar retained",&fail);
    let proof:ScriptAutoProof=script_auto_check("x y +","y x +",c);
    at_expect(proof.ok==1&&proof.equivalent==1&&proof.checked==256,"exhaustive commutativity",&fail);
    proof=script_auto_check("x y -","y x -",c);
    at_expect(proof.ok==1&&proof.equivalent==0&&proof.counter_x==1&&proof.counter_y==0&&proof.reference_value==1&&proof.candidate_value==15,"wrong candidate with counterexample",&fail);
    proof=script_auto_check("x y +","x call",c);
    at_expect(proof.ok==0&&proof.equivalent==0,"unknown candidate cannot be verified",&fail);
    at_expect(at_reject("",c)&&at_reject("dot",c)&&at_reject("auto optimize(runtime)",c),"missing semantic computation rejected",&fail);
    at_expect(at_reject("x /",c)&&at_reject("x y /",c)&&at_reject("x 1 <<",c)&&at_reject("1.0",c),"division shifts floats rejected",&fail);
    at_expect(at_reject("x y",c)&&at_reject("x +",c)&&at_reject("x y + +",c),"malformed stacks rejected",&fail);
    at_expect(at_reject("16",c)&&at_reject("-1",c)&&at_reject("999999999999999999",c),"out-of-domain constants rejected",&fail);
    at_expect(at_reject("read_file",c)&&at_reject("x @io",c)&&at_reject("x z +",c),"effects unknown inputs rejected",&fail);
    changed=at_config();changed.bits=0;at_expect(at_reject("0",changed),"zero width rejected",&fail);
    changed.bits=5;at_expect(at_reject("0",changed),"unsupported width rejected",&fail);
    changed=at_config();changed.variables=3;at_expect(at_reject("0",changed),"unsupported arity rejected",&fail);
    changed=at_config();changed.variables=0;at_expect(at_reject("x",changed)&&at_reject("y",changed),"undeclared inputs rejected",&fail);
    let zero:ScriptAutoResult=script_auto_optimize("15 1 +",changed);
    at_expect(zero.ok==1&&zero.assignments==1&&zero.cost==1,"closed expression domain",&fail);
    changed=at_config();changed.work_budget=r.work_bound-1;
    at_expect(at_reject("x 0 + y 0 + *",changed),"budget exhaustion produces no proof",&fail);
    changed.work_budget=r.work_bound;
    let exact:ScriptAutoResult=script_auto_optimize("x 0 + y 0 + *",changed);
    at_expect(exact.ok==1,"exact budget accepted",&fail);
    changed.work_budget=1;proof=script_auto_check("x","x",changed);
    at_expect(proof.ok==0&&proof.checked==0,"checker budget fail closed",&fail);
    changed=at_config();changed.source_id="";at_expect(at_reject("x",changed),"missing identity rejected",&fail);
    at_expect(at_reject("x x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x +",c),"node bound enforced",&fail);
    let bits:i32=1;let widths_ok:bool=true;
    while(bits<=4){changed=at_config();changed.bits=bits;proof=script_auto_check("x x ^","0",changed);
        if(proof.ok!=1||proof.equivalent!=1||proof.checked!=sa_states(changed)){widths_ok=false;}bits=bits+1;}
    at_expect(widths_ok,"all supported widths exhaustively checked",&fail);
    script_auto_result_free(&r);script_auto_result_free(&again);script_auto_result_free(&identity);
    script_auto_result_free(&constant);script_auto_result_free(&tie);script_auto_result_free(&fallback);
    script_auto_result_free(&zero);script_auto_result_free(&exact);
    at_expect(r.ok==0&&r.record.len==0&&r.generated.len==0,"release clears proof and owned output",&fail);
    script_auto_result_free(&r);
    if(fail!=0){return 1;}_zag_println("script auto unit: PASS");return 0;
}
