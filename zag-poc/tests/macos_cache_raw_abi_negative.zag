// The Darwin cache adapter admits only its audited no-follow open, fstat, and
// fsync argument profiles. Near-miss tuples must fail before touching memory
// or issuing an unrelated XNU operation.
extern fn _zag_raw_syscall(num:i64,a1:i64,a2:i64,a3:i64,a4:i64,a5:i64,a6:i64)i64;

fn main() i32 {
    if (_zag_raw_syscall(2, 1, 0, 0, 0, 0, 0) != 0 - 78) { return 1; }
    if (_zag_raw_syscall(5, 0, 1, 1, 0, 0, 0) != 0 - 78) { return 2; }
    if (_zag_raw_syscall(74, 0, 1, 0, 0, 0, 0) != 0 - 78) { return 3; }
    if (_zag_raw_syscall(262, -100, 1, 1, 0, 0, 0) != 0 - 78) { return 4; }
    if (_zag_raw_syscall(262, -100, 1, 1, 256, 1, 0) != 0 - 78) { return 5; }
    if (_zag_raw_syscall(262, -100, 1, 1, 256, 0, 1) != 0 - 78) { return 6; }
    if (_zag_raw_syscall(262, -100, 0, 1, 256, 0, 0) != 0 - 78) { return 7; }
    if (_zag_raw_syscall(262, -100, 1, 0, 256, 0, 0) != 0 - 78) { return 8; }
    // Darwin's AT_FDCWD must not be accepted as a Linux descriptor.
    if (_zag_raw_syscall(262, -2, 1, 1, 256, 0, 0) != 0 - 9) { return 9; }
    // The evidence writer adds precisely 0755 beside private 0600 creation.
    // Broader permissions and a truncate-shaped tuple remain refused before
    // the deliberately invalid path pointer can reach the kernel.
    if (_zag_raw_syscall(2, 1, 655553, 511, 0, 0, 0) != 0 - 78) { return 10; }
    if (_zag_raw_syscall(2, 1, 655937, 493, 0, 0, 0) != 0 - 78) { return 11; }
    return 42;
}
