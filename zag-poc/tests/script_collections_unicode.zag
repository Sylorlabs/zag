@import("std:range") as ranges
@import("std:utf8") as utf8

script;

let allocation_before = script_alloc_used();
let first_range: ranges.RangeNextI64 = ranges.range_item_i64(2, 11, 3, 4, 0);
let second_range: ranges.RangeNextI64 = ranges.range_item_i64(2, 11, 3, 4, 1);
let third_range: ranges.RangeNextI64 = ranges.range_item_i64(2, 11, 3, 4, 2);
let end_range: ranges.RangeNextI64 = ranges.range_item_i64(2, 11, 3, 4, 3);
if (first_range.status != ranges.range_status_item() || first_range.value != 2 ||
    second_range.value != 5 || third_range.value != 8 ||
    end_range.status != ranges.range_status_exhausted()) { return 1; }
let limited_range: ranges.RangeNextI64 = ranges.range_item_i64(0, 100, 1, 2, 2);
if (limited_range.status != ranges.range_status_limit()) { return 2; }

let text: []u8 = "Z\xc3\xa4g \xf0\x9f\x8c\x8d";
let checked: utf8.Utf8Validation = utf8.utf8_validate(text);
if (checked.status != utf8.utf8_status_exhausted() ||
    checked.scalar_count != 5) { return 3; }
let first: utf8.Utf8Decode = utf8.utf8_decode_at(text, 0);
let second: utf8.Utf8Decode = utf8.utf8_decode_at(text, 1);
if (first.scalar != 90 || second.scalar != 228) { return 4; }
if (utf8.utf8_validate("\xed\xa0\x80").status !=
    utf8.utf8_status_malformed()) { return 5; }
if (script_alloc_used() != allocation_before) { return 6; }
return 0;
