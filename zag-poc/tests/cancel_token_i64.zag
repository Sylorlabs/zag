// Cross-thread cooperative cancellation witness for std:cancel_token_i64.

@import("std:cancel_token_i64") as cancel
@import("std:rt")

struct CancelContext {
    token: cancel.CancelTokenI64,
    word: i64,
    started: i64,
    observed: i64,
    iterations: i64,
}

fn cancel_worker(context_address: i64) void {
    let context: *CancelContext = null as *CancelContext;
    unsafe { context = context_address as *CancelContext; }
    unsafe {
        @atomicStore64Order((&context.*.started) as *mut i64, 1, 2);
    }
    let iterations: i64 = 0;
    while (iterations < 1000000) {
        let requested: i32 =
            cancel.cancel_token_i64_is_requested(&context.*.token);
        if (requested == 1) {
            context.*.observed = 1;
            context.*.iterations = iterations;
            return;
        }
        iterations = iterations + 1;
        unsafe { let _yielded: i64 = _zag_raw_syscall(24, 0, 0, 0, 0, 0, 0); }
    }
    context.*.iterations = iterations;
}

fn main() i32 {
    let address: i64 = _zag_raw_syscall(9, 0, 4096, 3, 34, 0 - 1, 0);
    if (address < 0) { return 1; }
    let context: *CancelContext = null as *CancelContext;
    unsafe { context = address as *CancelContext; }
    context.*.word = 0;
    context.*.started = 0;
    context.*.observed = 0;
    context.*.iterations = 0;
    context.*.token = cancel.cancel_token_i64_invalid();
    let init_rc: i64 = 0;
    unsafe {
        init_rc = cancel.cancel_token_i64_init(
            &context.*.token, (&context.*.word) as *i64);
    }
    if (init_rc != 0) {
        let _unmap: i64 = _zag_raw_syscall(11, address, 4096, 0, 0, 0, 0);
        return 2;
    }
    unsafe {
        let worker: *opaque = @threadSpawn(cancel_worker, address);
        let started: i64 = 0;
        let request_rc: i64 = 0;
        let request_again_rc: i64 = 0;
        let requested: i32 = 0;
        let close_rc: i64 = 0;
        let after_close: i32 = 0;
        let spins: i32 = 0;
        while (spins < 100000 &&
            @atomicLoad64((&context.*.started) as *const i64) == 0) {
            spins = spins + 1;
            let _yielded: i64 = _zag_raw_syscall(24, 0, 0, 0, 0, 0, 0);
        }
        started = @atomicLoad64((&context.*.started) as *const i64);
        request_rc = cancel.cancel_token_i64_request(&context.*.token);
        request_again_rc = cancel.cancel_token_i64_request(&context.*.token);
        @threadJoin(worker);
        requested = cancel.cancel_token_i64_is_requested(&context.*.token);
        close_rc = cancel.cancel_token_i64_close(&context.*.token);
        after_close = cancel.cancel_token_i64_is_requested(&context.*.token);
        if (started != 1 || request_rc != 0 || request_again_rc != 0 ||
            requested != 1 || context.*.observed != 1 || close_rc != 0 ||
            after_close != 0 - 1) {
            let _unmap_bad: i64 = _zag_raw_syscall(11, address, 4096, 0, 0, 0, 0);
            return 5;
        }
        let _unmap: i64 = _zag_raw_syscall(11, address, 4096, 0, 0, 0, 0);
    }
    _zag_println("cancel-token requested=1 observed=1 one-shot=1");
    return 0;
}
