// Exercises the compiler-owned _zag_memcpy runtime over vector, word, and byte
// tails.  The source deliberately uses an unaligned source/destination offset:
// the SSE2 path must use MOVDQU, not an aligned MOVDQA operation.

@import("../std/list.zag")

extern fn _zag_memcpy(dst: *i8, src: *i8, n: i32) void

fn main() i32 {
    let source: ArrayList[u8] = make[u8](64);
    let dest: ArrayList[u8] = make[u8](64);
    source.len = 64;
    dest.len = 64;
    let i: i32 = 0;
    while (i < 64) {
        source.data[i] = (i * 3 + 1) as u8;
        dest.data[i] = 0;
        i = i + 1;
    }
    // 35 bytes: two 16-byte chunks, no word chunk, and three byte-tail bytes.
    _zag_memcpy((dest.data + 1) as *i8, (source.data + 1) as *i8, 35);
    let j: i32 = 0;
    while (j < 35) {
        if (dest.data[j + 1] != source.data[j + 1]) { return 10 + j; }
        j = j + 1;
    }
    if (dest.data[0] != 0 || dest.data[36] != 0) { return 60; }
    return 0;
}
