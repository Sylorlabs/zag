@import("../selfhost/native/foreground_cache.zag")
@import("../selfhost/zagd_linux.zag")

fn macos_arm64_target() i32 { return 1; }

fn probe_check(ok:i32,label:[]u8,fail:*i32)void{
    if(ok==0){_zag_print("FAIL macOS filesystem ABI: ");_zag_println(label);fail.*=fail.*+1;}
}

fn main()i32{
    if(_zag_argc()!=2){_zag_eprintln("usage: macos_foreground_cache_fs_probe ROOT");return 2;}
    let root:[]u8=_zag_arg(1);
    let base:[]u8=_zag_str_concat(root,"/.zag-cache");
    let dir:[]u8=_zag_str_concat(base,"/foreground");
    let fail:i32=0;

    let cpath:ArrayList[u8]=fc_cstring(root);
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(cpath.data[0..cpath.len]) as i64,
        720896,0,0,0,0);
    free[u8](&cpath);
    probe_check((fd>=0) as i32,"no-follow directory open",&fail);
    if(fd>=0){
        let stat:ArrayList[u8]=make[u8](144);stat.len=144;
        let frc:i64=_zag_raw_syscall(5,fd,
            _zag_slice_ptr(stat.data[0..stat.len]) as i64,0,0,0,0);
        probe_check((frc==0) as i32,"fstat64 result",&fail);
        probe_check(((fc_stat_mode(stat.data[0..stat.len])&61440)==16384) as i32,
            "fstat64 directory mode layout",&fail);
        probe_check((fc_stat_size(stat.data[0..stat.len])>=0) as i32,
            "fstat64 nonnegative directory size",&fail);
        free[u8](&stat);
        probe_check((_zag_raw_syscall(3,fd,0,0,0,0,0)==0) as i32,"close",&fail);
    }

    probe_check(fc_real_dir(root),"root is a directory",&fail);
    probe_check(fc_prepare_dirs(root,base,dir),"cache directories",&fail);
    let file:[]u8=_zag_str_concat(root,"/payload");
    let link:[]u8=_zag_str_concat(root,"/payload-link");
    let missing:[]u8=_zag_str_concat(root,"/missing");
    let payload:[]u8="fstat64 and fstatat64 preserve file sizes";
    probe_check(fc_publish_file(file,payload),"atomic file publication",&fail);
    let read:ForegroundBoundedRead=fc_read_bounded(file,4096);
    probe_check((read.ok==1&&@strEq(read.bytes.data[0..read.bytes.len],payload)) as i32,
        "bounded file read and fstat64 size",&fail);
    free[u8](&read.bytes);
    let denied:ForegroundBoundedRead=fc_read_bounded(file,1);
    probe_check((denied.ok==0) as i32,"oversized read rejection",&fail);
    free[u8](&denied.bytes);
    probe_check(zagd_path_is_regular(file),"Linux-shaped fstatat regular mode",&fail);
    probe_check((zagd_path_size(file)==payload.len) as i32,"Linux-shaped fstatat size",&fail);
    probe_check(zagd_path_is_directory(root),"Linux-shaped fstatat directory mode",&fail);
    probe_check(zagd_path_is_symlink(link),"fstatat does not follow symlinks",&fail);
    probe_check((zagd_path_is_regular(link)==0&&zagd_path_is_regular(missing)==0) as i32,
        "symlink and missing-file rejection",&fail);
    let linked:ForegroundBoundedRead=fc_read_bounded(link,4096);
    probe_check((linked.ok==0) as i32,"bounded reader rejects symlink",&fail);
    free[u8](&linked.bytes);
    let followed:ForegroundBoundedRead=fc_read_bounded_mode(link,4096,1);
    probe_check((followed.ok==1&&@strEq(followed.bytes.data[0..followed.bytes.len],payload)) as i32,
        "explicit linker reader follows symlink with bounded descriptor",&fail);
    free[u8](&followed.bytes);
    _zag_free(_zag_slice_ptr(file));_zag_free(_zag_slice_ptr(link));
    _zag_free(_zag_slice_ptr(missing));_zag_free(_zag_slice_ptr(base));
    _zag_free(_zag_slice_ptr(dir));
    if(fail!=0){return 1;}
    _zag_println("macOS filesystem ABI: PASS");return 42;
}
