; Exact QF_BV equivalence proof for the backend unsigned pow2 remainder rule.
; Each query asks Z3 to find a counterexample. UNSAT means all inputs agree.
(set-logic QF_BV)
(declare-fun x () (_ BitVec 64))
(assert (not (= (bvurem x #x0000000000000001) #x0000000000000000)))
(check-sat)
(reset)
(set-logic QF_BV)
(declare-fun x () (_ BitVec 64))
(assert (not (= (bvurem x #x0000000000000002) (bvand x #x0000000000000001))))
(check-sat)
(reset)
(set-logic QF_BV)
(declare-fun x () (_ BitVec 64))
(assert (not (= (bvurem x #x0000000000000008) (bvand x #x0000000000000007))))
(check-sat)
(reset)
(set-logic QF_BV)
(declare-fun x () (_ BitVec 64))
(assert (not (= (bvurem x #x0000000000100000) (bvand x #x00000000000fffff))))
(check-sat)
(reset)
(set-logic QF_BV)
(declare-fun x () (_ BitVec 64))
(assert (not (= (bvurem x #x0400000000000000) (bvand x #x03ffffffffffffff))))
(check-sat)
(reset)
(set-logic QF_BV)
(declare-fun x () (_ BitVec 32))
(assert (not (= (bvurem x #x00000100) (bvand x #x000000ff))))
(check-sat)
(reset)
(set-logic QF_BV)
(declare-fun x () (_ BitVec 8))
(assert (not (= (bvurem x #x04) (bvand x #x03))))
(check-sat)
(reset)
; Signed negative values demonstrate why the rewrite must be unsigned-only.
(set-logic QF_BV)
(declare-fun x () (_ BitVec 64))
(assert (not (= (bvsrem x #x0000000000000008) (bvand x #x0000000000000007))))
(check-sat)
