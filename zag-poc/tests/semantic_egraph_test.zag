@import("../selfhost/semantic_egraph.zag")

fn ze_test_expect(value:i32,failures:*i32)void{if(value==0){failures.*=failures.*+1;}}

fn main()i32{
    let failures:i32=0;
    let g:ZeGraph=ze_graph_new(64);
    let two:i32=ze_add_const(&g,2);let three:i32=ze_add_const(&g,3);let eight:i32=ze_add_const(&g,8);let zero:i32=ze_add_const(&g,0);let one:i32=ze_add_const(&g,1);
    let sum:i32=ze_add_binary(&g,ze_op_add(),two,three);let sum_again:i32=ze_add_binary(&g,ze_op_add(),three,two);
    let add_zero:i32=ze_add_binary(&g,ze_op_add(),sum,zero);let sub_zero:i32=ze_add_binary(&g,ze_op_sub(),sum,zero);let self_sub:i32=ze_add_binary(&g,ze_op_sub(),sum,sum);let three_again:i32=ze_add_binary(&g,ze_op_sub(),sum,two);let mul_one:i32=ze_add_binary(&g,ze_op_mul(),sum,one);let mul_zero:i32=ze_add_binary(&g,ze_op_mul(),sum,zero);let xor_zero:i32=ze_add_binary(&g,ze_op_xor(),sum,zero);let shl_zero:i32=ze_add_binary(&g,ze_op_shl(),sum,zero);let shr_zero:i32=ze_add_binary(&g,ze_op_shr(),sum,zero);let quotient:i32=ze_add_binary(&g,ze_op_div(),eight,two);let remainder:i32=ze_add_binary(&g,ze_op_rem(),eight,three);
    ze_test_expect(g.valid==1,&failures);ze_test_expect(ze_equivalent_before_saturation(&g,sum,sum_again)==1,&failures);
    ze_test_expect(ze_saturate(&g)==1,&failures);ze_test_expect(g.iterations<=16&&g.rewrites>0,&failures);
    ze_test_expect(ze_equivalent(&g,add_zero,sum)==1,&failures);ze_test_expect(ze_equivalent(&g,sub_zero,sum)==1,&failures);ze_test_expect(ze_equivalent(&g,self_sub,zero)==1,&failures);ze_test_expect(ze_equivalent(&g,mul_one,sum)==1,&failures);ze_test_expect(ze_equivalent(&g,mul_zero,zero)==1,&failures);ze_test_expect(ze_equivalent(&g,xor_zero,sum)==1,&failures);ze_test_expect(ze_equivalent(&g,shl_zero,sum)==1&&ze_equivalent(&g,shr_zero,sum)==1,&failures);
    let five:i64=0;ze_test_expect(ze_class_value(&g,sum,&five)==1&&five==5,&failures);let three_value:i64=0;ze_test_expect(ze_class_value(&g,three_again,&three_value)==1&&three_value==3,&failures);let quotient_value:i64=0;ze_test_expect(ze_class_value(&g,quotient,&quotient_value)==1&&quotient_value==4,&failures);let remainder_value:i64=0;ze_test_expect(ze_class_value(&g,remainder,&remainder_value)==1&&remainder_value==2,&failures);let nested:i32=ze_add_binary(&g,ze_op_mul(),sum,one);ze_test_expect(ze_equivalent(&g,nested,sum)==0,&failures);
    // No nodes may be added after saturation; malformed/unknown operations
    // invalidate the graph rather than being treated as opaque equalities.
    ze_test_expect(ze_add_const(&g,6)==-1&&g.valid==0,&failures);
    ze_graph_free(&g);
    let bounded:ZeGraph=ze_graph_new(2);let a:i32=ze_add_const(&bounded,1);let b:i32=ze_add_const(&bounded,2);ze_test_expect(a>=0&&b>=0,&failures);ze_test_expect(ze_add_const(&bounded,3)==-1&&bounded.valid==0,&failures);ze_graph_free(&bounded);
    let unknown:ZeGraph=ze_graph_new(8);let u:i32=ze_add_const(&unknown,1);ze_test_expect(ze_add_node(&unknown,99,u,-1,0)==-1&&unknown.valid==0,&failures);ze_graph_free(&unknown);
    let invalid:ZeGraph=ze_graph_new(0);ze_test_expect(invalid.valid==0,&failures);ze_graph_free(&invalid);
    let div_zero:ZeGraph=ze_graph_new(8);let four_zero:i32=ze_add_const(&div_zero,4);let denominator_zero:i32=ze_add_const(&div_zero,0);ze_test_expect(ze_add_binary(&div_zero,ze_op_div(),four_zero,denominator_zero)==-1&&div_zero.valid==0&&ze_saturate(&div_zero)==0,&failures);ze_graph_free(&div_zero);
    let rem_zero:ZeGraph=ze_graph_new(8);let four_rem:i32=ze_add_const(&rem_zero,4);let rem_denominator_zero:i32=ze_add_const(&rem_zero,0);ze_test_expect(ze_add_binary(&rem_zero,ze_op_rem(),four_rem,rem_denominator_zero)==-1&&rem_zero.valid==0&&ze_saturate(&rem_zero)==0,&failures);ze_graph_free(&rem_zero);
    let overflow_div:ZeGraph=ze_graph_new(8);let min_div:i32=ze_add_const(&overflow_div,ze_i32_min());let minus_one_div:i32=ze_add_const(&overflow_div,0-1);ze_test_expect(ze_add_binary(&overflow_div,ze_op_div(),min_div,minus_one_div)==-1&&overflow_div.valid==0&&ze_saturate(&overflow_div)==0,&failures);ze_graph_free(&overflow_div);
    let overflow_rem:ZeGraph=ze_graph_new(8);let min_rem:i32=ze_add_const(&overflow_rem,ze_i32_min());let minus_one_rem:i32=ze_add_const(&overflow_rem,0-1);ze_test_expect(ze_add_binary(&overflow_rem,ze_op_rem(),min_rem,minus_one_rem)==-1&&overflow_rem.valid==0&&ze_saturate(&overflow_rem)==0,&failures);ze_graph_free(&overflow_rem);
    let overflow_add:ZeGraph=ze_graph_new(8);let max_add:i32=ze_add_const(&overflow_add,ze_i32_max());let one_add:i32=ze_add_const(&overflow_add,1);ze_test_expect(ze_add_binary(&overflow_add,ze_op_add(),max_add,one_add)==-1&&overflow_add.valid==0&&ze_saturate(&overflow_add)==0,&failures);ze_graph_free(&overflow_add);
    let overflow_sub:ZeGraph=ze_graph_new(8);let min_sub:i32=ze_add_const(&overflow_sub,ze_i32_min());let one_sub:i32=ze_add_const(&overflow_sub,1);ze_test_expect(ze_add_binary(&overflow_sub,ze_op_sub(),min_sub,one_sub)==-1&&overflow_sub.valid==0&&ze_saturate(&overflow_sub)==0,&failures);ze_graph_free(&overflow_sub);
    let overflow_mul:ZeGraph=ze_graph_new(8);let max_mul:i32=ze_add_const(&overflow_mul,ze_i32_max());let two_mul:i32=ze_add_const(&overflow_mul,2);ze_test_expect(ze_add_binary(&overflow_mul,ze_op_mul(),max_mul,two_mul)==-1&&overflow_mul.valid==0&&ze_saturate(&overflow_mul)==0,&failures);ze_graph_free(&overflow_mul);
    let late_overflow:ZeGraph=ze_graph_new(16);let late_min:i32=ze_add_const(&late_overflow,ze_i32_min());let late_zero:i32=ze_add_const(&late_overflow,0);let late_one:i32=ze_add_const(&late_overflow,1);let late_minus_one:i32=ze_add_binary(&late_overflow,ze_op_sub(),late_zero,late_one);let late_edge:i32=ze_add_binary(&late_overflow,ze_op_div(),late_min,late_minus_one);ze_test_expect(late_edge>=0&&late_overflow.valid==1,&failures);ze_test_expect(ze_saturate(&late_overflow)==0&&late_overflow.valid==0&&late_overflow.saturated==0,&failures);ze_graph_free(&late_overflow);
    let late_zero_div:ZeGraph=ze_graph_new(16);let four_late:i32=ze_add_const(&late_zero_div,4);let zero_left:i32=ze_add_const(&late_zero_div,0);let late_denominator:i32=ze_add_binary(&late_zero_div,ze_op_sub(),zero_left,zero_left);let late_zero_edge:i32=ze_add_binary(&late_zero_div,ze_op_div(),four_late,late_denominator);ze_test_expect(late_zero_edge>=0&&late_zero_div.valid==1,&failures);ze_test_expect(ze_saturate(&late_zero_div)==0&&late_zero_div.valid==0&&late_zero_div.saturated==0,&failures);ze_graph_free(&late_zero_div);
    // i64 is an explicit graph mode.  The evaluator checks bounds before
    // every concrete operation, so the proof never depends on host wrapping
    // or on an overflowing intermediate expression.
    let wide:ZeGraph=ze_graph_new_i64(32);let wide_max_minus_one:i32=ze_add_const(&wide,ze_i64_max()-1);let wide_one:i32=ze_add_const(&wide,1);let wide_sum:i32=ze_add_binary(&wide,ze_op_add(),wide_max_minus_one,wide_one);ze_test_expect(wide.valid==1&&wide_sum>=0&&ze_saturate(&wide)==1,&failures);let wide_value:i64=0;ze_test_expect(ze_class_value(&wide,wide_sum,&wide_value)==1&&wide_value==ze_i64_max(),&failures);ze_graph_free(&wide);
    let wide_negative:ZeGraph=ze_graph_new_i64(16);let wide_min_plus_one:i32=ze_add_const(&wide_negative,ze_i64_min()+1);let wide_minus_one:i32=ze_add_const(&wide_negative,0-1);let wide_min_sum:i32=ze_add_binary(&wide_negative,ze_op_add(),wide_min_plus_one,wide_minus_one);ze_test_expect(wide_min_sum>=0&&ze_saturate(&wide_negative)==1,&failures);let wide_min_value:i64=0;ze_test_expect(ze_class_value(&wide_negative,wide_min_sum,&wide_min_value)==1&&wide_min_value==ze_i64_min(),&failures);ze_graph_free(&wide_negative);
    let wide_add_overflow:ZeGraph=ze_graph_new_i64(8);let wide_max:i32=ze_add_const(&wide_add_overflow,ze_i64_max());let wide_add_one:i32=ze_add_const(&wide_add_overflow,1);ze_test_expect(ze_add_binary(&wide_add_overflow,ze_op_add(),wide_max,wide_add_one)==-1&&wide_add_overflow.valid==0,&failures);ze_graph_free(&wide_add_overflow);
    let wide_sub_overflow:ZeGraph=ze_graph_new_i64(8);let wide_min:i32=ze_add_const(&wide_sub_overflow,ze_i64_min());let wide_sub_one:i32=ze_add_const(&wide_sub_overflow,1);ze_test_expect(ze_add_binary(&wide_sub_overflow,ze_op_sub(),wide_min,wide_sub_one)==-1&&wide_sub_overflow.valid==0,&failures);ze_graph_free(&wide_sub_overflow);
    let wide_mul:ZeGraph=ze_graph_new_i64(8);let wide_mul_left:i32=ze_add_const(&wide_mul,3037000499);let wide_mul_right:i32=ze_add_const(&wide_mul,3037000499);let wide_product:i32=ze_add_binary(&wide_mul,ze_op_mul(),wide_mul_left,wide_mul_right);ze_test_expect(wide_product>=0&&ze_saturate(&wide_mul)==1,&failures);ze_graph_free(&wide_mul);
    let wide_mul_overflow:ZeGraph=ze_graph_new_i64(8);let wide_mul_bad_left:i32=ze_add_const(&wide_mul_overflow,3037000500);let wide_mul_bad_right:i32=ze_add_const(&wide_mul_overflow,3037000500);ze_test_expect(ze_add_binary(&wide_mul_overflow,ze_op_mul(),wide_mul_bad_left,wide_mul_bad_right)==-1&&wide_mul_overflow.valid==0,&failures);ze_graph_free(&wide_mul_overflow);
    let wide_div_overflow:ZeGraph=ze_graph_new_i64(8);let wide_div_min:i32=ze_add_const(&wide_div_overflow,ze_i64_min());let wide_div_one:i32=ze_add_const(&wide_div_overflow,0-1);ze_test_expect(ze_add_binary(&wide_div_overflow,ze_op_div(),wide_div_min,wide_div_one)==-1&&wide_div_overflow.valid==0,&failures);ze_graph_free(&wide_div_overflow);
    let bool_graph:ZeGraph=ze_graph_new_bool(32);let bool_false:i32=ze_add_const(&bool_graph,0);let bool_true:i32=ze_add_const(&bool_graph,1);
    let bool_not:i32=ze_add_unary(&bool_graph,ze_op_not(),bool_false);let bool_and:i32=ze_add_binary(&bool_graph,ze_op_and(),bool_true,bool_not);let bool_or:i32=ze_add_binary(&bool_graph,ze_op_or(),bool_false,bool_and);let bool_eq:i32=ze_add_binary(&bool_graph,ze_op_eq(),bool_or,bool_true);let bool_ne:i32=ze_add_binary(&bool_graph,ze_op_ne(),bool_false,bool_false);
    ze_test_expect(bool_graph.valid==1&&ze_saturate(&bool_graph)==1&&bool_graph.integer_width==1,&failures);
    let bool_not_value:i64=0;let bool_and_value:i64=0;let bool_or_value:i64=0;let bool_eq_value:i64=0;let bool_ne_value:i64=0;
    ze_test_expect(ze_class_value(&bool_graph,bool_not,&bool_not_value)==1&&bool_not_value==1,&failures);ze_test_expect(ze_class_value(&bool_graph,bool_and,&bool_and_value)==1&&bool_and_value==1,&failures);ze_test_expect(ze_class_value(&bool_graph,bool_or,&bool_or_value)==1&&bool_or_value==1,&failures);ze_test_expect(ze_class_value(&bool_graph,bool_eq,&bool_eq_value)==1&&bool_eq_value==1,&failures);ze_test_expect(ze_class_value(&bool_graph,bool_ne,&bool_ne_value)==1&&bool_ne_value==0,&failures);
    ze_test_expect(ze_equivalent(&bool_graph,bool_and,bool_true)==1&&ze_equivalent(&bool_graph,bool_or,bool_true)==1,&failures);ze_graph_free(&bool_graph);
    let bool_bad_value:ZeGraph=ze_graph_new_bool(8);ze_test_expect(ze_add_const(&bool_bad_value,2)==-1&&bool_bad_value.valid==0,&failures);ze_graph_free(&bool_bad_value);
    let bool_bad_domain:ZeGraph=ze_graph_new_bool(8);let bool_domain_true:i32=ze_add_const(&bool_bad_domain,1);ze_test_expect(ze_add_binary(&bool_bad_domain,ze_op_add(),bool_domain_true,bool_domain_true)==-1&&bool_bad_domain.valid==0,&failures);ze_graph_free(&bool_bad_domain);
    let bool_bad_unary:ZeGraph=ze_graph_new_bool(8);ze_test_expect(ze_add_unary(&bool_bad_unary,ze_op_not(),-1)==-1&&bool_bad_unary.valid==0,&failures);ze_graph_free(&bool_bad_unary);
    let bool_bad_unknown:ZeGraph=ze_graph_new_bool(8);let bool_unknown_value:i32=ze_add_const(&bool_bad_unknown,1);ze_test_expect(ze_add_node(&bool_bad_unknown,99,bool_unknown_value,-1,0)==-1&&bool_bad_unknown.valid==0,&failures);ze_graph_free(&bool_bad_unknown);
    if(failures==0){_zag_println("semantic egraph: PASS");}return failures;
}
