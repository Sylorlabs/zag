@import("std:list") as list

fn main() i32 {
    let xs:list.ArrayList[i64]=list.make[i64](2);
    list.push[i64](&xs,11);list.push[i64](&xs,22);
    if(xs.len!=2||xs.data[1]!=22){list.free[i64](&xs);return 1;}
    list.clear[i64](&xs);
    if(xs.len!=0||xs.cap<2){list.free[i64](&xs);return 2;}
    list.push[i64](&xs,99);
    if(xs.len!=1||xs.data[0]!=99){list.free[i64](&xs);return 3;}
    list.free[i64](&xs);return 0;
}
