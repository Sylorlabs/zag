fn wrap(x:i32) i32 { return x+1; }
fn touch(x:i32) void { return; }
fn quotient(a:i32,b:i32) i32 { return a/b; }
fn remainder(a:i32,b:i32) i32 { return a%b; }

fn main() i32 {
    quotient(20,3);
    touch(42);
    let max:i32=2147483647;
    let wrapped:i32=wrap(max);
    if (wrapped>=0) { return 1; }
    let q:i32=quotient(20,3);
    let r:i32=remainder(20,3);
    let edge:i32=quotient(wrapped,-1);
    if (edge!=wrapped) { return 2; }
    let edge_r:i32=remainder(wrapped,-1);
    if (edge_r!=0) { return 3; }
    return q*10+r;
}
