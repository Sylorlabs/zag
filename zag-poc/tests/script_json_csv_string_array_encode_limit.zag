// Script JSON text-list encoding fails closed when the context has no
// remaining bytes for the retained output buffer.

script;

let values: ScriptList[[]u8] = list("name", "zag");
let remaining: i64 = 1048576 - script_alloc_used();
let reserve: *i8 = script_alloc(remaining);
if (reserve == null as *i8) { return 1; }
let encoded: []u8 = json_string_array_encode(values);
if (encoded.len != 0) { return 2; }
return 0;
