// Focused cross-platform contract: an oversized UDP datagram reports its
// truncation, exposes only the copied prefix, and is consumed atomically.

@import("std:list")
@import("std:net_ipv4") as net

fn main() i32 {
    let loopback: net.NetIpv4Endpoint = net.net_ipv4_endpoint(
        net.net_ipv4_loopback(), 0
    );
    let server_result: net.NetUdpSocketResult =
        net.net_udp_bind_ipv4(loopback, 1000);
    let client_result: net.NetUdpSocketResult =
        net.net_udp_bind_ipv4(loopback, 1000);
    if (server_result.ok == 0 || client_result.ok == 0) { return 1; }
    let server: net.NetUdpSocket = net.net_udp_socket_take(&server_result);
    let client: net.NetUdpSocket = net.net_udp_socket_take(&client_result);

    let payload: []u8 = "oversized-datagram";
    if (payload.len != 18) { return 2; }
    let sent: net.NetIoResult = net.net_udp_send_to(&client, server.local, payload);
    if (sent.ok == 0 || sent.transferred != payload.len) { return 3; }

    let tiny: ArrayList[u8] = make[u8](4);
    let received: net.NetUdpReceiveResult = net.net_udp_recv_from_bounded(
        &server, tiny.data[0..4], 4, 8
    );
    if (received.ok != 0 || received.code != net.net_status_truncated() ||
        received.transferred != 4 || tiny.data[0] != 'o' || tiny.data[1] != 'v' ||
        tiny.data[2] != 'e' || tiny.data[3] != 'r') {
        return 4;
    }

    // The oversized packet must be consumed, not exposed as a synthetic tail.
    let followup: net.NetIoResult = net.net_udp_send_to(&client, server.local, "ok");
    let next: net.NetUdpReceiveResult = net.net_udp_recv_from_bounded(
        &server, tiny.data[0..4], 4, 8
    );
    if (followup.ok == 0 || next.ok == 0 || next.transferred != 2 ||
        tiny.data[0] != 'o' || tiny.data[1] != 'k') {
        return 5;
    }

    if (net.net_udp_close(&server) != net.net_status_ok() ||
        net.net_udp_close(&client) != net.net_status_ok()) {
        return 6;
    }
    free[u8](&tiny);
    return 0;
}
