// Covers the i386 raw syscall boundary used by the subset: mmap2, write, and
// munmap.  Locals remain valid across each temporary callee-saved-register use.
fn main() i32 {
    let value:*i32 = _zag_malloc(4);
    if (value == null) { return 1; }
    value.* = 35;
    let freed:i32 = _zag_free(value);
    if (freed != 0) { return 2; }
    let printed:i32 = _zag_println_i32(7);
    if (printed < 0) { return 3; }
    return 42;
}
