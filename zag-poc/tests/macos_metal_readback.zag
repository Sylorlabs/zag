// End-to-end native Metal compute/readback witness for Apple Silicon.
// objc_msgSend is declared with the widest call shape used below; shorter
// Objective-C methods simply ignore the padded argument registers.
extern fn MTLCreateSystemDefaultDevice() *u8
extern fn objc_getClass(name:*i8) *u8
extern fn sel_registerName(name:*i8) *u8
extern fn objc_msgSend(receiver:*u8, selector:*u8, a2:*u8, a3:*u8, a4:*u8, a5:*u8, a6:*u8, a7:*u8) *u8
extern fn objc_msgSend_sizes(receiver:*u8, selector:*u8, groups:MtlSize, threads:MtlSize) *u8
extern fn _zag_slice_ptr(s:[]u8) *i8

struct MtlSize { width:i64, height:i64, depth:i64 }

fn sel(name:[]u8) *u8 { return sel_registerName(_zag_slice_ptr(name)); }
fn msg(r:*u8,s:*u8,a2:*u8,a3:*u8,a4:*u8,a5:*u8,a6:*u8,a7:*u8) *u8 { return objc_msgSend(r,s,a2,a3,a4,a5,a6,a7); }

fn main() i32 {
    let z:*u8=null as *u8;
    let device:*u8=MTLCreateSystemDefaultDevice(); if(device==z){return 1;}
    let ns:*u8=objc_getClass(_zag_slice_ptr("NSString\x00")); if(ns==z){return 2;}
    let src:*u8=msg(ns,sel("stringWithUTF8String:\x00"),_zag_slice_ptr("#include <metal_stdlib>\nusing namespace metal;\nkernel void zag_fill(device uint *out [[buffer(0)]], uint id [[thread_position_in_grid]]) { out[id] = 42; }\n\x00") as *u8,z,z,z,z,z);
    if(src==z){return 3;}
    let err:*u8=z;
    let lib:*u8=msg(device,sel("newLibraryWithSource:options:error:\x00"),src,z,(&err) as *u8,z,z,z); if(lib==z){return 4;}
    let kernel_fn:*u8=msg(lib,sel("newFunctionWithName:\x00"),msg(ns,sel("stringWithUTF8String:\x00"),_zag_slice_ptr("zag_fill\x00") as *u8,z,z,z,z,z),z,z,z,z,z); if(kernel_fn==z){return 5;}
    let pipe:*u8=msg(device,sel("newComputePipelineStateWithFunction:error:\x00"),kernel_fn,(&err) as *u8,z,z,z,z); if(pipe==z){return 6;}
    let buf:*u8=msg(device,sel("newBufferWithLength:options:\x00"),8 as *u8,z,z,z,z,z); if(buf==z){return 7;}
    let queue:*u8=msg(device,sel("newCommandQueue\x00"),z,z,z,z,z,z); if(queue==z){return 8;}
    let command:*u8=msg(queue,sel("commandBuffer\x00"),z,z,z,z,z,z); if(command==z){return 9;}
    let encoder:*u8=msg(command,sel("computeCommandEncoder\x00"),z,z,z,z,z,z); if(encoder==z){return 10;}
    let _p:*u8=msg(encoder,sel("setComputePipelineState:\x00"),pipe,z,z,z,z,z);
    let _b:*u8=msg(encoder,sel("setBuffer:offset:atIndex:\x00"),buf,z,z,z,z,z);
    // MTLSize {width,height,depth} is three word-sized values.  Passing both
    // values in x2..x7 exactly matches the arm64 Objective-C ABI.
    let one:MtlSize=MtlSize{.width=1,.height=1,.depth=1};
    let _d:*u8=objc_msgSend_sizes(encoder,sel("dispatchThreadgroups:threadsPerThreadgroup:\x00"),one,one);
    let _e:*u8=msg(encoder,sel("endEncoding\x00"),z,z,z,z,z,z);
    let _c:*u8=msg(command,sel("commit\x00"),z,z,z,z,z,z);
    let _w:*u8=msg(command,sel("waitUntilCompleted\x00"),z,z,z,z,z,z);
    let out:*i32=msg(buf,sel("contents\x00"),z,z,z,z,z,z) as *i32;
    if(out==null as *i32){return 11;}
    if(out[0]!=42){return 12;}
    return 42;
}
