@import("std:list")
@import("std:config_flat") as config
@import("std:log_json") as log

extern fn _zag_allocator_live_bytes() i64

fn all_byte(bytes: []u8, value: u8) i32 {
    let i: i32 = 0;
    while (i < bytes.len) {
        if (bytes[i] != value) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn fill_byte(bytes: []u8, value: u8) void {
    let i: i32 = 0;
    while (i < bytes.len) { bytes[i] = value; i = i + 1; }
}

fn main() i32 {
    let baseline: i64 = _zag_allocator_live_bytes();
    let entries: ArrayList[config.ConfigFlatEntry] =
        make[config.ConfigFlatEntry](8);
    let source: []u8 = "# bounded service config\n host = example.test \nport=443\nenabled = true\r\nmessage = hello world\n";
    let parsed: config.ConfigFlatParseResult =
        config.config_flat_parse_bounded(source, entries.data, 8);
    if (parsed.ok != 1 || parsed.count != 4 || parsed.error_line != 0) {
        return 1;
    }
    let host: config.ConfigFlatValue =
        config.config_flat_find(entries.data, parsed.count, "host");
    let port: config.ConfigFlatValue =
        config.config_flat_find(entries.data, parsed.count, "port");
    let enabled: config.ConfigFlatValue =
        config.config_flat_find(entries.data, parsed.count, "enabled");
    let missing: config.ConfigFlatValue =
        config.config_flat_find(entries.data, parsed.count, "missing");
    let port_number: config.ConfigFlatI64Result = config.config_flat_i64(port.value);
    let enabled_number: i32 = 0;
    if (host.found != 1 || !@strEq(host.value, "example.test") ||
        port_number.ok != 1 || port_number.value != 443 ||
        config.config_flat_bool(enabled.value, &enabled_number) == 0 ||
        enabled_number != 1 || missing.found != 0) { return 2; }

    let duplicate: config.ConfigFlatParseResult =
        config.config_flat_parse_bounded("a=1\na=2\n", entries.data, 8);
    let malformed: config.ConfigFlatParseResult =
        config.config_flat_parse_bounded("bad key=value\n", entries.data, 8);
    let missing_equals: config.ConfigFlatParseResult =
        config.config_flat_parse_bounded("key value\n", entries.data, 8);
    let too_many: config.ConfigFlatParseResult =
        config.config_flat_parse_bounded("a=1\nb=2\n", entries.data, 1);
    if (duplicate.code != config.config_flat_status_duplicate() ||
        duplicate.error_line != 2 ||
        malformed.code != config.config_flat_status_malformed() ||
        missing_equals.code != config.config_flat_status_malformed() ||
        too_many.code != config.config_flat_status_limit() ||
        config.config_flat_i64("9223372036854775807").value !=
            9223372036854775807 ||
        config.config_flat_i64("-9223372036854775808").value !=
            ((0 - 9223372036854775807) - 1) ||
        config.config_flat_i64("9223372036854775808").ok != 0 ||
        config.config_flat_i64("-9223372036854775809").ok != 0 ||
        config.config_flat_i64("4x").ok != 0) { return 3; }

    let output: ArrayList[u8] = make[u8](512);
    let encoded: log.LogJsonEncodeResult = log.log_json_encode(
        output.data[0..512], 1700000000, 123456789,
        log.log_json_level_info(), "service.start", "hello\n\"zag\""
    );
    let expected: []u8 = "{\"ts_sec\":1700000000,\"ts_nsec\":123456789,\"level\":\"info\",\"event\":\"service.start\",\"message\":\"hello\\n\\\"zag\\\"\"}\n";
    if (encoded.ok != 1 || encoded.length != expected.len ||
        !@strEq(output.data[0..encoded.length], expected)) { return 4; }

    let tiny: ArrayList[u8] = make[u8](16);
    fill_byte(tiny.data[0..16], 165);
    let limited: log.LogJsonEncodeResult = log.log_json_encode(
        tiny.data[0..16], 1, 2, log.log_json_level_info(), "event", "message"
    );
    let invalid: log.LogJsonEncodeResult = log.log_json_encode(
        tiny.data[0..16], 1, 2, 99, "bad event", "message"
    );
    if (limited.code != log.log_json_status_limit() ||
        invalid.code != log.log_json_status_invalid_argument() ||
        all_byte(tiny.data[0..16], 165) == 0) { return 5; }

    let written: log.LogJsonWriteResult = log.log_json_write_all_bounded(
        2, output.data[0..encoded.length], 8
    );
    if (written.ok != 1 || written.transferred != encoded.length ||
        written.calls < 1 || written.calls > 8) { return 6; }

    free[config.ConfigFlatEntry](&entries);
    free[u8](&output);
    free[u8](&tiny);
    if (_zag_allocator_live_bytes() != baseline) { return 7; }
    return 0;
}
