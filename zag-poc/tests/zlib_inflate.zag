@import("std:list")
@import("std:zlib_store")
@import("std:zlib_inflate")

struct TestState { passed: i32, failed: i32 }

fn expect(state: *TestState, condition: i32, name: []u8) void {
    if (condition != 0) {
        state.*.passed = state.*.passed + 1;
        _zag_print("ok  "); _zag_println(name);
    } else {
        state.*.failed = state.*.failed + 1;
        _zag_print("FAIL "); _zag_println(name);
    }
}

fn bytes_equal(bytes: ArrayList[u8], expected: []u8) i32 {
    if (bytes.len != expected.len) { return 0; }
    let i: i32 = 0;
    while (i < bytes.len) {
        if (bytes.data[i] != expected[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn copy_bytes(input: []u8) ArrayList[u8] {
    let output: ArrayList[u8] = make[u8](input.len);
    let i: i32 = 0;
    while (i < input.len) { push[u8](&output, input[i]); i = i + 1; }
    return output;
}

fn stored_contract(state: *TestState) void {
    let encoded: ZlibStoreEncodeResult = zlib_store_encode(
        "stored blocks remain accepted by the general inflater"
    );
    let decoded: ZlibInflateResult = zlib_inflate(
        encoded.bytes.data[0..encoded.bytes.len], 1024
    );
    expect(state, encoded.error == ZlibStoreError.none &&
        decoded.error == ZlibInflateError.none &&
        bytes_equal(decoded.bytes,
            "stored blocks remain accepted by the general inflater") != 0,
        "general inflate accepts canonical stored blocks");
    zlib_inflate_free(&decoded);
    zlib_store_encode_free(&encoded);
}

fn fixed_contract(state: *TestState) void {
    let compressed: []u8 =
        "\x78\x01\xcb\x48\xcd\xc9\xc9\x57\xc8\xc0\x4e\x2a\x02\x00\xae\x16\x0b\x06";
    let decoded: ZlibInflateResult = zlib_inflate(compressed, 1024);
    expect(state, decoded.error == ZlibInflateError.none &&
        bytes_equal(decoded.bytes, "hello hello hello hello hello!") != 0,
        "fixed Huffman stream matches Python zlib");
    zlib_inflate_free(&decoded);
}

fn dynamic_expected() ArrayList[u8] {
    let line: []u8 = "The quick brown fox jumps over the lazy dog. 0123456789\n";
    let output: ArrayList[u8] = make[u8](5600);
    let repeat: i32 = 0;
    while (repeat < 100) {
        let i: i32 = 0;
        while (i < line.len) { push[u8](&output, line[i]); i = i + 1; }
        repeat = repeat + 1;
    }
    return output;
}

fn dynamic_contract(state: *TestState) void {
    let compressed: []u8 =
        "\x78\xda\xed\xcb\x37\x11\x80\x40\x14\x40\xc1\x1e\x15\x5f\x01\x43\x0e\x3e\x30\x40\xce\x1c\x1c\x19\xf5\xe0\x82\xe6\xd5\x3b\x9b\x34\xa5\x2c\x7b\x9b\xf7\x92\x69\x75\x4e\x52\xa9\x4b\xba\x7d\x9c\x57\x51\x47\xa9\x65\xfb\x78\x48\x9f\x5b\x0a\x55\x9b\x62\xd9\x8e\xeb\xf9\x41\x18\xc5\x46\xc2\xe3\xf1\x78\x3c\x1e\x8f\xc7\xe3\xf1\x78\x3c\x1e\x8f\xc7\xe3\xf1\x78\xbc\x5f\xdf\x0b\x64\x78\x20\xa2";
    let expected: ArrayList[u8] = dynamic_expected();
    let decoded: ZlibInflateResult = zlib_inflate(compressed, 6000);
    expect(state, decoded.error == ZlibInflateError.none &&
        bytes_equal(decoded.bytes, expected.data[0..expected.len]) != 0,
        "dynamic Huffman stream and overlapping matches interoperate with Python zlib");
    zlib_inflate_free(&decoded);

    let limited: ZlibInflateResult = zlib_inflate(compressed, 100);
    expect(state, limited.error == ZlibInflateError.output_limit,
        "decoded output is bounded before a compressed stream can expand past policy");
    zlib_inflate_free(&limited);
    free[u8](&expected);
}

fn multiblock_contract(state: *TestState) void {
    let compressed: []u8 =
        "\x78\x9c\x4a\xcb\x2c\x2a\x2e\x51\x48\xca\xc9\x4f\xce\x56\x48\x1b\x65\x0f\x3b\x36\x00\x00\x00\xff\xff\x2b\x4e\x4d\xce\xcf\x4b\x81\x72\xca\x33\x4b\x32\x14\x12\x15\x52\x32\xd3\xd2\x52\x8b\x52\xf3\x4a\x14\x12\x73\x0a\x32\x12\x93\x52\x4b\x14\x0c\x8d\x8c\x4d\x4c\xcd\xcc\x2d\x2c\x0d\x46\x75\x8c\xea\x18\xd5\x31\xaa\x63\x54\xc7\xa8\x8e\x51\x1d\xa3\x3a\x46\x75\x0c\xb8\x0e\x00\x0d\x77\xec\xe8";
    let expected: ArrayList[u8] = make[u8](2980);
    let first: []u8 = "first block ";
    let second: []u8 = "second block with a different alphabet 1234567890 ";
    let repeat: i32 = 0;
    while (repeat < 40) {
        let i: i32 = 0;
        while (i < first.len) { push[u8](&expected, first[i]); i = i + 1; }
        repeat = repeat + 1;
    }
    repeat = 0;
    while (repeat < 50) {
        let i: i32 = 0;
        while (i < second.len) { push[u8](&expected, second[i]); i = i + 1; }
        repeat = repeat + 1;
    }
    let decoded: ZlibInflateResult = zlib_inflate(compressed, 4000);
    expect(state, decoded.error == ZlibInflateError.none &&
        bytes_equal(decoded.bytes, expected.data[0..expected.len]) != 0,
        "mixed compressed and synchronization blocks preserve stream state");
    zlib_inflate_free(&decoded);
    free[u8](&expected);
}

fn rejection_contract(state: *TestState) void {
    let short: ZlibInflateResult = zlib_inflate("\x78\x01", 100);
    expect(state, short.error == ZlibInflateError.truncated,
        "short zlib streams fail as truncated");
    zlib_inflate_free(&short);

    let invalid_header: ZlibInflateResult = zlib_inflate(
        "\x79\x01\x00\x00\x00\x00", 100
    );
    expect(state, invalid_header.error == ZlibInflateError.invalid_header,
        "invalid RFC 1950 headers fail before DEFLATE decoding");
    zlib_inflate_free(&invalid_header);

    let dictionary: ZlibInflateResult = zlib_inflate(
        "\x78\x20\x00\x00\x00\x00", 100
    );
    expect(state, dictionary.error == ZlibInflateError.preset_dictionary,
        "preset dictionaries fail closed until explicitly provided");
    zlib_inflate_free(&dictionary);

    let reserved: ZlibInflateResult = zlib_inflate(
        "\x78\x01\x07\x00\x00\x00\x01", 100
    );
    expect(state, reserved.error == ZlibInflateError.invalid_block_type,
        "reserved DEFLATE block types fail explicitly");
    zlib_inflate_free(&reserved);

    let encoded: ZlibStoreEncodeResult = zlib_store_encode("integrity");
    let damaged: ArrayList[u8] = copy_bytes(encoded.bytes.data[0..encoded.bytes.len]);
    damaged.data[damaged.len - 1] = damaged.data[damaged.len - 1] ^ 1;
    let checksum: ZlibInflateResult = zlib_inflate(
        damaged.data[0..damaged.len], 100
    );
    expect(state, checksum.error == ZlibInflateError.checksum_mismatch,
        "Adler32 corruption never returns trusted output");
    zlib_inflate_free(&checksum);

    damaged.data[damaged.len - 1] = damaged.data[damaged.len - 1] ^ 1;
    push[u8](&damaged, 0);
    let trailing: ZlibInflateResult = zlib_inflate(
        damaged.data[0..damaged.len], 100
    );
    expect(state, trailing.error == ZlibInflateError.trailing_data,
        "trailing bytes fail canonical full-stream decoding");
    zlib_inflate_free(&trailing);
    free[u8](&damaged);
    zlib_store_encode_free(&encoded);

    let invalid_limit: ZlibInflateResult = zlib_inflate("", 0);
    expect(state, invalid_limit.error == ZlibInflateError.invalid_limit,
        "callers must provide a positive bounded output policy");
    zlib_inflate_free(&invalid_limit);
}

fn corruption_contract(state: *TestState) void {
    let compressed: []u8 =
        "\x78\xda\xed\xcb\x37\x11\x80\x40\x14\x40\xc1\x1e\x15\x5f\x01\x43\x0e\x3e\x30\x40\xce\x1c\x1c\x19\xf5\xe0\x82\xe6\xd5\x3b\x9b\x34\xa5\x2c\x7b\x9b\xf7\x92\x69\x75\x4e\x52\xa9\x4b\xba\x7d\x9c\x57\x51\x47\xa9\x65\xfb\x78\x48\x9f\x5b\x0a\x55\x9b\x62\xd9\x8e\xeb\xf9\x41\x18\xc5\x46\xc2\xe3\xf1\x78\x3c\x1e\x8f\xc7\xe3\xf1\x78\x3c\x1e\x8f\xc7\xe3\xf1\x78\xbc\x5f\xdf\x0b\x64\x78\x20\xa2";
    let all_truncations_rejected: i32 = 1;
    let length: i32 = 0;
    while (length < compressed.len) {
        let result: ZlibInflateResult = zlib_inflate(compressed[0..length], 6000);
        if (result.error == ZlibInflateError.none) { all_truncations_rejected = 0; }
        zlib_inflate_free(&result);
        length = length + 1;
    }
    expect(state, all_truncations_rejected,
        "every strict prefix of a dynamic stream is rejected without over-read");

    let expected: ArrayList[u8] = dynamic_expected();
    let all_single_bit_corruption_safe: i32 = 1;
    let byte_index: i32 = 0;
    while (byte_index < compressed.len) {
        let bit: i32 = 0;
        while (bit < 8) {
            let damaged: ArrayList[u8] = copy_bytes(compressed);
            damaged.data[byte_index] = damaged.data[byte_index] ^ ((1 << bit) as u8);
            let result: ZlibInflateResult = zlib_inflate(
                damaged.data[0..damaged.len], 6000
            );
            if (result.error == ZlibInflateError.none &&
                bytes_equal(result.bytes, expected.data[0..expected.len]) == 0) {
                all_single_bit_corruption_safe = 0;
            }
            zlib_inflate_free(&result);
            free[u8](&damaged);
            bit = bit + 1;
        }
        byte_index = byte_index + 1;
    }
    expect(state, all_single_bit_corruption_safe,
        "single-bit mutations either fail or preserve the checksum-authenticated output");
    free[u8](&expected);
}

fn main() i32 {
    let state: TestState = TestState{ .passed = 0, .failed = 0 };
    stored_contract(&state);
    fixed_contract(&state);
    dynamic_contract(&state);
    multiblock_contract(&state);
    rejection_contract(&state);
    corruption_contract(&state);
    _zag_print("General zlib inflate: pass=");
    let passed: []u8 = _zag_i64_to_str(state.passed as i64);
    _zag_print(passed); _zag_str_free(passed);
    _zag_print(" fail=");
    let failed: []u8 = _zag_i64_to_str(state.failed as i64);
    _zag_println(failed); _zag_str_free(failed);
    if (state.failed == 0) { return 0; }
    return 1;
}
