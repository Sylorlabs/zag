@import("std:list")
@import("std:websocket") as ws

extern fn _zag_allocator_live_bytes() i64

fn bytes_equal(left: []u8, right: []u8) i32 {
    if (left.len != right.len) { return 0; }
    let i: i32 = 0;
    while (i < left.len) {
        if (left[i] != right[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn clone_bytes(input: []u8) ArrayList[u8] {
    let output: ArrayList[u8] = make[u8](input.len);
    let i: i32 = 0;
    while (i < input.len) { push[u8](&output, input[i]); i = i + 1; }
    return output;
}

fn main() i32 {
    let baseline: i64 = _zag_allocator_live_bytes();

    let sha_result: ws.WebSocketBufferResult = ws.websocket_sha1("abc");
    if (sha_result.ok != 1) { return 1; }
    let sha: ws.WebSocketBuffer = ws.websocket_buffer_take(&sha_result);
    let digest: []u8 = ws.websocket_buffer_slice(&sha);
    if (digest.len != 20 || digest[0] != 169 || digest[1] != 153 ||
        digest[2] != 62 || digest[3] != 54 || digest[4] != 71 ||
        digest[5] != 6 || digest[6] != 129 || digest[7] != 106 ||
        digest[8] != 186 || digest[9] != 62 || digest[10] != 37 ||
        digest[11] != 113 || digest[12] != 120 || digest[13] != 80 ||
        digest[14] != 194 || digest[15] != 108 || digest[16] != 156 ||
        digest[17] != 208 || digest[18] != 216 || digest[19] != 157) {
        return 2;
    }

    let base64_result: ws.WebSocketBufferResult = ws.websocket_base64_encode("hello");
    let base64: ws.WebSocketBuffer = ws.websocket_buffer_take(&base64_result);
    if (!@strEq(ws.websocket_buffer_slice(&base64), "aGVsbG8=")) { return 3; }
    let decoded_result: ws.WebSocketBufferResult = ws.websocket_base64_decode(
        ws.websocket_buffer_slice(&base64)
    );
    let decoded: ws.WebSocketBuffer = ws.websocket_buffer_take(&decoded_result);
    if (!@strEq(ws.websocket_buffer_slice(&decoded), "hello")) { return 4; }
    let bad_padding: ws.WebSocketBufferResult = ws.websocket_base64_decode("a===");
    let bad_unused: ws.WebSocketBufferResult = ws.websocket_base64_decode("Zh==");
    let bad_length: ws.WebSocketBufferResult = ws.websocket_base64_decode("abc");
    if (bad_padding.code != ws.websocket_status_malformed() ||
        bad_unused.code != ws.websocket_status_malformed() ||
        bad_length.code != ws.websocket_status_malformed()) { return 5; }

    let key: []u8 = "dGhlIHNhbXBsZSBub25jZQ==";
    let accept_result: ws.WebSocketBufferResult = ws.websocket_accept_value(key);
    let accept: ws.WebSocketBuffer = ws.websocket_buffer_take(&accept_result);
    if (!@strEq(ws.websocket_buffer_slice(&accept),
                "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=")) { return 6; }
    let request_result: ws.WebSocketBufferResult =
        ws.websocket_encode_client_handshake_default("example.test", "/chat", key);
    if (request_result.ok != 1) { return 7; }
    let request: ws.WebSocketBuffer = ws.websocket_buffer_take(&request_result);
    let response_result: ws.WebSocketBufferResult =
        ws.websocket_accept_handshake_default(ws.websocket_buffer_slice(&request));
    if (response_result.ok != 1) { return 8; }
    let response: ws.WebSocketBuffer = ws.websocket_buffer_take(&response_result);
    if (!@strEq(ws.websocket_buffer_slice(&response),
        "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n\r\n") ||
        ws.websocket_validate_server_handshake_default(
            ws.websocket_buffer_slice(&response), key
        ) != ws.websocket_status_ok() ||
        ws.websocket_validate_server_handshake_default(
            ws.websocket_buffer_slice(&response), "AAAAAAAAAAAAAAAAAAAAAA=="
        ) != ws.websocket_status_handshake()) { return 9; }
    let illegal_length_response: i64 = ws.websocket_validate_server_handshake_default(
        "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\nContent-Length: 0\r\n\r\n",
        key
    );
    if (illegal_length_response != ws.websocket_status_handshake()) { return 22; }

    let missing_upgrade: ws.WebSocketBufferResult = ws.websocket_accept_handshake_default(
        "GET /chat HTTP/1.1\r\nHost: example.test\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nContent-Length: 0\r\n\r\n"
    );
    let wrong_version: ws.WebSocketBufferResult = ws.websocket_accept_handshake_default(
        "GET /chat HTTP/1.1\r\nHost: example.test\r\nUpgrade: websocket\r\nConnection: keep-alive, Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 12\r\nContent-Length: 0\r\n\r\n"
    );
    let invalid_key: ws.WebSocketBufferResult = ws.websocket_accept_handshake_default(
        "GET /chat HTTP/1.1\r\nHost: example.test\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: AAA=\r\nSec-WebSocket-Version: 13\r\nContent-Length: 0\r\n\r\n"
    );
    if (missing_upgrade.code != ws.websocket_status_handshake() ||
        wrong_version.code != ws.websocket_status_handshake() ||
        invalid_key.code != ws.websocket_status_handshake()) { return 10; }

    let client_frame_result: ws.WebSocketBufferResult = ws.websocket_encode_client_frame(
        ws.websocket_opcode_text(), "Hello", 939139389
    );
    if (client_frame_result.ok != 1) { return 11; }
    let client_frame: ws.WebSocketBuffer = ws.websocket_buffer_take(&client_frame_result);
    let client_bytes: []u8 = ws.websocket_buffer_slice(&client_frame);
    if (client_bytes.len != 11 || client_bytes[0] != 129 || client_bytes[1] != 133 ||
        client_bytes[2] != 55 || client_bytes[3] != 250 || client_bytes[4] != 33 ||
        client_bytes[5] != 61 || client_bytes[6] != 127 || client_bytes[7] != 159 ||
        client_bytes[8] != 77 || client_bytes[9] != 81 || client_bytes[10] != 88) {
        return 12;
    }
    let parsed_client_result: ws.WebSocketFrameResult =
        ws.websocket_parse_client_frame(client_bytes, 32);
    let parsed_client: ws.WebSocketFrame = ws.websocket_frame_take(&parsed_client_result);
    if (parsed_client.opcode != ws.websocket_opcode_text() ||
        !@strEq(ws.websocket_frame_payload(&parsed_client), "Hello")) { return 13; }

    let long_payload: ArrayList[u8] = make[u8](126);
    let p: i32 = 0;
    while (p < 126) { push[u8](&long_payload, (p % 251) as u8); p = p + 1; }
    let server_binary_result: ws.WebSocketBufferResult = ws.websocket_encode_server_frame(
        ws.websocket_opcode_binary(), long_payload.data[0..long_payload.len]
    );
    let server_binary: ws.WebSocketBuffer = ws.websocket_buffer_take(&server_binary_result);
    let server_binary_bytes: []u8 = ws.websocket_buffer_slice(&server_binary);
    if (server_binary_bytes.len != 130 || server_binary_bytes[0] != 130 ||
        server_binary_bytes[1] != 126 || server_binary_bytes[2] != 0 ||
        server_binary_bytes[3] != 126) { return 14; }
    let parsed_binary_result: ws.WebSocketFrameResult =
        ws.websocket_parse_server_frame(server_binary_bytes, 126);
    let parsed_binary: ws.WebSocketFrame = ws.websocket_frame_take(&parsed_binary_result);
    if (parsed_binary.opcode != ws.websocket_opcode_binary() ||
        bytes_equal(ws.websocket_frame_payload(&parsed_binary),
                    long_payload.data[0..long_payload.len]) == 0) { return 15; }

    let close_payload: ArrayList[u8] = make[u8](5);
    push[u8](&close_payload, 3);
    push[u8](&close_payload, 232);
    push[u8](&close_payload, 98);
    push[u8](&close_payload, 121);
    push[u8](&close_payload, 101);
    let close_result: ws.WebSocketBufferResult = ws.websocket_encode_server_frame(
        ws.websocket_opcode_close(), close_payload.data[0..close_payload.len]
    );
    let close_frame: ws.WebSocketBuffer = ws.websocket_buffer_take(&close_result);
    let parsed_close_result: ws.WebSocketFrameResult = ws.websocket_parse_server_frame(
        ws.websocket_buffer_slice(&close_frame), 125
    );
    let parsed_close: ws.WebSocketFrame = ws.websocket_frame_take(&parsed_close_result);
    if (parsed_close.opcode != ws.websocket_opcode_close() ||
        bytes_equal(ws.websocket_frame_payload(&parsed_close),
                    close_payload.data[0..close_payload.len]) == 0) { return 16; }

    let ping_result: ws.WebSocketBufferResult = ws.websocket_encode_client_frame(
        ws.websocket_opcode_ping(), "probe", 16909060
    );
    let ping_buffer: ws.WebSocketBuffer = ws.websocket_buffer_take(&ping_result);
    let parsed_ping_result: ws.WebSocketFrameResult = ws.websocket_parse_client_frame(
        ws.websocket_buffer_slice(&ping_buffer), 125
    );
    let parsed_ping: ws.WebSocketFrame = ws.websocket_frame_take(&parsed_ping_result);
    let pong_result: ws.WebSocketBufferResult = ws.websocket_encode_server_frame(
        ws.websocket_opcode_pong(), ws.websocket_frame_payload(&parsed_ping)
    );
    let pong_buffer: ws.WebSocketBuffer = ws.websocket_buffer_take(&pong_result);
    let parsed_pong_result: ws.WebSocketFrameResult = ws.websocket_parse_server_frame(
        ws.websocket_buffer_slice(&pong_buffer), 125
    );
    let parsed_pong: ws.WebSocketFrame = ws.websocket_frame_take(&parsed_pong_result);
    let unicode_result: ws.WebSocketBufferResult = ws.websocket_encode_server_frame(
        ws.websocket_opcode_text(), "zag 😀"
    );
    let unicode_buffer: ws.WebSocketBuffer = ws.websocket_buffer_take(&unicode_result);
    let parsed_unicode_result: ws.WebSocketFrameResult = ws.websocket_parse_server_frame(
        ws.websocket_buffer_slice(&unicode_buffer), 32
    );
    let parsed_unicode: ws.WebSocketFrame = ws.websocket_frame_take(&parsed_unicode_result);
    if (parsed_ping.opcode != ws.websocket_opcode_ping() ||
        !@strEq(ws.websocket_frame_payload(&parsed_ping), "probe") ||
        parsed_pong.opcode != ws.websocket_opcode_pong() ||
        !@strEq(ws.websocket_frame_payload(&parsed_pong), "probe") ||
        parsed_unicode.opcode != ws.websocket_opcode_text() ||
        !@strEq(ws.websocket_frame_payload(&parsed_unicode), "zag 😀")) { return 21; }

    let unmasked_client: ws.WebSocketFrameResult = ws.websocket_parse_client_frame(
        ws.websocket_buffer_slice(&close_frame), 125
    );
    let masked_server: ws.WebSocketFrameResult = ws.websocket_parse_server_frame(
        client_bytes, 32
    );
    let rsv_bytes: ArrayList[u8] = clone_bytes(client_bytes);
    rsv_bytes.data[0] = 193;
    let rsv: ws.WebSocketFrameResult = ws.websocket_parse_client_frame(
        rsv_bytes.data[0..rsv_bytes.len], 32
    );
    let fragmented_bytes: ArrayList[u8] = clone_bytes(client_bytes);
    fragmented_bytes.data[0] = 1;
    let fragmented: ws.WebSocketFrameResult = ws.websocket_parse_client_frame(
        fragmented_bytes.data[0..fragmented_bytes.len], 32
    );
    let nonminimal: ws.WebSocketFrameResult = ws.websocket_parse_server_frame(
        "\x82\x7e\x00\x01x", 16
    );
    let huge_length: ws.WebSocketFrameResult = ws.websocket_parse_server_frame(
        "\x82\x7f", 65535
    );
    let reserved_opcode: ws.WebSocketFrameResult = ws.websocket_parse_server_frame(
        "\x83\x00", 16
    );
    let trailing_frame: ArrayList[u8] = clone_bytes(client_bytes);
    push[u8](&trailing_frame, 0);
    let trailing_result: ws.WebSocketFrameResult = ws.websocket_parse_client_frame(
        trailing_frame.data[0..trailing_frame.len], 32
    );
    let truncated_result: ws.WebSocketFrameResult = ws.websocket_parse_client_frame(
        client_bytes[0..client_bytes.len - 1], 32
    );
    if (unmasked_client.code != ws.websocket_status_protocol() ||
        masked_server.code != ws.websocket_status_protocol() ||
        rsv.code != ws.websocket_status_protocol() ||
        fragmented.code != ws.websocket_status_unsupported() ||
        nonminimal.code != ws.websocket_status_malformed() ||
        huge_length.code != ws.websocket_status_unsupported() ||
        reserved_opcode.code != ws.websocket_status_protocol() ||
        trailing_result.code != ws.websocket_status_malformed() ||
        truncated_result.code != ws.websocket_status_truncated()) { return 17; }

    let invalid_text_bytes: ArrayList[u8] = make[u8](8);
    push[u8](&invalid_text_bytes, 129);
    push[u8](&invalid_text_bytes, 2);
    push[u8](&invalid_text_bytes, 192);
    push[u8](&invalid_text_bytes, 175);
    let invalid_text: ws.WebSocketFrameResult = ws.websocket_parse_server_frame(
        invalid_text_bytes.data[0..invalid_text_bytes.len], 8
    );
    let one_byte_close: ws.WebSocketFrameResult = ws.websocket_parse_server_frame(
        "\x88\x01\x03", 8
    );
    let reserved_close: ws.WebSocketFrameResult = ws.websocket_parse_server_frame(
        "\x88\x02\x03\xed", 8
    );
    let payload_limit: ws.WebSocketFrameResult = ws.websocket_parse_server_frame(
        server_binary_bytes, 125
    );
    let oversized_ping: ws.WebSocketBufferResult = ws.websocket_encode_server_frame(
        ws.websocket_opcode_ping(), long_payload.data[0..long_payload.len]
    );
    if (invalid_text.code != ws.websocket_status_invalid_utf8() ||
        one_byte_close.code != ws.websocket_status_protocol() ||
        reserved_close.code != ws.websocket_status_protocol() ||
        payload_limit.code != ws.websocket_status_limit() ||
        oversized_ping.code != ws.websocket_status_limit()) { return 18; }

    if (ws.websocket_frame_close(&parsed_client) != ws.websocket_status_ok() ||
        ws.websocket_frame_close(&parsed_client) != ws.websocket_status_invalid_state() ||
        ws.websocket_frame_close(&parsed_binary) != ws.websocket_status_ok() ||
        ws.websocket_frame_close(&parsed_close) != ws.websocket_status_ok() ||
        ws.websocket_frame_close(&parsed_ping) != ws.websocket_status_ok() ||
        ws.websocket_frame_close(&parsed_pong) != ws.websocket_status_ok() ||
        ws.websocket_frame_close(&parsed_unicode) != ws.websocket_status_ok() ||
        ws.websocket_buffer_close(&sha) != ws.websocket_status_ok() ||
        ws.websocket_buffer_close(&sha) != ws.websocket_status_invalid_state() ||
        ws.websocket_buffer_close(&base64) != ws.websocket_status_ok() ||
        ws.websocket_buffer_close(&decoded) != ws.websocket_status_ok() ||
        ws.websocket_buffer_close(&accept) != ws.websocket_status_ok() ||
        ws.websocket_buffer_close(&request) != ws.websocket_status_ok() ||
        ws.websocket_buffer_close(&response) != ws.websocket_status_ok() ||
        ws.websocket_buffer_close(&client_frame) != ws.websocket_status_ok() ||
        ws.websocket_buffer_close(&server_binary) != ws.websocket_status_ok() ||
        ws.websocket_buffer_close(&close_frame) != ws.websocket_status_ok() ||
        ws.websocket_buffer_close(&ping_buffer) != ws.websocket_status_ok() ||
        ws.websocket_buffer_close(&pong_buffer) != ws.websocket_status_ok() ||
        ws.websocket_buffer_close(&unicode_buffer) != ws.websocket_status_ok()) { return 19; }
    free[u8](&long_payload);
    free[u8](&close_payload);
    free[u8](&rsv_bytes);
    free[u8](&fragmented_bytes);
    free[u8](&trailing_frame);
    free[u8](&invalid_text_bytes);
    if (_zag_allocator_live_bytes() != baseline) { return 20; }
    return 0;
}
