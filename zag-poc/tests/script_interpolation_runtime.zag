@import("../selfhost/std/script_interpolate.zag")
extern fn _zag_script_context_init(limit:i64,capabilities:i64,execution_policy:i64)*opaque
extern fn _zag_script_context_shutdown(context:*opaque)void
extern fn _zag_script_alloc_used(context:*opaque)i64
fn next_value(counter:*i32)i64{counter.*=counter.*+1;return counter.* as i64;}
fn main()i32{
    unsafe{
    let limit:i64=1048576;if(_zag_argc()>1&&@strEq(_zag_arg(1),"budget")){limit=65535;}
    let context:*opaque=_zag_script_context_init(limit,7,16843009);
    let count:i32=0;
    let output:[]u8=script_interpolation_finish(script_interpolation_append(
        script_interpolation_append(script_interpolation_new(context),script_format_i64_checked(context,next_value(&count))),
        script_format_i64_checked(context,next_value(&count))));
    if(count!=2||!@strEq(output,"12")){return 1;}
    if(_zag_script_alloc_used(context)!=65538){return 2;}
    let minimum:i64=(0-9223372036854775807)-1;
    if(!@strEq(script_format_i64_checked(context,minimum),"-9223372036854775808")){return 3;}
    if(!@strEq(script_format_i64_checked(context,9223372036854775807),"9223372036854775807")){return 4;}
    if(!@strEq(script_format_bool_checked(context,true),"true")){return 5;}
    if(!@strEq(script_format_bool_checked(context,false),"false")){return 6;}
    if(!@strEq(script_format_string_checked(context,"λ世界"),"λ世界")){return 7;}
    if(!@strEq(script_format_string_checked(context,""),"")){return 8;}
    if(_zag_argc()>1&&@strEq(_zag_arg(1),"overflow")){
        let data:*u8=_zag_script_alloc(context,65536) as *u8;
        let i:i32=0;while(i<65536){data[i]=65;i=i+1;}
        let builder:ScriptInterpolationBuilder=script_interpolation_append(script_interpolation_new(context),data[0..65536]);
        let failed:ScriptInterpolationBuilder=script_interpolation_append(builder,"x");return 9;
    }
    _zag_script_context_shutdown(context);return 0;
    }
}
