// Execute the production ARM wait emitter's post-syscall paths, including
// deterministic EINTR/error injection. Only the trap is replaced; stack setup,
// result normalization and cleanup are the actual backend implementation.
@import("../selfhost/native/process_wait_arm64.zag")
@import("../selfhost/native/aarch64.zag")
@import("../selfhost/native/macho_arm64.zag")

fn main() i32 {
    if (_zag_argc() != 2) { return 2; }
    let program: ArrayList[AInstr] = make[AInstr](256);
    let injected: i32 = 0;
    let round: i32 = 0;
    while (round < 4) {
        let result: i64 = -4;
        let expected: i64 = 0;
        if (round == 1) { result = -9; expected = -9; }
        if (round == 2) { result = -22; expected = -22; }
        if (round == 3) { result = 1; expected = 1; }
        push[AInstr](&program, ai_mov_rr(A_X20(), A_SP()));
        push[AInstr](&program, ai_mov_imm(A_X0(), -1));
        push[AInstr](&program, ai_mov_imm(A_X1(), 50));
        let start: i32 = program.len;
        let label: i32 = round * 10 + 1;
        process_emit_wait_arm64(&program, 1, label, label+1, label+2, label+3);
        let i: i32 = start;
        while (i < program.len) {
            if (program.data[i].kind == AK_DARWIN_SYSCALL() && program.data[i].imm == 230) {
                program.data[i] = ai_mov_imm(A_X0(), result);
                injected = injected + 1;
            }
            i = i + 1;
        }
        push[AInstr](&program, ai_cmp_imm(A_X0(), expected));
        push[AInstr](&program, ai_je(label+4));
        push[AInstr](&program, ai_mov_imm(A_X0(), 10 + round));
        push[AInstr](&program, ai_syscall(93));
        push[AInstr](&program, ai_label(label+4));
        push[AInstr](&program, ai_mov_rr(A_X21(), A_SP()));
        push[AInstr](&program, ai_cmp(A_X21(), A_X20()));
        push[AInstr](&program, ai_je(label+5));
        push[AInstr](&program, ai_mov_imm(A_X0(), 20 + round));
        push[AInstr](&program, ai_syscall(93));
        push[AInstr](&program, ai_label(label+5));
        round = round + 1;
    }
    if (injected != 4) { return 3; }
    push[AInstr](&program, ai_mov_imm(A_X0(), 0));
    push[AInstr](&program, ai_syscall(93));
    let data: ArrayList[u8] = make[u8](1);
    let provisional: ArrayList[u8] = aencode_macos(program, macho_code_vmaddr(), MACHO_BASE(), 0, 0);
    let code: ArrayList[u8] = aencode_macos(program, macho_code_vmaddr(), macho_data_vmaddr(provisional.len), 0, 0);
    return write_macho_arm64_data(_zag_arg(1), code, 0, data);
}
