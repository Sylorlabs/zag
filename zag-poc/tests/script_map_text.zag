script;

let values = text_map();
if (text_map_len(values) != 0 || text_map_has(values, "missing")) { return 1; }
if (text_map_put(values, "alpha", "one") != 0 ||
    text_map_put(values, "beta", "two") != 0 ||
    text_map_put(values, "gamma", "three") != 0 ||
    text_map_put(values, "delta", "four") != 0 ||
    text_map_put(values, "epsilon", "five") != 0 ||
    text_map_put(values, "zeta", "six") != 0) { return 2; }
if (!text_map_has(values, "alpha") || !text_map_has(values, "zeta") ||
    text_map_has(values, "missing") || text_map_len(values) != 6) { return 3; }
if (!@strEq(text_map_get(values, "alpha"), "one") ||
    !@strEq(text_map_get(values, "zeta"), "six")) { return 4; }
if (text_map_put(values, "alpha", "updated") != 0 ||
    !@strEq(text_map_get(values, "alpha"), "updated") ||
    text_map_len(values) != 6) { return 5; }
if (text_map_del(values, "gamma") != 0 ||
    text_map_has(values, "gamma") || text_map_len(values) != 5 ||
    !text_map_has(values, "delta")) { return 6; }
if (text_map_del(values, "gamma") == 0 ||
    text_map_del(values, "") != 1 || text_map_failed(values) != 0) { return 7; }
if (text_map_put(values, "", "") != 0 ||
    !text_map_has(values, "") || !@strEq(text_map_get(values, ""), "") ||
    text_map_len(values) != 6 || text_map_failed(values) != 0) { return 8; }

// text_map_put must copy caller-owned key/value bytes before the entry becomes
// visible. Mutating both source slices after insertion must not change lookup
// identity or the stored payload.
let copied = text_map();
let caller_key: *u8 = script_alloc(5) as *u8;
let caller_value: *u8 = script_alloc(3) as *u8;
if (caller_key == null as *u8 || caller_value == null as *u8) { return 11; }
caller_key[0] = 97; caller_key[1] = 108; caller_key[2] = 112;
caller_key[3] = 104; caller_key[4] = 97;
caller_value[0] = 111; caller_value[1] = 110; caller_value[2] = 101;
if (text_map_put(copied, caller_key[0..5], caller_value[0..3]) != 0) { return 12; }
caller_key[0] = 88; caller_value[0] = 89;
if (!text_map_has(copied, "alpha") || text_map_has(copied, "Xlpha") ||
    !@strEq(text_map_get(copied, "alpha"), "one") ||
    text_map_failed(copied) != 0) { return 13; }
// Clear validates the complete state table before writes, scrubs every
// retained key/value/state slot, keeps the table allocation, and permits
// deterministic reuse after a tombstone has been created.
let cleared = text_map();
if (text_map_put(cleared, "clear-alpha", "one") != 0 ||
    text_map_put(cleared, "clear-beta", "two") != 0 ||
    text_map_del(cleared, "clear-beta") != 0) { return 14; }
let old_keys: *[]u8 = cleared.keys;
let old_values: *[]u8 = cleared.values;
let old_used: *u8 = cleared.used;
let old_cap: i32 = cleared.cap;
let slot: i32 = 0;
while (slot < old_cap) {
    old_keys[slot] = "retained-key";
    old_values[slot] = "retained-value";
    slot = slot + 1;
}
if (text_map_clear(cleared) != 0 || text_map_len(cleared) != 0 ||
    text_map_failed(cleared) != 0 || cleared.cap != old_cap ||
    cleared.keys != old_keys || cleared.values != old_values ||
    cleared.used != old_used) { return 15; }
slot = 0;
while (slot < old_cap) {
    if (old_keys[slot].len != 0 || old_values[slot].len != 0 ||
        old_used[slot] != 0) { return 16; }
    slot = slot + 1;
}
if (text_map_put(cleared, "reused", "after-clear") != 0 ||
    text_map_len(cleared) != 1 ||
    !@strEq(text_map_get(cleared, "reused"), "after-clear")) { return 17; }

let zero_cap = text_map();
zero_cap.keys[0] = "zero-key";
zero_cap.values[0] = "zero-value";
zero_cap.cap = 0;
if (text_map_clear(zero_cap) != 1 || zero_cap.failed != 1 ||
    !@strEq(zero_cap.keys[0], "zero-key") ||
    !@strEq(zero_cap.values[0], "zero-value")) { return 18; }

let non_power = text_map();
non_power.keys[0] = "power-key";
non_power.values[0] = "power-value";
non_power.cap = 10;
if (text_map_clear(non_power) != 1 || non_power.failed != 1 ||
    !@strEq(non_power.keys[0], "power-key") ||
    !@strEq(non_power.values[0], "power-value")) { return 19; }

let mismatched = text_map();
mismatched.keys[0] = "count-key";
mismatched.values[0] = "count-value";
mismatched.count = 1;
if (text_map_clear(mismatched) != 1 || mismatched.failed != 1 ||
    !@strEq(mismatched.keys[0], "count-key") ||
    !@strEq(mismatched.values[0], "count-value") ||
    mismatched.used[0] != 0) { return 20; }

let tombstone_mismatch = text_map();
tombstone_mismatch.keys[0] = "tombstone-key";
tombstone_mismatch.values[0] = "tombstone-value";
tombstone_mismatch.tombstones = 1;
if (text_map_clear(tombstone_mismatch) != 1 ||
    tombstone_mismatch.failed != 1 ||
    !@strEq(tombstone_mismatch.keys[0], "tombstone-key") ||
    !@strEq(tombstone_mismatch.values[0], "tombstone-value") ||
    tombstone_mismatch.used[0] != 0) { return 21; }

let bad_state = text_map();
bad_state.keys[0] = "state-key";
bad_state.values[0] = "state-value";
bad_state.keys[bad_state.cap - 1] = "late-state-key";
bad_state.values[bad_state.cap - 1] = "late-state-value";
bad_state.used[bad_state.cap - 1] = 3;
if (text_map_clear(bad_state) != 1 || bad_state.failed != 1 ||
    !@strEq(bad_state.keys[0], "state-key") ||
    !@strEq(bad_state.values[0], "state-value") ||
    !@strEq(bad_state.keys[bad_state.cap - 1], "late-state-key") ||
    !@strEq(bad_state.values[bad_state.cap - 1], "late-state-value") ||
    bad_state.used[bad_state.cap - 1] != 3) { return 22; }

let bad_keys = text_map();
bad_keys.values[0] = "keys-null-value";
bad_keys.keys = null;
if (text_map_clear(bad_keys) != 1 || bad_keys.failed != 1 ||
    !@strEq(bad_keys.values[0], "keys-null-value")) { return 23; }

let bad_values = text_map();
bad_values.keys[0] = "values-null-key";
bad_values.values = null;
if (text_map_clear(bad_values) != 1 || bad_values.failed != 1 ||
    !@strEq(bad_values.keys[0], "values-null-key")) { return 24; }

let bad_used = text_map();
bad_used.keys[0] = "used-null-key";
bad_used.values[0] = "used-null-value";
bad_used.used = null;
if (text_map_clear(bad_used) != 1 || bad_used.failed != 1 ||
    !@strEq(bad_used.keys[0], "used-null-key") ||
    !@strEq(bad_used.values[0], "used-null-value")) { return 25; }

let bad_context = text_map();
bad_context.keys[0] = "context-null-key";
bad_context.values[0] = "context-null-value";
bad_context.context = null;
if (text_map_clear(bad_context) != 1 || bad_context.failed != 1 ||
    !@strEq(bad_context.keys[0], "context-null-key") ||
    !@strEq(bad_context.values[0], "context-null-value")) { return 26; }
return 0;
