@import("std:list")

fn slice_sum(values: []i64) i64 {
    let total: i64 = 0;
    let i: i32 = 0;
    while (i < values.len) { total = total + values[i]; i = i + 1; }
    return total;
}

fn main() i32 {
    let values: ArrayList[i64] = make[i64](5);
    push[i64](&values, 10); push[i64](&values, 20);
    push[i64](&values, 30); push[i64](&values, 40);
    push[i64](&values, 50);
    let middle: []i64 = values.data[1..4];
    if (middle.len != 3 || slice_sum(middle) != 90) {
        free[i64](&values); return 1;
    }
    middle[1] = 99;
    if (values.data[2] != 99) { free[i64](&values); return 2; }
    let tail: []i64 = middle[1..3];
    if (tail.len != 2 || tail[0] != 99 || tail[1] != 40) {
        free[i64](&values); return 3;
    }
    free[i64](&values);
    return 42;
}
