@import("../selfhost/package_resolve.zag")

extern fn _zag_write_file(path: []u8, content: []u8) i32
extern fn _zag_i64_to_str(v: i64) []u8 @alloc

fn lock_resolve_checksum_text(h: PackageRawChecksum) []u8 {
    let a: []u8 = _zag_i64_to_str(h.first);
    let b: []u8 = _zag_i64_to_str(h.second);
    let c: []u8 = _zag_i64_to_str(h.bytes);
    let ab: []u8 = _zag_str_concat(a, ","); ab = _zag_str_concat(ab, b);
    let abc: []u8 = _zag_str_concat(ab, ","); abc = _zag_str_concat(abc, c);
    _zag_str_free(a); _zag_str_free(b); _zag_str_free(c); _zag_str_free(ab);
    return abc;
}

fn lock_resolve_finalize(body: []u8) []u8 {
    let checksum: []u8 = lock_resolve_checksum_text(package_raw_checksum(body));
    let line: []u8 = _zag_str_concat("checksum=", checksum);
    let with_newline: []u8 = _zag_str_concat(line, "\n");
    let result: []u8 = _zag_str_concat(body, with_newline);
    _zag_str_free(checksum); _zag_str_free(line); _zag_str_free(with_newline);
    return result;
}

fn lock_resolve_entry(version: []u8, artifact_signature: []u8,
    index: []u8, source: []u8) []u8 {
    let index_sum: []u8 = lock_resolve_checksum_text(package_raw_checksum(index));
    let source_sum: []u8 = lock_resolve_checksum_text(package_raw_checksum(source));
    let line: []u8 = _zag_str_concat("entry=toolkit\tregistry/index.zag\t", index_sum);
    line = _zag_str_concat(line, "\t"); line = _zag_str_concat(line, version);
    line = _zag_str_concat(line, "\tsrc/toolkit.zag\t");
    line = _zag_str_concat(line, source_sum); line = _zag_str_concat(line, "\t");
    line = _zag_str_concat(line, artifact_signature); line = _zag_str_concat(line, "\n");
    _zag_str_free(index_sum); _zag_str_free(source_sum);
    return line;
}

fn lock_resolve_expect(ok: i32, label: []u8, failures: *i32) void {
    if (ok != 0) { _zag_print("ok  "); _zag_println(label); }
    else { _zag_print("FAIL "); _zag_println(label); failures.* = failures.* + 1; }
}

fn main() i32 {
    if (_zag_argc() != 2) { return 2; }
    let failures: i32 = 0; let root: []u8 = _zag_arg(1);
    let source_path: []u8 = package_import_join(root, "registry/src/toolkit.zag");
    let index_path: []u8 = package_import_join(root, "registry/index.zag");
    let lock_path: []u8 = package_import_join(root, "registry.lock");
    let manifest_path: []u8 = package_import_join(root, "zag.mod");
    let source: []u8 = "pub fn answer() i32 { return 42; }\n";
    let manifest: []u8 = "name = \"registry-lock-consumer\"\nversion = \"0.0.0\"\nedition = \"2026\"\n\n[deps]\ntoolkit = { path = \"registry/index.zag\", mode = \"registry\", version = \"^1.0.0\", registry_lock = \"registry.lock\" }\n";
    let source_sum: []u8 = lock_resolve_checksum_text(package_raw_checksum(source));
    let index_body: []u8 = _zag_str_concat(
        "format=zag-registry-index-v1\nauthority=local-file-v1\nsignature=none\nentry=toolkit\t1.0.0\tsrc/toolkit.zag\t",
        source_sum);
    index_body = _zag_str_concat(index_body, "\tsig/toolkit.sig\n");
    let index: []u8 = lock_resolve_finalize(index_body);
    let lock_entry: []u8 = lock_resolve_entry("1.0.0", "sig/toolkit.sig", index, source);
    let lock_body: []u8 = _zag_str_concat("format=zag-registry-lock-v1\n", lock_entry);
    let lock: []u8 = lock_resolve_finalize(lock_body);
    lock_resolve_expect(_zag_write_file(source_path, source) == 0 &&
        _zag_write_file(index_path, index) == 0 &&
        _zag_write_file(manifest_path, manifest) == 0 &&
        _zag_write_file(lock_path, lock) == 0,
        "explicit registry lock fixture writes", &failures);
    let base: []u8 = package_import_join(root, "src");
    let resolved: PackageImportResolution = package_import_resolve(
        "pkg:toolkit/src/toolkit.zag", base); _zag_str_free(base);
    lock_resolve_expect(resolved.matched == 1 && resolved.error == PackageImportError.none,
        "explicit registry lock accepts exact selected bytes and signature path", &failures);
    lock_resolve_expect(resolved.registry_lockfile_source_owned == 1 &&
        @strEq(resolved.registry_lockfile_source, lock) &&
        resolved.registry_lockfile.len > 0,
        "validated registry.lock sidecar is retained for semantic resources", &failures);
    package_import_resolution_release(&resolved);

    let bad_entry: []u8 = lock_resolve_entry("1.1.0", "sig/toolkit.sig", index, source);
    let bad_body: []u8 = _zag_str_concat("format=zag-registry-lock-v1\n", bad_entry);
    let bad_lock: []u8 = lock_resolve_finalize(bad_body);
    lock_resolve_expect(_zag_write_file(lock_path, bad_lock) == 0, "version mutation writes", &failures);
    let changed_base: []u8 = package_import_join(root, "src");
    let changed: PackageImportResolution = package_import_resolve(
        "pkg:toolkit/src/toolkit.zag", changed_base); _zag_str_free(changed_base);
    lock_resolve_expect(changed.error == PackageImportError.registry_lock_mismatch,
        "mutated locked version fails closed", &failures);
    package_import_resolution_release(&changed);

    let bad_signature_entry: []u8 = lock_resolve_entry("1.0.0", "sig/other.sig", index, source);
    let bad_signature_body: []u8 = _zag_str_concat(
        "format=zag-registry-lock-v1\n", bad_signature_entry);
    let bad_signature_lock: []u8 = lock_resolve_finalize(bad_signature_body);
    lock_resolve_expect(_zag_write_file(lock_path, bad_signature_lock) == 0,
        "signature-path mutation writes", &failures);
    let signature_base: []u8 = package_import_join(root, "src");
    let signature_changed: PackageImportResolution = package_import_resolve(
        "pkg:toolkit/src/toolkit.zag", signature_base); _zag_str_free(signature_base);
    lock_resolve_expect(signature_changed.error == PackageImportError.registry_lock_mismatch,
        "mutated artifact-signature provenance fails closed", &failures);
    package_import_resolution_release(&signature_changed);

    // The default resolver also consumes the transitive graph-lock envelope
    // through the same explicit registry_lock sidecar. It must bind the
    // selected version/source/raw bytes before returning a compilable result.
    let graph_body: []u8 = _zag_str_concat(
        "format=zag-registry-graph-lock-v1\nentry=toolkit\t1.0.0\tsrc/toolkit.zag\t",
        source_sum);
    graph_body = _zag_str_concat(graph_body, "\n");
    let graph_lock: []u8 = lock_resolve_finalize(graph_body);
    let default_manifest: []u8 = "name = \"registry-lock-consumer\"\nversion = \"0.0.0\"\nedition = \"2026\"\n\n[deps]\ntoolkit = { path = \"registry/index.zag\", mode = \"registry\", version = \"^1.0.0\" }\n";
    lock_resolve_expect(_zag_write_file(manifest_path, default_manifest) == 0,
        "default registry.lock manifest fixture writes", &failures);
    let nested_manifest_path: []u8 = package_import_join(root, "nested/zag.mod");
    let nested_index_path: []u8 = package_import_join(root, "nested/registry/index.zag");
    let nested_source_path: []u8 = package_import_join(root, "nested/registry/src/toolkit.zag");
    let nested_manifest: []u8 = "name = \"nested-consumer\"\nversion = \"0.0.0\"\nedition = \"2026\"\n\n[deps]\ntoolkit = { path = \"registry/index.zag\", mode = \"registry\", version = \"^1.0.0\" }\n";
    let nested_index: []u8 = index;
    lock_resolve_expect(_zag_write_file(nested_manifest_path, nested_manifest) == 0,
        "nested default registry.lock manifest fixture writes", &failures);
    lock_resolve_expect(_zag_write_file(nested_source_path, source) == 0 &&
        _zag_write_file(nested_index_path, nested_index) == 0,
        "nested default registry.lock index fixture writes", &failures);
    lock_resolve_expect(_zag_write_file(lock_path, graph_lock) == 0,
        "graph-lock fixture writes", &failures);
    let graph_base: []u8 = package_import_join(root, "src");
    let graph_resolved: PackageImportResolution = package_import_resolve(
        "pkg:toolkit/src/toolkit.zag", graph_base); _zag_str_free(graph_base);
    lock_resolve_expect(graph_resolved.matched == 1 &&
        graph_resolved.error == PackageImportError.none,
        "default resolver admits exact conventional graph-lock tuple", &failures);
    package_import_resolution_release(&graph_resolved);
    let nested_base: []u8 = package_import_join(root, "nested/src");
    let nested_resolved: PackageImportResolution = package_import_resolve(
        "pkg:toolkit/src/toolkit.zag", nested_base); _zag_str_free(nested_base);
    lock_resolve_expect(nested_resolved.matched == 1 &&
        nested_resolved.error == PackageImportError.none,
        "nested default resolver walks to the root conventional sidecar", &failures);
    package_import_resolution_release(&nested_resolved);
    let graph_edges: []u8 = "registry-lock-consumer\ttoolkit\t^1.0.0";
    lock_resolve_expect(package_import_graph_lock_edges_valid(graph_lock,
        graph_edges) == 1,
        "graph-lock sidecar covers the parser edge stream", &failures);
    let graph_extra_edges: []u8 = _zag_str_concat(graph_edges,
        "\nregistry-lock-consumer\tother\t^1.0.0");
    lock_resolve_expect(package_import_graph_lock_edges_valid(graph_lock,
        graph_extra_edges) == 0,
        "graph-lock sidecar rejects omitted graph targets", &failures);

    let graph_bad_body: []u8 = _zag_str_concat(
        "format=zag-registry-graph-lock-v1\nentry=toolkit\t1.1.0\tsrc/toolkit.zag\t",
        source_sum);
    graph_bad_body = _zag_str_concat(graph_bad_body, "\n");
    let graph_bad: []u8 = lock_resolve_finalize(graph_bad_body);
    lock_resolve_expect(_zag_write_file(lock_path, graph_bad) == 0,
        "graph-lock version mutation writes", &failures);
    let graph_bad_base: []u8 = package_import_join(root, "src");
    let graph_changed: PackageImportResolution = package_import_resolve(
        "pkg:toolkit/src/toolkit.zag", graph_bad_base); _zag_str_free(graph_bad_base);
    lock_resolve_expect(graph_changed.error == PackageImportError.registry_lock_mismatch,
        "default resolver rejects stale graph-lock selection", &failures);
    package_import_resolution_release(&graph_changed);
    // Leave the fixture on the valid conventional sidecar so the shell gate
    // exercises default parser/import admission after these direct assertions.
    lock_resolve_expect(_zag_write_file(lock_path, graph_lock) == 0,
        "graph-lock fixture restores valid selection", &failures);

    _zag_str_free(source_sum); _zag_str_free(index_body); _zag_str_free(index);
    _zag_str_free(lock_entry); _zag_str_free(lock_body); _zag_str_free(lock);
    _zag_str_free(bad_entry); _zag_str_free(bad_body); _zag_str_free(bad_lock);
    _zag_str_free(bad_signature_entry); _zag_str_free(bad_signature_body);
    _zag_str_free(bad_signature_lock); _zag_str_free(graph_body);
    _zag_str_free(graph_lock); _zag_str_free(graph_bad_body);
    _zag_str_free(graph_bad); _zag_str_free(graph_extra_edges);
    _zag_str_free(source_path);
    _zag_str_free(index_path); _zag_str_free(lock_path); _zag_str_free(manifest_path);
    _zag_str_free(nested_manifest_path); _zag_str_free(nested_index_path);
    _zag_str_free(nested_source_path);
    _zag_print("package registry lock resolver: ");
    _zag_print(_zag_i64_to_str((18 - failures) as i64)); _zag_print("/18\n");
    return failures;
}
