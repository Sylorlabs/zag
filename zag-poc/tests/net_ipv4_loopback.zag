@import("std:list")
@import("std:net_ipv4") as net

extern fn _zag_allocator_live_bytes() i64

fn bytes_equal(left: []u8, right: []u8) i32 {
    if (left.len != right.len) { return 0; }
    let i: i32 = 0;
    while (i < left.len) {
        if (left[i] != right[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn main() i32 {
    let allocation_baseline: i64 = _zag_allocator_live_bytes();
    let loopback: net.NetIpv4Endpoint = net.net_ipv4_endpoint(
        net.net_ipv4_loopback(), 0
    );

    let bad_listener: net.NetTcpListenerResult = net.net_tcp_listen_ipv4(
        net.net_ipv4_endpoint(net.net_ipv4_loopback(), 0 - 1), 8, 1000
    );
    if (bad_listener.ok != 0 || bad_listener.code != net.net_status_invalid_argument() ||
        bad_listener.value.open != 0) { return 1; }

    let listener_result: net.NetTcpListenerResult =
        net.net_tcp_listen_ipv4(loopback, 8, 1000);
    if (listener_result.ok != 1 || listener_result.value.open != 1 ||
        listener_result.value.local.address != net.net_ipv4_loopback() ||
        listener_result.value.local.port < 1 ||
        listener_result.value.local.port > 65535) { return 2; }
    let listener: net.NetTcpListener = net.net_tcp_listener_take(&listener_result);
    if (listener.open != 1 || listener_result.value.open != 0) { return 17; }

    let client_result: net.NetTcpStreamResult = net.net_tcp_connect_ipv4(
        listener.local, 1000
    );
    if (client_result.ok != 1 || client_result.value.open != 1) {
        net.net_tcp_listener_close(&listener);
        return 3;
    }
    let client: net.NetTcpStream = net.net_tcp_stream_take(&client_result);
    if (client.open != 1 || client_result.value.open != 0) { return 18; }
    let server_result: net.NetTcpStreamResult = net.net_tcp_accept(&listener, 1000);
    if (server_result.ok != 1 || server_result.value.open != 1) {
        net.net_tcp_stream_close(&client);
        net.net_tcp_listener_close(&listener);
        return 4;
    }
    let server: net.NetTcpStream = net.net_tcp_stream_take(&server_result);
    if (server.open != 1 || server_result.value.open != 0) { return 19; }

    let tcp_request: []u8 = "tcp-partial-loop";
    let send_request: net.NetIoResult = net.net_tcp_send_all_bounded(
        &client, tcp_request, 64, 32, 3
    );
    if (send_request.ok != 1 || send_request.transferred != tcp_request.len ||
        send_request.calls < 2) { return 5; }
    let request_buffer: ArrayList[u8] = make[u8](tcp_request.len);
    let recv_request: net.NetIoResult = net.net_tcp_recv_exact_bounded(
        &server, request_buffer.data[0..tcp_request.len], tcp_request.len,
        64, 32, 2
    );
    if (recv_request.ok != 1 || recv_request.transferred != tcp_request.len ||
        recv_request.calls < 2 ||
        bytes_equal(request_buffer.data[0..tcp_request.len], tcp_request) == 0) {
        return 6;
    }

    let tcp_response: []u8 = "tcp-response";
    let send_response: net.NetIoResult = net.net_tcp_send_all_bounded(
        &server, tcp_response, 64, 32, 2
    );
    let response_buffer: ArrayList[u8] = make[u8](tcp_response.len);
    let recv_response: net.NetIoResult = net.net_tcp_recv_exact_bounded(
        &client, response_buffer.data[0..tcp_response.len], tcp_response.len,
        64, 32, 3
    );
    if (send_response.ok != 1 || send_response.calls < 2 ||
        recv_response.ok != 1 || recv_response.calls < 2 ||
        bytes_equal(response_buffer.data[0..tcp_response.len], tcp_response) == 0) {
        return 7;
    }

    if (net.net_tcp_stream_close(&server) != net.net_status_ok() ||
        net.net_tcp_stream_close(&server) != net.net_status_invalid_state() ||
        net.net_tcp_stream_close(&client) != net.net_status_ok() ||
        net.net_tcp_listener_close(&listener) != net.net_status_ok() ||
        net.net_tcp_listener_close(&listener) != net.net_status_invalid_state()) {
        return 8;
    }
    let closed_send: net.NetIoResult = net.net_tcp_send_all(&client, "closed");
    let closed_accept: net.NetTcpStreamResult = net.net_tcp_accept(&listener, 1000);
    if (closed_send.ok != 0 || closed_send.code != net.net_status_invalid_state() ||
        closed_accept.ok != 0 ||
        closed_accept.code != net.net_status_invalid_state()) { return 9; }

    let udp_server_result: net.NetUdpSocketResult = net.net_udp_bind_ipv4(loopback, 1000);
    let udp_client_result: net.NetUdpSocketResult = net.net_udp_bind_ipv4(loopback, 1000);
    if (udp_server_result.ok != 1 || udp_client_result.ok != 1 ||
        udp_server_result.value.local.port < 1 ||
        udp_client_result.value.local.port < 1 ||
        udp_server_result.value.local.port == udp_client_result.value.local.port) {
        return 10;
    }
    let udp_server: net.NetUdpSocket = net.net_udp_socket_take(&udp_server_result);
    let udp_client: net.NetUdpSocket = net.net_udp_socket_take(&udp_client_result);
    if (udp_server.open != 1 || udp_client.open != 1 ||
        udp_server_result.value.open != 0 || udp_client_result.value.open != 0) {
        return 20;
    }

    let udp_request: []u8 = "udp-request";
    let udp_send: net.NetIoResult = net.net_udp_send_to(
        &udp_client, udp_server.local, udp_request
    );
    let udp_request_buffer: ArrayList[u8] = make[u8](64);
    let udp_recv: net.NetUdpReceiveResult = net.net_udp_recv_from_bounded(
        &udp_server, udp_request_buffer.data[0..64], 64, 8
    );
    if (udp_send.ok != 1 || udp_send.transferred != udp_request.len ||
        udp_recv.ok != 1 || udp_recv.transferred != udp_request.len ||
        udp_recv.source.address != net.net_ipv4_loopback() ||
        udp_recv.source.port != udp_client.local.port ||
        bytes_equal(udp_request_buffer.data[0..udp_recv.transferred], udp_request) == 0) {
        return 11;
    }

    let udp_response: []u8 = "udp-response";
    let udp_reply: net.NetIoResult = net.net_udp_send_to(
        &udp_server, udp_recv.source, udp_response
    );
    let udp_response_buffer: ArrayList[u8] = make[u8](64);
    let udp_reply_recv: net.NetUdpReceiveResult = net.net_udp_recv_from(
        &udp_client, udp_response_buffer.data[0..64]
    );
    if (udp_reply.ok != 1 || udp_reply_recv.ok != 1 ||
        udp_reply_recv.transferred != udp_response.len ||
        udp_reply_recv.source.port != udp_server.local.port ||
        bytes_equal(udp_response_buffer.data[0..udp_reply_recv.transferred],
                    udp_response) == 0) { return 12; }

    let trunc_send: net.NetIoResult = net.net_udp_send_to(
        &udp_client, udp_server.local, "oversized-datagram"
    );
    let tiny_buffer: ArrayList[u8] = make[u8](4);
    let trunc_recv: net.NetUdpReceiveResult = net.net_udp_recv_from_bounded(
        &udp_server, tiny_buffer.data[0..4], 4, 8
    );
    if (trunc_send.ok != 1 || trunc_recv.ok != 0 ||
        trunc_recv.code != net.net_status_truncated() ||
        trunc_recv.transferred != 4) { return 13; }

    if (net.net_udp_close(&udp_server) != net.net_status_ok() ||
        net.net_udp_close(&udp_server) != net.net_status_invalid_state() ||
        net.net_udp_close(&udp_client) != net.net_status_ok()) { return 14; }
    let closed_udp_send: net.NetIoResult = net.net_udp_send_to(
        &udp_client, udp_server.local, "closed"
    );
    if (closed_udp_send.ok != 0 ||
        closed_udp_send.code != net.net_status_invalid_state()) { return 15; }

    free[u8](&request_buffer);
    free[u8](&response_buffer);
    free[u8](&udp_request_buffer);
    free[u8](&udp_response_buffer);
    free[u8](&tiny_buffer);
    if (_zag_allocator_live_bytes() != allocation_baseline) { return 16; }
    return 0;
}
