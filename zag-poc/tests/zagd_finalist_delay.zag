struct FinalistDelayTimespec { sec:i64, nsec:i64 }

fn main()i32{
    // A wall-clock delay makes the cancellation race deterministic across
    // fast and slow CPUs. The executor's deadline is one second, so 200 ms
    // leaves ample headroom while guaranteeing an edit can invalidate an
    // in-flight finalist.
    let delay:FinalistDelayTimespec=FinalistDelayTimespec{.sec=0,.nsec=200000000};
    let _slept:i64=_zag_raw_syscall(35,(&delay) as i64,0,0,0,0,0);
    _zag_print("final-out");
    _zag_eprintln("final-err");
    return 7;
}
