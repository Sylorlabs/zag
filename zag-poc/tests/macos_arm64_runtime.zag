// Native macOS arm64 acceptance fixture: entry ABI, data addresses, heap, and I/O.

@import("../std/rt.zag")

fn main() i32 {
    if (_zag_argc() != 3) { return 10; }
    if (!@strEq(_zag_arg(1), "alpha") || !@strEq(_zag_arg(2), "beta")) { return 11; }

    let value: *i32 = new(40);
    value.* = value.* + 2;
    if (value.* != 42) { return 12; }

    let path: []u8 = "/tmp/zag_macos_arm64_runtime.txt";
    if (_zag_write_file(path, "darwin-roundtrip") != 0) { return 13; }
    if (_zag_file_exists(path) == 0) { return 14; }
    let content: []u8 = _zag_read_file(path);
    if (!@strEq(content, "darwin-roundtrip")) { return 15; }
    if (_zag_exec_cmd("exit 7") != 7) { return 16; }

    let message: []u8 = _zag_str_concat("macos-arm64-", "ok");
    _zag_println(message);
    return 0;
}
