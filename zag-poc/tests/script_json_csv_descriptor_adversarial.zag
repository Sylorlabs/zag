// Dynamic JSON/CSV aggregate encoders must reject forged descriptors before
// asking ScriptContext for output storage.  Successful constructors retain a
// non-null backing pointer even when len is zero; cap=0, null data, mismatched
// lengths, and a foreign context are therefore all invalid shapes.

script;

let ints: ScriptList[i64] = json_int_array("[]");
if (json_int_array_encode(ints).len != 2) { return 1; }
// Build every valid descriptor before taking the rejection baseline.  The
// constructors below intentionally charge their backing storage to the same
// ScriptContext, so a baseline taken earlier would make unrelated successful
// construction look like allocation during forged-descriptor rejection.
let bools: ScriptList[bool] = json_bool_array("[]");
let strings: ScriptList[[]u8] = csv_first_column("");
let rows: ScriptList[ScriptList[[]u8]] = csv_rows("name\n");
let row: ScriptList[[]u8] =
    script_list_get[ScriptList[[]u8]](rows, 0);
let map: ScriptMapText = json_string_map("{}");
// Empty text payloads use the canonical zero-length slice and therefore must
// remain valid despite having no non-null data pointer.
let empty_strings: ScriptList[[]u8] = csv_first_column(",");
let empty_rows: ScriptList[ScriptList[[]u8]] = csv_rows(",");
let empty_map: ScriptMapText = json_string_map("{\"\":\"\"}");
let before: i64 = script_alloc_used();

// Descriptor forgery is intentionally an unsafe test surface.  Keep every
// raw-pointer construction in one explicit lexical block so the fixture
// exercises runtime validation without weakening edition-2027 pointer rules.
// A top-level Script statement named `unsafe` is reserved for the strict
// declaration form, so place the lexical boundary under an ordinary block.
if (true) { unsafe {
let int_cap_zero: ScriptList[i64] = ScriptList[i64]{
    .data = ints.data, .len = 0, .cap = 0,
    .context = ints.context, .failed = 0};
if (json_int_array_encode(int_cap_zero).len != 0 ||
    script_alloc_used() != before) { return 2; }
let int_null_data: ScriptList[i64] = ScriptList[i64]{
    .data = null as *i64, .len = 0, .cap = ints.cap,
    .context = ints.context, .failed = 0};
if (json_int_array_encode(int_null_data).len != 0 ||
    script_alloc_used() != before) { return 3; }
let int_len_mismatch: ScriptList[i64] = ScriptList[i64]{
    .data = ints.data, .len = ints.cap + 1, .cap = ints.cap,
    .context = ints.context, .failed = 0};
if (json_int_array_encode(int_len_mismatch).len != 0 ||
    script_alloc_used() != before) { return 4; }
let int_wrong_context: ScriptList[i64] = ScriptList[i64]{
    .data = ints.data, .len = 0, .cap = ints.cap,
    .context = null as *opaque, .failed = 0};
if (json_int_array_encode(int_wrong_context).len != 0 ||
    script_alloc_used() != before) { return 5; }
let int_cap_overflow: ScriptList[i64] = ScriptList[i64]{
    .data = ints.data, .len = 0, .cap = 1048576,
    .context = ints.context, .failed = 0};
if (script_list_append[i64](&int_cap_overflow, 1) != 0 ||
    script_alloc_used() != before) { return 15; }

let bool_null_data: ScriptList[bool] = ScriptList[bool]{
    .data = null as *bool, .len = 0, .cap = bools.cap,
    .context = bools.context, .failed = 0};
if (json_bool_array_encode(bool_null_data).len != 0 ||
    script_alloc_used() != before) { return 6; }

let string_null_data: ScriptList[[]u8] = ScriptList[[]u8]{
    .data = null as *[]u8, .len = 0, .cap = strings.cap,
    .context = strings.context, .failed = 0};
if (json_string_array_encode(string_null_data).len != 0 ||
    script_alloc_used() != before) { return 7; }

let forged_row: ScriptList[[]u8] = ScriptList[[]u8]{
    .data = row.data, .len = 0, .cap = 0,
    .context = row.context, .failed = 0};
rows.data[0] = forged_row;
if (csv_rows_encode(rows).len != 0 || script_alloc_used() != before) {
    return 8;
}

let map_cap_zero: ScriptMapText = ScriptMapText{
    .keys = map.keys, .values = map.values, .used = map.used,
    .cap = 0, .count = 0, .tombstones = 0,
    .context = map.context, .failed = 0};
if (json_string_map_encode(map_cap_zero).len != 0 ||
    script_alloc_used() != before) { return 9; }
let map_count_mismatch: ScriptMapText = ScriptMapText{
    .keys = map.keys, .values = map.values, .used = map.used,
    .cap = map.cap, .count = 1, .tombstones = 0,
    .context = map.context, .failed = 0};
if (json_string_map_encode(map_count_mismatch).len != 0 ||
    script_alloc_used() != before) { return 10; }
let map_tombstone_mismatch: ScriptMapText = ScriptMapText{
    .keys = map.keys, .values = map.values, .used = map.used,
    .cap = map.cap, .count = 0, .tombstones = 1,
    .context = map.context, .failed = 0};
if (json_string_map_encode(map_tombstone_mismatch).len != 0 ||
    script_alloc_used() != before) { return 11; }
let map_null_arrays: ScriptMapText = ScriptMapText{
    .keys = null as *[]u8, .values = map.values, .used = map.used,
    .cap = map.cap, .count = 0, .tombstones = 0,
    .context = map.context, .failed = 0};
if (json_string_map_encode(map_null_arrays).len != 0 ||
    script_alloc_used() != before) { return 12; }
let map_wrong_context: ScriptMapText = ScriptMapText{
    .keys = map.keys, .values = map.values, .used = map.used,
    .cap = map.cap, .count = 0, .tombstones = 0,
    .context = null as *opaque, .failed = 0};
if (json_string_map_encode(map_wrong_context).len != 0 ||
    script_alloc_used() != before) { return 13; }
} }
// The real empty constructors remain accepted; their output allocations are
// intentionally after the rejection-allocation assertions above.
if (json_bool_array_encode(bools).len != 2 ||
    json_string_array_encode(strings).len != 2 ||
    json_string_map_encode(map).len != 2 ||
    json_string_array_encode(empty_strings).len != 4 ||
    csv_rows_encode(empty_rows).len != 1 ||
    json_string_map_encode(empty_map).len != 7) { return 14; }
return 0;
