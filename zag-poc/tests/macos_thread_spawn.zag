// Native macOS/ARM64 spawn/join witness. Four independent pthread-backed
// workers atomically update a shared global; every affine handle is consumed
// before the parent reads the result.
global let thread_counter:i64;

fn increment_worker() void {
    unsafe {
        let p:*mut i64 = (&thread_counter) as *mut i64;
        let _old:i64 = @atomicFetchAdd64(p, 1);
    }
}

fn main() i32 {
    unsafe {
        let a:*opaque = @threadSpawn(increment_worker);
        let b:*opaque = @threadSpawn(increment_worker);
        let c:*opaque = @threadSpawn(increment_worker);
        let d:*opaque = @threadSpawn(increment_worker);
        @threadJoin(a);
        @threadJoin(b);
        @threadJoin(c);
        @threadJoin(d);
        let p:*const i64 = (&thread_counter) as *const i64;
        if (@atomicLoad64(p) == 4) { return 42; }
        return 1;
    }
}
