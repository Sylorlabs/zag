// Produce a checker-only transform envelope for the handoff regression.  This
// fixture intentionally emits no machine code and does not publish daemon
// state; the shell test supplies the semantic snapshot and compiler image that
// the foreground consumer will bind.
@import("../selfhost/parse.zag")
@import("../selfhost/sema.zag")
@import("../selfhost/zir.zag")
@import("../selfhost/zagd_profile.zag")
@import("../selfhost/zagd_transform_proposal.zag")
@import("../selfhost/native/x86_cpu_profile.zag")
@import("../selfhost/version.zag")

extern fn _zag_read_file(path:[]u8)[]u8
extern fn _zag_write_file(path:[]u8,text:[]u8)i32

fn fixture_emit()i32{
    if(_zag_argc()!=6){return 2;}
    let source_path:[]u8=_zag_arg(1);
    let semantic_path:[]u8=_zag_arg(2);
    let compiler_path:[]u8=_zag_arg(3);
    let output_path:[]u8=_zag_arg(4);
    let source_mode:[]u8=_zag_arg(5);
    let source:[]u8=_zag_read_file(source_path);
    let semantic:[]u8=_zag_read_file(semantic_path);
    let image:[]u8=_zag_read_file(compiler_path);
    if(source.len<0||semantic.len<0||image.len<0){return 3;}
    let unit:CompilationUnit=parse_compilation_unit_dir(source,dir_of(source_path));
    let effects:map.StringMap[i32]=analyze(unit.decls);
    let authority:ZirAuthority=zir_prepare_const_i32_add_source_policy_with_origins(
        unit.decls,effects,unit.origins,zir_transform_policy_const_i32_add_default());
    let profile:X86CpuProfile=parse_x86_cpu_profile("generic");
    let manifest:SemanticManifestView=semantic_manifest_decode(semantic);
    if(authority.transform_count!=1||authority.certificate.valid!=1||
       profile.valid!=1||manifest.valid!=1){return 4;}
    let cert:ZirTransformCertificate=authority.certificate;
    let source_hash:ZagdHash=zagd_content_hash(source);
    if(@strEq(source_mode,"stale")==1){source_hash=zagd_content_hash("stale-source");}
    let proposal:ZagdTransformProposal=ZagdTransformProposal{
        .rule="const-i32-add-v1",.source=source_hash,
        .semantic_identity=zagd_profile_semantic_identity(semantic,zag_version(),profile.cache_key),
        .target=zagd_content_hash(profile.cache_key),.compiler=zag_version(),
        .compiler_identity=zagd_content_hash(image),
        .function_origin=cert.function_origin.stable_id,
        .operation_origin=cert.op_origin.stable_id,
        .lhs=cert.lhs_value as i32,.rhs=cert.rhs_value as i32,
        .result=cert.result_value as i32,.valid=1};
    let encoded:[]u8=ztp_encode(proposal);
    if(encoded.len==0){return 5;}
    return _zag_write_file(output_path,encoded);
}

fn main()i32{return fixture_emit();}
