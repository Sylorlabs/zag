// Behaviour guard: through std:rt, a single > 2 GiB malloc and realloc work and
// keep their contents (both editions).
@import("std:rt")
fn main() i32 {
    let n: i64 = 2500000000;
    let p: *u8 = _zag_malloc(n) as *u8;
    p[0] = 3;
    p[n - 1] = 4;
    let q: *u8 = _zag_realloc(p as *i8, n + 4096) as *u8;
    q[n + 4095] = 5;
    let s: i64 = (q[0] as i64) + (q[n - 1] as i64) + (q[n + 4095] as i64);
    _zag_free(q as *i8);
    return s as i32;
}
