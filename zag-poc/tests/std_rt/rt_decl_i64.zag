// Declaration conformance: std/rt.zag must declare the allocator byte counts as
// i64 (the runtime contract), not i32. Reads the std source next to the tests.
fn has(hay: []u8, needle: []u8) i32 {
    let i: i32 = 0;
    while (i + needle.len <= hay.len) {
        let j: i32 = 0;
        while (j < needle.len && hay[i + j] == needle[j]) { j = j + 1; }
        if (j == needle.len) { return 1; }
        i = i + 1;
    }
    return 0;
}
fn main() i32 {
    let src: []u8 = _zag_read_file("std/rt.zag");
    let bad: i32 = 0;
    if (has(src, "extern fn _zag_malloc(n: i64) *i8") == 0) { print_str("XX _zag_malloc not declared with n: i64\n"); bad = bad + 1; }
    if (has(src, "extern fn _zag_realloc(p: *i8, n: i64) *i8") == 0) { print_str("XX _zag_realloc not declared with n: i64\n"); bad = bad + 2; }
    return bad;
}
