@import("../selfhost/std/script_json.zag") as script_json
@import("std:json") as json

extern fn _zag_script_context_init(limit:i64, capabilities:i64, execution_policy:i64) *i8
extern fn _zag_script_context_shutdown(context:*i8) void
extern fn _zag_script_alloc_used(context:*i8) i64

fn check(value: []u8, policy: i64, overhead: i64) i32 {
    let expected: json.JsonEncodeResult = json.json_stringify_string_checked(value);
    if (expected.ok != 1) { return 1; }
    let context: *i8 = _zag_script_context_init((expected.value.len as i64) + overhead, 7, policy);
    if (context == null as *i8) { return 2; }
    let words: *i64 = context as *i64;
    let result: json.JsonEncodeResult = script_json.script_json_stringify_string_bounded(
        context, value, expected.value.len);
    let ok: bool = result.ok == 1 && @strEq(result.value, expected.value) &&
        _zag_script_alloc_used(context) == (expected.value.len as i64) + overhead && words[11] == 1;
    let decoded: json.JsonStringResult = json.json_parse_string(result.value);
    ok = ok && decoded.ok == 1 && @strEq(decoded.value, value);
    json.json_string_result_free(&decoded);
    _zag_free(_zag_slice_ptr(expected.value));
    _zag_script_context_shutdown(context);
    if (!ok) { return 3; }
    return 0;
}

fn invalid(context: *i8, value: []u8) i32 {
    let words: *i64 = context as *i64;
    let result: json.JsonEncodeResult = script_json.script_json_stringify_string(context, value);
    if (result.ok != 0 || result.value.len != 0 || words[11] != 0 || words[12] != 0 ||
        _zag_script_alloc_used(context) != 0) { return 1; }
    return 0;
}

fn main() i32 {
    if (check("", 16843009, 0) != 0) { return 1; }
    if (check("a\"b\\c/", 16843009, 0) != 0) { return 2; }
    if (check("AΩ😀", 16843009, 0) != 0) { return 3; }
    if (check("", 16843010, 16) != 0) { return 4; }
    if (check("a\"b\\c/", 16843010, 16) != 0) { return 5; }
    let bytes: *u8 = _zag_malloc(256) as *u8;
    let i: i32 = 0;
    while (i < 128) { bytes[i] = i as u8; i = i + 1; }
    // Every ASCII control including embedded NUL, both special punctuation,
    // unescaped slash and DEL; compare bytes and parse back through ordinary JSON.
    if (check(bytes[0..128], 16843009, 0) != 0) { return 6; }
    if (check(bytes[0..128], 16843010, 16) != 0) { return 7; }

    let context: *i8 = _zag_script_context_init(1024, 7, 16843009);
    if (context == null as *i8) { return 8; }
    // Every non-ASCII byte is invalid alone (continuations, truncation, bad leads).
    i = 128;
    while (i < 256) {
        bytes[0] = i as u8;
        if (invalid(context, bytes[0..1]) != 0) { return 9; }
        i = i + 1;
    }
    bytes[0] = 192; bytes[1] = 128;
    if (invalid(context, bytes[0..2]) != 0) { return 10; }
    bytes[0] = 224; bytes[1] = 159; bytes[2] = 191;
    if (invalid(context, bytes[0..3]) != 0) { return 11; }
    bytes[0] = 237; bytes[1] = 160; bytes[2] = 128;
    if (invalid(context, bytes[0..3]) != 0) { return 12; }
    bytes[0] = 240; bytes[1] = 143; bytes[2] = 191; bytes[3] = 191;
    if (invalid(context, bytes[0..4]) != 0) { return 13; }
    bytes[0] = 244; bytes[1] = 144; bytes[2] = 128; bytes[3] = 128;
    if (invalid(context, bytes[0..4]) != 0) { return 14; }
    bytes[0] = 194; bytes[1] = 65;
    if (invalid(context, bytes[0..2]) != 0) { return 15; }
    // Boundary-valid encodings stay UTF-8 rather than becoming ASCII escapes.
    bytes[0] = 194; bytes[1] = 128;
    if (check(bytes[0..2], 16843009, 0) != 0) { return 16; }
    bytes[0] = 224; bytes[1] = 160; bytes[2] = 128;
    if (check(bytes[0..3], 16843009, 0) != 0) { return 17; }
    bytes[0] = 244; bytes[1] = 143; bytes[2] = 191; bytes[3] = 191;
    if (check(bytes[0..4], 16843009, 0) != 0) { return 18; }

    if (script_json.script_json_stringify_string_bounded(context, "", -1).ok != 0 ||
        script_json.script_json_stringify_string_bounded(context, "", 0).ok != 0 ||
        script_json.script_json_stringify_string_bounded(context, "", 1).ok != 0 ||
        script_json.script_json_stringify_string_bounded(context, "abc", 4).ok != 0 ||
        script_json.script_json_stringify_string_bounded(context, "\n", 3).ok != 0) { return 19; }
    bytes[0] = 0;
    if (script_json.script_json_stringify_string_bounded(context, bytes[0..1], 7).ok != 0 ||
        invalid(context, (null as *u8)[0..1]) != 0 ||
        invalid(context, bytes[0..-1]) != 0) { return 28; }
    let words: *i64 = context as *i64;
    if (words[11] != 0 || words[12] != 0) { return 20; }
    let empty: json.JsonEncodeResult = script_json.script_json_stringify_string(context, "");
    if (empty.ok != 1 || !@strEq(empty.value, "\"\"") || words[11] != 1) { return 21; }
    _zag_script_context_shutdown(context);
    if (script_json.script_json_stringify_string(null as *i8, "").ok != 0) { return 22; }

    // Allocation rejection is typed, does not charge bytes, and permits retry.
    let short: *i8 = _zag_script_context_init(3, 7, 16843009);
    if (short == null as *i8) { return 23; }
    let denied: json.JsonEncodeResult = script_json.script_json_stringify_string(short, "\n");
    let short_words: *i64 = short as *i64;
    if (denied.ok != 0 || denied.value.len != 0 || _zag_script_alloc_used(short) != 0 ||
        short_words[11] != 0 || short_words[12] != 1) { return 24; }
    if (script_json.script_json_stringify_string(short, "a").ok != 1 ||
        script_json.script_json_stringify_string(short, "").ok != 0 ||
        _zag_script_alloc_used(short) != 3 || short_words[11] != 1) { return 25; }
    _zag_script_context_shutdown(short);
    let heap: *i8 = _zag_script_context_init(17, 7, 16843010);
    if (heap == null as *i8) { return 26; }
    if (script_json.script_json_stringify_string(heap, "").ok != 0 ||
        _zag_script_alloc_used(heap) != 0) { return 27; }
    _zag_script_context_shutdown(heap);
    _zag_free(bytes as *i8);
    return 0;
}
