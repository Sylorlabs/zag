@import("../selfhost/zagd_profile.zag")
@import("../selfhost/version.zag")

extern fn _zag_read_file(path:[]u8)[]u8

// Consume the daemon's actual candidates.record with the same foreground
// inputs used by znc. This remains metadata-only: a valid result reports a
// checked advisory and never supplies a rewrite or machine-code authority.
fn main()i32{
    if(_zag_argc()!=5){return 2;}
    let candidate:[]u8=_zag_read_file(_zag_arg(1));
    let semantic:[]u8=_zag_read_file(_zag_arg(2));
    let compiler:[]u8=_zag_read_file(_zag_arg(3));
    let target:[]u8=_zag_arg(4);
    let identity:ZagdHash=zagd_content_hash(compiler);
    let use:ZagdForegroundCandidateUse=zagd_foreground_candidate_consume(
        candidate,semantic,zag_version(),identity,target);
    if(use.valid==1&&use.metadata_consumed==1&&use.candidate_kind==51&&
       use.reason.len>0){
        _zag_println("zagd candidate integration: PASS");return 0;
    }
    _zag_print("zagd candidate integration: FAIL ");_zag_println(use.reason);
    return 1;
}
