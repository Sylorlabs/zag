// Integration verifier for files emitted by the real znc CLI. SHA pins come
// from the shell's independent oracle before any mutation. No shell hashing,
// compiler driver, or receipt issuance API is used by this verifier.
@import("../selfhost/artifact_provenance.zag")
@import("../selfhost/content_addressed_build.zag")

fn nev_check(ok: i32, label: []u8, failures: *i32) void {
    if (ok != 1) {
        _zag_eprintln(label);
        failures.* = failures.* + 1;
    }
}

fn nev_read(root: []u8, suffix: []u8) []u8 {
    let path: []u8 = _zag_str_concat(root, suffix);
    let bytes: []u8 = _zag_read_file(path);
    _zag_str_free(path);
    return bytes;
}

fn nev_free(bytes: []u8) void {
    if (bytes.len >= 0) { _zag_free(_zag_slice_ptr(bytes)); }
}

fn nev_path(fields: *ArrayList[[]u8], root: []u8, suffix: []u8) void {
    push[[]u8](fields, _zag_str_concat(root, suffix));
}

fn main() i32 {
    if (_zag_argc() != 9) {
        _zag_eprintln("usage: verify work compiler compiler-sha receipt-sha provenance-sha artifact-sha target valid|tampered-artifact|mismatched-store");
        return 2;
    }
    let root: []u8 = _zag_arg(1);
    let compiler_pin: []u8 = _zag_arg(3);
    let receipt_pin: []u8 = _zag_arg(4);
    let provenance_pin: []u8 = _zag_arg(5);
    let artifact_pin: []u8 = _zag_arg(6);
    let target: []u8 = _zag_arg(7);
    let mode: []u8 = _zag_arg(8);
    let artifact_ok: i32 = 1;
    let store_ok: i32 = 1;
    if (@strEq(mode, "tampered-artifact")) { artifact_ok = 0; }
    else if (@strEq(mode, "mismatched-store")) { store_ok = 0; }
    else if (!@strEq(mode, "valid")) { return 2; }

    let failures: i32 = 0;
    let compiler: []u8 = _zag_read_file(_zag_arg(2));
    let artifact: []u8 = nev_read(root, "/program");
    let receipt: []u8 = nev_read(root, "/receipt.ev");
    let source: []u8 = nev_read(root, "/receipt.ev.inputs");
    let provenance: []u8 = nev_read(root, "/receipt.ev.provenance");
    let closure: []u8 = nev_read(root, "/closure");
    let store_suffix: []u8 = _zag_str_concat("/store/", artifact_pin);
    let stored: []u8 = nev_read(root, store_suffix);
    _zag_str_free(store_suffix);
    nev_check(compiler.len > 0 && artifact.len > 0 && receipt.len > 0 &&
        source.len > 0 && provenance.len > 0 && closure.len > 0 && stored.len > 0,
        "FAIL: required compiler/evidence/artifact file missing or empty", &failures);
    nev_check(ev_matches(compiler, compiler_pin), "FAIL: actual compiler identity", &failures);
    nev_check(ev_matches(artifact, artifact_pin) == artifact_ok, "FAIL: actual artifact identity", &failures);
    nev_check(ev_matches(stored, artifact_pin) == store_ok, "FAIL: content-store identity", &failures);
    if (artifact_ok == 1 && store_ok == 1) {
        nev_check(ev_equal(artifact, stored), "FAIL: artifact and stored image bytes differ", &failures);
    }

    let inputs: BuildReceiptInputs = BuildReceiptInputs{.source=source,
        .compiler=compiler,.target=target,.artifact=artifact,.provenance=provenance};
    nev_check(content_build_receipt_verify(receipt, receipt_pin, inputs, compiler_pin) == artifact_ok,
        "FAIL: receipt verification against actual compiler and artifact", &failures);
    nev_check(artifact_provenance_verify(provenance, provenance_pin, artifact, compiler) == artifact_ok,
        "FAIL: provenance verification against actual compiler and artifact", &failures);
    inputs.artifact = stored;
    nev_check(content_build_receipt_verify(receipt, receipt_pin, inputs, compiler_pin) == store_ok,
        "FAIL: receipt verification against content-store bytes", &failures);
    nev_check(artifact_provenance_verify(provenance, provenance_pin, stored, compiler) == store_ok,
        "FAIL: provenance verification against content-store bytes", &failures);

    // The receipt's source is the whole native input envelope, not main.zag.
    let record: EvidenceRecord = ev_decode(receipt, receipt_pin);
    let envelope: EvidenceRecord = ev_decode(source, ev_get(record, 1));
    let expected: ArrayList[[]u8] = make[[]u8](20);
    ev_add(&expected, "zag-native-build-inputs-v1");
    ev_add(&expected, target);
    ev_add(&expected, closure);
    nev_path(&expected, root, "/project/.zagd.conf");
    ev_add(&expected, "absent"); ev_add(&expected, "");
    nev_path(&expected, root, "/project/main.zag");
    ev_add(&expected, "-o"); nev_path(&expected, root, "/program");
    ev_add(&expected, "--build-receipt"); nev_path(&expected, root, "/receipt.ev");
    ev_add(&expected, "--compiler-pin"); ev_add(&expected, compiler_pin);
    ev_add(&expected, "--content-store"); nev_path(&expected, root, "/store");
    ev_add(&expected, "--no-zagd"); ev_add(&expected, "--no-foreground-cache");
    ev_add(&expected, "--no-analyze"); ev_add(&expected, "--target");
    let cli_target: []u8 = target;
    if (@strEq(target, "linux-arm64")) { cli_target = "arm64"; }
    if (@strEq(target, "linux-x86_64")) { cli_target = "x86-64"; }
    ev_add(&expected, cli_target);
    nev_check(record.valid == 1 && envelope.valid == 1 && envelope.fields.len == expected.len,
        "FAIL: native-build-inputs schema/field count", &failures);
    let i: i32 = 0;
    while (i < expected.len) {
        nev_check(ev_equal(ev_get(envelope, i), expected.data[i]),
            "FAIL: native-build-inputs closure/config/invocation field", &failures);
        i = i + 1;
    }

    let origin: EvidenceRecord = ev_decode(provenance, provenance_pin);
    nev_check(origin.valid == 1 && origin.fields.len == 16 &&
        ev_equal(ev_get(origin, 2), "znc") == 1 &&
        ev_equal(ev_get(origin, 3), compiler_pin) == 1 &&
        ev_equal(ev_get(origin, 4), "synthetic") == 1 &&
        ev_equal(ev_get(origin, 5), "1") == 1 &&
        ev_equal(ev_get(origin, 6), "compiler-input-snapshot") == 1 &&
        ev_matches(source, ev_get(origin, 7)) == 1 &&
        ev_matches(source, ev_get(origin, 8)) == 1 &&
        ev_equal(ev_get(origin, 9), "synthetic") == 1 &&
        ev_equal(ev_get(origin, 10), "1") == 1 &&
        ev_equal(ev_get(origin, 11), "znc") == 1 &&
        ev_equal(ev_get(origin, 12), "content-store") == 1 &&
        ev_equal(ev_get(origin, 13), "native-build") == 1,
        "FAIL: synthetic compiler-input provenance and native-build custody", &failures);

    ev_fields_free(&origin.fields); ev_fields_free(&record.fields);
    ev_fields_free(&envelope.fields); ev_fields_free(&expected);
    nev_free(compiler); nev_free(artifact); nev_free(receipt); nev_free(source);
    nev_free(provenance); nev_free(closure); nev_free(stored);
    if (failures != 0) { return 1; }
    _zag_println("native evidence verification: PASS");
    return 0;
}
