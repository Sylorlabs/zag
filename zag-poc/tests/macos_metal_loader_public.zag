// Public std:metal_loader native compute/readback and lifecycle witness.
@import("std:metal_loader") as metal

extern fn _zag_malloc(bytes:i64) *u8;
extern fn _zag_free(value:*u8) void;

struct MetalOutput4 {
    a:i32,
    b:i32,
    c:i32,
    d:i32,
}

fn main() i32 {
    let source:[]u8="#include <metal_stdlib>\nusing namespace metal;\nkernel void zag_fill(device int *out [[buffer(0)]], constant int &value [[buffer(1)]], constant int &count [[buffer(2)]], uint id [[thread_position_in_grid]]) { if (id < count) { out[id] = value; } }\n\x00";
    let kernel:[]u8="zag_fill\x00";
    if (!metal.zag_metal_compat_available()) { return 9; }
    let ctx:metal.ZagMetalCompatContext=metal.zag_metal_compat_open();
    if (!metal.zag_metal_compat_is_open(&ctx)) { return 1; }

    let capabilities:metal.ZagMetalCompatCapabilities=
        metal.zag_metal_compat_capabilities(&ctx);
    if (!capabilities.available || !capabilities.command_queue ||
        !capabilities.unified_memory || capabilities.registry_id==0 ||
        capabilities.max_buffer_length<4096) {
        metal.zag_metal_compat_close(&ctx);
        return 10;
    }
    let memory:metal.ZagMetalMemoryResult=
        metal.zag_metal_compat_memory_roundtrip(&ctx,4096);
    if (!memory.ok || !memory.exact_readback || !memory.release_issued ||
        memory.error_code!=metal.zag_metal_status_ok()) {
        metal.zag_metal_compat_close(&ctx);
        return 11;
    }
    let wrong_memory:metal.ZagMetalMemoryResult=
        metal.zag_metal_compat_memory_roundtrip(&ctx,2048);
    if (wrong_memory.ok ||
        wrong_memory.error_code!=metal.zag_metal_status_invalid_argument()) {
        metal.zag_metal_compat_close(&ctx);
        return 12;
    }

    let output:MetalOutput4=MetalOutput4{.a=0,.b=0,.c=0,.d=0};
    let rc:i32=metal.zag_metal_compat_dispatch_source(&ctx,source,kernel,
        (&output.a) as *i32,4,42,4,4,1,1,0);
    if (rc!=metal.zag_metal_status_ok()) {
        metal.zag_metal_compat_close(&ctx);
        return 2;
    }
    if (output.a!=42 || output.b!=42 || output.c!=42 || output.d!=42) {
        metal.zag_metal_compat_close(&ctx);
        return 3;
    }

    let signed_rc:i32=metal.zag_metal_compat_dispatch_source(&ctx,source,
        kernel,(&output.a) as *i32,4,0-7,4,4,1,1,0);
    if (signed_rc!=metal.zag_metal_status_ok() || output.a!=0-7 ||
        output.b!=0-7 || output.c!=0-7 || output.d!=0-7) {
        metal.zag_metal_compat_close(&ctx);
        return 8;
    }

    // Match the reference compatibility-runtime envelope used by the Linux
    // Vulkan/OpenGL/OpenCL gates: 1024 work items and exact checked readback.
    let full_storage:*u8=_zag_malloc(8192);
    if (full_storage==null as *u8) {
        metal.zag_metal_compat_close(&ctx);
        return 13;
    }
    let full_output:*i32=full_storage as *i32;
    let full_rc:i32=metal.zag_metal_compat_dispatch_source(&ctx,source,kernel,
        full_output,1024,42,1024,1024,1,1,0);
    if (full_rc!=metal.zag_metal_status_ok()) {
        _zag_free(full_storage);
        metal.zag_metal_compat_close(&ctx);
        return 14;
    }
    let full_i:i32=0;
    while (full_i<1024) {
        if (full_output[full_i]!=42) {
            _zag_free(full_storage);
            metal.zag_metal_compat_close(&ctx);
            return 15;
        }
        full_i=full_i+1;
    }
    _zag_free(full_storage);

    // Work and timeout contracts fail closed before command submission.
    let over_limit:i32=metal.zag_metal_compat_dispatch_source(&ctx,source,kernel,
        (&output.a) as *i32,4,42,4,1048576,2,1,0);
    if (over_limit!=metal.zag_metal_status_limit()) {
        metal.zag_metal_compat_close(&ctx);
        return 4;
    }
    let unsupported_timeout:i32=metal.zag_metal_compat_dispatch_source(
        &ctx,source,kernel,(&output.a) as *i32,4,42,4,4,1,1,1);
    if (unsupported_timeout!=metal.zag_metal_status_invalid_argument()) {
        metal.zag_metal_compat_close(&ctx);
        return 5;
    }

    metal.zag_metal_compat_close(&ctx);
    if (metal.zag_metal_compat_is_open(&ctx)) { return 6; }
    let after_close:i32=metal.zag_metal_compat_dispatch_source(&ctx,
        source,kernel,(&output.a) as *i32,4,42,4,4,1,1,0);
    if (after_close!=metal.zag_metal_status_unavailable()) { return 7; }
    return 42;
}
