@import("../std/rt.zag")

// Compatibility spellings remain reachable in the native runtime even though
// std/rt.zag exposes the canonical names.
extern fn _zag_str_len(s: []u8) i32;
extern fn _zag_str_eq(a: []u8, b: []u8) i32;
extern fn _zag_allocator_allocation_count() i64;
extern fn _zag_allocator_live_bytes() i64;

fn memory_contract() i32 {
    // Zero and negative counts must not dereference either pointer.
    _zag_memcpy(null as *i8, null as *i8, 0);
    _zag_memcpy(null as *i8, null as *i8, 0 - 1);
    if (_zag_memcmp(null as *i8, null as *i8, 0) != 0) { return 1; }
    if (_zag_memcmp(null as *i8, null as *i8, 0 - 1) != 0) { return 2; }

    let src: *i8 = _zag_malloc(48);
    let dst: *i8 = _zag_malloc(48);
    let su: *u8 = src as *u8;
    let du: *u8 = dst as *u8;
    let i: i32 = 0;
    while (i < 48) {
        su[i] = ((i * 7 + 3) % 251) as u8;
        du[i] = 170 as u8;
        i = i + 1;
    }
    // Unaligned 35-byte copy crosses the x86 vector/word/tail boundaries.
    _zag_memcpy(dst + 1, src + 2, 35);
    if (du[0] != 170 as u8 || du[36] != 170 as u8) { return 3; }
    if (_zag_memcmp(dst + 1, src + 2, 35) != 0) { return 4; }
    du[18] = du[18] + 1;
    if (_zag_memcmp(dst + 1, src + 2, 35) != 1) { return 5; }
    du[18] = su[19];
    su[19] = 255 as u8;
    du[18] = 1 as u8;
    if (_zag_memcmp(dst + 1, src + 2, 35) != 0 - 254) { return 6; }
    _zag_free(src);
    _zag_free(dst);
    return 0;
}

fn string_contract() i32 {
    if (_zag_strlen("a\0b") != 3 || _zag_str_len("a\0b") != 3) { return 7; }
    if (_zag_strcmp("same", "same") != 1 || _zag_str_eq("same", "same") != 1) { return 8; }
    if (_zag_strcmp("same", "different") != 0 || _zag_str_eq("same", "different") != 0) { return 9; }
    if (_zag_strcmp_ord("", "") != 0) { return 10; }
    if (_zag_strcmp_ord("a", "aa") != 0 - 1) { return 11; }
    if (_zag_strcmp_ord("aa", "a") != 1) { return 12; }
    if (_zag_strcmp_ord("\xff", "\x01") != 254) { return 13; }
    if (_zag_str_index_of_byte("abca", 'a' as i32) != 0) { return 14; }
    if (_zag_str_index_of_byte("abca", 'z' as i32) != 0 - 1) { return 15; }
    if (_zag_str_index_of_byte("", 'a' as i32) != 0 - 1) { return 16; }
    if (_zag_str_index_of_byte("\xff", 0 - 1) != 0) { return 17; }
    if (_zag_str_index_of_byte("\xff", 511) != 0) { return 18; }

    let before_live: i64 = _zag_allocator_live_bytes();
    let empty_before_count: i64 = _zag_allocator_allocation_count();
    let empty_copy: []u8 = _zag_strdup("");
    if (empty_copy.len != 0 || _zag_slice_ptr(empty_copy) == null as *i8) { return 43; }
    if (_zag_allocator_allocation_count() - empty_before_count != 2) { return 44; }
    if (_zag_allocator_live_bytes() != before_live) { return 45; }
    _zag_str_free(empty_copy);
    if (_zag_allocator_live_bytes() != before_live) { return 46; }

    let before_count: i64 = _zag_allocator_allocation_count();
    let copy: []u8 = _zag_strdup("a\0z");
    if (copy.len != 3 || copy[0] != 'a' || copy[1] != 0 || copy[2] != 'z') { return 19; }
    copy[0] = 'b';
    if (copy[0] != 'b') { return 20; }
    if (_zag_allocator_live_bytes() - before_live != 3) { return 21; }
    if (_zag_allocator_allocation_count() - before_count != 2) { return 22; }
    _zag_str_free(copy);
    if (_zag_allocator_live_bytes() != before_live) { return 23; }
    return 0;
}

fn unsigned_format_contract() i32 {
    let before_live: i64 = _zag_allocator_live_bytes();
    let before_count: i64 = _zag_allocator_allocation_count();
    let zero: []u8 = _zag_u64_to_str(0 as u64);
    let max_word: []u8 = _zag_u64_to_str((0 - 1) as u64);
    let sign_bit: []u8 = _zag_u64_to_str((0 - 9223372036854775807 - 1) as u64);
    if (_zag_strcmp(zero, "0") != 1) { return 24; }
    // RT_U2S currently shares x86's signed peel for high-bit values. These
    // cases intentionally lock target parity rather than silently widening it.
    if (_zag_strcmp(max_word, "-1") != 1) { return 25; }
    if (_zag_strcmp(sign_bit, "-9223372036854775808") != 1) { return 26; }
    if (_zag_allocator_live_bytes() - before_live != zero.len + max_word.len + sign_bit.len) { return 27; }
    if (_zag_allocator_allocation_count() - before_count != 6) { return 28; }
    _zag_str_free(zero);
    _zag_str_free(max_word);
    _zag_str_free(sign_bit);
    if (_zag_allocator_live_bytes() != before_live) { return 29; }
    return 0;
}

fn environment_contract() i32 {
    let before_live: i64 = _zag_allocator_live_bytes();
    let before_count: i64 = _zag_allocator_allocation_count();
    let value: []u8 = _zag_getenv("ZAG_ARM64_RT_VALUE");
    let empty: []u8 = _zag_getenv("ZAG_ARM64_RT_EMPTY");
    let missing: []u8 = _zag_getenv("ZAG_ARM64_RT_MISSING_7F19");
    if (_zag_strcmp(value, "arm64=value") != 1) { return 30; }
    if (empty.len != 0 || _zag_slice_ptr(empty) == null as *i8) { return 31; }
    if (missing.len != 0 || _zag_slice_ptr(missing) != null as *i8) { return 32; }
    // Each borrowed result uses and immediately retires one descriptor.
    if (_zag_allocator_allocation_count() - before_count != 3) { return 33; }
    if (_zag_allocator_live_bytes() != before_live) { return 34; }
    return 0;
}

fn capture_contract() i32 {
    let before_live: i64 = _zag_allocator_live_bytes();
    let small: []u8 = _zag_exec_capture("printf 'a\\000b'");
    if (small.len != 3 || small[0] != 'a' || small[1] != 0 || small[2] != 'b') { return 35; }
    if (_zag_allocator_live_bytes() - before_live != 65536) { return 36; }
    _zag_str_free(small);
    if (_zag_allocator_live_bytes() != before_live) { return 37; }

    // 65,537 bytes forces the exact full-buffer boundary and one realloc.
    let large: []u8 = _zag_exec_capture("awk 'BEGIN { for (i = 0; i < 65537; i++) printf \"x\" }'");
    if (large.len != 65537 || large[0] != 'x' || large[65536] != 'x') { return 38; }
    if (_zag_allocator_live_bytes() - before_live != 131072) { return 39; }
    _zag_str_free(large);
    if (_zag_allocator_live_bytes() != before_live) { return 40; }
    return 0;
}

fn main() i32 {
    let status: i32 = memory_contract();
    if (status != 0) { return status; }
    status = string_contract();
    if (status != 0) { return status; }
    status = unsigned_format_contract();
    if (status != 0) { return status; }
    status = environment_contract();
    if (status != 0) { return status; }
    status = capture_contract();
    if (status != 0) { return status; }
    return 42;
}
