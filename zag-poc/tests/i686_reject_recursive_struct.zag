// A by-value cycle has no finite sequential layout and must fail before ELF32
// output. Pointer indirection is the future representation-safe escape hatch;
// the current pointer subset intentionally does not accept *CycleA.
struct CycleA { b:CycleB }
struct CycleB { a:CycleA }

fn bounce(value:CycleA) CycleA { return value; }
fn main() i32 { return 0; }
