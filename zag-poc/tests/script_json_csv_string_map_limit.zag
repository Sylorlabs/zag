// Script JSON string-map copy failure remains a failed, context-owned
// descriptor when the bounded Script budget has no room for map storage.

script;

let reserve: *i8 = script_alloc(1048576);
if (reserve == null as *i8) { return 1; }
let values: ScriptMapText = json_string_map("{\"name\":\"zag\"}");
if (text_map_len(values) != 0) { return 2; }
return 0;
