struct FinalistReferenceDelayTimespec { sec:i64, nsec:i64 }

fn main()i32{
    // Deliberately slower reference with the same public behavior as the
    // witness finalist.  The daemon still proves output/stderr/exit equality;
    // this fixture only makes the measured winner path deterministic.
    let delay:FinalistReferenceDelayTimespec=FinalistReferenceDelayTimespec{.sec=0,.nsec=20000000};
    let _slept:i64=_zag_raw_syscall(35,(&delay) as i64,0,0,0,0,0);
    _zag_print("final-out");
    _zag_eprintln("final-err");
    return 7;
}
