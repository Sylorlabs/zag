@import("../selfhost/native/aarch64.zag")
@import("../selfhost/native/aisa.zag")

fn word_is(code: ArrayList[u8], offset: i32,
           b0: i32, b1: i32, b2: i32, b3: i32) bool {
    return code.data[offset] == b0 as u8 &&
        code.data[offset + 1] == b1 as u8 &&
        code.data[offset + 2] == b2 as u8 &&
        code.data[offset + 3] == b3 as u8;
}

fn main() i32 {
    let program: ArrayList[AInstr] = make[AInstr](8);
    push[AInstr](&program, ai_vloadq(0, A_X10(), 0));
    push[AInstr](&program, ai_vstoreq(A_X29(), 0, 0));
    push[AInstr](&program, ai_veor(0, 1));
    push[AInstr](&program, ai_vand(0, 1));
    push[AInstr](&program, ai_vorr(0, 1));
    push[AInstr](&program, ai_vcnt(0, 0));
    push[AInstr](&program, ai_vaddv_b(0, 0));
    push[AInstr](&program, ai_vumov_b(A_X9(), 0));
    let code: ArrayList[u8] = aencode(program);
    if (code.len != 32 ||
        !word_is(code, 0, 64, 1, 192, 61) ||
        !word_is(code, 4, 160, 3, 128, 61) ||
        !word_is(code, 8, 0, 28, 33, 110) ||
        !word_is(code, 12, 0, 28, 33, 78) ||
        !word_is(code, 16, 0, 28, 161, 78) ||
        !word_is(code, 20, 0, 88, 32, 78) ||
        !word_is(code, 24, 0, 184, 49, 78) ||
        !word_is(code, 28, 9, 60, 1, 14)) {
        return 1;
    }
    free[u8](&code);
    free[AInstr](&program);
    return 42;
}
