struct WidePacket {
    unsigned_value:u64,
    signed_value:i64,
    tag:i32,
}

extern fn external_wide_mix(a:u64, b:i64, c:i32) u64;
extern fn external_wide_product(a:u64, b:u64) u64;
extern fn external_signed_divmod(a:i64, b:i64) i64;
extern fn transform_wide_packet(packet:WidePacket, delta:u64) WidePacket;

fn main() i32 {
    let mixed:u64=external_wide_mix(4294967295,-2,9);
    if (mixed!=4294967302) { return 1; }
    if (external_wide_product(4294967297,4294967297)!=8589934593) { return 5; }
    if (external_signed_divmod(-100,7)!=-16) { return 6; }

    let input:WidePacket=WidePacket{
        .unsigned_value=4294967295,
        .signed_value=-4294967296,
        .tag=7,
    };
    let output:WidePacket=transform_wide_packet(input,2);
    if (output.unsigned_value!=4294967297) { return 2; }
    if (output.signed_value!=-4294967294) { return 3; }
    if (output.tag!=42) { return 4; }
    return 42;
}
