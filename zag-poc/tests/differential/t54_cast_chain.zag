fn main() i32 {
    let a: i32 = 300;
    let b: u8 = a as u8;               // 44
    let c: i64 = (b as i32) as i64;    // 44
    let d: f64 = c as f64;             // 44.0
    let e: i32 = (d / 2.0) as i32;     // 22
    print_int(b as i64); print_int(c); print_int(e as i64);
    return e + 20;
}
