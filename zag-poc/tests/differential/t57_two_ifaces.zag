interface A { fn fa(self) i32; }
interface B { fn fb(self) i32; }
struct S { v: i32 }
fn (self: S) fa() i32 { return self.v; }
fn (self: S) fb() i32 { return self.v * 2; }
fn ua(a: A) i32 { return a.fa(); }
fn ub(b: B) i32 { return b.fb(); }
fn main() i32 { let s: S = S{ .v = 14 }; return ua(s) + ub(s); }
