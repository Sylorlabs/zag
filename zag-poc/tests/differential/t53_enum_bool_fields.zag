enum Mode { off, on, auto }
struct Cfg { mode: Mode, live: bool, n: i32 }
fn main() i32 {
    let c: Cfg = Cfg{ .mode = Mode.auto, .live = true, .n = 40 };
    let s: i32 = 0;
    switch (c.mode) { .off => { s = 1; } .on => { s = 2; } .auto => { s = c.n; } }
    if (c.live) { return s + 2; }
    return 0;
}
