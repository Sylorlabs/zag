interface Sink { fn put(self, v: i32) i32; }
struct Acc { total: i32 }
fn (self: Acc) put(v: i32) i32 { self.total = self.total + v; return self.total; }
fn feed(s: Sink) i32 { let a: i32 = s.put(10); let b: i32 = s.put(30); return b; }
fn main() i32 {
    let acc: Acc = Acc{ .total = 2 };
    return feed(acc);      // dispatch shares data ptr: 12 then 42
}
