error { A, B }
fn f(x: i32) !i32 { if (x == 1) { return error.A; } if (x == 2) { return error.B; } return x * 2; }
fn g(x: i32) !i32 { let v: i32 = try f(x); return v + 1; }
fn main() i32 {
    let a: i32 = g(5) catch 0 - 1;    // 11
    let b: i32 = g(1) catch |e| e;    // code of A
    let c: i32 = g(2) catch |e| e;    // code of B
    print_int(a); print_int(b); print_int(c);
    if (b != c && b > 0 && c > 0) { return 0; }
    return 1;
}
