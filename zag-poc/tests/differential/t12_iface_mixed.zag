interface Op { fn apply(self, x: i32) i32; }
struct AddN { n: i32 }
fn (self: AddN) apply(x: i32) i32 { return x + self.n; }
struct MulN { n: i32 }
fn (self: MulN) apply(x: i32) i32 { return x * self.n; }
fn run(o: Op, x: i32) i32 { return o.apply(x); }
fn main() i32 {
    let a: AddN = AddN{ .n = 2 };
    let m: MulN = MulN{ .n = 4 };
    return run(a, 10) + run(m, 10) - 10;    // 12 + 40 - 10 = 42
}
