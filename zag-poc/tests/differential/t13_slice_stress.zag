fn main() i32 {
    let s: []u8 = "abcdefgh";
    let t: []u8 = s[0..0];               // empty slice
    let u: []u8 = s[8..];                // empty tail
    let v: []u8 = s[2..7];
    let w: []u8 = v[1..3];               // subslice of subslice: "de"
    print_int(t.len); print_int(u.len);
    print_int(w.len); print_int(w[0] as i64);
    return 0;
}
