fn main() i32 {
    let a: i32 = 1;
    let b: i32 = a << 5;               // 32
    let c: i32 = (0 - 32) >> 2;        // arithmetic: -8
    let d: i32 = 255 & 15;             // 15
    let e: i32 = 8 | 3;                // 11
    let f: i32 = 12 ^ 10;              // 6
    print_int(b); print_int(c); print_int(d); print_int(e); print_int(f);
    return 0;
}
