fn main() i32 {
    let a: f64 = 0.1;
    let b: f64 = 0.2;
    print_f64(a + b);              // 0.3 (%g rounding)
    print_f64(1.0 / 3.0);
    print_f64(0.0 - 0.0);
    let big: f64 = 123456789.0;
    print_f64(big * big);
    let n: i64 = 9007199254740992;   // 2^53
    print_f64(n as f64);
    return ((a + b) * 10.0) as i32;  // 2 (trunc) or 3? trunc(2.9999...) = 2
}
