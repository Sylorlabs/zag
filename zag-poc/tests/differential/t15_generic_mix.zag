@import("../../std/list.zag")
struct Pair { a: i32, b: i32 }
fn sum_pairs(xs: ArrayList[Pair]) i32 {
    let s: i32 = 0;
    let i: i32 = 0;
    while (i < len[Pair](xs)) {
        let p: Pair = get[Pair](xs, i);
        s = s + p.a + p.b;
        i = i + 1;
    }
    return s;
}
fn main() i32 {
    let xs: ArrayList[Pair] = make[Pair](1);
    let i: i32 = 0;
    while (i < 20) { push[Pair](&xs, Pair{ .a = i, .b = 1 }); i = i + 1; }
    return sum_pairs(xs) - 168;    // 190+20-168 = 42
}
