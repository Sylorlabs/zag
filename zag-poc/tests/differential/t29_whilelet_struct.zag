struct N { v: i32, next: ?i32 }
fn step(k: i32) ?N { if (k > 3) { return null; } return N{ .v = k * 10, .next = k + 1 }; }
fn main() i32 {
    let cur: ?N = step(1);
    let s: i32 = 0;
    while (cur) |n| {
        s = s + n.v;
        let nx: i32 = n.next orelse 99;
        cur = step(nx);
    }
    return s - 18;    // 10+20+30 = 60 → 42
}
