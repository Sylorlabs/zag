fn cls(x: i32) i32 {
    if (x < 10) { let y: i32 = 1; return y; }
    else if (x < 20) { let y: i32 = 2; return y; }
    else if (x < 30) { let y: i32 = 3; return y; }
    else if (x < 40) { let y: i32 = 4; return y; }
    else { let y: i32 = 5; return y; }
}
fn main() i32 { return cls(5) + cls(15) + cls(25) + cls(35) + cls(99) * 5 + 2; }
