// Unsigned integers: the x86-64 and arm64 backends must produce IDENTICAL
// output. Signed condition codes / SDIV / signed decimal printing diverge on
// values whose top bit is set, which this fixture pins down per operation.
fn main() i32 {
    let top: u64 = (1 as u64) << 63;
    let one: u64 = 1;

    print_u64(top);
    if (top > one) { print_u64(1); } else { print_u64(0); }
    if (top >= one) { print_u64(1); } else { print_u64(0); }
    if (top < one) { print_u64(1); } else { print_u64(0); }
    if (one <= top) { print_u64(1); } else { print_u64(0); }

    print_u64(top / one);
    print_u64(top / 2);
    print_u64(top % 3);
    print_u64(((1 as u64) << 63) >> 1);

    let max: u64 = 18446744073709551615;
    print_u64(max);
    print_u64(max / 2);
    print_u64(max % 10);

    // Comptime literal on the LEFT adopts the u64 operand's signedness.
    if (1 < top) { print_u64(1); } else { print_u64(0); }
    if (0 < top) { print_u64(1); } else { print_u64(0); }
    print_u64(1 / max);
    print_u64(1 % max);

    // Literal-only operands above i64::MAX are u64 by construction.
    print_u64(18446744073709551615 / 2);
    print_u64(18446744073709551615 % 10);
    if (9223372036854775808 > 9223372036854775807) { print_u64(1); } else { print_u64(0); }

    let wide: u32 = 4000000000;
    print_u64(wide as u64);
    if (wide > 1) { print_u64(1); } else { print_u64(0); }

    return 0;
}
