@import("../../std/list.zag")
fn main() i32 {
    let xs: ArrayList[?i32] = make[?i32](2);
    push[?i32](&xs, 40);
    push[?i32](&xs, null);
    push[?i32](&xs, 2);
    let s: i32 = 0;
    let i: i32 = 0;
    while (i < len[?i32](xs)) {
        let o: ?i32 = get[?i32](xs, i);
        s = s + (o orelse 0);
        i = i + 1;
    }
    return s;
}
