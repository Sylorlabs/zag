fn main() i32 {
    let k: i32 = 1;
    let f: fn(i32, i32, i32, i32, i32, i32, i32) i32 =
        fn[k](a: i32, b: i32, c: i32, d: i32, e: i32, g: i32, h: i32) i32 {
            return a + b*2 + c*3 + d*4 + e*5 + g*6 + h*7 + k;
        };
    return f(1, 1, 1, 1, 1, 1, 1) + 13;   // 28+1+13 = 42
}
