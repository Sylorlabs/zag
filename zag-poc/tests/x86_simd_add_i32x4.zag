// Four unaligned i32 lanes exercise the only user-visible packed-SIMD v2
// operation.  The operation is intentionally raw-pointer based: Zag does not
// claim a general vector value ABI yet.

fn main() i32 {
    unsafe {
    // Reserve trailing lanes so checked bounds instrumentation proves the
    // complete sixteen-byte vector access, rather than allocator rounding.
    // Zag's ordinary scalar layout is word-stride. SIMD lanes instead use a
    // deliberately explicit packed sixteen-byte raw region, initialized and
    // inspected through byte pointers before casting at the SIMD boundary.
    let lhs:*u8 = _zag_malloc(32) as *u8;
    let rhs:*u8 = _zag_malloc(32) as *u8;
    lhs[0]=1; lhs[1]=0; lhs[2]=0; lhs[3]=0;
    lhs[4]=20; lhs[5]=0; lhs[6]=0; lhs[7]=0;
    lhs[8]=44; lhs[9]=1; lhs[10]=0; lhs[11]=0;
    lhs[12]=160; lhs[13]=15; lhs[14]=0; lhs[15]=0;
    rhs[0]=7; rhs[1]=0; rhs[2]=0; rhs[3]=0;
    rhs[4]=30; rhs[5]=0; rhs[6]=0; rhs[7]=0;
    rhs[8]=40; rhs[9]=0; rhs[10]=0; rhs[11]=0;
    rhs[12]=244; rhs[13]=1; rhs[14]=0; rhs[15]=0;
    @simdAddI32x4(lhs as *mut i32,
                  lhs as *const i32,
                  rhs as *const i32);
    if (lhs[0] != 8) { return 10; }
    if (lhs[4] != 50) { return 11; }
    if (lhs[8] != 84 || lhs[9] != 1) { return 12; }
    if (lhs[12] != 148 || lhs[13] != 17) { return 13; }
    _zag_free(lhs);
    _zag_free(rhs);
    return 0;
    }
}
