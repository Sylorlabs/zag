// Script CSV row encoding fails closed when the context has no remaining
// bytes for the retained output buffer.

script;

let rows: ScriptList[ScriptList[[]u8]] = csv_rows("name,value\r\nalice,1");
if (script_list_len[ScriptList[[]u8]](rows) != 2) { return 1; }
let remaining: i64 = 1048576 - script_alloc_used();
let reserve: *i8 = script_alloc(remaining);
if (reserve == null as *i8) { return 2; }
let encoded: []u8 = csv_rows_encode(rows);
if (encoded.len != 0) { return 3; }
return 0;
