script;

let before = script_alloc_used();
let doc = script_json_parse("{\"users\":[{\"name\":\"Ω\",\"active\":false}],\"nil\":null}");
if (doc.ok != 1 || script_alloc_used() != before) { return 1; }
let root = script_json_root(&doc);
let users = script_json_get(&doc, root, "users");
let first = script_json_at(&doc, users, 0);
let name = script_json_string(&doc, script_json_get(&doc, first, "name"));
let active = script_json_bool(&doc, script_json_get(&doc, first, "active"));
if (name.status != script_json_ok() || !@strEq(name.value, "Ω") ||
    active.status != script_json_ok() || active.value) { return 2; }
if (script_json_get(&doc, root, "missing").status != script_json_missing() ||
    script_json_get(&doc, root, "nil").status != script_json_null() ||
    script_json_at(&doc, root, 0).status != script_json_wrong_type()) { return 3; }
let encoded = script_json_encode_context(&doc);
if (encoded.ok != 1 || script_alloc_used() - before != encoded.value.len) { return 4; }
let null_bytes = script_json_encode_context_bounded(&doc,
    script_json_get(&doc, root, "nil"), 0, 4);
if (null_bytes.ok != 1 || !@strEq(null_bytes.value, "null") ||
    script_alloc_used() - before != encoded.value.len + 4) { return 5; }
let ordinary = script_json_encode(&doc);
if (ordinary.ok != 1 || !@strEq(ordinary.value, encoded.value)) { return 6; }
script_json_encoded_free(&ordinary);
script_json_document_free(&doc);
script_json_document_free(&doc);
let failed = script_json_parse("{\"partial\":[\"owned\",]}");
if (failed.ok != 0 || script_json_root(&failed).status != script_json_invalid()) { return 7; }
script_json_document_free(&failed);
return 0;
