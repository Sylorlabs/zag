script;

// Later declarations must win during the prepass, before any autoload.
if (script_json_stringify_string("x") != 11) { return 1; }
if (script_json_stringify_string_bounded("x", 2) != 12) { return 2; }
if (script_json_encode_context(3) != 13) { return 3; }
if (script_json_encode_context_bounded(1, 2, 3, 4) != 14) { return 4; }
if (script_json_parse("x") != 15) { return 5; }
if (script_alloc_used() != 0) { return 6; }
return 0;

fn script_json_stringify_string(value: []u8) i32 { return 10 + value.len; }
fn script_json_stringify_string_bounded(value: []u8, bound: i32) i32 { return 9 + value.len + bound; }
fn script_json_encode_context(doc: i32) i32 { return 10 + doc; }
fn script_json_encode_context_bounded(doc: i32, cursor: i32, depth: i32, bound: i32) i32 {
    return 4 + doc + cursor + depth + bound;
}
fn script_json_parse(value: []u8) i32 { return 14 + value.len; }
