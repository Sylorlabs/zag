fn script_json_stringify_string(value: []u8) i32 { return 20 + value.len; }
fn script_json_stringify_string_bounded(value: []u8, bound: i32) i32 { return 19 + value.len + bound; }
fn script_json_encode_context(doc: i32) i32 { return 20 + doc; }
fn script_json_encode_context_bounded(doc: i32, cursor: i32, depth: i32, bound: i32) i32 {
    return 14 + doc + cursor + depth + bound;
}
fn script_json_parse(value: []u8) i32 { return 24 + value.len; }
