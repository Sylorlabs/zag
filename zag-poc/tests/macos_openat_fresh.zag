// Fresh-path regression for Darwin's fixed syscall file-I/O lowering.
@import("../std/rt.zag")

fn main() i32 {
    let path: []u8 = "/tmp/zag_macos_openat_fresh_20260727.txt";
    if (_zag_write_file(path,"fresh-openat") != 0) { return 1; }
    if (_zag_file_exists(path) == 0) { return 2; }
    let value: []u8 = _zag_read_file(path);
    if (!@strEq(value,"fresh-openat")) { return 3; }
    return 42;
}
