extern fn cabi_narrow_i8(value: i8) i8 @cabi;
extern fn cabi_narrow_u8(value: u8) u8 @cabi;
extern fn cabi_narrow_i16(value: i16) i16 @cabi;
extern fn cabi_narrow_u16(value: u16) u16 @cabi;
extern fn cabi_narrow_i32(value: i32) i32 @cabi;
extern fn cabi_narrow_u32(value: u32) u32 @cabi;
extern fn cabi_narrow_stack(a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, tail: u8) u8 @cabi;

pub fn zag_narrow_i8(value: i8) i8 @cabi_export { unsafe { return cabi_narrow_i8(value); } }
pub fn zag_narrow_u8(value: u8) u8 @cabi_export { unsafe { return cabi_narrow_u8(value); } }
pub fn zag_narrow_i16(value: i16) i16 @cabi_export { unsafe { return cabi_narrow_i16(value); } }
pub fn zag_narrow_u16(value: u16) u16 @cabi_export { unsafe { return cabi_narrow_u16(value); } }
pub fn zag_narrow_i32(value: i32) i32 @cabi_export { unsafe { return cabi_narrow_i32(value); } }
pub fn zag_narrow_u32(value: u32) u32 @cabi_export { unsafe { return cabi_narrow_u32(value); } }
pub fn zag_narrow_stack(a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, tail: u8) u8 @cabi_export {
    unsafe { return cabi_narrow_stack(a0, a1, a2, a3, a4, a5, a6, a7, tail); }
}
