@repr(C) struct CLayout { a:u32, b:u64, p:*u8 }
@repr(packed) struct PackedLayout { a:u32, b:u32 }
fn main() i32 {
    return ((@sizeOf[CLayout]() != 16 || @alignOf[CLayout]() != 4 ||
        @offsetOf[CLayout]("a") != 0 || @offsetOf[CLayout]("b") != 4 ||
        @offsetOf[CLayout]("p") != 12 || @sizeOf[PackedLayout]() != 8 ||
        @offsetOf[PackedLayout]("b") != 4) as i32);
}
