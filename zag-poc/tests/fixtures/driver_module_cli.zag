// Minimal source used to prove the integrated --emit-driver-module CLI.
// The foreign symbol is deliberately explicit: kernel-owned Kbuild resolves
// it during the final module link.
extern fn zag_kernel_probe() i32 @cabi;

pub @cabi_export @driver_init fn init_module() i32 {
    unsafe { return zag_kernel_probe(); }
}

pub @cabi_export @driver_teardown fn cleanup_module() void {
    return;
}

// The ARM64 front end retains its ordinary program-entry validation even for
// module output; this body is never exported as a kernel symbol.
fn main() i32 {
    return 0;
}
