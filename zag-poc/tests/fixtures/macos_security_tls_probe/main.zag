// Physical availability probe for the macOS system TLS provider. This uses
// the strict custom-link path so the closed edition-2026 import family can be
// extended only after the real Security.framework entry point is proven.

extern fn SSLCreateContext(allocator: *u8, side: i32, connection_type: i32) *u8 @cabi;
extern fn SSLSetProtocolVersionMin(context: *u8, protocol: i32) i32 @cabi;
extern fn SSLSetProtocolVersionMax(context: *u8, protocol: i32) i32 @cabi;
extern fn CFRelease(value: *u8) void @cabi;

fn main() i32 {
    unsafe {
        // kSSLClientSide = 1, kSSLStreamType = 0.
        let context: *u8 = SSLCreateContext(null as *u8, 1, 0);
        if (context == null as *u8) { return 1; }
        // kTLSProtocol13 = 10. Secure Transport must accept TLS 1.3 as both
        // bounds before this provider can make a TLS 1.3 parity claim.
        if (SSLSetProtocolVersionMin(context, 10) != 0) {
            CFRelease(context);
            return 2;
        }
        if (SSLSetProtocolVersionMax(context, 10) != 0) {
            CFRelease(context);
            return 3;
        }
        CFRelease(context);
        return 42;
    }
}
