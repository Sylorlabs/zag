// Source-level i686 backend fixture.  The generic aggregate is intentionally
// small, but it exercises the same declaration expansion, generic call-name
// mangling, aggregate return, field load, and target ELF emission used by
// opaque driver-core values.
struct Box[T] { value: i32 }

fn make_box[T](value: i32) Box[T] {
    return Box[T]{ .value = value };
}

fn main() i32 {
    let box: Box[u16] = make_box[u16](7);
    return (box.value != 7) as i32;
}
