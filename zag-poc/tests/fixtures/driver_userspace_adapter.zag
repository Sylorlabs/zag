@import("std:driver") as driver
@import("std:driver_linux") as linux
@import("std:driver_linux_userspace") as userspace

fn check(target: i32, series: i32) i32 {
    let emulated: userspace.LinuxUserspaceAdapter = userspace.adapter(
        target, series, 1, 1, 1, 0);
    let unavailable: userspace.LinuxUserspaceAdapter = userspace.adapter(
        target, series, 0, 0, 0, 0);
    let probe: driver.DriverStatus = userspace.probe(&emulated);
    let rejected: driver.DriverStatus = userspace.probe(&unavailable);
    let core_ok: i32 = 1;
    unsafe {
        let register: driver.MmioRegister[u16] = driver.mmio_register_new_emulated[u16](
            4, driver.mmio_width_16(), driver.mmio_read_write(),
            driver.endian_big(), driver.mmio_barrier_device());
        let write: driver.DriverStatus = driver.mmio_write16(&register, 0x1234);
        let read: u16 = driver.mmio_read16_value(&register);
        driver.mmio_register_release(register);
        let counter: driver.Atomic[u32] = driver.atomic_new_emulated[u32](32, 1);
        let store: driver.DriverStatus = driver.atomic_store32(
            &counter, 0x55aa, driver.order_release());
        let load: u32 = driver.atomic_load32_value(
            &counter, driver.order_acquire());
        driver.atomic_release(counter);
        let domain: driver.DmaDomain = driver.dma_domain_new_emulated(
            64, 4, driver.dma_coherent());
        let buffer: driver.DmaBuffer[u8] = driver.dma_buffer_new_emulated[u8](
            16, 64, driver.dma_bidirectional(), driver.dma_coherent());
        let address: driver.BusAddress = driver.dma_buffer_map_emulated[u8](
            &buffer, &domain, 0x1000, 1);
        let sync: driver.DriverStatus = driver.dma_buffer_sync_for_device[u8](&buffer);
        driver.dma_buffer_unmap[u8](&buffer, address);
        let dma_ok: i32 = (sync.code == driver.driver_ok() &&
            driver.dma_buffer_is_mapped[u8](&buffer) == 0) as i32;
        driver.dma_buffer_release[u8](buffer);
        driver.dma_domain_release(domain);
        core_ok = (write.code == driver.driver_ok() && read == 0x1234 &&
            store.code == driver.driver_ok() && load == 0x55aa && dma_ok != 0) as i32;
    }
    return (probe.code == driver.driver_ok() &&
        rejected.code == driver.driver_unsupported() && core_ok != 0) as i32;
}

fn main() i32 {
    if (check(linux.linux_target_x86_64(), linux.linux_kernel_6_1()) == 0 ||
        check(linux.linux_target_x86_64(), linux.linux_kernel_6_6()) == 0 ||
        check(linux.linux_target_arm64(), linux.linux_kernel_6_1()) == 0 ||
        check(linux.linux_target_arm64(), linux.linux_kernel_6_6()) == 0 ||
        check(linux.linux_target_i686(), linux.linux_kernel_6_1()) == 0 ||
        check(linux.linux_target_i686(), linux.linux_kernel_6_6()) == 0) {
        return 1;
    }
    return 0;
}
