// SENTINEL prospective native narrow-cast regression, Zag edition 2026.
// Tests explicit low-bit-wrap contract documented in docs/X86_TARGET_POLICY.md.
fn parse_decimal(s:[]u8)u64 {
  let n:u64=0;let i:i64=0;
  while(i<s.len){n=n*10+((s[i] as u64)-48);i=i+1;}
  return n;
}
fn via_return(x:u64)u16 {return x as u16;}
fn main()i32 {
  let a:u64=parse_decimal("65536");
  let b:u64=parse_decimal("4294967296");
  let c:u64=parse_decimal("65535");
  let d:u64=parse_decimal("255");
  let minus:i64=0-1;
  let minus_big:i64=0-65535;
  print_u64((a as u8) as u64);         // 0
  print_u64((a as u16) as u64);        // 0
  print_u64((b as u32) as u64);        // 0
  print_u64(((a+1) as u16) as u64);    // 1
  print_u64((65537 as u16) as u64);    // 1 (literal expression)
  print_u64((257 as u8) as u64);       // 1
  print_i64((d as i8) as i64);         // -1
  print_i64((c as i16) as i64);        // -1
  print_i64(((b-1) as i32) as i64);   // -1
  print_i64((255 as i8) as i64);       // -1
  print_i64((65535 as i16) as i64);   // -1
  print_i64((4294967295 as i32) as i64); // -1
  print_u64((minus as u8) as u64);    // 255
  print_u64((minus as u16) as u64);   // 65535
  print_u64((minus as u32) as u64);   // 4294967295
  print_i64((minus_big as i8) as i64);  // 1
  print_i64((minus_big as i16) as i64); // 1
  print_i64((minus_big as i32) as i64); // -65535
  print_u64(((a as u16)+1) as u64);   // 1
  if((a as u16)==0){print_u64(1);}else{print_u64(0);}
  if((c as i16)<0){print_u64(1);}else{print_u64(0);}
  print_u64(via_return(a) as u64);    // 0
  let store_u16:u16=a as u16;
  let store_i16:i16=c as i16;
  print_u64(store_u16 as u64);        // 0
  print_i64(store_i16 as i64);        // -1
  let block:*u16=_zag_malloc(8) as *u16;
  if((block as i64)==0){return 2;}
  block[0]=a as u16;
  print_u64(block[0] as u64);         // 0
  _zag_free(block);
  return 0;
}
