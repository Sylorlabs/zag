// edition: 2027
@link("probe");

// Generic foreign ABI templates have no concrete SysV symbol contract and
// must not occupy (or shift) a compiler-owned static relocation index.
extern fn generic_import[T](value: T) T @cabi;
extern fn archive_answer() i32 @cabi;

fn main() i32 {
    unsafe { return archive_answer(); }
}
