@repr(C) struct XButtonEvent {
    event_type: i32,
    serial: i64,
    send_event: i32,
    display: *u8,
    window: i64,
    root: i64,
    subwindow: i64,
    time: i64,
    x: i32,
    y: i32,
    x_root: i32,
    y_root: i32,
    state: u32,
    button: u32,
    same_screen: i32,
}

fn main() i32 {
    unsafe {
    if (@sizeOf[XButtonEvent]() != 96) { return 1; }

    let raw: *u8 = _zag_malloc(192) as *u8;
    let i: i32 = 0;
    while (i < 192) { raw[i] = 170; i = i + 1; }
    let event: *XButtonEvent = raw as *XButtonEvent;

    if (((&event.*.event_type) as i64) - (event as i64) != 0) { return 2; }
    if (((&event.*.serial) as i64) - (event as i64) != 8) { return 3; }
    if (((&event.*.send_event) as i64) - (event as i64) != 16) { return 4; }
    if (((&event.*.display) as i64) - (event as i64) != 24) { return 5; }
    if (((&event.*.x) as i64) - (event as i64) != 64) { return 6; }
    if (((&event.*.y) as i64) - (event as i64) != 68) { return 7; }
    if (((&event.*.state) as i64) - (event as i64) != 80) { return 8; }
    if (((&event.*.button) as i64) - (event as i64) != 84) { return 9; }
    if (((&event.*.same_screen) as i64) - (event as i64) != 88) { return 10; }

    let next: *XButtonEvent = &event[1];
    if ((next as i64) - (event as i64) != 96) { return 11; }

    // Known little-endian foreign bytes: x=-2, y=42, button=0x11223344.
    raw[64] = 254; raw[65] = 255; raw[66] = 255; raw[67] = 255;
    raw[68] = 42; raw[69] = 0; raw[70] = 0; raw[71] = 0;
    raw[84] = 68; raw[85] = 51; raw[86] = 34; raw[87] = 17;
    if (event.*.x != -2 || event.*.y != 42) { return 12; }
    if (event.*.button != 287454020) { return 13; }

    // Narrow stores must not overwrite either the preceding padding or the
    // following C field. The sentinels expose accidental eight-byte stores.
    raw[63] = 91; raw[68] = 77;
    event.*.x = -1234567;
    if (raw[63] != 91 || raw[68] != 77 || event.*.x != -1234567) { return 14; }
    raw[83] = 92; raw[88] = 93;
    event.*.button = 16909060;
    if (raw[83] != 92 || raw[88] != 93 || event.*.button != 16909060) { return 15; }

    event.*.display = 4096 as *u8;
    if (event.*.display != 4096 as *u8) { return 16; }
    _zag_free(raw);
    return 42;
    }
}
