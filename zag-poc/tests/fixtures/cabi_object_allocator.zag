// edition: 2027
// The allocator runtime addresses its cursor/end cells in the compiler-owned
// data segment even though this source does not add any literal bytes.
extern fn _zag_malloc(n: i64) *u8;
extern fn _zag_free(p: *u8) void;

pub fn zag_allocator_identity(value: i64) i64 @cabi_export {
    let memory: *u8 = _zag_malloc(8);
    _zag_free(memory);
    return value;
}
