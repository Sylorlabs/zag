@repr(C) struct CLayout { a:u8, b:u32, c:u64, p:*u8 }
@repr(packed) struct PackedLayout { a:u32, b:u32 }
fn main() i32 {
    return ((@sizeOf[CLayout]() != 24 || @alignOf[CLayout]() != 8 ||
        @offsetOf[CLayout]("a") != 0 || @offsetOf[CLayout]("b") != 4 ||
        @offsetOf[CLayout]("c") != 8 || @offsetOf[CLayout]("p") != 16 ||
        @sizeOf[PackedLayout]() != 8 || @offsetOf[PackedLayout]("b") != 4) as i32);
}
