#!/bin/sh
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
echo ZAG_DRIVER_INIT_BEGIN
iteration=1
while [ "$iteration" -le 3 ]; do
    echo "ZAG_DRIVER_MODULE_ITERATION=$iteration"
    if ! insmod /zag_driver.ko; then
        echo ZAG_DRIVER_QEMU_FAIL_LOAD
        poweroff -f
        exit 1
    fi
    echo ZAG_DRIVER_MODULE_LOADED
    if ! rmmod zag_driver; then
        echo ZAG_DRIVER_QEMU_FAIL_UNLOAD
        poweroff -f
        exit 1
    fi
    echo ZAG_DRIVER_MODULE_UNLOADED
    iteration=$((iteration + 1))
done
echo ZAG_DRIVER_QEMU_PASS
poweroff -f
