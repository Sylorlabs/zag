// Physical probe for the modern macOS system TLS stack.  Secure Transport's
// SSLSetProtocolVersionMin/Max API is capped at TLS 1.2, so TLS 1.3 parity uses
// Network.framework transport objects plus Security.framework sec_protocol
// options instead.

extern fn _zag_code_anchor() i64;
extern fn qsort(base: *u8, count: i64, size: i64,
                compare: fn(*u8,*u8)i32) void @cabi @borrows_mut;
extern fn objc_getClass(name: *i8) *u8 @cabi;

extern fn nw_parameters_create() *u8 @cabi;
extern fn nw_parameters_copy_default_protocol_stack(parameters: *u8) *u8 @cabi;
extern fn nw_tcp_create_options() *u8 @cabi;
extern fn nw_tls_create_options() *u8 @cabi;
extern fn nw_tls_copy_sec_protocol_options(options: *u8) *u8 @cabi;
extern fn nw_protocol_stack_set_transport_protocol(stack: *u8,
                                                     options: *u8) void @cabi;
extern fn nw_protocol_stack_prepend_application_protocol(stack: *u8,
                                                          options: *u8) void @cabi;
extern fn nw_protocol_stack_iterate_application_protocols(
    stack: *u8, block: @borrows *u8
) void @cabi;
extern fn nw_release(value: *u8) void @cabi;

extern fn sec_protocol_options_set_min_tls_protocol_version(options: *u8,
                                                             version: u16) void @cabi;
extern fn sec_protocol_options_set_max_tls_protocol_version(options: *u8,
                                                             version: u16) void @cabi;
extern fn sec_release(value: *u8) void @cabi;

global let tls_probe_callbacks: i64;
global let tls_probe_protocol_seen: i64;
global let tls_probe_capture_address: i64;
global let tls_probe_capture_mode: i64;

@repr(C) struct TlsProbeBlockDescriptor {
    reserved: i64,
    size: i64,
}

@repr(C) struct TlsProbeBlockLiteral {
    isa: *u8,
    flags: i32,
    reserved: i32,
    invoke: *u8,
    descriptor: *TlsProbeBlockDescriptor,
}

fn zag_network_tls_probe_iterate(block: *u8, protocol: *u8) i32 {
    if (tls_probe_capture_mode == 1) {
        tls_probe_capture_address = _zag_code_anchor();
        return 0;
    }
    if (block != null as *u8) { tls_probe_callbacks = tls_probe_callbacks + 1; }
    if (protocol != null as *u8) { tls_probe_protocol_seen = 1; }
    return 0;
}

fn tls_probe_run(storage: @borrows_mut *u8) i32 {
    unsafe {
        let storage_raw: i64 = storage as i64;
        let descriptor: *TlsProbeBlockDescriptor =
            storage_raw as *TlsProbeBlockDescriptor;
        let block: *TlsProbeBlockLiteral =
            (storage_raw + 16) as *TlsProbeBlockLiteral;
        let capture_words: *i64 = (storage_raw + 64) as *i64;
        capture_words[0] = 2;
        capture_words[1] = 1;
        tls_probe_capture_mode = 1;
        qsort(capture_words as *u8, 2, 8, zag_network_tls_probe_iterate);
        tls_probe_capture_mode = 0;
        if (tls_probe_capture_address == 0) { return 1; }
        let global_block_class: *u8 = objc_getClass(
            _zag_slice_ptr("__NSGlobalBlock__\x00") as *i8
        );
        if (global_block_class == null as *u8) { return 8; }
        descriptor.*.reserved = 0;
        descriptor.*.size = 32;
        block.*.isa = global_block_class;
        block.*.flags = 268435456; // BLOCK_IS_GLOBAL = 1 << 28.
        block.*.reserved = 0;
        block.*.invoke = tls_probe_capture_address as *u8;
        block.*.descriptor = descriptor;

        let parameters: *u8 = nw_parameters_create();
        if (parameters == null as *u8) { return 3; }
        let stack: *u8 = nw_parameters_copy_default_protocol_stack(parameters);
        let tcp: *u8 = nw_tcp_create_options();
        let tls: *u8 = nw_tls_create_options();
        if (stack == null as *u8 || tcp == null as *u8 || tls == null as *u8) {
            if (tls != null as *u8) { nw_release(tls); }
            if (tcp != null as *u8) { nw_release(tcp); }
            if (stack != null as *u8) { nw_release(stack); }
            nw_release(parameters);
            return 4;
        }
        let security: *u8 = nw_tls_copy_sec_protocol_options(tls);
        if (security == null as *u8) {
            nw_release(tls); nw_release(tcp); nw_release(stack);
            nw_release(parameters);
            return 5;
        }

        // tls_protocol_version_TLSv13 = 0x0304.  These modern setters have no
        // error return; the later negotiated-metadata gate will prove the
        // configured version actually reaches a real TLS 1.3 session.
        sec_protocol_options_set_min_tls_protocol_version(security, 772 as u16);
        sec_protocol_options_set_max_tls_protocol_version(security, 772 as u16);
        nw_protocol_stack_set_transport_protocol(stack, tcp);
        nw_protocol_stack_prepend_application_protocol(stack, tls);
        nw_protocol_stack_iterate_application_protocols(
            stack, block as *u8
        );

        sec_release(security);
        nw_release(tls);
        nw_release(tcp);
        nw_release(stack);
        nw_release(parameters);

        if (tls_probe_callbacks != 1 || tls_probe_protocol_seen != 1) { return 6; }
        return 42;
    }
}

fn main() i32 {
    let storage: *u8 = _zag_malloc(4096);
    let result: i32 = tls_probe_run(storage);
    _zag_free(storage);
    return result;
}
