// Builds one deterministic GNU archive without cc, as, ar, or ld.
// The object member is emitted by Zag's production ELF64 ET_REL writer and
// exports this six-byte System V function:
//
//     archive_answer:
//         mov eax, 42
//         ret

// argv[1] is the temporary object path; argv[2] is the valid libprobe.a.
// argv[3..5] are duplicate-index, malformed-header, and malformed-ELF archives.

@import("../../selfhost/native/elf.zag")
@import("../../selfhost/native/ar.zag")
@import("../../selfhost/native/elf_obj.zag")

fn static_archive_byte(out: *ArrayList[u8], value: i32) void {
    push[u8](out, (value & 255) as u8);
}

fn static_archive_bytes(out: *ArrayList[u8], value: []u8) void {
    let i: i32 = 0;
    while (i < value.len) {
        static_archive_byte(out, value[i] as i32);
        i = i + 1;
    }
}

fn static_archive_field(out: *ArrayList[u8], value: []u8, width: i32) void {
    let i: i32 = 0;
    while (i < width) {
        if (i < value.len) {
            static_archive_byte(out, value[i] as i32);
        } else {
            static_archive_byte(out, 32);
        }
        i = i + 1;
    }
}

fn static_archive_be32(out: *ArrayList[u8], value: i64) void {
    static_archive_byte(out, ((value / 16777216) & 255) as i32);
    static_archive_byte(out, ((value / 65536) & 255) as i32);
    static_archive_byte(out, ((value / 256) & 255) as i32);
    static_archive_byte(out, (value & 255) as i32);
}

fn static_archive_header(out: *ArrayList[u8], name: []u8, size: i64) void {
    static_archive_field(out, name, 16);
    static_archive_field(out, "0", 12);
    static_archive_field(out, "0", 6);
    static_archive_field(out, "0", 6);
    static_archive_field(out, "100644", 8);
    static_archive_field(out, _zag_i64_to_str(size), 10);
    static_archive_byte(out, 96);
    static_archive_byte(out, 10);
}

fn static_archive_write(path: []u8, object: []u8,
                        symbols: ArrayList[Elf64ObjectSymbol]) i32 {
    // GNU's `/` member stores a BE symbol count, one BE archive-member header
    // offset per symbol, and NUL-terminated names. Every symbol in this fixture
    // is intentionally defined by the same object member.
    let symbol_table_size: i64 = 4 + symbols.len * 4;
    let name_size_index: i32 = 0;
    while (name_size_index < symbols.len) {
        symbol_table_size = symbol_table_size + symbols.data[name_size_index].name.len + 1;
        name_size_index = name_size_index + 1;
    }
    let member_header_offset: i64 = 8 + 60 + symbol_table_size +
        (symbol_table_size % 2);
    let archive: ArrayList[u8] = make[u8](object.len + 192);

    static_archive_bytes(&archive, "!<arch>\n");
    static_archive_header(&archive, "/", symbol_table_size);
    static_archive_be32(&archive, symbols.len as i64);
    let offset_index: i32 = 0;
    while (offset_index < symbols.len) {
        static_archive_be32(&archive, member_header_offset);
        offset_index = offset_index + 1;
    }
    let name_index: i32 = 0;
    while (name_index < symbols.len) {
        static_archive_bytes(&archive, symbols.data[name_index].name);
        static_archive_byte(&archive, 0);
        name_index = name_index + 1;
    }
    if ((symbol_table_size % 2) != 0) {
        static_archive_byte(&archive, 10);
    }

    static_archive_header(&archive, "probe.o/", object.len as i64);
    let i: i32 = 0;
    while (i < object.len) {
        static_archive_byte(&archive, object[i] as i32);
        i = i + 1;
    }
    if ((object.len % 2) != 0) {
        static_archive_byte(&archive, 10);
    }

    // Exercise the production archive/object readers before handing the input
    // to znc. The same fixture also proves representative malformed metadata is
    // rejected without an out-of-bounds read or a partial member selection.
    let archive_view: []u8 = archive.data[0..archive.len];
    let parsed_symbols: ArrayList[ArSymbol] = ar_symbol_table(archive_view);
    let parsed_entries: ArrayList[ArEntry] = ar_parse(archive_view);
    if (parsed_symbols.len != symbols.len || parsed_entries.len != 1 ||
        !@strEq(parsed_symbols.data[0].name, symbols.data[0].name) ||
        !@strEq(parsed_symbols.data[parsed_symbols.len - 1].name,
            symbols.data[symbols.len - 1].name) ||
        !@strEq(parsed_entries.data[0].name, "probe.o") ||
        parsed_entries.data[0].data.len != object.len ||
        ar_entry_data(archive_view, member_header_offset).len != object.len) {
        return 6;
    }
    let parsed_object: ObjFile = elf_obj_parse(object);
    if (parsed_object.valid != 1) { return 7; }

    let saved_fmag: u8 = archive.data[66];
    set[u8](&archive, 66, 0 as u8);
    if (ar_symbol_table(archive.data[0..archive.len]).len != 0 ||
        ar_parse(archive.data[0..archive.len]).len != 0) { return 8; }
    set[u8](&archive, 66, saved_fmag);

    let saved_count: u8 = archive.data[68];
    set[u8](&archive, 68, 255 as u8);
    if (ar_symbol_table(archive.data[0..archive.len]).len != 0) { return 9; }
    set[u8](&archive, 68, saved_count);
    let saved_count_low: u8 = archive.data[71];
    set[u8](&archive, 71, (symbols.len + 1) as u8);
    if (ar_symbol_table(archive.data[0..archive.len]).len != 0) { return 16; }
    set[u8](&archive, 71, saved_count_low);
    if (ar_entry_data(archive.data[0..archive.len], 0 - 1).len != 0) { return 10; }

    let saved_class: u8 = object[4];
    object[4] = 1 as u8;
    if (elf_obj_parse(object).valid != 0) { return 11; }
    object[4] = saved_class;
    if (elf_obj_parse(object[0..63]).valid != 0) { return 12; }
    return _zag_write_file(path, archive.data[0..archive.len]);
}

fn static_archive_corrupt(path: []u8, out: []u8, object_class: i32) i32 {
    let archive: []u8 = _zag_read_file(path);
    if (archive.len < 69) { return 1; }
    if (object_class == 0) {
        archive[66] = 0 as u8; // first member's `\x60\n` terminator
    } else {
        let index: ArrayList[ArSymbol] = ar_symbol_table(archive);
        if (index.len == 0) { return 1; }
        let class_offset: i64 = index.data[0].entry_offset + 60 + 4;
        if (class_offset < 0 || class_offset >= archive.len as i64) { return 1; }
        archive[class_offset as i32] = 1 as u8; // ELFCLASS32, not ELFCLASS64
    }
    return _zag_write_file(out, archive);
}

fn main() i32 {
    if (_zag_argc() != 6) {
        _zag_eprintln("usage: static_archive_cabi_generator OBJECT VALID DUPLICATE BAD_HEADER BAD_ELF");
        return 2;
    }

    let text: ArrayList[u8] = make[u8](64);
    let symbols: ArrayList[Elf64ObjectSymbol] = make[Elf64ObjectSymbol](8);

    let answer_offset: i64 = text.len as i64;
    static_archive_byte(&text, 184); // B8: mov eax, imm32
    static_archive_byte(&text, 42);
    static_archive_byte(&text, 0);
    static_archive_byte(&text, 0);
    static_archive_byte(&text, 0);
    static_archive_byte(&text, 195); // C3: ret
    push[Elf64ObjectSymbol](&symbols, Elf64ObjectSymbol{
        .name = "archive_answer", .offset = answer_offset, .size = 6,
    });

    let negative_offset: i64 = text.len as i64;
    static_archive_byte(&text, 184); // mov eax, -1 (upper half becomes zero)
    static_archive_byte(&text, 255); static_archive_byte(&text, 255);
    static_archive_byte(&text, 255); static_archive_byte(&text, 255);
    static_archive_byte(&text, 195);
    push[Elf64ObjectSymbol](&symbols, Elf64ObjectSymbol{
        .name = "archive_negative", .offset = negative_offset, .size = 6,
    });

    let i8_offset: i64 = text.len as i64;
    static_archive_byte(&text, 72); static_archive_byte(&text, 184); // mov rax, imm64
    static_archive_byte(&text, 249); static_archive_byte(&text, 119);
    static_archive_byte(&text, 102); static_archive_byte(&text, 85);
    static_archive_byte(&text, 68); static_archive_byte(&text, 51);
    static_archive_byte(&text, 34); static_archive_byte(&text, 17);
    static_archive_byte(&text, 195);
    push[Elf64ObjectSymbol](&symbols, Elf64ObjectSymbol{
        .name = "archive_i8", .offset = i8_offset, .size = 11,
    });

    let u16_offset: i64 = text.len as i64;
    static_archive_byte(&text, 72); static_archive_byte(&text, 184); // mov rax, imm64
    static_archive_byte(&text, 239); static_archive_byte(&text, 190);
    static_archive_byte(&text, 102); static_archive_byte(&text, 85);
    static_archive_byte(&text, 68); static_archive_byte(&text, 51);
    static_archive_byte(&text, 34); static_archive_byte(&text, 17);
    static_archive_byte(&text, 195);
    push[Elf64ObjectSymbol](&symbols, Elf64ObjectSymbol{
        .name = "archive_u16", .offset = u16_offset, .size = 11,
    });

    let add_offset: i64 = text.len as i64;
    static_archive_byte(&text, 72); static_archive_byte(&text, 137);
    static_archive_byte(&text, 248); // mov rax,rdi
    static_archive_byte(&text, 72); static_archive_byte(&text, 1);
    static_archive_byte(&text, 240); // add rax,rsi
    static_archive_byte(&text, 195);
    push[Elf64ObjectSymbol](&symbols, Elf64ObjectSymbol{
        .name = "archive_add", .offset = add_offset, .size = 7,
    });

    let f64_offset: i64 = text.len as i64;
    static_archive_byte(&text, 242); static_archive_byte(&text, 15);
    static_archive_byte(&text, 88); static_archive_byte(&text, 193); // addsd xmm0,xmm1
    static_archive_byte(&text, 195);
    push[Elf64ObjectSymbol](&symbols, Elf64ObjectSymbol{
        .name = "archive_add_f64", .offset = f64_offset, .size = 5,
    });

    let identity_offset: i64 = text.len as i64;
    static_archive_byte(&text, 72); static_archive_byte(&text, 137);
    static_archive_byte(&text, 248); static_archive_byte(&text, 195); // mov rax,rdi; ret
    push[Elf64ObjectSymbol](&symbols, Elf64ObjectSymbol{
        .name = "archive_identity", .offset = identity_offset, .size = 4,
    });
    if (write_elf_x86_64_object(_zag_arg(1), text, symbols) != 0) {
        _zag_eprintln("static archive fixture: object writer failed");
        return 3;
    }

    let object: []u8 = _zag_read_file(_zag_arg(1));
    if (object.len <= 0) {
        _zag_eprintln("static archive fixture: object read failed");
        return 4;
    }
    if (static_archive_write(_zag_arg(2), object, symbols) != 0) {
        _zag_eprintln("static archive fixture: archive write failed");
        return 5;
    }
    let duplicate_symbols: ArrayList[Elf64ObjectSymbol] = make[Elf64ObjectSymbol](symbols.len + 1);
    let si: i32 = 0;
    while (si < symbols.len) {
        push[Elf64ObjectSymbol](&duplicate_symbols, symbols.data[si]);
        si = si + 1;
    }
    push[Elf64ObjectSymbol](&duplicate_symbols, symbols.data[0]);
    if (static_archive_write(_zag_arg(3), object, duplicate_symbols) != 0) { return 13; }
    if (static_archive_corrupt(_zag_arg(2), _zag_arg(4), 0) != 0) { return 14; }
    if (static_archive_corrupt(_zag_arg(2), _zag_arg(5), 1) != 0) { return 15; }
    return 0;
}
