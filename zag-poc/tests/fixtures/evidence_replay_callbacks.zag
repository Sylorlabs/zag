// Real Zag module callbacks. Buffers are borrowed from the replay runner.
@import("../../std/list.zag")

fn evidence_observe(out: *ArrayList[u8], value: []u8) void {
    let i: i32 = 0;
    while (i < value.len) {
        push[u8](out, value[i]);
        i = i + 1;
    }
}

fn evidence_guard(input: []u8, out: *ArrayList[u8]) i32 {
    if (@strEq(input, "normal")) { evidence_observe(out, "ok"); }
    else if (@strEq(input, "evil")) { evidence_observe(out, "reject"); }
    else { evidence_observe(out, input); }
    return 0;
}

// Simulates removing the adversarial-input check in a changed module.
fn evidence_guard_regression(input: []u8, out: *ArrayList[u8]) i32 {
    if (@strEq(input, "normal") || @strEq(input, "evil")) {
        evidence_observe(out, "ok");
    } else {
        evidence_observe(out, input);
    }
    return 0;
}

fn evidence_always_wrong(input: []u8, out: *ArrayList[u8]) i32 {
    evidence_observe(out, "wrong");
    return 0;
}

// An invalid corpus/pin must not reach this function at all.
fn evidence_must_not_run(input: []u8, out: *ArrayList[u8]) i32 {
    _zag_exit(91);
    return 1;
}

fn evidence_mutating_callback(input: []u8, out: *ArrayList[u8]) i32 {
    if (input.len > 0) { input[0] = 'X'; }
    evidence_observe(out, input);
    return 0;
}

fn evidence_oversized_callback(input: []u8, out: *ArrayList[u8]) i32 {
    let i: i32 = 0;
    while (i < 1048577) {
        push[u8](out, 'x');
        i = i + 1;
    }
    return 0;
}

fn evidence_failed_callback(input: []u8, out: *ArrayList[u8]) i32 {
    evidence_observe(out, "partial observation");
    return 1;
}
