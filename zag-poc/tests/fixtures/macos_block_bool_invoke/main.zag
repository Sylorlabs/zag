extern fn _zag_code_anchor() i64;

struct BoolBlockThunk {
    call: fn(bool)void,
}

global let observed: i32;

fn bool_block_invoke(block: *u8, value: bool) i64 {
    if (block == null as *u8) { return _zag_code_anchor(); }
    observed = value as i32;
    return 0;
}

fn complete_bool(storage: @borrows_mut *u8, value: bool) void {
    unsafe {
        let block: *u8 = storage;
        let thunk_storage: *u8 = ((storage as i64) + 32) as *u8;
        let words: *i64 = thunk_storage as *i64;
        let block_words: *i64 = block as *i64;
        words[0] = block_words[2];
        words[1] = block as i64;
        let thunk: *BoolBlockThunk = thunk_storage as *BoolBlockThunk;
        thunk.*.call(value);
    }
}

fn run(storage: @borrows_mut *u8) i32 {
    unsafe {
        let words: *i64 = storage as *i64;
        words[0] = 0;
        words[1] = 0;
        words[2] = bool_block_invoke(null as *u8, false);
        words[3] = 0;
        complete_bool(storage, true);
        if (observed != 1) { return 1; }
        complete_bool(storage, false);
        if (observed != 0) { return 2; }
        return 42;
    }
}

fn main() i32 {
    let storage: *u8 = _zag_malloc(64);
    let result: i32 = run(storage);
    _zag_free(storage);
    return result;
}
