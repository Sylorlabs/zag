extern fn cabi_mul3(value: i64) i64 @cabi;
extern fn cabi_mixed(a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64,
    a6: i64, a7: i64, b: i8, c: u8, d: i16, e: u16, f: i32, g: u32,
    h: i64, i: u64, j: bool, k: *i64) i64 @cabi;

global let object_counter: i64;

fn generic_add[T](left: T, right: T) T { return left + right; }
fn private_value(value: i64) i64 { return generic_add[i64](value, 2); }

pub fn zag_object_answer(value: i64) i64 @cabi_export {
    unsafe { return cabi_mul3(private_value(value)); }
}

pub fn _zag_object_prefixed(value: u8) u8 @cabi_export { return value; }

pub fn zag_object_counter() i64 @cabi_export {
    object_counter = object_counter + 1;
    return object_counter;
}

pub fn zag_object_literal() *u8 @cabi_export {
    unsafe { return _zag_slice_ptr("native-object\0") as *u8; }
}

pub fn zag_object_allocate() i64 @cabi_export {
    unsafe {
        let p: *i8 = _zag_malloc(24) as *i8;
        p[0] = 17; p[23] = 25;
        let value: i64 = (p[0] as i64) + (p[23] as i64);
        _zag_free(p);
        return value;
    }
}

pub fn zag_object_mixed(a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64,
    a6: i64, a7: i64, b: i8, c: u8, d: i16, e: u16, f: i32, g: u32,
    h: i64, i: u64, j: bool, k: *i64) i64 @cabi_export {
    unsafe { return cabi_mixed(a0, a1, a2, a3, a4, a5, a6, a7,
        b, c, d, e, f, g, h, i, j, k); }
}

fn private_mixed(a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64,
    a6: i64, a7: i64, b: i8, c: u8, d: i16, e: u16, f: i32, g: u32,
    h: i64, i: u64, j: bool, k: *i64) i64 {
    return zag_object_mixed(a0, a1, a2, a3, a4, a5, a6, a7,
        b, c, d, e, f, g, h, i, j, k);
}

pub fn zag_object_internal_call(pointer: *i64) i64 @cabi_export {
    return private_mixed(1, 2, 3, 4, 5, 6, 7, 8, -7 as i8, 251 as u8,
        -1234 as i16, 60000 as u16, -123456 as i32, 4000000000 as u32,
        -9876543210, 1234567890123 as u64, true, pointer);
}
