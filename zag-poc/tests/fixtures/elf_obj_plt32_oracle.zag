// Source-level oracle for ELF R_X86_64_PLT32 relocation arithmetic.
// With text_base=B, S=B+100, A=-4, and P=B+2, S+A-P is exactly 94.
// The historical extra `-4` in apply_relocs encoded 90 instead.

@import("../../selfhost/native/elf_obj.zag")

fn main() i32 {
    let merged: MergedLib = MergedLib{
        .text = make[u8](8),
        .sym_addrs = make[SymAddr](1),
        .relocs = make[PendingReloc](1),
        .text_base = 4096,
    };
    let i: i32 = 0;
    while (i < 8) {
        push[u8](&merged.text, 0 as u8);
        i = i + 1;
    }
    push[SymAddr](&merged.sym_addrs, SymAddr{
        .name = "target",
        .addr = merged.text_base + 100,
    });
    push[PendingReloc](&merged.relocs, PendingReloc{
        .patch_off = 2,
        .type_ = 4,
        .sym_name = "target",
        .addend = 0 - 4,
    });

    let no_externals: ArrayList[SymAddr] = make[SymAddr](1);
    if (apply_relocs(&merged, no_externals) != 0) {
        _zag_eprintln("elf_obj PLT32 oracle: relocation unexpectedly failed");
        return 2;
    }
    if (merged.text.data[2] != 94 || merged.text.data[3] != 0 ||
        merged.text.data[4] != 0 || merged.text.data[5] != 0) {
        _zag_eprintln("elf_obj PLT32 oracle: expected rel32=94");
        return 1;
    }

    // Every malformed/unresolved case must be reported rather than silently
    // leaving a plausible zero displacement in a release executable.
    let rejected: MergedLib = MergedLib{
        .text = make[u8](8),
        .sym_addrs = make[SymAddr](4),
        .relocs = make[PendingReloc](6),
        .text_base = 4096,
    };
    let zi: i32 = 0;
    while (zi < 8) { push[u8](&rejected.text, 0 as u8); zi = zi + 1; }
    push[SymAddr](&rejected.sym_addrs, SymAddr{ .name = "duplicate", .addr = 4200 });
    push[SymAddr](&rejected.sym_addrs, SymAddr{ .name = "duplicate", .addr = 4300 });
    push[SymAddr](&rejected.sym_addrs, SymAddr{ .name = "one", .addr = 4200 });
    push[SymAddr](&rejected.sym_addrs, SymAddr{ .name = "far", .addr = 2147487744 });
    push[PendingReloc](&rejected.relocs, PendingReloc{ .patch_off = 0, .type_ = 4, .sym_name = "duplicate", .addend = 0 - 4 });
    push[PendingReloc](&rejected.relocs, PendingReloc{ .patch_off = 0, .type_ = 4, .sym_name = "missing", .addend = 0 - 4 });
    push[PendingReloc](&rejected.relocs, PendingReloc{ .patch_off = 0, .type_ = 99, .sym_name = "one", .addend = 0 });
    push[PendingReloc](&rejected.relocs, PendingReloc{ .patch_off = 2, .type_ = 1, .sym_name = "one", .addend = 0 });
    push[PendingReloc](&rejected.relocs, PendingReloc{ .patch_off = 0, .type_ = 4, .sym_name = "far", .addend = 0 });
    push[PendingReloc](&rejected.relocs, PendingReloc{ .patch_off = 0, .type_ = 11, .sym_name = "far", .addend = 0 });
    if (apply_relocs(&rejected, no_externals) != 6) {
        _zag_eprintln("elf_obj PLT32 oracle: fail-closed relocation cases were accepted");
        return 3;
    }
    return 0;
}
