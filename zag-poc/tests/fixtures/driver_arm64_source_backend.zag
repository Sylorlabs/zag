// Source-level ARM64 backend fixture.  It combines target-aware C layout
// queries with a generic aggregate return and field read.
@repr(C) struct CLayout { a:u8, b:u32, c:u64, p:*u8 }
struct Box[T] { value: i64 }

fn make_box[T](value: i64) Box[T] {
    return Box[T]{ .value = value };
}

fn main() i32 {
    let box: Box[u16] = make_box[u16](40);
    return ((@sizeOf[CLayout]() != 24 || @alignOf[CLayout]() != 8 ||
        @offsetOf[CLayout]("b") != 4 || @offsetOf[CLayout]("c") != 8 ||
        @offsetOf[CLayout]("p") != 16 || box.value != 40) as i32);
}
