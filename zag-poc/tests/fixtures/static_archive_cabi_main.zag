// edition: 2027
// The implementation is selected from libprobe.a by the compiler's native
// archive reader and appended to the executable text segment.
@link("probe");

extern fn archive_answer() i32 @cabi;
extern fn archive_negative() i32 @cabi;
extern fn archive_i8() i8 @cabi;
extern fn archive_u16() u16 @cabi;
extern fn archive_add(a: i64, b: i64) i64 @cabi;
extern fn archive_add_f64(a: f64, b: f64) f64 @cabi;
extern fn archive_identity(value: *u8) *u8 @cabi;

fn main() i32 {
    unsafe {
        if (archive_answer() != 42) { return 1; }
        // These are deliberately consumed as direct expressions. A typed local
        // must not be required to repair undefined upper return-register bits.
        if (archive_negative() >= 0) { return 2; }
        if ((archive_i8() as i64) != (0 - 7)) { return 3; }
        if ((archive_u16() as i64) != 48879) { return 4; }
        if (archive_add(20, 22) != 42) { return 5; }
        let sum: f64 = archive_add_f64(1.5, 2.25);
        if (sum < 3.74 || sum > 3.76) { return 6; }
        let pointer: *u8 = _zag_malloc(1) as *u8;
        if (archive_identity(pointer) != pointer) {
            _zag_free(pointer as *i8);
            return 7;
        }
        _zag_free(pointer as *i8);
        return 42;
    }
}
