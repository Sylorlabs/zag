@import("std:driver") as driver
@import("std:driver_emulator") as emulator

// Minimal module used by the real Kbuild/QEMU lifecycle gate.  The probe
// executes the same pure-Zag driver metadata core that the userspace adapter
// imports; the only platform-owned operation is the explicit kernel symbol
// below. `schedule` is an exported zero-argument Linux symbol in the six
// supplied kernel/architecture trees, so this fixture does not accidentally
// depend on the x86-only `__cond_resched` export.
extern fn schedule() void @cabi;

fn kernel_core_probe() i32 @driver_init {
    return (emulator.emulator_run_differential_status(66, 64) == 1 &&
        emulator.emulator_run_fault_status() == 1) as i32;
}

pub @cabi_export @driver_init fn init_module() i32 {
    let core_ok: i32 = kernel_core_probe();
    unsafe { schedule(); }
    return (core_ok == 0) as i32;
}

pub @cabi_export @driver_teardown fn cleanup_module() void {
    return;
}

fn main() i32 {
    return 0;
}
