// Direct native object import: Zag retains code generation and emits one
// target call relocation (R_X86_64_PLT32 or R_AARCH64_CALL26) for this legacy
// C implementation boundary.
extern fn cabi_mul3(x: i64) i64 @cabi;

pub fn zag_then_c(x: i64) i64 @cabi_export {
    unsafe { return cabi_mul3(x) + 1; }
}
