// Native evidence that std:net_ipv4 preserves its descriptor-inheritance
// contract on Darwin even though XNU has no Linux accept4/SOCK_CLOEXEC ABI.

@import("std:net_ipv4") as net

extern fn _zag_darwin_syscall(num: i64, a1: i64, a2: i64, a3: i64,
                              a4: i64, a5: i64, a6: i64) i64

fn descriptor_is_cloexec(fd: i64) i32 {
    // Darwin SYS_fcntl=92, F_GETFD=1, FD_CLOEXEC=1.
    let flags: i64 = _zag_darwin_syscall(92, fd, 1, 0, 0, 0, 0);
    return (flags >= 0 && (flags & 1) == 1) as i32;
}

fn main() i32 {
    let loopback: net.NetIpv4Endpoint = net.net_ipv4_endpoint(
        net.net_ipv4_loopback(), 0
    );
    let listener_result: net.NetTcpListenerResult =
        net.net_tcp_listen_ipv4(loopback, 4, 1000);
    if (listener_result.ok == 0) { return 1; }
    let listener: net.NetTcpListener =
        net.net_tcp_listener_take(&listener_result);
    if (descriptor_is_cloexec(listener.fd) == 0) {
        net.net_tcp_listener_close(&listener);
        return 2;
    }

    let client_result: net.NetTcpStreamResult =
        net.net_tcp_connect_ipv4(listener.local, 1000);
    if (client_result.ok == 0) {
        net.net_tcp_listener_close(&listener);
        return 3;
    }
    let client: net.NetTcpStream = net.net_tcp_stream_take(&client_result);
    let server_result: net.NetTcpStreamResult =
        net.net_tcp_accept(&listener, 1000);
    if (server_result.ok == 0) {
        net.net_tcp_stream_close(&client);
        net.net_tcp_listener_close(&listener);
        return 4;
    }
    let server: net.NetTcpStream = net.net_tcp_stream_take(&server_result);
    if (descriptor_is_cloexec(client.fd) == 0 ||
        descriptor_is_cloexec(server.fd) == 0) {
        net.net_tcp_stream_close(&server);
        net.net_tcp_stream_close(&client);
        net.net_tcp_listener_close(&listener);
        return 5;
    }

    let udp_result: net.NetUdpSocketResult = net.net_udp_bind_ipv4(loopback, 1000);
    if (udp_result.ok == 0) {
        net.net_tcp_stream_close(&server);
        net.net_tcp_stream_close(&client);
        net.net_tcp_listener_close(&listener);
        return 6;
    }
    let udp: net.NetUdpSocket = net.net_udp_socket_take(&udp_result);
    if (descriptor_is_cloexec(udp.fd) == 0) { return 7; }

    if (net.net_udp_close(&udp) != net.net_status_ok() ||
        net.net_tcp_stream_close(&server) != net.net_status_ok() ||
        net.net_tcp_stream_close(&client) != net.net_status_ok() ||
        net.net_tcp_listener_close(&listener) != net.net_status_ok()) {
        return 8;
    }
    return 42;
}
