extern fn MTLCreateSystemDefaultDevice() *u8
extern fn sel_registerName(name:*i8) *u8
extern fn objc_msgSend(receiver:*u8,selector:*u8) *u8
extern fn _zag_slice_ptr(s:[]u8)*i8

fn main() i32 {
    let device:*u8=MTLCreateSystemDefaultDevice();
    if(device==null as *u8){return 1;}
    let selector:*u8=sel_registerName(_zag_slice_ptr("newCommandQueue\x00"));
    if(selector==null as *u8){return 2;}
    let queue:*u8=objc_msgSend(device,selector);
    if(queue==null as *u8){return 3;}
    return 42;
}
