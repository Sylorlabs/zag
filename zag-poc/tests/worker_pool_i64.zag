@import("std:worker_pool_i64") as pool
@import("std:rt")
@import("std:cancel_token_i64") as cancel

extern fn _zag_allocator_live_bytes() i64

fn main() i32 {
    let baseline: i64 = _zag_allocator_live_bytes();
    let invalid_empty: pool.WorkerPoolI64Result = pool.WorkerPoolI64Result{
        .ok = 0, .code = 0, .completed = 0, .workers = 0, .total = 0};
    unsafe {
        invalid_empty = pool.worker_pool_i64_run(null as *i64, 0, 2);
    }
    if (invalid_empty.ok != 0 ||
        invalid_empty.code != pool.worker_pool_i64_status_invalid_argument()) {
        return 1;
    }
    let invalid_count: pool.WorkerPoolI64Result = pool.WorkerPoolI64Result{
        .ok = 0, .code = 0, .completed = 0, .workers = 0, .total = 0};
    unsafe { invalid_count = pool.worker_pool_i64_run(null as *i64, 65, 2); }
    if (invalid_count.ok != 0 ||
        invalid_count.code != pool.worker_pool_i64_status_invalid_argument()) {
        return 2;
    }
    let invalid_workers: pool.WorkerPoolI64Result = pool.WorkerPoolI64Result{
        .ok = 0, .code = 0, .completed = 0, .workers = 0, .total = 0};
    unsafe { invalid_workers = pool.worker_pool_i64_run(null as *i64, 1, 9); }
    if (invalid_workers.ok != 0 ||
        invalid_workers.code != pool.worker_pool_i64_status_invalid_argument()) {
        return 3;
    }
    let address: i64 = _zag_raw_syscall(9, 0, 4096, 3, 34, 0 - 1, 0);
    if (address < 0) { return 4; }
    let jobs: *i64 = null as *i64;
    unsafe { jobs = (address + 2048) as *i64; }
    let i: i32 = 0;
    while (i < 16) { jobs[i] = (i + 1) as i64; i = i + 1; }
    let token: cancel.CancelTokenI64 = cancel.CancelTokenI64{
        .word = null as *i64, .open = 0};
    let token_word: *i64 = null as *i64;
    unsafe { token_word = (address + 1024) as *i64; }
    if (cancel.cancel_token_i64_init(&token, token_word) != 0) { return 5; }
    if (cancel.cancel_token_i64_request(&token) != 0) { return 6; }
    let cancelled: pool.WorkerPoolI64Result = pool.WorkerPoolI64Result{
        .ok = 0, .code = 0, .completed = 0, .workers = 0, .total = 0};
    unsafe { cancelled = pool.worker_pool_i64_run_cancel(jobs, 16, 4, &token); }
    if (cancelled.ok != 0 ||
        cancelled.code != pool.worker_pool_i64_status_cancelled() ||
        cancelled.completed != 0 || cancelled.workers != 4) { return 7; }
    if (cancel.cancel_token_i64_close(&token) != 0) { return 8; }
    let invalid_cancel: pool.WorkerPoolI64Result = pool.WorkerPoolI64Result{
        .ok = 0, .code = 0, .completed = 0, .workers = 0, .total = 0};
    unsafe { invalid_cancel = pool.worker_pool_i64_run_cancel(jobs, 16, 4, &token); }
    if (invalid_cancel.ok != 0 ||
        invalid_cancel.code != pool.worker_pool_i64_status_invalid_argument()) { return 9; }
    let result: pool.WorkerPoolI64Result = pool.WorkerPoolI64Result{
        .ok = 0, .code = 0, .completed = 0, .workers = 0, .total = 0};
    unsafe { result = pool.worker_pool_i64_run(jobs, 16, 4); }
    let unmap_rc: i64 = _zag_raw_syscall(11, address, 4096, 0, 0, 0, 0);
    if (unmap_rc != 0) { return 10; }
    if (result.ok == 0 || result.code != 0 || result.completed != 16 ||
        result.workers != 4 || result.total != 1512) { return 11; }
    if (_zag_allocator_live_bytes() != baseline) { return 12; }
    _zag_println("worker-pool jobs=16 workers=4 cancelled=1 total=1512");
    return 0;
}
