fn zez_bool_cmp_function(predicate:[]u8,left:[]u8,right:[]u8)ZFunc{
    let body:ZBlock=ZBlock{.ops=make[ZOp](4)};
    push[ZOp](&body.ops,zez_bool_const("lhs",left));
    push[ZOp](&body.ops,zez_bool_const("rhs",right));
    push[ZOp](&body.ops,zez_bool_cmp("result",predicate,"lhs","rhs"));
    push[ZOp](&body.ops,zez_bool_return("result"));
    return ZFunc{.name="bool-cmp",.params=make[ZVal](1),.ret="bool",.body=body,.effects=0,.origin=zez_origin(),.coverage_complete=1,.coverage_errors=0};
}
fn zez_bool_unary(name:[]u8,opname:[]u8,operand:[]u8)ZOp{let o:ZOp=zez_bool_base(opname);push[ZVal](&o.results,zez_bool_val(name));push[ZVal](&o.operands,zez_bool_val(operand));return o;}
fn zez_bool_bin(name:[]u8,opname:[]u8,left:[]u8,right:[]u8)ZOp{let o:ZOp=zez_bool_base(opname);push[ZVal](&o.results,zez_bool_val(name));push[ZVal](&o.operands,zez_bool_val(left));push[ZVal](&o.operands,zez_bool_val(right));return o;}
fn zez_bool_cmp(name:[]u8,predicate:[]u8,left:[]u8,right:[]u8)ZOp{let o:ZOp=zez_bool_bin(name,"arith.cmpi",left,right);push[ZAttr](&o.attrs,ZAttr{.key="predicate",.val=predicate});return o;}
fn zez_bool_predicate_function()ZFunc{
    let body:ZBlock=ZBlock{.ops=make[ZOp](8)};
    push[ZOp](&body.ops,zez_bool_const("false","0"));push[ZOp](&body.ops,zez_bool_const("true","1"));
    push[ZOp](&body.ops,zez_bool_unary("not_false","arith.not","false"));
    push[ZOp](&body.ops,zez_bool_bin("and_true","arith.andi","true","not_false"));
    push[ZOp](&body.ops,zez_bool_bin("or_true","arith.ori","false","and_true"));
    push[ZOp](&body.ops,zez_bool_cmp("eq_true","eq","or_true","true"));
    push[ZOp](&body.ops,zez_bool_cmp("ne_false","ne","false","false"));
    push[ZOp](&body.ops,zez_bool_return("ne_false"));
    return ZFunc{.name="bool-predicates",.params=make[ZVal](1),.ret="bool",.body=body,.effects=0,.origin=zez_origin(),.coverage_complete=1,.coverage_errors=0};
}
fn zez_bool_short_circuit_function()ZFunc{let f:ZFunc=zez_bool_predicate_function();let region:ZRegion=ZRegion{.blocks=make[ZBlock](1)};push[ZRegion](&f.body.ops.data[2].regions,region);f.body.ops.data[2].name="scf.if";return f;}
fn zez_bool_nonbool_function()ZFunc{let body:ZBlock=ZBlock{.ops=make[ZOp](4)};push[ZOp](&body.ops,zez_const("integer","1"));let o:ZOp=zez_bool_base("arith.andi");push[ZVal](&o.results,zez_bool_val("bad"));push[ZVal](&o.operands,zez_val("integer"));push[ZVal](&o.operands,zez_val("integer"));push[ZOp](&body.ops,o);push[ZOp](&body.ops,zez_bool_return("bad"));return ZFunc{.name="bool-nonbool",.params=make[ZVal](1),.ret="bool",.body=body,.effects=0,.origin=zez_origin(),.coverage_complete=1,.coverage_errors=0};}
