fn main()i32{
    let failures:i32=0;let f:ZFunc=zez_function();let result:ZeZirRegionResult=ze_zir_extract_function(f,64);
    zez_named(result.valid==1,"valid",&failures);zez_named(result.complete==1,"complete",&failures);zez_named(result.saturated==1,"saturated",&failures);zez_named(result.executable_authority==0,"non-authoritative",&failures);
    zez_named(result.accepted_ops==6,"accepted-ops",&failures);zez_named(result.rejected_ops==0,"rejected-ops",&failures);zez_named(result.first_result_class>=0,"first-class",&failures);zez_named(result.last_result_class>=0,"last-class",&failures);
    zez_named(ze_equivalent(&result.graph,result.first_result_class,result.last_result_class)==1,"equivalent",&failures);
    let integer_and_one:ZeGraph=ze_graph_new(8);let integer_twenty_one:i32=ze_add_const(&integer_and_one,21);let integer_one:i32=ze_add_const(&integer_and_one,1);let integer_and_one_expr:i32=ze_add_binary(&integer_and_one,ze_op_and(),integer_twenty_one,integer_one);ze_saturate(&integer_and_one);
    zez_named(integer_and_one_expr>=0&&ze_equivalent(&integer_and_one,integer_and_one_expr,integer_twenty_one)==0,"i32 21&1 is not 21",&failures);ze_graph_free(&integer_and_one);
