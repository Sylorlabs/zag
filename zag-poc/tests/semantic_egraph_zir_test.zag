@import("../selfhost/semantic_egraph_zir.zag")

fn zez_expect(value:i32,failures:*i32)void{if(value==0){_zag_println(_zag_str_concat("semantic egraph ZIR failed check ",_zag_i64_to_str((failures.*+1) as i64)));failures.*=failures.*+1;}}
fn zez_named(value:i32,name:[]u8,failures:*i32)void{if(value==0){_zag_println(_zag_str_concat("semantic egraph ZIR failed: ",name));failures.*=failures.*+1;}}
fn zez_origin()ZOrigin{return ZOrigin{.module="test",.line=1,.byte_start=0,.byte_end=1,.stable_id=1,.complete=1,.exact=1};}
fn zez_val(name:[]u8)ZVal{return ZVal{.name=name,.ty="i32",.ownership="ssa",.alias_region="none",.lifetime="function",.layout="target-default",.origin=zez_origin()};}
fn zez_i64_val(name:[]u8)ZVal{return ZVal{.name=name,.ty="i64",.ownership="ssa",.alias_region="none",.lifetime="function",.layout="target-default",.origin=zez_origin()};}
fn zez_bool_val(name:[]u8)ZVal{return ZVal{.name=name,.ty="bool",.ownership="ssa",.alias_region="none",.lifetime="function",.layout="target-default",.origin=zez_origin()};}
fn zez_base(name:[]u8)ZOp{return ZOp{.name=name,.results=make[ZVal](2),.operands=make[ZVal](2),.attrs=make[ZAttr](1),.regions=make[ZRegion](1),.effects=0,.reads="none",.writes="none",.origin=zez_origin()};}
fn zez_i64_base(name:[]u8)ZOp{return ZOp{.name=name,.results=make[ZVal](2),.operands=make[ZVal](2),.attrs=make[ZAttr](1),.regions=make[ZRegion](1),.effects=0,.reads="none",.writes="none",.origin=zez_origin()};}
fn zez_bool_base(name:[]u8)ZOp{return ZOp{.name=name,.results=make[ZVal](2),.operands=make[ZVal](2),.attrs=make[ZAttr](1),.regions=make[ZRegion](1),.effects=0,.reads="none",.writes="none",.origin=zez_origin()};}
fn zez_const(name:[]u8,value:[]u8)ZOp{let o:ZOp=zez_base("arith.constant");push[ZVal](&o.results,zez_val(name));push[ZAttr](&o.attrs,ZAttr{.key="value",.val=value});return o;}
fn zez_i64_const(name:[]u8,value:[]u8)ZOp{let o:ZOp=zez_i64_base("arith.constant");push[ZVal](&o.results,zez_i64_val(name));push[ZAttr](&o.attrs,ZAttr{.key="value",.val=value});return o;}
fn zez_bool_const(name:[]u8,value:[]u8)ZOp{let o:ZOp=zez_bool_base("arith.constant");push[ZVal](&o.results,zez_bool_val(name));push[ZAttr](&o.attrs,ZAttr{.key="value",.val=value});return o;}
fn zez_bin(name:[]u8,opname:[]u8,left:[]u8,right:[]u8)ZOp{let o:ZOp=zez_base(opname);push[ZVal](&o.results,zez_val(name));push[ZVal](&o.operands,zez_val(left));push[ZVal](&o.operands,zez_val(right));return o;}
fn zez_unary(name:[]u8,opname:[]u8,value:[]u8)ZOp{let o:ZOp=zez_base(opname);push[ZVal](&o.results,zez_val(name));push[ZVal](&o.operands,zez_val(value));return o;}
fn zez_i64_bin(name:[]u8,opname:[]u8,left:[]u8,right:[]u8)ZOp{let o:ZOp=zez_i64_base(opname);push[ZVal](&o.results,zez_i64_val(name));push[ZVal](&o.operands,zez_i64_val(left));push[ZVal](&o.operands,zez_i64_val(right));return o;}
fn zez_i64_unary(name:[]u8,opname:[]u8,value:[]u8)ZOp{let o:ZOp=zez_i64_base(opname);push[ZVal](&o.results,zez_i64_val(name));push[ZVal](&o.operands,zez_i64_val(value));return o;}
fn zez_shift(name:[]u8,opname:[]u8,left:[]u8,right:[]u8,width:[]u8)ZOp{let o:ZOp=zez_bin(name,opname,left,right);push[ZAttr](&o.attrs,ZAttr{.key="width",.val=width});return o;}
fn zez_i64_shift(name:[]u8,opname:[]u8,left:[]u8,right:[]u8,width:[]u8)ZOp{let o:ZOp=zez_i64_bin(name,opname,left,right);push[ZAttr](&o.attrs,ZAttr{.key="width",.val=width});return o;}
fn zez_return(name:[]u8)ZOp{let o:ZOp=zez_base("func.return");push[ZVal](&o.operands,zez_val(name));return o;}
fn zez_i64_return(name:[]u8)ZOp{let o:ZOp=zez_i64_base("func.return");push[ZVal](&o.operands,zez_i64_val(name));return o;}
fn zez_bool_return(name:[]u8)ZOp{let o:ZOp=zez_bool_base("func.return");push[ZVal](&o.operands,zez_bool_val(name));return o;}
fn zez_function()ZFunc{let body:ZBlock=ZBlock{.ops=make[ZOp](8)};push[ZOp](&body.ops,zez_const("a","2"));push[ZOp](&body.ops,zez_const("b","3"));push[ZOp](&body.ops,zez_const("z","0"));push[ZOp](&body.ops,zez_bin("sum","arith.addi","a","b"));push[ZOp](&body.ops,zez_bin("same","arith.subi","sum","z"));push[ZOp](&body.ops,zez_return("same"));return ZFunc{.name="main",.params=make[ZVal](1),.ret="i32",.body=body,.effects=0,.origin=zez_origin(),.coverage_complete=1,.coverage_errors=0};}
fn zez_fold_function()ZFunc{let body:ZBlock=ZBlock{.ops=make[ZOp](4)};push[ZOp](&body.ops,zez_const("a","2"));push[ZOp](&body.ops,zez_const("b","3"));push[ZOp](&body.ops,zez_bin("sum","arith.addi","a","b"));push[ZOp](&body.ops,zez_return("sum"));return ZFunc{.name="fold",.params=make[ZVal](1),.ret="i32",.body=body,.effects=0,.origin=zez_origin(),.coverage_complete=1,.coverage_errors=0};}
fn zez_arith_overflow_function(opname:[]u8,left:[]u8,right:[]u8)ZFunc{let body:ZBlock=ZBlock{.ops=make[ZOp](4)};push[ZOp](&body.ops,zez_const("a",left));push[ZOp](&body.ops,zez_const("b",right));push[ZOp](&body.ops,zez_bin("bad",opname,"a","b"));push[ZOp](&body.ops,zez_return("bad"));return ZFunc{.name="overflow",.params=make[ZVal](1),.ret="i32",.body=body,.effects=0,.origin=zez_origin(),.coverage_complete=1,.coverage_errors=0};}
fn zez_neg_function(value:[]u8)ZFunc{let body:ZBlock=ZBlock{.ops=make[ZOp](4)};push[ZOp](&body.ops,zez_const("a",value));push[ZOp](&body.ops,zez_unary("neg","arith.negsi","a"));push[ZOp](&body.ops,zez_return("neg"));return ZFunc{.name="neg",.params=make[ZVal](1),.ret="i32",.body=body,.effects=0,.origin=zez_origin(),.coverage_complete=1,.coverage_errors=0};}
fn zez_division_function()ZFunc{let body:ZBlock=ZBlock{.ops=make[ZOp](8)};push[ZOp](&body.ops,zez_const("a","8"));push[ZOp](&body.ops,zez_const("b","2"));push[ZOp](&body.ops,zez_const("c","3"));push[ZOp](&body.ops,zez_bin("quotient","arith.divsi","a","b"));push[ZOp](&body.ops,zez_bin("remainder","arith.remsi","a","c"));push[ZOp](&body.ops,zez_return("remainder"));return ZFunc{.name="division",.params=make[ZVal](1),.ret="i32",.body=body,.effects=0,.origin=zez_origin(),.coverage_complete=1,.coverage_errors=0};}
