fn zez_xor_function()ZFunc{let body:ZBlock=ZBlock{.ops=make[ZOp](4)};push[ZOp](&body.ops,zez_const("left","21"));push[ZOp](&body.ops,zez_const("right","63"));push[ZOp](&body.ops,zez_bin("xor","arith.xori","left","right"));push[ZOp](&body.ops,zez_return("xor"));return ZFunc{.name="xor",.params=make[ZVal](1),.ret="i32",.body=body,.effects=0,.origin=zez_origin(),.coverage_complete=1,.coverage_errors=0};}
fn zez_i64_xor_function()ZFunc{let body:ZBlock=ZBlock{.ops=make[ZOp](4)};push[ZOp](&body.ops,zez_i64_const("left","21"));push[ZOp](&body.ops,zez_i64_const("right","63"));push[ZOp](&body.ops,zez_i64_bin("xor","arith.xori","left","right"));push[ZOp](&body.ops,zez_i64_return("xor"));return ZFunc{.name="i64-xor",.params=make[ZVal](1),.ret="i64",.body=body,.effects=0,.origin=zez_origin(),.coverage_complete=1,.coverage_errors=0};}
