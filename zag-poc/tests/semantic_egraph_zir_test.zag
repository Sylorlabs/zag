fn zez_shift_function(opname:[]u8,left:[]u8,right:[]u8,width:[]u8)ZFunc{let body:ZBlock=ZBlock{.ops=make[ZOp](4)};push[ZOp](&body.ops,zez_const("value",left));push[ZOp](&body.ops,zez_const("count",right));push[ZOp](&body.ops,zez_shift("shift",opname,"value","count",width));push[ZOp](&body.ops,zez_return("shift"));return ZFunc{.name="shift",.params=make[ZVal](1),.ret="i32",.body=body,.effects=0,.origin=zez_origin(),.coverage_complete=1,.coverage_errors=0};}
