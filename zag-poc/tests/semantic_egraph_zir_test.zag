fn zez_division_overflow_function()ZFunc{let body:ZBlock=ZBlock{.ops=make[ZOp](8)};push[ZOp](&body.ops,zez_const("min","-2147483648"));push[ZOp](&body.ops,zez_const("minus_one","-1"));push[ZOp](&body.ops,zez_bin("bad","arith.divsi","min","minus_one"));push[ZOp](&body.ops,zez_return("bad"));return ZFunc{.name="division-overflow",.params=make[ZVal](1),.ret="i32",.body=body,.effects=0,.origin=zez_origin(),.coverage_complete=1,.coverage_errors=0};}
