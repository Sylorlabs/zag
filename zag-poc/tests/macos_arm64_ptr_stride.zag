// Regression for the arm64 pointer-stride fix: `p + n` / `p - n` on a typed
// `*T` must scale the integer operand by the element stride — the same
// stride `p[i]` uses — so `p + n` computes `&p[n]` (V2_MEMORY_MODEL: pointer
// add/subtract scales by size_of(T)). The arm64 backend previously lowered
// pointer arithmetic as a raw byte add, so `p + 2` landed two BYTES after
// `p` instead of at the third element. Returns the first failing case.
//
// macos-arm64 only: the x86 backend retains the historical byte-arithmetic
// lowering, so this contract is asserted on the arm64 path where G11 landed.

struct Quad { a: i64, b: i64, c: i64, d: i64 }

fn main() i32 {
    let q: *Quad = new(Quad{ .a = 11, .b = 22, .c = 33, .d = 44 });
    let p: *i64 = &q.*.a;
    if (p[0] != 11 || p[3] != 44) { return 1; }      // indexing sanity
    if ((p + 2).* != 33) { return 2; }               // p + n == &p[n]
    if ((p + 0).* != 11) { return 3; }
    let t: *i64 = p + 3;
    if (t.* != 44) { return 4; }
    if (t[0] != 44) { return 5; }
    if (((p + 3) - 1).* != 33) { return 6; }          // p - n == &p[-n]
    if ((t - 2).* != 22) { return 7; }
    // A *u8 pointer keeps byte arithmetic: stride 1 under both readings.
    let u: *u8 = (&q.*.a) as *u8;
    if ((u + 8).* != 22) { return 8; }
    return 42;
}
