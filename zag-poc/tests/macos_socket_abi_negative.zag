// The Linux-shaped raw syscall boundary is translated only for the exact
// IPv4 tuples used by std:net_ipv4. Values outside that profile must fail
// closed instead of selecting a numerically unrelated XNU operation.

extern fn _zag_raw_syscall(num: i64, a1: i64, a2: i64, a3: i64,
                           a4: i64, a5: i64, a6: i64) i64

fn rejected(result: i64) i32 {
    return (result == 0 - 78) as i32;
}

fn main() i32 {
    let pollfd: u64 = 4294967295 | (1 << 32);
    if (rejected(_zag_raw_syscall(
            7, (&pollfd) as i64, 2, 100, 0, 0, 0
        )) == 0) {
        return 1;
    }

    // Only AF_INET, SOCK_STREAM/SOCK_DGRAM plus Linux SOCK_CLOEXEC, and
    // protocol zero belong to the portable std:net_ipv4 socket profile.
    if (rejected(_zag_raw_syscall(41, 30, 524289, 0, 0, 0, 0)) == 0) {
        return 2;
    }
    if (rejected(_zag_raw_syscall(41, 2, 524291, 0, 0, 0, 0)) == 0) {
        return 3;
    }
    if (rejected(_zag_raw_syscall(41, 2, 524289, 6, 0, 0, 0)) == 0) {
        return 4;
    }

    // Linux and Darwin reuse these operation names with different option and
    // flag values. Reject every unaudited tuple before consulting the fd.
    if (rejected(_zag_raw_syscall(54, 0 - 1, 2, 20, 0, 16, 0)) == 0) {
        return 5;
    }
    if (rejected(_zag_raw_syscall(54, 0 - 1, 1, 99, 0, 4, 0)) == 0) {
        return 6;
    }
    let socket_error: i64 = 0;
    let socket_error_length: i64 = 4;
    if (rejected(_zag_raw_syscall(
            55, 0 - 1, 1, 99, (&socket_error) as i64,
            (&socket_error_length) as i64, 0
        )) == 0) {
        return 7;
    }
    if (rejected(_zag_raw_syscall(49, 0 - 1, 0, 8, 0, 0, 0)) == 0) {
        return 8;
    }
    if (rejected(_zag_raw_syscall(42, 0 - 1, 0, 8, 0, 0, 0)) == 0) {
        return 9;
    }
    if (rejected(_zag_raw_syscall(288, 0 - 1, 0, 0, 0, 0, 0)) == 0) {
        return 10;
    }
    if (rejected(_zag_raw_syscall(44, 0 - 1, 0, 0, 64, 0, 0)) == 0) {
        return 11;
    }
    if (rejected(_zag_raw_syscall(45, 0 - 1, 0, 0, 64, 0, 0)) == 0) {
        return 12;
    }
    return 42;
}
