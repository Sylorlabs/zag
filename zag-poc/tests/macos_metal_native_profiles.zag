// Physical Apple-Silicon witness for the same reviewed fill/depth/blend kernel
// profiles accepted by the Linux GFX10.1 native slice. The MSL files are
// produced by `znc --target gpu-metal` before this executable is built.
@import("std:metal_loader") as metal

extern fn _zag_malloc(bytes:i64) *u8;
extern fn _zag_free(value:*u8) void;

fn main() i32 {
    if (_zag_argc()<3) { return 1; }
    let depth_raw:[]u8=_zag_read_file(_zag_arg(1));
    let blend_raw:[]u8=_zag_read_file(_zag_arg(2));
    if (depth_raw.len<=0 || blend_raw.len<=0) { return 2; }
    let depth_source:[]u8=_zag_str_concat(depth_raw,"\x00");
    let blend_source:[]u8=_zag_str_concat(blend_raw,"\x00");

    if (!metal.zag_metal_available()) { return 3; }
    let ctx:metal.ZagMetalCompatContext=metal.zag_metal_open();
    if (!metal.zag_metal_is_open(&ctx)) { return 4; }

    // Native Zag numeric pointers use the same eight-byte word stride as
    // numeric slices on both x86 and ARM64. The Metal adapter packs those
    // words into native 32-bit Metal buffers at the API boundary.
    let color_storage:*u8=_zag_malloc(64);
    let depth_storage:*u8=_zag_malloc(64);
    if (color_storage==null as *u8 || depth_storage==null as *u8) {
        if (color_storage!=null as *u8) { _zag_free(color_storage); }
        if (depth_storage!=null as *u8) { _zag_free(depth_storage); }
        metal.zag_metal_close(&ctx);
        return 5;
    }
    let color:*i32=color_storage as *i32;
    let depth:*i32=depth_storage as *i32;
    let i:i32=0;
    while(i<8){color[i]=1;depth[i]=100;i=i+1;}
    depth[3]=10;
    if(color[0]!=1||depth[0]!=100||color[7]!=1||depth[7]!=100){
        _zag_free(color_storage);_zag_free(depth_storage);metal.zag_metal_close(&ctx);return 14;
    }
    let depth_rc:i32=metal.zag_metal_dispatch_depth_source(&ctx,depth_source,
        "depthWriteKernel\x00",color,depth,8,0xCAFE,50,8,1,1,0);
    if(depth_rc!=metal.zag_metal_status_ok()){
        _zag_free(color_storage);_zag_free(depth_storage);metal.zag_metal_close(&ctx);return 6;
    }
    i=0;
    while(i<8){
        if(i==3){
            if(color[i]!=1||depth[i]!=10){_zag_free(color_storage);_zag_free(depth_storage);metal.zag_metal_close(&ctx);return 7;}
        }else{
            if(color[i]!=0xCAFE||depth[i]!=50){_zag_free(color_storage);_zag_free(depth_storage);metal.zag_metal_close(&ctx);return 8;}
        }
        i=i+1;
    }

    i=0;
    while(i<4){color[i]=0x204060;depth[i]=100;i=i+1;}
    depth[3]=10;
    let blend_rc:i32=metal.zag_metal_dispatch_blend_source(&ctx,blend_source,
        "blendDepthKernel\x00",color,depth,4,0x80C020,50,128,4,1,1,0);
    if(blend_rc!=metal.zag_metal_status_ok()){
        _zag_free(color_storage);_zag_free(depth_storage);metal.zag_metal_close(&ctx);return 9;
    }
    if(color[0]!=0x508040||color[1]!=0x508040||color[2]!=0x508040||
        color[3]!=0x204060||depth[0]!=50||depth[1]!=50||depth[2]!=50||depth[3]!=10){
        _zag_free(color_storage);_zag_free(depth_storage);metal.zag_metal_close(&ctx);return 10;
    }

    color[0]=0x123456;depth[0]=10;
    let zero_rc:i32=metal.zag_metal_dispatch_blend_source(&ctx,blend_source,
        "blendDepthKernel\x00",color,depth,1,0xFFFFFF,5,0,1,1,1,0);
    if(zero_rc!=metal.zag_metal_status_ok()||color[0]!=0x123456||depth[0]!=5){
        _zag_free(color_storage);_zag_free(depth_storage);metal.zag_metal_close(&ctx);return 11;
    }
    color[0]=0x123456;depth[0]=10;
    let full_rc:i32=metal.zag_metal_dispatch_blend_source(&ctx,blend_source,
        "blendDepthKernel\x00",color,depth,1,0xABCDEF,4,256,1,1,1,0);
    if(full_rc!=metal.zag_metal_status_ok()||color[0]!=0xABCDEF||depth[0]!=4){
        _zag_free(color_storage);_zag_free(depth_storage);metal.zag_metal_close(&ctx);return 12;
    }
    let bad_alpha:i32=metal.zag_metal_dispatch_blend_source(&ctx,blend_source,
        "blendDepthKernel\x00",color,depth,1,7,1,257,1,1,1,0);
    if(bad_alpha!=metal.zag_metal_status_invalid_argument()){
        _zag_free(color_storage);_zag_free(depth_storage);metal.zag_metal_close(&ctx);return 13;
    }

    _zag_free(color_storage);_zag_free(depth_storage);
    metal.zag_metal_close(&ctx);
    return 42;
}
