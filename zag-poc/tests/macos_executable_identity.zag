@import("../std/rt.zag")

// Current Darwin lowering must replace this bootstrap fallback. Returning
// argv[0] here would make the PATH and symlink witnesses falsely pass.
fn _zag_current_executable_path()[]u8{return "";}

fn main()i32{
    if(_zag_argc()!=2){return 2;}
    let path:[]u8=_zag_current_executable_path();
    if(path.len==0||path[0]!='/'){return 3;}
    if(!@strEq(path,_zag_arg(1))){_zag_println(path);return 4;}
    let image:[]u8=_zag_read_file(path);
    if(image.len<4){return 5;}
    let valid:i32=(image[0]==207&&image[1]==250&&image[2]==237&&image[3]==254) as i32;
    _zag_free(_zag_slice_ptr(image));_zag_free(_zag_slice_ptr(path));
    if(valid==0){return 6;}return 0;
}
