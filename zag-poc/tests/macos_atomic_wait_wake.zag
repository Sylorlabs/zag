// Native Darwin wait/wake witness. Two pthread-backed workers register on the
// same i32 address; the parent wakes them one at a time and verifies both the
// wake count and raw wait return value.
global let wait_word:i32;
global let wait_ready:i64;
global let wait_completed:i64;
global let wait_errors:i64;

fn wait_worker() void {
    unsafe {
        let ready:*mut i64 = (&wait_ready) as *mut i64;
        let _ready_old:i64 = @atomicFetchAdd64(ready, 1);
        let word:*mut i32 = (&wait_word) as *mut i32;
        let rc:i64 = @atomicWait32(word, 0);
        if (rc == 0) {
            let completed:*mut i64 = (&wait_completed) as *mut i64;
            let _completed_old:i64 = @atomicFetchAdd64(completed, 1);
        } else {
            let errors:*mut i64 = (&wait_errors) as *mut i64;
            let _error_old:i64 = @atomicFetchAdd64(errors, 1);
        }
    }
}

fn main() i32 {
    unsafe {
        let a:*opaque = @threadSpawn(wait_worker);
        let b:*opaque = @threadSpawn(wait_worker);
        let ready:*const i64 = (&wait_ready) as *const i64;
        let spins:i64 = 0;
        while (@atomicLoad64(ready) != 2 && spins < 1000000) { spins = spins + 1; }

        let word:*mut i32 = (&wait_word) as *mut i32;
        let first:i64 = 0;
        let tries1:i64 = 0;
        if (@atomicLoad64(ready) == 2) {
            while (first == 0 && tries1 < 1000000) { first = @atomicWake32(word, 1); tries1 = tries1 + 1; }
        }
        let second:i64 = 0;
        let tries2:i64 = 0;
        if (first == 1) {
            while (second == 0 && tries2 < 1000000) { second = @atomicWake32(word, 1); tries2 = tries2 + 1; }
        }

        // Ensure a failed bounded wake attempt cannot strand either worker.
        // A late waiter observes 1 != expected 0 and returns -EAGAIN; an
        // already-enqueued waiter is explicitly signalled here.
        wait_word = 1;
        let _release:i64 = @atomicWake32(word, 2);

        @threadJoin(a);
        @threadJoin(b);
        let completed:*const i64 = (&wait_completed) as *const i64;
        let errors:*const i64 = (&wait_errors) as *const i64;
        if (@atomicLoad64(ready) != 2) { return 2; }
        if (first != 1) { return 3; }
        if (second != 1) { return 4; }
        if (@atomicLoad64(completed) != 2 || @atomicLoad64(errors) != 0) { return 5; }

        let mismatch:i64 = @atomicWait32(word, 0);
        let none:i64 = @atomicWake32(word, 1);
        if (mismatch != -11 || none != 0) { return 6; }
        return 42;
    }
}
