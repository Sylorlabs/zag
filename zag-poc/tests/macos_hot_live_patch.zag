@import("../selfhost/native/hot_rt_macos.zag")

// Same declaration and data layout as macos_hot_live.zag. Only this immediate
// changes, so the live-patch gate can prove an in-place native text swap.
fn value() i32 { return 2; }
fn stable() i32 { return 7; }

fn main() i32 {
    while (zag_hot_should_continue()) {
        if (value() == 2 && stable() == 7) { return 42; }
        zag_hot_wait();
    }
    return 1;
}
