@import("../selfhost/script_auto_lower.zag")
@import("../selfhost/fmt.zag")

fn alt_dump(decls:ArrayList[*Node])[]u8 {
    let out:ArrayList[u8]=make[u8](1024);let i:i32=0;while(i<decls.len){fmt_decl(&out,decls.data[i]);i=i+1;}return out.data[0..out.len];
}
fn alt_expect(ok:bool,label:[]u8,fail:*i32)void {
    if(ok){_zag_println(_zag_str_concat("ok  ",label));}else{_zag_eprintln(_zag_str_concat("FAIL ",label));fail.*=fail.*+1;}
}
fn alt_reject(source:[]u8)bool {
    let decls:ArrayList[*Node]=parse_program(source);let before:[]u8=alt_dump(decls);let count:i32=decls.len;
    let errors:i32=script_auto_lower(&decls,"compiler","source","target");
    return errors>0&&decls.len==count&&@strEq(before,alt_dump(decls));
}
fn alt_markers(decls:ArrayList[*Node])i32 {
    let s:SalState=SalState{.markers=make[*Node](8),.names=make[[]u8](64),.errors=0,.reserved_binding=0,.visits=0};
    sal_body(decls,&s,0);return s.markers.len+s.errors;
}
fn alt_many(count:i32,inputs:i32)ArrayList[*Node] {
    let decls:ArrayList[*Node]=parse_program("fn main()i64{return 0;}");
    switch(decls.data[0].*){.fn_decl=>|f|{
        let i:i32=0;while(i<count){let args:ArrayList[*Node]=make[*Node](3);
            if(inputs==2){push[*Node](&args,mk_str("\"x y +\""));push[*Node](&args,mk_int("1"));push[*Node](&args,mk_int("2"));}
            else{push[*Node](&args,mk_str("\"0\""));}
            push[*Node](&f.body,new(Node{.estmt=ExprStmt{.expr=mk_call(mk_ident("script_auto_u4"),args)}}));i=i+1;
        }decls.data[0].*=Node{.fn_decl=f};
    }else=>{}}return decls;
}
fn alt_source_work(decls:ArrayList[*Node])i64 {
    let s:SalState=SalState{.markers=make[*Node](8),.names=make[[]u8](64),.errors=0,.reserved_binding=0,.visits=0};
    sal_body(decls,&s,0);return sal_source_work(s.markers,"compiler","source","target");
}
fn alt_comment_record(record:ScriptAutoLowerRecord)void {
    _zag_print("// auto-symbol: ");_zag_println(record.symbol);
    let i:i32=0;_zag_print("// auto-record: ");
    while(i<record.record.len){let ch:u8=record.record[i];_zag_print(record.record[i..i+1]);
        if(ch==10&&i+1<record.record.len){_zag_print("// auto-record: ");}i=i+1;
    }_zag_println("");
}
fn main()i32 {
    if(_zag_argc()==3&&(@strEq(_zag_arg(1),"--lower")||@strEq(_zag_arg(1),"--artifact"))){
        let source:[]u8=_zag_read_file(_zag_arg(2));let decls:ArrayList[*Node]=parse_program(source);
        let records:ArrayList[ScriptAutoLowerRecord]=make[ScriptAutoLowerRecord](8);
        if(script_auto_lower_with_records(&decls,"compiler","source","portable-u4",&records)!=0){return 1;}
        if(@strEq(_zag_arg(1),"--artifact")){let i:i32=0;while(i<records.len){alt_comment_record(records.data[i]);i=i+1;}}
        _zag_print(alt_dump(decls));return 0;
    }
    let fail:i32=0;
    let decls:ArrayList[*Node]=parse_program("fn main() i64 { return script_auto_u4(\"x 0 + y *\", 3, 5); }");
    let records:ArrayList[ScriptAutoLowerRecord]=make[ScriptAutoLowerRecord](2);
    let errors:i32=script_auto_lower_with_records(&decls,"compiler","source","target",&records);
    alt_expect(errors==0&&decls.len==2&&records.len==1&&alt_markers(decls)==0,"literal opt-in lowers to ordinary function and call",&fail);
    alt_expect(@strEq(records.data[0].symbol,"__zag_auto_u4_generated_0"),"deterministic generated symbol",&fail);
    let config:ScriptAutoConfig=ScriptAutoConfig{.bits=4,.variables=2,.work_budget=20000000,.source_id="source",.compiler_id="compiler",.target_id="target"};
    alt_expect(script_auto_verify_record(records.data[0].reference,config,records.data[0].record)==1,"lowering retains independently replayable engine evidence",&fail);
    let origin_ok:bool=false;switch(decls.data[1].*){.fn_decl=>|f|{origin_ok=f.line==0&&@strEq(f.origin,"<script-auto-generated>")&&@strEq(f.ret,"i64")&&f.params.len==2;}else=>{}}
    alt_expect(origin_ok,"generated provenance is explicitly synthetic",&fail);
    let once:[]u8=alt_dump(decls);let old_count:i32=decls.len;
    alt_expect(script_auto_lower(&decls,"compiler","source","target")==0&&decls.len==old_count&&@strEq(once,alt_dump(decls)),"second lowering is idempotent",&fail);
    let second:ArrayList[*Node]=parse_program("fn main() i64 { return script_auto_u4(\"x 0 + y *\", 3, 5); }");
    alt_expect(script_auto_lower(&second,"compiler","source","target")==0&&@strEq(once,alt_dump(second)),"independent lowering is deterministic",&fail);
    let collision:ArrayList[*Node]=parse_program("fn __zag_auto_u4_generated_0() i64 { return 7; } fn main() i64 { let __zag_auto_u4_generated_1:i64=0; return __zag_auto_u4(\"x\", 4); }");
    let cr:ArrayList[ScriptAutoLowerRecord]=make[ScriptAutoLowerRecord](1);
    alt_expect(script_auto_lower_with_records(&collision,"compiler","source","target",&cr)==0&&@strEq(cr.data[0].symbol,"__zag_auto_u4_generated_2"),"generated names avoid function and local bindings",&fail);
    let nested:ArrayList[*Node]=parse_program("fn main() i64 { return __zag_auto_u4(\"x y +\", script_auto_u4(\"x x *\",3), __zag_auto_u4(\"15 1 +\")); }");
    alt_expect(script_auto_lower(&nested,"compiler","source","target")==0&&nested.len==4&&alt_markers(nested)==0,"nested zero unary binary markers lower completely",&fail);
    alt_expect(alt_reject("fn main() i64 { let ref:[]u8=\"x\"; return __zag_auto_u4(ref,3); }"),"computed reference rejected atomically",&fail);
    alt_expect(alt_reject("fn main() i64 { return __zag_auto_u4(\"dot\",3); }"),"function name is not a semantic reference",&fail);
    alt_expect(alt_reject("fn main() i64 { return __zag_auto_u4(); }"),"missing reference rejected",&fail);
    alt_expect(alt_reject("fn main() i64 { return __zag_auto_u4(\"x\",1,2,3); }"),"excess input arity rejected",&fail);
    alt_expect(alt_reject("fn main() i64 { return __zag_auto_u4[i64](\"x\",1); }"),"type arguments rejected",&fail);
    alt_expect(alt_reject("fn main() i64 { return __zag_auto_u4(\"y\",1); }"),"reference cannot use undeclared y",&fail);
    alt_expect(alt_reject("fn main() i64 { let a:i64=__zag_auto_u4(\"x\",1); return __zag_auto_u4(\"x y /\",1,2); }"),"later invalid reference rolls back earlier staged candidate",&fail);
    alt_expect(alt_reject("fn script_auto_u4(x:i64) i64{return x;} fn main() i64{return script_auto_u4(\"x\",1);}"),"declared marker spelling rejected",&fail);
    alt_expect(alt_reject("fn main(script_auto_u4:fn(i64)i64) i64{return script_auto_u4(\"x\",1);}"),"parameter shadow rejected",&fail);
    alt_expect(alt_reject("fn main() i64{let script_auto_u4:i64=0;return script_auto_u4(\"x\",1);}"),"local shadow rejected",&fail);
    alt_expect(alt_reject("fn main() i64{let f=__zag_auto_u4;return 0;}"),"indirect marker use rejected",&fail);
    let plain:ArrayList[*Node]=parse_program("fn main() i64{return 3;}");let plain_before:[]u8=alt_dump(plain);
    alt_expect(script_auto_lower(&plain,"","","")==0&&@strEq(plain_before,alt_dump(plain)),"no opt-in leaves ordinary program alone",&fail);
    let bad_ids:ArrayList[*Node]=parse_program("fn main() i64{return __zag_auto_u4(\"x\",3);}");let ids_before:[]u8=alt_dump(bad_ids);
    alt_expect(script_auto_lower(&bad_ids,"","source","target")>0&&@strEq(ids_before,alt_dump(bad_ids)),"bad identities reject without AST mutation",&fail);
    let escaped:ArrayList[*Node]=parse_program("fn main() i64{return __zag_auto_u4(\"x\\t0\\n+\",3);}");
    alt_expect(script_auto_lower(&escaped,"compiler","source","target")==0,"whitespace escapes decoded before verification",&fail);
    // Exercise all expression and statement containers, even ones that this
    // deliberately syntax-only fixture cannot pass a separate type checker.
    let containers:ArrayList[*Node]=parse_program("struct R{v:i64} fn f(x:i64) i64 { let a=R{.v=__zag_auto_u4(\"x\",x)}; a.v=__zag_auto_u4(\"x\",x); if(__zag_auto_u4(\"x\",x)>0){return __zag_auto_u4(\"x\",x);}else{defer __zag_auto_u4(\"x\",x);} while(__zag_auto_u4(\"x\",x)>0){break;} unsafe{__zag_auto_u4(\"x\",x);} let z=a[__zag_auto_u4(\"x\",x)]; let q=a[__zag_auto_u4(\"x\",x)..__zag_auto_u4(\"x\",x)]; return (__zag_auto_u4(\"x\",x) as i64); }");
    alt_expect(script_auto_lower(&containers,"compiler","source","target")==0&&alt_markers(containers)==0&&containers.len==13,"traversal covers statement and aggregate containers",&fail);
    let single:ArrayList[*Node]=alt_many(1,2);
    let baseline:ScriptAutoResult=script_auto_optimize("x y +",config);
    alt_expect(alt_source_work(single)==baseline.work_bound,"source preflight matches engine work accounting",&fail);
    let permitted:ArrayList[*Node]=alt_many(13,2);
    alt_expect(alt_source_work(permitted)==19478784&&script_auto_lower(&permitted,"compiler","source","target")==0&&permitted.len==14,"13 binary markers fit aggregate budget",&fail);
    let excess:ArrayList[*Node]=alt_many(14,2);let excess_before:[]u8=alt_dump(excess);
    let retained:ArrayList[ScriptAutoLowerRecord]=make[ScriptAutoLowerRecord](1);
    push[ScriptAutoLowerRecord](&retained,records.data[0]);
    alt_expect(alt_source_work(excess)==20977152&&script_auto_lower_with_records(&excess,"compiler","source","target",&retained)>0&&excess.len==1&&@strEq(excess_before,alt_dump(excess))&&retained.len==1,"14 binary markers fail before mutation preserving prior evidence",&fail);
    let small:ArrayList[*Node]=alt_many(64,0);
    alt_expect(script_auto_lower(&small,"compiler","source","target")==0&&small.len==65,"64 cheap markers remain within aggregate budget",&fail);
    let too_many:ArrayList[*Node]=alt_many(65,0);let too_before:[]u8=alt_dump(too_many);
    alt_expect(script_auto_lower(&too_many,"compiler","source","target")>0&&too_many.len==1&&@strEq(too_before,alt_dump(too_many)),"marker count bound is independently enforced",&fail);
    script_auto_result_free(&baseline);
    if(fail!=0){return 1;}_zag_println("script auto lower unit: PASS");return 0;
}
