@import("std:list")
@import("std:rt")
@import("../selfhost/native/aarch64.zag")
@import("../selfhost/native/aisa.zag")
@import("../selfhost/native/elf.zag")
@import("../selfhost/native/elf_arm64.zag")

fn main() i32 {
    if (_zag_argc() != 2) { return 1; }
    let program: ArrayList[AInstr] = make[AInstr](16);
    push[AInstr](&program, ai_mov_imm(A_X10(), ADVBASE()));
    push[AInstr](&program, ai_vloadq(0, A_X10(), 0));
    push[AInstr](&program, ai_vloadq(1, A_X10(), 16));
    push[AInstr](&program, ai_vand(0, 1));
    push[AInstr](&program, ai_vstoreq(A_X10(), 32, 0));
    push[AInstr](&program, ai_vloadq(2, A_X10(), 32));
    push[AInstr](&program, ai_vloadq(3, A_X10(), 48));
    push[AInstr](&program, ai_vorr(2, 3));
    push[AInstr](&program, ai_veor(2, 3));
    push[AInstr](&program, ai_vcnt(2, 2));
    push[AInstr](&program, ai_vaddv_b(2, 2));
    push[AInstr](&program, ai_vumov_b(A_X0(), 2));
    push[AInstr](&program, ai_mov_imm(A_X8(), 93));
    push[AInstr](&program, ai_svc());

    let data: ArrayList[u8] = make[u8](64);
    let i: i32 = 0;
    while (i < 16) { push[u8](&data, 255); i = i + 1; }
    i = 0;
    while (i < 16) {
        let value: i32 = 0;
        if (i < 5) { value = 255; }
        else if (i == 5) { value = 3; }
        push[u8](&data, value as u8);
        i = i + 1;
    }
    while (data.len < 64) { push[u8](&data, 0); }
    let code: ArrayList[u8] = aencode(program);
    let written: i32 = write_elf_arm64_data(_zag_arg(1), code, 0, data);
    free[u8](&code);
    free[u8](&data);
    free[AInstr](&program);
    if (written != 0) { return 2; }
    return 42;
}
