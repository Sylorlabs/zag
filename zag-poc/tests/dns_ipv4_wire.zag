@import("std:list")
@import("std:dns_ipv4") as dns

extern fn _zag_allocator_live_bytes() i64

fn clone_bytes(input: []u8, extra_capacity: i32) ArrayList[u8] {
    let output: ArrayList[u8] = make[u8](input.len + extra_capacity);
    let i: i32 = 0;
    while (i < input.len) {
        push[u8](&output, input[i]);
        i = i + 1;
    }
    return output;
}

fn append_u16(output: *ArrayList[u8], value: i32) void {
    push[u8](output, ((value >> 8) & 255) as u8);
    push[u8](output, (value & 255) as u8);
}

fn append_u32(output: *ArrayList[u8], value: i64) void {
    push[u8](output, ((value >> 24) & 255) as u8);
    push[u8](output, ((value >> 16) & 255) as u8);
    push[u8](output, ((value >> 8) & 255) as u8);
    push[u8](output, (value & 255) as u8);
}

fn make_response(query: []u8) ArrayList[u8] {
    let response: ArrayList[u8] = clone_bytes(query, 16);
    response.data[2] = 129; // response + recursion desired
    response.data[3] = 128; // recursion available, no error
    response.data[6] = 0;
    response.data[7] = 1;
    push[u8](&response, 192);
    push[u8](&response, 12); // answer owner points to the question name
    append_u16(&response, 1);
    append_u16(&response, 1);
    append_u32(&response, 60);
    append_u16(&response, 4);
    push[u8](&response, 127);
    push[u8](&response, 0);
    push[u8](&response, 0);
    push[u8](&response, 42);
    return response;
}

fn main() i32 {
    let baseline: i64 = _zag_allocator_live_bytes();

    let invalid_empty: dns.DnsPacketResult = dns.dns_encode_a_query("", 4660);
    let invalid_dot: dns.DnsPacketResult = dns.dns_encode_a_query("a..test", 4660);
    let invalid_hyphen: dns.DnsPacketResult = dns.dns_encode_a_query("-bad.test", 4660);
    let invalid_id: dns.DnsPacketResult = dns.dns_encode_a_query("example.test", 70000);
    let tiny_limit: dns.DnsPacketResult = dns.dns_encode_a_query_bounded(
        "example.test", 4660, 20
    );
    if (invalid_empty.code != dns.dns_status_invalid_name() ||
        invalid_dot.code != dns.dns_status_invalid_name() ||
        invalid_hyphen.code != dns.dns_status_invalid_name() ||
        invalid_id.code != dns.dns_status_invalid_argument() ||
        tiny_limit.code != dns.dns_status_limit() ||
        invalid_empty.value.open != 0 || tiny_limit.value.open != 0) { return 1; }
    if (_zag_allocator_live_bytes() != baseline) { return 2; }

    let query_result: dns.DnsPacketResult = dns.dns_encode_a_query(
        "example.test", 4660
    );
    if (query_result.ok != 1 || query_result.value.open != 1) { return 3; }
    let query: dns.DnsPacket = dns.dns_packet_take(&query_result);
    if (query.open != 1 || query_result.value.open != 0) { return 14; }
    let query_bytes: []u8 = dns.dns_packet_slice(&query);
    if (query_bytes.len != 30 || query_bytes[0] != 18 || query_bytes[1] != 52 ||
        query_bytes[2] != 1 || query_bytes[3] != 0 ||
        query_bytes[4] != 0 || query_bytes[5] != 1 ||
        query_bytes[12] != 7 || query_bytes[20] != 4 ||
        query_bytes[25] != 0 || query_bytes[26] != 0 || query_bytes[27] != 1 ||
        query_bytes[28] != 0 || query_bytes[29] != 1) { return 4; }

    let response: ArrayList[u8] = make_response(query_bytes);
    let decoded: dns.DnsAResult = dns.dns_decode_a_response(
        response.data[0..response.len], 4660
    );
    if (decoded.ok != 1 || decoded.code != dns.dns_status_ok() ||
        decoded.address != 2130706474 || decoded.ttl_seconds != 60 ||
        decoded.answer_count != 1) { return 5; }

    let truncated: dns.DnsAResult = dns.dns_decode_a_response(
        response.data[0..response.len - 1], 4660
    );
    if (truncated.ok != 0 || truncated.code != dns.dns_status_truncated()) {
        return 6;
    }

    let bad_label: ArrayList[u8] = clone_bytes(response.data[0..response.len], 0);
    bad_label.data[12] = 64;
    let bad_label_result: dns.DnsAResult = dns.dns_decode_a_response(
        bad_label.data[0..bad_label.len], 4660
    );
    if (bad_label_result.code != dns.dns_status_malformed()) { return 7; }

    let pointer_loop: ArrayList[u8] = clone_bytes(response.data[0..response.len], 0);
    pointer_loop.data[12] = 192;
    pointer_loop.data[13] = 12;
    let pointer_loop_result: dns.DnsAResult = dns.dns_decode_a_response(
        pointer_loop.data[0..pointer_loop.len], 4660
    );
    if (pointer_loop_result.code != dns.dns_status_compression_loop()) { return 8; }

    let bad_pointer: ArrayList[u8] = clone_bytes(response.data[0..response.len], 0);
    bad_pointer.data[12] = 192;
    bad_pointer.data[13] = 255;
    let bad_pointer_result: dns.DnsAResult = dns.dns_decode_a_response(
        bad_pointer.data[0..bad_pointer.len], 4660
    );
    if (bad_pointer_result.code != dns.dns_status_malformed()) { return 9; }

    let no_a: ArrayList[u8] = clone_bytes(response.data[0..response.len], 0);
    no_a.data[query_bytes.len + 2] = 0;
    no_a.data[query_bytes.len + 3] = 28;
    let no_a_result: dns.DnsAResult = dns.dns_decode_a_response(
        no_a.data[0..no_a.len], 4660
    );
    if (no_a_result.code != dns.dns_status_no_a_answer()) { return 10; }

    let wrong_id: dns.DnsAResult = dns.dns_decode_a_response(
        response.data[0..response.len], 4661
    );
    let record_limit: dns.DnsAResult = dns.dns_decode_a_response_bounded(
        response.data[0..response.len], 4660, 4096, 0, 16
    );
    let packet_limit: dns.DnsAResult = dns.dns_decode_a_response_bounded(
        response.data[0..response.len], 4660, 20, 64, 16
    );
    if (wrong_id.code != dns.dns_status_id_mismatch() ||
        record_limit.code != dns.dns_status_invalid_argument() ||
        packet_limit.code != dns.dns_status_limit()) { return 11; }

    if (dns.dns_packet_close(&query) != dns.dns_status_ok() ||
        dns.dns_packet_close(&query) != dns.dns_status_invalid_state() ||
        dns.dns_packet_slice(&query).len != 0) { return 12; }
    free[u8](&response);
    free[u8](&bad_label);
    free[u8](&pointer_loop);
    free[u8](&bad_pointer);
    free[u8](&no_a);
    if (_zag_allocator_live_bytes() != baseline) { return 13; }
    return 0;
}
