@import("../selfhost/std/process_platform.zag")

fn main() i32 {
    let pair: i64 = 0;
    if (process_platform_pipe((&pair) as i64) != 0) { return 1; }
    let rd: i64 = pair & 4294967295;
    let wr: i64 = pair >> 32;
    if (process_platform_wait_readable(rd, 0) != 0) { return 2; }
    let start: i64 = _zag_clock_monotonic_ms();
    if (process_platform_wait_readable(rd, 37) != 0) { return 3; }
    let elapsed: i64 = _zag_clock_monotonic_ms() - start;
    if (elapsed < 25 || elapsed > 1000) { return 4; }
    let byte: i64 = 65;
    if (_zag_raw_syscall(1, wr, (&byte) as i64, 1, 0, 0, 0) != 1) { return 5; }
    if (process_platform_wait_readable(rd, 1000) != 1) { return 6; }
    if (process_platform_read(rd, (&byte) as i64, 1) != 1) { return 7; }
    if (process_platform_close(wr) != 0) { return 8; }
    if (process_platform_wait_readable(rd, 1000) != 1) { return 9; } // EOF/HUP
    if (process_platform_close(rd) != 0) { return 10; }
    if (process_platform_wait_readable(rd, 0) >= 0) { return 11; } // POLLNVAL
    let idle_start: i64 = _zag_clock_monotonic_ms();
    if (process_platform_wait_readable(-1, 1023) != 0) { return 12; }
    let idle_elapsed: i64 = _zag_clock_monotonic_ms() - idle_start;
    if (idle_elapsed < 1000 || idle_elapsed > 3000) { return 13; }
    if (process_platform_wait_readable(-2, 10) >= 0) { return 14; }
    if (_zag_process_wait_readable(-1, -1) >= 0) { return 15; } // intrinsic also finite
    _zag_println("process wait: empty/ready/HUP/invalid/finite idle PASS");
    return 0;
}
