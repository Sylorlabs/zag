// Source-level witness for the otherwise internal literal-only ELF32 writer.
// The installed compiler builds this host runner; the runner emits the i686
// artifact directly from the current elf_i686.zag source.
@import("../selfhost/native/elf_i686.zag")

fn main() i32 {
    if (_zag_argc() != 2) { return 2; }
    return write_i686_literal_exit(_zag_arg(1), 42);
}
