// Regression: a large mapping re-issued at an address that already has a
// large-registry tombstone must not leave a stale duplicate tombstone behind.
// Before the fix the final _zag_free of a valid small block panicked with
// "zag runtime: invalid or double free".
fn main() i32 {
    let big: i64 = 1048568;
    let p: *i8 = _zag_malloc(big);
    let q: *i8 = _zag_malloc(big);
    _zag_free(q);
    _zag_free(p);
    let s1: *i8 = _zag_malloc(300000);
    let r: *i8 = _zag_malloc(big);
    _zag_free(r);
    let s2: *i8 = _zag_malloc(300000);
    _zag_free(s2);
    _zag_free(s1);
    print_str("ok\n");
    return 0;
}
