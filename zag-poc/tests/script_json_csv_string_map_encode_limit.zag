// Script JSON text-map encoding fails closed when the context has no
// remaining bytes for the retained canonical output.

script;

let values: ScriptMapText = json_string_map("{\"name\":\"zag\"}");
if (text_map_len(values) != 1) { return 1; }
let remaining: i64 = 1048576 - script_alloc_used();
let reserve: *i8 = script_alloc(remaining);
if (reserve == null as *i8) { return 2; }
let encoded: []u8 = json_string_map_encode(values);
if (encoded.len != 0) { return 3; }
return 0;
