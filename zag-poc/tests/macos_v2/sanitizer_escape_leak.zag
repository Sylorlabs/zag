// Deliberately false foreign ownership contract, only for this negative test:
// libc strlen does not consume its input. The declaration's body is outside
// static ownership checking, but the native sanitizer must still diagnose the
// outstanding Zag allocation at process exit. Never use this binding in std.
extern fn strlen(text: @consumes *i8) i64 @cabi;

fn main() i32 {
    unsafe {
        let text: *i8 = _zag_malloc(16) as *i8;
        text[0] = 0;
        strlen(text);
    }
    return 0;
}
