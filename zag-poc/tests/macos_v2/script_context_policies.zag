extern fn _zag_script_context_init(limit:i64, capabilities:i64, execution_policy:i64) *opaque
extern fn _zag_script_context_shutdown(context:*opaque) void
extern fn _zag_script_alloc(context:*opaque, count:i64) *i8
extern fn _zag_script_alloc_used(context:*opaque) i64

fn main() i32 {
    unsafe {
        let arena: *opaque = _zag_script_context_init(64,7,16843009);
        if (arena == null as *opaque) { return 1; }
        if (_zag_script_alloc(arena,24) == null as *i8 || _zag_script_alloc_used(arena) != 24) { return 2; }
        _zag_script_context_shutdown(arena);

        let heap: *opaque = _zag_script_context_init(64,7,16843010);
        if (heap == null as *opaque) { return 3; }
        if (_zag_script_alloc(heap,24) == null as *i8 || _zag_script_alloc(heap,0) == null as *i8) { return 4; }
        if (_zag_script_alloc(heap,1) != null as *i8 || _zag_script_alloc_used(heap) != 56) { return 5; }
        let words: *i64 = heap as *i64;
        if (words[11] != 2 || words[12] != 1) { return 6; }
        _zag_script_context_shutdown(heap);
    }
    return 42;
