@import("std:json") as json
@import("std:list") as list

extern fn _zag_allocator_live_bytes() i64

fn json_owned_cleanup_test() i32 {
    let before: i64 = _zag_allocator_live_bytes();
    let malformed: json.JsonDocument =
        json.json_parse_value("{\"owned\":[\"first\",{\"second\":\"value\"},]}");
    if (malformed.ok != 0) { json.json_document_free(&malformed); return 0; }
    json.json_document_free(&malformed);
    if (_zag_allocator_live_bytes() != before) { return 0; }
    let valid: json.JsonDocument = json.json_parse_value("{\"x\":[1,\"two\",null]}");
    if (valid.ok != 1) { json.json_document_free(&valid); return 0; }
    json.json_document_free(&valid);
    return (_zag_allocator_live_bytes() == before) as i32;
}

fn main() i32 {
    if (json_owned_cleanup_test() == 0) { return 36; }
    let encoded: []u8 = json.json_stringify_string("a\"b\\c");
    if (!@strEq(encoded, "\"a\\\"b\\\\c\"")) { return 1; }
    let decoded: json.JsonStringResult = json.json_parse_string("  \"line\\nend\"  ");
    if (decoded.ok != 1 || decoded.value.len != 8 || decoded.value[4] != 10) { return 2; }
    let bad_string: json.JsonStringResult = json.json_parse_string("\"bad\\x\"");
    if (bad_string.ok != 0) { return 3; }
    let number: json.JsonIntResult = json.json_parse_int(" -42 ");
    if (number.ok != 1 || number.value != 0 - 42) { return 4; }
    let bad_number: json.JsonIntResult = json.json_parse_int("01");
    if (bad_number.ok != 0) { return 5; }
    let max_number: json.JsonIntResult =
        json.json_parse_int("9223372036854775807");
    let min_number: json.JsonIntResult =
        json.json_parse_int("-9223372036854775808");
    if (max_number.ok != 1 || max_number.value != 9223372036854775807 ||
        min_number.ok != 1 ||
        min_number.value != (0 - 9223372036854775807) - 1) { return 20; }
    if (json.json_parse_int("9223372036854775808").ok != 0 ||
        json.json_parse_int("-9223372036854775809").ok != 0 ||
        json.json_parse_int("999999999999999999999999").ok != 0) { return 21; }
    let flag: json.JsonBoolResult = json.json_parse_bool("false");
    if (flag.ok != 1 || flag.value != 0) { return 6; }
    let bad_flag: json.JsonBoolResult = json.json_parse_bool("False");
    if (bad_flag.ok != 0) { return 7; }
    if (!@strEq(json.json_stringify_int(17), "17")) { return 8; }
    if (!@strEq(json.json_stringify_bool(1), "true")) { return 9; }
    let decimal: json.JsonFloatResult = json.json_parse_float(" -1.25e2 ");
    if (decimal.ok != 1 || decimal.value != 0.0 - 125.0) { return 10; }
    let bad_decimal: json.JsonFloatResult = json.json_parse_float("1.");
    if (bad_decimal.ok != 0) { return 11; }
    if (json.json_parse_null(" null ").ok != 1 || json.json_parse_null("NULL").ok != 0) { return 12; }
    if (!@strEq(json.json_stringify_null(), "null")) { return 13; }
    let unicode: json.JsonStringResult = json.json_parse_string("\"A\\u03a9\\ud83d\\ude00\"");
    if (unicode.ok != 1 || unicode.value.len != 7 || unicode.value[1] != 206 || unicode.value[3] != 240) { return 14; }
    if (json.json_parse_string("\"\\ud83dX\"").ok != 0) { return 15; }
    let ints:json.JsonIntArrayResult=json.json_parse_int_array(" [1, -2, 30] ");
    if(ints.ok!=1||ints.values.len!=3||ints.values.data[1]!=0-2){return 16;}
    if(json.json_parse_int_array("[1,]").ok!=0){return 17;}
    let object:json.JsonStringObjectResult=json.json_parse_string_object("{\"name\":\"zag\",\"glyph\":\"\\u03a9\"}");
    if(object.ok!=1||object.keys.len!=2||!@strEq(object.keys.data[0],"name")||!@strEq(object.values.data[0],"zag")){return 18;}
    if(json.json_parse_string_object("{\"x\":1}").ok!=0){return 19;}

    let controls: json.JsonStringResult = json.json_parse_string("\"\\b\\f\\u0001\"");
    if (controls.ok != 1 || controls.value.len != 3 || controls.value[0] != 8 ||
        controls.value[1] != 12 || controls.value[2] != 1) { return 22; }
    if (!@strEq(json.json_stringify_string(controls.value), "\"\\b\\f\\u0001\"")) { return 23; }

    let source: []u8 =
        " { \"name\": \"zag\", \"items\": [null, true, -2.5e3, {\"emoji\":\"\\ud83d\\ude00\"}], \"empty\": [] } ";
    let document: json.JsonDocument = json.json_parse_value(source);
    if (document.ok != 1) { return 24; }
    let root: i32 = json.json_document_root(document);
    let root_value: json.JsonValue = json.json_value_at(document, root);
    if (root_value.kind != json.json_kind_object() || root_value.child_count != 3) { return 25; }
    let name: i32 = json.json_object_find(document, root, "name");
    if (name < 0 || json.json_value_at(document, name).kind != json.json_kind_string() ||
        !@strEq(json.json_value_at(document, name).text, "zag")) { return 26; }
    let items: i32 = json.json_object_find(document, root, "items");
    if (items < 0 || json.json_value_at(document, items).kind != json.json_kind_array() ||
        json.json_value_at(document, items).child_count != 4) { return 27; }
    let item_number: i32 = json.json_value_child(document, items, 2);
    if (item_number < 0 || json.json_value_at(document, item_number).kind != json.json_kind_number() ||
        !@strEq(json.json_value_at(document, item_number).text, "-2.5e3")) { return 28; }
    let nested: i32 = json.json_value_child(document, items, 3);
    let emoji: i32 = json.json_object_find(document, nested, "emoji");
    if (emoji < 0 || json.json_value_at(document, emoji).text.len != 4 ||
        json.json_value_at(document, emoji).text[0] != 240) { return 29; }
    let encoded_value: json.JsonEncodeResult = json.json_stringify_value(document, root);
    if (encoded_value.ok != 1 ||
        !@strEq(encoded_value.value, "{\"name\":\"zag\",\"items\":[null,true,-2.5e3,{\"emoji\":\"😀\"}],\"empty\":[]}")) { return 30; }
    let roundtrip: json.JsonDocument = json.json_parse_value(encoded_value.value);
    if (roundtrip.ok != 1 || json.json_value_at(roundtrip, roundtrip.root).child_count != 3) { return 31; }

    let malformed_array: json.JsonDocument = json.json_parse_value("[1,]");
    let malformed_object: json.JsonDocument = json.json_parse_value("{\"x\":true,}");
    let unclosed_array: json.JsonDocument = json.json_parse_value("[");
    let unclosed_object: json.JsonDocument = json.json_parse_value("{");
    let malformed_number: json.JsonDocument = json.json_parse_value("[1e]");
    let extra_value: json.JsonDocument = json.json_parse_value("true false");
    let failed_encode: json.JsonEncodeResult = json.json_stringify_value(malformed_array, 0);
    if (malformed_array.ok != 0 || malformed_object.ok != 0 || unclosed_array.ok != 0 ||
        unclosed_object.ok != 0 || malformed_number.ok != 0 || extra_value.ok != 0 ||
        failed_encode.ok != 0) { return 32; }

    let too_deep: json.JsonDocument = json.json_parse_value_bounded("[[0]]", 1, 32, 8);
    let bounded_ok: json.JsonDocument = json.json_parse_value_bounded("[[0]]", 2, 32, 3);
    let too_large: json.JsonDocument = json.json_parse_value_bounded("[0]", 2, 2, 3);
    let too_many: json.JsonDocument = json.json_parse_value_bounded("[1,2]", 2, 16, 2);
    if (too_deep.ok != 0 || bounded_ok.ok != 1 || too_large.ok != 0 || too_many.ok != 0) { return 33; }
    let tiny_output: json.JsonEncodeResult = json.json_stringify_value_bounded(document, root, 64, 5);
    if (tiny_output.ok != 0) { return 34; }

    let bad_bytes: list.ArrayList[u8] = list.make[u8](2);
    list.push[u8](&bad_bytes, 34); list.push[u8](&bad_bytes, 255); list.push[u8](&bad_bytes, 34);
    let bad_document: json.JsonDocument = json.json_parse_value(bad_bytes.data[0..bad_bytes.len]);
    if (json.json_parse_string(bad_bytes.data[0..bad_bytes.len]).ok != 0 ||
        json.json_stringify_string_checked(bad_bytes.data[1..2]).ok != 0 ||
        bad_document.ok != 0) { return 35; }

    json.json_encode_result_free(&encoded_value);
    json.json_document_free(&roundtrip);
    json.json_document_free(&document);
    json.json_document_free(&malformed_array);
    json.json_document_free(&malformed_object);
    json.json_document_free(&unclosed_array);
    json.json_document_free(&unclosed_object);
    json.json_document_free(&malformed_number);
    json.json_document_free(&extra_value);
    json.json_document_free(&too_deep);
    json.json_document_free(&bounded_ok);
    json.json_document_free(&too_large);
    json.json_document_free(&too_many);
    json.json_document_free(&bad_document);
    list.free[u8](&bad_bytes);
    return 0;
}
