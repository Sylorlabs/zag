@import("../selfhost/planner_authority.zag")

fn check(ok:i32,msg:[]u8,f:*i32)void{if(ok==1){return;}_zag_print("FAIL planner precedence: ");_zag_println(msg);f.*=f.*+1;}
fn choices(a:[]u8,d:[]u8,l:[]u8,c:[]u8)PlannerChoices{return PlannerChoices{.allocator=a,.device=d,.layout=l,.cpu=c,.allocator_explicit=1,.device_explicit=1,.layout_explicit=1,.cpu_explicit=1};}
fn policy(idle:i32,difficulty:[]u8,script:[]u8,regular:[]u8,objective:[]u8,trust:[]u8)PlannerPolicyOverrides{return PlannerPolicyOverrides{.idle_deep=idle,.idle_deep_set=1,.difficulty=difficulty,.difficulty_set=1,.script_optimization=script,.script_optimization_set=1,.regular_optimization=regular,.regular_optimization_set=1,.objective=objective,.objective_set=1,.trust_mode=trust,.trust_mode_set=1};}
fn main()i32{
 let f:i32=0;let src:[]u8="fn main() i32 { return 0; }";
 let project:PlannerConfig=planner_parse_config("allocator=script_process_arena\ndevice=cpu\nlayout=compiler_owned\ncpu=generic\nidle_deep=false\ndifficulty=explained\nscript_optimization=review\nregular_optimization=automatic\nobjective=runtime\ntrust_mode=reviewed\n");
 let empty:PlannerChoices=planner_empty_choices();
 let defaults:PlannerResolution=planner_resolve(1,src,planner_default_config(),empty,0);
 check(defaults.automatic_count==4&&@strEq(defaults.choices.allocator,"script_process_arena")&&@strEq(defaults.choices.cpu,"generic"),"bounded defaults",&f);
 let default_policy:PlannerPolicyResolution=planner_policy_resolve(planner_empty_policy_overrides(),planner_empty_policy_overrides(),planner_default_config());
 check(default_policy.valid==1&&default_policy.idle_deep==1&&@strEq(default_policy.difficulty,"simple")&&@strEq(default_policy.script_optimization,"automatic")&&@strEq(default_policy.regular_optimization,"review")&&@strEq(default_policy.objective,"runtime")&&@strEq(default_policy.trust_mode,"stable"),"adaptive defaults resolve",&f);
 let policy:PlannerResolution=planner_resolve(1,src,project,empty,0);
 check(policy.automatic_count==4&&@strEq(policy.choices.allocator,"script_process_arena"),"project policy over defaults",&f);
 check(policy.policy.valid==1&&policy.policy.idle_deep==0&&@strEq(policy.policy.difficulty,"explained")&&@strEq(policy.policy.script_optimization,"review")&&@strEq(policy.policy.regular_optimization,"automatic")&&@strEq(policy.policy.trust_mode,"reviewed"),"project adaptive policy resolves",&f);
 let source:PlannerChoices=choices("script_bounded_heap","cpu","compiler_owned","x86-64-v1");
 let source_wins:PlannerResolution=planner_resolve(1,src,project,source,0);
 check(source_wins.automatic_count==0&&@strEq(source_wins.choices.allocator,"script_bounded_heap")&&@strEq(source_wins.choices.cpu,"x86-64-v1"),"explicit source over project policy",&f);
 let cli:PlannerChoices=choices("script_process_arena","cpu","compiler_owned","generic");
 let cli_wins:PlannerResolution=planner_resolve(1,src,project,cli,0);
 check(cli_wins.automatic_count==0&&@strEq(cli_wins.choices.allocator,"script_process_arena")&&@strEq(cli_wins.choices.cpu,"generic"),"explicit CLI over explicit source",&f);
 let source_policy:PlannerPolicyOverrides=policy(1,"explicit","off","review","runtime","autonomous");
 let source_policy_wins:PlannerPolicyResolution=planner_policy_resolve(planner_empty_policy_overrides(),source_policy,project);
 check(source_policy_wins.valid==1&&source_policy_wins.idle_deep==1&&@strEq(source_policy_wins.difficulty,"explicit")&&@strEq(source_policy_wins.script_optimization,"off")&&@strEq(source_policy_wins.regular_optimization,"review")&&@strEq(source_policy_wins.trust_mode,"autonomous"),"source policy over project",&f);
 let cli_policy:PlannerPolicyOverrides=policy(0,"native","automatic","off","runtime","stable");
 let cli_policy_wins:PlannerPolicyResolution=planner_policy_resolve(cli_policy,source_policy,project);
 check(cli_policy_wins.valid==1&&cli_policy_wins.idle_deep==0&&@strEq(cli_policy_wins.difficulty,"native")&&@strEq(cli_policy_wins.script_optimization,"automatic")&&@strEq(cli_policy_wins.regular_optimization,"off")&&@strEq(cli_policy_wins.trust_mode,"stable"),"CLI policy over source",&f);
 let bad_idle:PlannerPolicyOverrides=policy(2,"simple","automatic","review","runtime","stable");
 let bad_difficulty:PlannerPolicyOverrides=policy(1,"expert","automatic","review","runtime","stable");
 let bad_script:PlannerPolicyOverrides=policy(1,"simple","fastest","review","runtime","stable");
 let bad_regular:PlannerPolicyOverrides=policy(1,"simple","automatic","always","runtime","stable");
 let bad_objective:PlannerPolicyOverrides=policy(1,"simple","automatic","review","memory","stable");
 let bad_trust:PlannerPolicyOverrides=policy(1,"simple","automatic","review","runtime","unsafe");
 check(planner_policy_resolve(planner_empty_policy_overrides(),bad_idle,project).valid==0&&planner_policy_resolve(planner_empty_policy_overrides(),bad_difficulty,project).valid==0&&planner_policy_resolve(planner_empty_policy_overrides(),bad_script,project).valid==0&&planner_policy_resolve(planner_empty_policy_overrides(),bad_regular,project).valid==0&&planner_policy_resolve(planner_empty_policy_overrides(),bad_objective,project).valid==0&&planner_policy_resolve(planner_empty_policy_overrides(),bad_trust,project).valid==0,"malformed explicit policy fails closed",&f);
 let bad:PlannerConfig=planner_parse_config("allocator=script_bounded_heap\nunknown=true\n");
 let rejected:PlannerResolution=planner_resolve(1,src,bad,empty,0);
 check(bad.valid==0&&rejected.policy.valid==0&&rejected.unresolved_count==4&&rejected.diagnostic.len>0,"malformed policy fails closed",&f);
 let duplicate:PlannerConfig=planner_parse_config("difficulty=simple\ndifficulty=native\n");
 check(duplicate.valid==0&&@strEq(duplicate.diagnostic,"planner config: duplicate key"),"duplicate policy keys fail closed",&f);
 if(f==0){_zag_println("planner precedence: pass=12 fail=0");}return f;
}
