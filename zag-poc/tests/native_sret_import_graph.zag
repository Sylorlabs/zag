// Regression for the compiler defect that once forced consumers to avoid a
// math-module import. Imported struct-returning methods need their own caller
// frame scratch and sret destinations, even inside another aggregate return.

@import("support/native_sret_import_math.zag")

struct ImportFrame {
    camera: ImportCamera,
    marker: ImportVec3,
    tail: i32,
}

fn import_frame(seed: i32) ImportFrame {
    let camera: ImportCamera = import_camera(seed);
    let marker: ImportVec3 = import_v3(1, 2, 3).shift(3, 2, 1);
    return ImportFrame{
        .camera = camera,
        .marker = marker.add(import_v3(1, 2, 3)),
        .tail = 5,
    };
}

fn import_frame_wrap(seed: i32) ImportFrame {
    let frame: ImportFrame = import_frame(seed);
    frame.marker = frame.marker.shift(1, 1, 1);
    return frame;
}

fn main() i32 {
    let frame: ImportFrame = import_frame_wrap(1);
    return frame.camera.eye.x + frame.camera.target.y + frame.camera.tag +
        frame.marker.x + frame.marker.y + frame.marker.z + frame.tail;
}
