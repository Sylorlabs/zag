@import("../selfhost/native/aarch64.zag")

fn encoded_shape(ins: AInstr, want_len: i32, want_last_byte: i32) bool {
    let program: ArrayList[AInstr] = make[AInstr](1);
    push[AInstr](&program, ins);
    let code: ArrayList[u8] = aencode(program);
    let ok: bool = code.len == want_len &&
        code.data[code.len - 1] == want_last_byte as u8;
    free[u8](&code);
    free[AInstr](&program);
    return ok;
}

fn enc_rd(code: ArrayList[u8], off: i32) i32 {
    return (code.data[off] as i32) % 32;
}

fn enc_rn(code: ArrayList[u8], off: i32) i32 {
    return ((code.data[off] as i32) / 32) +
        (((code.data[off + 1] as i32) % 4) * 8);
}

fn scratch_conflicts_ok() bool {
    let loads: ArrayList[AInstr] = make[AInstr](1);
    push[AInstr](&loads, ai_load(A_X16(), A_X16(), 0 - 264));
    let load_code: ArrayList[u8] = aencode(loads);
    // ADD x17,x16,#0; SUB x17,x17,#264; LDR x16,[x17]
    let load_ok: bool = load_code.len == 12 &&
        enc_rd(load_code, 0) == A_X17() && enc_rn(load_code, 0) == A_X16() &&
        enc_rd(load_code, 4) == A_X17() && enc_rn(load_code, 4) == A_X17() &&
        enc_rd(load_code, 8) == A_X16() && enc_rn(load_code, 8) == A_X17();

    let stores: ArrayList[AInstr] = make[AInstr](1);
    push[AInstr](&stores, ai_store(A_X16(), 0 - 264, A_X17()));
    let store_code: ArrayList[u8] = aencode(stores);
    // Both IP registers are operands: adjust x16, store x17, restore x16.
    let store_ok: bool = store_code.len == 12 &&
        store_code.data[3] == 209 &&
        enc_rd(store_code, 0) == A_X16() && enc_rn(store_code, 0) == A_X16() &&
        enc_rd(store_code, 4) == A_X17() && enc_rn(store_code, 4) == A_X16() &&
        store_code.data[11] == 145 &&
        enc_rd(store_code, 8) == A_X16() && enc_rn(store_code, 8) == A_X16();

    free[u8](&load_code);
    free[AInstr](&loads);
    free[u8](&store_code);
    free[AInstr](&stores);
    return load_ok && store_ok;
}

fn darwin_gettimeofday_clears_x2() bool {
    let calls: ArrayList[AInstr] = make[AInstr](1);
    push[AInstr](&calls, ai_syscall(169));
    let code: ArrayList[u8] = aencode_macos(calls, 0, 0, 0, 0);
    // MOVZ x2,#0; MOVZ x16,#116; SVC #0x80; B.CC; NEG x0,x0.
    let ok: bool = code.len == 20 &&
        code.data[0] == 2 && code.data[1] == 0 &&
        code.data[2] == 128 && code.data[3] == 210 &&
        enc_rd(code, 4) == A_X16() &&
        code.data[8] == 1 && code.data[9] == 16 &&
        code.data[10] == 0 && code.data[11] == 212;
    free[u8](&code);
    free[AInstr](&calls);
    return ok;
}

fn main() i32 {
    // Negative frame offsets beyond simm9 must expand instead of wrapping.
    if (!encoded_shape(ai_load(A_X0(), A_X29(), 0 - 264), 12, 249)) { return 1; }
    if (!encoded_shape(ai_store(A_X29(), 0 - 272, A_X0()), 12, 249)) { return 2; }
    if (!encoded_shape(ai_loadb(A_X0(), A_X29(), 0 - 300), 12, 57)) { return 3; }
    if (!encoded_shape(ai_storeb(A_X29(), 0 - 301, A_X0()), 12, 57)) { return 4; }
    if (!encoded_shape(ai_loadh(A_X0(), A_X29(), 0 - 302), 12, 121)) { return 5; }
    if (!encoded_shape(ai_storeh(A_X29(), 0 - 304, A_X0()), 12, 121)) { return 6; }
    if (!encoded_shape(ai_loadw(A_X0(), A_X29(), 0 - 308), 12, 185)) { return 7; }
    if (!encoded_shape(ai_storew(A_X29(), 0 - 312, A_X0()), 12, 185)) { return 8; }

    // Positive offsets outside scaled ranges (or their alignment) also expand.
    if (!encoded_shape(ai_load(A_X0(), A_X29(), 32761), 16, 249)) { return 9; }
    if (!encoded_shape(ai_storeb(A_X29(), 4096, A_X0()), 12, 57)) { return 10; }
    if (!encoded_shape(ai_loadh(A_X0(), A_X29(), 8191), 16, 121)) { return 11; }
    if (!encoded_shape(ai_storew(A_X29(), 16382, A_X0()), 16, 185)) { return 12; }

    // Both immediate forms retain their compact single-instruction encoding.
    if (!encoded_shape(ai_load(A_X0(), A_X29(), 32760), 4, 249)) { return 13; }
    if (!encoded_shape(ai_storeb(A_X29(), 4095, A_X0()), 4, 57)) { return 14; }
    if (!encoded_shape(ai_loadh(A_X0(), A_X29(), 8190), 4, 121)) { return 15; }
    if (!encoded_shape(ai_storew(A_X29(), 16380, A_X0()), 4, 185)) { return 16; }
    if (!encoded_shape(ai_load(A_X0(), A_X29(), 0 - 256), 4, 248)) { return 17; }

    if (!scratch_conflicts_ok()) { return 18; }
    if (!darwin_gettimeofday_clears_x2()) { return 19; }
    return 0;
}
