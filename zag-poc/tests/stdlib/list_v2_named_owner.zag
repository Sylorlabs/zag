@import("../../std/list.zag") as list

fn main() i32 {
    let values: list.ArrayList[i32] = list.make[i32](2);
    list.push[i32](&values, 20);
    list.push[i32](&values, 22);
    if (list.get[i32](values, 0) + list.get[i32](values, 1) != 42) {
        return 1;
    }
    list.free[i32](&values);
    if (values.len != 0 || values.cap != 0) {
        return 2;
    }
    return 0;
}
