enum CopyMode { start, end }
enum CopyCross { start, center, end, stretch, baseline }

struct CopyInsets {
    top: i64,
    right: i64,
    bottom: i64,
    left: i64,
}

struct CopyStyle {
    mode: CopyMode,
    gap: i64,
    padding: CopyInsets,
}

struct CopyStyleList {
    data: *CopyStyle,
    len: i32,
}

struct CopyFlowStyle {
    axis: i64,
    direction: i64,
    main_alignment: i64,
    cross_alignment: CopyCross,
    gap: i64,
    padding: CopyInsets,
}

fn normalize_copy_style(raw: CopyStyle) CopyStyle {
    let style: CopyStyle = raw;
    if (style.gap < 0) { style.gap = 0; }
    if (style.padding.left < 0) { style.padding.left = 0; }
    return style;
}

fn verify_three_aggregate_args(first: CopyInsets, bounds: CopyStyle, raw_style: CopyFlowStyle) i32 {
    let style: CopyFlowStyle = raw_style;
    if (first.top == 1 && bounds.padding.right == 2 && style.axis == 7 && style.direction == 8 &&
        style.main_alignment == 9 && style.cross_alignment == CopyCross.baseline && style.gap == 10 &&
        style.padding.top == 11 && style.padding.right == 12 && style.padding.bottom == 13 && style.padding.left == 14) {
        return 1;
    }
    return 0;
}

fn verify_flex_shaped_args(items: CopyStyleList, bounds: CopyInsets, raw_style: CopyFlowStyle) i32 {
    let style: CopyFlowStyle = raw_style;
    if (items.len == 1 && bounds.bottom == 3 && style.cross_alignment == CopyCross.baseline &&
        style.padding.left == 14) {
        return 1;
    }
    return 0;
}

fn duplicate_member_switch(cross: CopyCross) i32 {
    let result: i32 = 0;
    switch (cross) {
        .start => { result = 1; }
        .center => { result = 2; }
        .end => { result = 3; }
        .stretch => { result = 4; }
        .baseline => { result = 42; }
    }
    return result;
}

fn main() i32 {
    let input: CopyStyle = CopyStyle{
        .mode = CopyMode.end,
        .gap = -7,
        .padding = CopyInsets{ .top = 1, .right = 2, .bottom = 3, .left = -4 },
    };
    let output: CopyStyle = normalize_copy_style(input);
    let stored: CopyStyle = output;
    let styles: CopyStyleList = CopyStyleList{ .data = &stored, .len = 1 };
    let indexed: CopyStyle = styles.data[0];
    let switched: CopyStyle = switch (indexed.mode) {
        .start => CopyStyle{ .mode = CopyMode.start, .gap = 99, .padding = indexed.padding },
        .end => indexed,
    };
    let flow_style: CopyFlowStyle = CopyFlowStyle{
        .axis = 7,
        .direction = 8,
        .main_alignment = 9,
        .cross_alignment = CopyCross.baseline,
        .gap = 10,
        .padding = CopyInsets{ .top = 11, .right = 12, .bottom = 13, .left = 14 },
    };
    let three_ok: i32 = verify_three_aggregate_args(output.padding, output, flow_style);
    let empty_styles: CopyStyleList = CopyStyleList{ .data = null as *CopyStyle, .len = 1 };
    let flex_shape_ok: i32 = verify_flex_shaped_args(empty_styles, output.padding, flow_style);
    let duplicate_switch_ok: i32 = duplicate_member_switch(flow_style.cross_alignment);
    let ok: i32 = (indexed.mode == CopyMode.end && indexed.gap == 0 && indexed.padding.top == 1 &&
        indexed.padding.right == 2 && indexed.padding.bottom == 3 && indexed.padding.left == 0 &&
        switched.mode == CopyMode.end && switched.gap == 0) as i32;
    if (ok == 1 && three_ok == 1 && flex_shape_ok == 1 && duplicate_switch_ok == 42 && output.mode == CopyMode.end && output.gap == 0 && output.padding.top == 1 &&
        output.padding.right == 2 && output.padding.bottom == 3 && output.padding.left == 0) {
        return 42;
    }
    return 1;
}
