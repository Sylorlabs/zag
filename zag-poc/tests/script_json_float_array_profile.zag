script;

let before: i64 = script_alloc_used();
let values: ScriptList[f64] = json_float_array(
    " [1.5, -0.0, 2e1, -3.25E-2] ");
if (script_list_failed[f64](values) != 0 ||
    script_list_len[f64](values) != 4 ||
    script_list_get[f64](values, 0) != 1.5 ||
    script_list_get[f64](values, 1) != 0.0 ||
    script_list_get[f64](values, 2) != 20.0 ||
    script_list_get[f64](values, 3) != -0.0325 ||
    script_alloc_used() <= before) { return 10; }
let after: i64 = script_alloc_used();
let empty: ScriptList[f64] = json_float_array("[]");
if (script_list_failed[f64](empty) != 0 ||
    script_list_len[f64](empty) != 0 || script_alloc_used() <= after) {
    return 11;
}
let bad_before: i64 = script_alloc_used();
let bad: ScriptList[f64] = json_float_array("[1.0,]");
if (script_list_failed[f64](bad) == 0 ||
    script_list_len[f64](bad) != 0 || script_alloc_used() != bad_before) {
    return 12;
}
let trailing: ScriptList[f64] = json_float_array("[1.0]x");
if (script_list_failed[f64](trailing) == 0 ||
    script_list_len[f64](trailing) != 0 || script_alloc_used() != bad_before) {
    return 13;
}
let wrong: ScriptList[f64] = json_float_array("[true]");
if (script_list_failed[f64](wrong) == 0 ||
    script_list_len[f64](wrong) != 0 || script_alloc_used() != bad_before) {
    return 14;
}
let enc_values: ScriptList[f64] = json_float_array("[1.5,-0.0,20.0,-0.0325]");
if (script_list_failed[f64](enc_values) != 0 || script_list_len[f64](enc_values) != 4) { return 15; }
let encoded: []u8 = json_float_array_encode(enc_values);
if (!@strEq(encoded, "[1.5,0,20,-0.0325]")) { return 16; }
let edge_values: ScriptList[f64] = json_float_array("[-20.0,0.000001,1.234000]");
if (script_list_failed[f64](edge_values) != 0 ||
    !@strEq(json_float_array_encode(edge_values), "[-20,0.000001,1.234]")) { return 17; }
// The formatter is intentionally bounded to six decimal places.  A value
// whose spelling would lose information is rejected instead of silently
// changing a JSON payload.
let lossy: ScriptList[f64] = json_float_array("[1.23456789]");
let lossy_before: i64 = script_alloc_used();
if (json_float_array_encode(lossy).len != 0 ||
    script_alloc_used() != lossy_before) { return 18; }
return 0;
