@import("std:list")
@import("std:os_macos") as os
@import("std:rt")

extern fn _zag_allocator_live_bytes() i64

fn same_bytes(left: []u8, right: []u8) i32 {
    if (left.len != right.len) { return 0; }
    let i: i32 = 0;
    while (i < left.len) { if (left[i] != right[i]) { return 0; } i = i + 1; }
    return 1;
}

fn all_byte(value: []u8, expected: u8) i32 {
    let i: i32 = 0;
    while (i < value.len) { if (value[i] != expected) { return 0; } i = i + 1; }
    return 1;
}

fn fill_byte(value: []u8, byte: u8) void {
    let i: i32 = 0;
    while (i < value.len) { value[i] = byte; i = i + 1; }
}

fn main() i32 {
    if (_zag_argc() != 3) { return 2; }
    let baseline: i64 = _zag_allocator_live_bytes();
    let invalid_clock: os.OsMacosClockResult = os.os_macos_clock_read(99);
    if (invalid_clock.ok != 0 || invalid_clock.code != os.os_macos_status_invalid_argument()) { return 3; }

    let before: os.OsMacosClockResult = os.os_macos_monotonic();
    let realtime: os.OsMacosClockResult = os.os_macos_realtime();
    let continuous_before: i64 = os.os_macos_continuous_ticks();
    if (before.ok != 1 || realtime.ok != 1 || realtime.seconds <= 0 || continuous_before <= 0) { return 4; }

    let delay: ArrayList[i64] = make[i64](2);
    delay.data[0] = 0;
    delay.data[1] = 1000000;
    let sleep_rc: i64 = _zag_raw_syscall(35, delay.data as i64, 0, 0, 0, 0, 0);
    let after: os.OsMacosClockResult = os.os_macos_monotonic();
    let continuous_after: i64 = os.os_macos_continuous_ticks();
    if (sleep_rc != 0 || after.ok != 1 || after.seconds < before.seconds ||
        (after.seconds == before.seconds && after.nanoseconds < before.nanoseconds) ||
        continuous_after < continuous_before) { return 5; }

    let first: ArrayList[u8] = make[u8](64);
    let second: ArrayList[u8] = make[u8](64);
    fill_byte(first.data[0..64], 0);
    fill_byte(second.data[0..64], 0);
    let first_result: os.OsMacosRandomResult = os.os_macos_secure_random_fill(first.data[0..64]);
    let second_result: os.OsMacosRandomResult = os.os_macos_secure_random_fill_bounded(second.data[0..64], 8);
    if (first_result.ok != 1 || first_result.transferred != 64 || first_result.calls != 1 ||
        second_result.ok != 1 || second_result.transferred != 64 || second_result.calls != 1 ||
        all_byte(first.data[0..64], 0) != 0 || all_byte(second.data[0..64], 0) != 0 ||
        same_bytes(first.data[0..64], second.data[0..64]) != 0) { return 6; }

    let sentinel: ArrayList[u8] = make[u8](8);
    fill_byte(sentinel.data[0..8], 165);
    let empty_result: os.OsMacosRandomResult = os.os_macos_secure_random_fill(sentinel.data[0..0]);
    let zero_calls: os.OsMacosRandomResult = os.os_macos_secure_random_fill_bounded(sentinel.data[0..8], 0);
    if (empty_result.code != os.os_macos_status_invalid_argument() ||
        zero_calls.code != os.os_macos_status_invalid_argument() ||
        all_byte(sentinel.data[0..8], 165) == 0) { return 7; }

    if (os.os_macos_clonefile(_zag_arg(1), _zag_arg(2)) != 0) { return 8; }
    if (os.os_macos_clonefile("", _zag_arg(2)) != (0 - 1)) { return 9; }

    free[i64](&delay);
    free[u8](&first);
    free[u8](&second);
    free[u8](&sentinel);
    if (_zag_allocator_live_bytes() != baseline) { return 10; }
    return 42;
}
