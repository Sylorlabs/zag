@import("../selfhost/v2_edition.zag")

fn main() i32 {
    let source: []u8 = "// unsafe in a comment\nlet first: i32 = 1;\nlet text: []u8 = \"unsafe in a string\";\n\nlet unsafe: i32 = first + 1;\n";
    if (v2_word_line(source, "unsafe") != 5) {
        _zag_eprintln("v2 edition diagnostic unit: wrong reserved-token line");
        return 1;
    }
    if (@strEq(v2_reserved_word(source), "unsafe") == 0) {
        _zag_eprintln("v2 edition diagnostic unit: wrong reserved token");
        return 1;
    }
    _zag_println("v2 edition diagnostic unit: PASS");
    return 0;
}
