extern fn XOpenDisplay(name: *u8) *u8;
extern fn XDefaultScreen(display: *u8) i32;
extern fn XRootWindow(display: *u8, screen: i32) i64;
extern fn XCreateSimpleWindow(display: *u8, parent: i64, x: i32, y: i32,
    width: i32, height: i32, border_width: i32, border: i64,
    background: i64) i64;
extern fn XDestroyWindow(display: *u8, window: i64) i32;
extern fn XCloseDisplay(display: *u8) i32;

fn main() i32 {
    let display: *u8 = XOpenDisplay(null as *u8);
    if (display == null as *u8) { return 2; }
    let screen: i32 = XDefaultScreen(display);
    let root: i64 = XRootWindow(display, screen);
    let window: i64 = XCreateSimpleWindow(display, root, 0, 0,
        64, 64, 0, 0, 0);
    if (window == 0) { _ = XCloseDisplay(display); return 3; }
    _ = XDestroyWindow(display, window);
    _ = XCloseDisplay(display);
    return 42;
}
