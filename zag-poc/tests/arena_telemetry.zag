@import("std/allocator.zag")

fn exercise_arena() !i32 {
    let failure: i32 = 0;
    let system: SystemAllocator = system_allocator();
    let backing: Allocation = try system.allocate(262144000, 8);
    let arena: ArenaAllocator = try arena_allocator(backing);

    let empty: ArenaTelemetry = arena.telemetry();
    if (empty.capacity != 262144000 || empty.used != 0 ||
        empty.remaining != 262144000 || empty.high_water != 0 ||
        empty.generation <= 0) {
        failure = 1;
    }

    // The overload boundary is 200 MiB; the final 50 MiB remains available
    // for bounded recovery and refusal work.
    let active: ArenaBlock = try arena.allocate(209715200, 8);
    let pressure: ArenaTelemetry = arena.telemetry();
    if (pressure.used != 209715200 || pressure.remaining != 52428800 ||
        pressure.high_water != 209715200) {
        if (failure == 0) { failure = 2; }
    }

    try arena_write_u64(active, 0, 72623859790382856 as u64);
    let word: u64 = try arena_read_u64(active, 0);
    let active_length: i64 = arena_block_len(active);
    if (word != 72623859790382856 as u64 || active_length != 209715200) {
        if (failure == 0) { failure = 3; }
    }

    // This invokes the real allocation path. The caught result is discarded;
    // `active` is only a type-correct fallback and no alias survives.
    arena.allocate(52428801, 8) catch active;
    let after_failure: ArenaTelemetry = arena.telemetry();
    if (after_failure.used != pressure.used ||
        after_failure.remaining != pressure.remaining ||
        after_failure.high_water != pressure.high_water) {
        if (failure == 0) { failure = 4; }
    }

    let reserve: ArenaBlock = try arena.allocate(52428800, 8);
    try arena_fill_u8(reserve, 0, 64, 165);
    let first: u8 = try arena_read_u8(reserve, 0);
    let last: u8 = try arena_read_u8(reserve, 63);
    let reserve_length: i64 = arena_block_len(reserve);
    let full: ArenaTelemetry = arena.telemetry();
    if (first != 165 || last != 165 || reserve_length != 52428800 ||
        full.used != 262144000 || full.remaining != 0 ||
        full.high_water != 262144000) {
        if (failure == 0) { failure = 5; }
    }

    try arena.reset();
    let reset: ArenaTelemetry = arena.telemetry();
    if (reset.capacity != 262144000 || reset.used != 0 ||
        reset.remaining != 262144000 || reset.high_water != 262144000 ||
        reset.generation == empty.generation) {
        if (failure == 0) { failure = 6; }
    }

    // More iterations than the runtime block-table capacity prove that reset
    // reuses dead metadata instead of growing a hidden side allocation.
    let iteration: i32 = 0;
    while (iteration < 4096) {
        let churn: ArenaBlock = try arena.allocate(8, 8);
        try arena.reset();
        iteration = iteration + 1;
    }

    let after_churn: ArenaTelemetry = arena.telemetry();
    if (after_churn.used != 0 || after_churn.remaining != 262144000 ||
        after_churn.high_water != 262144000 ||
        after_churn.generation <= reset.generation) {
        if (failure == 0) { failure = 7; }
    }

    let final_block: ArenaBlock = try arena.allocate(16, 8);
    try arena_write_u8(final_block, 15, 42);
    let answer: u8 = try arena_read_u8(final_block, 15);
    let released: Allocation = try arena.deinit();
    try system.deallocate(released);
    if (failure != 0) { return failure; }
    return answer as i32;
}

fn main() i32 {
    return exercise_arena() catch 99;
}
