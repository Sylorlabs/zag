@import("std:list")

fn main() i32 {
    let values: ArrayList[vsa_b<65>] = make[vsa_b<65>](2);
    let zero: vsa_b<65> = @vsaZero[vsa_b<65>]();
    push[vsa_b<65>](&values, zero);
    let bound: vsa_b<65> = get[vsa_b<65>](values, 0) ^ zero;
    let direct: vsa_b<65> = zero ^ get[vsa_b<65>](values, 0);
    let ok: bool = @vsaHamming(bound, direct) == 0;
    free[vsa_b<65>](&values);
    if (!ok) { return 1; }
    return 42;
}
