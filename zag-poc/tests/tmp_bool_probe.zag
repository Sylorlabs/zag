@import("../selfhost/zir.zag")
fn main()i32{
 let unit:CompilationUnit=parse_compilation_unit_dir("fn main() i32 { let flag:bool=true == false; if (flag) { return 1; } return 42; }\n",".");let eff:map.StringMap[i32]=analyze(unit.decls);let raw:ZModule=build_module(unit.decls,eff,unit.origins);let prop:ZirTransformProposal=zir_propose_const_bool_cmp(raw);let policy:ZirTransformPolicy=zir_transform_policy_const_bool_cmp_default();let check:ZirTransformCheck=zir_check_const_bool_cmp_source_policy(raw,unit.decls,unit.origins,policy,prop);let sel:ZirAuthority=zir_select_foreground_transform_source_policy(raw,unit.decls,unit.origins,policy,prop);
 _zag_println(_zag_str_concat("coverage=",_zag_i64_to_str(raw.coverage_complete as i64)));_zag_println(_zag_str_concat("errors=",_zag_i64_to_str(raw.coverage_errors as i64)));_zag_println(_zag_str_concat("proposed=",_zag_i64_to_str(prop.proposed as i64)));_zag_println(_zag_str_concat("check=",_zag_i64_to_str(check.accepted as i64)));_zag_println(_zag_str_concat("reason=",check.reason));_zag_println(_zag_str_concat("selected=",_zag_i64_to_str(sel.transform_count as i64)));_zag_println(_zag_str_concat("status=",sel.transform_status));return 0;
}
