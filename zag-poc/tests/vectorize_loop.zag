// tests/vectorize_loop.zag — the vectorizer's target shape.
//
// `sum_add_all` is the recognized unit-stride accumulate: an induction variable
// in a stack slot initialized to 0 with a +1 step, a bound that is a parameter,
// one unit-stride `a[i]` access, and a single integer accumulator whose address
// never escapes.  It is what `--vectorize=on` must rewrite.
//
// `count_calls` is the same loop shape with a call in the body.  The pass must
// REJECT it: an unmodelled side effect per iteration means lane-parallel
// execution is not equivalent, whatever the alias analysis says.
//
// `sum_add_all_f32` is the same shape on floats.  The pass must reject it too:
// wrapping integer addition is associative, floating-point addition is not, so a
// lane-parallel carry plus a horizontal fold is a different number from the
// scalar left-to-right sum.  This case is the reason reject code 5 exists.

@import("../std/list.zag")

fn sum_add_all(a: *i32, n: i32) i32 {
    let s: i32 = 0;
    let i: i32 = 0;
    while (i < n) {
        s = s + a[i];
        i = i + 1;
    }
    return s;
}

fn count_calls(a: *i32, n: i32, f: fn(i32)void) i32 {
    let s: i32 = 0;
    let i: i32 = 0;
    while (i < n) {
        f(a[i]);
        i = i + 1;
    }
    return s;
}

fn sum_add_all_f32(a: *f32, n: i32) f32 {
    let s: f32 = 0.0;
    let i: i32 = 0;
    while (i < n) {
        s = s + a[i];
        i = i + 1;
    }
    return s;
}

fn sink(v: i32) void {
    if (v == 0) { return; }
}

fn main() i32 {
    let xs: ArrayList[i32] = make[i32](4);
    xs.len = 4;
    xs.data[0] = 1;
    xs.data[1] = 2;
    xs.data[2] = 3;
    xs.data[3] = 4;
    let fs: ArrayList[f32] = make[f32](4);
    fs.len = 4;
    fs.data[0] = 1.0;
    fs.data[1] = 2.0;
    fs.data[2] = 3.0;
    fs.data[3] = 4.0;
    if (sum_add_all(xs.data, 4) != 10) { return 1; }
    if (sum_add_all_f32(fs.data, 4) != 10.0) { return 2; }
    if (count_calls(xs.data, 4, sink) != 0) { return 3; }
    return 0;
}
