// Small compiler harness: run the actual current process lowering without
// rebuilding the CLI, optimizer planner, or evidence machinery.
@import("../selfhost/native/ncodegen.zag")
@import("../selfhost/native/x86.zag")
@import("../selfhost/native/acodegen.zag")
@import("../selfhost/native/aarch64.zag")
@import("../selfhost/native/macho_arm64.zag")
@import("../selfhost/native/elf.zag")
@import("../selfhost/native/elf_arm64.zag")

fn main() i32 {
    if (_zag_argc() != 4) { return 2; }
    let source: []u8 = _zag_read_file(_zag_arg(1));
    let decls: ArrayList[*Node] = parse_program_dir(source, "tests");
    let errors: i32 = 0;
    let data: ArrayList[u8] = make[u8](16);
    if (@strEq(_zag_arg(3), "linux-x86_64")) {
        let program: ArrayList[Instr] = lower_program(decls, &errors, &data);
        if (errors != 0) { return 3; }
        return write_elf_exec_data(_zag_arg(2), encode(program), 0, data);
    }
    let os: i32 = AC_OS_LINUX();
    if (@strEq(_zag_arg(3), "macos-arm64")) { os = AC_OS_MACOS(); }
    else if (!@strEq(_zag_arg(3), "linux-arm64")) { return 5; }
    let program: ArrayList[AInstr] = aload_program_target(decls, &errors, &data, os, 0, 0, 0, 0, 0);
    if (errors != 0) { return 4; }
    if (os == AC_OS_MACOS()) {
        let provisional: ArrayList[u8] = aencode_macos(program, macho_code_vmaddr(), MACHO_BASE(), data.len, 0);
        let code: ArrayList[u8] = aencode_macos(program, macho_code_vmaddr(), macho_data_vmaddr(provisional.len), data.len, 0);
        return write_macho_arm64_data(_zag_arg(2), code, 0, data);
    }
    return write_elf_arm64_data(_zag_arg(2), aencode(program), 0, data);
}
