@import("std:list")
@import("std:http1") as http

extern fn _zag_allocator_live_bytes() i64

fn main() i32 {
    let baseline: i64 = _zag_allocator_live_bytes();
    let headers: ArrayList[http.Http1Header] = make[http.Http1Header](2);
    push[http.Http1Header](&headers, http.Http1Header{
        .name = "X-Trace", .value = "42",
    });

    let request_result: http.Http1BufferResult = http.http1_encode_request(
        "POST", "/items?q=zag", "example.test", headers, "body"
    );
    if (request_result.ok != 1 || request_result.value.open != 1) { return 1; }
    let request_buffer: http.Http1Buffer = http.http1_buffer_take(&request_result);
    let request_bytes: []u8 = http.http1_buffer_slice(&request_buffer);
    if (!@strEq(request_bytes,
        "POST /items?q=zag HTTP/1.1\r\nHost: example.test\r\nX-Trace: 42\r\nContent-Length: 4\r\n\r\nbody")) {
        return 2;
    }
    let prefix_probe: http.Http1MessageProbe = http.http1_probe_message(
        request_bytes[0..20]
    );
    let complete_probe: http.Http1MessageProbe = http.http1_probe_message(request_bytes);
    if (prefix_probe.ok != 1 || prefix_probe.complete != 0 ||
        prefix_probe.code != http.http1_status_truncated() ||
        complete_probe.ok != 1 || complete_probe.complete != 1 ||
        complete_probe.total_bytes != request_bytes.len ||
        complete_probe.body_bytes != 4) { return 13; }

    let parsed_result: http.Http1RequestResult = http.http1_parse_request(request_bytes);
    if (parsed_result.ok != 1 || parsed_result.value.open != 1) { return 3; }
    let parsed: http.Http1Request = http.http1_request_take(&parsed_result);
    let host: http.Http1HeaderLookup = http.http1_request_header(&parsed, "HOST");
    let trace: http.Http1HeaderLookup = http.http1_request_header(&parsed, "x-trace");
    if (!@strEq(parsed.method, "POST") || !@strEq(parsed.path, "/items?q=zag") ||
        !@strEq(parsed.body, "body") || host.count != 1 ||
        !@strEq(host.value, "example.test") || trace.count != 1 ||
        !@strEq(trace.value, "42")) { return 4; }

    let response_result: http.Http1BufferResult = http.http1_encode_response(
        200, "OK", headers, "answer=42"
    );
    if (response_result.ok != 1) { return 5; }
    let response_buffer: http.Http1Buffer = http.http1_buffer_take(&response_result);
    let response_bytes: []u8 = http.http1_buffer_slice(&response_buffer);
    if (!@strEq(response_bytes,
        "HTTP/1.1 200 OK\r\nX-Trace: 42\r\nContent-Length: 9\r\n\r\nanswer=42")) {
        return 6;
    }
    let parsed_response_result: http.Http1ResponseResult =
        http.http1_parse_response(response_bytes);
    if (parsed_response_result.ok != 1) { return 7; }
    let parsed_response: http.Http1Response =
        http.http1_response_take(&parsed_response_result);
    let response_trace: http.Http1HeaderLookup =
        http.http1_response_header(&parsed_response, "X-TRACE");
    if (parsed_response.status != 200 || !@strEq(parsed_response.reason, "OK") ||
        !@strEq(parsed_response.body, "answer=42") || response_trace.count != 1) {
        return 8;
    }

    let bare_lf: http.Http1RequestResult = http.http1_parse_request(
        "GET / HTTP/1.1\nHost: example.test\nContent-Length: 0\n\n"
    );
    let no_host: http.Http1RequestResult = http.http1_parse_request(
        "GET / HTTP/1.1\r\nContent-Length: 0\r\n\r\n"
    );
    let duplicate_host: http.Http1RequestResult = http.http1_parse_request(
        "GET / HTTP/1.1\r\nHost: one\r\nHost: two\r\nContent-Length: 0\r\n\r\n"
    );
    let duplicate_length: http.Http1RequestResult = http.http1_parse_request(
        "GET / HTTP/1.1\r\nHost: one\r\nContent-Length: 0\r\nContent-Length: 0\r\n\r\n"
    );
    let transfer: http.Http1RequestResult = http.http1_parse_request(
        "POST / HTTP/1.1\r\nHost: one\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n"
    );
    let truncated: http.Http1RequestResult = http.http1_parse_request(
        "POST / HTTP/1.1\r\nHost: one\r\nContent-Length: 4\r\n\r\nabc"
    );
    let trailing: http.Http1RequestResult = http.http1_parse_request(
        "POST / HTTP/1.1\r\nHost: one\r\nContent-Length: 3\r\n\r\nabcd"
    );
    let folded: http.Http1RequestResult = http.http1_parse_request(
        "GET / HTTP/1.1\r\nHost: one\r\n folded\r\nContent-Length: 0\r\n\r\n"
    );
    let bad_name: http.Http1RequestResult = http.http1_parse_request(
        "GET / HTTP/1.1\r\nHost : one\r\nContent-Length: 0\r\n\r\n"
    );
    if (bare_lf.code != http.http1_status_malformed() ||
        no_host.code != http.http1_status_malformed() ||
        duplicate_host.code != http.http1_status_malformed() ||
        duplicate_length.code != http.http1_status_malformed() ||
        transfer.code != http.http1_status_unsupported() ||
        truncated.code != http.http1_status_truncated() ||
        trailing.code != http.http1_status_malformed() ||
        folded.code != http.http1_status_malformed() ||
        bad_name.code != http.http1_status_malformed()) { return 9; }

    let tiny: http.Http1Limits = http.http1_default_limits();
    tiny.max_message_bytes = 64;
    tiny.max_header_bytes = 64;
    tiny.max_body_bytes = 8;
    let too_large_encode: http.Http1BufferResult = http.http1_encode_request_bounded(
        "POST", "/", "example.test", headers, "012345678", tiny
    );
    let too_large_parse: http.Http1RequestResult = http.http1_parse_request_bounded(
        request_bytes, tiny
    );
    let count_limits: http.Http1Limits = http.http1_default_limits();
    count_limits.max_header_count = 2;
    let too_many_encode: http.Http1BufferResult = http.http1_encode_request_bounded(
        "GET", "/", "example.test", headers, "", count_limits
    );
    let too_many_parse: http.Http1RequestResult = http.http1_parse_request_bounded(
        request_bytes, count_limits
    );
    let bad_method: http.Http1BufferResult = http.http1_encode_request(
        "BAD METHOD", "/", "example.test", headers, ""
    );
    let proxy_path: http.Http1BufferResult = http.http1_encode_request(
        "GET", "http://example.test/", "example.test", headers, ""
    );
    let bad_host: http.Http1BufferResult = http.http1_encode_request(
        "GET", "/", "bad host", headers, ""
    );
    if (too_large_encode.code != http.http1_status_limit() ||
        too_large_parse.code != http.http1_status_limit() ||
        too_many_encode.code != http.http1_status_limit() ||
        too_many_parse.code != http.http1_status_limit() ||
        bad_method.code != http.http1_status_invalid_argument() ||
        proxy_path.code != http.http1_status_invalid_argument() ||
        bad_host.code != http.http1_status_invalid_argument()) { return 10; }

    if (http.http1_request_close(&parsed) != http.http1_status_ok() ||
        http.http1_request_close(&parsed) != http.http1_status_invalid_state() ||
        http.http1_response_close(&parsed_response) != http.http1_status_ok() ||
        http.http1_response_close(&parsed_response) != http.http1_status_invalid_state() ||
        http.http1_buffer_close(&request_buffer) != http.http1_status_ok() ||
        http.http1_buffer_close(&request_buffer) != http.http1_status_invalid_state() ||
        http.http1_buffer_close(&response_buffer) != http.http1_status_ok()) {
        return 11;
    }
    free[http.Http1Header](&headers);
    if (_zag_allocator_live_bytes() != baseline) { return 12; }
    return 0;
}
