@import("std:list")
@import("std:http1") as http

extern fn _zag_allocator_live_bytes() i64

fn main() i32 {
    let baseline: i64 = _zag_allocator_live_bytes();
    if (http.http1_buffer_take(null as *http.Http1BufferResult).open != 0 ||
        http.http1_request_take(null as *http.Http1RequestResult).open != 0 ||
        http.http1_response_take(null as *http.Http1ResponseResult).open != 0 ||
        http.http1_buffer_slice(null as *http.Http1Buffer).len != 0 ||
        http.http1_buffer_close(null as *http.Http1Buffer) !=
            http.http1_status_invalid_state() ||
        http.http1_request_close(null as *http.Http1Request) !=
            http.http1_status_invalid_state() ||
        http.http1_response_close(null as *http.Http1Response) !=
            http.http1_status_invalid_state() ||
        http.http1_chunked_close(null as *http.Http1ChunkedResult) !=
            http.http1_status_invalid_state() ||
        http.http1_request_header(null as *http.Http1Request, "x").found != 0 ||
        http.http1_response_header(null as *http.Http1Response, "x").found != 0) {
        return 40;
    }
    let headers: ArrayList[http.Http1Header] = make[http.Http1Header](2);
    push[http.Http1Header](&headers, http.Http1Header{
        .name = "X-Trace", .value = "42",
    });

    let request_result: http.Http1BufferResult = http.http1_encode_request(
        "POST", "/items?q=zag", "example.test", headers, "body"
    );
    if (request_result.ok != 1 || request_result.value.open != 1) { return 1; }
    let request_buffer: http.Http1Buffer = http.http1_buffer_take(&request_result);
    let request_bytes: []u8 = http.http1_buffer_slice(&request_buffer);
    if (!@strEq(request_bytes,
        "POST /items?q=zag HTTP/1.1\r\nHost: example.test\r\nX-Trace: 42\r\nContent-Length: 4\r\n\r\nbody")) {
        return 2;
    }
    let prefix_probe: http.Http1MessageProbe = http.http1_probe_message(
        request_bytes[0..20]
    );
    let complete_probe: http.Http1MessageProbe = http.http1_probe_message(request_bytes);
    if (prefix_probe.ok != 1 || prefix_probe.complete != 0 ||
        prefix_probe.code != http.http1_status_truncated() ||
        complete_probe.ok != 1 || complete_probe.complete != 1 ||
        complete_probe.total_bytes != request_bytes.len ||
        complete_probe.body_bytes != 4) { return 13; }

    let parsed_result: http.Http1RequestResult = http.http1_parse_request(request_bytes);
    if (parsed_result.ok != 1 || parsed_result.value.open != 1) { return 3; }
    let parsed: http.Http1Request = http.http1_request_take(&parsed_result);
    let host: http.Http1HeaderLookup = http.http1_request_header(&parsed, "HOST");
    let trace: http.Http1HeaderLookup = http.http1_request_header(&parsed, "x-trace");
    if (!@strEq(parsed.method, "POST") || !@strEq(parsed.path, "/items?q=zag") ||
        !@strEq(parsed.body, "body") || host.count != 1 ||
        !@strEq(host.value, "example.test") || trace.count != 1 ||
        !@strEq(trace.value, "42")) { return 4; }

    let response_result: http.Http1BufferResult = http.http1_encode_response(
        200, "OK", headers, "answer=42"
    );
    if (response_result.ok != 1) { return 5; }
    let response_buffer: http.Http1Buffer = http.http1_buffer_take(&response_result);
    let response_bytes: []u8 = http.http1_buffer_slice(&response_buffer);
    if (!@strEq(response_bytes,
        "HTTP/1.1 200 OK\r\nX-Trace: 42\r\nContent-Length: 9\r\n\r\nanswer=42")) {
        return 6;
    }
    let parsed_response_result: http.Http1ResponseResult =
        http.http1_parse_response(response_bytes);
    if (parsed_response_result.ok != 1) { return 7; }
    let parsed_response: http.Http1Response =
        http.http1_response_take(&parsed_response_result);
    let response_trace: http.Http1HeaderLookup =
        http.http1_response_header(&parsed_response, "X-TRACE");
    if (parsed_response.status != 200 || !@strEq(parsed_response.reason, "OK") ||
        !@strEq(parsed_response.body, "answer=42") || response_trace.count != 1) {
        return 8;
    }

    let chunked_result: http.Http1BufferResult = http.http1_encode_chunked(
        "hello-world", 5
    );
    if (chunked_result.ok != 1 || chunked_result.value.open != 1) { return 14; }
    let chunked_buffer: http.Http1Buffer = http.http1_buffer_take(&chunked_result);
    let chunked_bytes: []u8 = http.http1_buffer_slice(&chunked_buffer);
    if (!@strEq(chunked_bytes,
        "5\r\nhello\r\n5\r\n-worl\r\n1\r\nd\r\n0\r\n\r\n")) {
        return 15;
    }
    let decoded_result: http.Http1BufferResult = http.http1_decode_chunked(
        chunked_bytes
    );
    if (decoded_result.ok != 1 || decoded_result.value.open != 1) { return 16; }
    let decoded_buffer: http.Http1Buffer = http.http1_buffer_take(&decoded_result);
    if (!@strEq(http.http1_buffer_slice(&decoded_buffer), "hello-world")) {
        return 17;
    }
    let chunk_extension: http.Http1BufferResult = http.http1_decode_chunked(
        "5;ignored\r\nhello\r\n0\r\n\r\n"
    );
    let chunk_truncated: http.Http1BufferResult = http.http1_decode_chunked(
        "5\r\nhello\r\n0\r\n"
    );
    let chunk_trailer: http.Http1BufferResult = http.http1_decode_chunked(
        "5\r\nhello\r\n0\r\n\r\nTrailer: x\r\n"
    );
    let chunk_bad_crlf: http.Http1BufferResult = http.http1_decode_chunked(
        "5\nhello\r\n0\r\n\r\n"
    );
    if (chunk_extension.code != http.http1_status_unsupported() ||
        chunk_truncated.code != http.http1_status_truncated() ||
        chunk_trailer.code != http.http1_status_unsupported() ||
        chunk_bad_crlf.code != http.http1_status_malformed()) { return 18; }

    // Full-message chunked framing is an explicit opt-in adapter.  It owns a
    // normalized body, while the ordinary parser above continues to reject
    // Transfer-Encoding so callers cannot accidentally mix framing domains.
    let framed_request_result: http.Http1BufferResult =
        http.http1_encode_request_chunked("POST", "/items", "example.test",
            headers, "hello-world", 5);
    if (framed_request_result.ok != 1 || framed_request_result.value.open != 1) { return 19; }
    let framed_request_buffer: http.Http1Buffer =
        http.http1_buffer_take(&framed_request_result);
    let framed_request_bytes: []u8 =
        http.http1_buffer_slice(&framed_request_buffer);
    if (!@strEq(framed_request_bytes,
        "POST /items HTTP/1.1\r\nHost: example.test\r\nX-Trace: 42\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n5\r\n-worl\r\n1\r\nd\r\n0\r\n\r\n")) { return 20; }
    let framed_request_body: http.Http1BufferResult =
        http.http1_message_body_auto(framed_request_bytes);
    if (framed_request_body.ok != 1) { return 21; }
    let framed_request_body_buffer: http.Http1Buffer =
        http.http1_buffer_take(&framed_request_body);
    if (!@strEq(http.http1_buffer_slice(&framed_request_body_buffer), "hello-world")) { return 22; }

    let framed_response_result: http.Http1BufferResult =
        http.http1_encode_response_chunked(200, "OK", headers, "answer=42", 4);
    if (framed_response_result.ok != 1) { return 23; }
    let framed_response_buffer: http.Http1Buffer =
        http.http1_buffer_take(&framed_response_result);
    let framed_response_bytes: []u8 = http.http1_buffer_slice(&framed_response_buffer);
    let framed_response_body: http.Http1BufferResult =
        http.http1_message_body_auto(framed_response_bytes);
    if (framed_response_body.ok != 1) { return 24; }
    let framed_response_body_buffer: http.Http1Buffer =
        http.http1_buffer_take(&framed_response_body);
    if (!@strEq(http.http1_buffer_slice(&framed_response_body_buffer), "answer=42")) { return 25; }

    let smuggled: http.Http1BufferResult = http.http1_message_body_auto(
        "POST / HTTP/1.1\r\nHost: one\r\nContent-Length: 4\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n");
    let unsupported_coding: http.Http1BufferResult = http.http1_message_body_auto(
        "POST / HTTP/1.1\r\nHost: one\r\nTransfer-Encoding: gzip\r\n\r\n");
    if (smuggled.code != http.http1_status_malformed() ||
        unsupported_coding.code != http.http1_status_unsupported()) { return 26; }

    let trailers: ArrayList[http.Http1Header] = make[http.Http1Header](2);
    push[http.Http1Header](&trailers, http.Http1Header{
        .name = "Digest", .value = "sha-256=abc",
    });
    let trailer_encoded: http.Http1BufferResult =
        http.http1_encode_chunked_with_trailers_bounded(
            "hello", 5, trailers, http.http1_default_limits());
    if (trailer_encoded.ok != 1 || trailer_encoded.value.open != 1) { return 27; }
    let trailer_buffer: http.Http1Buffer = http.http1_buffer_take(&trailer_encoded);
    if (!@strEq(http.http1_buffer_slice(&trailer_buffer),
        "5\r\nhello\r\n0\r\nDigest: sha-256=abc\r\n\r\n")) { return 28; }
    let trailer_request: http.Http1BufferResult =
        http.http1_encode_request_chunked_with_trailers_bounded(
            "POST", "/items", "example.test", headers, "hello", 5,
            trailers, http.http1_default_limits());
    if (trailer_request.ok != 1) { return 32; }
    let trailer_request_buffer: http.Http1Buffer =
        http.http1_buffer_take(&trailer_request);
    if (!@strEq(http.http1_buffer_slice(&trailer_request_buffer),
        "POST /items HTTP/1.1\r\nHost: example.test\r\nX-Trace: 42\r\nTrailer: Digest\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\nDigest: sha-256=abc\r\n\r\n")) { return 33; }
    let trailer_request_body: http.Http1BufferResult =
        http.http1_message_body_auto(http.http1_buffer_slice(&trailer_request_buffer));
    if (trailer_request_body.ok != 1 ||
        !@strEq(http.http1_buffer_slice(&trailer_request_body.value), "hello")) { return 34; }
    let trailer_response: http.Http1BufferResult =
        http.http1_encode_response_chunked_with_trailers_bounded(
            200, "OK", headers, "answer", 3, trailers,
            http.http1_default_limits());
    if (trailer_response.ok != 1) { return 35; }
    let trailer_response_buffer: http.Http1Buffer =
        http.http1_buffer_take(&trailer_response);
    if (!@strEq(http.http1_buffer_slice(&trailer_response_buffer),
        "HTTP/1.1 200 OK\r\nX-Trace: 42\r\nTrailer: Digest\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nans\r\n3\r\nwer\r\n0\r\nDigest: sha-256=abc\r\n\r\n")) { return 36; }
    let trailer_decoded: http.Http1ChunkedResult =
        http.http1_decode_chunked_with_trailers_bounded(
            http.http1_buffer_slice(&trailer_buffer), http.http1_default_limits());
    if (trailer_decoded.ok != 1 || trailer_decoded.trailers.len != 1 ||
        !@strEq(trailer_decoded.trailers.data[0].name, "Digest") ||
        !@strEq(trailer_decoded.trailers.data[0].value, "sha-256=abc") ||
        !@strEq(http.http1_buffer_slice(&trailer_decoded.value), "hello")) { return 29; }
    let auto_trailer: http.Http1BufferResult = http.http1_message_body_auto(
        "POST / HTTP/1.1\r\nHost: one\r\nTransfer-Encoding: chunked\r\nTrailer: Digest\r\n\r\n5\r\nhello\r\n0\r\nDigest: sha-256=abc\r\n\r\n");
    if (auto_trailer.ok != 1 ||
        !@strEq(http.http1_buffer_slice(&auto_trailer.value), "hello")) { return 30; }
    let duplicate_trailer: http.Http1ChunkedResult =
        http.http1_decode_chunked_with_trailers_bounded(
            "1\r\na\r\n0\r\nX-A: one\r\nx-a: two\r\n\r\n",
            http.http1_default_limits());
    let forbidden_trailer: http.Http1ChunkedResult =
        http.http1_decode_chunked_with_trailers_bounded(
            "0\r\nContent-Length: 1\r\n\r\n", http.http1_default_limits());
    if (duplicate_trailer.code != http.http1_status_malformed() ||
        forbidden_trailer.code != http.http1_status_malformed()) { return 31; }

    let bare_lf: http.Http1RequestResult = http.http1_parse_request(
        "GET / HTTP/1.1\nHost: example.test\nContent-Length: 0\n\n"
    );
    let no_host: http.Http1RequestResult = http.http1_parse_request(
        "GET / HTTP/1.1\r\nContent-Length: 0\r\n\r\n"
    );
    let duplicate_host: http.Http1RequestResult = http.http1_parse_request(
        "GET / HTTP/1.1\r\nHost: one\r\nHost: two\r\nContent-Length: 0\r\n\r\n"
    );
    let duplicate_length: http.Http1RequestResult = http.http1_parse_request(
        "GET / HTTP/1.1\r\nHost: one\r\nContent-Length: 0\r\nContent-Length: 0\r\n\r\n"
    );
    let transfer: http.Http1RequestResult = http.http1_parse_request(
        "POST / HTTP/1.1\r\nHost: one\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n"
    );
    let truncated: http.Http1RequestResult = http.http1_parse_request(
        "POST / HTTP/1.1\r\nHost: one\r\nContent-Length: 4\r\n\r\nabc"
    );
    let trailing: http.Http1RequestResult = http.http1_parse_request(
        "POST / HTTP/1.1\r\nHost: one\r\nContent-Length: 3\r\n\r\nabcd"
    );
    let folded: http.Http1RequestResult = http.http1_parse_request(
        "GET / HTTP/1.1\r\nHost: one\r\n folded\r\nContent-Length: 0\r\n\r\n"
    );
    let bad_name: http.Http1RequestResult = http.http1_parse_request(
        "GET / HTTP/1.1\r\nHost : one\r\nContent-Length: 0\r\n\r\n"
    );
    if (bare_lf.code != http.http1_status_malformed() ||
        no_host.code != http.http1_status_malformed() ||
        duplicate_host.code != http.http1_status_malformed() ||
        duplicate_length.code != http.http1_status_malformed() ||
        transfer.code != http.http1_status_unsupported() ||
        truncated.code != http.http1_status_truncated() ||
        trailing.code != http.http1_status_malformed() ||
        folded.code != http.http1_status_malformed() ||
        bad_name.code != http.http1_status_malformed()) { return 9; }

    let tiny: http.Http1Limits = http.http1_default_limits();
    tiny.max_message_bytes = 64;
    tiny.max_header_bytes = 64;
    tiny.max_body_bytes = 8;
    let too_large_encode: http.Http1BufferResult = http.http1_encode_request_bounded(
        "POST", "/", "example.test", headers, "012345678", tiny
    );
    let too_large_parse: http.Http1RequestResult = http.http1_parse_request_bounded(
        request_bytes, tiny
    );
    let count_limits: http.Http1Limits = http.http1_default_limits();
    count_limits.max_header_count = 2;
    let too_many_encode: http.Http1BufferResult = http.http1_encode_request_bounded(
        "GET", "/", "example.test", headers, "", count_limits
    );
    let too_many_parse: http.Http1RequestResult = http.http1_parse_request_bounded(
        request_bytes, count_limits
    );
    let bad_method: http.Http1BufferResult = http.http1_encode_request(
        "BAD METHOD", "/", "example.test", headers, ""
    );
    let proxy_path: http.Http1BufferResult = http.http1_encode_request(
        "GET", "http://example.test/", "example.test", headers, ""
    );
    let bad_host: http.Http1BufferResult = http.http1_encode_request(
        "GET", "/", "bad host", headers, ""
    );
    if (too_large_encode.code != http.http1_status_limit() ||
        too_large_parse.code != http.http1_status_limit() ||
        too_many_encode.code != http.http1_status_limit() ||
        too_many_parse.code != http.http1_status_limit() ||
        bad_method.code != http.http1_status_invalid_argument() ||
        proxy_path.code != http.http1_status_invalid_argument() ||
        bad_host.code != http.http1_status_invalid_argument()) { return 10; }

    if (http.http1_request_close(&parsed) != http.http1_status_ok() ||
        http.http1_request_close(&parsed) != http.http1_status_invalid_state() ||
        http.http1_response_close(&parsed_response) != http.http1_status_ok() ||
        http.http1_response_close(&parsed_response) != http.http1_status_invalid_state() ||
        http.http1_buffer_close(&request_buffer) != http.http1_status_ok() ||
        http.http1_buffer_close(&request_buffer) != http.http1_status_invalid_state() ||
        http.http1_buffer_close(&response_buffer) != http.http1_status_ok() ||
        http.http1_buffer_close(&chunked_buffer) != http.http1_status_ok() ||
        http.http1_buffer_close(&chunked_buffer) != http.http1_status_invalid_state() ||
        http.http1_buffer_close(&decoded_buffer) != http.http1_status_ok() ||
        http.http1_buffer_close(&framed_request_buffer) != http.http1_status_ok() ||
        http.http1_buffer_close(&framed_request_body_buffer) != http.http1_status_ok() ||
        http.http1_buffer_close(&framed_response_buffer) != http.http1_status_ok() ||
        http.http1_buffer_close(&framed_response_body_buffer) != http.http1_status_ok() ||
        http.http1_buffer_close(&trailer_buffer) != http.http1_status_ok() ||
        http.http1_buffer_close(&trailer_request_buffer) != http.http1_status_ok() ||
        http.http1_buffer_close(&trailer_request_body.value) != http.http1_status_ok() ||
        http.http1_buffer_close(&trailer_response_buffer) != http.http1_status_ok() ||
        http.http1_chunked_close(&trailer_decoded) != http.http1_status_ok() ||
        http.http1_buffer_close(&auto_trailer.value) != http.http1_status_ok()) {
        return 11;
    }
    free[http.Http1Header](&duplicate_trailer.trailers);
    free[http.Http1Header](&forbidden_trailer.trailers);
    free[http.Http1Header](&trailers);
    free[http.Http1Header](&headers);
    if (_zag_allocator_live_bytes() != baseline) { return 12; }
    return 0;
}
