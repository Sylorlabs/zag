// Narrow import fixture for the production ZIR scalar-call seam.
// Public declarations are the only external candidates; private and generic
// declarations exercise the fail-closed boundary in the native proof.
pub fn add_i32(a:i32,b:i32) i32 { return a+b; }
pub fn add_i64(a:i64,b:i64) i64 { return a+b; }
pub fn one_i32() i32 { return 41; }
pub fn one_i64() i64 { return 41; }
fn private_i32(a:i32,b:i32) i32 { return a+b; }
// A public imported body may call a private helper from the same source
// module. The direct-call provenance rule admits that internal edge while
// keeping the helper unreachable from the importing root.
pub fn add_i32_via_helper(a:i32,b:i32) i32 { return private_i32(a,b); }
// The source name itself contains `__`; an unqualified import must not be
// mistaken for a parser-produced explicit alias clone.
pub fn fake__qualified(a:i32,b:i32) i32 { return a+b; }
pub fn wrong_i32_param(a:i64,b:i64) i32 { return (a+b) as i32; }
