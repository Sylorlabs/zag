// The zero case is intentional: Zag defines trailing_zeros(0) as the i64 bit
// width, matching BMI1 TZCNT rather than the undefined BSF instruction.
extern fn trailing_zeros(value:i64)i64;

fn main() i32 {
    if (trailing_zeros(0) != 64) { return 10; }
    if (trailing_zeros(1) != 0) { return 11; }
    if (trailing_zeros(8) != 3) { return 12; }
    if (trailing_zeros(0 - 16) != 4) { return 13; }
    return 42;
}
