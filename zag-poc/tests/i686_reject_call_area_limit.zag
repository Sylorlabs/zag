// S13 occupies exactly 16,384 i386 words. The additional i32 would require
// more than the backend's bounded 64 KiB outgoing argument area.
struct S0 { a:i32, b:i32 }
struct S1 { a:S0, b:S0 }
struct S2 { a:S1, b:S1 }
struct S3 { a:S2, b:S2 }
struct S4 { a:S3, b:S3 }
struct S5 { a:S4, b:S4 }
struct S6 { a:S5, b:S5 }
struct S7 { a:S6, b:S6 }
struct S8 { a:S7, b:S7 }
struct S9 { a:S8, b:S8 }
struct S10 { a:S9, b:S9 }
struct S11 { a:S10, b:S10 }
struct S12 { a:S11, b:S11 }
struct S13 { a:S12, b:S12 }

fn too_many(value:S13, extra:i32) i32 { return extra; }
fn main() i32 { return 42; }
