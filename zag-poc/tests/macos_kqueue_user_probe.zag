// Direct Darwin service probe for the two kernel facilities used by the
// macOS SPSC channel: anonymous mmap and EVFILT_USER kqueue notifications.

extern fn _zag_darwin_syscall(num: i64, a1: i64, a2: i64, a3: i64,
                              a4: i64, a5: i64, a6: i64) i64

struct MacosUserKevent {
    ident: i64,
    // ABI-exact Darwin `struct kevent` layout on arm64. Zag word-aligns scalar
    // struct fields, so filter/flags/fflags share this packed word.
    filter_flags: i64,
    data: i64,
    udata: i64,
}

struct MacosChannelTimespec {
    seconds: i64,
    nanoseconds: i64,
}

fn main() i32 {
    let address: i64 = _zag_darwin_syscall(
        197, 0, 4096, 3, 4098, 0 - 1, 0
    );
    if (address < 0) { return (0 - address) as i32; }
    let unmap: i64 = _zag_darwin_syscall(73, address, 4096, 0, 0, 0, 0);
    if (unmap < 0) { return 40 + ((0 - unmap) as i32); }

    let kq: i64 = _zag_darwin_syscall(362, 0, 0, 0, 0, 0, 0);
    if (kq < 0) { return 80 + ((0 - kq) as i32); }
    let add: MacosUserKevent = MacosUserKevent{
        .ident = 1,
        .filter_flags = 2228214,
        .data = 0,
        .udata = 77,
    };
    let add_rc: i64 = _zag_darwin_syscall(
        363, kq, (&add) as i64, 1, 0, 0, 0
    );
    if (add_rc < 0) {
        let _closed: i64 = _zag_darwin_syscall(6, kq, 0, 0, 0, 0, 0);
        return 120 + ((0 - add_rc) as i32);
    }
    let trigger: MacosUserKevent = MacosUserKevent{
        .ident = 1,
        .filter_flags = 72057594037993462,
        .data = 0,
        .udata = 0,
    };
    let trigger_rc: i64 = _zag_darwin_syscall(
        363, kq, (&trigger) as i64, 1, 0, 0, 0
    );
    if (trigger_rc < 0) {
        let _closed: i64 = _zag_darwin_syscall(6, kq, 0, 0, 0, 0, 0);
        return 140 + ((0 - trigger_rc) as i32);
    }
    let received: MacosUserKevent = MacosUserKevent{
        .ident = 0,
        .filter_flags = 0,
        .data = 0,
        .udata = 0,
    };
    let timeout: MacosChannelTimespec = MacosChannelTimespec{
        .seconds = 1,
        .nanoseconds = 0,
    };
    let wait_rc: i64 = _zag_darwin_syscall(
        363, kq, 0, 0, (&received) as i64, 1, (&timeout) as i64
    );
    let close_rc: i64 = _zag_darwin_syscall(6, kq, 0, 0, 0, 0, 0);
    if (wait_rc < 0) { return 160 + ((0 - wait_rc) as i32); }
    if (wait_rc != 1 || received.ident != 1 ||
        (received.filter_flags & 65535) != 65526) {
        return 199;
    }
    if (close_rc < 0) { return 200; }
    return 42;
}
