        vk_put_word(spv,816,34);
        vk_put_word(spv,820,65789);
        vk_put_word(spv,824,65592);
        let push:*u8=mmap(null as *u8,8,3,34,-1,0); vk_put_word(push,0,42); vk_put_word(push,4,1024);
        let vk_out_mem:*u8=mmap(null as *u8,8192,3,34,-1,0); let vk_out:*i32=vk_out_mem as *i32;
        let vk_rc:i32=zag_vulkan_compat_dispatch(&vk,spv,207,vk_out,1024,push,8,1024,1,1,1000000000);
        if (vk_rc!=0) { return fail(vk_rc); }
        let vi:u32=0; while (vi<1024) { if (vk_out[vi as i32]!=42) { return fail(-1001); } vi=vi+1; }
        vk_put_word(push,0,7); vk_put_word(push,4,17);
        let vk_small_mem:*u8=mmap(null as *u8,136,3,34,-1,0); let vk_small:*i32=vk_small_mem as *i32;
        let vk_small_rc:i32=zag_vulkan_compat_dispatch(&vk,spv,207,vk_small,17,push,8,17,1,1,1000000000);
        if (vk_small_rc!=0) { return fail(vk_small_rc); }
        let vsi:u32=0; while (vsi<17) { if (vk_small[vsi as i32]!=7) { return fail(-1002); } vsi=vsi+1; }
        munmap(spv,828);munmap(push,8);munmap(vk_out_mem,8192);munmap(vk_small_mem,136);
    }
    zag_vulkan_compat_close(&vk);
    let gl:ZagOpenGLCompatContext=zag_opengl_compat_open();
    if (!gl.available) { return fail(-1100+gl.error_code); }
    unsafe {
        let gl_text:[]u8="#version 430\nlayout(local_size_x=1) in; layout(std430,binding=0) buffer Out { int out_data[]; }; uniform int value; uniform int count; void main(){ uint i=gl_GlobalInvocationID.x; if(i<uint(count)) out_data[i]=value; }";
        let gl_source:*u8=mmap(null as *u8,512,3,34,-1,0);
        let gi:u32=0; while (gi<gl_text.len) { gl_source[gi as i32]=gl_text[gi as i32]; gi=gi+1; }
        let gl_out_mem:*u8=mmap(null as *u8,8192,3,34,-1,0); let gl_out:*i32=gl_out_mem as *i32;
        let gl_rc:i32=zag_opengl_compat_dispatch(&gl,gl_source,gl_text.len as u64,gl_out,1024,42,1024,1024,1,1,1000000000);
        if (gl_rc!=0) { zag_opengl_compat_close(&gl); return fail(gl_rc); }
        let gi2:u32=0; while (gi2<1024) { if (gl_out[gi2 as i32]!=42) { zag_opengl_compat_close(&gl); return fail(-1101); } gi2=gi2+1; }
        let gl_small_mem:*u8=mmap(null as *u8,136,3,34,-1,0); let gl_small:*i32=gl_small_mem as *i32;
        let gl_small_rc:i32=zag_opengl_compat_dispatch(&gl,gl_source,gl_text.len as u64,gl_small,17,7,17,17,1,1,1000000000);
        if (gl_small_rc!=0) { zag_opengl_compat_close(&gl); return fail(gl_small_rc); }
        let gsi:u32=0; while (gsi<17) { if (gl_small[gsi as i32]!=7) { zag_opengl_compat_close(&gl); return fail(-1102); } gsi=gsi+1; }
        munmap(gl_source,512); munmap(gl_out_mem,8192); munmap(gl_small_mem,136);
    }
    zag_opengl_compat_close(&gl);
    let cl:ZagOpenCLCompatContext=zag_opencl_compat_open();
    if (!cl.available) { return fail(-1200+cl.error_code); }
    unsafe {
        let cl_text:[]u8="__kernel void fillKernel(__global int* out, int value, int count) { size_t i=get_global_id(0); if (i < (size_t)count) out[i]=value; }";
        let cl_source:*u8=mmap(null as *u8,256,3,34,-1,0);
        let ci:u32=0; while (ci<cl_text.len) { cl_source[ci as i32]=cl_text[ci as i32]; ci=ci+1; }
        cl_source[cl_text.len as i32]=0;
        let cl_out_mem:*u8=mmap(null as *u8,8192,3,34,-1,0); let cl_out:*i32=cl_out_mem as *i32;
        let cl_rc:i32=zag_opencl_compat_dispatch(&cl,null as *u8,0,cl_source,cl_text.len as u64,null as *u8,cl_out,1024,42,1024,1024,64,1000000000);
        if (cl_rc!=0) { zag_opencl_compat_close(&cl); return fail(cl_rc); }
        let ci2:u32=0; while (ci2<1024) { if (cl_out[ci2 as i32]!=42) { zag_opencl_compat_close(&cl); return fail(-1201); } ci2=ci2+1; }
        let cl_small_mem:*u8=mmap(null as *u8,136,3,34,-1,0); let cl_small:*i32=cl_small_mem as *i32;
        let cl_small_rc:i32=zag_opencl_compat_dispatch(&cl,null as *u8,0,cl_source,cl_text.len as u64,null as *u8,cl_small,17,123,17,17,1,1000000000);
        if (cl_small_rc!=0) { zag_opencl_compat_close(&cl); return fail(cl_small_rc); }
        let csi:u32=0; while (csi<17) { if (cl_small[csi as i32]!=123) { zag_opencl_compat_close(&cl); return fail(-1202); } csi=csi+1; }
        munmap(cl_source,256); munmap(cl_out_mem,8192); munmap(cl_small_mem,136);
    }
    zag_opencl_compat_shutdown_process(&cl,0);
    return 0;
}
