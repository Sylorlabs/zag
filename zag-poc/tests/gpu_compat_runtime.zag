// End-to-end pure-Zag compatibility adapters.  The surrounding gate links
// this one driver against the installed Vulkan, EGL/OpenGL, and OpenCL ICDs.
@import("std/vulkan_loader.zag")
@import("std/opengl_loader.zag")
@import("std/opencl_loader.zag")
@import("std/gpu_compat_contract.zag")

extern fn _zag_println(text:[]u8) void;
extern fn _zag_i64_to_str(v:i64) []u8;

fn fail(code:i32) i32 {
    _zag_println("Zag pure GPU runtime failure");
    let text:[]u8=_zag_i64_to_str(code as i64);
    _zag_println(text);
    _zag_str_free(text);
    return code;
}

fn vk_put_word(mem:*u8, offset:i32, word:i64) void {
    mem[offset]=(word & 255) as u8; mem[offset+1]=((word>>8)&255) as u8;
    mem[offset+2]=((word>>16)&255) as u8; mem[offset+3]=((word>>24)&255) as u8;
}

fn main() i32 {
    let invalid_readback:i32=zag_gpu_compat_validate_readback(
        ZagGpuCompatReadback{.output_buffer=null as *i32,.output_count=1});
    if (invalid_readback!=-202) { return fail(-900); }
    let invalid_launch:i32=zag_gpu_compat_validate_launch(
        ZagGpuCompatLaunch{.group_count_x=0,.group_count_y=1,.group_count_z=1,.local_work_size=0,.timeout_ns=1000000000});
    if (invalid_launch!=-201) { return fail(-901); }
    let invalid_timeout:i32=zag_gpu_compat_validate_launch(
        ZagGpuCompatLaunch{.group_count_x=1,.group_count_y=1,.group_count_z=1,.local_work_size=0,.timeout_ns=60000000001});
    if (invalid_timeout!=-201) { return fail(-902); }
    unsafe {
        let contract_mem:*u8=mmap(null as *u8,8,3,34,-1,0);
        let contract_rc:i32=zag_gpu_compat_validate(
            ZagGpuCompatReadback{.output_buffer=contract_mem as *i32,.output_count=1},
            ZagGpuCompatLaunch{.group_count_x=1,.group_count_y=1,.group_count_z=1,.local_work_size=0,.timeout_ns=1000000000});
        munmap(contract_mem,8);
        if (contract_rc!=0) { return fail(-903); }
    }
    let vk:ZagVulkanCompatContext=zag_vulkan_compat_open();
    if (!vk.available) { return fail(-1000+vk.error_code); }
    unsafe {
        // Canonical bounded fill shader emitted by `vulkan-compat`, packed
        // into a raw four-byte SPIR-V ABI buffer.
        let spv:*u8=mmap(null as *u8,828,3,34,-1,0);
        vk_put_word(spv,0,119734787);
        vk_put_word(spv,4,65536);
        vk_put_word(spv,8,0);
        vk_put_word(spv,12,36);
        vk_put_word(spv,16,0);
        vk_put_word(spv,20,131089);
        vk_put_word(spv,24,1);
