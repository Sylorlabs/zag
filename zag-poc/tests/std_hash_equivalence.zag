// Witness that the overflow-free std/hashmap.zag hashes equal the previous
// wrapping-i32 formulas (edition 2026 root, where wrapping is the semantics),
// and that large i64 keys round-trip through Int64Map. Exit 42 on success.
@import("std/hashmap.zag") as hm

fn old_hash_i32(k: i32) i32 {
    let h: i32 = k * 2654435761 as i32;
    return h & 2147483647;
}
fn old_hash_i64(k: i64) i32 {
    let lo: i32 = k as i32;
    let mix: i32 = (k * 2654435761 as i64) as i32;
    let h: i32 = lo + mix;
    return h & 2147483647;
}
fn old_hash_str(k: []u8) i32 {
    let h: i32 = 5381;
    let i: i32 = 0;
    while (i < k.len) { h = h * 33 + (k[i] as i32); i = i + 1; }
    return h & 2147483647;
}

fn main() i32 {
    let s: u64 = 88172645463325252;
    let i: i32 = 0;
    while (i < 200000) {
        s = s ^ (s << 13); s = s ^ (s >> 7); s = s ^ (s << 17);
        let k64: i64 = s as i64;
        let k32: i32 = (s >> 40) as i32 - 8388608;
        if (hm.hash_i64(k64) != old_hash_i64(k64)) { return 1; }
        if (hm.hash_i32(k32) != old_hash_i32(k32)) { return 2; }
        if (hm.hash_i64(0 - (i as i64)) != old_hash_i64(0 - (i as i64))) { return 3; }
        i = i + 1;
    }
    if (hm.hash_str("a-rather-long-key-that-overflows-djb2-many-times") != old_hash_str("a-rather-long-key-that-overflows-djb2-many-times")) { return 4; }
    if (hm.hash_str("") != old_hash_str("")) { return 5; }
    let m: hm.Int64Map[i64] = hm.int64_make[i64](8);
    hm.int64_put[i64](&m, 9000000000123, 5);
    hm.int64_put[i64](&m, 0 - 9000000000123, 6);
    let a: i64 = hm.int64_get[i64](m, 9000000000123) orelse 0;
    let b: i64 = hm.int64_get[i64](m, 0 - 9000000000123) orelse 0;
    hm.int64_free[i64](&m);
    if (a != 5 || b != 6) { return 6; }
    return 42;
}
