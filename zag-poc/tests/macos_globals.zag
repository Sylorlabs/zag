// Distinct global cells must be zero-filled, writable, and addressable under
// ASLR without sharing the allocator's runtime registry or literal storage.
global let counter: i32;
global let sentinel: i64;

fn add_global(amount: i32) i32 {
    counter = counter + amount;
    return counter;
}

fn shadow_global() i32 {
    let counter: i32 = 3;
    counter = counter + 4;
    return counter;
}

fn main() i32 {
    if (counter != 0 || sentinel != 0) { return 1; }
    sentinel = 987654321;
    if (add_global(40) != 40) { return 2; }
    if (shadow_global() != 7 || counter != 40) { return 5; }
    unsafe {
        let address: *i32 = &counter;
        address.* = address.* + 2;
        let temporary: *i8 = _zag_malloc(24) as *i8;
        temporary[0] = 7;
        let stored: i8 = temporary[0];
        _zag_free(temporary);
        if (stored != 7) { return 3; }
    }
    if (sentinel != 987654321) { return 4; }
    return counter;
}
