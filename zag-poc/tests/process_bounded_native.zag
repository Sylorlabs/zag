@import("../selfhost/std/process.zag") as process

fn main() i32 {
    let ok: process.ProcessResult = process.process_run_bounded("printf hello", 1000, 1024);
    if (process.process_result_state(ok) != process.process_state_exited() ||
        process.process_result_status(ok) != 0 || !@strEq(process.process_result_output(ok), "hello")) { return 1; }

    let timed: process.ProcessResult = process.process_run_bounded("sleep 2", 30, 1024);
    if (process.process_result_state(timed) != process.process_state_timed_out()) { return 2; }

    let closed: process.ProcessResult = process.process_run_bounded("exec 1>&-; sleep 2", 30, 1024);
    if (process.process_result_state(closed) != process.process_state_timed_out()) { return 8; }

    let capped: process.ProcessResult = process.process_run_bounded("yes x", 1000, 64);
    if (process.process_result_state(capped) != process.process_state_output_limit() ||
        process.process_result_output(capped).len != 64) { return 3; }

    let missing: process.ProcessResult = process.process_run_bounded("command_that_does_not_exist_7f3a", 1000, 1024);
    if (process.process_result_state(missing) != process.process_state_exited() ||
        process.process_result_status(missing) != 127) { return 4; }

    let descendants: process.ProcessResult = process.process_run_bounded("sleep 10 & printf $!; wait", 30, 128);
    if (process.process_result_state(descendants) != process.process_state_timed_out()) { return 5; }
    let child_pid: i64 = _zag_str_to_i64(process.process_result_output(descendants));
    if (child_pid <= 0) { return 6; }
    let settle: *i64 = _zag_malloc(16) as *i64;
    settle[0] = 0; settle[1] = 50000000;
    let _settled: i64 = _zag_raw_syscall(35, settle as i64, 0, 0, 0, 0, 0);
    let alive: i64 = _zag_raw_syscall(62, child_pid, 0, 0, 0, 0, 0);
    if (alive != 0 - 3) { return 7; }
    return 0;
}
