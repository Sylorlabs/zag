@import("../selfhost/std/script_format.zag") as fmt
@import("../selfhost/std/script_string.zag") as strings

extern fn _zag_script_context_init(limit:i64, capabilities:i64, execution_policy:i64) *opaque
extern fn _zag_script_context_shutdown(context:*opaque) void
extern fn _zag_script_alloc_used(context:*opaque) i64

fn succeeds(result: fmt.ScriptFormatResult, expected: []u8) bool {
    return result.error == fmt.ScriptFormatError.none && @strEq(result.bytes, expected);
}

fn allocation_failed(result: fmt.ScriptFormatResult) bool {
    return result.error == fmt.ScriptFormatError.allocation_failed && result.bytes.len == 0;
}

fn check_integer(value: i64, expected: []u8) i32 {
    unsafe {
    let context: *opaque = _zag_script_context_init(expected.len as i64, 7, 16843009);
    if (context == null as *opaque) { return 1; }
    let output: fmt.ScriptFormatResult = fmt.script_format_i64(context, value);
    let ok: bool = succeeds(output, expected) &&
        _zag_script_alloc_used(context) == expected.len as i64;
    _zag_script_context_shutdown(context);
    if (!ok) { return 2; }
    return 0;
    }
}

fn main() i32 {
    unsafe {
    let minimum: i64 = (0 - 9223372036854775807) - 1;
    if (check_integer(0, "0") != 0) { return 1; }
    if (check_integer(1, "1") != 0) { return 2; }
    if (check_integer(-1, "-1") != 0) { return 3; }
    if (check_integer(10, "10") != 0) { return 4; }
    if (check_integer(-10, "-10") != 0) { return 5; }
    if (check_integer(1000000000000000000, "1000000000000000000") != 0) { return 6; }
    if (check_integer(9223372036854775807, "9223372036854775807") != 0) { return 7; }
    if (check_integer(minimum, "-9223372036854775808") != 0) { return 8; }
    if (check_integer(-2147483648, "-2147483648") != 0) { return 9; }

    // One byte short: no partial allocation, copy, or accounting increment.
    let short: *opaque = _zag_script_context_init(19, 7, 16843009);
    if (short == null as *opaque) { return 10; }
    if (!allocation_failed(fmt.script_format_i64(short, minimum)) ||
        _zag_script_alloc_used(short) != 0) { return 11; }
    if (!succeeds(fmt.script_format_i64(short, 9223372036854775807), "9223372036854775807")) { return 12; }
    if (!allocation_failed(fmt.script_format_i64(short, 0)) ||
        _zag_script_alloc_used(short) != 19) { return 13; }
    _zag_script_context_shutdown(short);

    let context: *opaque = _zag_script_context_init(64, 7, 16843009);
    if (context == null as *opaque) { return 14; }
    let yes: fmt.ScriptFormatResult = fmt.script_format_bool(context, true);
    let no: fmt.ScriptFormatResult = fmt.script_format_bool(context, false);
    if (!succeeds(yes, "true") || !succeeds(no, "false") ||
        _zag_script_alloc_used(context) != 9) { return 15; }
    let value: fmt.ScriptFormatResult = fmt.script_format_string(context, "hello");
    if (!succeeds(value, "hello") || _zag_script_alloc_used(context) != 14) { return 16; }
    if (!succeeds(fmt.script_format_string(context, ""), "")) { return 17; }
    let result: []u8 = strings.script_string_concat(context, value.bytes, yes.bytes);
    if (!@strEq(result, "hellotrue")) { return 18; }
    _zag_script_context_shutdown(context);

    let exact: *opaque = _zag_script_context_init(4, 7, 16843009);
    if (exact == null as *opaque) { return 19; }
    if (!allocation_failed(fmt.script_format_bool(exact, false)) ||
        _zag_script_alloc_used(exact) != 0) { return 20; }
    if (!succeeds(fmt.script_format_bool(exact, true), "true")) { return 21; }
    if (!allocation_failed(fmt.script_format_string(exact, "x")) ||
        _zag_script_alloc_used(exact) != 4) { return 22; }
    _zag_script_context_shutdown(exact);

    // Heap policy charges a 16-byte ownership record as well as the payload.
    let heap_short: *opaque = _zag_script_context_init(35, 7, 16843010);
    if (heap_short == null as *opaque) { return 23; }
    if (!allocation_failed(fmt.script_format_i64(heap_short, minimum)) ||
        _zag_script_alloc_used(heap_short) != 0) { return 24; }
    _zag_script_context_shutdown(heap_short);
    let heap: *opaque = _zag_script_context_init(36, 7, 16843010);
    if (heap == null as *opaque) { return 25; }
    if (!succeeds(fmt.script_format_i64(heap, minimum), "-9223372036854775808") ||
        _zag_script_alloc_used(heap) != 36) { return 26; }
    _zag_script_context_shutdown(heap);

    // Strings preserve bytes (including NUL), and own a copy of the input.
    let bytes: *opaque = _zag_script_context_init(6, 7, 16843009);
    if (bytes == null as *opaque) { return 27; }
    let original: fmt.ScriptFormatResult = fmt.script_format_string(bytes, "a\0b");
    let copied: fmt.ScriptFormatResult = fmt.script_format_string(bytes, original.bytes);
    if (original.error != fmt.ScriptFormatError.none || copied.error != fmt.ScriptFormatError.none || copied.bytes.len != 3 || copied.bytes[0] != 97 || copied.bytes[1] != 0 || copied.bytes[2] != 98 ||
        _zag_script_alloc_used(bytes) != 6) { return 28; }
    original.bytes[0] = 122;
    if (copied.bytes[0] != 97) { return 29; }
    _zag_script_context_shutdown(bytes);

    // Even empty output has an explicit outcome. Heap ownership overhead can
    // exhaust the budget although the requested payload is zero bytes.
    let empty: *opaque = _zag_script_context_init(16, 7, 16843010);
    if (empty == null as *opaque) { return 30; }
    if (!succeeds(fmt.script_format_string(empty, ""), "") ||
        _zag_script_alloc_used(empty) != 16) { return 31; }
    if (!allocation_failed(fmt.script_format_string(empty, "")) ||
        _zag_script_alloc_used(empty) != 16) { return 32; }
    _zag_script_context_shutdown(empty);
    return 0;
    }
}
