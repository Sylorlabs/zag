// sqrt/sqrtf builtin lowering. Both backends lower to an exact IEEE-754
// hardware square root (x86 SQRTSD, arm64 FSQRT), so exact and correctly
// rounded results are required. A signed or approximated lowering would
// silently return a nearby wrong value, so each check has its own code.
fn main() i32 {
    if (sqrt(4.0) != 2.0) { return 1; }
    if (sqrt(9.0) != 3.0) { return 2; }
    if (sqrt(0.25) != 0.5) { return 3; }
    if (sqrt(1.0) != 1.0) { return 4; }
    if (sqrt(0.0) != 0.0) { return 5; }
    let r: f64 = sqrt(2.0);
    let err: f64 = r * r - 2.0;
    if (err > 0.000000000000001) { return 6; }
    if (err < 0.0 - 0.000000000000001) { return 7; }
    // correctly rounded: sqrt(2) == 0x3FF6A09E667F3BCD == 4609047870845172685
    let rp: *f64 = &r;
    if ((rp as *u64)[0] != 4609047870845172685) { return 8; }
    return 42;
}
