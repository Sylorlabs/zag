// A comparison immediately following a cast must remain an expression.
// It must not be consumed as a dimensioned hardware type suffix.
fn classify(input: []u8, required: i64) i32 {
    if (((input.len) as i64 < required)) { return 1; }
    if (((input.len) as i64 > required)) { return 2; }
    return 42;
}

fn main() i32 {
    return classify("flash", 5);
}
