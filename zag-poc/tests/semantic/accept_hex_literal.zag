// Hex integer literals are supported (0x / 0X, digits + a-f/A-F + '_').
// 0x2a == 42, so a correct implementation exits 42.
fn main() i32 {
    let mask: i32 = 0xff;      // 255
    let shift: i32 = 0x10;     // 16
    let val: i32 = 0xC0DE;     // 49374
    if ((val & mask) != 0xde) { return 1; }   // low byte
    if (shift != 16) { return 2; }
    return 0x2a;
}
