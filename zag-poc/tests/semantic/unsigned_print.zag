// print_u64/print_u32 must render the exact UNSIGNED decimal magnitude.
// A signed decimal routine prints bit-63-set values as negatives.
fn main() i32 {
    print_u64((1 as u64) << 63);          // 9223372036854775808
    print_u64(18446744073709551615);      // u64 max, 20 digits
    print_u32(4000000000);                // bit 31 set
    print_u64(0);
    // Signed printing must stay signed.
    let low: i64 = 0 - 9223372036854775807 - 1;
    print_i64(low);                       // -9223372036854775808
    return 42;
}
