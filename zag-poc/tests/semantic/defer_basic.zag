// tests/semantic/defer_basic.zag — defer/errdefer cleanup semantics
//
// This file exercises:
//   defer expr        — run at all function exits (normal return, early return)
//   errdefer expr     — run only on error exits (return error.X, try propagation)
//   LIFO ordering     — last-registered defer runs first

fn cleanup_a() void { _zag_print("defer A\n"); }
fn cleanup_b() void { _zag_print("defer B\n"); }
fn cleanup_err() void { _zag_print("errdefer ERR\n"); }

error { FailError }

// defer runs at normal (fall-through) exit, in LIFO order.
fn test_normal_exit() i32 {
    defer cleanup_a();
    defer cleanup_b();
    _zag_print("body\n");
    return 0;
}

// defer runs at early return, in LIFO order. Return value preserved.
fn test_early_return() i32 {
    defer cleanup_a();
    defer cleanup_b();
    _zag_print("before return\n");
    return 42;
}

// defer runs on success; both defer and errdefer run on error return.
fn may_fail(x: i32) !i32 {
    defer cleanup_a();
    errdefer cleanup_err();
    if (x == 0) { return error.FailError; }
    return x + 1;
}

// errdefer fires when error propagates via try from a callee.
fn inner(x: i32) !i32 {
    defer cleanup_a();
    errdefer cleanup_err();
    if (x == 0) { return error.FailError; }
    return x + 1;
}

fn outer(x: i32) !i32 {
    let r: i32 = try inner(x);
    return r * 2;
}

fn main() i32 {
    // Normal exit: body, defer B, defer A
    let a: i32 = test_normal_exit();

    // Early return: before return, defer B, defer A, then 42
    let b: i32 = test_early_return();
    print_i32(b);
    _zag_print("\n");

    // Success path: defer A only
    _zag_print("--- success ---\n");
    let c: i32 = may_fail(5) catch 0;
    print_i32(c);
    _zag_print("\n");

    // Error path: defer A + errdefer ERR
    _zag_print("--- error ---\n");
    let d: i32 = may_fail(0) catch -1;

    // try propagation: errdefer fires in inner on error
    _zag_print("--- try error ---\n");
    let e: i32 = outer(0) catch -1;

    return a + 0;
}
