// Unsigned integer semantics. Values with bit 63 set (u64) or bit 31 set in a
// 32-bit slot must compare, divide, modulo, and shift as UNSIGNED. A signed
// lowering silently returns the wrong branch/quotient instead of failing to
// compile, so each check below has its own exit code.
fn main() i32 {
    let top: u64 = (1 as u64) << 63;   // 9223372036854775808, negative as i64
    let one: u64 = 1;

    if (!(top > one)) { return 1; }
    if (!(top >= one)) { return 2; }
    if (!(one < top)) { return 3; }
    if (!(one <= top)) { return 4; }
    if (top < one) { return 5; }
    if (top == one) { return 6; }
    if (top <= one) { return 7; }

    if (top / one != top) { return 8; }
    if (top / 2 != ((1 as u64) << 62)) { return 9; }
    if (top % 3 != 2) { return 10; }

    let max: u64 = 18446744073709551615;
    if (max / 2 != 9223372036854775807) { return 11; }
    if (max % 10 != 5) { return 12; }
    if (!(max > top)) { return 13; }

    // Unsigned right shift stays logical.
    if (top >> 1 != ((1 as u64) << 62)) { return 14; }
    if (max >> 63 != 1) { return 15; }

    // Narrow unsigned types widen zero-extended, so their 64-bit slot ordering
    // and division are unaffected by the signedness of the slot.
    let wide: u32 = 4000000000;
    if (!(wide > 1)) { return 16; }
    if (wide / 2 != 2000000000) { return 17; }
    if (wide % 3 != (4000000000 % 3)) { return 18; }
    let half: u16 = 60000;
    if (!(half > 100)) { return 19; }
    if (half / 2 != 30000) { return 20; }
    let byte: u8 = 200;
    if (!(byte > 7)) { return 21; }
    if (byte / 2 != 100) { return 22; }

    // A positive literal on the LEFT adopts the other operand's type: these are
    // unsigned comparisons/divisions even though the literal has no signedness.
    if (!(1 < top)) { return 26; }
    if (!(0 < top)) { return 27; }
    if (!(1 <= top)) { return 28; }
    if (0 > top) { return 29; }
    if (1 / max != 0) { return 30; }
    if (1 % max != 1) { return 31; }

    // A literal too large for i64 is u64 by construction. Its bit pattern is
    // already exact, so only the operation's signedness needs correcting.
    let lit_half: u64 = 18446744073709551615 / 2;
    if (lit_half != 9223372036854775807) { return 32; }
    let lit_rem: u64 = 18446744073709551615 % 10;
    if (lit_rem != 5) { return 33; }
    if (!(18446744073709551615 > 1)) { return 34; }
    if (!(9223372036854775808 > 9223372036854775807)) { return 35; }
    let hex_half: u64 = 0xFFFFFFFFFFFFFFFF / 2;
    if (hex_half != 9223372036854775807) { return 36; }

    // Signed arithmetic keeps its own semantics.
    let neg: i64 = 0 - 7;
    if (neg > 1) { return 23; }
    if (neg / 2 != 0 - 3) { return 24; }
    if (neg % 2 != 0 - 1) { return 25; }

    return 42;
}
