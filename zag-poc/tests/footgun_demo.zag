// footgun_demo.zag — the uniform-word-ABI heap-corruption footgun that this
// branch makes impossible. Under Zag's native layout every typed-pointer
// element occupies one 8-byte word: `p[i]` through a `*i32` advances 8 bytes,
// NOT 4 (see docs/V2_MEMORY_MODEL.md, `zvec_elem_stride`/`cg_elem_stride`).
//
// BEFORE this change the code below compiled cleanly: `n * 4` is a C-sizeof
// guess — it allocates 4·n bytes but `p[i]` writes 8·i bytes in, so the loop
// silently scribbles 4·n bytes past the allocation (the same class of bug
// that corrupted the heap in DC-3's sha256.zag and crashed DC-1's
// one_engine.zag). AFTER this change `znc` rejects it at compile time with a
// hard error naming the byte-correct fix:
//
//   native: `_zag_malloc`/`_zag_realloc` byte count cannot be proven to hold
//   a whole number of `*i32` elements — `p[i]` advances 8 bytes per element
//   (Zag word ABI), not a C sizeof guess. Fix: use `_zag_alloc_array[i32](count)`
//   or `count * @sizeOf[i32]()`.
//
// This file is intentionally NOT compiled by the test suite as a program —
// tests/run_abi_layout.sh asserts the compiler rejects it with the hard
// error. The commented-out `main` at the bottom shows the typed-primitive
// form, which compiles and runs cleanly.

fn footgun(n: i32) i32 {
    // BUG: byte-count guess. n * 4 bytes < n * 8 bytes needed for p[0..n).
    // `n * 4` cannot be proven to hold a whole number of 8-byte elements for
    // every runtime n, so the compiler rejects this outright.
    let p: *i32 = _zag_malloc(n * 4) as *i32;
    let i: i32 = 0;
    while (i < n) { p[i] = i * i; i = i + 1; }   // writes past the end at i>=n/2
    let s: i32 = 0;
    i = 0;
    while (i < n) { s = s + p[i]; i = i + 1; }
    _zag_free(p as *i8);
    return s;
}

fn main() i32 {
    _zag_println(_zag_i64_to_str(footgun(8) as i64));
    return 0;
}

