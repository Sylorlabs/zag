// Regression for direct frame-slot assignment on the native AArch64 backend.
// The optimized lowering must preserve aliasing and the general lvalue path.
fn bump_indirect(ptr: *i64) i64 {
    let v: i64 = 7;
    v = v + 1;
    ptr.* = ptr.* + v;
    return v;
}

fn main() i32 {
    let x: i64 = 17;
    let alias: *i64 = &x;
    x = x + 3;
    if (alias.* != 20) { return 1; }

    let increment: i64 = bump_indirect(&x);
    if (increment != 8 || x != 28) { return 2; }

    let i: i64 = 0;
    let total: i64 = 0;
    while (i < 3000) {
        total = total + i;
        i = i + 1;
    }
    if (total != 4498500 || i != 3000) { return 3; }

    if (x == 28) {
        let x: i64 = 4;
        x = x + 2;
        if (x != 6) { return 4; }
    }
    if (x != 28) { return 5; }

    let stored: i64 = 10;
    let indirect: *i64 = &stored;
    indirect.* = 42;
    if (stored != 42) { return 6; }

    // RHS modifies the aliased target before the local store takes place.
    x = bump_indirect(&x) + x;
    if (x != 44) { return 7; }
    return 0;
}
