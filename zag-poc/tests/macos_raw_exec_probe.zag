extern fn _zag_raw_syscall(num:i64,a1:i64,a2:i64,a3:i64,a4:i64,a5:i64,a6:i64)i64
extern fn _zag_slice_ptr(s:[]u8)*i8

fn main() i32 {
    let pid:i64=_zag_raw_syscall(57,0,0,0,0,0,0);
    if(pid<0){return 1;}
    if(pid==0){
        let argv:**i8=new(null as *i8); argv[0]=_zag_slice_ptr("/bin/sh\x00"); argv[1]=_zag_slice_ptr("-c\x00"); argv[2]=_zag_slice_ptr("exit 7\x00"); argv[3]=null as *i8;
        let bad:i64=_zag_raw_syscall(59,_zag_slice_ptr("/bin/sh\x00") as i64,argv as i64,0,0,0,0);
        return 30+(0-bad) as i32;
    }
    let status:*i64=new(0); let got:i64=_zag_raw_syscall(61,pid,status as i64,0,0,0,0);
    if(got!=pid){return 2;} return ((status[0]>>8)&255) as i32;
}
