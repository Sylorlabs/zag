@import("../std/gfx1010_vm.zag")
@import("../std/list.zag") as list

fn check(name_: []u8, ok: bool, failures: *i32) void {
    if (ok) { _zag_print("  ok  "); } else { _zag_print("  XX  "); failures.*=failures.*+1; }
    _zag_println(name_);
}

fn push_u32(out: *list.ArrayList[u8], v: i64) void {
    list.push[u8](out,(v&255) as u8); list.push[u8](out,((v/256)&255) as u8);
    list.push[u8](out,((v/65536)&255) as u8); list.push[u8](out,((v/16777216)&255) as u8);
}

fn setreg(out: *list.ArrayList[u8], reg: i64, vals: list.ArrayList[i64]) void {
    push_u32(out,gfxvm_packet3(0x76,vals.len+1));
    push_u32(out,reg-0x2C00);
    let i:i32=0; while(i<vals.len){push_u32(out,vals.data[i]);i=i+1;}
}

fn vals3(a:i64,b:i64,c:i64) list.ArrayList[i64] { let x=list.make[i64](3);list.push[i64](&x,a);list.push[i64](&x,b);list.push[i64](&x,c);return x; }
fn vals2(a:i64,b:i64) list.ArrayList[i64] { let x=list.make[i64](2);list.push[i64](&x,a);list.push[i64](&x,b);return x; }
fn vals6(a:i64,b:i64,c:i64,d:i64,e:i64,f:i64) list.ArrayList[i64] { let x=list.make[i64](6);list.push[i64](&x,a);list.push[i64](&x,b);list.push[i64](&x,c);list.push[i64](&x,d);list.push[i64](&x,e);list.push[i64](&x,f);return x; }
fn vals7(a:i64,b:i64,c:i64,d:i64,e:i64,f:i64,g:i64) list.ArrayList[i64] { let x=list.make[i64](7);list.push[i64](&x,a);list.push[i64](&x,b);list.push[i64](&x,c);list.push[i64](&x,d);list.push[i64](&x,e);list.push[i64](&x,f);list.push[i64](&x,g);return x; }

fn make_ib(shader:i64,target:i64,value:i64,count:i64) list.ArrayList[u8] {
    let ib=list.make[u8](128);
    setreg(&ib,0x2E04,vals3(0,0,0)); setreg(&ib,0x2E07,vals3(1,1,1));
    let pgm:i64=shader/256; setreg(&ib,0x2E0C,vals2(pgm&0xFFFFFFFF,pgm/4294967296));
    setreg(&ib,0x2E12,vals2(0,134)); setreg(&ib,0x2E40,vals3(target&0xFFFFFFFF,target/4294967296,value));
    push_u32(&ib,gfxvm_packet3(0x15,4)); push_u32(&ib,count);
    push_u32(&ib,1); push_u32(&ib,1); push_u32(&ib,1);
    return ib;
}

fn make_depth_ib(shader:i64,color:i64,depth:i64,value:i64,z:i64,count:i64)list.ArrayList[u8]{
    let ib=list.make[u8](160);setreg(&ib,0x2E04,vals3(0,0,0));setreg(&ib,0x2E07,vals3(1,1,1));
    let pgm:i64=shader/256;setreg(&ib,0x2E0C,vals2(pgm&0xFFFFFFFF,pgm/4294967296));
    setreg(&ib,0x2E12,vals2(0,140));setreg(&ib,0x2E40,vals6(color&0xFFFFFFFF,color/4294967296,depth&0xFFFFFFFF,depth/4294967296,value,z));
    push_u32(&ib,gfxvm_packet3(0x15,4));push_u32(&ib,count);push_u32(&ib,1);push_u32(&ib,1);push_u32(&ib,1);return ib;
}

fn make_blend_ib(shader:i64,color:i64,depth:i64,value:i64,z:i64,alpha:i64,count:i64)list.ArrayList[u8]{
    let ib=list.make[u8](176);setreg(&ib,0x2E04,vals3(0,0,0));setreg(&ib,0x2E07,vals3(1,1,1));
    let pgm:i64=shader/256;setreg(&ib,0x2E0C,vals2(pgm&0xFFFFFFFF,pgm/4294967296));
    setreg(&ib,0x2E12,vals2(0,142));setreg(&ib,0x2E40,vals7(color&0xFFFFFFFF,color/4294967296,depth&0xFFFFFFFF,depth/4294967296,value,z,alpha));
    push_u32(&ib,gfxvm_packet3(0x15,4));push_u32(&ib,count);push_u32(&ib,1);push_u32(&ib,1);push_u32(&ib,1);return ib;
}

fn main() i32 {
    let failures:i32=0; let b:Gfx1010VmBundle=gfxvm_bundle_load("/tmp/zag_gfx1010_vm_fill.zgk");
    check("compiler-owned ZGK1 bundle decodes as the complete supported ISA and PM4 contract",b.ok&&b.profile==1&&b.dispatch_initiator==1&&b.pm4_profile==1&&gfxvm_fill_isa_valid(b.code),&failures);
    let ib=make_ib(4096,8192,0xBEEF,16); let mem=list.make[i64](32); mem.len=32; mem.data[31]=0x12345678;
    let r:Gfx1010VmResult=gfxvm_run_fill(b,ib.data[0..ib.len],4096,8192,mem.data,mem.len,1);
    let filled:bool=true; let i:i32=0; while(i<16){if(mem.data[i]!=0xBEEF){filled=false;}i=i+1;}
    check("virtual command processor executes decoded instructions",r.ok&&r.instructions==112&&r.stores==16&&filled,&failures);
    check("virtual ISA execution preserves the guard word",mem.data[31]==0x12345678,&failures);
    let bad_reserved=make_ib(4096,8192,7,1); bad_reserved.data[bad_reserved.len-4]=2;
    check("nonzero reserved dispatch bits fail closed",!gfxvm_decode_dispatch(bad_reserved.data[0..bad_reserved.len],b).ok,&failures);
    let bad_reg=make_ib(4096,8192,7,1); bad_reg.data[4]=(bad_reg.data[4]+1) as u8;
    check("unknown or shifted register programming fails closed",!gfxvm_decode_dispatch(bad_reg.data[0..bad_reg.len],b).ok,&failures);
    let oob=make_ib(4096,8192,7,33);
    check("out-of-bounds virtual dispatch is rejected before execution",gfxvm_run_fill(b,oob.data[0..oob.len],4096,8192,mem.data,mem.len,2).error_code==4,&failures);
    check("shader and target virtual addresses must match mapped objects",gfxvm_run_fill(b,ib.data[0..ib.len],4352,8192,mem.data,mem.len,2).error_code==3,&failures);
    let q:Gfx1010VmQueue=gfxvm_queue_new();
    check("queue requires an explicit CPU-to-device ownership release",gfxvm_queue_submit_fill(&q,b,ib.data[0..ib.len],4096,8192,mem.data,mem.len,1).error_code==5&&q.disabled,&failures);
    let q2:Gfx1010VmQueue=gfxvm_queue_new();
    let released:bool=gfxvm_release_to_device(&q2);
    let qr:Gfx1010VmResult=gfxvm_queue_submit_fill(&q2,b,ib.data[0..ib.len],4096,8192,mem.data,mem.len,1);
    check("ordered queue submission retires a monotonic fence",released&&qr.ok&&q2.last_fence==1,&failures);
    check("device-to-CPU acquire requires the exact retired fence",gfxvm_acquire_from_device(&q2,1)&&q2.owner==0,&failures);
    let _release2:bool=gfxvm_release_to_device(&q2);
    check("a stale fence or ownership anomaly quarantines the queue",!gfxvm_acquire_from_device(&q2,0)&&q2.disabled,&failures);
    let db:Gfx1010VmBundle=gfxvm_bundle_load("/tmp/zag_gfx1010_vm_depth.zgk");
    check("compiler-owned depth bundle validates every load compare branch and store",db.ok&&db.profile==2&&gfxvm_depth_isa_valid(db.code),&failures);
    let colors=list.make[i64](8);colors.len=8;let depths=list.make[i64](8);depths.len=8;
    let di:i32=0;while(di<8){colors.data[di]=1;depths.data[di]=100;di=di+1;}depths.data[3]=10;
    let dib=make_depth_ib(4096,8192,12288,0xCAFE,50,8);
    let dr:Gfx1010VmResult=gfxvm_run_depth(db,dib.data[0..dib.len],4096,8192,12288,colors.data,depths.data,8,7);
    let dexact:bool=true;let dj:i32=0;while(dj<8){if(dj==3){if(colors.data[dj]!=1||depths.data[dj]!=10){dexact=false;}}else{if(colors.data[dj]!=0xCAFE||depths.data[dj]!=50){dexact=false;}}dj=dj+1;}
    check("depth ISA executes signed compare and conditional color/depth stores",dr.ok&&dr.instructions==120&&dr.stores==14&&dexact,&failures);
    let doob=make_depth_ib(4096,8192,12288,7,1,9);
    check("depth dispatch rejects either-buffer overflow before execution",gfxvm_run_depth(db,doob.data[0..doob.len],4096,8192,12288,colors.data,depths.data,8,8).error_code==4,&failures);
    let dq:Gfx1010VmQueue=gfxvm_queue_new();let drel:bool=gfxvm_release_to_device(&dq);
    let dqr:Gfx1010VmResult=gfxvm_queue_submit_depth(&dq,db,dib.data[0..dib.len],4096,8192,12288,colors.data,depths.data,8,1);
    check("depth queue uses the same ownership and exact-fence protocol",drel&&dqr.ok&&gfxvm_acquire_from_device(&dq,1),&failures);
    let bb:Gfx1010VmBundle=gfxvm_bundle_load("/tmp/zag_gfx1010_vm_blend.zgk");
    check("compiler-owned blend bundle validates all 59 instruction words",bb.ok&&bb.profile==3&&gfxvm_blend_isa_valid(bb.code),&failures);
    let bc=list.make[i64](4);bc.len=4;let bz=list.make[i64](4);bz.len=4;
    let bi:i32=0;while(bi<4){bc.data[bi]=0x204060;bz.data[bi]=100;bi=bi+1;}bz.data[3]=10;
    let bib=make_blend_ib(4096,8192,12288,0x80C020,50,128,4);
    let br:Gfx1010VmResult=gfxvm_run_blend(bb,bib.data[0..bib.len],4096,8192,12288,bc.data,bz.data,4,9);
    check("blend ISA executes fixed-point RGB and depth rejection exactly",br.ok&&br.instructions==236&&br.stores==6&&bc.data[0]==0x508040&&bc.data[1]==0x508040&&bc.data[2]==0x508040&&bc.data[3]==0x204060&&bz.data[3]==10,&failures);
    let zero=make_blend_ib(4096,8192,12288,0xFFFFFF,5,0,1);bz.data[0]=10;bc.data[0]=0x123456;
    let zr:Gfx1010VmResult=gfxvm_run_blend(bb,zero.data[0..zero.len],4096,8192,12288,bc.data,bz.data,4,10);
    check("alpha zero preserves color while retiring accepted depth",zr.ok&&bc.data[0]==0x123456&&bz.data[0]==5,&failures);
    let full=make_blend_ib(4096,8192,12288,0xABCDEF,4,256,1);
    let fr:Gfx1010VmResult=gfxvm_run_blend(bb,full.data[0..full.len],4096,8192,12288,bc.data,bz.data,4,11);
    check("alpha 256 replaces all packed RGB channels",fr.ok&&bc.data[0]==0xABCDEF&&bz.data[0]==4,&failures);
    let badalpha=make_blend_ib(4096,8192,12288,7,1,257,1);
    check("out-of-range fixed-point alpha fails before execution",gfxvm_run_blend(bb,badalpha.data[0..badalpha.len],4096,8192,12288,bc.data,bz.data,4,12).error_code==4,&failures);
    let boob=make_blend_ib(4096,8192,12288,7,1,1,5);
    check("blend dispatch rejects either-buffer overflow",gfxvm_run_blend(bb,boob.data[0..boob.len],4096,8192,12288,bc.data,bz.data,4,12).error_code==4,&failures);
    let bq:Gfx1010VmQueue=gfxvm_queue_new();let brel:bool=gfxvm_release_to_device(&bq);
    let bqr:Gfx1010VmResult=gfxvm_queue_submit_blend(&bq,bb,full.data[0..full.len],4096,8192,12288,bc.data,bz.data,4,1);
    check("blend queue uses explicit ownership and exact fences",brel&&bqr.ok&&gfxvm_acquire_from_device(&bq,1),&failures);
    if(failures==0){_zag_println("GFX1010 VM: ALL PASS");return 0;}_zag_println("GFX1010 VM: FAILURES");return 1;
}
