extern fn _zag_darwin_syscall(num:i64,a1:i64,a2:i64,a3:i64,a4:i64,a5:i64,a6:i64)i64
extern fn _zag_code_anchor() i64

fn main() i32 {
    let page:i64=16384;
    let address:i64=_zag_code_anchor();
    let base:i64=address-(address%page);
    let rc:i64=_zag_darwin_syscall(74,base,page,7,0,0,0);
    if(rc<0){return 20+(0-rc) as i32;}
    let _restored:i64=_zag_darwin_syscall(74,base,page,5,0,0,0);
    return 42;
}
