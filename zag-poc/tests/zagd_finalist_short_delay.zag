struct FinalistShortDelayTimespec { sec:i64, nsec:i64 }

fn main()i32{
    let delay:FinalistShortDelayTimespec=FinalistShortDelayTimespec{.sec=0,.nsec=20000000};
    let _slept:i64=_zag_raw_syscall(35,(&delay) as i64,0,0,0,0,0);
    _zag_print("final-out");
    _zag_eprintln("final-err");
    return 7;
}
