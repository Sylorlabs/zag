@import("std:channel_mpmc_i64") as channel

extern fn _zag_allocator_live_bytes() i64

fn main() i32 {
    let baseline:i64=_zag_allocator_live_bytes();
    let one:channel.ChannelMpmcI64Result=channel.channel_mpmc_i64_create(1);
    let bad:channel.ChannelMpmcI64Result=channel.channel_mpmc_i64_create(3);
    let too_large:channel.ChannelMpmcI64Result=channel.channel_mpmc_i64_create(128);
    if(one.ok!=0||bad.ok!=0||too_large.ok!=0||
       one.code!=channel.channel_mpmc_i64_status_invalid_argument()||
       bad.code!=channel.channel_mpmc_i64_status_invalid_argument()||
       too_large.code!=channel.channel_mpmc_i64_status_invalid_argument()){return 1;}

    let created:channel.ChannelMpmcI64Result=channel.channel_mpmc_i64_create(4);
    if(created.ok==0){return 2;}
    let queue:channel.ChannelMpmcI64=channel.channel_mpmc_i64_take(&created);
    if(channel.channel_mpmc_i64_take(&created).open!=0){return 3;}
    let empty:channel.ChannelMpmcI64OpResult=channel.channel_mpmc_i64_try_receive(&queue);
    if(empty.ok!=0||empty.code!=channel.channel_mpmc_i64_status_empty()){return 4;}
    let i:i64=0;
    while(i<4){
        if(channel.channel_mpmc_i64_try_send(&queue,100+i).ok==0){return 5;}
        i=i+1;
    }
    let full:channel.ChannelMpmcI64OpResult=channel.channel_mpmc_i64_try_send(&queue,999);
    if(full.ok!=0||full.code!=channel.channel_mpmc_i64_status_full()){return 6;}
    let first:channel.ChannelMpmcI64OpResult=channel.channel_mpmc_i64_try_receive(&queue);
    let second:channel.ChannelMpmcI64OpResult=channel.channel_mpmc_i64_try_receive(&queue);
    if(first.ok==0||second.ok==0||first.value!=100||second.value!=101){return 7;}
    if(channel.channel_mpmc_i64_try_send(&queue,200).ok==0||
       channel.channel_mpmc_i64_try_send(&queue,201).ok==0){return 8;}
    let third:channel.ChannelMpmcI64OpResult=channel.channel_mpmc_i64_try_receive(&queue);
    let fourth:channel.ChannelMpmcI64OpResult=channel.channel_mpmc_i64_try_receive(&queue);
    let fifth:channel.ChannelMpmcI64OpResult=channel.channel_mpmc_i64_try_receive(&queue);
    let sixth:channel.ChannelMpmcI64OpResult=channel.channel_mpmc_i64_try_receive(&queue);
    if(third.ok==0||fourth.ok==0||fifth.ok==0||sixth.ok==0||
       third.value!=102||fourth.value!=103||fifth.value!=200||sixth.value!=201){return 9;}
    if(channel.channel_mpmc_i64_close(&queue)!=0||
       channel.channel_mpmc_i64_close(&queue)!=channel.channel_mpmc_i64_status_invalid_state()){return 10;}
    if(channel.channel_mpmc_i64_try_send(&queue,1).code!=channel.channel_mpmc_i64_status_invalid_state()||
       channel.channel_mpmc_i64_try_receive(&queue).code!=channel.channel_mpmc_i64_status_invalid_state()){return 11;}
    if(_zag_allocator_live_bytes()!=baseline){return 12;}
    return 0;
}
