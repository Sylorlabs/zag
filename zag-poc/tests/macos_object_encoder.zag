@import("../selfhost/native/macho_object_encoder.zag")

fn invalid_case(kind: i32) i32 {
    let program: ArrayList[AInstr] = make[AInstr](4);
    let data: ArrayList[u8] = make[u8](1);
    push[u8](&data, 42);
    let imports: ArrayList[[]u8] = make[[]u8](1);
    push[[]u8](&imports, "getpid");
    let exports: ArrayList[AObjectExport] = make[AObjectExport](1);
    push[AObjectExport](&exports, AObjectExport{.name="answer",.label=1});
    if (kind == 1) { push[AInstr](&program, ai_label(1)); }
    else { push[AInstr](&program, ai_fn_label(1)); }
    if (kind == 2) { push[AInstr](&program, ai_fn_label(1)); }
    if (kind == 3) { push[AInstr](&program, ai_jmp(99)); }
    if (kind == 4) { push[AInstr](&program, ai_jmp(-1)); }
    if (kind == 5) { push[AInstr](&program, ai_data_addr(A_X0(), 2)); }
    if (kind == 6) { push[AInstr](&program, ai_extern_call(1)); }
    if (kind == 7) { exports.data[0].name = "bad\0name"; }
    if (kind == 8) { imports.data[0] = ""; }
    if (kind == 9) { push[AInstr](&program, ai_fn_label(8388608)); }
    push[AInstr](&program, ai_ret());
    let encoded: MobjEncoded = mobj_encode_macos(program, data, imports, exports);
    let ok: i32 = (encoded.valid == 0) as i32;
    mobj_encoded_release(&encoded);
    free[AInstr](&program); free[u8](&data);
    free[[]u8](&imports); free[AObjectExport](&exports);
    return ok;
}

fn main() i32 {
    if (_zag_argc() != 3) { return 2; }
    let bad: i32 = 1;
    while (bad <= 9) {
        if (invalid_case(bad) != 1) { return 10 + bad; }
        bad = bad + 1;
    }
    let program: ArrayList[AInstr] = make[AInstr](300000);
    let data: ArrayList[u8] = make[u8](8193);
    while (data.len < 8193) { push[u8](&data, 0); }
    data.data[8192] = 42;
    let imports: ArrayList[[]u8] = make[[]u8](1);
    push[[]u8](&imports, "getpid");
    let exports: ArrayList[AObjectExport] = make[AObjectExport](4);
    push[AObjectExport](&exports, AObjectExport{.name="zag_object_answer",.label=1});
    push[AObjectExport](&exports, AObjectExport{.name="zag_object_pid",.label=2});
    push[AObjectExport](&exports, AObjectExport{.name="_zag_object_far_pointer",.label=3});
    push[AInstr](&program, ai_fn_label(3));
    push[AInstr](&program, ai_lea_lbl(A_X0(), 1));
    push[AInstr](&program, ai_ret());
    let padding: i32 = 0;
    while (padding < 270000) {
        push[AInstr](&program, ai_mov_imm(A_X9(), 0)); padding = padding + 1;
    }
    push[AInstr](&program, ai_fn_label(1));
    push[AInstr](&program, ai_data_addr(A_X0(), 8192));
    push[AInstr](&program, ai_loadb(A_X0(), A_X0(), 0));
    push[AInstr](&program, ai_ret());
    push[AInstr](&program, ai_fn_label(2));
    push[AInstr](&program, ai_sub_imm(A_SP(), 16));
    push[AInstr](&program, ai_store(A_SP(), 0, A_X29()));
    push[AInstr](&program, ai_store(A_SP(), 8, A_X30()));
    push[AInstr](&program, ai_mov_rr(A_X29(), A_SP()));
    push[AInstr](&program, ai_extern_call(0));
    push[AInstr](&program, ai_load(A_X29(), A_SP(), 0));
    push[AInstr](&program, ai_load(A_X30(), A_SP(), 8));
    push[AInstr](&program, ai_add_imm(A_SP(), 16));
    push[AInstr](&program, ai_ret());
    let encoded: MobjEncoded = mobj_encode_macos(program, data, imports, exports);
    if (encoded.valid != 1) { return 3; }
    let status: i32 = 0;
    if (@strEq(_zag_arg(2), "archive")) {
        status = mobj_write_static(_zag_arg(1), encoded.text, data, encoded.symbols, encoded.relocs);
    } else {
        status = mobj_write(_zag_arg(1), encoded.text, data, encoded.symbols, encoded.relocs);
    }
    mobj_encoded_release(&encoded);
    free[AInstr](&program); free[u8](&data);
    free[[]u8](&imports); free[AObjectExport](&exports);
    return status;
}
