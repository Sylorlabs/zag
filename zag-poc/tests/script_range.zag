// Script-owned half-open i64 range smoke and bounded failure contract.

script;

let up = range(2, 11, 3);
if (range_failed(up) != 0 || script_list_len[i64](up) != 3 ||
    script_list_get[i64](up, 0) != 2 || script_list_get[i64](up, 1) != 5 ||
    script_list_get[i64](up, 2) != 8) { return 1; }

let down = range(5, -2, -2);
if (range_failed(down) != 0 || script_list_len[i64](down) != 4 ||
    script_list_get[i64](down, 0) != 5 || script_list_get[i64](down, 3) != -1) { return 2; }

let empty = range(7, 7, 1);
if (range_failed(empty) != 0 || script_list_len[i64](empty) != 0) { return 3; }

let invalid = range(0, 10, 0);
if (range_failed(invalid) == 0 || script_list_len[i64](invalid) != 0) { return 4; }

let bounded = range(0, 1048577, 1);
if (range_failed(bounded) == 0 || script_list_len[i64](bounded) != 0) { return 5; }

let maximum: i64 = 9223372036854775807;
let near_max = range(maximum - 1, maximum, 2);
if (range_failed(near_max) != 0 || script_list_len[i64](near_max) != 1 ||
    script_list_get[i64](near_max, 0) != maximum - 1) { return 6; }

let minimum: i64 = (0 - 9223372036854775807) - 1;
let near_min = range(minimum + 1, minimum, 0 - 2);
if (range_failed(near_min) != 0 || script_list_len[i64](near_min) != 1 ||
    script_list_get[i64](near_min, 0) != minimum + 1) { return 7; }

// A next step that would overflow is terminal, never a wrapped value.
let crossing = range(-1, maximum, maximum);
if (range_failed(crossing) != 0 || script_list_len[i64](crossing) != 2 ||
    script_list_get[i64](crossing, 0) != -1 ||
    script_list_get[i64](crossing, 1) != maximum - 1) { return 8; }

let crossing_down = range(maximum, minimum, minimum);
if (range_failed(crossing_down) != 0 || script_list_len[i64](crossing_down) != 2 ||
    script_list_get[i64](crossing_down, 0) != maximum ||
    script_list_get[i64](crossing_down, 1) != -1) { return 9; }

return 0;
