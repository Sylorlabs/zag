// Result-header allocation boundaries for both Script allocator policies.
// Compile with process_lowering_driver: these compiler-owned ABI calls are
// deliberately not part of the public source-language surface.
@import("../selfhost/std/process.zag")
extern fn _zag_script_context_init(limit: i64, capabilities: i64, policy: i64) *opaque;
extern fn _zag_script_context_shutdown(context: *opaque) void;
extern fn _zag_script_alloc(context: *opaque, bytes: i64) *i8;
extern fn _zag_script_alloc_used(context: *opaque) i64;

fn process_result_allocation_case(policy: i64, one_short: i64) i32 {
    let context: *opaque = _zag_script_context_init(128, 7, policy);
    let fill_bytes: i64 = 96 + one_short;
    let used_before: i64 = fill_bytes;
    if (policy == 16843010) { fill_bytes = 64 + one_short; used_before = fill_bytes + 16; }
    let fill: *i8 = _zag_script_alloc(context, fill_bytes);
    if (fill == null as *i8 || _zag_script_alloc_used(context) != used_before) { return 1; }
    let result: ProcessResult = ProcessResult{.handle=process_result_new(context, 1, 23, process_state_exited(), "ok")};
    if (one_short == 0) {
        if (process_result_status(result) != 23 || process_result_state(result) != process_state_exited() ||
            !@strEq(process_result_output(result), "ok") || _zag_script_alloc_used(context) != 128) { return 2; }
        // A second constructor must fail without charging more bytes.
        result = ProcessResult{.handle=process_result_new(context, 1, 99, process_state_exited(), "not-success")};
        used_before = 128;
    }
    if (result.handle != null as *opaque || process_result_status(result) != -1 ||
        process_result_state(result) != process_state_runtime_error() || process_result_output(result).len != 0) { return 3; }
    if (_zag_script_alloc_used(context) != used_before) { return 4; }
    _zag_script_context_shutdown(context);
    return 0;
}

fn main() i32 {
    if (process_result_allocation_case(16843009, 0) != 0) { return 1; }
    if (process_result_allocation_case(16843009, 1) != 0) { return 2; }
    if (process_result_allocation_case(16843010, 0) != 0) { return 3; }
    if (process_result_allocation_case(16843010, 1) != 0) { return 4; }
    _zag_println("process result allocation: exact-fit/exhausted/one-short arena+heap PASS");
    return 0;
}
