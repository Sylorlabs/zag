// Script-owned homogeneous UTF-8 byte-slice set.

script;

let values = text_set();
if (text_set_failed(values) != 0 || text_set_len(values) != 0 ||
    text_set_has(values, "missing")) { return 1; }
if (text_set_add(values, "alpha") != 0 ||
    text_set_add(values, "alpha") != 2 ||
    text_set_add(values, "beta") != 0 ||
    text_set_add(values, "gamma") != 0 ||
    text_set_add(values, "delta") != 0) { return 2; }
if (!text_set_has(values, "alpha") || !text_set_has(values, "delta") ||
    text_set_has(values, "missing") || text_set_len(values) != 4) { return 3; }

// Keys are copied into ScriptContext by the shared ScriptMapText authority.
let caller_key: *u8 = script_alloc(5) as *u8;
if (caller_key == null as *u8) { return 4; }
caller_key[0] = 97; caller_key[1] = 108; caller_key[2] = 112;
caller_key[3] = 104; caller_key[4] = 97;
if (text_set_add(values, caller_key[0..5]) != 2) { return 5; }
caller_key[0] = 88;
if (!text_set_has(values, "alpha") || text_set_has(values, "Xlpha") ||
    text_set_failed(values) != 0) { return 6; }

if (text_set_del(values, "beta") != 0 || text_set_del(values, "beta") != 1 ||
    text_set_has(values, "beta") || text_set_len(values) != 3 ||
    text_set_add(values, "beta") != 0 || text_set_len(values) != 4) { return 7; }
// The facade must preserve the shared text-map backing while inheriting its
// complete pre-write validation and deterministic slot scrub.
let cleared = text_set();
if (text_set_add(cleared, "clear-alpha") != 0 ||
    text_set_add(cleared, "clear-beta") != 0 ||
    text_set_del(cleared, "clear-beta") != 0) { return 8; }
let old_keys: *[]u8 = cleared.map.keys;
let old_values: *[]u8 = cleared.map.values;
let old_used: *u8 = cleared.map.used;
let old_cap: i32 = cleared.map.cap;
let slot: i32 = 0;
while (slot < old_cap) {
    old_keys[slot] = "set-key";
    old_values[slot] = "set-value";
    slot = slot + 1;
}
if (text_set_clear(cleared) != 0 || text_set_len(cleared) != 0 ||
    text_set_failed(cleared) != 0 || cleared.map.cap != old_cap ||
    cleared.map.keys != old_keys || cleared.map.values != old_values ||
    cleared.map.used != old_used) { return 9; }
slot = 0;
while (slot < old_cap) {
    if (old_keys[slot].len != 0 || old_values[slot].len != 0 ||
        old_used[slot] != 0) { return 10; }
    slot = slot + 1;
}
if (text_set_add(cleared, "after-clear") != 0 ||
    !text_set_has(cleared, "after-clear") || text_set_len(cleared) != 1) { return 11; }

let mismatched = text_set();
mismatched.map.keys[0] = "mismatch-key";
mismatched.map.values[0] = "mismatch-value";
mismatched.map.count = 1;
if (text_set_clear(mismatched) != 1 || text_set_failed(mismatched) != 1 ||
    !@strEq(mismatched.map.keys[0], "mismatch-key") ||
    !@strEq(mismatched.map.values[0], "mismatch-value") ||
    mismatched.map.used[0] != 0) { return 12; }

let bad_state = text_set();
bad_state.map.keys[0] = "bad-state-key";
bad_state.map.values[0] = "bad-state-value";
bad_state.map.keys[bad_state.map.cap - 1] = "late-state-key";
bad_state.map.values[bad_state.map.cap - 1] = "late-state-value";
bad_state.map.used[bad_state.map.cap - 1] = 3;
if (text_set_clear(bad_state) != 1 || text_set_failed(bad_state) != 1 ||
    !@strEq(bad_state.map.keys[0], "bad-state-key") ||
    !@strEq(bad_state.map.values[0], "bad-state-value") ||
    !@strEq(bad_state.map.keys[bad_state.map.cap - 1], "late-state-key") ||
    !@strEq(bad_state.map.values[bad_state.map.cap - 1], "late-state-value") ||
    bad_state.map.used[bad_state.map.cap - 1] != 3) { return 13; }
return 0;
