// Positive system-ABI proof: resolve and call a Vulkan loader function without
// cc/as/ld or a custom GPU kernel driver.
extern fn vkEnumerateInstanceVersion(version: *u32) i32 @io;

fn main() i32 {
    let version: u32 = 0;
    let rc: i32 = vkEnumerateInstanceVersion(&version);
    if (rc != 0) { return 1; }
    if (version == 0) { return 2; }
    return 42;
}
