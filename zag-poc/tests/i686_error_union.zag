error { Failed }

fn step(value:i32) !i32 {
    if (value == 0) { return error.Failed; }
    return value;
}

fn twice(value:i32) !i32 {
    let first:i32=try step(value);
    return first + first;
}

fn main() i32 {
    let ok:i32=twice(21) catch 1;
    let failed:i32=twice(0) catch 42;
    if (ok == 42) { return failed; }
    return 1;
}
