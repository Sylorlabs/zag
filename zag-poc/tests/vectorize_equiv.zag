// tests/vectorize_equiv.zag — a SELF-CHECKING equivalence test.
//
// `vec_sum` is the vectorizable unit-stride accumulate. `ref_sum` is the same
// loop with a call in the body, which the vectorizer MUST refuse (reject code
// 10: an unmodelled side effect per iteration is not equivalent under
// lane-parallel execution). So `ref_sum` is a genuine scalar reference computed
// by the same compiler, in the same binary, from the same memory.
//
// The program reads its data from a fixed virtual address inside its own image
// rather than from a local array, because edition 2026 has no array literals and
// no globals. `main` produces that pointer with a same-width cast, which is the
// only way the direct lowering can form a pointer value at all — so this file
// also exercises the pointer-argument path end to end.
//
// It is built twice, with and without `--vectorize=on`, and must exit 0 either
// way. The only way to exit 0 is for the vector fold to have produced exactly
// what the scalar loop produced.

fn noop(v: i32) i32 {
    return v;
}

fn vec_sum(a: *i32, n: i32) i32 {
    let s: i32 = 0;
    let i: i32 = 0;
    while (i < n) {
        s = s + a[i];
        i = i + 1;
    }
    return s;
}

fn ref_sum(a: *i32, n: i32) i32 {
    let s: i32 = 0;
    let i: i32 = 0;
    while (i < n) {
        s = s + noop(a[i]);
        i = i + 1;
    }
    return s;
}

// Many windows, so a fold that is right for one trip count and wrong for
// another cannot pass. The list is deliberately dense at the boundaries that
// matter for a 2-lane word vector: below one vector, exactly one, one plus a
// tail, exact multiples, and multiples plus a tail. `2` and `3` are the cases
// that catch a horizontal fold which reuses the accumulator twice, because
// `3` needs a second vector iteration while `1` and `2` do not.
fn check(base: i32, n: i32) i32 {
    let p: *i32 = base as *i32;
    let v: i32 = vec_sum(p, n);
    let r: i32 = ref_sum(p, n);
    if (v != r) { return 1; }
    if (r == 0) { return 2; }
    return 0;
}

fn main() i32 {
    // The compiler maps the text segment at 0x400000 and it is mapped readable,
    // so this reads real, non-zero, deterministic words out of the program image
    // itself -- edition 2026 has neither array literals nor globals to use
    // instead. The exact words differ between a vectorized and a scalar build,
    // which is fine: each build compares its own vectorized sum against its own
    // scalar sum over the SAME memory.
    let base: i32 = 4194304;
    let rc: i32 = check(base, 1);
    if (rc != 0) { return 1; }
    rc = check(base, 2);
    if (rc != 0) { return 2; }
    rc = check(base, 3);
    if (rc != 0) { return 3; }
    rc = check(base, 4);
    if (rc != 0) { return 4; }
    rc = check(base, 5);
    if (rc != 0) { return 5; }
    rc = check(base, 6);
    if (rc != 0) { return 6; }
    rc = check(base, 7);
    if (rc != 0) { return 7; }
    rc = check(base, 8);
    if (rc != 0) { return 8; }
    rc = check(base, 9);
    if (rc != 0) { return 9; }
    rc = check(base, 15);
    if (rc != 0) { return 15; }
    rc = check(base, 16);
    if (rc != 0) { return 16; }
    rc = check(base, 17);
    if (rc != 0) { return 17; }
    rc = check(base, 31);
    if (rc != 0) { return 31; }
    rc = check(base, 32);
    if (rc != 0) { return 32; }
    rc = check(base, 33);
    if (rc != 0) { return 33; }
    rc = check(base, 63);
    if (rc != 0) { return 63; }
    rc = check(base, 64);
    if (rc != 0) { return 64; }
    rc = check(base, 65);
    if (rc != 0) { return 65; }
    return 0;
}
