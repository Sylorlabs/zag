// Script JSON integer-list encoding fails closed when the context has no
// remaining bytes for the retained output buffer.

script;

let values: ScriptList[i64] = json_int_array("[1,2,3]");
if (script_list_len[i64](values) != 3) { return 1; }
let remaining: i64 = 1048576 - script_alloc_used();
let reserve: *i8 = script_alloc(remaining);
if (reserve == null as *i8) { return 2; }
let encoded: []u8 = json_int_array_encode(values);
if (encoded.len != 0) { return 3; }
return 0;
