// One verified TLS 1.3 HTTP request/response over 127.0.0.1.
// Certificate/key/CA paths are provided by the focused gate. The adapter is an
// explicit OpenSSL 3 dynamic boundary, not a static or production-server claim.

@import("std:list")
@import("std:http1") as http
@import("std:net_ipv4") as net
@import("std:rt")
@import("std:tls_openssl") as tls

extern fn _zag_allocator_live_bytes() i64

fn tls_http_abort_child(pid: i64) void {
    let _kill: i64 = _zag_raw_syscall(62, pid, 9, 0, 0, 0, 0);
    let status: ArrayList[i64] = make[i64](1);
    let _wait: i64 = _zag_raw_syscall(
        61, pid, status.data as i64, 0, 0, 0, 0
    );
    free[i64](&status);
}

fn tls_http_child(server: net.NetTcpStream, client: net.NetTcpStream,
                  listener: net.NetTcpListener,
                  certificate: []u8, private_key: []u8) void {
    let local_client: net.NetTcpStream = client;
    let local_listener: net.NetTcpListener = listener;
    let local_server: net.NetTcpStream = server;
    net.net_tcp_stream_close(&local_client);
    net.net_tcp_listener_close(&local_listener);

    let context_result: tls.TlsOpenSslContextResult =
        tls.tls_openssl_server_context(certificate, private_key);
    if (context_result.ok == 0) {
        net.net_tcp_stream_close(&local_server);
        _zag_exit(21);
    }
    let context: tls.TlsOpenSslContext =
        tls.tls_openssl_context_take(&context_result);
    let connection_result: tls.TlsOpenSslConnectionResult =
        tls.tls_openssl_server_accept(&context, local_server.fd);
    if (connection_result.ok == 0) {
        tls.tls_openssl_context_close(&context);
        net.net_tcp_stream_close(&local_server);
        _zag_exit(22);
    }
    let connection: tls.TlsOpenSslConnection =
        tls.tls_openssl_connection_take(&connection_result);
    let request_text: []u8 = "GET /answer HTTP/1.1\r\nHost: localhost\r\nContent-Length: 0\r\n\r\n";
    let request_bytes: ArrayList[u8] = make[u8](request_text.len);
    let received: tls.TlsOpenSslIoResult = tls.tls_openssl_read_exact_bounded(
        &connection, request_bytes.data[0..request_text.len], 16
    );
    let parsed_result: http.Http1RequestResult = http.http1_parse_request(
        request_bytes.data[0..request_text.len]
    );
    if (received.ok == 0 || parsed_result.ok == 0) {
        free[u8](&request_bytes);
        tls.tls_openssl_connection_close(&connection);
        tls.tls_openssl_context_close(&context);
        net.net_tcp_stream_close(&local_server);
        _zag_exit(23);
    }
    let parsed: http.Http1Request = http.http1_request_take(&parsed_result);
    if (!@strEq(parsed.method, "GET") ||
        !@strEq(parsed.path, "/answer")) {
        http.http1_request_close(&parsed);
        free[u8](&request_bytes);
        tls.tls_openssl_connection_close(&connection);
        tls.tls_openssl_context_close(&context);
        net.net_tcp_stream_close(&local_server);
        _zag_exit(24);
    }
    http.http1_request_close(&parsed);
    free[u8](&request_bytes);
    let response: []u8 = "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\n42";
    let sent: tls.TlsOpenSslIoResult = tls.tls_openssl_write_all_bounded(
        &connection, response, 16
    );
    if (sent.ok == 0 ||
        tls.tls_openssl_connection_close(&connection) !=
            tls.tls_openssl_status_ok() ||
        tls.tls_openssl_context_close(&context) !=
            tls.tls_openssl_status_ok() ||
        net.net_tcp_stream_close(&local_server) != net.net_status_ok()) {
        _zag_exit(25);
    }
    _zag_exit(0);
}

fn main() i32 {
    if (_zag_argc() != 3 && _zag_argc() != 4) { return 2; }
    let expect_hostname_failure: i32 = 0;
    if (_zag_argc() == 4) {
        if (!@strEq(_zag_arg(3), "--expect-hostname-failure")) { return 2; }
        expect_hostname_failure = 1;
    }
    let baseline: i64 = _zag_allocator_live_bytes();
    let certificate: []u8 = _zag_arg(1);
    let private_key: []u8 = _zag_arg(2);

    let bad_server: tls.TlsOpenSslContextResult =
        tls.tls_openssl_server_context("/definitely/missing/cert.pem", private_key);
    let bad_client: tls.TlsOpenSslContextResult =
        tls.tls_openssl_client_context("/definitely/missing/ca.pem");
    if (bad_server.ok != 0 || bad_client.ok != 0 ||
        tls.tls_openssl_hostname_valid("bad/name") != 0) { return 3; }

    let endpoint: net.NetIpv4Endpoint = net.net_ipv4_endpoint(
        net.net_ipv4_loopback(), 0
    );
    let listener_result: net.NetTcpListenerResult =
        net.net_tcp_listen_ipv4(endpoint, 4, 5000);
    if (listener_result.ok == 0) { return 4; }
    let listener: net.NetTcpListener =
        net.net_tcp_listener_take(&listener_result);
    let client_result: net.NetTcpStreamResult =
        net.net_tcp_connect_ipv4(listener.local, 5000);
    if (client_result.ok == 0) {
        net.net_tcp_listener_close(&listener);
        return 5;
    }
    let client: net.NetTcpStream = net.net_tcp_stream_take(&client_result);
    let server_result: net.NetTcpStreamResult =
        net.net_tcp_accept(&listener, 5000);
    if (server_result.ok == 0) {
        net.net_tcp_stream_close(&client);
        net.net_tcp_listener_close(&listener);
        return 6;
    }
    let server: net.NetTcpStream = net.net_tcp_stream_take(&server_result);

    let pid: i64 = _zag_raw_syscall(57, 0, 0, 0, 0, 0, 0);
    if (pid < 0) {
        net.net_tcp_stream_close(&server);
        net.net_tcp_stream_close(&client);
        net.net_tcp_listener_close(&listener);
        return 7;
    }
    if (pid == 0) {
        tls_http_child(server, client, listener, certificate, private_key);
        _zag_exit(26);
    }

    net.net_tcp_stream_close(&server);
    net.net_tcp_listener_close(&listener);
    let context_result: tls.TlsOpenSslContextResult =
        tls.tls_openssl_client_context(certificate);
    if (context_result.ok == 0) {
        net.net_tcp_stream_close(&client);
        tls_http_abort_child(pid);
        return 8;
    }
    let context: tls.TlsOpenSslContext =
        tls.tls_openssl_context_take(&context_result);
    let invalid_fd: tls.TlsOpenSslConnectionResult =
        tls.tls_openssl_client_connect(&context, 0 - 1, "localhost");
    if (invalid_fd.code != tls.tls_openssl_status_invalid_argument()) {
        tls.tls_openssl_context_close(&context);
        net.net_tcp_stream_close(&client);
        tls_http_abort_child(pid);
        return 9;
    }
    let requested_hostname: []u8 = "localhost";
    if (expect_hostname_failure == 1) { requested_hostname = "wrong.example"; }
    let connection_result: tls.TlsOpenSslConnectionResult =
        tls.tls_openssl_client_connect(&context, client.fd, requested_hostname);
    if (expect_hostname_failure == 1) {
        let negative_ok: i32 = (connection_result.ok == 0 &&
            connection_result.code == tls.tls_openssl_status_verification()) as i32;
        tls.tls_openssl_context_close(&context);
        net.net_tcp_stream_close(&client);
        let child_status: ArrayList[i64] = make[i64](1);
        let waited: i64 = _zag_raw_syscall(
            61, pid, child_status.data as i64, 0, 0, 0, 0
        );
        let raw_status: i64 = child_status.data[0];
        free[i64](&child_status);
        if (negative_ok == 0 || waited != pid || (raw_status & 127) != 0 ||
            ((raw_status >> 8) & 255) == 0 ||
            _zag_allocator_live_bytes() != baseline) { return 17; }
        return 0;
    }
    if (connection_result.ok == 0) {
        tls.tls_openssl_context_close(&context);
        net.net_tcp_stream_close(&client);
        tls_http_abort_child(pid);
        return 10;
    }
    let connection: tls.TlsOpenSslConnection =
        tls.tls_openssl_connection_take(&connection_result);
    let duplicate_take: tls.TlsOpenSslConnection =
        tls.tls_openssl_connection_take(&connection_result);
    if (duplicate_take.open != 0 ||
        connection.protocol != tls.tls_openssl_protocol_tls13()) {
        tls.tls_openssl_connection_close(&connection);
        tls.tls_openssl_context_close(&context);
        net.net_tcp_stream_close(&client);
        tls_http_abort_child(pid);
        return 11;
    }
    let request: []u8 = "GET /answer HTTP/1.1\r\nHost: localhost\r\nContent-Length: 0\r\n\r\n";
    let sent: tls.TlsOpenSslIoResult = tls.tls_openssl_write_all_bounded(
        &connection, request, 16
    );
    let response_text: []u8 =
        "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\n42";
    let response_bytes: ArrayList[u8] = make[u8](response_text.len);
    let received: tls.TlsOpenSslIoResult = tls.tls_openssl_read_exact_bounded(
        &connection, response_bytes.data[0..response_text.len], 16
    );
    let parsed_result: http.Http1ResponseResult = http.http1_parse_response(
        response_bytes.data[0..response_text.len]
    );
    if (sent.ok == 0 || received.ok == 0 || parsed_result.ok == 0) {
        free[u8](&response_bytes);
        tls.tls_openssl_connection_close(&connection);
        tls.tls_openssl_context_close(&context);
        net.net_tcp_stream_close(&client);
        tls_http_abort_child(pid);
        return 12;
    }
    let parsed: http.Http1Response = http.http1_response_take(&parsed_result);
    if (parsed.status != 200 || !@strEq(parsed.body, "42")) {
        http.http1_response_close(&parsed);
        free[u8](&response_bytes);
        tls.tls_openssl_connection_close(&connection);
        tls.tls_openssl_context_close(&context);
        net.net_tcp_stream_close(&client);
        tls_http_abort_child(pid);
        return 13;
    }
    http.http1_response_close(&parsed);
    free[u8](&response_bytes);
    if (tls.tls_openssl_connection_close(&connection) !=
            tls.tls_openssl_status_ok() ||
        tls.tls_openssl_connection_close(&connection) !=
            tls.tls_openssl_status_invalid_state() ||
        tls.tls_openssl_write_all_bounded(&connection, "x", 1).code !=
            tls.tls_openssl_status_invalid_state() ||
        tls.tls_openssl_context_close(&context) !=
            tls.tls_openssl_status_ok() ||
        tls.tls_openssl_context_close(&context) !=
            tls.tls_openssl_status_invalid_state() ||
        net.net_tcp_stream_close(&client) != net.net_status_ok()) {
        tls_http_abort_child(pid);
        return 14;
    }

    let child_status: ArrayList[i64] = make[i64](1);
    let waited: i64 = _zag_raw_syscall(
        61, pid, child_status.data as i64, 0, 0, 0, 0
    );
    let raw_status: i64 = child_status.data[0];
    free[i64](&child_status);
    if (waited != pid || (raw_status & 127) != 0 ||
        ((raw_status >> 8) & 255) != 0) { return 15; }
    if (_zag_allocator_live_bytes() != baseline) { return 16; }
    _zag_println("tls http service: protocol=TLSv1.3 status=200 body=42 negatives=4");
    return 0;
}
