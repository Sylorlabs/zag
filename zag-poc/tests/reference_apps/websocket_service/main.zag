// One RFC 6455 upgrade and text-frame exchange over 127.0.0.1 TCP.
// This is bounded reference evidence, not TLS, compression, fragmentation,
// async, cancellation, load, or production security certification.

@import("std:list")
@import("std:http1") as http
@import("std:http1_service") as service
@import("std:net_ipv4") as net
@import("std:websocket") as ws

extern fn _zag_allocator_live_bytes() i64

fn main() i32 {
    let baseline: i64 = _zag_allocator_live_bytes();
    let bad_handshake: ws.WebSocketBufferResult = ws.websocket_accept_handshake_default(
        "GET /socket HTTP/1.1\r\nHost: local\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nContent-Length: 0\r\n\r\n"
    );
    let unmasked_client: ws.WebSocketFrameResult = ws.websocket_parse_client_frame(
        "\x81\x02hi", 16
    );
    let fragmented: ws.WebSocketFrameResult = ws.websocket_parse_server_frame(
        "\x01\x00", 16
    );
    let invalid_text: ws.WebSocketFrameResult = ws.websocket_parse_server_frame(
        "\x81\x02\xc0\xaf", 16
    );
    let invalid_close: ws.WebSocketFrameResult = ws.websocket_parse_server_frame(
        "\x88\x01\x03", 16
    );
    if (bad_handshake.code != ws.websocket_status_handshake() ||
        unmasked_client.code != ws.websocket_status_protocol() ||
        fragmented.code != ws.websocket_status_unsupported() ||
        invalid_text.code != ws.websocket_status_invalid_utf8() ||
        invalid_close.code != ws.websocket_status_protocol()) { return 1; }

    let key: []u8 = "dGhlIHNhbXBsZSBub25jZQ==";
    let handshake_result: ws.WebSocketBufferResult =
        ws.websocket_encode_client_handshake_default("127.0.0.1", "/socket", key);
    if (handshake_result.ok == 0) { return 2; }
    let handshake: ws.WebSocketBuffer = ws.websocket_buffer_take(&handshake_result);

    let listener_result: net.NetTcpListenerResult = net.net_tcp_listen_ipv4(
        net.net_ipv4_endpoint(net.net_ipv4_loopback(), 0), 4, 2000
    );
    if (listener_result.ok == 0) { return 3; }
    let listener: net.NetTcpListener = net.net_tcp_listener_take(&listener_result);
    let client_result: net.NetTcpStreamResult = net.net_tcp_connect_ipv4(
        listener.local, 2000
    );
    if (client_result.ok == 0) { return 4; }
    let client: net.NetTcpStream = net.net_tcp_stream_take(&client_result);
    let server_result: net.NetTcpStreamResult = net.net_tcp_accept(&listener, 2000);
    if (server_result.ok == 0) { return 5; }
    let server: net.NetTcpStream = net.net_tcp_stream_take(&server_result);

    let handshake_send: net.NetIoResult = net.net_tcp_send_all_bounded(
        &client, ws.websocket_buffer_slice(&handshake), 4096, 4096, 9
    );
    let server_handshake_result: service.Http1ReceiveResult =
        service.http1_receive_message_bounded(
            &server, http.http1_default_limits(), 4096
        );
    if (handshake_send.ok == 0 || handshake_send.calls < 2 ||
        server_handshake_result.ok == 0) { return 6; }
    let server_handshake: http.Http1Buffer =
        service.http1_receive_take(&server_handshake_result);
    let accept_result: ws.WebSocketBufferResult = ws.websocket_accept_handshake_default(
        http.http1_buffer_slice(&server_handshake)
    );
    if (accept_result.ok == 0) { return 7; }
    let accept: ws.WebSocketBuffer = ws.websocket_buffer_take(&accept_result);
    let accept_send: net.NetIoResult = net.net_tcp_send_all_bounded(
        &server, ws.websocket_buffer_slice(&accept), 4096, 4096, 11
    );
    let client_handshake_result: service.Http1ReceiveResult =
        service.http1_receive_message_bounded(
            &client, http.http1_default_limits(), 4096
        );
    if (accept_send.ok == 0 || accept_send.calls < 2 ||
        client_handshake_result.ok == 0) { return 8; }
    let client_handshake: http.Http1Buffer =
        service.http1_receive_take(&client_handshake_result);
    if (ws.websocket_validate_server_handshake_default(
            http.http1_buffer_slice(&client_handshake), key
        ) != ws.websocket_status_ok()) { return 9; }

    let client_text_result: ws.WebSocketBufferResult = ws.websocket_encode_client_frame(
        ws.websocket_opcode_text(), "42", 305419896
    );
    if (client_text_result.ok == 0) { return 10; }
    let client_text: ws.WebSocketBuffer = ws.websocket_buffer_take(&client_text_result);
    let client_text_send: net.NetIoResult = net.net_tcp_send_all_bounded(
        &client, ws.websocket_buffer_slice(&client_text), 64, 64, 2
    );
    let server_frame_bytes: ArrayList[u8] = make[u8](client_text.bytes.len);
    let server_frame_receive: net.NetIoResult = net.net_tcp_recv_exact_bounded(
        &server, server_frame_bytes.data[0..client_text.bytes.len],
        client_text.bytes.len, 64, 64, 2
    );
    server_frame_bytes.len = client_text.bytes.len;
    if (client_text_send.ok == 0 || client_text_send.calls < 2 ||
        server_frame_receive.ok == 0 || server_frame_receive.calls < 2) { return 11; }
    let parsed_client_result: ws.WebSocketFrameResult = ws.websocket_parse_client_frame(
        server_frame_bytes.data[0..server_frame_bytes.len], 16
    );
    if (parsed_client_result.ok == 0) { return 12; }
    let parsed_client: ws.WebSocketFrame = ws.websocket_frame_take(&parsed_client_result);
    if (parsed_client.opcode != ws.websocket_opcode_text() ||
        !@strEq(ws.websocket_frame_payload(&parsed_client), "42")) { return 13; }

    let server_text_result: ws.WebSocketBufferResult = ws.websocket_encode_server_frame(
        ws.websocket_opcode_text(), "ack:42"
    );
    if (server_text_result.ok == 0) { return 14; }
    let server_text: ws.WebSocketBuffer = ws.websocket_buffer_take(&server_text_result);
    let server_text_send: net.NetIoResult = net.net_tcp_send_all_bounded(
        &server, ws.websocket_buffer_slice(&server_text), 64, 64, 3
    );
    let client_frame_bytes: ArrayList[u8] = make[u8](server_text.bytes.len);
    let client_frame_receive: net.NetIoResult = net.net_tcp_recv_exact_bounded(
        &client, client_frame_bytes.data[0..server_text.bytes.len],
        server_text.bytes.len, 64, 64, 2
    );
    client_frame_bytes.len = server_text.bytes.len;
    if (server_text_send.ok == 0 || server_text_send.calls < 2 ||
        client_frame_receive.ok == 0 || client_frame_receive.calls < 2) { return 15; }
    let parsed_server_result: ws.WebSocketFrameResult = ws.websocket_parse_server_frame(
        client_frame_bytes.data[0..client_frame_bytes.len], 16
    );
    if (parsed_server_result.ok == 0) { return 16; }
    let parsed_server: ws.WebSocketFrame = ws.websocket_frame_take(&parsed_server_result);
    if (parsed_server.opcode != ws.websocket_opcode_text() ||
        !@strEq(ws.websocket_frame_payload(&parsed_server), "ack:42")) { return 17; }

    if (ws.websocket_frame_close(&parsed_client) != ws.websocket_status_ok() ||
        ws.websocket_frame_close(&parsed_server) != ws.websocket_status_ok() ||
        ws.websocket_buffer_close(&handshake) != ws.websocket_status_ok() ||
        ws.websocket_buffer_close(&accept) != ws.websocket_status_ok() ||
        ws.websocket_buffer_close(&client_text) != ws.websocket_status_ok() ||
        ws.websocket_buffer_close(&server_text) != ws.websocket_status_ok() ||
        http.http1_buffer_close(&server_handshake) != http.http1_status_ok() ||
        http.http1_buffer_close(&client_handshake) != http.http1_status_ok()) { return 18; }
    free[u8](&server_frame_bytes);
    free[u8](&client_frame_bytes);
    if (net.net_tcp_stream_close(&server) != net.net_status_ok() ||
        net.net_tcp_stream_close(&server) != net.net_status_invalid_state() ||
        net.net_tcp_stream_close(&client) != net.net_status_ok() ||
        net.net_tcp_listener_close(&listener) != net.net_status_ok() ||
        net.net_tcp_listener_close(&listener) != net.net_status_invalid_state()) {
        return 19;
    }
    if (_zag_allocator_live_bytes() != baseline) { return 20; }
    _zag_println("websocket service: upgrade=101 text=ack:42 negatives=5");
    return 0;
}
