// Native SQLite-backed reference application for the bounded i64 KV contract.
// The adapter opens only SQLite `:memory:`; this program is not a server and
// does not make a persistence, network, or TLS claim.

@import("std:database_kv") as contract
@import("std:sqlite_kv") as sqlite

fn main() i32 {
    let inventory: sqlite.SqliteKv = sqlite.sqlite_kv_open(4);
    if (inventory.status != contract.database_kv_ok()) { return 1; }
    if (sqlite.sqlite_kv_put(&inventory, 1001, 19) !=
        contract.database_kv_ok()) { sqlite.sqlite_kv_close(&inventory); return 2; }
    if (sqlite.sqlite_kv_put(&inventory, 1002, 23) !=
        contract.database_kv_ok()) { sqlite.sqlite_kv_close(&inventory); return 3; }

    let first: i64 = 0;
    let second: i64 = 0;
    let count: i32 = 0;
    if (sqlite.sqlite_kv_get(&inventory, 1001, &first) !=
        contract.database_kv_ok() ||
        sqlite.sqlite_kv_get(&inventory, 1002, &second) !=
        contract.database_kv_ok() ||
        sqlite.sqlite_kv_count(&inventory, &count) !=
        contract.database_kv_ok()) {
        sqlite.sqlite_kv_close(&inventory);
        return 4;
    }
    if (first + second != 42 || count != 2) {
        sqlite.sqlite_kv_close(&inventory);
        return 5;
    }
    if (sqlite.sqlite_kv_close(&inventory) != contract.database_kv_ok()) {
        return 6;
    }
    _zag_println("sqlite kv inventory: rows=2 total=42");
    return 0;
}
