// Bounded Linux/x86-64 SPSC worker reference application.
//
// One parent producer sends eight jobs to one captureless worker consumer.
// The worker is also the sole producer for a second result channel.  Every
// operation has a finite timeout and the join consumes the thread handle.
// This is not a worker pool, MPMC channel, async/await scheduler, cancellation
// facility, or compiler inference that arbitrary shared code is race-free.

@import("std:channel_i64") as channel
@import("std:rt")

extern fn _zag_allocator_live_bytes() i64

struct AsyncWorkerContext {
    jobs: channel.ChannelI64,
    results: channel.ChannelI64,
    worker_error: i64,
}

fn async_worker(context_address: i64) void {
    let context: *AsyncWorkerContext = null as *AsyncWorkerContext;
    unsafe { context = context_address as *AsyncWorkerContext; }
    let i: i32 = 0;
    while (i < 8) {
        let job: channel.ChannelI64ReceiveResult =
            channel.channel_i64_receive_wait(&context.*.jobs, 2000);
        if (job.ok == 0) {
            context.*.worker_error = job.code;
            return;
        }
        let sent: channel.ChannelI64SendResult =
            channel.channel_i64_send_wait(
                &context.*.results, job.value * job.value + 1, 2000
            );
        if (sent.ok == 0) {
            context.*.worker_error = sent.code;
            return;
        }
        i = i + 1;
    }
}

fn main() i32 {
    let baseline: i64 = _zag_allocator_live_bytes();
    let context_address: i64 =
        _zag_raw_syscall(9, 0, 4096, 3, 34, 0 - 1, 0);
    if (context_address < 0) { return 2; }
    let context: *AsyncWorkerContext = null as *AsyncWorkerContext;
    unsafe { context = context_address as *AsyncWorkerContext; }
    context.*.jobs = channel.channel_i64_invalid();
    context.*.results = channel.channel_i64_invalid();
    context.*.worker_error = 0;
    if (channel.channel_i64_create_into(&context.*.jobs, 8) != 0) {
        let cleanup_rc: i64 =
            _zag_raw_syscall(11, context_address, 4096, 0, 0, 0, 0);
        if (cleanup_rc != 0) { return 8; }
        return 3;
    }
    if (channel.channel_i64_create_into(&context.*.results, 8) != 0) {
        let jobs_cleanup_rc: i64 =
            channel.channel_i64_close(&context.*.jobs);
        let context_cleanup_rc: i64 =
            _zag_raw_syscall(11, context_address, 4096, 0, 0, 0, 0);
        if (jobs_cleanup_rc != 0 || context_cleanup_rc != 0) { return 8; }
        return 3;
    }

    let main_error: i64 = 0;
    let sum: i64 = 0;
    unsafe {
        let worker: *opaque = @threadSpawn(async_worker, context_address);
        let i: i32 = 1;
        while (i <= 8 && main_error == 0) {
            let sent: channel.ChannelI64SendResult =
                channel.channel_i64_send_wait(
                    &context.*.jobs, i as i64, 2000
                );
            if (sent.ok == 0) { main_error = sent.code; }
            i = i + 1;
        }
        i = 0;
        while (i < 8 && main_error == 0) {
            let received: channel.ChannelI64ReceiveResult =
                channel.channel_i64_receive_wait(&context.*.results, 2000);
            if (received.ok == 0) {
                main_error = received.code;
            } else {
                sum = sum + received.value;
            }
            i = i + 1;
        }
        @threadJoin(worker);
    }

    let worker_error: i64 = context.*.worker_error;
    let result_close: i64 = channel.channel_i64_close(&context.*.results);
    let job_close: i64 = channel.channel_i64_close(&context.*.jobs);
    let context_close: i64 =
        _zag_raw_syscall(11, context_address, 4096, 0, 0, 0, 0);
    if (main_error != 0 || worker_error != 0) { return 4; }
    if (sum != 212) { return 5; }
    if (result_close != 0 || job_close != 0 || context_close != 0) { return 6; }
    if (_zag_allocator_live_bytes() != baseline) { return 7; }
    _zag_println("async-worker jobs=8 result_sum=212");
    return 0;
}
