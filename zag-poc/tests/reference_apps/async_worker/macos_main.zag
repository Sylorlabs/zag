// Apple Silicon macOS counterpart to the Linux SPSC worker reference app.
// The service contract is the same; the channel wait/wake mechanism is
// Darwin-native EVFILT_USER kqueue notification.

@import("std:macos_channel_i64") as channel
@import("std:rt")

extern fn _zag_allocator_live_bytes() i64

struct MacosAsyncWorkerContext {
    jobs: channel.MacosChannelI64,
    results: channel.MacosChannelI64,
    worker_error: i64,
}

fn macos_async_worker(context_address: i64) void {
    let context: *MacosAsyncWorkerContext = null as *MacosAsyncWorkerContext;
    unsafe { context = context_address as *MacosAsyncWorkerContext; }
    let i: i32 = 0;
    while (i < 8) {
        let job: channel.MacosChannelI64ReceiveResult =
            channel.macos_channel_i64_receive_wait(&context.*.jobs, 2000);
        if (job.ok == 0) { context.*.worker_error = job.code; return; }
        let sent: channel.MacosChannelI64SendResult =
            channel.macos_channel_i64_send_wait(&context.*.results, job.value * job.value + 1, 2000);
        if (sent.ok == 0) { context.*.worker_error = sent.code; return; }
        i = i + 1;
    }
}

fn main() i32 {
    let baseline: i64 = _zag_allocator_live_bytes();
    // Keep the thread argument as the integer address returned by the kernel.
    // That matches @threadSpawn's scalar argument contract without laundering
    // an owned Zag pointer through an integer.
    let context_address: i64 = _zag_darwin_syscall(
        197, 0, 4096, 3, 4098, 0 - 1, 0
    );
    if (context_address < 0) { return 2; }
    let context: *MacosAsyncWorkerContext = null as *MacosAsyncWorkerContext;
    unsafe { context = context_address as *MacosAsyncWorkerContext; }
    context.*.jobs = channel.macos_channel_i64_invalid();
    context.*.results = channel.macos_channel_i64_invalid();
    context.*.worker_error = 0;
    let jobs_create: i64 = channel.macos_channel_i64_create_into(&context.*.jobs, 8);
    if (jobs_create != 0) {
        let _unmap: i64 = _zag_darwin_syscall(73, context_address, 4096, 0, 0, 0, 0);
        if (jobs_create < 0 && jobs_create > (0 - 200)) {
            return (0 - jobs_create) as i32;
        }
        return 31;
    }
    if (channel.macos_channel_i64_create_into(&context.*.results, 8) != 0) {
        let _jobs: i64 = channel.macos_channel_i64_close(&context.*.jobs);
        let _unmap: i64 = _zag_darwin_syscall(73, context_address, 4096, 0, 0, 0, 0);
        return 32;
    }

    let main_error: i64 = 0;
    let sum: i64 = 0;
    unsafe {
        let worker: *opaque = @threadSpawn(macos_async_worker, context_address);
        let i: i32 = 1;
        while (i <= 8 && main_error == 0) {
            let sent: channel.MacosChannelI64SendResult =
                channel.macos_channel_i64_send_wait(&context.*.jobs, i as i64, 2000);
            if (sent.ok == 0) { main_error = sent.code; }
            i = i + 1;
        }
        i = 0;
        while (i < 8 && main_error == 0) {
            let received: channel.MacosChannelI64ReceiveResult =
                channel.macos_channel_i64_receive_wait(&context.*.results, 2000);
            if (received.ok == 0) { main_error = received.code; }
            else { sum = sum + received.value; }
            i = i + 1;
        }
        @threadJoin(worker);
    }

    let timeout: channel.MacosChannelI64ReceiveResult =
        channel.macos_channel_i64_receive_wait(&context.*.results, 40);
    let worker_error: i64 = context.*.worker_error;
    let result_close: i64 = channel.macos_channel_i64_close(&context.*.results);
    let job_close: i64 = channel.macos_channel_i64_close(&context.*.jobs);
    let context_close: i64 = _zag_darwin_syscall(73, context_address, 4096, 0, 0, 0, 0);
    if (main_error != 0 || worker_error != 0) { return 4; }
    if (sum != 212) { return 5; }
    if (timeout.ok != 0 || timeout.code != channel.macos_channel_i64_status_timeout() ||
        timeout.wait_calls < 1 || timeout.elapsed_ms < 20) { return 6; }
    if (result_close != 0 || job_close != 0 || context_close != 0) { return 7; }
    if (_zag_allocator_live_bytes() != baseline) { return 8; }
    _zag_println("macos-async-worker jobs=8 result_sum=212 timeout=1");
    return 0;
}
