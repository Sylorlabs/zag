// Native reference application for the bounded i64 dynamic-plugin contract.

@import("std:dynamic_plugin") as plugin

extern fn _zag_allocator_live_bytes() i64

fn main() i32 {
    if (_zag_argc() < 2 || _zag_argc() > 3) { return 2; }
    let baseline: i64 = _zag_allocator_live_bytes();
    let path: []u8 = _zag_arg(1);

    if (_zag_argc() == 3) {
        let selected: plugin.DynamicPluginI64 =
            plugin.dynamic_plugin_load_i64(path, _zag_arg(2));
        if (selected.status != plugin.dynamic_plugin_ok()) {
            return 20 + selected.status;
        }
        plugin.dynamic_plugin_close(&selected);
        return 12;
    }

    let close_counter: *i64 = _zag_malloc(8) as *i64;
    close_counter.* = 0;
    let watcher: plugin.DynamicPluginI64 =
        plugin.dynamic_plugin_load_i64(path, "zag_plugin_watch_close");
    if (watcher.status != plugin.dynamic_plugin_ok()) {
        _zag_free(close_counter as *i8);
        return 10;
    }
    let watched: i64 = 0;
    if (plugin.dynamic_plugin_call_i64(&watcher,
        close_counter as i64, &watched) != plugin.dynamic_plugin_ok() ||
        watched != 7) {
        plugin.dynamic_plugin_close(&watcher);
        _zag_free(close_counter as *i8);
        return 13;
    }
    if (plugin.dynamic_plugin_close(&watcher) != plugin.dynamic_plugin_ok() ||
        close_counter.* != 1) {
        _zag_free(close_counter as *i8);
        return 14;
    }

    let operation: plugin.DynamicPluginI64 =
        plugin.dynamic_plugin_load_i64(path, "zag_plugin_apply");
    if (operation.status != plugin.dynamic_plugin_ok()) {
        _zag_free(close_counter as *i8);
        return 15;
    }
    let answer: i64 = 0;
    if (plugin.dynamic_plugin_call_i64(&operation, 20, &answer) !=
        plugin.dynamic_plugin_ok() || answer != 42) {
        plugin.dynamic_plugin_close(&operation);
        _zag_free(close_counter as *i8);
        return 16;
    }
    if (plugin.dynamic_plugin_close(&operation) != plugin.dynamic_plugin_ok()) {
        _zag_free(close_counter as *i8);
        return 17;
    }
    if (plugin.dynamic_plugin_close(&operation) !=
        plugin.dynamic_plugin_invalid() ||
        plugin.dynamic_plugin_call_i64(&operation, 1, &answer) !=
        plugin.dynamic_plugin_invalid()) {
        _zag_free(close_counter as *i8);
        return 18;
    }
    _zag_free(close_counter as *i8);
    if (_zag_allocator_live_bytes() != baseline) { return 19; }
    _zag_println("dynamic plugin: answer=42 unloads=1");
    return 0;
}
