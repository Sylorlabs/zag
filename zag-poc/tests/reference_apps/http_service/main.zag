// One bounded native HTTP/1.1 request/response over 127.0.0.1 TCP.
// This is reference evidence for the codec and stream adapter, not a claim of
// TLS, HTTP/2/3, chunking, keep-alive, async, or production server hardening.

@import("std:list")
@import("std:http1") as http
@import("std:http1_service") as service
@import("std:net_ipv4") as net

extern fn _zag_allocator_live_bytes() i64

fn main() i32 {
    let baseline: i64 = _zag_allocator_live_bytes();
    let malformed_lf: http.Http1RequestResult = http.http1_parse_request(
        "GET / HTTP/1.1\nHost: local\n\n"
    );
    let missing_host: http.Http1RequestResult = http.http1_parse_request(
        "GET / HTTP/1.1\r\nContent-Length: 0\r\n\r\n"
    );
    let truncated_body: http.Http1RequestResult = http.http1_parse_request(
        "POST / HTTP/1.1\r\nHost: local\r\nContent-Length: 2\r\n\r\n4"
    );
    let chunked: http.Http1RequestResult = http.http1_parse_request(
        "POST / HTTP/1.1\r\nHost: local\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n"
    );
    if (malformed_lf.code != http.http1_status_malformed() ||
        missing_host.code != http.http1_status_malformed() ||
        truncated_body.code != http.http1_status_truncated() ||
        chunked.code != http.http1_status_unsupported()) { return 1; }

    let request_headers: ArrayList[http.Http1Header] = make[http.Http1Header](1);
    let request_result: http.Http1BufferResult = http.http1_encode_request(
        "GET", "/answer", "127.0.0.1", request_headers, ""
    );
    if (request_result.ok == 0) { free[http.Http1Header](&request_headers); return 2; }
    let request: http.Http1Buffer = http.http1_buffer_take(&request_result);

    let listener_result: net.NetTcpListenerResult = net.net_tcp_listen_ipv4(
        net.net_ipv4_endpoint(net.net_ipv4_loopback(), 0), 4, 2000
    );
    if (listener_result.ok == 0) {
        http.http1_buffer_close(&request);
        free[http.Http1Header](&request_headers);
        return 3;
    }
    let listener: net.NetTcpListener = net.net_tcp_listener_take(&listener_result);
    let client_result: net.NetTcpStreamResult = net.net_tcp_connect_ipv4(
        listener.local, 2000
    );
    if (client_result.ok == 0) {
        net.net_tcp_listener_close(&listener);
        http.http1_buffer_close(&request);
        free[http.Http1Header](&request_headers);
        return 4;
    }
    let client: net.NetTcpStream = net.net_tcp_stream_take(&client_result);
    let server_result: net.NetTcpStreamResult = net.net_tcp_accept(&listener, 2000);
    if (server_result.ok == 0) {
        net.net_tcp_stream_close(&client);
        net.net_tcp_listener_close(&listener);
        http.http1_buffer_close(&request);
        free[http.Http1Header](&request_headers);
        return 5;
    }
    let server: net.NetTcpStream = net.net_tcp_stream_take(&server_result);

    let request_send: net.NetIoResult = net.net_tcp_send_all_bounded(
        &client, http.http1_buffer_slice(&request), 4096, 1024, 7
    );
    let received_request_result: service.Http1ReceiveResult =
        service.http1_receive_message_bounded(
            &server, http.http1_default_limits(), 4096
        );
    if (request_send.ok == 0 || request_send.calls < 2 ||
        received_request_result.ok == 0 || received_request_result.calls < 2) {
        return 6;
    }
    let received_request: http.Http1Buffer =
        service.http1_receive_take(&received_request_result);
    let parsed_request_result: http.Http1RequestResult = http.http1_parse_request(
        http.http1_buffer_slice(&received_request)
    );
    if (parsed_request_result.ok == 0) { return 7; }
    let parsed_request: http.Http1Request =
        http.http1_request_take(&parsed_request_result);
    if (!@strEq(parsed_request.method, "GET") ||
        !@strEq(parsed_request.path, "/answer") || parsed_request.body.len != 0) {
        return 8;
    }

    let response_headers: ArrayList[http.Http1Header] = make[http.Http1Header](1);
    push[http.Http1Header](&response_headers, http.Http1Header{
        .name = "Content-Type", .value = "text/plain",
    });
    let response_result: http.Http1BufferResult = http.http1_encode_response(
        200, "OK", response_headers, "42\n"
    );
    if (response_result.ok == 0) { return 9; }
    let response: http.Http1Buffer = http.http1_buffer_take(&response_result);
    let response_send: net.NetIoResult = net.net_tcp_send_all_bounded(
        &server, http.http1_buffer_slice(&response), 4096, 1024, 5
    );
    let received_response_result: service.Http1ReceiveResult =
        service.http1_receive_message_bounded(
            &client, http.http1_default_limits(), 4096
        );
    if (response_send.ok == 0 || response_send.calls < 2 ||
        received_response_result.ok == 0) { return 10; }
    let received_response: http.Http1Buffer =
        service.http1_receive_take(&received_response_result);
    let parsed_response_result: http.Http1ResponseResult = http.http1_parse_response(
        http.http1_buffer_slice(&received_response)
    );
    if (parsed_response_result.ok == 0) { return 11; }
    let parsed_response: http.Http1Response =
        http.http1_response_take(&parsed_response_result);
    let content_type: http.Http1HeaderLookup =
        http.http1_response_header(&parsed_response, "content-type");
    if (parsed_response.status != 200 || !@strEq(parsed_response.body, "42\n") ||
        content_type.count != 1 || !@strEq(content_type.value, "text/plain")) {
        return 12;
    }

    if (http.http1_request_close(&parsed_request) != http.http1_status_ok() ||
        http.http1_response_close(&parsed_response) != http.http1_status_ok() ||
        http.http1_buffer_close(&received_request) != http.http1_status_ok() ||
        http.http1_buffer_close(&received_response) != http.http1_status_ok() ||
        http.http1_buffer_close(&request) != http.http1_status_ok() ||
        http.http1_buffer_close(&response) != http.http1_status_ok()) { return 13; }
    free[http.Http1Header](&request_headers);
    free[http.Http1Header](&response_headers);
    if (net.net_tcp_stream_close(&server) != net.net_status_ok() ||
        net.net_tcp_stream_close(&server) != net.net_status_invalid_state() ||
        net.net_tcp_stream_close(&client) != net.net_status_ok() ||
        net.net_tcp_listener_close(&listener) != net.net_status_ok() ||
        net.net_tcp_listener_close(&listener) != net.net_status_invalid_state()) {
        return 14;
    }
    if (_zag_allocator_live_bytes() != baseline) { return 15; }
    _zag_println("http service: status=200 body=42 negatives=4");
    return 0;
}
