// Composed macOS TLS 1.3 HTTP reference client.
//
// The transport and TLS layers are Apple's Network.framework and Security
// framework. The HTTP/1.1 bytes follow Zag's bounded wire contract, whose
// standalone codec is validated by the native protocol suite. The focused gate
// supplies a local TLS server and an explicit DER trust anchor, then verifies
// the complete request/response path through Network.framework.

@import("std:rt")

extern fn objc_getClass(name: *i8) *u8 @cabi;
extern fn dispatch_queue_create(label: *i8, attributes: *u8) *u8 @cabi;
extern fn dispatch_semaphore_create(value: i64) *u8 @cabi;
extern fn dispatch_semaphore_wait(semaphore: *u8, timeout: u64) i64 @cabi;
extern fn dispatch_semaphore_signal(semaphore: *u8) i64 @cabi;
extern fn dispatch_time(when: u64, delta: i64) u64 @cabi;
extern fn dispatch_data_create(buffer: *u8, size: i64, queue: *u8,
                               destructor: *u8) *u8 @cabi;
extern fn dispatch_data_create_map(data: *u8, buffer: **u8,
                                   size: *i64) *u8 @cabi;
extern fn dispatch_release(value: *u8) void @cabi;

extern fn nw_parameters_create() *u8 @cabi;
extern fn nw_parameters_copy_default_protocol_stack(parameters: *u8) *u8 @cabi;
extern fn nw_tcp_create_options() *u8 @cabi;
extern fn nw_tls_create_options() *u8 @cabi;
extern fn nw_tls_copy_sec_protocol_options(options: *u8) *u8 @cabi;
extern fn nw_protocol_stack_set_transport_protocol(stack: *u8,
                                                     options: *u8) void @cabi;
extern fn nw_protocol_stack_prepend_application_protocol(stack: *u8,
                                                          options: *u8) void @cabi;
extern fn nw_endpoint_create_host(hostname: *i8, port: *i8) *u8 @cabi;
extern fn nw_connection_create(endpoint: *u8, parameters: *u8) *u8 @cabi;
extern fn nw_connection_set_state_changed_handler(connection: *u8,
                                                   handler: @borrows *u8) void @cabi;
extern fn nw_connection_set_queue(connection: *u8, queue: *u8) void @cabi;
extern fn nw_connection_start(connection: *u8) void @cabi;
extern fn nw_connection_cancel(connection: *u8) void @cabi;
extern fn nw_connection_receive(connection: *u8, minimum: u32, maximum: u32,
                                 completion: @borrows *u8) void @cabi;
extern fn nw_connection_send(connection: *u8, content: *u8, context: *u8,
                              complete: bool,
                              completion: @borrows *u8) void @cabi;
extern fn nw_content_context_create(identifier: *i8) *u8 @cabi;
extern fn nw_protocol_copy_tls_definition() *u8 @cabi;
extern fn nw_connection_copy_protocol_metadata(connection: *u8,
                                                definition: *u8) *u8 @cabi;
extern fn nw_tls_copy_sec_protocol_metadata(metadata: *u8) *u8 @cabi;
extern fn nw_release(value: *u8) void @cabi;

extern fn sec_protocol_options_set_min_tls_protocol_version(options: *u8,
                                                             version: u16) void @cabi;
extern fn sec_protocol_options_set_max_tls_protocol_version(options: *u8,
                                                             version: u16) void @cabi;
extern fn sec_protocol_options_set_peer_authentication_required(options: *u8,
                                                                 required: bool) void @cabi;
extern fn sec_protocol_options_set_tls_server_name(options: *u8,
                                                    server_name: *i8) void @cabi;
extern fn sec_protocol_options_set_verify_block(options: *u8,
                                                 block: @borrows *u8,
                                                 queue: *u8) void @cabi;
extern fn sec_protocol_metadata_get_negotiated_tls_protocol_version(metadata: *u8) u16 @cabi;
extern fn sec_trust_copy_ref(trust: *u8) *u8 @cabi;
extern fn sec_release(value: *u8) void @cabi;

extern fn CFDataCreate(allocator: *u8, bytes: @borrows *u8,
                       length: i64) *u8 @cabi;
extern fn CFArrayCreate(allocator: *u8, values: @borrows *u8, count: i64,
                        callbacks: *u8) *u8 @cabi;
extern fn CFRelease(value: *u8) void @cabi;
extern fn SecCertificateCreateWithData(allocator: *u8, data: *u8) *u8 @cabi;
extern fn SecTrustSetAnchorCertificates(trust: *u8, anchors: *u8) i32 @cabi;
extern fn SecTrustSetAnchorCertificatesOnly(trust: *u8, only: bool) i32 @cabi;
extern fn SecTrustEvaluateWithError(trust: *u8, error: *u8) bool @cabi;

extern fn _zag_code_anchor() i64;
extern fn _zag_argc() i32;
extern fn _zag_arg(index: i32) []u8;
extern fn _zag_read_file(path: []u8) []u8;
extern fn _zag_malloc(size: i32) *i8;
extern fn _zag_free(value: @consumes *i8) void;
extern fn _zag_slice_ptr(value: []u8) *i8;
extern fn _zag_allocator_live_bytes() i64;

struct TlsBoolBlockThunk { call: fn(bool)void, }

@repr(C) struct TlsHttpBlockDescriptor { reserved: i64, size: i64, }

@repr(C) struct TlsHttpBlockLiteral {
    isa: *u8,
    flags: i32,
    reserved: i32,
    invoke: *u8,
    descriptor: *TlsHttpBlockDescriptor,
}

global let tls_http_semaphore: *u8;
global let tls_http_connection: *u8;
global let tls_http_request_content: *u8;
global let tls_http_context: *u8;
global let tls_http_receive_block: *u8;
global let tls_http_send_block: *u8;
global let tls_http_response: *u8;
global let tls_http_response_len: i32;
global let tls_http_response_capacity: i32;
global let tls_http_state: i32;
global let tls_http_error: i32;
global let tls_http_started: i32;
global let tls_http_anchors: *u8;
global let tls_http_verify_workspace: *u8;

fn tls_http_release_resources(connection: *u8, endpoint: *u8,
                              security: *u8, tls: *u8, tcp: *u8,
                              stack: *u8, parameters: *u8, context: *u8,
                              request_content: *u8, semaphore: *u8,
                              queue: *u8, definition: *u8,
                              metadata: *u8, tls_metadata: *u8) void {
    unsafe {
        if (tls_metadata != null as *u8) { sec_release(tls_metadata); }
        if (metadata != null as *u8) { nw_release(metadata); }
        if (definition != null as *u8) { nw_release(definition); }
        if (connection != null as *u8) { nw_release(connection); }
        if (endpoint != null as *u8) { nw_release(endpoint); }
        if (security != null as *u8) { sec_release(security); }
        if (tls != null as *u8) { nw_release(tls); }
        if (tcp != null as *u8) { nw_release(tcp); }
        if (stack != null as *u8) { nw_release(stack); }
        if (parameters != null as *u8) { nw_release(parameters); }
        if (context != null as *u8) { dispatch_release(context); }
        if (request_content != null as *u8) {
            dispatch_release(request_content);
        }
        if (semaphore != null as *u8) { dispatch_release(semaphore); }
        if (queue != null as *u8) { dispatch_release(queue); }
    }
}

fn tls_http_response_matches() i32 {
    let expected: []u8 =
        "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\n42";
    if (tls_http_response_len != expected.len) { return 0; }
    let start: i32 = 0;
    let i: i32 = 0;
    while (i < expected.len) {
        if (tls_http_response[start + i] != expected[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn tls_http_signal() void {
    unsafe {
        if (tls_http_semaphore != null as *u8) {
            let _signal: i64 = dispatch_semaphore_signal(tls_http_semaphore);
        }
    }
}

fn tls_http_state_handler(block: *u8, state: i32, error: *u8) i64 {
    if (block == null as *u8 && state == 99) { return _zag_code_anchor(); }
    tls_http_state = state;
    if (error != null as *u8) { tls_http_error = 1; }
    unsafe {
        if (state == 3 && tls_http_started == 0) {
            tls_http_started = 1;
            nw_connection_receive(
                tls_http_connection, 1, tls_http_response_capacity as u32,
                tls_http_receive_block
            );
            nw_connection_send(
                tls_http_connection, tls_http_request_content,
                tls_http_context, true, tls_http_send_block
            );
        }
    }
    if (state == 4 || state == 5 || error != null as *u8) { tls_http_signal(); }
    return 0;
}

fn tls_http_send_handler(block: *u8, error: *u8) i64 {
    if (block == null as *u8 && error == null as *u8) {
        return _zag_code_anchor();
    }
    if (error != null as *u8) { tls_http_error = 1; tls_http_signal(); }
    return 0;
}

fn tls_http_receive_handler(block: *u8, content: *u8, context: *u8,
                            is_complete: bool, error: *u8) i64 {
    if (block == null as *u8 && content == null as *u8 &&
        context == null as *u8 && is_complete == false && error == null as *u8) {
        return _zag_code_anchor();
    }
    unsafe {
        if (content != null as *u8) {
            let mapped_ptr: *u8 = null as *u8;
            let mapped_size: i64 = 0;
            let mapped: *u8 = dispatch_data_create_map(
                content, (&mapped_ptr) as **u8, (&mapped_size) as *i64
            );
            if (mapped == null as *u8 || mapped_ptr == null as *u8 ||
                mapped_size < 0 ||
                mapped_size > tls_http_response_capacity - tls_http_response_len) {
                if (mapped != null as *u8) { dispatch_release(mapped); }
                tls_http_error = 1;
                tls_http_signal();
                return 0;
            }
            let i: i64 = 0;
            while (i < mapped_size) {
                tls_http_response[tls_http_response_len + i as i32] =
                    mapped_ptr[i] as u8;
                i = i + 1;
            }
            tls_http_response_len = tls_http_response_len + mapped_size as i32;
            dispatch_release(mapped);
        }
        if (is_complete) {
            if (error == null as *u8 && tls_http_response_matches() == 1) {
                tls_http_signal();
                return 0;
            }
            tls_http_error = 1;
            tls_http_signal();
        } else if (error != null as *u8) {
            tls_http_error = 1;
            tls_http_signal();
        } else {
            // Network.framework may split one response across callbacks. Keep
            // receiving until the exact bounded response arrives or the
            // connection reports completion/error.
            nw_connection_receive(
                tls_http_connection, 1, tls_http_response_capacity as u32,
                tls_http_receive_block
            );
        }
    }
    return 0;
}

fn tls_http_complete_bool(block: @borrows *u8,
                          workspace: @borrows_mut *u8,
                          value: bool) void {
    unsafe {
        let block_words: *i64 = block as *i64;
        let thunk_words: *i64 = workspace as *i64;
        thunk_words[0] = block_words[2];
        thunk_words[1] = block as i64;
        let thunk: *TlsBoolBlockThunk = workspace as *TlsBoolBlockThunk;
        thunk.*.call(value);
    }
}

fn tls_http_verify_handler(block: *u8, metadata: *u8, trust_object: *u8,
                           complete: *u8) i64 {
    if (block == null as *u8 && metadata == null as *u8 &&
        trust_object == null as *u8 && complete == null as *u8) {
        return _zag_code_anchor();
    }
    unsafe {
        let accepted: bool = false;
        if (trust_object != null as *u8 && complete != null as *u8 &&
            tls_http_anchors != null as *u8 &&
            tls_http_verify_workspace != null as *u8) {
            let trust: *u8 = sec_trust_copy_ref(trust_object);
            if (trust != null as *u8) {
                if (SecTrustSetAnchorCertificates(trust, tls_http_anchors) == 0 &&
                    SecTrustSetAnchorCertificatesOnly(trust, true) == 0) {
                    accepted = SecTrustEvaluateWithError(trust, null as *u8);
                }
                CFRelease(trust);
            }
        }
        if (complete != null as *u8 && tls_http_verify_workspace != null as *u8) {
            tls_http_complete_bool(
                complete, tls_http_verify_workspace, accepted
            );
        }
    }
    return 0;
}

fn tls_http_run(storage: @borrows_mut *u8, port: *i8, server_name: *i8,
                anchors_address: i64, response_capacity: i32) i32 {
    unsafe {
        let anchors: *u8 = anchors_address as *u8;
        let response: *u8 = ((storage as i64) + 4096) as *u8;
        if (anchors == null as *u8 || response == null as *u8 ||
            response_capacity < 256 || response_capacity > 65536) { return 20; }
        let descriptor: *TlsHttpBlockDescriptor =
            storage as *TlsHttpBlockDescriptor;
        let state_block: *TlsHttpBlockLiteral =
            ((storage as i64) + 16) as *TlsHttpBlockLiteral;
        let verify_descriptor: *TlsHttpBlockDescriptor =
            ((storage as i64) + 64) as *TlsHttpBlockDescriptor;
        let verify_block: *TlsHttpBlockLiteral =
            ((storage as i64) + 80) as *TlsHttpBlockLiteral;
        let receive_descriptor: *TlsHttpBlockDescriptor =
            ((storage as i64) + 144) as *TlsHttpBlockDescriptor;
        let receive_block: *TlsHttpBlockLiteral =
            ((storage as i64) + 160) as *TlsHttpBlockLiteral;
        let send_descriptor: *TlsHttpBlockDescriptor =
            ((storage as i64) + 224) as *TlsHttpBlockDescriptor;
        let send_block: *TlsHttpBlockLiteral =
            ((storage as i64) + 240) as *TlsHttpBlockLiteral;
        let verify_workspace: *u8 = ((storage as i64) + 288) as *u8;
        let global_block_class: *u8 = objc_getClass(
            _zag_slice_ptr("__NSGlobalBlock__\x00") as *i8
        );
        if (global_block_class == null as *u8) { return 10; }

        descriptor.*.reserved = 0; descriptor.*.size = 32;
        state_block.*.isa = global_block_class;
        state_block.*.flags = 268435456; state_block.*.reserved = 0;
        state_block.*.invoke = tls_http_state_handler(
            null as *u8, 99, null as *u8
        ) as *u8;
        state_block.*.descriptor = descriptor;

        verify_descriptor.*.reserved = 0; verify_descriptor.*.size = 32;
        verify_block.*.isa = global_block_class;
        verify_block.*.flags = 268435456; verify_block.*.reserved = 0;
        verify_block.*.invoke = tls_http_verify_handler(
            null as *u8, null as *u8, null as *u8, null as *u8
        ) as *u8;
        verify_block.*.descriptor = verify_descriptor;

        receive_descriptor.*.reserved = 0; receive_descriptor.*.size = 32;
        receive_block.*.isa = global_block_class;
        receive_block.*.flags = 268435456; receive_block.*.reserved = 0;
        receive_block.*.invoke = tls_http_receive_handler(
            null as *u8, null as *u8, null as *u8, false, null as *u8
        ) as *u8;
        receive_block.*.descriptor = receive_descriptor;

        send_descriptor.*.reserved = 0; send_descriptor.*.size = 32;
        send_block.*.isa = global_block_class;
        send_block.*.flags = 268435456; send_block.*.reserved = 0;
        send_block.*.invoke = tls_http_send_handler(
            null as *u8, null as *u8
        ) as *u8;
        send_block.*.descriptor = send_descriptor;

        let queue: *u8 = dispatch_queue_create(
            _zag_slice_ptr("dev.zag.tls-http\x00") as *i8, null as *u8
        );
        let semaphore: *u8 = dispatch_semaphore_create(0);
        let parameters: *u8 = nw_parameters_create();
        let stack: *u8 = null as *u8;
        let tcp: *u8 = null as *u8;
        let tls: *u8 = null as *u8;
        let security: *u8 = null as *u8;
        let endpoint: *u8 = null as *u8;
        let connection: *u8 = null as *u8;
        let definition: *u8 = null as *u8;
        let metadata: *u8 = null as *u8;
        let tls_metadata: *u8 = null as *u8;
        let request: []u8 =
            "GET /answer HTTP/1.1\r\nHost: localhost\r\nContent-Length: 0\r\n\r\n";
        let request_data: *u8 = dispatch_data_create(
            _zag_slice_ptr(request) as *u8, request.len as i64,
            null as *u8, null as *u8
        );
        let context: *u8 = nw_content_context_create(
            _zag_slice_ptr("zag-http-request\x00") as *i8
        );
        if (queue == null as *u8 || semaphore == null as *u8 ||
            parameters == null as *u8 || request_data == null as *u8 ||
            context == null as *u8) {
            tls_http_release_resources(
                connection, endpoint, security, tls, tcp, stack,
                parameters, context, request_data, semaphore, queue,
                definition, metadata, tls_metadata
            );
            return 11;
        }

        stack = nw_parameters_copy_default_protocol_stack(parameters);
        tcp = nw_tcp_create_options(); tls = nw_tls_create_options();
        if (stack == null as *u8 || tcp == null as *u8 || tls == null as *u8) {
            tls_http_release_resources(
                connection, endpoint, security, tls, tcp, stack,
                parameters, context, request_data, semaphore, queue,
                definition, metadata, tls_metadata
            );
            return 12;
        }
        security = nw_tls_copy_sec_protocol_options(tls);
        if (security == null as *u8) {
            tls_http_release_resources(
                connection, endpoint, security, tls, tcp, stack,
                parameters, context, request_data, semaphore, queue,
                definition, metadata, tls_metadata
            );
            return 13;
        }
        sec_protocol_options_set_min_tls_protocol_version(security, 772 as u16);
        sec_protocol_options_set_max_tls_protocol_version(security, 772 as u16);
        sec_protocol_options_set_peer_authentication_required(security, true);
        sec_protocol_options_set_tls_server_name(security, server_name);
        sec_protocol_options_set_verify_block(
            security, verify_block as *u8, queue
        );
        nw_protocol_stack_set_transport_protocol(stack, tcp);
        nw_protocol_stack_prepend_application_protocol(stack, tls);
        endpoint = nw_endpoint_create_host(
            _zag_slice_ptr("127.0.0.1\x00") as *i8, port
        );
        if (endpoint == null as *u8) {
            tls_http_release_resources(
                connection, endpoint, security, tls, tcp, stack,
                parameters, context, request_data, semaphore, queue,
                definition, metadata, tls_metadata
            );
            return 14;
        }
        connection = nw_connection_create(endpoint, parameters);
        if (connection == null as *u8) {
            tls_http_release_resources(
                connection, endpoint, security, tls, tcp, stack,
                parameters, context, request_data, semaphore, queue,
                definition, metadata, tls_metadata
            );
            return 15;
        }

        tls_http_semaphore = semaphore;
        tls_http_connection = connection;
        tls_http_request_content = request_data;
        tls_http_context = context;
        tls_http_receive_block = receive_block as *u8;
        tls_http_send_block = send_block as *u8;
        tls_http_response = response;
        tls_http_response_len = 0;
        tls_http_response_capacity = response_capacity;
        tls_http_state = 0; tls_http_error = 0; tls_http_started = 0;
        tls_http_anchors = anchors;
        tls_http_verify_workspace = verify_workspace;
        nw_connection_set_state_changed_handler(
            connection, state_block as *u8
        );
        nw_connection_set_queue(connection, queue);
        nw_connection_start(connection);
        let wait_status: i64 = dispatch_semaphore_wait(
            semaphore, dispatch_time(0, 5000000000)
        );
        let good: i32 = (wait_status == 0 && tls_http_error == 0 &&
            tls_http_state == 3 && tls_http_response_matches() == 1) as i32;
        if (connection != null as *u8) { nw_connection_cancel(connection); }
        let negotiated: u16 = 0;
        if (good == 1) {
            definition = nw_protocol_copy_tls_definition();
            if (definition != null as *u8) {
                metadata = nw_connection_copy_protocol_metadata(
                    connection, definition
                );
            }
            if (metadata != null as *u8) {
                tls_metadata = nw_tls_copy_sec_protocol_metadata(metadata);
            }
            if (tls_metadata != null as *u8) {
                negotiated = sec_protocol_metadata_get_negotiated_tls_protocol_version(
                    tls_metadata
                );
            }
        }
        tls_http_release_resources(
            connection, endpoint, security, tls, tcp, stack, parameters,
            context, request_data, semaphore, queue, definition, metadata,
            tls_metadata
        );
        tls_http_semaphore = null as *u8;
        tls_http_connection = null as *u8;
        tls_http_request_content = null as *u8;
        tls_http_context = null as *u8;
        tls_http_receive_block = null as *u8;
        tls_http_send_block = null as *u8;
        tls_http_response = null as *u8;
        tls_http_response_len = 0;
        tls_http_response_capacity = 0;
        tls_http_anchors = null as *u8;
        tls_http_verify_workspace = null as *u8;
        if (good == 0 || negotiated != 772 as u16) { return 16; }
        return 0;
    }
}

fn main() i32 {
    if (_zag_argc() != 5) { return 2; }
    let baseline: i64 = _zag_allocator_live_bytes();
    let storage: *u8 = _zag_malloc(70000) as *u8;
    let der: []u8 = _zag_read_file(_zag_arg(2));
    let cert_data: *u8 = null as *u8;
    let certificate: *u8 = null as *u8;
    let anchors: *u8 = null as *u8;
    let result: i32 = 3;
    unsafe {
        if (storage != null as *u8 && der.len > 0) {
            cert_data = CFDataCreate(
                null as *u8, _zag_slice_ptr(der) as *u8, der.len as i64
            );
            if (cert_data != null as *u8) {
                certificate = SecCertificateCreateWithData(
                    null as *u8, cert_data
                );
            }
            if (certificate != null as *u8) {
                let anchor_slot: **u8 = ((storage as i64) + 384) as **u8;
                anchor_slot[0] = certificate;
                anchors = CFArrayCreate(
                    null as *u8, anchor_slot as *u8, 1, null as *u8
                );
            }
            if (anchors != null as *u8) {
                let name: []u8 = _zag_arg(3);
                result = tls_http_run(
                    storage,
                    _zag_slice_ptr(_zag_arg(1)),
                    _zag_slice_ptr(name),
                    anchors as i64, 65536
                );
            }
        }
        if (anchors != null as *u8) { CFRelease(anchors); }
        if (certificate != null as *u8) { CFRelease(certificate); }
        if (cert_data != null as *u8) { CFRelease(cert_data); }
    }
    _zag_free(_zag_slice_ptr(der));
    _zag_free(storage as *i8);
    if (result != 0 || _zag_allocator_live_bytes() != baseline) { return 4; }
    _zag_println(
        "tls http service: backend=Network.framework protocol=TLSv1.3 status=200 body=42 negatives=2"
    );
    return 0;
}
