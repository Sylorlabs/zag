@import("std:set") as setlib

fn hash_i32_for_test(key: i32) i32 { return key; }
fn eq_i32_for_test(a: i32, b: i32) bool { return a == b; }

fn main() i32 {
    let values: setlib.Set[i32] =
        setlib.set_make[i32](8, hash_i32_for_test, eq_i32_for_test);
    setlib.set_add[i32](&values, "not-an-i32");
    setlib.set_free[i32](&values);
    return 0;
}
