extern fn _zag_raw_syscall(num:i64,a1:i64,a2:i64,a3:i64,a4:i64,a5:i64,a6:i64)i64
extern fn _zag_malloc(bytes:i32)*u8

fn main() i32 {
    let pair: *i64 = _zag_malloc(8) as *i64;
    if (_zag_raw_syscall(293,pair as i64,2048,0,0,0,0) < 0) { return 1; }
    let fd: i64 = pair[0] & 4294967295;
    // Linux F_SETLK (6) aliases an unrelated Darwin command. It must never be
    // issued through the portable x86-numbered boundary.
    let result: i64 = _zag_raw_syscall(72,fd,6,0,0,0,0);
    let _read_close: i64 = _zag_raw_syscall(3,fd,0,0,0,0,0);
    let _write_close: i64 = _zag_raw_syscall(3,pair[0]>>32,0,0,0,0,0);
    if (result == 0 - 78) { return 42; }
    return 2;
}
