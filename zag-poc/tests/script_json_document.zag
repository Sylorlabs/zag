@import("../selfhost/std/script_json_document.zag") as sj
@import("std:json") as json
extern fn _zag_script_context_init(limit:i64, capabilities:i64, execution_policy:i64) *i8
extern fn _zag_script_context_shutdown(context:*i8) void
extern fn _zag_script_alloc_used(context:*i8) i64
extern fn _zag_allocator_live_bytes() i64

fn failed_parse(src: []u8, depth: i32, bytes: i32, values: i32) i32 {
    let before: i64 = _zag_allocator_live_bytes();
    let doc: json.JsonDocument = sj.script_json_parse_bounded(src, depth, bytes, values);
    if (doc.ok != 0 || doc.nodes.len != 0 || doc.owned_text.len != 0 || _zag_allocator_live_bytes() != before) { return 1; }
    if (sj.script_json_root(&doc).status != sj.script_json_invalid()) { return 2; }
    sj.script_json_document_free(&doc);
    if (_zag_allocator_live_bytes() != before) { return 3; }
    return 0;
}

fn context_encode(doc: *json.JsonDocument, policy: i64, overhead: i64) i32 {
    let expected: json.JsonEncodeResult = sj.script_json_encode(doc);
    if (expected.ok != 1) { return 1; }
    let context: *i8 = _zag_script_context_init((expected.value.len as i64) + overhead, 7, policy);
    let before: i64 = _zag_allocator_live_bytes();
    let probe: json.JsonDocument = sj.script_json_parse("[1,2,3]");
    if (probe.ok != 1 || _zag_script_alloc_used(context) != 0) { return 5; }
    sj.script_json_document_free(&probe);
    if (_zag_allocator_live_bytes() != before) { return 6; }
    let root: sj.ScriptJsonCursor = sj.script_json_root(doc);
    if (sj.script_json_encode_context_bounded(context, doc, root, 64, 1).ok != 0 ||
        _zag_script_alloc_used(context) != 0 || _zag_allocator_live_bytes() != before) { return 2; }
    let encoded: json.JsonEncodeResult = sj.script_json_encode_context(context, doc);
    let words: *i64 = context as *i64;
    if (encoded.ok != 1 || !@strEq(encoded.value, expected.value) || words[11] != 1 ||
        _zag_script_alloc_used(context) != (expected.value.len as i64) + overhead) { return 3; }
    // A second encode cannot fit; its ordinary temporary must be released.
    let used: i64 = _zag_allocator_live_bytes();
    if (sj.script_json_encode_context(context, doc).ok != 0 ||
        _zag_allocator_live_bytes() != used || words[11] != 1) { return 4; }
    _zag_script_context_shutdown(context);
    sj.script_json_encoded_free(&expected);
    return 0;
}

fn main() i32 {
    if (failed_parse("{\"x\":[\"owned\",{\"y\":\"text\"},]}", 64, 1024, 100) != 0) { return 1; }
    if (failed_parse("[1] trailing", 64, 1024, 100) != 0) { return 2; }
    if (failed_parse("[[1]]", 0, 1024, 100) != 0) { return 3; }
    if (failed_parse("[1,2]", 64, 1024, 2) != 0) { return 4; }
    if (failed_parse("null", 64, 3, 100) != 0) { return 5; }
    if (failed_parse("", 64, 1024, 100) != 0) { return 6; }
    if (failed_parse((null as *u8)[0..1], 64, 1024, 100) != 0 ||
        failed_parse((null as *u8)[0..-1], 64, 1024, 100) != 0) { return 24; }
    let scalar: json.JsonDocument = sj.script_json_parse_bounded("null", 0, 4, 1);
    if (scalar.ok != 1 || sj.script_json_root(&scalar).status != sj.script_json_null()) { return 25; }
    sj.script_json_document_free(&scalar);
    let before: i64 = _zag_allocator_live_bytes();
    let doc: json.JsonDocument = sj.script_json_parse("{\"users\":[{\"name\":\"Ω\",\"n\":-42,\"yes\":false}],\"nil\":null,\"empty\":\"\",\"huge\":9223372036854775808,\"f\":1.5,\"dup\":1,\"dup\":2}");
    if (doc.ok != 1) { return 7; }
    let root: sj.ScriptJsonCursor = sj.script_json_root(&doc);
    let users: sj.ScriptJsonCursor = sj.script_json_get(&doc, root, "users");
    let user: sj.ScriptJsonCursor = sj.script_json_at(&doc, users, 0);
    let name: sj.ScriptJsonString = sj.script_json_string(&doc, sj.script_json_get(&doc, user, "name"));
    if (name.status != sj.script_json_ok() || !@strEq(name.value, "Ω")) { return 8; }
    if (sj.script_json_int(&doc, sj.script_json_get(&doc, user, "n")).value != -42) { return 9; }
    let no: sj.ScriptJsonBool = sj.script_json_bool(&doc, sj.script_json_get(&doc, user, "yes"));
    if (no.status != sj.script_json_ok() || no.value) { return 10; }
    let missing: sj.ScriptJsonCursor = sj.script_json_get(&doc, root, "absent");
    let nil: sj.ScriptJsonCursor = sj.script_json_get(&doc, root, "nil");
    if (missing.status != sj.script_json_missing() || nil.status != sj.script_json_null()) { return 11; }
    if (sj.script_json_get(&doc, missing, "nested").status != sj.script_json_missing() ||
        sj.script_json_get(&doc, nil, "nested").status != sj.script_json_null() ||
        sj.script_json_string(&doc, nil).status != sj.script_json_null()) { return 12; }
    if (sj.script_json_get(&doc, users, "name").status != sj.script_json_wrong_type() ||
        sj.script_json_at(&doc, root, 0).status != sj.script_json_wrong_type() ||
        sj.script_json_at(&doc, users, -1).status != sj.script_json_missing() ||
        sj.script_json_at(&doc, users, 1).status != sj.script_json_missing()) { return 13; }
    let empty: sj.ScriptJsonString = sj.script_json_string(&doc, sj.script_json_get(&doc, root, "empty"));
    if (empty.status != sj.script_json_ok() || empty.value.len != 0) { return 14; }
    if (sj.script_json_int(&doc, sj.script_json_get(&doc, root, "huge")).status != sj.script_json_number_range() ||
        sj.script_json_int(&doc, sj.script_json_get(&doc, root, "f")).status != sj.script_json_number_range() ||
        sj.script_json_float(&doc, sj.script_json_get(&doc, root, "f")).value != 1.5) { return 15; }
    if (sj.script_json_int(&doc, sj.script_json_get(&doc, root, "dup")).value != 1 ||
        sj.script_json_length(&doc, users).value != 1 || sj.script_json_length(&doc, root).value != 7 ||
        !@strEq(sj.script_json_member_key(&doc, root, 0).value, "users") ||
        sj.script_json_member_key(&doc, root, 7).status != sj.script_json_missing()) { return 16; }
    let encoded: json.JsonEncodeResult = sj.script_json_encode(&doc);
    let roundtrip: json.JsonDocument = sj.script_json_parse(encoded.value);
    if (encoded.ok != 1 || roundtrip.ok != 1) { return 17; }
    sj.script_json_document_free(&roundtrip);
    sj.script_json_encoded_free(&encoded);
    let null_encoded: json.JsonEncodeResult = sj.script_json_encode_bounded(&doc, nil, 0, 4);
    if (null_encoded.ok != 1 || !@strEq(null_encoded.value, "null")) { return 18; }
    sj.script_json_encoded_free(&null_encoded);
    if (sj.script_json_encode_bounded(&doc, root, 0, 1024).ok != 0 ||
        sj.script_json_encode_bounded(&doc, missing, 64, 1024).ok != 0) { return 19; }
    sj.script_json_document_free(&doc);
    if (sj.script_json_root(&doc).status != sj.script_json_invalid() ||
        sj.script_json_string(&doc, user).status != sj.script_json_invalid()) { return 20; }
    sj.script_json_document_free(&doc);
    if (_zag_allocator_live_bytes() != before) { return 21; }
    // Native context metadata retention is outside this facade's ownership.
    let small: json.JsonDocument = sj.script_json_parse("{\"a\":[null,true,0,\"x\"]}");
    if (context_encode(&small, 16843009, 0) != 0) { return 22; }
    if (context_encode(&small, 16843010, 16) != 0) { return 23; }
    sj.script_json_document_free(&small);
    return 0;
}
