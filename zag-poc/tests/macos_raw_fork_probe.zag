extern fn _zag_raw_syscall(num:i64,a1:i64,a2:i64,a3:i64,a4:i64,a5:i64,a6:i64)i64

fn main() i32 {
    let pid:i64=_zag_raw_syscall(57,0,0,0,0,0,0);
    if(pid<0){return 10+(0-pid) as i32;}
    if(pid==0){return 0;}
    let status:*i64=new(0);
    let got:i64=_zag_raw_syscall(61,pid,status as i64,0,0,0,0);
    if(got!=pid){return 20;}
    return 42;
}
