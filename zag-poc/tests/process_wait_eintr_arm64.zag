// Linux ARM64 execution fixture. The kernel supplies the vDSO sigreturn
// trampoline for an action without SA_RESTORER; no libc signal wrapper.
@import("../selfhost/std/process_platform.zag")
fn process_test_signal(signal: i64) void { return; }

fn main() i32 {
    let action: *i64 = _zag_malloc(32) as *i64;
    let handler: fn(i64) void = process_test_signal;
    action[0] = ((&handler) as *i64)[0]; // code word of captureless Zag function
    action[1] = 0; action[2] = 0; action[3] = 0;
    if (_zag_raw_syscall(13, 10, action as i64, 0, 8, 0, 0) != 0) { return 1; }
    let parent: i64 = _zag_raw_syscall(39, 0, 0, 0, 0, 0, 0);
    let child: i64 = process_platform_fork();
    if (child < 0) { return 2; }
    if (child == 0) {
        let delay: *i64 = _zag_malloc(16) as *i64;
        delay[0] = 0; delay[1] = 100000000;
        let slept: i64 = _zag_raw_syscall(35, delay as i64, 0, 0, 0, 0, 0);
        if (slept != 0 || _zag_raw_syscall(62, parent, 10, 0, 0, 0, 0) != 0) { _zag_exit(3); }
        _zag_exit(0);
    }
    let start: i64 = _zag_clock_monotonic_ms();
    let rc: i32 = process_platform_wait_readable(-1, 2000);
    let elapsed: i64 = _zag_clock_monotonic_ms() - start;
    let status: i64 = 0;
    if (process_platform_wait(child, (&status) as i64, 0) != child || status != 0) { return 4; }
    // Returning -EINTR, spinning, or swallowing EINTR until the full timeout
    // are all wrong. The supervisor must regain control to check its deadline.
    if (rc != 0 || elapsed < 30 || elapsed > 1000) { return 5; }
    _zag_println("process wait: real Linux ARM64 SIGUSR1/EINTR PASS");
    return 0;
}
