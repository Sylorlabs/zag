@import("std:channel_mpmc_i64") as channel

struct MpmcWorkers {
    queue: channel.ChannelMpmcI64,
    producer_total: i64,
    consumer_total: i64,
    sum: i64,
    errors: i64,
}

fn mpmc_producer_a(address:i64) void {
    unsafe {
    let context:*MpmcWorkers=null as *MpmcWorkers;
    unsafe { context=address as *MpmcWorkers; }
    if(context==null as *MpmcWorkers){return;}
    let i:i64=0;
    while(i<100){
        let attempts:i32=0;
        let sent:i32=0;
        while(attempts<100000&&sent==0){
            let result:channel.ChannelMpmcI64OpResult=
                channel.channel_mpmc_i64_try_send(&context.*.queue,1000+i);
            if(result.ok==1){sent=1;}
            else if(result.code!=channel.channel_mpmc_i64_status_full()&&
                    result.code!=channel.channel_mpmc_i64_status_contention()){
                @atomicFetchAdd64((&context.*.errors) as *mut i64,1);break;
            }
            attempts=attempts+1;
        }
        if(sent==0){@atomicFetchAdd64((&context.*.errors) as *mut i64,1);}
        @atomicFetchAdd64((&context.*.producer_total) as *mut i64,1);
        i=i+1;
    }
    }
}

fn mpmc_producer_b(address:i64) void {
    unsafe {
    let context:*MpmcWorkers=null as *MpmcWorkers;
    unsafe { context=address as *MpmcWorkers; }
    if(context==null as *MpmcWorkers){return;}
    let i:i64=0;
    while(i<100){
        let attempts:i32=0;
        let sent:i32=0;
        while(attempts<100000&&sent==0){
            let result:channel.ChannelMpmcI64OpResult=
                channel.channel_mpmc_i64_try_send(&context.*.queue,2000+i);
            if(result.ok==1){sent=1;}
            else if(result.code!=channel.channel_mpmc_i64_status_full()&&
                    result.code!=channel.channel_mpmc_i64_status_contention()){
                @atomicFetchAdd64((&context.*.errors) as *mut i64,1);break;
            }
            attempts=attempts+1;
        }
        if(sent==0){@atomicFetchAdd64((&context.*.errors) as *mut i64,1);}
        @atomicFetchAdd64((&context.*.producer_total) as *mut i64,1);
        i=i+1;
    }
    }
}

fn mpmc_consumer(address:i64) void {
    unsafe {
    let context:*MpmcWorkers=null as *MpmcWorkers;
    unsafe { context=address as *MpmcWorkers; }
    if(context==null as *MpmcWorkers){return;}
    let i:i64=0;
    while(i<100){
        let attempts:i32=0;
        let received:i32=0;
        while(attempts<100000&&received==0){
            let result:channel.ChannelMpmcI64OpResult=
                channel.channel_mpmc_i64_try_receive(&context.*.queue);
            if(result.ok==1){
                @atomicFetchAdd64((&context.*.sum) as *mut i64,result.value);
                received=1;
            }else if(result.code!=channel.channel_mpmc_i64_status_empty()&&
                    result.code!=channel.channel_mpmc_i64_status_contention()){
                @atomicFetchAdd64((&context.*.errors) as *mut i64,1);break;
            }
            attempts=attempts+1;
        }
        if(received==0){@atomicFetchAdd64((&context.*.errors) as *mut i64,1);}
        @atomicFetchAdd64((&context.*.consumer_total) as *mut i64,1);
        i=i+1;
    }
    }
}

fn main() i32 {
    unsafe {
        let context_address:i64=_zag_raw_syscall(9,0,4096,3,34,0-1,0);
        if(context_address<0){return 2;}
        let context:*MpmcWorkers=context_address as *MpmcWorkers;
        if(channel.channel_mpmc_i64_create_into(&context.*.queue,8)!=0){return 1;}
        context.*.producer_total=0;context.*.consumer_total=0;
        context.*.sum=0;context.*.errors=0;
        let p1:*opaque=@threadSpawn(mpmc_producer_a,context_address);
        let p2:*opaque=@threadSpawn(mpmc_producer_b,context_address);
        let c1:*opaque=@threadSpawn(mpmc_consumer,context_address);
        let c2:*opaque=@threadSpawn(mpmc_consumer,context_address);
        if(p1==null as *opaque||p2==null as *opaque||
           c1==null as *opaque||c2==null as *opaque){return 3;}
        @threadJoin(p1);@threadJoin(p2);@threadJoin(c1);@threadJoin(c2);
        let queue_closed:i64=channel.channel_mpmc_i64_close(&context.*.queue);
        let expected_sum:i64=0;
        let i:i64=0;
        while(i<100){expected_sum=expected_sum+1000+i+2000+i;i=i+1;}
        let producers:i64=context.*.producer_total;
        let consumers:i64=context.*.consumer_total;
        let sum:i64=context.*.sum;
        let errors:i64=context.*.errors;
        let unmap:i64=_zag_raw_syscall(11,context_address,4096,0,0,0,0);
        if(queue_closed!=0||unmap!=0||producers!=200||consumers!=200||
           sum!=expected_sum||errors!=0){return 4;}
        return 0;
    }
}
