@import("../selfhost/std/fmt.zag")

fn main() i32 {
    let s: []u8 = fmt_int(42 as i64);
    _zag_println(s);
    _zag_println(fmt_bool(1));
    _zag_println(fmt_bool(0));

    let parts: StrList = strlist_new(3);
    strlist_push(&parts, "hello");
    strlist_push(&parts, " ");
    strlist_push(&parts, "world");
    let joined: []u8 = fmt_concat(&parts);
    _zag_println(joined);

    // Test empty StrList
    let empty_parts: StrList = strlist_new(1);
    let joined_empty: []u8 = fmt_concat(&empty_parts);
    if (joined_empty.len == 0) {
        _zag_println("empty_parts: OK");
    }

    // Test StrList with only empty strings
    let empty_strs: StrList = strlist_new(2);
    strlist_push(&empty_strs, "");
    strlist_push(&empty_strs, "");
    let joined_empty_strs: []u8 = fmt_concat(&empty_strs);
    if (joined_empty_strs.len == 0) {
        _zag_println("empty_strs: OK");
    }

    // Test single element
    let single: StrList = strlist_new(1);
    strlist_push(&single, "single");
    let joined_single: []u8 = fmt_concat(&single);
    _zag_println(joined_single);

    let parts2: StrList = strlist_new(3);
    strlist_push(&parts2, "one");
    strlist_push(&parts2, "two");
    strlist_push(&parts2, "three");
    let joined2: []u8 = fmt_join(&parts2, ",");
    _zag_println(joined2);

    print_int32(123);
    println_int32(456);
    print_bool(1);
    print_bool(0);
    return 0;
}
