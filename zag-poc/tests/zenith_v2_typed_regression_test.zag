// Regression witnesses discovered while moving Zenith DAW to edition 2027.
// These are compiler tests: consumer source must not paper over typed/resource
// authority defects with aliases, scalar temporaries, or allocator lookalikes.

@import("../selfhost/typed.zag")

fn expect(ok: i32, label: []u8, failures: *i32) void {
    if (ok == 0) {
        _zag_eprintln(label);
        failures.* = failures.* + 1;
    }
}

fn first_let_expr(decls: ArrayList[*Node]) *Node {
    let i: i32 = 0;
    while (i < decls.len) {
        switch (decls.data[i].*) {
            .fn_decl => |f| {
                let j: i32 = 0;
                while (j < f.body.len) {
                    switch (f.body.data[j].*) {
                        .let_ => |l| { if (l.has_init == 1) { return l.expr; } }
                        else => { }
                    }
                    j = j + 1;
                }
            }
            else => { }
        }
        i = i + 1;
    }
    return null as *Node;
}

fn first_statement_expr(decls: ArrayList[*Node]) *Node {
    let i: i32 = 0;
    while (i < decls.len) {
        switch (decls.data[i].*) {
            .fn_decl => |f| {
                let j: i32 = 0;
                while (j < f.body.len) {
                    switch (f.body.data[j].*) {
                        .estmt => |e| { return e.expr; }
                        else => { }
                    }
                    j = j + 1;
                }
            }
            else => { }
        }
        i = i + 1;
    }
    return null as *Node;
}

fn main() i32 {
    let failures: i32 = 0;

    // A field/method call has no direct declaration name. An empty generic
    // base must not match every underscore-led runtime declaration.
    expect(zt_generic_decl_name_candidate("_zag_malloc", "") == 0,
        "empty call name matched an unrelated generic declaration", &failures);

    // zalloc/zalloc_i are first-class resource producers when their result is
    // installed in an @owned(zfree/zfree_i) field.
    let floats: ArrayList[*Node] = parse_program(
        "fn make_buf() void { let data:[]f32=zalloc(8); zfree(data); }");
    let float_expr: *Node = first_let_expr(floats);
    expect(float_expr != null && @strEq(zt_res_known_acquire_release(float_expr), "zfree"),
        "zalloc did not carry its zfree resource relation", &failures);

    let ints: ArrayList[*Node] = parse_program(
        "fn make_buf() void { let data:[]i32=zalloc_i(8); zfree_i(data); }");
    let int_expr: *Node = first_let_expr(ints);
    expect(int_expr != null && @strEq(zt_res_known_acquire_release(int_expr), "zfree_i"),
        "zalloc_i did not carry its zfree_i resource relation", &failures);

    // A copied scalar argument cannot transfer the owner of the buffer from
    // which it was indexed.
    let scalar: ArrayList[*Node] = parse_program(
        "fn observe(x:f32)f32{return x;} fn main()i32{return 0;}");
    expect(zt_callee_param_pointer_free(scalar, "observe", 0) == 1,
        "pointer-free callee parameter was not recognized", &failures);
    expect(zt_compiler_nonretaining_call("print_f32") == 1,
        "scalar print intrinsic was not recognized as nonretaining", &failures);

    // `filter.reset()` is an ordinary domain method. Only reset on the exact
    // live retained allocator receiver advances a fixed-buffer generation.
    let reset_ast: ArrayList[*Node] = parse_program(
        "fn probe()void{filter.reset();}");
    let reset_expr: *Node = first_statement_expr(reset_ast);
    let inactive: ZTRetainedState = ZTRetainedState{
        .backing = "", .allocator = "", .released = "", .phase = 0,
        .generation = 1, .kind = 0,
    };
    let live_other: ZTRetainedState = ZTRetainedState{
        .backing = "backing", .allocator = "arena", .released = "", .phase = 1,
        .generation = 1, .kind = 2,
    };
    let live_filter: ZTRetainedState = ZTRetainedState{
        .backing = "backing", .allocator = "filter", .released = "", .phase = 1,
        .generation = 1, .kind = 1,
    };
    expect(reset_expr != null && zt_retained_reset_is_live(reset_expr, inactive) == 0,
        "ordinary reset was claimed without a retained allocator lifecycle", &failures);
    expect(zt_retained_reset_is_live(reset_expr, live_other) == 0,
        "ordinary reset was claimed for a different retained allocator", &failures);
    expect(zt_retained_reset_is_live(reset_expr, live_filter) == 1,
        "the exact live retained allocator reset was not recognized", &failures);

    if (failures == 0) { _zag_println("zenith v2 typed regressions: PASS"); }
    return failures;
}
