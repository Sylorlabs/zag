@import("../selfhost/native/process_script_authority.zag")

fn process_authority_spoof(which: i32) i32 {
    let decls: ArrayList[*Node] = parse_program_dir("@import(\"../selfhost/std/process.zag\") fn main() i32 { return 0; }", "tests");
    let i: i32 = 0;
    while (i < decls.len) {
        switch (decls.data[i].*) {
            .fn_decl => |f| {
                if (which == 1 && @strEq(f.name,"process_platform_wait_readable")) {
                    f.origin = "project/process_platform.zag";
                    decls.data[i].* = Node{.fn_decl=f};
                }
                if (which != 1 && @strEq(f.name,"_zag_process_wait_readable")) {
                    if (which == 2) { f.origin = "<root>"; }
                    else { f.is_extern = 0; }
                    decls.data[i].* = Node{.fn_decl=f};
                }
            }
            else => {}
        }
        i = i + 1;
    }
    return process_script_runtime_authorized(decls,"process_platform_wait_readable","_zag_process_wait_readable");
}

fn main() i32 {
    let decls: ArrayList[*Node] = parse_program_dir("@import(\"../selfhost/std/process.zag\") fn main() i32 { return 0; }", "tests");
    if (process_script_runtime_authorized(decls,"process_platform_wait_readable","_zag_process_wait_readable") != 1) { return 1; }
    if (process_script_runtime_authorized(decls,"process_platform_pipe","_zag_raw_syscall") != 1) { return 2; }
    if (process_script_runtime_authorized(decls,"process_run_bounded_internal","_zag_raw_syscall") != 0) { return 3; }
    if (process_script_runtime_authorized(decls,"process_platform_read","_zag_process_wait_readable") != 0) { return 4; }
    if (process_authority_spoof(1) != 0) { return 5; }
    if (process_authority_spoof(2) != 0) { return 6; }
    if (process_authority_spoof(3) != 0) { return 7; }
    if (process_script_runtime_authorized(decls,"process_platform_wait_readable","_zag_process_wait_readable") != 1) { return 8; }
    _zag_println("process Script authority: exact origins, owner/callee binding and spoof rejection PASS");
    return 0;
}
