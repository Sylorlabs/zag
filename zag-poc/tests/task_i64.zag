// Bounded Linux/x86-64 cooperative task/result witness. This is deliberately
// intrinsic-only: it is not the language async/await surface.

fn add_worker(handle:i64) i64 {
    let task:*opaque = null;
    let input:i64 = 0;
    unsafe {
        task = handle as *opaque;
        input = @taskInput(task);
        if (@taskCancelled(task) == 1) { return 0 - 999; }
    }
    return input + 40;
}

fn cancel_worker(handle:i64) i64 {
    let task:*opaque = null;
    let input:i64 = 0;
    unsafe { task = handle as *opaque; input = @taskInput(task); }
    let i:i64 = 0;
    while (i < 10000000) {
        unsafe {
            if (@taskCancelled(task) == 1) { return 0 - 999; }
            let _yielded:i64 = _zag_raw_syscall(24,0,0,0,0,0,0);
        }
        i = i + 1;
    }
    return input;
}

fn main() i32 {
    unsafe {
        let first:*opaque = @taskSpawn(add_worker, 2);
        if (first == null as *opaque) { return 1; }
        let value:i64 = @taskAwait(first);
        if (value != 42) { return 2; }

        let second:*opaque = @taskSpawn(cancel_worker, 7);
        if (second == null as *opaque) { return 3; }
        let cancel_rc:i64 = @taskCancel(second);
        let cancelled:i64 = @taskAwait(second);
        if (cancel_rc != 0 || cancelled != 0 - 999) { return 4; }
    }
    _zag_println("task-i64 result=42 cancellation=1");
    return 42;
}
