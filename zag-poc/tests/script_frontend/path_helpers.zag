script;

let joined:[]u8=path_join("tmp","report.json");
if(!@strEq(joined,"tmp/report.json")){return 51;}
if(!@strEq(path_basename("/tmp/report.json"),"report.json")){return 52;}
if(!@strEq(path_dirname("/tmp/report.json"),"/tmp")){return 53;}
if(!@strEq(path_extension("/tmp/report.json"),".json")){return 54;}
if(script_alloc_used()!=15){return 55;}
return 0;
