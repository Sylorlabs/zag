script;

def doubled(value):
    return value * 2

scores = [8, 10, 6]
scores.append(9)

if len(scores) == 4:
    print(scores[2])
else:
    return 1

total = 0
for score in scores:
    total = total + score

if total != 33:
    return 2

if doubled(21) != 42:
    return 3

range_total = 0
for number in range(1, 5):
    range_total = range_total + number

if range_total != 10:
    return 4
