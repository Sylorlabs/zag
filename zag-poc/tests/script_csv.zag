// script_csv.zag — deterministic CSV contract test in Script mode.
//
// Supports:
// - unquoted fields split on commas
// - quoted fields with commas and escaped quotes
// - CRLF or LF row boundaries
//
@import("std:csv") as csv

extern fn _zag_allocator_live_bytes() i64

fn csv_owned_cleanup_test() i32 {
    let before: i64 = _zag_allocator_live_bytes();
    let malformed: csv.CsvTable = csv.csv_parse("a,b\n\"owned\",\"unterminated");
    if (malformed.ok != 0) { csv.csv_free(&malformed); return 0; }
    csv.csv_free(&malformed);
    if (_zag_allocator_live_bytes() != before) { return 0; }
    let valid: csv.CsvTable = csv.csv_parse("a,b\n\"line1\nline2\",c");
    if (valid.ok != 1) { csv.csv_free(&valid); return 0; }
    csv.csv_free(&valid);
    return (_zag_allocator_live_bytes() == before) as i32;
}

fn main() i32 {
    if (csv_owned_cleanup_test() == 0) { return 23; }
    let input: []u8 =
        "name,age,city,score\nalice,30,\"New York\",95\nbob,25,\"Los Angeles, CA\",88\ncarol,35,Chicago,72\ndave,28,Boston,91\neve,22,Seattle,85";

    let table: csv.CsvTable = csv.csv_parse(input);
    if (table.ok != 1) { return 1; }
    if (csv.csv_row_count(table) != 6) { return 2; }
    if (csv.csv_col_count(table) != 4) { return 3; }
    if (!@strEq(csv.csv_get(table, 0, 0), "name")) { return 4; }
    if (!@strEq(csv.csv_get(table, 1, 3), "95")) { return 5; }
    if (!@strEq(csv.csv_get(table, 2, 2), "Los Angeles, CA")) { return 6; }
    if (!@strEq(csv.csv_get(table, 5, 1), "22")) { return 7; }
    if (csv.csv_cell_count(table, 2) != 4) { return 8; }

    let quoted_csv: []u8 =
        "\"a\",\"b\"\"bee\"\",\"\"\",\"b\"\n\"c\",\"d\"";
    let quoted_table: csv.CsvTable = csv.csv_parse(quoted_csv);
    if (quoted_table.ok != 1) { return 9; }
    if (csv.csv_row_count(quoted_table) != 2) { return 10; }
    if (!@strEq(csv.csv_get(quoted_table, 0, 1), "b\"bee\",\"")) { return 11; }

    let malformed: []u8 = "\"unterminated\nx,y";
    let malformed_table: csv.CsvTable = csv.csv_parse(malformed);
    if (malformed_table.ok != 0) { return 12; }

    let crlf_csv: []u8 = "a,b\r\nx,y\r\nz,w";
    let crlf_table: csv.CsvTable = csv.csv_parse(crlf_csv);
    if (crlf_table.ok != 1) { return 13; }
    if (csv.csv_row_count(crlf_table) != 3) { return 14; }
    if (!@strEq(csv.csv_get(crlf_table, 2, 1), "w")) { return 15; }

    let edge_csv: []u8 = ",tail,\n\"line1\nline2\",\"a\"\"b\"\n";
    let edge_table: csv.CsvTable = csv.csv_parse(edge_csv);
    if (edge_table.ok != 1 || csv.csv_row_count(edge_table) != 2 ||
        csv.csv_cell_count(edge_table, 0) != 3 ||
        !@strEq(csv.csv_get(edge_table, 0, 0), "") ||
        !@strEq(csv.csv_get(edge_table, 0, 2), "") ||
        !@strEq(csv.csv_get(edge_table, 1, 0), "line1\nline2") ||
        !@strEq(csv.csv_get(edge_table, 1, 1), "a\"b")) { return 16; }

    let final_empty: csv.CsvTable = csv.csv_parse("a,b,");
    let comma_only: csv.CsvTable = csv.csv_parse(",");
    let blank_line: csv.CsvTable = csv.csv_parse("\n");
    if (final_empty.ok != 1 || csv.csv_cell_count(final_empty, 0) != 3 ||
        !@strEq(csv.csv_get(final_empty, 0, 2), "") ||
        comma_only.ok != 1 || csv.csv_cell_count(comma_only, 0) != 2 ||
        blank_line.ok != 1 || csv.csv_row_count(blank_line) != 1 ||
        csv.csv_cell_count(blank_line, 0) != 1) { return 17; }

    let quoted_crlf: csv.CsvTable = csv.csv_parse("\"a\r\nb\",c");
    if (quoted_crlf.ok != 1 || !@strEq(csv.csv_get(quoted_crlf, 0, 0), "a\r\nb")) { return 18; }

    let bytes_after_quote: csv.CsvTable = csv.csv_parse("\"a\" ,b");
    let quote_in_unquoted: csv.CsvTable = csv.csv_parse("a\"b,c");
    let lone_quote: csv.CsvTable = csv.csv_parse("\"");
    if (bytes_after_quote.ok != 0 || quote_in_unquoted.ok != 0 || lone_quote.ok != 0) { return 19; }

    let encoded: csv.CsvEncodeResult = csv.csv_encode(edge_table);
    let encoded_lf: csv.CsvEncodeResult = csv.csv_encode_lf(edge_table);
    if (encoded.ok != 1 || !@strEq(encoded.value, ",tail,\r\n\"line1\nline2\",\"a\"\"b\"") ||
        encoded_lf.ok != 1 || !@strEq(encoded_lf.value, ",tail,\n\"line1\nline2\",\"a\"\"b\"")) { return 20; }
    let encoded_roundtrip: csv.CsvTable = csv.csv_parse(encoded.value);
    if (encoded_roundtrip.ok != 1 || csv.csv_row_count(encoded_roundtrip) != 2 ||
        !@strEq(csv.csv_get(encoded_roundtrip, 1, 1), "a\"b")) { return 21; }

    let bounded_bytes: csv.CsvTable = csv.csv_parse_bounded("abc", 2, 4, 4, 4);
    let bounded_rows: csv.CsvTable = csv.csv_parse_bounded("a\nb", 8, 1, 4, 4);
    let bounded_cells: csv.CsvTable = csv.csv_parse_bounded("a,b", 8, 4, 1, 4);
    let bounded_field: csv.CsvTable = csv.csv_parse_bounded("abc", 8, 4, 4, 2);
    let tiny_encode: csv.CsvEncodeResult = csv.csv_encode_bounded(edge_table, 5, 1);
    if (bounded_bytes.ok != 0 || bounded_rows.ok != 0 || bounded_cells.ok != 0 ||
        bounded_field.ok != 0 || tiny_encode.ok != 0) { return 22; }

    csv.csv_free(&table);
    csv.csv_free(&quoted_table);
    csv.csv_free(&malformed_table);
    csv.csv_free(&crlf_table);
    csv.csv_free(&edge_table);
    csv.csv_free(&final_empty);
    csv.csv_free(&comma_only);
    csv.csv_free(&blank_line);
    csv.csv_free(&quoted_crlf);
    csv.csv_free(&bytes_after_quote);
    csv.csv_free(&quote_in_unquoted);
    csv.csv_free(&lone_quote);
    csv.csv_free(&encoded_roundtrip);
    csv.csv_free(&bounded_bytes);
    csv.csv_free(&bounded_rows);
    csv.csv_free(&bounded_cells);
    csv.csv_free(&bounded_field);
    csv.csv_encode_result_free(&encoded);
    csv.csv_encode_result_free(&encoded_lf);
    return 0;
}
