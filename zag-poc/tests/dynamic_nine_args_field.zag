extern fn cabi_nine(a: i64, b: i64, c: i64, d: i64, e: i64,
    f: i64, g: i64, h: i64, i: i64) i64;

struct Box { result: i64, left: i64, right: i64 }

fn make_box() Box {
    let box: Box = Box{ .result = 0, .left = 11, .right = 31 };
    box.result = cabi_nine(1, 2, 3, 4, 5, 6, 7, 8, 9);
    return box;
}

fn main() i32 {
    let box: Box = make_box();
    if (box.result == 987654321 && box.left + box.right == 42) { return 42; }
    return 1;
}
