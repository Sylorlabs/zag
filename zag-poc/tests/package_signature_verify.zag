@import("../selfhost/package_signature.zag")

extern fn _zag_argc() i32
extern fn _zag_arg(i: i32) []u8

fn main() i32 {
    if (_zag_argc() != 4) {
        _zag_eprintln("usage: package_signature_verify <index> <public.pem> <signature.bin>");
        return 2;
    }
    let ok: i32 = package_signature_verify_files(
        _zag_arg(1), _zag_arg(2), _zag_arg(3));
    if (ok == 1) {
        _zag_println("package signature: verified");
        return 0;
    }
    _zag_println("package signature: rejected");
    return 1;
}
