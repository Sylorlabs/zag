// Direct argv process boundary: argument bytes are never interpreted by a shell.
@import("../selfhost/std/process.zag") as process
@import("std:list") as list

fn main() i32 {
    let arguments: list.ArrayList[[]u8] = list.make[[]u8](4);
    list.push[[]u8](&arguments, "%s");
    list.push[[]u8](&arguments, "literal;$(printf injected) `quoted`");
    let direct: process.ProcessResult = process.process_run_argv_bounded(
        "/usr/bin/printf", arguments, 1000, 1024);
    if (process.process_result_state(direct) != process.process_state_exited() ||
        process.process_result_status(direct) != 0 ||
        !@strEq(process.process_result_output(direct),
            "literal;$(printf injected) `quoted`")) {
        list.free[[]u8](&arguments);
        return 1;
    }
    list.free[[]u8](&arguments);

    let timeout_arguments: list.ArrayList[[]u8] = list.make[[]u8](1);
    list.push[[]u8](&timeout_arguments, "2");
    let timed: process.ProcessResult = process.process_run_argv_bounded(
        "/bin/sleep", timeout_arguments, 30, 1024);
    if (process.process_result_state(timed) != process.process_state_timed_out()) {
        list.free[[]u8](&timeout_arguments);
        return 2;
    }
    list.free[[]u8](&timeout_arguments);

    let capped_arguments: list.ArrayList[[]u8] = list.make[[]u8](1);
    list.push[[]u8](&capped_arguments, "x");
    let capped: process.ProcessResult = process.process_run_argv_bounded(
        "/usr/bin/yes", capped_arguments, 1000, 64);
    if (process.process_result_state(capped) != process.process_state_output_limit() ||
        process.process_result_output(capped).len != 64) {
        list.free[[]u8](&capped_arguments);
        return 3;
    }
    list.free[[]u8](&capped_arguments);

    let missing_arguments: list.ArrayList[[]u8] = list.make[[]u8](1);
    let missing: process.ProcessResult = process.process_run_argv_bounded(
        "/definitely/missing/zag-process", missing_arguments, 1000, 1024);
    if (process.process_result_state(missing) != process.process_state_exited() ||
        process.process_result_status(missing) != 127) {
        list.free[[]u8](&missing_arguments);
        return 4;
    }
    list.free[[]u8](&missing_arguments);

    let invalid: list.ArrayList[[]u8] = list.make[[]u8](1);
    let rejected: process.ProcessResult = process.process_run_argv_bounded(
        "", invalid, 1000, 1024);
    if (process.process_result_state(rejected) != process.process_state_runtime_error()) {
        list.free[[]u8](&invalid);
        return 5;
    }
    list.free[[]u8](&invalid);
    return 0;
}
