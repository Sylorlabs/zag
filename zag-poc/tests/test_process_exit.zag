// Integration test for process_exit in selfhost/std/process.zag.
// Tests that process_exit terminates the process immediately with the requested exit code.

extern fn _zag_println(s: []u8) void @io;
extern fn _zag_arg(index: i32) []u8 @io;
extern fn _zag_exec_cmd(command: []u8) i32 @io;
extern fn _zag_exit(code: i32) void @io;
extern fn _zag_strcmp(a: []u8, b: []u8) i32 @pure;
extern fn _zag_str_concat(a: []u8, b: []u8) []u8 @alloc;

fn process_arg(index: i32) []u8 {
    return _zag_arg(index);
}

fn process_run_shell(command: []u8) i32 {
    return _zag_exec_cmd(command);
}

fn process_exit(code: i32) void {
    _zag_exit(code);
}

fn main() i32 {
    // Child process mode: inspect argument and call process_exit
    let arg1: []u8 = process_arg(1);
    if (arg1.len > 0) {
        if (_zag_strcmp(arg1, "exit_zero") == 1) {
            process_exit(0);
            return 99; // unreachable if process_exit succeeds
        }
        if (_zag_strcmp(arg1, "exit_42") == 1) {
            process_exit(42);
            return 99; // unreachable if process_exit succeeds
        }
        if (_zag_strcmp(arg1, "exit_125") == 1) {
            process_exit(125);
            return 99; // unreachable if process_exit succeeds
        }
        return 98; // unknown subcommand
    }

    // Parent/driver mode: run self as subprocess with various exit codes
    let self_bin: []u8 = process_arg(0);
    if (self_bin.len == 0) {
        _zag_println("FAIL: empty self binary path");
        return 1;
    }

    // Test 1: process_exit(0)
    let cmd0: []u8 = _zag_str_concat(self_bin, " exit_zero");
    let status0: i32 = process_run_shell(cmd0);
    if (status0 != 0) {
        _zag_println("FAIL: process_exit(0) returned unexpected code");
        return 1;
    }
    _zag_println("process_exit(0): PASS");

    // Test 2: process_exit(42)
    let cmd42: []u8 = _zag_str_concat(self_bin, " exit_42");
    let status42: i32 = process_run_shell(cmd42);
    if (status42 != 42) {
        _zag_println("FAIL: process_exit(42) returned unexpected code");
        return 2;
    }
    _zag_println("process_exit(42): PASS");

    // Test 3: process_exit(125)
    let cmd125: []u8 = _zag_str_concat(self_bin, " exit_125");
    let status125: i32 = process_run_shell(cmd125);
    if (status125 != 125) {
        _zag_println("FAIL: process_exit(125) returned unexpected code");
        return 3;
    }
    _zag_println("process_exit(125): PASS");

    return 0;
}
