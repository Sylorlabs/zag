@import("../selfhost/native/hot_rt_macos.zag")

// Deliberately adds a source-function page. The compiler must reject this
// layout change and preserve the previously staged/running image.
fn added_page() i32 { return 3; }
fn value() i32 { return 2; }
fn stable() i32 { return 7; }

fn main() i32 {
    while (zag_hot_should_continue()) {
        if (value() == 2 && stable() == 7 && added_page() == 3) { return 42; }
        zag_hot_wait();
    }
    return 1;
}
