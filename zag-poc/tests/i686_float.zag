fn affine(tag: i32, x: f64, y: f64) f64 {
    if (tag == 7) { return x * y + 0.5; }
    return 0.0;
}
fn main() i32 {
    let a: f64 = 1.5;
    let b: f64 = 2.0;
    let c: f64 = affine(7, a, b);
    let d: f64 = (c - 0.5) / b;
    if (c == 3.5) {
        if (d >= 1.5) {
            if (d < 2.0) { return 42; }
        }
    }
    return 1;
}
