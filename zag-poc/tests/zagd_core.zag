@import("../selfhost/zagd.zag")

fn expect(ok: i32, failures: *i32) void {
    if (ok == 0) { failures.* = failures.* + 1; }
}

fn main() i32 {
    let failures: i32 = 0;
    let cfg: ZagdConfig = zagd_default_config();
    expect(zagd_config_valid(cfg), &failures);
    expect(cfg.mode == zagd_mode_light() && cfg.max_workers == 1, &failures);
    expect(cfg.gpu_background == 0 && cfg.network_access == 0, &failures);

    let a: ZagdHash = zagd_content_hash("alpha");
    let a2: ZagdHash = zagd_content_hash("alpha");
    let b: ZagdHash = zagd_content_hash("beta");
    expect(zagd_hash_equal(a, a2), &failures);
    expect(1 - zagd_hash_equal(a, b), &failures);

    let root: ZagdHash = zagd_content_hash("root");
    let s1: ZagdHash = zagd_snapshot_add(zagd_snapshot_begin(root), "a.zag", a);
    let s2: ZagdHash = zagd_snapshot_add(zagd_snapshot_begin(root), "a.zag", a2);
    let s3: ZagdHash = zagd_snapshot_add(zagd_snapshot_begin(root), "b.zag", a2);
    expect(zagd_hash_equal(s1, s2), &failures);
    expect(1 - zagd_hash_equal(s1, s3), &failures);

    let early: ZagdStableDecision = zagd_stability(a, b, 100, 150, 75);
    let ready: ZagdStableDecision = zagd_stability(a, b, 100, 175, 75);
    let identical: ZagdStableDecision = zagd_stability(a, a2, 100, 175, 75);
    expect(early.stable == 0 && early.wait_ms == 25 && early.content_changed == 1, &failures);
    expect(ready.stable == 1 && ready.content_changed == 1, &failures);
    expect(identical.stable == 1 && identical.content_changed == 0, &failures);

    expect(zagd_classify_change(0, 1, 1, 1, 1, 1) == zagd_change_none(), &failures);
    expect(zagd_classify_change(1, 0, 0, 0, 0, 1) == zagd_change_nonsemantic(), &failures);
    expect(zagd_classify_change(1, 1, 0, 0, 0, 1) == zagd_change_private_body(), &failures);
    expect(zagd_classify_change(1, 1, 1, 0, 0, 1) == zagd_change_public_shape(), &failures);
    expect(zagd_classify_change(1, 1, 1, 1, 0, 1) == zagd_change_root_profile(), &failures);
    expect(zagd_classify_change(1, 1, 1, 1, 1, 1) == zagd_change_target_profile(), &failures);
    expect(zagd_classify_change(1, 0, 0, 0, 0, 0) == zagd_change_unknown(), &failures);

    let src1: ZagdSourceFacts = zagd_source_facts("pub fn api(x:i32) i32 { return x + 1; }\nfn private() i32 { return 1; }");
    let src_comment: ZagdSourceFacts = zagd_source_facts("// format-only\npub fn api ( x : i32 ) i32 { return x + 1; }\nfn private() i32{return 1;}");
    let src_body: ZagdSourceFacts = zagd_source_facts("pub fn api(x:i32) i32 { return x + 1; }\nfn private() i32 { return 2; }");
    let src_shape: ZagdSourceFacts = zagd_source_facts("pub fn api(x:i64) i64 { return x + 1; }\nfn private() i32 { return 1; }");
    let src_script: ZagdSourceFacts = zagd_source_facts("script; pub fn api(x:i32) i32 { return x; }");
    expect(zagd_classify_sources(src1, src_comment, 0) == zagd_change_nonsemantic(), &failures);
    expect(zagd_classify_sources(src1, src_body, 0) == zagd_change_private_body(), &failures);
    expect(zagd_classify_sources(src1, src_shape, 0) == zagd_change_public_shape(), &failures);
    expect(zagd_classify_sources(src1, src_script, 0) == zagd_change_root_profile(), &failures);
    expect(zagd_source_facts("pub fn broken() { \"oops").valid == 0, &failures);

    let facts: ZagdPlanFacts = ZagdPlanFacts{.temporary_bytes=4096,.repeated_allocations=3,.non_overlapping_buffers=1,.cpu_loop=1,.explicit_allocator=0,.explicit_device=0};
    let regular_advice: ZagdAdvice = zagd_adaptive_advice(facts, 0, 3, 0);
    let script_advice: ZagdAdvice = zagd_adaptive_advice(facts, 1, 3, 0);
    expect(regular_advice.kind == zagd_advice_reuse_buffer() && regular_advice.automatic == 0, &failures);
    expect(script_advice.kind == zagd_advice_reuse_buffer() && script_advice.automatic == 1, &failures);
    facts.explicit_allocator = 1;
    expect(zagd_adaptive_advice(facts, 1, 3, 0).automatic == 0, &failures);
    expect(zagd_adaptive_advice(facts, 1, 3, 1).kind == zagd_advice_none(), &failures);
    expect(zagd_adaptive_advice(facts, 1, 0, 0).kind == zagd_advice_none(), &failures);

    let compiler: ZagdHash = zagd_content_hash("znc-v1");
    let target: ZagdHash = zagd_content_hash("x86_64-generic");
    let payload: ZagdHash = zagd_content_hash("cached-analysis");
    let rec: ZagdCacheRecord = ZagdCacheRecord{
        .format_version = zagd_cache_format_version(), .compiler_identity = compiler,
        .snapshot_identity = s1, .target_identity = target,
        .payload_identity = payload, .payload_bytes = payload.bytes, .complete = 1 };
    expect(zagd_cache_accept(rec, compiler, s1, target, payload, 1024), &failures);
    rec.complete = 0;
    expect(1 - zagd_cache_accept(rec, compiler, s1, target, payload, 1024), &failures);
    rec.complete = 1;
    expect(1 - zagd_cache_accept(rec, compiler, s3, target, payload, 1024), &failures);
    expect(1 - zagd_cache_accept(rec, compiler, s1, target, zagd_content_hash("tampered"), 1024), &failures);
    return failures;
}
