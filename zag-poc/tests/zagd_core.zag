@import("../selfhost/zagd.zag")
@import("../std/list.zag")

fn expect(ok: i32, failures: *i32) void {
    if (ok == 0) { failures.* = failures.* + 1; }
}

fn main() i32 {
    let failures: i32 = 0;
    let cfg: ZagdConfig = zagd_default_config();
    expect(zagd_config_valid(cfg), &failures);
    expect(cfg.mode == zagd_mode_adaptive() && cfg.max_workers == 1, &failures);
    expect(cfg.idle_deep == 1 && @strEq(cfg.difficulty, "simple") &&
        @strEq(cfg.script_optimization, "automatic") &&
        @strEq(cfg.regular_optimization, "review") &&
        @strEq(cfg.objective, "runtime") && @strEq(cfg.trust_mode, "stable"), &failures);
    expect(cfg.max_memory_bytes == 536870912 && cfg.max_cache_bytes == 2147483648 &&
        cfg.stability_window_ms == 75, &failures);
    expect(cfg.gpu_background == 0 && cfg.network_access == 0, &failures);
    let invalid_cfg:ZagdConfig=cfg;
    invalid_cfg.max_workers=2;
    expect(1-zagd_config_valid(invalid_cfg),&failures);
    invalid_cfg=cfg;invalid_cfg.max_memory_bytes=67108863;
    expect(1-zagd_config_valid(invalid_cfg),&failures);
    invalid_cfg=cfg;invalid_cfg.max_cache_bytes=1048575;
    expect(1-zagd_config_valid(invalid_cfg),&failures);
    invalid_cfg=cfg;invalid_cfg.idle_deep=2;
    expect(1-zagd_config_valid(invalid_cfg),&failures);
    invalid_cfg=cfg;invalid_cfg.difficulty="guess";
    expect(1-zagd_config_valid(invalid_cfg),&failures);
    invalid_cfg=cfg;invalid_cfg.script_optimization="always";
    expect(1-zagd_config_valid(invalid_cfg),&failures);
    invalid_cfg=cfg;invalid_cfg.regular_optimization="silent";
    expect(1-zagd_config_valid(invalid_cfg),&failures);
    invalid_cfg=cfg;invalid_cfg.objective="size";
    expect(1-zagd_config_valid(invalid_cfg),&failures);
    invalid_cfg=cfg;invalid_cfg.trust_mode="unbounded";
    expect(1-zagd_config_valid(invalid_cfg),&failures);
    expect(@strEq(zagd_provenance_name(zagd_provenance_proven()),"proven")&&@strEq(zagd_provenance_name(zagd_provenance_derived()),"derived")&&@strEq(zagd_provenance_name(zagd_provenance_estimated()),"estimated")&&@strEq(zagd_provenance_name(zagd_provenance_measured()),"measured")&&@strEq(zagd_provenance_name(zagd_provenance_unknown()),"unknown"),&failures);

    let a: ZagdHash = zagd_content_hash("alpha");
    let a2: ZagdHash = zagd_content_hash("alpha");
    let b: ZagdHash = zagd_content_hash("beta");
    expect(zagd_hash_equal(a, a2), &failures);
    expect(1 - zagd_hash_equal(a, b), &failures);

    let root: ZagdHash = zagd_content_hash("root");
    let root_module:ZagdHash=zagd_content_hash("a.zag");
    let graph:ZagdHash=zagd_content_hash("graph");
    let s1: ZagdHash = zagd_snapshot_add(zagd_snapshot_begin(root,root_module,a,graph,1), "a.zag", a);
    let s2: ZagdHash = zagd_snapshot_add(zagd_snapshot_begin(root,root_module,a2,graph,1), "a.zag", a2);
    let s3: ZagdHash = zagd_snapshot_add(zagd_snapshot_begin(root,zagd_content_hash("b.zag"),a2,graph,1), "b.zag", a2);
    let other_graph:ZagdHash=zagd_snapshot_add(zagd_snapshot_begin(root,root_module,a,zagd_content_hash("graph-2"),1),"a.zag",a);
    expect(zagd_hash_equal(s1, s2), &failures);
    expect(1 - zagd_hash_equal(s1, s3), &failures);
    expect(1-zagd_hash_equal(s1,other_graph),&failures);

    let early: ZagdStableDecision = zagd_stability(a, b, 100, 150, 75);
    let ready: ZagdStableDecision = zagd_stability(a, b, 100, 175, 75);
    let identical: ZagdStableDecision = zagd_stability(a, a2, 100, 175, 75);
    expect(early.stable == 0 && early.wait_ms == 25 && early.content_changed == 1, &failures);
    expect(ready.stable == 1 && ready.content_changed == 1, &failures);
    expect(identical.stable == 1 && identical.content_changed == 0, &failures);

    expect(zagd_classify_change(0, 1, 1, 1, 1, 1) == zagd_change_none(), &failures);
    expect(zagd_classify_change(1, 0, 0, 0, 0, 1) == zagd_change_nonsemantic(), &failures);
    expect(zagd_classify_change(1, 1, 0, 0, 0, 1) == zagd_change_private_body(), &failures);
    expect(zagd_classify_change(1, 1, 1, 0, 0, 1) == zagd_change_public_shape(), &failures);
    expect(zagd_classify_change(1, 1, 1, 1, 0, 1) == zagd_change_root_profile(), &failures);
    expect(zagd_classify_change(1, 1, 1, 1, 1, 1) == zagd_change_target_profile(), &failures);
    expect(zagd_classify_change(1, 0, 0, 0, 0, 0) == zagd_change_unknown(), &failures);

    let src1: ZagdSourceFacts = zagd_source_facts("pub fn api(x:i32) i32 { return x + 1; }\nfn private() i32 { return 1; }");
    let src_comment: ZagdSourceFacts = zagd_source_facts("// format-only\npub fn api ( x : i32 ) i32 { return x + 1; }\nfn private() i32{return 1;}");
    let src_body: ZagdSourceFacts = zagd_source_facts("pub fn api(x:i32) i32 { return x + 1; }\nfn private() i32 { return 2; }");
    let src_shape: ZagdSourceFacts = zagd_source_facts("pub fn api(x:i64) i64 { return x + 1; }\nfn private() i32 { return 1; }");
    let src_script: ZagdSourceFacts = zagd_source_facts("script; pub fn api(x:i32) i32 { return x; }");
    let layout_before:ZagdSourceFacts=zagd_source_facts("pub struct Shared { value:i32 }");
    let layout_after:ZagdSourceFacts=zagd_source_facts("pub struct Shared { value:i32, tag:i32 }");
    let layout_format:ZagdSourceFacts=zagd_source_facts("// formatting only\npub struct Shared { value : i32 }");
    expect(zagd_classify_sources(src1, src_comment, 0) == zagd_change_nonsemantic(), &failures);
    expect(zagd_classify_sources(src1, src_body, 0) == zagd_change_private_body(), &failures);
    expect(zagd_classify_sources(src1, src_shape, 0) == zagd_change_public_shape(), &failures);
    expect(zagd_classify_sources(src1, src_script, 0) == zagd_change_root_profile(), &failures);
    expect(zagd_classify_sources(layout_before,layout_after,0)==zagd_change_public_shape(),&failures);
    expect(zagd_classify_sources(layout_before,layout_format,0)==zagd_change_nonsemantic(),&failures);
    expect(zagd_source_facts("pub fn broken() { \"oops").valid == 0, &failures);
    expect(zagd_source_facts("pub struct Broken { value:i32").valid == 0, &failures);

    let facts: ZagdPlanFacts = ZagdPlanFacts{.temporary_bytes=4096,.repeated_allocations=3,.non_overlapping_buffers=1,.cpu_loop=1,.explicit_allocator=0,.explicit_device=0,.script_cpu_unspecified=1,.script_cpu_target_compatible=1};
    let regular_advice: ZagdAdvice = zagd_adaptive_advice(facts, 0, 3, 0);
    let script_advice: ZagdAdvice = zagd_adaptive_advice(facts, 1, 3, 0);
    expect(regular_advice.kind == zagd_advice_reuse_buffer() && regular_advice.automatic == 0 &&
        regular_advice.supported == 0 && regular_advice.equivalent == 0 &&
        regular_advice.rejected_reason.len > 0, &failures);
    expect(script_advice.kind == zagd_advice_reuse_buffer() && script_advice.automatic == 0 &&
        script_advice.supported == 0 && script_advice.equivalent == 0 &&
        script_advice.rejected_reason.len > 0, &failures);
    facts.explicit_allocator = 1;
    expect(zagd_adaptive_advice(facts, 1, 3, 0).automatic == 0, &failures);
    expect(zagd_adaptive_advice(facts, 1, 3, 1).kind == zagd_advice_none(), &failures);
    expect(zagd_adaptive_advice(facts, 1, 0, 0).kind == zagd_advice_none(), &failures);
    let adaptive:ZagdPlannerRun=zagd_planner_start(zagd_mode_adaptive(),1000);expect(adaptive.budget==64&&adaptive.complete==0,&failures);zagd_planner_step(&adaptive,1000,0);expect(adaptive.evaluated==64&&adaptive.complete==1&&adaptive.suggestions==0,&failures);
    let deep:ZagdPlannerRun=zagd_planner_start(zagd_mode_deep(),1000);expect(deep.budget==256,&failures);zagd_planner_step(&deep,10,0);zagd_planner_accept_constants(&deep,3);expect(deep.suggestions==3&&deep.evaluated==10,&failures);let cancelled:ZagdPlannerRun=zagd_planner_start(zagd_mode_deep(),10);zagd_planner_step(&cancelled,10,1);zagd_planner_accept_constants(&cancelled,3);expect(cancelled.cancelled==1&&cancelled.suggestions==0,&failures);
    let finalists:ArrayList[ZagdPlanCandidate]=make[ZagdPlanCandidate](5);
    push[ZagdPlanCandidate](&finalists,ZagdPlanCandidate{.kind=3,.valid=1,.supported=1,.equivalent=1,.setup_ns=5,.estimated_runtime_ns=100,.measured_runtime_ns=0,.memory_bytes=64});
    push[ZagdPlanCandidate](&finalists,ZagdPlanCandidate{.kind=2,.valid=1,.supported=1,.equivalent=1,.setup_ns=5,.estimated_runtime_ns=80,.measured_runtime_ns=70,.memory_bytes=64});
    push[ZagdPlanCandidate](&finalists,ZagdPlanCandidate{.kind=1,.valid=1,.supported=0,.equivalent=1,.setup_ns=0,.estimated_runtime_ns=1,.measured_runtime_ns=1,.memory_bytes=1});
    let selected:ZagdPlanSelection=zagd_deep_select(finalists,128,2,0);
    expect(selected.winner_kind==2&&selected.evaluated==2&&selected.benchmarked==1&&selected.basis==zagd_provenance_measured(),&failures);
    expect(zagd_deep_select(finalists,32,8,0).winner_kind==0,&failures);
    expect(zagd_deep_select(finalists,128,8,1).cancelled==1&&zagd_deep_select(finalists,128,8,1).evaluated==0,&failures);
    let source_key:ZagdHash=zagd_content_hash("stable-semantic-graph");let target_key:ZagdHash=zagd_content_hash("x86-generic");facts.explicit_allocator=0;
    let generated:ArrayList[ZagdConcreteCandidate]=zagd_generate_candidates(facts,source_key,target_key,1,5,0);
    expect(generated.len==5&&generated.data[0].kind==zagd_candidate_script_default_cpu()&&
        generated.data[0].automatic==1&&generated.data[0].supported==1&&generated.data[0].equivalent==1&&
        generated.data[0].provenance==zagd_provenance_derived()&&generated.data[0].runtime_ns==0&&
        generated.data[0].memory_bytes==0&&generated.data[0].rejected_reason.len==0,&failures);
    let gi:i32=1;while(gi<generated.len){
        expect(generated.data[gi].automatic==0&&generated.data[gi].supported==0&&
            generated.data[gi].equivalent==0&&generated.data[gi].runtime_ns<0&&
            generated.data[gi].memory_bytes<0&&generated.data[gi].rejected_reason.len>0&&
            generated.data[gi].provenance==zagd_provenance_unknown(),&failures);
        gi=gi+1;
    }
    let regular_candidates:ArrayList[ZagdConcreteCandidate]=zagd_generate_candidates(facts,source_key,target_key,0,5,0);expect(regular_candidates.len==5&&regular_candidates.data[0].kind==zagd_candidate_buffer_reuse()&&regular_candidates.data[0].automatic==0&&regular_candidates.data[0].supported==0,&failures);
    facts.script_cpu_unspecified=0;let explicit_cpu_candidates:ArrayList[ZagdConcreteCandidate]=zagd_generate_candidates(facts,source_key,target_key,1,5,0);expect(explicit_cpu_candidates.data[0].kind==zagd_candidate_buffer_reuse()&&explicit_cpu_candidates.data[0].automatic==0,&failures);
    facts.script_cpu_unspecified=1;facts.script_cpu_target_compatible=0;let target_mismatch:ArrayList[ZagdConcreteCandidate]=zagd_generate_candidates(facts,source_key,target_key,1,5,0);expect(target_mismatch.data[0].kind==zagd_candidate_script_default_cpu()&&target_mismatch.data[0].supported==0&&target_mismatch.data[0].automatic==0&&target_mismatch.data[0].provenance==zagd_provenance_unknown(),&failures);facts.script_cpu_target_compatible=1;
    facts.explicit_allocator=1;let explicit_candidates:ArrayList[ZagdConcreteCandidate]=zagd_generate_candidates(facts,source_key,target_key,1,5,0);expect(explicit_candidates.data[0].automatic==1&&explicit_candidates.data[1].automatic==0,&failures);
    expect(zagd_generate_candidates(facts,source_key,target_key,1,2,1).len==0&&zagd_generate_candidates(facts,source_key,target_key,1,2,0).len==2,&failures);
    // `zagd_prune_dominated` consumes its input. Exercise it with owned
    // copies so the generated candidates remain available for measurement
    // assertions below and are never read after the prune frees its storage.
    let prune_input:ArrayList[ZagdConcreteCandidate]=make[ZagdConcreteCandidate](generated.len);let prune_i:i32=0;while(prune_i<generated.len){push[ZagdConcreteCandidate](&prune_input,generated.data[prune_i]);prune_i=prune_i+1;}
    let pruned:ArrayList[ZagdConcreteCandidate]=zagd_prune_dominated(prune_input,8192,5,0);expect(pruned.len==1&&pruned.data[0].kind==zagd_candidate_script_default_cpu(),&failures);
    let prune_input_low:ArrayList[ZagdConcreteCandidate]=make[ZagdConcreteCandidate](generated.len);let prune_low_i:i32=0;while(prune_low_i<generated.len){push[ZagdConcreteCandidate](&prune_input_low,generated.data[prune_low_i]);prune_low_i=prune_low_i+1;}
    let pruned_low:ArrayList[ZagdConcreteCandidate]=zagd_prune_dominated(prune_input_low,1,5,0);expect(pruned_low.len==1,&failures);
    let measured:ZagdMeasurement=ZagdMeasurement{.kind=generated.data[3].kind,.source=source_key,.target=target_key,.runtime_ns=321,.runs=5,.valid=1};
    expect(zagd_ingest_measurement(&generated.data[3],measured,source_key,target_key,1,0)==0,&failures);
    let implemented:ZagdConcreteCandidate=generated.data[3];implemented.supported=1;implemented.equivalent=1;
    implemented.setup_ns=20;implemented.runtime_ns=400;implemented.memory_bytes=4096;
    expect(zagd_ingest_measurement(&implemented,measured,source_key,target_key,1,0)==1&&
        implemented.provenance==zagd_provenance_measured()&&implemented.runtime_ns==321&&
        @strEq(implemented.evidence_basis,"measured"),&failures);
    measured.source=zagd_content_hash("stale");expect(zagd_ingest_measurement(&implemented,measured,source_key,target_key,1,0)==0,&failures);measured.source=source_key;expect(zagd_ingest_measurement(&implemented,measured,source_key,target_key,1,1)==0,&failures);

    let compiler: ZagdHash = zagd_content_hash("znc-v1");
    let target: ZagdHash = zagd_content_hash("x86_64-generic");
    let payload: ZagdHash = zagd_content_hash("cached-analysis");
    let rec: ZagdCacheRecord = ZagdCacheRecord{
        .format_version = zagd_cache_format_version(), .compiler_identity = compiler,
        .snapshot_identity = s1, .target_identity = target,
        .payload_identity = payload, .payload_bytes = payload.bytes, .complete = 1 };
    expect(zagd_cache_accept(rec, compiler, s1, target, payload, 1024), &failures);
    rec.complete = 0;
    expect(1 - zagd_cache_accept(rec, compiler, s1, target, payload, 1024), &failures);
    rec.complete = 1;
    expect(1 - zagd_cache_accept(rec, compiler, s3, target, payload, 1024), &failures);
    expect(1 - zagd_cache_accept(rec, compiler, s1, target, zagd_content_hash("tampered"), 1024), &failures);
    return failures;
}
