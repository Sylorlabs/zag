// Focused contract checks for std:linux_fs.  Fixture creation and permission
// setup live in run_reference_concurrent_file_indexer.sh.

@import("std:linux_fs") as fs
@import("std:rt")

extern fn _zag_allocator_live_bytes() i64

fn test_map() *u8 {
    let raw: i64 = _zag_raw_syscall(9, 0, 8192, 3, 34, 0 - 1, 0);
    if (raw < 0) { return null as *u8; }
    return raw as *u8;
}

fn test_prepare_entries(memory: *u8, capacity: i32) *fs.LinuxFsEntry {
    let entries: *fs.LinuxFsEntry = memory as *fs.LinuxFsEntry;
    let names: *u8 = (memory as i64 + 512) as *u8;
    let i: i32 = 0;
    while (i < capacity) {
        entries[i].name = (names as i64 + i * 256) as *u8;
        entries[i].name_capacity = 256;
        entries[i].name_length = 0;
        entries[i].kind = 0;
        i = i + 1;
    }
    return entries;
}

fn test_copy_name(output: *u8, value: []u8) void {
    let i: i32 = 0;
    while (i < value.len) {
        output[i] = value[i];
        i = i + 1;
    }
    output[value.len] = 0;
}

fn test_list_code(path: []u8, expected: i64, capacity: i32,
                  memory: *u8) i32 {
    let opened: fs.LinuxFsDirectoryResult = fs.linux_fs_directory_open(path);
    if (opened.ok == 0) { return 0; }
    let directory: fs.LinuxFsDirectory = fs.linux_fs_directory_take(&opened);
    let entries: *fs.LinuxFsEntry = test_prepare_entries(memory, capacity);
    let scratch: *u8 = (memory as i64 + 4096) as *u8;
    let listed: fs.LinuxFsListResult =
        fs.linux_fs_list_regular_children_bounded(
            &directory, entries, capacity, scratch, 4096, 8
        );
    let recovered: i32 = 1;
    if (expected == fs.linux_fs_status_limit() && listed.count > 0) {
        let metadata: fs.LinuxFsMetadataResult =
            fs.linux_fs_stat_regular_at_prepared(
                directory.fd, entries[0].name, entries[0].name_length,
                256, 16777216
            );
        recovered = metadata.ok;
    }
    let close_rc: i64 = fs.linux_fs_directory_close(&directory);
    return (listed.ok == 0 && listed.code == expected &&
        recovered == 1 && close_rc == 0) as i32;
}

fn test_read_code(path: []u8, expected: i64, memory: *u8) i32 {
    let opened: fs.LinuxFsDirectoryResult = fs.linux_fs_directory_open(path);
    if (opened.ok == 0) { return 0; }
    let directory: fs.LinuxFsDirectory = fs.linux_fs_directory_take(&opened);
    let entries: *fs.LinuxFsEntry = test_prepare_entries(memory, 3);
    let scratch: *u8 = (memory as i64 + 4096) as *u8;
    let output: *u8 = (memory as i64 + 2048) as *u8;
    let listed: fs.LinuxFsListResult =
        fs.linux_fs_list_regular_children_bounded(
            &directory, entries, 3, scratch, 4096, 8
        );
    if (listed.ok == 0 || listed.count != 3) {
        fs.linux_fs_directory_close(&directory);
        return 0;
    }
    let read: fs.LinuxFsReadResult = fs.linux_fs_read_regular_at_prepared(
        directory.fd, entries[2].name, entries[2].name_length, 256,
        output, 64, 8
    );
    let close_rc: i64 = fs.linux_fs_directory_close(&directory);
    return (read.ok == 0 && read.code == expected && close_rc == 0) as i32;
}

fn main() i32 {
    if (_zag_argc() != 11) { return 1; }
    let allocator_baseline: i64 = _zag_allocator_live_bytes();
    let memory: *u8 = test_map();
    if (memory == null as *u8) { return 2; }

    let forged: fs.LinuxFsDirectoryResult = fs.LinuxFsDirectoryResult{
        .ok = 1, .code = 0,
        .value = fs.LinuxFsDirectory{.fd = 0 - 1, .open = 1},
    };
    if (fs.linux_fs_directory_take(&forged).open != 0 ||
        fs.linux_fs_directory_take(null as *fs.LinuxFsDirectoryResult).open != 0 ||
        fs.linux_fs_directory_close(null as *fs.LinuxFsDirectory) !=
            fs.linux_fs_status_invalid_state()) { return 25; }
    let null_list: fs.LinuxFsListResult =
        fs.linux_fs_list_regular_children_bounded(
            null as *fs.LinuxFsDirectory, null as *fs.LinuxFsEntry, 0,
            null as *u8, 0, 0
        );
    if (null_list.ok != 0 ||
        null_list.code != fs.linux_fs_status_invalid_state()) { return 26; }

    let traversal: fs.LinuxFsDirectoryResult =
        fs.linux_fs_directory_open(_zag_arg(2));
    if (traversal.ok != 0 || traversal.code != fs.linux_fs_status_traversal()) {
        return 3;
    }
    let missing: fs.LinuxFsDirectoryResult =
        fs.linux_fs_directory_open(_zag_arg(3));
    if (missing.ok != 0 || missing.code != (0 - 2)) { return 4; }
    let symlink_root: fs.LinuxFsDirectoryResult =
        fs.linux_fs_directory_open(_zag_arg(4));
    if (symlink_root.ok != 0 ||
        symlink_root.code != fs.linux_fs_status_symlink()) { return 5; }
    let denied_root: fs.LinuxFsDirectoryResult =
        fs.linux_fs_directory_open(_zag_arg(9));
    if (denied_root.ok != 0 || denied_root.code != (0 - 13)) { return 6; }
    let regular_root: fs.LinuxFsDirectoryResult =
        fs.linux_fs_directory_open(_zag_arg(10));
    if (regular_root.ok != 0 ||
        regular_root.code != fs.linux_fs_status_unsupported_kind()) { return 7; }

    if (test_list_code(_zag_arg(5), fs.linux_fs_status_symlink(), 3, memory) == 0) {
        return 8;
    }
    if (test_list_code(_zag_arg(6), fs.linux_fs_status_traversal(), 3, memory) == 0) {
        return 9;
    }
    if (test_list_code(_zag_arg(7), fs.linux_fs_status_limit(), 3, memory) == 0) {
        return 10;
    }
    if (test_read_code(_zag_arg(8), fs.linux_fs_status_limit(), memory) == 0) {
        return 11;
    }

    let opened: fs.LinuxFsDirectoryResult = fs.linux_fs_directory_open(_zag_arg(1));
    if (opened.ok == 0) { return 12; }
    let directory: fs.LinuxFsDirectory = fs.linux_fs_directory_take(&opened);
    let duplicate_take: fs.LinuxFsDirectory = fs.linux_fs_directory_take(&opened);
    if (duplicate_take.open != 0) { return 13; }
    let entries: *fs.LinuxFsEntry = test_prepare_entries(memory, 3);
    let scratch: *u8 = (memory as i64 + 4096) as *u8;
    let output: *u8 = (memory as i64 + 2048) as *u8;
    let listed: fs.LinuxFsListResult =
        fs.linux_fs_list_regular_children_bounded(
            &directory, entries, 3, scratch, 4096, 8
        );
    if (listed.ok == 0 || listed.count != 3 ||
        @strEq(entries[0].name[0..entries[0].name_length], "a.txt") == 0 ||
        @strEq(entries[1].name[0..entries[1].name_length], "b.txt") == 0 ||
        @strEq(entries[2].name[0..entries[2].name_length], "c.txt") == 0) {
        return 14;
    }
    let invalid_list: fs.LinuxFsListResult =
        fs.linux_fs_list_regular_children_bounded(
            &directory, entries, 3, null as *u8, 4096, 8
        );
    if (invalid_list.ok != 0 ||
        invalid_list.code != fs.linux_fs_status_invalid_argument()) { return 15; }

    let read: fs.LinuxFsReadResult = fs.linux_fs_read_regular_at_prepared(
        directory.fd, entries[0].name, entries[0].name_length, 256,
        output, 64, 8
    );
    if (read.ok == 0 || read.bytes_read != 6 || read.checksum != 1610 ||
        read.read_calls < 2) { return 16; }
    let metadata: fs.LinuxFsMetadataResult = fs.linux_fs_stat_regular_at_prepared(
        directory.fd, entries[0].name, entries[0].name_length, 256, 64
    );
    if (metadata.ok == 0 || metadata.file_size != 6 || metadata.kind != 8) {
        return 35;
    }
    let metadata_limit: fs.LinuxFsMetadataResult =
        fs.linux_fs_stat_regular_at_prepared(
            directory.fd, entries[0].name, entries[0].name_length, 256, 5
        );
    if (metadata_limit.ok != 0 ||
        metadata_limit.code != fs.linux_fs_status_limit()) { return 36; }
    let metadata_bad_name: fs.LinuxFsMetadataResult =
        fs.linux_fs_stat_regular_at_prepared(
            directory.fd, entries[0].name, entries[0].name_length,
            entries[0].name_length, 64
        );
    if (metadata_bad_name.ok != 0 ||
        metadata_bad_name.code != fs.linux_fs_status_invalid_argument()) {
        return 37;
    }
    let write_name: *u8 = (memory as i64 + 2600) as *u8;
    test_copy_name(write_name, "write.txt");
    let write_input: *u8 = (memory as i64 + 2700) as *u8;
    test_copy_name(write_input, "updated!");
    let written: fs.LinuxFsWriteResult = fs.linux_fs_write_regular_at_prepared(
        directory.fd, write_name, 9, 10, write_input, 8, 64, 8
    );
    if (written.ok == 0 || written.bytes_written != 8 ||
        written.write_calls < 1) { return 27; }
    let written_read: fs.LinuxFsReadResult = fs.linux_fs_read_regular_at_prepared(
        directory.fd, write_name, 9, 10, output, 64, 8
    );
    if (written_read.ok == 0 || written_read.bytes_read != 8 ||
        @strEq(output[0..8], "updated!") == 0) { return 28; }
    let rewritten: fs.LinuxFsWriteResult = fs.linux_fs_write_regular_at_prepared(
        directory.fd, write_name, 9, 10, null as *u8, 0, 64, 8
    );
    if (rewritten.ok == 0 || rewritten.bytes_written != 0) { return 29; }
    let empty_read: fs.LinuxFsReadResult = fs.linux_fs_read_regular_at_prepared(
        directory.fd, write_name, 9, 10, output, 64, 8
    );
    if (empty_read.ok == 0 || empty_read.bytes_read != 0) { return 30; }
    if (fs.linux_fs_directory_flush(&directory) != 0) { return 39; }
    let write_limit: fs.LinuxFsWriteResult =
        fs.linux_fs_write_regular_at_prepared(
            directory.fd, write_name, 9, 10, write_input, 8, 7, 8
        );
    if (write_limit.ok != 0 ||
        write_limit.code != fs.linux_fs_status_invalid_argument()) { return 42; }
    let write_after_limit: fs.LinuxFsWriteResult =
        fs.linux_fs_write_regular_at_prepared(
            directory.fd, write_name, 9, 10, write_input, 8, 64, 8
        );
    if (write_after_limit.ok == 0 || write_after_limit.bytes_written != 8) {
        return 43;
    }
    let bad_input: fs.LinuxFsWriteResult = fs.linux_fs_write_regular_at_prepared(
        directory.fd, write_name, 9, 10, null as *u8, 1, 64, 8
    );
    if (bad_input.ok != 0 || bad_input.code != fs.linux_fs_status_invalid_argument()) {
        return 31;
    }
    test_copy_name(write_name, "../a.txt");
    let traversal_write: fs.LinuxFsWriteResult =
        fs.linux_fs_write_regular_at_prepared(
            directory.fd, write_name, 8, 9, write_input, 8, 64, 8
        );
    if (traversal_write.ok != 0 ||
        traversal_write.code != fs.linux_fs_status_invalid_argument()) {
        return 35;
    }
    test_copy_name(write_name, "write.txt");
    let oversized: fs.LinuxFsWriteResult =
        fs.linux_fs_write_regular_at_prepared(
            directory.fd, write_name, 9, 10, write_input, 8, 4, 8
        );
    if (oversized.ok != 0 ||
        oversized.code != fs.linux_fs_status_invalid_argument()) {
        return 36;
    }
    let symlink_opened: fs.LinuxFsDirectoryResult =
        fs.linux_fs_directory_open(_zag_arg(5));
    if (symlink_opened.ok == 0) { return 32; }
    let symlink_directory: fs.LinuxFsDirectory =
        fs.linux_fs_directory_take(&symlink_opened);
    let symlink_write: fs.LinuxFsWriteResult = fs.linux_fs_write_regular_at_prepared(
        symlink_directory.fd, entries[2].name, entries[2].name_length, 256,
        write_input, 8, 64, 8
    );
    if (symlink_write.ok != 0) { return 33; }
    let symlink_metadata: fs.LinuxFsMetadataResult =
        fs.linux_fs_stat_regular_at_prepared(
            symlink_directory.fd, entries[2].name, entries[2].name_length,
            256, 64
        );
    if (symlink_metadata.ok != 0) { return 38; }
    if (fs.linux_fs_directory_close(&symlink_directory) != 0) { return 34; }
    let nested_opened: fs.LinuxFsDirectoryResult =
        fs.linux_fs_directory_open(_zag_arg(6));
    if (nested_opened.ok == 0) { return 37; }
    let nested_directory: fs.LinuxFsDirectory =
        fs.linux_fs_directory_take(&nested_opened);
    test_copy_name(write_name, "child");
    let nonregular_write: fs.LinuxFsWriteResult =
        fs.linux_fs_write_regular_at_prepared(
            nested_directory.fd, write_name, 5, 10, write_input, 8, 64, 8
        );
    if (nonregular_write.ok != 0) { return 38; }
    if (fs.linux_fs_directory_close(&nested_directory) != 0) { return 39; }
    test_copy_name(write_name, "write.txt");
    let prepared: *u8 = (memory as i64 + 1800) as *u8;
    test_copy_name(prepared, "missing.txt");
    let missing_file: fs.LinuxFsReadResult =
        fs.linux_fs_read_regular_at_prepared(
            directory.fd, prepared, 11, 12, output, 64, 8
        );
    if (missing_file.ok != 0 || missing_file.code != (0 - 2)) { return 17; }
    test_copy_name(prepared, "../a.txt");
    let traversal_file: fs.LinuxFsReadResult =
        fs.linux_fs_read_regular_at_prepared(
            directory.fd, prepared, 8, 9, output, 64, 8
        );
    if (traversal_file.ok != 0 ||
        traversal_file.code != fs.linux_fs_status_invalid_argument()) { return 18; }
    let short_capacity: fs.LinuxFsReadResult =
        fs.linux_fs_read_regular_at_prepared(
            directory.fd, entries[0].name, entries[0].name_length,
            entries[0].name_length, output, 64, 8
        );
    if (short_capacity.ok != 0 ||
        short_capacity.code != fs.linux_fs_status_invalid_argument()) { return 19; }

    let saved_fd: i64 = directory.fd;
    if (fs.linux_fs_descriptor_is_open(saved_fd) == 0 ||
        fs.linux_fs_directory_close(&directory) != 0 ||
        fs.linux_fs_descriptor_is_open(saved_fd) != 0 ||
        fs.linux_fs_directory_close(&directory) !=
            fs.linux_fs_status_invalid_state()) { return 20; }
    let closed_list: fs.LinuxFsListResult =
        fs.linux_fs_list_regular_children_bounded(
            &directory, entries, 3, scratch, 4096, 8
        );
    if (closed_list.ok != 0 ||
        closed_list.code != fs.linux_fs_status_invalid_state()) { return 21; }
    let closed_read: fs.LinuxFsReadResult =
        fs.linux_fs_read_regular_at_prepared(
            saved_fd, entries[0].name, entries[0].name_length, 256,
            output, 64, 8
        );
    if (closed_read.ok != 0 || closed_read.code != (0 - 9)) { return 22; }
    let closed_write: fs.LinuxFsWriteResult =
        fs.linux_fs_write_regular_at_prepared(
            saved_fd, write_name, 9, 10, write_input, 8, 64, 8
        );
    if (closed_write.ok != 0 || closed_write.code != (0 - 9)) { return 40; }
    if (fs.linux_fs_directory_flush(&directory) !=
        fs.linux_fs_status_invalid_state()) { return 41; }

    if (_zag_raw_syscall(11, memory as i64, 8192, 0, 0, 0, 0) != 0) {
        return 23;
    }
    if (_zag_allocator_live_bytes() != allocator_baseline) { return 24; }
    return 0;
}
