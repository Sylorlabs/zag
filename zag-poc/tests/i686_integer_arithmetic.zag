fn main() i32 {
    let product:i32 = -7 * 9;
    let quotient:i32 = product / 5;
    let remainder:i32 = product % 5;
    let wrapped:i32 = -2147483648 / -1;
    let wrapped_remainder:i32 = -2147483648 % -1;
    if (quotient != -12) { return 1; }
    if (remainder != -3) { return 2; }
    if (wrapped != -2147483648) { return 3; }
    if (wrapped_remainder != 0) { return 4; }
    return 42;
}
