// Callee-side witness. Parameter field reads must normalize the inbound cdecl
// words, local field initialization must normalize each spill slot, and the
// hidden-sret copy must publish normalized full words.
struct NarrowPacket {
    signed8:i8,
    unsigned8:u8,
    signed16:i16,
    unsigned16:u16,
    enabled:bool,
}

pub fn transform_narrow_packet(packet:NarrowPacket) NarrowPacket {
    let result:NarrowPacket=NarrowPacket{
        .signed8=packet.signed8+(1 as i8),
        .unsigned8=packet.unsigned8+(1 as u8),
        .signed16=packet.signed16+(1 as i16),
        .unsigned16=packet.unsigned16+(1 as u16),
        .enabled=packet.enabled,
    };
    return result;
}
