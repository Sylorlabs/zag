@import("../selfhost/std/script_map.zag") as m
extern fn _zag_script_context_init(limit:i64, capabilities:i64, execution_policy:i64) *opaque
extern fn _zag_script_context_shutdown(context:*opaque) void
extern fn _zag_script_alloc_used(context:*opaque) i64

fn has(map: m.ScriptMap[i64], key: []u8, expected: i64) bool {
    unsafe {
        let result: m.ScriptMapLookup[i64] = m.script_map_get[i64](map, key);
        if (!result.found || result.error != m.ScriptMapError.none) { return false; }
        return result.value.* == expected;
    }
}

fn exercise(policy: i64) i32 {
    unsafe {
        let context: *opaque = _zag_script_context_init(65536, 7, policy);
        if (context == null as *opaque) { return 1; }
        let map: m.ScriptMap[i64] = m.script_map_new[i64](context, 0);
        if (map.error != m.ScriptMapError.none || m.script_map_len[i64](map) != 0) { return 2; }
        // These keys all collide modulo the initial 8 slots.
        let put_error: m.ScriptMapError = m.script_map_put[i64](&map, "a", 0);
        if (put_error != m.ScriptMapError.none) { return 50 + put_error as i32; }
        if (m.script_map_put[i64](&map, "i", 2) != m.ScriptMapError.none) { return 60; }
        if (m.script_map_put[i64](&map, "q", 3) != m.ScriptMapError.none) { return 61; }
        if (m.script_map_put[i64](&map, "y", 4) != m.ScriptMapError.none) { return 62; }
        let used: i64 = _zag_script_alloc_used(context);
        if (m.script_map_put[i64](&map, "i", 22) != m.ScriptMapError.none ||
            _zag_script_alloc_used(context) != used || map.len != 4) { return 4; }
        if (!has(map, "a", 0) || !has(map, "i", 22) || !has(map, "q", 3) || !has(map, "y", 4)) { return 5; }
        let missing: m.ScriptMapLookup[i64] = m.script_map_get[i64](map, "absent");
        if (missing.found || missing.error != m.ScriptMapError.none || missing.value != null as *i64) { return 6; }
        // Fifth entry forces growth; old collision chains must survive.
        if (m.script_map_put[i64](&map, "", 5) != m.ScriptMapError.none || map.cap != 8) { return 7; }
        if (!has(map, "", 5) || !has(map, "a", 0) || !has(map, "i", 22) || !has(map, "q", 3) || !has(map, "y", 4)) { return 8; }
        let first: m.ScriptMapLookup[i64] = m.script_map_at[i64](map, 0);
        let second: m.ScriptMapLookup[i64] = m.script_map_at[i64](map, 1);
        if (!first.found || !@strEq(first.key, "a") || !@strEq(second.key, "i") || second.value.* != 22) { return 9; }
        if (m.script_map_at[i64](map, -1).found || m.script_map_at[i64](map, map.len).found) { return 10; }
        // Mutable key input is copied, including embedded NUL and high bytes.
        let input: *u8 = _zag_script_alloc(context, 3) as *u8;
        input[0] = 65; input[1] = 0; input[2] = 255;
        if (m.script_map_put[i64](&map, input[0..3], 77) != m.ScriptMapError.none) { return 11; }
        input[0] = 66;
        let copied: m.ScriptMapLookup[i64] = m.script_map_at[i64](map, 5);
        if (copied.key.len != 3 || copied.key[0] != 65 || copied.key[1] != 0 || copied.key[2] != 255 || copied.value.* != 77) { return 12; }
        if (m.script_map_get[i64](map, input[0..3]).found) { return 13; }
        // Many entries exercise repeated growth, wraparound and insertion order.
        let i: i32 = 0;
        while (i < 100) {
            input[0] = 120; input[1] = i as u8; input[2] = 33;
            if (m.script_map_put[i64](&map, input[0..3], i as i64) != m.ScriptMapError.none) { return 14; }
            i = i + 1;
        }
        i = 0;
        while (i < 100) {
            input[0] = 120; input[1] = i as u8; input[2] = 33;
            if (!has(map, input[0..3], i as i64)) { return 15; }
            let item: m.ScriptMapLookup[i64] = m.script_map_at[i64](map, i + 6);
            if (!item.found || !@strEq(item.key, input[0..3]) || item.value.* != i as i64) { return 16; }
            i = i + 1;
        }
        if (!has(map, "a", 0) || !has(map, "i", 22) || map.len != 106) { return 17; }
        _zag_script_context_shutdown(context);
    }
    return 0;
}

fn budgets(policy: i64, overhead: i64) i32 {
    unsafe {
        let table: i64 = m.script_map_storage_bytes[i64](4);
        let growth: i64 = m.script_map_storage_bytes[i64](8);
        let context: *opaque = _zag_script_context_init(table + overhead - 1, 7, policy);
        let failed: m.ScriptMap[i64] = m.script_map_new[i64](context, 4);
        if (failed.error != m.ScriptMapError.allocation_failed || _zag_script_alloc_used(context) != 0) { return 30; }
        if (m.script_map_put[i64](&failed, "a", 1) != m.ScriptMapError.invalid_state ||
            m.script_map_get[i64](failed, "a").error != m.ScriptMapError.invalid_state) { return 31; }
        _zag_script_context_shutdown(context);

        // Exactly enough for construction and one copied key.
        let key_context: *opaque = _zag_script_context_init(table + overhead + 1 + overhead, 7, policy);
        let map: m.ScriptMap[i64] = m.script_map_new[i64](key_context, 4);
        if (m.script_map_put[i64](&map, "a", 0) != m.ScriptMapError.none) { return 32; }
        let used: i64 = _zag_script_alloc_used(key_context);
        if (used != table + overhead + 1 + overhead) { return 33; }
        if (m.script_map_put[i64](&map, "b", 2) != m.ScriptMapError.allocation_failed ||
            map.len != 1 || _zag_script_alloc_used(key_context) != used || !has(map, "a", 0)) { return 34; }
        if (m.script_map_put[i64](&map, "a", 9) != m.ScriptMapError.none || !has(map, "a", 9) ||
            _zag_script_alloc_used(key_context) != used) { return 35; }
        _zag_script_context_shutdown(key_context);

        // One byte short of the combined growth+key request: no partial charge.
        let initial: i64 = table + overhead + 4 * (1 + overhead);
        let short_context: *opaque = _zag_script_context_init(initial + growth + 1 + overhead - 1, 7, policy);
        let short_map: m.ScriptMap[i64] = m.script_map_new[i64](short_context, 4);
        if (m.script_map_put[i64](&short_map, "a", 1) != m.ScriptMapError.none ||
            m.script_map_put[i64](&short_map, "i", 2) != m.ScriptMapError.none ||
            m.script_map_put[i64](&short_map, "q", 3) != m.ScriptMapError.none ||
            m.script_map_put[i64](&short_map, "y", 4) != m.ScriptMapError.none) { return 36; }
        if (_zag_script_alloc_used(short_context) != initial) { return 37; }
        if (m.script_map_put[i64](&short_map, "z", 5) != m.ScriptMapError.allocation_failed ||
            short_map.len != 4 || short_map.cap != 4 || _zag_script_alloc_used(short_context) != initial || !has(short_map, "q", 3)) { return 38; }
        _zag_script_context_shutdown(short_context);
        let exact_context: *opaque = _zag_script_context_init(initial + growth + 1 + overhead, 7, policy);
        let exact_map: m.ScriptMap[i64] = m.script_map_new[i64](exact_context, 4);
        if (m.script_map_put[i64](&exact_map, "a", 1) != m.ScriptMapError.none ||
            m.script_map_put[i64](&exact_map, "i", 2) != m.ScriptMapError.none ||
            m.script_map_put[i64](&exact_map, "q", 3) != m.ScriptMapError.none ||
            m.script_map_put[i64](&exact_map, "y", 4) != m.ScriptMapError.none ||
            m.script_map_put[i64](&exact_map, "z", 5) != m.ScriptMapError.none) { return 39; }
        if (_zag_script_alloc_used(exact_context) != initial + growth + 1 + overhead || !has(exact_map, "z", 5)) { return 40; }
        _zag_script_context_shutdown(exact_context);
    }
    return 0;
}

struct MapTestValue {
    count: i64,
    text: []u8,
}

fn value_types() i32 {
    unsafe {
        let context: *opaque = _zag_script_context_init(4096, 7, 16843009);
        let flags: m.ScriptMap[bool] = m.script_map_new[bool](context, 4);
        if (m.script_map_put[bool](&flags, "no", false) != m.ScriptMapError.none) { return 70; }
        let flag: m.ScriptMapLookup[bool] = m.script_map_get[bool](flags, "no");
        if (!flag.found || flag.value.*) { return 71; }
        let text: m.ScriptMap[[]u8] = m.script_map_new[[]u8](context, 4);
        if (m.script_map_put[[]u8](&text, "empty", "") != m.ScriptMapError.none) { return 72; }
        let empty: m.ScriptMapLookup[[]u8] = m.script_map_get[[]u8](text, "empty");
        if (!empty.found || !@strEq(empty.value.*, "")) { return 73; }
        let records: m.ScriptMap[MapTestValue] = m.script_map_new[MapTestValue](context, 4);
        let value: MapTestValue = MapTestValue{ .count = 42, .text = "record" };
        if (m.script_map_put[MapTestValue](&records, "a", value) != m.ScriptMapError.none ||
            m.script_map_put[MapTestValue](&records, "b", value) != m.ScriptMapError.none ||
            m.script_map_put[MapTestValue](&records, "c", value) != m.ScriptMapError.none ||
            m.script_map_put[MapTestValue](&records, "d", value) != m.ScriptMapError.none ||
            m.script_map_put[MapTestValue](&records, "e", value) != m.ScriptMapError.none) { return 74; }
        let item: m.ScriptMapLookup[MapTestValue] = m.script_map_get[MapTestValue](records, "a");
        if (!item.found || item.value.*.count != 42 || !@strEq(item.value.*.text, "record")) { return 75; }
        _zag_script_context_shutdown(context);
    }
    return 0;
}

fn invalid_inputs() i32 {
    unsafe {
        let context: *opaque = _zag_script_context_init(4096, 7, 16843009);
        let invalid: m.ScriptMap[i64] = m.script_map_new[i64](context, -1);
        if (invalid.error != m.ScriptMapError.capacity_limit) { return 80; }
        let huge: m.ScriptMap[i64] = m.script_map_new[i64](context, 2147483647);
        if (huge.error != m.ScriptMapError.capacity_limit || _zag_script_alloc_used(context) != 0) { return 81; }
        let map: m.ScriptMap[i64] = m.script_map_new[i64](context, 4);
        let used: i64 = _zag_script_alloc_used(context);
        let bad: []u8 = (null as *u8)[0..1];
        if (m.script_map_put[i64](&map, bad, 0) != m.ScriptMapError.invalid_key ||
            m.script_map_get[i64](map, bad).error != m.ScriptMapError.invalid_key ||
            map.len != 0 || _zag_script_alloc_used(context) != used) { return 82; }
        // Replacing the empty key does not recopy or reallocate it.
        if (m.script_map_put[i64](&map, "", 1) != m.ScriptMapError.none ||
            m.script_map_put[i64](&map, "", 2) != m.ScriptMapError.none ||
            map.len != 1 || !has(map, "", 2)) { return 83; }
        map.slots[1] = 4294967296;
        if (m.script_map_get[i64](map, "a").error != m.ScriptMapError.invalid_state) { return 84; }
        map.len = map.cap + 1;
        if (m.script_map_put[i64](&map, "b", 0) != m.ScriptMapError.invalid_state ||
            m.script_map_at[i64](map, 0).error != m.ScriptMapError.invalid_state) { return 85; }
        _zag_script_context_shutdown(context);
    }
    return 0;
}

fn main() i32 {
    let status: i32 = exercise(16843009);
    if (status != 0) { return status; }
    status = exercise(16843010);
    if (status != 0) { return status; }
    status = budgets(16843009, 0);
    if (status != 0) { return status; }
    status = budgets(16843010, 16);
    if (status != 0) { return status; }
    status = value_types();
    if (status != 0) { return status; }
    return invalid_inputs();
}
