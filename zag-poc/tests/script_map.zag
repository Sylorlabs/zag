script;

let values = map();
if (map_len(values) != 0 || map_has(values, 1)) { return 1; }
if (map_put(values, 1, 10) != 0 || map_put(values, 2, 20) != 0) { return 2; }
if (!map_has(values, 1) || !map_has(values, 2) || map_has(values, 3)) { return 3; }
if (map_get(values, 1) != 10 || map_get(values, 2) != 20 || map_len(values) != 2) { return 4; }
if (map_put(values, 1, 11) != 0 || map_get(values, 1) != 11 || map_len(values) != 2) { return 5; }
let collisions = map();
if (map_put(collisions, 1, 101) != 0 ||
    map_put(collisions, 9, 109) != 0 ||
    map_put(collisions, 17, 117) != 0) { return 6; }
if (map_del(collisions, 9) != 0 || map_len(collisions) != 2 ||
    map_has(collisions, 9) || !map_has(collisions, 17)) { return 7; }
if (map_del(collisions, 9) == 0 ||
    map_put(collisions, 25, 125) != 0 || map_len(collisions) != 3 ||
    !map_has(collisions, 25) || map_get(collisions, 17) != 117) { return 8; }
let i: i32 = 3;
while (i < 40) {
    if (map_put(values, i, i + 100) != 0) { return 9; }
    i = i + 1;
}
if (map_del(values, 9) != 0 || map_has(values, 9) || map_len(values) != 38) { return 10; }
let j: i32 = 100;
while (j < 150) {
    if (map_put(values, j, j + 1000) != 0) { return 11; }
    j = j + 1;
}
if (map_has(values, 9) || !map_has(values, 10) || map_get(values, 39) != 139 ||
    map_get(values, 149) != 1149 || map_len(values) != 88 || map_failed(values) != 0) { return 12; }

// Clear scrubs every retained slot, keeps the original ScriptContext-backed
// arrays/capacity, and permits deterministic reuse after tombstones and growth.
let cleared = map();
if (map_put(cleared, 1, 101) != 0 || map_put(cleared, 9, 109) != 0 ||
    map_del(cleared, 9) != 0) { return 13; }
let old_keys: *i32 = cleared.keys;
let old_values: *i32 = cleared.values;
let old_used: *u8 = cleared.used;
let old_cap: i32 = cleared.cap;
let slot: i32 = 0;
while (slot < old_cap) {
    old_keys[slot] = 1234;
    old_values[slot] = 5678;
    slot = slot + 1;
}
if (map_clear(cleared) != 0 || map_len(cleared) != 0 ||
    map_failed(cleared) != 0 || cleared.cap != old_cap ||
    cleared.keys != old_keys || cleared.values != old_values ||
    cleared.used != old_used) { return 14; }
slot = 0;
while (slot < old_cap) {
    if (old_keys[slot] != 0 || old_values[slot] != 0 || old_used[slot] != 0) { return 15; }
    slot = slot + 1;
}
if (map_put(cleared, 42, 4242) != 0 || map_len(cleared) != 1 ||
    map_get(cleared, 42) != 4242) { return 16; }

let forged = map();
forged.keys[0] = 77;
forged.values[0] = 88;
forged.cap = 0;
if (map_clear(forged) != 1 || forged.failed != 1 ||
    forged.keys[0] != 77 || forged.values[0] != 88) { return 17; }

