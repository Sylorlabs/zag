// libm through the C ABI on macos-arm64: log/exp (and friends) have no
// AArch64 hardware instruction, so they resolve to libSystem through the
// ordinary dyld bind path (requires --dynamic). The whitelist accepts the
// one-f64-argument, f64-return ABI shape. Returns the first failing case.
extern fn log(x: f64) f64;
extern fn exp(x: f64) f64;

fn main() i32 {
    let e: f64 = exp(1.0);
    if (e < 2.71828182845904 || e > 2.71828182845905) { return 1; }
    let l: f64 = log(2.718281828459045);
    if (l < 0.9999999999 || l > 1.0000000001) { return 2; }
    let r: f64 = log(exp(2.0));
    if (r < 1.9999999999 || r > 2.0000000001) { return 3; }
    if (log(1.0) != 0.0) { return 4; }
    if (exp(0.0) != 1.0) { return 5; }
    return 42;
}
