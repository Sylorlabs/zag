// Cancellation-aware waits over the bounded MPMC i64 queue.

@import("std:channel_mpmc_i64") as base
@import("std:cancel_token_i64") as cancel
@import("std:channel_mpmc_i64_cancel") as cancellable

fn main() i32 {
    let word: i64 = 0;
    let token: cancel.CancelTokenI64 = cancel.cancel_token_i64_invalid();
    if (cancel.cancel_token_i64_init(&token, (&word) as *i64) != 0) { return 1; }
    let one: base.ChannelMpmcI64Result = base.channel_mpmc_i64_create(1);
    if (one.ok != 0 || one.code != base.channel_mpmc_i64_status_invalid_argument()) {
        return 2;
    }
    let created: base.ChannelMpmcI64Result = base.channel_mpmc_i64_create(2);
    if (created.ok != 1) { return 2; }
    let channel: base.ChannelMpmcI64 = base.channel_mpmc_i64_take(&created);
    if (base.channel_mpmc_i64_try_send(&channel, 7).ok != 1) { return 3; }
    if (cancel.cancel_token_i64_request(&token) != 0) { return 4; }
    let cancelled_send: cancellable.ChannelMpmcI64CancelSendResult =
        cancellable.channel_mpmc_i64_cancel_send_wait(&channel, &token, 99, 1000);
    if (cancelled_send.ok != 0 ||
        cancelled_send.code != cancellable.channel_mpmc_i64_cancel_status_cancelled()) {
        return 5;
    }
    let cancelled_receive: cancellable.ChannelMpmcI64CancelReceiveResult =
        cancellable.channel_mpmc_i64_cancel_receive_wait(&channel, &token, 1000);
    let retained: base.ChannelMpmcI64OpResult =
        base.channel_mpmc_i64_try_receive(&channel);
    if (cancelled_receive.ok != 0 ||
        cancelled_receive.code != cancellable.channel_mpmc_i64_cancel_status_cancelled() ||
        retained.ok != 1 || retained.value != 7) { return 6; }
    if (cancel.cancel_token_i64_close(&token) != 0) { return 7; }

    let timeout_word: i64 = 0;
    let timeout_token: cancel.CancelTokenI64 = cancel.cancel_token_i64_invalid();
    if (cancel.cancel_token_i64_init(&timeout_token, (&timeout_word) as *i64) != 0) {
        return 8;
    }
    let timed_receive: cancellable.ChannelMpmcI64CancelReceiveResult =
        cancellable.channel_mpmc_i64_cancel_receive_wait(&channel, &timeout_token, 1000);
    if (timed_receive.ok != 0 ||
        timed_receive.code != base.channel_mpmc_i64_status_empty() ||
        timed_receive.elapsed_ms < 850 || timed_receive.elapsed_ms > 2500) { return 10; }
    if (base.channel_mpmc_i64_try_send(&channel, 8).ok != 1 ||
        base.channel_mpmc_i64_try_send(&channel, 9).ok != 1) { return 11; }
    let timed_send: cancellable.ChannelMpmcI64CancelSendResult =
        cancellable.channel_mpmc_i64_cancel_send_wait(&channel, &timeout_token, 10, 1000);
    if (timed_send.ok != 0 ||
        timed_send.code != base.channel_mpmc_i64_status_full() ||
        timed_send.elapsed_ms < 850 || timed_send.elapsed_ms > 2500) { return 12; }

    let invalid_timeout: cancellable.ChannelMpmcI64CancelReceiveResult =
        cancellable.channel_mpmc_i64_cancel_receive_wait(&channel, &timeout_token, 5001);
    if (invalid_timeout.ok != 0 ||
        invalid_timeout.code != cancellable.channel_mpmc_i64_cancel_status_invalid_argument()) {
        return 13;
    }
    if (cancel.cancel_token_i64_close(&timeout_token) != 0 ||
        base.channel_mpmc_i64_close(&channel) != 0) { return 14; }
    _zag_println("mpmc-cancel preflight=1 send=cancelled receive=cancelled timeout=honored");
    return 0;
}
