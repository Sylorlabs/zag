script;

global let map_test_counter: i32;
fn map_test_next() i32 {
    map_test_counter = map_test_counter + 1;
    return map_test_counter;
}

let values = {"a": 0, "i": 2, "q": 3, "a": 7, "y": 4};
if (script_map_len[i32](values) != 4) { return 1; }
let duplicate: ScriptMapLookup[i32] = script_map_get[i32](values, "a");
if (!duplicate.found || duplicate.error != ScriptMapError.none || duplicate.value.* != 7) { return 2; }
let first: ScriptMapLookup[i32] = script_map_at[i32](values, 0);
if (!first.found || !@strEq(first.key, "a")) { return 3; }
let missing: ScriptMapLookup[i32] = script_map_get[i32](values, "missing");
if (missing.found || missing.error != ScriptMapError.none) { return 4; }
let zeroes = {"zero": 0};
let zero: ScriptMapLookup[i32] = script_map_get[i32](zeroes, "zero");
if (!zero.found || zero.value.* != 0) { return 5; }
let empty: ScriptMap[i32] = {};
if (script_map_len[i32](empty) != 0) { return 6; }
if (script_map_put[i32](&empty, "first", 1) != ScriptMapError.none) { return 7; }
let flags = {"no": false, "yes": true};
let flag: ScriptMapLookup[bool] = script_map_get[bool](flags, "no");
if (!flag.found || flag.value.*) { return 8; }
let texts = {"empty": "", "name": "Zag"};
let name: ScriptMapLookup[[]u8] = script_map_get[[]u8](texts, "name");
if (!name.found || !@strEq(name.value.*, "Zag")) { return 9; }
// Nested checked-insert lowering must preserve exactly-once source order.
let ordered = {"x": map_test_next(), "y": map_test_next(), "x": map_test_next()};
if (map_test_counter != 3 || ordered["x"] != 3 || ordered["y"] != 2) { return 10; }
if (values["a"] != 7) { return 11; }
return 0;
