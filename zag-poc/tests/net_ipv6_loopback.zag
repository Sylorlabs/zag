@import("std:list")
@import("std:net_ipv6") as net6

extern fn _zag_allocator_live_bytes() i64

fn bytes_equal(left:[]u8,right:[]u8)i32 {
    if(left.len!=right.len){return 0;}
    let i:i32=0;while(i<left.len){if(left[i]!=right[i]){return 0;}i=i+1;}
    return 1;
}

fn main() i32 {
    let baseline:i64=_zag_allocator_live_bytes();
    let loopback:net6.NetIpv6Endpoint=net6.net6_ipv6_endpoint(0,1,0,0);
    let bad:net6.NetIpv6TcpListenerResult=net6.net6_listen(
        net6.net6_ipv6_endpoint(0,1,0-1,0),8,1000);
    if(bad.ok!=0||bad.value.open!=0||bad.code!=net6.net6_status_invalid_argument()){
        return 1;
    }

    let listener_result:net6.NetIpv6TcpListenerResult=net6.net6_listen(loopback,8,1000);
    if(listener_result.ok!=1||listener_result.value.open!=1||
       listener_result.value.local.high!=0||listener_result.value.local.low!=1||
       listener_result.value.local.port<1||listener_result.value.local.port>65535){return 2;}
    let listener:net6.NetIpv6TcpListener=net6.net6_listener_take(&listener_result);
    if(listener.open!=1||listener_result.value.open!=0){return 3;}

    let client_result:net6.NetIpv6TcpStreamResult=net6.net6_connect(listener.local,1000);
    if(client_result.ok!=1||client_result.value.open!=1){return 4;}
    let client:net6.NetIpv6TcpStream=net6.net6_stream_take(&client_result);
    let server_result:net6.NetIpv6TcpStreamResult=net6.net6_accept(&listener,1000);
    if(server_result.ok!=1||server_result.value.open!=1){return 5;}
    let server:net6.NetIpv6TcpStream=net6.net6_stream_take(&server_result);

    let request:[]u8="ipv6-tcp-request";
    let send:net6.NetIpv6IoResult=net6.net6_send(&client,request,8);
    let request_buffer:ArrayList[u8]=make[u8](request.len);
    let receive:net6.NetIpv6IoResult=net6.net6_recv(
        &server,request_buffer.data[0..request.len],request.len,8);
    if(send.ok!=1||send.transferred!=request.len||receive.ok!=1||
       receive.transferred!=request.len||bytes_equal(
           request_buffer.data[0..request.len],request)==0){return 6;}

    let response:[]u8="ipv6-tcp-response";
    let response_send:net6.NetIpv6IoResult=net6.net6_send(&server,response,8);
    let response_buffer:ArrayList[u8]=make[u8](response.len);
    let response_receive:net6.NetIpv6IoResult=net6.net6_recv(
        &client,response_buffer.data[0..response.len],response.len,8);
    if(response_send.ok!=1||response_receive.ok!=1||
       bytes_equal(response_buffer.data[0..response.len],response)==0){return 7;}
    if(net6.net6_stream_close(&server)!=net6.net6_status_ok()||
       net6.net6_stream_close(&server)!=net6.net6_status_invalid_state()||
       net6.net6_stream_close(&client)!=net6.net6_status_ok()||
       net6.net6_listener_close(&listener)!=net6.net6_status_ok()||
       net6.net6_listener_close(&listener)!=net6.net6_status_invalid_state()){return 8;}

    let udp_a_result:net6.NetIpv6UdpSocketResult=net6.net6_udp_bind(loopback,1000);
    let udp_b_result:net6.NetIpv6UdpSocketResult=net6.net6_udp_bind(loopback,1000);
    if(udp_a_result.ok!=1||udp_b_result.ok!=1||
       udp_a_result.value.local.port<1||udp_b_result.value.local.port<1||
       udp_a_result.value.local.port==udp_b_result.value.local.port){return 9;}
    let udp_a:net6.NetIpv6UdpSocket=net6.net6_udp_take(&udp_a_result);
    let udp_b:net6.NetIpv6UdpSocket=net6.net6_udp_take(&udp_b_result);

    let datagram:[]u8="ipv6-udp-datagram";
    let udp_send:net6.NetIpv6IoResult=net6.net6_udp_send(&udp_a,udp_b.local,datagram);
    let datagram_buffer:ArrayList[u8]=make[u8](64);
    let udp_receive:net6.NetIpv6UdpReceiveResult=net6.net6_udp_recv(
        &udp_b,datagram_buffer.data[0..64]);
    if(udp_send.ok!=1||udp_receive.ok!=1||udp_receive.transferred!=datagram.len||
       udp_receive.source.high!=0||udp_receive.source.low!=1||
       udp_receive.source.port!=udp_a.local.port||bytes_equal(
           datagram_buffer.data[0..datagram.len],datagram)==0){return 10;}

    let too_big:net6.NetIpv6IoResult=net6.net6_udp_send(
        &udp_a,udp_b.local,"0123456789");
    let tiny:ArrayList[u8]=make[u8](4);
    let trunc:net6.NetIpv6UdpReceiveResult=net6.net6_udp_recv(&udp_b,tiny.data[0..4]);
    if(too_big.ok!=1||trunc.ok!=0||trunc.code!=net6.net6_status_truncated()||
       trunc.transferred!=4){return 11;}
    if(net6.net6_udp_close(&udp_a)!=net6.net6_status_ok()||
       net6.net6_udp_close(&udp_a)!=net6.net6_status_invalid_state()||
       net6.net6_udp_close(&udp_b)!=net6.net6_status_ok()){return 12;}

    free[u8](&request_buffer);free[u8](&response_buffer);
    free[u8](&datagram_buffer);free[u8](&tiny);
    if(_zag_allocator_live_bytes()!=baseline){return 13;}
    return 0;
}
