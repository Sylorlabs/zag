@import("../selfhost/std/process.zag")

fn main() i32 {
    let denied: ProcessIsolationRunResult = process_run_bounded_with_isolation(
        "printf should-not-run", 1000, 64, ProcessIsolationRequirement.SecuritySandbox);
    if (denied.isolation.accepted != 0 || denied.isolation.sandboxed != 0 ||
        denied.isolation.status != ProcessIsolationStatus.Unsupported) { return 1; }
    if (process_result_state(denied.process) != process_state_isolation_unsupported() ||
        process_result_output(denied.process).len != 0) { return 2; }
    let allowed: ProcessIsolationRunResult = process_run_bounded_with_isolation(
        "printf supervised", 1000, 64, ProcessIsolationRequirement.SupervisionOnly);
    if (allowed.isolation.accepted != 1 || allowed.isolation.sandboxed != 0 ||
        allowed.isolation.status != ProcessIsolationStatus.NotRequested) { return 3; }
    if (process_result_state(allowed.process) != process_state_exited() ||
        !@strEq(process_result_output(allowed.process), "supervised")) { return 4; }
    let denied_only: ProcessIsolationRunResult = process_run_bounded_with_isolation(
        "printf should-not-run", 0, 0, ProcessIsolationRequirement.SecuritySandbox);
    if (process_result_state(denied_only.process) != process_state_isolation_unsupported()) { return 5; }
    _zag_println("process isolation: explicit sandbox refusal and supervision-only PASS");
    return 0;
}
