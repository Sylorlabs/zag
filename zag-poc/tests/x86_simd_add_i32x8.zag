// AVX2 i32x8 explicit SIMD contract.
fn main() i32 {
    unsafe {
        let lhs:*u8 = _zag_malloc(64) as *u8;
        let rhs:*u8 = _zag_malloc(64) as *u8;
        lhs[0]=1; rhs[0]=7;
        lhs[4]=2; rhs[4]=8;
        lhs[8]=3; rhs[8]=9;
        lhs[12]=4; rhs[12]=10;
        lhs[16]=5; rhs[16]=11;
        lhs[20]=6; rhs[20]=12;
        lhs[24]=7; rhs[24]=13;
        lhs[28]=8; rhs[28]=14;
        @simdAddI32x8(lhs as *mut i32, lhs as *const i32, rhs as *const i32);
        if (lhs[0] != 8) { return 1; }
        if (lhs[4] != 10) { return 2; }
        if (lhs[28] != 22) { return 3; }
        _zag_free(lhs);
        _zag_free(rhs);
        return 0;
    }
}
