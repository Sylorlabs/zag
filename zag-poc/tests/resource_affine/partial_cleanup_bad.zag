@import("std:list")

@resource
struct Frame {
    bytes: @owned(free) ArrayList[u8],
}

fn frame_make() Frame {
    return Frame{ .bytes = make[u8](4) };
}

fn frame_free(frame: @consumes *Frame) void {
    free[u8](&frame.*.bytes);
}

fn main() i32 {
    let frame: Frame = frame_make();
    if (frame.bytes.len == 0) {
        frame_free(&frame);
    }
    return 0;
}
