@import("std:list")

struct Wrapper { values: ArrayList[i32] }
struct Holder { item: Wrapper }

fn store_observation(out: @borrows_mut *Holder, value: Wrapper) void {
    out.*.item = value;
}

fn main() i32 {
    let owner: Wrapper = Wrapper{ .values = make[i32](1) };
    let holder: Holder = Holder{ .item = Wrapper{ .values = make[i32](1) } };
    store_observation(&holder, owner);
    return 0;
}
