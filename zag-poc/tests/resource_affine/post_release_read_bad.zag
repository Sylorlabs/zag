@import("std:list")

@resource
struct Frame {
    bytes: @owned(free) ArrayList[u8],
    revision: i32,
}

fn frame_make() Frame {
    return Frame{ .bytes = make[u8](4), .revision = 1 };
}

fn frame_free(frame: @consumes *Frame) void {
    free[u8](&frame.*.bytes);
}

fn main() i32 {
    let frame: Frame = frame_make();
    frame_free(&frame);
    return frame.revision;
}
