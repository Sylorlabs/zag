@import("std:list")

extern fn _zag_allocator_live_bytes() i64;

@resource
struct Frame {
    bytes: @owned(free) ArrayList[u8],
    tag: i32,
}

global let released_count: i32;
global let released_sum: i32;

fn frame_make(tag: i32) Frame {
    let bytes: ArrayList[u8] = make[u8](1);
    push[u8](&bytes, tag as u8);
    return Frame{ .bytes = bytes, .tag = tag };
}

fn frame_drop(frame: @consumes Frame) void {
    released_count = released_count + 1;
    released_sum = released_sum + frame.tag;
    free[u8](&frame.bytes);
}

fn main() i32 {
    let baseline: i64 = _zag_allocator_live_bytes();
    let dst: ArrayList[Frame] = make[Frame](1);
    let first: Frame = frame_make(3);
    push_move[Frame](&dst, first);

    let src: ArrayList[Frame] = make[Frame](1);
    let second: Frame = frame_make(5);
    push_move[Frame](&src, second);
    let third: Frame = frame_make(7);
    push_move[Frame](&src, third);

    move_all[Frame](&dst, &src);
    let status: i32 = 0;
    if (dst.len != 3 || dst.cap < 3 ||
        dst.data[0].tag != 3 || dst.data[1].tag != 5 || dst.data[2].tag != 7) {
        status = 1;
    }
    drain[Frame](&dst, frame_drop);
    if (released_count != 3 || released_sum != 15) { status = 2; }
    if (_zag_allocator_live_bytes() != baseline) { status = 3; }
    return status;
}
