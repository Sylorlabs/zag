@import("std:list")

@resource
struct Frame {
    bytes: @owned(free) ArrayList[u8],
}

fn frame_make() Frame {
    let bytes: ArrayList[u8] = make[u8](4);
    return Frame{ .bytes = bytes };
}

fn frame_drop(frame: @consumes Frame) void {
    free[u8](&frame.bytes);
}

fn main() i32 {
    let frames: ArrayList[Frame] = make[Frame](1);
    frames.data[0] = frame_make();
    frames.len = 1;
    drain[Frame](&frames, frame_drop);
    return frames.len;
}
