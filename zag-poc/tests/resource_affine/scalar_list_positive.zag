@import("std:list")

fn main() i32 {
    let values: ArrayList[i32] = make[i32](2);
    push[i32](&values, 10);
    push[i32](&values, 20);
    set[i32](&values, 0, 22);
    let first: i32 = get[i32](values, 0);
    let last: i32 = pop[i32](&values);
    let remaining: i32 = len[i32](values);
    free[i32](&values);
    if (first != 22 || last != 20 || remaining != 1) {
        return 1;
    }
    return 0;
}
