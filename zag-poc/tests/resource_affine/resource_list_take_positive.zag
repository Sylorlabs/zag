@import("std:list")

extern fn _zag_allocator_live_bytes() i64;

@resource
struct Frame {
    bytes: @owned(free) ArrayList[u8],
    tag: i32,
}

global let selected_tag: i32;

fn frame_drop(frame: @consumes Frame) void {
    free[u8](&frame.bytes);
}

fn frame_select(frame: @consumes Frame) void {
    selected_tag = frame.tag;
    free[u8](&frame.bytes);
}

fn main() i32 {
    let baseline: i64 = _zag_allocator_live_bytes();
    let frames: ArrayList[Frame] = ArrayList[Frame]{
        .data = _zag_malloc(@sizeOf[Frame]()) as *Frame,
        .len = 1,
        .cap = 1,
    };
    frames.data[0].bytes.data = _zag_malloc(32) as *u8;
    frames.data[0].bytes.len = 1;
    frames.data[0].bytes.cap = 4;
    frames.data[0].bytes.data[0] = 10;
    frames.data[0].tag = 10;
    take_with[Frame](&frames, 0, frame_select, frame_drop);
    if (selected_tag != 10) { return 1; }
    if (_zag_allocator_live_bytes() != baseline) { return 2; }
    return 0;
}
