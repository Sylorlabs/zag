@import("std:list")

@resource
struct Box[T] {
    values: @owned(free) ArrayList[T],
}

fn box_make[T]() Box[T] {
    return Box[T]{ .values = make[T](1) };
}

fn abandon_box[T](box: Box[T]) void {
    return;
}

fn main() i32 {
    let box: Box[i32] = box_make[i32]();
    abandon_box[i32](box);
    return 0;
}
