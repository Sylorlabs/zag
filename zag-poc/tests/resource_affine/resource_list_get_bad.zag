@import("std:list")

@resource
struct Frame {
    bytes: @owned(free) ArrayList[u8],
}

fn frame_free(frame: @consumes *Frame) void {
    free[u8](&frame.*.bytes);
}

fn main() i32 {
    let frames: ArrayList[Frame] = make[Frame](1);
    let copied: Frame = get[Frame](frames, 0);
    frame_free(&copied);
    free[Frame](&frames);
    return 0;
}
