@import("std:list")

@resource
struct Frame {
    bytes: @owned(free) ArrayList[u8],
}

fn frame_drop(frame: @consumes Frame) void {
    free[u8](&frame.bytes);
}

fn main() i32 {
    let frames: ArrayList[Frame] = make[Frame](1);
    let frame: Frame = Frame{ .bytes = make[u8](1) };
    push_move[Frame](&frames, frame);
    remove_with[Frame](&frames, 2, frame_drop);
    // The operation exits at runtime for this invalid index. Keep a modeled
    // cleanup after the call so the static proof still covers the non-exit
    // continuation; the executable never reaches it on the negative path.
    drain[Frame](&frames, frame_drop);
    return 0;
}
