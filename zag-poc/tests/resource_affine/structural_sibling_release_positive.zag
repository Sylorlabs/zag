@import("std:list")

struct Pair {
    left: ArrayList[i32],
    right: ArrayList[i32],
}

fn pair_make() Pair {
    let left: ArrayList[i32] = make[i32](1);
    let right: ArrayList[i32] = make[i32](1);
    push[i32](&left, 17);
    push[i32](&right, 25);
    return Pair{ .left = left, .right = right };
}

fn pair_free(value: @consumes *Pair) i32 {
    free[i32](&value.*.left);
    let count: i32 = value.*.right.len;
    let answer: i32 = get[i32](value.*.right, 0);
    free[i32](&value.*.right);
    return ((count != 1) || (answer != 25)) as i32;
}

fn main() i32 {
    let value: Pair = pair_make();
    return pair_free(&value);
}
