@import("std:list")

@resource
struct Frame {
    bytes: ArrayList[u8],
}

fn frame_free(frame: @consumes *Frame) void {
    free[u8](&frame.*.bytes);
}

fn main() i32 {
    let frames: ArrayList[Frame] = make[Frame](1);
    let borrowed: Frame = frames.data[0];
    frame_free(&borrowed);
    free[Frame](&frames);
    return 0;
}
