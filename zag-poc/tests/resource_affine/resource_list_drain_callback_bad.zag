@import("std:list")

@resource
struct Frame {
    bytes: @owned(free) ArrayList[u8],
}

// A resource-valued drain callback must state and prove the exact consuming
// element contract. Merely observing a Frame cannot dispose of drained data.
fn frame_observe(frame: Frame) void {
    return;
}

fn main() i32 {
    let frames: ArrayList[Frame] = make[Frame](1);
    drain[Frame](&frames, frame_observe);
    return 0;
}
