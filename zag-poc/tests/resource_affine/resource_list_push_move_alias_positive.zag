@import("std:list") as list

extern fn _zag_allocator_live_bytes() i64;

fn byte_list_drop(bytes: @consumes *list.ArrayList[u8]) void {
    list.free[u8](bytes);
}

@resource
struct Frame {
    bytes: @owned(byte_list_drop) list.ArrayList[u8],
}

fn frame_drop(frame: @consumes Frame) void {
    byte_list_drop(&frame.bytes);
}

fn main() i32 {
    let baseline: i64 = _zag_allocator_live_bytes();
    let frames: list.ArrayList[Frame] = list.make[Frame](1);
    let bytes: list.ArrayList[u8] = list.make[u8](2);
    let frame: Frame = Frame{ .bytes = bytes };
    list.push_move[Frame](&frames, frame);
    // Keep the affine list live through the check so every control-flow path
    // reaches the explicit element destructor below.  An early return here
    // would correctly be rejected: the compiler cannot assume this runtime
    // length comparison is constant, even though the positive witness expects
    // one element.
    let status: i32 = (frames.len != 1) as i32;
    list.drain[Frame](&frames, frame_drop);
    if (status != 0) { return status; }
    return (_zag_allocator_live_bytes() != baseline) as i32;
}
