@import("std:list")

@resource
struct Frame {
    bytes: @owned(free) ArrayList[u8],
    revision: i64,
}

struct LabelView {
    text: []u8,
    id: i64,
}

struct SurfaceSpec {
    title: []u8,
    subtitle: []u8,
}

fn surface_spec(
    title: @retained_by_return []u8,
    subtitle: @retained_by_return []u8,
) SurfaceSpec {
    return SurfaceSpec{
        .title = title,
        .subtitle = subtitle,
    };
}

fn inspect_surface(title: @borrows []u8, subtitle: @borrows []u8) i32 {
    let spec: SurfaceSpec = surface_spec(title, subtitle);
    return spec.title.len + spec.subtitle.len;
}

fn decorate_surface(title: @borrows []u8) i32 {
    let spec: SurfaceSpec = surface_spec(title, title);
    spec.subtitle = title;
    return spec.title.len + spec.subtitle.len;
}

fn frame_make(seed: u8) Frame {
    let bytes: ArrayList[u8] = make[u8](4);
    push[u8](&bytes, seed);
    return Frame{ .bytes = bytes, .revision = 1 };
}

fn frame_revision(frame: @borrows *Frame) i64 {
    return frame.*.revision + frame.*.bytes.len as i64;
}

fn frame_free(frame: @consumes *Frame) void {
    free[u8](&frame.*.bytes);
}

fn retained_views_end_before_owner() i32 {
    let owner: ArrayList[u8] = make[u8](8);
    push[u8](&owner, 90);
    let views: ArrayList[LabelView] = make[LabelView](2);
    push[LabelView](&views, LabelView{
        .text = owner.data[0..owner.len],
        .id = 7,
    });
    free[LabelView](&views);
    free[u8](&owner);
    return 0;
}

fn retained_result_ends_at_call_boundary() i32 {
    let title: ArrayList[u8] = make[u8](8);
    push[u8](&title, 90);
    let subtitle: ArrayList[u8] = make[u8](8);
    push[u8](&subtitle, 75);
    let measured: i32 = inspect_surface(
        title.data[0..title.len],
        subtitle.data[0..subtitle.len],
    ) + decorate_surface(title.data[0..title.len]);
    free[u8](&subtitle);
    free[u8](&title);
    if (measured != 4) {
        return 1;
    }
    return 0;
}

fn retained_result_ends_at_lexical_scope() i32 {
    let owner: ArrayList[u8] = make[u8](4);
    push[u8](&owner, 65);
    let measured: i32 = 0;
    if (owner.len > 0) {
        let spec: SurfaceSpec = surface_spec(
            owner.data[0..owner.len],
            owner.data[0..owner.len],
        );
        measured = spec.title.len + spec.subtitle.len;
    }
    free[u8](&owner);
    return (measured != 2) as i32;
}

fn owner_move_after_views_end() i32 {
    let owner: ArrayList[u8] = make[u8](4);
    push[u8](&owner, 66);
    let views: ArrayList[LabelView] = make[LabelView](1);
    push[LabelView](&views, LabelView{
        .text = owner.data[0..owner.len],
        .id = 1,
    });
    free[LabelView](&views);
    let moved: ArrayList[u8] = owner;
    free[u8](&moved);
    return 0;
}

fn main() i32 {
    let current: Frame = frame_make(11);
    let next: Frame = frame_make(19);
    let fail: i32 = 0;
    if (frame_revision(&current) != 2) {
        fail = 1;
    }
    frame_free(&current);
    current = next;
    if (frame_revision(&current) != 2) {
        fail = 1;
    }
    frame_free(&current);
    return fail + retained_views_end_before_owner() +
        retained_result_ends_at_call_boundary() +
        retained_result_ends_at_lexical_scope() + owner_move_after_views_end();
}
