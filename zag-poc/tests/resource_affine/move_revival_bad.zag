@import("std:list")

@resource
struct Frame {
    bytes: @owned(free) ArrayList[u8],
}

fn frame_make() Frame {
    return Frame{ .bytes = make[u8](4) };
}

fn frame_free(frame: @consumes *Frame) void {
    free[u8](&frame.*.bytes);
}

fn main() i32 {
    let source: Frame = frame_make();
    let first: Frame = source;
    let revived: Frame = source;
    frame_free(&first);
    frame_free(&revived);
    return 0;
}
