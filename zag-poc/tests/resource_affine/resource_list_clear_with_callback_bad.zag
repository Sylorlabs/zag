@import("std:list")

@resource
struct Frame {
    bytes: @owned(free) ArrayList[u8],
}

// A resource-valued clear_with callback must state and prove the exact
// consuming element contract. Merely observing a Frame cannot dispose of the
// retained list's nested resources.
fn frame_observe(frame: Frame) void {
    return;
}

fn main() i32 {
    let frames: ArrayList[Frame] = make[Frame](1);
    clear_with[Frame](&frames, frame_observe);
    return 0;
}
