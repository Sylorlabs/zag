@import("std:list")

struct Wrapper {
    values: ArrayList[i32],
    revision: i64,
}

struct Envelope[T] {
    payload: T,
    tag: i64,
}

fn wrapper_make(seed: i32) Wrapper {
    let values: ArrayList[i32] = make[i32](2);
    push[i32](&values, seed);
    return Wrapper{ .values = values, .revision = 1 };
}

fn wrapper_free(value: @consumes *Wrapper) void {
    free[i32](&value.*.values);
}

fn wrapper_observe(value: Wrapper) i64 {
    if (value.values.len == 0) { return value.revision; }
    return value.revision + value.values.data[0] as i64;
}

fn wrapper_consume(value: @consumes Wrapper) void {
    free[i32](&value.values);
}

fn envelope_make(seed: i32) Envelope[ArrayList[i32]] {
    let values: ArrayList[i32] = make[i32](2);
    push[i32](&values, seed);
    return Envelope[ArrayList[i32]]{ .payload = values, .tag = 2 };
}

fn envelope_free(value: @consumes *Envelope[ArrayList[i32]]) void {
    free[i32](&value.*.payload);
}

fn main() i32 {
    let first: Wrapper = wrapper_make(41);
    let observed: i64 = wrapper_observe(first);
    let moved: Wrapper = first;
    let answer: i32 = get[i32](moved.values, 0);
    wrapper_free(&moved);

    let consumed: Wrapper = wrapper_make(17);
    wrapper_consume(consumed);

    let nested: Envelope[ArrayList[i32]] = envelope_make(42);
    let nested_moved: Envelope[ArrayList[i32]] = nested;
    let nested_answer: i32 = get[i32](nested_moved.payload, 0);
    envelope_free(&nested_moved);
    return ((observed != 42) || (answer != 41) || (nested_answer != 42)) as i32;
}
