@import("std:list")

struct Envelope[T] { payload: T }

fn envelope_make() Envelope[ArrayList[i32]] {
    return Envelope[ArrayList[i32]]{ .payload = make[i32](1) };
}

fn envelope_free(value: @consumes *Envelope[ArrayList[i32]]) void {
    free[i32](&value.*.payload);
}

fn main() i32 {
    let owner: Envelope[ArrayList[i32]] = envelope_make();
    let moved: Envelope[ArrayList[i32]] = owner;
    let duplicate: Envelope[ArrayList[i32]] = owner;
    envelope_free(&moved);
    envelope_free(&duplicate);
    return 0;
}
