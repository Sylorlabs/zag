@import("std:list") as list

fn byte_list_drop(bytes: @consumes *list.ArrayList[u8]) void {
    list.free[u8](bytes);
}

@resource
struct Frame {
    bytes: @owned(byte_list_drop) list.ArrayList[u8],
}

// A project declaration cannot impersonate the compiler-owned std:list move
// boundary, even with the same spelling and apparent generic contracts.
fn push_move[T](xs: @borrows_mut *list.ArrayList[T], val: @consumes T) void {
    xs.*.data[xs.*.len] = val;
    xs.*.len = xs.*.len + 1;
}

fn main() i32 {
    let frames: list.ArrayList[Frame] = list.make[Frame](1);
    let frame: Frame = Frame{ .bytes = list.make[u8](2) };
    push_move[Frame](&frames, frame);
    return 0;
}
