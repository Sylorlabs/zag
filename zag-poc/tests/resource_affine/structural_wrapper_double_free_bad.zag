@import("std:list")

struct Wrapper { values: ArrayList[i32] }

fn wrapper_make() Wrapper {
    return Wrapper{ .values = make[i32](1) };
}

fn wrapper_free(value: @consumes *Wrapper) void {
    free[i32](&value.*.values);
}

fn main() i32 {
    let owner: Wrapper = wrapper_make();
    wrapper_free(&owner);
    wrapper_free(&owner);
    return 0;
}
