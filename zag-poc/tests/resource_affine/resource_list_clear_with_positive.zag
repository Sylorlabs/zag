@import("std:list")

extern fn _zag_allocator_live_bytes() i64;

@resource
struct Frame {
    bytes: @owned(free) ArrayList[u8],
    tag: i32,
}

global let released_count: i32;
global let released_sum: i32;

fn frame_drop(frame: @consumes Frame) void {
    released_count = released_count + 1;
    released_sum = released_sum + frame.tag;
    free[u8](&frame.bytes);
}

fn main() i32 {
    let baseline: i64 = _zag_allocator_live_bytes();
    let frames: ArrayList[Frame] = ArrayList[Frame]{
        .data = _zag_malloc(@sizeOf[Frame]() * 2) as *Frame,
        .len = 2,
        .cap = 2,
    };
    frames.data[0].bytes.data = _zag_malloc(32) as *u8;
    frames.data[0].bytes.len = 1;
    frames.data[0].bytes.cap = 4;
    frames.data[0].bytes.data[0] = 42;
    frames.data[0].tag = 10;
    frames.data[1].bytes.data = _zag_malloc(32) as *u8;
    frames.data[1].bytes.len = 1;
    frames.data[1].bytes.cap = 4;
    frames.data[1].bytes.data[0] = 43;
    frames.data[1].tag = 12;
    let original_cap: i32 = frames.cap;

    clear_with[Frame](&frames, frame_drop);
    let status: i32 = 0;
    if (released_count != 2 || released_sum != 22) { status = 1; }
    let cleared_ok: i32 = 1;
    let cleared_i: i32 = 0;
    while (cleared_i < @sizeOf[Frame]()) {
        if ((frames.data as *u8)[cleared_i] != 0) { cleared_ok = 0; }
        cleared_i = cleared_i + 1;
    }
    if (frames.len != 0 || frames.cap != original_cap || frames.data == null as *Frame || cleared_ok == 0) {
        status = 2;
    }
    drain[Frame](&frames, frame_drop);
    if (_zag_allocator_live_bytes() != baseline) { status = 3; }
    return status;
}
