@import("std:list")

@resource
struct Frame {
    bytes: @owned(free) ArrayList[u8],
}

fn frame_free(frame: @consumes *Frame) void {
    free[u8](&frame.*.bytes);
}

fn main() i32 {
    let frames: ArrayList[Frame] = make[Frame](1);
    let moved: Frame = pop[Frame](&frames);
    frame_free(&moved);
    free[Frame](&frames);
    return 0;
}
