@import("std:list")

@resource
struct Frame {
    bytes: ArrayList[u8],
}

fn main() i32 {
    let frames: ArrayList[Frame] = make[Frame](1);
    // Initialize the one backing slot without creating a nested allocation;
    // this fixture exercises retained element views rather than element moves.
    frames.data[0].bytes.data = null as *u8;
    frames.data[0].bytes.len = 0;
    frames.data[0].bytes.cap = 0;
    frames.len = 1;

    let observed: i32 = 0;
    if (frames.cap > 0) {
        let via_get: Frame = get[Frame](frames, 0);
        observed = observed + via_get.bytes.len;
        let via_index: Frame = frames.data[0];
        observed = observed + via_index.bytes.cap;
    }

    free[Frame](&frames);
    return observed;
}
