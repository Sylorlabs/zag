@import("std:list")

struct LabelView {
    text: []u8,
}

fn main() i32 {
    let owner: ArrayList[u8] = make[u8](4);
    push[u8](&owner, 65);
    let view: LabelView = LabelView{
        .text = owner.data[0..owner.len],
    };
    let moved: ArrayList[u8] = owner;
    free[u8](&moved);
    return view.text.len;
}
