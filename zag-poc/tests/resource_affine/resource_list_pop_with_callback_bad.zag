@import("std:list")

@resource
struct Frame {
    bytes: @owned(free) ArrayList[u8],
}

// A resource-valued pop_with callback must consume the selected final
// element. Observation alone cannot prove nested ownership is disposed.
fn frame_observe(frame: Frame) void {
    return;
}

fn main() i32 {
    let frames: ArrayList[Frame] = make[Frame](1);
    pop_with[Frame](&frames, frame_observe);
    return 0;
}
