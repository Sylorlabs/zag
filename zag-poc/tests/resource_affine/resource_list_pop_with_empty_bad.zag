@import("std:list")

@resource
struct Frame {
    bytes: @owned(free) ArrayList[u8],
}

global let called: i32;

fn frame_drop(frame: @consumes Frame) void {
    called = called + 1;
    free[u8](&frame.bytes);
}

fn main() i32 {
    let frames: ArrayList[Frame] = make[Frame](1);
    pop_with[Frame](&frames, frame_drop);
    drain[Frame](&frames, frame_drop);
    return called;
}
