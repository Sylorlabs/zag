@import("std:list") as list

fn byte_list_drop(bytes: @consumes *list.ArrayList[u8]) void {
    list.free[u8](bytes);
}

@resource
struct Frame {
    bytes: @owned(byte_list_drop) list.ArrayList[u8],
}

// A project declaration cannot impersonate std:list's audited whole-list
// transfer boundary, even when its apparent generic contracts match.
fn move_all[T](dst: @borrows_mut *list.ArrayList[T],
               src: @consumes *list.ArrayList[T]) void {
    list.free[T](src);
}

fn main() i32 {
    let dst: list.ArrayList[Frame] = list.make[Frame](1);
    let src: list.ArrayList[Frame] = list.make[Frame](1);
    move_all[Frame](&dst, &src);
    return 0;
}
