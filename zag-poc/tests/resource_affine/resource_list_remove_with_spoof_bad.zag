@import("std:list") as list

fn byte_list_drop(bytes: @consumes *list.ArrayList[u8]) void {
    list.free[u8](bytes);
}

@resource
struct Frame {
    bytes: @owned(byte_list_drop) list.ArrayList[u8],
}

fn frame_drop(frame: @consumes Frame) void {
    byte_list_drop(&frame.bytes);
}

// Project-local same-name helpers do not receive std:list's affine exception.
fn remove_with[T](xs: @borrows_mut *list.ArrayList[T], index: i32,
                  release: fn(@consumes T) void) void {
    return;
}

fn main() i32 {
    let frames: list.ArrayList[Frame] = list.make[Frame](1);
    remove_with[Frame](&frames, 0, frame_drop);
    return 0;
}
