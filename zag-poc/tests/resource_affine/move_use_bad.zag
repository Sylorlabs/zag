@import("std:list")

@resource
struct Frame {
    bytes: @owned(free) ArrayList[u8],
}

fn frame_make(seed: u8) Frame {
    let bytes: ArrayList[u8] = make[u8](4);
    push[u8](&bytes, seed);
    return Frame{ .bytes = bytes };
}

fn frame_revision(frame: @borrows *Frame) i32 {
    return frame.*.bytes.len;
}

fn frame_free(frame: @consumes *Frame) void {
    free[u8](&frame.*.bytes);
}

fn main() i32 {
    let source: Frame = frame_make(7);
    let destination: Frame = source;
    let stale: i32 = frame_revision(&source);
    frame_free(&destination);
    return stale;
}
