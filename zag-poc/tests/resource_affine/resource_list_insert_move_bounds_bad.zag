@import("std:list")

@resource
struct Frame {
    bytes: @owned(free) ArrayList[u8],
}

fn frame_drop(frame: @consumes Frame) void {
    free[u8](&frame.bytes);
}

fn main() i32 {
    let frames: ArrayList[Frame] = make[Frame](1);
    let frame: Frame = Frame{ .bytes = make[u8](1) };
    insert_move[Frame](&frames, 1, frame);
    drain[Frame](&frames, frame_drop);
    return 0;
}
