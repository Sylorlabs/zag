@import("std:list")

@resource
struct Frame {
    bytes: @owned(free) ArrayList[u8],
    tag: i32,
}

fn frame_drop(frame: @consumes Frame) void {
    free[u8](&frame.bytes);
}

fn main() i32 {
    let frames: ArrayList[Frame] = ArrayList[Frame]{
        .data = _zag_malloc(@sizeOf[Frame]()) as *Frame,
        .len = 1,
        .cap = 1,
    };
    frames.data[0].bytes.data = _zag_malloc(32) as *u8;
    frames.data[0].bytes.len = 1;
    frames.data[0].bytes.cap = 4;
    frames.data[0].tag = 10;
    take_with[Frame](&frames, 2, frame_drop, frame_drop);
    return 0;
}
