@import("std:list") as list

fn byte_list_drop(bytes: @consumes *list.ArrayList[u8]) void {
    list.free[u8](bytes);
}

@resource
struct Frame {
    bytes: @owned(byte_list_drop) list.ArrayList[u8],
}

fn insert_move[T](xs: @borrows_mut *list.ArrayList[T], index: i32,
                  val: @consumes T) void {
    xs.*.data[index] = val;
}

fn main() i32 {
    let frames: list.ArrayList[Frame] = list.make[Frame](1);
    let frame: Frame = Frame{ .bytes = list.make[u8](1) };
    insert_move[Frame](&frames, 0, frame);
    return 0;
}
