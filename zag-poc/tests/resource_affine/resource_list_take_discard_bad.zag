@import("std:list")

struct Frame {
    bytes: ArrayList[u8],
}

fn frame_drop(frame: @consumes Frame) void {
    free[u8](&frame.bytes);
}

fn frame_observe(frame: Frame) void {
    return;
}

fn main() i32 {
    let frames: ArrayList[Frame] = make[Frame](1);
    take_with[Frame](&frames, 0, frame_drop, frame_observe);
    return 0;
}
