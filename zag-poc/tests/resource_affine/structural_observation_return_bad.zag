@import("std:list")

struct Wrapper { values: ArrayList[i32] }

fn observe_and_return(value: Wrapper) Wrapper {
    return value;
}

fn main() i32 {
    let owner: Wrapper = Wrapper{ .values = make[i32](1) };
    let escaped: Wrapper = observe_and_return(owner);
    free[i32](&escaped.values);
    return 0;
}
