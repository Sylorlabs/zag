@import("std:list")

extern fn _zag_allocator_live_bytes() i64;

@resource
struct Frame {
    bytes: @owned(free) ArrayList[u8],
    tag: i32,
}

global let released_count: i32;
global let released_sum: i32;

fn frame_make(tag: i32) Frame {
    let bytes: ArrayList[u8] = make[u8](1);
    push[u8](&bytes, tag as u8);
    return Frame{ .bytes = bytes, .tag = tag };
}

fn frame_drop(frame: @consumes Frame) void {
    released_count = released_count + 1;
    released_sum = released_sum + frame.tag;
    free[u8](&frame.bytes);
}

fn main() i32 {
    let baseline: i64 = _zag_allocator_live_bytes();
    let frames: ArrayList[Frame] = make[Frame](3);
    let first: Frame = frame_make(10);
    push_move[Frame](&frames, first);
    let second: Frame = frame_make(11);
    push_move[Frame](&frames, second);
    let third: Frame = frame_make(12);
    push_move[Frame](&frames, third);

    remove_with[Frame](&frames, 1, frame_drop);
    let status: i32 = 0;
    if (frames.len != 2 || frames.data[0].tag != 10 || frames.data[1].tag != 12 ||
        released_count != 1 || released_sum != 11) { status = 1; }
    drain[Frame](&frames, frame_drop);
    if (released_count != 3 || released_sum != 33) { status = 2; }
    if (_zag_allocator_live_bytes() != baseline) { status = 3; }
    return status;
}
