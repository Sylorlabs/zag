@import("std:list")

@resource
struct Frame {
    bytes: @owned(free) ArrayList[u8],
}

fn frame_make() Frame {
    return Frame{ .bytes = make[u8](4) };
}

// An explicit @consumes annotation does not tell a generic body how to drop
// an arbitrary concrete resource.  This sink must remain fail-closed until a
// generic destructor/transfer protocol exists.
fn discard[T](value: @consumes T) void {
    return;
}

fn main() i32 {
    let frame: Frame = frame_make();
    discard[Frame](frame);
    return 0;
}
