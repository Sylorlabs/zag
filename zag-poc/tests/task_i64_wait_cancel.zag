// Bounded cancellation-token bridge over the Linux x86-64 TaskI64 ABI.
//
// This fixture proves that a caller-owned one-shot token can request
// cooperative cancellation while a non-consuming task wait is polling. It
// deliberately does not claim a scheduler, a generic future, or forced worker
// termination: every affine task is still consumed exactly once with await.

@import("std:task_i64") as task
@import("std:cancel_token_i64") as cancel

struct Delay {
    seconds: i64,
    nanoseconds: i64,
}

fn immediate_worker(raw:i64) i64 {
    unsafe { return @taskInput(raw as *opaque) + 1; }
}

fn cancellable_worker(raw:i64) i64 {
    unsafe {
        let handle:*opaque = raw as *opaque;
        let i:i64 = 0;
        while (i < 10000000) {
            if (@taskCancelled(handle) == 1) { return 0 - 999; }
            let _yielded:i64 = _zag_raw_syscall(24,0,0,0,0,0,0);
            i = i + 1;
        }
        return @taskInput(handle);
    }
}

fn delayed_request(raw:i64) void {
    let token:*cancel.CancelTokenI64 = null as *cancel.CancelTokenI64;
    unsafe {
        token = raw as *cancel.CancelTokenI64;
        let delay:Delay = Delay{.seconds = 0, .nanoseconds = 20000000};
        let _slept:i64 = _zag_raw_syscall(35,(&delay) as i64,0,0,0,0,0);
    }
    let _requested:i64 = cancel.cancel_token_i64_request(token);
}

fn main() i32 {
    unsafe {
        let invalid_handle:task.TaskI64PollResult =
            task.task_i64_wait_cancel(null as *opaque, null as *cancel.CancelTokenI64, 0);
        if (invalid_handle.ok != 0 ||
            invalid_handle.code != task.task_i64_poll_status_invalid_handle()) {
            return 1;
        }

        let invalid_token:cancel.CancelTokenI64 = cancel.cancel_token_i64_invalid();
        let invalid_task:*opaque = @taskSpawn(immediate_worker, 41);
        let rejected:task.TaskI64PollResult =
            task.task_i64_wait_cancel(invalid_task, &invalid_token, 0);
        if (rejected.ok != 0 ||
            rejected.code != task.task_i64_poll_status_invalid_token()) {
            return 2;
        }
        let invalid_value:i64 = @taskAwait(invalid_task);
        if (invalid_value != 42) { return 3; }

        let timeout_word:i64 = 0;
        let timeout_token:cancel.CancelTokenI64 = cancel.cancel_token_i64_invalid();
        if (cancel.cancel_token_i64_init(&timeout_token, (&timeout_word) as *i64) != 0) {
            return 4;
        }
        let timeout_task:*opaque = @taskSpawn(immediate_worker, 9);
        let bad_timeout:task.TaskI64PollResult =
            task.task_i64_wait_cancel(timeout_task, &timeout_token, 5001);
        if (bad_timeout.ok != 0 ||
            bad_timeout.code != task.task_i64_poll_status_invalid_timeout()) {
            return 5;
        }
        let timeout_value:i64 = @taskAwait(timeout_task);
        if (timeout_value != 10 ||
            cancel.cancel_token_i64_close(&timeout_token) != 0) { return 6; }

        let pre_word:i64 = 0;
        let pre_token:cancel.CancelTokenI64 = cancel.cancel_token_i64_invalid();
        if (cancel.cancel_token_i64_init(&pre_token, (&pre_word) as *i64) != 0 ||
            cancel.cancel_token_i64_request(&pre_token) != 0) { return 7; }
        let pre_task:*opaque = @taskSpawn(cancellable_worker, 0);
        let pre_cancelled:task.TaskI64PollResult =
            task.task_i64_wait_cancel(pre_task, &pre_token, 1000);
        if (pre_cancelled.ok != 1 ||
            pre_cancelled.cancellation_requested != 1 ||
            task.task_i64_cancelled(pre_task) != 1) { return 8; }
        let pre_value:i64 = @taskAwait(pre_task);
        if (pre_value != 0 - 999 ||
            cancel.cancel_token_i64_close(&pre_token) != 0) { return 9; }

        let during_word:i64 = 0;
        let during_token:cancel.CancelTokenI64 = cancel.cancel_token_i64_invalid();
        if (cancel.cancel_token_i64_init(&during_token, (&during_word) as *i64) != 0) {
            return 10;
        }
        let during_task:*opaque = @taskSpawn(cancellable_worker, 0);
        let requester:*opaque =
            @threadSpawn(delayed_request, (&during_token) as i64);
        let during:task.TaskI64PollResult =
            task.task_i64_wait_cancel(during_task, &during_token, 1000);
        @threadJoin(requester);
        if (during.ok != 1 || during.cancellation_requested != 1 ||
            task.task_i64_cancelled(during_task) != 1) { return 11; }
        let during_value:i64 = @taskAwait(during_task);
        if (during_value != 0 - 999 ||
            cancel.cancel_token_i64_close(&during_token) != 0) { return 12; }

        let success_word:i64 = 0;
        let success_token:cancel.CancelTokenI64 = cancel.cancel_token_i64_invalid();
        if (cancel.cancel_token_i64_init(&success_token, (&success_word) as *i64) != 0) {
            return 13;
        }
        let success_task:*opaque = @taskSpawn(immediate_worker, 41);
        let success:task.TaskI64PollResult =
            task.task_i64_wait_cancel(success_task, &success_token, 1000);
        if (success.ok != 1 || success.state != task.task_i64_poll_ready() ||
            success.value != 42 || success.cancellation_requested != 0) { return 14; }
        let success_value:i64 = @taskAwait(success_task);
        if (success_value != 42 ||
            cancel.cancel_token_i64_close(&success_token) != 0) { return 15; }
    }
    _zag_println("task-wait-cancel preflight=1 bridge=1 success=1");
    return 0;
}
