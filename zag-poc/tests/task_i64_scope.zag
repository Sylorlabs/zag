// Poll-driven parent-to-child cancellation scope witness.

@import("std:task_i64") as task
@import("std:task_i64_scope") as scope

fn cancellable_worker(raw:i64) i64 {
    unsafe {
        let handle:*opaque = raw as *opaque;
        let i:i64 = 0;
        while (i < 10000000) {
            if (@taskCancelled(handle) == 1) { return 0 - 999; }
            let _yielded:i64 = _zag_raw_syscall(24, 0, 0, 0, 0, 0, 0);
            i = i + 1;
        }
        return @taskInput(handle);
    }
}

fn main() i32 {
    unsafe {
        let parent:*opaque = @taskSpawn(cancellable_worker, 1);
        let child0:*opaque = @taskSpawn(cancellable_worker, 10);
        let child1:*opaque = @taskSpawn(cancellable_worker, 20);
        if (parent == null as *opaque || child0 == null as *opaque ||
            child1 == null as *opaque) { return 1; }
        let cancellation_scope:scope.TaskI64CancellationScope =
            scope.TaskI64CancellationScope{
                .parent = parent as i64, .child0 = child0 as i64,
                .child1 = child1 as i64, .child2 = 0, .child3 = 0,
                .child4 = 0, .child5 = 0, .child6 = 0, .count = 2};
        let before:scope.TaskI64ScopeResult =
            scope.task_i64_scope_poll(&cancellation_scope);
        if (before.ok != 1 || before.state != task.task_i64_poll_pending() ||
            before.parent_cancelled != 0 || before.propagated != 0 ||
            before.child_cancelled_count != 0) { return 2; }
        if (@taskCancel(parent) != 0) { return 3; }
        let after:scope.TaskI64ScopeResult =
            scope.task_i64_scope_wait(&cancellation_scope, 1000);
        if (after.ok != 1 || after.parent_cancelled != 1 ||
            after.propagated != 1 || after.child_cancelled_count != 2 ||
            after.index < 0 || after.state != task.task_i64_poll_ready() ||
            after.value != 0 - 999 || after.cancellation_requested != 1) {
            return 4;
        }
        cancellation_scope.child0 = cancellation_scope.child1;
        cancellation_scope.child1 = 0;
        cancellation_scope.count = 1;
        if (@taskAwait(child0) != 0 - 999) { return 6; }
        let second:scope.TaskI64ScopeResult =
            scope.task_i64_scope_wait(&cancellation_scope, 1000);
        if (second.ok != 1 || second.index != 0 ||
            second.state != task.task_i64_poll_ready() ||
            second.value != 0 - 999 || second.cancellation_requested != 1) {
            return 7;
        }
        cancellation_scope.child0 = 0;
        cancellation_scope.count = 0;
        if (@taskAwait(child1) != 0 - 999) { return 9; }
        if (@taskAwait(parent) != 0 - 999) { return 11; }
    }
    _zag_println("task-i64-scope parent=1 propagated=1 children=2 ready=2");
    return 0;
}
