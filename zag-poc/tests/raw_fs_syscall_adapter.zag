@import("../std/rt.zag")
@import("../std/list.zag")

fn c_string(value: []u8) ArrayList[u8] {
    let out: ArrayList[u8] = make[u8](value.len + 1);
    let i: i32 = 0;
    while (i < value.len) { push[u8](&out, value[i]); i = i + 1; }
    push[u8](&out, 0 as u8);
    return out;
}

fn record(ok: bool, code: i32, status: *i32) void {
    if (!ok && status.* == 0) { status.* = code; }
}

fn main() i32 {
    let pid: i64 = _zag_raw_syscall(39, 0, 0, 0, 0, 0, 0);
    let pid_text: []u8 = _zag_i64_to_str(pid);
    let root: []u8 = _zag_str_concat("/tmp/zag-raw-fs-adapter-", pid_text);
    let first: []u8 = _zag_str_concat(root, "/first");
    let second: []u8 = _zag_str_concat(root, "/second");
    let root_c: ArrayList[u8] = c_string(root);
    let first_c: ArrayList[u8] = c_string(first);
    let second_c: ArrayList[u8] = c_string(second);
    let relative_second_c: ArrayList[u8] = c_string("second");
    let rp: i64 = root_c.data as i64;
    let fp: i64 = first_c.data as i64;
    let sp: i64 = second_c.data as i64;
    let relative_sp: i64 = relative_second_c.data as i64;

    // Best-effort cleanup makes a repeated run deterministic.
    let _c1: i64 = _zag_raw_syscall(87, fp, 0, 0, 0, 0, 0);
    let _c2: i64 = _zag_raw_syscall(87, sp, 0, 0, 0, 0, 0);
    let _c3: i64 = _zag_raw_syscall(84, rp, 0, 0, 0, 0, 0);

    let status: i32 = 0;
    record(_zag_raw_syscall(83, rp, 448, 0, 0, 0, 0) == 0, 1, &status);
    record(_zag_write_file(first, "legacy") == 0, 2, &status);
    record(_zag_raw_syscall(82, fp, sp, 0, 0, 0, 0) == 0, 3, &status);
    record(_zag_file_exists(first) == 0 && _zag_file_exists(second) == 1, 4, &status);

    record(_zag_write_file(first, "at") == 0, 5, &status);
    record(_zag_raw_syscall(264, 0 - 100, fp, 0 - 100, sp, 0, 0) == 0, 6, &status);
    record(_zag_file_exists(first) == 0 && _zag_file_exists(second) == 1, 7, &status);

    // Unknown flags must not mutate. A Linux *at syscall with an absolute
    // pathname ignores dirfd, so use a relative pathname to test bad dirfds.
    record(_zag_raw_syscall(263, 0 - 100, sp, 1, 0, 0, 0) < 0 &&
        _zag_file_exists(second) == 1, 8, &status);
    // Enter the temporary directory so "second" resolves when dirfd is
    // ignored. A broken adapter returning ENOENT can no longer pass this test.
    record(_zag_raw_syscall(80, rp, 0, 0, 0, 0, 0) == 0, 14, &status);
    record(_zag_raw_syscall(263, 0 - 2, relative_sp, 0, 0, 0, 0) == 0 - 9 &&
        _zag_file_exists(second) == 1, 9, &status);
    record(_zag_raw_syscall(263, 0 - 100, sp, 0, 0, 0, 0) == 0 &&
        _zag_file_exists(second) == 0, 10, &status);

    record(_zag_write_file(first, "unlink") == 0, 11, &status);
    record(_zag_raw_syscall(87, fp, 0, 0, 0, 0, 0) == 0 &&
        _zag_file_exists(first) == 0, 12, &status);
    record(_zag_raw_syscall(84, rp, 0, 0, 0, 0, 0) == 0, 13, &status);

    free[u8](&relative_second_c); free[u8](&second_c); free[u8](&first_c); free[u8](&root_c);
    _zag_str_free(second); _zag_str_free(first); _zag_str_free(root); _zag_str_free(pid_text);
    if (status != 0) { return status; }
    return 42;
}
