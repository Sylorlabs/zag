// A listener with no client must honor the per-accept timeout on every native
// host. In particular, Darwin SO_RCVTIMEO alone does not bound accept(2).

@import("std:net_ipv4") as net

extern fn _zag_clock_monotonic_ms() i64

fn main() i32 {
    let listener_result: net.NetTcpListenerResult = net.net_tcp_listen_ipv4(
        net.net_ipv4_endpoint(net.net_ipv4_loopback(), 0), 4, 1000
    );
    if (listener_result.ok == 0) { return 1; }
    let listener: net.NetTcpListener =
        net.net_tcp_listener_take(&listener_result);
    let started: i64 = _zag_clock_monotonic_ms();
    let accepted: net.NetTcpStreamResult = net.net_tcp_accept(&listener, 100);
    let elapsed: i64 = _zag_clock_monotonic_ms() - started;
    if (accepted.ok != 0 || accepted.code != net.net_status_timeout()) {
        net.net_tcp_listener_close(&listener);
        return 2;
    }
    if (elapsed < 0 || elapsed > 1000) {
        net.net_tcp_listener_close(&listener);
        return 3;
    }
    if (net.net_tcp_listener_close(&listener) != net.net_status_ok()) {
        return 4;
    }
    return 0;
}
