// Typed bounded multi-task result transport witness.

@import("std:task_i64") as task
@import("std:task_i64_wait_many") as many

struct Delay {
    seconds: i64,
    nanoseconds: i64,
}

fn delayed_worker(raw:i64) i64 {
    unsafe {
        let handle:*opaque = raw as *opaque;
        let delay:Delay = Delay{.seconds = 0, .nanoseconds = 60000000};
        let _slept:i64 = _zag_raw_syscall(35, (&delay) as i64, 0, 0, 0, 0, 0);
        if (@taskCancelled(handle) == 1) { return 0 - 999; }
        return @taskInput(handle);
    }
}

fn immediate_worker(raw:i64) i64 {
    unsafe { return @taskInput(raw as *opaque) + 1; }
}

fn blank_result() many.TaskI64WaitManyResult {
    return many.TaskI64WaitManyResult{.ok = 0, .code = 0, .state = 0,
        .completed = 0, .ready_mask = 0, .cancellation_mask = 0,
        .value0 = 0, .value1 = 0, .value2 = 0, .value3 = 0,
        .value4 = 0, .value5 = 0, .value6 = 0, .value7 = 0};
}

fn main() i32 {
    unsafe {
        let first:*opaque = @taskSpawn(delayed_worker, 10);
        let second:*opaque = @taskSpawn(immediate_worker, 20);
        let third:*opaque = @taskSpawn(immediate_worker, 30);
        if (first == null as *opaque || second == null as *opaque ||
            third == null as *opaque) { return 1; }
        let set:many.TaskI64WaitManySet = many.TaskI64WaitManySet{
            .h0 = first as i64, .h1 = second as i64, .h2 = third as i64,
            .h3 = 0, .h4 = 0, .h5 = 0, .h6 = 0, .h7 = 0, .count = 3};
        let result:many.TaskI64WaitManyResult = blank_result();
        let status:i64 = many.task_i64_wait_many(&set, 1000, &result);
        if (status != 0 || result.ok != 1 ||
            result.state != task.task_i64_poll_ready() || result.completed != 3 ||
            result.ready_mask != 7 || result.cancellation_mask != 0 ||
            result.value0 != 10 || result.value1 != 21 || result.value2 != 31) {
            return 2;
        }
        if (@taskAwait(first) != 10 || @taskAwait(second) != 21 ||
            @taskAwait(third) != 31) { return 3; }

        let duplicate0:*opaque = @taskSpawn(immediate_worker, 40);
        let duplicate1:*opaque = @taskSpawn(immediate_worker, 50);
        let duplicate_set:many.TaskI64WaitManySet = many.TaskI64WaitManySet{
            .h0 = duplicate0 as i64, .h1 = duplicate0 as i64,
            .h2 = 0, .h3 = 0, .h4 = 0, .h5 = 0, .h6 = 0, .h7 = 0,
            .count = 2};
        let duplicate_result:many.TaskI64WaitManyResult = blank_result();
        if (many.task_i64_wait_many(&duplicate_set, 0, &duplicate_result) !=
            many.task_i64_wait_many_status_invalid_set() ||
            duplicate_result.code != many.task_i64_wait_many_status_invalid_set()) {
            return 4;
        }
        let duplicate0_value:i64 = @taskAwait(duplicate0);
        let duplicate1_value:i64 = @taskAwait(duplicate1);
        if (duplicate0_value != 41 || duplicate1_value != 51) {
            return 5;
        }

        let cancelled:*opaque = @taskSpawn(delayed_worker, 60);
        let survivor:*opaque = @taskSpawn(delayed_worker, 70);
        let cancel_set:many.TaskI64WaitManySet = many.TaskI64WaitManySet{
            .h0 = cancelled as i64, .h1 = survivor as i64,
            .h2 = 0, .h3 = 0, .h4 = 0, .h5 = 0, .h6 = 0, .h7 = 0,
            .count = 2};
        if (@taskCancel(cancelled) != 0) { return 6; }
        let cancel_result:many.TaskI64WaitManyResult = blank_result();
        if (many.task_i64_wait_many(&cancel_set, 1000, &cancel_result) != 0 ||
            cancel_result.state != task.task_i64_poll_ready() ||
            cancel_result.completed != 2 || cancel_result.ready_mask != 3 ||
            cancel_result.cancellation_mask != 1 ||
            cancel_result.value0 != 0 - 999 || cancel_result.value1 != 70) {
            return 7;
        }
        if (@taskAwait(cancelled) != 0 - 999 || @taskAwait(survivor) != 70) {
            return 8;
        }

        let timeout_task:*opaque = @taskSpawn(delayed_worker, 80);
        let timeout_set:many.TaskI64WaitManySet = many.TaskI64WaitManySet{
            .h0 = timeout_task as i64, .h1 = 0, .h2 = 0, .h3 = 0,
            .h4 = 0, .h5 = 0, .h6 = 0, .h7 = 0, .count = 1};
        let timeout_result:many.TaskI64WaitManyResult = blank_result();
        if (many.task_i64_wait_many(&timeout_set, 5001, &timeout_result) !=
            many.task_i64_wait_many_status_invalid_timeout()) { return 9; }
        if (many.task_i64_wait_many(&timeout_set, 0,
            0 as *many.TaskI64WaitManyResult) !=
            many.task_i64_wait_many_status_invalid_output()) { return 10; }
        if (@taskAwait(timeout_task) != 80) { return 11; }
    }
    _zag_println("task-i64-wait-many tasks=6 completed=6 masks=3 fail-closed=3");
    return 0;
}
