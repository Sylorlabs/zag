// Regression: decimal float literals must encode correctly over the whole
// IEEE-754 double range. Before grok/fix-float-literal-range the native
// literal encoder rejected |exponent| beyond ~18 ("float literal magnitude
// out of supported range") and silently encoded 0.000000000000000000001 as 0.
fn f64_bits(x: f64) i64 { let v: f64 = x; let r: i64 = 0; unsafe { let p: *i64 = (&v) as *i64; r = p.*; } return r; }
fn chk(id: i64, got: f64, want: i64) i64 {
    if (f64_bits(got) != want) { _zag_print("FAIL case "); print_i64(id); return 1; }
    return 0;
}
fn main() i32 {
    let f: i64 = 0;
    f = f + chk(1, 0.1, 0x3FB999999999999A);
    f = f + chk(2, 1e21, 0x444B1AE4D6E2EF50);
    f = f + chk(3, 1e22, 4936209963552724370);
    f = f + chk(4, 1e23, 0x44B52D02C7E14AF6);
    f = f + chk(5, 6.022e23, 0x44DFE154F457EA13);
    f = f + chk(6, 1.7976931348623157e308, 0x7FEFFFFFFFFFFFFF);
    f = f + chk(7, 2.2250738585072014e-308, 0x0010000000000000);
    f = f + chk(8, 4.9406564584124654e-324, 1);
    f = f + chk(9, 1e-323, 2);
    f = f + chk(10, 2.4703282292062327e-324, 0);
    f = f + chk(11, 2.4703282292062328e-324, 1);
    f = f + chk(12, 9007199254740993.0, 0x4340000000000000);
    f = f + chk(13, 9007199254740995.0, 0x4340000000000002);
    f = f + chk(14, 1.0e19, 4891288408196988160);
    f = f + chk(15, 1e309, 0x7FF0000000000000);
    f = f + chk(16, 1e-400, 0);
    f = f + chk(17, 0., 0x0010000000000000);
    let tiny: f64 = 0.000000000000000000001;
    if (f64_bits(tiny) == 0 || f64_bits(tiny) != f64_bits(1.0e-21)) { _zag_print("FAIL tiny\n"); f = f + 1; }
    let big: f64 = 1.0e300;
    if (!(big > 1.0e18 * 1.0e18)) { _zag_print("FAIL big\n"); f = f + 1; }
    if (f != 0) { return 1; }
    _zag_print("float literal range: all cases ok\n");
    return 0;
}
