@import("std:list")
@import("std:checksum")
@import("std:zlib_store")

struct TestState { passed: i32, failed: i32 }

fn expect(state: *TestState, condition: i32, name: []u8) void {
    if (condition != 0) {
        state.*.passed = state.*.passed + 1;
        _zag_print("ok  "); _zag_println(name);
    } else {
        state.*.failed = state.*.failed + 1;
        _zag_print("FAIL "); _zag_println(name);
    }
}

fn bytes_equal_slice(a: ArrayList[u8], b: []u8) i32 {
    if (a.len != b.len) { return 0; }
    let i: i32 = 0;
    while (i < a.len) {
        if (a.data[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn checksum_contract(state: *TestState) void {
    expect(state, checksum_crc32("") == 0 && checksum_adler32("") == 1,
        "empty checksum vectors match their format identities");
    expect(state, checksum_crc32("123456789") == 3421780262,
        "CRC32 matches the published 123456789 vector");
    expect(state, checksum_adler32("123456789") == 152961502,
        "Adler32 matches the published 123456789 vector");
}

fn round_trip_size(state: *TestState, size: i32) i32 {
    let input: ArrayList[u8] = make[u8](size);
    let i: i32 = 0;
    while (i < size) {
        push[u8](&input, ((i * 37 + size) % 251) as u8);
        i = i + 1;
    }
    let encoded: ZlibStoreEncodeResult = zlib_store_encode(input.data[0..input.len]);
    let decoded: ZlibStoreDecodeResult = zlib_store_decode(
        encoded.bytes.data[0..encoded.bytes.len]
    );
    let ok: i32 = (encoded.error == ZlibStoreError.none &&
        decoded.error == ZlibStoreError.none &&
        bytes_equal_slice(decoded.bytes, input.data[0..input.len]) != 0) as i32;
    zlib_store_decode_free(&decoded);
    zlib_store_encode_free(&encoded);
    free[u8](&input);
    return ok;
}

fn zlib_contract(state: *TestState) void {
    let empty: ZlibStoreEncodeResult = zlib_store_encode("");
    let expected_empty: ArrayList[u8] = make[u8](11);
    push[u8](&expected_empty, 120); push[u8](&expected_empty, 1);
    push[u8](&expected_empty, 1); push[u8](&expected_empty, 0);
    push[u8](&expected_empty, 0); push[u8](&expected_empty, 255);
    push[u8](&expected_empty, 255); push[u8](&expected_empty, 0);
    push[u8](&expected_empty, 0); push[u8](&expected_empty, 0);
    push[u8](&expected_empty, 1);
    expect(state, empty.error == ZlibStoreError.none &&
        bytes_equal_slice(empty.bytes, expected_empty.data[0..expected_empty.len]) != 0,
        "empty stored zlib stream has one canonical final block");
    free[u8](&expected_empty);
    zlib_store_encode_free(&empty);

    expect(state, round_trip_size(state, 0) != 0 && round_trip_size(state, 1) != 0 &&
        round_trip_size(state, 65535) != 0 && round_trip_size(state, 65536) != 0 &&
        round_trip_size(state, 131071) != 0,
        "stored zlib round trips exact bytes across block boundaries");

    let encoded: ZlibStoreEncodeResult = zlib_store_encode("hello");
    let expected_hello: ArrayList[u8] = make[u8](16);
    push[u8](&expected_hello, 120); push[u8](&expected_hello, 1);
    push[u8](&expected_hello, 1); push[u8](&expected_hello, 5);
    push[u8](&expected_hello, 0); push[u8](&expected_hello, 250);
    push[u8](&expected_hello, 255); push[u8](&expected_hello, 104);
    push[u8](&expected_hello, 101); push[u8](&expected_hello, 108);
    push[u8](&expected_hello, 108); push[u8](&expected_hello, 111);
    push[u8](&expected_hello, 6); push[u8](&expected_hello, 44);
    push[u8](&expected_hello, 2); push[u8](&expected_hello, 21);
    expect(state, bytes_equal_slice(encoded.bytes,
        expected_hello.data[0..expected_hello.len]) != 0,
        "stored hello stream matches the interoperable zlib byte vector");
    free[u8](&expected_hello);

    let saved_header: u8 = encoded.bytes.data[0];
    encoded.bytes.data[0] = 0;
    let bad_header: ZlibStoreDecodeResult = zlib_store_decode(
        encoded.bytes.data[0..encoded.bytes.len]
    );
    expect(state, bad_header.error == ZlibStoreError.unsupported_header &&
        bad_header.error_offset == 0,
        "unsupported zlib headers fail at byte zero");
    zlib_store_decode_free(&bad_header);
    encoded.bytes.data[0] = saved_header;

    let saved_block: u8 = encoded.bytes.data[2];
    encoded.bytes.data[2] = 3;
    let bad_block: ZlibStoreDecodeResult = zlib_store_decode(
        encoded.bytes.data[0..encoded.bytes.len]
    );
    expect(state, bad_block.error == ZlibStoreError.unsupported_block &&
        bad_block.error_offset == 2,
        "compressed and noncanonical block headers fail visibly");
    zlib_store_decode_free(&bad_block);
    encoded.bytes.data[2] = saved_block;

    let saved_length: u8 = encoded.bytes.data[5];
    encoded.bytes.data[5] = saved_length - 1;
    let bad_length: ZlibStoreDecodeResult = zlib_store_decode(
        encoded.bytes.data[0..encoded.bytes.len]
    );
    expect(state, bad_length.error == ZlibStoreError.length_mismatch &&
        bad_length.error_offset == 3,
        "stored block length complements are mandatory");
    zlib_store_decode_free(&bad_length);
    encoded.bytes.data[5] = saved_length;

    let checksum_offset: i32 = encoded.bytes.len - 1;
    encoded.bytes.data[checksum_offset] = encoded.bytes.data[checksum_offset] + 1;
    let bad_checksum: ZlibStoreDecodeResult = zlib_store_decode(
        encoded.bytes.data[0..encoded.bytes.len]
    );
    expect(state, bad_checksum.error == ZlibStoreError.checksum_mismatch,
        "Adler32 corruption fails before decoded bytes become trusted");
    zlib_store_decode_free(&bad_checksum);
    encoded.bytes.data[checksum_offset] = encoded.bytes.data[checksum_offset] - 1;

    let truncated: ZlibStoreDecodeResult = zlib_store_decode(
        encoded.bytes.data[0..encoded.bytes.len - 1]
    );
    expect(state, truncated.error == ZlibStoreError.truncated,
        "truncated Adler32 trailers report the observed length");
    zlib_store_decode_free(&truncated);

    push[u8](&encoded.bytes, 0);
    let trailing: ZlibStoreDecodeResult = zlib_store_decode(
        encoded.bytes.data[0..encoded.bytes.len]
    );
    expect(state, trailing.error == ZlibStoreError.trailing_data,
        "trailing zlib bytes fail canonical decoding");
    zlib_store_decode_free(&trailing);
    zlib_store_encode_free(&encoded);
}

fn main() i32 {
    let state: TestState = TestState{ .passed = 0, .failed = 0 };
    checksum_contract(&state);
    zlib_contract(&state);
    let passed_text: []u8 = _zag_i64_to_str(state.passed as i64);
    let failed_text: []u8 = _zag_i64_to_str(state.failed as i64);
    _zag_print("Compression primitives: pass="); _zag_print(passed_text);
    _zag_print(" fail="); _zag_println(failed_text);
    _zag_str_free(passed_text);
    _zag_str_free(failed_text);
    if (state.failed == 0) { return 0; }
    return 1;
}
