// Minimal dynamic-ABI Vulkan probe.  This intentionally uses raw byte storage
// rather than pretending Zag's ordinary aggregate layout is a C ABI layout.
// It proves that a pure-Zag host can create an instance and enumerate a
// physical device; the bounded dispatch gate exercises the complete pipeline.

// Pointer values cross the narrow C ABI as integers so the checker does not
// mistake Vulkan's output handles and stack buffers for Zag-owned allocations.
extern fn vkCreateInstance(info: i64, allocator: i64, instance: i64) i32 @cabi;
extern fn vkDestroyInstance(instance: i64, allocator: i64) void @cabi;
extern fn vkEnumeratePhysicalDevices(instance: i64, count: i64, devices: i64) i32 @cabi;
extern fn _zag_println(text: []u8) void;

// Every field is represented as one eight-byte C ABI slot.  The Vulkan
// sType/flags integers occupy the low half of their slots and their natural
// padding occupies the high half, matching the Linux Vulkan ABI.
struct VkInstanceInfo {
    s_type: i64,
    p_next: i64,
    flags: i64,
    app: i64,
    layer_count: i64,
    layer_names: i64,
    extension_count: i64,
    extension_names: i64,
}

fn main() i32 {
    unsafe {
        let ici: VkInstanceInfo = VkInstanceInfo{
            .s_type = 1, .p_next = 0, .flags = 0, .app = 0,
            .layer_count = 0, .layer_names = 0, .extension_count = 0,
            .extension_names = 0,
        };
        let instance_out: u64 = 0;
        let count: u32 = 0;
        let rc: i32 = vkCreateInstance((&ici) as i64, 0, (&instance_out) as i64);
        if (rc != 0) { return 3; }
        let instance: *u8 = instance_out as *u8;
        if (vkEnumeratePhysicalDevices(instance as i64, (&count) as i64, 0) != 0 || count == 0) {
            vkDestroyInstance(instance as i64, 0); return 4;
        }
        let device_out: u64 = 0;
        if (vkEnumeratePhysicalDevices(instance as i64, (&count) as i64, (&device_out) as i64) != 0) {
            vkDestroyInstance(instance as i64, 0); return 5;
        }
        _zag_println("ZAG_VULKAN_PROBE_OK");
        vkDestroyInstance(instance as i64, 0);
        return 0;
    }
}
