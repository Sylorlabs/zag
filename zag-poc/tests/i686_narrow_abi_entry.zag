// Compiler-produced caller side of the narrow SysV i386 ABI witness.
// Every argument crosses an ELF32 object boundary after explicit wrapping,
// and every narrow result is converted back to i32 after the external call.
extern fn external_narrow_args(a:i8, b:u8, c:i16, d:u16, e:bool) i32;
extern fn external_i8() i8;
extern fn external_u8() u8;
extern fn external_i16() i16;
extern fn external_u16() u16;
extern fn external_bool() bool;

fn main() i32 {
    if (external_narrow_args(128 as i8, 255 as u8, 32768 as i16, 65535 as u16, true) != 7) {
        return 1;
    }
    if ((external_i8() as i32) != -128) { return 2; }
    if ((external_u8() as i32) != 255) { return 3; }
    if ((external_i16() as i32) != -32768) { return 4; }
    if ((external_u16() as i32) != 65535) { return 5; }
    if (external_bool() == false) { return 6; }
    return 42;
}
