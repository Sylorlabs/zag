// A Script-owned boolean list must not escape through an uncontracted
// aggregate sink, even when it is also consumed by the bounded JSON encoder.
// This is intentionally a compile-time negative fixture.
script;

struct BoolEncodePayload { values: ScriptList[bool] }
extern fn retain_bool_encode_payload(value: BoolEncodePayload) void

let values: ScriptList[bool] = json_bool_array("[true,false]");
let encoded: []u8 = json_bool_array_encode(values);
if (encoded.len == 0) { return 1; }
let payload: BoolEncodePayload = BoolEncodePayload{ .values = values };
retain_bool_encode_payload(payload);
return 0;
