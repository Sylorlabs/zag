@import("std:json") as json
@import("std:list") as list

extern fn _zag_allocator_live_bytes() i64

// Every strict parser failure owns a temporary ArrayList, including failures
// after one or more values have been appended.  Cleanup is checked immediately
// so a later successful parse cannot hide a leaked partial result.
fn expect_bad_balanced(source: []u8) i32 {
    let before: i64 = _zag_allocator_live_bytes();
    let result: json.JsonFloatArrayResult = json.json_parse_float_array(source);
    if (result.ok != 0) {
        json.json_float_array_result_free(&result);
        return 0;
    }
    json.json_float_array_result_free(&result);
    json.json_float_array_result_free(&result);
    return (_zag_allocator_live_bytes() == before) as i32;
}

fn expect_bad_bounded_balanced(source: []u8, max_bytes: i32,
    max_values: i32, expected_values: i32) i32 {
    let before: i64 = _zag_allocator_live_bytes();
    let result: json.JsonFloatArrayResult =
        json.json_parse_float_array_bounded(source, max_bytes, max_values);
    if (result.ok != 0 || result.values.len != expected_values) {
        json.json_float_array_result_free(&result);
        return 0;
    }
    json.json_float_array_result_free(&result);
    json.json_float_array_result_free(&result);
    return (_zag_allocator_live_bytes() == before) as i32;
}

fn expect_good_bounded_balanced(source: []u8, max_bytes: i32,
    max_values: i32, expected_values: i32) i32 {
    let before: i64 = _zag_allocator_live_bytes();
    let result: json.JsonFloatArrayResult =
        json.json_parse_float_array_bounded(source, max_bytes, max_values);
    let good: i32 = (result.ok == 1 &&
        result.values.len == expected_values) as i32;
    json.json_float_array_result_free(&result);
    return (good == 1 && _zag_allocator_live_bytes() == before) as i32;
}

fn make_over_value_source() list.ArrayList[u8] {
    let count: i32 = json.json_default_max_values() + 1;
    let source: list.ArrayList[u8] = list.make[u8](count * 5 + 1);
    let at: i32 = 0;
    source.data[at] = 91; at = at + 1;
    let i: i32 = 0;
    while (i < count) {
        if (i > 0) { source.data[at] = 44; at = at + 1; }
        source.data[at] = 48; at = at + 1;
        source.data[at] = 46; at = at + 1;
        source.data[at] = 53; at = at + 1;
        i = i + 1;
    }
    source.data[at] = 93; at = at + 1;
    source.len = at;
    return source;
}

fn main() i32 {
    let before: i64 = _zag_allocator_live_bytes();
    let parsed: json.JsonFloatArrayResult =
        json.json_parse_float_array(" [1.5, -0.0, 2e1, -3.25E-2] ");
    if (parsed.ok != 1 || parsed.values.len != 4 ||
        parsed.values.data[0] != 1.5 || parsed.values.data[1] != 0.0 ||
        parsed.values.data[2] != 20.0 || parsed.values.data[3] != -0.0325) {
        json.json_float_array_result_free(&parsed);
        return 1;
    }
    json.json_float_array_result_free(&parsed);
    json.json_float_array_result_free(&parsed);
    let empty: json.JsonFloatArrayResult = json.json_parse_float_array(" [] ");
    if (empty.ok != 1 || empty.values.len != 0) {
        json.json_float_array_result_free(&empty);
        return 2;
    }
    json.json_float_array_result_free(&empty);
    json.json_float_array_result_free(&empty);
    if (_zag_allocator_live_bytes() != before) { return 3; }

    if (expect_bad_balanced("[1.0,]") == 0 ||
        expect_bad_balanced("[1.0] trailing") == 0 ||
        expect_bad_balanced("[1 2]") == 0 ||
        expect_bad_balanced("[NaN]") == 0 ||
        expect_bad_balanced("[1e]") == 0 ||
        expect_bad_balanced("[01]") == 0 ||
        expect_bad_balanced("[-]") == 0 ||
        expect_bad_balanced("1.0") == 0) { return 4; }

    if (expect_good_bounded_balanced("[1.25,-2e1]", 32, 2, 2) == 0 ||
        expect_bad_bounded_balanced("[1.0]", 4, 65536, 0) == 0 ||
        expect_bad_bounded_balanced("[1.0,2.0]", 32, 1, 1) == 0 ||
        expect_bad_bounded_balanced("[1.0]", 0, 4, 0) == 0 ||
        expect_bad_bounded_balanced("[1.0]", 1048577, 4, 0) == 0 ||
        expect_bad_bounded_balanced("[1.0]", 32, 65537, 0) == 0) {
        return 5;
    }

    // Exercise the default value limit after thousands of successful appends,
    // then verify that releasing the partial result restores allocator state.
    let over_values: list.ArrayList[u8] = make_over_value_source();
    let over_values_before: i64 = _zag_allocator_live_bytes();
    let over_values_result: json.JsonFloatArrayResult =
        json.json_parse_float_array(over_values.data[0..over_values.len]);
    if (over_values_result.ok != 0 ||
        over_values_result.values.len != json.json_default_max_values()) {
        json.json_float_array_result_free(&over_values_result);
        list.free[u8](&over_values);
        return 6;
    }
    json.json_float_array_result_free(&over_values_result);
    json.json_float_array_result_free(&over_values_result);
    if (_zag_allocator_live_bytes() != over_values_before) {
        list.free[u8](&over_values);
        return 7;
    }
    list.free[u8](&over_values);
    return 0;
}
