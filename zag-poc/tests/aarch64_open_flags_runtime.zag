fn arm_open_c_path(path: []u8) *u8 {
    let out: *u8 = _zag_malloc(path.len + 1) as *u8;
    let i: i32 = 0;
    while (i < path.len) {
        out[i] = path[i];
        i = i + 1;
    }
    out[path.len] = 0;
    return out;
}

fn arm_open_x86(path: []u8, flags: i64, mode: i64) i64 {
    let cpath: *u8 = arm_open_c_path(path);
    let fd: i64 = _zag_raw_syscall(
        2, cpath as i64, flags, mode, 0, 0, 0
    );
    _zag_free(cpath as *i8);
    return fd;
}

fn arm_openat_x86(path: []u8, flags: i64, mode: i64) i64 {
    let cpath: *u8 = arm_open_c_path(path);
    let fd: i64 = _zag_raw_syscall(
        257, 0 - 100, cpath as i64, flags, mode, 0, 0
    );
    _zag_free(cpath as *i8);
    return fd;
}

fn arm_open_close(fd: i64) i64 {
    return _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
}

fn arm_open_fdinfo_has_cloexec(fd: i64) i32 {
    let fd_text: []u8 = _zag_i64_to_str(fd);
    let fdinfo_path: []u8 = _zag_str_concat("/proc/self/fdinfo/", fd_text);
    let fdinfo: []u8 = _zag_read_file(fdinfo_path);
    if (fdinfo.len < 0) { return 0; }

    let i: i32 = 0;
    while (i + 7 < fdinfo.len) {
        if (fdinfo[i] == 102 && fdinfo[i + 1] == 108 &&
            fdinfo[i + 2] == 97 && fdinfo[i + 3] == 103 &&
            fdinfo[i + 4] == 115 && fdinfo[i + 5] == 58 &&
            fdinfo[i + 6] == 9) {
            let j: i32 = i + 7;
            let flags: i64 = 0;
            let digits: i32 = 0;
            while (j < fdinfo.len && fdinfo[j] >= 48 && fdinfo[j] <= 55) {
                flags = flags * 8 + ((fdinfo[j] - 48) as i64);
                digits = digits + 1;
                j = j + 1;
            }
            return (digits > 0 && (flags & 524288) != 0) as i32;
        }
        i = i + 1;
    }
    return 0;
}

fn main() i32 {
    if (_zag_argc() != 3) { return 1; }
    let created_path: []u8 = _zag_arg(1);
    let symlink_path: []u8 = _zag_arg(2);

    // x86-64 O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC, mode 0600.
    let created: i64 = arm_open_x86(created_path, 655553, 384);
    if (created < 0) { return 2; }
    if (arm_open_fdinfo_has_cloexec(created) == 0) {
        let _close_missing_cloexec: i64 = arm_open_close(created);
        return 3;
    }
    if (arm_open_close(created) != 0) { return 7; }

    // O_EXCL must survive translation: the same create must now fail.
    let duplicate: i64 = arm_open_x86(created_path, 655553, 384);
    if (duplicate >= 0) { let _close_duplicate: i64 = arm_open_close(duplicate); }
    if (duplicate != 0 - 17) { return 4; } // EEXIST

    // x86-64 O_DIRECTORY|O_NOFOLLOW|O_CLOEXEC must reject a regular file.
    let directory_only: i64 = arm_openat_x86(created_path, 720896, 0);
    if (directory_only >= 0) { let _close_directory: i64 = arm_open_close(directory_only); }
    if (directory_only != 0 - 20) { return 5; } // ENOTDIR

    // x86-64 O_NOFOLLOW|O_CLOEXEC must reject the prepared final symlink.
    let nofollow: i64 = arm_openat_x86(symlink_path, 655360, 0);
    if (nofollow >= 0) { let _close_nofollow: i64 = arm_open_close(nofollow); }
    if (nofollow != 0 - 40) { return 6; } // ELOOP
    return 42;
}
