script;

let values = {"alpha": "one", "beta": "two", "alpha": "updated", "": "empty", "line\n": "tab\t", "{{literal}}": "value {{and}}"};
if (text_map_len(values) != 5 ||
    !@strEq(text_map_get(values, "alpha"), "updated") ||
    !@strEq(text_map_get(values, ""), "empty") ||
    !@strEq(text_map_get(values, "line\n"), "tab\t") ||
    !@strEq(text_map_get(values, "{literal}"), "value {and}")) { return 1; }

if (text_map_put(values, "gamma", "three") != 0 ||
    text_map_put(values, "delta", "four") != 0 ||
    text_map_put(values, "epsilon", "five") != 0 ||
    text_map_put(values, "zeta", "six") != 0 ||
    text_map_put(values, "eta", "seven") != 0 ||
    text_map_len(values) != 10 || !text_map_has(values, "gamma") ||
    !@strEq(text_map_get(values, "gamma"), "three") ||
    !@strEq(text_map_get(values, "eta"), "seven")) { return 2; }
if (text_map_del(values, "beta") != 0 || text_map_has(values, "beta") ||
    text_map_put(values, "beta", "reinserted") != 0 ||
    !@strEq(text_map_get(values, "beta"), "reinserted") ||
    text_map_len(values) != 10) { return 3; }
if (text_map_clear(values) != 0 || text_map_len(values) != 0 ||
    text_map_has(values, "alpha") || text_map_failed(values) != 0) { return 4; }
return 0;
