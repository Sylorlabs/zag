// Pure-Zag contract for the closed Mach-O SQLite import family and ordinals.
@import("../selfhost/native/macho_arm64.zag")

fn main() i32 {
    let sqlite:ArrayList[[]u8]=make[[]u8](8);
    push[[]u8](&sqlite,"sqlite3_open");
    push[[]u8](&sqlite,"sqlite3_close");
    push[[]u8](&sqlite,"sqlite3_prepare_v2");
    push[[]u8](&sqlite,"sqlite3_bind_int64");
    push[[]u8](&sqlite,"sqlite3_step");
    push[[]u8](&sqlite,"sqlite3_column_int64");
    push[[]u8](&sqlite,"sqlite3_finalize");
    push[[]u8](&sqlite,"sqlite3_changes");
    if(mo_imports_known(sqlite)!=1||mo_need_sqlite(sqlite)!=1){return 1;}
    let i:i32=0;
    while(i<sqlite.len){if(mo_import_ordinal(sqlite.data[i])!=4){return 2;}i=i+1;}
    if(mo_resolved_import_ordinal("sqlite3_open",0,0)!=2){return 3;}
    if(mo_resolved_import_ordinal("sqlite3_open",1,0)!=3){return 4;}
    if(mo_resolved_import_ordinal("sqlite3_open",0,1)!=3){return 5;}
    if(mo_resolved_import_ordinal("sqlite3_open",1,1)!=4){return 6;}
    let invalid:ArrayList[[]u8]=make[[]u8](1);
    push[[]u8](&invalid,"sqlite3_open_v2");
    if(mo_imports_known(invalid)!=0||mo_import_ordinal("sqlite3_open_v2")!=0){return 7;}
    if(_zag_argc()>1){
        // mov w0,#0; ret. The probe is inspected, not used as a replacement
        // for the executable adapter conformance below.
        let text:ArrayList[u8]=make[u8](8);
        push[u8](&text,0);push[u8](&text,0);push[u8](&text,128);push[u8](&text,82);
        push[u8](&text,192);push[u8](&text,3);push[u8](&text,95);push[u8](&text,214);
        let data:ArrayList[u8]=make[u8](1);
        if(write_macho_arm64_dynamic(_zag_arg(1),text,0,data,sqlite)!=0){return 8;}
    }
    _zag_println("macos sqlite writer contract: exact=8 ordinals=4 closed=1");
    return 0;
}
