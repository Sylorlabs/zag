@import("../selfhost/std/process_platform.zag") as platform

fn main() i32 {
    let caps: platform.ProcessPlatformCapabilities = platform.process_platform_capabilities();
    if (caps.platform != platform.process_platform_linux() &&
        caps.platform != platform.process_platform_darwin()) { return 1; }
    if (caps.process_group != 1 || caps.nonblocking_observation != 1 ||
        caps.deadline_wait != 1 || caps.fail_closed != 1) { return 2; }
    if (platform.process_platform_supervision_ready(caps) != 1) { return 3; }
    if (platform.process_platform_wait_readable(-2, 1) >= 0) { return 4; }
    if (platform.process_platform_wait_readable(0, 60001) >= 0) { return 5; }
    let again: i64 = -11;
    let other: i64 = -35;
    if (caps.platform == platform.process_platform_darwin()) { again = -35; other = -11; }
    if (platform.process_platform_read_disposition(again) != 0) { return 6; }
    if (platform.process_platform_read_disposition(other) != 2) { return 9; }
    if (platform.process_platform_read_disposition(0 - 4) != 0) { return 7; }
    if (platform.process_platform_read_disposition(0 - 99) != 2) { return 8; }
    if (caps.isolation != 0) { return 10; }
    let denied: platform.ProcessIsolationResult = platform.process_platform_check_isolation(platform.ProcessIsolationRequirement.SecuritySandbox);
    if (denied.accepted != 0 || denied.sandboxed != 0 || denied.status != platform.ProcessIsolationStatus.Unsupported) { return 11; }
    caps.platform = 0;
    if (platform.process_platform_supervision_ready(caps) != 0) { return 12; }
    caps.platform = platform.process_platform_linux(); caps.deadline_wait = 0;
    if (platform.process_platform_supervision_ready(caps) != 0) { return 13; }
    return 0;
}
