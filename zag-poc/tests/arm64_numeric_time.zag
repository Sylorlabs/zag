@import("../std/rt.zag")

fn conversion_contract() i32 {
    if (@intToFloat(0) != 0.0) { return 1; }
    if (@intToFloat(0 - 17) != 0.0 - 17.0) { return 2; }
    if (@intToFloat(9007199254740992) != 9007199254740992.0) { return 3; }
    // 2^53+1 is the first positive i64 not exactly representable as f64;
    // SCVTF/CVTSI2SD must both round it to the even 2^53 endpoint.
    if (@intToFloat(9007199254740993) != 9007199254740992.0) { return 4; }
    if (@floatToInt(3.99) != 3) { return 5; }
    if (@floatToInt(0.0 - 3.99) != 0 - 3) { return 6; }
    if (@floatToInt(2147483647.75) != 2147483647) { return 7; }
    return 0;
}

fn monotonic_contract() i32 {
    let start: i64 = _zag_clock_monotonic_ms();
    if (start <= 0) { return 8; }
    // Monotonic milliseconds are boot-relative, not Unix-epoch wall time.
    // A 10^12 ms ceiling leaves over 31 years of continuous uptime headroom
    // while strictly rejecting the old gettimeofday implementation.
    if (start >= 1000000000000) { return 9; }
    let pause_output: []u8 = _zag_exec_capture("sleep 0.03");
    if (pause_output.len != 0) { return 10; }
    _zag_str_free(pause_output);
    let finish: i64 = _zag_clock_monotonic_ms();
    if (finish < start) { return 11; }
    let elapsed: i64 = finish - start;
    if (elapsed < 10) { return 12; }
    if (elapsed > 5000) { return 13; }
    return 0;
}

fn main() i32 {
    let status: i32 = conversion_contract();
    if (status != 0) { return status; }
    status = monotonic_contract();
    if (status != 0) { return status; }
    return 42;
}
