@import("std:database_kv") as contract
@import("std:database_memory") as memory

extern fn _zag_allocator_live_bytes() i64

struct ConformanceState { passed: i32, failed: i32 }

fn expect(state: *ConformanceState, condition: bool) void {
    if (condition) { state.*.passed = state.*.passed + 1; }
    else { state.*.failed = state.*.failed + 1; }
}

fn main() i32 {
    let state: ConformanceState = ConformanceState{.passed=0,.failed=0};
    let before: i64 = _zag_allocator_live_bytes();

    let zero: memory.MemoryKv = memory.memory_kv_open(0);
    expect(&state, zero.status == contract.database_kv_invalid() && zero.open == 0);
    let too_large: memory.MemoryKv =
        memory.memory_kv_open(contract.database_kv_max_capacity() + 1);
    expect(&state, too_large.status == contract.database_kv_invalid() &&
        too_large.open == 0);

    let database: memory.MemoryKv = memory.memory_kv_open(2);
    expect(&state, database.status == contract.database_kv_ok() &&
        database.open == 1);
    let count: i32 = 99;
    expect(&state, memory.memory_kv_count(&database, &count) ==
        contract.database_kv_ok() && count == 0);

    let value: i64 = 99;
    expect(&state, memory.memory_kv_get(&database, 404, &value) ==
        contract.database_kv_missing() && value == 0);
    expect(&state, memory.memory_kv_put(&database, 4294967297, 1099511627776) ==
        contract.database_kv_ok());
    expect(&state, memory.memory_kv_put(&database, 0 - 4294967299,
        0 - 1099511627777) ==
        contract.database_kv_ok());
    expect(&state, memory.memory_kv_put(&database, 11, 99) ==
        contract.database_kv_limit());
    expect(&state, memory.memory_kv_put(&database, 4294967297,
        1099511627818) ==
        contract.database_kv_ok());
    expect(&state, memory.memory_kv_get(&database, 4294967297, &value) ==
        contract.database_kv_ok() && value == 1099511627818);
    expect(&state, memory.memory_kv_delete(&database, 404) ==
        contract.database_kv_missing());
    expect(&state, memory.memory_kv_delete(&database, 0 - 4294967299) ==
        contract.database_kv_ok());
    expect(&state, memory.memory_kv_count(&database, &count) ==
        contract.database_kv_ok() && count == 1);
    expect(&state, memory.memory_kv_close(&database) ==
        contract.database_kv_ok() && database.open == 0 &&
        _zag_allocator_live_bytes() == before);
    value = 99;
    expect(&state, memory.memory_kv_get(&database, 4294967297, &value) ==
        contract.database_kv_invalid() && value == 0);
    expect(&state, memory.memory_kv_close(&database) ==
        contract.database_kv_invalid());

    if (state.failed != 0 || state.passed != 16) { return 1; }
    _zag_println("database memory conformance: pass=16 fail=0");
    return 0;
}
