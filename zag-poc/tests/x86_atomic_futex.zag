// A nonblocking real-kernel proof for the bounded Linux futex intrinsics.
// The wait expected value deliberately mismatches the word, so futex(2)
// returns -EAGAIN rather than sleeping.  Wake has no waiter and returns zero.
fn main() i32 {
    unsafe {
        let word:i32 = 7;
        let p:*const i32 = (&word) as *const i32;
        let wait_rc:i64 = @atomicWait32(p, 8);
        let wake_rc:i64 = @atomicWake32(p, 1);
        if (wait_rc == 0 - 11 && wake_rc == 0) { return 42; }
        return 1;
    }
}
