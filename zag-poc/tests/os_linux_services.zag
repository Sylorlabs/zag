@import("std:list")
@import("std:os_linux") as os
@import("std:rt")

extern fn _zag_allocator_live_bytes() i64

fn same_bytes(left: []u8, right: []u8) i32 {
    if (left.len != right.len) { return 0; }
    let i: i32 = 0;
    while (i < left.len) {
        if (left[i] != right[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn all_byte(value: []u8, expected: u8) i32 {
    let i: i32 = 0;
    while (i < value.len) {
        if (value[i] != expected) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn fill_byte(value: []u8, byte: u8) void {
    let i: i32 = 0;
    while (i < value.len) {
        value[i] = byte;
        i = i + 1;
    }
}

fn main() i32 {
    let baseline: i64 = _zag_allocator_live_bytes();

    let invalid_clock: os.OsLinuxClockResult = os.os_linux_clock_read(99);
    if (invalid_clock.ok != 0 ||
        invalid_clock.code != os.os_linux_status_invalid_argument() ||
        invalid_clock.seconds != 0 || invalid_clock.nanoseconds != 0) {
        return 1;
    }

    let monotonic_before: os.OsLinuxClockResult = os.os_linux_monotonic();
    let realtime: os.OsLinuxClockResult = os.os_linux_realtime();
    if (monotonic_before.ok != 1 || realtime.ok != 1 ||
        monotonic_before.nanoseconds < 0 ||
        monotonic_before.nanoseconds >= 1000000000 ||
        realtime.nanoseconds < 0 || realtime.nanoseconds >= 1000000000 ||
        realtime.seconds <= 0) { return 2; }

    let delay: ArrayList[i64] = make[i64](2);
    delay.data[0] = 0;
    delay.data[1] = 1000000;
    let sleep_rc: i64 = _zag_raw_syscall(
        35, delay.data as i64, 0, 0, 0, 0, 0
    );
    let monotonic_after: os.OsLinuxClockResult = os.os_linux_monotonic();
    if (sleep_rc != 0 || monotonic_after.ok != 1 ||
        monotonic_after.seconds < monotonic_before.seconds ||
        (monotonic_after.seconds == monotonic_before.seconds &&
         monotonic_after.nanoseconds < monotonic_before.nanoseconds)) {
        return 3;
    }

    let first: ArrayList[u8] = make[u8](64);
    let second: ArrayList[u8] = make[u8](64);
    fill_byte(first.data[0..64], 0);
    fill_byte(second.data[0..64], 0);
    let first_result: os.OsLinuxRandomResult =
        os.os_linux_secure_random_fill(first.data[0..64]);
    let second_result: os.OsLinuxRandomResult =
        os.os_linux_secure_random_fill_bounded(second.data[0..64], 8);
    if (first_result.ok != 1 || first_result.transferred != 64 ||
        first_result.calls < 1 ||
        first_result.calls > os.os_linux_random_max_calls() ||
        second_result.ok != 1 || second_result.transferred != 64 ||
        second_result.calls < 1 || second_result.calls > 8 ||
        all_byte(first.data[0..64], 0) != 0 ||
        all_byte(second.data[0..64], 0) != 0 ||
        same_bytes(first.data[0..64], second.data[0..64]) != 0) {
        return 4;
    }

    let sentinel: ArrayList[u8] = make[u8](8);
    fill_byte(sentinel.data[0..8], 165);
    let empty_result: os.OsLinuxRandomResult =
        os.os_linux_secure_random_fill(sentinel.data[0..0]);
    let zero_calls: os.OsLinuxRandomResult =
        os.os_linux_secure_random_fill_bounded(sentinel.data[0..8], 0);
    let too_many_calls: os.OsLinuxRandomResult =
        os.os_linux_secure_random_fill_bounded(
            sentinel.data[0..8], os.os_linux_random_max_calls() + 1
        );
    if (empty_result.code != os.os_linux_status_invalid_argument() ||
        zero_calls.code != os.os_linux_status_invalid_argument() ||
        too_many_calls.code != os.os_linux_status_invalid_argument() ||
        all_byte(sentinel.data[0..8], 165) == 0) { return 5; }

    let oversized_length: i32 = os.os_linux_random_max_bytes() + 1;
    let oversized: ArrayList[u8] = make[u8](oversized_length);
    fill_byte(oversized.data[0..oversized_length], 90);
    let oversized_result: os.OsLinuxRandomResult =
        os.os_linux_secure_random_fill(oversized.data[0..oversized_length]);
    if (oversized_result.ok != 0 ||
        oversized_result.code != os.os_linux_status_limit() ||
        oversized_result.transferred != 0 || oversized_result.calls != 0 ||
        all_byte(oversized.data[0..oversized_length], 90) == 0) { return 6; }

    free[i64](&delay);
    free[u8](&first);
    free[u8](&second);
    free[u8](&sentinel);
    free[u8](&oversized);
    if (_zag_allocator_live_bytes() != baseline) { return 7; }
    return 0;
}
