@import("std:list")

fn identity65(v: vsa_b<65>) vsa_b<65> { return v; }
fn bind65(a: vsa_b<65>, b: vsa_b<65>) vsa_b<65> { return a ^ b; }

fn one_word(value: i64) ArrayList[i64] {
    let words: ArrayList[i64] = make[i64](1);
    push[i64](&words, value);
    return words;
}

fn main() i32 {
    if (@sizeOf[vsa_b<1>]() != 8 || @sizeOf[vsa_b<63>]() != 8 ||
        @sizeOf[vsa_b<64>]() != 8 || @sizeOf[vsa_b<65>]() != 16 ||
        @sizeOf[vsa_b<128>]() != 16 || @sizeOf[vsa_b<129>]() != 24) {
        return 1;
    }
    if (@sizeOf[vsa_b<2048>]() != 256 || @sizeOf[vsa_b<4096>]() != 512 ||
        @sizeOf[vsa_b<8192>]() != 1024 || @sizeOf[vsa_b<10000>]() != 1256 ||
        @sizeOf[vsa_b<16384>]() != 2048) { return 2; }
    if (@vsaDimension[vsa_b<10000>]() != 10000 ||
        @vsaWordCount[vsa_b<10000>]() != 157) { return 3; }

    let one_bits: ArrayList[i64] = one_word(0 - 1);
    let v1: vsa_b<1> = @vsaFromWords[vsa_b<1>](one_bits.data[0..1]);
    let v63: vsa_b<63> = @vsaFromWords[vsa_b<63>](one_bits.data[0..1]);
    let v64: vsa_b<64> = @vsaFromWords[vsa_b<64>](one_bits.data[0..1]);
    free[i64](&one_bits);
    if (@vsaWord(v1, 0) != 1 || @vsaHamming(v1, @vsaZero[vsa_b<1>]()) != 1) { return 4; }
    if (@vsaWord(v63, 0) != 9223372036854775807 ||
        @vsaHamming(v63, @vsaZero[vsa_b<63>]()) != 63) { return 5; }
    if (@vsaWord(v64, 0) != (0 - 1) ||
        @vsaHamming(v64, @vsaZero[vsa_b<64>]()) != 64) { return 6; }

    let a_words: ArrayList[i64] = make[i64](2);
    push[i64](&a_words, 0 - 1);
    push[i64](&a_words, 0 - 1);
    let b_words: ArrayList[i64] = make[i64](2);
    push[i64](&b_words, 10);
    push[i64](&b_words, 0);
    let a: vsa_b<65> = @vsaFromWords[vsa_b<65>](a_words.data[0..2]);
    let b: vsa_b<65> = @vsaFromWords[vsa_b<65>](b_words.data[0..2]);
    let v128: vsa_b<128> = @vsaFromWords[vsa_b<128>](a_words.data[0..2]);
    let b128: vsa_b<128> = @vsaFromWords[vsa_b<128>](b_words.data[0..2]);
    free[i64](&b_words);
    free[i64](&a_words);
    let zero: vsa_b<65> = @vsaZero[vsa_b<65>]();
    if (@vsaWord(a, 0) != (0 - 1) || @vsaWord(a, 1) != 1) { return 7; }
    if (@vsaHamming(a, zero) != 65 || @vsaHamming(identity65(a), a) != 0) { return 8; }

    let bound: vsa_b<65> = bind65(a, b);
    let intersected: vsa_b<65> = a & b;
    let united: vsa_b<65> = b | zero;
    let majority: vsa_b<65> = @vsaMajority3[vsa_b<65>](a, b, zero);
    if (@vsaWord(bound, 0) != ((0 - 1) ^ 10) || @vsaWord(bound, 1) != 1) { return 9; }
    if (@vsaWord(intersected, 0) != 10 || @vsaWord(intersected, 1) != 0) { return 10; }
    if (@vsaHamming(united, b) != 0 || @vsaHamming(majority, intersected) != 0) { return 11; }

    if (@vsaHamming(v128, @vsaZero[vsa_b<128>]()) != 128) { return 12; }
    let bound128: vsa_b<128> = v128 ^ b128;
    let intersected128: vsa_b<128> = v128 & b128;
    let united128: vsa_b<128> = b128 | @vsaZero[vsa_b<128>]();
    let majority128: vsa_b<128> = @vsaMajority3[vsa_b<128>](
        v128, b128, @vsaZero[vsa_b<128>]());
    if (@vsaWord(bound128, 0) != ((0 - 1) ^ 10) ||
        @vsaWord(bound128, 1) != (0 - 1) ||
        @vsaHamming(intersected128, b128) != 0) { return 13; }
    if (@vsaHamming(united128, b128) != 0 ||
        @vsaHamming(majority128, intersected128) != 0) { return 14; }

    // Three words force the SIMD lowering to process one full 128-bit prefix
    // and the scalar authority to mask the single live bit in the final word.
    let a129_words: ArrayList[i64] = make[i64](3);
    push[i64](&a129_words, 43690); // 0xaaaa
    push[i64](&a129_words, 61680); // 0xf0f0
    push[i64](&a129_words, 0 - 1);
    let b129_words: ArrayList[i64] = make[i64](3);
    push[i64](&b129_words, 52428); // 0xcccc
    push[i64](&b129_words, 4080);  // 0x0ff0
    push[i64](&b129_words, 0 - 1);
    let a129: vsa_b<129> = @vsaFromWords[vsa_b<129>](a129_words.data[0..3]);
    let b129: vsa_b<129> = @vsaFromWords[vsa_b<129>](b129_words.data[0..3]);
    free[i64](&b129_words);
    free[i64](&a129_words);
    let zero129: vsa_b<129> = @vsaZero[vsa_b<129>]();
    if (@vsaWord(a129, 2) != 1 || @vsaWord(b129, 2) != 1 ||
        @vsaHamming(a129, zero129) != 17) { return 15; }
    let bound129: vsa_b<129> = a129 ^ b129;
    let intersected129: vsa_b<129> = a129 & b129;
    let united129: vsa_b<129> = b129 | zero129;
    let majority129: vsa_b<129> = @vsaMajority3[vsa_b<129>](
        a129, b129, zero129);
    if (@vsaWord(bound129, 0) != 26214 ||
        @vsaWord(bound129, 1) != 65280 ||
        @vsaWord(bound129, 2) != 0) { return 16; }
    if (@vsaWord(intersected129, 0) != 34952 ||
        @vsaWord(intersected129, 1) != 240 ||
        @vsaWord(intersected129, 2) != 1 ||
        @vsaWord(united129, 0) != 52428 ||
        @vsaWord(united129, 1) != 4080 ||
        @vsaWord(united129, 2) != 1 ||
        @vsaHamming(united129, b129) != 0 ||
        @vsaHamming(majority129, intersected129) != 0) { return 17; }
    return 42;
}
