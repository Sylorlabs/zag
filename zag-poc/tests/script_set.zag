// Script-owned homogeneous i32 set smoke and collision/growth contract.

script;

let values = set();
if (set_failed(values) != 0 || set_len(values) != 0) { return 1; }
if (set_add(values, 1) != 0 || set_add(values, 1) != 2) { return 2; }
if (set_add(values, -9) != 0 || !set_has(values, -9) ||
    !set_has(values, 1) || set_len(values) != 2) { return 3; }
let i: i32 = 0;
while (i < 64) {
    if (set_add(values, i * 17) == 1) { return 4; }
    i = i + 1;
}
if (set_len(values) != 66 || !set_has(values, 51 * 17)) { return 5; }
if (set_del(values, 1) != 0 || set_del(values, 1) != 1 ||
    set_has(values, 1) || set_len(values) != 65) { return 6; }
if (set_add(values, 1) != 0 || !set_has(values, 1) || set_len(values) != 66) { return 7; }

// Clear scrubs every retained key/state slot, preserves the table allocation,
// and allows deterministic reuse after a tombstone has been created.
let cleared = set();
if (set_add(cleared, 1) != 0 || set_add(cleared, 9) != 0 ||
    set_del(cleared, 9) != 0) { return 8; }
let old_keys: *i32 = cleared.keys;
let old_used: *u8 = cleared.used;
let old_cap: i32 = cleared.cap;
let slot: i32 = 0;
while (slot < old_cap) {
    old_keys[slot] = 1234;
    slot = slot + 1;
}
if (set_clear(cleared) != 0 || set_len(cleared) != 0 ||
    set_failed(cleared) != 0 || cleared.cap != old_cap ||
    cleared.keys != old_keys || cleared.used != old_used) { return 9; }
slot = 0;
while (slot < old_cap) {
    if (old_keys[slot] != 0 || old_used[slot] != 0) { return 10; }
    slot = slot + 1;
}
if (set_add(cleared, 42) != 0 || !set_has(cleared, 42) ||
    set_len(cleared) != 1) { return 11; }

let forged = set();
forged.keys[0] = 77;
forged.cap = 0;
if (set_clear(forged) != 1 || forged.failed != 1 || forged.keys[0] != 77) { return 12; }

let non_power = set();
non_power.keys[0] = 88;
non_power.cap = 10;
if (set_clear(non_power) != 1 || non_power.failed != 1 || non_power.keys[0] != 88) { return 13; }

let already_failed = set();
already_failed.keys[0] = 99;
already_failed.failed = 1;
if (set_clear(already_failed) != 1 || already_failed.failed != 1 ||
    already_failed.keys[0] != 99 || already_failed.used[0] != 0) { return 14; }

let mismatched = set();
mismatched.keys[0] = 55;
mismatched.count = 1;
if (set_clear(mismatched) != 1 || mismatched.failed != 1 ||
    mismatched.keys[0] != 55 || mismatched.used[0] != 0) { return 15; }

let bad_state = set();
bad_state.keys[0] = 66;
bad_state.used[0] = 3;
if (set_clear(bad_state) != 1 || bad_state.failed != 1 ||
    bad_state.keys[0] != 66 || bad_state.used[0] != 3) { return 16; }
return 0;
