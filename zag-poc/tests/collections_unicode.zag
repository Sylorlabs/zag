@import("std:rt")
@import("std:list") as list
@import("std:hashmap") as hashmap
@import("std:set") as setlib
@import("std:range") as ranges
@import("std:iterator") as iterator
@import("std:utf8") as utf8

extern fn _zag_allocator_live_bytes() i64

fn constant_hash(key: i32) i32 { return key - key; }
fn wrap_hash(key: i32) i32 { return 7 + (key - key); }
fn negative_hash(key: i32) i32 { return (0 - 1) + (key - key); }
fn identity_hash(key: i32) i32 { return key; }
fn integer_equal(a: i32, b: i32) bool { return a == b; }

fn hashmap_collision_test() i32 {
    let map: hashmap.HashMap[i32,i32] =
        hashmap.make[i32,i32](8, constant_hash, integer_equal);
    hashmap.put[i32,i32](&map, 10, 100);
    hashmap.put[i32,i32](&map, 20, 200);
    hashmap.put[i32,i32](&map, 30, 300);
    if (!hashmap.del[i32,i32](&map, 10)) {
        hashmap.free[i32,i32](&map); return 1;
    }
    if ((hashmap.get[i32,i32](map, 30) orelse 0) != 300 ||
        !hashmap.has[i32,i32](map, 20) ||
        hashmap.has[i32,i32](map, 10)) {
        hashmap.free[i32,i32](&map); return 2;
    }

    // Updating 30 must traverse the tombstone for 10. It must not create a
    // duplicate entry in that earlier slot.
    hashmap.put[i32,i32](&map, 30, 333);
    if (hashmap.count[i32,i32](map) != 2 ||
        (hashmap.get[i32,i32](map, 30) orelse 0) != 333) {
        hashmap.free[i32,i32](&map); return 3;
    }

    // A genuinely new colliding key reuses the first tombstone.
    hashmap.put[i32,i32](&map, 40, 400);
    if (hashmap.count[i32,i32](map) != 3 ||
        !hashmap.has[i32,i32](map, 20) ||
        !hashmap.has[i32,i32](map, 30) ||
        !hashmap.has[i32,i32](map, 40)) {
        hashmap.free[i32,i32](&map); return 4;
    }
    if (!hashmap.del[i32,i32](&map, 20) ||
        hashmap.del[i32,i32](&map, 999) ||
        !hashmap.has[i32,i32](map, 30) ||
        !hashmap.has[i32,i32](map, 40)) {
        hashmap.free[i32,i32](&map); return 5;
    }
    hashmap.free[i32,i32](&map);
    if (map.entries != null as *hashmap.HEntry[i32,i32] ||
        map.cap != 0 || map.count != 0) { return 6; }

    // Also cover a cluster wrapping across the final bucket and a caller hash
    // with the sign bit set.
    let wrapped: hashmap.HashMap[i32,i32] =
        hashmap.make[i32,i32](8, wrap_hash, integer_equal);
    hashmap.put[i32,i32](&wrapped, 1, 11);
    hashmap.put[i32,i32](&wrapped, 2, 22);
    hashmap.put[i32,i32](&wrapped, 3, 33);
    if (!hashmap.del[i32,i32](&wrapped, 1) ||
        (hashmap.get[i32,i32](wrapped, 3) orelse 0) != 33) {
        hashmap.free[i32,i32](&wrapped); return 7;
    }
    hashmap.free[i32,i32](&wrapped);

    let negative: hashmap.HashMap[i32,i32] =
        hashmap.make[i32,i32](8, negative_hash, integer_equal);
    hashmap.put[i32,i32](&negative, 9, 99);
    if ((hashmap.get[i32,i32](negative, 9) orelse 0) != 99) {
        hashmap.free[i32,i32](&negative); return 8;
    }
    hashmap.free[i32,i32](&negative);

    // Populate every bucket with a tombstone while active count returns to
    // zero. Missing lookup must terminate after cap probes, and insertion must
    // reuse a tombstone even though no never-used bucket remains.
    let all_tombstones: hashmap.HashMap[i32,i32] =
        hashmap.make[i32,i32](8, identity_hash, integer_equal);
    let bucket: i32 = 0;
    while (bucket < 8) {
        hashmap.put[i32,i32](&all_tombstones, bucket, bucket + 100);
        if (!hashmap.del[i32,i32](&all_tombstones, bucket)) {
            hashmap.free[i32,i32](&all_tombstones); return 9;
        }
        bucket = bucket + 1;
    }
    if (hashmap.has[i32,i32](all_tombstones, 99) ||
        (hashmap.get[i32,i32](all_tombstones, 99) orelse 1234) != 1234 ||
        hashmap.del[i32,i32](&all_tombstones, 99)) {
        hashmap.free[i32,i32](&all_tombstones); return 10;
    }
    hashmap.put[i32,i32](&all_tombstones, 16, 160);
    if (hashmap.count[i32,i32](all_tombstones) != 1 ||
        (hashmap.get[i32,i32](all_tombstones, 16) orelse 0) != 160) {
        hashmap.free[i32,i32](&all_tombstones); return 11;
    }
    hashmap.free[i32,i32](&all_tombstones);
    return 0;
}

fn set_test() i32 {
    let values: setlib.Set[i32] =
        setlib.set_make[i32](8, constant_hash, integer_equal);
    if (!setlib.set_add[i32](&values, 7) ||
        !setlib.set_add[i32](&values, 8) ||
        setlib.set_add[i32](&values, 7) ||
        setlib.set_count[i32](values) != 2 ||
        !setlib.set_contains[i32](values, 8)) {
        setlib.set_free[i32](&values); return 1;
    }
    if (!setlib.set_remove[i32](&values, 7) ||
        setlib.set_remove[i32](&values, 7) ||
        setlib.set_contains[i32](values, 7) ||
        setlib.set_count[i32](values) != 1) {
        setlib.set_free[i32](&values); return 2;
    }
    setlib.set_free[i32](&values);
    if (values.inner.entries != null as *hashmap.HEntry[i32,i32]) { return 3; }

    let ints: setlib.IntSet = setlib.int_set_make(1);
    let i: i32 = 0;
    while (i < 40) {
        if (!setlib.int_set_add(&ints, i)) {
            setlib.int_set_free(&ints); return 4;
        }
        i = i + 1;
    }
    if (setlib.int_set_count(ints) != 40 ||
        !setlib.int_set_contains(ints, 39)) {
        setlib.int_set_free(&ints); return 5;
    }
    setlib.int_set_free(&ints);
    return 0;
}

fn range_test() i32 {
    let up: ranges.RangeI64 = ranges.range_i64(1, 8, 2, 8);
    let sum: i64 = 0;
    while (true) {
        let item: ranges.RangeNextI64 = ranges.range_next_i64(&up);
        if (item.status == ranges.range_status_exhausted()) { break; }
        if (item.status != ranges.range_status_item()) { return 1; }
        sum = sum + item.value;
    }
    if (sum != 16 || ranges.range_emitted_i64(up) != 4 ||
        ranges.range_status_i64(up) != ranges.range_status_exhausted()) {
        return 2;
    }

    let down: ranges.RangeI64 = ranges.range_i64(5, 0, 0 - 2, 8);
    let down_sum: i64 = 0;
    while (true) {
        let item: ranges.RangeNextI64 = ranges.range_next_i64(&down);
        if (item.status == ranges.range_status_exhausted()) { break; }
        if (item.status != ranges.range_status_item()) { return 3; }
        down_sum = down_sum + item.value;
    }
    if (down_sum != 9 || ranges.range_emitted_i64(down) != 3) { return 4; }

    let limited: ranges.RangeI64 = ranges.range_i64(0, 100, 1, 3);
    if (ranges.range_next_i64(&limited).value != 0 ||
        ranges.range_next_i64(&limited).value != 1 ||
        ranges.range_next_i64(&limited).value != 2 ||
        ranges.range_next_i64(&limited).status != ranges.range_status_limit()) {
        return 5;
    }
    let invalid: ranges.RangeI64 = ranges.range_i64(0, 10, 0, 10);
    let invalid_budget: ranges.RangeI64 = ranges.range_i64(0, 10, 1, 0 - 1);
    let empty_up: ranges.RangeI64 = ranges.range_i64(10, 1, 1, 10);
    let empty_down: ranges.RangeI64 = ranges.range_i64(1, 10, 0 - 1, 10);
    if (ranges.range_status_i64(invalid) != ranges.range_status_invalid() ||
        ranges.range_status_i64(invalid_budget) != ranges.range_status_invalid() ||
        ranges.range_status_i64(empty_up) != ranges.range_status_exhausted() ||
        ranges.range_status_i64(empty_down) != ranges.range_status_exhausted()) {
        return 6;
    }

    let maximum: i64 = 9223372036854775807;
    let near_max: ranges.RangeI64 = ranges.range_i64(maximum - 1, maximum, 2, 4);
    if (ranges.range_next_i64(&near_max).value != maximum - 1 ||
        ranges.range_next_i64(&near_max).status !=
            ranges.range_status_exhausted()) { return 7; }
    let minimum: i64 = (0 - 9223372036854775807) - 1;
    let near_min: ranges.RangeI64 = ranges.range_i64(minimum + 1, minimum, 0 - 2, 4);
    if (ranges.range_next_i64(&near_min).value != minimum + 1 ||
        ranges.range_next_i64(&near_min).status !=
            ranges.range_status_exhausted()) { return 8; }
    return 0;
}

fn iterator_body(items: []i32) i32 @borrows {
    let all: iterator.SliceIterator[i32] = iterator.slice_iterator[i32](items);
    let sum: i32 = 0;
    let next: ?i32 = iterator.slice_iterator_next[i32](&all);
    while (next) |value| {
        sum = sum + value;
        next = iterator.slice_iterator_next[i32](&all);
    }
    if (sum != 15 || iterator.slice_iterator_status[i32](all) !=
        iterator.slice_iterator_status_exhausted()) {
        return 1;
    }

    let bounded: iterator.SliceIterator[i32] =
        iterator.slice_iterator_bounded[i32](items, 2);
    if ((iterator.slice_iterator_next[i32](&bounded) orelse 0) != 3 ||
        (iterator.slice_iterator_next[i32](&bounded) orelse 0) != 5 ||
        (iterator.slice_iterator_next[i32](&bounded) orelse 99) != 99 ||
        iterator.slice_iterator_status[i32](bounded) !=
        iterator.slice_iterator_status_limit()) {
        return 2;
    }
    let invalid: iterator.SliceIterator[i32] =
        iterator.slice_iterator_bounded[i32](items, 0 - 1);
    if (iterator.slice_iterator_status[i32](invalid) !=
        iterator.slice_iterator_status_invalid()) {
        return 3;
    }

    return 0;
}

fn iterator_bytes_body() i32 {
    // A second monomorphization proves this is a typed slice iterator rather
    // than an i32-only fixture dressed as a generic API.
    let bytes: iterator.SliceIterator[u8] = iterator.slice_iterator[u8]("Zag");
    if ((iterator.slice_iterator_next[u8](&bytes) orelse 0) != 90 ||
        (iterator.slice_iterator_next[u8](&bytes) orelse 0) != 97 ||
        (iterator.slice_iterator_next[u8](&bytes) orelse 0) != 103 ||
        (iterator.slice_iterator_next[u8](&bytes) orelse 255) != 255 ||
        iterator.slice_iterator_status[u8](bytes) !=
        iterator.slice_iterator_status_exhausted()) {
        return 4;
    }
    return 0;
}

fn iterator_test() i32 {
    let values: list.ArrayList[i32] = list.make[i32](4);
    list.push[i32](&values, 3);
    list.push[i32](&values, 5);
    list.push[i32](&values, 7);
    let body_rc: i32 = iterator_body(values.data[0..values.len]);
    let bytes_rc: i32 = iterator_bytes_body();
    list.free[i32](&values);
    if (body_rc != 0) { return body_rc; }
    return bytes_rc;
}

fn utf8_invalid_test() i32 {
    let cases: list.ArrayList[[]u8] = list.make[[]u8](12);
    list.push[[]u8](&cases, "\xc0\xaf");
    list.push[[]u8](&cases, "\xe0\x80\x80");
    list.push[[]u8](&cases, "\xed\xa0\x80");
    list.push[[]u8](&cases, "\xf0\x80\x80\x80");
    list.push[[]u8](&cases, "\xf4\x90\x80\x80");
    list.push[[]u8](&cases, "\xe2\x82");
    list.push[[]u8](&cases, "\x80");
    list.push[[]u8](&cases, "\xf8\x88\x80\x80\x80");
    list.push[[]u8](&cases, "\xc2A");
    let i: i32 = 0;
    while (i < cases.len) {
        let checked: utf8.Utf8Validation = utf8.utf8_validate(cases.data[i]);
        if (checked.status == utf8.utf8_status_exhausted() ||
            utf8.utf8_is_valid(cases.data[i])) {
            list.free[[]u8](&cases); return i + 1;
        }
        i = i + 1;
    }
    list.free[[]u8](&cases);
    return 0;
}

fn utf8_test() i32 {
    let text: []u8 = "A\xc2\xa2\xe2\x82\xac\xf0\x9f\x98\x80";
    let checked: utf8.Utf8Validation = utf8.utf8_validate(text);
    if (checked.status != utf8.utf8_status_exhausted() ||
        checked.scalar_count != 4 || checked.error_offset != text.len ||
        !utf8.utf8_is_valid(text)) { return 1; }

    let scalars: utf8.Utf8Iterator = utf8.utf8_iterator(text);
    let a: utf8.Utf8Decode = utf8.utf8_next(&scalars);
    let cent: utf8.Utf8Decode = utf8.utf8_next(&scalars);
    let euro: utf8.Utf8Decode = utf8.utf8_next(&scalars);
    let face: utf8.Utf8Decode = utf8.utf8_next(&scalars);
    let end: utf8.Utf8Decode = utf8.utf8_next(&scalars);
    if (a.scalar != 65 || a.width != 1 || cent.scalar != 162 ||
        cent.width != 2 || euro.scalar != 8364 || euro.width != 3 ||
        face.scalar != 128512 || face.width != 4 ||
        end.status != utf8.utf8_status_exhausted()) { return 2; }

    let bounded: utf8.Utf8Validation = utf8.utf8_validate_bounded(text, 2);
    if (bounded.status != utf8.utf8_status_limit() ||
        bounded.scalar_count != 2 || bounded.error_offset != 3) { return 3; }
    if (utf8.utf8_decode_at(text, 0 - 1).status !=
            utf8.utf8_status_invalid_argument() ||
        utf8.utf8_decode_at(text, text.len + 1).status !=
            utf8.utf8_status_invalid_argument()) { return 4; }

    if (utf8.utf8_decode_at("\xc2\x80", 0).scalar != 128 ||
        utf8.utf8_decode_at("\xe0\xa0\x80", 0).scalar != 2048 ||
        utf8.utf8_decode_at("\xed\x9f\xbf", 0).scalar != 55295 ||
        utf8.utf8_decode_at("\xee\x80\x80", 0).scalar != 57344 ||
        utf8.utf8_decode_at("\xf0\x90\x80\x80", 0).scalar != 65536 ||
        utf8.utf8_decode_at("\xf4\x8f\xbf\xbf", 0).scalar != 1114111) {
        return 5;
    }
    let invalid_rc: i32 = utf8_invalid_test();
    if (invalid_rc != 0) { return 10 + invalid_rc; }
    if (utf8.utf8_decode_at("\xc0\xaf", 0).status !=
            utf8.utf8_status_malformed() ||
        utf8.utf8_decode_at("\xed\xa0\x80", 0).status !=
            utf8.utf8_status_malformed() ||
        utf8.utf8_decode_at("\xf4\x90\x80\x80", 0).status !=
            utf8.utf8_status_malformed() ||
        utf8.utf8_decode_at("\xe2\x82", 0).status !=
            utf8.utf8_status_truncated() ||
        utf8.utf8_validate_bounded(text, 0 - 1).status !=
            utf8.utf8_status_invalid_argument()) { return 29; }

    let output: list.ArrayList[u8] = list.make[u8](12);
    output.len = 12;
    let i: i32 = 0;
    while (i < output.len) { output.data[i] = 90; i = i + 1; }
    let encoded: utf8.Utf8Encode =
        utf8.utf8_encode_at(output.data[0..output.len], 2, 128512);
    if (encoded.status != utf8.utf8_status_item() || encoded.width != 4 ||
        encoded.next_index != 6 || output.data[2] != 240 ||
        output.data[3] != 159 || output.data[4] != 152 ||
        output.data[5] != 128 ||
        utf8.utf8_decode_at(output.data[2..6], 0).scalar != 128512) {
        list.free[u8](&output); return 30;
    }

    let before0: u8 = output.data[0];
    let before1: u8 = output.data[1];
    if (utf8.utf8_encode_at(output.data[0..1], 0, 8364).status !=
            utf8.utf8_status_output_too_small() ||
        utf8.utf8_encode_at(output.data[0..output.len], 0, 55296).status !=
            utf8.utf8_status_invalid_scalar() ||
        utf8.utf8_encode_at(output.data[0..output.len], 0, 1114112).status !=
            utf8.utf8_status_invalid_scalar() ||
        utf8.utf8_encode_at(output.data[0..output.len], 0, 0 - 1).status !=
            utf8.utf8_status_invalid_scalar() ||
        output.data[0] != before0 || output.data[1] != before1) {
        list.free[u8](&output); return 31;
    }
    list.free[u8](&output);
    return 0;
}

fn main() i32 {
    let baseline: i64 = _zag_allocator_live_bytes();
    let hashmap_result: i32 = hashmap_collision_test();
    if (hashmap_result != 0) { return 10 + hashmap_result; }
    let set_result: i32 = set_test();
    if (set_result != 0) { return 30 + set_result; }
    let range_result: i32 = range_test();
    if (range_result != 0) { return 50 + range_result; }
    let iterator_result: i32 = iterator_test();
    if (iterator_result != 0) { return 70 + iterator_result; }
    let utf8_result: i32 = utf8_test();
    if (utf8_result != 0) { return 100 + utf8_result; }
    if (_zag_allocator_live_bytes() != baseline) { return 200; }
    _zag_println("collections-unicode-ok");
    return 0;
}
