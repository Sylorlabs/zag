// Emit the OpenCL C fallback from the same reviewed Zag kernel profile used by
// the OpenCL SPIR-V encoder. This stays a small pure-Zag tool so the runtime
// gate never substitutes a hand-written kernel for the user's source.

@import("../selfhost/opencl_c.zag")

fn main() i32 {
    if (_zag_argc() != 3) {
        _zag_eprintln("usage: opencl_c_emit <source.zag> <output.cl>");
        return 2;
    }
    let src: []u8 = _zag_read_file(_zag_arg(1));
    if (src.len < 0) {
        _zag_eprintln("opencl_c_emit: cannot read source");
        return 1;
    }
    let errors: i32 = 0;
    let out: ArrayList[u8] = emit_opencl_c(src, &errors);
    if (errors != 0 || out.len == 0) {
        _zag_eprintln("opencl_c_emit: OpenCL C profile rejected source");
        return 1;
    }
    if (_zag_write_file(_zag_arg(2), out.data[0..out.len]) != 0) {
        _zag_eprintln("opencl_c_emit: failed to write output");
        return 1;
    }
    return 0;
}
