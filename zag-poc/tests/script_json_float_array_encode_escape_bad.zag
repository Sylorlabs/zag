// A Script-owned floating-point list must not escape through an uncontracted
// aggregate sink, even when it is consumed by the bounded JSON encoder.
// This is intentionally a compile-time negative fixture.
script;

struct FloatEncodePayload { values: ScriptList[f64] }
extern fn retain_float_encode_payload(value: FloatEncodePayload) void

let values: ScriptList[f64] = json_float_array("[1.5,2.0]");
let encoded: []u8 = json_float_array_encode(values);
if (encoded.len == 0) { return 1; }
let payload: FloatEncodePayload = FloatEncodePayload{ .values = values };
retain_float_encode_payload(payload);
return 0;
