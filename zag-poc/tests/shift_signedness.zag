fn main() i32 {
    let u64_top: u64 = (1 as u64) << 63;
    let u64_half: u64 = u64_top >> 1;
    if (u64_half != ((1 as u64) << 62)) { return 1; }

    let u32_top: u32 = (1 as u32) << 31;
    let u32_half: u32 = u32_top >> 1;
    if (u32_half != ((1 as u32) << 30)) { return 2; }

    let signed64: i64 = (0 - 8) >> 1;
    if (signed64 != (0 - 4)) { return 3; }

    let signed32: i32 = (0 - 8) >> 1;
    if (signed32 != (0 - 4)) { return 4; }

    print_int(u64_half as i64);
    return 0;
}
