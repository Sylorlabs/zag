extern fn _zag_raw_syscall(num:i64,a1:i64,a2:i64,a3:i64,a4:i64,a5:i64,a6:i64)i64
extern fn _zag_malloc(bytes:i32)*u8

fn main() i32 {
    let pair:*i64=_zag_malloc(8) as *i64;
    let made:i64=_zag_raw_syscall(293,pair as i64,2048,0,0,0,0);
    if(made<0){return 10+(0-made) as i32;}if(made!=0){return 19;}
    let fd:i64=pair[0]&4294967295;
    let flags:i64=_zag_raw_syscall(72,fd,4,2048,0,0,0);
    if(flags<0){return 20+(0-flags) as i32;}if(flags!=0){return 29;}
    let byte:*u8=_zag_malloc(1);byte[0]='z';
    let written:i64=_zag_raw_syscall(1,pair[0]>>32,byte as i64,1,0,0,0);
    if(written!=1){return 30;}
    byte[0]=0;
    let read:i64=_zag_raw_syscall(0,fd,byte as i64,1,0,0,0);
    if(read!=1||byte[0]!='z'){return 31;}
    let a:i64=_zag_raw_syscall(3,fd,0,0,0,0,0);
    let b:i64=_zag_raw_syscall(3,pair[0]>>32,0,0,0,0,0);
    if(a!=0||b!=0){return 32;}
    return 42;
}
