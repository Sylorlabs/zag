// Script CSV row bridge: nested list descriptors and cell bytes are all
// retained in the ScriptContext, while malformed strict tables fail closed.

script;

let before: i64 = script_alloc_used();
let rows: ScriptList[ScriptList[[]u8]] = csv_rows("name,notes\r\nalice,ready\r\n\"bob, jr\",\"line1\nline2\"");
if (script_list_failed[ScriptList[[]u8]](rows) != 0 || script_list_len[ScriptList[[]u8]](rows) != 3 || script_alloc_used() <= before) { return 1; }
if (script_list_len[[]u8](script_list_get[ScriptList[[]u8]](rows, 0)) != 2) { return 2; }
if (!@strEq(script_list_get[[]u8](script_list_get[ScriptList[[]u8]](rows, 0), 0), "name")) { return 2; }
if (!@strEq(script_list_get[[]u8](script_list_get[ScriptList[[]u8]](rows, 0), 1), "notes")) { return 2; }
if (script_list_len[[]u8](script_list_get[ScriptList[[]u8]](rows, 2)) != 2) { return 2; }
if (!@strEq(script_list_get[[]u8](script_list_get[ScriptList[[]u8]](rows, 2), 0), "bob, jr")) { return 2; }
if (!@strEq(script_list_get[[]u8](script_list_get[ScriptList[[]u8]](rows, 2), 1), "line1\nline2")) { return 2; }

let after: i64 = script_alloc_used();
let bad: ScriptList[ScriptList[[]u8]] = csv_rows("\"unterminated");
if (script_list_failed[ScriptList[[]u8]](bad) == 0 || script_list_len[ScriptList[[]u8]](bad) != 0 || script_alloc_used() != after) { return 3; }

let empty: ScriptList[ScriptList[[]u8]] = csv_rows("");
if (script_list_failed[ScriptList[[]u8]](empty) != 0 || script_list_len[ScriptList[[]u8]](empty) != 0) { return 4; }
