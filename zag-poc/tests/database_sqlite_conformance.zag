@import("std:database_kv") as contract
@import("std:sqlite_kv") as sqlite

extern fn _zag_allocator_live_bytes() i64

struct ConformanceState { passed: i32, failed: i32 }

fn expect(state: *ConformanceState, condition: bool) void {
    if (condition) { state.*.passed = state.*.passed + 1; }
    else { state.*.failed = state.*.failed + 1; }
}

fn main() i32 {
    let state: ConformanceState = ConformanceState{.passed=0,.failed=0};
    let before: i64 = _zag_allocator_live_bytes();

    let zero: sqlite.SqliteKv = sqlite.sqlite_kv_open(0);
    expect(&state, zero.status == contract.database_kv_invalid() && zero.open == 0);
    let empty_path: sqlite.SqliteKv = sqlite.sqlite_kv_open_path("", 2);
    expect(&state, empty_path.status == contract.database_kv_invalid() &&
        empty_path.open == 0 && _zag_allocator_live_bytes() == before);
    let nul_path: sqlite.SqliteKv =
        sqlite.sqlite_kv_open_path("bad\0path", 2);
    expect(&state, nul_path.status == contract.database_kv_invalid() &&
        nul_path.open == 0 && _zag_allocator_live_bytes() == before);
    let too_large: sqlite.SqliteKv =
        sqlite.sqlite_kv_open(contract.database_kv_max_capacity() + 1);
    expect(&state, too_large.status == contract.database_kv_invalid() &&
        too_large.open == 0);

    let database: sqlite.SqliteKv = sqlite.sqlite_kv_open(2);
    expect(&state, database.status == contract.database_kv_ok() &&
        database.open == 1);
    let count: i32 = 99;
    expect(&state, sqlite.sqlite_kv_count(&database, &count) ==
        contract.database_kv_ok() && count == 0);

    let value: i64 = 99;
    expect(&state, sqlite.sqlite_kv_get(&database, 404, &value) ==
        contract.database_kv_missing() && value == 0);
    expect(&state, sqlite.sqlite_kv_put(&database, 4294967297, 1099511627776) ==
        contract.database_kv_ok());
    expect(&state, sqlite.sqlite_kv_put(&database, 0 - 4294967299,
        0 - 1099511627777) ==
        contract.database_kv_ok());
    expect(&state, sqlite.sqlite_kv_put(&database, 11, 99) ==
        contract.database_kv_limit());
    expect(&state, sqlite.sqlite_kv_put(&database, 4294967297,
        1099511627818) ==
        contract.database_kv_ok());
    expect(&state, sqlite.sqlite_kv_get(&database, 4294967297, &value) ==
        contract.database_kv_ok() && value == 1099511627818);
    expect(&state, sqlite.sqlite_kv_delete(&database, 404) ==
        contract.database_kv_missing());
    expect(&state, sqlite.sqlite_kv_delete(&database, 0 - 4294967299) ==
        contract.database_kv_ok());
    expect(&state, sqlite.sqlite_kv_count(&database, &count) ==
        contract.database_kv_ok() && count == 1);
    value = 123;
    expect(&state, sqlite.sqlite_kv_get(&database, 4294967297,
        null as *i64) == contract.database_kv_invalid() && value == 123);
    count = 123;
    expect(&state, sqlite.sqlite_kv_count(&database, null as *i32) ==
        contract.database_kv_invalid() && count == 123);
    expect(&state, sqlite.sqlite_kv_close(&database) ==
        contract.database_kv_ok() && database.open == 0 &&
        _zag_allocator_live_bytes() == before);
    value = 99;
    expect(&state, sqlite.sqlite_kv_get(&database, 4294967297, &value) ==
        contract.database_kv_invalid() && value == 0);
    expect(&state, sqlite.sqlite_kv_close(&database) ==
        contract.database_kv_invalid());
    value = 123;
    expect(&state, sqlite.sqlite_kv_get(null as *sqlite.SqliteKv,
        4294967297, &value) == contract.database_kv_invalid() && value == 0);
    count = 123;
    expect(&state, sqlite.sqlite_kv_count(null as *sqlite.SqliteKv, &count) ==
        contract.database_kv_invalid() && count == 0);
    expect(&state, sqlite.sqlite_kv_put(null as *sqlite.SqliteKv, 1, 2) ==
        contract.database_kv_invalid());
    expect(&state, sqlite.sqlite_kv_delete(null as *sqlite.SqliteKv, 1) ==
        contract.database_kv_invalid());
    expect(&state, sqlite.sqlite_kv_close(null as *sqlite.SqliteKv) ==
        contract.database_kv_invalid());

    if (state.failed != 0 || state.passed != 25) { return 1; }
    _zag_println("database sqlite conformance: pass=25 fail=0");
    return 0;
}
