extern fn _zag_clock_monotonic_ms() i64
extern fn _zag_raw_syscall(num:i64,a1:i64,a2:i64,a3:i64,a4:i64,a5:i64,a6:i64)i64

fn main() i32 {
    let start:i64=_zag_clock_monotonic_ms();
    let ts:*i64=new(0);ts[0]=0;ts[1]=50000000;
    let _nap:i64=_zag_raw_syscall(35,ts as i64,0,0,0,0,0);
    if(_nap<0){return (0-_nap) as i32;}
    let end:i64=_zag_clock_monotonic_ms();
    if(start<0||end<start){return 1;}
    let delta:i64=end-start;
    if(delta<20){return 3;}
    if(delta>1000){return 4;}
    return 42;
}
