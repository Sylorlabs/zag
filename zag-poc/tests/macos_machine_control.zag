fn sixth(a:i64,b:i64,c:i64,d:i64,e:i64,f:i64) i64 { return f; }

fn main() i32 {
    let word:i64=0;
    let byte:u8=0;
    let half:u16=0;
    let dword:u32=0;
    unsafe {
        let wp:*mut i64=(&word) as *mut i64;
        let bp:*mut u8=(&byte) as *mut u8;
        let hp:*mut u16=(&half) as *mut u16;
        let dp:*mut u32=(&dword) as *mut u32;
        @volatileStore(wp,sixth(1,2,3,4,5,42));
        @volatileStore8(bp,255);
        @volatileStore16(hp,65535);
        @volatileStore32(dp,4294967295);
        if(@volatileLoad(wp)!=42){return 1;}
        if(@volatileLoad8(bp)!=255){return 2;}
        if(@volatileLoad16(hp)!=65535){return 3;}
        if(@volatileLoad32(dp)!=4294967295){return 4;}
        @prefetch(wp as *const i64);

        let lhs:*u8=_zag_malloc(32) as *u8;
        let rhs:*u8=_zag_malloc(32) as *u8;
        let out:*u8=_zag_malloc(32) as *u8;
        let status:i32=0;
        let i:i32=0;
        while(i<16){lhs[i]=i as u8;rhs[i]=(16+i) as u8;out[i]=0;i=i+1;}

        @simdAddI32x4(out as *mut i32,lhs as *const i32,rhs as *const i32);
        if(out[0]!=16 || out[4]!=24 || out[12]!=40){status=10;}
        @simdSubI32x4(out as *mut i32,rhs as *const i32,lhs as *const i32);
        if(out[0]!=16 || out[4]!=16 || out[12]!=16){status=11;}
        @simdAndI32x4(out as *mut i32,lhs as *const i32,rhs as *const i32);
        if(out[0]!=0 || out[15]!=15){status=12;}
        @simdOrI32x4(out as *mut i32,lhs as *const i32,rhs as *const i32);
        if(out[0]!=16 || out[15]!=31){status=13;}
        @simdXorI32x4(out as *mut i32,lhs as *const i32,rhs as *const i32);
        if(out[0]!=16 || out[15]!=16){status=14;}

        _zag_free(lhs);_zag_free(rhs);_zag_free(out);
        if(status!=0){return status;}
    }
    return 42;
}
