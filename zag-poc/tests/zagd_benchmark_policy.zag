@import("../selfhost/zagd_benchmark.zag")
@import("../std/list.zag")

fn zbt_expect(value:i32,failures:*i32)void{if(value==0){failures.*=failures.*+1;}}
fn zbt_values(first:i64,second:i64,first_count:i32,count:i32)ArrayList[i64]{
    let out:ArrayList[i64]=make[i64](count);let i:i32=0;while(i<count){let value:i64=second;if(i<first_count){value=first;}push[i64](&out,value);i=i+1;}return out;
}
fn zbt_workload(id:i32,low:i64,high:i64,low_count:i32,noise:i64)ZagdBenchmarkWorkloadEvidence{
    return ZagdBenchmarkWorkloadEvidence{
        .workload=id,
        .reference_warmups=zbt_values(1000,1000,3,3),
        .finalist_warmups=zbt_values(low,low,3,3),
        .noise_reference=zbt_values(1000,1000,30,30),
        .noise_repeat=zbt_values(1000-noise,1000+noise,15,30),
        .reference_runs=zbt_values(1000,1000,30,30),
        .finalist_runs=zbt_values(low,high,low_count,30),
    };
}
fn zbt_candidate(kind:i32,low:i64,high:i64,low_count:i32,noise:i64,memory:i64,size:i64)ZagdBenchmarkCandidateEvidence{
    let workloads:ArrayList[ZagdBenchmarkWorkloadEvidence]=make[ZagdBenchmarkWorkloadEvidence](2);
    push[ZagdBenchmarkWorkloadEvidence](&workloads,zbt_workload(1,low,high,low_count,noise));
    push[ZagdBenchmarkWorkloadEvidence](&workloads,zbt_workload(2,low,high,low_count,noise));
    return ZagdBenchmarkCandidateEvidence{.kind=kind,.valid=1,.equivalent=1,.peak_memory_bytes=memory,.binary_size_bytes=size,.workloads=workloads};
}
fn zbt_required()ArrayList[i32]{let out:ArrayList[i32]=make[i32](2);push[i32](&out,1);push[i32](&out,2);return out;}
fn zbt_single(c:ZagdBenchmarkCandidateEvidence)ArrayList[ZagdBenchmarkCandidateEvidence]{let out:ArrayList[ZagdBenchmarkCandidateEvidence]=make[ZagdBenchmarkCandidateEvidence](1);push[ZagdBenchmarkCandidateEvidence](&out,c);return out;}

fn main()i32{
    let failures:i32=0;let required:ArrayList[i32]=zbt_required();

    // Preserve the executor admission-policy regressions while extending this
    // gate with the richer, still-unwired statistical selector.
    let source:ZagdHash=zagd_content_hash("stable");let target:ZagdHash=zagd_content_hash("x86");
    let request:ZagdBenchmarkRequest=ZagdBenchmarkRequest{.explicit=1,.mode=zagd_mode_deep(),.finalists=2,.timeout_ms=1000,.max_memory=67108864,.source=source,.stable_source=source,.target=target,.active_target=target,.cancelled=0,.network=0,.gpu=0,.source_writes=0};
    let decision:ZagdBenchmarkDecision=zagd_benchmark_decide(request);
    zbt_expect(decision.allowed==1&&decision.execution_supported==1&&decision.reason==zagd_benchmark_reason_ready()&&decision.requires_output_witness==1,&failures);
    request.explicit=0;zbt_expect(zagd_benchmark_decide(request).reason==zagd_benchmark_reason_not_explicit(),&failures);
    request.explicit=1;request.mode=zagd_mode_adaptive();zbt_expect(zagd_benchmark_decide(request).reason==zagd_benchmark_reason_not_deep(),&failures);
    request.mode=zagd_mode_deep();request.finalists=4;zbt_expect(zagd_benchmark_decide(request).reason==zagd_benchmark_reason_budget(),&failures);
    request.finalists=2;request.source=zagd_content_hash("stale");zbt_expect(zagd_benchmark_decide(request).reason==zagd_benchmark_reason_stale(),&failures);
    request.source=source;request.cancelled=1;zbt_expect(zagd_benchmark_decide(request).reason==zagd_benchmark_reason_cancelled(),&failures);
    request.cancelled=0;request.network=1;zbt_expect(zagd_benchmark_decide(request).reason==zagd_benchmark_reason_forbidden_resource(),&failures);

    // Exact one-sided p=0.008062... boundary for 22 wins in 30 pairs.
    zbt_expect(zagd_benchmark_paired_sign99(22,8)==1,&failures);
    zbt_expect(zagd_benchmark_paired_sign99(21,9)==0,&failures);
    zbt_expect(zagd_benchmark_paired_sign99(8,22)==0,&failures);
    zbt_expect(zagd_benchmark_paired_sign_tail(22,8,200)==0&&zagd_benchmark_paired_sign_tail(23,7,200)==1,&failures);

    let large:ZagdBenchmarkCandidateEvidence=zbt_candidate(7,900,900,30,2,1024,1200);
    let small:ZagdBenchmarkCandidateEvidence=zbt_candidate(9,900,900,30,2,1024,900);
    let tied:ArrayList[ZagdBenchmarkCandidateEvidence]=make[ZagdBenchmarkCandidateEvidence](2);
    push[ZagdBenchmarkCandidateEvidence](&tied,large);push[ZagdBenchmarkCandidateEvidence](&tied,small);
    let selected:ZagdBenchmarkPolicySelection=zagd_benchmark_select_99(tied,required,4096);
    zbt_expect(selected.status==zagd_benchmark_policy_selected()&&selected.winner_kind==9&&selected.evaluated==2&&selected.eligible==2&&selected.confidence_percent==99&&selected.no_regression==1&&selected.binary_size_bytes==900&&selected.advisory==1,&failures);

    // Input order cannot change the result; runtime wins before size.
    let reversed:ArrayList[ZagdBenchmarkCandidateEvidence]=make[ZagdBenchmarkCandidateEvidence](2);
    push[ZagdBenchmarkCandidateEvidence](&reversed,small);push[ZagdBenchmarkCandidateEvidence](&reversed,large);
    zbt_expect(zagd_benchmark_select_99(reversed,required,4096).winner_kind==9,&failures);
    let same_size:ArrayList[ZagdBenchmarkCandidateEvidence]=make[ZagdBenchmarkCandidateEvidence](2);
    push[ZagdBenchmarkCandidateEvidence](&same_size,zbt_candidate(8,900,900,30,2,1024,900));
    push[ZagdBenchmarkCandidateEvidence](&same_size,zbt_candidate(6,900,900,30,2,1024,900));
    zbt_expect(zagd_benchmark_select_99(same_size,required,4096).winner_kind==6,&failures);
    let faster:ZagdBenchmarkCandidateEvidence=zbt_candidate(3,850,850,30,2,1024,5000);
    let speed_first:ArrayList[ZagdBenchmarkCandidateEvidence]=make[ZagdBenchmarkCandidateEvidence](2);
    push[ZagdBenchmarkCandidateEvidence](&speed_first,small);push[ZagdBenchmarkCandidateEvidence](&speed_first,faster);
    zbt_expect(zagd_benchmark_select_99(speed_first,required,4096).winner_kind==3,&failures);

    // With two workload hypotheses, 23/7 clears the family-wise 99% threshold;
    // 22/8 clears an isolated test but is a deterministic selector no-win.
    let edge:ZagdBenchmarkCandidateEvidence=zbt_candidate(11,900,1100,23,2,1024,1000);
    zbt_expect(zagd_benchmark_select_99(zbt_single(edge),required,4096).winner_kind==11,&failures);
    let below:ZagdBenchmarkCandidateEvidence=zbt_candidate(12,900,1100,22,2,1024,1000);
    zbt_expect(zagd_benchmark_select_99(zbt_single(below),required,4096).status==zagd_benchmark_policy_no_win(),&failures);

    // Calibrated noise can make every pair indeterminate. It must never be
    // promoted into a fabricated win.
    let noisy:ZagdBenchmarkCandidateEvidence=zbt_candidate(13,950,1050,15,60,1024,1000);
    let no_win:ZagdBenchmarkPolicySelection=zagd_benchmark_select_99(zbt_single(noisy),required,4096);
    zbt_expect(no_win.status==zagd_benchmark_policy_no_win()&&no_win.winner_kind==0&&no_win.eligible==0,&failures);

    // One workload regression rejects an otherwise fast candidate.
    let regressed:ZagdBenchmarkCandidateEvidence=zbt_candidate(14,900,900,30,2,1024,1000);
    regressed.workloads.data[1]=zbt_workload(2,1100,1100,30,2);
    zbt_expect(zagd_benchmark_select_99(zbt_single(regressed),required,4096).winner_kind==0,&failures);

    let over_memory:ZagdBenchmarkCandidateEvidence=zbt_candidate(15,900,900,30,2,4097,1000);
    zbt_expect(zagd_benchmark_select_99(zbt_single(over_memory),required,4096).winner_kind==0,&failures);
    let missing_memory:ZagdBenchmarkCandidateEvidence=zbt_candidate(24,900,900,30,2,0,1000);
    zbt_expect(zagd_benchmark_select_99(zbt_single(missing_memory),required,4096).winner_kind==0,&failures);
    let unequivalent:ZagdBenchmarkCandidateEvidence=zbt_candidate(16,900,900,30,2,1024,1000);unequivalent.equivalent=0;
    zbt_expect(zagd_benchmark_select_99(zbt_single(unequivalent),required,4096).winner_kind==0,&failures);

    // Mutated/truncated evidence fails closed.
    let bad_sample:ZagdBenchmarkCandidateEvidence=zbt_candidate(17,900,900,30,2,1024,1000);bad_sample.workloads.data[0].finalist_runs.data[0]=0;
    zbt_expect(zagd_benchmark_select_99(zbt_single(bad_sample),required,4096).winner_kind==0,&failures);
    let short_warmup:ZagdBenchmarkCandidateEvidence=zbt_candidate(18,900,900,30,2,1024,1000);short_warmup.workloads.data[0].finalist_warmups.len=2;
    zbt_expect(zagd_benchmark_select_99(zbt_single(short_warmup),required,4096).winner_kind==0,&failures);
    let short_noise:ZagdBenchmarkCandidateEvidence=zbt_candidate(19,900,900,30,2,1024,1000);short_noise.workloads.data[0].noise_repeat.len=29;
    zbt_expect(zagd_benchmark_select_99(zbt_single(short_noise),required,4096).winner_kind==0,&failures);
    let missing:ZagdBenchmarkCandidateEvidence=zbt_candidate(20,900,900,30,2,1024,1000);missing.workloads.len=1;
    zbt_expect(zagd_benchmark_select_99(zbt_single(missing),required,4096).winner_kind==0,&failures);
    let duplicate:ZagdBenchmarkCandidateEvidence=zbt_candidate(21,900,900,30,2,1024,1000);duplicate.workloads.data[1].workload=1;
    zbt_expect(zagd_benchmark_select_99(zbt_single(duplicate),required,4096).winner_kind==0,&failures);
    let no_size:ZagdBenchmarkCandidateEvidence=zbt_candidate(22,900,900,30,2,1024,0);
    zbt_expect(zagd_benchmark_select_99(zbt_single(no_size),required,4096).winner_kind==0,&failures);

    let same_kinds:ArrayList[ZagdBenchmarkCandidateEvidence]=make[ZagdBenchmarkCandidateEvidence](2);
    push[ZagdBenchmarkCandidateEvidence](&same_kinds,zbt_candidate(23,900,900,30,2,1024,1000));
    push[ZagdBenchmarkCandidateEvidence](&same_kinds,zbt_candidate(23,850,850,30,2,1024,1000));
    zbt_expect(zagd_benchmark_select_99(same_kinds,required,4096).evaluated==0,&failures);
    let bad_required:ArrayList[i32]=make[i32](2);push[i32](&bad_required,1);push[i32](&bad_required,1);
    zbt_expect(zagd_benchmark_select_99(zbt_single(small),bad_required,4096).evaluated==0,&failures);

    if(failures==0){_zag_println("zagd checked benchmark selector: PASS");}return failures;
}
