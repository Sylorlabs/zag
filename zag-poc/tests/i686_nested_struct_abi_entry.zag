// Caller-side recursive sequential-layout witness. The complete Envelope is
// 48 bytes (12 i386 words) after recursively inlining its acyclic children.
struct Numbers {
    signed8:i8,
    unsigned8:u8,
    signed16:i16,
    unsigned16:u16,
    ready:bool,
    count:i32,
    ratio:f32,
    total:f64,
}
struct Link { pointer:*i32, size:usize }
struct Payload { numbers:Numbers, link:Link }
struct Envelope { payload:Payload, code:i32 }

extern fn transform_envelope(value:Envelope) Envelope;

fn main() i32 {
    let backing:i32=9;
    let numbers:Numbers=Numbers{
        .signed8=127,
        .unsigned8=254,
        .signed16=32767,
        .unsigned16=65535,
        .ready=false,
        .count=10,
        .ratio=1.5,
        .total=2.25,
    };
    let link:Link=Link{.pointer=&backing,.size=4};
    let payload:Payload=Payload{.numbers=numbers,.link=link};
    let input:Envelope=Envelope{.payload=payload,.code=35};
    input.payload.numbers.signed8=input.payload.numbers.signed8+(2 as i8);
    input.payload.numbers.unsigned8=input.payload.numbers.unsigned8+(3 as u8);
    input.payload.numbers.signed16=input.payload.numbers.signed16+(2 as i16);
    input.payload.numbers.unsigned16=input.payload.numbers.unsigned16+(2 as u16);
    input.payload.numbers.ready=9 as bool;

    let output:Envelope=transform_envelope(input);
    let copied:Envelope=output;
    let assigned:Envelope=input;
    assigned=copied;
    if ((assigned.payload.numbers.signed8 as i32)!=-126) { return 1; }
    if ((assigned.payload.numbers.unsigned8 as i32)!=2) { return 2; }
    if ((assigned.payload.numbers.signed16 as i32)!=-32766) { return 3; }
    if ((assigned.payload.numbers.unsigned16 as i32)!=2) { return 4; }
    if (assigned.payload.numbers.ready==false) { return 5; }
    if (assigned.payload.numbers.count!=12) { return 6; }
    if (assigned.payload.numbers.ratio!=3.0) { return 7; }
    if (assigned.payload.numbers.total!=4.5) { return 8; }
    if (assigned.payload.link.size!=5) { return 9; }
    if (assigned.payload.link.pointer.*!=9) { return 10; }
    if (assigned.code!=42) { return 11; }
    return 42;
}
