extern fn _zag_raw_syscall(num:i64,a1:i64,a2:i64,a3:i64,a4:i64,a5:i64,a6:i64)i64
extern fn _zag_malloc(bytes:i32)*u8

fn main() i32 {
    let pair: *i64 = _zag_malloc(8) as *i64;
    if (_zag_raw_syscall(293,pair as i64,2048,0,0,0,0) != 0) { return 1; }
    let read_fd: i64 = pair[0] & 4294967295;
    let write_fd: i64 = pair[0] >> 32;

    // Linux-numbered F_GETFD (1) is numerically identical on Darwin. The
    // portable adapter must admit this exact tuple, then preserve EBADF after
    // the descriptor is closed.
    let live: i64 = _zag_raw_syscall(72,read_fd,1,0,0,0,0);
    if (live < 0) {
        let _read_close: i64 = _zag_raw_syscall(3,read_fd,0,0,0,0,0);
        let _write_close: i64 = _zag_raw_syscall(3,write_fd,0,0,0,0,0);
        return 2;
    }
    if (_zag_raw_syscall(3,read_fd,0,0,0,0,0) != 0) {
        let _write_close: i64 = _zag_raw_syscall(3,write_fd,0,0,0,0,0);
        return 3;
    }
    let closed: i64 = _zag_raw_syscall(72,read_fd,1,0,0,0,0);
    if (_zag_raw_syscall(3,write_fd,0,0,0,0,0) != 0) { return 4; }
    if (closed == 0 - 9) { return 42; }
    return 5;
}
