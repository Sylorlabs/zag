@import("std:list")
@import("std:json") as json
@import("std:csv") as csv

script;

let document: json.JsonDocument =
    json.json_parse_value("{\"jobs\":[{\"name\":\"index\",\"ready\":true}],\"count\":1}");
if (document.ok != 1) { return 1; }
let root_value: json.JsonValue = document.nodes.data[document.root];
if (root_value.kind != json.json_kind_object() || root_value.child_count != 2) { return 2; }
let jobs: i32 = document.children.data[root_value.first_child];
let jobs_value: json.JsonValue = document.nodes.data[jobs];
if (jobs_value.kind != json.json_kind_array() || jobs_value.child_count != 1) { return 3; }
let job: i32 = document.children.data[jobs_value.first_child];
let job_value: json.JsonValue = document.nodes.data[job];
let name: i32 = document.children.data[job_value.first_child];
if (!@strEq(document.nodes.data[name].text, "index")) { return 4; }
let json_encoded: json.JsonEncodeResult = json.json_stringify_value(document, document.root);
if (json_encoded.ok != 1 || !@strEq(json_encoded.value, "{\"jobs\":[{\"name\":\"index\",\"ready\":true}],\"count\":1}")) { return 5; }
json.json_encode_result_free(&json_encoded);
json.json_document_free(&document);

let table: csv.CsvTable = csv.csv_parse("name,notes\r\nindex,\"line1\nline2\"");
if (table.ok != 1 || table.rows.len != 2 || table.rows.data[1].cells.len != 2 ||
    !@strEq(table.rows.data[1].cells.data[1], "line1\nline2")) { return 6; }
let csv_encoded: csv.CsvEncodeResult = csv.csv_encode(table);
if (csv_encoded.ok != 1 || !@strEq(csv_encoded.value, "name,notes\r\nindex,\"line1\nline2\"")) { return 7; }
csv.csv_encode_result_free(&csv_encoded);
csv.csv_free(&table);
return 0;
