@import("std:json") as json
@import("std:list") as list

extern fn _zag_allocator_live_bytes() i64

// Every strict parser failure owns a temporary ArrayList, including failures
// after one or more values have already been appended.  Check the allocator
// immediately around each case so a later successful parse cannot hide a
// leaked partial result.
fn expect_bad_balanced(source: []u8) i32 {
    let before: i64 = _zag_allocator_live_bytes();
    let result: json.JsonBoolArrayResult = json.json_parse_bool_array(source);
    if (result.ok != 0) {
        json.json_bool_array_result_free(&result);
        return 0;
    }
    json.json_bool_array_result_free(&result);
    json.json_bool_array_result_free(&result);
    return (_zag_allocator_live_bytes() == before) as i32;
}

fn expect_bad_bounded_balanced(source: []u8, max_bytes: i32,
    max_values: i32, expected_values: i32) i32 {
    let before: i64 = _zag_allocator_live_bytes();
    let result: json.JsonBoolArrayResult =
        json.json_parse_bool_array_bounded(source, max_bytes, max_values);
    if (result.ok != 0 || result.values.len != expected_values) {
        json.json_bool_array_result_free(&result);
        return 0;
    }
    json.json_bool_array_result_free(&result);
    json.json_bool_array_result_free(&result);
    return (_zag_allocator_live_bytes() == before) as i32;
}

fn expect_good_bounded_balanced(source: []u8, max_bytes: i32,
    max_values: i32, expected_values: i32) i32 {
    let before: i64 = _zag_allocator_live_bytes();
    let result: json.JsonBoolArrayResult =
        json.json_parse_bool_array_bounded(source, max_bytes, max_values);
    let good: i32 = (result.ok == 1 &&
        result.values.len == expected_values) as i32;
    json.json_bool_array_result_free(&result);
    return (good == 1 && _zag_allocator_live_bytes() == before) as i32;
}

fn make_over_value_source() list.ArrayList[u8] {
    let count: i32 = json.json_default_max_values() + 1;
    let source: list.ArrayList[u8] = list.make[u8](count * 5 + 1);
    let at: i32 = 0;
    source.data[at] = 91; at = at + 1;
    let i: i32 = 0;
    while (i < count) {
        if (i > 0) { source.data[at] = 44; at = at + 1; }
        source.data[at] = 116; at = at + 1;
        source.data[at] = 114; at = at + 1;
        source.data[at] = 117; at = at + 1;
        source.data[at] = 101; at = at + 1;
        i = i + 1;
    }
    source.data[at] = 93; at = at + 1;
    source.len = at;
    return source;
}

fn main() i32 {
    let before: i64 = _zag_allocator_live_bytes();
    let parsed: json.JsonBoolArrayResult =
        json.json_parse_bool_array(" [ true,\n false, true ] ");
    if (parsed.ok != 1 || parsed.values.len != 3 ||
        parsed.values.data[0] != true || parsed.values.data[1] != false ||
        parsed.values.data[2] != true) { json.json_bool_array_result_free(&parsed); return 1; }
    json.json_bool_array_result_free(&parsed);
    json.json_bool_array_result_free(&parsed);
    let empty: json.JsonBoolArrayResult = json.json_parse_bool_array(" [] ");
    if (empty.ok != 1 || empty.values.len != 0) { json.json_bool_array_result_free(&empty); return 2; }
    json.json_bool_array_result_free(&empty);
    if (_zag_allocator_live_bytes() != before) { return 3; }

    // Malformed and partially parsed inputs must release the strict
    // temporary before the next case observes allocator state.
    if (expect_bad_balanced("[True]") == 0 ||
        expect_bad_balanced("[true,false") == 0 ||
        expect_bad_balanced("[true,]") == 0 ||
        expect_bad_balanced("[true] trailing") == 0 ||
        expect_bad_balanced("[1]") == 0 || expect_bad_balanced("true") == 0) {
        return 4;
    }
    // The source exceeds the byte bound, the element count exceeds the value
    // bound, and invalid bounds all fail closed without retaining a result.
    if (expect_good_bounded_balanced("[true,false]", 32, 2, 2) == 0 ||
        expect_bad_bounded_balanced("[true]", 4, 65536, 0) == 0 ||
        expect_bad_bounded_balanced("[true,false]", 32, 1, 1) == 0 ||
        expect_bad_bounded_balanced("[true]", 0, 4, 0) == 0 ||
        expect_bad_bounded_balanced("[true]", 1048577, 4, 0) == 0 ||
        expect_bad_bounded_balanced("[true]", 32, 65537, 0) == 0) { return 5; }

    // Exercise the default over-value path after thousands of successful
    // appends, then verify cleanup before releasing the generated source.
    let over_values: list.ArrayList[u8] = make_over_value_source();
    let over_values_before: i64 = _zag_allocator_live_bytes();
    let over_values_result: json.JsonBoolArrayResult =
        json.json_parse_bool_array(over_values.data[0..over_values.len]);
    if (over_values_result.ok != 0 ||
        over_values_result.values.len != json.json_default_max_values()) {
        json.json_bool_array_result_free(&over_values_result);
        list.free[u8](&over_values);
        return 6;
    }
    json.json_bool_array_result_free(&over_values_result);
    json.json_bool_array_result_free(&over_values_result);
    if (_zag_allocator_live_bytes() != over_values_before) {
        list.free[u8](&over_values);
        return 7;
    }
    list.free[u8](&over_values);
    return 0;
}
