// Import-side witness for nested aggregate returns. This deliberately uses
// receiver methods and nested struct-returning calls: consumers must not need
// to flatten these expressions or duplicate math helpers into another module.

struct ImportVec3 {
    x: i32,
    y: i32,
    z: i32,
}

fn import_v3(x: i32, y: i32, z: i32) ImportVec3 {
    return ImportVec3{ .x = x, .y = y, .z = z };
}

fn (self: ImportVec3) add(other: ImportVec3) ImportVec3 {
    return import_v3(self.x + other.x, self.y + other.y, self.z + other.z);
}

fn (self: ImportVec3) shift(dx: i32, dy: i32, dz: i32) ImportVec3 {
    return self.add(import_v3(dx, dy, dz));
}

struct ImportCamera {
    eye: ImportVec3,
    target: ImportVec3,
    tag: i32,
}

fn import_camera(seed: i32) ImportCamera {
    let base: ImportVec3 = import_v3(seed, seed + 1, seed + 2);
    return ImportCamera{
        .eye = base.shift(1, 2, 3),
        .target = base.add(import_v3(4, 5, 6)),
        .tag = 7,
    };
}
