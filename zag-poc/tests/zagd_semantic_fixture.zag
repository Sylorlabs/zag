@import("../selfhost/parse.zag")
@import("../selfhost/sema.zag")
@import("../selfhost/semantic_manifest.zag")
extern fn _zag_read_file(path:[]u8)[]u8
extern fn _zag_write_file(path:[]u8,text:[]u8)i32
fn main()i32{if(_zag_argc()!=3){return 2;}let source:[]u8=_zag_read_file(_zag_arg(1));let unit:CompilationUnit=parse_compilation_unit_dir(source,".");let effects:map.StringMap[i32]=analyze(unit.decls);let manifest:*SemanticManifest=semantic_manifest_build("app.zag",source,unit.profile,unit.decls,effects);return _zag_write_file(_zag_arg(2),manifest.*.text);}
