// Bounded language-level async spelling over the TaskI64 runtime.
// This is deliberately not a general future/scheduler contract.
async fn increment(input: i64) i64 {
    return input + 1;
}

// Result-only async workers use the same affine TaskI64 handle and await
// ownership boundary; they simply have no source input payload.
async fn constant() i64 {
    return 41;
}

fn main() i32 {
    unsafe {
        let handle: *opaque = increment(41);
        let value: i64 = await(handle);
        if (value != 42) { return 1; }
        let zero_handle: *opaque = constant();
        let zero_value: i64 = await(zero_handle);
        if (zero_value != 41) { return 2; }
        let no_handle: *opaque = null;
        let cancel_rc: i64 = cancel(no_handle);
        if (cancel_rc != 0) { return 3; }
        return 42;
    }
}
