// Regression: std collections must size their backing allocation in i64.
// 100M x 24-byte records = 2.4 GB > 2^31; the i32 product used to wrap
// negative and abort with "invalid negative allocation size".
@import("std:list") as list

struct Rec {
    op: i32,
    a: i32,
    b: i32,
    pad: i32,
    val: i64,
}

fn main() i32 {
    let n: i32 = 100000000;
    let rc: i32 = 42;
    let xs: list.ArrayList[Rec] = list.make[Rec](n);
    if (list.cap[Rec](xs) != n) { rc = 1; }
    list.push[Rec](&xs, Rec{ .op = 1, .a = 2, .b = 3, .pad = 0, .val = 40 });
    list.set[Rec](&xs, 0, Rec{ .op = 1, .a = 2, .b = 3, .pad = 0, .val = 41 });
    let g: Rec = list.get[Rec](xs, 0);
    if (g.val != 41) { rc = 2; }
    // Touch the last record of the 2.4 GB block (only that page is committed).
    list.set[Rec](&xs, n - 1, Rec{ .op = 0, .a = 0, .b = 0, .pad = 0, .val = 1 });
    let last: Rec = list.get[Rec](xs, n - 1);
    if (last.val != 1) { rc = 3; }
    list.free[Rec](&xs);
    return rc;
}
