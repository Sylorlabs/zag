// std:math accuracy witness. Exit 42 when every check passes, otherwise the
// 1-based index of the first failing check.
@import("std:math") as math

fn near(got: f64, want: f64, tol: f64) bool {
    let d: f64 = got - want;
    if (d < 0.0) { d = 0.0 - d; }
    let scale: f64 = want;
    if (scale < 0.0) { scale = 0.0 - scale; }
    if (scale < 1.0) { scale = 1.0; }
    return d <= tol * scale;
}

fn main() i32 {
    let t: f64 = 0.000000000001;
    if (!near(math.sqrt(2.0), 1.4142135623730951, t)) { return 1; }
    if (!near(math.sqrt(1.0e10), 100000.0, t)) { return 2; }
    if (!near(math.sqrt(0.0001), 0.01, t)) { return 3; }
    if (!near(math.exp(1.0), 2.718281828459045, t)) { return 4; }
    if (!near(math.exp(-10.0) * math.exp(10.0), 1.0, t)) { return 5; }
    if (!near(math.ln(math.exp(50.0)), 50.0, t)) { return 6; }
    if (!near(math.ln(10.0), 2.302585092994046, t)) { return 7; }
    if (!near(math.ln(0.001), -6.907755278982137, t)) { return 8; }
    if (!near(math.ln(math.exp(3.25)), 3.25, t)) { return 9; }
    if (!near(math.pow(2.0, 10.0), 1024.0, t)) { return 10; }
    if (!near(math.pow(2.0, 0.5), 1.4142135623730951, t)) { return 11; }
    if (!near(math.pow(-3.0, 3.0), -27.0, t)) { return 12; }
    if (!near(math.tanh(0.5), 0.46211715726000974, t)) { return 13; }
    if (!near(math.sigmoid(0.0), 0.5, t)) { return 14; }
    if (!near(math.sin(math.pi() / 6.0), 0.5, t)) { return 15; }
    if (!near(math.cos(0.0), 1.0, t)) { return 16; }
    if (!near(math.floor(-2.5), -3.0, t)) { return 17; }
    if (!near(math.ceil(2.1), 3.0, t)) { return 18; }
    if (!math.is_nan(math.sqrt(-1.0))) { return 19; }
    if (!near(math.log2(8.0), 3.0, t)) { return 20; }
    return 42;
}
