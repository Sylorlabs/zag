// Cancellation-aware channel adapter contract.

@import("std:channel_i64") as base
@import("std:cancel_token_i64") as cancel
@import("std:channel_i64_cancel") as cancellable

fn main() i32 {
    let word: i64 = 0;
    let token: cancel.CancelTokenI64 = cancel.cancel_token_i64_invalid();
    if (cancel.cancel_token_i64_init(&token, (&word) as *i64) != 0) { return 1; }
    let created: base.ChannelI64Result = base.channel_i64_create(1);
    if (created.ok != 1) { return 2; }
    let channel: base.ChannelI64 = base.channel_i64_take(&created);
    let first: base.ChannelI64SendResult = base.channel_i64_try_send(&channel, 7);
    if (first.ok != 1) { return 3; }
    if (cancel.cancel_token_i64_request(&token) != 0) { return 4; }
    let cancelled_send: cancellable.ChannelI64CancelSendResult =
        cancellable.channel_i64_cancel_send_wait(&channel, &token, 99, 1000);
    if (cancelled_send.ok != 0 ||
        cancelled_send.code != cancellable.channel_i64_cancel_status_cancelled() ||
        base.channel_i64_count(&channel) != 1) { return 5; }
    let cancelled_receive: cancellable.ChannelI64CancelReceiveResult =
        cancellable.channel_i64_cancel_receive_wait(&channel, &token, 1000);
    if (cancelled_receive.ok != 0 ||
        cancelled_receive.code != cancellable.channel_i64_cancel_status_cancelled()) {
        return 6;
    }
    if (cancel.cancel_token_i64_close(&token) != 0) { return 7; }

    // The adapter accepts a five-second timeout and must not return its
    // bounded-attempt status after the old 64-slice (~640 ms) ceiling. Drain
    // the original item, then exercise both empty-receive and full-send
    // timeout paths with a live, non-cancelled token.
    let drained: base.ChannelI64ReceiveResult =
        base.channel_i64_try_receive(&channel);
    if (drained.ok != 1 || drained.value != 7) { return 8; }
    let timeout_word: i64 = 0;
    let timeout_token: cancel.CancelTokenI64 = cancel.cancel_token_i64_invalid();
    if (cancel.cancel_token_i64_init(&timeout_token, (&timeout_word) as *i64) != 0) {
        return 9;
    }
    let timed_receive: cancellable.ChannelI64CancelReceiveResult =
        cancellable.channel_i64_cancel_receive_wait(&channel, &timeout_token, 1000);
    if (timed_receive.ok != 0 ||
        timed_receive.code != base.channel_i64_status_empty() ||
        timed_receive.elapsed_ms < 850 || timed_receive.elapsed_ms > 2500) {
        return 10;
    }
    if (base.channel_i64_try_send(&channel, 9).ok != 1) { return 11; }
    let timed_send: cancellable.ChannelI64CancelSendResult =
        cancellable.channel_i64_cancel_send_wait(&channel, &timeout_token, 10, 1000);
    if (timed_send.ok != 0 ||
        timed_send.code != base.channel_i64_status_full() ||
        timed_send.elapsed_ms < 850 || timed_send.elapsed_ms > 2500) {
        return 12;
    }
    if (cancel.cancel_token_i64_close(&timeout_token) != 0 ||
        base.channel_i64_close(&channel) != 0) { return 13; }
    _zag_println("cancel-channel preflight=1 send=cancelled receive=cancelled timeout=honored");
    return 0;
}
