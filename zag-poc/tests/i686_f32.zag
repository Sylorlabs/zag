fn blend(tag: i32, x: f32, y: f32) f32 {
    if (tag == 9) { return x * y + 0.25; }
    return 0.0;
}
fn main() i32 {
    let a: f32 = 1.5;
    let b: f32 = 2.0;
    let c: f32 = blend(9, a, b);
    let d: f32 = (c - 0.25) / b;
    if (c == 3.25) { if (d >= 1.5) { if (d < 2.0) { return 42; } } }
    return 1;
}
