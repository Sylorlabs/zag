@import("../selfhost/zagd_transform_proposal.zag")

fn ztp_test_expect(value:i32,failures:*i32)void{if(value==0){failures.*=failures.*+1;}}

fn main()i32{
    let failures:i32=0;
    let source:ZagdHash=zagd_content_hash("source-v1");
    let semantic:ZagdHash=zagd_content_hash("semantic-v1");
    let target:ZagdHash=zagd_content_hash("linux-x86_64-generic");
    let compiler_identity:ZagdHash=zagd_content_hash("compiler-image-v1");
    let compiler:[]u8="test-compiler-v1";
    let p:ZagdTransformProposal=ZagdTransformProposal{.rule="const-i32-add-v1",.source=source,.semantic_identity=semantic,.target=target,.compiler=compiler,.compiler_identity=compiler_identity,.function_origin=7,.operation_origin=9,.lhs=2147483647,.rhs=1,.result=0-2147483648,.valid=1};
    let encoded:[]u8=ztp_encode(p);
    ztp_test_expect(encoded.len>0,&failures);
    let decoded:ZagdTransformProposalCheck=ztp_decode(encoded);
    ztp_test_expect(decoded.valid==1&&decoded.executable_authority==0,&failures);
    ztp_test_expect(decoded.proposal.lhs==2147483647&&decoded.proposal.rhs==1&&decoded.proposal.result==(0-2147483648),&failures);
    let bound:ZagdTransformProposalCheck=ztp_validate(encoded,source,semantic,target,compiler,compiler_identity);
    ztp_test_expect(bound.valid==1&&@strEq(bound.reason,"proposal-envelope-valid-checker-only"),&failures);
    let stale:ZagdTransformProposalCheck=ztp_validate(encoded,zagd_content_hash("other-source"),semantic,target,compiler,compiler_identity);
    ztp_test_expect(stale.valid==0&&@strEq(stale.reason,"stale-source-policy-binding"),&failures);

    let wrong:ZagdTransformProposal=p;wrong.result=1;
    ztp_test_expect(ztp_encode(wrong).len==0,&failures);
    let bad_origin:ZagdTransformProposal=p;bad_origin.operation_origin=0-1;
    ztp_test_expect(ztp_encode(bad_origin).len==0,&failures);
    let empty:ZagdTransformProposalCheck=ztp_decode("");
    ztp_test_expect(empty.valid==0&&empty.executable_authority==0,&failures);
    // A producer cannot turn the envelope into authority by changing the
    // decoded status: the only successful decode status is checker-only.
    ztp_test_expect(decoded.executable_authority==0,&failures);
    if(failures==0){_zag_println("zagd transform proposal: PASS");}return failures;
}
