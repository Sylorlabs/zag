enum Support { supported, experimental, unavailable }
enum Backend { none, headless, x11 }

extern fn XOpenDisplay(name: *u8) *u8;
extern fn XDefaultScreen(display: *u8) i32;
extern fn XRootWindow(display: *u8, screen: i32) i64;
extern fn XCreateSimpleWindow(display: *u8, parent: i64, x: i32, y: i32,
    width: i32, height: i32, border_width: i32, border: i64,
    background: i64) i64;
extern fn XDestroyWindow(display: *u8, window: i64) i32;
extern fn XCloseDisplay(display: *u8) i32;

struct Capability { status: Support, reason: []u8 }

struct Capabilities {
    requested: Backend,
    active: Backend,
    window: Capability,
    cpu: Capability,
    gpu: Capability,
    accessibility: Capability,
    text_input: Capability,
    fallback: i32,
    fallback_reason: []u8,
}

struct Host {
    display: *u8,
    visual: *u8,
    window: i64,
    gc: *u8,
    image: *u8,
    image_data: *u8,
    event_data: *u8,
    atom: i64,
    depth: i32,
    width: i32,
    height: i32,
    open: i32,
    error: i32,
    capabilities: Capabilities,
}

fn capability(status: Support, reason: []u8) Capability {
    return Capability{ .status = status, .reason = reason };
}

fn headless() Capabilities {
    return Capabilities{
        .requested = Backend.headless,
        .active = Backend.headless,
        .window = capability(Support.unavailable, "no window"),
        .cpu = capability(Support.supported, "cpu"),
        .gpu = capability(Support.unavailable, "no gpu"),
        .accessibility = capability(Support.unavailable, "no a11y"),
        .text_input = capability(Support.unavailable, "no ime"),
        .fallback = 0,
        .fallback_reason = "",
    };
}

fn automatic(x11: i32) Capabilities {
    let result: Capabilities = headless();
    if (x11 != 0) {
        result.requested = Backend.none;
        result.active = Backend.x11;
        result.window = capability(Support.experimental, "x11");
    }
    return result;
}

fn empty_host() Host {
    return Host{
        .display = null as *u8,
        .visual = null as *u8,
        .window = 0,
        .gc = null as *u8,
        .image = null as *u8,
        .image_data = null as *u8,
        .event_data = null as *u8,
        .atom = 0,
        .depth = 0,
        .width = 0,
        .height = 0,
        .open = 0,
        .error = 0,
        .capabilities = automatic(1),
    };
}

fn open_host() Host {
    let host: Host = empty_host();
    host.capabilities = automatic(1);
    host.display = XOpenDisplay(null as *u8);
    if (host.display != null as *u8) {
        let screen: i32 = XDefaultScreen(host.display);
        let root: i64 = XRootWindow(host.display, screen);
        host.window = XCreateSimpleWindow(host.display, root, 0, 0,
            64, 64, 0, 0, 0);
        if (host.window != 0) { _ = XDestroyWindow(host.display, host.window); }
        _ = XCloseDisplay(host.display);
        host.display = null as *u8;
    }
    host.width = 21;
    host.height = 21;
    return host;
}

fn main() i32 {
    let host: Host = open_host();
    if (host.capabilities.active == Backend.x11 &&
        host.capabilities.cpu.status == Support.supported) {
        return host.width + host.height;
    }
    return 1;
}
