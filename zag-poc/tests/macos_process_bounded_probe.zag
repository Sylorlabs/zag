@import("../selfhost/std/process.zag") as process

fn main() i32 {
    let result: process.ProcessResult = process.process_run_bounded("printf hello",1000,1024);
    let state:i32=process.process_result_state(result);
    if(state!=0){return 10+state;}
    let status:i32=process.process_result_status(result);
    if(status!=0){return 20+status;}
    if(!@strEq(process.process_result_output(result),"hello")){return 30;}
    return 42;
}
