@import("../selfhost/std/script_map.zag") as m
extern fn _zag_script_context_init(limit:i64, capabilities:i64, execution_policy:i64) *opaque
extern fn _zag_script_context_shutdown(context:*opaque) void
extern fn _zag_script_alloc_used(context:*opaque) i64

fn check_set(policy: i64, overhead: i64) i32 {
    unsafe {
        let limit: i64 = m.script_map_storage_bytes[i64](4) + overhead +
            4 * (1 + overhead) + m.script_map_storage_bytes[i64](8) + 1 + overhead;
        let context: *opaque = _zag_script_context_init(limit, 7, policy);
        let map: m.ScriptMap[i64] = m.script_map_new_checked[i64](context, 4);
        m.script_map_set_checked[i64](&map, "a", 0);
        m.script_map_set_checked[i64](&map, "i", 2);
        m.script_map_set_checked[i64](&map, "q", 3);
        m.script_map_set_checked[i64](&map, "y", 4);
        let used: i64 = _zag_script_alloc_used(context);
        m.script_map_set_checked[i64](&map, "a", 9);
        if (map.len != 4 || _zag_script_alloc_used(context) != used ||
            m.script_map_index_checked[i64](map, "a") != 9) { return 6; }
        m.script_map_set_checked[i64](&map, "z", 5);
        if (map.len != 5 || map.cap != 8 || _zag_script_alloc_used(context) != limit ||
            m.script_map_index_checked[i64](map, "z") != 5 ||
            m.script_map_index_checked[i64](map, "q") != 3) { return 7; }
        // Replacement still succeeds at the exact allocation budget boundary.
        m.script_map_set_checked[i64](&map, "a", 10);
        let first: m.ScriptMapLookup[i64] = m.script_map_at[i64](map, 0);
        if (!@strEq(first.key, "a") || first.value.* != 10 ||
            _zag_script_alloc_used(context) != limit) { return 8; }
        _zag_script_context_shutdown(context);
    }
    return 0;
}

fn main() i32 {
    unsafe {
        let mode: []u8 = _zag_arg(1);
        if (@strEq(mode, "set") || @strEq(mode, "set_heap")) {
            let policy: i64 = 16843009;
            let overhead: i64 = 0;
            if (@strEq(mode, "set_heap")) { policy = 16843010; overhead = 16; }
            let exhausted: *opaque = _zag_script_context_init(
                m.script_map_storage_bytes[i64](8) + overhead, 7, policy);
            let target: m.ScriptMap[i64] = m.script_map_new_checked[i64](exhausted, 8);
            m.script_map_set_checked[i64](&target, "a", 1);
            return 9;
        }
        if (@strEq(mode, "constructor")) {
            let small: *opaque = _zag_script_context_init(1, 7, 16843009);
            let failed: m.ScriptMap[i64] = m.script_map_new_checked[i64](small, 8);
            return 2;
        }
        if (@strEq(mode, "insert")) {
            let full: *opaque = _zag_script_context_init(m.script_map_storage_bytes[i64](8), 7, 16843009);
            let failed: m.ScriptMap[i64] = m.script_map_insert_checked[i64](
                m.script_map_new_checked[i64](full, 8), "a", 1);
            return 3;
        }
        let context: *opaque = _zag_script_context_init(4096, 7, 16843009);
        let map: m.ScriptMap[i64] = m.script_map_insert_checked[i64](
            m.script_map_insert_checked[i64](m.script_map_new_checked[i64](context, 8), "a", 1), "a", 2);
        if (@strEq(mode, "missing")) {
            let missing: i64 = m.script_map_index_checked[i64](map, "missing");
            return 4;
        }
        if (m.script_map_index_checked[i64](map, "a") != 2 || map.len != 1) { return 5; }
        _zag_script_context_shutdown(context);
    }
    let status: i32 = check_set(16843009, 0);
    if (status != 0) { return status; }
    return check_set(16843010, 16);
}
