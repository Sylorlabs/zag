@import("../selfhost/native/macho_dylib.zag")

// These malformed records must fail before any output can be written. The
// successful image below is independently loaded and inspected by Apple tools.
fn invalid_case(kind: i32) i32 {
    let encoded: MobjEncoded = MobjEncoded{.text=make[u8](8),
        .symbols=make[MobjSymbol](2),.relocs=make[MobjReloc](2),.valid=1};
    mo_le(&encoded.text,0x94000000,4); mo_le(&encoded.text,0xd65f03c0,4);
    push[MobjSymbol](&encoded.symbols,MobjSymbol{.name=_zag_str_concat("","_answer"),.section=1,.offset=0,.external=1,.weak=0});
    push[MobjSymbol](&encoded.symbols,MobjSymbol{.name=_zag_str_concat("","_getpid"),.section=0,.offset=0,.external=1,.weak=0});
    push[MobjReloc](&encoded.relocs,MobjReloc{.section=1,.offset=0,.symbol=1,.kind=2});
    let data: ArrayList[u8] = make[u8](8); mo_zero(&data,8);
    let libraries: ArrayList[[]u8] = make[[]u8](2); push[[]u8](&libraries,"/usr/lib/libSystem.B.dylib");
    let imports: ArrayList[MdylibImport] = make[MdylibImport](2);
    push[MdylibImport](&imports,MdylibImport{.symbol=1,.library=1,.weak=0});
    let rpaths: ArrayList[[]u8] = make[[]u8](1);
    let install_name: []u8 = "@rpath/libprobe.dylib"; let entry: i32 = -1;
    if (kind == 1) { encoded.valid = 0; }
    if (kind == 2) { imports.len = 0; }
    if (kind == 3) { imports.data[0].library = 2; }
    if (kind == 4) { imports.data[0].symbol = 0; }
    if (kind == 5) { push[MdylibImport](&imports,imports.data[0]); }
    if (kind == 6) { install_name = ""; }
    if (kind == 7) { push[[]u8](&libraries,libraries.data[0]); }
    if (kind == 8) { entry = -2; }
    if (kind == 9) { entry = 1; }
    if (kind == 10) { encoded.symbols.data[0].offset = 1; }
    if (kind == 11) { md_patch(&encoded.text,0,0x94000001,4); }
    if (kind == 12) {
        push[MobjReloc](&encoded.relocs,MobjReloc{.section=2,.offset=0,.symbol=0,.kind=0}); data.data[0] = 1;
    }
    if (kind == 13) { encoded.relocs.data[0] = MobjReloc{.section=1,.offset=0,.symbol=0,.kind=0}; }
    if (kind == 14) { encoded.relocs.data[0].symbol = 2; }
    if (kind == 15) { encoded.relocs.data[0].offset = 2; }
    if (kind == 16) { push[[]u8](&rpaths,"bad\0path"); }
    if (kind == 17) { libraries.data[0] = "bad\0library"; }
    if (kind == 18) { encoded.text.len = 6; }
    // TLVP PAGE21 remains outside the compact dynamic-link IR; kind 7
    // (POINTER_TO_GOT) is now a supported static-input relocation.
    if (kind == 19) { encoded.relocs.data[0].kind = 8; }
    if (kind == 20) { encoded.relocs.data[0].kind = 3; md_patch(&encoded.text,0,0x90000000,4); }
    if (kind == 21) { while (rpaths.len < 254) { push[[]u8](&rpaths,"@loader_path"); } }
    if (kind == 22) { imports.data[0].library=-2; }
    if (kind == 23) { encoded.symbols.data[1].weak=1; }
    let errors: i32 = 0;
    let image: ArrayList[u8] = md_build_full(encoded,data,libraries,imports,install_name,entry,rpaths,&errors);
    let rejected: i32 = (errors != 0 && image.len == 0) as i32;
    free[u8](&image); mobj_encoded_release(&encoded); free[u8](&data);
    free[[]u8](&libraries); free[MdylibImport](&imports); free[[]u8](&rpaths);
    return rejected;
}

fn main() i32 {
    if (_zag_argc() != 2) { return 2; }
    let invalid: i32 = 1;
    while (invalid <= 23) {
        if (invalid_case(invalid) != 1) {
            _zag_eprintln(_zag_str_concat("accepted invalid dylib case ",_zag_i64_to_str(invalid as i64))); return 3;
        }
        invalid = invalid+1;
    }
    let program: ArrayList[AInstr] = make[AInstr](40);
    let data: ArrayList[u8] = make[u8](24); mo_zero(&data,24); data.data[8] = 42;
    let foreign: ArrayList[[]u8] = make[[]u8](1); push[[]u8](&foreign,"getpid");
    let exports: ArrayList[AObjectExport] = make[AObjectExport](305);
    push[AObjectExport](&exports,AObjectExport{.name="zag_answer",.label=1});
    push[AObjectExport](&exports,AObjectExport{.name="zag_answer_pointer",.label=2});
    push[AObjectExport](&exports,AObjectExport{.name="zag_pid",.label=3});
    push[AObjectExport](&exports,AObjectExport{.name="zag_rebased_pointer",.label=4});
    push[AObjectExport](&exports,AObjectExport{.name="zag_bound_pointer",.label=5});
    let i: i32 = 0;
    while (i < 300) {
        let number: []u8 = _zag_i64_to_str(i as i64);
        push[AObjectExport](&exports,AObjectExport{.name=_zag_str_concat("zag_export_",number),.label=1});
        _zag_str_free(number); i = i+1;
    }
    push[AInstr](&program,ai_fn_label(1));
    push[AInstr](&program,ai_data_addr(A_X0(),8));
    push[AInstr](&program,ai_load(A_X0(),A_X0(),0)); push[AInstr](&program,ai_ret());
    push[AInstr](&program,ai_fn_label(2));
    push[AInstr](&program,ai_lea_lbl(A_X0(),1)); push[AInstr](&program,ai_ret());
    push[AInstr](&program,ai_fn_label(3));
    push[AInstr](&program,ai_sub_imm(A_SP(),16)); push[AInstr](&program,ai_store(A_SP(),0,A_X30()));
    push[AInstr](&program,ai_extern_call(0)); push[AInstr](&program,ai_load(A_X30(),A_SP(),0));
    push[AInstr](&program,ai_add_imm(A_SP(),16)); push[AInstr](&program,ai_ret());
    push[AInstr](&program,ai_fn_label(4));
    push[AInstr](&program,ai_data_addr(A_X0(),0)); push[AInstr](&program,ai_load(A_X0(),A_X0(),0));
    push[AInstr](&program,ai_ret());
    push[AInstr](&program,ai_fn_label(5));
    push[AInstr](&program,ai_data_addr(A_X0(),16)); push[AInstr](&program,ai_load(A_X0(),A_X0(),0));
    push[AInstr](&program,ai_ret());
    let encoded: MobjEncoded = mobj_encode_macos(program,data,foreign,exports);
    if (encoded.valid == 0) { return 4; }
    let answer_symbol: i32 = -1; i = 0;
    while (i < encoded.symbols.len) {
        if (@strEq(encoded.symbols.data[i].name,"_zag_answer")) { answer_symbol = i; }
        i = i+1;
    }
    let pid_symbol: i32 = mobj_find_undefined(encoded.symbols,"_getpid");
    if (answer_symbol < 0 || pid_symbol < 0) { return 5; }
    push[MobjReloc](&encoded.relocs,MobjReloc{.section=2,.offset=0,.symbol=answer_symbol,.kind=0});
    push[MobjReloc](&encoded.relocs,MobjReloc{.section=2,.offset=16,.symbol=pid_symbol,.kind=0});
    let libraries: ArrayList[[]u8] = make[[]u8](1); push[[]u8](&libraries,"/usr/lib/libSystem.B.dylib");
    let imports: ArrayList[MdylibImport] = make[MdylibImport](1);
    push[MdylibImport](&imports,MdylibImport{.symbol=pid_symbol,.library=1,.weak=0});
    let result: i32 = md_write(_zag_arg(1),encoded,data,libraries,imports,"@rpath/libzag-probe.dylib");
    mobj_encoded_release(&encoded); free[AInstr](&program); free[u8](&data);
    free[[]u8](&foreign); free[MdylibImport](&imports); free[[]u8](&libraries);
    i = 5; while (i < exports.len) { _zag_str_free(exports.data[i].name); i = i+1; }
    free[AObjectExport](&exports);
    return result;
}
