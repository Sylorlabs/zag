// AVX2/FMA packed-f32 intrinsic contract (@simdF32* builtins).
// Exercises the register-tiled reduction folds and elementwise kernels
// against scalar reference loops.
@import("std/list.zag")
fn main() i32 {
    unsafe {
        let n: i64 = 40;
        let a: ArrayList[f32] = make[f32](n);
        let b: ArrayList[f32] = make[f32](n);
        let o: ArrayList[f32] = make[f32](n);
        a.len = n; b.len = n; o.len = n;
        let i: i64 = 0;
        while (i < n) {
            a.data[i] = ((i % 9) + 1) as f32;
            b.data[i] = ((i % 5) + 1) as f32;
            i = i + 1;
        }
        let ap: *f32 = a.data;
        let bp: *f32 = b.data;
        let op: *f32 = o.data;

        let k: i64 = 0;
        let ref: f64 = 0.0;
        while (k < n) { ref = ref + (a.data[k] as f64) * (b.data[k] as f64); k = k + 1; }
        let d: f64 = @simdF32Dot(ap, bp, n);
        if (d < ref - 0.001 || d > ref + 0.001) { return 10; }

        let sref: f64 = 0.0;
        k = 0;
        while (k < n) { sref = sref + (a.data[k] as f64); k = k + 1; }
        let s: f64 = @simdF32Sum(ap, n);
        if (s < sref - 0.001 || s > sref + 0.001) { return 11; }

        // dot4: 4 column dots, block stride 10 over a 4x10 b-panel.
        let b4: ArrayList[f32] = make[f32](40);
        b4.len = 40;
        i = 0;
        while (i < 40) { b4.data[i] = ((i % 7) + 1) as f32; i = i + 1; }
        let o4: ArrayList[f32] = make[f32](4);
        o4.len = 4;
        @simdF32Dot4(o4.data, ap, b4.data, 10, 10);
        let j: i64 = 0;
        while (j < 4) {
            let r: f64 = 0.0;
            let kk: i64 = 0;
            while (kk < 10) { r = r + (a.data[kk] as f64) * (b4.data[(j * 10 + kk)] as f64); kk = kk + 1; }
            let got: f64 = o4.data[j] as f64;
            if (got < r - 0.01 || got > r + 0.01) { return (20 + j) as i32; }
            j = j + 1;
        }

        @simdF32Axpy(op, 3.0, bp, n);
        i = 0;
        while (i < n) { if ((o.data[i] as f64) != 3.0 * (b.data[i] as f64)) { return 30; } i = i + 1; }

        @simdF32Add(op, ap, bp, n);
        i = 0;
        while (i < n) { if (o.data[i] != a.data[i] + b.data[i]) { return 40; } i = i + 1; }
        @simdF32Sub(op, ap, bp, n);
        i = 0;
        while (i < n) { if (o.data[i] != a.data[i] - b.data[i]) { return 41; } i = i + 1; }
        @simdF32Mul(op, ap, bp, n);
        i = 0;
        while (i < n) { if (o.data[i] != a.data[i] * b.data[i]) { return 42; } i = i + 1; }

        @simdF32Scale(op, ap, 0.5, n);
        i = 0;
        while (i < n) { if (o.data[i] != (0.5 as f32) * a.data[i]) { return 43; } i = i + 1; }

        @simdF32Copy(op, ap, n);
        i = 0;
        while (i < n) { if (o.data[i] != a.data[i]) { return 44; } i = i + 1; }

        // n not a multiple of 8: scalar tail must cover lanes 33..39.
        let d2: f64 = @simdF32Dot(ap, bp, 37);
        let ref2: f64 = 0.0;
        k = 0;
        while (k < 37) { ref2 = ref2 + (a.data[k] as f64) * (b.data[k] as f64); k = k + 1; }
        if (d2 < ref2 - 0.001 || d2 > ref2 + 0.001) { return 50; }

        return 0;
    }
}
