// AVX2/FMA packed-f32 intrinsic contract (@simdF32* builtins).
// Exercises the register-tiled reduction folds and elementwise kernels
// against scalar reference loops. n=40 exercises the 8-wide vector loop
// plus a 4-element scalar tail; n must stay a non-multiple of 8.
// Single exit: every check folds into `bad` so all buffers are freed on
// every path (the ownership checker flags early returns that leak).
fn main() i32 {
    unsafe {
        let n: i64 = 40;
        let a: *f32 = _zag_malloc(n * 4) as *f32;
        let b: *f32 = _zag_malloc(n * 4) as *f32;
        let o: *f32 = _zag_malloc(n * 4) as *f32;
        let cd: *f64 = _zag_malloc(n * 8) as *f64;
        let b4: *f32 = _zag_malloc(160) as *f32;
        let o4: *f32 = _zag_malloc(16) as *f32;
        let bad: i32 = 0;
        let i: i64 = 0;
        while (i < n) {
            a[i] = ((i % 9) + 1) as f32;
            b[i] = ((i % 5) + 1) as f32;
            i = i + 1;
        }
        i = 0;
        while (i < 40) { b4[i] = ((i % 7) + 1) as f32; i = i + 1; }

        let k: i64 = 0;
        let ref: f64 = 0.0;
        while (k < n) { ref = ref + (a[k] as f64) * (b[k] as f64); k = k + 1; }
        let d: f64 = @simdF32Dot(a, b, n);
        if (d < ref - 0.001 || d > ref + 0.001) { bad = 10; }

        let sref: f64 = 0.0;
        k = 0;
        while (k < n) { sref = sref + (a[k] as f64); k = k + 1; }
        let s: f64 = @simdF32Sum(a, n);
        if (s < sref - 0.001 || s > sref + 0.001) { bad = 11; }

        // dot4: four column dots, block stride 10 over a 4x10 b-panel.
        @simdF32Dot4(o4, a, b4, 10, 10);
        let j: i64 = 0;
        while (j < 4) {
            let r: f64 = 0.0;
            let kk: i64 = 0;
            while (kk < 10) { r = r + (a[kk] as f64) * (b4[(j * 10 + kk)] as f64); kk = kk + 1; }
            let got: f64 = o4[j] as f64;
            if (got < r - 0.01 || got > r + 0.01) { bad = (20 + j) as i32; }
            j = j + 1;
        }

        // dot8: eight column dots over the same 4x10 panel treated as 8x10
        // (b4 holds 40 elems; bs=10,n=10 reads cols 0-3 then wraps — use a
        // dedicated 8-col panel instead).
        let b8: *f32 = _zag_malloc(320) as *f32;
        let o8: *f32 = _zag_malloc(32) as *f32;
        i = 0;
        while (i < 80) { b8[i] = ((i % 11) + 1) as f32; i = i + 1; }
        @simdF32Dot8(o8, a, b8, 10, 10);
        j = 0;
        while (j < 8) {
            let r8: f64 = 0.0;
            let kk: i64 = 0;
            while (kk < 10) { r8 = r8 + (a[kk] as f64) * (b8[(j * 10 + kk)] as f64); kk = kk + 1; }
            let got8: f64 = o8[j] as f64;
            if (got8 < r8 - 0.01 || got8 > r8 + 0.01) { bad = (50 + j) as i32; }
            j = j + 1;
        }
        _zag_free(b8 as *i8);
        _zag_free(o8 as *i8);

        @simdF32Axpy(o, 3.0, b, n);
        i = 0;
        while (i < n) { if ((o[i] as f64) != 3.0 * (b[i] as f64)) { bad = 30; } i = i + 1; }

        @simdF32Add(o, a, b, n);
        i = 0;
        while (i < n) { if (o[i] != a[i] + b[i]) { bad = 40; } i = i + 1; }
        @simdF32Sub(o, a, b, n);
        i = 0;
        while (i < n) { if (o[i] != a[i] - b[i]) { bad = 41; } i = i + 1; }
        @simdF32Mul(o, a, b, n);
        i = 0;
        while (i < n) { if (o[i] != a[i] * b[i]) { bad = 42; } i = i + 1; }

        @simdF32Scale(o, a, 0.5, n);
        i = 0;
        while (i < n) { if ((o[i] as f64) != (a[i] as f64) * 0.5) { bad = 43; } i = i + 1; }

        @simdF32Copy(o, a, n);
        i = 0;
        while (i < n) { if (o[i] != a[i]) { bad = 44; } i = i + 1; }

        // widen-add: f64 destination accumulates widened f32 source.
        // n exercises both the 4-wide vcvtps2pd body and the scalar tail.
        i = 0;
        while (i < n) { cd[i] = 1.0; i = i + 1; }
        @simdF32WidenAdd(cd, a, n);
        i = 0;
        while (i < n) { if (cd[i] != 1.0 + (a[i] as f64)) { bad = 45; } i = i + 1; }
        @simdF32WidenAdd(cd, a, n);
        i = 0;
        while (i < n) { if (cd[i] != 1.0 + 2.0 * (a[i] as f64)) { bad = 46; } i = i + 1; }

        // widen/narrow round-trip and standalone zero: reuse a/o/cd buffers.
        i = 0;
        while (i < n) { cd[i] = 0.0; i = i + 1; }
        @simdF32Widen(cd, a, n);
        i = 0;
        while (i < n) { if (cd[i] != (a[i] as f64)) { bad = 47; } i = i + 1; }
        @simdF64Narrow(o, cd, n);
        i = 0;
        while (i < n) { if (o[i] != a[i]) { bad = 48; } i = i + 1; }
        @simdF32Zero(o, n);
        i = 0;
        while (i < n) { if (o[i] != 0.0) { bad = 49; } i = i + 1; }

        // fused Adam: md,vd accumulate over two calls; n exercises the
        // 4-wide body plus the scalar tail. Params match the engine order.
        let pm: *f64 = _zag_malloc(9 * 8) as *f64;
        pm[0] = 1.0; pm[1] = 0.9; pm[2] = 0.1; pm[3] = 0.999; pm[4] = 0.001;
        pm[5] = 1.0; pm[6] = 1.0; pm[7] = 0.001; pm[8] = 0.00000001;
        i = 0;
        while (i < n) { cd[i] = 0.0; o[i] = (a[i] * a[i]) as f32; i = i + 1; }
        let gd: *f64 = _zag_malloc(n * 8) as *f64;
        let mdb: *f64 = _zag_malloc(n * 8) as *f64;
        let vdb: *f64 = _zag_malloc(n * 8) as *f64;
        i = 0;
        while (i < n) { mdb[i] = 0.0; vdb[i] = 0.0; cd[i] = 1.0; gd[i] = (a[i] as f64) * 0.01; i = i + 1; }
        @simdF64Adam(cd, gd, mdb, vdb, n, pm);
        // md = 0.1*g, vd = 0.001*g^2, d = 1 - 0.001*(md/1)/(sqrt(vd/1)+eps)
        i = 0;
        while (i < n) {
            let gg: f64 = gd[i];
            let md0: f64 = mdb[i] - 0.1 * gg;
            if (md0 < 0.0) { md0 = 0.0 - md0; }
            if (md0 > 0.0000000001) { bad = 50; }
            let vd0: f64 = vdb[i] - 0.001 * gg * gg;
            if (vd0 < 0.0) { vd0 = 0.0 - vd0; }
            if (vd0 > 0.0000000001) { bad = 51; }
            let dd: f64 = 1.0 - 0.001 * (0.1 * gg) / (sqrt(0.001 * gg * gg) + 0.00000001);
            let diff: f64 = cd[i] - dd;
            if (diff < 0.0) { diff = 0.0 - diff; }
            if (diff > 0.0000000001) { bad = 52; }
            i = i + 1;
        }
        // second call accumulates: md = 0.9*md + 0.1*g = 0.19*g
        @simdF64Adam(cd, gd, mdb, vdb, n, pm);
        i = 0;
        while (i < n) {
            let mdiff: f64 = mdb[i] - 0.19 * gd[i];
            if (mdiff < 0.0) { mdiff = 0.0 - mdiff; }
            if (mdiff > 0.0000000001) { bad = 53; }
            i = i + 1;
        }
        _zag_free(mdb as *i8);
        _zag_free(vdb as *i8);
        _zag_free(gd as *i8);
        _zag_free(pm as *i8);

        _zag_free(cd as *i8);
        _zag_free(a as *i8);
        _zag_free(b as *i8);
        _zag_free(o as *i8);
        _zag_free(b4 as *i8);
        _zag_free(o4 as *i8);
        return bad;
    }
}
