@import("std/allocator.zag")

fn work() !i32 {
    let system: SystemAllocator = system_allocator();
    let backing: Allocation = try system.allocate(64, 8);
    let fixed: FixedBufferAllocator = try fixed_buffer_allocator(backing);
    let metrics: ArenaTelemetry = fixed.telemetry();
    let released: Allocation = try fixed.deinit();
    try system.deallocate(released);
    return metrics.used as i32;
}

fn main() i32 { return work() catch 9; }
