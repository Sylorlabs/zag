// Linux x86-64 event adapter for zagd. Pure Zag, libc-free raw syscalls.
// Recursively discovers project directories with getdents64 and maintains one
// inotify watch per directory, including directories created after startup.

@import("../std/list.zag")

extern fn _zag_raw_syscall(num: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64) i64
extern fn _zag_slice_ptr(s: []u8) *i8

fn zagd_sys_inotify_init1() i64 { return 294; }
fn zagd_set_low_priority() void { let _rc:i64=_zag_raw_syscall(141,0,0,10,0,0,0); }
fn zagd_sys_inotify_add_watch() i64 { return 254; }
fn zagd_sys_read() i64 { return 0; }
fn zagd_sys_close() i64 { return 3; }
fn zagd_sys_nanosleep() i64 { return 35; }
fn zagd_sys_getpid() i64 { return 39; }
fn zagd_sys_fork() i64 { return 57; }
fn zagd_sys_unlink() i64 { return 87; }
fn zagd_sys_kill() i64 { return 62; }
fn zagd_sys_getdents64() i64 { return 217; }
fn zagd_sys_openat() i64 { return 257; }

fn zagd_in_cloexec() i64 { return 524288; }
fn zagd_in_create() i64 { return 256; }
fn zagd_in_delete() i64 { return 512; }
fn zagd_in_modify() i64 { return 2; }
fn zagd_in_close_write() i64 { return 8; }
fn zagd_in_moved_from() i64 { return 64; }
fn zagd_in_moved_to() i64 { return 128; }
fn zagd_in_attrib() i64 { return 4; }
fn zagd_in_isdir() i64 { return 1073741824; }
fn zagd_watch_mask() i64 { return 974; }
fn zagd_at_fdcwd() i64 { return 0 - 100; }
fn zagd_o_directory_read() i64 { return 589824; }
fn zagd_o_lock_create() i64 { return 524481; }

struct ZagdTimespec { sec: i64, nsec: i64 }

fn zagd_sleep_ms(ms: i64) void {
    let delay: i64 = ms;
    if (delay < 0) { delay = 0; }
    let ts: ZagdTimespec = ZagdTimespec{ .sec = delay / 1000,
        .nsec = (delay % 1000) * 1000000 };
    let _rc: i64 = _zag_raw_syscall(zagd_sys_nanosleep(), (&ts) as i64, 0, 0, 0, 0, 0);
}

fn zagd_c_string(value: []u8) ArrayList[u8] {
    let out: ArrayList[u8] = make[u8](value.len + 1);
    let i: i32 = 0;
    while (i < value.len) { push[u8](&out, value[i]); i = i + 1; }
    push[u8](&out, 0 as u8);
    return out;
}

fn zagd_ptr(bytes: []u8) i64 { return _zag_slice_ptr(bytes) as i64; }

fn zagd_inotify_open() i64 {
    return _zag_raw_syscall(zagd_sys_inotify_init1(), zagd_in_cloexec(), 0, 0, 0, 0, 0);
}

fn zagd_inotify_watch(fd: i64, path: []u8) i64 {
    let cpath: ArrayList[u8] = zagd_c_string(path);
    return _zag_raw_syscall(zagd_sys_inotify_add_watch(), fd,
        zagd_ptr(cpath.data[0..cpath.len]), zagd_watch_mask(), 0, 0, 0);
}

fn zagd_close(fd: i64) void {
    if (fd >= 0) { let _rc: i64 = _zag_raw_syscall(zagd_sys_close(), fd, 0, 0, 0, 0, 0); }
}

fn zagd_unlink(path: []u8) void {
    let cpath: ArrayList[u8] = zagd_c_string(path);
    let _rc: i64 = _zag_raw_syscall(zagd_sys_unlink(), zagd_ptr(cpath.data[0..cpath.len]), 0, 0, 0, 0, 0);
}

fn zagd_read_events(fd: i64, buffer: *ArrayList[u8]) i64 {
    if (buffer.*.len < 4096) {
        while (buffer.*.len < 4096) { push[u8](buffer, 0 as u8); }
    }
    return _zag_raw_syscall(zagd_sys_read(), fd,
        zagd_ptr(buffer.*.data[0..buffer.*.len]), buffer.*.len, 0, 0, 0);
}

fn zagd_u32_at(data: []u8, off: i32) i64 {
    return (data[off] as i64) + (data[off + 1] as i64) * 256 +
        (data[off + 2] as i64) * 65536 + (data[off + 3] as i64) * 16777216;
}

fn zagd_u16_at(data: []u8, off: i32) i32 {
    return (data[off] as i32) + (data[off + 1] as i32) * 256;
}

fn zagd_mask_has(mask: i64, bit: i64) i32 { return ((mask / bit) % 2) as i32; }

fn zagd_event_name(data: []u8, off: i32, name_bytes: i32) []u8 {
    let n: i32 = 0;
    while (n < name_bytes && data[off + n] != 0) { n = n + 1; }
    return data[off..off + n];
}

fn zagd_has_suffix(value: []u8, suffix: []u8) i32 {
    if (suffix.len > value.len) { return 0; }
    let i: i32 = 0;
    while (i < suffix.len) {
        if (value[value.len - suffix.len + i] != suffix[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn zagd_ignored_name(name: []u8) i32 {
    if (name.len == 0) { return 1; }
    if (@strEq(name, ".zagd.status") || @strEq(name, ".zagd.lock") ||
        @strEq(name, ".zagd.stop") || @strEq(name, ".zag-cache") ||
        @strEq(name, "zig-cache") || @strEq(name, "build") ||
        @strEq(name, "dist") || @strEq(name, "target")) { return 1; }
    if (zagd_has_suffix(name, "~") || zagd_has_suffix(name, ".tmp") ||
        zagd_has_suffix(name, ".swp") || zagd_has_suffix(name, ".part")) { return 1; }
    if (name.len > 1 && name[0] == '.' && name[1] == '#') { return 1; }
    return 0;
}

fn zagd_join_path(root: []u8, name: []u8) []u8 {
    if (root.len > 0 && root[root.len - 1] == '/') { return _zag_str_concat(root, name); }
    return _zag_str_concat(root, _zag_str_concat("/", name));
}

fn zagd_fork() i64 { return _zag_raw_syscall(zagd_sys_fork(), 0, 0, 0, 0, 0, 0); }
fn zagd_pid() i64 { return _zag_raw_syscall(zagd_sys_getpid(), 0, 0, 0, 0, 0, 0); }

fn zagd_pid_alive(pid: i64) i32 {
    if (pid < 2) { return 0; }
    let rc: i64 = _zag_raw_syscall(zagd_sys_kill(), pid, 0, 0, 0, 0, 0);
    if (rc == 0) { return 1; }
    // Linux returns -ESRCH (-3) only when no such process exists. EPERM and all
    // other failures are conservatively treated as alive for singleton safety.
    if (rc == (0 - 3)) { return 0; }
    return 1;
}

fn zagd_open_lock(path: []u8) i64 {
    let cpath: ArrayList[u8] = zagd_c_string(path);
    return _zag_raw_syscall(zagd_sys_openat(), zagd_at_fdcwd(),
        zagd_ptr(cpath.data[0..cpath.len]), zagd_o_lock_create(), 384, 0, 0);
}

fn zagd_open_directory(path: []u8) i64 {
    let cpath: ArrayList[u8] = zagd_c_string(path);
    return _zag_raw_syscall(zagd_sys_openat(), zagd_at_fdcwd(),
        zagd_ptr(cpath.data[0..cpath.len]), zagd_o_directory_read(), 0, 0, 0);
}

fn zagd_getdents(fd: i64, buffer: *ArrayList[u8]) i64 {
    if (buffer.*.len < 4096) { while (buffer.*.len < 4096) { push[u8](buffer, 0 as u8); } }
    return _zag_raw_syscall(zagd_sys_getdents64(), fd,
        zagd_ptr(buffer.*.data[0..buffer.*.len]), buffer.*.len, 0, 0, 0);
}
