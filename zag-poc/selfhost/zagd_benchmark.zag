// Direct Linux x86-64 finalist execution. This intentionally does not use a
// shell: the reviewed finalist path is the execve target.
@import("zagd.zag")
@import("std:list")

struct ZagdBenchmarkRequest { explicit:i32, mode:i32, finalists:i32, timeout_ms:i64, max_memory:i64, source:ZagdHash, stable_source:ZagdHash, target:ZagdHash, active_target:ZagdHash, cancelled:i32, network:i32, gpu:i32, source_writes:i32 }
struct ZagdBenchmarkDecision { allowed:i32, reason:i32, max_finalists:i32, execution_supported:i32, requires_output_witness:i32, provenance:i32 }
struct ZagdExecutionResult { state:i32, exit_code:i32, term_signal:i32, stdout:[]u8, stderr:[]u8, elapsed_ms:i64, stdout_owned:i32, stderr_owned:i32 }

fn zagd_benchmark_reason_ready()i32{return 0;}
fn zagd_benchmark_reason_not_explicit()i32{return 1;}
fn zagd_benchmark_reason_not_deep()i32{return 2;}
fn zagd_benchmark_reason_budget()i32{return 3;}
fn zagd_benchmark_reason_stale()i32{return 4;}
fn zagd_benchmark_reason_cancelled()i32{return 5;}
fn zagd_benchmark_reason_forbidden_resource()i32{return 6;}
fn zagd_benchmark_reason_executor_unavailable()i32{return 7;}

fn zagd_execution_exited()i32{return 0;}
fn zagd_execution_timed_out()i32{return 1;}
fn zagd_execution_output_limit()i32{return 2;}
fn zagd_execution_cancelled()i32{return 3;}
fn zagd_execution_runtime_error()i32{return 4;}

fn zagd_execution_result_bad()ZagdExecutionResult{return ZagdExecutionResult{.state=zagd_execution_runtime_error(),.exit_code=0-1,.term_signal=0,.stdout="",.stderr="",.elapsed_ms=0,.stdout_owned=0,.stderr_owned=0};}
// Only executor results own their captured streams. This helper is safe for
// synthetic test witnesses and error sentinels because ownership is explicit.
fn zagd_execution_result_free(result:*ZagdExecutionResult)void{if(result.*.stdout_owned==1){_zag_free(_zag_slice_ptr(result.*.stdout));}if(result.*.stderr_owned==1){_zag_free(_zag_slice_ptr(result.*.stderr));}result.*.stdout="";result.*.stderr="";result.*.stdout_owned=0;result.*.stderr_owned=0;}

fn zagd_benchmark_decide(r:ZagdBenchmarkRequest)ZagdBenchmarkDecision{
    let d:ZagdBenchmarkDecision=ZagdBenchmarkDecision{.allowed=0,.reason=zagd_benchmark_reason_executor_unavailable(),.max_finalists=3,.execution_supported=1,.requires_output_witness=1,.provenance=zagd_provenance_measured()};
    if(r.explicit!=1){d.reason=zagd_benchmark_reason_not_explicit();return d;}if(r.mode!=zagd_mode_deep()){d.reason=zagd_benchmark_reason_not_deep();return d;}if(r.finalists<1||r.finalists>3||r.timeout_ms<1||r.timeout_ms>5000||r.max_memory<1048576||r.max_memory>268435456){d.reason=zagd_benchmark_reason_budget();return d;}if(zagd_hash_equal(r.source,r.stable_source)==0||zagd_hash_equal(r.target,r.active_target)==0){d.reason=zagd_benchmark_reason_stale();return d;}if(r.cancelled!=0){d.reason=zagd_benchmark_reason_cancelled();return d;}if(r.network!=0||r.gpu!=0||r.source_writes!=0){d.reason=zagd_benchmark_reason_forbidden_resource();return d;}
    d.allowed=1;d.reason=zagd_benchmark_reason_ready();return d;
}

// A timing may be persisted only after comparing the actual reference and
// finalist witnesses. A request flag can never substitute for this check.
fn zagd_execution_equivalent(reference:ZagdExecutionResult,finalist:ZagdExecutionResult)i32{if(reference.state!=zagd_execution_exited()||finalist.state!=zagd_execution_exited()){return 0;}if(reference.exit_code!=finalist.exit_code||reference.term_signal!=finalist.term_signal){return 0;}if(!@strEq(reference.stdout,finalist.stdout)||!@strEq(reference.stderr,finalist.stderr)){return 0;}return 1;}
fn zagd_measurement_may_persist(decision:ZagdBenchmarkDecision,reference:ZagdExecutionResult,finalist:ZagdExecutionResult)i32{if(decision.allowed!=1||decision.requires_output_witness!=1){return 0;}return zagd_execution_equivalent(reference,finalist);}

// Pure benchmark-policy authority. The current daemon measurement record does
// not carry these samples and does not call this selector: it remains advisory.
// A future production integration must populate every field from bounded,
// alternating reference/finalist runs before this result can authorize an
// artifact. Keeping the checked policy here makes that missing evidence exact.
struct ZagdBenchmarkWorkloadEvidence {
    workload:i32,
    reference_warmups:ArrayList[i64],
    finalist_warmups:ArrayList[i64],
    noise_reference:ArrayList[i64],
    noise_repeat:ArrayList[i64],
    reference_runs:ArrayList[i64],
    finalist_runs:ArrayList[i64],
}
struct ZagdBenchmarkCandidateEvidence {
    kind:i32,
    valid:i32,
    equivalent:i32,
    peak_memory_bytes:i64,
    binary_size_bytes:i64,
    workloads:ArrayList[ZagdBenchmarkWorkloadEvidence],
}
struct ZagdBenchmarkCandidateCheck {
    eligible:i32,
    no_regression:i32,
    improved_workloads:i32,
    runtime_score_ns:i64,
    binary_size_bytes:i64,
}
struct ZagdBenchmarkPolicySelection {
    status:i32,
    winner_kind:i32,
    evaluated:i32,
    eligible:i32,
    confidence_percent:i32,
    no_regression:i32,
    runtime_score_ns:i64,
    binary_size_bytes:i64,
    advisory:i32,
}

fn zagd_benchmark_policy_no_win()i32{return 0;}
fn zagd_benchmark_policy_selected()i32{return 1;}
fn zagd_benchmark_policy_confidence()i32{return 99;}
fn zagd_benchmark_policy_min_warmups()i32{return 3;}
fn zagd_benchmark_policy_min_runs()i32{return 30;}
fn zagd_benchmark_policy_max_runs()i32{return 60;}
fn zagd_benchmark_policy_max_sample_ns()i64{return 5000000000;}

fn zagd_benchmark_samples_valid(values:ArrayList[i64],minimum:i32,maximum:i32)i32{
    if(values.len<minimum||values.len>maximum){return 0;}
    let i:i32=0;while(i<values.len){if(values.data[i]<1||values.data[i]>zagd_benchmark_policy_max_sample_ns()){return 0;}i=i+1;}return 1;
}
fn zagd_benchmark_noise_bound(w:ZagdBenchmarkWorkloadEvidence)i64{
    if(zagd_benchmark_samples_valid(w.noise_reference,zagd_benchmark_policy_min_runs(),zagd_benchmark_policy_max_runs())==0||
       zagd_benchmark_samples_valid(w.noise_repeat,zagd_benchmark_policy_min_runs(),zagd_benchmark_policy_max_runs())==0||
       w.noise_reference.len!=w.noise_repeat.len){return 0-1;}
    let bound:i64=0;let i:i32=0;while(i<w.noise_reference.len){let delta:i64=w.noise_reference.data[i]-w.noise_repeat.data[i];if(delta<0){delta=0-delta;}if(delta>bound){bound=delta;}i=i+1;}return bound;
}

// Exact one-sided paired sign test. For exchangeable paired signs under the
// no-improvement null, the upper binomial tail must be at most 1/100. Ties
// inside the calibrated noise floor are excluded from the decisive pair count.
// n is capped at 60 so every binomial coefficient and 2^n fit in signed i64.
fn zagd_benchmark_choose(n:i32,k0:i32)i64{
    if(n<0||k0<0||k0>n||n>60){return 0;}
    let k:i32=k0;if(k>n-k){k=n-k;}
    let result:i64=1;let i:i32=1;while(i<=k){result=(result*((n-k+i) as i64))/(i as i64);i=i+1;}return result;
}
fn zagd_benchmark_paired_sign_tail(wins:i32,losses:i32,denominator:i32)i32{
    let n:i32=wins+losses;if(wins<0||losses<0||n<1||n>60||denominator<100||denominator>4800){return 0;}
    let tail:i64=0;let k:i32=wins;while(k<=n){tail=tail+zagd_benchmark_choose(n,k);k=k+1;}
    let outcomes:i64=1;let i:i32=0;while(i<n){outcomes=outcomes*2;i=i+1;}return (tail<=outcomes/(denominator as i64)) as i32;
}
fn zagd_benchmark_paired_sign99(wins:i32,losses:i32)i32{return zagd_benchmark_paired_sign_tail(wins,losses,100);}
fn zagd_benchmark_required_workloads_valid(required:ArrayList[i32])i32{
    if(required.len<1||required.len>16){return 0;}
    let i:i32=0;while(i<required.len){if(required.data[i]<1){return 0;}let j:i32=i+1;while(j<required.len){if(required.data[i]==required.data[j]){return 0;}j=j+1;}i=i+1;}return 1;
}
fn zagd_benchmark_workload_count(workloads:ArrayList[ZagdBenchmarkWorkloadEvidence],workload:i32)i32{
    let count:i32=0;let i:i32=0;while(i<workloads.len){if(workloads.data[i].workload==workload){count=count+1;}i=i+1;}return count;
}
fn zagd_benchmark_candidate_check(c:ZagdBenchmarkCandidateEvidence,required:ArrayList[i32],memory_limit:i64,family_tests:i32)ZagdBenchmarkCandidateCheck{
    let out:ZagdBenchmarkCandidateCheck=ZagdBenchmarkCandidateCheck{.eligible=0,.no_regression=0,.improved_workloads=0,.runtime_score_ns=0-1,.binary_size_bytes=c.binary_size_bytes};
    if(c.kind<1||c.valid!=1||c.equivalent!=1||memory_limit<1||c.peak_memory_bytes<1||c.peak_memory_bytes>memory_limit||c.binary_size_bytes<1||family_tests<1||family_tests>48||zagd_benchmark_required_workloads_valid(required)==0||c.workloads.len!=required.len){return out;}
    let score:i64=0;let improved:i32=0;let ri:i32=0;
    while(ri<required.len){
        let id:i32=required.data[ri];if(zagd_benchmark_workload_count(c.workloads,id)!=1){return out;}
        let wi:i32=0;while(wi<c.workloads.len&&c.workloads.data[wi].workload!=id){wi=wi+1;}
        if(wi>=c.workloads.len){return out;}let w:ZagdBenchmarkWorkloadEvidence=c.workloads.data[wi];
        if(zagd_benchmark_samples_valid(w.reference_warmups,zagd_benchmark_policy_min_warmups(),16)==0||
           zagd_benchmark_samples_valid(w.finalist_warmups,zagd_benchmark_policy_min_warmups(),16)==0||
           w.reference_warmups.len!=w.finalist_warmups.len||
           zagd_benchmark_samples_valid(w.reference_runs,zagd_benchmark_policy_min_runs(),zagd_benchmark_policy_max_runs())==0||
           zagd_benchmark_samples_valid(w.finalist_runs,zagd_benchmark_policy_min_runs(),zagd_benchmark_policy_max_runs())==0||
           w.reference_runs.len!=w.finalist_runs.len){return out;}
        let noise:i64=zagd_benchmark_noise_bound(w);if(noise<0){return out;}
        let reference_sum:i64=0;let finalist_sum:i64=0;let wins:i32=0;let losses:i32=0;let i:i32=0;
        while(i<w.reference_runs.len){let reference:i64=w.reference_runs.data[i];let finalist:i64=w.finalist_runs.data[i];reference_sum=reference_sum+reference;finalist_sum=finalist_sum+finalist;let delta:i64=reference-finalist;if(delta>noise){wins=wins+1;}else if(0-delta>noise){losses=losses+1;}i=i+1;}
        let allowance:i64=noise*(w.reference_runs.len as i64);
        // A per-workload mean bound rejects material regression even when the
        // paired sign test alone is inconclusive in a noisy sample.
        if(finalist_sum>reference_sum+allowance||zagd_benchmark_paired_sign99(losses,wins)==1){return out;}
        // Bonferroni-correct across every candidate/workload comparison so the
        // bounded finalist search, not just one isolated test, retains 99%.
        let decisive:i32=wins+losses;if(decisive*2>=w.reference_runs.len&&zagd_benchmark_paired_sign_tail(wins,losses,100*family_tests)==1){improved=improved+1;}
        score=score+finalist_sum/(w.reference_runs.len as i64);ri=ri+1;
    }
    if(improved<1){return out;}out.eligible=1;out.no_regression=1;out.improved_workloads=improved;out.runtime_score_ns=score;return out;
}
fn zagd_benchmark_candidate_kinds_valid(candidates:ArrayList[ZagdBenchmarkCandidateEvidence])i32{
    if(candidates.len<1||candidates.len>3){return 0;}let i:i32=0;while(i<candidates.len){if(candidates.data[i].kind<1){return 0;}let j:i32=i+1;while(j<candidates.len){if(candidates.data[i].kind==candidates.data[j].kind){return 0;}j=j+1;}i=i+1;}return 1;
}
fn zagd_benchmark_select_99(candidates:ArrayList[ZagdBenchmarkCandidateEvidence],required:ArrayList[i32],memory_limit:i64)ZagdBenchmarkPolicySelection{
    let result:ZagdBenchmarkPolicySelection=ZagdBenchmarkPolicySelection{.status=zagd_benchmark_policy_no_win(),.winner_kind=0,.evaluated=0,.eligible=0,.confidence_percent=0,.no_regression=0,.runtime_score_ns=0-1,.binary_size_bytes=0-1,.advisory=1};
    if(memory_limit<1||zagd_benchmark_required_workloads_valid(required)==0||zagd_benchmark_candidate_kinds_valid(candidates)==0){return result;}
    let best_runtime:i64=9223372036854775807;let best_size:i64=9223372036854775807;let family_tests:i32=candidates.len*required.len;let i:i32=0;
    while(i<candidates.len){let c:ZagdBenchmarkCandidateEvidence=candidates.data[i];let checked:ZagdBenchmarkCandidateCheck=zagd_benchmark_candidate_check(c,required,memory_limit,family_tests);result.evaluated=result.evaluated+1;if(checked.eligible==1){result.eligible=result.eligible+1;if(checked.runtime_score_ns<best_runtime||(checked.runtime_score_ns==best_runtime&&(checked.binary_size_bytes<best_size||(checked.binary_size_bytes==best_size&&(result.winner_kind==0||c.kind<result.winner_kind))))){best_runtime=checked.runtime_score_ns;best_size=checked.binary_size_bytes;result.winner_kind=c.kind;}}i=i+1;}
    if(result.winner_kind!=0){result.status=zagd_benchmark_policy_selected();result.confidence_percent=zagd_benchmark_policy_confidence();result.no_regression=1;result.runtime_score_ns=best_runtime;result.binary_size_bytes=best_size;}return result;
}

fn zagd_execute_finalist(path:[]u8,timeout_ms:i64,max_memory:i64,max_output:i64,cancelled:*i32)ZagdExecutionResult{unsafe{
    let bad:ZagdExecutionResult=zagd_execution_result_bad();
    if(timeout_ms<1||timeout_ms>5000||max_memory<1048576||max_memory>268435456||max_output<1||max_output>1048576||cancelled==null as *i32){return bad;}
    let op:*i64=make[i64](1).data;let ep:*i64=make[i64](1).data;
    if(_zag_raw_syscall(293,op as i64,2048,0,0,0,0)<0){_zag_free(op as *i8);_zag_free(ep as *i8);return bad;}
    if(_zag_raw_syscall(293,ep as i64,2048,0,0,0,0)<0){let _c:i64=_zag_raw_syscall(3,op[0]&4294967295,0,0,0,0,0);let _d:i64=_zag_raw_syscall(3,op[0]>>32,0,0,0,0,0);_zag_free(op as *i8);_zag_free(ep as *i8);return bad;}
    let ord:i64=op[0]&4294967295;let owr:i64=op[0]>>32;let erd:i64=ep[0]&4294967295;let ewr:i64=ep[0]>>32;
    let p:*i8=make[i8](path.len+1).data;let pi:i32=0;while(pi<path.len){p[pi]=path[pi];pi=pi+1;}p[path.len]=0;
    let av:**i8=make[*i8](2).data;av[0]=p;av[1]=null as *i8;
    let pid:i64=_zag_raw_syscall(57,0,0,0,0,0,0);
    if(pid==0){
        // The child either execs or exits immediately. Its private COW copies
        // of path, argv, pipe words, and limit storage are process-exit scoped.
        let _g:i64=_zag_raw_syscall(109,0,0,0,0,0,0);let lim:*i64=make[i64](2).data;lim[0]=max_memory;lim[1]=max_memory;let _as:i64=_zag_raw_syscall(160,9,lim as i64,0,0,0,0);lim[0]=((timeout_ms+999)/1000)+1;lim[1]=lim[0];let _cpu:i64=_zag_raw_syscall(160,0,lim as i64,0,0,0,0);let _o:i64=_zag_raw_syscall(33,owr,1,0,0,0,0);let _e:i64=_zag_raw_syscall(33,ewr,2,0,0,0,0);let _c0:i64=_zag_raw_syscall(3,ord,0,0,0,0,0);let _c1:i64=_zag_raw_syscall(3,owr,0,0,0,0,0);let _c2:i64=_zag_raw_syscall(3,erd,0,0,0,0,0);let _c3:i64=_zag_raw_syscall(3,ewr,0,0,0,0,0);let _x:i64=_zag_raw_syscall(59,p as i64,av as i64,0,0,0,0);_zag_exit(127);
    }
    if(pid<0){let _a:i64=_zag_raw_syscall(3,ord,0,0,0,0,0);let _b:i64=_zag_raw_syscall(3,owr,0,0,0,0,0);let _c:i64=_zag_raw_syscall(3,erd,0,0,0,0,0);let _d:i64=_zag_raw_syscall(3,ewr,0,0,0,0,0);_zag_free(av as *i8);_zag_free(p);_zag_free(op as *i8);_zag_free(ep as *i8);return bad;}
    let _pg:i64=_zag_raw_syscall(109,pid,pid,0,0,0,0);let _co:i64=_zag_raw_syscall(3,owr,0,0,0,0,0);let _ce:i64=_zag_raw_syscall(3,ewr,0,0,0,0,0);
    _zag_free(av as *i8);_zag_free(p);_zag_free(op as *i8);_zag_free(ep as *i8);
    let ob:ArrayList[i8]=make[i8]((max_output+1) as i32);let eb:ArrayList[i8]=make[i8]((max_output+1) as i32);let on:i64=0;let en:i64=0;let oe:i32=0;let ee:i32=0;let status:*i64=make[i64](1).data;let ts:*i64=make[i64](2).data;ts[0]=0;ts[1]=1000000;let start:i64=_zag_clock_monotonic_ms();let state:i32=zagd_execution_exited();let reaped:i32=0;let done:i32=0;
    while(done==0){let nr:i64=_zag_raw_syscall(0,ord,(ob.data as i64)+on,(max_output+1)-on,0,0,0);if(nr>0){on=on+nr;}else if(nr==0){oe=1;}let ne:i64=_zag_raw_syscall(0,erd,(eb.data as i64)+en,(max_output+1)-en,0,0,0);if(ne>0){en=en+ne;}else if(ne==0){ee=1;}if(on>max_output||en>max_output){state=zagd_execution_output_limit();if(on>max_output){on=max_output;}if(en>max_output){en=max_output;}done=1;}if(done==0&&cancelled[0]!=0){state=zagd_execution_cancelled();done=1;}if(done==0&&reaped==0){let w:i64=_zag_raw_syscall(61,pid,status as i64,1,0,0,0);if(w==pid){reaped=1;}else if(w<0&&w!=0-4){state=zagd_execution_runtime_error();done=1;}}if(done==0&&reaped==1&&oe==1&&ee==1){done=1;}let now:i64=_zag_clock_monotonic_ms();if(done==0&&(now<0||now-start>=timeout_ms)){state=zagd_execution_timed_out();done=1;}if(done==0){let _n:i64=_zag_raw_syscall(35,ts as i64,0,0,0,0,0);}}
    if(state!=zagd_execution_exited()){let _k:i64=_zag_raw_syscall(62,0-pid,9,0,0,0,0);}if(reaped==0){let _r:i64=_zag_raw_syscall(61,pid,status as i64,0,0,0,0);}let _cr:i64=_zag_raw_syscall(3,ord,0,0,0,0,0);let _er:i64=_zag_raw_syscall(3,erd,0,0,0,0,0);let raw:i64=status[0];let code:i32=((raw>>8)&255) as i32;let sig:i32=(raw&127) as i32;let elapsed:i64=_zag_clock_monotonic_ms()-start;_zag_free(status as *i8);_zag_free(ts as *i8);return ZagdExecutionResult{.state=state,.exit_code=code,.term_signal=sig,.stdout=ob.data[0..on as i32],.stderr=eb.data[0..en as i32],.elapsed_ms=elapsed,.stdout_owned=1,.stderr_owned=1};
}}
