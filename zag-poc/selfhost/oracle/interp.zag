// selfhost/oracle/interp.zag — Zag tree-walking interpreter
//
// A second execution path for a subset of Zag. The differential oracle contract
// is: given a Zag source string, this interpreter's stdout must match the stdout
// of the same source compiled via the C backend (zagc) and run. This module is
// the first feature: enough to run fib(10) and produce identical output.
//
// Supported surface (as of 2026-06-30):
//   - int literals (i32)
//   - identifiers (locals + function refs)
//   - binary: + - * / < > <= >= == !=
//   - unary: -
//   - call: to declared fns, taking i32 args
//   - if / if-else (with i32 cond)
//   - return (with optional i32 expr)
//   - let (with i32 init expr)
//   - assign (locals only)
//   - builtin: print_i32 (matches zagc's runtime symbol)
//
// Out of scope (will be added incrementally):
//   - struct, enum, union, slice, pointer types
//   - while, switch, break, continue
//   - generic instantiation
//   - closures / captures
//   - the full heterogeneous numeric system

@import("../parse.zag")
@import("../ast.zag")
@import("../../std/rt.zag")

// ── value type ─────────────────────────────────────────────────────────────
// A tagged i64 value. i32/f32/[]u8 pointers all fit in 8 bytes. Tag encodes
// the dynamic type so binary ops and equality can be type-checked at runtime.
fn VT_I32() i32  { return 1; }
fn VT_I64() i32  { return 2; }
fn VT_F32() i32  { return 3; }
fn VT_STR() i32  { return 4; }
fn VT_BOOL() i32 { return 5; }

struct Value { tag: i32, bits: i64 }

fn v_i32(x: i32) Value { return Value{ .tag = VT_I32(), .bits = x as i64 }; }
fn v_i64(x: i64) Value { return Value{ .tag = VT_I64(), .bits = x }; }
fn v_f32(x: f32) Value { return Value{ .tag = VT_F32(), .bits = (x as f64) as i64 }; }
// String values are heap-allocated buffers laid out as:
//   i32 len  |  u8[len] bytes (no NUL terminator, no quotes)
// The buffer's pointer is stored in `bits`. `str_len` and `str_data` recover
// the length and bytes pointer respectively. print_str uses these to emit
// the string to stdout exactly as the C backend's print_str does (fwrite +
// '\n').
//
// Allocation uses _zag_malloc; for differential-test purposes we never
// free the buffers (the test programs exit immediately after printing).
fn alloc_str(text: []u8, from: i32, to: i32) Value {
    let n: i32 = to - from;
    if (n < 0) { n = 0; }
    let sz: i32 = 4 + n;
    let raw: *i8 = _zag_malloc(sz);
    let p: *i32 = raw as *i32;
    p[0] = n;
    let bp: *u8 = (raw as *u8) + 4;
    let i: i32 = 0;
    while (i < n) {
        bp[i] = text[from + i];
        i = i + 1;
    }
    return Value{ .tag = VT_STR(), .bits = raw as i64 };
}

fn str_len(v: Value) i32 {
    if (v.tag != VT_STR()) { return 0; }
    let raw: *i8 = v.bits as *i8;
    let p: *i32 = raw as *i32;
    return p[0];
}

fn str_data(v: Value) *u8 {
    let raw: *i8 = v.bits as *i8;
    return (raw as *u8) + 4;
}

// Emit a string buffer (ptr, len) to stdout followed by a newline.
// The C backend's print_str does fwrite + '\n' in C. The interpreter doesn't
// have a direct fwrite binding (adding a new extern requires hand-tuning in
// selfhost/native/ncodegen.zag's RT_* dispatch table, which is a much bigger
// change than the oracle's incremental growth justifies). String output is
// therefore deferred to a later feature; for now we emit a marker so any
// program that hits this path fails loudly rather than silently producing
// wrong output.
fn emit_str_ln(data: *u8, n: i32) void {
    let _: *u8 = data;
    let _: i32 = n;
    _zag_println("[interp: print_str not yet implemented]");
}
fn v_bool(b: i32) Value { return Value{ .tag = VT_BOOL(), .bits = b as i64 }; }

// Boolean coercion: 0 → 0, anything else → 1. Statement form because znc's
// dialect does not allow `if (c) 1 else 0` as an expression.
fn bool_coerce(x: i32) i32 {
    if (x == 0) { return 0; }
    return 1;
}

// Ternary helper: statement-form if/else returning i32.
fn if_then_else_i32(cond: i32, t: i32, e: i32) i32 {
    if (cond == 0) { return e; }
    return t;
}

// ── function table ─────────────────────────────────────────────────────────
// fn_name → FnDecl pointer. Looked up at call time.
struct FnEntry { name: []u8, decl: *Node }

struct FnTable { entries: ArrayList[FnEntry] }

fn fntab_new() FnTable {
    return FnTable{ .entries = make[FnEntry](4) };
}

fn fntab_register(t: *FnTable, name: []u8, decl: *Node) void {
    let e: FnEntry = FnEntry{ .name = name, .decl = decl };
    push[FnEntry](&t.*.entries, e);
}

fn fntab_lookup(t: *FnTable, name: []u8) *Node {
    let i: i32 = 0;
    while (i < len[FnEntry](t.*.entries)) {
        let e: FnEntry = get[FnEntry](t.*.entries, i);
        if (@strEq(e.name, name) == 1) { return e.decl; }
        i = i + 1;
    }
    return null;
}

// ── call stack ─────────────────────────────────────────────────────────────
// A single i32 local frame. (Recursion via the Zag call stack; we don't need
// a heap-allocated frame for fib(10).)
struct Local { name: []u8, val: Value }

struct Frame { locals: ArrayList[Local] }

fn frame_new() Frame { return Frame{ .locals = make[Local](4) }; }

fn frame_set(f: *Frame, name: []u8, val: Value) void {
    let i: i32 = 0;
    while (i < len[Local](f.*.locals)) {
        let l: Local = get[Local](f.*.locals, i);
        if (@strEq(l.name, name) == 1) {
            set[Local](&f.*.locals, i, Local{ .name = name, .val = val });
            return;
        }
        i = i + 1;
    }
    push[Local](&f.*.locals, Local{ .name = name, .val = val });
}

fn frame_get(f: *Frame, name: []u8) Value {
    let i: i32 = 0;
    while (i < len[Local](f.*.locals)) {
        let l: Local = get[Local](f.*.locals, i);
        if (@strEq(l.name, name) == 1) { return l.val; }
        i = i + 1;
    }
    // Not in locals — fall back to global identifier resolution.
    return Value{ .tag = 0, .bits = 0 };
}

fn frame_has(f: *Frame, name: []u8) i32 {
    let i: i32 = 0;
    while (i < len[Local](f.*.locals)) {
        let l: Local = get[Local](f.*.locals, i);
        if (@strEq(l.name, name) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

// ── control flow signals ───────────────────────────────────────────────────
// Interpreting return / break as a tagged sentinel value.
fn CTRL_NONE() i32    { return 0; }
fn CTRL_RETURN() i32  { return 1; }
struct Control { kind: i32, val: Value }

// ── expression evaluation ──────────────────────────────────────────────────
fn eval_expr(n: *Node, frame: *Frame, fntab: *FnTable) Control {
    switch (n.*) {
        .ilit => |x| {
            // Parse as i64 to preserve full precision; let coerce_to_type
            // truncate at the use site (let/assign/return) if needed.
            return Control{ .kind = CTRL_NONE(), .val = v_i64(_zag_str_to_i64(x.text)) };
        }
        .slit => |x| {
            // Strip the surrounding quotes. The C backend's strip_quotes is
            // more elaborate (handles escape sequences); for now we only
            // support literal ASCII without escapes.
            let n: i32 = x.text.len;
            if (n < 2) { return Control{ .kind = CTRL_NONE(), .val = alloc_str(x.text, 0, 0) }; }
            return Control{ .kind = CTRL_NONE(), .val = alloc_str(x.text, 1, n - 1) };
        }
        .id => |x| {
            if (frame_has(frame, x.name) == 1) {
                return Control{ .kind = CTRL_NONE(), .val = frame_get(frame, x.name) };
            }
            return Control{ .kind = CTRL_NONE(), .val = Value{ .tag = 0, .bits = 0 } };
        }
        .bin => |b| {
            let lc: Control = eval_expr(b.l, frame, fntab);
            let rc: Control = eval_expr(b.r, frame, fntab);
            // Promote operands to i64 for arithmetic so we don't lose
            // precision on values that fit in i32 but not in our interpretation
            // of the literal parser's i32 truncation. Comparisons still
            // produce i32 (the C backend does the same — `a < b` is i32 in Zag).
            let lv: i64 = lc.val.bits;
            let rv: i64 = rc.val.bits;
            if (@strEq(b.op, "+") == 1) { return Control{ .kind = CTRL_NONE(), .val = v_i64(lv + rv) }; }
            if (@strEq(b.op, "-") == 1) { return Control{ .kind = CTRL_NONE(), .val = v_i64(lv - rv) }; }
            if (@strEq(b.op, "*") == 1) { return Control{ .kind = CTRL_NONE(), .val = v_i64(lv * rv) }; }
            if (@strEq(b.op, "/") == 1) { return Control{ .kind = CTRL_NONE(), .val = v_i64(lv / rv) }; }
            if (@strEq(b.op, "<")  == 1) { return Control{ .kind = CTRL_NONE(), .val = v_bool(bool_coerce(if_then_else_i32(lv <  rv, 1, 0))) }; }
            if (@strEq(b.op, ">")  == 1) { return Control{ .kind = CTRL_NONE(), .val = v_bool(bool_coerce(if_then_else_i32(lv >  rv, 1, 0))) }; }
            if (@strEq(b.op, "<=") == 1) { return Control{ .kind = CTRL_NONE(), .val = v_bool(bool_coerce(if_then_else_i32(lv <= rv, 1, 0))) }; }
            if (@strEq(b.op, ">=") == 1) { return Control{ .kind = CTRL_NONE(), .val = v_bool(bool_coerce(if_then_else_i32(lv >= rv, 1, 0))) }; }
            if (@strEq(b.op, "==") == 1) { return Control{ .kind = CTRL_NONE(), .val = v_bool(bool_coerce(if_then_else_i32(lv == rv, 1, 0))) }; }
            if (@strEq(b.op, "!=") == 1) { return Control{ .kind = CTRL_NONE(), .val = v_bool(bool_coerce(if_then_else_i32(lv != rv, 1, 0))) }; }
            return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
        }
        .un => |u| {
            let ic: Control = eval_expr(u.e, frame, fntab);
            let iv: i64 = ic.val.bits;
            if (@strEq(u.op, "-") == 1) { return Control{ .kind = CTRL_NONE(), .val = v_i64(0 - iv) }; }
            return Control{ .kind = CTRL_NONE(), .val = v_i64(iv) };
        }
        .call => |c| {
            let callee_name: []u8 = "";
            switch (c.callee.*) {
                .id => |idn| { callee_name = idn.name; }
                else => { }
            }
            // Builtin: @len(s) — for []u8 slices produced by alloc_str,
            // returns the length stored at offset 0 of the heap header.
            // For non-string values, returns 0. The C backend emits
            // `(s).len` for slices, so this is the runtime equivalent.
            if (@strEq(callee_name, "@len") == 1) {
                let ac: Control = eval_expr(get[*Node](c.args, 0), frame, fntab);
                let n: i32 = str_len(ac.val);
                return Control{ .kind = CTRL_NONE(), .val = v_i32(n) };
            }
            if (@strEq(callee_name, "print_i32") == 1) {
                let ac: Control = eval_expr(get[*Node](c.args, 0), frame, fntab);
                let av: i32 = ac.val.bits as i32;
                let s: []u8 = _zag_i64_to_str(av as i64);
                _zag_println(s);
                return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
            }
            if (@strEq(callee_name, "print_i64") == 1) {
                let ac: Control = eval_expr(get[*Node](c.args, 0), frame, fntab);
                let av: i64 = ac.val.bits;
                let s: []u8 = _zag_i64_to_str(av);
                _zag_println(s);
                return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
            }
            if (@strEq(callee_name, "print_u64") == 1) {
                let ac: Control = eval_expr(get[*Node](c.args, 0), frame, fntab);
                let av: i64 = ac.val.bits;
                let s: []u8 = _zag_u64_to_str(av as u64);
                _zag_println(s);
                return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
            }
            if (@strEq(callee_name, "print_f32") == 1) {
                let ac: Control = eval_expr(get[*Node](c.args, 0), frame, fntab);
                let av: f32 = (ac.val.bits as f64) as f32;
                let s: []u8 = _zag_i64_to_str((av as f64 * 1000.0) as i64);
                // C backend uses %g which produces "1.5" style. For now output
                // a faithful "%g"-like representation via _zag_i64_to_str of
                // (val * 1000). Full f32 <-> text support is a later feature.
                _zag_print(s);
                _zag_println("");
                return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
            }
            if (@strEq(callee_name, "print_f64") == 1) {
                let ac: Control = eval_expr(get[*Node](c.args, 0), frame, fntab);
                let av: f64 = ac.val.bits as f64;
                let s: []u8 = _zag_i64_to_str((av * 1000.0) as i64);
                _zag_print(s);
                _zag_println("");
                return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
            }
            if (@strEq(callee_name, "print_str") == 1) {
                let ac: Control = eval_expr(get[*Node](c.args, 0), frame, fntab);
                let n: i32 = str_len(ac.val);
                let data: *u8 = str_data(ac.val);
                emit_str_ln(data, n);
                return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
            }
            let fdecl: *Node = fntab_lookup(fntab, callee_name);
            if (fdecl == null) {
                _zag_print("interp: unknown function ");
                _zag_println(callee_name);
                return Control{ .kind = CTRL_RETURN(), .val = v_i32(0) };
            }
            switch (fdecl.*) {
                .fn_decl => |fd| {
                    let new_frame: Frame = frame_new();
                    let pi: i32 = 0;
                    while (pi < len[Param](fd.params)) {
                        let p: Param = get[Param](fd.params, pi);
                        if (pi < len[*Node](c.args)) {
                            let ac: Control = eval_expr(get[*Node](c.args, pi), frame, fntab);
                            frame_set(&new_frame, p.name, ac.val);
                        } else {
                            frame_set(&new_frame, p.name, v_i32(0));
                        }
                        pi = pi + 1;
                    }
                    let body_ctrl: Control = exec_block(fd.body, &new_frame, fntab);
                    if (body_ctrl.kind == CTRL_RETURN()) { return body_ctrl; }
                    return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
                }
                else => {
                    return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
                }
            }
        }
        else => {
            return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
        }
    }
}

// ── statement execution ────────────────────────────────────────────────────
fn exec_block(body: ArrayList[*Node], frame: *Frame, fntab: *FnTable) Control {
    let i: i32 = 0;
    while (i < len[*Node](body)) {
        let s: *Node = get[*Node](body, i);
        let c: Control = exec_stmt(s, frame, fntab);
        if (c.kind == CTRL_RETURN()) { return c; }
        i = i + 1;
    }
    return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
}

// Wrap a raw Value in a typed Value matching the declared type string. Used
// for `let x: T = expr;` and `x = expr;` where the declaration dictates the
// storage type. i32/i64/u64/f32/f64 are supported; everything else falls
// through unchanged.
fn coerce_to_type(v: Value, dty: []u8) Value {
    if (@strEq(dty, "i32") == 1)  { return v_i32(v.bits as i32); }
    if (@strEq(dty, "i64") == 1)  { return v_i64(v.bits); }
    if (@strEq(dty, "u32") == 1)  { return v_i32(v.bits as i32); }
    if (@strEq(dty, "u64") == 1)  { return v_i64(v.bits); }
    if (@strEq(dty, "f32") == 1)  { return v_f32((v.bits as f64) as f32); }
    if (@strEq(dty, "f64") == 1)  { return v_i64(v.bits); }
    return v;
}

fn exec_stmt(n: *Node, frame: *Frame, fntab: *FnTable) Control {
    switch (n.*) {
        .let_ => |l| {
            if (l.has_init == 1) {
                let c: Control = eval_expr(l.expr, frame, fntab);
                if (l.has_dty == 1) {
                    frame_set(frame, l.name, coerce_to_type(c.val, l.dty));
                } else {
                    frame_set(frame, l.name, c.val);
                }
            } else {
                if (l.has_dty == 1) {
                    frame_set(frame, l.name, coerce_to_type(v_i32(0), l.dty));
                } else {
                    frame_set(frame, l.name, v_i32(0));
                }
            }
            return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
        }
        .assign => |a| {
            let c: Control = eval_expr(a.expr, frame, fntab);
            switch (a.target.*) {
                .id => |idn| { frame_set(frame, idn.name, c.val); }
                else => { }
            }
            return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
        }
        .if_ => |x| {
            let cc: Control = eval_expr(x.cond, frame, fntab);
            let cond_truthy: i32 = bool_coerce(cc.val.bits as i32);
            if (cond_truthy == 1) {
                return exec_block(x.then_body, frame, fntab);
            }
            if (x.has_els == 1) {
                return exec_block(x.els_body, frame, fntab);
            }
            return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
        }
        .while_ => |w| {
            // while (cond) { body } — re-evaluate cond after each iteration.
            // return inside body must propagate, so we forward the Control.
            // has_cap (while-let) is out of scope for the current feature set.
            let looping: i32 = 1;
            while (looping == 1) {
                let cc: Control = eval_expr(w.cond, frame, fntab);
                if (bool_coerce(cc.val.bits as i32) == 0) { looping = 0; }
                if (looping == 1) {
                    let bc: Control = exec_block(w.body, frame, fntab);
                    if (bc.kind == CTRL_RETURN()) { return bc; }
                }
            }
            return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
        }
        .ret => |r| {
            if (r.has_expr == 1) {
                let c: Control = eval_expr(r.expr, frame, fntab);
                return Control{ .kind = CTRL_RETURN(), .val = c.val };
            }
            return Control{ .kind = CTRL_RETURN(), .val = v_i32(0) };
        }
        .estmt => |e| {
            return eval_expr(e.expr, frame, fntab);
        }
        else => {
            return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
        }
    }
}

// ── entry point ────────────────────────────────────────────────────────────
// Build the FnTable from parsed decls, then invoke `main`.
fn run_program(decls: ArrayList[*Node]) i32 {
    let fntab: FnTable = fntab_new();
    let main_decl: *Node = null;
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        let d: *Node = get[*Node](decls, i);
        switch (d.*) {
            .fn_decl => |fd| {
                fntab_register(&fntab, fd.name, d);
                if (@strEq(fd.name, "main") == 1) { main_decl = d; }
            }
            else => { }
        }
        i = i + 1;
    }
    if (main_decl == null) {
        _zag_println("interp: no fn main()");
        return 1;
    }
    let main_frame: Frame = frame_new();
    switch (main_decl.*) {
        .fn_decl => |fd| {
            let _: Control = exec_block(fd.body, &main_frame, &fntab);
        }
        else => { }
    }
    return 0;
}
