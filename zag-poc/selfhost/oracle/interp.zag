// selfhost/oracle/interp.zag — Zag tree-walking interpreter
//
// A second execution path for a subset of Zag. The differential oracle contract
// is: given a Zag source string, this interpreter's stdout must match the stdout
// of the same source compiled via the C backend (zagc) and run. This module is
// the first feature: enough to run fib(10) and produce identical output.
//
// Supported surface (as of 2026-06-30):
//   - int literals (i32)
//   - identifiers (locals + function refs)
//   - binary: + - * / < > <= >= == !=
//   - unary: -
//   - call: to declared fns, taking i32 args
//   - if / if-else (with i32 cond)
//   - return (with optional i32 expr)
//   - let (with i32 init expr)
//   - assign (locals only)
//   - builtin: print_i32 (matches zagc's runtime symbol)
//
// Out of scope (will be added incrementally):
//   - struct, enum, union, slice, pointer types
//   - while, switch, break, continue
//   - generic instantiation
//   - closures / captures
//   - the full heterogeneous numeric system

@import("../parse.zag")
@import("../ast.zag")
@import("../../std/rt.zag")

// ── value type ─────────────────────────────────────────────────────────────
// A tagged i64 value. i32/f32/[]u8 pointers all fit in 8 bytes. Tag encodes
// the dynamic type so binary ops and equality can be type-checked at runtime.
fn VT_I32() i32  { return 1; }
fn VT_I64() i32  { return 2; }
fn VT_F32() i32  { return 3; }
fn VT_STR() i32  { return 4; }
fn VT_BOOL() i32 { return 5; }

struct Value { tag: i32, bits: i64 }

fn v_i32(x: i32) Value { return Value{ .tag = VT_I32(), .bits = x as i64 }; }
fn v_i64(x: i64) Value { return Value{ .tag = VT_I64(), .bits = x }; }
// Parse a decimal float literal scaled by 1000. "1.5" → 1500, "-2.5" →
// -2500, "3.14" → 3140, "10" → 10000. We scan the text for the optional
// decimal point, accumulate integer and fractional parts, and combine.
// Limited to 3 decimal places (truncates the rest). Returns the scaled
// value as an i64.
fn parse_float_scaled(text: []u8) i64 {
    let neg: i32 = 0;
    let start: i32 = 0;
    if (text.len > 0) {
        if ((text[0] as i32) == ('-' as i32)) { neg = 1; start = 1; }
    }
    let int_part: i64 = 0;
    let dot_pos: i32 = -1;
    let ki: i32 = start;
    while (ki < text.len) {
        let ch: i32 = text[ki] as i32;
        if (ch == ('.' as i32)) { dot_pos = ki; }
        ki = ki + 1;
    }
    let int_end: i32 = text.len;
    if (dot_pos >= 0) { int_end = dot_pos; }
    // Integer part: text[start..int_end].
    ki = start;
    while (ki < int_end) {
        let ch: i32 = text[ki] as i32;
        if (ch >= ('0' as i32) && ch <= ('9' as i32)) {
            int_part = int_part * 10 + (ch - ('0' as i32)) as i64;
        }
        ki = ki + 1;
    }
    // Fractional part: text[dot_pos+1..text.len], up to 3 digits.
    let frac_part: i64 = 0;
    if (dot_pos >= 0) {
        let frac_start: i32 = dot_pos + 1;
        let nfrac: i32 = text.len - frac_start;
        if (nfrac > 3) { nfrac = 3; }
        let place: i64 = 100;
        ki = 0;
        while (ki < nfrac) {
            let ch: i32 = text[frac_start + ki] as i32;
            if (ch >= ('0' as i32) && ch <= ('9' as i32)) {
                frac_part = frac_part + ((ch - ('0' as i32)) as i64) * place;
            }
            place = place / 10;
            ki = ki + 1;
        }
    }
    let result: i64 = int_part * 1000 + frac_part;
    if (neg == 1) { result = 0 - result; }
    return result;
}
fn f32_bits(x: f32) i64 {
    let ibuf: *i64 = _zag_malloc(8) as *i64;
    let fbuf: *f32 = ibuf as *f32;
    fbuf[0] = x;
    let result: i64 = ibuf[0];
    return result;
}

fn f64_bits(x: f64) i64 {
    let ibuf: *i64 = _zag_malloc(8) as *i64;
    let fbuf: *f64 = ibuf as *f64;
    fbuf[0] = x;
    let result: i64 = ibuf[0];
    return result;
}

fn f32_from_bits(b: i64) f32 {
    let ibuf: *i64 = _zag_malloc(8) as *i64;
    ibuf[0] = b;
    let fbuf: *f32 = ibuf as *f32;
    let result: f32 = fbuf[0];
    return result;
}

fn f64_from_bits(b: i64) f64 {
    let ibuf: *i64 = _zag_malloc(8) as *i64;
    ibuf[0] = b;
    let fbuf: *f64 = ibuf as *f64;
    let result: f64 = fbuf[0];
    return result;
}

fn v_f32(x: f32) Value { return Value{ .tag = VT_F32(), .bits = f32_bits(x) }; }
// String values are heap-allocated buffers laid out as:
//   i32 len  |  u8[len] bytes (no NUL terminator, no quotes)
// The buffer's pointer is stored in `bits`. `str_len` and `str_data` recover
// the length and bytes pointer respectively. print_str uses these to emit
// the string to stdout exactly as the C backend's print_str does (fwrite +
// '\n').
//
// Allocation uses _zag_malloc; for differential-test purposes we never
// free the buffers (the test programs exit immediately after printing).
fn alloc_str(text: []u8, from: i32, to: i32) Value {
    let n: i32 = to - from;
    if (n < 0) { n = 0; }
    let sz: i32 = 4 + n;
    let raw: *i8 = _zag_malloc(sz);
    let p: *i32 = raw as *i32;
    p[0] = n;
    let bp: *u8 = (raw as *u8) + 4;
    let i: i32 = 0;
    while (i < n) {
        bp[i] = text[from + i];
        i = i + 1;
    }
    return Value{ .tag = VT_STR(), .bits = raw as i64 };
}

fn str_len(v: Value) i32 {
    if (v.tag != VT_STR()) { return 0; }
    let raw: *i8 = v.bits as *i8;
    let p: *i32 = raw as *i32;
    return p[0];
}

fn str_data(v: Value) *u8 {
    let raw: *i8 = v.bits as *i8;
    return (raw as *u8) + 4;
}

// Emit a string buffer (ptr, len) to stdout followed by a newline.
// The C backend's print_str does fwrite + '\n' in C. The interpreter doesn't
// have a direct fwrite binding (adding a new extern requires hand-tuning in
// selfhost/native/ncodegen.zag's RT_* dispatch table, which is a much bigger
// change than the oracle's incremental growth justifies).
//
// As a workaround, we build a `printf` command that emits the bytes via
// `%c` format with each byte as a decimal argument, then run it via
// _zag_exec_cmd. The shell command output goes to the parent's stdout
// (system() inherits the parent's fds), so the bytes appear on stdout as
// if print_str had been called natively.
//
// For a string of length n, the command looks like:
//   printf '%c%c%c...' 104 101 108 108 111
// where each %c is a char format and each integer is the byte value.
// The trailing newline is appended separately via printf '\n'.
// Map a digit 0-9 to its ASCII char as a 1-byte []u8 slice literal.
// The Zag dialect doesn't let us construct a 1-byte []u8 from a runtime
// value, so we use a per-digit table of pre-built string literals. These
// 10 helpers turn a small int into the textual digit we need.
//
// (Originally 0-7 for octal escapes; widened to 0-9 when we started
// formatting decimal float fractions. The "oct_" prefix is kept for
// now to avoid a wider rename — semantics is identical, just broader.)
fn oct_digit_0() []u8 { return "0"; }
fn oct_digit_1() []u8 { return "1"; }
fn oct_digit_2() []u8 { return "2"; }
fn oct_digit_3() []u8 { return "3"; }
fn oct_digit_4() []u8 { return "4"; }
fn oct_digit_5() []u8 { return "5"; }
fn oct_digit_6() []u8 { return "6"; }
fn oct_digit_7() []u8 { return "7"; }
fn oct_digit_8() []u8 { return "8"; }
fn oct_digit_9() []u8 { return "9"; }

// Convert a digit in 0-9 to its ASCII char as a []u8 by calling the
// right helper. Statement form because znc doesn't allow array indexing
// on []u8 values the way we'd want here (we'd need a table of slices).
fn digit_to_slice(d: i32) []u8 {
    if (d == 0) { return oct_digit_0(); }
    if (d == 1) { return oct_digit_1(); }
    if (d == 2) { return oct_digit_2(); }
    if (d == 3) { return oct_digit_3(); }
    if (d == 4) { return oct_digit_4(); }
    if (d == 5) { return oct_digit_5(); }
    if (d == 6) { return oct_digit_6(); }
    if (d == 7) { return oct_digit_7(); }
    if (d == 8) { return oct_digit_8(); }
    return oct_digit_9();
}

// Format an f32 as a string that printf can read back. We scale by 1000
// to preserve up to 3 decimal places (matching the C backend's f32
// precision), then write the result as an integer division:
//   4.0    ->  "4"   (printf '%g' 4 -> 4)
//   1.5    ->  "1.5" (printf '%g' 1.5 -> 1.5)
//   0.6    ->  "0.6"
// The trick: build "int_part" and "frac_part" separately, concatenate
// with a "." if frac != 0. printf '%g' does the rest of the formatting.
fn float_to_str(x: f32) []u8 {
    let scaled: i64 = (x as f64 * 1000.0) as i64;
    let neg: i32 = 0;
    let abs_val: i64 = scaled;
    if (scaled < 0) { neg = 1; abs_val = 0 - scaled; }
    let int_part: i64 = abs_val / 1000;
    let frac_part: i64 = abs_val % 1000;
    let result: []u8 = "";
    if (neg == 1) { result = _zag_str_concat(result, "-"); }
    result = _zag_str_concat(result, _zag_i64_to_str(int_part));
    if (frac_part != 0) {
        result = _zag_str_concat(result, ".");
        // Pad frac_part to 3 digits: 5 -> "005", 50 -> "050", 500 -> "500"
        let d1: i32 = (frac_part / 100) as i32;
        let d2: i32 = ((frac_part / 10) % 10) as i32;
        let d3: i32 = (frac_part % 10) as i32;
        result = _zag_str_concat(result, digit_to_slice(d1));
        result = _zag_str_concat(result, digit_to_slice(d2));
        result = _zag_str_concat(result, digit_to_slice(d3));
    }
    return result;
}

fn float_to_str_d(x: f64) []u8 {
    let scaled: i64 = (x * 1000.0) as i64;
    let neg: i32 = 0;
    let abs_val: i64 = scaled;
    if (scaled < 0) { neg = 1; abs_val = 0 - scaled; }
    let int_part: i64 = abs_val / 1000;
    let frac_part: i64 = abs_val % 1000;
    let result: []u8 = "";
    if (neg == 1) { result = _zag_str_concat(result, "-"); }
    result = _zag_str_concat(result, _zag_i64_to_str(int_part));
    if (frac_part != 0) {
        result = _zag_str_concat(result, ".");
        let d1: i32 = (frac_part / 100) as i32;
        let d2: i32 = ((frac_part / 10) % 10) as i32;
        let d3: i32 = (frac_part % 10) as i32;
        result = _zag_str_concat(result, digit_to_slice(d1));
        result = _zag_str_concat(result, digit_to_slice(d2));
        result = _zag_str_concat(result, digit_to_slice(d3));
    }
    return result;
}

// The C backend's print_str does fwrite + '\n' in C. The interpreter doesn't
// have a direct fwrite binding (adding a new extern requires hand-tuning in
// selfhost/native/ncodegen.zag's RT_* dispatch table, which is a much bigger
// change than the oracle's incremental growth justifies).
//
// As a workaround, we build a `printf '%b'` command where the argument is
// a string of octal escapes (\NNN, one per byte). printf '%b' interprets
// these escapes as bytes. The shell command output goes to the parent's
// stdout (system() inherits the parent's fds), so the bytes appear on
// stdout as if print_str had been called natively.
fn emit_str_ln(data: *u8, n: i32) void {
    if (n == 0) {
        _zag_println("");
        return;
    }
    // Build the command:  printf '%b' '\NNN\NNN...' ; printf '\n'
    let octets: []u8 = "";
    let i: i32 = 0;
    while (i < n) {
        let b: i32 = data[i] as i32;
        let d0: i32 = (b / 64) + ('0' as i32);
        let d1: i32 = ((b / 8) % 8) + ('0' as i32);
        let d2: i32 = (b % 8) + ('0' as i32);
        // Each digit (d0, d1, d2) is in 0-7. Convert to the digit's ASCII
        // char (as a 1-byte []u8) via the per-digit helper table, then
        // concatenate. Prepend the backslash before each \NNN group.
        octets = _zag_str_concat(octets, "\\");
        octets = _zag_str_concat(octets, digit_to_slice(d0 - ('0' as i32)));
        octets = _zag_str_concat(octets, digit_to_slice(d1 - ('0' as i32)));
        octets = _zag_str_concat(octets, digit_to_slice(d2 - ('0' as i32)));
        i = i + 1;
    }
    let cmd: []u8 = "printf '%b' '";
    cmd = _zag_str_concat(cmd, octets);
    cmd = _zag_str_concat(cmd, "'; printf '\\n'");
    let _: i32 = _zag_exec_cmd(cmd);
}
fn v_bool(b: i32) Value { return Value{ .tag = VT_BOOL(), .bits = b as i64 }; }
fn v_bool(b: i32) Value { return Value{ .tag = VT_BOOL(), .bits = b as i64 }; }

// Boolean coercion: 0 → 0, anything else → 1. Statement form because znc's
// dialect does not allow `if (c) 1 else 0` as an expression.
fn bool_coerce(x: i32) i32 {
    if (x == 0) { return 0; }
    return 1;
}

// Ternary helper: statement-form if/else returning i32.
fn if_then_else_i32(cond: i32, t: i32, e: i32) i32 {
    if (cond == 0) { return e; }
    return t;
}

// ── function table ─────────────────────────────────────────────────────────
// fn_name → FnDecl pointer. Looked up at call time.
struct FnEntry { name: []u8, decl: *Node }

struct FnTable { entries: ArrayList[FnEntry] }

fn fntab_new() FnTable {
    return FnTable{ .entries = make[FnEntry](4) };
}

fn fntab_register(t: *FnTable, name: []u8, decl: *Node) void {
    let e: FnEntry = FnEntry{ .name = name, .decl = decl };
    push[FnEntry](&t.*.entries, e);
}

fn fntab_lookup(t: *FnTable, name: []u8) *Node {
    let i: i32 = 0;
    while (i < len[FnEntry](t.*.entries)) {
        let e: FnEntry = get[FnEntry](t.*.entries, i);
        if (@strEq(e.name, name) == 1) { return e.decl; }
        i = i + 1;
    }
    return null;
}

// ── call stack ─────────────────────────────────────────────────────────────
// A single i32 local frame. (Recursion via the Zag call stack; we don't need
// a heap-allocated frame for fib(10).)
struct Local { name: []u8, val: Value }

struct Frame { locals: ArrayList[Local] }

fn frame_new() Frame { return Frame{ .locals = make[Local](4) }; }

fn frame_set(f: *Frame, name: []u8, val: Value) void {
    let i: i32 = 0;
    while (i < len[Local](f.*.locals)) {
        let l: Local = get[Local](f.*.locals, i);
        if (@strEq(l.name, name) == 1) {
            set[Local](&f.*.locals, i, Local{ .name = name, .val = val });
            return;
        }
        i = i + 1;
    }
    push[Local](&f.*.locals, Local{ .name = name, .val = val });
}

fn frame_get(f: *Frame, name: []u8) Value {
    let i: i32 = 0;
    while (i < len[Local](f.*.locals)) {
        let l: Local = get[Local](f.*.locals, i);
        if (@strEq(l.name, name) == 1) { return l.val; }
        i = i + 1;
    }
    // Not in locals — fall back to global identifier resolution.
    return Value{ .tag = 0, .bits = 0 };
}

fn frame_has(f: *Frame, name: []u8) i32 {
    let i: i32 = 0;
    while (i < len[Local](f.*.locals)) {
        let l: Local = get[Local](f.*.locals, i);
        if (@strEq(l.name, name) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

// ── control flow signals ───────────────────────────────────────────────────
// Interpreting return / break as a tagged sentinel value.
fn CTRL_NONE() i32    { return 0; }
fn CTRL_RETURN() i32  { return 1; }
struct Control { kind: i32, val: Value }

// ── expression evaluation ──────────────────────────────────────────────────
fn eval_expr(n: *Node, frame: *Frame, fntab: *FnTable) Control {
    switch (n.*) {
        .ilit => |x| {
            // The Zag AST has only one numeric-literal kind. The C backend
            // emits the text verbatim and lets the C compiler figure out
            // whether it's an int or float. The interpreter has to do that
            // itself: scan for '.' or 'e'/'E' to decide. The C backend's
            // f32 literal `1.5` round-trips through C as 1.5f; we use f64
            // internally and narrow on demand via coerce_to_type.
            let has_dot: i32 = 0;
            let ki: i32 = 0;
            while (ki < x.text.len) {
                let ch: i32 = x.text[ki] as i32;
                if (ch == ('.' as i32)) { has_dot = 1; }
                if (ch == ('e' as i32) || ch == ('E' as i32)) { has_dot = 1; }
                ki = ki + 1;
            }
            if (has_dot == 1) {
                // Float literal: scale by 1000 to get a 3-decimal integer,
                // preserving f32 precision. f32 has ~7 decimal digits of
                // precision, so 3 fractional digits is well within range
                // for typical literal magnitudes.
                let scaled: i64 = parse_float_scaled(x.text);
                return Control{ .kind = CTRL_NONE(), .val = v_f32((scaled as f64 / 1000.0) as f32) };
            }
            return Control{ .kind = CTRL_NONE(), .val = v_i64(_zag_str_to_i64(x.text)) };
        }
        .slit => |x| {
            // Strip the surrounding quotes. The C backend's strip_quotes is
            // more elaborate (handles escape sequences); for now we only
            // support literal ASCII without escapes.
            let n: i32 = x.text.len;
            if (n < 2) { return Control{ .kind = CTRL_NONE(), .val = alloc_str(x.text, 0, 0) }; }
            return Control{ .kind = CTRL_NONE(), .val = alloc_str(x.text, 1, n - 1) };
        }
        .id => |x| {
            if (frame_has(frame, x.name) == 1) {
                return Control{ .kind = CTRL_NONE(), .val = frame_get(frame, x.name) };
            }
            return Control{ .kind = CTRL_NONE(), .val = Value{ .tag = 0, .bits = 0 } };
        }
        .fld => |f| {
            // Field access. For slice values (ZagSliceU8 = {ptr, len}), the
            // only field we model is `.len`. For struct values this would
            // dispatch on the field name; that's deferred until structs
            // are added to the interpreter.
            let bc: Control = eval_expr(f.base, frame, fntab);
            if (bc.val.tag == VT_STR()) {
                if (@strEq(f.fname, "len") == 1) {
                    return Control{ .kind = CTRL_NONE(), .val = v_i32(str_len(bc.val)) };
                }
            }
            return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
        }
        .idx => |ix| {
            // Slice/array indexing. The C backend's codegen type pass stamps
            // ptr_base: 0 for slice bases, 1 for raw pointer bases. The
            // interpreter does not run that pass, so the default value
            // from mk_index (1) is what we see for slice indexing too.
            // We try slice semantics first: if the base evaluates to a
            // heap-allocated string buffer (tag = VT_STR()), we read the
            // i-th byte. Raw pointer bases are not yet supported.
            let bc: Control = eval_expr(ix.base, frame, fntab);
            let ic: Control = eval_expr(ix.idx, frame, fntab);
            let i: i32 = ic.val.bits as i32;
            if (bc.val.tag == VT_STR()) {
                let data: *u8 = str_data(bc.val);
                let b: u8 = data[i];
                return Control{ .kind = CTRL_NONE(), .val = v_i32(b as i32) };
            }
            if (ix.ptr_base == 0) {
                // Slice base per the type-pass stamp, but base doesn't look
                // like a slice value. Fall back to a defensive 0.
                return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
            }
            // Raw pointer base not supported; return 0.
            return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
        }
        .bin => |b| {
            let lc: Control = eval_expr(b.l, frame, fntab);
            let rc: Control = eval_expr(b.r, frame, fntab);
            // Float arithmetic: if either operand is tagged as a float,
            // promote both to f64 and do the op on floats. The result is
            // returned as v_f32 (which stores the f64 bit pattern in `bits`).
            if (lc.val.tag == VT_F32() || rc.val.tag == VT_F32()) {
                let lf: f64 = f64_from_bits(lc.val.bits);
                let rf: f64 = f64_from_bits(rc.val.bits);
                if (@strEq(b.op, "+") == 1) { return Control{ .kind = CTRL_NONE(), .val = v_f32((lf + rf) as f32) }; }
                if (@strEq(b.op, "-") == 1) { return Control{ .kind = CTRL_NONE(), .val = v_f32((lf - rf) as f32) }; }
                if (@strEq(b.op, "*") == 1) { return Control{ .kind = CTRL_NONE(), .val = v_f32((lf * rf) as f32) }; }
                if (@strEq(b.op, "/") == 1) { return Control{ .kind = CTRL_NONE(), .val = v_f32((lf / rf) as f32) }; }
                if (@strEq(b.op, "<")  == 1) { return Control{ .kind = CTRL_NONE(), .val = v_bool(bool_coerce(if_then_else_i32(lf <  rf, 1, 0))) }; }
                if (@strEq(b.op, ">")  == 1) { return Control{ .kind = CTRL_NONE(), .val = v_bool(bool_coerce(if_then_else_i32(lf >  rf, 1, 0))) }; }
                if (@strEq(b.op, "<=") == 1) { return Control{ .kind = CTRL_NONE(), .val = v_bool(bool_coerce(if_then_else_i32(lf <= rf, 1, 0))) }; }
                if (@strEq(b.op, ">=") == 1) { return Control{ .kind = CTRL_NONE(), .val = v_bool(bool_coerce(if_then_else_i32(lf >= rf, 1, 0))) }; }
                if (@strEq(b.op, "==") == 1) { return Control{ .kind = CTRL_NONE(), .val = v_bool(bool_coerce(if_then_else_i32(lf == rf, 1, 0))) }; }
                if (@strEq(b.op, "!=") == 1) { return Control{ .kind = CTRL_NONE(), .val = v_bool(bool_coerce(if_then_else_i32(lf != rf, 1, 0))) }; }
                return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
            }
            // Integer path: promote operands to i64 for arithmetic so we
            // don't lose precision on values that fit in i32 but not in
            // our interpretation of the literal parser's i32 truncation.
            // Comparisons still produce i32 (the C backend does the same
            // — `a < b` is i32 in Zag).
            let lv: i64 = lc.val.bits;
            let rv: i64 = rc.val.bits;
            if (@strEq(b.op, "+") == 1) { return Control{ .kind = CTRL_NONE(), .val = v_i64(lv + rv) }; }
            if (@strEq(b.op, "-") == 1) { return Control{ .kind = CTRL_NONE(), .val = v_i64(lv - rv) }; }
            if (@strEq(b.op, "*") == 1) { return Control{ .kind = CTRL_NONE(), .val = v_i64(lv * rv) }; }
            if (@strEq(b.op, "/") == 1) { return Control{ .kind = CTRL_NONE(), .val = v_i64(lv / rv) }; }
            if (@strEq(b.op, "<")  == 1) { return Control{ .kind = CTRL_NONE(), .val = v_bool(bool_coerce(if_then_else_i32(lv <  rv, 1, 0))) }; }
            if (@strEq(b.op, ">")  == 1) { return Control{ .kind = CTRL_NONE(), .val = v_bool(bool_coerce(if_then_else_i32(lv >  rv, 1, 0))) }; }
            if (@strEq(b.op, "<=") == 1) { return Control{ .kind = CTRL_NONE(), .val = v_bool(bool_coerce(if_then_else_i32(lv <= rv, 1, 0))) }; }
            if (@strEq(b.op, ">=") == 1) { return Control{ .kind = CTRL_NONE(), .val = v_bool(bool_coerce(if_then_else_i32(lv >= rv, 1, 0))) }; }
            if (@strEq(b.op, "==") == 1) { return Control{ .kind = CTRL_NONE(), .val = v_bool(bool_coerce(if_then_else_i32(lv == rv, 1, 0))) }; }
            if (@strEq(b.op, "!=") == 1) { return Control{ .kind = CTRL_NONE(), .val = v_bool(bool_coerce(if_then_else_i32(lv != rv, 1, 0))) }; }
            return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
        }
        .cast_ => |c| {
            // Type casts in Zag are mostly no-ops at runtime — the bit
            // pattern is preserved and the declared type is metadata.
            // For the differential test we treat `expr as T` as identity
            // and let coerce_to_type at the use site handle the width.
            return eval_expr(c.expr, frame, fntab);
        }
        .un => |u| {
            let ic: Control = eval_expr(u.e, frame, fntab);
            if (ic.val.tag == VT_F32()) {
                let f: f64 = f64_from_bits(ic.val.bits);
                if (@strEq(u.op, "-") == 1) { return Control{ .kind = CTRL_NONE(), .val = v_f32((0.0 - f) as f32) }; }
                return Control{ .kind = CTRL_NONE(), .val = ic.val };
            }
            let iv: i64 = ic.val.bits;
            if (@strEq(u.op, "-") == 1) { return Control{ .kind = CTRL_NONE(), .val = v_i64(0 - iv) }; }
            return Control{ .kind = CTRL_NONE(), .val = v_i64(iv) };
        }
        .call => |c| {
            let callee_name: []u8 = "";
            switch (c.callee.*) {
                .id => |idn| { callee_name = idn.name; }
                else => { }
            }
            // Builtin: @len(s) — for []u8 slices produced by alloc_str,
            // returns the length stored at offset 0 of the heap header.
            // For non-string values, returns 0. The C backend emits
            // `(s).len` for slices, so this is the runtime equivalent.
            if (@strEq(callee_name, "@len") == 1) {
                let ac: Control = eval_expr(get[*Node](c.args, 0), frame, fntab);
                let n: i32 = str_len(ac.val);
                return Control{ .kind = CTRL_NONE(), .val = v_i32(n) };
            }
            // Builtin: @strEq(a, b) — byte-equal comparison of two []u8
            // slices. Returns 1 if equal, 0 if not. Matches the C
            // backend's _zag_str_eq semantics.
            if (@strEq(callee_name, "@strEq") == 1) {
                let ac: Control = eval_expr(get[*Node](c.args, 0), frame, fntab);
                let bc: Control = eval_expr(get[*Node](c.args, 1), frame, fntab);
                let na: i32 = str_len(ac.val);
                let nb: i32 = str_len(bc.val);
                let eq: i32 = 1;
                if (na != nb) { eq = 0; }
                if (eq == 1) {
                    let da: *u8 = str_data(ac.val);
                    let db: *u8 = str_data(bc.val);
                    let i: i32 = 0;
                    while (i < na) {
                        if (da[i] != db[i]) { eq = 0; }
                        i = i + 1;
                    }
                }
                return Control{ .kind = CTRL_NONE(), .val = v_i32(eq) };
            }
            // Builtin: @strLen(s) — returns the byte length. Same as
            // @len for []u8 slices; included for compatibility with code
            // that uses both names.
            if (@strEq(callee_name, "@strLen") == 1) {
                let ac: Control = eval_expr(get[*Node](c.args, 0), frame, fntab);
                return Control{ .kind = CTRL_NONE(), .val = v_i32(str_len(ac.val)) };
            }
            if (@strEq(callee_name, "print_i32") == 1) {
                let ac: Control = eval_expr(get[*Node](c.args, 0), frame, fntab);
                let av: i32 = ac.val.bits as i32;
                let s: []u8 = _zag_i64_to_str(av as i64);
                _zag_println(s);
                return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
            }
            if (@strEq(callee_name, "print_i64") == 1) {
                let ac: Control = eval_expr(get[*Node](c.args, 0), frame, fntab);
                let av: i64 = ac.val.bits;
                let s: []u8 = _zag_i64_to_str(av);
                _zag_println(s);
                return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
            }
            if (@strEq(callee_name, "print_u64") == 1) {
                let ac: Control = eval_expr(get[*Node](c.args, 0), frame, fntab);
                let av: i64 = ac.val.bits;
                let s: []u8 = _zag_u64_to_str(av as u64);
                _zag_println(s);
                return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
            }
            if (@strEq(callee_name, "print_f32") == 1) {
                let ac: Control = eval_expr(get[*Node](c.args, 0), frame, fntab);
                let av: f32 = f32_from_bits(ac.val.bits);
                // Use printf '%g' via the shell, same workaround as
                // print_str, so the format matches the C backend's
                // printf("%g\n", (double)x) exactly.
                let cmd: []u8 = "printf '%g' ";
                let av_str: []u8 = float_to_str(av);
                cmd = _zag_str_concat(cmd, av_str);
                cmd = _zag_str_concat(cmd, "; printf '\\n'");
                let _: i32 = _zag_exec_cmd(cmd);
                return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
            }
            if (@strEq(callee_name, "print_f64") == 1) {
                let ac: Control = eval_expr(get[*Node](c.args, 0), frame, fntab);
                let av: f64 = f64_from_bits(ac.val.bits);
                let cmd: []u8 = "printf '%g' ";
                let av_str: []u8 = float_to_str_d(av);
                cmd = _zag_str_concat(cmd, av_str);
                cmd = _zag_str_concat(cmd, "; printf '\\n'");
                let _: i32 = _zag_exec_cmd(cmd);
                return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
            }
            if (@strEq(callee_name, "print_str") == 1) {
                let ac: Control = eval_expr(get[*Node](c.args, 0), frame, fntab);
                let n: i32 = str_len(ac.val);
                let data: *u8 = str_data(ac.val);
                emit_str_ln(data, n);
                return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
            }
            let fdecl: *Node = fntab_lookup(fntab, callee_name);
            if (fdecl == null) {
                _zag_print("interp: unknown function ");
                _zag_println(callee_name);
                return Control{ .kind = CTRL_RETURN(), .val = v_i32(0) };
            }
            switch (fdecl.*) {
                .fn_decl => |fd| {
                    let new_frame: Frame = frame_new();
                    let pi: i32 = 0;
                    while (pi < len[Param](fd.params)) {
                        let p: Param = get[Param](fd.params, pi);
                        if (pi < len[*Node](c.args)) {
                            let ac: Control = eval_expr(get[*Node](c.args, pi), frame, fntab);
                            frame_set(&new_frame, p.name, ac.val);
                        } else {
                            frame_set(&new_frame, p.name, v_i32(0));
                        }
                        pi = pi + 1;
                    }
                    let body_ctrl: Control = exec_block(fd.body, &new_frame, fntab);
                    if (body_ctrl.kind == CTRL_RETURN()) { return body_ctrl; }
                    return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
                }
                else => {
                    return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
                }
            }
        }
        else => {
            return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
        }
    }
}

// ── statement execution ────────────────────────────────────────────────────
fn exec_block(body: ArrayList[*Node], frame: *Frame, fntab: *FnTable) Control {
    let i: i32 = 0;
    while (i < len[*Node](body)) {
        let s: *Node = get[*Node](body, i);
        let c: Control = exec_stmt(s, frame, fntab);
        if (c.kind == CTRL_RETURN()) { return c; }
        i = i + 1;
    }
    return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
}

// Wrap a raw Value in a typed Value matching the declared type string. Used
// for `let x: T = expr;` and `x = expr;` where the declaration dictates the
// storage type. i32/i64/u64/f32/f64 are supported; everything else falls
// through unchanged.
fn coerce_to_type(v: Value, dty: []u8) Value {
    if (@strEq(dty, "i32") == 1)  { return v_i32(v.bits as i32); }
    if (@strEq(dty, "i64") == 1)  { return v_i64(v.bits); }
    if (@strEq(dty, "u32") == 1)  { return v_i32(v.bits as i32); }
    if (@strEq(dty, "u64") == 1)  { return v_i64(v.bits); }
    if (@strEq(dty, "f32") == 1)  { return v_f32(f32_from_bits(v.bits)); }
    if (@strEq(dty, "f64") == 1)  { return v_f32(f64_from_bits(v.bits) as f32); }
    return v;
}

fn exec_stmt(n: *Node, frame: *Frame, fntab: *FnTable) Control {
    switch (n.*) {
        .let_ => |l| {
            if (l.has_init == 1) {
                let c: Control = eval_expr(l.expr, frame, fntab);
                if (l.has_dty == 1) {
                    frame_set(frame, l.name, coerce_to_type(c.val, l.dty));
                } else {
                    frame_set(frame, l.name, c.val);
                }
            } else {
                if (l.has_dty == 1) {
                    frame_set(frame, l.name, coerce_to_type(v_i32(0), l.dty));
                } else {
                    frame_set(frame, l.name, v_i32(0));
                }
            }
            return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
        }
        .assign => |a| {
            let c: Control = eval_expr(a.expr, frame, fntab);
            switch (a.target.*) {
                .id => |idn| { frame_set(frame, idn.name, c.val); }
                else => { }
            }
            return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
        }
        .if_ => |x| {
            let cc: Control = eval_expr(x.cond, frame, fntab);
            let cond_truthy: i32 = bool_coerce(cc.val.bits as i32);
            if (cond_truthy == 1) {
                return exec_block(x.then_body, frame, fntab);
            }
            if (x.has_els == 1) {
                return exec_block(x.els_body, frame, fntab);
            }
            return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
        }
        .while_ => |w| {
            // while (cond) { body } — re-evaluate cond after each iteration.
            // return inside body must propagate, so we forward the Control.
            // has_cap (while-let) is out of scope for the current feature set.
            let looping: i32 = 1;
            while (looping == 1) {
                let cc: Control = eval_expr(w.cond, frame, fntab);
                if (bool_coerce(cc.val.bits as i32) == 0) { looping = 0; }
                if (looping == 1) {
                    let bc: Control = exec_block(w.body, frame, fntab);
                    if (bc.kind == CTRL_RETURN()) { return bc; }
                }
            }
            return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
        }
        .ret => |r| {
            if (r.has_expr == 1) {
                let c: Control = eval_expr(r.expr, frame, fntab);
                return Control{ .kind = CTRL_RETURN(), .val = c.val };
            }
            return Control{ .kind = CTRL_RETURN(), .val = v_i32(0) };
        }
        .estmt => |e| {
            return eval_expr(e.expr, frame, fntab);
        }
        else => {
            return Control{ .kind = CTRL_NONE(), .val = v_i32(0) };
        }
    }
}

// ── entry point ────────────────────────────────────────────────────────────
// Build the FnTable from parsed decls, then invoke `main`.
fn run_program(decls: ArrayList[*Node]) i32 {
    let fntab: FnTable = fntab_new();
    let main_decl: *Node = null;
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        let d: *Node = get[*Node](decls, i);
        switch (d.*) {
            .fn_decl => |fd| {
                fntab_register(&fntab, fd.name, d);
                if (@strEq(fd.name, "main") == 1) { main_decl = d; }
            }
            else => { }
        }
        i = i + 1;
    }
    if (main_decl == null) {
        _zag_println("interp: no fn main()");
        return 1;
    }
    let main_frame: Frame = frame_new();
    switch (main_decl.*) {
        .fn_decl => |fd| {
            let _: Control = exec_block(fd.body, &main_frame, &fntab);
        }
        else => { }
    }
    return 0;
}
