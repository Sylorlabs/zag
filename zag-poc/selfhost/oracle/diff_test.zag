// selfhost/oracle/diff_test.zag — driver for the differential oracle
//
// Reads Zag source from stdin, parses it, and runs it through the interpreter.
// Pair with selfhost/oracle/run_diff.sh: that script also compiles the same
// source via zagc (the C backend) and diffs stdout. If both produce the same
// output, the interpreter is verified for the surface it covers.

@import("interp.zag")
@import("../parse.zag")
@import("../../std/rt.zag")

fn main() i32 {
    let src: []u8 = _zag_read_file("/dev/stdin");
    if (src.len < 0) {
        return 1;
    }
    let decls: ArrayList[*Node] = parse_program(src);
    return run_program(decls);
}
