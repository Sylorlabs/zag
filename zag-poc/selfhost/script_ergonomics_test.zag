@import("script_syntax.zag")

fn expect(ok:i32,name:[]u8,fail:*i32)void{
    if(ok==1){_zag_println(_zag_str_concat("ok  ",name));return;}
    _zag_eprintln(_zag_str_concat("XX  ",name));fail.*=fail.*+1;
}
fn main()i32{
    // The runner compiles the current normalizer, then feeds its output to the
    // existing native compiler. No compiler bootstrap is needed.
    if(_zag_argc()==2){
        _zag_println(script_syntax_normalize(_zag_read_file(_zag_arg(1))));
        return 0;
    }
    let fail:i32=0;
    let surface:[]u8=script_syntax_normalize(
        "script;\ncount=1\ncount += 2\ncount*=3+4; # rhs\nif ready and not failed or forced: # block\n    return 0\n");
    expect(zs_find(surface,"ready && ! failed || forced")>=0&&zs_find(surface,"// block")>=0,"boolean operators and header comments",&fail);
    expect(zs_find(surface,"let count = 1;")>=0&&
        zs_find(surface,"count = count + (2);")>=0&&
        zs_find(surface,"count = count * (3+4); // rhs")>=0,"compound precedence and semicolon",&fail);
    expect(zs_assignment_at("call(value=3)")==-1&&
        zs_assignment_at("items[key=3]")==-1&&
        zs_assignment_at("call(left==right)")==-1&&
        zs_assignment_at("left==right")==-1&&
        zs_assignment_at("left!=right")==-1&&
        zs_assignment_at("left<=right")==-1&&
        zs_assignment_at("left>=right")==-1,"nested assignments and comparisons",&fail);
    expect(zs_compound_assignment_at("call(value+=3)")==-1&&
        zs_compound_assignment_at("x += call(a==b)")==2&&
        zs_compound_assignment_at("x = call(a+=b)")==-1&&
        zs_compound_assignment_at("x +== y")==-1,"compound scanner boundaries",&fail);
    expect(zs_assignment_at("'='")==-1&&zs_assignment_at("\"x=y\"")==-1&&
        zs_assignment_at("call() # x=1")==-1&&
        zs_compound_assignment_at("call() // x+=1")==-1,"literal and comment operators",&fail);
    let comments:[]u8=script_syntax_normalize(
        "script;\n# { is and +=\n// } is or *=\nname = \"#literal // is and +=\" # explanation\nch = '#'\nbrace = '{'\nprint(name) // is not changed\n");
    expect(zs_find(comments,"let name = \"#literal // is and +=\"; // explanation")>=0&&
        zs_find(comments,"let ch = '#';")>=0&&
        zs_find(comments,"let brace = '{';")>=0&&
        zs_find(comments,"println(name); // is not changed")>=0,"comments and character literals preserved",&fail);
    let expr:ArrayList[u8]=make[u8](64);
    zs_emit_expr(&expr,"'a' + ']' + \"escaped \\\" is and #\"");
    expect(@strEq(expr.data[0..expr.len],"'a' + ']' + \"escaped \\\" is and #\""),"escaped quotes preserve literal text",&fail);
    let calls:[]u8=script_syntax_normalize(
        "script;\nresult = call(left==right)\ncall(value=3)\nvalues.append(left==right)\n");
    expect(zs_find(calls,"let result = call(left==right);")>=0&&
        zs_find(calls,"call(value=3);")>=0&&
        zs_find(calls,"append(values, left==right);")>=0,"argument equality and append lowering",&fail);
    let quoted_comment:[]u8=script_syntax_normalize("script;\n# unmatched \" ' {\nx=1 // unmatched \"\n");
    expect(zs_find(quoted_comment,"let x = 1; // unmatched \"")>=0,"comment quotes never reach lexer",&fail);
    let indexed:ArrayList[u8]=make[u8](64);
    zs_emit_expr(&indexed,"values[']']");
    expect(@strEq(indexed.data[0..indexed.len],"item_at(values, ']')"),"index closing character literal",&fail);
    let strict:[]u8="fn main()i32 { return 0; } // is";
    expect(@strEq(script_syntax_normalize(strict),strict),"strict source unchanged",&fail);
    if(fail==0){_zag_println("script-ergonomics pass=11 fail=0");return 0;}
    return 1;
}
