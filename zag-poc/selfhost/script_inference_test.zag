@import("script_syntax.zag")

fn zi_expect(source:[]u8,want:[]u8)void{
    let actual:[]u8=script_syntax_normalize(source);
    if(zs_find(actual,want)<0){
        _zag_eprintln(_zag_str_concat("missing: ",want));_zag_eprintln(actual);_zag_exit(1);
    }
}
fn main()i32{
    if(_zag_argc()==2){
        _zag_println(script_syntax_normalize(_zag_read_file(_zag_arg(1))));return 0;
    }
    zi_expect("script;\ndef identity(x):\n    return x\nvalue=identity(\"hi\")\n","fn identity(x:[]u8) []u8");
    zi_expect("script;\ndef identity(x):\n    return x\nvalue=identity(True)\n","fn identity(x:bool) bool");
    zi_expect("script;\ndef identity(x):\n    return x\nvalue=identity(8)\n","fn identity(x:i64) i64");
    zi_expect("script;\ndef negate(x):\n    return not x\n","fn negate(x:bool) bool");
    zi_expect("script;\ndef twice(x):\n    return x*2\n","fn twice(x:i64) i64");
    zi_expect("script;\ndef first(x):\n    return second(x)\ndef second(y):\n    return y\nvalue=first(\"text\")\n","fn second(y:[]u8) []u8");
    zi_expect("script;\nvalue=first(True)\ndef second(y):\n    return y\ndef first(x):\n    return second(x)\n","fn first(x:bool) bool");
    zi_expect("script;\ndef narrow(x: i32)->i32:\n    return x+1\nvalue=narrow(7)\n","fn narrow(x:i32) i32");
    zi_expect("script;\ndef answer():\n    return \"yes # not return 0\"\n","fn answer() []u8");
    zi_expect("script;\ndef empty():\n    pass\nempty()\n","fn empty() void");
    zi_expect("script;\ndef same(x):\n    if x==0:\n        return True\n    else:\n        return same(x-1)\n","fn same(x:i64) bool");
    zi_expect("script;\ndef message():\n    return f\"{{hello}} {call(\"is # {\")}!\"\n","return f\"{{hello}} {call(\"is # {\")}!\";");
    zi_expect("script;\ndef message():\n    return f\"{call(\"x\")}\"\n","fn message() []u8");
    zi_expect("script;\ndef record(x: Point) -> Point:\n    return x\nvalue=Point{x: 1, y}\n","fn record(x:Point) Point");

    zi_expect("script;\ndef left(x):\n    return right(x)\ndef right(y):\n    if y==0:\n        return False\n    return left(y-1)\n","fn left(x:i64) bool");
    zi_expect("script;\ndef named():\n    return Point{x: 1}\n","fn named() Point");
    zi_expect("script;\ndef named(x:Point)->bool:\n    if x==Point{x: 1}:\n        return True\n    return False\n","fn named(x:Point) bool");
    zi_expect("script;\ndef annotated(x:f64)->f64:\n    return x+1\n","fn annotated(x:f64) f64");
    zi_expect("script;\ndef local(x):\n    x=x+1\n    return x\n","x = x+1;");
    zi_expect("script;\ndef one(x):\n    result=x+1\n    return result\ndef two(x):\n    result=x+2\n    return result\n","fn two(x:i64) i64 {\nlet result = x+2;");
    let interpolated:[]u8="script;\ndef text():\n    return f\"{{{{}}}} {call(\"# is {\")} ' and not\"\n";
    let lexed:[]u8=zs_lex_source(interpolated);
    if(lexed.len!=interpolated.len){return 1;}
    let normalized:ZsNormalized=script_syntax_normalize_with_origins(interpolated);
    if(!@strEq(normalized.cst.source,interpolated)||script_syntax_cst_valid(normalized.cst)==0){return 2;}
    zi_expect("script; if(true) { return 0; }","script; if(true) { return 0; }");
    zi_expect("script;\ndef bump(x):\n    x += 2\n    return x\n","fn bump(x:i64) i64");
    zi_expect("script;\ndef dot():\n    return '.'\n","fn dot() i64");
    zi_expect("script;\ndef exp():\n    return 1e3\n","fn exp() f64");
    zi_expect("script;\ndef hex():\n    return 0xFE\n","fn hex() i64");
    zi_expect("script;\ndef mapping(m:ScriptMap[i64])->ScriptMap[i64]:\n    return m\nlet m: ScriptMap[i64] = {}\n","let m: ScriptMap[i64] = {};");
    zi_expect("script;\ndef scalar():\n    return 1\nm = {\"key\": scalar()}\n","let m = {\"key\": scalar()};");
    let inferred:ZsNormalized=script_syntax_normalize_with_origins("script;\ndef value():\n    return True\n");
    if(inferred.origins.len<2||inferred.origins.data[1].exact!=0){return 3;}
    zi_expect("script;\ndef optional(x:i64)->?i64:\n    return x\n","fn optional(x:i64) ?i64");
    zi_expect("script;\ndef fallible(x:i64)->!i64:\n    return x\n","fn fallible(x:i64) !i64");
    zi_expect("script;\ndef same(a,b):\n    return @strEq(a,b)\n","fn same(a:[]u8, b:[]u8) bool");
    let strict_f:[]u8="fn text() []u8 { return f\"{nested(\"a'b\")}\"; }";
    let strict_cst:ZsCst=script_syntax_cst(strict_f);
    if(script_syntax_cst_valid(strict_cst)==0||!@strEq(strict_cst.source,strict_f)||
        zs_lex_source(strict_f).len!=strict_f.len){return 4;}
    let strict_normal:ZsNormalized=script_syntax_normalize_with_origins(strict_f);
    if(!@strEq(strict_normal.source,strict_f)||strict_normal.origins.len!=1||strict_normal.origins.data[0].exact!=1){return 5;}
    let embed:[]u8="fn asset() []u8 { return #embed(\"file.bin\"); }";
    if(!@strEq(zs_lex_source(embed),embed)){return 6;}
    let embed_cst:ZsCst=script_syntax_cst(embed);let hash_found:i32=0;let ei:i32=0;
    while(ei<embed_cst.tokens.len){
        let token:ZsCstToken=embed_cst.tokens.data[ei];
        if(@strEq(embed[token.byte_start..token.byte_end],"#")){hash_found=1;}
        ei=ei+1;
    }
    if(hash_found!=1){return 7;}
    let strict_comment:[]u8="// f\"{bad ' quote\nfn okay() i32 { return 0; }";
    if(!@strEq(zs_lex_source(strict_comment),strict_comment)||
        script_syntax_cst_valid(script_syntax_cst(strict_comment))==0){return 8;}
    _zag_println("script-inference pass=35 fail=0");return 0;
}
