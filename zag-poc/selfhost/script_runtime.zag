// script_runtime.zag -- smallest honest runtime foundation for Zag Script.
//
// Allocations made by this portable policy model are retained for the lifetime
// of the process. The generated Linux x86-64 runtime implements policy 1 as one
// arena and policy 2 as individually tracked native blocks reclaimed at
// shutdown. The arena charges requested payload; the bounded heap charges
// payload plus a 16-byte ownership header. Native allocator size-class slack is
// not counted, so neither model is a hard process-RSS cap. This is not an
// ownership system or a general memory-safety proof. Strict libraries remain
// free to require their own explicit allocator.
//
// Native generated script entry points additionally carry compiler-owned
// context metadata and expose `script_alloc(byte_count)` in the root script
// body. That convenience enforces the selected 64 MiB Script allocator budget and
// returns null when the request is invalid or exceeds the remaining budget.
// `script_alloc_used()` reports charged bytes for inspection/testing.
// A user-declared `script_alloc` wins, and imported strict-library allocation
// is never redirected. Compiler-owned root Script `new` uses the selected policy;
// ordinary `make`, strict-library `new`, and allocator metadata are excluded.
// This remains neither an RSS limit nor a general memory-safety claim.

@import("../std/list.zag")

struct ScriptLimits {
    max_memory_bytes: i64,
    max_processes: i32,
    process_timeout_ms: i64,
}

struct ScriptCapabilities {
    bits: i32,
    filesystem_read: i32,
    filesystem_write: i32,
    process: i32,
    environment_read: i32,
    network: i32,
    device: i32,
}

// The compiler exposes a read-only Script environment lookup only after the
// root's exact requested name has passed the explicit project allowlist. This
// metadata is still not a dynamic map or a strict-library API.
struct ScriptEnvironmentView {
    read_only: i32,
    lookup_available: i32,
}

// Stable internal policy ids shared conceptually with the generated native
// context. They describe choices already validated by the compiler; they do
// not expose compiler-generated symbols or imply an unimplemented transform.
struct ScriptExecutionPolicy {
    allocator_id: i32,
    cpu_id: i32,
    device_id: i32,
    layout_id: i32,
}

struct ScriptErrorReporterPolicy {
    uncaught_to_stderr: i32,
    include_source: i32,
    include_operation: i32,
    failure_exit_status: i32,
}

struct ScriptAllocation {
    ok: i32,
    requested_bytes: i64,
    diagnostic: []u8,
    bytes: ArrayList[u8],
}

struct ScriptAllocatorState {
    policy_id: i32,
    limit_bytes: i64,
    used_bytes: i64,
    allocation_count: i32,
    failed_allocations: i32,
}

struct ScriptRuntimeState {
    running: i32,
    output_flushed: i32,
    shutdown_complete: i32,
}

struct ScriptContext {
    args: ArrayList[[]u8],
    environment: ScriptEnvironmentView,
    capabilities: ScriptCapabilities,
    limits: ScriptLimits,
    execution: ScriptExecutionPolicy,
    allocator: ScriptAllocatorState,
    error_reporter: ScriptErrorReporterPolicy,
    runtime: ScriptRuntimeState,
}

fn script_default_limits() ScriptLimits {
    return ScriptLimits{ .max_memory_bytes = 67108864,
        .max_processes = 4, .process_timeout_ms = 30000 };
}

fn script_default_capabilities() ScriptCapabilities {
    return ScriptCapabilities{ .bits = 3,
        .filesystem_read = 1, .filesystem_write = 1,
        .process = 0, .environment_read = 0, .network = 0, .device = 0 };
}

fn script_capabilities_from_bits(bits: i32) ScriptCapabilities {
    return ScriptCapabilities{ .bits = bits,
        .filesystem_read = bits & 1,
        .filesystem_write = (bits >> 1) & 1,
        .process = (bits >> 2) & 1,
        .environment_read = (bits >> 3) & 1,
        .network = (bits >> 4) & 1,
        .device = (bits >> 5) & 1 };
}

fn script_environment_view_from_bits(bits: i32) ScriptEnvironmentView {
    return ScriptEnvironmentView{ .read_only = 1,
        .lookup_available = (bits >> 3) & 1 };
}

fn script_default_execution_policy() ScriptExecutionPolicy {
    // 1 = process-lifetime arena, generic x86, CPU, compiler-owned layout.
    return ScriptExecutionPolicy{ .allocator_id = 1, .cpu_id = 1,
        .device_id = 1, .layout_id = 1 };
}

fn script_allocator_charge(policy_id:i32, requested:i64) i64 {
    if(policy_id==2){return requested+16;}
    return requested;
}

fn script_default_error_reporter() ScriptErrorReporterPolicy {
    return ScriptErrorReporterPolicy{ .uncaught_to_stderr = 1,
        .include_source = 1, .include_operation = 1,
        .failure_exit_status = 1 };
}

fn script_capture_args() ArrayList[[]u8] {
    let result: ArrayList[[]u8] = make[[]u8](_zag_argc());
    let i: i32 = 0;
    while (i < _zag_argc()) {
        push[[]u8](&result, _zag_arg(i));
        i = i + 1;
    }
    return result;
}

fn script_context_init_policy_with(limit_bytes: i64, args: ArrayList[[]u8],
    capability_bits: i32, execution: ScriptExecutionPolicy) ScriptContext {
    let limits: ScriptLimits = script_default_limits();
    limits.max_memory_bytes = limit_bytes;
    return ScriptContext{ .args = args,
        .environment = script_environment_view_from_bits(capability_bits),
        .capabilities = script_capabilities_from_bits(capability_bits),
        .limits = limits, .execution = execution,
        .allocator = ScriptAllocatorState{ .policy_id = execution.allocator_id,
            .limit_bytes = limit_bytes,
            .used_bytes = 0, .allocation_count = 0, .failed_allocations = 0 },
        .error_reporter = script_default_error_reporter(),
        .runtime = ScriptRuntimeState{ .running = 1, .output_flushed = 0,
            .shutdown_complete = 0 } };
}

fn script_context_init_with(limit_bytes: i64, args: ArrayList[[]u8]) ScriptContext {
    let capabilities: ScriptCapabilities = script_default_capabilities();
    return script_context_init_policy_with(limit_bytes, args, capabilities.bits,
        script_default_execution_policy());
}

fn script_context_init(limit_bytes: i64) ScriptContext {
    return script_context_init_with(limit_bytes, script_capture_args());
}

fn script_empty_allocation(requested: i64, message: []u8) ScriptAllocation {
    return ScriptAllocation{ .ok = 0, .requested_bytes = requested,
        .diagnostic = message,
        .bytes = ArrayList[u8]{ .data = 0 as *u8, .len = 0, .cap = 0 } };
}

// Returns an owned-by-the-script-lifetime byte region. The counter is updated
// only after validation and before allocation. Generated native Script
// allocation is fail-closed and does not expose recoverable host allocation
// failure.
fn script_alloc(ctx: *ScriptContext, byte_count: i64) ScriptAllocation {
    if (ctx.*.runtime.running == 0) {
        ctx.*.allocator.failed_allocations = ctx.*.allocator.failed_allocations + 1;
        return script_empty_allocation(byte_count, "script allocation rejected: runtime is shut down");
    }
    if (byte_count < 0) {
        ctx.*.allocator.failed_allocations = ctx.*.allocator.failed_allocations + 1;
        return script_empty_allocation(byte_count, "script allocation rejected: size must be nonnegative");
    }
    if (byte_count > 2147483647) {
        ctx.*.allocator.failed_allocations = ctx.*.allocator.failed_allocations + 1;
        return script_empty_allocation(byte_count,
            "script allocation rejected: request exceeds current native allocation representation");
    }
    let charged_bytes:i64=script_allocator_charge(
        ctx.*.allocator.policy_id,byte_count);
    // Subtraction form avoids overflow in used + charged bytes.
    if (ctx.*.allocator.limit_bytes < 0 ||
        charged_bytes > ctx.*.allocator.limit_bytes - ctx.*.allocator.used_bytes) {
        ctx.*.allocator.failed_allocations = ctx.*.allocator.failed_allocations + 1;
        return script_empty_allocation(byte_count, "script memory limit exceeded");
    }
    if (byte_count == 0) {
        ctx.*.allocator.used_bytes =
            ctx.*.allocator.used_bytes + charged_bytes;
        ctx.*.allocator.allocation_count = ctx.*.allocator.allocation_count + 1;
        return ScriptAllocation{ .ok = 1, .requested_bytes = 0,
            .diagnostic = "",
            .bytes = ArrayList[u8]{ .data = 0 as *u8, .len = 0, .cap = 0 } };
    }
    let data: ArrayList[u8] = make[u8](byte_count as i32);
    let i: i64 = 0;
    while (i < byte_count) { push[u8](&data, 0); i = i + 1; }
    ctx.*.allocator.used_bytes =
        ctx.*.allocator.used_bytes + charged_bytes;
    ctx.*.allocator.allocation_count = ctx.*.allocator.allocation_count + 1;
    return ScriptAllocation{ .ok = 1, .requested_bytes = byte_count,
        .diagnostic = "", .bytes = data };
}

// Idempotent deterministic policy-model shutdown: flush output before recording
// completion. Generated native shutdown additionally performs the selected
// allocator's real arena/block reclamation.
fn script_shutdown(ctx: *ScriptContext) void {
    if (ctx.*.runtime.shutdown_complete == 1) { return; }
    _zag_flush();
    ctx.*.runtime.output_flushed = 1;
    ctx.*.runtime.running = 0;
    ctx.*.runtime.shutdown_complete = 1;
}
