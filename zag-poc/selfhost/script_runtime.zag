// script_runtime.zag -- smallest honest runtime foundation for Zag Script.
//
// Allocations made here are retained for the lifetime of the process.  The
// byte counter and limit provide bounded requested-payload accounting. Allocator
// metadata is not counted, so this is not yet a hard process-RSS cap. It is not
// an ownership system, reclamation, or a general memory-safety proof. Strict
// libraries remain free to require their own explicit allocator.
//
// Native generated script entry points additionally carry compiler-owned
// context metadata and expose `script_alloc(byte_count)` in the root script
// body. That convenience enforces the 64 MiB requested-payload budget and
// returns null when the request is invalid or exceeds the remaining budget.
// `script_alloc_used()` reports charged payload bytes for inspection/testing.
// A user-declared `script_alloc` wins, and imported strict-library allocation
// is never redirected. Ordinary `make`/`new` allocation is not yet charged to
// this budget, allocator metadata is excluded, and this remains neither an RSS
// limit nor a general memory-safety claim.

@import("../std/list.zag")

struct ScriptLimits {
    max_memory_bytes: i64,
    max_processes: i32,
    process_timeout_ms: i64,
}

struct ScriptCapabilities {
    filesystem_read: i32,
    filesystem_write: i32,
    process: i32,
    network: i32,
    device: i32,
}

struct ScriptAllocation {
    ok: i32,
    requested_bytes: i64,
    diagnostic: []u8,
    bytes: ArrayList[u8],
}

struct ScriptAllocatorState {
    limit_bytes: i64,
    used_bytes: i64,
    allocation_count: i32,
    failed_allocations: i32,
}

struct ScriptRuntimeState {
    running: i32,
    output_flushed: i32,
    shutdown_complete: i32,
}

struct ScriptContext {
    args: ArrayList[[]u8],
    capabilities: ScriptCapabilities,
    limits: ScriptLimits,
    allocator: ScriptAllocatorState,
    runtime: ScriptRuntimeState,
}

fn script_default_limits() ScriptLimits {
    return ScriptLimits{ .max_memory_bytes = 67108864,
        .max_processes = 4, .process_timeout_ms = 30000 };
}

fn script_default_capabilities() ScriptCapabilities {
    return ScriptCapabilities{ .filesystem_read = 1, .filesystem_write = 1,
        .process = 0, .network = 0, .device = 0 };
}

fn script_capture_args() ArrayList[[]u8] {
    let result: ArrayList[[]u8] = make[[]u8](_zag_argc());
    let i: i32 = 0;
    while (i < _zag_argc()) {
        push[[]u8](&result, _zag_arg(i));
        i = i + 1;
    }
    return result;
}

fn script_context_init_with(limit_bytes: i64, args: ArrayList[[]u8]) ScriptContext {
    let limits: ScriptLimits = script_default_limits();
    limits.max_memory_bytes = limit_bytes;
    return ScriptContext{ .args = args,
        .capabilities = script_default_capabilities(), .limits = limits,
        .allocator = ScriptAllocatorState{ .limit_bytes = limit_bytes,
            .used_bytes = 0, .allocation_count = 0, .failed_allocations = 0 },
        .runtime = ScriptRuntimeState{ .running = 1, .output_flushed = 0,
            .shutdown_complete = 0 } };
}

fn script_context_init(limit_bytes: i64) ScriptContext {
    return script_context_init_with(limit_bytes, script_capture_args());
}

fn script_empty_allocation(requested: i64, message: []u8) ScriptAllocation {
    return ScriptAllocation{ .ok = 0, .requested_bytes = requested,
        .diagnostic = message,
        .bytes = ArrayList[u8]{ .data = 0 as *u8, .len = 0, .cap = 0 } };
}

// Returns an owned-by-the-script-lifetime byte region. The counter is updated
// only after validation and before allocation. The current native allocator is
// process-lifetime and does not expose recoverable host allocation failure.
fn script_alloc(ctx: *ScriptContext, byte_count: i64) ScriptAllocation {
    if (ctx.*.runtime.running == 0) {
        ctx.*.allocator.failed_allocations = ctx.*.allocator.failed_allocations + 1;
        return script_empty_allocation(byte_count, "script allocation rejected: runtime is shut down");
    }
    if (byte_count < 0) {
        ctx.*.allocator.failed_allocations = ctx.*.allocator.failed_allocations + 1;
        return script_empty_allocation(byte_count, "script allocation rejected: size must be nonnegative");
    }
    if (byte_count > 2147483647) {
        ctx.*.allocator.failed_allocations = ctx.*.allocator.failed_allocations + 1;
        return script_empty_allocation(byte_count,
            "script allocation rejected: request exceeds current native allocation representation");
    }
    // Subtraction form avoids overflow in used + requested.
    if (ctx.*.allocator.limit_bytes < 0 ||
        byte_count > ctx.*.allocator.limit_bytes - ctx.*.allocator.used_bytes) {
        ctx.*.allocator.failed_allocations = ctx.*.allocator.failed_allocations + 1;
        return script_empty_allocation(byte_count, "script memory limit exceeded");
    }
    if (byte_count == 0) {
        ctx.*.allocator.allocation_count = ctx.*.allocator.allocation_count + 1;
        return ScriptAllocation{ .ok = 1, .requested_bytes = 0,
            .diagnostic = "",
            .bytes = ArrayList[u8]{ .data = 0 as *u8, .len = 0, .cap = 0 } };
    }
    let data: ArrayList[u8] = make[u8](byte_count as i32);
    let i: i64 = 0;
    while (i < byte_count) { push[u8](&data, 0); i = i + 1; }
    ctx.*.allocator.used_bytes = ctx.*.allocator.used_bytes + byte_count;
    ctx.*.allocator.allocation_count = ctx.*.allocator.allocation_count + 1;
    return ScriptAllocation{ .ok = 1, .requested_bytes = byte_count,
        .diagnostic = "", .bytes = data };
}

// Idempotent deterministic shutdown: flush output before recording completion.
// Process-lifetime allocations remain retained until process exit.
fn script_shutdown(ctx: *ScriptContext) void {
    if (ctx.*.runtime.shutdown_complete == 1) { return; }
    _zag_flush();
    ctx.*.runtime.output_flushed = 1;
    ctx.*.runtime.running = 0;
    ctx.*.runtime.shutdown_complete = 1;
}
