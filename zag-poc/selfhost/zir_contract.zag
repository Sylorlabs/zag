// Shared typed IR contract consumed by the producer, foreground backend, and
// provenance tools.  Keep this file deliberately free of sema/map and source
// construction logic: backends need the schema and identity rules, not the
// producer's parser-side implementation.

@import("parse.zag")

struct ZOrigin {
    module: []u8,
    line: i32,
    byte_start: i32,
    byte_end: i32,
    stable_id: i64,
    complete: i32,
    exact: i32,
}

struct ZVal {
    name: []u8,
    ty: []u8,
    ownership: []u8,
    alias_region: []u8,
    lifetime: []u8,
    layout: []u8,
    origin: ZOrigin,
}
struct ZAttr { key: []u8, val: []u8 }
struct ZOp {
    name: []u8,
    results: ArrayList[ZVal],
    operands: ArrayList[ZVal],
    attrs: ArrayList[ZAttr],
    regions: ArrayList[ZRegion],
    effects: i32,
    reads: []u8,
    writes: []u8,
    origin: ZOrigin,
}
struct ZBlock { ops: ArrayList[ZOp] }
struct ZRegion { blocks: ArrayList[ZBlock] }
struct ZFunc {
    name: []u8,
    params: ArrayList[ZVal],
    ret: []u8,
    body: ZBlock,
    effects: i32,
    origin: ZOrigin,
    coverage_complete: i32,
    coverage_errors: i32,
}
struct ZModule {
    funcs: ArrayList[ZFunc],
    schema_version: []u8,
    transform_version: []u8,
    coverage_complete: i32,
    coverage_errors: i32,
    origin_complete: i32,
    origin_exact: i32,
}

struct ZirSemanticIdentity { first: i64, second: i64, bytes: i64 }
struct ZirTransformCertificate {
    format: []u8,
    identity_schema: []u8,
    rule: []u8,
    checker: []u8,
    ir_verifier: []u8,
    before: ZirSemanticIdentity,
    after: ZirSemanticIdentity,
    function_index: i32,
    op_index: i32,
    lhs_def_index: i32,
    rhs_def_index: i32,
    transform_count: i32,
    function_name: []u8,
    lhs_ssa: []u8,
    rhs_ssa: []u8,
    result_ssa: []u8,
    result_type: []u8,
    source_context: []u8,
    policy_target: []u8,
    policy_edition: []u8,
    arithmetic_policy: []u8,
    safety_checked: i32,
    sanitize_memory: i32,
    automatic_selection: i32,
    function_origin: ZOrigin,
    op_origin: ZOrigin,
    lhs_def_origin: ZOrigin,
    rhs_def_origin: ZOrigin,
    lhs_origin: ZOrigin,
    rhs_origin: ZOrigin,
    result_origin: ZOrigin,
    lhs_value: i64,
    rhs_value: i64,
    result_value: i64,
    valid: i32,
}
struct ZirTransformProposal {
    candidate: ZModule,
    certificate: ZirTransformCertificate,
    proposed: i32,
}
struct ZirTransformCheck { accepted: i32, reason: []u8 }
struct ZirTransformPolicy {
    target: []u8,
    edition: []u8,
    arithmetic: []u8,
    safety_checked: i32,
    sanitize_memory: i32,
    automatic_selection: i32,
}
struct ZirAuthority {
    module: ZModule,
    ast_bridge: ArrayList[*Node],
    valid: i32,
    verify_errors: i32,
    coverage_complete: i32,
    coverage_errors: i32,
    origin_complete: i32,
    origin_exact: i32,
    transform_status: []u8,
    transform_rule: []u8,
    transform_checker: []u8,
    transform_count: i32,
    certificate: ZirTransformCertificate,
}

fn zir_unknown_origin() ZOrigin {
    return ZOrigin{.module="",.line=0,.byte_start=0,.byte_end=0,
        .stable_id=0,.complete=0,.exact=0};
}
fn zir_transform_cert_format()[]u8{return "zag-ir-transform-certificate-v1";}
fn zir_transform_identity_schema()[]u8{return "zag-ir-semantic-identity-v1";}
fn zir_transform_rule_const_i32_add()[]u8{return "const-i32-add-v1";}
fn zir_transform_structural_checker_const_i32_add()[]u8{return "const-i32-add-structural-check-v1";}
fn zir_transform_checker_const_i32_add()[]u8{return "const-i32-add-source-policy-check-v1";}
fn zir_ir_verifier_name()[]u8{return "def-before-use-v1";}
fn zir_transform_source_context_const_i32_add()[]u8{return "direct-explicit-i32-expression-v1";}
fn zir_transform_target_linux_x86_64()[]u8{return "linux-x86_64";}
fn zir_transform_edition_regular()[]u8{return "2026";}
fn zir_transform_arithmetic_i32_wrap()[]u8{return "i32-twos-complement-wrap-v1";}

fn zir_identity_empty()ZirSemanticIdentity{
    return ZirSemanticIdentity{.first=216613626,.second=131542391,.bytes=0};
}
fn zir_identity_equal(a:ZirSemanticIdentity,b:ZirSemanticIdentity)i32{
    return (a.first==b.first&&a.second==b.second&&a.bytes==b.bytes) as i32;
}
fn zir_transform_certificate_none()ZirTransformCertificate{
    let unknown:ZOrigin=zir_unknown_origin();let empty:ZirSemanticIdentity=zir_identity_empty();
    return ZirTransformCertificate{.format="",.identity_schema="",.rule="",
        .checker="",.ir_verifier="",.before=empty,.after=empty,
        .function_index=0-1,.op_index=0-1,.lhs_def_index=0-1,.rhs_def_index=0-1,
        .transform_count=0,.function_name="",.lhs_ssa="",.rhs_ssa="",
        .result_ssa="",.result_type="",.source_context="",.policy_target="",
        .policy_edition="",.arithmetic_policy="",.safety_checked=0,
        .sanitize_memory=0,.automatic_selection=0,.function_origin=unknown,
        .op_origin=unknown,.lhs_def_origin=unknown,.rhs_def_origin=unknown,
        .lhs_origin=unknown,.rhs_origin=unknown,.result_origin=unknown,
        .lhs_value=0,.rhs_value=0,.result_value=0,.valid=0};
}

fn zsid_emit(out:*ArrayList[u8],s:[]u8)void{
    let i:i32=0;while(i<s.len){push[u8](out,s[i]);i=i+1;}
}
fn zsid_text(out:*ArrayList[u8],tag:[]u8,value:[]u8)void{
    let size:[]u8=_zag_i64_to_str(value.len as i64);
    zsid_emit(out,tag);zsid_emit(out,"#");zsid_emit(out,size);
    zsid_emit(out,":");zsid_emit(out,value);zsid_emit(out,"\n");
    _zag_free(_zag_slice_ptr(size));
}
fn zsid_i64(out:*ArrayList[u8],tag:[]u8,value:i64)void{
    let text:[]u8=_zag_i64_to_str(value);zsid_text(out,tag,text);
    _zag_free(_zag_slice_ptr(text));
}
fn zsid_origin(out:*ArrayList[u8],o:ZOrigin)void{
    zsid_text(out,"origin.module",o.module);zsid_i64(out,"origin.line",o.line);
    zsid_i64(out,"origin.byte_start",o.byte_start);zsid_i64(out,"origin.byte_end",o.byte_end);
    zsid_i64(out,"origin.stable_id",o.stable_id);zsid_i64(out,"origin.complete",o.complete);
    zsid_i64(out,"origin.exact",o.exact);
}
fn zsid_value(out:*ArrayList[u8],v:ZVal)void{
    zsid_text(out,"value.name",v.name);zsid_text(out,"value.type",v.ty);
    zsid_text(out,"value.ownership",v.ownership);zsid_text(out,"value.alias",v.alias_region);
    zsid_text(out,"value.lifetime",v.lifetime);zsid_text(out,"value.layout",v.layout);
    zsid_origin(out,v.origin);
}
fn zsid_attr(out:*ArrayList[u8],a:ZAttr)void{
    zsid_text(out,"attr.key",a.key);zsid_text(out,"attr.value",a.val);
}
fn zsid_block(out:*ArrayList[u8],blk:ZBlock)void{
    zsid_i64(out,"block.op_count",blk.ops.len);let i:i32=0;
    while(i<blk.ops.len){zsid_op(out,blk.ops.data[i]);i=i+1;}
}
fn zsid_region(out:*ArrayList[u8],region:ZRegion)void{
    zsid_i64(out,"region.block_count",region.blocks.len);let i:i32=0;
    while(i<region.blocks.len){zsid_block(out,region.blocks.data[i]);i=i+1;}
}
fn zsid_op(out:*ArrayList[u8],op:ZOp)void{
    zsid_text(out,"op.name",op.name);zsid_i64(out,"op.result_count",op.results.len);
    let i:i32=0;while(i<op.results.len){zsid_value(out,op.results.data[i]);i=i+1;}
    zsid_i64(out,"op.operand_count",op.operands.len);i=0;
    while(i<op.operands.len){zsid_value(out,op.operands.data[i]);i=i+1;}
    zsid_i64(out,"op.attr_count",op.attrs.len);i=0;
    while(i<op.attrs.len){zsid_attr(out,op.attrs.data[i]);i=i+1;}
    zsid_i64(out,"op.region_count",op.regions.len);i=0;
    while(i<op.regions.len){zsid_region(out,op.regions.data[i]);i=i+1;}
    zsid_i64(out,"op.effects",op.effects);zsid_text(out,"op.reads",op.reads);
    zsid_text(out,"op.writes",op.writes);zsid_origin(out,op.origin);
}
fn zsid_function(out:*ArrayList[u8],f:ZFunc)void{
    zsid_text(out,"function.name",f.name);zsid_i64(out,"function.param_count",f.params.len);
    let i:i32=0;while(i<f.params.len){zsid_value(out,f.params.data[i]);i=i+1;}
    zsid_text(out,"function.return",f.ret);zsid_i64(out,"function.effects",f.effects);
    zsid_origin(out,f.origin);zsid_i64(out,"function.coverage_complete",f.coverage_complete);
    zsid_i64(out,"function.coverage_errors",f.coverage_errors);zsid_block(out,f.body);
}
fn zir_semantic_identity(m:ZModule)ZirSemanticIdentity{
    let bytes:ArrayList[u8]=make[u8](512);
    zsid_text(&bytes,"identity.schema",zir_transform_identity_schema());
    zsid_text(&bytes,"module.schema",m.schema_version);
    zsid_text(&bytes,"module.transform",m.transform_version);
    zsid_i64(&bytes,"module.coverage_complete",m.coverage_complete);
    zsid_i64(&bytes,"module.coverage_errors",m.coverage_errors);
    zsid_i64(&bytes,"module.origin_complete",m.origin_complete);
    zsid_i64(&bytes,"module.origin_exact",m.origin_exact);
    zsid_i64(&bytes,"module.function_count",m.funcs.len);
    let i:i32=0;while(i<m.funcs.len){zsid_function(&bytes,m.funcs.data[i]);i=i+1;}
    let a:i64=216613626;let b:i64=131542391;i=0;
    while(i<bytes.len){let byte:i64=bytes.data[i] as i64;
        a=(a*257+byte+1)%1000000007;b=(b*263+byte+1)%1000000009;i=i+1;}
    let result:ZirSemanticIdentity=ZirSemanticIdentity{.first=a,.second=b,.bytes=bytes.len};
    free[u8](&bytes);return result;
}

fn attr_val(o:ZOp,key:[]u8)[]u8{
    let i:i32=0;while(i<o.attrs.len){if(@strEq(o.attrs.data[i].key,key)){return o.attrs.data[i].val;}i=i+1;}
    return "";
}
