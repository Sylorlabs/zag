@import("package_registry_transitive.zag")

extern fn _zag_allocator_live_bytes() i64

fn v2_check(ok: i32, label: []u8, failures: *i32) void {
    if (ok != 0) { _zag_print("ok  "); _zag_println(label); }
    else { failures.* = failures.* + 1; _zag_print("FAIL "); _zag_println(label); }
}

fn main() i32 {
    let failures: i32 = 0;
    let before: i64 = _zag_allocator_live_bytes();
    let signed_body: []u8 =
        "format=zag-registry-index-v1\nauthority=local-file-v1\nsignature=ed25519\nentry=alpha\t1.2.0\tsrc/alpha.zag\t4,5,6\tsig/alpha.sig\nentry=beta\t2.0.0\tsrc/beta.zag\t7,8,9\tsig/beta.sig\n";
    let signed_index: []u8 = package_registry_finalize(signed_body);
    let edges: []u8 = "root\talpha\t^1.0.0\nroot\tbeta\t^2.0.0\nalpha\tbeta\t^2.0.0";

    let lock: PackageRegistryGraphLockV2 = package_registry_graph_lock_v2_create(
        signed_index, edges, "root", "registry/index.zag",
        PackageRegistryGraphLockV2Policy.signed_artifact);
    v2_check(lock.valid == 1 && lock.package_count == 2 &&
        @strEq(package_registry_line(lock.bytes, 0),
            "format=zag-registry-graph-lock-v2") &&
        @strEq(package_registry_line(lock.bytes, 1),
            "policy=signed-artifact") &&
        @strEq(package_registry_line(lock.bytes, 2)[0..6], "entry="),
        "v2 create retains signed artifact provenance", &failures);

    let checked: PackageRegistryGraphLockV2Check =
        package_registry_graph_lock_v2_verify(signed_index, edges, lock.bytes,
            "root", "registry/index.zag",
            PackageRegistryGraphLockV2Policy.signed_artifact);
    v2_check(checked.valid == 1 && checked.entry_count == 2 &&
        checked.error == PackageRegistryTransitiveError.none,
        "v2 verifies exact scope/index/checksum/signature tuples", &failures);

    let reordered: []u8 = "alpha\tbeta\t^2.0.0\nroot\tbeta\t^2.0.0\nroot\talpha\t^1.0.0";
    let reordered_lock: PackageRegistryGraphLockV2 =
        package_registry_graph_lock_v2_create(signed_index, reordered, "root",
            "registry/index.zag", PackageRegistryGraphLockV2Policy.signed_artifact);
    v2_check(reordered_lock.valid == 1 &&
        @strEq(lock.bytes, reordered_lock.bytes),
        "v2 lock bytes are deterministic across edge order", &failures);

    let forged: []u8 = _zag_str_concat(lock.bytes, "x");
    let forged_check: PackageRegistryGraphLockV2Check =
        package_registry_graph_lock_v2_verify(signed_index, edges, forged,
            "root", "registry/index.zag",
            PackageRegistryGraphLockV2Policy.signed_artifact);
    v2_check(forged_check.valid == 0 &&
        forged_check.error == PackageRegistryTransitiveError.invalid_lock,
        "v2 appended bytes fail the envelope checksum", &failures);
    _zag_str_free(forged);

    let extra_body: []u8 =
        "format=zag-registry-index-v1\nauthority=local-file-v1\nsignature=ed25519\nentry=alpha\t1.2.0\tsrc/alpha.zag\t4,5,6\tsig/alpha.sig\nentry=beta\t2.0.0\tsrc/beta.zag\t7,8,9\tsig/beta.sig\nentry=gamma\t3.0.0\tsrc/gamma.zag\t10,11,12\tsig/gamma.sig\n";
    let extra_index: []u8 = package_registry_finalize(extra_body);
    let changed_check: PackageRegistryGraphLockV2Check =
        package_registry_graph_lock_v2_verify(extra_index, edges, lock.bytes,
            "root", "registry/index.zag",
            PackageRegistryGraphLockV2Policy.signed_artifact);
    v2_check(changed_check.valid == 0 &&
        changed_check.error == PackageRegistryTransitiveError.lock_mismatch,
        "v2 index checksum rejects unchanged selected tuples on changed index", &failures);

    let unsigned_body: []u8 =
        "format=zag-registry-index-v1\nauthority=local-file-v1\nsignature=none\nentry=alpha\t1.2.0\tsrc/alpha.zag\t4,5,6\nentry=beta\t2.0.0\tsrc/beta.zag\t7,8,9\n";
    let unsigned_index: []u8 = package_registry_finalize(unsigned_body);
    let unsigned_lock: PackageRegistryGraphLockV2 =
        package_registry_graph_lock_v2_create(unsigned_index, edges, "root",
            "registry/index.zag", PackageRegistryGraphLockV2Policy.unsigned);
    let unsigned_check: PackageRegistryGraphLockV2Check =
        package_registry_graph_lock_v2_verify(unsigned_index, edges,
            unsigned_lock.bytes, "root", "registry/index.zag",
            PackageRegistryGraphLockV2Policy.unsigned);
    v2_check(unsigned_lock.valid == 1 && unsigned_check.valid == 1,
        "v2 preserves an explicit checksum-only policy", &failures);

    let signed_only: PackageRegistryGraphLockV2 =
        package_registry_graph_lock_v2_create(signed_index, edges, "root",
            "registry/index.zag", PackageRegistryGraphLockV2Policy.signed_index);
    v2_check(signed_only.valid == 1,
        "signed-index policy allows optional artifact signatures", &failures);

    let missing_artifact_body: []u8 =
        "format=zag-registry-index-v1\nauthority=local-file-v1\nsignature=ed25519\nentry=alpha\t1.2.0\tsrc/alpha.zag\t4,5,6\nentry=beta\t2.0.0\tsrc/beta.zag\t7,8,9\n";
    let missing_artifact_index: []u8 = package_registry_finalize(
        missing_artifact_body);
    let missing_artifact: PackageRegistryGraphLockV2 =
        package_registry_graph_lock_v2_create(missing_artifact_index, edges,
            "root", "registry/index.zag",
            PackageRegistryGraphLockV2Policy.signed_artifact);
    v2_check(missing_artifact.valid == 0 &&
        missing_artifact.error == PackageRegistryTransitiveError.invalid_graph,
        "signed-artifact policy rejects legacy unsigned entry shape", &failures);

    let bad_scope: PackageRegistryGraphLockV2 = package_registry_graph_lock_v2_create(
        signed_index, edges, "../escape", "registry/index.zag",
        PackageRegistryGraphLockV2Policy.signed_artifact);
    v2_check(bad_scope.valid == 0 &&
        bad_scope.error == PackageRegistryTransitiveError.invalid_graph,
        "v2 rejects unsafe scope provenance", &failures);

    let v1: PackageRegistryGraphLock = package_registry_graph_lock_create(
        unsigned_index, edges);
    v2_check(v1.valid == 1 && package_registry_graph_lock_verify(
        unsigned_index, edges, v1.bytes).valid == 1,
        "existing v1 create and verify behavior remains available", &failures);

    if (lock.bytes.len > 0) { _zag_str_free(lock.bytes); }
    if (reordered_lock.bytes.len > 0) { _zag_str_free(reordered_lock.bytes); }
    if (unsigned_lock.bytes.len > 0) { _zag_str_free(unsigned_lock.bytes); }
    if (signed_only.bytes.len > 0) { _zag_str_free(signed_only.bytes); }
    if (missing_artifact.bytes.len > 0) { _zag_str_free(missing_artifact.bytes); }
    if (bad_scope.bytes.len > 0) { _zag_str_free(bad_scope.bytes); }
    if (v1.bytes.len > 0) { _zag_str_free(v1.bytes); }
    _zag_str_free(signed_index); _zag_str_free(extra_index);
    _zag_str_free(unsigned_index); _zag_str_free(missing_artifact_index);
    v2_check(_zag_allocator_live_bytes() == before,
        "v2 codec restores allocator baseline", &failures);
    if (failures == 0) { _zag_println("package registry graph lock v2: 10/10"); }
    return failures;
}
