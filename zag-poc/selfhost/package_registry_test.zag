@import("package_registry.zag")
fn pr_expect(ok:i32,label:[]u8,f:*i32)void{if(ok==1){return;}_zag_eprintln(_zag_str_concat("package registry test: ",label));f.*=f.*+1;}
fn pr_digest(content:[]u8)[]u8{let h:ArrayList[u8]=macho_sha256(content);let x:ArrayList[u8]=package_registry_hex(h);free[u8](&h);return x.data[0..x.len];}
fn pr_line(out:*ArrayList[u8],name:[]u8,maj:i32,min:i32,pat:i32,root:[]u8,digest:[]u8,deps:[]u8,key:[]u8)void{
    let e:PackageRegistryEntry=PackageRegistryEntry{.name=name,.major=maj,.minor=min,.patch=pat,.root=root,.digest=digest,.deps=deps,.signature="",.valid=1};
    let basis:ArrayList[u8]=package_registry_basis(e);let mac:ArrayList[u8]=package_registry_hmac(key,basis.data[0..basis.len]);let sig:ArrayList[u8]=package_registry_hex(mac);
    package_registry_text(out,"package=");package_registry_text(out,name);push[u8](out,'\t');package_registry_number(out,maj);push[u8](out,'\t');package_registry_number(out,min);push[u8](out,'\t');package_registry_number(out,pat);push[u8](out,'\t');package_registry_text(out,root);push[u8](out,'\t');package_registry_text(out,digest);push[u8](out,'\t');package_registry_text(out,deps);push[u8](out,'\t');package_registry_text(out,sig.data[0..sig.len]);push[u8](out,'\n');
    free[u8](&sig);free[u8](&mac);free[u8](&basis);
}
fn main()i32{
    let f:i32=0;let key:[]u8="zagscript-offline-registry-trust-key-v1";
    let core:[]u8=pr_digest("core-zag-and-assets-v1");let t10:[]u8=pr_digest("toolkit-1.0");let t12:[]u8=pr_digest("toolkit-1.2-with-assets");let u10:[]u8=pr_digest("util-1.0");let u11:[]u8=pr_digest("util-1.1");
    let text:ArrayList[u8]=make[u8](4096);package_registry_text(&text,"format=zag-offline-registry-v1\n");pr_line(&text,"core",1,0,0,"vendor/core-1.0.0",core,"-",key);pr_line(&text,"toolkit",1,0,0,"vendor/toolkit-1.0.0",t10,"util@1",key);pr_line(&text,"toolkit",1,2,0,"vendor/toolkit-1.2.0",t12,"util@1",key);pr_line(&text,"util",1,0,0,"vendor/util-1.0.0",u10,"-",key);pr_line(&text,"util",1,1,0,"vendor/util-1.1.0",u11,"core@1",key);
    let r:PackageRegistry=package_registry_parse(text.data[0..text.len],key);pr_expect(r.valid==1&&r.entries.len==5,"canonical authenticated registry parses",&f);let selected:i32=package_registry_select(r,"toolkit",1);pr_expect(selected>=0&&r.entries.data[selected].minor==2,"highest compatible version selected",&f);let closure:PackageRegistryClosure=package_registry_closure(r,"toolkit",1);pr_expect(closure.valid==1&&closure.indices.len==3,"transitive closure selects toolkit util core",&f);
    let wrong:PackageRegistry=package_registry_parse(text.data[0..text.len],"wrong-trust-key");pr_expect(wrong.valid==0,"wrong trust key rejects registry",&f);package_registry_release(&wrong);
    let unsafe_text:ArrayList[u8]=make[u8](1024);package_registry_text(&unsafe_text,"format=zag-offline-registry-v1\n");pr_line(&unsafe_text,"bad",1,0,0,"vendor/../escape",core,"-",key);let bad:PackageRegistry=package_registry_parse(unsafe_text.data[0..unsafe_text.len],key);pr_expect(bad.valid==0,"vendor traversal rejected",&f);package_registry_release(&bad);free[u8](&unsafe_text);
    let h1:ArrayList[u8]=package_registry_hmac(key,"metadata");let h2:ArrayList[u8]=package_registry_hmac(key,"metadata");pr_expect(h1.len==32&&h2.len==32&&package_registry_equal(h1,h2.data[0..h2.len])==1,"HMAC-SHA256 deterministic",&f);free[u8](&h2);free[u8](&h1);
    let changed:[]u8=pr_digest("toolkit-1.2-with-assets-mutated");pr_expect(!@strEq(changed,t12),"non-Zag asset content changes SHA-256",&f);_zag_free(_zag_slice_ptr(changed));package_registry_closure_release(&closure);package_registry_release(&r);free[u8](&text);_zag_free(_zag_slice_ptr(u11));_zag_free(_zag_slice_ptr(u10));_zag_free(_zag_slice_ptr(t12));_zag_free(_zag_slice_ptr(t10));_zag_free(_zag_slice_ptr(core));if(f==0){_zag_println("offline authenticated package registry: PASS");}return f;
}
