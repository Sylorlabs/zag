@import("package_registry.zag")

extern fn _zag_allocator_live_bytes() i64

fn registry_expect(ok: i32, label: []u8, failures: *i32) void {
    if (ok != 0) { _zag_print("ok  "); _zag_println(label); }
    else { failures.* = failures.* + 1; _zag_print("FAIL "); _zag_println(label); }
}

fn registry_body() []u8 {
    return "format=zag-registry-index-v1\nauthority=local-file-v1\nsignature=none\nentry=alpha\t1.0.0\tsrc/alpha-1.zag\t1,2,3\nentry=alpha\t1.2.0\tsrc/alpha-2.zag\t4,5,6\nentry=beta\t2.0.0\tsrc/beta.zag\t7,8,9\n";
}

fn main() i32 {
    let failures: i32 = 0;
    let before: i64 = _zag_allocator_live_bytes();
    let body: []u8 = registry_body();
    let index: []u8 = package_registry_finalize(body);
    registry_expect(package_registry_index_valid(index) == 1,
        "canonical local index validates", &failures);

    let latest: PackageRegistryLookup = package_registry_lookup(index, "alpha", "");
    registry_expect(latest.found == 1 && latest.error == PackageRegistryError.none &&
        @strEq(latest.version, "1.2.0") && @strEq(latest.source, "src/alpha-2.zag"),
        "unconstrained query chooses the highest deterministic version", &failures);

    let caret: PackageRegistryLookup = package_registry_lookup(index, "alpha", "^1.0.0");
    registry_expect(caret.found == 1 && @strEq(caret.version, "1.2.0"),
        "caret query selects the highest compatible version", &failures);
    let tilde: PackageRegistryLookup = package_registry_lookup(index, "alpha", "~1.0.0");
    registry_expect(tilde.found == 1 && @strEq(tilde.version, "1.0.0"),
        "tilde query stays inside the minor interval", &failures);
    let wildcard_major: PackageRegistryLookup = package_registry_lookup(index, "alpha", "1.*");
    registry_expect(wildcard_major.found == 1 && @strEq(wildcard_major.version, "1.2.0"),
        "major wildcard selects the highest matching version", &failures);
    let wildcard_minor: PackageRegistryLookup = package_registry_lookup(index, "alpha", "1.0.*");
    registry_expect(wildcard_minor.found == 1 && @strEq(wildcard_minor.version, "1.0.0"),
        "minor wildcard stays inside the patch interval", &failures);
    let wildcard_any: PackageRegistryLookup = package_registry_lookup(index, "alpha", "*");
    registry_expect(wildcard_any.found == 1 && @strEq(wildcard_any.version, "1.2.0"),
        "unbounded wildcard selects the highest deterministic version", &failures);
    let intersection: PackageRegistryLookup = package_registry_lookup_all(index,
        "alpha", "^1.0.0\n~1.2.0");
    registry_expect(intersection.found == 1 && @strEq(intersection.version, "1.2.0"),
        "multiple graph requirements select one highest common version", &failures);
    let conflict: PackageRegistryLookup = package_registry_lookup_all(index,
        "alpha", "^1.0.0\n^2.0.0");
    registry_expect(conflict.found == 0 &&
        conflict.error == PackageRegistryError.version_not_found,
        "incompatible graph requirements fail closed", &failures);
    let malformed_set: PackageRegistryLookup = package_registry_lookup_all(index,
        "alpha", "^1.0.0\n");
    registry_expect(malformed_set.found == 0 &&
        malformed_set.error == PackageRegistryError.invalid_query,
        "trailing requirement entries fail closed", &failures);
    let exact_missing: PackageRegistryLookup = package_registry_lookup(index, "alpha", "1.1.0");
    registry_expect(exact_missing.found == 0 &&
        exact_missing.error == PackageRegistryError.version_not_found,
        "known package with no compatible version fails closed", &failures);
    let unknown: PackageRegistryLookup = package_registry_lookup(index, "missing", "");
    registry_expect(unknown.found == 0 &&
        unknown.error == PackageRegistryError.package_not_found,
        "unknown package fails closed", &failures);
    let malformed_query: PackageRegistryLookup = package_registry_lookup(index, "alpha", "^1.2");
    registry_expect(malformed_query.found == 0 &&
        malformed_query.error == PackageRegistryError.invalid_query,
        "malformed version requirement fails closed", &failures);
    let malformed_wildcard: PackageRegistryLookup = package_registry_lookup(index, "alpha", "^1.*");
    registry_expect(malformed_wildcard.found == 0 &&
        malformed_wildcard.error == PackageRegistryError.invalid_query,
        "prefixed wildcard requirement fails closed", &failures);

    let appended: []u8 = _zag_str_concat(index, "forged");
    registry_expect(package_registry_index_valid(appended) == 0,
        "bytes appended after the checksum are rejected", &failures);
    _zag_str_free(appended);
    let no_signature: []u8 = "format=zag-registry-index-v1\nauthority=local-file-v1\nsignature=ed25519:claimed\n";
    let no_signature_full: []u8 = package_registry_finalize(no_signature);
    registry_expect(package_registry_index_valid(no_signature_full) == 0,
        "unverified signature labels are not accepted as authority", &failures);
    _zag_str_free(no_signature_full);

    let signed_body: []u8 = "format=zag-registry-index-v1\nauthority=local-file-v1\nsignature=ed25519\nentry=alpha\t1.0.0\tsrc/alpha-1.zag\t1,2,3\n";
    let signed_index: []u8 = package_registry_finalize(signed_body);
    registry_expect(package_registry_signed_index_shape_valid(signed_index) == 1,
        "signed index shape validates independently of detached signature", &failures);
    let signed_mutation: []u8 = _zag_str_concat(signed_index, "x");
    registry_expect(package_registry_signed_index_shape_valid(signed_mutation) == 0,
        "signed index mutation is rejected before cryptographic verification", &failures);
    _zag_str_free(signed_mutation);
    _zag_str_free(signed_index);

    let reversed_body: []u8 = "format=zag-registry-index-v1\nauthority=local-file-v1\nsignature=none\nentry=alpha\t1.2.0\tsrc/alpha-2.zag\t4,5,6\nentry=alpha\t1.0.0\tsrc/alpha-1.zag\t1,2,3\n";
    let reversed: []u8 = package_registry_finalize(reversed_body);
    registry_expect(package_registry_index_valid(reversed) == 0,
        "noncanonical entry order is rejected", &failures);
    _zag_str_free(reversed);

    _zag_str_free(index);
    registry_expect(_zag_allocator_live_bytes() == before,
        "index finalization and borrowed lookup restore allocator baseline", &failures);
    if (failures == 0) { _zag_println("package registry protocol: 20/20"); }
    return failures;
}
