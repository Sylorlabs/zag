// Checked interpolation adapter. All payloads live in the Script arena.
@import("script_format.zag")
struct ScriptInterpolationBuilder { data:*u8, len:i32 }

fn script_interpolation_fail() void {
    _zag_eprintln("Zag Script interpolation: allocation or output limit exceeded");
    _zag_exit(1);
}
fn script_format_string_checked(context:*opaque,value:[]u8)[]u8{
    if(value.len<0||value.len>65536||(value.len>0&&_zag_slice_ptr(value)==null as *i8)){script_interpolation_fail();}
    let result:ScriptFormatResult=script_format_string(context,value);
    if(result.error!=ScriptFormatError.none){script_interpolation_fail();}
    return result.bytes;
}
fn script_format_bool_checked(context:*opaque,value:bool)[]u8{
    let result:ScriptFormatResult=script_format_bool(context,value);
    if(result.error!=ScriptFormatError.none){script_interpolation_fail();}
    return result.bytes;
}
fn script_format_i64_checked(context:*opaque,value:i64)[]u8{
    let result:ScriptFormatResult=script_format_i64(context,value);
    if(result.error!=ScriptFormatError.none){script_interpolation_fail();}
    return result.bytes;
}
fn script_interpolation_new(context:*opaque)ScriptInterpolationBuilder{
    let data:*u8=_zag_script_alloc(context,65536) as *u8;
    if(data==null as *u8){script_interpolation_fail();}
    return ScriptInterpolationBuilder{.data=data,.len=0};
}
fn script_interpolation_append(builder:ScriptInterpolationBuilder,value:[]u8)ScriptInterpolationBuilder{
    if(builder.data==null as *u8||builder.len<0||builder.len>65536||
       value.len<0||value.len>65536-builder.len){script_interpolation_fail();}
    let i:i32=0;while(i<value.len){builder.data[builder.len+i]=value[i];i=i+1;}
    builder.len=builder.len+value.len;return builder;
}
fn script_interpolation_finish(builder:ScriptInterpolationBuilder)[]u8{
    if(builder.data==null as *u8||builder.len<0||builder.len>65536){script_interpolation_fail();}
    return builder.data[0..builder.len];
}
