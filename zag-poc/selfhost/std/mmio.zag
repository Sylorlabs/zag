// Bounded MMIO-region helper for edition-2027 native code.  Creating a region
// is still an unsafe authority decision: this module cannot prove that an
// address names a real device or that the caller owns the bus.  Once created,
// exact-width accesses reject negative and out-of-range offsets before they
// issue one volatile transaction.

struct MmioRegion { base: *mut u8, len: i64 }

fn mmio_region(base: *mut u8, len: i64) !MmioRegion {
    if (len < 0) { return error.OutOfRange; }
    return MmioRegion{ .base = base, .len = len };
}

fn mmio_read8(region: MmioRegion, offset: i64) !u8 {
    if (offset < 0 || offset >= region.len) { return error.OutOfRange; }
    unsafe {
        let ptr: *mut u8 = region.base + offset;
        return @volatileLoad8(ptr);
    }
}

fn mmio_write8(region: MmioRegion, offset: i64, value: u8) !void {
    if (offset < 0 || offset >= region.len) { return error.OutOfRange; }
    unsafe {
        let ptr: *mut u8 = region.base + offset;
        @volatileStore8(ptr, value);
    }
    return;
}
