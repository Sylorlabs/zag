// Edition boundary: validated in edition 2026. Edition 2027 currently rejects
// ordinary std:json ownership/resource flows; no checker exemption is intended.
// Typed convenience over ordinary std/json; no dynamic values or new parser.
// OWNERSHIP: parse returns one ordinary JsonDocument owner. Do not copy/free
// aliases. Free it with script_json_document_free, even after failure (safe).
// Cursors are indexes into THAT document; strings borrow it until free. Never
// use a cursor with another document or retain a borrowed string past free.
// Document pointer arguments must be non-null and refer to facade parse results.
// Parsing and ordinary encoding allocate outside the ScriptContext budget.
// Limits bound syntax/input/output, not total allocated bytes or process RSS.
// Context encoding uses an ordinary temporary, copies once into the context,
// then frees the temporary on success AND budget failure. Only the final copy
// (plus policy overhead) is charged. Its bytes last until context shutdown.
@import("std:json") as json

struct ScriptJsonCursor { status: i32, index: i32 }
struct ScriptJsonString { status: i32, value: []u8 }
struct ScriptJsonInt { status: i32, value: i64 }
struct ScriptJsonFloat { status: i32, value: f64 }
struct ScriptJsonBool { status: i32, value: bool }

fn script_json_ok() i32 { return 1; }
fn script_json_missing() i32 { return 2; }
fn script_json_null() i32 { return 3; }
fn script_json_wrong_type() i32 { return 4; }
fn script_json_invalid() i32 { return 5; }
fn script_json_number_range() i32 { return 6; }

// Failure cleanup happens here, including partial nested parse allocations.
fn script_json_parse_bounded(src: []u8, max_depth: i32, max_bytes: i32,
    max_values: i32) json.JsonDocument {
    if (src.len < 0 || (src.len > 0 && _zag_slice_ptr(src) == null as *i8)) {
        let invalid: json.JsonDocument = json.json_document_empty();
        script_json_document_free(&invalid);
        return invalid;
    }
    let doc: json.JsonDocument = json.json_parse_value_bounded(src,
        max_depth, max_bytes, max_values);
    if (doc.ok == 0) { script_json_document_free(&doc); }
    return doc;
}

fn script_json_parse(src: []u8) json.JsonDocument {
    return script_json_parse_bounded(src, json.json_default_max_depth(),
        json.json_default_max_bytes(), json.json_default_max_values());
}

fn script_json_document_free(doc: *json.JsonDocument) void {
    json.json_document_free(doc);
    // Ordinary list.free releases storage but does not clear its descriptor.
    // Clear every owner so failed parses and repeated facade cleanup are safe.
    doc.*.nodes.data = null as *json.JsonValue;
    doc.*.nodes.len = 0; doc.*.nodes.cap = 0;
    doc.*.children.data = null as *i32;
    doc.*.children.len = 0; doc.*.children.cap = 0;
    doc.*.edge_keys.data = null as *[]u8;
    doc.*.edge_keys.len = 0; doc.*.edge_keys.cap = 0;
    doc.*.owned_text.data = null as *[]u8;
    doc.*.owned_text.len = 0; doc.*.owned_text.cap = 0;
}

fn script_json_cursor(doc: *json.JsonDocument, index: i32) ScriptJsonCursor {
    if (doc.*.ok != 1 || index < 0 || index >= doc.*.nodes.len) {
        return ScriptJsonCursor{ .status = script_json_invalid(), .index = -1 };
    }
    let status: i32 = script_json_ok();
    if (json.json_value_at(doc.*, index).kind == json.json_kind_null()) {
        status = script_json_null();
    }
    return ScriptJsonCursor{ .status = status, .index = index };
}

fn script_json_root(doc: *json.JsonDocument) ScriptJsonCursor {
    return script_json_cursor(doc, json.json_document_root(doc.*));
}

// Failure propagation makes nested calls preserve missing/null/type errors.
fn script_json_get(doc: *json.JsonDocument, parent: ScriptJsonCursor,
    key: []u8) ScriptJsonCursor {
    if (parent.status != script_json_ok()) { return parent; }
    let checked: ScriptJsonCursor = script_json_cursor(doc, parent.index);
    if (checked.status != script_json_ok()) { return checked; }
    if (json.json_value_at(doc.*, parent.index).kind != json.json_kind_object()) {
        return ScriptJsonCursor{ .status = script_json_wrong_type(), .index = -1 };
    }
    let index: i32 = json.json_object_find(doc.*, parent.index, key);
    if (index < 0) { return ScriptJsonCursor{ .status = script_json_missing(), .index = -1 }; }
    return script_json_cursor(doc, index);
}

fn script_json_at(doc: *json.JsonDocument, parent: ScriptJsonCursor,
    offset: i32) ScriptJsonCursor {
    if (parent.status != script_json_ok()) { return parent; }
    let checked: ScriptJsonCursor = script_json_cursor(doc, parent.index);
    if (checked.status != script_json_ok()) { return checked; }
    if (json.json_value_at(doc.*, parent.index).kind != json.json_kind_array()) {
        return ScriptJsonCursor{ .status = script_json_wrong_type(), .index = -1 };
    }
    let index: i32 = json.json_value_child(doc.*, parent.index, offset);
    if (index < 0) { return ScriptJsonCursor{ .status = script_json_missing(), .index = -1 }; }
    return script_json_cursor(doc, index);
}

fn script_json_expect(doc: *json.JsonDocument, cursor: ScriptJsonCursor,
    kind: i32) i32 {
    if (cursor.status != script_json_ok()) { return cursor.status; }
    let checked: ScriptJsonCursor = script_json_cursor(doc, cursor.index);
    if (checked.status != script_json_ok()) { return checked.status; }
    if (json.json_value_at(doc.*, cursor.index).kind != kind) { return script_json_wrong_type(); }
    return script_json_ok();
}

fn script_json_string(doc: *json.JsonDocument, cursor: ScriptJsonCursor) ScriptJsonString {
    let status: i32 = script_json_expect(doc, cursor, json.json_kind_string());
    if (status != script_json_ok()) { return ScriptJsonString{ .status = status, .value = "" }; }
    return ScriptJsonString{ .status = status, .value = json.json_value_at(doc.*, cursor.index).text };
}

fn script_json_int(doc: *json.JsonDocument, cursor: ScriptJsonCursor) ScriptJsonInt {
    let status: i32 = script_json_expect(doc, cursor, json.json_kind_number());
    if (status != script_json_ok()) { return ScriptJsonInt{ .status = status, .value = 0 }; }
    let result: json.JsonIntResult = json.json_parse_int(json.json_value_at(doc.*, cursor.index).text);
    if (result.ok == 0) { status = script_json_number_range(); }
    return ScriptJsonInt{ .status = status, .value = result.value };
}

// Float conversion follows ordinary JSON rounding and exponent behavior; it
// is not an exact decimal conversion or an additional finite-number guarantee.
fn script_json_float(doc: *json.JsonDocument, cursor: ScriptJsonCursor) ScriptJsonFloat {
    let status: i32 = script_json_expect(doc, cursor, json.json_kind_number());
    if (status != script_json_ok()) { return ScriptJsonFloat{ .status = status, .value = 0.0 }; }
    let result: json.JsonFloatResult = json.json_parse_float(json.json_value_at(doc.*, cursor.index).text);
    if (result.ok == 0) { status = script_json_number_range(); }
    return ScriptJsonFloat{ .status = status, .value = result.value };
}

fn script_json_bool(doc: *json.JsonDocument, cursor: ScriptJsonCursor) ScriptJsonBool {
    let status: i32 = script_json_expect(doc, cursor, json.json_kind_bool());
    if (status != script_json_ok()) { return ScriptJsonBool{ .status = status, .value = false }; }
    return ScriptJsonBool{ .status = status, .value = json.json_value_at(doc.*, cursor.index).boolean != 0 };
}

fn script_json_length(doc: *json.JsonDocument, cursor: ScriptJsonCursor) ScriptJsonInt {
    if (cursor.status != script_json_ok()) { return ScriptJsonInt{ .status = cursor.status, .value = 0 }; }
    let checked: ScriptJsonCursor = script_json_cursor(doc, cursor.index);
    if (checked.status != script_json_ok()) { return ScriptJsonInt{ .status = checked.status, .value = 0 }; }
    let value: json.JsonValue = json.json_value_at(doc.*, cursor.index);
    if (value.kind != json.json_kind_array() && value.kind != json.json_kind_object()) {
        return ScriptJsonInt{ .status = script_json_wrong_type(), .value = 0 };
    }
    return ScriptJsonInt{ .status = script_json_ok(), .value = value.child_count as i64 };
}

// Ordinary owned output; release with script_json_encoded_free.
fn script_json_encode_bounded(doc: *json.JsonDocument, cursor: ScriptJsonCursor,
    max_depth: i32, max_bytes: i32) json.JsonEncodeResult {
    if (cursor.status != script_json_ok() && cursor.status != script_json_null()) {
        return json.JsonEncodeResult{ .ok = 0, .value = "" };
    }
    return json.json_stringify_value_bounded(doc.*, cursor.index, max_depth, max_bytes);
}

fn script_json_encode(doc: *json.JsonDocument) json.JsonEncodeResult {
    return script_json_encode_bounded(doc, script_json_root(doc),
        json.json_default_max_depth(), json.json_default_max_output_bytes());
}

fn script_json_encoded_free(result: *json.JsonEncodeResult) void {
    json.json_encode_result_free(result);
}

fn script_json_encode_context_bounded(context: *i8, doc: *json.JsonDocument,
    cursor: ScriptJsonCursor, max_depth: i32, max_bytes: i32) json.JsonEncodeResult {
    if (context == null as *i8) { return json.JsonEncodeResult{ .ok = 0, .value = "" }; }
    let encoded: json.JsonEncodeResult = script_json_encode_bounded(doc, cursor, max_depth, max_bytes);
    if (encoded.ok == 0) { return encoded; }
    let data: *u8 = _zag_script_alloc(context, encoded.value.len as i64) as *u8;
    if (data == null as *u8) {
        script_json_encoded_free(&encoded);
        return json.JsonEncodeResult{ .ok = 0, .value = "" };
    }
    let count: i32 = encoded.value.len;
    let i: i32 = 0;
    while (i < count) { data[i] = encoded.value[i]; i = i + 1; }
    script_json_encoded_free(&encoded);
    return json.JsonEncodeResult{ .ok = 1, .value = data[0..count] };
}

fn script_json_encode_context(context: *i8, doc: *json.JsonDocument) json.JsonEncodeResult {
    return script_json_encode_context_bounded(context, doc, script_json_root(doc),
        json.json_default_max_depth(), json.json_default_max_output_bytes());
}

// Object iteration preserves ordinary JSON order and duplicate-key semantics
// (get returns the first matching key). The returned key borrows the document.
fn script_json_member_key(doc: *json.JsonDocument, cursor: ScriptJsonCursor,
    member: i32) ScriptJsonString {
    let status: i32 = script_json_expect(doc, cursor, json.json_kind_object());
    if (status != script_json_ok()) { return ScriptJsonString{ .status = status, .value = "" }; }
    let count: i32 = json.json_value_at(doc.*, cursor.index).child_count;
    if (member < 0 || member >= count) {
        return ScriptJsonString{ .status = script_json_missing(), .value = "" };
    }
    return ScriptJsonString{ .status = script_json_ok(),
        .value = json.json_value_object_key(doc.*, cursor.index, member) };
}
