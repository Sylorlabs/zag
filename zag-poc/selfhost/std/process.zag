// selfhost/std/process.zag — process services for the native Zag runtime.
//
// These wrappers use runtime primitives emitted by Zag's native backend. They
// do not link libc. `process_run_shell` intentionally invokes /bin/sh and
// returns its exit status; use it only when shell interpretation is wanted.

// Opaque stable ABI for the future bounded supervisor. Module-prefixing may
// rename ProcessResult, but cannot change the compiler-owned handle layout.
struct ProcessResult { handle: *opaque }

fn process_state_exited() i32 { return 0; }
fn process_state_timed_out() i32 { return 1; }
fn process_state_output_limit() i32 { return 2; }
fn process_state_runtime_error() i32 { return 3; }

fn process_result_status(result: ProcessResult) i32 {
    return _zag_process_result_status(result.handle);
}

fn process_result_state(result: ProcessResult) i32 {
    return _zag_process_result_state(result.handle);
}

fn process_result_output(result: ProcessResult) []u8 {
    return _zag_process_result_output(result.handle);
}

fn process_arg_count() i32 {
    return _zag_argc();
}

fn process_arg(index: i32) []u8 {
    return _zag_arg(index);
}

fn process_run_shell(command: []u8) i32 {
    return _zag_exec_cmd(command);
}

fn process_exit(code: i32) void {
    _zag_exit(code);
}
