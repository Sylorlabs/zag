// Statically typed formatting primitives for Script interpolation. Each result
// owns context-backed bytes until Script shutdown, like script_string_concat.
// Payload allocation is exact (no terminator); allocator policy overhead is
// charged by _zag_script_alloc. Check error before using bytes; an empty
// successful string is distinct from allocation failure.

enum ScriptFormatError {
    none,
    invalid_slice,
    allocation_failed,
}

struct ScriptFormatResult {
    bytes: []u8,
    error: ScriptFormatError,
}

fn script_format_string(context: *opaque, value: []u8) ScriptFormatResult {
    if (value.len < 0) {
        return ScriptFormatResult{ .bytes = (null as *u8)[0..0],
            .error = ScriptFormatError.invalid_slice };
    }
    let data: *u8 = _zag_script_alloc(context, value.len as i64) as *u8;
    if (data == null as *u8) {
        return ScriptFormatResult{ .bytes = data[0..0],
            .error = ScriptFormatError.allocation_failed };
    }
    let i: i32 = 0;
    while (i < value.len) { data[i] = value[i]; i = i + 1; }
    return ScriptFormatResult{ .bytes = data[0..value.len], .error = ScriptFormatError.none };
}

fn script_format_bool(context: *opaque, value: bool) ScriptFormatResult {
    if (value) { return script_format_string(context, "true"); }
    return script_format_string(context, "false");
}

// i32 and smaller signed integers can be widened to this typed entry point.
// Count and emit in the negative domain: -i64_min cannot be represented, but
// its negative remainders are always in [-9, 0]. No temporary allocation or
// allocating integer-to-string intrinsic is used. Output is at most 20 bytes.
fn script_format_i64(context: *opaque, value: i64) ScriptFormatResult {
    let negative: bool = value < 0;
    let remaining: i64 = value;
    if (remaining > 0) { remaining = 0 - remaining; }
    let count: i32 = 1;
    let probe: i64 = remaining;
    while (probe <= -10) { count = count + 1; probe = probe / 10; }
    if (negative) { count = count + 1; }
    let data: *u8 = _zag_script_alloc(context, count as i64) as *u8;
    if (data == null as *u8) {
        return ScriptFormatResult{ .bytes = data[0..0],
            .error = ScriptFormatError.allocation_failed };
    }
    let index: i32 = count;
    while (index > 0) {
        index = index - 1;
        data[index] = (48 - (remaining % 10)) as u8;
        remaining = remaining / 10;
        if (remaining == 0) { break; }
    }
    if (negative) { data[0] = 45; }
    return ScriptFormatResult{ .bytes = data[0..count], .error = ScriptFormatError.none };
}
