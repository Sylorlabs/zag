// Root-only, statically typed Zag Script path conveniences. These are lexical
// helpers: they do not access the filesystem, resolve symlinks, or normalize
// parent components. path_join returns Script-lifetime charged storage; the
// other helpers return slices of their input.

fn script_path_join(context:*opaque,left:[]u8,right:[]u8)[]u8 {
    let separator:i32=1;
    if(left.len==0||right.len==0||left[left.len-1]=='/'||right[0]=='/'){separator=0;}
    let total:i32=left.len+separator+right.len;
    let raw:*i8=_zag_script_alloc(context,total as i64);
    if(raw==null as *i8){_zag_eprintln("Zag Script memory limit exceeded by path_join");return (null as *i8)[0..0];}
    let i:i32=0;while(i<left.len){raw[i]=left[i];i=i+1;}
    if(separator==1){raw[i]='/';i=i+1;}
    let j:i32=0;while(j<right.len){raw[i+j]=right[j];j=j+1;}
    return raw[0..total];
}
fn script_path_basename(_context:*opaque,path:[]u8)[]u8 {
    let end:i32=path.len;while(end>1&&path[end-1]=='/'){end=end-1;}
    let start:i32=end;while(start>0&&path[start-1]!='/'){start=start-1;}
    return path[start..end];
}
fn script_path_dirname(_context:*opaque,path:[]u8)[]u8 {
    let end:i32=path.len;while(end>1&&path[end-1]=='/'){end=end-1;}
    let slash:i32=end-1;while(slash>=0&&path[slash]!='/'){slash=slash-1;}
    if(slash<0){return ".";}if(slash==0){return "/";}return path[0..slash];
}
fn script_path_extension(_context:*opaque,path:[]u8)[]u8 {
    let base:[]u8=script_path_basename(_context,path);let dot:i32=base.len;
    while(dot>0&&base[dot-1]!='.'){dot=dot-1;}
    if(dot<=1||dot>=base.len){return "";}return base[dot-1..base.len];
}
