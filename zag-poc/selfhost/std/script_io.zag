// Root-only Zag Script file convenience. The native reader may use temporary
// staging storage, but the value returned to Script is copied into and charged
// against the ScriptContext budget. Strict Zag continues to call
// `_zag_read_file` directly and is unaffected.

fn script_read_file(context: *opaque, path: []u8) []u8 {
    let staged: []u8 = _zag_read_file(path);
    if (staged.len < 0) { return staged; }
    let raw: *i8 = _zag_script_alloc(context, staged.len as i64);
    if (raw == null as *i8) {
        _zag_eprintln("Zag Script memory limit exceeded by read_file result");
        return (null as *i8)[0..0];
    }
    let i: i32 = 0;
    while (i < staged.len) {
        raw[i] = staged[i];
        i = i + 1;
    }
    return raw[0..staged.len];
}
