// Edition boundary: validated in edition 2026. Edition 2027 currently rejects
// ordinary std:json ownership/resource flows; no checker exemption is intended.
// JSON string encoding for an explicit native ScriptContext handle (*i8 keeps
// this ordinary-JSON module usable from edition 2026 callers). Success
// makes exactly one _zag_script_alloc call for the exact quoted payload (no
// terminator). Bytes belong to the context until shutdown; do not free them.
// max_bytes includes quotes and escapes, but excludes allocator policy overhead.
// Invalid input/bounds fail before allocation; budget failure returns ok = 0.
// As with ordinary JSON, callers must inspect ok, not the value's length.
@import("std:json") as json

fn script_json_stringify_string_bounded(context: *i8, value: []u8,
    max_bytes: i32) json.JsonEncodeResult {
    if (context == null as *i8 || max_bytes < 2 || value.len < 0) {
        return json.JsonEncodeResult{ .ok = 0, .value = "" };
    }
    // Also bounds the ordinary UTF-8 validator's lookahead arithmetic.
    if (value.len > max_bytes - 2) {
        return json.JsonEncodeResult{ .ok = 0, .value = "" };
    }
    if (value.len > 0 && _zag_slice_ptr(value) == null as *i8) {
        return json.JsonEncodeResult{ .ok = 0, .value = "" };
    }
    if (json.json_utf8_valid(value) == 0) {
        return json.JsonEncodeResult{ .ok = 0, .value = "" };
    }
    let count: i64 = 2;
    let i: i32 = 0;
    while (i < value.len) {
        let c: u8 = value[i];
        if (c == 34 || c == 92 || c == 8 || c == 12 || c == 10 || c == 13 || c == 9) {
            count = count + 2;
        } else if (c < 32) { count = count + 6; }
        else { count = count + 1; }
        if (count > max_bytes as i64) {
            return json.JsonEncodeResult{ .ok = 0, .value = "" };
        }
        i = i + 1;
    }
    let data: *u8 = _zag_script_alloc(context, count) as *u8;
    if (data == null as *u8) {
        return json.JsonEncodeResult{ .ok = 0, .value = "" };
    }
    data[0] = 34;
    let pos: i32 = 1;
    i = 0;
    while (i < value.len) {
        let c: u8 = value[i];
        if (c == 34 || c == 92) {
            data[pos] = 92; data[pos + 1] = c; pos = pos + 2;
        } else if (c == 8 || c == 12 || c == 10 || c == 13 || c == 9) {
            let escaped: u8 = 116;
            if (c == 8) { escaped = 98; }
            else if (c == 12) { escaped = 102; }
            else if (c == 10) { escaped = 110; }
            else if (c == 13) { escaped = 114; }
            data[pos] = 92; data[pos + 1] = escaped; pos = pos + 2;
        } else if (c < 32) {
            data[pos] = 92; data[pos + 1] = 117;
            data[pos + 2] = 48; data[pos + 3] = 48;
            data[pos + 4] = json.json_hex_digit((c as i32) / 16);
            data[pos + 5] = json.json_hex_digit((c as i32) % 16);
            pos = pos + 6;
        } else { data[pos] = c; pos = pos + 1; }
        i = i + 1;
    }
    data[pos] = 34;
    return json.JsonEncodeResult{ .ok = 1, .value = data[0..count as i32] };
}

fn script_json_stringify_string(context: *i8, value: []u8) json.JsonEncodeResult {
    return script_json_stringify_string_bounded(context, value,
        json.json_default_max_output_bytes());
}
