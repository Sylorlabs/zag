// Compiler-owned Script JSON byte bridge.
//
// The public Script surface is deliberately raw-bytes only: parse and encode
// happen inside this helper, native JsonDocument/JsonEncodeResult temporaries
// are released on every path, and only the final bytes are retained by the
// generated ScriptContext. Strict callers continue to use std:json directly.

@import("std:json") as json
@import("std:script_list")
@import("std:script_map")

fn script_json_int_array_failed(context: *opaque) ScriptList[i64] {
    return ScriptList[i64]{ .data = null as *i64, .len = 0, .cap = 0,
        .context = context, .failed = 1 };
}

fn script_json_string_map_failed(context: *opaque) ScriptMapText {
    return ScriptMapText{.keys = null as *[]u8, .values = null as *[]u8,
        .used = null as *u8, .cap = 0, .count = 0, .tombstones = 0,
        .context = context, .failed = 1};
}

fn script_json_normalize(context: *opaque, source: []u8) []u8 {
    let document: json.JsonDocument = json.json_parse_value_bounded(source,
        json.json_default_max_depth(), json.json_default_max_bytes(),
        json.json_default_max_values());
    if (document.ok == 0) {
        json.json_document_free(&document);
        return (null as *u8)[0..0];
    }
    let encoded: json.JsonEncodeResult = json.json_stringify_value_bounded(
        document, document.root, json.json_default_max_depth(),
        json.json_default_max_output_bytes());
    if (encoded.ok == 0) {
        json.json_encode_result_free(&encoded);
        json.json_document_free(&document);
        return (null as *u8)[0..0];
    }
    let output_len: i32 = encoded.value.len;
    let size: i64 = output_len as i64;
    let data: *u8 = _zag_script_alloc(context, size) as *u8;
    if (data == null as *u8) {
        json.json_encode_result_free(&encoded);
        json.json_document_free(&document);
        _zag_eprintln("Zag Script JSON output allocation failed");
        _zag_exit(1);
    }
    let i: i32 = 0;
    while (i < output_len) {
        data[i] = encoded.value[i];
        i = i + 1;
    }
    json.json_encode_result_free(&encoded);
    json.json_document_free(&document);
    return data[0..output_len];
}

// Parse one homogeneous JSON integer array into Script-owned storage. The
// strict codec keeps its native temporary until every validation step is done;
// only a successful, bounded result is copied into ScriptContext. Malformed,
// over-limit, and allocation-failure paths return a failed descriptor and
// never expose native storage to the Script caller.
fn script_json_int_array(context: *opaque, source: []u8) ScriptList[i64] {
    let parsed: json.JsonIntArrayResult = json.json_parse_int_array_bounded(
        source, json.json_default_max_bytes(), json.json_default_max_values());
    if (parsed.ok == 0) {
        json.json_int_array_result_free(&parsed);
        return script_json_int_array_failed(context);
    }
    let result: ScriptList[i64] = script_list_new[i64](context, parsed.values.len);
    if (result.failed != 0) {
        json.json_int_array_result_free(&parsed);
        return result;
    }
    let i: i32 = 0;
    while (i < parsed.values.len) {
        if (script_list_append[i64](&result, parsed.values.data[i]) != 0) {
            json.json_int_array_result_free(&parsed);
            return result;
        }
        i = i + 1;
    }
    json.json_int_array_result_free(&parsed);
    return result;
}

fn script_json_bool_array_failed(context: *opaque) ScriptList[bool] {
    return ScriptList[bool]{ .data = null as *bool, .len = 0, .cap = 0,
        .context = context, .failed = 1 };
}

// Parse a bounded homogeneous JSON boolean array and copy it into
// ScriptContext-owned storage.  The strict parser's temporary is released on
// success, malformed input, and every failed copy path.
fn script_json_bool_array(context: *opaque, source: []u8) ScriptList[bool] {
    let parsed: json.JsonBoolArrayResult = json.json_parse_bool_array_bounded(
        source, json.json_default_max_bytes(), json.json_default_max_values());
    if (parsed.ok == 0) {
        json.json_bool_array_result_free(&parsed);
        return script_json_bool_array_failed(context);
    }
    let result: ScriptList[bool] = script_list_new[bool](context, parsed.values.len);
    if (result.failed != 0) {
        json.json_bool_array_result_free(&parsed);
        return result;
    }
    let i: i32 = 0;
    while (i < parsed.values.len) {
        if (script_list_append[bool](&result, parsed.values.data[i]) != 0) {
            json.json_bool_array_result_free(&parsed);
            return result;
        }
        i = i + 1;
    }
    json.json_bool_array_result_free(&parsed);
    return result;
}

fn script_json_float_array_failed(context: *opaque) ScriptList[f64] {
    return ScriptList[f64]{ .data = null as *f64, .len = 0, .cap = 0,
        .context = context, .failed = 1 };
}

// Parse a bounded homogeneous JSON floating-point array and copy it into
// ScriptContext-owned storage. The strict native list is released on success,
// malformed input, and every Script allocation/append failure; no ordinary
// heap pointer is exposed to the Script caller.
fn script_json_float_array(context: *opaque, source: []u8) ScriptList[f64] {
    let parsed: json.JsonFloatArrayResult = json.json_parse_float_array_bounded(
        source, json.json_default_max_bytes(), json.json_default_max_values());
    if (parsed.ok == 0) {
        json.json_float_array_result_free(&parsed);
        return script_json_float_array_failed(context);
    }
    let result: ScriptList[f64] = script_list_new[f64](context, parsed.values.len);
    if (result.failed != 0) {
        json.json_float_array_result_free(&parsed);
        return result;
    }
    let i: i32 = 0;
    while (i < parsed.values.len) {
        if (script_list_append[f64](&result, parsed.values.data[i]) != 0) {
            json.json_float_array_result_free(&parsed);
            return result;
        }
        i = i + 1;
    }
    json.json_float_array_result_free(&parsed);
    return result;
}

fn script_json_string_array_failed(context: *opaque) ScriptList[[]u8] {
    return ScriptList[[]u8]{.data = null as *[]u8, .len = 0, .cap = 0,
        .context = context, .failed = 1};
}

fn script_json_copy_text(context: *opaque, source: []u8) []u8 {
    if (source.len < 0) { return (null as *u8)[0..0]; }
    if (source.len == 0) { return ""; }
    let data: *u8 = _zag_script_alloc(context, source.len as i64) as *u8;
    if (data == null as *u8) { return (null as *u8)[0..0]; }
    let i: i32 = 0;
    while (i < source.len) { data[i] = source[i]; i = i + 1; }
    return data[0..source.len];
}

// Parse a bounded homogeneous JSON string array. Native decoded strings are
// copied into ScriptContext-owned list storage before the temporary result is
// released; malformed input and any Script allocation failure return a failed
// descriptor without exposing ordinary-heap pointers.
fn script_json_string_array(context: *opaque, source: []u8)
    ScriptList[[]u8] {
    let parsed: json.JsonStringArrayResult =
        json.json_parse_string_array_bounded(source,
            json.json_default_max_bytes(), json.json_default_max_values());
    if (parsed.ok == 0) {
        json.json_string_array_result_free(&parsed);
        return script_json_string_array_failed(context);
    }
    let result: ScriptList[[]u8] =
        script_list_new[[]u8](context, parsed.values.len);
    if (result.failed != 0) {
        json.json_string_array_result_free(&parsed);
        return result;
    }
    let i: i32 = 0;
    while (i < parsed.values.len) {
        let text: []u8 = script_json_copy_text(context,
            parsed.values.data[i]);
        if (parsed.values.data[i].len > 0 && text.len == 0) {
            result.failed = 1;
            json.json_string_array_result_free(&parsed);
            return result;
        }
        if (script_list_append[[]u8](&result, text) != 0) {
            json.json_string_array_result_free(&parsed);
            return result;
        }
        i = i + 1;
    }
    json.json_string_array_result_free(&parsed);
    return result;
}

// Encode a validated Script-owned integer list back to bounded JSON bytes.
// The output buffer is the only retained allocation; each temporary decimal
// spelling is released before the next element is visited. A forged,
// failed, cross-context, over-limit, or allocator-exhausted descriptor
// returns the same empty failure slice used by the other Script JSON bridges.
fn script_json_int_array_encode(context: *opaque,
    values: ScriptList[i64]) []u8 {
    let max_values: i32 = json.json_default_max_values();
    let max_output: i32 = json.json_default_max_output_bytes();
    if (!script_list_descriptor_valid[i64](values, context) ||
        values.len > max_values ||
        max_output < 2 || values.len > (max_output - 2) / 22) {
        return (null as *u8)[0..0];
    }
    let capacity: i64 = 2 + (values.len as i64) * 22;
    let data: *u8 = _zag_script_alloc(context, capacity) as *u8;
    if (data == null as *u8) { return (null as *u8)[0..0]; }
    let at: i32 = 0;
    data[at] = '['; at = at + 1;
    let i: i32 = 0;
    while (i < values.len) {
        if (i > 0) { data[at] = ','; at = at + 1; }
        let encoded: []u8 = _zag_i64_to_str(values.data[i]);
        if (encoded.len <= 0 || at + encoded.len >= capacity) {
            if (encoded.len > 0) { _zag_free(_zag_slice_ptr(encoded)); }
            return (null as *u8)[0..0];
        }
        let j: i32 = 0;
        while (j < encoded.len) {
            data[at] = encoded[j]; at = at + 1; j = j + 1;
        }
        _zag_free(_zag_slice_ptr(encoded));
        i = i + 1;
    }
    data[at] = ']'; at = at + 1;
    return data[0..at];
}

// Encode a validated Script-owned boolean list as a bounded JSON array.  The
// spelling is deterministic (`true`/`false`, no surrounding whitespace) and
// the output buffer is the only retained allocation.  The exact size is
// computed before allocation so an output-limit or Script-budget failure
// cannot leave a partial result behind.
fn script_json_bool_array_encode(context: *opaque,
    values: ScriptList[bool]) []u8 {
    let max_values: i32 = json.json_default_max_values();
    let max_output: i32 = json.json_default_max_output_bytes();
    if (!script_list_descriptor_valid[bool](values, context) ||
        values.len > max_values || max_output < 2) {
        return (null as *u8)[0..0];
    }
    let capacity: i64 = 2;
    let i: i32 = 0;
    while (i < values.len) {
        let item_bytes: i64 = 4;
        if (values.data[i] == true) { item_bytes = 4; }
        else { item_bytes = 5; }
        if (capacity > (max_output as i64) - item_bytes -
            (i > 0) as i64) {
            return (null as *u8)[0..0];
        }
        capacity = capacity + item_bytes;
        if (i > 0) { capacity = capacity + 1; }
        i = i + 1;
    }
    let data: *u8 = _zag_script_alloc(context, capacity) as *u8;
    if (data == null as *u8) { return (null as *u8)[0..0]; }
    let at: i32 = 0;
    data[at] = '['; at = at + 1;
    i = 0;
    while (i < values.len) {
        if (i > 0) { data[at] = ','; at = at + 1; }
        if (values.data[i] == true) {
            data[at] = 't'; at = at + 1;
            data[at] = 'r'; at = at + 1;
            data[at] = 'u'; at = at + 1;
            data[at] = 'e'; at = at + 1;
        } else {
            data[at] = 'f'; at = at + 1;
            data[at] = 'a'; at = at + 1;
            data[at] = 'l'; at = at + 1;
            data[at] = 's'; at = at + 1;
            data[at] = 'e'; at = at + 1;
        }
        i = i + 1;
    }
    data[at] = ']'; at = at + 1;
    return data[0..at];
}

// Write a finite f64 using the bounded six-decimal Script spelling without
// allocating a temporary slice.  This is intentionally a narrow JSON
// encoder contract: values outside the exactly-convertible signed-i64 range,
// non-finite values, and values whose six-decimal spelling does not round-trip
// through the strict JSON parser are rejected by the caller.
fn script_json_float_spelling(slot: []u8, value: f64) []u8 {
    if (slot.len < 64 || value != value) { return slot[0..0]; }
    let max_exact: f64 = 9223372036854774784.0;
    if (value >= max_exact || value <= 0.0 - max_exact) {
        return slot[0..0];
    }
    let negative: i32 = (value < 0.0) as i32;
    let absolute: f64 = value;
    if (negative == 1) { absolute = 0.0 - value; }
    let whole: i64 = (@floatToInt(absolute) as i64);
    let fraction_value: f64 = (absolute - (whole as f64)) * 1000000.0 + 0.5;
    let fraction: i64 = (@floatToInt(fraction_value) as i64);
    let rounded_whole: i64 = whole;
    let rounded_fraction: i64 = fraction;
    if (fraction >= 1000000) {
        rounded_whole = whole + 1;
        rounded_fraction = 0;
    }
    let at: i32 = slot.len;
    let end: i32 = slot.len;
    if (rounded_fraction > 0) {
        // Write all six fractional digits before trimming trailing zeroes.
        // Keeping the leading zeroes is required for values such as 0.0325;
        // dropping them would produce the invalid JSON spelling `.325`.
        let frac_work: i64 = rounded_fraction;
        let digit_i: i32 = 0;
        while (digit_i < 6) {
            at = at - 1;
            slot[at] = ('0' as u8) + (frac_work % 10) as u8;
            frac_work = frac_work / 10;
            digit_i = digit_i + 1;
        }
        let frac_start: i32 = at;
        let frac_digits: i32 = 6;
        while (frac_digits > 0 && slot[frac_start + frac_digits - 1] == '0') {
            frac_digits = frac_digits - 1;
        }
        if (frac_digits > 0) {
            at = frac_start - 1;
            slot[at] = '.';
            end = frac_start + frac_digits;
        } else {
            at = frac_start;
            end = frac_start;
        }
    }
    let whole_work: i64 = rounded_whole;
    if (whole_work == 0) { at = at - 1; slot[at] = '0'; }
    else {
        while (whole_work > 0) {
            at = at - 1;
            slot[at] = ('0' as u8) + (whole_work % 10) as u8;
            whole_work = whole_work / 10;
        }
    }
    if (negative == 1) { at = at - 1; slot[at] = '-'; }
    // Compact the reversed write in-place.  The slot is caller-owned output
    // storage, so this does not create a hidden Script allocation per item.
    let length: i32 = end - at;
    let i: i32 = 0;
    while (i < length) { slot[i] = slot[at + i]; i = i + 1; }
    return slot[0..length];
}

// Validate the formatter's bounded six-decimal policy without allocating.
// This pass runs before the output buffer is reserved, so a lossy, non-finite,
// or out-of-range value cannot consume Script budget before the encoder fails.
fn script_json_float_value_valid(value: f64) i32 {
    if (value != value) { return 0; }
    let max_exact: f64 = 9223372036854774784.0;
    if (value >= max_exact || value <= 0.0 - max_exact) { return 0; }
    let negative: i32 = (value < 0.0) as i32;
    let absolute: f64 = value;
    if (negative == 1) { absolute = 0.0 - value; }
    let whole: i64 = (@floatToInt(absolute) as i64);
    let fraction_value: f64 = (absolute - (whole as f64)) * 1000000.0 + 0.5;
    let fraction: i64 = (@floatToInt(fraction_value) as i64);
    let rounded_whole: i64 = whole;
    let rounded_fraction: i64 = fraction;
    if (fraction >= 1000000) {
        rounded_whole = whole + 1;
        rounded_fraction = 0;
    }
    let reconstructed: f64 = (rounded_whole as f64) +
        (rounded_fraction as f64) / 1000000.0;
    if (negative == 1) { reconstructed = 0.0 - reconstructed; }
    // Decimal parsing and the inverse division can differ by a few ulps even
    // when they denote the same six-decimal value (notably 0.000001).  Keep a
    // tiny absolute tolerance for that representation noise while still
    // rejecting any materially lossy six-decimal rounding.
    let delta: f64 = reconstructed - value;
    if (delta < 0.0) { delta = 0.0 - delta; }
    return (delta <= 0.000000000001) as i32;
}

// Encode a bounded, round-trippable finite floating-point Script list.  The
// fixed 64-byte per-element staging slots make the allocation and all writes
// auditable before returning; only one ScriptContext buffer is retained.
fn script_json_float_array_encode(context: *opaque,
    values: ScriptList[f64]) []u8 {
    let max_values: i32 = json.json_default_max_values();
    let max_output: i32 = json.json_default_max_output_bytes();
    if (!script_list_descriptor_valid[f64](values, context) ||
        values.len > max_values || max_output < 2) {
        return (null as *u8)[0..0];
    }
    // Preflight every element before reserving the retained output buffer.
    // The formatter is intentionally conservative: values that cannot be
    // represented by its fixed six-decimal spelling are rejected rather than
    // silently changing the JSON payload.
    let valid_i: i32 = 0;
    while (valid_i < values.len) {
        if (script_json_float_value_valid(values.data[valid_i]) == 0) {
            return (null as *u8)[0..0];
        }
        valid_i = valid_i + 1;
    }
    let capacity64: i64 = 2 + (values.len as i64) * 65;
    if (capacity64 > max_output || capacity64 > 2147483647) {
        return (null as *u8)[0..0];
    }
    let data: *u8 = _zag_script_alloc(context, capacity64) as *u8;
    if (data == null as *u8) { return (null as *u8)[0..0]; }
    let i: i32 = 0;
    let at: i32 = 1;
    while (i < values.len) {
        let slot_start: i32 = 1 + i * 65;
        let slot: []u8 = data[slot_start..slot_start + 64];
        // `script_json_float_value_valid` and the fixed 64-byte slot establish
        // the formatter contract before allocation.  The writer below is
        // therefore intentionally infallible: it performs only bounded local
        // formatting/copying and cannot retain a buffer and then report a
        // recoverable validation failure.
        let spelling: []u8 = script_json_float_spelling(slot, values.data[i]);
        if (i > 0) { data[at] = ','; at = at + 1; }
        let j: i32 = 0;
        while (j < spelling.len) {
            data[at] = spelling[j]; at = at + 1; j = j + 1;
        }
        i = i + 1;
    }
    data[at] = ']'; at = at + 1;
    // capacity64 is 2 + 65*n while each element occupies at most 64 bytes
    // plus one separator, so this final write is within the reserved buffer.
    data[0] = '[';
    return data[0..at];
}

// Encode a Script-owned UTF-8 text list as a bounded JSON array.  The
// JsonEncodeResult for each element is native temporary storage and is freed
// before the next element; only the final byte slice remains Script-owned.
fn script_json_string_array_encode(context: *opaque,
    values: ScriptList[[]u8]) []u8 {
    let max_values: i32 = json.json_default_max_values();
    let max_output: i32 = json.json_default_max_output_bytes();
    if (!script_list_descriptor_valid[[]u8](values, context) ||
        values.len > max_values || max_output < 2) {
        return (null as *u8)[0..0];
    }
    let capacity: i64 = 2;
    let i: i32 = 0;
    while (i < values.len) {
        let value: []u8 = values.data[i];
        if (value.len < 0 || value.len > max_output ||
            (value.len > 0 && _zag_slice_ptr(value) == null as *i8) ||
            json.json_utf8_valid(value) == 0) {
            return (null as *u8)[0..0];
        }
        let raw: i64 = value.len as i64;
        if (capacity > (max_output as i64) - raw * 6 - 2) {
            return (null as *u8)[0..0];
        }
        capacity = capacity + raw * 6 + 2;
        if (i > 0) { capacity = capacity + 1; }
        i = i + 1;
    }
    let data: *u8 = _zag_script_alloc(context, capacity) as *u8;
    if (data == null as *u8) { return (null as *u8)[0..0]; }
    let at: i32 = 0;
    data[at] = '['; at = at + 1;
    i = 0;
    while (i < values.len) {
        if (i > 0) { data[at] = ','; at = at + 1; }
        let encoded: json.JsonEncodeResult =
            json.json_stringify_string_checked(values.data[i]);
        if (encoded.ok == 0) {
            json.json_encode_result_free(&encoded);
            return (null as *u8)[0..0];
        }
        let j: i32 = 0;
        while (j < encoded.value.len) {
            data[at] = encoded.value[j]; at = at + 1; j = j + 1;
        }
        json.json_encode_result_free(&encoded);
        i = i + 1;
    }
    data[at] = ']'; at = at + 1;
    return data[0..at];
}

// Parse a bounded JSON object whose keys and values are both strings into a
// Script-owned text map. The strict parser's native strings are copied into
// the map before the temporary result is released; malformed input and any
// ScriptContext allocation failure return a failed map descriptor.
fn script_json_string_map(context: *opaque, source: []u8) ScriptMapText {
    let parsed: json.JsonStringObjectResult =
        json.json_parse_string_object_bounded(source,
            json.json_default_max_bytes(), json.json_default_max_values());
    if (parsed.ok == 0) {
        json.json_string_object_result_free(&parsed);
        return script_json_string_map_failed(context);
    }
    let result: ScriptMapText = script_map_text_new(context);
    if (result.failed != 0) {
        json.json_string_object_result_free(&parsed);
        return result;
    }
    let i: i32 = 0;
    while (i < parsed.keys.len) {
        if (script_map_text_put(&result, parsed.keys.data[i],
            parsed.values.data[i]) != 0) {
            json.json_string_object_result_free(&parsed);
            return result;
        }
        i = i + 1;
    }
    json.json_string_object_result_free(&parsed);
    return result;
}

fn script_json_bytes_cmp(left: []u8, right: []u8) i32 {
    let n: i32 = left.len;
    if (right.len < n) { n = right.len; }
    let i: i32 = 0;
    while (i < n) {
        if (left[i] < right[i]) { return -1; }
        if (left[i] > right[i]) { return 1; }
        i = i + 1;
    }
    if (left.len < right.len) { return -1; }
    if (left.len > right.len) { return 1; }
    return 0;
}

// Validate the complete feasible ScriptMapText shape before the encoder asks
// ScriptContext for output storage.  Structural bounds alone are insufficient:
// a forged count/tombstone pair can otherwise make the encoder allocate and
// only then discover that the declared entries are absent.
fn script_json_string_map_descriptor_valid(map: ScriptMapText,
    context: *opaque) bool {
    if (map.context != context || map.failed != 0 || map.cap < 8 ||
        map.cap > 1048576 || map.count < 0 || map.count > map.cap ||
        map.tombstones < 0 || map.tombstones > map.cap - map.count ||
        (map.cap & (map.cap - 1)) != 0 ||
        map.keys == null as *[]u8 || map.values == null as *[]u8 ||
        map.used == null as *u8) {
        return false;
    }
    let max_output: i32 = json.json_default_max_output_bytes();
    let live: i32 = 0;
    let tombstones: i32 = 0;
    let slot: i32 = 0;
    while (slot < map.cap) {
        if (map.used[slot] == 1) {
            let key: []u8 = map.keys[slot];
            let value: []u8 = map.values[slot];
            if (key.len < 0 || value.len < 0 || key.len > max_output ||
                value.len > max_output ||
                (key.len > 0 && _zag_slice_ptr(key) == null as *i8) ||
                (value.len > 0 && _zag_slice_ptr(value) == null as *i8) ||
                json.json_utf8_valid(key) == 0 ||
                json.json_utf8_valid(value) == 0) {
                return false;
            }
            live = live + 1;
        } else if (map.used[slot] == 2) {
            tombstones = tombstones + 1;
        } else if (map.used[slot] != 0) {
            return false;
        }
        slot = slot + 1;
    }
    return live == map.count && tombstones == map.tombstones;
}

// Encode a Script-owned text map with canonical bytewise key ordering. The
// hash-table slot order is intentionally not part of the public result, so
// maps built through different insertion/deletion histories still produce
// identical JSON bytes. Native JsonEncodeResult temporaries are released for
// every key and value before the next entry is visited.
fn script_json_string_map_encode(context: *opaque,
    values: ScriptMapText) []u8 {
    let max_values: i32 = json.json_default_max_values();
    let max_output: i32 = json.json_default_max_output_bytes();
    if (!script_json_string_map_descriptor_valid(values, context) ||
        values.count > max_values || max_output < 2) {
        return (null as *u8)[0..0];
    }
    let capacity: i64 = 2;
    let slot: i32 = 0;
    while (slot < values.cap) {
        if (values.used[slot] == 1) {
            let key: []u8 = values.keys[slot];
            let value: []u8 = values.values[slot];
            let raw: i64 = (key.len as i64) + (value.len as i64);
            if (raw > (max_output as i64) ||
                capacity > (max_output as i64) - raw * 6 - 5) {
                return (null as *u8)[0..0];
            }
            capacity = capacity + raw * 6 + 5;
        } else if (values.used[slot] != 0 && values.used[slot] != 2) {
            return (null as *u8)[0..0];
        }
        slot = slot + 1;
    }
    let data: *u8 = _zag_script_alloc(context, capacity) as *u8;
    if (data == null as *u8) { return (null as *u8)[0..0]; }
    let at: i32 = 0;
    data[at] = '{'; at = at + 1;
    let emitted: i32 = 0;
    let first: i32 = 1;
    let last: []u8 = "";
    while (emitted < values.count) {
        let selected: i32 = -1;
        let selected_key: []u8 = "";
        slot = 0;
        while (slot < values.cap) {
            if (values.used[slot] == 1) {
                let key: []u8 = values.keys[slot];
                let after_last: i32 = (first == 1 ||
                    script_json_bytes_cmp(key, last) > 0) as i32;
                if (after_last == 1 && (selected < 0 ||
                    script_json_bytes_cmp(key, selected_key) < 0)) {
                    selected = slot; selected_key = key;
                }
            }
            slot = slot + 1;
        }
        if (selected < 0) { return (null as *u8)[0..0]; }
        if (emitted > 0) { data[at] = ','; at = at + 1; }
        let encoded_key: json.JsonEncodeResult =
            json.json_stringify_string_checked(values.keys[selected]);
        let encoded_value: json.JsonEncodeResult =
            json.json_stringify_string_checked(values.values[selected]);
        if (encoded_key.ok == 0 || encoded_value.ok == 0) {
            json.json_encode_result_free(&encoded_key);
            json.json_encode_result_free(&encoded_value);
            return (null as *u8)[0..0];
        }
        let i: i32 = 0;
        while (i < encoded_key.value.len) {
            data[at] = encoded_key.value[i]; at = at + 1; i = i + 1;
        }
        data[at] = ':'; at = at + 1;
        i = 0;
        while (i < encoded_value.value.len) {
            data[at] = encoded_value.value[i]; at = at + 1; i = i + 1;
        }
        json.json_encode_result_free(&encoded_key);
        json.json_encode_result_free(&encoded_value);
        last = values.keys[selected]; first = 0; emitted = emitted + 1;
    }
    data[at] = '}'; at = at + 1;
    return data[0..at];
}
