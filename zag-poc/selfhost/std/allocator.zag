// v2 native SystemAllocator: a checked, handle-based bridge to the native
// ordinary allocator.  This is intentionally narrow: its Allocation record is
// the ownership token, never a raw pointer plus a caller-guessed length.

error { OutOfMemory, InvalidSize, InvalidAlignment, InvalidAllocator }

struct Allocation {
    ptr: *u8,
    len: i64,
    alignment: i64,
    generation: i64,
    // Runtime allocator identity is part of the checked ownership token.  It
    // prevents a descriptor minted by one allocator family from being
    // replayed through another family's deallocator.  The current public
    // constructor exposes only SystemAllocator (identity 1); callers cannot
    // make that identity valid for a different runtime registry entry.
    allocator_id: i64,
}

struct SystemAllocator { allocator_id: i64 }

// `system_allocator()` is a value constructor, not mutable global state.  Its
// identity is carried into every Allocation descriptor and checked again at
// deallocation; it is not a raw pointer or a caller-selected registry index.
fn system_allocator() SystemAllocator { return SystemAllocator{ .allocator_id = 1 }; }

// The native allocator has 8-byte minimum alignment and size classes.  Expose
// the exact capacity reserved for this handle, so deallocation can validate it
// against the runtime provenance record rather than trusting caller metadata.
fn system_allocator_capacity(bytes: i64) !i64 {
    if (bytes < 0) { return error.InvalidSize; }
    let capacity: i64 = 16;
    while (capacity < bytes) {
        if (capacity >= 524288) { return bytes; }
        capacity = capacity * 2;
    }
    return capacity;
}

fn (self: SystemAllocator) allocate(bytes: i64, alignment: i64) !Allocation {
    // Ordinary native allocations are 8-byte aligned, so every supported
    // power-of-two request up to 8 is satisfied and recorded exactly.
    if (alignment != 1 && alignment != 2 && alignment != 4 && alignment != 8) { return error.InvalidAlignment; }
    let capacity: i64 = try system_allocator_capacity(bytes);
    let ptr: *u8 = _zag_malloc(capacity);
    if (ptr == null as *u8) { return error.OutOfMemory; }
    let generation: i64 = _zag_allocation_register(ptr, capacity, alignment, self.allocator_id);
    return Allocation{ .ptr = ptr, .len = capacity, .alignment = alignment, .generation = generation, .allocator_id = self.allocator_id };
}

// Zeroing is performed through the just-minted checked allocation root.  The
// loop bound is the exact recorded capacity, so it cannot write past the
// handle's native allocation even when the caller requested a smaller value.
fn (self: SystemAllocator) allocate_zeroed(bytes: i64, alignment: i64) !Allocation {
    let block: Allocation = try self.allocate(bytes, alignment);
    unsafe {
        let i: i64 = 0;
        while (i < block.len) {
            block.ptr[i] = 0;
            i = i + 1;
        }
    }
    return block;
}

// Allocate the replacement before consuming `block`: any fallible allocation
// path returns its error with the original handle still live.  The old handle
// is validated before copying, and only consumed after the overlap is copied.
fn (self: SystemAllocator) resize(block: Allocation, bytes: i64, alignment: i64) !Allocation {
    // A valid descriptor is bound to its minting receiver as well as to the
    // runtime provenance table. Reject a cross-receiver replay before any
    // validation, allocation, copy, or free can mutate the live handle.
    if (self.allocator_id != block.allocator_id) { return error.InvalidAllocator; }
    _zag_allocation_validate(block.ptr, block.len, block.alignment, block.generation, block.allocator_id);
    let replacement: Allocation = try self.allocate(bytes, alignment);
    let copy_len: i64 = block.len;
    if (replacement.len < copy_len) { copy_len = replacement.len; }
    unsafe {
        let i: i64 = 0;
        while (i < copy_len) {
            replacement.ptr[i] = block.ptr[i];
            i = i + 1;
        }
    }
    try self.deallocate(block);
    return replacement;
}

// Deallocation consumes the full handle at the source level.  The compiler
// validates pointer, exact capacity, liveness, and SystemAllocator alignment
// before raw free; copied, stale, shortened, or forged records fail closed.
fn (self: SystemAllocator) deallocate(block: Allocation) !void {
    if (self.allocator_id != block.allocator_id) { return error.InvalidAllocator; }
    _zag_allocation_validate(block.ptr, block.len, block.alignment, block.generation, block.allocator_id);
    _zag_allocation_free(block.ptr);
    return;
}
