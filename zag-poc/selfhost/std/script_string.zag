// Script-context string helpers. Returned storage lasts until Script shutdown
// and its payload is charged to the configured Script limit.

fn script_string_concat(context: *opaque, a: []u8, b: []u8) []u8 {
    let total: i32 = a.len + b.len;
    let data: *u8 = _zag_script_alloc(context, total as i64) as *u8;
    if (data == null as *u8) { return data[0..0]; }
    let i: i32 = 0;
    while (i < a.len) { data[i] = a[i]; i = i + 1; }
    let j: i32 = 0;
    while (j < b.len) { data[a.len + j] = b[j]; j = j + 1; }
    return data[0..total];
}
