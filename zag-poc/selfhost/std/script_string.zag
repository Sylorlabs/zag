// Script-context string helpers. Returned storage lasts until Script shutdown
// and its payload is charged to the configured Script limit.

fn script_string_concat(context: *opaque, a: []u8, b: []u8) []u8 {
    if (a.len < 0 || b.len < 0) {
        _zag_eprintln("Zag Script string_concat received an invalid slice");
        return (null as *u8)[0..0];
    }
    let total64: i64 = (a.len as i64) + (b.len as i64);
    if (total64 > 2147483647) {
        _zag_eprintln("Zag Script string_concat result is too large");
        return (null as *u8)[0..0];
    }
    let total: i32 = total64 as i32;
    let data: *u8 = _zag_script_alloc(context, total64) as *u8;
    if (data == null as *u8) {
        // A non-empty interpolation result cannot be represented by an empty
        // slice. Reject exhaustion instead of silently changing observable
        // output while preserving the bounded Script allocator contract.
        _zag_eprintln("Zag Script string allocation failed");
        _zag_exit(1);
    }
    let i: i32 = 0;
    while (i < a.len) { data[i] = a[i]; i = i + 1; }
    let j: i32 = 0;
    while (j < b.len) { data[a.len + j] = b[j]; j = j + 1; }
    return data[0..total];
}

// Scalar interpolation stays inside ScriptContext.  Do not route this
// through _zag_i64_to_str: that helper returns an ordinary heap slice which
// would either leak or make the Script lifetime checker guess about a hidden
// temporary.  The bounded 24-byte buffer covers every signed i64 spelling,
// including the minimum value, and the returned slice points at the exact
// suffix written below.
fn script_string_i64(context: *opaque, value: i64) []u8 {
    let data: *u8 = _zag_script_alloc(context, 24) as *u8;
    if (data == null as *u8) {
        _zag_eprintln("Zag Script string allocation failed");
        _zag_exit(1);
    }
    let magnitude: u64 = 0;
    let negative: i32 = (value < 0) as i32;
    if (negative == 1) {
        // value + 1 is representable even for INT64_MIN; the final +1 is
        // performed after widening to u64.
        magnitude = ((0 - (value + 1)) as u64) + 1;
    } else {
        magnitude = value as u64;
    }
    let end: i32 = 24;
    let at: i32 = end;
    if (magnitude == 0) {
        at = at - 1;
        data[at] = '0' as u8;
    } else {
        while (magnitude > 0) {
            at = at - 1;
            data[at] = ('0' as u8) + (magnitude % 10) as u8;
            magnitude = magnitude / 10;
        }
    }
    if (negative == 1) {
        at = at - 1;
        data[at] = '-' as u8;
    }
    return data[at..end];
}

fn script_string_bool(context: *opaque, value: bool) []u8 {
    if (value) { return script_string_concat(context, "true", ""); }
    return script_string_concat(context, "false", "");
}

// Bounded f64 interpolation for Script. It is deliberately locale-free and
// deterministic: finite values are rounded to six decimal places with
// trailing fractional zeroes removed; NaN and infinities use fixed spellings.
// Values outside the exactly-convertible signed-i64 whole-number range are
// reported as `inf` rather than invoking an undefined float-to-int conversion.
fn script_string_f64(context: *opaque, value: f64) []u8 {
    let data: *u8 = _zag_script_alloc(context, 64) as *u8;
    if (data == null as *u8) {
        _zag_eprintln("Zag Script string allocation failed");
        _zag_exit(1);
    }
    if (value != value) {
        data[0] = 'n'; data[1] = 'a'; data[2] = 'n';
        return data[0..3];
    }
    let max_exact: f64 = 9223372036854774784.0;
    if (value >= max_exact) {
        data[0] = 'i'; data[1] = 'n'; data[2] = 'f';
        return data[0..3];
    }
    if (value <= 0.0 - max_exact) {
        data[0] = '-'; data[1] = 'i'; data[2] = 'n'; data[3] = 'f';
        return data[0..4];
    }
    let negative: i32 = (value < 0.0) as i32;
    let absolute: f64 = value;
    if (negative == 1) { absolute = 0.0 - value; }
    let whole: i64 = (@floatToInt(absolute) as i64);
    let fraction_value: f64 = (absolute - (whole as f64)) * 1000000.0 + 0.5;
    let fraction: i64 = (@floatToInt(fraction_value) as i64);
    let rounded_whole: i64 = whole;
    let rounded_fraction: i64 = fraction;
    if (fraction >= 1000000) { rounded_whole = whole + 1; rounded_fraction = 0; }
    let end: i32 = 64;
    let at: i32 = end;
    let frac_digits: i32 = 0;
    let trimmed_fraction: i64 = rounded_fraction;
    while (trimmed_fraction > 0 && trimmed_fraction % 10 == 0) {
        trimmed_fraction = trimmed_fraction / 10;
    }
    let frac_work: i64 = trimmed_fraction;
    while (frac_work > 0) { frac_digits = frac_digits + 1; frac_work = frac_work / 10; }
    let i: i32 = 0;
    let frac_write: i64 = trimmed_fraction;
    while (i < frac_digits) {
        at = at - 1; data[at] = ('0' as u8) + (frac_write % 10) as u8;
        frac_write = frac_write / 10; i = i + 1;
    }
    if (frac_digits > 0) { at = at - 1; data[at] = '.'; }
    let whole_work: i64 = rounded_whole;
    if (whole_work == 0) { at = at - 1; data[at] = '0'; }
    else {
        while (whole_work > 0) {
            at = at - 1; data[at] = ('0' as u8) + (whole_work % 10) as u8;
            whole_work = whole_work / 10;
        }
    }
    if (negative == 1) { at = at - 1; data[at] = '-'; }
    return data[at..end];
}
