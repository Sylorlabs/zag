// Compiler-owned Script CSV byte bridge.
//
// The public Script surface is deliberately raw-bytes only: parse and encode
// happen inside this helper, native CsvTable/CsvEncodeResult temporaries are
// released on every path, and only the final bytes are retained by the
// generated ScriptContext. Strict callers continue to use std:csv directly.

@import("std:csv")
// Keep the transitive ArrayList declarations in the same compilation unit
// when this compiler-owned bridge is loaded without an explicit std:csv import.
@import("std:list")
@import("std:script_list")

fn script_csv_first_column_failed(context: *opaque) ScriptList[[]u8] {
    return ScriptList[[]u8]{.data = null as *[]u8, .len = 0, .cap = 0,
        .context = context, .failed = 1};
}

fn script_csv_copy_text(context: *opaque, source: []u8) []u8 {
    if (source.len < 0) { return (null as *u8)[0..0]; }
    if (source.len == 0) { return ""; }
    let data: *u8 = _zag_script_alloc(context, source.len as i64) as *u8;
    if (data == null as *u8) { return (null as *u8)[0..0]; }
    let i: i32 = 0;
    while (i < source.len) { data[i] = source[i]; i = i + 1; }
    return data[0..source.len];
}

fn script_csv_normalize(context: *opaque, source: []u8) []u8 {
    // Keep the raw-byte bridge's empty slice unambiguous: strict std:csv still
    // accepts an empty table, while Script uses zero length solely for failure.
    if (source.len == 0) { return (null as *u8)[0..0]; }
    let table: CsvTable = csv_parse_bounded(source,
        csv_default_max_bytes(), csv_default_max_rows(),
        csv_default_max_cells(), csv_default_max_field_bytes());
    if (table.ok == 0) {
        csv_free(&table);
        return (null as *u8)[0..0];
    }
    let encoded: CsvEncodeResult = csv_encode_bounded(table,
        csv_default_max_output_bytes(), 1);
    if (encoded.ok == 0) {
        csv_encode_result_free(&encoded);
        csv_free(&table);
        return (null as *u8)[0..0];
    }
    let output_len: i32 = encoded.value.len;
    let size: i64 = output_len as i64;
    let data: *u8 = _zag_script_alloc(context, size) as *u8;
    if (data == null as *u8) {
        csv_encode_result_free(&encoded);
        csv_free(&table);
        _zag_eprintln("Zag Script CSV output allocation failed");
        _zag_exit(1);
    }
    let i: i32 = 0;
    while (i < output_len) {
        data[i] = encoded.value[i];
        i = i + 1;
    }
    csv_encode_result_free(&encoded);
    csv_free(&table);
    return data[0..output_len];
}

// Parse a bounded CSV table and copy its first column into a Script-owned
// string list. This is intentionally a single-column aggregate contract:
// arbitrary row shapes and nested Script aggregates remain outside this slice.
fn script_csv_first_column(context: *opaque, source: []u8)
    ScriptList[[]u8] {
    let table: CsvTable = csv_parse_bounded(source,
        csv_default_max_bytes(), csv_default_max_rows(),
        csv_default_max_cells(), csv_default_max_field_bytes());
    if (table.ok == 0) {
        csv_free(&table);
        return script_csv_first_column_failed(context);
    }
    let result: ScriptList[[]u8] = script_list_new[[]u8](context,
        table.rows.len);
    if (result.failed != 0) {
        csv_free(&table);
        return result;
    }
    let i: i32 = 0;
    while (i < table.rows.len) {
        if (table.rows.data[i].cells.len < 1) {
            result.failed = 1;
            csv_free(&table);
            return result;
        }
        let text: []u8 = script_csv_copy_text(context,
            table.rows.data[i].cells.data[0]);
        if (table.rows.data[i].cells.data[0].len > 0 && text.len == 0) {
            result.failed = 1;
            csv_free(&table);
            return result;
        }
        if (script_list_append(&result, text) != 0) {
            csv_free(&table);
            return result;
        }
        i = i + 1;
    }
    csv_free(&table);
    return result;
}

// Parse a bounded CSV table into Script-owned rows.  Each row and each cell
// gets its own ScriptContext-owned descriptor/payload; the strict CsvTable is
// released before the nested aggregate becomes visible to the Script caller.
// This is intentionally row-shaped rather than schema-inferred: callers keep
// explicit control over column count, text interpretation, and validation.
fn script_csv_rows_failed(context: *opaque)
    ScriptList[ScriptList[[]u8]] {
    return ScriptList[ScriptList[[]u8]]{
        .data = null as *ScriptList[[]u8], .len = 0, .cap = 0,
        .context = context, .failed = 1};
}

fn script_csv_rows(context: *opaque, source: []u8)
    ScriptList[ScriptList[[]u8]] {
    let table: CsvTable = csv_parse_bounded(source,
        csv_default_max_bytes(), csv_default_max_rows(),
        csv_default_max_cells(), csv_default_max_field_bytes());
    if (table.ok == 0) {
        csv_free(&table);
        return script_csv_rows_failed(context);
    }
    let result: ScriptList[ScriptList[[]u8]] =
        script_list_new[ScriptList[[]u8]](context, table.rows.len);
    if (result.failed != 0) {
        csv_free(&table);
        return result;
    }
    let i: i32 = 0;
    while (i < table.rows.len) {
        let row: ScriptList[[]u8] = script_list_new[[]u8](context,
            table.rows.data[i].cells.len);
        if (row.failed != 0) {
            result.failed = 1;
            csv_free(&table);
            return result;
        }
        let j: i32 = 0;
        while (j < table.rows.data[i].cells.len) {
            let cell: []u8 = table.rows.data[i].cells.data[j];
            let text: []u8 = script_csv_copy_text(context, cell);
            if (cell.len > 0 && text.len == 0) {
                result.failed = 1;
                csv_free(&table);
                return result;
            }
            if (script_list_append[[]u8](&row, text) != 0) {
                result.failed = 1;
                csv_free(&table);
                return result;
            }
            j = j + 1;
        }
        if (script_list_append[ScriptList[[]u8]](&result, row) != 0) {
            csv_free(&table);
            return result;
        }
        i = i + 1;
    }
    csv_free(&table);
    return result;
}

// Encode Script-owned text rows using the same bounded RFC-style field rules
// as std:csv.  The output is retained by ScriptContext; no native CsvTable is
// constructed, so there is no ownership ambiguity around cell payloads.
fn script_csv_field_quoted(field: []u8) i32 {
    let i: i32 = 0;
    while (i < field.len) {
        if (field[i] == 44 || field[i] == 34 || field[i] == 10 ||
            field[i] == 13) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn script_csv_rows_encode(context: *opaque,
    rows: ScriptList[ScriptList[[]u8]]) []u8 {
    let max_rows: i32 = csv_default_max_rows();
    let max_cells: i32 = csv_default_max_cells();
    let max_field: i32 = csv_default_max_field_bytes();
    let max_output: i32 = csv_default_max_output_bytes();
    if (!script_list_descriptor_valid[ScriptList[[]u8]](rows, context) ||
        rows.len > max_rows || max_output < 0) {
        return (null as *u8)[0..0];
    }
    let capacity: i64 = 0;
    let total_cells: i32 = 0;
    let ri: i32 = 0;
    while (ri < rows.len) {
        let row: ScriptList[[]u8] = rows.data[ri];
        if (!script_list_descriptor_valid[[]u8](row, context) ||
            row.len < 1) {
            return (null as *u8)[0..0];
        }
        if (row.len > max_cells - total_cells) { return (null as *u8)[0..0]; }
        total_cells = total_cells + row.len;
        let ci: i32 = 0;
        while (ci < row.len) {
            let field: []u8 = row.data[ci];
            if (field.len < 0 || field.len > max_field ||
                (field.len > 0 && _zag_slice_ptr(field) == null as *i8)) {
                return (null as *u8)[0..0];
            }
            // A quoted field costs at most two delimiters plus one byte per
            // embedded quote; 2*len+2 is a conservative checked bound.
            let field_bound: i64 = field.len as i64;
            if (script_csv_field_quoted(field) == 1) {
                field_bound = 2 + (field.len as i64) * 2;
            }
            if (capacity > (max_output as i64) - field_bound) {
                return (null as *u8)[0..0];
            }
            capacity = capacity + field_bound;
            if (ci > 0) { capacity = capacity + 1; }
            ci = ci + 1;
        }
        if (ri > 0) { capacity = capacity + 2; }
        if (capacity > max_output as i64) { return (null as *u8)[0..0]; }
        ri = ri + 1;
    }
    if (capacity == 0) { return (null as *u8)[0..0]; }
    let data: *u8 = _zag_script_alloc(context, capacity) as *u8;
    if (data == null as *u8) { return (null as *u8)[0..0]; }
    let at: i32 = 0;
    ri = 0;
    while (ri < rows.len) {
        if (ri > 0) { data[at] = 13; at = at + 1; data[at] = 10; at = at + 1; }
        let row: ScriptList[[]u8] = rows.data[ri];
        let ci: i32 = 0;
        while (ci < row.len) {
            if (ci > 0) { data[at] = 44; at = at + 1; }
            let field: []u8 = row.data[ci];
            let quoted: i32 = script_csv_field_quoted(field);
            if (quoted == 1) { data[at] = 34; at = at + 1; }
            let fi: i32 = 0;
            while (fi < field.len) {
                if (field[fi] == 34) { data[at] = 34; at = at + 1; }
                data[at] = field[fi]; at = at + 1; fi = fi + 1;
            }
            if (quoted == 1) { data[at] = 34; at = at + 1; }
            ci = ci + 1;
        }
        ri = ri + 1;
    }
    return data[0..at];
}
