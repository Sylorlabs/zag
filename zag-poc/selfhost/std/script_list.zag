// Statically typed growable list used by Zag Script. Growth is geometric, so
// successful append sequences copy O(n) elements overall. Every backing buffer
// is charged to the Script context; superseded buffers remain owned by the
// selected Script allocator until generated shutdown.

struct ScriptList[T] {
    data: *T,
    len: i32,
    cap: i32,
    context: *opaque,
    failed: i32,
}

fn script_list_new[T](context: *opaque, capacity: i32) ScriptList[T] {
    let cap: i32 = capacity;
    if (cap < 4) { cap = 4; }
    let element_size: i64 = @sizeOf[T]() as i64;
    let cap64: i64 = cap as i64;
    if (element_size <= 0 || cap64 > 2147483647 / element_size) {
        return ScriptList[T]{ .data = null as *T, .len = 0, .cap = cap,
            .context = context, .failed = 1 };
    }
    // Widen before multiplying. An i32 product could wrap back to a small
    // positive request and make a huge logical list write past a tiny buffer.
    let data: *T = _zag_script_alloc(context, cap64 * element_size) as *T;
    let failed: i32 = 0;
    if (data == null as *T) { failed = 1; }
    return ScriptList[T]{ .data = data, .len = 0, .cap = cap, .context = context,
        .failed = failed };
}

// A successful ScriptList constructor always clamps capacity to at least four
// elements and retains a backing allocation, including for an empty list.
// Keep this exact shape check at dynamic aggregate boundaries so a forged
// descriptor cannot turn an empty list into an unbounded/null-backed view.
fn script_list_descriptor_valid[T](list: ScriptList[T], context: *opaque) bool {
    let element_size: i64 = @sizeOf[T]() as i64;
    // Generic descriptor validation compares opaque/raw backing pointers.
    // Keep that narrow operation explicit; callers still receive only a bool
    // and no pointer authority is exposed by this helper.
    unsafe {
        return (list.failed == 0 && context != null as *opaque &&
            list.context == context && list.cap >= 4 &&
            list.len >= 0 && list.len <= list.cap && list.data != null as *T &&
            element_size > 0 &&
            (list.cap as i64) <= 2147483647 / element_size);
    }
}

fn script_list1[T](context: *opaque, a: T) ScriptList[T] {
    let result: ScriptList[T] = script_list_new[T](context, 4);
    if (result.failed != 0) { return result; }
    result.data[0] = a; result.len = 1; return result;
}

fn script_list2[T](context: *opaque, a: T, b: T) ScriptList[T] {
    let result: ScriptList[T] = script_list1[T](context, a);
    if (result.failed != 0) { return result; }
    result.data[1] = b; result.len = 2; return result;
}

fn script_list3[T](context: *opaque, a: T, b: T, c: T) ScriptList[T] {
    let result: ScriptList[T] = script_list2[T](context, a, b);
    if (result.failed != 0) { return result; }
    result.data[2] = c; result.len = 3; return result;
}

fn script_list4[T](context: *opaque, a: T, b: T, c: T, d: T) ScriptList[T] {
    let result: ScriptList[T] = script_list3[T](context, a, b, c);
    if (result.failed != 0) { return result; }
    result.data[3] = d; result.len = 4; return result;
}

fn script_list_append[T](list: *ScriptList[T], value: T) i32 {
    if (!script_list_descriptor_valid[T](list.*, list.*.context)) {
        list.*.failed = 1;
        return 1;
    }
    if (list.*.len == list.*.cap) {
        if (list.*.cap > 1073741823) {
            list.*.failed = 1;
            return 1;
        }
        let next_cap: i32 = list.*.cap * 2;
        let element_size: i64 = @sizeOf[T]() as i64;
        if (element_size <= 0 ||
            (next_cap as i64) > 2147483647 / element_size) {
            list.*.failed = 1;
            return 1;
        }
        let next: *T = _zag_script_alloc(list.*.context,
            (next_cap as i64) * element_size) as *T;
        if (next == null as *T) { list.*.failed = 1; return 1; }
        let i: i32 = 0;
        while (i < list.*.len) { next[i] = list.*.data[i]; i = i + 1; }
        list.*.data = next; list.*.cap = next_cap;
    }
    list.*.data[list.*.len] = value;
    list.*.len = list.*.len + 1;
    return 0;
}

// Replace one element in a Script-owned list.  Script lists currently carry
// values with copy semantics; affine/resource element move and drop metadata
// is deliberately not inferred here.  Returning a status keeps malformed
// descriptors and indexes inside the bounded Script failure contract instead
// of exposing a raw pointer write.
fn script_list_set[T](list: *ScriptList[T], index: i32, value: T) i32 {
    if (!script_list_descriptor_valid[T](list.*, list.*.context) ||
        index < 0 || index >= list.*.len) {
        list.*.failed = 1;
        return 1;
    }
    list.*.data[index] = value;
    return 0;
}

// Clear every live value while retaining the ScriptContext-owned backing
// allocation for reuse.  ScriptList values have copy semantics, so this
// operation is intentionally limited to the same non-resource element domain
// as append/set/pop; the typed resource checker rejects resource-valued
// instantiations before this body can discard nested ownership.  Validate the
// complete descriptor before touching `data`: a failed constructor, forged
// context/capacity/length, or null list pointer fails closed and records the
// failure on a non-null descriptor.  The live prefix is scrubbed so stale
// values cannot be observed through the retained capacity after clear.
fn script_list_clear[T](list: *ScriptList[T]) i32 {
    if (list == null as *ScriptList[T]) { return 1; }
    if (!script_list_descriptor_valid[T](list.*,
                                         list.*.context)) {
        list.*.failed = 1;
        return 1;
    }
    let element_size: i64 = @sizeOf[T]() as i64;
    let live_bytes: i64 = (list.*.len as i64) * element_size;
    // The descriptor validator proves cap*element_size fits the bounded raw
    // byte index domain, so this is redundant for a normal descriptor but
    // keeps the multiplication-to-index boundary explicit and fail-closed.
    if (element_size <= 0 || live_bytes < 0 || live_bytes > 2147483647) {
        list.*.failed = 1;
        return 1;
    }
    let bytes: i32 = live_bytes as i32;
    let raw: *u8 = list.*.data as *u8;
    let i: i32 = 0;
    while (i < bytes) { raw[i] = 0; i = i + 1; }
    list.*.len = 0;
    return 0;
}

// Remove and return the last value.  Empty/failed/corrupt lists fail closed
// through the same checked diagnostic boundary as script_list_get.  The
// operation is intentionally value-oriented until ScriptList grows explicit
// per-element affine move/drop state; resource-valued list operations remain
// rejected by the strict ownership checker.
fn script_list_pop[T](list: *ScriptList[T]) T {
    if (!script_list_descriptor_valid[T](list.*, list.*.context) ||
        list.*.len <= 0) {
        list.*.failed = 1;
        _zag_eprintln("Zag Script list pop is empty or the list state is invalid");
        _zag_exit(1);
    }
    let last: i32 = list.*.len - 1;
    let value: T = list.*.data[last];
    list.*.len = last;
    return value;
}

fn script_list_len[T](list: ScriptList[T]) i32 { return list.len; }
// List indexing is an explicit dynamic boundary.  Do not let a failed
// constructor, a corrupted descriptor, or a negative/high index become a raw
// pointer access merely because `ScriptList` is a small transparent struct.
// `_zag_exit` does not return on the supported native path; the trailing
// return satisfies the ordinary generic function shape for the parser.
fn script_list_get[T](list: ScriptList[T], index: i32) T {
    if (!script_list_descriptor_valid[T](list, list.context) ||
        index < 0 || index >= list.len) {
        _zag_eprintln("Zag Script list index is out of bounds or the list state is invalid");
        _zag_exit(1);
    }
    return list.data[index];
}
fn script_list_failed[T](list: ScriptList[T]) i32 { return list.failed; }

// Materialized Script argument collection. The collection backing array is
// charged to the Script context; string bytes remain the immutable process
// argument storage supplied by the runtime.
fn script_args(context: *opaque) ScriptList[[]u8] {
    let result: ScriptList[[]u8] = script_list_new[[]u8](context, _zag_argc());
    if (result.failed != 0) { return result; }
    let i:i32=0;while(i<_zag_argc()){result.data[i]=_zag_arg(i);i=i+1;}
    result.len=_zag_argc();return result;
}
