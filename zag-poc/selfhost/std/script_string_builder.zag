// Fixed-capacity string builder shared by Zag Script and strict Zag.
// No append reallocates: total copy work is exactly the bytes successfully
// appended. A failed append leaves the prior contents unchanged.

struct ScriptStringBuilder {
    data: *i8,
    len: i32,
    cap: i32,
    failed: i32,
}

fn string_builder_from_buffer(buffer: *i8, capacity: i32) ScriptStringBuilder {
    return ScriptStringBuilder{ .data = buffer, .len = 0, .cap = capacity, .failed = 0 };
}

// Compiler-bound Script constructor. Strict code should use
// string_builder_from_buffer with explicitly allocated storage.
fn script_string_builder_new(context: *opaque, capacity: i32) ScriptStringBuilder {
    if (capacity < 0) {
        return ScriptStringBuilder{ .data = null as *i8, .len = 0, .cap = 0, .failed = 1 };
    }
    let memory: *i8 = _zag_script_alloc(context, capacity as i64);
    if (memory == null as *i8) {
        return ScriptStringBuilder{ .data = memory, .len = 0, .cap = capacity, .failed = 1 };
    }
    return string_builder_from_buffer(memory, capacity);
}

fn string_builder_append(builder: *ScriptStringBuilder, value: []u8) i32 {
    if (builder.*.failed != 0 || value.len > builder.*.cap - builder.*.len) {
        builder.*.failed = 1;
        return 1;
    }
    let i: i32 = 0;
    while (i < value.len) {
        builder.*.data[builder.*.len + i] = value[i] as i8;
        i = i + 1;
    }
    builder.*.len = builder.*.len + value.len;
    return 0;
}

fn string_builder_len(builder: *ScriptStringBuilder) i32 { return builder.*.len; }
fn string_builder_failed(builder: *ScriptStringBuilder) i32 { return builder.*.failed; }

fn string_builder_output(builder: *ScriptStringBuilder) []u8 {
    return (builder.*.data as *u8)[0..builder.*.len];
}
