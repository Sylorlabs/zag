// Bounded Script-owned i64 range constructor.
//
// range(start, end, step) follows the compact profile's half-open interval
// convention and returns a ScriptList[i64]. It is deliberately bounded:
// zero steps, allocation failure, and more than 1,048,576 emitted values fail
// closed instead of turning a short source expression into an unbounded
// allocation or loop. A representable sequence that would step past an i64
// extreme terminates cleanly without wrapping, matching std:range.

@import("std:script_list")

fn script_range_failed(context: *opaque) ScriptList[i64] {
    return ScriptList[i64]{.data = null as *i64, .len = 0, .cap = 0,
        .context = context, .failed = 1};
}

fn script_range_i64_max() i64 { return 9223372036854775807; }
fn script_range_i64_min() i64 {
    return (0 - 9223372036854775807) - 1;
}

fn script_range_i64(context: *opaque, start: i64, end: i64,
    step: i64) ScriptList[i64] {
    if (step == 0) { return script_range_failed(context); }
    let result: ScriptList[i64] = script_list_new[i64](context, 4);
    if (result.failed != 0) { return result; }
    let value: i64 = start;
    let emitted: i32 = 0;
    while (emitted <= 1048576) {
        if ((step > 0 && value >= end) || (step < 0 && value <= end)) {
            return result;
        }
        if (emitted >= 1048576) {
            return script_range_failed(context);
        }
        if (script_list_append[i64](&result, value) != 0) {
            return result;
        }
        emitted = emitted + 1;
        // Form the next value only after an explicit signed-overflow check.
        // If the mathematical next value leaves i64 it must also cross the
        // representable exclusive endpoint, so terminate without wrapping.
        if (step > 0) {
            if (value > script_range_i64_max() - step) {
                return result;
            }
            let next: i64 = value + step;
            if (next >= end) { return result; }
            value = next;
        } else {
            if (value < script_range_i64_min() - step) {
                return result;
            }
            let next: i64 = value + step;
            if (next <= end) { return result; }
            value = next;
        }
    }
    return script_range_failed(context);
}
