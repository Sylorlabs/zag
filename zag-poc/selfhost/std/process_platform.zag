// selfhost/std/process_platform.zag -- typed platform boundary for processes.
//
// Shared process supervision only consumes this contract.  The native backend
// supplies the target-specific implementation; no Darwin errno, syscall number,
// or kernel wait structure is allowed to leak into process.zag.

extern fn _zag_process_platform_capabilities() i64 @io;
extern fn _zag_process_wait_readable(fd: i64, timeout_ms: i64) i64 @io;
extern fn _zag_process_read_disposition(code: i64) i64 @io;
extern fn _zag_raw_syscall(num: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64) i64 @io;

// Explicit adapter to the compiler's audited Linux-numbered raw process ABI.
// Target codegen translates this subset for ARM/Linux and ARM/Darwin. No raw
// syscall selectors occur in the shared process state machine.
fn process_platform_pipe(pair: i64) i64 { return _zag_raw_syscall(293, pair, 0, 0, 0, 0, 0); }
fn process_platform_nonblocking(fd: i64) i64 { return _zag_raw_syscall(72, fd, 4, 2048, 0, 0, 0); }
fn process_platform_close(fd: i64) i64 { return _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0); }
fn process_platform_fork() i64 { return _zag_raw_syscall(57, 0, 0, 0, 0, 0, 0); }
fn process_platform_set_group(pid: i64) i64 { return _zag_raw_syscall(109, pid, pid, 0, 0, 0, 0); }
fn process_platform_dup2(source: i64, destination: i64) i64 { return _zag_raw_syscall(33, source, destination, 0, 0, 0, 0); }
fn process_platform_exec_shell(shell: i64, argv: i64, envp: i64) i64 { return _zag_raw_syscall(59, shell, argv, envp, 0, 0, 0); }
fn process_platform_read(fd: i64, buffer: i64, bytes: i64) i64 { return _zag_raw_syscall(0, fd, buffer, bytes, 0, 0, 0); }
fn process_platform_wait(pid: i64, status: i64, nohang: i64) i64 { return _zag_raw_syscall(61, pid, status, nohang, 0, 0, 0); }
fn process_platform_kill_group(pid: i64) i64 { if (pid <= 1) { return -1; } return _zag_raw_syscall(62, -pid, 9, 0, 0, 0, 0); }
fn process_platform_kill_child(pid: i64) i64 { if (pid <= 1) { return -1; } return _zag_raw_syscall(62, pid, 9, 0, 0, 0, 0); }

struct ProcessPlatformCapabilities {
    platform: i32,
    process_group: i32,
    nonblocking_observation: i32,
    deadline_wait: i32,
    fail_closed: i32,
    isolation: i32,
}

enum ProcessIsolationRequirement { SupervisionOnly, SecuritySandbox }
enum ProcessIsolationStatus { NotRequested, Unsupported }
struct ProcessIsolationResult {
    accepted: i32,
    sandboxed: i32,
    status: ProcessIsolationStatus,
}

fn process_platform_linux() i32 { return 1; }
fn process_platform_darwin() i32 { return 2; }

fn process_platform_cap_process_group() i32 { return 4; }
fn process_platform_cap_nonblocking_observation() i32 { return 8; }
fn process_platform_cap_deadline_wait() i32 { return 16; }
fn process_platform_cap_fail_closed() i32 { return 32; }
fn process_platform_cap_isolation() i32 { return 64; }

fn process_platform_capabilities() ProcessPlatformCapabilities {
    let bits: i32 = _zag_process_platform_capabilities() as i32;
    let platform: i32 = (bits & 3) as i32;
    return ProcessPlatformCapabilities{
        .platform = platform,
        .process_group = ((bits & process_platform_cap_process_group()) != 0) as i32,
        .nonblocking_observation = ((bits & process_platform_cap_nonblocking_observation()) != 0) as i32,
        .deadline_wait = ((bits & process_platform_cap_deadline_wait()) != 0) as i32,
        .fail_closed = ((bits & process_platform_cap_fail_closed()) != 0) as i32,
        .isolation = ((bits & process_platform_cap_isolation()) != 0) as i32,
    };
}

// Process groups are NOT a security sandbox. Neither backend installs a kernel
// sandbox. Even a fabricated capability bit cannot authorize a missing backend.
// This decision is made before pipe/fork, never by exiting a spawned child.
fn process_platform_check_isolation(requirement: ProcessIsolationRequirement) ProcessIsolationResult {
    if (requirement == ProcessIsolationRequirement.SupervisionOnly) {
        return ProcessIsolationResult{.accepted=1,.sandboxed=0,.status=ProcessIsolationStatus.NotRequested};
    }
    return ProcessIsolationResult{.accepted=0,.sandboxed=0,.status=ProcessIsolationStatus.Unsupported};
}

fn process_platform_supervision_ready(c: ProcessPlatformCapabilities) i32 {
    if (c.platform != process_platform_linux() && c.platform != process_platform_darwin()) { return 0; }
    return (c.process_group == 1 && c.nonblocking_observation == 1 &&
        c.deadline_wait == 1 && c.fail_closed == 1) as i32;
}

// One source-level wait primitive.  Backends may use poll, epoll, kqueue, or a
// future equivalent, but callers receive only readable/timeout/error semantics.
fn process_platform_wait_readable(fd: i64, timeout_ms: i64) i32 {
    if (fd < 0 - 1 || fd > 2147483647 || timeout_ms < 0 || timeout_ms > 60000) { return 0 - 22; }
    return _zag_process_wait_readable(fd, timeout_ms) as i32;
}

// Normalize negative nonblocking read outcomes: 0=retry, 2=permanent error.
fn process_platform_read_disposition(code: i64) i32 {
    return _zag_process_read_disposition(code) as i32;
}
