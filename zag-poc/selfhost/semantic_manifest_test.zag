@import("parse.zag")
@import("sema.zag")
@import("semantic_manifest.zag")
fn mt(ok:i32,msg:[]u8,f:*i32)void{if(ok==0){_zag_println(msg);f.*=f.*+1;}}
fn manifest(src:[]u8)*SemanticManifest{let u:CompilationUnit=parse_compilation_unit_dir(src,".");let e:map.StringMap[i32]=analyze(u.decls);return semantic_manifest_build("app.zag",src,u.profile,u.decls,e,u.modules,u.imports);}
fn main()i32{let f:i32=0;
 let a:*SemanticManifest=manifest("pub struct Point { x:i32, y:i32 } pub fn api(x:i32) i32 { return x; } fn hidden() i32 { return 1; }");
 let private_edit:*SemanticManifest=manifest("pub struct Point { x:i32, y:i32 } pub fn api(x:i32) i32 { return x; } fn hidden() i32 { return 2; }");
 let signature_edit:*SemanticManifest=manifest("pub struct Point { x:i32, y:i32 } pub fn api(x:i64) i64 { return x; } fn hidden() i32 { return 1; }");
 let layout_edit:*SemanticManifest=manifest("pub struct Point { x:i64, y:i32 } pub fn api(x:i32) i32 { return x; } fn hidden() i32 { return 1; }");
 let effect_edit:*SemanticManifest=manifest("pub struct Point { x:i32, y:i32 } @io pub fn api(x:i32) i32 { return x; } fn hidden() i32 { return 1; }");
 mt(zagd_hash_equal(a.*.public_identity,private_edit.*.public_identity),"private body changed public identity",&f);
 mt(semantic_manifest_changed_decl_dependents(a.*.text,private_edit.*.text)==1,"body-only declaration edit not localized",&f);
 mt(1-zagd_hash_equal(a.*.public_identity,signature_edit.*.public_identity),"signature identity unchanged",&f);
 mt(1-zagd_hash_equal(a.*.layout_identity,layout_edit.*.layout_identity),"layout identity unchanged",&f);
 mt(1-zagd_hash_equal(a.*.effect_identity,effect_edit.*.effect_identity),"effect identity unchanged",&f);
 mt(zagd_word_at(a.*.text,0,"format")==1,"manifest format missing",&f);
 mt(semantic_manifest_decode(a.*.text).valid==1,"manifest validation failed",&f);
 mt(semantic_manifest_constant_count(a.*.text)==1,"proven constant-return fact missing",&f);
 mt(semantic_manifest_decode(_zag_str_concat(a.*.text,"corrupt")).valid==0,"trailing corruption accepted",&f);
 let cut:[]u8=a.*.text[0..a.*.text.len-2];mt(semantic_manifest_decode(cut).valid==0,"truncated manifest accepted",&f);
 let graph_unit:CompilationUnit=parse_compilation_unit_dir("pub fn root() i32 { return 0; }",".");push[ResolvedModule](&graph_unit.modules,ResolvedModule{.path="lib.zag",.source="pub fn lib() i32{return 0;}"});push[ResolvedImport](&graph_unit.imports,ResolvedImport{.importer="left.zag",.imported="lib.zag"});push[ResolvedImport](&graph_unit.imports,ResolvedImport{.importer="right.zag",.imported="lib.zag"});push[ResolvedImport](&graph_unit.imports,ResolvedImport{.importer="app.zag",.imported="left.zag"});push[ResolvedImport](&graph_unit.imports,ResolvedImport{.importer="app.zag",.imported="right.zag"});push[ResolvedImport](&graph_unit.imports,ResolvedImport{.importer="lib.zag",.imported="app.zag"});let graph_eff:map.StringMap[i32]=analyze(graph_unit.decls);let graph:*SemanticManifest=semantic_manifest_build("app.zag","pub fn root() i32 { return 0; }",graph_unit.profile,graph_unit.decls,graph_eff,graph_unit.modules,graph_unit.imports);mt(semantic_manifest_direct_dependents(graph.*.text,"lib.zag")==2,"direct diamond dependents wrong",&f);mt(semantic_manifest_transitive_dependents(graph.*.text,"lib.zag")==3,"transitive diamond/cycle closure wrong",&f);mt(semantic_manifest_transitive_dependents(_zag_str_concat(graph.*.text,"corrupt"),"lib.zag")==0,"corrupt graph accepted",&f);
 let calls:*SemanticManifest=manifest("fn leaf() i32{return 1;} fn mid() i32{return leaf();} fn top() i32{return mid();}");mt(semantic_manifest_transitive_callers(calls.*.text,"leaf")==2,"transitive callers wrong",&f);
 let calls_changed:*SemanticManifest=manifest("fn leaf() i32{return 1;} fn mid() i64{return 1;} fn top() i32{return mid();}");mt(semantic_manifest_changed_decl_dependents(calls.*.text,calls_changed.*.text)==2,"changed declaration closure wrong",&f);
 if(f==0){_zag_println("semantic manifest: pass=15 fail=0");}return f;}
