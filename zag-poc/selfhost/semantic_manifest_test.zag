@import("parse.zag")
@import("sema.zag")
@import("semantic_manifest.zag")
fn mt(ok:i32,msg:[]u8,f:*i32)void{if(ok==0){_zag_println(msg);f.*=f.*+1;}}
fn manifest(src:[]u8)*SemanticManifest{let u:CompilationUnit=parse_compilation_unit_dir(src,".");let e:map.StringMap[i32]=analyze(u.decls);return semantic_manifest_build("app.zag",src,u.profile,u.decls,e,u.modules,u.imports);}
fn main()i32{let f:i32=0;
 let a:*SemanticManifest=manifest("pub struct Point { x:i32, y:i32 } pub fn api(x:i32) i32 { return x; } fn hidden() i32 { return 1; }");
 let private_edit:*SemanticManifest=manifest("pub struct Point { x:i32, y:i32 } pub fn api(x:i32) i32 { return x; } fn hidden() i32 { return 2; }");
 let signature_edit:*SemanticManifest=manifest("pub struct Point { x:i32, y:i32 } pub fn api(x:i64) i64 { return x; } fn hidden() i32 { return 1; }");
 let layout_edit:*SemanticManifest=manifest("pub struct Point { x:i64, y:i32 } pub fn api(x:i32) i32 { return x; } fn hidden() i32 { return 1; }");
 let effect_edit:*SemanticManifest=manifest("pub struct Point { x:i32, y:i32 } @io pub fn api(x:i32) i32 { return x; } fn hidden() i32 { return 1; }");
 let borrow_contract:*SemanticManifest=manifest("pub fn api(x:@borrows *u8) void { }");
 let mutable_contract:*SemanticManifest=manifest("pub fn api(x:@borrows_mut *u8) void { }");
 let comment_edit:*SemanticManifest=manifest("// formatting only\npub struct Point { x:i32, y:i32 } pub fn api(x:i32) i32 { return x; } fn hidden() i32 { return 1; }");
 mt(zagd_hash_equal(a.*.public_identity,private_edit.*.public_identity),"private body changed public identity",&f);
 mt(semantic_manifest_changed_decl_dependents(a.*.text,private_edit.*.text)==1,"body-only declaration edit not localized",&f);
 mt(1-zagd_hash_equal(a.*.public_identity,signature_edit.*.public_identity),"signature identity unchanged",&f);
 mt(1-zagd_hash_equal(a.*.layout_identity,layout_edit.*.layout_identity),"layout identity unchanged",&f);
 mt(1-zagd_hash_equal(a.*.effect_identity,effect_edit.*.effect_identity),"effect identity unchanged",&f);
 mt(1-zagd_hash_equal(borrow_contract.*.public_identity,mutable_contract.*.public_identity),"parameter lifetime contract missing from public identity",&f);
 let ci:SemanticInvalidation=semantic_manifest_invalidation(a.*.text,comment_edit.*.text);mt(ci.comment_only==1&&ci.codegen_invalidated==0,"comment edit invalidated codegen",&f);
 let pi:SemanticInvalidation=semantic_manifest_invalidation(a.*.text,private_edit.*.text);mt(pi.declaration_dependents==1&&pi.codegen_invalidated==1&&pi.layout_changed==0,"private invalidation not selective",&f);
 let li:SemanticInvalidation=semantic_manifest_invalidation(a.*.text,layout_edit.*.text);mt(li.layout_changed==1&&li.codegen_invalidated==1,"layout invalidation missing",&f);
 let aid:ZagdHash=semantic_manifest_artifact_identity(a.*.text,"1","x86");mt(zagd_hash_equal(aid,semantic_manifest_artifact_identity(comment_edit.*.text,"1","x86"))==1&&zagd_hash_equal(aid,semantic_manifest_artifact_identity(a.*.text,"2","x86"))==0,"artifact identity qualification failed",&f);
 let witnesses:*SemanticManifest=manifest("struct Pair { x:i32, y:i32 } fn id(x:i32) i32{return x;} fn probe(xs:[]i32,p:Pair) i32 { let a=xs[0]; let b=p.x; let c=id(a as i32); if(c>0){let d=c+1;} while(a<2){a=a+1;} return b; }");
 mt(sm_text_has(witnesses.*.text,"expr_fact=probe\tlet.a\ttype=i32\ttype_basis=typed\teffect=0\teffect_basis=sema"),"index witness missing",&f);
 mt(sm_text_has(witnesses.*.text,"expr_fact=probe\tlet.b\ttype=i32\ttype_basis=typed"),"field witness missing",&f);
 mt(sm_text_has(witnesses.*.text,"expr_fact=probe\tlet.c\ttype=i32\ttype_basis=typed"),"call/cast witness missing",&f);
 mt(sm_text_has(witnesses.*.text,"expr_fact=probe\tif.condition\ttype=bool\ttype_basis=typed")&&sm_text_has(witnesses.*.text,"expr_fact=probe\twhile.condition\ttype=bool\ttype_basis=typed"),"nested control witness missing",&f);
 mt(zagd_word_at(a.*.text,0,"format")==1,"manifest format missing",&f);
 mt(semantic_manifest_decode(a.*.text).valid==1,"manifest validation failed",&f);
 mt(semantic_manifest_decode(a.*.text).graph_complete==1,"exact struct origins did not produce a complete graph",&f);
 mt(sm_text_has(a.*.text,"decl_module_edge=app.zag\tPoint")&&sm_text_has(a.*.text,"layout_node=Point\t")&&sm_text_has(a.*.text,"decl_type_edge=Point\ti32"),"struct graph edges missing",&f);
 mt(semantic_manifest_constant_count(a.*.text)==1,"proven constant-return fact missing",&f);
 let arithmetic:*SemanticManifest=manifest("fn folded() i32 { return (2 + 3) * 4; }");mt(semantic_manifest_constant_count(arithmetic.*.text)==1,"bounded arithmetic equivalence missing",&f);
 mt(semantic_manifest_decode(_zag_str_concat(a.*.text,"corrupt")).valid==0,"trailing corruption accepted",&f);
 let cut:[]u8=a.*.text[0..a.*.text.len-2];mt(semantic_manifest_decode(cut).valid==0,"truncated manifest accepted",&f);
 let graph_unit:CompilationUnit=parse_compilation_unit_dir("pub fn root() i32 { return 0; }",".");push[ResolvedModule](&graph_unit.modules,ResolvedModule{.path="lib.zag",.source="pub fn lib() i32{return 0;}"});push[ResolvedImport](&graph_unit.imports,ResolvedImport{.importer="left.zag",.imported="lib.zag"});push[ResolvedImport](&graph_unit.imports,ResolvedImport{.importer="right.zag",.imported="lib.zag"});push[ResolvedImport](&graph_unit.imports,ResolvedImport{.importer="app.zag",.imported="left.zag"});push[ResolvedImport](&graph_unit.imports,ResolvedImport{.importer="app.zag",.imported="right.zag"});push[ResolvedImport](&graph_unit.imports,ResolvedImport{.importer="lib.zag",.imported="app.zag"});let graph_eff:map.StringMap[i32]=analyze(graph_unit.decls);let graph:*SemanticManifest=semantic_manifest_build("app.zag","pub fn root() i32 { return 0; }",graph_unit.profile,graph_unit.decls,graph_eff,graph_unit.modules,graph_unit.imports);mt(semantic_manifest_direct_dependents(graph.*.text,"lib.zag")==2,"direct diamond dependents wrong",&f);mt(semantic_manifest_transitive_dependents(graph.*.text,"lib.zag")==3,"transitive diamond/cycle closure wrong",&f);mt(semantic_manifest_transitive_dependents(_zag_str_concat(graph.*.text,"corrupt"),"lib.zag")==0,"corrupt graph accepted",&f);
 graph_unit.modules.data[0].source="// comment-only imported edit\npub fn lib() i32{return 0;}";let graph_comment:*SemanticManifest=semantic_manifest_build("app.zag","pub fn root() i32 { return 0; }",graph_unit.profile,graph_unit.decls,graph_eff,graph_unit.modules,graph_unit.imports);mt(zagd_hash_equal(semantic_manifest_decode(graph.*.text).graph_identity,semantic_manifest_decode(graph_comment.*.text).graph_identity)==1&&semantic_manifest_module_stale(graph.*.text,"lib.zag",zagd_content_hash(graph_unit.modules.data[0].source))==1,"raw module freshness leaked into semantic graph identity",&f);
 let calls:*SemanticManifest=manifest("fn leaf() i32{return 1;} fn mid() i32{return leaf();} fn top() i32{return mid();}");mt(semantic_manifest_transitive_callers(calls.*.text,"leaf")==2,"transitive callers wrong",&f);
 let nested_calls:*SemanticManifest=manifest("struct Box { value:i32 } fn leaf() i32{return 1;} fn from_switch(x:i32) i32{return switch(x){1=>leaf() else=>0};} fn from_struct() i32 { let b=Box{.value=leaf()}; return b.value; }");mt(semantic_manifest_transitive_callers(nested_calls.*.text,"leaf")==2,"switch/aggregate call edges missing",&f);
 let calls_changed:*SemanticManifest=manifest("fn leaf() i32{return 1;} fn mid() i64{return 1;} fn top() i32{return mid();}");mt(semantic_manifest_changed_decl_dependents(calls.*.text,calls_changed.*.text)==2,"changed declaration closure wrong",&f);
 let buffer_pair:*SemanticManifest=manifest("fn buffers() i32 { let first:[]f32=zalloc(4); first[0]=1.0; zfree(first); let second:[]f32=zalloc(8); let observed=second.len; zfree(second); return observed; }");
 let buffer_facts:SemanticBufferLifetimeFacts=semantic_manifest_buffer_lifetime_facts(buffer_pair.*.text);
 mt(buffer_facts.valid==1&&buffer_facts.pairs==1&&buffer_facts.reusable_bytes==32,"exact ordered raw-buffer lifetime fact missing",&f);
 mt(sm_text_has(buffer_pair.*.text,"basis=proven-foreground-ast\tautomatic=0\tsource_changes=0\texecutable_authority=0"),"buffer lifetime authority boundary missing",&f);
 let buffer_comment:*SemanticManifest=manifest("fn buffers() i32 { /* comment only */ let first:[]f32=zalloc(4); first[0]=1.0; zfree(first); let second:[]f32=zalloc(8); let observed=second.len; zfree(second); return observed; }");
 let comment_facts:SemanticBufferLifetimeFacts=semantic_manifest_buffer_lifetime_facts(buffer_comment.*.text);
 mt(comment_facts.valid==1&&comment_facts.pairs==buffer_facts.pairs&&comment_facts.reusable_bytes==buffer_facts.reusable_bytes,"comment-only buffer facts changed",&f);
 let buffer_alias:*SemanticManifest=manifest("fn alias() i32 { let first:[]f32=zalloc(4); let copy=first; zfree(first); let second:[]f32=zalloc(8); zfree(second); return 0; }");
 mt(semantic_manifest_buffer_lifetime_facts(buffer_alias.*.text).pairs==0,"whole-buffer alias was claimed non-overlapping",&f);
 let buffer_call:*SemanticManifest=manifest("fn expose(value:[]f32) void {} fn caller() i32 { let first:[]f32=zalloc(4); expose(first); zfree(first); let second:[]f32=zalloc(8); zfree(second); return 0; }");
 mt(semantic_manifest_buffer_lifetime_facts(buffer_call.*.text).pairs==0,"whole-buffer call exposure was claimed non-overlapping",&f);
 let buffer_escape:*SemanticManifest=manifest("fn escape() []f32 { let first:[]f32=zalloc(4); return first; zfree(first); let second:[]f32=zalloc(8); zfree(second); return second; }");
 mt(semantic_manifest_buffer_lifetime_facts(buffer_escape.*.text).pairs==0,"escaping return was claimed non-overlapping",&f);
 let buffer_missing_free:*SemanticManifest=manifest("fn missing() i32 { let first:[]f32=zalloc(4); let second:[]f32=zalloc(8); zfree(second); return 0; }");
 mt(semantic_manifest_buffer_lifetime_facts(buffer_missing_free.*.text).pairs==0,"missing free was claimed non-overlapping",&f);
 let buffer_overlap:*SemanticManifest=manifest("fn overlap() i32 { let first:[]f32=zalloc(4); let second:[]f32=zalloc(8); zfree(first); zfree(second); return 0; }");
 mt(semantic_manifest_buffer_lifetime_facts(buffer_overlap.*.text).pairs==0,"overlapping lifetimes were claimed disjoint",&f);
 let buffer_after_free:*SemanticManifest=manifest("fn after_free() i32 { let first:[]f32=zalloc(4); zfree(first); let observed=first.len; let second:[]f32=zalloc(8); zfree(second); return observed; }");
 mt(semantic_manifest_buffer_lifetime_facts(buffer_after_free.*.text).pairs==0,"use after free was claimed non-overlapping",&f);
 let buffer_double_free:*SemanticManifest=manifest("fn double_free() i32 { let first:[]f32=zalloc(4); zfree(first); zfree(first); let second:[]f32=zalloc(8); zfree(second); return 0; }");
 mt(semantic_manifest_buffer_lifetime_facts(buffer_double_free.*.text).pairs==0,"duplicate free was claimed non-overlapping",&f);
 let compact_src:[]u8="pub fn leaf() i32{return 1;} fn mid() i32{return leaf();} fn top() i32{return mid();}";
 let compact_unit:CompilationUnit=parse_compilation_unit_dir(compact_src,".");let compact_eff:map.StringMap[i32]=analyze(compact_unit.decls);
 let detailed:*SemanticManifest=semantic_manifest_build("app.zag",compact_src,compact_unit.profile,compact_unit.decls,compact_eff,compact_unit.modules,compact_unit.imports);
 let compact:*SemanticManifest=semantic_manifest_build_compact("app.zag",compact_src,compact_unit.profile,compact_unit.decls,compact_eff,compact_unit.modules,compact_unit.imports);
 let detailed_view:SemanticManifestView=semantic_manifest_decode(detailed.*.text);let compact_view:SemanticManifestView=semantic_manifest_decode(compact.*.text);
 mt(compact_view.valid==1&&compact_view.graph_complete==1&&@strEq(smf_value(compact.*.text,"detail_level"),"compact")&&@strEq(smf_value(detailed.*.text,"detail_level"),"full"),"compact exact graph detail level is not complete",&f);
 mt(zagd_hash_equal(detailed_view.graph_identity,compact_view.graph_identity)==1&&zagd_hash_equal(detailed.*.public_identity,compact.*.public_identity)==1&&zagd_hash_equal(detailed.*.effect_identity,compact.*.effect_identity)==1&&zagd_hash_equal(detailed.*.layout_identity,compact.*.layout_identity)==1,"compact identities differ from detailed manifest",&f);
 mt(sm_text_has(compact.*.text,"module_node=app.zag\t")&&semantic_manifest_transitive_callers(compact.*.text,"leaf")==2,"compact raw-module/call graph is incomplete",&f);
 mt(sm_text_has(compact.*.text,"expr_fact=")==0&&sm_text_has(compact.*.text,"value_type=")==0&&compact.*.text.len<detailed.*.text.len,"compact manifest retained verbose expression witnesses",&f);
 if(f==0){_zag_println("semantic manifest: pass=34 fail=0");}return f;}
