// Exact-byte artifact origin and custody, independent of advisory manifests.
// "sealed" is a producer-declared classification: the codec checks that all
// listed inputs also claim sealed and that the custody links are continuous.
// It does not resolve input provenance records or prove their classification.
// A trusted external SHA pin detects changes to this exact record. Computing
// a pin from an untrusted record only checks internal consistency. Neither a
// pin nor a custody hash authenticates an actor/generator or proves an actual
// transfer/execution. Authentication and recursive input validation belong to
// the integrating authority; there are no signatures or credentials here.
@import("evidence_codec.zag")

struct ArtifactInput { name:[]u8, digest:[]u8, provenance:[]u8, kind:[]u8 }
struct ArtifactCustody { from:[]u8, to:[]u8, action:[]u8 }

fn ap_kind(kind:[]u8)i32{return (ev_equal(kind,"sealed")==1||ev_equal(kind,"synthetic")==1) as i32;}
fn ap_link(previous:[]u8,artifact:[]u8,from:[]u8,to:[]u8,action:[]u8,index:i32)[]u8{
    let f:ArrayList[[]u8]=make[[]u8](7);ev_add(&f,"zag-custody-link-v1");ev_add(&f,previous);
    ev_add(&f,artifact);ev_add(&f,from);ev_add(&f,to);ev_add(&f,action);ev_add_int(&f,index);
    let encoded:[]u8=ev_encode(f);let result:[]u8=ev_hash(encoded);
    ev_fields_free(&f);_zag_str_free(encoded);return result;
}
// Record fields: schema, artifact SHA, generator label, generator image SHA,
// kind, input count, (name, content SHA, provenance SHA, kind)*,
// custody count, (from, to, action, previous link, link SHA)*.
fn artifact_provenance_valid(r:EvidenceRecord)i32{
    if(r.valid!=1||r.fields.len<7||ev_equal(ev_get(r,0),"zag-artifact-provenance-v1")==0||
        ev_digest_ok(ev_get(r,1))==0||ev_get(r,2).len==0||ev_digest_ok(ev_get(r,3))==0||ap_kind(ev_get(r,4))==0){return 0;}
    let n:i32=ev_uint(ev_get(r,5),256);if(n<0||r.fields.len<7+n*4){return 0;}
    let i:i32=0;while(i<n){let p:i32=6+i*4;
        if(ev_get(r,p).len==0||ev_digest_ok(ev_get(r,p+1))==0||ev_digest_ok(ev_get(r,p+2))==0||ap_kind(ev_get(r,p+3))==0){return 0;}
        if(ev_equal(ev_get(r,4),"sealed")==1&&ev_equal(ev_get(r,p+3),"sealed")==0){return 0;}
        let j:i32=0;while(j<i){if(ev_equal(ev_get(r,p),ev_get(r,6+j*4))==1){return 0;}j=j+1;}i=i+1;
    }
    let base:i32=6+n*4;let count:i32=ev_uint(ev_get(r,base),256);
    if(count<1||r.fields.len!=base+1+count*5){return 0;}
    let previous:[]u8=ev_get(r,1);let owner:[]u8=ev_get(r,2);i=0;
    while(i<count){let p:i32=base+1+i*5;
        if(ev_equal(ev_get(r,p),owner)==0||ev_get(r,p+1).len==0||ev_get(r,p+2).len==0||ev_equal(ev_get(r,p+3),previous)==0){return 0;}
        let want:[]u8=ap_link(previous,ev_get(r,1),owner,ev_get(r,p+1),ev_get(r,p+2),i);
        let ok:i32=ev_equal(want,ev_get(r,p+4));_zag_str_free(want);if(ok==0){return 0;}
        previous=ev_get(r,p+4);owner=ev_get(r,p+1);i=i+1;
    }return 1;
}
fn artifact_provenance_encode(artifact:[]u8,generator:[]u8,generator_image:[]u8,kind:[]u8,inputs:ArrayList[ArtifactInput],custody:ArrayList[ArtifactCustody])[]u8{
    if(inputs.len>256||custody.len>256||generator_image.len<=0){return ev_empty();}
    let f:ArrayList[[]u8]=make[[]u8](16);ev_add(&f,"zag-artifact-provenance-v1");push[[]u8](&f,ev_hash(artifact));
    ev_add(&f,generator);push[[]u8](&f,ev_hash(generator_image));ev_add(&f,kind);ev_add_int(&f,inputs.len);
    let i:i32=0;while(i<inputs.len){let x:ArtifactInput=inputs.data[i];ev_add(&f,x.name);ev_add(&f,x.digest);ev_add(&f,x.provenance);ev_add(&f,x.kind);i=i+1;}
    ev_add_int(&f,custody.len);let previous:[]u8=f.data[1];i=0;
    while(i<custody.len){let x:ArtifactCustody=custody.data[i];let link:[]u8=ap_link(previous,f.data[1],x.from,x.to,x.action,i);
        ev_add(&f,x.from);ev_add(&f,x.to);ev_add(&f,x.action);ev_add(&f,previous);push[[]u8](&f,link);previous=link;i=i+1;}
    let r:EvidenceRecord=EvidenceRecord{.fields=f,.valid=1};let result:[]u8=ev_empty();
    if(artifact_provenance_valid(r)==1){_zag_str_free(result);result=ev_encode(f);}ev_fields_free(&f);return result;
}
fn artifact_provenance_verify(text:[]u8,pin:[]u8,artifact:[]u8,generator_image:[]u8)i32{
    let r:EvidenceRecord=ev_decode(text,pin);let ok:i32=artifact_provenance_valid(r);
    if(ok==1){ok=(ev_matches(artifact,ev_get(r,1))==1&&ev_matches(generator_image,ev_get(r,3))==1) as i32;}
    ev_fields_free(&r.fields);return ok;
}
