@import("zagd_identity.zag")

extern fn _zag_allocator_live_bytes() i64

fn zlit(ok:i32,message:[]u8,failures:*i32)void{if(ok==0){_zag_println(message);failures.*=failures.*+1;}}
fn zlit_pid()i64{return _zag_raw_syscall(39,0,0,0,0,0,0);}

fn main()i32{
    let failures:i32=0;
    zlit(zli_parse_pid("12\n34\n")==12,"identity: valid PID rejected",&failures);
    zlit(zli_parse_pid("12x\n34\n")<0,"identity: malformed PID prefix accepted",&failures);
    zlit(zli_lock_start("12\n34\n").len==2,"identity: valid start token rejected",&failures);
    zlit(zli_lock_start("12\n34\nforged").len==0,"identity: trailing forged lock data accepted",&failures);
    let root:[]u8="/tmp/zagd root $special";
    let cmd:ArrayList[u8]=zagd_text(96);zagd_text_append(&cmd,"/tmp/zagd\0--root\0");zagd_text_append(&cmd,root);zagd_text_append(&cmd,"\0--mode\0light\0");
    zlit(zli_cmdline_matches(cmd.data[0..cmd.len],root)==1,"identity: root with spaces/special bytes rejected",&failures);
    let duplicate:ArrayList[u8]=zagd_text(cmd.len+64);zagd_text_append(&duplicate,cmd.data[0..cmd.len]);zagd_text_append(&duplicate,"--root\0");zagd_text_append(&duplicate,root);zagd_text_append_byte(&duplicate,0);
    zlit(zli_cmdline_matches(duplicate.data[0..duplicate.len],root)==0,"identity: duplicate root flag accepted",&failures);
    let base_live:i64=_zag_allocator_live_bytes();
    let live:i64=zlit_pid();let live_record:[]u8=zagd_lock_record(live);
    zlit(live_record.len>0,"identity: could not obtain current process start token",&failures);
    let held_live:i64=_zag_allocator_live_bytes();
    // This test process is live but is not zagd: a matching PID/start token
    // must never make it the owner of a project singleton.
    zlit(zagd_lock_identity_alive(live_record,"/tmp/zagd root $special")==0,"identity: unrelated live PID accepted as zagd",&failures);
    zlit(_zag_allocator_live_bytes()==held_live,"identity: liveness probe leaked path or /proc buffers",&failures);
    let forged:ArrayList[u8]=zagd_text(32);zagd_text_append_i64(&forged,live);zagd_text_append(&forged,"\n1\n");
    let forged_live:i64=_zag_allocator_live_bytes();
    zlit(zagd_lock_identity_alive(forged.data[0..forged.len],".")==0,"identity: forged start token accepted",&failures);
    zlit(_zag_allocator_live_bytes()==forged_live,"identity: forged liveness probe leaked buffers",&failures);
    zagd_text_free(live_record);zlit(_zag_allocator_live_bytes()==forged_live-(held_live-base_live),"identity: lock-record storage was not released",&failures);
    free[u8](&forged);free[u8](&duplicate);free[u8](&cmd);
    if(failures==0){_zag_println("zagd identity: pass=12 fail=0");}return failures;
}
