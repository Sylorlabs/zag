@import("zagd_saturation.zag")
fn zsat_expect(ok:i32,label:[]u8,f:*i32)void{if(ok==1){return;}_zag_eprintln(_zag_str_concat("zagd saturation test: ",label));f.*=f.*+1;}
fn main()i32{let f:i32=0;let text:[]u8="format=zagd-typed-region-v1\ntype=u4\nvariables=1\neffects=pure\nexpr=x 0 +\n";let r:ZagdSaturationRegion=zagd_saturation_extract(text);zsat_expect(r.valid==1&&r.bits==4&&r.variables==1,"extract",&f);let a:ZagdSaturationResult=zagd_saturation_run(r,"compiler-v1","native-v1",20000000);let b:ZagdSaturationResult=zagd_saturation_run(r,"compiler-v1","native-v1",20000000);zsat_expect(a.ok==1&&a.cost==1&&a.assignments==16&&a.candidates>1,"minimum",&f);zsat_expect(b.ok==1&&@strEq(a.generated,b.generated)&&@strEq(a.proof_record,b.proof_record),"deterministic",&f);let c:ScriptAutoConfig=ScriptAutoConfig{.bits=4,.variables=1,.work_budget=20000000,.source_id=text,.compiler_id="compiler-v1",.target_id="native-v1"};let p:ScriptAutoProof=script_auto_check("x 0 +","x",c);zsat_expect(p.ok==1&&p.equivalent==1&&p.checked==16,"all-domain proof",&f);let pair:[]u8="format=zagd-typed-region-v1\ntype=u4\nvariables=2\neffects=pure\nexpr=x y +\n";let pr:ZagdSaturationResult=zagd_saturation_run(zagd_saturation_extract(pair),"compiler-v1","native-v1",20000000);zsat_expect(pr.ok==1&&pr.assignments==256,"two-input domain",&f);zsat_expect(zagd_saturation_extract("format=zagd-typed-region-v1\ntype=f32\nvariables=1\neffects=pure\nexpr=x\n").valid==0,"float rejects",&f);zsat_expect(zagd_saturation_extract("format=zagd-typed-region-v1\ntype=u4\nvariables=1\neffects=reads\nexpr=x\n").valid==0,"effects reject",&f);let tiny:ZagdSaturationResult=zagd_saturation_run(r,"compiler-v1","native-v1",1);zsat_expect(tiny.ok==0&&@strEq(tiny.error,"work_budget_exceeded"),"budget reject",&f);zagd_saturation_result_free(&pr);zagd_saturation_result_free(&b);zagd_saturation_result_free(&a);if(f==0){_zag_println("zagd bounded equality saturation: PASS");}return f;}
