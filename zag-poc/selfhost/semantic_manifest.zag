// Foreground-compiler semantic manifest. Only successful parse/type/effect
// checking may publish this advisory record. It never authorizes codegen.
@import("zagd.zag")
@import("semantic_manifest_format.zag")
@import("astjson.zag")

struct SemanticManifest { text:[]u8, public_identity:ZagdHash, effect_identity:ZagdHash, layout_identity:ZagdHash }

fn sm_add(h:ZagdHash,s:[]u8)ZagdHash{return zagd_hash_extend(h,_zag_str_concat(s,"\n"));}
fn sm_param_text(p:Param)[]u8{return _zag_str_concat(p.name,_zag_str_concat(":",_zag_str_concat(p.pty,_zag_str_concat("!",_zag_str_concat(p.eff,_zag_str_concat("@",_zag_i64_to_str(p.calign)))))));}
fn sm_hash_fields(h:ZagdHash)[]u8{return _zag_str_concat(_zag_i64_to_str(h.first),_zag_str_concat(",",_zag_str_concat(_zag_i64_to_str(h.second),_zag_str_concat(",",_zag_i64_to_str(h.bytes)))));}
fn sm_text_has(text:[]u8,needle:[]u8)i32{let i:i32=0;while(i+needle.len<=text.len){let j:i32=0;while(j<needle.len&&text[i+j]==needle[j]){j=j+1;}if(j==needle.len){return 1;}i=i+1;}return 0;}
struct SmConst { value:i64, valid:i32 }
fn sm_const(n:*Node)SmConst{let out:SmConst=SmConst{.value=0,.valid=0};switch(n.*){.ilit=>|x|{let v:i64=_zag_str_to_i64(x.text);if(v>=(0-1000000)&&v<=1000000){out.value=v;out.valid=1;}}.un=>|u|{let a:SmConst=sm_const(u.e);if(a.valid==1&&@strEq(u.op,"-")&&a.value!=(0-1000000)){out.value=0-a.value;out.valid=1;}}.bin=>|b|{let a:SmConst=sm_const(b.l);let c:SmConst=sm_const(b.r);if(a.valid==1&&c.valid==1){if(@strEq(b.op,"+")){out.value=a.value+c.value;out.valid=1;}else if(@strEq(b.op,"-")){out.value=a.value-c.value;out.valid=1;}else if(@strEq(b.op,"*")){out.value=a.value*c.value;out.valid=1;}else if(@strEq(b.op,"/")&&c.value!=0){out.value=a.value/c.value;out.valid=1;}else if(@strEq(b.op,"%")&&c.value!=0){out.value=a.value%c.value;out.valid=1;}if(out.value<(0-1000000)||out.value>1000000){out.valid=0;}}}else=>{}}return out;}
fn sm_literal_node(n:*Node)i32{return sm_const(n).valid;}
fn sm_constant_return(f:FnDecl)i32{if(len[*Node](f.body)!=1){return 0;}let result:i32=0;let n:*Node=get[*Node](f.body,0);switch(n.*){.ret=>|r|{if(r.has_expr==1){result=sm_literal_node(r.expr);}}else=>{}}return result;}
fn sm_calls_expr(caller:[]u8,n:*Node,eff:map.StringMap[i32],lines:*[]u8)void{switch(n.*){.call=>|c|{let name:[]u8=callee_name(c.callee);if(name.len>0){lines.*=_zag_str_concat(lines.*,_zag_str_concat("call_edge=",_zag_str_concat(caller,_zag_str_concat("\t",_zag_str_concat(name,"\n")))));}sm_calls_expr(caller,c.callee,eff,lines);let i:i32=0;while(i<len[*Node](c.args)){sm_calls_expr(caller,get[*Node](c.args,i),eff,lines);i=i+1;}}.bin=>|b|{sm_calls_expr(caller,b.l,eff,lines);sm_calls_expr(caller,b.r,eff,lines);}.un=>|u|sm_calls_expr(caller,u.e,eff,lines),.idx=>|x|{sm_calls_expr(caller,x.base,eff,lines);sm_calls_expr(caller,x.idx,eff,lines);}.fld=>|x|sm_calls_expr(caller,x.base,eff,lines),.slice_=>|s|{sm_calls_expr(caller,s.base,eff,lines);sm_calls_expr(caller,s.lo,eff,lines);if(s.has_hi==1){sm_calls_expr(caller,s.hi,eff,lines);}}.cast_=>|c|sm_calls_expr(caller,c.expr,eff,lines),else=>{}}}
fn sm_calls_body(caller:[]u8,body:ArrayList[*Node],eff:map.StringMap[i32],lines:*[]u8)void{let i:i32=0;while(i<len[*Node](body)){let n:*Node=get[*Node](body,i);switch(n.*){.let_=>|l|{if(l.has_init==1){sm_calls_expr(caller,l.expr,eff,lines);}}.ret=>|r|{if(r.has_expr==1){sm_calls_expr(caller,r.expr,eff,lines);}}.if_=>|x|{sm_calls_expr(caller,x.cond,eff,lines);sm_calls_body(caller,x.then_body,eff,lines);sm_calls_body(caller,x.els_body,eff,lines);}.while_=>|w|{sm_calls_expr(caller,w.cond,eff,lines);sm_calls_body(caller,w.body,eff,lines);}.unsafe_=>|u|sm_calls_body(caller,u.body,eff,lines),.assign=>|a|{sm_calls_expr(caller,a.target,eff,lines);sm_calls_expr(caller,a.expr,eff,lines);}.estmt=>|e|sm_calls_expr(caller,e.expr,eff,lines),else=>{}}i=i+1;}}

fn semantic_manifest_build(module_path:[]u8,source:[]u8,profile:ModuleProfile,decls:ArrayList[*Node],eff:map.StringMap[i32],modules:ArrayList[ResolvedModule],imports:ArrayList[ResolvedImport])*SemanticManifest{
    let pubh:ZagdHash=zagd_hash_empty();let effh:ZagdHash=zagd_hash_empty();let layh:ZagdHash=zagd_hash_empty();let lines:[]u8="";
    let i:i32=0;while(i<len[*Node](decls)){let node:*Node=get[*Node](decls,i);switch(node.*){
        .fn_decl=>|f|{
            let sig:[]u8=_zag_str_concat("fn ",f.name);let j:i32=0;while(j<len[Param](f.params)){sig=_zag_str_concat(sig,_zag_str_concat("|",sm_param_text(get[Param](f.params,j))));j=j+1;}sig=_zag_str_concat(sig,_zag_str_concat("->",_zag_str_concat(f.ret,_zag_str_concat("!",f.ret_eff))));
            let mask:i32=map.get[i32](eff,f.name) orelse 0;let canonical:ArrayList[u8]=make[u8](128);aj_node(&canonical,node);let declid:ZagdHash=zagd_content_hash(canonical.data[0..canonical.len]);let decl_line:[]u8=_zag_str_concat("decl_fn=",f.name);decl_line=_zag_str_concat(decl_line,_zag_str_concat("\t",sm_hash_fields(declid)));decl_line=_zag_str_concat(decl_line,_zag_str_concat("\tline=",_zag_i64_to_str(f.line)));decl_line=_zag_str_concat(decl_line,_zag_str_concat("\teffect=",_zag_str_concat(_zag_i64_to_str(mask),"\n")));lines=_zag_str_concat(lines,decl_line);
            let call_lines:[]u8="";sm_calls_body(f.name,f.body,eff,&call_lines);let leaf:i32=(call_lines.len==0) as i32;let constant:i32=sm_constant_return(f);let fact:[]u8=_zag_str_concat("fact_fn=",f.name);fact=_zag_str_concat(fact,_zag_str_concat("\teffect_free=",_zag_i64_to_str((mask==0) as i32)));fact=_zag_str_concat(fact,_zag_str_concat("\tleaf=",_zag_i64_to_str(leaf)));fact=_zag_str_concat(fact,_zag_str_concat("\tconstant_return=",_zag_i64_to_str(constant)));fact=_zag_str_concat(fact,_zag_str_concat("\talloc=",_zag_i64_to_str(mask&1)));fact=_zag_str_concat(fact,_zag_str_concat("\tio=",_zag_i64_to_str((mask&4)/4)));fact=_zag_str_concat(fact,"\n");lines=_zag_str_concat(lines,fact);lines=_zag_str_concat(lines,call_lines);
            if(f.is_pub==1){pubh=sm_add(pubh,sig);effh=sm_add(effh,_zag_str_concat(f.name,_zag_str_concat("=",_zag_i64_to_str(mask))));lines=_zag_str_concat(lines,_zag_str_concat("public_fn=",_zag_str_concat(sig,_zag_str_concat("\teffect=",_zag_str_concat(_zag_i64_to_str(mask),"\n")))));}
        }
        .struct_=>|s|{if(s.is_pub==1){let shape:[]u8=_zag_str_concat("struct ",s.name);let j:i32=0;while(j<len[Param](s.fields)){shape=_zag_str_concat(shape,_zag_str_concat("|",sm_param_text(get[Param](s.fields,j))));j=j+1;}pubh=sm_add(pubh,shape);layh=sm_add(layh,shape);lines=_zag_str_concat(lines,_zag_str_concat("public_layout=",_zag_str_concat(shape,"\n")));}}
        else=>{}
    }i=i+1;}
    let root:ZagdHash=zagd_content_hash(source);let profile_name:[]u8="strict";if(profile==ModuleProfile.script){profile_name="script";}
    let body:[]u8="format=zag-semantic-manifest-v1\nadvisory=true\nexecutable_authority=false\ncomplete=true\n";
    body=_zag_str_concat(body,_zag_str_concat("module=",_zag_str_concat(module_path,"\n")));body=_zag_str_concat(body,_zag_str_concat("profile=",_zag_str_concat(profile_name,"\n")));body=_zag_str_concat(body,_zag_str_concat("source=",_zag_str_concat(sm_hash_fields(root),"\n")));body=_zag_str_concat(body,_zag_str_concat("public=",_zag_str_concat(sm_hash_fields(pubh),"\n")));body=_zag_str_concat(body,_zag_str_concat("effects=",_zag_str_concat(sm_hash_fields(effh),"\n")));body=_zag_str_concat(body,_zag_str_concat("layouts=",_zag_str_concat(sm_hash_fields(layh),"\n")));body=_zag_str_concat(body,lines);
    i=0;while(i<len[ResolvedModule](modules)){let m:ResolvedModule=get[ResolvedModule](modules,i);let name:[]u8=m.path;if(@strEq(name,"<root>")){name=module_path;}body=_zag_str_concat(body,_zag_str_concat("module_node=",_zag_str_concat(name,_zag_str_concat("\t",_zag_str_concat(sm_hash_fields(zagd_content_hash(m.source)),"\n")))));i=i+1;}i=0;while(i<len[ResolvedImport](imports)){let edge:ResolvedImport=get[ResolvedImport](imports,i);let from:[]u8=edge.importer;if(@strEq(from,"<root>")){from=module_path;}body=_zag_str_concat(body,_zag_str_concat("import_edge=",_zag_str_concat(from,_zag_str_concat("\t",_zag_str_concat(edge.imported,"\n")))));i=i+1;}
    let sum:ZagdHash=zagd_content_hash(body);let text:[]u8=_zag_str_concat(body,_zag_str_concat("checksum=",_zag_str_concat(sm_hash_fields(sum),"\n")));
    return new(SemanticManifest{.text=text,.public_identity=pubh,.effect_identity=effh,.layout_identity=layh});
}
