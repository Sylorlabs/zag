// Foreground-compiler semantic manifest. Only successful parse/type/effect
// checking may publish this advisory record. It never authorizes codegen.
@import("zagd.zag")
@import("semantic_manifest_format.zag")

struct SemanticManifest { text:[]u8, public_identity:ZagdHash, effect_identity:ZagdHash, layout_identity:ZagdHash }

fn sm_add(h:ZagdHash,s:[]u8)ZagdHash{return zagd_hash_extend(h,_zag_str_concat(s,"\n"));}
fn sm_param_text(p:Param)[]u8{return _zag_str_concat(p.name,_zag_str_concat(":",_zag_str_concat(p.pty,_zag_str_concat("!",_zag_str_concat(p.eff,_zag_str_concat("@",_zag_i64_to_str(p.calign)))))));}
fn sm_hash_fields(h:ZagdHash)[]u8{return _zag_str_concat(_zag_i64_to_str(h.first),_zag_str_concat(",",_zag_str_concat(_zag_i64_to_str(h.second),_zag_str_concat(",",_zag_i64_to_str(h.bytes)))));}

fn semantic_manifest_build(module_path:[]u8,source:[]u8,profile:ModuleProfile,decls:ArrayList[*Node],eff:map.StringMap[i32],modules:ArrayList[ResolvedModule],imports:ArrayList[ResolvedImport])*SemanticManifest{
    let pubh:ZagdHash=zagd_hash_empty();let effh:ZagdHash=zagd_hash_empty();let layh:ZagdHash=zagd_hash_empty();let lines:[]u8="";
    let i:i32=0;while(i<len[*Node](decls)){let node:*Node=get[*Node](decls,i);switch(node.*){
        .fn_decl=>|f|{if(f.is_pub==1){let sig:[]u8=_zag_str_concat("fn ",f.name);let j:i32=0;while(j<len[Param](f.params)){sig=_zag_str_concat(sig,_zag_str_concat("|",sm_param_text(get[Param](f.params,j))));j=j+1;}sig=_zag_str_concat(sig,_zag_str_concat("->",_zag_str_concat(f.ret,_zag_str_concat("!",f.ret_eff))));pubh=sm_add(pubh,sig);let mask:i32=map.get[i32](eff,f.name) orelse 0;effh=sm_add(effh,_zag_str_concat(f.name,_zag_str_concat("=",_zag_i64_to_str(mask))));lines=_zag_str_concat(lines,_zag_str_concat("public_fn=",_zag_str_concat(sig,_zag_str_concat("\teffect=",_zag_str_concat(_zag_i64_to_str(mask),"\n")))));}}
        .struct_=>|s|{if(s.is_pub==1){let shape:[]u8=_zag_str_concat("struct ",s.name);let j:i32=0;while(j<len[Param](s.fields)){shape=_zag_str_concat(shape,_zag_str_concat("|",sm_param_text(get[Param](s.fields,j))));j=j+1;}pubh=sm_add(pubh,shape);layh=sm_add(layh,shape);lines=_zag_str_concat(lines,_zag_str_concat("public_layout=",_zag_str_concat(shape,"\n")));}}
        else=>{}
    }i=i+1;}
    let root:ZagdHash=zagd_content_hash(source);let profile_name:[]u8="strict";if(profile==ModuleProfile.script){profile_name="script";}
    let body:[]u8="format=zag-semantic-manifest-v1\nadvisory=true\nexecutable_authority=false\ncomplete=true\n";
    body=_zag_str_concat(body,_zag_str_concat("module=",_zag_str_concat(module_path,"\n")));body=_zag_str_concat(body,_zag_str_concat("profile=",_zag_str_concat(profile_name,"\n")));body=_zag_str_concat(body,_zag_str_concat("source=",_zag_str_concat(sm_hash_fields(root),"\n")));body=_zag_str_concat(body,_zag_str_concat("public=",_zag_str_concat(sm_hash_fields(pubh),"\n")));body=_zag_str_concat(body,_zag_str_concat("effects=",_zag_str_concat(sm_hash_fields(effh),"\n")));body=_zag_str_concat(body,_zag_str_concat("layouts=",_zag_str_concat(sm_hash_fields(layh),"\n")));body=_zag_str_concat(body,lines);
    i=0;while(i<len[ResolvedModule](modules)){let m:ResolvedModule=get[ResolvedModule](modules,i);let name:[]u8=m.path;if(@strEq(name,"<root>")){name=module_path;}body=_zag_str_concat(body,_zag_str_concat("module_node=",_zag_str_concat(name,_zag_str_concat("\t",_zag_str_concat(sm_hash_fields(zagd_content_hash(m.source)),"\n")))));i=i+1;}i=0;while(i<len[ResolvedImport](imports)){let edge:ResolvedImport=get[ResolvedImport](imports,i);let from:[]u8=edge.importer;if(@strEq(from,"<root>")){from=module_path;}body=_zag_str_concat(body,_zag_str_concat("import_edge=",_zag_str_concat(from,_zag_str_concat("\t",_zag_str_concat(edge.imported,"\n")))));i=i+1;}
    let sum:ZagdHash=zagd_content_hash(body);let text:[]u8=_zag_str_concat(body,_zag_str_concat("checksum=",_zag_str_concat(sm_hash_fields(sum),"\n")));
    return new(SemanticManifest{.text=text,.public_identity=pubh,.effect_identity=effh,.layout_identity=layh});
}
