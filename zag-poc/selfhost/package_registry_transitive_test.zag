@import("package_registry_transitive.zag")

extern fn _zag_allocator_live_bytes() i64

fn transitive_check(ok: i32, label: []u8, failures: *i32) void {
    if (ok != 0) { _zag_print("ok  "); _zag_println(label); }
    else { failures.* = failures.* + 1; _zag_print("FAIL "); _zag_println(label); }
}

fn main() i32 {
    let failures: i32 = 0;
    let before: i64 = _zag_allocator_live_bytes();
    let body: []u8 = "format=zag-registry-index-v1\nauthority=local-file-v1\nsignature=none\nentry=alpha\t1.0.0\tsrc/alpha.zag\t1,2,3\nentry=alpha\t1.2.0\tsrc/alpha-new.zag\t4,5,6\nentry=beta\t2.0.0\tsrc/beta.zag\t7,8,9\n";
    let index: []u8 = package_registry_finalize(body);
    transitive_check(package_registry_index_valid(index) == 1,
        "transitive fixture is a canonical local index", &failures);

    let graph_text: []u8 = "root\talpha\t^1.0.0\nroot\tbeta\t^2.0.0\nalpha\tbeta\t^2.0.0";
    let walked: PackageRegistryTransitiveLookup =
        package_registry_transitive_lookup(index, graph_text);
    transitive_check(walked.valid == 1 && walked.edge_count == 3 &&
        walked.package_count == 2 &&
        walked.error == PackageRegistryTransitiveError.none,
        "explicit transitive edges resolve all incoming constraints", &failures);

    let reordered: []u8 = "alpha\tbeta\t^2.0.0\nroot\tbeta\t^2.0.0\nroot\talpha\t^1.0.0";
    let lock: PackageRegistryGraphLock =
        package_registry_graph_lock_create(index, graph_text);
    let lock_reordered: PackageRegistryGraphLock =
        package_registry_graph_lock_create(index, reordered);
    transitive_check(lock.valid == 1 && lock.package_count == 2 &&
        lock.bytes.len > 0 && @strEq(lock.bytes, lock_reordered.bytes),
        "create-only graph lock is deterministic across edge order", &failures);
    transitive_check(@strEq(lock.bytes,
        "format=zag-registry-graph-lock-v1\nentry=alpha\t1.2.0\tsrc/alpha-new.zag\t4,5,6\nentry=beta\t2.0.0\tsrc/beta.zag\t7,8,9\nchecksum=603292195,410499862,112\n"),
        "graph lock sorts selected packages and binds exact checksums", &failures);

    let missing: PackageRegistryTransitiveLookup =
        package_registry_transitive_lookup(index, "root\tmissing\t*");
    transitive_check(missing.valid == 0 &&
        missing.error == PackageRegistryTransitiveError.missing_dependency &&
        @strEq(missing.failing_to, "missing"),
        "missing transitive package fails closed with its target", &failures);

    let conflict: PackageRegistryTransitiveLookup =
        package_registry_transitive_lookup(index,
            "root\talpha\t^1.0.0\nroot\talpha\t^2.0.0");
    transitive_check(conflict.valid == 0 &&
        conflict.error == PackageRegistryTransitiveError.version_conflict &&
        @strEq(conflict.failing_to, "alpha"),
        "incompatible incoming ranges fail closed", &failures);

    let cycle: PackageRegistryTransitiveLookup =
        package_registry_transitive_lookup(index,
            "root\talpha\t^1.0.0\nalpha\tbeta\t^2.0.0\nbeta\talpha\t^1.0.0");
    transitive_check(cycle.valid == 0 &&
        cycle.error == PackageRegistryTransitiveError.cycle,
        "explicit package cycle fails closed", &failures);

    let malformed: PackageRegistryTransitiveLookup =
        package_registry_transitive_lookup(index, "root\talpha");
    transitive_check(malformed.valid == 0 &&
        malformed.error == PackageRegistryTransitiveError.invalid_graph,
        "transitive records require exactly three fields", &failures);

    if (lock.bytes.len > 0) { _zag_str_free(lock.bytes); }
    if (lock_reordered.bytes.len > 0) { _zag_str_free(lock_reordered.bytes); }
    _zag_str_free(index);
    transitive_check(_zag_allocator_live_bytes() == before,
        "transitive traversal and lock creation restore allocator baseline", &failures);
    if (failures == 0) { _zag_println("package registry transitive: 8/8"); }
    return failures;
}
