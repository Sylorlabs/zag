// Pure policy core: no source mutation and no daemon/compiler dependency.
// mode schedules optional daemon analysis only. It never changes foreground
// compilation correctness, and `off` must remain a fully correct build mode.
struct PlannerConfig { mode: []u8, default_allocator: []u8, default_device: []u8, default_layout: []u8, default_cpu: []u8, valid: i32, diagnostic: []u8 }
struct PlannerChoices { allocator: []u8, device: []u8, layout: []u8, cpu: []u8, allocator_explicit: i32, device_explicit: i32, layout_explicit: i32, cpu_explicit: i32 }
struct PlannerResolution { choices: PlannerChoices, source: []u8, source_changed: i32, automatic_count: i32, unresolved_count: i32, provenance: []u8, diagnostic: []u8 }

fn planner_default_config() PlannerConfig { return PlannerConfig{.mode="advisory",.default_allocator="script_process_arena",.default_device="cpu",.default_layout="compiler_owned",.default_cpu="generic",.valid=1,.diagnostic=""}; }
fn planner_empty_choices() PlannerChoices { return PlannerChoices{.allocator="",.device="",.layout="",.cpu="",.allocator_explicit=0,.device_explicit=0,.layout_explicit=0,.cpu_explicit=0}; }

fn planner_trim(s: []u8) []u8 { let a:i32=0; let b:i32=s.len; while(a<b && (s[a]==' '||s[a]=='\t'||s[a]=='\r')){a=a+1;} while(b>a && (s[b-1]==' '||s[b-1]=='\t'||s[b-1]=='\r')){b=b-1;} return s[a..b]; }
fn planner_set(cfg:*PlannerConfig, line:[]u8) void {
    let eq:i32=0-1; let i:i32=0; while(i<line.len){if(line[i]=='='){eq=i; i=line.len;} i=i+1;}
    if(eq<1){cfg.*.valid=0;cfg.*.diagnostic="planner config: expected key=value";return;}
    let k:[]u8=planner_trim(line[0..eq]); let v:[]u8=planner_trim(line[eq+1..]);
    if(@strEq(k,"mode")){if(@strEq(v,"off")||@strEq(v,"light")||@strEq(v,"adaptive")||@strEq(v,"deep")||@strEq(v,"advisory")){cfg.*.mode=v;return;} cfg.*.valid=0;cfg.*.diagnostic="planner config: invalid mode";return;}
    if(@strEq(k,"allocator")){cfg.*.default_allocator=v;return;} if(@strEq(k,"device")){cfg.*.default_device=v;return;} if(@strEq(k,"layout")){cfg.*.default_layout=v;return;} if(@strEq(k,"cpu")){cfg.*.default_cpu=v;return;}
    cfg.*.valid=0; cfg.*.diagnostic="planner config: unknown key";
}
fn planner_parse_config(text:[]u8) PlannerConfig { let c:PlannerConfig=planner_default_config(); let start:i32=0; let i:i32=0; while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=planner_trim(text[start..i]);if(line.len>0&&line[0]!='#'){planner_set(&c,line);if(c.valid==0){return c;}}start=i+1;}i=i+1;}return c; }

// profile: 0 regular Zag, 1 Zag Script. Explicit fields always win.
fn planner_resolve(profile:i32, source:[]u8, cfg:PlannerConfig, input:PlannerChoices, strict:i32) PlannerResolution {
    let out:PlannerChoices=input; let automatic:i32=0; let unresolved:i32=0;
    if(cfg.valid==0){return PlannerResolution{.choices=out,.source=source,.source_changed=0,.automatic_count=0,.unresolved_count=4,.provenance="config:error",.diagnostic=cfg.diagnostic};}
    if(profile==1){
        if(out.allocator_explicit==0){out.allocator=cfg.default_allocator;automatic=automatic+1;} if(out.device_explicit==0){out.device=cfg.default_device;automatic=automatic+1;} if(out.layout_explicit==0){out.layout=cfg.default_layout;automatic=automatic+1;} if(out.cpu_explicit==0){out.cpu=cfg.default_cpu;automatic=automatic+1;}
    }
    // Regular Zag is quiet by default: absence of script defaults is not an
    // unresolved fact. Future analyzers may report concrete findings through a
    // separate suggestion input, without changing this resolution policy.
    let diag:[]u8=""; if(strict==1&&unresolved>0){diag="strict: unresolved planner choices remain";}
    let prov:[]u8="explicit choices preserved; script unspecified choices derive from project config; regular Zag remains advisory";
    return PlannerResolution{.choices=out,.source=source,.source_changed=0,.automatic_count=automatic,.unresolved_count=unresolved,.provenance=prov,.diagnostic=diag};
}
