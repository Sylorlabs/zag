// Pure policy core: no source mutation and no daemon/compiler dependency.
// mode schedules optional daemon analysis only. It never changes foreground
// compilation correctness, and `off` must remain a fully correct build mode.
struct PlannerConfig { mode: []u8, idle_deep:i32, difficulty:[]u8, script_optimization:[]u8, regular_optimization:[]u8, objective:[]u8, trust_mode:[]u8, default_allocator: []u8, default_device: []u8, default_layout: []u8, default_cpu: []u8, script_memory_bytes:i64, allow_filesystem_read:i32, allow_filesystem_write:i32, allow_process:i32, environment_allow:[]u8, notifications:[]u8, max_workers:i32, stability_window_ms:i64, max_memory_bytes:i64, max_cache_bytes:i64, valid: i32, diagnostic: []u8 }
struct PlannerChoices { allocator: []u8, device: []u8, layout: []u8, cpu: []u8, allocator_explicit: i32, device_explicit: i32, layout_explicit: i32, cpu_explicit: i32 }
// Policy overrides are data only. They are supplied by a caller that already
// owns the corresponding explicit choice (CLI or source); this layer never
// interprets them as permission to execute an optimizer.
struct PlannerPolicyOverrides { idle_deep:i32, idle_deep_set:i32, difficulty:[]u8, difficulty_set:i32, script_optimization:[]u8, script_optimization_set:i32, regular_optimization:[]u8, regular_optimization_set:i32, objective:[]u8, objective_set:i32, trust_mode:[]u8, trust_mode_set:i32 }
struct PlannerPolicyResolution { idle_deep:i32, difficulty:[]u8, script_optimization:[]u8, regular_optimization:[]u8, objective:[]u8, trust_mode:[]u8, valid:i32, provenance:[]u8, diagnostic:[]u8 }
struct PlannerResolution { choices: PlannerChoices, policy: PlannerPolicyResolution, source: []u8, source_changed: i32, automatic_count: i32, unresolved_count: i32, provenance: []u8, diagnostic: []u8 }

fn planner_default_config() PlannerConfig { return PlannerConfig{.mode="adaptive",.idle_deep=1,.difficulty="simple",.script_optimization="automatic",.regular_optimization="review",.objective="runtime",.trust_mode="stable",.default_allocator="script_process_arena",.default_device="cpu",.default_layout="compiler_owned",.default_cpu="generic",.script_memory_bytes=67108864,.allow_filesystem_read=1,.allow_filesystem_write=1,.allow_process=1,.environment_allow="",.notifications="advisory",.max_workers=1,.stability_window_ms=75,.max_memory_bytes=536870912,.max_cache_bytes=2147483648,.valid=1,.diagnostic=""}; }
fn planner_empty_choices() PlannerChoices { return PlannerChoices{.allocator="",.device="",.layout="",.cpu="",.allocator_explicit=0,.device_explicit=0,.layout_explicit=0,.cpu_explicit=0}; }
fn planner_empty_policy_overrides() PlannerPolicyOverrides { return PlannerPolicyOverrides{.idle_deep=0,.idle_deep_set=0,.difficulty="",.difficulty_set=0,.script_optimization="",.script_optimization_set=0,.regular_optimization="",.regular_optimization_set=0,.objective="",.objective_set=0,.trust_mode="",.trust_mode_set=0}; }

fn planner_trim(s: []u8) []u8 { let a:i32=0; let b:i32=s.len; while(a<b && (s[a]==' '||s[a]=='\t'||s[a]=='\r')){a=a+1;} while(b>a && (s[b-1]==' '||s[b-1]=='\t'||s[b-1]=='\r')){b=b-1;} return s[a..b]; }
fn planner_u64(s:[]u8,max:i64) i64 {if(s.len==0){return 0-1;}let n:i64=0;let i:i32=0;while(i<s.len){if(s[i]<'0'||s[i]>'9'){return 0-1;}let d:i64=(s[i] as i64)-48;if(n>(max-d)/10){return 0-1;}n=n*10+d;i=i+1;}return n;}
fn planner_bool(s:[]u8)i32{if(@strEq(s,"true")){return 1;}if(@strEq(s,"false")){return 0;}return 0-1;}
fn planner_environment_name_valid(s:[]u8)i32{if(s.len<1||s.len>128){return 0;}let i:i32=0;while(i<s.len){let c:u8=s[i];if(i==0){if(!((c>='A'&&c<='Z')||(c>='a'&&c<='z')||c=='_')){return 0;}}else{if(!((c>='A'&&c<='Z')||(c>='a'&&c<='z')||(c>='0'&&c<='9')||c=='_')){return 0;}}i=i+1;}return 1;}
fn planner_environment_allow_valid(s:[]u8)i32{if(s.len==0){return 1;}if(s.len>512){return 0;}let start:i32=0;let i:i32=0;while(i<=s.len){if(i==s.len||s[i]==','){if(planner_environment_name_valid(s[start..i])==0){return 0;}start=i+1;}i=i+1;}return 1;}
fn planner_set(cfg:*PlannerConfig, line:[]u8) void {
    let eq:i32=0-1; let i:i32=0; while(i<line.len){if(line[i]=='='){eq=i; i=line.len;} i=i+1;}
    if(eq<1){cfg.*.valid=0;cfg.*.diagnostic="planner config: expected key=value";return;}
    let k:[]u8=planner_trim(line[0..eq]); let v:[]u8=planner_trim(line[eq+1..]);
    if(@strEq(k,"mode")){if(@strEq(v,"off")||@strEq(v,"light")||@strEq(v,"adaptive")||@strEq(v,"deep")||@strEq(v,"advisory")){cfg.*.mode=v;return;} cfg.*.valid=0;cfg.*.diagnostic="planner config: invalid mode";return;}
    if(@strEq(k,"idle_deep")){let b:i32=planner_bool(v);if(b<0){cfg.*.valid=0;cfg.*.diagnostic="planner config: idle_deep must be true or false";return;}cfg.*.idle_deep=b;return;}
    if(@strEq(k,"difficulty")){if(@strEq(v,"simple")||@strEq(v,"explained")||@strEq(v,"explicit")||@strEq(v,"native")){cfg.*.difficulty=v;return;}cfg.*.valid=0;cfg.*.diagnostic="planner config: difficulty must be simple, explained, explicit, or native";return;}
    if(@strEq(k,"script_optimization")){if(@strEq(v,"automatic")||@strEq(v,"review")||@strEq(v,"off")){cfg.*.script_optimization=v;return;}cfg.*.valid=0;cfg.*.diagnostic="planner config: script_optimization must be automatic, review, or off";return;}
    if(@strEq(k,"regular_optimization")){if(@strEq(v,"review")||@strEq(v,"automatic")||@strEq(v,"off")){cfg.*.regular_optimization=v;return;}cfg.*.valid=0;cfg.*.diagnostic="planner config: regular_optimization must be review, automatic, or off";return;}
    if(@strEq(k,"objective")){if(@strEq(v,"runtime")){cfg.*.objective=v;return;}cfg.*.valid=0;cfg.*.diagnostic="planner config: this build supports objective=runtime";return;}
    if(@strEq(k,"trust_mode")){if(@strEq(v,"stable")||@strEq(v,"reviewed")||@strEq(v,"autonomous")){cfg.*.trust_mode=v;return;}cfg.*.valid=0;cfg.*.diagnostic="planner config: trust_mode must be stable, reviewed, or autonomous";return;}
    if(@strEq(k,"allocator")){cfg.*.default_allocator=v;return;} if(@strEq(k,"device")){cfg.*.default_device=v;return;} if(@strEq(k,"layout")){cfg.*.default_layout=v;return;} if(@strEq(k,"cpu")){cfg.*.default_cpu=v;return;}
    if(@strEq(k,"notifications")){if(@strEq(v,"errors_only")||@strEq(v,"advisory")){cfg.*.notifications=v;return;}cfg.*.valid=0;cfg.*.diagnostic="planner config: notifications must be errors_only or advisory";return;}
    if(@strEq(k,"script_memory_bytes")){let n:i64=planner_u64(v,2147483648);if(n<1048576){cfg.*.valid=0;cfg.*.diagnostic="planner config: script_memory_bytes must be 1048576..2147483648";return;}cfg.*.script_memory_bytes=n;return;}
    if(@strEq(k,"allow_filesystem_read")){let b:i32=planner_bool(v);if(b<0){cfg.*.valid=0;cfg.*.diagnostic="planner config: allow_filesystem_read must be true or false";return;}cfg.*.allow_filesystem_read=b;return;}
    if(@strEq(k,"allow_filesystem_write")){let b:i32=planner_bool(v);if(b<0){cfg.*.valid=0;cfg.*.diagnostic="planner config: allow_filesystem_write must be true or false";return;}cfg.*.allow_filesystem_write=b;return;}
    if(@strEq(k,"allow_process")){let b:i32=planner_bool(v);if(b<0){cfg.*.valid=0;cfg.*.diagnostic="planner config: allow_process must be true or false";return;}cfg.*.allow_process=b;return;}
    if(@strEq(k,"environment_allow")){if(planner_environment_allow_valid(v)==0){cfg.*.valid=0;cfg.*.diagnostic="planner config: environment_allow must be a comma-separated list of simple variable names";return;}cfg.*.environment_allow=v;return;}
    if(@strEq(k,"max_workers")){let n:i64=planner_u64(v,64);if(n!=1){cfg.*.valid=0;cfg.*.diagnostic="planner config: this build supports max_workers=1";return;}cfg.*.max_workers=1;return;}
    if(@strEq(k,"stability_window_ms")){let n:i64=planner_u64(v,60000);if(n<1){cfg.*.valid=0;cfg.*.diagnostic="planner config: stability_window_ms must be 1..60000";return;}cfg.*.stability_window_ms=n;return;}
    if(@strEq(k,"max_memory_bytes")){let n:i64=planner_u64(v,2147483648);if(n<67108864){cfg.*.valid=0;cfg.*.diagnostic="planner config: max_memory_bytes must be 67108864..2147483648";return;}cfg.*.max_memory_bytes=n;return;}
    if(@strEq(k,"max_cache_bytes")){let n:i64=planner_u64(v,2147483648);if(n<1048576){cfg.*.valid=0;cfg.*.diagnostic="planner config: max_cache_bytes must be 1048576..2147483648";return;}cfg.*.max_cache_bytes=n;return;}
    cfg.*.valid=0; cfg.*.diagnostic="planner config: unknown key";
}
// Configuration is intentionally fail-closed.  A repeated key is ambiguous
// in a policy file (especially when an editor leaves an old value below a new
// one), so do not silently apply last-writer-wins semantics.
fn planner_line_key(line:[]u8)[]u8{let eq:i32=0-1;let i:i32=0;while(i<line.len){if(line[i]=='='){eq=i;i=line.len;}i=i+1;}if(eq<1){return "";}return planner_trim(line[0..eq]);}
fn planner_key_seen_before(text:[]u8,before:i32,key:[]u8)i32{
    if(key.len==0||before<=0){return 0;}
    let start:i32=0;let i:i32=0;
    while(i<before){
        if(text[i]=='\n'){
            let line:[]u8=planner_trim(text[start..i]);
            if(line.len>0&&line[0]!='#'&&@strEq(planner_line_key(line),key)){return 1;}
            start=i+1;
        }
        i=i+1;
    }
    if(start<before){let line:[]u8=planner_trim(text[start..before]);if(line.len>0&&line[0]!='#'&&@strEq(planner_line_key(line),key)){return 1;}}
    return 0;
}
fn planner_parse_config(text:[]u8) PlannerConfig { let c:PlannerConfig=planner_default_config(); let start:i32=0; let i:i32=0; while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=planner_trim(text[start..i]);if(line.len>0&&line[0]!='#'){let key:[]u8=planner_line_key(line);if(planner_key_seen_before(text,start,key)==1){c.valid=0;c.diagnostic="planner config: duplicate key";return c;}planner_set(&c,line);if(c.valid==0){return c;}}start=i+1;}i=i+1;}return c; }

fn planner_policy_override_valid(o:PlannerPolicyOverrides) []u8 {
    if(o.idle_deep_set==1&&(o.idle_deep<0||o.idle_deep>1)){return "planner policy: idle_deep override must be true or false";}
    if(o.difficulty_set==1&&!( @strEq(o.difficulty,"simple")||@strEq(o.difficulty,"explained")||@strEq(o.difficulty,"explicit")||@strEq(o.difficulty,"native") )){return "planner policy: invalid difficulty override";}
    if(o.script_optimization_set==1&&!( @strEq(o.script_optimization,"automatic")||@strEq(o.script_optimization,"review")||@strEq(o.script_optimization,"off") )){return "planner policy: invalid script_optimization override";}
    if(o.regular_optimization_set==1&&!( @strEq(o.regular_optimization,"review")||@strEq(o.regular_optimization,"automatic")||@strEq(o.regular_optimization,"off") )){return "planner policy: invalid regular_optimization override";}
    if(o.objective_set==1&&!@strEq(o.objective,"runtime")){return "planner policy: unsupported objective override";}
    if(o.trust_mode_set==1&&!( @strEq(o.trust_mode,"stable")||@strEq(o.trust_mode,"reviewed")||@strEq(o.trust_mode,"autonomous") )){return "planner policy: invalid trust_mode override";}
    return "";
}

fn planner_policy_resolve(cli:PlannerPolicyOverrides, source:PlannerPolicyOverrides, cfg:PlannerConfig) PlannerPolicyResolution {
    let out:PlannerPolicyResolution=PlannerPolicyResolution{.idle_deep=cfg.idle_deep,.difficulty=cfg.difficulty,.script_optimization=cfg.script_optimization,.regular_optimization=cfg.regular_optimization,.objective=cfg.objective,.trust_mode=cfg.trust_mode,.valid=1,.provenance="CLI > source > project > defaults; policy data only; no optimizer authority",.diagnostic=""};
    if(cfg.valid==0){out.valid=0;out.diagnostic=cfg.diagnostic;return out;}
    if(!@strEq(planner_policy_override_valid(source),"")){out.valid=0;out.diagnostic=planner_policy_override_valid(source);return out;}
    if(!@strEq(planner_policy_override_valid(cli),"")){out.valid=0;out.diagnostic=planner_policy_override_valid(cli);return out;}
    if(source.idle_deep_set==1){out.idle_deep=source.idle_deep;} if(cli.idle_deep_set==1){out.idle_deep=cli.idle_deep;}
    if(source.difficulty_set==1){out.difficulty=source.difficulty;} if(cli.difficulty_set==1){out.difficulty=cli.difficulty;}
    if(source.script_optimization_set==1){out.script_optimization=source.script_optimization;} if(cli.script_optimization_set==1){out.script_optimization=cli.script_optimization;}
    if(source.regular_optimization_set==1){out.regular_optimization=source.regular_optimization;} if(cli.regular_optimization_set==1){out.regular_optimization=cli.regular_optimization;}
    if(source.objective_set==1){out.objective=source.objective;} if(cli.objective_set==1){out.objective=cli.objective;}
    if(source.trust_mode_set==1){out.trust_mode=source.trust_mode;} if(cli.trust_mode_set==1){out.trust_mode=cli.trust_mode;}
    return out;
}

// profile: 0 regular Zag, 1 Zag Script. Explicit fields always win.
fn planner_resolve(profile:i32, source:[]u8, cfg:PlannerConfig, input:PlannerChoices, strict:i32) PlannerResolution {
    let out:PlannerChoices=input; let automatic:i32=0; let unresolved:i32=0;
    let policy:PlannerPolicyResolution=planner_policy_resolve(planner_empty_policy_overrides(),planner_empty_policy_overrides(),cfg);
    if(cfg.valid==0){return PlannerResolution{.choices=out,.policy=policy,.source=source,.source_changed=0,.automatic_count=0,.unresolved_count=4,.provenance="config:error",.diagnostic=cfg.diagnostic};}
    if(profile==1){
        if(out.allocator_explicit==0){out.allocator=cfg.default_allocator;automatic=automatic+1;} if(out.device_explicit==0){out.device=cfg.default_device;automatic=automatic+1;} if(out.layout_explicit==0){out.layout=cfg.default_layout;automatic=automatic+1;} if(out.cpu_explicit==0){out.cpu=cfg.default_cpu;automatic=automatic+1;}
    }
    // Regular Zag is quiet by default: absence of script defaults is not an
    // unresolved fact. Future analyzers may report concrete findings through a
    // separate suggestion input, without changing this resolution policy.
    let diag:[]u8=""; if(strict==1&&unresolved>0){diag="strict: unresolved planner choices remain";}
    let prov:[]u8="explicit choices preserved; script unspecified choices derive from project config; regular Zag remains advisory";
    return PlannerResolution{.choices=out,.policy=policy,.source=source,.source_changed=0,.automatic_count=automatic,.unresolved_count=unresolved,.provenance=prov,.diagnostic=diag};
}
