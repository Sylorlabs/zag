// A bounded handoff envelope for one foreground-checked transform rule.
//
// This is intentionally a proposal codec, not an optimizer or code generator.
// The daemon may publish the envelope, but only a foreground compiler with
// the matching source/policy checker could consume it.  The record contains
// no IR, machine code, or authority bit that can be enabled by a producer.
@import("zagd_store.zag")

struct ZagdTransformProposal {
    rule:[]u8,
    source:ZagdHash,
    semantic_identity:ZagdHash,
    target:ZagdHash,
    compiler:[]u8,
    compiler_identity:ZagdHash,
    function_origin:i64,
    operation_origin:i64,
    lhs:i32,
    rhs:i32,
    result:i32,
    valid:i32,
}

struct ZagdTransformProposalCheck {
    valid:i32,
    executable_authority:i32,
    reason:[]u8,
    proposal:ZagdTransformProposal,
}

fn ztp_bad_hash()ZagdHash{return ZagdHash{.first=0-1,.second=0-1,.bytes=0-1};}
fn ztp_empty()ZagdTransformProposal{return ZagdTransformProposal{.rule="",.source=ztp_bad_hash(),.semantic_identity=ztp_bad_hash(),.target=ztp_bad_hash(),.compiler="",.compiler_identity=ztp_bad_hash(),.function_origin=0-1,.operation_origin=0-1,.lhs=0,.rhs=0,.result=0,.valid=0};}
fn ztp_bad(reason:[]u8)ZagdTransformProposalCheck{return ZagdTransformProposalCheck{.valid=0,.executable_authority=0,.reason=reason,.proposal=ztp_empty()};}
fn ztp_hash_valid(h:ZagdHash)i32{return (h.first>=0&&h.second>=0&&h.bytes>0) as i32;}

fn ztp_token(value:[]u8)i32{
    if(value.len==0||value.len>128){return 0;}
    let i:i32=0;while(i<value.len){let c:u8=value[i];if(!((c>='a'&&c<='z')||(c>='A'&&c<='Z')||(c>='0'&&c<='9')||c=='_'||c=='.'||c=='-'||c==':')){return 0;}i=i+1;}
    return 1;
}

// Returns 2147483649 for malformed or out-of-range text.  The lexical form
// is canonical: no plus sign, no leading zero, and -0 is rejected.
fn ztp_i32_text(value:[]u8)i64{
    if(value.len==0||value.len>11){return 2147483649;}
    let negative:i32=0;let start:i32=0;
    if(value[0]=='-'){negative=1;start=1;if(value.len==1||value[1]=='0'){return 2147483649;}}
    if(start==0&&value.len>1&&value[0]=='0'){return 2147483649;}
    let limit:i64=2147483647;if(negative==1){limit=2147483648;}let n:i64=0;let i:i32=start;
    while(i<value.len){if(value[i]<'0'||value[i]>'9'){return 2147483649;}let d:i64=(value[i] as i64)-48;if(n>(limit-d)/10){return 2147483649;}n=n*10+d;i=i+1;}
    if(negative==1){return 0-n;}return n;
}

fn ztp_nonnegative(value:[]u8,maximum:i64)i64{
    if(value.len==0||value.len>19||(value.len>1&&value[0]=='0')){return 0-1;}
    let n:i64=0;let i:i32=0;while(i<value.len){if(value[i]<'0'||value[i]>'9'){return 0-1;}let d:i64=(value[i] as i64)-48;if(n>(maximum-d)/10){return 0-1;}n=n*10+d;i=i+1;}return n;
}
fn ztp_hash_field(text:[]u8,key:[]u8)ZagdHash{
    let bad:ZagdHash=ztp_bad_hash();let value:[]u8=zagd_record_value(text,key);let tabs:i32=0;let i:i32=0;
    while(i<value.len){if(value[i]=='\t'){tabs=tabs+1;}i=i+1;}
    if(tabs!=2){return bad;}
    let first:i64=ztp_nonnegative(zstore_tab_field(value,0),1000000009);let second:i64=ztp_nonnegative(zstore_tab_field(value,1),1000000009);let bytes:i64=ztp_nonnegative(zstore_tab_field(value,2),2147483647);
    if(first<0||second<0||bytes<0){return bad;}return ZagdHash{.first=first,.second=second,.bytes=bytes};
}

fn ztp_wrap_add(lhs:i32,rhs:i32)i32{
    let n:i64=(lhs as i64)+(rhs as i64);let wrapped:i64=n;
    while(wrapped>2147483647){wrapped=wrapped-4294967296;}
    while(wrapped<0-2147483648){wrapped=wrapped+4294967296;}
    return wrapped as i32;
}

fn ztp_append_hash(out:*ArrayList[u8],value:ZagdHash)void{
    zagd_text_append_i64(out,value.first);zagd_text_append_byte(out,'\t');
    zagd_text_append_i64(out,value.second);zagd_text_append_byte(out,'\t');
    zagd_text_append_i64(out,value.bytes);
}
fn ztp_append_checksum(out:*ArrayList[u8])void{
    let h:ZagdHash=zagd_content_hash(out.*.data[0..out.*.len]);
    zagd_text_append(out,"checksum_first=");zagd_text_append_i64(out,h.first);
    zagd_text_append(out,"\nchecksum_second=");zagd_text_append_i64(out,h.second);
    zagd_text_append(out,"\nchecksum_bytes=");zagd_text_append_i64(out,h.bytes);
    zagd_text_append_byte(out,'\n');
}

fn ztp_encode(value:ZagdTransformProposal)[]u8{
    if(value.valid!=1||!@strEq(value.rule,"const-i32-add-v1")||
       ztp_hash_valid(value.source)==0||ztp_hash_valid(value.semantic_identity)==0||
       ztp_hash_valid(value.target)==0||ztp_token(value.compiler)==0||ztp_hash_valid(value.compiler_identity)==0||
       value.function_origin<0||value.operation_origin<0||
       value.result!=ztp_wrap_add(value.lhs,value.rhs)){return "";}
    let out:ArrayList[u8]=zagd_text(1024);
    zagd_text_append(&out,"format=zagd-transform-proposal-v1\ncomplete=true\nproposal=true\nrule=const-i32-add-v1\nrule_version=1\nsource=");ztp_append_hash(&out,value.source);
    zagd_text_append(&out,"\nsemantic_identity=");ztp_append_hash(&out,value.semantic_identity);
    zagd_text_append(&out,"\ntarget=");ztp_append_hash(&out,value.target);
    zagd_text_append(&out,"\ncompiler=");zagd_text_append(&out,value.compiler);
    zagd_text_append(&out,"\ncompiler_identity=");ztp_append_hash(&out,value.compiler_identity);
    zagd_text_append(&out,"\nfunction_origin=");zagd_text_append_i64(&out,value.function_origin);
    zagd_text_append(&out,"\noperation_origin=");zagd_text_append_i64(&out,value.operation_origin);
    zagd_text_append(&out,"\nlhs=");zagd_text_append_i64(&out,value.lhs as i64);
    zagd_text_append(&out,"\nrhs=");zagd_text_append_i64(&out,value.rhs as i64);
    zagd_text_append(&out,"\nresult=");zagd_text_append_i64(&out,value.result as i64);
    zagd_text_append(&out,"\narithmetic=i32-wrap\nsource_policy=caller-bound-v1\nforeground_consumption=checker-only\nexecutable_authority=false\n");
    ztp_append_checksum(&out);return out.data[0..out.len];
}

fn ztp_key_allowed(key:[]u8)i32{
    return (@strEq(key,"format")||@strEq(key,"complete")||@strEq(key,"proposal")||
        @strEq(key,"rule")||@strEq(key,"rule_version")||@strEq(key,"source")||
        @strEq(key,"semantic_identity")||@strEq(key,"target")||@strEq(key,"compiler")||@strEq(key,"compiler_identity")||
        @strEq(key,"function_origin")||@strEq(key,"operation_origin")||@strEq(key,"lhs")||
        @strEq(key,"rhs")||@strEq(key,"result")||@strEq(key,"arithmetic")||
        @strEq(key,"source_policy")||@strEq(key,"foreground_consumption")||
        @strEq(key,"executable_authority")||@strEq(key,"checksum_first")||
        @strEq(key,"checksum_second")||@strEq(key,"checksum_bytes")) as i32;
}
fn ztp_closed(text:[]u8)i32{
    let start:i32=0;let i:i32=0;while(i<=text.len){
        if(i==text.len||text[i]=='\n'){
            let line:[]u8=text[start..i];if(line.len>0){let eq:i32=0;while(eq<line.len&&line[eq]!='='){eq=eq+1;}
                if(eq<=0||ztp_key_allowed(line[0..eq])==0){return 0;}}
            start=i+1;
        }i=i+1;
    }return 1;
}
fn ztp_exact(text:[]u8,key:[]u8)i32{return zstore_single_field(text,key);}
fn ztp_checksum_ok(text:[]u8)i32{
    if(text.len<1||text.len>4096||zagd_find_checksum(text)<0||zstore_final_field(text,"checksum_bytes")==0||
       ztp_exact(text,"checksum_first")==0||ztp_exact(text,"checksum_second")==0||ztp_exact(text,"checksum_bytes")==0){return 0;}
    let mark:i32=zagd_find_checksum(text);let h:ZagdHash=zagd_content_hash(text[0..mark]);
    return (ztp_nonnegative(zagd_record_value(text,"checksum_first"),1000000009)==h.first&&
        ztp_nonnegative(zagd_record_value(text,"checksum_second"),1000000009)==h.second&&
        ztp_nonnegative(zagd_record_value(text,"checksum_bytes"),4096)==h.bytes) as i32;
}

fn ztp_decode(text:[]u8)ZagdTransformProposalCheck{
    if(text.len<=0||text.len>4096||ztp_closed(text)==0||ztp_checksum_ok(text)==0){return ztp_bad("invalid-envelope");}
    let keys:ArrayList[[]u8]=make[[]u8](22);
    push[[]u8](&keys,"format");push[[]u8](&keys,"complete");push[[]u8](&keys,"proposal");push[[]u8](&keys,"rule");push[[]u8](&keys,"rule_version");push[[]u8](&keys,"source");push[[]u8](&keys,"semantic_identity");push[[]u8](&keys,"target");push[[]u8](&keys,"compiler");push[[]u8](&keys,"compiler_identity");push[[]u8](&keys,"function_origin");push[[]u8](&keys,"operation_origin");push[[]u8](&keys,"lhs");push[[]u8](&keys,"rhs");push[[]u8](&keys,"result");push[[]u8](&keys,"arithmetic");push[[]u8](&keys,"source_policy");push[[]u8](&keys,"foreground_consumption");push[[]u8](&keys,"executable_authority");push[[]u8](&keys,"checksum_first");push[[]u8](&keys,"checksum_second");push[[]u8](&keys,"checksum_bytes");
    let i:i32=0;while(i<keys.len){if(ztp_exact(text,keys.data[i])==0){free[[]u8](&keys);return ztp_bad("missing-or-duplicate-key");}i=i+1;}free[[]u8](&keys);
    if(!@strEq(zagd_record_value(text,"format"),"zagd-transform-proposal-v1")||!@strEq(zagd_record_value(text,"complete"),"true")||
       !@strEq(zagd_record_value(text,"proposal"),"true")||!@strEq(zagd_record_value(text,"rule"),"const-i32-add-v1")||
       !@strEq(zagd_record_value(text,"rule_version"),"1")||!@strEq(zagd_record_value(text,"arithmetic"),"i32-wrap")||
       !@strEq(zagd_record_value(text,"source_policy"),"caller-bound-v1")||!@strEq(zagd_record_value(text,"foreground_consumption"),"checker-only")||
       !@strEq(zagd_record_value(text,"executable_authority"),"false")){return ztp_bad("invalid-authority-or-rule");}
    let source:ZagdHash=ztp_hash_field(text,"source");let semantic:ZagdHash=ztp_hash_field(text,"semantic_identity");let target:ZagdHash=ztp_hash_field(text,"target");let compiler_identity:ZagdHash=ztp_hash_field(text,"compiler_identity");
    let function_id:i64= ztp_i32_text(zagd_record_value(text,"function_origin"));let operation_id:i64=ztp_i32_text(zagd_record_value(text,"operation_origin"));
    let lhs:i64=ztp_i32_text(zagd_record_value(text,"lhs"));let rhs:i64=ztp_i32_text(zagd_record_value(text,"rhs"));let result:i64=ztp_i32_text(zagd_record_value(text,"result"));
    if(ztp_hash_valid(source)==0||ztp_hash_valid(semantic)==0||ztp_hash_valid(target)==0||ztp_hash_valid(compiler_identity)==0||ztp_token(zagd_record_value(text,"compiler"))==0||
       function_id<0||operation_id<0||function_id>2147483647||operation_id>2147483647||lhs==2147483649||rhs==2147483649||result==2147483649||
       ztp_wrap_add(lhs as i32,rhs as i32)!=(result as i32)){return ztp_bad("invalid-operation-facts");}
    let p:ZagdTransformProposal=ZagdTransformProposal{.rule="const-i32-add-v1",.source=source,.semantic_identity=semantic,.target=target,.compiler=zagd_record_value(text,"compiler"),.compiler_identity=compiler_identity,.function_origin=function_id,.operation_origin=operation_id,.lhs=lhs as i32,.rhs=rhs as i32,.result=result as i32,.valid=1};
    return ZagdTransformProposalCheck{.valid=1,.executable_authority=0,.reason="proposal-envelope-valid-checker-only",.proposal=p};
}

fn ztp_validate(text:[]u8,source:ZagdHash,semantic:ZagdHash,target:ZagdHash,compiler:[]u8,compiler_identity:ZagdHash)ZagdTransformProposalCheck{
    let decoded:ZagdTransformProposalCheck=ztp_decode(text);if(decoded.valid==0){return decoded;}
    if(zagd_hash_equal(decoded.proposal.source,source)==0||zagd_hash_equal(decoded.proposal.semantic_identity,semantic)==0||
       zagd_hash_equal(decoded.proposal.target,target)==0||!@strEq(decoded.proposal.compiler,compiler)||
       zagd_hash_equal(decoded.proposal.compiler_identity,compiler_identity)==0){return ztp_bad("stale-source-policy-binding");}
    return decoded;
}
