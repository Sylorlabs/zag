@import("package_registry_graph.zag")

// Explicit graph edges are the only transitive authority currently available
// to the local registry layer. Each line is `from<TAB>to<TAB>requirement`.
// `root` is a synthetic source node; every package node must also be present
// in the local index. This does not inspect package artifacts for imports.
enum PackageRegistryTransitiveError {
    none,
    invalid_index,
    invalid_graph,
    missing_dependency,
    version_conflict,
    cycle,
    traversal_limit,
    invalid_lock,
    lock_mismatch,
}

struct PackageRegistryTransitiveLookup {
    valid: i32,
    edge_count: i32,
    package_count: i32,
    failing_from: []u8,
    failing_to: []u8,
    error: PackageRegistryTransitiveError,
}

struct PackageRegistryGraphLock {
    bytes: []u8,
    valid: i32,
    package_count: i32,
    error: PackageRegistryTransitiveError,
}

struct PackageRegistryGraphLockCheck {
    valid: i32,
    entry_count: i32,
    failing_name: []u8,
    error: PackageRegistryTransitiveError,
}

struct PackageRegistryGraphLockEntry {
    name: []u8,
    version: []u8,
    source: []u8,
    checksum: PackageRawChecksum,
    valid: i32,
}

fn package_registry_transitive_bad(
    error: PackageRegistryTransitiveError) PackageRegistryTransitiveLookup {
    return PackageRegistryTransitiveLookup{.valid = 0, .edge_count = 0,
        .package_count = 0, .failing_from = "", .failing_to = "",
        .error = error};
}

fn package_registry_graph_lock_bad(
    error: PackageRegistryTransitiveError) PackageRegistryGraphLock {
    return PackageRegistryGraphLock{.bytes = "", .valid = 0,
        .package_count = 0, .error = error};
}

fn package_registry_graph_lock_check_bad(
    error: PackageRegistryTransitiveError) PackageRegistryGraphLockCheck {
    return PackageRegistryGraphLockCheck{.valid = 0, .entry_count = 0,
        .failing_name = "", .error = error};
}

fn package_registry_transitive_append_owned(base: []u8,
    suffix: []u8) []u8 {
    let out: []u8 = _zag_str_concat(base, suffix);
    if (base.len > 0) { _zag_str_free(base); }
    return out;
}

fn package_registry_transitive_part(line: []u8, wanted: i32) []u8 {
    if (package_registry_part_count(line) != 3) { return ""; }
    return package_registry_part(line, wanted);
}

fn package_registry_transitive_node_safe(name: []u8) i32 {
    return (package_import_safe_name(name) == 1 || @strEq(name, "root")) as i32;
}

fn package_registry_transitive_line_count(text: []u8) i32 {
    if (text.len == 0) { return 0; }
    let count: i32 = 1; let i: i32 = 0;
    while (i < text.len) {
        if (text[i] == '\n') { count = count + 1; }
        i = i + 1;
    }
    return count;
}

fn package_registry_transitive_path_contains(path: []u8,
    wanted: []u8) i32 {
    let start: i32 = 0; let i: i32 = 0;
    while (i < path.len) {
        if (path[i] == '\n') {
            if (@strEq(path[start..i], wanted)) { return 1; }
            start = i + 1;
        }
        i = i + 1;
    }
    if (@strEq(path[start..path.len], wanted)) { return 1; }
    return 0;
}

// Return 0 for no cycle, 1 for a cycle, and 2 when the bounded traversal
// budget is exhausted. The budget makes adversarial branching fail closed.
fn package_registry_transitive_cycle_visit(edges: []u8, node: []u8,
    path: []u8, depth: i32, budget: *i32) i32 {
    if (depth >= 64) { return 2; }
    let edge_count: i32 = package_registry_transitive_line_count(edges);
    let line_no: i32 = 0;
    while (line_no < edge_count) {
        if (budget.* <= 0) { return 2; }
        budget.* = budget.* - 1;
        let line: []u8 = package_registry_line(edges, line_no);
        let from: []u8 = package_registry_transitive_part(line, 0);
        if (@strEq(from, node)) {
            let to: []u8 = package_registry_transitive_part(line, 1);
            if (package_registry_transitive_path_contains(path, to) != 0) {
                return 1;
            }
            let next: []u8 = _zag_str_concat(path, "\n");
            next = package_registry_transitive_append_owned(next, to);
            let result: i32 = package_registry_transitive_cycle_visit(
                edges, to, next, depth + 1, budget);
            _zag_str_free(next);
            if (result != 0) { return result; }
        }
        line_no = line_no + 1;
    }
    return 0;
}

fn package_registry_transitive_group(edges: []u8, wanted: []u8) []u8 {
    let edge_count: i32 = package_registry_transitive_line_count(edges);
    let grouped: []u8 = "";
    let line_no: i32 = 0;
    while (line_no < edge_count) {
        let line: []u8 = package_registry_line(edges, line_no);
        if (@strEq(package_registry_transitive_part(line, 1), wanted)) {
            let requirement: []u8 =
                package_registry_transitive_part(line, 2);
            if (requirement.len > 0) {
                if (grouped.len == 0) {
                    grouped = _zag_str_concat("", requirement);
                } else {
                    let joined: []u8 = _zag_str_concat(grouped, "\n");
                    _zag_str_free(grouped);
                    grouped = _zag_str_concat(joined, requirement);
                    _zag_str_free(joined);
                }
            }
        }
        line_no = line_no + 1;
    }
    return grouped;
}

fn package_registry_transitive_compare(a: []u8, b: []u8) i32 {
    let common: i32 = a.len;
    if (b.len < common) { common = b.len; }
    let i: i32 = 0;
    while (i < common) {
        if (a[i] < b[i]) { return 0 - 1; }
        if (a[i] > b[i]) { return 1; }
        i = i + 1;
    }
    if (a.len < b.len) { return 0 - 1; }
    if (a.len > b.len) { return 1; }
    return 0;
}

fn package_registry_graph_lock_line_count(text: []u8) i32 {
    if (text.len == 0) { return 0; }
    let count: i32 = 1; let i: i32 = 0;
    while (i < text.len) {
        if (text[i] == '\n') { count = count + 1; }
        i = i + 1;
    }
    return count;
}

fn package_registry_graph_lock_entry(line: []u8)
    PackageRegistryGraphLockEntry {
    let bad: PackageRegistryGraphLockEntry = PackageRegistryGraphLockEntry{
        .name = "", .version = "", .source = "",
        .checksum = PackageRawChecksum{.first = 0, .second = 0, .bytes = 0},
        .valid = 0};
    if (line.len < 7 || !@strEq(line[0..6], "entry=") ||
        package_registry_part_count(line[6..line.len]) != 4) { return bad; }
    let fields: []u8 = line[6..line.len];
    let name: []u8 = package_registry_part(fields, 0);
    let version: []u8 = package_registry_part(fields, 1);
    let source: []u8 = package_registry_part(fields, 2);
    let parsed: PackageChecksumParse = package_lock_checksum(
        package_registry_part(fields, 3));
    if (package_import_safe_name(name) == 0 ||
        package_semver_parse(version).valid == 0 ||
        package_import_artifact_safe(source) == 0 || parsed.valid == 0) {
        return bad;
    }
    return PackageRegistryGraphLockEntry{.name = name, .version = version,
        .source = source, .checksum = parsed.checksum, .valid = 1};
}

fn package_registry_graph_lock_has_name(lock: []u8,
    name: []u8) i32 {
    let line_count: i32 = package_registry_graph_lock_line_count(lock);
    let line_no: i32 = 1;
    while (line_no < line_count - 2) {
        let entry: PackageRegistryGraphLockEntry =
            package_registry_graph_lock_entry(package_registry_line(lock, line_no));
        if (entry.valid == 1 && @strEq(entry.name, name)) {
            return 1;
        }
        line_no = line_no + 1;
    }
    return 0;
}

fn package_registry_transitive_lookup(index: []u8,
    edges: []u8) PackageRegistryTransitiveLookup {
    if (package_registry_index_valid(index) == 0) {
        return package_registry_transitive_bad(
            PackageRegistryTransitiveError.invalid_index);
    }
    if (edges.len == 0 || edges.len > 1048576 ||
        edges[edges.len - 1] == '\n') {
        return package_registry_transitive_bad(
            PackageRegistryTransitiveError.invalid_graph);
    }
    let edge_count: i32 = package_registry_transitive_line_count(edges);
    if (edge_count <= 0 || edge_count > 256) {
        return package_registry_transitive_bad(
            PackageRegistryTransitiveError.invalid_graph);
    }

    // Validate edge shape, package node existence, and each local requirement.
    let line_no: i32 = 0;
    while (line_no < edge_count) {
        let line: []u8 = package_registry_line(edges, line_no);
        let from: []u8 = package_registry_transitive_part(line, 0);
        let to: []u8 = package_registry_transitive_part(line, 1);
        let requirement: []u8 = package_registry_transitive_part(line, 2);
        if (from.len == 0 || to.len == 0 ||
            package_registry_transitive_node_safe(from) == 0 ||
            package_import_safe_name(to) == 0 ||
            (requirement.len > 0 &&
             package_version_requirement_valid(requirement) == 0)) {
            return package_registry_transitive_bad(
                PackageRegistryTransitiveError.invalid_graph);
        }
        if (!@strEq(from, "root")) {
            let source: PackageRegistryLookup =
                package_registry_lookup(index, from, "");
            if (source.found == 0) {
                return PackageRegistryTransitiveLookup{.valid = 0,
                    .edge_count = edge_count, .package_count = 0,
                    .failing_from = from, .failing_to = to,
                    .error = PackageRegistryTransitiveError.missing_dependency};
            }
        }
        line_no = line_no + 1;
    }

    // Check every distinct target against all of its incoming requirements.
    let package_count: i32 = 0; let target_no: i32 = 0;
    while (target_no < edge_count) {
        let target_line: []u8 = package_registry_line(edges, target_no);
        let target: []u8 = package_registry_transitive_part(target_line, 1);
        let prior: i32 = 0; let prior_no: i32 = 0;
        while (prior_no < target_no) {
            let prior_line: []u8 = package_registry_line(edges, prior_no);
            if (@strEq(package_registry_transitive_part(prior_line, 1), target)) {
                prior = 1; break;
            }
            prior_no = prior_no + 1;
        }
        if (prior == 0) {
            let grouped: []u8 = package_registry_transitive_group(edges, target);
            let selected: PackageRegistryLookup =
                package_registry_lookup_all(index, target, grouped);
            if (grouped.len > 0) { _zag_str_free(grouped); }
            if (selected.found == 0) {
                let error: PackageRegistryTransitiveError =
                    PackageRegistryTransitiveError.version_conflict;
                if (selected.error == PackageRegistryError.package_not_found) {
                    error = PackageRegistryTransitiveError.missing_dependency;
                }
                return PackageRegistryTransitiveLookup{.valid = 0,
                    .edge_count = edge_count, .package_count = package_count,
                    .failing_from = "root", .failing_to = target,
                    .error = error};
            }
            package_count = package_count + 1;
        }
        target_no = target_no + 1;
    }

    // Walk from every declared source so disconnected cycles are not hidden.
    let budget: i32 = 65536; let source_no: i32 = 0;
    while (source_no < edge_count) {
        let source_line: []u8 = package_registry_line(edges, source_no);
        let source: []u8 = package_registry_transitive_part(source_line, 0);
        let prior: i32 = 0; let prior_no: i32 = 0;
        while (prior_no < source_no) {
            let prior_line: []u8 = package_registry_line(edges, prior_no);
            if (@strEq(package_registry_transitive_part(prior_line, 0), source)) {
                prior = 1; break;
            }
            prior_no = prior_no + 1;
        }
        if (prior == 0) {
            let cycle_path: []u8 = _zag_str_concat("", source);
            let cycle: i32 = package_registry_transitive_cycle_visit(
                edges, source, cycle_path, 0, &budget);
            _zag_str_free(cycle_path);
            if (cycle == 1) {
                return PackageRegistryTransitiveLookup{.valid = 0,
                    .edge_count = edge_count, .package_count = package_count,
                    .failing_from = source, .failing_to = source,
                    .error = PackageRegistryTransitiveError.cycle};
            }
            if (cycle == 2) {
                return PackageRegistryTransitiveLookup{.valid = 0,
                    .edge_count = edge_count, .package_count = package_count,
                    .failing_from = source, .failing_to = source,
                    .error = PackageRegistryTransitiveError.traversal_limit};
            }
        }
        source_no = source_no + 1;
    }
    return PackageRegistryTransitiveLookup{.valid = 1,
        .edge_count = edge_count, .package_count = package_count,
        .failing_from = "", .failing_to = "",
        .error = PackageRegistryTransitiveError.none};
}

// Create a deterministic selected-package record. The record is intentionally
// not consumed by package_import_resolve yet: it has no transitive artifact
// metadata or signature authority. Its checksum covers the exact emitted
// bytes, and entries are sorted by package name independent of edge order.
fn package_registry_graph_lock_create(index: []u8,
    edges: []u8) PackageRegistryGraphLock {
    let graph: PackageRegistryTransitiveLookup =
        package_registry_transitive_lookup(index, edges);
    if (graph.valid == 0) {
        return package_registry_graph_lock_bad(graph.error);
    }
    let body: []u8 = _zag_str_concat("", "format=zag-registry-graph-lock-v1\n");
    let previous: []u8 = ""; let emitted: i32 = 0;
    while (emitted < graph.package_count) {
        let candidate: []u8 = ""; let line_no: i32 = 0;
        let edge_count: i32 = package_registry_transitive_line_count(edges);
        while (line_no < edge_count) {
            let line: []u8 = package_registry_line(edges, line_no);
            let target: []u8 = package_registry_transitive_part(line, 1);
            if (package_registry_transitive_compare(target, previous) > 0 &&
                (candidate.len == 0 || package_registry_transitive_compare(
                    target, candidate) < 0)) {
                candidate = target;
            }
            line_no = line_no + 1;
        }
        if (candidate.len == 0) {
            _zag_str_free(body);
            return package_registry_graph_lock_bad(
                PackageRegistryTransitiveError.invalid_graph);
        }
        let grouped: []u8 = package_registry_transitive_group(edges, candidate);
        let selected: PackageRegistryLookup =
            package_registry_lookup_all(index, candidate, grouped);
        if (grouped.len > 0) { _zag_str_free(grouped); }
        if (selected.found == 0) {
            _zag_str_free(body);
            return package_registry_graph_lock_bad(
                PackageRegistryTransitiveError.version_conflict);
        }
        let first: []u8 = _zag_i64_to_str(selected.checksum.first);
        let second: []u8 = _zag_i64_to_str(selected.checksum.second);
        let bytes: []u8 = _zag_i64_to_str(selected.checksum.bytes);
        let line: []u8 = _zag_str_concat("entry=", candidate);
        line = package_registry_transitive_append_owned(line, "\t");
        line = package_registry_transitive_append_owned(line, selected.version);
        line = package_registry_transitive_append_owned(line, "\t");
        line = package_registry_transitive_append_owned(line, selected.source);
        line = package_registry_transitive_append_owned(line, "\t");
        line = package_registry_transitive_append_owned(line, first);
        line = package_registry_transitive_append_owned(line, ",");
        line = package_registry_transitive_append_owned(line, second);
        line = package_registry_transitive_append_owned(line, ",");
        line = package_registry_transitive_append_owned(line, bytes);
        line = package_registry_transitive_append_owned(line, "\n");
        body = package_registry_transitive_append_owned(body, line);
        _zag_str_free(line); _zag_str_free(first); _zag_str_free(second);
        _zag_str_free(bytes); previous = candidate; emitted = emitted + 1;
    }
    let checksum: PackageRawChecksum = package_raw_checksum(body);
    let first: []u8 = _zag_i64_to_str(checksum.first);
    let second: []u8 = _zag_i64_to_str(checksum.second);
    let bytes: []u8 = _zag_i64_to_str(checksum.bytes);
    let line: []u8 = _zag_str_concat("checksum=", first);
    line = package_registry_transitive_append_owned(line, ",");
    line = package_registry_transitive_append_owned(line, second);
    line = package_registry_transitive_append_owned(line, ",");
    line = package_registry_transitive_append_owned(line, bytes);
    line = package_registry_transitive_append_owned(line, "\n");
    let result: []u8 = package_registry_transitive_append_owned(body, line);
    _zag_str_free(line); _zag_str_free(first);
    _zag_str_free(second); _zag_str_free(bytes);
    return PackageRegistryGraphLock{.bytes = result, .valid = 1,
        .package_count = graph.package_count,
        .error = PackageRegistryTransitiveError.none};
}

// Verify a graph lock against the exact local index and explicit edge set.
// This is stronger than checksum validation alone: every selected package is
// checked against all incoming requirements, and coverage must match the
// graph's distinct targets. It is still caller-owned authority until the
// foreground resolver wires this API into package_import_resolve.
fn package_registry_graph_lock_verify(index: []u8, edges: []u8,
    lock: []u8) PackageRegistryGraphLockCheck {
    let graph: PackageRegistryTransitiveLookup =
        package_registry_transitive_lookup(index, edges);
    if (graph.valid == 0) {
        return package_registry_graph_lock_check_bad(graph.error);
    }
    if (lock.len == 0 || lock.len > 1048576 || lock[lock.len - 1] != '\n' ||
        !@strEq(package_registry_line(lock, 0),
            "format=zag-registry-graph-lock-v1")) {
        return package_registry_graph_lock_check_bad(
            PackageRegistryTransitiveError.invalid_lock);
    }
    let line_count: i32 = package_registry_graph_lock_line_count(lock);
    if (line_count != graph.package_count + 3) {
        return package_registry_graph_lock_check_bad(
            PackageRegistryTransitiveError.lock_mismatch);
    }
    let checksum_line: []u8 = package_registry_line(lock, line_count - 2);
    if (checksum_line.len < 10 || !@strEq(checksum_line[0..9], "checksum=")) {
        return package_registry_graph_lock_check_bad(
            PackageRegistryTransitiveError.invalid_lock);
    }
    let mark: i32 = 0; let i: i32 = 0;
    while (i < lock.len) {
        if ((i == 0 || lock[i - 1] == '\n') && i + 9 <= lock.len &&
            @strEq(lock[i..i + 9], "checksum=")) {
            mark = i;
        }
        i = i + 1;
    }
    if (mark <= 0 || mark + checksum_line.len + 1 != lock.len) {
        return package_registry_graph_lock_check_bad(
            PackageRegistryTransitiveError.invalid_lock);
    }
    let claimed: PackageChecksumParse = package_lock_checksum(
        checksum_line[9..checksum_line.len]);
    if (claimed.valid == 0 || package_raw_checksum_equal(
        package_raw_checksum(lock[0..mark]), claimed.checksum) == 0) {
        return package_registry_graph_lock_check_bad(
            PackageRegistryTransitiveError.invalid_lock);
    }

    let previous: []u8 = ""; let line_no: i32 = 1;
    while (line_no < line_count - 2) {
        let entry: PackageRegistryGraphLockEntry =
            package_registry_graph_lock_entry(package_registry_line(lock, line_no));
        let name: []u8 = entry.name; let version: []u8 = entry.version;
        let source: []u8 = entry.source;
        let checksum: PackageRawChecksum = entry.checksum;
        if (entry.valid == 0 ||
            (previous.len > 0 &&
             package_registry_transitive_compare(name, previous) <= 0)) {
            return package_registry_graph_lock_check_bad(
                PackageRegistryTransitiveError.invalid_lock);
        }
        let grouped: []u8 = package_registry_transitive_group(edges, name);
        let selected: PackageRegistryLookup =
            package_registry_lookup_all(index, name, grouped);
        if (grouped.len > 0) { _zag_str_free(grouped); }
        if (selected.found == 0 || !@strEq(selected.version, version) ||
            !@strEq(selected.source, source) ||
            package_raw_checksum_equal(selected.checksum, checksum) == 0) {
            return PackageRegistryGraphLockCheck{.valid = 0,
                .entry_count = line_count - 3, .failing_name = name,
                .error = PackageRegistryTransitiveError.lock_mismatch};
        }
        previous = name; line_no = line_no + 1;
    }

    // Equal entry counts are insufficient: an extra valid registry package
    // could replace a required target. Confirm coverage of every graph target.
    let edge_count: i32 = package_registry_transitive_line_count(edges);
    let target_no: i32 = 0;
    while (target_no < edge_count) {
        let target_line: []u8 = package_registry_line(edges, target_no);
        let target: []u8 = package_registry_transitive_part(target_line, 1);
        let prior: i32 = 0; let prior_no: i32 = 0;
        while (prior_no < target_no) {
            let prior_line: []u8 = package_registry_line(edges, prior_no);
            if (@strEq(package_registry_transitive_part(prior_line, 1), target)) {
                prior = 1; break;
            }
            prior_no = prior_no + 1;
        }
        if (prior == 0 && package_registry_graph_lock_has_name(lock, target) == 0) {
            return PackageRegistryGraphLockCheck{.valid = 0,
                .entry_count = line_count - 3, .failing_name = target,
                .error = PackageRegistryTransitiveError.lock_mismatch};
        }
        target_no = target_no + 1;
    }
    return PackageRegistryGraphLockCheck{.valid = 1,
        .entry_count = line_count - 3, .failing_name = "",
        .error = PackageRegistryTransitiveError.none};
}

// Opt-in graph-lock v2 provenance.  v1 intentionally remains a four-field,
// checksum-only format.  v2 records the stable scope/index identity and the
// selected artifact-signature path, but this codec remains filesystem- and
// crypto-neutral: callers must perform detached Ed25519 verification over
// their retained bytes before treating a signed policy as authoritative.
enum PackageRegistryGraphLockV2Policy {
    unsigned,
    signed_index,
    signed_artifact,
}

struct PackageRegistryGraphLockV2 {
    bytes: []u8,
    valid: i32,
    package_count: i32,
    error: PackageRegistryTransitiveError,
}

struct PackageRegistryGraphLockV2Check {
    valid: i32,
    entry_count: i32,
    failing_name: []u8,
    error: PackageRegistryTransitiveError,
}

struct PackageRegistryGraphLockV2Entry {
    scope: []u8,
    name: []u8,
    index_path: []u8,
    index_checksum: PackageRawChecksum,
    version: []u8,
    source: []u8,
    checksum: PackageRawChecksum,
    artifact_signature: []u8,
    valid: i32,
}

fn package_registry_graph_lock_v2_bad(
    error: PackageRegistryTransitiveError) PackageRegistryGraphLockV2 {
    return PackageRegistryGraphLockV2{.bytes = "", .valid = 0,
        .package_count = 0, .error = error};
}

fn package_registry_graph_lock_v2_check_bad(
    error: PackageRegistryTransitiveError) PackageRegistryGraphLockV2Check {
    return PackageRegistryGraphLockV2Check{.valid = 0, .entry_count = 0,
        .failing_name = "", .error = error};
}

fn package_registry_graph_lock_v2_policy_valid(
    policy: PackageRegistryGraphLockV2Policy) i32 {
    return (policy == PackageRegistryGraphLockV2Policy.unsigned ||
        policy == PackageRegistryGraphLockV2Policy.signed_index ||
        policy == PackageRegistryGraphLockV2Policy.signed_artifact) as i32;
}

fn package_registry_graph_lock_v2_policy_text(
    policy: PackageRegistryGraphLockV2Policy) []u8 {
    if (policy == PackageRegistryGraphLockV2Policy.unsigned) {
        return "unsigned";
    }
    if (policy == PackageRegistryGraphLockV2Policy.signed_index) {
        return "signed-index";
    }
    if (policy == PackageRegistryGraphLockV2Policy.signed_artifact) {
        return "signed-artifact";
    }
    return "";
}

fn package_registry_graph_lock_v2_allow_signed(
    policy: PackageRegistryGraphLockV2Policy) i32 {
    return (policy != PackageRegistryGraphLockV2Policy.unsigned) as i32;
}

fn package_registry_graph_lock_v2_signed_index(index: []u8) i32 {
    return @strEq(package_registry_index_line(index, 2),
        "signature=ed25519") as i32;
}

fn package_registry_graph_lock_v2_select(index: []u8, name: []u8,
    requirements: []u8, policy: PackageRegistryGraphLockV2Policy)
    PackageRegistryIndexLookup {
    let allow_signed: i32 = package_registry_graph_lock_v2_allow_signed(policy);
    if (requirements.len == 0) {
        return package_registry_index_select(index, name, "", allow_signed);
    }
    return package_registry_index_select_all(index, name, requirements,
        allow_signed);
}

fn package_registry_graph_lock_v2_part(line: []u8, wanted: i32) []u8 {
    if (package_registry_part_count(line[6..line.len]) != 8) { return ""; }
    return package_registry_part(line[6..line.len], wanted);
}

fn package_registry_graph_lock_v2_entry(line: []u8)
    PackageRegistryGraphLockV2Entry {
    let zero: PackageRawChecksum = PackageRawChecksum{.first = 0,
        .second = 0, .bytes = 0};
    let bad: PackageRegistryGraphLockV2Entry = PackageRegistryGraphLockV2Entry{
        .scope = "", .name = "", .index_path = "", .index_checksum = zero,
        .version = "", .source = "", .checksum = zero,
        .artifact_signature = "", .valid = 0};
    if (line.len < 7 || !@strEq(line[0..6], "entry=") ||
        package_registry_part_count(line[6..line.len]) != 8) { return bad; }
    let fields: []u8 = line[6..line.len];
    let scope: []u8 = package_registry_part(fields, 0);
    let name: []u8 = package_registry_part(fields, 1);
    let index_path: []u8 = package_registry_part(fields, 2);
    let index_sum: PackageChecksumParse = package_lock_checksum(
        package_registry_part(fields, 3));
    let version: []u8 = package_registry_part(fields, 4);
    let source: []u8 = package_registry_part(fields, 5);
    let artifact_sum: PackageChecksumParse = package_lock_checksum(
        package_registry_part(fields, 6));
    let artifact_signature: []u8 = package_registry_part(fields, 7);
    if (package_import_artifact_safe(scope) == 0 ||
        package_import_safe_name(name) == 0 ||
        package_import_artifact_safe(index_path) == 0 ||
        index_sum.valid == 0 || package_semver_parse(version).valid == 0 ||
        package_import_artifact_safe(source) == 0 || artifact_sum.valid == 0 ||
        (artifact_signature.len > 0 &&
         package_import_artifact_safe(artifact_signature) == 0)) { return bad; }
    return PackageRegistryGraphLockV2Entry{.scope = scope, .name = name,
        .index_path = index_path, .index_checksum = index_sum.checksum,
        .version = version, .source = source, .checksum = artifact_sum.checksum,
        .artifact_signature = artifact_signature, .valid = 1};
}

fn package_registry_graph_lock_v2_entry_after(
    a: PackageRegistryGraphLockV2Entry,
    b: PackageRegistryGraphLockV2Entry) i32 {
    let order: i32 = package_registry_transitive_compare(a.scope, b.scope);
    if (order != 0) { return (order > 0) as i32; }
    order = package_registry_transitive_compare(a.name, b.name);
    if (order != 0) { return (order > 0) as i32; }
    order = package_registry_transitive_compare(a.index_path, b.index_path);
    if (order != 0) { return (order > 0) as i32; }
    return (package_registry_transitive_compare(a.version, b.version) > 0) as i32;
}

fn package_registry_graph_lock_v2_line_count(text: []u8) i32 {
    if (text.len == 0) { return 0; }
    let count: i32 = 1; let i: i32 = 0;
    while (i < text.len) {
        if (text[i] == '\n') { count = count + 1; }
        i = i + 1;
    }
    return count;
}

fn package_registry_graph_lock_v2_valid_shape(lock: []u8,
    policy: PackageRegistryGraphLockV2Policy) i32 {
    if (package_registry_graph_lock_v2_policy_valid(policy) == 0 ||
        lock.len == 0 || lock.len > 1048576 || lock[lock.len - 1] != '\n' ||
        !@strEq(package_registry_line(lock, 0),
            "format=zag-registry-graph-lock-v2") ||
        package_registry_line(lock, 1).len !=
            package_registry_graph_lock_v2_policy_text(policy).len + 7 ||
        !@strEq(package_registry_line(lock, 1)[0..7], "policy=") ||
        !@strEq(package_registry_line(lock, 1)[7..package_registry_line(lock, 1).len],
            package_registry_graph_lock_v2_policy_text(policy))) { return 0; }
    let line_count: i32 = package_registry_graph_lock_v2_line_count(lock);
    if (line_count < 5 || line_count > 260) { return 0; }
    let mark: i32 = package_registry_checksum_mark(lock);
    if (mark <= 0 || mark >= lock.len) { return 0; }
    let checksum_line: []u8 = package_registry_line(lock, line_count - 2);
    if (checksum_line.len < 10 || !@strEq(checksum_line[0..9], "checksum=") ||
        mark + checksum_line.len + 1 != lock.len) { return 0; }
    let claimed: PackageChecksumParse = package_lock_checksum(
        checksum_line[9..checksum_line.len]);
    if (claimed.valid == 0 || package_raw_checksum_equal(
        package_raw_checksum(lock[0..mark]), claimed.checksum) == 0) { return 0; }
    let previous: PackageRegistryGraphLockV2Entry =
        package_registry_graph_lock_v2_entry(package_registry_line(lock, 2));
    let entries: i32 = 0; let line_no: i32 = 2;
    while (line_no < line_count - 2) {
        let entry: PackageRegistryGraphLockV2Entry =
            package_registry_graph_lock_v2_entry(package_registry_line(lock, line_no));
        if (entry.valid == 0 || (entries > 0 &&
            package_registry_graph_lock_v2_entry_after(entry, previous) == 0)) {
            return 0;
        }
        previous = entry; entries = entries + 1;
        line_no = line_no + 1;
    }
    return (entries > 0 && line_no == line_count - 2) as i32;
}

// Validate explicit transitive edges using the signed-index-aware resolver
// selection primitive.  Cryptographic verification remains an outer caller
// obligation because this module only receives byte snapshots.
fn package_registry_graph_lock_v2_lookup(index: []u8, edges: []u8,
    policy: PackageRegistryGraphLockV2Policy) PackageRegistryTransitiveLookup {
    if (package_registry_graph_lock_v2_policy_valid(policy) == 0 ||
        package_registry_index_valid_local_mode(index,
            package_registry_graph_lock_v2_allow_signed(policy)) == 0) {
        return package_registry_transitive_bad(
            PackageRegistryTransitiveError.invalid_index);
    }
    if (policy != PackageRegistryGraphLockV2Policy.unsigned &&
        package_registry_graph_lock_v2_signed_index(index) == 0) {
        return package_registry_transitive_bad(
            PackageRegistryTransitiveError.invalid_index);
    }
    if (edges.len == 0 || edges.len > 1048576 || edges[edges.len - 1] == '\n') {
        return package_registry_transitive_bad(
            PackageRegistryTransitiveError.invalid_graph);
    }
    let edge_count: i32 = package_registry_transitive_line_count(edges);
    if (edge_count <= 0 || edge_count > 256) {
        return package_registry_transitive_bad(
            PackageRegistryTransitiveError.invalid_graph);
    }
    let line_no: i32 = 0;
    while (line_no < edge_count) {
        let line: []u8 = package_registry_line(edges, line_no);
        let from: []u8 = package_registry_transitive_part(line, 0);
        let to: []u8 = package_registry_transitive_part(line, 1);
        let requirement: []u8 = package_registry_transitive_part(line, 2);
        if (from.len == 0 || to.len == 0 ||
            package_registry_transitive_node_safe(from) == 0 ||
            package_import_safe_name(to) == 0 ||
            (requirement.len > 0 &&
             package_version_requirement_valid(requirement) == 0)) {
            return package_registry_transitive_bad(
                PackageRegistryTransitiveError.invalid_graph);
        }
        if (!@strEq(from, "root")) {
            let source: PackageRegistryIndexLookup =
                package_registry_graph_lock_v2_select(index, from, "", policy);
            if (source.found == 0) {
                return PackageRegistryTransitiveLookup{.valid = 0,
                    .edge_count = edge_count, .package_count = 0,
                    .failing_from = from, .failing_to = to,
                    .error = PackageRegistryTransitiveError.missing_dependency};
            }
        }
        line_no = line_no + 1;
    }
    let package_count: i32 = 0; let target_no: i32 = 0;
    while (target_no < edge_count) {
        let target_line: []u8 = package_registry_line(edges, target_no);
        let target: []u8 = package_registry_transitive_part(target_line, 1);
        let prior: i32 = 0; let prior_no: i32 = 0;
        while (prior_no < target_no) {
            let prior_line: []u8 = package_registry_line(edges, prior_no);
            if (@strEq(package_registry_transitive_part(prior_line, 1), target)) {
                prior = 1; break;
            }
            prior_no = prior_no + 1;
        }
        if (prior == 0) {
            let grouped: []u8 = package_registry_transitive_group(edges, target);
            let selected: PackageRegistryIndexLookup =
                package_registry_graph_lock_v2_select(index, target, grouped, policy);
            if (grouped.len > 0) { _zag_str_free(grouped); }
            if (selected.found == 0) {
                let error: PackageRegistryTransitiveError =
                    PackageRegistryTransitiveError.version_conflict;
                if (selected.error == PackageImportError.dependency_not_found) {
                    error = PackageRegistryTransitiveError.missing_dependency;
                }
                return PackageRegistryTransitiveLookup{.valid = 0,
                    .edge_count = edge_count, .package_count = package_count,
                    .failing_from = "root", .failing_to = target, .error = error};
            }
            if (policy == PackageRegistryGraphLockV2Policy.signed_artifact &&
                selected.artifact_signature.len == 0) {
                return PackageRegistryTransitiveLookup{.valid = 0,
                    .edge_count = edge_count, .package_count = package_count,
                    .failing_from = "root", .failing_to = target,
                    .error = PackageRegistryTransitiveError.invalid_graph};
            }
            package_count = package_count + 1;
        }
        target_no = target_no + 1;
    }
    let budget: i32 = 65536; let source_no: i32 = 0;
    while (source_no < edge_count) {
        let source_line: []u8 = package_registry_line(edges, source_no);
        let source: []u8 = package_registry_transitive_part(source_line, 0);
        let prior: i32 = 0; let prior_no: i32 = 0;
        while (prior_no < source_no) {
            let prior_line: []u8 = package_registry_line(edges, prior_no);
            if (@strEq(package_registry_transitive_part(prior_line, 0), source)) {
                prior = 1; break;
            }
            prior_no = prior_no + 1;
        }
        if (prior == 0) {
            let path: []u8 = _zag_str_concat("", source);
            let cycle: i32 = package_registry_transitive_cycle_visit(
                edges, source, path, 0, &budget);
            _zag_str_free(path);
            if (cycle == 1) {
                return PackageRegistryTransitiveLookup{.valid = 0,
                    .edge_count = edge_count, .package_count = package_count,
                    .failing_from = source, .failing_to = source,
                    .error = PackageRegistryTransitiveError.cycle};
            }
            if (cycle == 2) {
                return PackageRegistryTransitiveLookup{.valid = 0,
                    .edge_count = edge_count, .package_count = package_count,
                    .failing_from = source, .failing_to = source,
                    .error = PackageRegistryTransitiveError.traversal_limit};
            }
        }
        source_no = source_no + 1;
    }
    return PackageRegistryTransitiveLookup{.valid = 1, .edge_count = edge_count,
        .package_count = package_count, .failing_from = "", .failing_to = "",
        .error = PackageRegistryTransitiveError.none};
}

fn package_registry_graph_lock_v2_entry_line(scope: []u8, name: []u8,
    index_path: []u8, index_checksum: PackageRawChecksum, version: []u8,
    source: []u8, checksum: PackageRawChecksum, signature: []u8) []u8 {
    let a: []u8 = _zag_i64_to_str(index_checksum.first);
    let b: []u8 = _zag_i64_to_str(index_checksum.second);
    let c: []u8 = _zag_i64_to_str(index_checksum.bytes);
    let d: []u8 = _zag_i64_to_str(checksum.first);
    let e: []u8 = _zag_i64_to_str(checksum.second);
    let f: []u8 = _zag_i64_to_str(checksum.bytes);
    let line: []u8 = _zag_str_concat("entry=", scope);
    line = package_registry_transitive_append_owned(line, "\t");
    line = package_registry_transitive_append_owned(line, name);
    line = package_registry_transitive_append_owned(line, "\t");
    line = package_registry_transitive_append_owned(line, index_path);
    line = package_registry_transitive_append_owned(line, "\t");
    line = package_registry_transitive_append_owned(line, a);
    line = package_registry_transitive_append_owned(line, ",");
    line = package_registry_transitive_append_owned(line, b);
    line = package_registry_transitive_append_owned(line, ",");
    line = package_registry_transitive_append_owned(line, c);
    line = package_registry_transitive_append_owned(line, "\t");
    line = package_registry_transitive_append_owned(line, version);
    line = package_registry_transitive_append_owned(line, "\t");
    line = package_registry_transitive_append_owned(line, source);
    line = package_registry_transitive_append_owned(line, "\t");
    line = package_registry_transitive_append_owned(line, d);
    line = package_registry_transitive_append_owned(line, ",");
    line = package_registry_transitive_append_owned(line, e);
    line = package_registry_transitive_append_owned(line, ",");
    line = package_registry_transitive_append_owned(line, f);
    line = package_registry_transitive_append_owned(line, "\t");
    line = package_registry_transitive_append_owned(line, signature);
    line = package_registry_transitive_append_owned(line, "\n");
    _zag_str_free(a); _zag_str_free(b); _zag_str_free(c);
    _zag_str_free(d); _zag_str_free(e); _zag_str_free(f);
    return line;
}

fn package_registry_graph_lock_v2_checksum_line(
    checksum: PackageRawChecksum) []u8 {
    let a: []u8 = _zag_i64_to_str(checksum.first);
    let b: []u8 = _zag_i64_to_str(checksum.second);
    let c: []u8 = _zag_i64_to_str(checksum.bytes);
    let line: []u8 = _zag_str_concat("checksum=", a);
    line = package_registry_transitive_append_owned(line, ",");
    line = package_registry_transitive_append_owned(line, b);
    line = package_registry_transitive_append_owned(line, ",");
    line = package_registry_transitive_append_owned(line, c);
    line = package_registry_transitive_append_owned(line, "\n");
    _zag_str_free(a); _zag_str_free(b); _zag_str_free(c);
    return line;
}

fn package_registry_graph_lock_v2_create(index: []u8, edges: []u8,
    scope: []u8, index_path: []u8,
    policy: PackageRegistryGraphLockV2Policy) PackageRegistryGraphLockV2 {
    if (package_registry_graph_lock_v2_policy_valid(policy) == 0 ||
        package_import_artifact_safe(scope) == 0 ||
        package_import_artifact_safe(index_path) == 0) {
        return package_registry_graph_lock_v2_bad(
            PackageRegistryTransitiveError.invalid_graph);
    }
    let graph: PackageRegistryTransitiveLookup =
        package_registry_graph_lock_v2_lookup(index, edges, policy);
    if (graph.valid == 0) {
        return package_registry_graph_lock_v2_bad(graph.error);
    }
    let body: []u8 = _zag_str_concat(
        "format=zag-registry-graph-lock-v2\npolicy=",
        package_registry_graph_lock_v2_policy_text(policy));
    body = package_registry_transitive_append_owned(body, "\n");
    let previous: []u8 = ""; let emitted: i32 = 0;
    while (emitted < graph.package_count) {
        let candidate: []u8 = ""; let line_no: i32 = 0;
        let edge_count: i32 = package_registry_transitive_line_count(edges);
        while (line_no < edge_count) {
            let target: []u8 = package_registry_transitive_part(
                package_registry_line(edges, line_no), 1);
            if (package_registry_transitive_compare(target, previous) > 0 &&
                (candidate.len == 0 || package_registry_transitive_compare(
                    target, candidate) < 0)) { candidate = target; }
            line_no = line_no + 1;
        }
        let grouped: []u8 = package_registry_transitive_group(edges, candidate);
        let selected: PackageRegistryIndexLookup =
            package_registry_graph_lock_v2_select(index, candidate, grouped, policy);
        if (grouped.len > 0) { _zag_str_free(grouped); }
        if (selected.found == 0 ||
            (policy == PackageRegistryGraphLockV2Policy.signed_artifact &&
             selected.artifact_signature.len == 0)) {
            _zag_str_free(body);
            return package_registry_graph_lock_v2_bad(
                PackageRegistryTransitiveError.version_conflict);
        }
        let line: []u8 = package_registry_graph_lock_v2_entry_line(scope,
            candidate, index_path, package_raw_checksum(index), selected.version,
            selected.source, selected.checksum, selected.artifact_signature);
        body = package_registry_transitive_append_owned(body, line);
        _zag_str_free(line); previous = candidate; emitted = emitted + 1;
    }
    let line: []u8 = package_registry_graph_lock_v2_checksum_line(
        package_raw_checksum(body));
    let result: []u8 = package_registry_transitive_append_owned(body, line);
    _zag_str_free(line);
    return PackageRegistryGraphLockV2{.bytes = result, .valid = 1,
        .package_count = graph.package_count,
        .error = PackageRegistryTransitiveError.none};
}

fn package_registry_graph_lock_v2_verify(index: []u8, edges: []u8,
    lock: []u8, scope: []u8, index_path: []u8,
    policy: PackageRegistryGraphLockV2Policy) PackageRegistryGraphLockV2Check {
    if (package_registry_graph_lock_v2_policy_valid(policy) == 0 ||
        package_import_artifact_safe(scope) == 0 ||
        package_import_artifact_safe(index_path) == 0 ||
        package_registry_graph_lock_v2_valid_shape(lock, policy) == 0) {
        return package_registry_graph_lock_v2_check_bad(
            PackageRegistryTransitiveError.invalid_lock);
    }
    let graph: PackageRegistryTransitiveLookup =
        package_registry_graph_lock_v2_lookup(index, edges, policy);
    if (graph.valid == 0) {
        return package_registry_graph_lock_v2_check_bad(graph.error);
    }
    let line_count: i32 = package_registry_graph_lock_v2_line_count(lock);
    if (line_count != graph.package_count + 4) {
        return package_registry_graph_lock_v2_check_bad(
            PackageRegistryTransitiveError.lock_mismatch);
    }
    let index_checksum: PackageRawChecksum = package_raw_checksum(index);
    let previous: PackageRegistryGraphLockV2Entry =
        package_registry_graph_lock_v2_entry(package_registry_line(lock, 2));
    let line_no: i32 = 2; let entries: i32 = 0;
    while (line_no < line_count - 2) {
        let entry: PackageRegistryGraphLockV2Entry =
            package_registry_graph_lock_v2_entry(package_registry_line(lock, line_no));
        if (entry.valid == 0 || (entries > 0 &&
            package_registry_graph_lock_v2_entry_after(entry, previous) == 0)) {
            return package_registry_graph_lock_v2_check_bad(
                PackageRegistryTransitiveError.invalid_lock);
        }
        let grouped: []u8 = package_registry_transitive_group(edges, entry.name);
        let selected: PackageRegistryIndexLookup =
            package_registry_graph_lock_v2_select(index, entry.name, grouped, policy);
        if (grouped.len > 0) { _zag_str_free(grouped); }
        if (!@strEq(entry.scope, scope) || !@strEq(entry.index_path, index_path) ||
            package_raw_checksum_equal(entry.index_checksum, index_checksum) == 0 ||
            selected.found == 0 || !@strEq(entry.version, selected.version) ||
            !@strEq(entry.source, selected.source) ||
            package_raw_checksum_equal(entry.checksum, selected.checksum) == 0 ||
            !@strEq(entry.artifact_signature, selected.artifact_signature) ||
            (policy == PackageRegistryGraphLockV2Policy.signed_artifact &&
             entry.artifact_signature.len == 0)) {
            return PackageRegistryGraphLockV2Check{.valid = 0,
                .entry_count = entries, .failing_name = entry.name,
                .error = PackageRegistryTransitiveError.lock_mismatch};
        }
        previous = entry; entries = entries + 1; line_no = line_no + 1;
    }
    let edge_count: i32 = package_registry_transitive_line_count(edges);
    let target_no: i32 = 0;
    while (target_no < edge_count) {
        let target: []u8 = package_registry_transitive_part(
            package_registry_line(edges, target_no), 1);
        let prior: i32 = 0; let prior_no: i32 = 0;
        while (prior_no < target_no) {
            if (@strEq(package_registry_transitive_part(
                package_registry_line(edges, prior_no), 1), target)) {
                prior = 1; break;
            }
            prior_no = prior_no + 1;
        }
        if (prior == 0) {
            let found: i32 = 0; let lock_no: i32 = 2;
            while (lock_no < line_count - 2) {
                if (@strEq(package_registry_graph_lock_v2_entry(
                    package_registry_line(lock, lock_no)).name, target)) {
                    found = 1; break;
                }
                lock_no = lock_no + 1;
            }
            if (found == 0) {
                return PackageRegistryGraphLockV2Check{.valid = 0,
                    .entry_count = entries, .failing_name = target,
                    .error = PackageRegistryTransitiveError.lock_mismatch};
            }
        }
        target_no = target_no + 1;
    }
    return PackageRegistryGraphLockV2Check{.valid = 1,
        .entry_count = entries, .failing_name = "",
        .error = PackageRegistryTransitiveError.none};
}
