// Exact-byte build receipt. The caller supplies the expected compiler SHA-256
// independently of the image and record. Both issuance and verification check
// it. This binds supplied bytes; the build adapter must still ensure that this
// image was actually used to compile the supplied source/artifact.
@import("evidence_codec.zag")

struct BuildReceiptInputs {
    source: []u8,
    compiler: []u8,
    target: []u8,
    artifact: []u8,
    provenance: []u8,
}

fn cab_key(source_hash: []u8, compiler_hash: []u8, target: []u8,
    artifact_hash: []u8) []u8 {
    let fields: ArrayList[[]u8] = make[[]u8](5);
    ev_add(&fields, "zag-content-address-v1");
    ev_add(&fields, source_hash);
    ev_add(&fields, compiler_hash);
    ev_add(&fields, target);
    ev_add(&fields, artifact_hash);
    let encoded: []u8 = ev_encode(fields);
    let result: []u8 = ev_empty();
    if (encoded.len > 0) {
        _zag_str_free(result);
        result = ev_hash(encoded);
    }
    ev_fields_free(&fields);
    _zag_str_free(encoded);
    return result;
}

fn cab_inputs_valid(inputs: BuildReceiptInputs, expected_compiler_sha: []u8) i32 {
    if (inputs.source.len < 0 || inputs.source.len > 67108864 ||
        inputs.compiler.len <= 0 || inputs.target.len <= 0 ||
        inputs.target.len > 4096 || inputs.artifact.len < 0 ||
        inputs.artifact.len > 67108864 || inputs.provenance.len <= 0 ||
        inputs.provenance.len > 67108864) {
        return 0;
    }
    return ev_matches(inputs.compiler, expected_compiler_sha);
}

// Owned empty string on refusal. v2 replaces the old self-declared "enforced"
// field with the checked expected digest. No v1 receipt is accepted as v2.
fn content_build_receipt_encode(source: []u8, compiler: []u8, target: []u8,
    artifact: []u8, provenance: []u8, expected_compiler_sha: []u8) []u8 {
    let inputs: BuildReceiptInputs = BuildReceiptInputs{
        .source = source, .compiler = compiler, .target = target,
        .artifact = artifact, .provenance = provenance };
    // Check identity before constructing any receipt fields or content address.
    if (cab_inputs_valid(inputs, expected_compiler_sha) == 0) {
        return ev_empty();
    }
    let fields: ArrayList[[]u8] = make[[]u8](9);
    ev_add(&fields, "zag-content-build-v2");
    push[[]u8](&fields, ev_hash(source));
    ev_add(&fields, expected_compiler_sha);
    ev_add(&fields, target);
    push[[]u8](&fields, ev_hash(artifact));
    ev_add_int(&fields, artifact.len);
    push[[]u8](&fields, ev_hash(provenance));
    ev_add(&fields, expected_compiler_sha);
    push[[]u8](&fields, cab_key(fields.data[1], fields.data[2], target, fields.data[4]));
    let result: []u8 = ev_encode(fields);
    ev_fields_free(&fields);
    return result;
}

fn content_build_receipt_verify(text: []u8, pin: []u8,
    inputs: BuildReceiptInputs, expected_compiler_sha: []u8) i32 {
    if (cab_inputs_valid(inputs, expected_compiler_sha) == 0) { return 0; }
    let record: EvidenceRecord = ev_decode(text, pin);
    let ok: i32 = 0;
    if (record.valid == 1 && record.fields.len == 9 &&
        ev_equal(ev_get(record, 0), "zag-content-build-v2") == 1 &&
        ev_equal(ev_get(record, 2), expected_compiler_sha) == 1 &&
        ev_equal(ev_get(record, 7), expected_compiler_sha) == 1 &&
        ev_matches(inputs.source, ev_get(record, 1)) == 1 &&
        ev_equal(inputs.target, ev_get(record, 3)) == 1 &&
        ev_matches(inputs.artifact, ev_get(record, 4)) == 1 &&
        ev_uint(ev_get(record, 5), 2147483647) == inputs.artifact.len &&
        ev_matches(inputs.provenance, ev_get(record, 6)) == 1) {
        let key: []u8 = cab_key(ev_get(record, 1), ev_get(record, 2),
            ev_get(record, 3), ev_get(record, 4));
        ok = ev_equal(key, ev_get(record, 8));
        _zag_str_free(key);
    }
    ev_fields_free(&record.fields);
    return ok;
}
