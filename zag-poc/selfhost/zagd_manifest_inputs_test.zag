@import("parse.zag")
@import("sema.zag")
@import("semantic_manifest.zag")
@import("zagd_manifest_inputs.zag")

extern fn _zag_read_file(path:[]u8)[]u8
extern fn _zag_write_file(path:[]u8,text:[]u8)i32

fn main()i32{
    if(_zag_argc()==4&&@strEq(_zag_arg(1),"--current")){
        let text:[]u8=_zag_read_file(_zag_arg(3));
        if(text.len<0){return 2;}
        let current:i32=zagd_manifest_modules_current(_zag_arg(2),text);
        _zag_free(_zag_slice_ptr(text));
        if(current==1){return 0;}return 1;
    }
    if(_zag_argc()==7&&@strEq(_zag_arg(1),"--matches")){
        // source, base-dir, compiler-cwd, project-root, semantic-record
        let source:[]u8=_zag_read_file(_zag_arg(2));
        if(source.len<0){return 6;}
        let unit:CompilationUnit=parse_compilation_unit_dir(source,_zag_arg(3));
        let text:[]u8=_zag_read_file(_zag_arg(6));
        if(text.len<0){return 7;}
        let matches:i32=semantic_manifest_matches_unit_inputs(_zag_arg(5),
            _zag_arg(4),text,source,unit.modules);
        _zag_free(_zag_slice_ptr(text));_zag_free(_zag_slice_ptr(source));
        if(matches==1){return 0;}return 1;
    }
    // source, base-dir, root-module, compiler-cwd, project-root, output-record
    if(_zag_argc()!=7){return 3;}
    let source:[]u8=_zag_read_file(_zag_arg(1));
    if(source.len<0){return 4;}
    let unit:CompilationUnit=parse_compilation_unit_dir(source,_zag_arg(2));
    let effects:map.StringMap[i32]=analyze(unit.decls);
    let manifest:*SemanticManifest=semantic_manifest_build_published(_zag_arg(3),
        source,unit.profile,unit.decls,effects,unit.modules,unit.imports,
        unit.resources,_zag_arg(4),_zag_arg(5));
    if(semantic_manifest_decode(manifest.*.text).valid==0||
        semantic_manifest_matches_unit_inputs(_zag_arg(5),_zag_arg(4),
            manifest.*.text,source,unit.modules)==0||
        zagd_manifest_modules_current(_zag_arg(5),manifest.*.text)==0){return 5;}
    return _zag_write_file(_zag_arg(6),manifest.*.text);
}
