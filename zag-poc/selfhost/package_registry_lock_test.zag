@import("package_registry_lock.zag")

extern fn _zag_str_free(s: []u8) void

fn lock_entry_body(alias: []u8, index_path: []u8, index_bytes: []u8,
                   version: []u8, source: []u8, artifact_bytes: []u8) []u8 {
    let index_fields: []u8 = package_registry_lock_checksum_line(
        package_raw_checksum(index_bytes));
    let artifact_fields: []u8 = package_registry_lock_checksum_line(
        package_raw_checksum(artifact_bytes));
    let index_checksum: []u8 = index_fields[9..index_fields.len - 1];
    let artifact_checksum: []u8 = artifact_fields[9..artifact_fields.len - 1];
    let line: []u8 = _zag_str_concat("entry=", alias);
    line = _zag_str_concat(line, "\t");
    line = _zag_str_concat(line, index_path);
    line = _zag_str_concat(line, "\t");
    line = _zag_str_concat(line, index_checksum);
    line = _zag_str_concat(line, "\t");
    line = _zag_str_concat(line, version);
    line = _zag_str_concat(line, "\t");
    line = _zag_str_concat(line, source);
    line = _zag_str_concat(line, "\t");
    line = _zag_str_concat(line, artifact_checksum);
    line = _zag_str_concat(line, "\n");
    _zag_str_free(index_fields); _zag_str_free(artifact_fields);
    return line;
}

fn lock_entry_body_signed(alias: []u8, index_path: []u8, index_bytes: []u8,
                          version: []u8, source: []u8, artifact_bytes: []u8,
                          artifact_signature: []u8) []u8 {
    let plain: []u8 = lock_entry_body(alias, index_path, index_bytes,
        version, source, artifact_bytes);
    let prefix: []u8 = _zag_str_concat(plain[0..plain.len - 1], "\t");
    let with_signature: []u8 = _zag_str_concat(prefix, artifact_signature);
    let result: []u8 = _zag_str_concat(with_signature, "\n");
    _zag_str_free(plain); _zag_str_free(prefix); _zag_str_free(with_signature);
    return result;
}

fn lock_record(first: []u8, second: []u8) []u8 {
    let body: []u8 = _zag_str_concat("format=zag-registry-lock-v1\n", first);
    body = _zag_str_concat(body, second);
    let result: []u8 = package_registry_lock_finalize(body);
    _zag_str_free(body);
    return result;
}

fn check(ok: i32, label: []u8, pass: *i32, fail: *i32) void {
    if (ok != 0) { _zag_print("ok  "); _zag_println(label); pass.* = pass.* + 1; }
    else { _zag_print("FAIL "); _zag_println(label); fail.* = fail.* + 1; }
}

fn main() i32 {
    let pass: i32 = 0; let fail: i32 = 0;
    let index: []u8 = "registry-index-v1\n";
    let artifact: []u8 = "artifact-alpha-v1\n";
    let line: []u8 = lock_entry_body("alpha", "registry/index.zag", index,
        "1.2.0", "src/alpha.zag", artifact);
    let lock: []u8 = lock_record(line, "");
    check(package_registry_lock_valid(lock), "canonical lock validates", &pass, &fail);
    let lookup: PackageRegistryLockLookup = package_registry_lock_lookup(
        lock, "alpha", "registry/index.zag");
    check(lookup.found == 1 && lookup.error == PackageRegistryLockError.none &&
        @strEq(lookup.entry.version, "1.2.0") &&
        @strEq(lookup.entry.source, "src/alpha.zag"),
        "exact alias/index lookup returns the pinned version and source", &pass, &fail);
    check(package_registry_lock_match(lock, "alpha", "registry/index.zag",
        "1.2.0", "src/alpha.zag", index, artifact) == PackageRegistryLockError.none,
        "matching index and artifact bytes are accepted", &pass, &fail);
    check(package_registry_lock_match(lock, "alpha", "registry/index.zag",
        "1.1.0", "src/alpha.zag", index, artifact) == PackageRegistryLockError.version_mismatch,
        "stale selected version is rejected", &pass, &fail);
    check(package_registry_lock_match(lock, "alpha", "registry/index.zag",
        "1.2.0", "src/other.zag", index, artifact) == PackageRegistryLockError.source_mismatch,
        "redirected source is rejected", &pass, &fail);
    check(package_registry_lock_match(lock, "alpha", "registry/index.zag",
        "1.2.0", "src/alpha.zag", "changed-index\n", artifact) == PackageRegistryLockError.index_checksum_mismatch,
        "mutated registry index is rejected", &pass, &fail);
    check(package_registry_lock_match(lock, "alpha", "registry/index.zag",
        "1.2.0", "src/alpha.zag", index, "changed-artifact\n") == PackageRegistryLockError.artifact_checksum_mismatch,
        "mutated artifact is rejected", &pass, &fail);

    let beta: []u8 = lock_entry_body("beta", "registry/index.zag", index,
        "1.0.0", "src/beta.zag", artifact);
    let duplicate: []u8 = lock_record(line, line);
    check(package_registry_lock_valid(duplicate) == 0,
        "duplicate entry is rejected after checksum recomputation", &pass, &fail);
    let duplicate_source_line: []u8 = lock_entry_body("alpha",
        "registry/index.zag", index, "1.2.0", "src/other.zag", artifact);
    let duplicate_selection: []u8 = lock_record(line, duplicate_source_line);
    check(package_registry_lock_valid(duplicate_selection) == 0,
        "duplicate selection key cannot redirect to another source", &pass, &fail);
    let reversed: []u8 = lock_record(beta, line);
    check(package_registry_lock_valid(reversed) == 0,
        "noncanonical entry order is rejected after checksum recomputation", &pass, &fail);
    let truncated: []u8 = lock[0..lock.len - 1];
    check(package_registry_lock_valid(truncated) == 0,
        "truncated final checksum is rejected", &pass, &fail);
    let forged: []u8 = _zag_str_concat(lock[0..lock.len - 1], "checksum=1,2,3\n");
    check(package_registry_lock_valid(forged) == 0,
        "forged checksum is rejected", &pass, &fail);

    let signed_line: []u8 = lock_entry_body_signed("alpha",
        "registry/index.zag", index, "1.2.0", "src/alpha.zag", artifact,
        "signatures/alpha.sig");
    let signed_lock: []u8 = lock_record(signed_line, "");
    let signed_lookup: PackageRegistryLockLookup = package_registry_lock_lookup(
        signed_lock, "alpha", "registry/index.zag");
    check(package_registry_lock_valid(signed_lock) != 0 &&
        @strEq(signed_lookup.entry.artifact_signature, "signatures/alpha.sig"),
        "signed lock retains its validated artifact-signature path", &pass, &fail);
    check(package_registry_lock_match_signed(signed_lock, "alpha",
        "registry/index.zag", "1.2.0", "src/alpha.zag", index, artifact,
        "signatures/alpha.sig") == PackageRegistryLockError.none,
        "signed matcher accepts the exact artifact-signature path", &pass, &fail);
    check(package_registry_lock_match(signed_lock, "alpha", "registry/index.zag",
        "1.2.0", "src/alpha.zag", index, artifact) ==
        PackageRegistryLockError.artifact_signature_mismatch,
        "legacy unsigned matcher cannot hide a required signature path", &pass, &fail);
    check(package_registry_lock_match_signed(signed_lock, "alpha",
        "registry/index.zag", "1.2.0", "src/alpha.zag", index, artifact,
        "signatures/other.sig") == PackageRegistryLockError.artifact_signature_mismatch,
        "signed matcher rejects a redirected artifact-signature path", &pass, &fail);
    let unsafe_signature_line: []u8 = lock_entry_body_signed("alpha",
        "registry/index.zag", index, "1.2.0", "src/alpha.zag", artifact,
        "../signatures/alpha.sig");
    let unsafe_signature_lock: []u8 = lock_record(unsafe_signature_line, "");
    check(package_registry_lock_valid(unsafe_signature_lock) == 0,
        "traversal in artifact-signature provenance is rejected", &pass, &fail);

    check(package_registry_lock_core_checksum_valid("1000000007,0,1") == 0 &&
        package_registry_lock_core_checksum_valid("1,2,8388609") == 0,
        "out-of-range checksum tuples are rejected before lock matching", &pass, &fail);

    _zag_str_free(line); _zag_str_free(lock); _zag_str_free(beta);
    _zag_str_free(duplicate); _zag_str_free(duplicate_source_line);
    _zag_str_free(duplicate_selection); _zag_str_free(reversed); _zag_str_free(forged);
    _zag_str_free(signed_line); _zag_str_free(signed_lock);
    _zag_str_free(unsafe_signature_line); _zag_str_free(unsafe_signature_lock);
    _zag_print("package registry lock: "); _zag_print(_zag_i64_to_str(pass as i64));
    _zag_print("/"); _zag_println(_zag_i64_to_str((pass + fail) as i64));
    return (fail != 0) as i32;
}
