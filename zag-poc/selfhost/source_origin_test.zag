@import("parse.zag")

fn so_check(ok:i32,name:[]u8,fail:*i32)void{
    if(ok==1){_zag_println(_zag_str_concat("ok  ",name));}
    else{_zag_eprintln(_zag_str_concat("XX  ",name));fail.*=fail.*+1;}
}

fn so_tree_missing(n:*Node,origins:ArrayList[NodeOrigin])i32{
    let missing:i32=(node_origin_find(origins,n).stable_id==0) as i32;
    switch(n.*){
        .fn_decl=>|f|{let i:i32=0;while(i<f.body.len){missing=missing+so_tree_missing(f.body.data[i],origins);i=i+1;}}
        .let_=>|x|{if(x.has_init==1){missing=missing+so_tree_missing(x.expr,origins);}}
        .ret=>|x|{if(x.has_expr==1){missing=missing+so_tree_missing(x.expr,origins);}}
        .if_=>|x|{missing=missing+so_tree_missing(x.cond,origins);let i:i32=0;
            while(i<x.then_body.len){missing=missing+so_tree_missing(x.then_body.data[i],origins);i=i+1;}
            i=0;while(i<x.els_body.len){missing=missing+so_tree_missing(x.els_body.data[i],origins);i=i+1;}}
        .while_=>|x|{missing=missing+so_tree_missing(x.cond,origins);let i:i32=0;
            while(i<x.body.len){missing=missing+so_tree_missing(x.body.data[i],origins);i=i+1;}}
        .assign=>|x|{missing=missing+so_tree_missing(x.target,origins)+so_tree_missing(x.expr,origins);}
        .estmt=>|x|{missing=missing+so_tree_missing(x.expr,origins);}
        .bin=>|x|{missing=missing+so_tree_missing(x.l,origins)+so_tree_missing(x.r,origins);}
        .un=>|x|{missing=missing+so_tree_missing(x.e,origins);}
        .call=>|x|{missing=missing+so_tree_missing(x.callee,origins);let i:i32=0;
            while(i<x.args.len){missing=missing+so_tree_missing(x.args.data[i],origins);i=i+1;}}
        .fld=>|x|{missing=missing+so_tree_missing(x.base,origins);}
        .idx=>|x|{missing=missing+so_tree_missing(x.base,origins)+so_tree_missing(x.idx,origins);}
        else=>{}
    }
    return missing;
}

fn main()i32{
    let fail:i32=0;
    let unicode_src:[]u8="fn main() []u8 { return \"λ\"; }\r\n";
    let toks:ArrayList[Token]=lex(unicode_src);let str_origin_ok:i32=0;let i:i32=0;
    while(i<toks.len){let t:Token=toks.data[i];if(t.kind==Tk.Str&&t.byte_start==24&&
        t.byte_end==28&&t.line==1&&t.col==25){str_origin_ok=1;}i=i+1;}
    so_check(str_origin_ok==1&&toks.data[toks.len-1].byte_start==33,
        "lexer preserves Unicode CRLF byte offsets",&fail);

    let source:[]u8="fn add(x:i32,y:i32) i32 { return x+y; }\nfn main() i32 { let x:i32=add(1,2); while (x<4) { x=x+1; } if (x==4) { return x; } else { return 0; } }\n";
    let first:CompilationUnit=parse_compilation_unit_dir(source,".");
    let second:CompilationUnit=parse_compilation_unit_dir(source,".");
    let add_origin:NodeOrigin=node_origin_find(first.origins,first.decls.data[0]);
    let main_origin:NodeOrigin=node_origin_find(first.origins,first.decls.data[1]);
    so_check(add_origin.byte_start==0&&add_origin.byte_end==39&&add_origin.line==1&&
        add_origin.col==1&&main_origin.byte_start==40&&main_origin.byte_end==143&&
        main_origin.line==2&&add_origin.exact==1&&main_origin.exact==1,"exact declaration source spans",&fail);
    let missing:i32=so_tree_missing(first.decls.data[0],first.origins)+
        so_tree_missing(first.decls.data[1],first.origins);
    so_check(missing==0,"all reachable parsed scalar AST nodes have origins",&fail);
    let stable:i32=(first.origins.len==second.origins.len) as i32;i=0;
    while(i<first.origins.len&&stable==1){let a:NodeOrigin=first.origins.data[i];let b:NodeOrigin=second.origins.data[i];
        if(a.stable_id!=b.stable_id||a.byte_start!=b.byte_start||a.byte_end!=b.byte_end||
            !@strEq(a.module,b.module)){stable=0;}i=i+1;}
    so_check(stable==1,"node origin IDs are deterministic",&fail);

    let script:CompilationUnit=parse_compilation_unit_dir("script;\nlet x = 1\nreturn x\n",".");
    let wrapper_missing:i32=0;let user_body_complete:i32=0;i=0;
    while(i<script.decls.len){let d:*Node=script.decls.data[i];switch(d.*){.fn_decl=>|f|{
        if(@strEq(f.name,"main")){wrapper_missing=(node_origin_find(script.origins,d).stable_id==0) as i32;}
        if(@strEq(f.name,"__zag_compiler_script_body_7f3a")&&f.body.len>=2){user_body_complete=
            (node_origin_find(script.origins,f.body.data[0]).stable_id!=0&&
             node_origin_find(script.origins,f.body.data[1]).stable_id!=0) as i32;}}
        else=>{}}i=i+1;}
    so_check(wrapper_missing==1&&user_body_complete==1,
        "synthetic wrappers fail closed while user Script nodes retain origins",&fail);

    let compact:[]u8="script;\nif True:\n    print(\"λ\")\nelse:\n    return 7\n";
    let compact_unit:CompilationUnit=parse_compilation_unit_dir(compact,".");
    let compact_if:*Node=compact_unit.decls.data[0];i=0;
    while(i<compact_unit.decls.len){let d:*Node=compact_unit.decls.data[i];switch(d.*){
        .fn_decl=>|f|{if(@strEq(f.name,"__zag_compiler_script_body_7f3a")&&f.body.len>0){compact_if=f.body.data[0];}}
        else=>{}}i=i+1;}
    let if_origin:NodeOrigin=node_origin_find(compact_unit.origins,compact_if);
    let compact_children:i32=0;let cond_start:i32=0;let cond_end:i32=0;let print_start:i32=0;let print_end:i32=0;let print_line:i32=0;let print_col:i32=0;switch(compact_if.*){.if_=>|x|{
        let cond_origin:NodeOrigin=node_origin_find(compact_unit.origins,x.cond);
        let print_origin:NodeOrigin=node_origin_find(compact_unit.origins,x.then_body.data[0]);
        cond_start=cond_origin.byte_start;cond_end=cond_origin.byte_end;print_start=print_origin.byte_start;
        print_end=print_origin.byte_end;print_line=print_origin.line;print_col=print_origin.col;
        if(cond_origin.byte_start==8&&cond_origin.byte_end==16&&cond_origin.exact==0&&print_origin.byte_start==21&&
            print_origin.byte_end==32&&print_origin.line==3&&print_origin.col==5&&print_origin.exact==0){compact_children=1;}}
        else=>{}}
    so_check(if_origin.byte_start==8&&if_origin.byte_end==52&&if_origin.line==2&&
        if_origin.col==1&&compact_children==1,"indentation AST origins project to compact bytes",&fail);
    let compact_again:CompilationUnit=parse_compilation_unit_dir(compact,".");let compact_again_if:*Node=compact_again.decls.data[0];i=0;
    while(i<compact_again.decls.len){let d:*Node=compact_again.decls.data[i];switch(d.*){
        .fn_decl=>|f|{if(@strEq(f.name,"__zag_compiler_script_body_7f3a")&&f.body.len>0){compact_again_if=f.body.data[0];}}
        else=>{}}i=i+1;}
    so_check(node_origin_find(compact_unit.origins,compact_if).stable_id==
        node_origin_find(compact_again.origins,compact_again_if).stable_id,
        "compact projected origin IDs are deterministic",&fail);

    let imported:CompilationUnit=parse_compilation_unit_dir(
        "@import(\"tests/source_origins/compact_lib.zs\") as compact\nfn main() i32 { return compact.compact_value(); }\n",".");
    let imported_ok:i32=0;i=0;while(i<imported.decls.len){let d:*Node=imported.decls.data[i];switch(d.*){
        .fn_decl=>|f|{if(@strEq(f.name,"compact__compact_value")){let o:NodeOrigin=node_origin_find(imported.origins,d);
            if(@strEq(o.module,"tests/source_origins/compact_lib.zs")&&o.byte_start==8&&o.byte_end==42&&
                o.line==2&&o.col==1&&o.exact==0){imported_ok=1;}}}else=>{}}i=i+1;}
    so_check(imported_ok==1,"qualified compact-module origins survive cloning",&fail);

    if(fail==0){_zag_println("source-origin pass=8 fail=0");return 0;}return 1;
}
