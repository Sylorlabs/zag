// Transactional foreground publication. Failure is advisory and must never
// change the success/failure of an authoritative compilation.
@import("semantic_manifest.zag")
extern fn _zag_write_file(path:[]u8,text:[]u8)i32
extern fn _zag_raw_syscall(num:i64,a1:i64,a2:i64,a3:i64,a4:i64,a5:i64,a6:i64)i64
extern fn _zag_slice_ptr(s:[]u8)*i8
fn smp_cstring(s:[]u8)ArrayList[u8]{let out:ArrayList[u8]=make[u8](s.len+1);let i:i32=0;while(i<s.len){push[u8](&out,s[i]);i=i+1;}push[u8](&out,0 as u8);return out;}
fn smp_mkdir(path:[]u8)i32{
    let p:ArrayList[u8]=smp_cstring(path);
    let rc:i64=_zag_raw_syscall(83,_zag_slice_ptr(p.data[0..p.len]) as i64,493,0,0,0,0);
    free[u8](&p);
    if(rc==0||rc==(0-17)){return 1;}
    return 0;
}
fn smp_hash_fields(h:ZagdHash)[]u8{return _zag_str_concat(_zag_i64_to_str(h.first),_zag_str_concat(",",_zag_str_concat(_zag_i64_to_str(h.second),_zag_str_concat(",",_zag_i64_to_str(h.bytes)))));}

// Expression witnesses are intentionally detailed, but merged Script/prelude
// and self-host units do not need those verbose advisory facts to publish an
// exact semantic graph. Large units use the compact builder: declaration
// identities, raw module hashes, imports, call/type/layout edges, profile, and
// public/effect/layout identities remain exact and checksum-bound. Only
// expression and local buffer witnesses are omitted. An extreme record that
// still exceeds the reader's hard bound remains explicitly incomplete.
fn smp_selected_manifest(module_path:[]u8,source:[]u8,unit:CompilationUnit,effects:map.StringMap[i32],semantic_bytes:i64)*SemanticManifest{
    if(semantic_bytes<=524288){return semantic_manifest_build(module_path,source,unit.profile,unit.decls,effects,unit.modules,unit.imports);}
    return semantic_manifest_build_compact(module_path,source,unit.profile,unit.decls,effects,unit.modules,unit.imports);
}
fn smp_bounded_manifest(module_path:[]u8,source:[]u8,unit:CompilationUnit,effects:map.StringMap[i32])[]u8{
    let semantic_bytes:i64=0;let mi:i32=0;while(mi<unit.modules.len){semantic_bytes=semantic_bytes+unit.modules.data[mi].source.len;mi=mi+1;}
    let manifest:*SemanticManifest=smp_selected_manifest(module_path,source,unit,effects,semantic_bytes);
    if(manifest.*.text.len<=8388608){return manifest.*.text;}
    let profile:[]u8="strict";if(unit.profile==ModuleProfile.script){profile="script";}
    let root:ZagdHash=zagd_content_hash(source);
    let body:[]u8="format=zag-semantic-manifest-v1\nadvisory=true\nexecutable_authority=false\ncomplete=false\nincomplete_reason=manifest-byte-ceiling\n";
    body=_zag_str_concat(body,_zag_str_concat("module=",_zag_str_concat(module_path,"\n")));
    body=_zag_str_concat(body,_zag_str_concat("profile=",_zag_str_concat(profile,"\n")));
    body=_zag_str_concat(body,_zag_str_concat("source=",_zag_str_concat(smp_hash_fields(root),"\n")));
    let sum:ZagdHash=zagd_content_hash(body);
    return _zag_str_concat(body,_zag_str_concat("checksum=",_zag_str_concat(smp_hash_fields(sum),"\n")));
}

fn semantic_manifest_publish(root:[]u8,module_path:[]u8,source:[]u8,unit:CompilationUnit,effects:map.StringMap[i32])i32{
    let cache:[]u8=_zag_str_concat(root,"/.zag-cache");
    let dir:[]u8=_zag_str_concat(cache,"/zagd");
    if(smp_mkdir(cache)==0||smp_mkdir(dir)==0){return 0;}
    let text:[]u8=smp_bounded_manifest(module_path,source,unit,effects);
    let temp:[]u8=_zag_str_concat(dir,"/semantic.record.tmp");
    let final:[]u8=_zag_str_concat(dir,"/semantic.record");
    if(_zag_write_file(temp,text)!=0){return 0;}
    let a:ArrayList[u8]=smp_cstring(temp);
    let b:ArrayList[u8]=smp_cstring(final);
    let rc:i64=_zag_raw_syscall(82,_zag_slice_ptr(a.data[0..a.len]) as i64,_zag_slice_ptr(b.data[0..b.len]) as i64,0,0,0,0);
    free[u8](&a);
    free[u8](&b);
    if(rc!=0){return 0;}
    let _ready:i32=_zag_write_file(_zag_str_concat(root,"/.zagd.semantic-ready"),"ready\n");
    return 1;
}
