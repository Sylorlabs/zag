// Transactional foreground publication. Failure is advisory and must never
// change the success/failure of an authoritative compilation.
@import("semantic_manifest.zag")
extern fn _zag_write_file(path:[]u8,text:[]u8)i32
extern fn _zag_raw_syscall(num:i64,a1:i64,a2:i64,a3:i64,a4:i64,a5:i64,a6:i64)i64
extern fn _zag_slice_ptr(s:[]u8)*i8
fn smp_cstring(s:[]u8)ArrayList[u8]{let out:ArrayList[u8]=make[u8](s.len+1);let i:i32=0;while(i<s.len){push[u8](&out,s[i]);i=i+1;}push[u8](&out,0 as u8);return out;}
fn smp_mkdir(path:[]u8)i32{let p:ArrayList[u8]=smp_cstring(path);let rc:i64=_zag_raw_syscall(83,_zag_slice_ptr(p.data[0..p.len]) as i64,493,0,0,0,0);if(rc==0||rc==(0-17)){return 1;}return 0;}
fn semantic_manifest_publish(root:[]u8,module_path:[]u8,source:[]u8,profile:ModuleProfile,decls:ArrayList[*Node],effects:map.StringMap[i32])i32{let cache:[]u8=_zag_str_concat(root,"/.zag-cache");let dir:[]u8=_zag_str_concat(cache,"/zagd");if(smp_mkdir(cache)==0||smp_mkdir(dir)==0){return 0;}let manifest:*SemanticManifest=semantic_manifest_build(module_path,source,profile,decls,effects);let temp:[]u8=_zag_str_concat(dir,"/semantic.record.tmp");let final:[]u8=_zag_str_concat(dir,"/semantic.record");if(_zag_write_file(temp,manifest.*.text)!=0){return 0;}let a:ArrayList[u8]=smp_cstring(temp);let b:ArrayList[u8]=smp_cstring(final);let rc:i64=_zag_raw_syscall(82,_zag_slice_ptr(a.data[0..a.len]) as i64,_zag_slice_ptr(b.data[0..b.len]) as i64,0,0,0,0);if(rc!=0){return 0;}return 1;}
