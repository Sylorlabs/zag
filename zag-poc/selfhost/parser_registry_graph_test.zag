@import("parse.zag")

extern fn _zag_allocator_live_bytes() i64

fn graph_check(ok:i32,label:[]u8,failures:*i32)void{
    if(ok!=0){_zag_print("ok  ");_zag_println(label);}
    else{failures.*=failures.*+1;_zag_print("FAIL ");_zag_println(label);}
}

fn edge_case(base:[]u8,importer:[]u8,spec:[]u8,expected:[]u8,
    failures:*i32,label:[]u8)void{
    let imports:ArrayList[ResolvedImport]=make[ResolvedImport](1);
    push[ResolvedImport](&imports,ResolvedImport{.importer=importer,
        .imported="",.specifier=spec});
    let complete:i32=1;
    let edges:[]u8=parser_registry_graph_edges(imports,base,&complete);
    graph_check(complete==1&&@strEq(edges,expected),label,failures);
    if(edges.len>0){_zag_str_free(edges);}
    free[ResolvedImport](&imports);
}

fn incomplete_case(base:[]u8,importer:[]u8,spec:[]u8,
    failures:*i32,label:[]u8)void{
    let imports:ArrayList[ResolvedImport]=make[ResolvedImport](1);
    push[ResolvedImport](&imports,ResolvedImport{.importer=importer,
        .imported="",.specifier=spec});
    let complete:i32=1;
    let edges:[]u8=parser_registry_graph_edges(imports,base,&complete);
    graph_check(complete==0&&edges.len==0,label,failures);
    if(edges.len>0){_zag_str_free(edges);}
    free[ResolvedImport](&imports);
}

fn main()i32{
    let failures:i32=0;
    let before:i64=_zag_allocator_live_bytes();
    let root:[]u8="/tmp/zag-parser-registry-graph-fixture/root";
    let nested:[]u8="/tmp/zag-parser-registry-graph-fixture/root/nested/module.zag";
    let malformed:[]u8="/tmp/zag-parser-registry-graph-fixture/malformed";
    let missing:[]u8="/tmp/zag-parser-registry-graph-fixture/missing";

    edge_case(root,"<root>","pkg:dep/src/root.zag",
        "root-package\tdep\t^1.0.0",&failures,
        "root edge uses the exact manifest owner name");
    edge_case(root,nested,"pkg:dep/src/nested.zag",
        "nested-package\tdep\t~1.2.0",&failures,
        "nested edge uses the nearest manifest owner name");
    incomplete_case(missing,"<root>","pkg:dep/src/missing.zag",&failures,
        "missing owner manifest clears the graph");
    incomplete_case(malformed,"<root>","pkg:dep/src/malformed.zag",&failures,
        "malformed owner manifest clears the graph");
    incomplete_case(root,"<root>","pkg:bad.name/src/unsafe.zag",&failures,
        "unsafe dependency name clears the graph");
    edge_case(root,"<root>","../local.zag","",&failures,
        "ordinary imports do not become registry graph edges");
    edge_case("/tmp/zag-parser-registry-graph-fixture/root/vendor","<root>",
        "pkg:dep/src/root.zag","",&failures,
        "validated vendor imports do not become registry graph edges");

    // A nested graph-lock is not an aggregate authority for the complete
    // parser-owned graph.  The production boundary must reject it rather than
    // accepting only the nested resolver's per-tuple check.
    let lock_imports:ArrayList[ResolvedImport]=make[ResolvedImport](1);
    push[ResolvedImport](&lock_imports,ResolvedImport{.importer=nested,
        .imported="",.specifier="pkg:dep/src/nested.zag"});
    let nested_lock:i32=0;
    let nested_lock_path:[]u8=parser_registry_graph_lock_path(lock_imports,
        root,&nested_lock);
    graph_check(nested_lock==1&&nested_lock_path.len==0,
        "nested graph-lock sidecar fails closed without root aggregate authority",
        &failures);
    if(nested_lock_path.len>0){_zag_str_free(nested_lock_path);}
    free[ResolvedImport](&lock_imports);

    // The pure helper owns all temporary strings; check its allocator boundary
    // before constructing the intentionally retained parsed unit below.
    graph_check(_zag_allocator_live_bytes()==before,
        "parser graph helper restores the allocator baseline",&failures);

    // Exercise the production parser boundary, not only the pure edge helper:
    // a real offline registry import must retain the canonical owner/dependency
    // edge on CompilationUnit for the later graph-lock admission seam.
    let parsed:CompilationUnit=parse_compilation_unit_dir(
        "@import(\"pkg:dep/src/root.zag\") as dep\nfn main() i32 { return dep.answer(); }\n",
        root);
    graph_check(parsed.registry_graph_complete==1&&
        @strEq(parsed.registry_graph_edges,"root-package\tdep\t^1.0.0"),
        "parsed compilation unit retains the canonical registry graph edge",
        &failures);
    if(failures==0){_zag_println("parser registry graph: 10/10");}
    return failures;
}
