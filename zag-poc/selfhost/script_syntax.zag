// Python-shaped Zag Script source normalization.
//
// This is deliberately a source-to-source layout front-end, not a second
// expression parser or language implementation. It accepts the
// indentation-oriented Script surface, indexes the original bytes with the
// shared lexer, and emits ordinary Zag tokens for the existing parser/AST/
// sema/backend pipeline. Strict Zag is returned byte-for-byte unchanged.

@import("../std/list.zag")
@import("lex.zag")

// Lossless indentation CST.  The CST owns no rewritten text: every node is an
// exact byte range into `source`, including comments, trailing whitespace,
// CRLF/LF choice, blank lines, and a final line without a newline.  `origin_id`
// is deterministic for the same compact bytes and span; generated projections
// use it to retain a reversible link to compact source.
struct ZsCstLine {
    raw_start: i32,
    raw_end: i32,
    content_start: i32,
    content_end: i32,
    line: i32,
    indent: i32,
    kind: i32,
    origin_id: i64,
    token_start: i32,
    token_end: i32,
    // Header classification is derived from the shared token range.  The
    // normalizer may use this layout fact, but it never gets to invent a
    // second keyword grammar from raw line text.
    header_kind: i32, // 1 script, 2 if, 3 elif, 4 else, 5 while, 6 def, 7 for
    header_error: i32, // 0 valid/non-header, 1 malformed recognized header
    // Logical statement envelope. Physical continuation lines retain their
    // opener so normalization and layout recovery operate on one shared CST
    // node rather than re-parsing continuation text.
    logical_owner: i32,
    logical_token_start: i32,
    logical_token_end: i32,
    logical_raw_end: i32,
    logical_content_end: i32,
    delimiter_before: i32,
    delimiter_after: i32,
}
// Token spans are a lossless index over the original bytes and are classified
// by lex.zag's shared Token/Tk stream. Trivia remains owned by `source` and the
// line spans; tokenization never rewrites or drops source bytes. The
// normalizer still consumes line nodes for layout lowering, but parser
// integration uses these stable ranges without another token grammar or origin
// scheme.
struct ZsCstToken {
    kind: i32, // 1 identifier, 2 number, 3 string, 4 operator, 5 punctuation, 6 comment
    // Exact shared-lexer token code retained alongside the compact class.
    // The class remains useful for recovery; expression lowering uses this
    // code only for the small punctuation/string distinctions it needs.
    lex_kind: i32,
    byte_start: i32,
    byte_end: i32,
    line: i32,
    col: i32,
    origin_id: i64,
}
struct ZsCstLayout {
    kind: i32, // 1 indent, 2 dedent, 3 eof-dedent
    byte_offset: i32,
    line: i32,
    indent: i32,
    origin_id: i64,
}
struct ZsCstRecovery {
    kind: i32, // 1 inconsistent dedent, 2 mixed indent, 3 invalid byte,
               // 4/5 unterminated literal, 6 malformed Script header,
               // 7 unexpected indentation without a block header,
    // 8 missing indented body after a block header, 11 trailing operator,
    // 12 incomplete member access, 13 malformed string interpolation brace,
    // 14 unterminated string escape
    byte_start: i32,
    byte_end: i32,
    line: i32,
    // 1-based byte column of the first damaged byte. Keeping this alongside
    // the byte span lets editor/watchers render a localized diagnostic
    // without rescanning the compact source or guessing from a UTF-8 scalar.
    col: i32,
    message: []u8,
    origin_id: i64,
}
struct ZsCst {
    source: []u8,
    lines: ArrayList[ZsCstLine],
    tokens: ArrayList[ZsCstToken],
    layouts: ArrayList[ZsCstLayout],
    recoveries: ArrayList[ZsCstRecovery],
    valid: i32,
}
struct ZsOriginSegment {
    generated_start: i32,
    generated_end: i32,
    source_start: i32,
    source_end: i32,
    origin_id: i64,
    exact: i32, // generated bytes are byte-identical to the source range
}
struct ZsNormalized {
    source: []u8,
    cst: ZsCst,
    origins: ArrayList[ZsOriginSegment],
}

// The parser consumes this envelope instead of independently lexing the
// normalized bytes.  `tokens` are still the ordinary shared-lexer Token
// stream; the envelope is the authority seam that binds that stream to the
// lossless compact CST and its generated-byte origin projection.  Keeping the
// bridge here prevents the Script normalizer from becoming a second parser and
// makes malformed/partial projections fail closed before AST construction.
struct ZsParserInput {
    tokens: ArrayList[Token],
    cst: ZsCst,
    origins: ArrayList[ZsOriginSegment],
}
// A deliberately small interpolation plan.  The Script front-end does not
// invent a second expression grammar: each expression part is re-lexed by the
// shared lexer below, while literal parts retain their source spelling.  A
// part kind of 0 is a literal and 1 is an expression whose proven type is
// retained (byte slice, i64, or bool); scalar conversion is added only after
// that bounded source proof. Kind 4 is a single lexer-validated float literal
// whose source spelling can be emitted without allocation; float variables and
// expressions remain unknown until a Script-owned formatter exists.
struct ZsInterpPart {
    kind: i32,
    start: i32,
    end: i32,
}
// The normalizer only records types it can prove from the compact Script
// source.  Unknown names remain ordinary byte expressions and therefore fail
// through the shared typed checker instead of being guessed into a numeric or
// boolean conversion.
struct ZsInterpBinding {
    name: []u8,
    kind: i32, // 1 []u8, 2 i64, 3 bool, 4 literal f64 spelling, 5 f64, 0 unknown
}
// Token-derived declaration delimiters used by the compact `def` projection.
// Parameter internals remain ordinary source slices for now; the enclosing
// function/name/return boundaries must nevertheless come from the shared
// lexer so parentheses or arrow-like bytes in trivia cannot shift the header.
struct ZsDefBounds {
    name_start: i32,
    name_end: i32,
    lp: i32,
    rp: i32,
    ret_start: i32,
    ret_end: i32,
    valid: i32,
}
// Token-derived bounds for a conditional layout header.  The expression and
// terminal colon are retained as absolute compact-source offsets so lowering
// cannot rescan raw line text or let trivia shift the condition boundary.
struct ZsHeaderBounds {
    expr_start: i32,
    expr_end: i32,
    colon_start: i32,
    colon_end: i32,
    valid: i32,
}
// Token-derived expression spans for a compact `for` header.  All offsets are
// absolute into the original Script source; -1 denotes the omitted lower
// bound in the one-argument `range(value)` form.  The normalizer projects
// these spans through the shared CST token stream instead of re-lexing a
// source slice for each expression.
struct ZsForExprBounds {
    collection_start: i32,
    collection_end: i32,
    lower_start: i32,
    lower_end: i32,
    upper_start: i32,
    upper_end: i32,
    is_range: i32,
    valid: i32,
}
// A compact expression projection must begin and end on complete CST token
// boundaries.  Keeping the interval check separate from the emitter lets
// tooling reject forged/stale spans without invoking the fail-closed emitter
// (and keeps generated expressions from silently disappearing on an empty or
// overlapping range).
struct ZsExprTokenBounds {
    first: i32,
    last: i32,
    valid: i32,
}
// Bounds for the deliberately narrow Script map-literal surface.  `first`
// and `last` are CST-token indices with the closing brace excluded.  The
// literal is admitted only when every entry is one integer token (or a unary
// minus followed by one integer token) on each side of exactly one colon.
struct ZsMapLiteralBounds {
    first: i32,
    last: i32,
    valid: i32,
}
// Physical envelope for a map assignment whose opening and closing braces
// may belong to different CST lines. `close_line` is the physical line that
// owns the closing brace, allowing the strict-brace projector to consume the
// complete source span exactly once.
struct ZsMapAssignmentEnvelope {
    first: i32,
    last: i32,
    close_line: i32,
    trailing: i32,
    valid: i32,
}
struct ZsAppendBounds {
    receiver_start: i32,
    receiver_end: i32,
    arg_start: i32,
    arg_end: i32,
    valid: i32,
}
// Token-derived assignment boundaries for Script statement lowering. `eq` and
// `annotation_colon` are relative to the statement base; -1 means absent.
// The RHS begins immediately after the shared `=` token, before horizontal
// trivia is normalized by the existing emitter.
struct ZsAssignmentBounds {
    eq: i32,
    annotation_colon: i32,
    rhs_start: i32,
    valid: i32,
}

fn zs_origin_id(src:[]u8,start:i32,end:i32,line:i32)i64{
    let h:i64=17;let i:i32=start;
    while(i<end){h=(h*257+(src[i] as i64)+1)%1000000007;i=i+1;}
    h=(h*257+(start as i64)+1)%1000000007;
    h=(h*257+(end as i64)+1)%1000000007;
    return (h*257+(line as i64)+1)%1000000007;
}

fn zs_cst_kind(content:[]u8)i32{
    if(content.len==0){return 0;}
    // Both Script's Python-shaped `#` comments and strict Zag's `//`
    // comments are trivia.  The shared lexer drops `//` lines, so leaving
    // them as ordinary CST statements would later manufacture an empty
    // expression span and fail closed in the projector.
    if(content[0]=='#'||(content.len>=2&&content[0]=='/'&&content[1]=='/')){return 1;}
    if(@strEq(content,"script;")){return 2;}
    if(content[content.len-1]==':'){return 3;}
    return 4;
}

fn zs_utf8_cont(c:u8)bool{return c>=128&&c<=191;}
// Keep CST recovery's scalar boundary rules aligned with std:utf8 without
// asking the shared lexer to inspect malformed bytes. The probe reports only
// the status and expected width needed by this fail-closed recovery pass.
struct ZsUtf8Probe { status:i32, width:i32 }
fn zs_utf8_probe(src:[]u8,start:i32)ZsUtf8Probe{
    if(start<0||start>=src.len){return ZsUtf8Probe{.status=0,.width=0};}
    let b:u8=src[start];
    if(b<128){return ZsUtf8Probe{.status=1,.width=1};}
    if(b>=194&&b<=223){
        if(start+1>=src.len){return ZsUtf8Probe{.status=2,.width=2};}
        if(!zs_utf8_cont(src[start+1])){return ZsUtf8Probe{.status=3,.width=2};}
        return ZsUtf8Probe{.status=1,.width=2};
    }
    if(b>=224&&b<=239){
        if(start+2>=src.len){return ZsUtf8Probe{.status=2,.width=3};}
        let b1:u8=src[start+1];let b2:u8=src[start+2];
        if(!zs_utf8_cont(b1)||!zs_utf8_cont(b2)||
            (b==224&&b1<160)||(b==237&&b1>159)){
            return ZsUtf8Probe{.status=3,.width=3};
        }
        return ZsUtf8Probe{.status=1,.width=3};
    }
    if(b>=240&&b<=244){
        if(start+3>=src.len){return ZsUtf8Probe{.status=2,.width=4};}
        let b1:u8=src[start+1];let b2:u8=src[start+2];let b3:u8=src[start+3];
        if(!zs_utf8_cont(b1)||!zs_utf8_cont(b2)||!zs_utf8_cont(b3)||
            (b==240&&b1<144)||(b==244&&b1>143)){
            return ZsUtf8Probe{.status=3,.width=4};
        }
        return ZsUtf8Probe{.status=1,.width=4};
    }
    return ZsUtf8Probe{.status=3,.width=1};
}
// Return the localized byte span for the malformed UTF-8 unit beginning at
// `start`.  `zs_invalid_source_offset` deliberately stops at the first bad
// lead/continuation boundary; retaining the contiguous continuation bytes
// that belong to that lead gives recovery consumers the complete damaged
// unit without swallowing a following ASCII/source token.  This is only a
// recovery span calculation: validity remains fail-closed in the validator
// above and the shared lexer is never asked to interpret malformed bytes.
fn zs_invalid_source_end(src:[]u8,start:i32)i32{
    if(start<0||start>=src.len){return start+1;}
    let probe:ZsUtf8Probe=zs_utf8_probe(src,start);let width:i32=probe.width;
    if(width==1&&(src[start]>=192&&src[start]<=193)){width=2;}
    else if(width==1&&(src[start]>=245&&src[start]<=247)){width=4;}
    if(width<=0){return start+1;}
    let limit:i32=start+width;if(limit>src.len){limit=src.len;}
    let end:i32=start+1;
    while(end<limit&&zs_utf8_cont(src[end])){end=end+1;}
    return end;
}
// Find the next malformed byte at or after `start`.  Keeping the cursor
// explicit lets CST recovery report every disjoint damaged unit in one source
// instead of stopping at the first byte and losing later editor diagnostics.
// The scan advances over valid scalar sequences, while an invalid lead or
// continuation is returned to the caller for localized recovery.
fn zs_invalid_source_offset_after(src:[]u8,start:i32)i32{
    let i:i32=start;
    if(i<0){i=0;}
    while(i<src.len){
        if(src[i]==0){return i;}
        let probe:ZsUtf8Probe=zs_utf8_probe(src,i);
        if(probe.status!=1){return i;}
        i=i+probe.width;
    }
    return -1;
}
fn zs_invalid_source_offset(src:[]u8)i32{
    return zs_invalid_source_offset_after(src,0);
}

fn zs_line_for_offset(src:[]u8,offset:i32)i32{
    let line:i32=1;let i:i32=0;
    let bound:i32=offset;
    if(bound<0){return line;}
    while(i<bound&&i<src.len){if(src[i]==10){line=line+1;}i=i+1;}
    return line;
}

// Lexer columns are deliberately byte columns. Recovery uses the same
// convention so malformed UTF-8 cannot make diagnostics disagree with the
// shared token stream: a valid multibyte scalar advances the column by its
// encoded width, while the damaged byte itself remains addressable.
fn zs_col_for_offset(src:[]u8,offset:i32)i32{
    if(offset<0){return 0;}
    let line_start:i32=0;let i:i32=0;
    while(i<offset&&i<src.len){if(src[i]==10){line_start=i+1;}i=i+1;}
    return offset-line_start+1;
}

// The shared lexer deliberately exits on an unterminated literal.  The CST
// needs a recoverable boundary before it asks that lexer for tokens, otherwise
// malformed Script input cannot retain a localized diagnostic span.  This
// preflight understands only quote/comment boundaries; expression grammar
// remains owned by lex.zag and the ordinary parser.
fn zs_unterminated_literal_offset(src:[]u8)i32{
    let quote:u8=0;let escaped:i32=0;let start:i32=-1;let i:i32=0;
    while(i<src.len){
        let c:u8=src[i];
        if(quote==0){
            if(c=='/'&&i+1<src.len&&src[i+1]=='/'){
                i=i+2;while(i<src.len&&src[i]!=10){i=i+1;}
                continue;
            }
            if(c=='#'){
                i=i+1;while(i<src.len&&src[i]!=10){i=i+1;}
                continue;
            }
            if(c==34||c==39){quote=c;start=i;escaped=0;}
        }else if(escaped==1){
            escaped=0;
        }else if(c==92){
            escaped=1;
        }else if(c==quote){
            quote=0;start=-1;
        }
        i=i+1;
    }
    return start;
}

// Return the exact backslash that leaves a Script string escape unfinished at
// EOF. The ordinary literal preflight still owns all other quote boundaries;
// this narrower recovery lets editor tooling highlight the damaged escape
// byte instead of the whole unterminated string token.
fn zs_unterminated_string_escape_offset(src:[]u8)i32{
    let quote:u8=0;let escaped:i32=0;let escape_start:i32=-1;let i:i32=0;
    while(i<src.len){
        let c:u8=src[i];
        if(quote==0){
            if(c=='/'&&i+1<src.len&&src[i+1]=='/'){
                i=i+2;while(i<src.len&&src[i]!=10){i=i+1;}
                continue;
            }
            if(c=='#'){
                i=i+1;while(i<src.len&&src[i]!=10){i=i+1;}
                continue;
            }
            if(c==34||c==39){quote=c;escaped=0;escape_start=-1;}
        }else if(escaped==1){
            escaped=0;escape_start=-1;
        }else if(c==92){
            escaped=1;escape_start=i;
        }else if(c==quote){
            quote=0;escape_start=-1;
        }
        i=i+1;
    }
    if(quote==34&&escaped==1){return escape_start;}
    return -1;
}

// Script comments use `#`, while the shared strict lexer only skips `//`.
// Feed that lexer a same-length shadow buffer for Script CST indexing: every
// byte in a hash comment becomes a space, preserving every token offset while
// preventing comment text from being interpreted as header or expression
// syntax. Delimiters inside quoted literals remain unchanged.
fn zs_cst_lex_input(src:[]u8,script_profile:i32)[]u8{
    if(script_profile==0){return src;}
    let out:ArrayList[u8]=make[u8](src.len+1);
    let quote:u8=0;let escaped:i32=0;let hash_comment:i32=0;let i:i32=0;
    while(i<src.len){
        let c:u8=src[i];
        if(hash_comment==1){
            // Script comments are line trivia. Replace every comment byte
            // with a same-length space so the shared strict lexer cannot
            // classify trailing comment words as header tokens, while all
            // token offsets remain byte-identical to the compact source.
            if(c==10){hash_comment=0;push[u8](&out,c);}
            else{push[u8](&out,' ');}
        }else if(quote!=0){
            push[u8](&out,c);
            if(escaped==1){escaped=0;}
            else if(c==92){escaped=1;}
            else if(c==quote){quote=0;}
        }else if(c==34||c==39){quote=c;push[u8](&out,c);}
        else if(c=='#'){hash_comment=1;push[u8](&out,' ');}
        else{push[u8](&out,c);}
        i=i+1;
    }
    return out.data[0..out.len];
}

// Return the first Script `#` comment delimiter in one already-bounded line,
// ignoring delimiters inside string/character literals. The caller keeps the
// original line span for provenance and uses this offset only to prevent
// comment trivia from entering expression/header lowering.
fn zs_script_comment_offset(src:[]u8,start:i32,end:i32)i32{
    let quote:u8=0;let escaped:i32=0;let i:i32=start;
    while(i<end){
        let c:u8=src[i];
        if(quote==0){
            if(c==34||c==39){quote=c;escaped=0;}
            else if(c=='#'||(c=='/'&&i+1<end&&src[i+1]=='/')){return i;}
        }else if(escaped==1){escaped=0;}
        else if(c==92){escaped=1;}
        else if(c==quote){quote=0;}
        i=i+1;
    }
    return -1;
}

fn zs_cst_shared_kind(k:Tk)i32{
    if(tk_code(k)==tk_code(Tk.Str)){return 3;}
    if(tk_code(k)==tk_code(Tk.Int)||tk_code(k)==tk_code(Tk.Float)){return 2;}
    if(tk_code(k)==tk_code(Tk.Op)){return 4;}
    if(tk_code(k)==tk_code(Tk.Ident)||tk_code(k)==tk_code(Tk.Annot)||
        tk_code(k)>=tk_code(Tk.KwFn)&&tk_code(k)<tk_code(Tk.Lp)){return 1;}
    return 5;
}

fn zs_delimiter_matches(open:u8,close:u8)bool{
    return (open=='('&&close==')')||(open=='['&&close==']')||
        (open=='{'&&close=='}');
}

fn zs_delimiter_recovery_message(kind:i32)[]u8{
    if(kind==9){return "mismatched closing delimiter";}
    return "unterminated opening delimiter";
}

fn zs_delimiter_delta(src:[]u8,tokens:ArrayList[ZsCstToken],start:i32,end:i32)i32{
    let delta:i32=0;let i:i32=start;
    while(i<end&&i<tokens.len){
        let tok:ZsCstToken=tokens.data[i];let text:[]u8=src[tok.byte_start..tok.byte_end];
        if(@strEq(text,"(")||@strEq(text,"[")||@strEq(text,"{")){delta=delta+1;}
        else if(@strEq(text,")")||@strEq(text,"]")||@strEq(text,"}")){delta=delta-1;}
        i=i+1;
    }
    return delta;
}

// A deliberately narrow expression recovery seam: a top-level Script
// statement cannot end on a shared-lexer operator when no delimiter is open.
// This catches the common editor-intermediate `value = 1 +` shape with a
// precise token span, while leaving all other expression meaning to parse.zag.
fn zs_cst_trailing_operator(tokens:ArrayList[ZsCstToken],start:i32,end:i32)i32{
    if(end<=start||end>tokens.len){return -1;}
    let tok:ZsCstToken=tokens.data[end-1];
    if(tok.lex_kind==tk_code(Tk.Op)){return end-1;}
    return -1;
}

// A standalone dot is punctuation rather than Tk.Op, but it is unambiguously
// incomplete when it terminates a top-level expression (`value = item.`).
// Keep this recovery separate from operator handling so callers can preserve
// the exact diagnostic class without broadening expression parsing here.
fn zs_cst_trailing_member_access(tokens:ArrayList[ZsCstToken],start:i32,end:i32)i32{
    if(end<=start||end>tokens.len){return -1;}
    let tok:ZsCstToken=tokens.data[end-1];
    if(tok.lex_kind==tk_code(Tk.Dot)){return end-1;}
    return -1;
}

// Return the first byte of a malformed Script string interpolation.  String
// tokens are already validated by the shared lexer, so this pass only checks
// the small interpolation convention owned by the Script projector: doubled
// braces are literal, a single opening brace must have a non-empty expression
// and a closing brace, and a single closing brace is never valid.  Keeping the
// recovery at the exact brace gives editor tooling a stable source origin
// without making the CST a second expression parser.
fn zs_cst_string_interpolation_error(src:[]u8,start:i32,end:i32)i32{
    if(start<0||end<=start||end>src.len||end-start<2){return -1;}
    let body_start:i32=start+1;let body_end:i32=end-1;let p0:i32=body_start;
    let p:i32=p0;
    while(p<body_end){
        if((src[p]=='{'||src[p]=='}')&&p+1<body_end&&src[p+1]==src[p]){
            p=p+2;continue;
        }
        if(src[p]=='}'){return p;}
        if(src[p]=='{'){
            let q:i32=p+1;
            while(q<body_end&&src[q]!='}'){
                if(src[q]=='{'){return q;}
                q=q+1;
            }
            if(q>=body_end){return p;}
            let expr_start:i32=q;
            let trim:i32=p+1;
            while(trim<q&&(src[trim]==' '||src[trim]=='\t'||src[trim]=='\r')){trim=trim+1;}
            expr_start=trim;
            if(expr_start>=q){return p;}
            p=q+1;continue;
        }
        p=p+1;
    }
    return -1;
}

fn zs_cst_append_shared_tokens(src:[]u8,node:ZsCstLine,
                               shared:ArrayList[Token],shared_i:*i32,
                               tokens:*ArrayList[ZsCstToken])void{
    while(shared_i.*<shared.len){
        let tok:Token=shared.data[shared_i.*];
        if(tk_code(tok.kind)==tk_code(Tk.Eof)){shared_i.*=shared_i.*+1;continue;}
        if(tok.line<node.line){shared_i.*=shared_i.*+1;continue;}
        if(tok.line>node.line){break;}
        if(tok.byte_start>=node.content_start&&tok.byte_end<=node.content_end){
            push[ZsCstToken](tokens,ZsCstToken{.kind=zs_cst_shared_kind(tok.kind),
                .lex_kind=tk_code(tok.kind),
                .byte_start=tok.byte_start,.byte_end=tok.byte_end,.line=tok.line,
                .col=tok.col,.origin_id=zs_origin_id(src,tok.byte_start,
                tok.byte_end,tok.line)});
        }
        shared_i.*=shared_i.*+1;
    }
}

// Recognize only the seven layout-bearing Script headers from the shared
// token range.  Their expressions are still parsed by the ordinary Zag
// parser after lowering; this function deliberately checks no expression
// semantics.  A recognized keyword with a malformed delimiter is retained as
// a localized CST recovery rather than falling through as an ordinary call.
fn zs_cst_header_kind(src:[]u8,node:ZsCstLine,tokens:ArrayList[ZsCstToken])i32{
    if(node.token_start>=node.token_end){return 0;}
    let first:ZsCstToken=tokens.data[node.token_start];
    let first_text:[]u8=src[first.byte_start..first.byte_end];
    let last:ZsCstToken=tokens.data[node.token_end-1];
    let last_text:[]u8=src[last.byte_start..last.byte_end];
    // The compact profile permits the first executable statement after
    // `script;` on the same physical line.  The shared token boundary still
    // recognizes the marker from its first two tokens and the normalizer
    // lowers the remaining tail through the ordinary statement path.
    if(@strEq(first_text,"script")){return ((node.token_end-node.token_start>=2&&
        @strEq(src[tokens.data[node.token_start+1].byte_start..tokens.data[node.token_start+1].byte_end],";")) as i32);}
    if(@strEq(first_text,"if")){return (((node.token_end-node.token_start>=3&&@strEq(last_text,":")) as i32)*2);}
    if(@strEq(first_text,"elif")){return (((node.token_end-node.token_start>=3&&@strEq(last_text,":")) as i32)*3);}
    if(@strEq(first_text,"else")){return (((node.token_end-node.token_start==2&&@strEq(last_text,":")) as i32)*4);}
    if(@strEq(first_text,"while")){return (((node.token_end-node.token_start>=3&&@strEq(last_text,":")) as i32)*5);}
    if(@strEq(first_text,"def")){
        let has_name:i32=(node.token_end-node.token_start>=5) as i32;
        let has_parens:i32=0;let i:i32=node.token_start+2;
        while(i<node.token_end-1){let text:[]u8=src[tokens.data[i].byte_start..tokens.data[i].byte_end];if(@strEq(text,"(")){has_parens=has_parens+1;}else if(@strEq(text,")")){has_parens=has_parens+1;}i=i+1;}
        return (((has_name==1&&has_parens>=2&&@strEq(last_text,":")) as i32)*6);
    }
    if(@strEq(first_text,"for")){
        // The compact binding form is deliberately narrow: one shared-lexer
        // identifier followed immediately by `in`, then a non-empty
        // collection expression.  Rejecting malformed binding/separator
        // shapes here gives the CST a localized recovery instead of emitting
        // an invalid native `|literal|` binding for the ordinary parser.
        let has_name:i32=0;let has_in:i32=0;let has_collection:i32=0;
        if(node.token_start+1<node.token_end-1&&
            tokens.data[node.token_start+1].kind==1){has_name=1;}
        if(node.token_start+2<node.token_end-1&&
            @strEq(src[tokens.data[node.token_start+2].byte_start..
                tokens.data[node.token_start+2].byte_end],"in")){has_in=1;}
        if(node.token_start+3<node.token_end-1){has_collection=1;}
        return ((((node.token_end-node.token_start>=5)&&has_name==1&&
            has_in==1&&has_collection==1&&@strEq(last_text,":")) as i32)*7);
    }
    return 0;
}

fn zs_cst_header_opens_block(kind:i32)i32{
    return (kind==2||kind==3||kind==4||kind==5||kind==6||kind==7) as i32;
}

fn zs_cst_header_error(src:[]u8,node:ZsCstLine,tokens:ArrayList[ZsCstToken])i32{
    if(node.token_start>=node.token_end){return 0;}
    let first:ZsCstToken=tokens.data[node.token_start];
    let word:[]u8=src[first.byte_start..first.byte_end];
    if(@strEq(word,"script")){
        if(node.token_end-node.token_start>=2&&
            @strEq(src[tokens.data[node.token_start+1].byte_start..tokens.data[node.token_start+1].byte_end],";")){return 0;}
        return 1;
    }
    if(@strEq(word,"if")||@strEq(word,"elif")||
        @strEq(word,"else")||@strEq(word,"while")||@strEq(word,"def")||
        @strEq(word,"for")){return 1;}
    return 0;
}

// Return the expression range for a token-derived conditional header.  The
// keyword and terminal colon are excluded by token index, so indentation,
// spacing, and comments cannot shift the lowering boundary.
fn zs_cst_header_expr(src:[]u8,node:ZsCstLine,tokens:ArrayList[ZsCstToken])[]u8{
    let bounds:ZsHeaderBounds=zs_cst_header_bounds(src,node,tokens);
    if(bounds.valid==0){return "";}
    return src[bounds.expr_start..bounds.expr_end];
}

// Return conditional expression and terminal-colon bounds directly from the
// shared CST token range.  This is deliberately structural: type/precedence
// and expression meaning remain owned by the ordinary parser after lowering.
fn zs_cst_header_bounds(src:[]u8,node:ZsCstLine,
                        tokens:ArrayList[ZsCstToken])ZsHeaderBounds{
    let bad:ZsHeaderBounds=ZsHeaderBounds{.expr_start=-1,.expr_end=-1,
        .colon_start=-1,.colon_end=-1,.valid=0};
    if(node.header_kind!=2&&node.header_kind!=3&&node.header_kind!=5){return bad;}
    let lo:i32=node.token_start+1;let colon_idx:i32=node.token_end-1;
    if(lo<0||colon_idx<=lo||colon_idx>=tokens.len){return bad;}
    let colon:ZsCstToken=tokens.data[colon_idx];
    if(!@strEq(src[colon.byte_start..colon.byte_end],":")){return bad;}
    let last_idx:i32=colon_idx-1;
    if(lo<last_idx&&
       @strEq(src[tokens.data[lo].byte_start..tokens.data[lo].byte_end],"(")&&
       @strEq(src[tokens.data[last_idx].byte_start..tokens.data[last_idx].byte_end],")")){
        lo=lo+1;last_idx=last_idx-1;
    }
    if(lo>last_idx){return bad;}
    let last_expr:ZsCstToken=tokens.data[last_idx];
    if(last_expr.byte_end<=last_expr.byte_start){return bad;}
    return ZsHeaderBounds{.expr_start=tokens.data[lo].byte_start,
        .expr_end=last_expr.byte_end,.colon_start=colon.byte_start,
        .colon_end=colon.byte_end,.valid=1};
}

// Token-derived parts of `for name in collection:`.  The first identifier is
// the binding and the tokens after `in` up to the terminal colon are the
// collection expression.  Keeping both spans here avoids a second textual
// search for the word ` in ` in the layout normalizer.
fn zs_cst_for_name(src:[]u8,node:ZsCstLine,tokens:ArrayList[ZsCstToken])[]u8{
    if(node.header_kind!=7||node.token_start+2>=node.token_end||
        tokens.data[node.token_start+1].kind!=1||
        !@strEq(src[tokens.data[node.token_start+2].byte_start..
            tokens.data[node.token_start+2].byte_end],"in")){return "";}
    return src[tokens.data[node.token_start+1].byte_start..tokens.data[node.token_start+1].byte_end];
}

// Return absolute token spans for the expression(s) in a `for` header.  The
// collection span covers every token after `in` and before the terminal
// colon.  An exact `range(...)` call is split only at top-level commas; a
// nested call's commas remain inside the corresponding token span.  If the
// header is not exactly a range call, the whole collection remains one
// expression and is projected unchanged.
fn zs_cst_for_expr_bounds(src:[]u8,node:ZsCstLine,
                          tokens:ArrayList[ZsCstToken])ZsForExprBounds{
    let bad:ZsForExprBounds=ZsForExprBounds{.collection_start=-1,
        .collection_end=-1,.lower_start=-1,.lower_end=-1,
        .upper_start=-1,.upper_end=-1,.is_range=0,.valid=0};
    if(node.header_kind!=7){return bad;}
    let in_at:i32=node.token_start+2;
    let colon:i32=node.token_end-1;
    if(in_at<0||colon<=in_at+1||colon>=tokens.len||
        !@strEq(src[tokens.data[in_at].byte_start..tokens.data[in_at].byte_end],"in")){return bad;}
    let first:i32=in_at+1;let last:i32=colon;
    let out:ZsForExprBounds=ZsForExprBounds{
        .collection_start=tokens.data[first].byte_start,
        .collection_end=tokens.data[last-1].byte_end,
        .lower_start=-1,.lower_end=-1,.upper_start=-1,.upper_end=-1,
        .is_range=0,.valid=1};
    // A range is special only when it occupies the entire collection span.
    // This keeps `range(2) + extra` as one ordinary expression instead of
    // silently discarding the suffix during layout lowering.
    if(first+1<last&&
        @strEq(src[tokens.data[first].byte_start..tokens.data[first].byte_end],"range")&&
        @strEq(src[tokens.data[first+1].byte_start..tokens.data[first+1].byte_end],"(")){
        let open:i32=first+1;let depth:i32=0;let comma:i32=-1;
        let second_comma:i32=-1;let close:i32=-1;let i:i32=open+1;
        while(i<last){
            let text:[]u8=src[tokens.data[i].byte_start..tokens.data[i].byte_end];
            if(@strEq(text,"(")){depth=depth+1;}
            else if(@strEq(text,")")){
                if(depth==0){close=i;break;}
                depth=depth-1;
            }else if(@strEq(text,",")&&depth==0){
                if(comma<0){comma=i;}else{second_comma=i;}
            }
            i=i+1;
        }
        if(close==last-1&&second_comma<0){
            let arg_first:i32=open+1;
            if(comma<0){
                if(arg_first<close){
                    out.upper_start=tokens.data[arg_first].byte_start;
                    out.upper_end=tokens.data[close-1].byte_end;
                    out.is_range=1;
                }
            }else if(arg_first<comma&&comma+1<close){
                out.lower_start=tokens.data[arg_first].byte_start;
                out.lower_end=tokens.data[comma-1].byte_end;
                out.upper_start=tokens.data[comma+1].byte_start;
                out.upper_end=tokens.data[close-1].byte_end;
                out.is_range=1;
            }
        }
    }
    return out;
}

fn zs_cst_for_collection(src:[]u8,node:ZsCstLine,tokens:ArrayList[ZsCstToken])[]u8{
    if(node.header_kind!=7){return "";}
    let in_at:i32=node.token_start+2;
    if(in_at>=node.token_end-1||!@strEq(src[tokens.data[in_at].byte_start..tokens.data[in_at].byte_end],"in")||in_at+1>=node.token_end-1){return "";}
    let first:i32=in_at+1;let last:i32=node.token_end-1;
    return src[tokens.data[first].byte_start..tokens.data[last-1].byte_end];
}

// `range(...)` is the one structured sub-expression that the layout
// normalizer lowers specially. Keep its argument boundaries token-derived as
// well: a raw comma search would split a nested call such as
// `range(choose(0, 1), 4)` at the wrong byte. Part 1 is the lower argument
// (empty for the one-argument form); part 2 is the upper argument.
fn zs_cst_for_range_part(src:[]u8,node:ZsCstLine,tokens:ArrayList[ZsCstToken],part:i32)[]u8{
    if(node.header_kind!=7||part<1||part>2){return "";}
    let in_at:i32=node.token_start+2;
    if(in_at>=node.token_end-1||!@strEq(src[tokens.data[in_at].byte_start..tokens.data[in_at].byte_end],"in")||in_at+2>=node.token_end){return "";}
    let range_at:i32=in_at+1;
    if(!@strEq(src[tokens.data[range_at].byte_start..tokens.data[range_at].byte_end],"range")||
        !@strEq(src[tokens.data[range_at+1].byte_start..tokens.data[range_at+1].byte_end],"(")){return "";}
    let open:i32=range_at+1;let depth:i32=0;let comma:i32=-1;let second_comma:i32=-1;let close:i32=-1;
    i=open+1;
    while(i<node.token_end-1){
        let text:[]u8=src[tokens.data[i].byte_start..tokens.data[i].byte_end];
        if(@strEq(text,"(")){depth=depth+1;}
        else if(@strEq(text,")")){if(depth==0){close=i;break;}depth=depth-1;}
        else if(@strEq(text,",")&&depth==0){if(comma<0){comma=i;}else{second_comma=i;}}
        i=i+1;
    }
    if(close<0||second_comma>=0){return "";}
    let first:i32=open+1;
    if(part==1){
        if(comma<0||first>=comma){return "";}
        return src[tokens.data[first].byte_start..tokens.data[comma-1].byte_end];
    }
    let last:i32=close;
    if(comma<0){if(first>=last){return "";}return src[tokens.data[first].byte_start..tokens.data[last-1].byte_end];}
    if(comma+1>=last){return "";}
    return src[tokens.data[comma+1].byte_start..tokens.data[last-1].byte_end];
}

fn script_syntax_cst(src:[]u8)ZsCst{
    let out:ZsCst=ZsCst{.source=src,.lines=make[ZsCstLine](16),
        .tokens=make[ZsCstToken](32),.layouts=make[ZsCstLayout](16),
        .recoveries=make[ZsCstRecovery](4),.valid=1};
    let invalid_offset:i32=zs_invalid_source_offset(src);
    if(invalid_offset>=0){
        out.valid=0;
        // Keep each malformed unit as its own recovery node.  The compiler
        // still fails closed and does not lex invalid bytes, but editor and
        // watcher consumers can now highlight all damaged regions in one
        // pass. `zs_invalid_source_end` consumes only the continuation bytes
        // belonging to the returned lead, so a later malformed unit cannot be
        // swallowed by the earlier diagnostic.
        let invalid_cursor:i32=invalid_offset;
        while(invalid_cursor>=0&&invalid_cursor<src.len){
            let invalid_end:i32=zs_invalid_source_end(src,invalid_cursor);
            if(invalid_end<=invalid_cursor){break;}
            let invalid_line:i32=zs_line_for_offset(src,invalid_cursor);
            push[ZsCstRecovery](&out.recoveries,ZsCstRecovery{.kind=3,
                .byte_start=invalid_cursor,.byte_end=invalid_end,
                .line=invalid_line,
                .col=zs_col_for_offset(src,invalid_cursor),
                .message="invalid UTF-8 or NUL source byte",
                // The origin covers the complete localized recovery unit, not
                // merely its lead byte. This keeps recovery provenance aligned
                // with the byte span even for truncated/overlong UTF-8 units.
                .origin_id=zs_origin_id(src,invalid_cursor,invalid_end,
                    invalid_line)});
            invalid_cursor=zs_invalid_source_offset_after(src,invalid_end);
        }
    }
    let literal_escape_offset:i32=zs_unterminated_string_escape_offset(src);
    let literal_offset:i32=zs_unterminated_literal_offset(src);
    if(invalid_offset<0&&literal_escape_offset>=0){
        out.valid=0;
        let escape_line:i32=zs_line_for_offset(src,literal_escape_offset);
        push[ZsCstRecovery](&out.recoveries,ZsCstRecovery{.kind=14,
            .byte_start=literal_escape_offset,.byte_end=literal_escape_offset+1,
            .line=escape_line,.col=zs_col_for_offset(src,literal_escape_offset),
            .message="unterminated string escape",
            .origin_id=zs_origin_id(src,literal_escape_offset,
                literal_escape_offset+1,escape_line)});
    }else if(invalid_offset<0&&literal_offset>=0){
        out.valid=0;
        let literal_kind:i32=4;
        let literal_message:[]u8="unterminated string or character literal";
        if(src[literal_offset]==34){
            literal_kind=4;literal_message="unterminated string literal";
        }else{literal_kind=5;literal_message="unterminated character literal";}
        push[ZsCstRecovery](&out.recoveries,ZsCstRecovery{.kind=literal_kind,
            .byte_start=literal_offset,.byte_end=src.len,
            .line=zs_line_for_offset(src,literal_offset),
            .col=zs_col_for_offset(src,literal_offset),
            .message=literal_message,
            .origin_id=zs_origin_id(src,literal_offset,src.len,
                zs_line_for_offset(src,literal_offset))});
    }
    let script_profile:i32=zs_script_marker(src);
    let shared:ArrayList[Token]=make[Token](1);
    if(invalid_offset<0&&literal_offset<0&&literal_escape_offset<0){
        shared=lex(zs_cst_lex_input(src,script_profile));
    }
    let shared_i:i32=0;
    let indent_stack:ArrayList[i32]=make[i32](8);push[i32](&indent_stack,0);
    let canonical_brace:i32=zs_has_canonical_brace(src);
    // Delimiter depth is part of the CST, not a normalizer-side text scan.
    // The stack is intentionally byte-sized because only the three shared
    // lexer delimiter pairs participate in Script continuation ownership.
    let delimiters:ArrayList[u8]=make[u8](8);
    let delimiter_depth:i32=0;
    let continuation_owner:i32=-1;
    let delimiter_error_seen:i32=0;
    // The last significant Script line controls whether the next indentation
    // increase is structurally legal.  Blank/comment lines never replace it.
    let last_code_header:i32=-1;
    let last_code_header_error:i32=0;
    // A recognized block header must be followed by a strictly indented
    // significant line. Blank/comment lines preserve this pending state.
    let pending_body_indent:i32=-1;
    let start:i32=0;let line:i32=1;
    while(start<src.len){
        let pos:i32=start;while(pos<src.len&&src[pos]!=10){pos=pos+1;}
        let raw_end:i32=pos;if(pos<src.len){raw_end=pos+1;}
        let body:[]u8=src[start..pos];let ts:i32=zs_trim_start(body);let te:i32=zs_trim_end(body);
        // On a whitespace-only line trim_start reaches body.len while
        // trim_end reaches zero. Canonicalize both ends to the empty slice at
        // body.len instead of constructing the invalid body[len..0] range.
        if(te<ts){te=ts;}
        let content:[]u8=body[ts..te];
        let token_start:i32=out.tokens.len;
        let line_node:ZsCstLine=ZsCstLine{
            .raw_start=start,.raw_end=raw_end,.content_start=start+ts,
            .content_end=start+te,.line=line,.indent=ts,
            .kind=zs_cst_kind(content),.origin_id=zs_origin_id(src,start,raw_end,line),
            .token_start=token_start,.token_end=token_start,.header_kind=0,
            .header_error=0,.logical_owner=out.lines.len,
            .logical_token_start=token_start,.logical_token_end=token_start,
            .logical_raw_end=raw_end,.logical_content_end=start+te,
            .delimiter_before=delimiter_depth,.delimiter_after=delimiter_depth,
        };
        zs_cst_append_shared_tokens(src,line_node,shared,&shared_i,&out.tokens);
        line_node.token_end=out.tokens.len;
        if(line_node.delimiter_before>0&&continuation_owner>=0){
            line_node.logical_owner=continuation_owner;
            line_node.logical_token_start=out.lines.data[continuation_owner].logical_token_start;
        }
        let scan_i:i32=token_start;
        while(scan_i<out.tokens.len){
            let tok:ZsCstToken=out.tokens.data[scan_i];
            let text:[]u8=src[tok.byte_start..tok.byte_end];
            if(@strEq(text,"(")||@strEq(text,"[")||@strEq(text,"{")){
                push[u8](&delimiters,text[0]);
                delimiter_depth=delimiter_depth+1;
            }else if(@strEq(text,")")||@strEq(text,"]")||@strEq(text,"}")){
                if(delimiter_depth==0||
                   zs_delimiter_matches(delimiters.data[delimiter_depth-1],text[0])==0){
                    out.valid=0;delimiter_error_seen=1;
                    push[ZsCstRecovery](&out.recoveries,ZsCstRecovery{.kind=9,
                        .byte_start=tok.byte_start,.byte_end=tok.byte_end,
                        .line=line,.col=tok.col,
                        .message=zs_delimiter_recovery_message(9),
                        .origin_id=zs_origin_id(src,tok.byte_start,tok.byte_end,line)});
                }else{delimiters.len=delimiters.len-1;delimiter_depth=delimiter_depth-1;}
            }
            scan_i=scan_i+1;
        }
        let delimiter_after_value:i32=line_node.delimiter_before+
            zs_delimiter_delta(src,out.tokens,token_start,out.tokens.len);
        if(delimiter_after_value>=0){delimiter_depth=delimiter_after_value;}
        line_node.delimiter_after=delimiter_after_value;
        line_node.logical_token_end=out.tokens.len;
        line_node.logical_raw_end=raw_end;
        line_node.logical_content_end=start+te;
        // A continuation closes the opener's logical token envelope. Re-run
        // header classification only after the complete delimiter expression
        // is available; before that point `if (` is deliberately non-header.
        if(line_node.logical_owner<out.lines.len){
            let owner:ZsCstLine=out.lines.data[line_node.logical_owner];
            if(line_node.logical_owner!=out.lines.len&&delimiter_after_value==0){
                let completed:ZsCstLine=ZsCstLine{.raw_start=owner.raw_start,
                    .raw_end=owner.raw_end,.content_start=owner.content_start,
                    .content_end=owner.content_end,.line=owner.line,.indent=owner.indent,
                    .kind=owner.kind,.origin_id=owner.origin_id,
                    .token_start=owner.token_start,.token_end=owner.token_end,
                    .header_kind=owner.header_kind,.header_error=owner.header_error,
                    .logical_owner=owner.logical_owner,
                    .logical_token_start=owner.logical_token_start,
                    .logical_token_end=out.tokens.len,.logical_raw_end=raw_end,
                    .logical_content_end=start+te,
                    .delimiter_before=owner.delimiter_before,
                    .delimiter_after=owner.delimiter_after};
                let header_view:ZsCstLine=completed;
                header_view.token_start=owner.logical_token_start;
                header_view.token_end=out.tokens.len;
                header_view.content_end=start+te;
                completed.header_kind=zs_cst_header_kind(src,header_view,out.tokens);
                completed.header_error=0;
                if(script_profile==1&&canonical_brace==0&&completed.header_kind==0){
                    completed.header_error=zs_cst_header_error(src,header_view,out.tokens);
                }
                if(completed.header_error==1){
                    out.valid=0;
                    push[ZsCstRecovery](&out.recoveries,ZsCstRecovery{.kind=6,
                        .byte_start=owner.content_start,.byte_end=start+te,
                        .line=owner.line,.col=zs_col_for_offset(src,owner.content_start),
                        .message="malformed Script layout header",
                        .origin_id=owner.origin_id});
                }
                out.lines.data[line_node.logical_owner]=completed;
                line_node.logical_token_start=completed.logical_token_start;
                line_node.header_kind=completed.header_kind;
                line_node.header_error=completed.header_error;
                if(script_profile==1&&canonical_brace==0){
                    last_code_header=completed.header_kind;
                    last_code_header_error=completed.header_error;
                    if(zs_cst_header_opens_block(completed.header_kind)==1){
                        pending_body_indent=completed.indent;
                    }
                }
            }else if(line_node.logical_owner!=out.lines.len){
                out.lines.data[line_node.logical_owner].logical_token_end=out.tokens.len;
                out.lines.data[line_node.logical_owner].logical_raw_end=raw_end;
                out.lines.data[line_node.logical_owner].logical_content_end=start+te;
            }
        }
        line_node.header_kind=zs_cst_header_kind(src,line_node,out.tokens);
        line_node.header_error=0;
        // A Script file containing canonical braces is delegated unchanged to
        // the strict parser. Its ordinary `if (...) { ... }` lines must not
        // be mistaken for malformed indentation headers.
        if(script_profile==1&&canonical_brace==0&&line_node.header_kind==0&&
            line_node.delimiter_after==0){
            line_node.header_error=zs_cst_header_error(src,line_node,out.tokens);
        }
        if(line_node.header_error==1){
            out.valid=0;
            push[ZsCstRecovery](&out.recoveries,ZsCstRecovery{.kind=6,
                .byte_start=line_node.content_start,.byte_end=line_node.content_end,
                .line=line,.col=zs_col_for_offset(src,line_node.content_start),
                .message="malformed Script layout header",
                .origin_id=line_node.origin_id});
        }
        // Keep expression recovery deliberately narrow.  A top-level Script
        // line ending in an operator is an incomplete editor intermediate;
        // record its exact shared-token span, but leave all other expression
        // semantics to the ordinary parser.  Open-delimiter continuations
        // are owned by their logical envelope and are intentionally deferred.
        if(script_profile==1&&canonical_brace==0&&line_node.kind!=1&&
            line_node.header_kind==0&&line_node.header_error==0&&
            line_node.delimiter_before==0&&line_node.delimiter_after==0){
            let trailing_operator:i32=zs_cst_trailing_operator(out.tokens,
                line_node.token_start,line_node.token_end);
            if(trailing_operator>=0){
                let operator_token:ZsCstToken=out.tokens.data[trailing_operator];
                out.valid=0;
                push[ZsCstRecovery](&out.recoveries,ZsCstRecovery{.kind=11,
                    .byte_start=operator_token.byte_start,
                    .byte_end=operator_token.byte_end,.line=line,.col=operator_token.col,
                    .message="expression cannot end with an operator",
                    .origin_id=operator_token.origin_id});
            }
            let trailing_member:i32=zs_cst_trailing_member_access(out.tokens,
                line_node.token_start,line_node.token_end);
            if(trailing_member>=0){
                let member_token:ZsCstToken=out.tokens.data[trailing_member];
                out.valid=0;
                push[ZsCstRecovery](&out.recoveries,ZsCstRecovery{.kind=12,
                    .byte_start=member_token.byte_start,
                    .byte_end=member_token.byte_end,.line=line,.col=member_token.col,
                    .message="expression cannot end with member access",
                    .origin_id=member_token.origin_id});
            }
        }
        // String interpolation is a Script-level convention layered on top
        // of shared string tokens. Record malformed braces before projection
        // can emit a generic normalizer diagnostic, preserving the exact
        // compact-source span and keeping the parser boundary fail-closed.
        if(script_profile==1&&canonical_brace==0){
            let interpolation_i:i32=line_node.token_start;
            while(interpolation_i<line_node.token_end){
                let interpolation_token:ZsCstToken=out.tokens.data[interpolation_i];
                if(interpolation_token.lex_kind==tk_code(Tk.Str)){
                    let bad_brace:i32=zs_cst_string_interpolation_error(src,
                        interpolation_token.byte_start,interpolation_token.byte_end);
                    if(bad_brace>=0){
                        out.valid=0;
                        push[ZsCstRecovery](&out.recoveries,ZsCstRecovery{.kind=13,
                            .byte_start=bad_brace,.byte_end=bad_brace+1,.line=line,
                            .col=zs_col_for_offset(src,bad_brace),
                            .message="malformed string interpolation brace",
                            .origin_id=zs_origin_id(src,bad_brace,bad_brace+1,line)});
                    }
                }
                interpolation_i=interpolation_i+1;
            }
        }
        if(script_profile==1&&content.len>0&&zs_indent_mixed(src,start,start+ts)==1){
            out.valid=0;
            push[ZsCstRecovery](&out.recoveries,ZsCstRecovery{.kind=2,
                .byte_start=start,.byte_end=start+ts,.line=line,.col=1,
                .message="mixed tabs and spaces in indentation",
                .origin_id=line_node.origin_id});
        }
        // Layout is derived from non-trivia lines only.  A comment or blank
        // line retains its exact bytes but cannot open or close a block.
        // Physical indentation inside an open delimiter belongs to the
        // enclosing logical expression, not to the Script block stack.  The
        // shared token delimiter depth is the only authority for this
        // exemption; raw whitespace never opens a second layout grammar.
        if(content.len>0&&line_node.kind!=1&&
            (line_node.delimiter_before==0||script_profile==0)){
            if(script_profile==1&&canonical_brace==0&&pending_body_indent>=0&&
                line_node.indent<=pending_body_indent&&line_node.header_error==0&&
                zs_indent_mixed(src,start,start+ts)==0){
                out.valid=0;
                push[ZsCstRecovery](&out.recoveries,ZsCstRecovery{.kind=8,
                    .byte_start=line_node.content_start,.byte_end=line_node.content_end,
                    .line=line,.col=zs_col_for_offset(src,line_node.content_start),
                    .message="expected an indented statement after block header",
                    .origin_id=line_node.origin_id});
                pending_body_indent=-1;
            }else if(script_profile==1&&canonical_brace==0&&
                pending_body_indent>=0&&line_node.indent>pending_body_indent){
                pending_body_indent=-1;
            }
            let top:i32=indent_stack.data[indent_stack.len-1];
            if(line_node.indent>top){
                if(script_profile==1&&canonical_brace==0&&
                    line_node.header_error==0&&last_code_header_error==0&&
                    zs_cst_header_opens_block(last_code_header)==0&&
                    zs_indent_mixed(src,start,start+ts)==0){
                    out.valid=0;
                    push[ZsCstRecovery](&out.recoveries,ZsCstRecovery{.kind=7,
                        .byte_start=line_node.raw_start,.byte_end=line_node.content_start,
                        .line=line,.col=1,
                        .message="unexpected indentation without a block header",
                        .origin_id=line_node.origin_id});
                }
                push[i32](&indent_stack,line_node.indent);
                push[ZsCstLayout](&out.layouts,ZsCstLayout{.kind=1,
                    .byte_offset=line_node.content_start,.line=line,.indent=line_node.indent,
                    .origin_id=zs_origin_id(src,line_node.content_start,
                    line_node.content_start,line)});
            }else if(line_node.indent<top){
                while(indent_stack.len>1&&line_node.indent<indent_stack.data[indent_stack.len-1]){
                    indent_stack.len=indent_stack.len-1;
                    push[ZsCstLayout](&out.layouts,ZsCstLayout{.kind=2,
                        .byte_offset=line_node.content_start,.line=line,.indent=line_node.indent,
                        .origin_id=zs_origin_id(src,line_node.content_start,
                        line_node.content_start,line)});
                }
                if(line_node.indent!=indent_stack.data[indent_stack.len-1]){
                    out.valid=0;
                    push[ZsCstRecovery](&out.recoveries,ZsCstRecovery{.kind=1,
                        .byte_start=line_node.content_start,.byte_end=line_node.content_end,
                        .line=line,.col=zs_col_for_offset(src,line_node.content_start),
                        .message="inconsistent indentation dedent",
                        .origin_id=line_node.origin_id});
                }
            }
            last_code_header=line_node.header_kind;
            last_code_header_error=line_node.header_error;
            if(script_profile==1&&canonical_brace==0&&
                zs_cst_header_opens_block(line_node.header_kind)==1){
                pending_body_indent=line_node.indent;
            }
        }
        push[ZsCstLine](&out.lines,ZsCstLine{.raw_start=line_node.raw_start,
            .raw_end=line_node.raw_end,.content_start=line_node.content_start,
            .content_end=line_node.content_end,.line=line_node.line,
            .indent=line_node.indent,.kind=line_node.kind,
            .origin_id=line_node.origin_id,.token_start=token_start,
            .token_end=out.tokens.len,.header_kind=line_node.header_kind,
            .header_error=line_node.header_error,.logical_owner=line_node.logical_owner,
            .logical_token_start=line_node.logical_token_start,
            .logical_token_end=line_node.logical_token_end,
            .logical_raw_end=line_node.logical_raw_end,
            .logical_content_end=line_node.logical_content_end,
            .delimiter_before=line_node.delimiter_before,
            .delimiter_after=delimiter_after_value});
        if(delimiter_after_value>0){
            if(line_node.delimiter_before==0){continuation_owner=out.lines.len-1;}
        }else{continuation_owner=-1;}
        start=raw_end;line=line+1;
    }
    if(delimiter_depth>0&&delimiter_error_seen==0){
        out.valid=0;
        push[ZsCstRecovery](&out.recoveries,ZsCstRecovery{.kind=10,
            .byte_start=src.len,.byte_end=src.len,.line=line,
            .col=zs_col_for_offset(src,src.len),
            .message=zs_delimiter_recovery_message(10),
            .origin_id=zs_origin_id(src,src.len,src.len,line)});
    }
    if(script_profile==1&&canonical_brace==0&&pending_body_indent>=0){
        out.valid=0;
        push[ZsCstRecovery](&out.recoveries,ZsCstRecovery{.kind=8,
            .byte_start=src.len,.byte_end=src.len,.line=line,
            .col=zs_col_for_offset(src,src.len),
            .message="expected an indented statement after block header",
            .origin_id=zs_origin_id(src,src.len,src.len,line)});
    }
    // Preserve the normalizer's logical terminal blank line while keeping its
    // raw span empty, so CST reconstruction remains byte-exact.
    if(src.len>0&&src[src.len-1]==10){
        push[ZsCstLine](&out.lines,ZsCstLine{
            .raw_start=src.len,.raw_end=src.len,.content_start=src.len,
            .content_end=src.len,.line=line,.indent=0,.kind=0,
            .origin_id=zs_origin_id(src,src.len,src.len,line),
            .token_start=out.tokens.len,.token_end=out.tokens.len,.header_kind=0,
            .header_error=0,.logical_owner=out.lines.len,
            .logical_token_start=out.tokens.len,.logical_token_end=out.tokens.len,
            .logical_raw_end=src.len,.logical_content_end=src.len,
            .delimiter_before=delimiter_depth,.delimiter_after=delimiter_depth,
        });
    }
    while(indent_stack.len>1){indent_stack.len=indent_stack.len-1;
        push[ZsCstLayout](&out.layouts,ZsCstLayout{.kind=3,.byte_offset=src.len,
            .line=line,.indent=indent_stack.data[indent_stack.len-1],
            .origin_id=zs_origin_id(src,src.len,src.len,line)});
    }
    return out;
}

fn script_syntax_cst_reconstruct(cst:ZsCst)[]u8{
    let out:ArrayList[u8]=make[u8](cst.source.len+1);let i:i32=0;
    while(i<cst.lines.len){let line:ZsCstLine=cst.lines.data[i];zs_app(&out,cst.source[line.raw_start..line.raw_end]);i=i+1;}
    return out.data[0..out.len];
}

// Shared-parser boundary validation.  The CST is still not the indentation
// grammar authority, but no parser may proceed with a projection whose source
// spans, token ranges, or reconstruction are inconsistent.  This keeps the
// compact-source provenance contract fail-closed while the layout/recovery
// nodes are being promoted into the shared lexer.
fn script_syntax_cst_valid(cst:ZsCst)i32{
    let initial_recovery:i32=0;
    while(initial_recovery<cst.recoveries.len){
        // Strict Zag remains owned by the ordinary lexer/parser.  Its CST
        // may record delimiter/literal recovery nodes, but those must not
        // preempt the precise lexical diagnostic (for example E0002 for an
        // unterminated string or character literal).  Script layout errors
        // still fail closed at this shared boundary below.
        if(zs_script_marker(cst.source)==1 &&
            (cst.recoveries.data[initial_recovery].kind==3||
             cst.recoveries.data[initial_recovery].kind==4||
             cst.recoveries.data[initial_recovery].kind==5||
             cst.recoveries.data[initial_recovery].kind==6||
             cst.recoveries.data[initial_recovery].kind==7||
             cst.recoveries.data[initial_recovery].kind==8||
             cst.recoveries.data[initial_recovery].kind==11||
             cst.recoveries.data[initial_recovery].kind==12||
             cst.recoveries.data[initial_recovery].kind==13||
             cst.recoveries.data[initial_recovery].kind==14)){return 0;}
        initial_recovery=initial_recovery+1;
    }
    // Strict Zag is passed through unchanged; its parser owns delimiter and
    // indentation diagnostics. The CST still records the source envelope,
    // but strict formatting columns must not invalidate the Script bridge.
    if(zs_script_marker(cst.source)==0){return 1;}
    // Indentation events are grammar-bearing only for Script files. Strict
    // brace-based Zag may format continuation lines at arbitrary columns.
    if(cst.valid==0&&zs_script_marker(cst.source)==1){return 0;}
    let line_cursor:i32=0;let token_index_cursor:i32=0;let token_byte_cursor:i32=0;let li:i32=0;
    while(li<cst.lines.len){
        let line:ZsCstLine=cst.lines.data[li];
        if(line.raw_start<line_cursor||line.raw_end<line.raw_start||
            line.raw_end>cst.source.len||line.content_start<line.raw_start||
            line.content_end<line.content_start||line.content_end>line.raw_end||
            line.token_start!=token_index_cursor||line.token_end<line.token_start||
            line.token_end>cst.tokens.len){return 0;}
        let ti:i32=line.token_start;
        while(ti<line.token_end){
            let tok:ZsCstToken=cst.tokens.data[ti];
            if(tok.byte_start<line.content_start||tok.byte_end<=tok.byte_start||
                tok.byte_end>line.content_end||tok.byte_start<token_byte_cursor||
                tok.line!=line.line||tok.origin_id<0){return 0;}
            token_byte_cursor=tok.byte_end;ti=ti+1;
        }
        // Trivia between tokens is intentionally allowed; the enclosing line
        // span remains the lossless owner of those bytes.
        token_index_cursor=line.token_end;line_cursor=line.raw_end;li=li+1;
    }
    if(line_cursor>cst.source.len||token_index_cursor!=cst.tokens.len){return 0;}
    // Validate every line's raw span before reconstructing from it.  The CST
    // is an internal contract, but callers (and future incremental tooling)
    // can hand this validator a forged or stale value.  Reconstructing first
    // would slice the source with an unchecked raw_start/raw_end and turn a
    // recoverable invalid projection into a bounds trap instead of a
    // fail-closed rejection.
    if(!@strEq(script_syntax_cst_reconstruct(cst),cst.source)){return 0;}
    let ti:i32=0;while(ti<cst.tokens.len){let tok:ZsCstToken=cst.tokens.data[ti];
        if(tok.byte_start<0||tok.byte_end>cst.source.len){return 0;}ti=ti+1;}
    let layout_cursor:i32=-1;let li2:i32=0;
    while(li2<cst.layouts.len){let event:ZsCstLayout=cst.layouts.data[li2];
        if(event.byte_offset<0||event.byte_offset>cst.source.len||event.line<1||
            event.indent<0||event.origin_id<0||
            (layout_cursor>event.byte_offset&&event.kind!=3)){return 0;}
        layout_cursor=event.byte_offset;li2=li2+1;
    }
    let ri:i32=0;
    while(ri<cst.recoveries.len){
        let recovery:ZsCstRecovery=cst.recoveries.data[ri];
        // Strict Zag delimiter mismatches remain available to the ordinary
        // parser so it can emit its precise declaration/annotation diagnostic;
        // the CST span contract itself is still structurally valid. Script
        // files with these recoveries already fail above through cst.valid.
        if((recovery.kind<1||recovery.kind>14)||recovery.byte_start<0||
            recovery.byte_end<recovery.byte_start||recovery.byte_end>cst.source.len||
            recovery.line<1||recovery.col<1||recovery.origin_id<0||
            recovery.message.len==0){return 0;}
        ri=ri+1;
    }
    return 1;
}

// Validate that every token the shared parser is about to consume belongs to
// one complete generated-origin segment.  This is intentionally a structural
// check only: expression/header meaning remains owned by lex.zag and
// parse.zag.  In particular, inserted braces and separators are allowed to
// map conservatively to their compact source line through an inexact segment,
// while a token that escapes the projection is rejected instead of silently
// receiving a guessed origin.
fn script_syntax_parser_tokens_valid(normalized:ZsNormalized,
                                     tokens:ArrayList[Token])i32{
    if(script_syntax_cst_valid(normalized.cst)==0){return 0;}
    let cursor:i32=0;let oi:i32=0;
    while(oi<normalized.origins.len){
        let segment:ZsOriginSegment=normalized.origins.data[oi];
        if(segment.generated_start!=cursor||segment.generated_start<0||
            segment.generated_end<=segment.generated_start||
            segment.generated_end>normalized.source.len||
            segment.source_start<0||segment.source_end<segment.source_start||
            segment.source_end>normalized.cst.source.len||segment.origin_id<0||
            (segment.exact!=0&&segment.exact!=1)){return 0;}
        cursor=segment.generated_end;oi=oi+1;
    }
    if(cursor!=normalized.source.len){
        // An empty strict source has no generated bytes and therefore no
        // segment.  Any non-empty projection must nevertheless be complete.
        if(normalized.source.len!=0||normalized.origins.len!=0){return 0;}
    }
    let previous_end:i32=0;let ti:i32=0;
    while(ti<tokens.len){
        let token:Token=tokens.data[ti];
        if(tk_code(token.kind)==tk_code(Tk.Eof)){
            if(token.byte_start!=normalized.source.len||token.byte_end!=normalized.source.len){return 0;}
            ti=ti+1;continue;
        }
        if(token.byte_start<0||token.byte_end<=token.byte_start||
            token.byte_end>normalized.source.len||token.byte_start<previous_end||
            token.line<1||token.col<1){return 0;}
        let covered:i32=0;let si:i32=0;
        while(si<normalized.origins.len){
            let segment:ZsOriginSegment=normalized.origins.data[si];
            if(segment.generated_start<=token.byte_start&&
                token.byte_end<=segment.generated_end){covered=1;break;}
            si=si+1;
        }
        if(covered==0){return 0;}
        previous_end=token.byte_end;ti=ti+1;
    }
    return 1;
}

// Single entry point for the shared parser's token stream.  Script callers
// first produce a lossless CST/normalized projection; this bridge then invokes
// the ordinary lexer exactly once and validates the resulting token spans
// against that projection before parse.zag can construct AST nodes.
fn script_syntax_parser_input(normalized:ZsNormalized)ZsParserInput{
    let tokens:ArrayList[Token]=lex(normalized.source);
    if(script_syntax_parser_tokens_valid(normalized,tokens)==0){
        _zag_eprintln("E0018: shared parser token stream escaped Script CST origin projection");
        _zag_exit(1);
    }
    return ZsParserInput{.tokens=tokens,.cst=normalized.cst,.origins=normalized.origins};
}

fn zs_app(out:*ArrayList[u8],s:[]u8)void{let i:i32=0;while(i<s.len){push[u8](out,s[i]);i=i+1;}}
fn zs_ch(out:*ArrayList[u8],c:i32)void{push[u8](out,c as u8);}
fn zs_space(c:u8)bool{return c==32||c==9||c==10||c==13;}
fn zs_trim_start(s:[]u8)i32{let i:i32=0;while(i<s.len&&zs_space(s[i])){i=i+1;}return i;}
fn zs_trim_end(s:[]u8)i32{let i:i32=s.len;while(i>0&&zs_space(s[i-1])){i=i-1;}return i;}
fn zs_indent_mixed(src:[]u8,start:i32,end:i32)i32{
    let saw_space:i32=0;let saw_tab:i32=0;let i:i32=start;
    while(i<end){if(src[i]==32){saw_space=1;}else if(src[i]==9){saw_tab=1;}i=i+1;}
    return (saw_space==1&&saw_tab==1) as i32;
}
fn zs_starts(s:[]u8,p:[]u8)bool{if(s.len<p.len){return false;}return @strEq(s[0..p.len],p);}
fn zs_ends(s:[]u8,p:[]u8)bool{if(s.len<p.len){return false;}return @strEq(s[s.len-p.len..s.len],p);}
fn zs_ident(c:u8)bool{return(c>='a'&&c<='z')||(c>='A'&&c<='Z')||(c>='0'&&c<='9')||c=='_';}
fn zs_name_seen(names:ArrayList[[]u8],name:[]u8)i32{let i:i32=0;while(i<names.len){if(@strEq(names.data[i],name)){return 1;}i=i+1;}return 0;}
fn zs_find(s:[]u8,needle:[]u8)i32{if(needle.len==0){return 0;}let i:i32=0;while(i+needle.len<=s.len){if(@strEq(s[i..i+needle.len],needle)){return i;}i=i+1;}return -1;}
fn zs_type_name(name:[]u8)[]u8{if(@strEq(name,"int")){return "i64";}if(@strEq(name,"float")){return "f64";}if(@strEq(name,"str")){return "[]u8";}if(@strEq(name,"bool")){return "bool";}if(@strEq(name,"None")){return "void";}return name;}
fn zs_interp_binding_kind(bindings:ArrayList[ZsInterpBinding],name:[]u8)i32{
    let i:i32=0;while(i<bindings.len){if(@strEq(bindings.data[i].name,name)){return bindings.data[i].kind;}i=i+1;}return 0;
}
fn zs_interp_binding_set(bindings:*ArrayList[ZsInterpBinding],name:[]u8,kind:i32)void{
    if(name.len==0){return;}
    let i:i32=0;while(i<bindings.*.len){if(@strEq(bindings.*.data[i].name,name)){bindings.*.data[i].kind=kind;return;}i=i+1;}
    push[ZsInterpBinding](bindings,ZsInterpBinding{.name=name,.kind=kind});
}
fn zs_interp_lhs_name(lhs:[]u8,annotation_colon:i32)[]u8{
    let a:i32=zs_trim_start(lhs);let b:i32=zs_trim_end(lhs);let start:i32=a;
    if(start+4<=b&&@strEq(lhs[start..start+4],"let ")){start=start+4;while(start<b&&zs_space(lhs[start])){start=start+1;}}
    let stop:i32=b;if(annotation_colon>=start&&annotation_colon<b){stop=annotation_colon;}
    while(stop>start&&zs_space(lhs[stop-1])){stop=stop-1;}
    return lhs[start..stop];
}
fn zs_interp_annotation_kind(lhs:[]u8,annotation_colon:i32)i32{
    let start:i32=zs_trim_start(lhs);let end:i32=zs_trim_end(lhs);
    if(annotation_colon<start||annotation_colon>=end){return 0;}
    let raw:[]u8=lhs[annotation_colon+1..end];let a:i32=zs_trim_start(raw);let b:i32=zs_trim_end(raw);let ty:[]u8=raw[a..b];
    if(@strEq(ty,"bool")){return 3;}if(@strEq(ty,"int")||@strEq(ty,"i64")||@strEq(ty,"i32")){return 2;}
    if(@strEq(ty,"float")||@strEq(ty,"f32")||@strEq(ty,"f64")){return 5;}
    if(@strEq(ty,"str")||@strEq(ty,"[]u8")){return 1;}return 0;
}
fn zs_emit_lhs(out:*ArrayList[u8],lhs:[]u8,annotation_colon:i32)void{
    let start:i32=zs_trim_start(lhs);let end:i32=zs_trim_end(lhs);
    if(annotation_colon<start||annotation_colon>=end){zs_app(out,lhs);return;}
    let at:i32=annotation_colon;zs_app(out,lhs[0..at+1]);let raw:[]u8=lhs[at+1..end];let a:i32=zs_trim_start(raw);let b:i32=zs_trim_end(raw);zs_app(out,zs_type_name(raw[a..b]));
}
// Find only a top-level assignment operator using the shared lexer.  Raw byte
// scanning is insufficient here: `=` inside a call, index expression, or
// string is expression syntax, not a Script binding separator.  Keeping the
// byte offset from the lexer preserves the existing source-origin envelope
// while making the grammar decision token-derived.
fn zs_find_assignment_token(s:[]u8)i32{
    let toks:ArrayList[Token]=lex(s);let hi:i32=toks.len;
    if(hi>0&&tk_code(get[Token](toks,hi-1).kind)==tk_code(Tk.Eof)){hi=hi-1;}
    let paren:i32=0;let bracket:i32=0;let brace:i32=0;let i:i32=0;
    while(i<hi){
        let tok:Token=get[Token](toks,i);let kind:i32=tk_code(tok.kind);
        if(kind==tk_code(Tk.Lp)){paren=paren+1;}
        else if(kind==tk_code(Tk.Rp)){if(paren>0){paren=paren-1;}else{return -1;}}
        else if(kind==tk_code(Tk.Lbracket)){bracket=bracket+1;}
        else if(kind==tk_code(Tk.Rbracket)){if(bracket>0){bracket=bracket-1;}else{return -1;}}
        else if(kind==tk_code(Tk.Lbrace)){brace=brace+1;}
        else if(kind==tk_code(Tk.Rbrace)){if(brace>0){brace=brace-1;}else{return -1;}}
        else if(kind==tk_code(Tk.Op)&&@strEq(tok.val,"=")&&paren==0&&bracket==0&&brace==0){return tok.byte_start;}
        i=i+1;
    }
    return -1;
}

// Project the complete assignment boundary from one CST line. The first
// top-level colon before `=` is the binding annotation; colons inside generic
// brackets, calls, and literals remain expression/type tokens and cannot shift
// this boundary. All offsets are relative to `base`.
fn zs_assignment_bounds_cst(src:[]u8,node:ZsCstLine,
                            tokens:ArrayList[ZsCstToken],base:i32,limit:i32)ZsAssignmentBounds{
    let bad:ZsAssignmentBounds=ZsAssignmentBounds{.eq=-1,.annotation_colon=-1,
        .rhs_start=-1,.valid=0};
    if(base<0||limit<base||limit>src.len){return bad;}
    let paren:i32=0;let bracket:i32=0;let brace:i32=0;let colon:i32=-1;let i:i32=node.token_start;
    while(i<node.token_end&&i<tokens.len){
        let tok:ZsCstToken=tokens.data[i];
        if(tok.byte_start>=base&&tok.byte_end<=limit){
            let text:[]u8=src[tok.byte_start..tok.byte_end];
            if(@strEq(text,"(")){paren=paren+1;}
            else if(@strEq(text,")")){if(paren>0){paren=paren-1;}else{return bad;}}
            else if(@strEq(text,"[")){bracket=bracket+1;}
            else if(@strEq(text,"]")){if(bracket>0){bracket=bracket-1;}else{return bad;}}
            else if(@strEq(text,"{")){brace=brace+1;}
            else if(@strEq(text,"}")){if(brace>0){brace=brace-1;}else{return bad;}}
            else if(tok.kind==5&&@strEq(text,":")&&paren==0&&bracket==0&&brace==0&&colon<0){colon=tok.byte_start-base;}
            else if(tok.kind==4&&@strEq(text,"=")&&paren==0&&bracket==0&&brace==0){
                return ZsAssignmentBounds{.eq=tok.byte_start-base,
                    .annotation_colon=colon,.rhs_start=tok.byte_end-base,.valid=1};
            }
        }
        i=i+1;
    }
    return bad;
}

// Find a top-level assignment in one CST line without lexing that line again.
// The CST token range was produced by the shared lexer over the compact
// source, so this helper only projects token bytes into the already-bounded
// statement slice.  `base` and `limit` are source offsets; the returned offset
// is relative to `base`, matching zs_find_assignment_token's contract.  This
// keeps statement lowering from making a second, line-local grammar decision
// while retaining the old helper as a focused unit-test oracle.
fn zs_find_assignment_cst(src:[]u8,node:ZsCstLine,
                          tokens:ArrayList[ZsCstToken],base:i32,limit:i32)i32{
    return zs_assignment_bounds_cst(src,node,tokens,base,limit).eq;
}
fn zs_interp_expr_kind(s:[]u8,bindings:ArrayList[ZsInterpBinding])i32{
    let toks:ArrayList[Token]=lex(s);let hi:i32=toks.len;if(hi>0&&toks.data[hi-1].kind==Tk.Eof){hi=hi-1;}
    if(hi<=0){return 0;}
    // Preserve only the lexical spelling of a standalone float literal. This
    // avoids both an ordinary-heap temporary and an invented formatting rule.
    if(hi==1&&toks.data[0].kind==Tk.Float){return 4;}
    if(hi==2&&toks.data[0].kind==Tk.Op&&@strEq(toks.data[0].val,"-")&&toks.data[1].kind==Tk.Float){return 4;}
    let saw_numeric:i32=0;let saw_float:i32=0;let saw_bool:i32=0;let saw_bytes:i32=0;let unknown:i32=0;let bool_op:i32=0;let arithmetic:i32=0;let i:i32=0;
    while(i<hi){let tok:Token=toks.data[i];
        if(tok.kind==Tk.Int){saw_numeric=1;}
        else if(tok.kind==Tk.Float){saw_float=1;}
        else if(tok.kind==Tk.Str){saw_bytes=1;}
        else if(tok.kind==Tk.KwTrue||tok.kind==Tk.KwFalse){saw_bool=1;}
        else if(tok.kind==Tk.Ident){
            if(@strEq(tok.val,"True")||@strEq(tok.val,"False")){saw_bool=1;}
            else if(@strEq(tok.val,"len")||@strEq(tok.val,"length")||@strEq(tok.val,"args_len")||@strEq(tok.val,"script_alloc_used")){saw_numeric=1;}
            else{let known:i32=zs_interp_binding_kind(bindings,tok.val);if(known==1){saw_bytes=1;}else if(known==2){saw_numeric=1;}else if(known==3){saw_bool=1;}else if(known==5){saw_float=1;}else if(tok.val.len>0&&tok.val[0]!='_'){unknown=1;}}
        }else if(tok.kind==Tk.Op){
            if(@strEq(tok.val,"==")||@strEq(tok.val,"!=")||@strEq(tok.val,"<")||@strEq(tok.val,"<=")||@strEq(tok.val,">")||@strEq(tok.val,">=")||@strEq(tok.val,"&&")||@strEq(tok.val,"||")||@strEq(tok.val,"!")){bool_op=1;}else if(@strEq(tok.val,"+")||@strEq(tok.val,"-")||@strEq(tok.val,"*")||@strEq(tok.val,"/")||@strEq(tok.val,"%")){arithmetic=1;}
        }
        i=i+1;
    }
    if(bool_op==1&&unknown==0&&saw_bytes==0){return 3;}
    if(saw_float==1&&unknown==0&&saw_bytes==0&&saw_bool==0){return 5;}
    if(saw_numeric==1&&unknown==0&&saw_float==0&&saw_bytes==0&&saw_bool==0){return 2;}
    if(saw_bool==1&&unknown==0&&saw_bytes==0&&arithmetic==0){return 3;}
    if(saw_bytes==1&&unknown==0&&saw_numeric==0&&saw_bool==0){return 1;}
    return 0;
}

// Infer an assignment RHS directly from its enclosing CST token range.  The
// shared lexer has already classified literals/operators and retained their
// exact source spans; this helper only repeats the existing bounded type fact
// projection, not expression parsing.  Interpolation expressions still use
// zs_interp_expr_kind because they live inside one string token.
fn zs_interp_expr_kind_cst(src:[]u8,node:ZsCstLine,
                           tokens:ArrayList[ZsCstToken],base:i32,limit:i32,
                           assignment:ZsAssignmentBounds,
                           bindings:ArrayList[ZsInterpBinding])i32{
    if(assignment.valid==0||base<0||limit<base||limit>src.len||
       assignment.rhs_start<0){return 0-1;}
    let rhs_start:i32=base+assignment.rhs_start;
    if(rhs_start<base||rhs_start>limit){return 0-1;}
    let hi:i32=0;let first_float:i32=0;let second_float:i32=0;
    let first_minus:i32=0;let saw_numeric:i32=0;let saw_float:i32=0;
    let saw_bool:i32=0;let saw_bytes:i32=0;let unknown:i32=0;
    let bool_op:i32=0;let arithmetic:i32=0;let i0:i32=node.token_start;let i:i32=i0;
    while(i<node.token_end&&i<tokens.len){
        let tok:ZsCstToken=tokens.data[i];
        if(tok.byte_start>=rhs_start&&tok.byte_end<=limit){
            let text:[]u8=src[tok.byte_start..tok.byte_end];let is_float:i32=0;
            if(tok.kind==2){
                let p:i32=0;while(p<text.len){if(text[p]=='.'||text[p]=='e'||text[p]=='E'){is_float=1;}p=p+1;}
                if(is_float==1){saw_float=1;}else{saw_numeric=1;}
            }else if(tok.kind==3){saw_bytes=1;}
            else if(tok.kind==1){
                if(@strEq(text,"true")||@strEq(text,"false")||
                   @strEq(text,"True")||@strEq(text,"False")){saw_bool=1;}
                else if(@strEq(text,"len")||@strEq(text,"length")||
                        @strEq(text,"args_len")||@strEq(text,"script_alloc_used")){saw_numeric=1;}
                else if(text.len>0&&text[0]!='@'){
                    let known:i32=zs_interp_binding_kind(bindings,text);
                    if(known==1){saw_bytes=1;}else if(known==2){saw_numeric=1;}
                    else if(known==3){saw_bool=1;}else if(known==5){saw_float=1;}
                    else if(text.len>0&&text[0]!='_'){unknown=1;}
                }
            }else if(tok.kind==4){
                if(@strEq(text,"==")||@strEq(text,"!=")||@strEq(text,"<")||
                   @strEq(text,"<=")||@strEq(text,">")||@strEq(text,">=")||
                   @strEq(text,"&&")||@strEq(text,"||")||@strEq(text,"!")||
                   @strEq(text,"and")||@strEq(text,"or")){bool_op=1;}
                else if(@strEq(text,"+")||@strEq(text,"-")||
                        @strEq(text,"*")||@strEq(text,"/")||@strEq(text,"%")){arithmetic=1;}
            }
            if(hi==0){first_float=is_float;first_minus=(tok.kind==4&&@strEq(text,"-")) as i32;}
            else if(hi==1){second_float=is_float;}
            hi=hi+1;
        }
        i=i+1;
    }
    if(hi<=0){return 0;}
    if(hi==1&&first_float==1){return 4;}
    if(hi==2&&first_minus==1&&second_float==1){return 4;}
    if(bool_op==1&&unknown==0&&saw_bytes==0){return 3;}
    if(saw_float==1&&unknown==0&&saw_bytes==0&&saw_bool==0){return 5;}
    if(saw_numeric==1&&unknown==0&&saw_float==0&&saw_bytes==0&&saw_bool==0){return 2;}
    if(saw_bool==1&&unknown==0&&saw_bytes==0&&arithmetic==0){return 3;}
    if(saw_bytes==1&&unknown==0&&saw_numeric==0&&saw_bool==0){return 1;}
    return 0;
}
fn zs_emit_expr_gap(out:*ArrayList[u8],s:[]u8,start:i32,end:i32)void{
    // Keep ordinary horizontal trivia for strict-looking one-line source.
    // A multiline logical envelope collapses its newline/indentation gap to
    // one separator, so physical indentation cannot leak into generated
    // expression spelling.
    let saw_newline:i32=0;let i:i32=start;
    while(i<end){if(s[i]==10){saw_newline=1;}i=i+1;}
    if(saw_newline==1){zs_ch(out,32);return;}
    i=start;
    while(i<end){
        if(s[i]==32||s[i]==9||s[i]==13){zs_ch(out,s[i]);}
        i=i+1;
    }
}

fn zs_interp_trim_start(s:[]u8,start:i32,end:i32)i32{
    let i:i32=start;while(i<end&&(s[i]==32||s[i]==9||s[i]==13)){i=i+1;}return i;
}
fn zs_interp_trim_end(s:[]u8,start:i32,end:i32)i32{
    let i:i32=end;while(i>start&&(s[i-1]==32||s[i-1]==9||s[i-1]==13)){i=i-1;}return i;
}
fn zs_interp_emit_literal(out:*ArrayList[u8],s:[]u8,start:i32,end:i32)void{
    // The lexer already validated the enclosing quote.  Preserve escapes and
    // collapse only the documented doubled-brace escapes ({{ and }}).
    zs_ch(out,34);let i:i32=start;
    while(i<end){
        if((s[i]=='{'||s[i]=='}')&&i+1<end&&s[i+1]==s[i]){zs_ch(out,s[i]);i=i+2;}
        else{zs_ch(out,s[i]);i=i+1;}
    }
    zs_ch(out,34);
}
fn zs_interp_emit_part(out:*ArrayList[u8],s:[]u8,part:ZsInterpPart,bindings:ArrayList[ZsInterpBinding])void{
    if(part.kind==0){zs_interp_emit_literal(out,s,part.start,part.end);}
    else{
        let expr:[]u8=s[part.start..part.end];let kind:i32=zs_interp_expr_kind(expr,bindings);
        if(kind==2){zs_app(out,"script_string_i64(__zag_script_context, (");zs_emit_expr(out,expr,bindings);zs_app(out,") as i64)");}
        else if(kind==3){zs_app(out,"script_string_bool(__zag_script_context, (");zs_emit_expr(out,expr,bindings);zs_app(out,"))");}
        else if(kind==4){zs_interp_emit_literal(out,expr,0,expr.len);}
        else if(kind==5){zs_app(out,"script_string_f64(__zag_script_context, (");zs_emit_expr(out,expr,bindings);zs_app(out,"))");}
        else{zs_emit_expr(out,expr,bindings);}
    }
}
fn zs_interp_emit_chain(out:*ArrayList[u8],s:[]u8,parts:ArrayList[ZsInterpPart],at:i32,bindings:ArrayList[ZsInterpBinding])void{
    let part:ZsInterpPart=parts.data[at];
    if(at+1>=parts.len){zs_interp_emit_part(out,s,part,bindings);return;}
    zs_app(out,"string_concat(");zs_interp_emit_part(out,s,part,bindings);zs_app(out,", ");
    zs_interp_emit_chain(out,s,parts,at+1,bindings);zs_ch(out,')');
}
fn zs_emit_string_token(out:*ArrayList[u8],s:[]u8,token:[]u8,bindings:ArrayList[ZsInterpBinding])void{
    // token includes its surrounding quotes.  No braces means byte-for-byte
    // preservation, which keeps strict-looking strings and escaped bytes
    // stable.  A single brace starts a []u8 expression; doubled braces are
    // literal braces.  Nested braces, empty expressions, and unmatched braces
    // are rejected instead of being guessed at by a second parser.
    if(token.len<2){zs_app(out,token);return;}
    let body_start:i32=1;let body_end:i32=token.len-1;let i:i32=body_start;let has_interp:i32=0;
    while(i<body_end){
        if((token[i]=='{'||token[i]=='}')&&i+1<body_end&&token[i+1]==token[i]){has_interp=1;i=i+2;}
        else if(token[i]=='{'||token[i]=='}'){has_interp=1;i=i+1;}
        else{i=i+1;}
    }
    if(has_interp==0){zs_app(out,token);return;}
    let parts:ArrayList[ZsInterpPart]=make[ZsInterpPart](8);
    let cursor:i32=body_start;let literal_start:i32=body_start;let p:i32=body_start;
    while(p<body_end){
        if(token[p]=='{'&&p+1<body_end&&token[p+1]=='{'){p=p+2;continue;}
        if(token[p]=='}'&&p+1<body_end&&token[p+1]=='}'){p=p+2;continue;}
        if(token[p]=='}'){
            _zag_eprintln("Zag Script interpolation: unmatched `}` (use `}}` for a literal brace)");_zag_exit(1);
        }
        if(token[p]!='{'){p=p+1;continue;}
        push[ZsInterpPart](&parts,ZsInterpPart{.kind=0,.start=literal_start,.end=p});
        let q:i32=p+1;while(q<body_end&&token[q]!='}'){if(token[q]=='{'){
            _zag_eprintln("Zag Script interpolation: nested `{` is not supported");_zag_exit(1);
        }q=q+1;}
        if(q>=body_end){_zag_eprintln("Zag Script interpolation: unmatched `{` (close the expression or use `{{`)");_zag_exit(1);}
        let expr_start:i32=zs_interp_trim_start(token,p+1,q);let expr_end:i32=zs_interp_trim_end(token,expr_start,q);
        if(expr_start>=expr_end){_zag_eprintln("Zag Script interpolation: expression between braces cannot be empty");_zag_exit(1);}
        push[ZsInterpPart](&parts,ZsInterpPart{.kind=1,.start=expr_start,.end=expr_end});
        cursor=q+1;literal_start=cursor;p=cursor;
    }
    push[ZsInterpPart](&parts,ZsInterpPart{.kind=0,.start=literal_start,.end=body_end});
    let generated:ArrayList[u8]=make[u8](token.len+64);zs_interp_emit_chain(&generated,token,parts,0,bindings);
    zs_app(out,generated.data[0..generated.len]);
}

fn zs_emit_expr_tokens(out:*ArrayList[u8],s:[]u8,toks:ArrayList[Token],lo:i32,hi:i32,bindings:ArrayList[ZsInterpBinding])void{
    let i:i32=lo;let previous_end:i32=0;let have_previous:i32=0;
    while(i<hi){
        let tok:Token=toks.data[i];
        if(have_previous==1&&tok.byte_start>previous_end){
            let closing:i32=(@strEq(tok.val,")")||@strEq(tok.val,"]")||
                @strEq(tok.val,"}")) as i32;
            if(closing==0){zs_emit_expr_gap(out,s,previous_end,tok.byte_start);}
        }
        if(tok.kind==Tk.Ident){
            let word:[]u8=tok.val;
            // `make[T]` is canonical Zag generic application, not beginner
            // collection indexing. Keep it intact so allocation accounting and
            // strict diagnostics see the real allocator call.
            if(i+1<hi&&toks.data[i+1].kind==Tk.Lbracket&&
                !@strEq(word,"make")){
                let close:i32=i+2;let depth:i32=1;
                while(close<hi&&depth>0){
                    if(toks.data[close].kind==Tk.Lbracket){depth=depth+1;}
                    else if(toks.data[close].kind==Tk.Rbracket){depth=depth-1;}
                    close=close+1;
                }
                if(depth!=0){_zag_eprintln("Zag Script: list index is missing `]`");_zag_exit(1);}
                zs_app(out,"item_at(");zs_app(out,word);zs_app(out,", ");
                zs_emit_expr_tokens(out,s,toks,i+2,close-1,bindings);zs_ch(out,')');
                previous_end=toks.data[close-1].byte_end;i=close;have_previous=1;
                continue;
            }
            if(@strEq(word,"True")){zs_app(out,"true");}
            else if(@strEq(word,"False")){zs_app(out,"false");}
            else if(@strEq(word,"None")){zs_app(out,"null");}
            else if(@strEq(word,"not")){zs_ch(out,'!');}
            else if(@strEq(word,"print")){zs_app(out,"println");}
            else{zs_app(out,word);}
        }else{
            // Token.val is the shared lexer’s canonical spelling (`and`/`or`
            // are already `&&`/`||`), while strings and literals retain their
            // exact source bytes.
            if(tok.kind==Tk.Str){zs_emit_string_token(out,s,tok.val,bindings);}
            else{zs_app(out,tok.val);}
        }
        previous_end=tok.byte_end;i=i+1;have_previous=1;
    }
}

fn zs_emit_expr(out:*ArrayList[u8],s:[]u8,bindings:ArrayList[ZsInterpBinding])void{
    let toks:ArrayList[Token]=lex(s);let hi:i32=toks.len;
    if(hi>0&&toks.data[hi-1].kind==Tk.Eof){hi=hi-1;}
    zs_emit_expr_tokens(out,s,toks,0,hi,bindings);
}

// Resolve one compact-source expression span to the exact shared-CST token
// interval it contains. A span that cuts through a token, overlaps a token
// outside the requested interval, or contains no token is invalid. This is a
// structural boundary check only; expression meaning remains owned by the
// ordinary parser after projection.
fn zs_cst_expr_token_bounds(src:[]u8,tokens:ArrayList[ZsCstToken],
                            start:i32,end:i32)ZsExprTokenBounds{
    let bad:ZsExprTokenBounds=ZsExprTokenBounds{.first=-1,.last=-1,.valid=0};
    if(start<0||end<=start||end>src.len){return bad;}
    let first:i32=-1;let last:i32=-1;let i:i32=0;
    // Keep this bounded envelope check allocation-free.  The CST already
    // owns the token storage; allocating and freeing a temporary ArrayList
    // here made every expression projection carry an independent ownership
    // edge through the native compiler.  A two-bit stack is sufficient for
    // the shared three delimiter kinds and fails closed above 31 nesting
    // levels rather than risking an overflowing shift.
    let delimiter_stack:i64=0;
    let delimiter_depth:i32=0;
    while(i<tokens.len){
        let tok:ZsCstToken=tokens.data[i];
        if(tok.byte_start<0||tok.byte_end<=tok.byte_start||
           tok.byte_end>src.len){return bad;}
        // Any token crossing either boundary means the caller supplied a
        // stale/forged byte span rather than a projection derived from CST.
        if(tok.byte_start<end&&tok.byte_end>start&&
           (tok.byte_start<start||tok.byte_end>end)){return bad;}
        if(tok.byte_start>=start&&tok.byte_end<=end){
            if(first<0){first=i;}
            last=i+1;
            let text:[]u8=src[tok.byte_start..tok.byte_end];
            if(@strEq(text,"(")||@strEq(text,"[")||@strEq(text,"{")){
                if(delimiter_depth>=31){return bad;}
                let code:i64=(@strEq(text,"(") as i64)+
                    2*(@strEq(text,"[") as i64)+
                    3*(@strEq(text,"{") as i64);
                delimiter_stack=(delimiter_stack<<2)|code;
                delimiter_depth=delimiter_depth+1;
            }
            else if(@strEq(text,")")||@strEq(text,"]")||@strEq(text,"}")){
                let expected:i64=delimiter_stack&3;
                let actual:i64=(@strEq(text,")") as i64)+
                    2*(@strEq(text,"]") as i64)+
                    3*(@strEq(text,"}") as i64);
                if(delimiter_depth==0||expected!=actual){return bad;}
                delimiter_stack=delimiter_stack>>2;
                delimiter_depth=delimiter_depth-1;
            }
        }else if(first>=0&&tok.byte_start>=end){break;}
        i=i+1;
    }
    if(first<0||last<=first||delimiter_depth!=0){return bad;}
    return ZsExprTokenBounds{.first=first,.last=last,.valid=1};
}

// Validate one side of a map entry without inventing an expression grammar.
// The shared lexer has already established that these are integer tokens; the
// small range check prevents a host-width integer from being silently
// truncated to ScriptMapI32's i32 key/value contract.
fn zs_map_i32_magnitude(text:[]u8,limit:i64)i32{
    if(text.len==0||limit<0){return 0;}
    let base:i64=10;let i:i32=0;
    if(text.len>=2&&text[0]=='0'&&(text[1]=='x'||text[1]=='X')){base=16;i=2;}
    let value:i64=0;let saw_digit:i32=0;
    while(i<text.len){
        let c:u8=text[i];
        if(c=='_'){i=i+1;continue;}
        let digit:i64=0-1;
        if(c>='0'&&c<='9'){digit=(c as i64)-48;}
        else if(base==16&&c>='a'&&c<='f'){digit=(c as i64)-87;}
        else if(base==16&&c>='A'&&c<='F'){digit=(c as i64)-55;}
        if(digit<0||digit>=base||digit>limit||value>(limit-digit)/base){return 0;}
        value=value*base+digit;saw_digit=1;i=i+1;
    }
    return saw_digit;
}

fn zs_map_i32_literal(src:[]u8,tokens:ArrayList[ZsCstToken],first:i32,last:i32)i32{
    if(first<0||last<=first||last>tokens.len){return 0;}
    let negative:i32=0;let value_token:i32=first;
    if(last-first==2){
        let minus:ZsCstToken=tokens.data[first];
        if(minus.lex_kind!=tk_code(Tk.Op)||!@strEq(src[minus.byte_start..minus.byte_end],"-")){return 0;}
        negative=1;value_token=first+1;
    }else if(last-first!=1){return 0;}
    let literal:ZsCstToken=tokens.data[value_token];
    if(literal.lex_kind!=tk_code(Tk.Int)){return 0;}
    let limit:i64=2147483647;
    if(negative==1){limit=2147483648;}
    return zs_map_i32_magnitude(src[literal.byte_start..literal.byte_end],limit);
}

fn zs_map_entry_i32(src:[]u8,tokens:ArrayList[ZsCstToken],first:i32,last:i32)i32{
    if(first<0||last<=first||last>tokens.len){return 0;}
    let colon:i32=-1;let i0:i32=first;let i:i32=i0;
    while(i<last){
        let tok:ZsCstToken=tokens.data[i];let text:[]u8=src[tok.byte_start..tok.byte_end];
        // Nested expressions, calls, and containers intentionally remain
        // outside this first homogeneous literal slice. They must not be
        // interpreted by a second scanner here.
        if(@strEq(text,"{")||@strEq(text,"}")||@strEq(text,"(")||
           @strEq(text,")")||@strEq(text,"[")||@strEq(text,"]")){return 0;}
        if(tok.kind==5&&@strEq(text,":")){
            if(colon>=0){return 0;}colon=i;
        }
        i=i+1;
    }
    if(colon<=first||colon+1>=last){return 0;}
    return (zs_map_i32_literal(src,tokens,first,colon)==1&&
        zs_map_i32_literal(src,tokens,colon+1,last)==1) as i32;
}

// Validate one side of a text-map entry.  The shared CST lexer must classify
// the complete side as exactly one string token; this keeps identifiers,
// calls, containers, interpolation expressions, and malformed token spans out
// of the bounded literal surface.  Text-map literals deliberately do not
// admit Script interpolation: doubled braces retain the existing string
// escape semantics (`{{`/`}}` -> literal brace), while every leftover single
// brace is rejected before the expression emitter can interpret it.
fn zs_map_text_literal(src:[]u8,tokens:ArrayList[ZsCstToken],first:i32,last:i32)i32{
    if(first<0||last<=first||last>tokens.len||last-first!=1){return 0;}
    let tok:ZsCstToken=tokens.data[first];
    if(tok.lex_kind!=tk_code(Tk.Str)||tok.byte_start<0||tok.byte_end<=tok.byte_start||
       tok.byte_end>src.len||tok.byte_end-tok.byte_start<2){return 0;}
    let text:[]u8=src[tok.byte_start..tok.byte_end];
    let i:i32=1;let end:i32=text.len-1;
    while(i<end){
        if((text[i]=='{'||text[i]=='}')&&i+1<end&&text[i+1]==text[i]){i=i+2;}
        else if(text[i]=='{'||text[i]=='}'){return 0;}
        else{i=i+1;}
    }
    return 1;
}

fn zs_map_entry_text(src:[]u8,tokens:ArrayList[ZsCstToken],first:i32,last:i32)i32{
    if(first<0||last<=first||last>tokens.len){return 0;}
    let colon:i32=-1;let i:i32=first;
    while(i<last){
        let tok:ZsCstToken=tokens.data[i];
        let text:[]u8=src[tok.byte_start..tok.byte_end];
        // A string token is opaque to the CST entry separator scan. Any
        // punctuation here is structural and therefore cannot be nested.
        if(@strEq(text,"{")||@strEq(text,"}")||@strEq(text,"(")||
           @strEq(text,")")||@strEq(text,"[")||@strEq(text,"]")){return 0;}
        if(tok.kind==5&&@strEq(text,":")){
            if(colon>=0){return 0;}colon=i;
        }
        i=i+1;
    }
    if(colon<=first||colon+1>=last){return 0;}
    return (zs_map_text_literal(src,tokens,first,colon)==1&&
        zs_map_text_literal(src,tokens,colon+1,last)==1) as i32;
}

fn zs_cst_map_text_literal_bounds(src:[]u8,tokens:ArrayList[ZsCstToken],
                                  start:i32,end:i32)ZsMapLiteralBounds{
    let bad:ZsMapLiteralBounds=ZsMapLiteralBounds{.first=-1,.last=-1,.valid=0};
    let expr:ZsExprTokenBounds=zs_cst_expr_token_bounds(src,tokens,start,end);
    if(expr.valid==0||expr.last-expr.first<2){return bad;}
    let expr_last:i32=expr.last;
    let tail:ZsCstToken=tokens.data[expr_last-1];
    if(@strEq(src[tail.byte_start..tail.byte_end],";")){expr_last=expr_last-1;}
    if(expr_last-expr.first<2){return bad;}
    let open:ZsCstToken=tokens.data[expr.first];
    let close:ZsCstToken=tokens.data[expr_last-1];
    if(!@strEq(src[open.byte_start..open.byte_end],"{")||
       !@strEq(src[close.byte_start..close.byte_end],"}")){return bad;}
    let first:i32=expr.first+1;let last:i32=expr_last-1;
    if(first>=last){return bad;}
    let segment:i32=first;let i:i32=first;
    while(i<last){
        let tok:ZsCstToken=tokens.data[i];
        let text:[]u8=src[tok.byte_start..tok.byte_end];
        if(tok.kind==5&&@strEq(text,",")){
            if(i==segment||zs_map_entry_text(src,tokens,segment,i)==0){return bad;}
            segment=i+1;
        }
        i=i+1;
    }
    if(segment>=last||zs_map_entry_text(src,tokens,segment,last)==0){return bad;}
    return ZsMapLiteralBounds{.first=expr.first,.last=expr_last,.valid=1};
}

// Return valid bounds only for `{ i32: i32, ... }`. A balanced brace pair
// with malformed contents still gets a non-valid envelope from the caller so
// the normalizer can issue a focused Script diagnostic instead of selecting
// strict mode and producing an unrelated struct/block error.
fn zs_cst_map_literal_bounds(src:[]u8,tokens:ArrayList[ZsCstToken],
                             start:i32,end:i32)ZsMapLiteralBounds{
    let bad:ZsMapLiteralBounds=ZsMapLiteralBounds{.first=-1,.last=-1,.valid=0};
    let expr:ZsExprTokenBounds=zs_cst_expr_token_bounds(src,tokens,start,end);
    if(expr.valid==0||expr.last-expr.first<2){return bad;}
    let expr_last:i32=expr.last;
    let tail:ZsCstToken=tokens.data[expr_last-1];
    if(@strEq(src[tail.byte_start..tail.byte_end],";")){expr_last=expr_last-1;}
    if(expr_last-expr.first<2){return bad;}
    let open:ZsCstToken=tokens.data[expr.first];
    let close:ZsCstToken=tokens.data[expr_last-1];
    if(!@strEq(src[open.byte_start..open.byte_end],"{")||
       !@strEq(src[close.byte_start..close.byte_end],"}")){return bad;}
    let first:i32=expr.first+1;let last:i32=expr_last-1;
    if(first>=last){return bad;}
    let segment:i32=first;let i:i32=first;
    while(i<last){
        let tok:ZsCstToken=tokens.data[i];let text:[]u8=src[tok.byte_start..tok.byte_end];
        if(tok.kind==5&&@strEq(text,",")){
            if(i==segment||zs_map_entry_i32(src,tokens,segment,i)==0){return bad;}
            segment=i+1;
        }
        i=i+1;
    }
    if(segment>=last||zs_map_entry_i32(src,tokens,segment,last)==0){return bad;}
    return ZsMapLiteralBounds{.first=expr.first,.last=expr_last,.valid=1};
}

// A brace pair in an assignment RHS is a Script map-literal candidate even
// when its contents are malformed. This lets the normalizer remain in the
// Script profile long enough to report the bounded map diagnostic. Only the
// shared CST token interval decides whether the pair is the complete RHS.
fn zs_cst_assignment_brace_rhs(src:[]u8,node:ZsCstLine,
                               tokens:ArrayList[ZsCstToken],base:i32,limit:i32)i32{
    let assignment:ZsAssignmentBounds=zs_assignment_bounds_cst(src,node,tokens,base,limit);
    if(assignment.valid==0){return 0;}
    let start:i32=base+assignment.rhs_start;
    let expr:ZsExprTokenBounds=zs_cst_expr_token_bounds(src,tokens,start,limit);
    if(expr.valid==0){return 0;}
    let expr_last:i32=expr.last;
    let tail:ZsCstToken=tokens.data[expr_last-1];
    if(@strEq(src[tail.byte_start..tail.byte_end],";")){expr_last=expr_last-1;}
    if(expr_last<=expr.first){return 0;}
    let open:ZsCstToken=tokens.data[expr.first];
    let close:ZsCstToken=tokens.data[expr_last-1];
    return (@strEq(src[open.byte_start..open.byte_end],"{")&&
        @strEq(src[close.byte_start..close.byte_end],"}")) as i32;
}

// Find a complete brace envelope for a simple assignment whose opening brace
// is on the supplied physical line. This is deliberately only an envelope
// finder; homogeneous-entry validation remains in zs_cst_map_literal_bounds
// and zs_cst_map_text_literal_bounds. Extra statements after the closing
// brace are rejected so a multiline map can only own its physical statement.
// Return the first statement byte after a same-line `script;` marker.  The
// marker is a declaration, not part of the assignment grammar; keeping this
// boundary token-derived lets the strict map projector handle compact
// one-line `.zs` diagnostics without a second scanner.
fn zs_cst_script_body_start(src:[]u8,node:ZsCstLine,
                            tokens:ArrayList[ZsCstToken])i32{
    if(node.token_end-node.token_start>=2){
        let first:ZsCstToken=tokens.data[node.token_start];
        let second:ZsCstToken=tokens.data[node.token_start+1];
        if(@strEq(src[first.byte_start..first.byte_end],"script")&&
           @strEq(src[second.byte_start..second.byte_end],";")){
            return second.byte_end;
        }
    }
    return node.content_start;
}

fn zs_cst_map_assignment_envelope(src:[]u8,cst:ZsCst,tokens:ArrayList[ZsCstToken],
                                  node:ZsCstLine)ZsMapAssignmentEnvelope{
    let bad:ZsMapAssignmentEnvelope=ZsMapAssignmentEnvelope{.first=-1,.last=-1,
        .close_line=-1,.trailing=0,.valid=0};
    if(node.token_end<=node.token_start||node.content_end<=node.content_start){return bad;}
    let body_start:i32=zs_cst_script_body_start(src,node,tokens);
    let assignment:ZsAssignmentBounds=zs_assignment_bounds_cst(src,node,tokens,
        body_start,node.content_end);
    if(assignment.valid==0){return bad;}
    let rhs_abs:i32=body_start+assignment.rhs_start;
    let first:i32=-1;let i0:i32=node.token_start;let i:i32=i0;
    while(i<node.token_end&&i<tokens.len){
        let tok:ZsCstToken=tokens.data[i];
        if(tok.byte_start>=rhs_abs){first=i;break;}
        i=i+1;
    }
    if(first<0||!@strEq(src[tokens.data[first].byte_start..tokens.data[first].byte_end],"{")){return bad;}
    let depth:i32=0;let close:i32=-1;let j:i32=first;
    while(j<tokens.len){
        let tok:ZsCstToken=tokens.data[j];
        let text:[]u8=src[tok.byte_start..tok.byte_end];
        if(@strEq(text,"{")){depth=depth+1;}
        else if(@strEq(text,"}")){
            depth=depth-1;
            if(depth==0){close=j;break;}
            if(depth<0){return bad;}
        }
        j=j+1;
    }
    if(close<0){return bad;}
    // A map rewrite is statement-scoped. Record extra same-line statements so
    // malformed compact sources receive the focused map diagnostic rather
    // than falling through to native `{`/`:` unknown-identifier errors.
    let trailing:i32=0;
    let k:i32=close+1;
    while(k<tokens.len&&tokens.data[k].line==tokens.data[close].line){
        let tail:[]u8=src[tokens.data[k].byte_start..tokens.data[k].byte_end];
        if(!@strEq(tail,";")){trailing=1;}
        k=k+1;
    }
    let close_line:i32=-1;let li:i32=0;
    while(li<cst.lines.len){
        let line:ZsCstLine=cst.lines.data[li];
        if(close>=line.token_start&&close<line.token_end){close_line=li;break;}
        li=li+1;
    }
    if(close_line<0){return bad;}
    return ZsMapAssignmentEnvelope{.first=first,.last=close+1,
        .close_line=close_line,.trailing=trailing,.valid=1};
}

// Detect a map-assignment shape at any delimiter depth.  A same-line nested
// block is outside the bounded rewrite envelope, but it still deserves the
// focused map diagnostic instead of falling through to native `{`/`:` errors.
fn zs_cst_map_assignment_candidate(src:[]u8,node:ZsCstLine,
                                   tokens:ArrayList[ZsCstToken])i32{
    let i:i32=node.token_start;
    while(i+1<node.token_end&&i+1<tokens.len){
        let here:ZsCstToken=tokens.data[i];
        let next:ZsCstToken=tokens.data[i+1];
        if(@strEq(src[here.byte_start..here.byte_end],"=")&&
           @strEq(src[next.byte_start..next.byte_end],"{")){return 1;}
        i=i+1;
    }
    return 0;
}

fn zs_has_script_map_literal_cst(src:[]u8,cst:ZsCst)i32{
    let i:i32=0;
    while(i<cst.lines.len){
        let node:ZsCstLine=cst.lines.data[i];
        // In strict-brace source, a nested physical line inherits the block
        // opener's logical owner even though it still has an exact token and
        // content interval of its own. Inspect those physical intervals so a
        // nested-only map declaration can select the bounded rewrite path.
        if(node.token_end>node.token_start&&node.content_end>node.content_start){
            let comment_at:i32=zs_script_comment_offset(src,node.content_start,node.content_end);
            let code_end:i32=node.content_end;
            if(comment_at>=0){code_end=comment_at;}
            if(zs_cst_assignment_brace_rhs(src,node,cst.tokens,
                node.content_start,code_end)==1){return 1;}
        }
        // A map literal may span delimiter-owned physical lines.  The
        // opener owns the complete shared token envelope, while each
        // continuation retains only its own physical interval.  Project the
        // owner's logical range here so profile selection remains exact and
        // does not fall through to the ordinary parser with raw `{` tokens.
        if(node.logical_owner==i&&node.logical_token_end>node.token_end&&
           node.logical_content_end>node.content_start){
            let logical:ZsCstLine=node;
            logical.token_start=node.logical_token_start;
            logical.token_end=node.logical_token_end;
            logical.content_end=node.logical_content_end;
            let logical_end:i32=zs_cst_logical_code_end(src,node,cst.tokens);
            if(logical_end>node.content_start&&
               zs_cst_assignment_brace_rhs(src,logical,cst.tokens,
                   node.content_start,logical_end)==1){return 1;}
        }
        if(zs_cst_map_assignment_envelope(src,cst,cst.tokens,node).valid==1||
           zs_cst_map_assignment_candidate(src,node,cst.tokens)==1){return 1;}
        i=i+1;
    }
    return 0;
}

// Emit an expression from the already indexed compact CST token interval.
// This is intentionally a projection into the existing token emitter, not a
// second expression grammar: the CST supplies the exact token boundaries and
// the shared lexer supplies the canonical `and`/`or` operator spelling.  The
// compact class is sufficient for the emitter's bounded distinctions; all
// other token bytes remain source slices and are passed through unchanged.
fn zs_emit_expr_cst_range(out:*ArrayList[u8],src:[]u8,
                          cst_tokens:ArrayList[ZsCstToken],start:i32,end:i32,
                          bindings:ArrayList[ZsInterpBinding])void{
    let bounds:ZsExprTokenBounds=zs_cst_expr_token_bounds(src,cst_tokens,start,end);
    if(bounds.valid==0){
        _zag_eprintln("Zag Script: expression span must align with shared CST tokens");
        _zag_exit(1);
    }
    let projected:ArrayList[Token]=make[Token](8);
    let i:i32=bounds.first;
    while(i<bounds.last){
        let ct:ZsCstToken=cst_tokens.data[i];
        let value:[]u8=src[ct.byte_start..ct.byte_end];
        let kind:Tk=Tk.Op;
        if(ct.lex_kind==tk_code(Tk.Str)){kind=Tk.Str;}
        else if(ct.lex_kind==tk_code(Tk.Ident)||
                (ct.lex_kind>=tk_code(Tk.KwFn)&&ct.lex_kind<tk_code(Tk.Lp))){kind=Tk.Ident;}
        else if(@strEq(value,"[")){kind=Tk.Lbracket;}
        else if(@strEq(value,"]")){kind=Tk.Rbracket;}
        else if(@strEq(value,"and")){value="&&";}
        else if(@strEq(value,"or")){value="||";}
        push[Token](&projected,Token{.kind=kind,.val=value,.line=ct.line,
            .col=ct.col,.byte_start=ct.byte_start,.byte_end=ct.byte_end});
        i=i+1;
    }
    zs_emit_expr_tokens(out,src,projected,0,projected.len,bindings);
    free[Token](&projected);
}

fn zs_def_bounds(line:[]u8)ZsDefBounds{
    let bad:ZsDefBounds=ZsDefBounds{.name_start=-1,.name_end=-1,.lp=-1,.rp=-1,
        .ret_start=-1,.ret_end=-1,.valid=0};
    let toks:ArrayList[Token]=lex(line);let hi:i32=toks.len;
    if(hi>0&&tk_code(toks.data[hi-1].kind)==tk_code(Tk.Eof)){hi=hi-1;}
    if(hi<4||tk_code(toks.data[0].kind)!=tk_code(Tk.Ident)||
        !@strEq(toks.data[0].val,"def")||tk_code(toks.data[1].kind)!=tk_code(Tk.Ident)||
        tk_code(toks.data[2].kind)!=tk_code(Tk.Lp)){return bad;}
    let depth:i32=0;let close_idx:i32=-1;let i:i32=2;
    while(i<hi){
        let kind:i32=tk_code(toks.data[i].kind);
        if(kind==tk_code(Tk.Lp)){depth=depth+1;}
        else if(kind==tk_code(Tk.Rp)){
            if(depth<=0){return bad;}
            depth=depth-1;if(depth==0){close_idx=i;break;}
        }
        i=i+1;
    }
    if(close_idx<0||close_idx+1>=hi||
        tk_code(toks.data[hi-1].kind)!=tk_code(Tk.Colon)){return bad;}
    let ret_start:i32=-1;let ret_end:i32=-1;
    if(close_idx+1<hi-1){
        if(close_idx+2>=hi-1||tk_code(toks.data[close_idx+1].kind)!=tk_code(Tk.Op)||
            !@strEq(toks.data[close_idx+1].val,"-")||
            tk_code(toks.data[close_idx+2].kind)!=tk_code(Tk.Op)||
            !@strEq(toks.data[close_idx+2].val,">")||close_idx+3>=hi-1){return bad;}
        ret_start=toks.data[close_idx+3].byte_start;ret_end=toks.data[hi-2].byte_end;
    }
    return ZsDefBounds{.name_start=toks.data[1].byte_start,
        .name_end=toks.data[1].byte_end,.lp=toks.data[2].byte_start,
        .rp=toks.data[close_idx].byte_start,.ret_start=ret_start,
        .ret_end=ret_end,.valid=1};
}

// CST authority for compact `def` headers.  Unlike zs_def_bounds, this helper
// consumes the token range already indexed for the source line and returns
// every declaration/parameter boundary relative to `base`.  The parameter
// body remains an ordinary source slice for the shared lexer-backed parameter
// emitter; no second raw keyword or delimiter grammar is introduced here.
fn zs_def_bounds_cst(src:[]u8,node:ZsCstLine,
                     tokens:ArrayList[ZsCstToken],base:i32,limit:i32)ZsDefBounds{
    let bad:ZsDefBounds=ZsDefBounds{.name_start=-1,.name_end=-1,.lp=-1,.rp=-1,
        .ret_start=-1,.ret_end=-1,.valid=0};
    if(base<0||limit<base||limit>src.len){return bad;}
    let first:i32=-1;let last:i32=-1;let i:i32=node.token_start;
    while(i<node.token_end&&i<tokens.len){
        let tok:ZsCstToken=tokens.data[i];
        if(tok.byte_start>=base&&tok.byte_end<=limit){
            if(first<0){first=i;}
            last=i+1;
        }else if(last>=0&&tok.byte_start>limit){break;}
        i=i+1;
    }
    if(first<0||last-first<4){return bad;}
    let def_tok:ZsCstToken=tokens.data[first];
    let name_tok:ZsCstToken=tokens.data[first+1];
    let open_tok:ZsCstToken=tokens.data[first+2];
    if(def_tok.kind!=1||name_tok.kind!=1||open_tok.kind!=5||
        !@strEq(src[def_tok.byte_start..def_tok.byte_end],"def")||
        !@strEq(src[open_tok.byte_start..open_tok.byte_end],"(")){return bad;}
    let depth:i32=0;let close_idx:i32=-1;let j:i32=first+2;
    while(j<last){
        let tok:ZsCstToken=tokens.data[j];
        let text:[]u8=src[tok.byte_start..tok.byte_end];
        if(@strEq(text,"(")){depth=depth+1;}
        else if(@strEq(text,")")){
            if(depth<=0){return bad;}
            depth=depth-1;if(depth==0){close_idx=j;break;}
        }
        j=j+1;
    }
    if(close_idx<0||close_idx+1>=last){return bad;}
    let colon_idx:i32=last-1;let colon_tok:ZsCstToken=tokens.data[colon_idx];
    if(!@strEq(src[colon_tok.byte_start..colon_tok.byte_end],":")){return bad;}
    let ret_start:i32=-1;let ret_end:i32=-1;
    if(close_idx+1<colon_idx){
        if(close_idx+3>=colon_idx){return bad;}
        let dash:ZsCstToken=tokens.data[close_idx+1];
        let arrow:ZsCstToken=tokens.data[close_idx+2];
        if(!@strEq(src[dash.byte_start..dash.byte_end],"-")||
            !@strEq(src[arrow.byte_start..arrow.byte_end],">")||
            close_idx+3>=colon_idx){return bad;}
        ret_start=tokens.data[close_idx+3].byte_start-base;
        ret_end=tokens.data[colon_idx-1].byte_end-base;
    }
    return ZsDefBounds{.name_start=name_tok.byte_start-base,
        .name_end=name_tok.byte_end-base,.lp=open_tok.byte_start-base,
        .rp=tokens.data[close_idx].byte_start-base,.ret_start=ret_start,
        .ret_end=ret_end,.valid=1};
}

fn zs_append_bounds(line:[]u8)ZsAppendBounds{
    let bad:ZsAppendBounds=ZsAppendBounds{.receiver_start=-1,.receiver_end=-1,
        .arg_start=-1,.arg_end=-1,.valid=0};
    let toks:ArrayList[Token]=lex(line);let hi:i32=toks.len;
    if(hi>0&&tk_code(toks.data[hi-1].kind)==tk_code(Tk.Eof)){hi=hi-1;}
    // Only the compact simple-receiver form is lowered here.  Nested calls
    // and strings are still part of the argument token range, so their `)` or
    // `.append(` spellings cannot terminate or trigger this recognition.
    if(hi<5||tk_code(toks.data[0].kind)!=tk_code(Tk.Ident)||
        tk_code(toks.data[1].kind)!=tk_code(Tk.Dot)||
        tk_code(toks.data[2].kind)!=tk_code(Tk.Ident)||
        !@strEq(toks.data[2].val,"append")||
        tk_code(toks.data[3].kind)!=tk_code(Tk.Lp)||
        tk_code(toks.data[hi-1].kind)!=tk_code(Tk.Rp)){return bad;}
    return ZsAppendBounds{.receiver_start=toks.data[0].byte_start,
        .receiver_end=toks.data[0].byte_end,.arg_start=toks.data[3].byte_end,
        .arg_end=toks.data[hi-1].byte_start,.valid=1};
}

// The normalizer's append convenience also consumes a CST token range.  It
// intentionally recognizes only the existing simple named-receiver form; the
// argument may contain arbitrary nested shared-parser tokens.  Returned spans
// are relative to `base`, so the statement emitter can use them directly on
// its bounded line slice.  The raw-string zs_append_bounds helper remains for
// focused tests and compatibility with callers outside the CST projection.
fn zs_append_bounds_cst(src:[]u8,node:ZsCstLine,
                        tokens:ArrayList[ZsCstToken],base:i32,limit:i32)ZsAppendBounds{
    let bad:ZsAppendBounds=ZsAppendBounds{.receiver_start=-1,.receiver_end=-1,
        .arg_start=-1,.arg_end=-1,.valid=0};
    if(base<0||limit<base||limit>src.len){return bad;}
    let first:i32=-1;let last:i32=-1;let i0:i32=node.token_start;
    let i:i32=i0;
    while(i<node.token_end&&i<tokens.len){
        let tok:ZsCstToken=tokens.data[i];
        if(tok.byte_start>=base&&tok.byte_end<=limit){
            if(first<0){first=i;}
        }
        i=i+1;
    }
    if(first<0){return bad;}
    let j:i32=first;
    while(j<node.token_end&&j<tokens.len){
        let tok:ZsCstToken=tokens.data[j];
        if(tok.byte_start>=base&&tok.byte_end<=limit){last=j+1;}
        else if(last>=0&&tok.byte_start>limit){break;}
        j=j+1;
    }
    if(last<0||last-first<5){return bad;}
    let first_tok:ZsCstToken=tokens.data[first];
    let dot_tok:ZsCstToken=tokens.data[first+1];
    let method_tok:ZsCstToken=tokens.data[first+2];
    let open_tok:ZsCstToken=tokens.data[first+3];
    let close_tok:ZsCstToken=tokens.data[last-1];
    if(first_tok.kind!=1||dot_tok.kind!=5||method_tok.kind!=1||
        !@strEq(src[method_tok.byte_start..method_tok.byte_end],"append")||
        !@strEq(src[dot_tok.byte_start..dot_tok.byte_end],".")||
        !@strEq(src[open_tok.byte_start..open_tok.byte_end],"(")||
        !@strEq(src[close_tok.byte_start..close_tok.byte_end],")")){return bad;}
    return ZsAppendBounds{.receiver_start=first_tok.byte_start-base,
        .receiver_end=first_tok.byte_end-base,.arg_start=open_tok.byte_end-base,
        .arg_end=close_tok.byte_start-base,.valid=1};
}

fn zs_emit_def_param(out:*ArrayList[u8],raw:[]u8)void{
    let a:i32=zs_trim_start(raw);let b:i32=zs_trim_end(raw);if(b<=a){return;}
    let part:[]u8=raw[a..b];let toks:ArrayList[Token]=lex(part);let hi:i32=toks.len;
    if(hi>0&&tk_code(toks.data[hi-1].kind)==tk_code(Tk.Eof)){hi=hi-1;}
    let depth:i32=0;let colon:i32=-1;let i:i32=0;
    while(i<hi){
        let kind:i32=tk_code(toks.data[i].kind);
        if(kind==tk_code(Tk.Lp)||kind==tk_code(Tk.Lbracket)||kind==tk_code(Tk.Lbrace)){depth=depth+1;}
        else if(kind==tk_code(Tk.Rp)||kind==tk_code(Tk.Rbracket)||kind==tk_code(Tk.Rbrace)){if(depth>0){depth=depth-1;}}
        else if(kind==tk_code(Tk.Colon)&&depth==0){colon=toks.data[i].byte_start;break;}
        i=i+1;
    }
    if(colon<0){zs_app(out,part);zs_app(out,":i64");return;}
    let name_end:i32=zs_trim_end(part[0..colon]);let name_start:i32=zs_trim_start(part[0..name_end]);
    let type_raw:[]u8=part[colon+1..part.len];let type_start:i32=zs_trim_start(type_raw);let type_end:i32=zs_trim_end(type_raw);
    if(name_end<=name_start||type_end<=type_start){_zag_eprintln("Zag Script: function parameters require `name` or `name: type`");_zag_exit(1);}
    zs_app(out,part[name_start..name_end]);zs_ch(out,':');zs_app(out,zs_type_name(type_raw[type_start..type_end]));
}

fn zs_emit_def_params(out:*ArrayList[u8],params:[]u8)void{
    let toks:ArrayList[Token]=lex(params);let hi:i32=toks.len;
    if(hi>0&&tk_code(toks.data[hi-1].kind)==tk_code(Tk.Eof)){hi=hi-1;}
    let segment_start:i32=0;let depth:i32=0;let count:i32=0;let i:i32=0;
    while(i<=hi){
        let at_end:i32=(i==hi) as i32;let comma:i32=0;
        if(at_end==0){let kind:i32=tk_code(toks.data[i].kind);comma=(kind==tk_code(Tk.Comma)&&depth==0) as i32;}
        if(at_end==1||comma==1){
            let segment_end:i32=params.len;if(comma==1){segment_end=toks.data[i].byte_start;}
            let a:i32=zs_trim_start(params[segment_start..segment_end]);let b:i32=zs_trim_end(params[segment_start..segment_end]);
            if(b>a){if(count>0){zs_app(out,", ");}zs_emit_def_param(out,params[segment_start+a..segment_start+b]);}
            if(b>a){count=count+1;}
            if(comma==1){segment_start=toks.data[i].byte_end;}
            i=i+1;continue;
        }
        let kind:i32=tk_code(toks.data[i].kind);
        if(kind==tk_code(Tk.Lp)||kind==tk_code(Tk.Lbracket)||kind==tk_code(Tk.Lbrace)){depth=depth+1;}
        else if(kind==tk_code(Tk.Rp)||kind==tk_code(Tk.Rbracket)||kind==tk_code(Tk.Rbrace)){if(depth>0){depth=depth-1;}}
        i=i+1;
    }
}

// Emit one parameter from a CST token interval.  The source slice preserves
// the existing spelling/trimming behavior, while the shared token range
// owns nesting, annotation-colon, and unsupported-default decisions.  A
// malformed nested type or top-level default fails before emitting it.
fn zs_emit_def_param_cst(out:*ArrayList[u8],src:[]u8,
                         tokens:ArrayList[ZsCstToken],first:i32,last:i32,
                         start_abs:i32,end_abs:i32)i32{
    if(start_abs<0||end_abs<start_abs||end_abs>src.len||first<0||last<first||last>tokens.len){return 0;}
    let depth:i32=0;let colon:i32=-1;let i0:i32=first;let i:i32=i0;
    while(i<last){
        let tok:ZsCstToken=tokens.data[i];
        if(tok.byte_start<start_abs||tok.byte_end>end_abs||tok.byte_end<=tok.byte_start){return 0;}
        let text:[]u8=src[tok.byte_start..tok.byte_end];
        if(tok.kind==5&&@strEq(text,"(")||tok.kind==5&&@strEq(text,"[")||tok.kind==5&&@strEq(text,"{")){depth=depth+1;}
        else if(tok.kind==5&&@strEq(text,")")||tok.kind==5&&@strEq(text,"]")||tok.kind==5&&@strEq(text,"}")){
            if(depth<=0){return 0;}depth=depth-1;
        }else if(tok.kind==5&&@strEq(text,":")&&depth==0){
            if(colon>=0){return 0;}colon=tok.byte_start;
        }else if(tok.kind==4&&@strEq(text,"=")&&depth==0){
            // Script function defaults are not projected by this profile;
            // reject them here instead of turning them into a malformed type.
            return 0;
        }
        i=i+1;
    }
    if(depth!=0){return 0;}
    let raw:[]u8=src[start_abs..end_abs];let a:i32=zs_trim_start(raw);let b:i32=zs_trim_end(raw);
    if(b<=a){return 1;}
    let part_start:i32=start_abs+a;let part_end:i32=start_abs+b;
    if(colon<0){zs_app(out,src[part_start..part_end]);zs_app(out,":i64");return 1;}
    if(colon<part_start||colon>=part_end){return 0;}
    let name_raw:[]u8=src[part_start..colon];let name_end:i32=zs_trim_end(name_raw);
    let name_start:i32=zs_trim_start(name_raw[0..name_end]);
    let type_raw:[]u8=src[colon+1..part_end];let type_start:i32=zs_trim_start(type_raw);let type_end:i32=zs_trim_end(type_raw);
    if(name_end<=name_start||type_end<=type_start){return 0;}
    zs_app(out,src[part_start+name_start..part_start+name_end]);zs_ch(out,':');zs_app(out,zs_type_name(type_raw[type_start..type_end]));return 1;
}

// Segment and emit parameters from the enclosing declaration's CST tokens.
// Commas inside generic/function/container types remain in one segment. Empty
// comma segments retain the old permissive behavior, while unbalanced nested
// delimiters and unsupported defaults fail closed before the shared parser.
fn zs_emit_def_params_cst(out:*ArrayList[u8],src:[]u8,node:ZsCstLine,
                          tokens:ArrayList[ZsCstToken],base:i32,bounds:ZsDefBounds)i32{
    if(base<0||base>src.len||bounds.valid==0){return 0;}
    let open_abs:i32=base+bounds.lp;let close_abs:i32=base+bounds.rp;
    let open_idx:i32=-1;let close_idx:i32=-1;let i0:i32=node.token_start;let i:i32=i0;
    while(i<node.token_end&&i<tokens.len){
        let tok:ZsCstToken=tokens.data[i];let text:[]u8=src[tok.byte_start..tok.byte_end];
        if(tok.byte_start==open_abs&&@strEq(text,"(")){open_idx=i;}
        if(tok.byte_start==close_abs&&@strEq(text,")")){close_idx=i;}
        i=i+1;
    }
    if(open_idx<0||close_idx<=open_idx||tokens.data[open_idx].byte_end>tokens.data[close_idx].byte_start){return 0;}
    let param_start:i32=tokens.data[open_idx].byte_end;let param_end:i32=tokens.data[close_idx].byte_start;
    let segment_start:i32=param_start;let segment_first:i32=open_idx+1;let depth:i32=0;let count:i32=0;let j:i32=segment_first;
    while(j<=close_idx){
        let at_end:i32=(j==close_idx) as i32;
        if(at_end==1){
            let raw:[]u8=src[segment_start..param_end];let a:i32=zs_trim_start(raw);let b:i32=zs_trim_end(raw);
            if(b>a){if(count>0){zs_app(out,", ");}if(zs_emit_def_param_cst(out,src,tokens,segment_first,close_idx,segment_start,param_end)==0){return 0;}count=count+1;}
            break;
        }
        let tok:ZsCstToken=tokens.data[j];
        if(tok.byte_start<param_start||tok.byte_end>param_end||tok.byte_end<=tok.byte_start){return 0;}
        let text:[]u8=src[tok.byte_start..tok.byte_end];
        if(tok.kind==5&&@strEq(text,"(")||tok.kind==5&&@strEq(text,"[")||tok.kind==5&&@strEq(text,"{")){depth=depth+1;}
        else if(tok.kind==5&&@strEq(text,")")||tok.kind==5&&@strEq(text,"]")||tok.kind==5&&@strEq(text,"}")){
            if(depth<=0){return 0;}depth=depth-1;
        }else if(tok.kind==5&&@strEq(text,",")&&depth==0){
            let raw:[]u8=src[segment_start..tok.byte_start];let a:i32=zs_trim_start(raw);let b:i32=zs_trim_end(raw);
            if(b>a){if(count>0){zs_app(out,", ");}if(zs_emit_def_param_cst(out,src,tokens,segment_first,j,segment_start,tok.byte_start)==0){return 0;}count=count+1;}
            segment_start=tok.byte_end;segment_first=j+1;
        }
        j=j+1;
    }
    if(depth!=0){return 0;}return 1;
}

fn zs_emit_def(out:*ArrayList[u8],line:[]u8,src:[]u8,node:ZsCstLine,
               tokens:ArrayList[ZsCstToken],base:i32,bounds:ZsDefBounds)void{
    if(bounds.valid==0){_zag_eprintln("Zag Script: function should read `def name(arguments):`");_zag_exit(1);}
    zs_app(out,"fn ");zs_app(out,line[bounds.name_start..bounds.name_end]);zs_ch(out,'(');
    if(zs_emit_def_params_cst(out,src,node,tokens,base,bounds)==0){_zag_eprintln("Zag Script: malformed nested or default function parameter");_zag_exit(1);}
    zs_ch(out,')');
    let ret:[]u8="i64";
    if(bounds.ret_start>=0){ret=zs_type_name(line[bounds.ret_start..bounds.ret_end]);}
    zs_ch(out,' ');zs_app(out,ret);zs_app(out," {\n");
}

fn zs_script_marker(src:[]u8)i32{
    let i:i32=0;
    while(i<src.len){
        while(i<src.len&&(src[i]==32||src[i]==9||src[i]==10||src[i]==13)){i=i+1;}
        if(i+1<src.len&&src[i]=='/'&&src[i+1]=='/'){while(i<src.len&&src[i]!=10){i=i+1;}}
        else if(i<src.len&&src[i]=='#'){while(i<src.len&&src[i]!=10){i=i+1;}}
        else{if(i+7<=src.len&&@strEq(src[i..i+7],"script;")){return 1;}return 0;}
    }
    return 0;
}

fn zs_has_canonical_brace(src:[]u8)i32{
    // Match the shared lexer’s trivia/literal boundary closely enough that a
    // brace in a comment or character/string literal cannot switch a Script
    // source into strict-brace parsing. This detector only decides the outer
    // profile; the CST lexer remains authoritative for tokens and spans.
    let quote:u8=0;let escaped:i32=0;let i:i32=0;
    while(i<src.len){
        let c:u8=src[i];
        if(quote!=0){
            if(escaped==1){escaped=0;}
            else if(c==92){escaped=1;}
            else if(c==quote){quote=0;}
            i=i+1;
        }else if(c==34||c==39){quote=c;i=i+1;
        }else if(c==35){while(i<src.len&&src[i]!=10){i=i+1;}
        }else if(c==47&&i+1<src.len&&src[i+1]==47){while(i<src.len&&src[i]!=10){i=i+1;}
        }else if(c=='{'||c=='}'){return 1;
        }else{i=i+1;}
    }
    return 0;
}

fn zs_cst_logical_code_end(src:[]u8,node:ZsCstLine,
                           tokens:ArrayList[ZsCstToken])i32{
    if(node.logical_token_end<=node.logical_token_start){return node.logical_content_end;}
    let last:i32=node.logical_token_end-1;
    if(last<0||last>=tokens.len){return -1;}
    return tokens.data[last].byte_end;
}

fn zs_cst_layout_keyword(src:[]u8,node:ZsCstLine,
                         tokens:ArrayList[ZsCstToken])i32{
    if(node.logical_token_start<0||node.logical_token_start>=tokens.len){return 0;}
    let tok:ZsCstToken=tokens.data[node.logical_token_start];
    let word:[]u8=src[tok.byte_start..tok.byte_end];
    return (@strEq(word,"if")||@strEq(word,"elif")||@strEq(word,"else")||
        @strEq(word,"while")||@strEq(word,"for")||@strEq(word,"def")) as i32;
}

fn zs_emit_statement(out:*ArrayList[u8],line:[]u8,names:*ArrayList[[]u8],
                     bindings:*ArrayList[ZsInterpBinding],assignment_bounds:ZsAssignmentBounds,
                     append_hint:ZsAppendBounds,cst_expr_kind:i32,src:[]u8,
                     cst_tokens:ArrayList[ZsCstToken],expr_base:i32,
                     logical_end_abs:i32)void{
    // Python-shaped list construction is a Script prelude call. Indexing
    // remains native parser syntax and is not rewritten.
    let text:[]u8=line;
    // Keep loop control as canonical statements instead of sending the
    // keywords through expression lowering.  The shared parser remains the
    // authority for loop-context diagnostics; this branch only removes the
    // indentation-shaped surface syntax.
    let statement_start:i32=zs_trim_start(text);let statement_end:i32=zs_trim_end(text);
    let statement:[]u8=text[statement_start..statement_end];
    // Assignment and append boundaries are supplied by the enclosing CST's
    // shared token range.  Do not re-lex this line and let a second scanner
    // decide where the statement grammar starts.
    let eq:i32=assignment_bounds.eq;let eq_width:i32=1;
    let annotation_colon:i32=assignment_bounds.annotation_colon;
    // Skip the assignment operator and one optional separator space.  The
    // left-hand separator belongs to the lhs slice (which is trimmed by
    // zs_emit_lhs); advancing by three would silently drop the first byte of
    // every spaced RHS (for example `let data = make[u8](16)`).
    if(eq+1<text.len&&text[eq+1]==' '){eq_width=2;}
    if(eq>0){
        let name:[]u8=text[0..eq];let binding_name:[]u8=zs_interp_lhs_name(name,annotation_colon);let name_start:i32=zs_trim_start(name);let explicit_let:i32=0;if(name_start+4<=name.len&&@strEq(name[name_start..name_start+4],"let ")){explicit_let=1;}let simple:i32=1;let ni:i32=0;
        while(ni<binding_name.len){if(!zs_ident(binding_name[ni])){simple=0;}ni=ni+1;}
        let rhs:[]u8=text[eq+eq_width..text.len];
        if(simple==1&&explicit_let==0&&binding_name.len>0&&zs_name_seen(names.*,binding_name)==0){zs_app(out,"let ");push[[]u8](names,binding_name);}
        let inferred:i32=zs_interp_annotation_kind(name,annotation_colon);if(inferred==0){if(cst_expr_kind>=0){inferred=cst_expr_kind;}else{inferred=zs_interp_expr_kind(rhs,bindings.*);}}zs_interp_binding_set(bindings,binding_name,inferred);
        zs_emit_lhs(out,name,annotation_colon);zs_app(out," = ");
        let rhs_start_abs:i32=expr_base+assignment_bounds.rhs_start;
        let rhs_end_abs:i32=logical_end_abs;
        let rhs_bounds:ZsExprTokenBounds=zs_cst_expr_token_bounds(src,cst_tokens,
            rhs_start_abs,rhs_end_abs);
        let rhs_is_list:i32=0;
        let rhs_is_map_candidate:i32=0;
        if(rhs_bounds.valid==1){
            let first:ZsCstToken=cst_tokens.data[rhs_bounds.first];
            let rhs_last:i32=rhs_bounds.last;
            let tail:ZsCstToken=cst_tokens.data[rhs_last-1];
            if(@strEq(src[tail.byte_start..tail.byte_end],";")){rhs_last=rhs_last-1;}
            if(rhs_last>rhs_bounds.first){
                let last:ZsCstToken=cst_tokens.data[rhs_last-1];
                rhs_is_list=(@strEq(src[first.byte_start..first.byte_end],"[")&&
                    @strEq(src[last.byte_start..last.byte_end],"]")) as i32;
                rhs_is_map_candidate=(@strEq(src[first.byte_start..first.byte_end],"{")&&
                    @strEq(src[last.byte_start..last.byte_end],"}")) as i32;
            }
        }
        if(rhs_is_map_candidate==1){
            let map_bounds:ZsMapLiteralBounds=zs_cst_map_literal_bounds(src,cst_tokens,
                rhs_start_abs,rhs_end_abs);
            if(annotation_colon>=0||simple==0||binding_name.len==0){
                _zag_eprintln("Zag Script: map literals require a simple unannotated binding");
                _zag_exit(1);
            }
            if(map_bounds.valid==1){
                // The runtime already owns bounded construction and growth.
                // The literal is projected as ordinary Script calls so parser
                // binding, ownership, allocation accounting, and diagnostics
                // remain shared.
                zs_app(out,"map();\n");
                let segment_start:i32=map_bounds.first+1;
                let segment:i32=segment_start;let i:i32=segment_start;
                while(i<=map_bounds.last-1){
                    let at_end:i32=(i==map_bounds.last-1) as i32;
                    let tok:ZsCstToken=cst_tokens.data[i];
                    let comma:i32=(tok.kind==5&&@strEq(src[tok.byte_start..tok.byte_end],",")) as i32;
                    if(at_end==1||comma==1){
                        let entry_end:i32=i;
                        let colon:i32=-1;let j:i32=segment;
                        while(j<entry_end){
                            let ct:ZsCstToken=cst_tokens.data[j];
                            if(ct.kind==5&&@strEq(src[ct.byte_start..ct.byte_end],":")){colon=j;}
                            j=j+1;
                        }
                        if(colon<=segment||colon+1>=entry_end){
                            _zag_eprintln("Zag Script: malformed map literal entry");_zag_exit(1);
                        }
                        zs_app(out,"map_put(");zs_app(out,binding_name);zs_app(out,", ");
                        zs_emit_expr_cst_range(out,src,cst_tokens,
                            cst_tokens.data[segment].byte_start,
                            cst_tokens.data[colon-1].byte_end,bindings.*);
                        zs_app(out,", ");
                        zs_emit_expr_cst_range(out,src,cst_tokens,
                            cst_tokens.data[colon+1].byte_start,
                            cst_tokens.data[entry_end-1].byte_end,bindings.*);
                        zs_app(out,");\n");
                        if(at_end==1){break;}
                        segment=i+1;
                    }
                    i=i+1;
                }
                return;
            }
            let text_bounds:ZsMapLiteralBounds=zs_cst_map_text_literal_bounds(src,cst_tokens,
                rhs_start_abs,rhs_end_abs);
            if(text_bounds.valid==1){
                zs_app(out,"text_map();\n");
                let segment_start:i32=text_bounds.first+1;
                let segment:i32=segment_start;let i:i32=segment_start;
                while(i<=text_bounds.last-1){
                    let at_end:i32=(i==text_bounds.last-1) as i32;
                    let tok:ZsCstToken=cst_tokens.data[i];
                    let comma:i32=(tok.kind==5&&@strEq(src[tok.byte_start..tok.byte_end],",")) as i32;
                    if(at_end==1||comma==1){
                        let entry_end:i32=i;
                        let colon:i32=-1;let j:i32=segment;
                        while(j<entry_end){
                            let ct:ZsCstToken=cst_tokens.data[j];
                            if(ct.kind==5&&@strEq(src[ct.byte_start..ct.byte_end],":")){colon=j;}
                            j=j+1;
                        }
                        if(colon<=segment||colon+1>=entry_end){
                            _zag_eprintln("Zag Script: malformed text map literal entry");_zag_exit(1);
                        }
                        zs_app(out,"text_map_put(");zs_app(out,binding_name);zs_app(out,", ");
                        zs_emit_expr_cst_range(out,src,cst_tokens,
                            cst_tokens.data[segment].byte_start,
                            cst_tokens.data[colon-1].byte_end,bindings.*);
                        zs_app(out,", ");
                        zs_emit_expr_cst_range(out,src,cst_tokens,
                            cst_tokens.data[colon+1].byte_start,
                            cst_tokens.data[entry_end-1].byte_end,bindings.*);
                        zs_app(out,");\n");
                        if(at_end==1){break;}
                        segment=i+1;
                    }
                    i=i+1;
                }
                return;
            }
            _zag_eprintln("Zag Script: map literal requires one or more homogeneous literal entries without a trailing comma");
            _zag_exit(1);
        }else if(rhs_is_list==1){
            zs_app(out,"list(");
            let first:ZsCstToken=cst_tokens.data[rhs_bounds.first];
            let last:ZsCstToken=cst_tokens.data[rhs_bounds.last-1];
            let inner_end:i32=last.byte_start;
            let inner_bounds:ZsExprTokenBounds=zs_cst_expr_token_bounds(src,cst_tokens,
                first.byte_end,inner_end);
            if(inner_bounds.valid==1){
                let inner_last:ZsCstToken=cst_tokens.data[inner_bounds.last-1];
                if(@strEq(src[inner_last.byte_start..inner_last.byte_end],",")){
                    inner_end=inner_last.byte_start;
                }
                if(inner_end>first.byte_end){
                    zs_emit_expr_cst_range(out,src,cst_tokens,
                        first.byte_end,inner_end,bindings.*);
                }
            }
            zs_ch(out,')');
        }else{
            zs_emit_expr_cst_range(out,src,cst_tokens,rhs_start_abs,rhs_end_abs,bindings.*);
        }
    }else{
        // `values.append(x)` lowers to the already bounded typed Script list
        // operation. Only a simple named receiver is accepted in this first
        // deterministic slice.
        let append:ZsAppendBounds=append_hint;
        if(append.valid==1){zs_app(out,"append(");zs_app(out,text[append.receiver_start..append.receiver_end]);zs_app(out,", ");
            zs_emit_expr_cst_range(out,src,cst_tokens,expr_base+append.arg_start,
                expr_base+append.arg_end,bindings.*);zs_ch(out,')');}
        else if(@strEq(text,"pass")){zs_ch(out,'0');}
        else if(@strEq(statement,"break")){zs_app(out,"break");}
        else if(@strEq(statement,"continue")){zs_app(out,"continue");}
        else{zs_emit_expr_cst_range(out,src,cst_tokens,expr_base+statement_start,
            logical_end_abs,bindings.*);}
    }
    if(!zs_ends(text,";")){zs_ch(out,';');}
    zs_ch(out,10);
}

// The profile marker is a declaration, but compact Script may place the first
// executable statement on the same physical line (`script; return 0;`).  Keep
// the marker as its own parser line, then send the remainder through the same
// statement emitter used for subsequent lines.  This avoids a second grammar
// while preserving the compact source's source-span envelope.
fn zs_emit_script_line(out:*ArrayList[u8],line:[]u8,names:*ArrayList[[]u8],
                       bindings:*ArrayList[ZsInterpBinding],src:[]u8,
                       node:ZsCstLine,tokens:ArrayList[ZsCstToken])void{
    zs_app(out,"script;\n");
    let start:i32=7;while(start<line.len&&zs_space(line[start])){start=start+1;}
    if(start<line.len){
        let base:i32=node.content_start+start;
        let assignment:ZsAssignmentBounds=zs_assignment_bounds_cst(src,node,tokens,base,node.content_end);
        let append:ZsAppendBounds=zs_append_bounds_cst(src,node,tokens,base,node.content_end);
        let expr_kind:i32=zs_interp_expr_kind_cst(src,node,tokens,base,node.content_end,assignment,bindings.*);
        zs_emit_statement(out,line[start..line.len],names,bindings,assignment,append,expr_kind,
            src,tokens,base,node.content_end);
    }
}

// Strict-brace Script is already ordinary compilable Zag apart from the
// bounded map-literal sugar. Rewrite map assignments that own their physical
// statement and preserve every other line byte-for-byte. A map declaration may
// therefore sit on its own line inside a strict block without routing that
// block through the indentation normalizer. The shared CST still owns
// assignment, brace, entry, and source-origin boundaries, including a
// multiline map's physical envelope.
fn zs_normalize_strict_map_literals(src:[]u8,cst:ZsCst)ZsNormalized{
    let out:ArrayList[u8]=make[u8](src.len+64);
    let origins:ArrayList[ZsOriginSegment]=make[ZsOriginSegment](16);
    let names:ArrayList[[]u8]=make[[]u8](16);
    let bindings:ArrayList[ZsInterpBinding]=make[ZsInterpBinding](16);
    let ci:i32=0;let consumed_until:i32=-1;
    while(ci<cst.lines.len){
        let node:ZsCstLine=cst.lines.data[ci];
        let generated_start:i32=out.len;
        let rewritten:i32=0;
        let source_end:i32=node.raw_end;
        // Continuation lines belonging to a map envelope were consumed by
        // the opener's projection. Other strict-brace continuation lines
        // still need their exact physical bytes copied below.
        if(ci<=consumed_until){ci=ci+1;}
        else{
        // Strict block braces make their interior lines logical continuations
        // of the opening line, but each physical line still owns an exact CST
        // token interval. Inspect that interval directly so a standalone map
        // declaration inside the block is rewritten without treating the
        // surrounding block as an indentation expression.
        if(node.token_end>node.token_start&&node.content_end>node.content_start){
            let envelope:ZsMapAssignmentEnvelope=zs_cst_map_assignment_envelope(
                src,cst,cst.tokens,node);
            let map_candidate:i32=zs_cst_map_assignment_candidate(src,node,cst.tokens);
            let body_start:i32=zs_cst_script_body_start(src,node,cst.tokens);
            let projected:ZsCstLine=node;let code_end:i32=node.content_end;
            if(envelope.valid==1){
                projected.token_start=node.token_start;
                projected.token_end=envelope.last;
                code_end=cst.tokens.data[envelope.last-1].byte_end;
            }else{
                let comment_at:i32=zs_script_comment_offset(src,node.content_start,node.content_end);
                if(comment_at>=0){code_end=comment_at;}
            }
            if(zs_cst_assignment_brace_rhs(src,projected,cst.tokens,
                body_start,code_end)==1){
                if(envelope.trailing==1){
                    _zag_eprintln("Zag Script: map literal requires one or more homogeneous literal entries without a trailing comma");
                    _zag_exit(1);
                }
                // Keep a same-line `script;` declaration on its own parser
                // line before projecting the bounded map assignment.
                if(body_start>node.content_start){
                    zs_app(&out,src[node.content_start..body_start]);
                    zs_ch(&out,10);
                }
                let line:[]u8=src[body_start..code_end];
                let assignment:ZsAssignmentBounds=zs_assignment_bounds_cst(src,projected,
                    cst.tokens,body_start,code_end);
                let append:ZsAppendBounds=zs_append_bounds_cst(src,projected,cst.tokens,
                    body_start,code_end);
                let expr_kind:i32=zs_interp_expr_kind_cst(src,projected,cst.tokens,
                    body_start,code_end,assignment,bindings);
                zs_emit_statement(&out,line,&names,&bindings,assignment,append,expr_kind,
                    src,cst.tokens,body_start,code_end);
                rewritten=1;
                if(envelope.valid==1&&envelope.close_line>ci){
                    consumed_until=envelope.close_line;
                    source_end=cst.lines.data[envelope.close_line].raw_end;
                }
            }else if(map_candidate==1){
                _zag_eprintln("Zag Script: map literal requires one or more homogeneous literal entries without a trailing comma");
                _zag_exit(1);
            }
        }
        if(rewritten==0&&node.raw_end>node.raw_start){
            zs_app(&out,src[node.raw_start..node.raw_end]);
        }
        if(out.len>generated_start){
            push[ZsOriginSegment](&origins,ZsOriginSegment{
                .generated_start=generated_start,.generated_end=out.len,
                .source_start=node.raw_start,.source_end=source_end,
                .origin_id=node.origin_id,.exact=(rewritten==0) as i32,
            });
        }
        ci=ci+1;
        }
    }
    return ZsNormalized{.source=out.data[0..out.len],.cst=cst,.origins=origins};
}

fn script_syntax_normalize_with_origins(src:[]u8)ZsNormalized{
    let cst:ZsCst=script_syntax_cst(src);
    // Interpolation-brace recovery is a Script lexical diagnostic, not an
    // indentation failure.  Report it before the shared CST validity guard
    // so malformed one-line forms such as `script; println("{name")` retain
    // the focused message promised by the CLI negative contract.
    if(zs_script_marker(src)==1){
        let recovery_i:i32=0;
        while(recovery_i<cst.recoveries.len){
            if(cst.recoveries.data[recovery_i].kind==13){
                _zag_eprintln("Zag Script interpolation: malformed string interpolation brace");
                _zag_exit(1);
            }
            recovery_i=recovery_i+1;
        }
    }
    if(zs_script_marker(src)==1&&script_syntax_cst_valid(cst)==0){
        _zag_eprintln("Zag Script: inconsistent indentation layout");_zag_exit(1);
    }
    let origins:ArrayList[ZsOriginSegment]=make[ZsOriginSegment](16);
    // A balanced assignment-RHS brace pair is the one compact Script map
    // literal exception to strict-brace selection. All other canonical brace
    // sources remain byte-exact strict Zag; malformed map entries stay in the
    // Script projector long enough to receive a focused diagnostic.
    let has_script_map_brace:i32=zs_has_script_map_literal_cst(src,cst);
    if(zs_script_marker(src)==0||
       (zs_has_canonical_brace(src)==1&&has_script_map_brace==0)){
        if(src.len>0){push[ZsOriginSegment](&origins,ZsOriginSegment{.generated_start=0,.generated_end=src.len,.source_start=0,.source_end=src.len,.origin_id=zs_origin_id(src,0,src.len,1),.exact=1});}
        return ZsNormalized{.source=src,.cst=cst,.origins=origins};
    }
    if(zs_has_canonical_brace(src)==1&&has_script_map_brace==1){
        return zs_normalize_strict_map_literals(src,cst);
    }
    let out:ArrayList[u8]=make[u8](src.len+64);
    let blocks:ArrayList[i32]=make[i32](8);
    let names:ArrayList[[]u8]=make[[]u8](16);
    let bindings:ArrayList[ZsInterpBinding]=make[ZsInterpBinding](16);
    let need_indent:i32=-1;let ci:i32=0;let last_origin:i64=0;let last_source_start:i32=0;let last_source_end:i32=0;
    let layout_i:i32=0;
    while(ci<cst.lines.len){
            let node:ZsCstLine=cst.lines.data[ci];
            // Continuation physical lines are already owned by their logical
            // opener. Emit the projected statement once, then skip the
            // continuation nodes so their indentation/comments cannot become
            // separate statements or duplicate origin segments.
            if(node.logical_owner!=ci){ci=ci+1;continue;}
            let logical_multiline:i32=(node.logical_token_end>node.token_end) as i32;
            let projected_node:ZsCstLine=node;
            let logical_end_abs:i32=node.content_end;
            if(logical_multiline==1){
                projected_node.token_start=node.logical_token_start;
                projected_node.token_end=node.logical_token_end;
                projected_node.content_end=node.logical_content_end;
                projected_node.raw_end=node.logical_raw_end;
                logical_end_abs=zs_cst_logical_code_end(src,node,cst.tokens);
                if(logical_end_abs<=node.content_start){
                    _zag_eprintln("Zag Script: empty multiline expression");
                    _zag_exit(1);
                }
            }
            let generated_start:i32=out.len;
            let raw:[]u8=src[node.raw_start..node.content_end];let ts:i32=node.content_start-node.raw_start;let te:i32=raw.len;
            last_origin=node.origin_id;last_source_start=node.raw_start;
            last_source_end=node.raw_end;
            if(logical_multiline==1){last_source_end=node.logical_raw_end;}
            if(te>ts){
                let indent:i32=node.indent;
                let comment_at:i32=-1;
                if(logical_multiline==0){comment_at=zs_script_comment_offset(src,node.content_start,node.content_end);}
                let code_end:i32=logical_end_abs;
                if(comment_at>=0){code_end=comment_at;}
                let line:[]u8=src[node.content_start..code_end];
                let full_comment:i32=(comment_at==node.content_start) as i32;
                // A same-level `else`/`elif` continues the open `if`; defer
                // CST dedent closures until the continuation logic below.
                let continuation_line:i32=((node.header_kind==3||node.header_kind==4) as i32);
                while(layout_i<cst.layouts.len&&cst.layouts.data[layout_i].byte_offset<=node.content_start){
                    let layout:ZsCstLayout=cst.layouts.data[layout_i];
                    if((layout.kind==2||layout.kind==3)&&continuation_line==0){
                        if(blocks.len>0){zs_app(&out,"}\n");blocks.len=blocks.len-1;}
                    }
                    layout_i=layout_i+1;
                }
                if(full_comment==1){
                    let comment_line:[]u8=src[node.content_start..node.content_end];
                    if(comment_line.len>=2&&comment_line[0]=='/'&&comment_line[1]=='/'){zs_app(&out,comment_line);}
                    else{zs_app(&out,"//");zs_app(&out,comment_line[1..comment_line.len]);}
                    zs_ch(&out,10);
                }
                else{
                if (need_indent >= 0) {
                    if (indent <= need_indent) { _zag_eprintln("Zag Script: indent the lines belonging to the statement above"); _zag_exit(1); }
                    need_indent = -1;
                }
                    if (node.header_kind == 4 || node.header_kind == 3) {
                        // Close only the prior `if` block at the same indentation
                        // level, then emit the continuation form.
                        while (blocks.len > 0 && blocks.data[blocks.len - 1] > indent) {
                            zs_app(&out, "}\n");
                            blocks.len = blocks.len - 1;
                        }
                        if (blocks.len == 0 || blocks.data[blocks.len - 1] != indent) {
                            _zag_eprintln("Zag Script: unexpected `else`/`elif` without matching `if`");
                            _zag_exit(1);
                        }
                        zs_app(&out, "}\n");
                        blocks.len = blocks.len - 1;
                    }
                    if(node.header_kind==1){zs_emit_script_line(&out,line,&names,&bindings,
                        src,node,cst.tokens);}
                    else if(node.header_kind==2){let header_bounds:ZsHeaderBounds=zs_cst_header_bounds(src,projected_node,cst.tokens);if(header_bounds.valid==0){_zag_eprintln("Zag Script: `if` needs a condition");_zag_exit(1);}zs_app(&out,"if (");zs_emit_expr_cst_range(&out,src,cst.tokens,header_bounds.expr_start,header_bounds.expr_end,bindings);zs_app(&out,") {\n");push[i32](&blocks,indent);need_indent=indent;}
                    else if(node.header_kind==5){let header_bounds:ZsHeaderBounds=zs_cst_header_bounds(src,projected_node,cst.tokens);if(header_bounds.valid==0){_zag_eprintln("Zag Script: `while` needs a condition");_zag_exit(1);}zs_app(&out,"while (");zs_emit_expr_cst_range(&out,src,cst.tokens,header_bounds.expr_start,header_bounds.expr_end,bindings);zs_app(&out,") {\n");push[i32](&blocks,indent);need_indent=indent;}
                    else if(node.header_kind==4){zs_app(&out,"else {\n");push[i32](&blocks,indent);need_indent=indent;}
                    else if(node.header_kind==3){let header_bounds:ZsHeaderBounds=zs_cst_header_bounds(src,projected_node,cst.tokens);if(header_bounds.valid==0){_zag_eprintln("Zag Script: `elif` needs a condition");_zag_exit(1);}zs_app(&out,"else if (");zs_emit_expr_cst_range(&out,src,cst.tokens,header_bounds.expr_start,header_bounds.expr_end,bindings);zs_app(&out,") {\n");push[i32](&blocks,indent);need_indent=indent;}
                    else if(node.header_kind==6){
                        let def_bounds:ZsDefBounds=zs_def_bounds_cst(src,projected_node,cst.tokens,
                            node.content_start,code_end);
                        zs_emit_def(&out,line,src,projected_node,cst.tokens,node.content_start,def_bounds);
                        push[i32](&blocks,indent);need_indent=indent;
                    }
                    else if(node.header_kind==7){
                        let name:[]u8=zs_cst_for_name(src,projected_node,cst.tokens);
                        let for_bounds:ZsForExprBounds=zs_cst_for_expr_bounds(src,projected_node,cst.tokens);
                        if(name.len==0||for_bounds.valid==0){_zag_eprintln("Zag Script: `for` should read `for name in collection:`");_zag_exit(1);}
                        zs_app(&out,"for (");
                        if(for_bounds.is_range==1){
                            if(for_bounds.lower_start<0){zs_app(&out,"0..");}
                            else{zs_emit_expr_cst_range(&out,src,cst.tokens,
                                for_bounds.lower_start,for_bounds.lower_end,bindings);zs_app(&out,"..");}
                            zs_emit_expr_cst_range(&out,src,cst.tokens,
                                for_bounds.upper_start,for_bounds.upper_end,bindings);
                        }else{zs_emit_expr_cst_range(&out,src,cst.tokens,
                            for_bounds.collection_start,for_bounds.collection_end,bindings);}
                        zs_app(&out,") |");zs_app(&out,name);zs_app(&out,"| {\n");push[i32](&blocks,indent);need_indent=indent;
                    }else{
                        let assignment:ZsAssignmentBounds=zs_assignment_bounds_cst(src,projected_node,
                            cst.tokens,node.content_start,code_end);
                        let append:ZsAppendBounds=zs_append_bounds_cst(src,projected_node,
                            cst.tokens,node.content_start,code_end);
                        let expr_kind:i32=zs_interp_expr_kind_cst(src,projected_node,cst.tokens,
                            node.content_start,code_end,assignment,bindings);
                        zs_emit_statement(&out,line,&names,&bindings,assignment,append,expr_kind,
                            src,cst.tokens,node.content_start,code_end);
                    }
                }
            }else{zs_ch(&out,10);}
            if(out.len>generated_start){let exact:i32=0;if(logical_multiline==0&&
                out.len-generated_start==node.raw_end-node.raw_start&&
                @strEq(out.data[generated_start..out.len],src[node.raw_start..node.raw_end])){exact=1;}
                push[ZsOriginSegment](&origins,ZsOriginSegment{
                .generated_start=generated_start,.generated_end=out.len,
                .source_start=node.raw_start,.source_end=last_source_end,.origin_id=node.origin_id,
                .exact=exact,
            });}
            ci=ci+1;
    }
    if(need_indent>=0){_zag_eprintln("Zag Script: expected an indented statement before the file ended");_zag_exit(1);}
    if(blocks.len>0){let generated_start:i32=out.len;while(blocks.len>0){zs_app(&out,"}\n");blocks.len=blocks.len-1;}push[ZsOriginSegment](&origins,ZsOriginSegment{
        .generated_start=generated_start,.generated_end=out.len,.source_start=last_source_start,
        .source_end=last_source_end,.origin_id=last_origin,.exact=0,
    });}
    return ZsNormalized{.source=out.data[0..out.len],.cst=cst,.origins=origins};
}

fn script_syntax_normalize(src:[]u8)[]u8{
    return script_syntax_normalize_with_origins(src).source;
}
