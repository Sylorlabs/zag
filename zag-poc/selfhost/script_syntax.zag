// Python-shaped Zag Script source normalization.
//
// This is deliberately a source-to-source layout front-end, not a second
// expression parser or language implementation. It accepts the
// indentation-oriented Script surface, indexes the original bytes with the
// shared lexer, and emits ordinary Zag tokens for the existing parser/AST/
// sema/backend pipeline. Strict Zag is returned byte-for-byte unchanged.

@import("../std/list.zag")
@import("lex.zag")

// Lossless indentation CST.  The CST owns no rewritten text: every node is an
// exact byte range into `source`, including comments, trailing whitespace,
// CRLF/LF choice, blank lines, and a final line without a newline.  `origin_id`
// is deterministic for the same compact bytes and span; generated projections
// use it to retain a reversible link to compact source.
struct ZsCstLine {
    raw_start: i32,
    raw_end: i32,
    content_start: i32,
    content_end: i32,
    line: i32,
    indent: i32,
    kind: i32,
    origin_id: i64,
    token_start: i32,
    token_end: i32,
}
// Token spans are a lossless index over the original bytes and are classified
// by lex.zag's shared Token/Tk stream. Trivia remains owned by `source` and the
// line spans; tokenization never rewrites or drops source bytes. The
// normalizer still consumes line nodes for layout lowering, but parser
// integration uses these stable ranges without another token grammar or origin
// scheme.
struct ZsCstToken {
    kind: i32, // 1 identifier, 2 number, 3 string, 4 operator, 5 punctuation, 6 comment
    byte_start: i32,
    byte_end: i32,
    line: i32,
    col: i32,
    origin_id: i64,
}
struct ZsCstLayout {
    kind: i32, // 1 indent, 2 dedent, 3 eof-dedent
    byte_offset: i32,
    line: i32,
    indent: i32,
    origin_id: i64,
}
struct ZsCstRecovery {
    kind: i32, // 1 inconsistent dedent
    byte_start: i32,
    byte_end: i32,
    line: i32,
    message: []u8,
    origin_id: i64,
}
struct ZsCst {
    source: []u8,
    lines: ArrayList[ZsCstLine],
    tokens: ArrayList[ZsCstToken],
    layouts: ArrayList[ZsCstLayout],
    recoveries: ArrayList[ZsCstRecovery],
    valid: i32,
}
struct ZsOriginSegment {
    generated_start: i32,
    generated_end: i32,
    source_start: i32,
    source_end: i32,
    origin_id: i64,
    exact: i32, // generated bytes are byte-identical to the source range
}
struct ZsNormalized {
    source: []u8,
    cst: ZsCst,
    origins: ArrayList[ZsOriginSegment],
}

fn zs_origin_id(src:[]u8,start:i32,end:i32,line:i32)i64{
    let h:i64=17;let i:i32=start;
    while(i<end){h=(h*257+(src[i] as i64)+1)%1000000007;i=i+1;}
    h=(h*257+(start as i64)+1)%1000000007;
    h=(h*257+(end as i64)+1)%1000000007;
    return (h*257+(line as i64)+1)%1000000007;
}

fn zs_cst_kind(content:[]u8)i32{
    if(content.len==0){return 0;}
    if(content[0]=='#'){return 1;}
    if(@strEq(content,"script;")){return 2;}
    if(content[content.len-1]==':'){return 3;}
    return 4;
}

fn zs_utf8_cont(c:u8)bool{return c>=128&&c<=191;}
fn zs_invalid_source_offset(src:[]u8)i32{
    let i:i32=0;
    while(i<src.len){
        let c:u8=src[i];
        if(c==0){return i;}
        if(c<128){i=i+1;}
        else if(c>=194&&c<=223){
            if(i+1>=src.len||!zs_utf8_cont(src[i+1])){return i;}
            i=i+2;
        }else if(c>=224&&c<=239){
            if(i+2>=src.len||!zs_utf8_cont(src[i+2])||
                (c==224&&src[i+1]<160)||(c==237&&src[i+1]>=160)||
                !zs_utf8_cont(src[i+1])){return i;}
            i=i+3;
        }else if(c>=240&&c<=244){
            if(i+3>=src.len||!zs_utf8_cont(src[i+2])||
                !zs_utf8_cont(src[i+3])||(c==240&&src[i+1]<144)||
                (c==244&&src[i+1]>=144)||!zs_utf8_cont(src[i+1])){return i;}
            i=i+4;
        }else{return i;}
    }
    return -1;
}

fn zs_cst_shared_kind(k:Tk)i32{
    if(tk_code(k)==tk_code(Tk.Str)){return 3;}
    if(tk_code(k)==tk_code(Tk.Int)||tk_code(k)==tk_code(Tk.Float)){return 2;}
    if(tk_code(k)==tk_code(Tk.Op)){return 4;}
    if(tk_code(k)==tk_code(Tk.Ident)||tk_code(k)==tk_code(Tk.Annot)||
        tk_code(k)>=tk_code(Tk.KwFn)&&tk_code(k)<tk_code(Tk.Lp)){return 1;}
    return 5;
}

fn zs_cst_append_shared_tokens(src:[]u8,node:ZsCstLine,
                               shared:ArrayList[Token],shared_i:*i32,
                               tokens:*ArrayList[ZsCstToken])void{
    while(shared_i.*<shared.len){
        let tok:Token=shared.data[shared_i.*];
        if(tk_code(tok.kind)==tk_code(Tk.Eof)){shared_i.*=shared_i.*+1;continue;}
        if(tok.line<node.line){shared_i.*=shared_i.*+1;continue;}
        if(tok.line>node.line){break;}
        if(tok.byte_start>=node.content_start&&tok.byte_end<=node.content_end){
            push[ZsCstToken](tokens,ZsCstToken{.kind=zs_cst_shared_kind(tok.kind),
                .byte_start=tok.byte_start,.byte_end=tok.byte_end,.line=tok.line,
                .col=tok.col,.origin_id=zs_origin_id(src,tok.byte_start,
                tok.byte_end,tok.line)});
        }
        shared_i.*=shared_i.*+1;
    }
}

fn script_syntax_cst(src:[]u8)ZsCst{
    let out:ZsCst=ZsCst{.source=src,.lines=make[ZsCstLine](16),
        .tokens=make[ZsCstToken](32),.layouts=make[ZsCstLayout](16),
        .recoveries=make[ZsCstRecovery](4),.valid=1};
    let invalid_offset:i32=zs_invalid_source_offset(src);
    if(invalid_offset>=0){
        out.valid=0;
        push[ZsCstRecovery](&out.recoveries,ZsCstRecovery{.kind=3,
            .byte_start=invalid_offset,.byte_end=invalid_offset+1,.line=1,
            .message="invalid UTF-8 or NUL source byte",.origin_id=0});
    }
    let shared:ArrayList[Token]=make[Token](1);
    if(invalid_offset<0){shared=lex(src);}
    let shared_i:i32=0;
    let script_profile:i32=zs_script_marker(src);
    let indent_stack:ArrayList[i32]=make[i32](8);push[i32](&indent_stack,0);
    let start:i32=0;let line:i32=1;
    while(start<src.len){
        let pos:i32=start;while(pos<src.len&&src[pos]!=10){pos=pos+1;}
        let raw_end:i32=pos;if(pos<src.len){raw_end=pos+1;}
        let body:[]u8=src[start..pos];let ts:i32=zs_trim_start(body);let te:i32=zs_trim_end(body);
        // On a whitespace-only line trim_start reaches body.len while
        // trim_end reaches zero. Canonicalize both ends to the empty slice at
        // body.len instead of constructing the invalid body[len..0] range.
        if(te<ts){te=ts;}
        let content:[]u8=body[ts..te];
        let token_start:i32=out.tokens.len;
        let line_node:ZsCstLine=ZsCstLine{
            .raw_start=start,.raw_end=raw_end,.content_start=start+ts,
            .content_end=start+te,.line=line,.indent=ts,
            .kind=zs_cst_kind(content),.origin_id=zs_origin_id(src,start,raw_end,line),
            .token_start=token_start,.token_end=token_start,
        };
        zs_cst_append_shared_tokens(src,line_node,shared,&shared_i,&out.tokens);
        if(script_profile==1&&content.len>0&&zs_indent_mixed(src,start,start+ts)==1){
            out.valid=0;
            push[ZsCstRecovery](&out.recoveries,ZsCstRecovery{.kind=2,
                .byte_start=start,.byte_end=start+ts,.line=line,
                .message="mixed tabs and spaces in indentation",
                .origin_id=line_node.origin_id});
        }
        // Layout is derived from non-trivia lines only.  A comment or blank
        // line retains its exact bytes but cannot open or close a block.
        if(content.len>0&&line_node.kind!=1){
            let top:i32=indent_stack.data[indent_stack.len-1];
            if(line_node.indent>top){
                push[i32](&indent_stack,line_node.indent);
                push[ZsCstLayout](&out.layouts,ZsCstLayout{.kind=1,
                    .byte_offset=line_node.content_start,.line=line,.indent=line_node.indent,
                    .origin_id=zs_origin_id(src,line_node.content_start,
                    line_node.content_start,line)});
            }else if(line_node.indent<top){
                while(indent_stack.len>1&&line_node.indent<indent_stack.data[indent_stack.len-1]){
                    indent_stack.len=indent_stack.len-1;
                    push[ZsCstLayout](&out.layouts,ZsCstLayout{.kind=2,
                        .byte_offset=line_node.content_start,.line=line,.indent=line_node.indent,
                        .origin_id=zs_origin_id(src,line_node.content_start,
                        line_node.content_start,line)});
                }
                if(line_node.indent!=indent_stack.data[indent_stack.len-1]){
                    out.valid=0;
                    push[ZsCstRecovery](&out.recoveries,ZsCstRecovery{.kind=1,
                        .byte_start=line_node.content_start,.byte_end=line_node.content_end,
                        .line=line,.message="inconsistent indentation dedent",
                        .origin_id=line_node.origin_id});
                }
            }
        }
        push[ZsCstLine](&out.lines,ZsCstLine{.raw_start=line_node.raw_start,
            .raw_end=line_node.raw_end,.content_start=line_node.content_start,
            .content_end=line_node.content_end,.line=line_node.line,
            .indent=line_node.indent,.kind=line_node.kind,
            .origin_id=line_node.origin_id,.token_start=token_start,
            .token_end=out.tokens.len});
        start=raw_end;line=line+1;
    }
    // Preserve the normalizer's logical terminal blank line while keeping its
    // raw span empty, so CST reconstruction remains byte-exact.
    if(src.len>0&&src[src.len-1]==10){
        push[ZsCstLine](&out.lines,ZsCstLine{
            .raw_start=src.len,.raw_end=src.len,.content_start=src.len,
            .content_end=src.len,.line=line,.indent=0,.kind=0,
            .origin_id=zs_origin_id(src,src.len,src.len,line),
            .token_start=out.tokens.len,.token_end=out.tokens.len,
        });
    }
    while(indent_stack.len>1){indent_stack.len=indent_stack.len-1;
        push[ZsCstLayout](&out.layouts,ZsCstLayout{.kind=3,.byte_offset=src.len,
            .line=line,.indent=indent_stack.data[indent_stack.len-1],
            .origin_id=zs_origin_id(src,src.len,src.len,line)});
    }
    return out;
}

fn script_syntax_cst_reconstruct(cst:ZsCst)[]u8{
    let out:ArrayList[u8]=make[u8](cst.source.len+1);let i:i32=0;
    while(i<cst.lines.len){let line:ZsCstLine=cst.lines.data[i];zs_app(&out,cst.source[line.raw_start..line.raw_end]);i=i+1;}
    return out.data[0..out.len];
}

// Shared-parser boundary validation.  The CST is still not the indentation
// grammar authority, but no parser may proceed with a projection whose source
// spans, token ranges, or reconstruction are inconsistent.  This keeps the
// compact-source provenance contract fail-closed while the layout/recovery
// nodes are being promoted into the shared lexer.
fn script_syntax_cst_valid(cst:ZsCst)i32{
    let initial_recovery:i32=0;
    while(initial_recovery<cst.recoveries.len){
        if(cst.recoveries.data[initial_recovery].kind==3){return 0;}
        initial_recovery=initial_recovery+1;
    }
    // Indentation events are grammar-bearing only for Script files. Strict
    // brace-based Zag may format continuation lines at arbitrary columns.
    if(cst.valid==0&&zs_script_marker(cst.source)==1){return 0;}
    if(!@strEq(script_syntax_cst_reconstruct(cst),cst.source)){return 0;}
    let line_cursor:i32=0;let token_index_cursor:i32=0;let token_byte_cursor:i32=0;let li:i32=0;
    while(li<cst.lines.len){
        let line:ZsCstLine=cst.lines.data[li];
        if(line.raw_start<line_cursor||line.raw_end<line.raw_start||
            line.raw_end>cst.source.len||line.content_start<line.raw_start||
            line.content_end<line.content_start||line.content_end>line.raw_end||
            line.token_start!=token_index_cursor||line.token_end<line.token_start||
            line.token_end>cst.tokens.len){return 0;}
        let ti:i32=line.token_start;
        while(ti<line.token_end){
            let tok:ZsCstToken=cst.tokens.data[ti];
            if(tok.byte_start<line.content_start||tok.byte_end<=tok.byte_start||
                tok.byte_end>line.content_end||tok.byte_start<token_byte_cursor||
                tok.line!=line.line||tok.origin_id<0){return 0;}
            token_byte_cursor=tok.byte_end;ti=ti+1;
        }
        // Trivia between tokens is intentionally allowed; the enclosing line
        // span remains the lossless owner of those bytes.
        token_index_cursor=line.token_end;line_cursor=line.raw_end;li=li+1;
    }
    if(line_cursor>cst.source.len||token_index_cursor!=cst.tokens.len){return 0;}
    let ti:i32=0;while(ti<cst.tokens.len){let tok:ZsCstToken=cst.tokens.data[ti];
        if(tok.byte_start<0||tok.byte_end>cst.source.len){return 0;}ti=ti+1;}
    let layout_cursor:i32=-1;let li2:i32=0;
    while(li2<cst.layouts.len){let event:ZsCstLayout=cst.layouts.data[li2];
        if(event.byte_offset<0||event.byte_offset>cst.source.len||event.line<1||
            event.indent<0||event.origin_id<0||
            (layout_cursor>event.byte_offset&&event.kind!=3)){return 0;}
        layout_cursor=event.byte_offset;li2=li2+1;
    }
    let ri:i32=0;
    while(ri<cst.recoveries.len){
        let recovery:ZsCstRecovery=cst.recoveries.data[ri];
        if((recovery.kind!=1&&recovery.kind!=2)||recovery.byte_start<0||
            recovery.byte_end<recovery.byte_start||recovery.byte_end>cst.source.len||
            recovery.line<1||recovery.origin_id<0||recovery.message.len==0){return 0;}
        ri=ri+1;
    }
    return 1;
}

fn zs_app(out:*ArrayList[u8],s:[]u8)void{let i:i32=0;while(i<s.len){push[u8](out,s[i]);i=i+1;}}
fn zs_ch(out:*ArrayList[u8],c:i32)void{push[u8](out,c as u8);}
fn zs_space(c:u8)bool{return c==32||c==9||c==13;}
fn zs_trim_start(s:[]u8)i32{let i:i32=0;while(i<s.len&&zs_space(s[i])){i=i+1;}return i;}
fn zs_trim_end(s:[]u8)i32{let i:i32=s.len;while(i>0&&zs_space(s[i-1])){i=i-1;}return i;}
fn zs_indent_mixed(src:[]u8,start:i32,end:i32)i32{
    let saw_space:i32=0;let saw_tab:i32=0;let i:i32=start;
    while(i<end){if(src[i]==32){saw_space=1;}else if(src[i]==9){saw_tab=1;}i=i+1;}
    return (saw_space==1&&saw_tab==1) as i32;
}
fn zs_starts(s:[]u8,p:[]u8)bool{if(s.len<p.len){return false;}return @strEq(s[0..p.len],p);}
fn zs_ends(s:[]u8,p:[]u8)bool{if(s.len<p.len){return false;}return @strEq(s[s.len-p.len..s.len],p);}
fn zs_ident(c:u8)bool{return(c>='a'&&c<='z')||(c>='A'&&c<='Z')||(c>='0'&&c<='9')||c=='_';}
fn zs_name_seen(names:ArrayList[[]u8],name:[]u8)i32{let i:i32=0;while(i<names.len){if(@strEq(names.data[i],name)){return 1;}i=i+1;}return 0;}
fn zs_find(s:[]u8,needle:[]u8)i32{if(needle.len==0){return 0;}let i:i32=0;while(i+needle.len<=s.len){if(@strEq(s[i..i+needle.len],needle)){return i;}i=i+1;}return -1;}
fn zs_type_name(name:[]u8)[]u8{if(@strEq(name,"int")){return "i64";}if(@strEq(name,"float")){return "f64";}if(@strEq(name,"str")){return "[]u8";}if(@strEq(name,"bool")){return "bool";}if(@strEq(name,"None")){return "void";}return name;}
fn zs_emit_expr(out:*ArrayList[u8],s:[]u8)void{
    let quoted:i32=0;let escaped:i32=0;let i:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if(quoted==1){zs_ch(out,c);if(escaped==1){escaped=0;}else if(c==92){escaped=1;}else if(c==34){quoted=0;}i=i+1;}
        else if(c==34){quoted=1;zs_ch(out,c);i=i+1;}
        else if((c>='a'&&c<='z')||(c>='A'&&c<='Z')||c=='_'){
            let start:i32=i;i=i+1;while(i<s.len&&zs_ident(s[i])){i=i+1;}let word:[]u8=s[start..i];
            // `make[T]` is canonical Zag generic application, not beginner
            // collection indexing. Keep it intact so allocation accounting and
            // strict diagnostics see the real allocator call.
            if(i<s.len&&s[i]=='['&&!@strEq(word,"make")){
                let close:i32=i+1;let depth:i32=1;let q:i32=0;let esc:i32=0;
                while(close<s.len&&depth>0){let cc:u8=s[close];if(q==1){if(esc==1){esc=0;}else if(cc==92){esc=1;}else if(cc==34){q=0;}}else if(cc==34){q=1;}else if(cc=='['){depth=depth+1;}else if(cc==']'){depth=depth-1;}close=close+1;}
                if(depth!=0){_zag_eprintln("Zag Script: list index is missing `]`");_zag_exit(1);}
                zs_app(out,"item_at(");zs_app(out,word);zs_app(out,", ");zs_emit_expr(out,s[i+1..close-1]);zs_ch(out,')');i=close;
            }
            else if(@strEq(word,"True")){zs_app(out,"true");}
            else if(@strEq(word,"False")){zs_app(out,"false");}
            else if(@strEq(word,"None")){zs_app(out,"null");}
            else if(@strEq(word,"not")){zs_ch(out,'!');}
            else if(@strEq(word,"print")){zs_app(out,"println");}
            else{zs_app(out,word);}
        }else{zs_ch(out,c);i=i+1;}
    }
}

fn zs_emit_def(out:*ArrayList[u8],line:[]u8)void{
    let lp:i32=zs_find(line,"(");let rp:i32=zs_find(line,")");
    if(lp<=4||rp<=lp||!zs_ends(line,":")){_zag_eprintln("Zag Script: function should read `def name(arguments):`");_zag_exit(1);}
    zs_app(out,"fn ");zs_app(out,line[4..lp]);zs_ch(out,'(');
    let params:[]u8=line[lp+1..rp];let start:i32=0;let i:i32=0;let count:i32=0;
    while(i<=params.len){if(i==params.len||params[i]==','){let raw:[]u8=params[start..i];let a:i32=zs_trim_start(raw);let b:i32=zs_trim_end(raw);if(b>a){if(count>0){zs_app(out,", ");}let p:[]u8=raw[a..b];let colon:i32=zs_find(p,":");if(colon>0){let ta:i32=zs_trim_start(p[colon+1..p.len]);let typed:[]u8=p[colon+1+ta..p.len];zs_app(out,p[0..colon]);zs_ch(out,':');zs_app(out,zs_type_name(typed));}else{zs_app(out,p);zs_app(out,":i64");}count=count+1;}start=i+1;}i=i+1;}
    zs_ch(out,')');
    let ret:[]u8="i64";let arrow:i32=zs_find(line," -> ");
    if(arrow>rp){let raw_ret:[]u8=line[arrow+4..line.len-1];let ra:i32=zs_trim_start(raw_ret);let rb:i32=zs_trim_end(raw_ret);ret=zs_type_name(raw_ret[ra..rb]);}
    zs_ch(out,' ');zs_app(out,ret);zs_app(out," {\n");
}

fn zs_cst_token_text(src:[]u8,tok:ZsCstToken)[]u8{
    return src[tok.byte_start..tok.byte_end];
}
fn zs_line_keyword(src:[]u8,cst:ZsCst,node:ZsCstLine,word:[]u8)i32{
    if(node.token_start>=node.token_end){return 0;}
    let tok:ZsCstToken=cst.tokens.data[node.token_start];
    return @strEq(zs_cst_token_text(src,tok),word) as i32;
}
fn zs_line_last_text(src:[]u8,cst:ZsCst,node:ZsCstLine)[]u8{
    if(node.token_start>=node.token_end){return "";}
    let tok:ZsCstToken=cst.tokens.data[node.token_end-1];
    return zs_cst_token_text(src,tok);
}
fn zs_line_ends_punct(src:[]u8,cst:ZsCst,node:ZsCstLine,punct:[]u8)i32{
    return @strEq(zs_line_last_text(src,cst,node),punct) as i32;
}

fn zs_script_marker(src:[]u8)i32{
    let i:i32=0;
    while(i<src.len){
        while(i<src.len&&(src[i]==32||src[i]==9||src[i]==10||src[i]==13)){i=i+1;}
        if(i+1<src.len&&src[i]=='/'&&src[i+1]=='/'){while(i<src.len&&src[i]!=10){i=i+1;}}
        else{if(i+7<=src.len&&@strEq(src[i..i+7],"script;")){return 1;}return 0;}
    }
    return 0;
}

fn zs_has_canonical_brace(src:[]u8)i32{
    let quoted:i32=0;let escaped:i32=0;let i:i32=0;
    while(i<src.len){let c:u8=src[i];if(quoted==1){if(escaped==1){escaped=0;}else if(c==92){escaped=1;}else if(c==34){quoted=0;}}else if(c==34){quoted=1;}else if(c=='{'||c=='}'){return 1;}i=i+1;}
    return 0;
}

fn zs_emit_statement(out:*ArrayList[u8],line:[]u8,names:*ArrayList[[]u8])void{
    // Python-shaped list construction is a Script prelude call. Indexing
    // remains native parser syntax and is not rewritten.
    let text:[]u8=line;
    let eq:i32=zs_find(text," = ");
    if(eq>0){
        let name:[]u8=text[0..eq];let simple:i32=1;let ni:i32=0;
        while(ni<name.len){if(!zs_ident(name[ni])){simple=0;}ni=ni+1;}
        let rhs:[]u8=text[eq+3..text.len];
        if(simple==1&&zs_name_seen(names.*,name)==0){zs_app(out,"let ");push[[]u8](names,name);}
        zs_app(out,name);zs_app(out," = ");
        if(rhs.len>=2&&rhs[0]=='['&&rhs[rhs.len-1]==']'){zs_app(out,"list(");zs_emit_expr(out,rhs[1..rhs.len-1]);zs_ch(out,')');}
        else{zs_emit_expr(out,rhs);}
    }else{
        // `values.append(x)` lowers to the already bounded typed Script list
        // operation. Only a simple named receiver is accepted in this first
        // deterministic slice.
        let dot:i32=zs_find(text,".append(");
        if(dot>0&&zs_ends(text,")")){let recv:[]u8=text[0..dot];let simple:i32=1;let ri:i32=0;while(ri<recv.len){if(!zs_ident(recv[ri])){simple=0;}ri=ri+1;}if(simple==1){zs_app(out,"append(");zs_app(out,recv);zs_app(out,", ");zs_emit_expr(out,text[dot+8..text.len-1]);zs_ch(out,')');}else{zs_app(out,text);}}
        else if(@strEq(text,"pass")){zs_ch(out,'0');}
        else{zs_emit_expr(out,text);}
    }
    if(!zs_ends(text,";")){zs_ch(out,';');}
    zs_ch(out,10);
}

// The profile marker is a declaration, but compact Script may place the first
// executable statement on the same physical line (`script; return 0;`).  Keep
// the marker as its own parser line, then send the remainder through the same
// statement emitter used for subsequent lines.  This avoids a second grammar
// while preserving the compact source's source-span envelope.
fn zs_emit_script_line(out:*ArrayList[u8],line:[]u8,names:*ArrayList[[]u8])void{
    zs_app(out,"script;\n");
    let start:i32=7;while(start<line.len&&zs_space(line[start])){start=start+1;}
    if(start<line.len){zs_emit_statement(out,line[start..line.len],names);}
}

fn script_syntax_normalize_with_origins(src:[]u8)ZsNormalized{
    let cst:ZsCst=script_syntax_cst(src);
    if(zs_script_marker(src)==1&&script_syntax_cst_valid(cst)==0){
        _zag_eprintln("Zag Script: inconsistent indentation layout");_zag_exit(1);
    }
    let origins:ArrayList[ZsOriginSegment]=make[ZsOriginSegment](16);
    if(zs_script_marker(src)==0||zs_has_canonical_brace(src)==1){
        if(src.len>0){push[ZsOriginSegment](&origins,ZsOriginSegment{.generated_start=0,.generated_end=src.len,.source_start=0,.source_end=src.len,.origin_id=zs_origin_id(src,0,src.len,1),.exact=1});}
        return ZsNormalized{.source=src,.cst=cst,.origins=origins};
    }
    let out:ArrayList[u8]=make[u8](src.len+64);
    let blocks:ArrayList[i32]=make[i32](8);
    let names:ArrayList[[]u8]=make[[]u8](16);
    let need_indent:i32=-1;let ci:i32=0;let last_origin:i64=0;let last_source_start:i32=0;let last_source_end:i32=0;
    let layout_i:i32=0;
    while(ci<cst.lines.len){
            let node:ZsCstLine=cst.lines.data[ci];let generated_start:i32=out.len;
            let raw:[]u8=src[node.raw_start..node.content_end];let ts:i32=node.content_start-node.raw_start;let te:i32=raw.len;
            last_origin=node.origin_id;last_source_start=node.raw_start;last_source_end=node.raw_end;
            if(te>ts){
                let indent:i32=node.indent;let line:[]u8=src[node.content_start..node.content_end];
                // A same-level `else`/`elif` continues the open `if`; defer
                // CST dedent closures until the continuation logic below.
                let continuation_line:i32=((zs_line_keyword(src,cst,node,"else")==1||
                    zs_line_keyword(src,cst,node,"elif")==1)&&
                    zs_line_ends_punct(src,cst,node,":")==1) as i32;
                while(layout_i<cst.layouts.len&&cst.layouts.data[layout_i].byte_offset<=node.content_start){
                    let layout:ZsCstLayout=cst.layouts.data[layout_i];
                    if((layout.kind==2||layout.kind==3)&&continuation_line==0){
                        if(blocks.len>0){zs_app(&out,"}\n");blocks.len=blocks.len-1;}
                    }
                    layout_i=layout_i+1;
                }
                if(line[0]=='#'){zs_app(&out,"//");zs_app(&out,line[1..line.len]);zs_ch(&out,10);}
                else{
                if (need_indent >= 0) {
                    if (indent <= need_indent) { _zag_eprintln("Zag Script: indent the lines belonging to the statement above"); _zag_exit(1); }
                    need_indent = -1;
                }
                    let is_else: i32 = (zs_line_keyword(src,cst,node,"else")==1&&
                        zs_line_ends_punct(src,cst,node,":" )==1) as i32;
                    let is_elif: i32 = 0;
                    if (zs_line_keyword(src,cst,node,"elif")==1&&
                        zs_line_ends_punct(src,cst,node,":" )==1) { is_elif = 1; }

                    if (is_else == 1 || is_elif == 1) {
                        // Close only the prior `if` block at the same indentation
                        // level, then emit the continuation form.
                        while (blocks.len > 0 && blocks.data[blocks.len - 1] > indent) {
                            zs_app(&out, "}\n");
                            blocks.len = blocks.len - 1;
                        }
                        if (blocks.len == 0 || blocks.data[blocks.len - 1] != indent) {
                            _zag_eprintln("Zag Script: unexpected `else`/`elif` without matching `if`");
                            _zag_exit(1);
                        }
                        zs_app(&out, "}\n");
                        blocks.len = blocks.len - 1;
                    }
                    if(zs_line_keyword(src,cst,node,"script")==1&&
                        zs_line_ends_punct(src,cst,node,";")==1){zs_emit_script_line(&out,line,&names);}
                    else if(zs_line_keyword(src,cst,node,"if")==1&&
                        zs_line_ends_punct(src,cst,node,":" )==1){zs_app(&out,"if (");zs_emit_expr(&out,line[3..line.len-1]);zs_app(&out,") {\n");push[i32](&blocks,indent);need_indent=indent;}
                    else if(zs_line_keyword(src,cst,node,"while")==1&&
                        zs_line_ends_punct(src,cst,node,":" )==1){zs_app(&out,"while (");zs_emit_expr(&out,line[6..line.len-1]);zs_app(&out,") {\n");push[i32](&blocks,indent);need_indent=indent;}
                    else if(is_else==1){zs_app(&out,"else {\n");push[i32](&blocks,indent);need_indent=indent;}
                    else if(is_elif==1){zs_app(&out,"else if (");zs_emit_expr(&out,line[5..line.len-1]);zs_app(&out,") {\n");push[i32](&blocks,indent);need_indent=indent;}
                    else if(zs_line_keyword(src,cst,node,"def")==1&&
                        zs_line_ends_punct(src,cst,node,":" )==1){zs_emit_def(&out,line);push[i32](&blocks,indent);need_indent=indent;}
                    else if(zs_line_keyword(src,cst,node,"for")==1&&
                        zs_line_ends_punct(src,cst,node,":" )==1){
                        let body:[]u8=line[4..line.len-1];let in_at:i32=zs_find(body," in ");
                        if(in_at<=0){_zag_eprintln("Zag Script: `for` should read `for name in collection:`");_zag_exit(1);}
                        let collection:[]u8=body[in_at+4..body.len];
                        zs_app(&out,"for (");
                        if(zs_starts(collection,"range(")&&zs_ends(collection,")")){
                            let range_body:[]u8=collection[6..collection.len-1];let comma:i32=zs_find(range_body,",");
                            if(comma<0){zs_app(&out,"0..");zs_emit_expr(&out,range_body);}
                            else{zs_emit_expr(&out,range_body[0..comma]);zs_app(&out,"..");let rs:i32=zs_trim_start(range_body[comma+1..range_body.len]);zs_emit_expr(&out,range_body[comma+1+rs..range_body.len]);}
                        }else{zs_emit_expr(&out,collection);}
                        zs_app(&out,") |");zs_app(&out,body[0..in_at]);zs_app(&out,"| {\n");push[i32](&blocks,indent);need_indent=indent;
                    }else{zs_emit_statement(&out,line,&names);}
                }
            }else{zs_ch(&out,10);}
            if(out.len>generated_start){let exact:i32=0;if(out.len-generated_start==node.raw_end-node.raw_start&&
                @strEq(out.data[generated_start..out.len],src[node.raw_start..node.raw_end])){exact=1;}
                push[ZsOriginSegment](&origins,ZsOriginSegment{
                .generated_start=generated_start,.generated_end=out.len,
                .source_start=node.raw_start,.source_end=node.raw_end,.origin_id=node.origin_id,
                .exact=exact,
            });}
            ci=ci+1;
    }
    if(need_indent>=0){_zag_eprintln("Zag Script: expected an indented statement before the file ended");_zag_exit(1);}
    if(blocks.len>0){let generated_start:i32=out.len;while(blocks.len>0){zs_app(&out,"}\n");blocks.len=blocks.len-1;}push[ZsOriginSegment](&origins,ZsOriginSegment{
        .generated_start=generated_start,.generated_end=out.len,.source_start=last_source_start,
        .source_end=last_source_end,.origin_id=last_origin,.exact=0,
    });}
    return ZsNormalized{.source=out.data[0..out.len],.cst=cst,.origins=origins};
}

fn script_syntax_normalize(src:[]u8)[]u8{
    return script_syntax_normalize_with_origins(src).source;
}
