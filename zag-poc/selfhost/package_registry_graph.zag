@import("package_registry.zag")

// Validate a bounded dependency graph against one local index. Each input
// line is `package-name<TAB>requirement`; repeated names are intersected as a
// group through package_registry_lookup_all, while distinct names are checked
// independently. This is deliberately a selection/validation boundary, not
// a transitive solver: the caller still owns graph traversal and lock
// publication. The returned failing_name is borrowed from `requirements`.
enum PackageRegistryGraphError {
    none,
    invalid_index,
    invalid_graph,
    package_not_found,
    version_not_found,
}

struct PackageRegistryGraphLookup {
    valid: i32,
    edge_count: i32,
    package_count: i32,
    failing_name: []u8,
    error: PackageRegistryGraphError,
}

fn package_registry_graph_bad(error: PackageRegistryGraphError)
    PackageRegistryGraphLookup {
    return PackageRegistryGraphLookup{.valid = 0, .edge_count = 0,
        .package_count = 0, .failing_name = "", .error = error};
}

fn package_registry_graph_name(line: []u8) []u8 {
    if (package_registry_part_count(line) != 2) { return ""; }
    return package_registry_part(line, 0);
}

fn package_registry_graph_requirement(line: []u8) []u8 {
    if (package_registry_part_count(line) != 2) { return ""; }
    return package_registry_part(line, 1);
}

fn package_registry_graph_line_count(text: []u8) i32 {
    if (text.len == 0) { return 0; }
    let count: i32 = 1;
    let i: i32 = 0;
    while (i < text.len) {
        if (text[i] == '\n') { count = count + 1; }
        i = i + 1;
    }
    return count;
}

fn package_registry_graph_lookup(index: []u8,
    requirements: []u8) PackageRegistryGraphLookup {
    if (package_registry_index_valid(index) == 0) {
        return package_registry_graph_bad(
            PackageRegistryGraphError.invalid_index);
    }
    if (requirements.len == 0 || requirements.len > 1048576 ||
        requirements[requirements.len - 1] == '\n') {
        return package_registry_graph_bad(
            PackageRegistryGraphError.invalid_graph);
    }
    let edge_count: i32 = package_registry_graph_line_count(requirements);
    if (edge_count <= 0 || edge_count > 256) {
        return package_registry_graph_bad(
            PackageRegistryGraphError.invalid_graph);
    }

    let package_count: i32 = 0;
    let line_no: i32 = 0;
    while (line_no < edge_count) {
        let line: []u8 = package_registry_line(requirements, line_no);
        let name: []u8 = package_registry_graph_name(line);
        let first_requirement: []u8 = package_registry_graph_requirement(line);
        if (name.len == 0 || package_import_safe_name(name) == 0 ||
            (first_requirement.len > 0 &&
             package_version_requirement_valid(first_requirement) == 0)) {
            return package_registry_graph_bad(
                PackageRegistryGraphError.invalid_graph);
        }

        // Process each package alias once. Earlier lines with the same name
        // are already represented by that first occurrence's intersection.
        let prior: i32 = 0;
        let prior_no: i32 = 0;
        while (prior_no < line_no) {
            let prior_line: []u8 = package_registry_line(requirements, prior_no);
            if (@strEq(package_registry_graph_name(prior_line), name)) {
                prior = 1; break;
            }
            prior_no = prior_no + 1;
        }
        if (prior == 0) {
            let grouped: []u8 = "";
            let group_no: i32 = line_no;
            while (group_no < edge_count) {
                let group_line: []u8 = package_registry_line(
                    requirements, group_no);
                if (@strEq(package_registry_graph_name(group_line), name)) {
                    let requirement: []u8 =
                        package_registry_graph_requirement(group_line);
                    if (requirement.len > 0) {
                        if (grouped.len == 0) {
                            grouped = _zag_str_concat("", requirement);
                        } else {
                            let joined: []u8 = _zag_str_concat(grouped, "\n");
                            _zag_str_free(grouped);
                            grouped = _zag_str_concat(joined, requirement);
                            _zag_str_free(joined);
                        }
                    }
                }
                group_no = group_no + 1;
            }
            let selected: PackageRegistryLookup =
                package_registry_lookup_all(index, name, grouped);
            if (grouped.len > 0) { _zag_str_free(grouped); }
            if (selected.found == 0) {
                let error: PackageRegistryGraphError =
                    PackageRegistryGraphError.version_not_found;
                if (selected.error == PackageRegistryError.package_not_found) {
                    error = PackageRegistryGraphError.package_not_found;
                }
                return PackageRegistryGraphLookup{.valid = 0,
                    .edge_count = edge_count, .package_count = package_count,
                    .failing_name = name, .error = error};
            }
            package_count = package_count + 1;
        }
        line_no = line_no + 1;
    }
    return PackageRegistryGraphLookup{.valid = 1, .edge_count = edge_count,
        .package_count = package_count, .failing_name = "",
        .error = PackageRegistryGraphError.none};
}
