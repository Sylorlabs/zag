@import("zagd_incremental.zag")
@import("../std/list.zag")
fn ok(v:i32,msg:[]u8,f:*i32)void{if(v==0){_zag_eprintln(msg);f.*=f.*+1;}}
fn fact(name:[]u8,pub:i32,sig:[]u8,layout:[]u8,body:[]u8)ZagdDeclFingerprint{return ZagdDeclFingerprint{.name=name,.kind=1,.public=pub,.parse=zagd_content_hash(name),.signature=zagd_content_hash(sig),.layout=zagd_content_hash(layout),.body=zagd_content_hash(body),.callers=zagd_content_hash("caller"),.codegen_region=zagd_content_hash("region")};}
fn file(source:[]u8,parse:[]u8,root:[]u8,target:[]u8,d:ZagdDeclFingerprint)ZagdIncrementalFile{let ds:ArrayList[ZagdDeclFingerprint]=make[ZagdDeclFingerprint](1);push[ZagdDeclFingerprint](&ds,d);return ZagdIncrementalFile{.path="src/a.zag",.content=zagd_content_hash(source),.parse=zagd_content_hash(parse),.declarations=ds,.root=zagd_content_hash(root),.target=zagd_content_hash(target),.valid=1,.advisory=1,.executable_authority=0};}
fn main()i32{let f:i32=0;let base:ZagdIncrementalFile=file("source","parse","root","x86",fact("work",0,"sig","layout","body"));let text:[]u8=zagd_incremental_encode(base);let restored:ZagdIncrementalFile=zagd_incremental_decode(text);ok(restored.valid==1&&restored.declarations.len==1&&restored.executable_authority==0,"restart reuse",&f);ok(zagd_incremental_decode(_zag_str_concat(text,"corrupt")).valid==0,"corruption miss",&f);let comment:ZagdIncrementalFile=file("source // comment","parse","root","x86",fact("work",0,"sig","layout","body"));let dc:ZagdIncrementalDecision=zagd_incremental_decide(base,comment);ok(dc.change==zagd_change_nonsemantic()&&dc.reuse_parse==1&&dc.invalidate_codegen==0,"comment reuse",&f);let body:ZagdIncrementalFile=file("body2","parse2","root","x86",fact("work",0,"sig","layout","body2"));let db:ZagdIncrementalDecision=zagd_incremental_decide(base,body);ok(db.change==zagd_change_private_body()&&db.invalidate_types==0&&db.invalidate_callers==1,"private caller invalidation",&f);let pub:ZagdIncrementalFile=file("pub2","parse2","root","x86",fact("work",1,"sig2","layout","body"));ok(zagd_incremental_decide(base,pub).change==zagd_change_public_shape(),"public invalidation",&f);let layout:ZagdIncrementalFile=file("layout2","parse2","root","x86",fact("work",0,"sig","layout2","body"));ok(zagd_incremental_decide(base,layout).invalidate_layouts==1,"layout invalidation",&f);let root:ZagdIncrementalFile=file("source","parse","script","x86",fact("work",0,"sig","layout","body"));ok(zagd_incremental_decide(base,root).change==zagd_change_root_profile(),"root invalidation",&f);let target:ZagdIncrementalFile=file("source","parse","root","native",fact("work",0,"sig","layout","body"));ok(zagd_incremental_decide(base,target).change==zagd_change_target_profile(),"target invalidation",&f);if(f==0){_zag_println("zagd incremental persistence: ok");}return f;}
