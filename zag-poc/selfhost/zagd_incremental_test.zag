@import("zagd_incremental.zag")
@import("../std/list.zag")
fn ok(v:i32,msg:[]u8,f:*i32)void{if(v==0){_zag_eprintln(msg);f.*=f.*+1;}}
fn fact(name:[]u8,pub:i32,sig:[]u8,layout:[]u8,body:[]u8)ZagdDeclFingerprint{return ZagdDeclFingerprint{.name=name,.kind=1,.public=pub,.parse=zagd_content_hash(name),.signature=zagd_content_hash(sig),.layout=zagd_content_hash(layout),.body=zagd_content_hash(body),.callers=zagd_content_hash("caller"),.codegen_region=zagd_content_hash("region")};}
fn file(source:[]u8,parse:[]u8,root:[]u8,target:[]u8,d:ZagdDeclFingerprint)ZagdIncrementalFile{let ds:ArrayList[ZagdDeclFingerprint]=make[ZagdDeclFingerprint](1);push[ZagdDeclFingerprint](&ds,d);return ZagdIncrementalFile{.path="src/a.zag",.content=zagd_content_hash(source),.parse=zagd_content_hash(parse),.declarations=ds,.root=zagd_content_hash(root),.target=zagd_content_hash(target),.valid=1,.advisory=1,.executable_authority=0};}
fn main()i32{let f:i32=0;let base:ZagdIncrementalFile=file("source","parse","root","x86",fact("work",0,"sig","layout","body"));let text:[]u8=zagd_incremental_encode(base);let restored:ZagdIncrementalFile=zagd_incremental_decode(text);ok(restored.valid==1&&restored.declarations.len==1&&restored.executable_authority==0,"restart reuse",&f);ok(zagd_incremental_decode(_zag_str_concat(text,"corrupt")).valid==0,"corruption miss",&f);let comment:ZagdIncrementalFile=file("source // comment","parse","root","x86",fact("work",0,"sig","layout","body"));let dc:ZagdIncrementalDecision=zagd_incremental_decide(base,comment);ok(dc.change==zagd_change_nonsemantic()&&dc.reuse_parse==1&&dc.invalidate_codegen==0,"comment reuse",&f);let body:ZagdIncrementalFile=file("body2","parse2","root","x86",fact("work",0,"sig","layout","body2"));let db:ZagdIncrementalDecision=zagd_incremental_decide(base,body);ok(db.change==zagd_change_private_body()&&db.invalidate_types==0&&db.invalidate_callers==1,"private caller invalidation",&f);let pub:ZagdIncrementalFile=file("pub2","parse2","root","x86",fact("work",1,"sig2","layout","body"));ok(zagd_incremental_decide(base,pub).change==zagd_change_public_shape(),"public invalidation",&f);let layout:ZagdIncrementalFile=file("layout2","parse2","root","x86",fact("work",0,"sig","layout2","body"));ok(zagd_incremental_decide(base,layout).invalidate_layouts==1,"layout invalidation",&f);let root:ZagdIncrementalFile=file("source","parse","script","x86",fact("work",0,"sig","layout","body"));ok(zagd_incremental_decide(base,root).change==zagd_change_root_profile(),"root invalidation",&f);let target:ZagdIncrementalFile=file("source","parse","root","native",fact("work",0,"sig","layout","body"));ok(zagd_incremental_decide(base,target).change==zagd_change_target_profile(),"target invalidation",&f);let src:[]u8="pub struct Pair { left:i32, right:i32 } fn helper(x:i32) i32 { return x; } pub fn api(x:i32) i32 { return helper(x); }";let extracted:ZagdIncrementalFile=zagd_incremental_extract("src/a.zag",src,zagd_source_facts(src),"x86");ok(extracted.valid==1&&extracted.declarations.len==3,"real declaration extraction",&f);let extext:[]u8=zagd_incremental_encode(extracted);ok(zagd_incremental_decode(extext).declarations.len==3,"real declaration persistence",&f);let noisy:[]u8="// fn fake() i32 { bad(); }\n/* { fn nested(){} } */ fn real() i32 { let s=[]u8(\"fn nope() { fake(); }\"); return 1; }";let noise:ZagdIncrementalFile=zagd_incremental_extract("noise.zag",noisy,zagd_source_facts(noisy),"x86");ok(noise.valid==1&&noise.declarations.len==1&&@strEq(noise.declarations.data[0].name,"real"),"comments and strings ignored",&f);let reversed:[]u8="pub fn api(x:i32) i32 { return helper(x); } fn helper(x:i32) i32 { return x; } pub struct Pair { left:i32, right:i32 }";let reordered:ZagdIncrementalFile=zagd_incremental_extract("src/a.zag",reversed,zagd_source_facts(reversed),"x86");let rd:ZagdIncrementalDecision=zagd_incremental_decide(extracted,reordered);ok(rd.change==zagd_change_unknown()&&rd.invalidate_codegen==1,"declaration order invalidates conservatively",&f);let broken:[]u8="fn bad() i32 { return 1;";ok(zagd_incremental_extract("bad.zag",broken,zagd_source_facts(broken),"x86").valid==0,"unknown syntax fails closed",&f);if(f==0){_zag_println("zagd incremental persistence: ok");}return f;}
