@import("zagd_incremental.zag")
@import("../std/list.zag")

fn ok(value: i32, message: []u8, failures: *i32) void {
    if (value == 0) {
        _zag_eprintln(message);
        failures.* = failures.* + 1;
    }
}

fn fact(name: []u8, public: i32, signature: []u8, layout: []u8,
        body: []u8) ZagdDeclFingerprint {
    return ZagdDeclFingerprint{
        .name=name,
        .kind=1,
        .public=public,
        .parse=zagd_content_hash(name),
        .signature=zagd_content_hash(signature),
        .layout=zagd_content_hash(layout),
        .body=zagd_content_hash(body),
        .callers=zagd_content_hash("caller"),
        .codegen_region=zagd_content_hash("region"),
    };
}

fn file(source: []u8, parse: []u8, root: []u8, target: []u8,
        declaration: ZagdDeclFingerprint) ZagdIncrementalFile {
    let declarations: ArrayList[ZagdDeclFingerprint] =
        make[ZagdDeclFingerprint](1);
    push[ZagdDeclFingerprint](&declarations, declaration);
    return ZagdIncrementalFile{
        .path="src/a.zag",
        .content=zagd_content_hash(source),
        .parse=zagd_content_hash(parse),
        .declarations=declarations,
        .root=zagd_content_hash(root),
        .target=zagd_content_hash(target),
        .valid=1,
        .advisory=1,
        .executable_authority=0,
    };
}

fn main() i32 {
    let failures: i32 = 0;
    let base: ZagdIncrementalFile =
        file("source", "parse", "root", "x86",
            fact("work", 0, "sig", "layout", "body"));
    let text: []u8 = zagd_incremental_encode(base);
    let restored: ZagdIncrementalFile = zagd_incremental_decode(text);
    ok(restored.valid == 1 && restored.declarations.len == 1 &&
        restored.executable_authority == 0, "restart reuse", &failures);
    ok(zagd_incremental_decode(_zag_str_concat(text, "corrupt")).valid == 0,
        "corruption miss", &failures);

    // Spell every persisted-control field explicitly. Partial struct literals
    // do not establish portable zero-initialization across native backends.
    let index: ZagdIncrementalIndex = ZagdIncrementalIndex{
        .files=make[ZagdIncrementalFile](2),
        .graph_identity=zagd_hash_empty(),
        .graph_complete=0,
        .valid=1,
        .advisory=1,
        .executable_authority=0,
    };
    zagd_incremental_index_put(&index, base);
    let second: ZagdIncrementalFile =
        file("second", "parse2", "root", "x86",
            fact("other", 1, "sig2", "layout2", "body2"));
    second.path = "src/b.zag";
    zagd_incremental_index_put(&index, second);
    let index_text: []u8 = zagd_incremental_index_encode(index);
    let restored_index: ZagdIncrementalIndex =
        zagd_incremental_index_decode(index_text);
    ok(restored_index.valid == 1,
        "multi-file project index validity", &failures);
    ok(restored_index.files.len == 2,
        "multi-file project index file count", &failures);
    ok(zagd_incremental_index_get(restored_index, "src/b.zag").
        declarations.len == 1,
        "multi-file project index declaration count", &failures);
    ok(zagd_incremental_index_decode(
        _zag_str_concat(index_text, "corrupt")).valid == 0,
        "project index corruption miss", &failures);

    let comment: ZagdIncrementalFile =
        file("source // comment", "parse", "root", "x86",
            fact("work", 0, "sig", "layout", "body"));
    let comment_decision: ZagdIncrementalDecision =
        zagd_incremental_decide(base, comment);
    ok(comment_decision.change == zagd_change_nonsemantic() &&
        comment_decision.reuse_parse == 1 &&
        comment_decision.invalidate_codegen == 0,
        "comment reuse", &failures);

    let body: ZagdIncrementalFile =
        file("body2", "parse2", "root", "x86",
            fact("work", 0, "sig", "layout", "body2"));
    let body_decision: ZagdIncrementalDecision =
        zagd_incremental_decide(base, body);
    ok(body_decision.change == zagd_change_private_body() &&
        body_decision.invalidate_types == 0 &&
        body_decision.invalidate_callers == 1,
        "private caller invalidation", &failures);

    let public_shape: ZagdIncrementalFile =
        file("pub2", "parse2", "root", "x86",
            fact("work", 1, "sig2", "layout", "body"));
    ok(zagd_incremental_decide(base, public_shape).change ==
        zagd_change_public_shape(), "public invalidation", &failures);

    let layout: ZagdIncrementalFile =
        file("layout2", "parse2", "root", "x86",
            fact("work", 0, "sig", "layout2", "body"));
    ok(zagd_incremental_decide(base, layout).invalidate_layouts == 1,
        "layout invalidation", &failures);

    let root: ZagdIncrementalFile =
        file("source", "parse", "script", "x86",
            fact("work", 0, "sig", "layout", "body"));
    ok(zagd_incremental_decide(base, root).change ==
        zagd_change_root_profile(), "root invalidation", &failures);

    let target: ZagdIncrementalFile =
        file("source", "parse", "root", "native",
            fact("work", 0, "sig", "layout", "body"));
    ok(zagd_incremental_decide(base, target).change ==
        zagd_change_target_profile(), "target invalidation", &failures);

    let source: []u8 =
        "pub struct Pair { left:i32, right:i32 } fn helper(x:i32) i32 { return x; } pub fn api(x:i32) i32 { return helper(x); }";
    let extracted: ZagdIncrementalFile =
        zagd_incremental_extract("src/a.zag", source,
            zagd_source_facts(source), "x86");
    ok(extracted.valid == 1 && extracted.declarations.len == 3,
        "real declaration extraction", &failures);
    let extracted_text: []u8 = zagd_incremental_encode(extracted);
    ok(zagd_incremental_decode(extracted_text).declarations.len == 3,
        "real declaration persistence", &failures);

    let noisy: []u8 =
        "// fn fake() i32 { bad(); }\n/* { fn nested(){} } */ fn real() i32 { let s=[]u8(\"fn nope() { fake(); }\"); return 1; }";
    let noise: ZagdIncrementalFile =
        zagd_incremental_extract("noise.zag", noisy,
            zagd_source_facts(noisy), "x86");
    ok(noise.valid == 1 && noise.declarations.len == 1 &&
        @strEq(noise.declarations.data[0].name, "real"),
        "comments and strings ignored", &failures);

    let reversed: []u8 =
        "pub fn api(x:i32) i32 { return helper(x); } fn helper(x:i32) i32 { return x; } pub struct Pair { left:i32, right:i32 }";
    let reordered: ZagdIncrementalFile =
        zagd_incremental_extract("src/a.zag", reversed,
            zagd_source_facts(reversed), "x86");
    let reorder_decision: ZagdIncrementalDecision =
        zagd_incremental_decide(extracted, reordered);
    ok(reorder_decision.change == zagd_change_unknown() &&
        reorder_decision.invalidate_codegen == 1,
        "declaration order invalidates conservatively", &failures);

    let broken: []u8 = "fn bad() i32 { return 1;";
    ok(zagd_incremental_extract("bad.zag", broken,
        zagd_source_facts(broken), "x86").valid == 0,
        "unknown syntax fails closed", &failures);
    if (failures == 0) {
        _zag_println("zagd incremental persistence: ok");
    }
    return failures;
}
