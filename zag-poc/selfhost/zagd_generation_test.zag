@import("zagd_generation.zag")
extern fn _zag_write_file(path: []u8, content: []u8) i32

fn zgt_expect(ok: i32, label: []u8, failures: *i32) void {
    if (ok == 1) { return; }
    _zag_eprintln(_zag_str_concat("zagd generation test: ", label));
    failures.* = failures.* + 1;
}
fn zgt_active_canary(generation: ZagdHash, predecessor: ZagdHash) ZagdGenerationCanary {
    return ZagdGenerationCanary{ .generation = generation, .predecessor = predecessor,
        .successes = 0, .failures = 0, .consecutive_crashes = 0,
        .required_successes = zagd_generation_required_successes(), .session_clean = 1,
        .quarantined = 0, .valid = 1 };
}

fn main() i32 {
    if (_zag_argc() != 2) { _zag_eprintln("zagd generation test: expected state root");return 2; }
    let failures: i32 = 0;let root: []u8 = _zag_arg(1);let compiler: []u8 = "test-compiler-v1";
    let empty: ZagdHash = zagd_hash_empty();

    let manifest_text: []u8 = zagd_generation_manifest_encode(compiler, empty,
        zagd_generation_builtin_policy());
    let manifest: ZagdGenerationManifest = zagd_generation_manifest_decode(manifest_text);
    zgt_expect(manifest.valid == 1 && manifest.canary_required == 3 &&
        zagd_hash_equal(manifest.parent, empty) == 1, "manifest decode", &failures);
    zgt_expect(@strEq(zagd_record_value(manifest_text, "execution_payload"), "none") &&
        @strEq(zagd_record_value(manifest_text, "executable_authority"), "false") &&
        @strEq(zagd_record_value(manifest_text, "sandbox_execution_required"), "true"),
        "manifest has no executable payload", &failures);
    let appended_manifest: []u8 = _zag_str_concat(manifest_text, "mutated");
    zgt_expect(zagd_generation_manifest_decode(appended_manifest).valid == 0,
        "mutated manifest rejected", &failures);zagd_text_free(appended_manifest);
    zgt_expect(zagd_generation_manifest_decode(manifest_text[0..manifest_text.len - 1]).valid == 0,
        "truncated manifest rejected", &failures);
    zgt_expect(zagd_generation_manifest_compatible(manifest_text, "test-compiler-v2").valid == 0,
        "stale compiler manifest rejected", &failures);

    let base_pointers: ZagdGenerationPointers = zagd_generation_default_pointers(manifest.identity);
    let base_canary: ZagdGenerationCanary = zagd_generation_default_canary(manifest.identity);
    let pointer_text: []u8 = zagd_generation_pointers_encode(base_pointers);
    let canary_text: []u8 = zagd_generation_canary_encode(base_canary);
    zgt_expect(zagd_generation_pointers_decode(pointer_text).valid == 1,
        "pointer decode", &failures);
    zgt_expect(zagd_generation_canary_decode(canary_text).valid == 1,
        "canary decode", &failures);
    zgt_expect(zagd_generation_pointers_decode(pointer_text[0..pointer_text.len - 1]).valid == 0 &&
        zagd_generation_canary_decode(canary_text[0..canary_text.len - 1]).valid == 0,
        "truncated state rejected", &failures);
    let invalid_canary: ZagdGenerationCanary = base_canary;
    invalid_canary.failures = 1;invalid_canary.consecutive_crashes = 2;
    zgt_expect(zagd_generation_canary_value_valid(invalid_canary) == 0,
        "impossible canary rejected", &failures);
    zagd_text_free(canary_text);zagd_text_free(pointer_text);

    let initial: ZagdGenerationRegistry = zagd_generation_initialize_stable(root, compiler);
    zgt_expect(initial.record_valid == 1 && initial.fallback == 0 &&
        initial.execution_enabled == 0 && zagd_hash_equal(initial.selected, manifest.identity) == 1,
        "linked release registry initialized", &failures);
    let builtin_path: []u8 = zagd_generation_manifest_path(root, manifest.identity);
    zgt_expect(zagd_path_is_regular(builtin_path) == 1,
        "flat content-addressed builtin manifest", &failures);
    zgt_expect(zagd_generation_write_immutable(builtin_path, manifest_text) == 1 &&
        zagd_generation_write_immutable(builtin_path, "different") == 0,
        "immutable create accepts only exact bytes", &failures);

    // Install a metadata-only candidate and simulate three consecutive crashed
    // sessions. The third recorded crash quarantines it and rolls both pointers
    // back to the retained linked release generation.
    let candidate_text: []u8 = zagd_generation_manifest_encode(compiler, manifest.identity,
        zagd_content_hash("candidate-policy-one"));
    let candidate: ZagdGenerationManifest = zagd_generation_manifest_decode(candidate_text);
    zgt_expect(candidate.valid == 1 && zagd_generation_install_manifest(root, candidate_text) == 1,
        "candidate manifest installed without execution authority", &failures);
    let candidate_path: []u8 = zagd_generation_manifest_path(root, candidate.identity);
    let active_pointers: ZagdGenerationPointers = ZagdGenerationPointers{
        .current = candidate.identity, .last_known_good = manifest.identity, .valid = 1 };
    let active_canary: ZagdGenerationCanary = zgt_active_canary(candidate.identity, manifest.identity);
    zgt_expect(zagd_generation_persist(root, active_pointers, active_canary) == 1,
        "active canary state persisted", &failures);
    let active: ZagdGenerationRegistry = zagd_generation_load(root, compiler);
    zgt_expect(active.record_valid == 1 && active.fallback == 0 &&
        zagd_hash_equal(active.selected, candidate.identity) == 1,
        "active candidate metadata loaded", &failures);
    let crashed: ZagdGenerationTransition = zagd_generation_begin_session(active_pointers, active_canary);
    zgt_expect(crashed.valid == 1 && crashed.started == 1 && crashed.canary.session_clean == 0,
        "first candidate session begun", &failures);
    crashed = zagd_generation_begin_session(crashed.pointers, crashed.canary);
    crashed = zagd_generation_begin_session(crashed.pointers, crashed.canary);
    crashed = zagd_generation_begin_session(crashed.pointers, crashed.canary);
    zgt_expect(crashed.valid == 1 && crashed.rolled_back == 1 && crashed.started == 0 &&
        crashed.canary.quarantined == 1 && crashed.canary.consecutive_crashes == 3 &&
        zagd_hash_equal(crashed.pointers.current, manifest.identity) == 1 &&
        zagd_hash_equal(crashed.pointers.last_known_good, manifest.identity) == 1,
        "crash loop quarantined and rolled back", &failures);
    zgt_expect(zagd_generation_persist(root, crashed.pointers, crashed.canary) == 1,
        "rollback state persisted", &failures);
    let rolled_back: ZagdGenerationRegistry = zagd_generation_load(root, compiler);
    zgt_expect(rolled_back.record_valid == 1 && rolled_back.fallback == 1 &&
        rolled_back.quarantined == 1 && rolled_back.execution_enabled == 0 &&
        zagd_hash_equal(rolled_back.selected, manifest.identity) == 1,
        "quarantined load selects retained predecessor", &failures);
    zgt_expect(zagd_path_is_regular(candidate_path) == 1 &&
        zagd_path_is_regular(builtin_path) == 1,
        "rollback retains candidate and predecessor manifests", &failures);

    // A second candidate survives the complete bounded canary window. Promotion
    // changes metadata pointers only; execution remains disabled in this slice.
    let candidate_two_text: []u8 = zagd_generation_manifest_encode(compiler, manifest.identity,
        zagd_content_hash("candidate-policy-two"));
    let candidate_two: ZagdGenerationManifest = zagd_generation_manifest_decode(candidate_two_text);
    zgt_expect(candidate_two.valid == 1 &&
        zagd_generation_install_manifest(root, candidate_two_text) == 1,
        "second candidate installed", &failures);
    let promoted_pointers: ZagdGenerationPointers = ZagdGenerationPointers{
        .current = candidate_two.identity, .last_known_good = manifest.identity, .valid = 1 };
    let promoted_canary: ZagdGenerationCanary = zgt_active_canary(candidate_two.identity, manifest.identity);
    let round: i32 = 0;let promoted: i32 = 0;
    while (round < zagd_generation_required_successes()) {
        let begun: ZagdGenerationTransition = zagd_generation_begin_session(promoted_pointers, promoted_canary);
        let finished: ZagdGenerationTransition = zagd_generation_finish_session(begun.pointers, begun.canary);
        zgt_expect(begun.valid == 1 && begun.started == 1 && finished.valid == 1,
            "clean canary session", &failures);
        promoted_pointers = finished.pointers;promoted_canary = finished.canary;
        promoted = finished.promoted;round = round + 1;
    }
    zgt_expect(promoted == 1 && promoted_canary.successes == 3 &&
        zagd_hash_equal(promoted_pointers.current, candidate_two.identity) == 1 &&
        zagd_hash_equal(promoted_pointers.last_known_good, candidate_two.identity) == 1,
        "bounded canary promotion", &failures);
    zgt_expect(zagd_generation_persist(root, promoted_pointers, promoted_canary) == 1,
        "promoted state persisted", &failures);
    let promoted_registry: ZagdGenerationRegistry = zagd_generation_load(root, compiler);
    zgt_expect(promoted_registry.record_valid == 1 && promoted_registry.execution_enabled == 0 &&
        zagd_hash_equal(promoted_registry.selected, candidate_two.identity) == 1 &&
        zagd_path_is_regular(builtin_path) == 1,
        "promoted metadata retains predecessor and cannot execute", &failures);
    let prepared: ZagdGenerationRegistry = zagd_generation_prepare_stable(root, compiler);
    let finished_registry: ZagdGenerationRegistry = zagd_generation_finish_stable(root, compiler);
    zgt_expect(prepared.record_valid == 1 && prepared.canary.session_clean == 0 &&
        finished_registry.record_valid == 1 && finished_registry.canary.session_clean == 1,
        "daemon session lifecycle persisted", &failures);

    let pointer_path: []u8 = zagd_generation_record_path(root, "generation-pointers.record");
    let canary_path: []u8 = zagd_generation_record_path(root, "generation-canary.record");
    let promoted_pointer_text: []u8 = zagd_generation_pointers_encode(promoted_pointers);
    let promoted_canary_text: []u8 = zagd_generation_canary_encode(promoted_canary);
    zgt_expect(_zag_write_file(pointer_path,
        promoted_pointer_text[0..promoted_pointer_text.len - 1]) == 0 &&
        zagd_generation_load(root, compiler).record_valid == 0,
        "truncated pointer record falls back", &failures);
    zgt_expect(zagd_generation_persist(root, promoted_pointers, promoted_canary) == 1,
        "pointer state restored", &failures);
    let mutated_canary: []u8 = _zag_str_concat(promoted_canary_text, "forged");
    zgt_expect(_zag_write_file(canary_path, mutated_canary) == 0 &&
        zagd_generation_load(root, compiler).record_valid == 0,
        "mutated canary record falls back", &failures);zagd_text_free(mutated_canary);
    zgt_expect(zagd_generation_persist(root, promoted_pointers, promoted_canary) == 1,
        "canary state restored", &failures);

    let stale: ZagdGenerationRegistry = zagd_generation_load(root, "test-compiler-v2");
    zgt_expect(stale.record_valid == 0 && stale.fallback == 1 && stale.execution_enabled == 0,
        "stale compiler registry falls back", &failures);
    let missing: ZagdHash = zagd_content_hash("missing-generation");
    let missing_pointers: ZagdGenerationPointers = ZagdGenerationPointers{
        .current = missing, .last_known_good = manifest.identity, .valid = 1 };
    let missing_canary: ZagdGenerationCanary = zgt_active_canary(missing, manifest.identity);
    zgt_expect(zagd_generation_persist(root, missing_pointers, missing_canary) == 1 &&
        zagd_generation_load(root, compiler).record_valid == 0,
        "missing content-addressed manifest falls back", &failures);
    zgt_expect(zagd_generation_persist(root, promoted_pointers, promoted_canary) == 1,
        "valid promoted state restored after stale pointer", &failures);

    // Direct on-disk corruption cannot be repaired by overwriting an immutable
    // content-addressed name. The loader falls back to the linked release.
    let candidate_two_path: []u8 = zagd_generation_manifest_path(root, candidate_two.identity);
    zgt_expect(_zag_write_file(candidate_two_path, "corrupt") == 0 &&
        zagd_generation_load(root, compiler).record_valid == 0 &&
        zagd_generation_write_immutable(candidate_two_path, candidate_two_text) == 0 &&
        zagd_path_is_regular(builtin_path) == 1,
        "mutated immutable manifest is quarantined by fallback", &failures);

    zagd_text_free(candidate_two_path);zagd_text_free(promoted_canary_text);
    zagd_text_free(promoted_pointer_text);zagd_text_free(canary_path);zagd_text_free(pointer_path);
    zagd_text_free(candidate_two_text);zagd_text_free(candidate_path);zagd_text_free(candidate_text);
    zagd_text_free(builtin_path);zagd_text_free(manifest_text);
    if (failures == 0) { _zag_println("zagd stable generation registry: PASS"); }
    return failures;
}
