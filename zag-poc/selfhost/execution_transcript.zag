// Native execution recorder API. The runtime adapter supplies observed events;
// this module never infers execution from source text or launches a process.
@import("evidence_codec.zag")

struct ExecutionEvent { operation:[]u8, request:[]u8, response:[]u8, status:i32 }
struct ExecutionRecorder { fields:ArrayList[[]u8], count:i32, valid:i32, closed:i32 }

fn et_genesis(compiler:[]u8,input:[]u8,context:[]u8)[]u8{
    let f:ArrayList[[]u8]=make[[]u8](4);ev_add(&f,"zag-execution-genesis-v1");ev_add(&f,compiler);ev_add(&f,input);ev_add(&f,context);
    let text:[]u8=ev_encode(f);let hash:[]u8=ev_hash(text);ev_fields_free(&f);_zag_str_free(text);return hash;
}
fn et_link(previous:[]u8,index:i32,event:ExecutionEvent)[]u8{
    let f:ArrayList[[]u8]=make[[]u8](7);ev_add(&f,"zag-execution-event-v1");ev_add(&f,previous);ev_add_int(&f,index);
    ev_add(&f,event.operation);ev_add(&f,event.request);ev_add(&f,event.response);ev_add_int(&f,event.status);
    let text:[]u8=ev_encode(f);let hash:[]u8=ev_empty();if(text.len>0){_zag_str_free(hash);hash=ev_hash(text);}
    ev_fields_free(&f);_zag_str_free(text);return hash;
}
fn execution_record_begin(compiler_image:[]u8,input:[]u8,context:[]u8)ExecutionRecorder{
    let f:ArrayList[[]u8]=make[[]u8](16);ev_add(&f,"zag-execution-transcript-v1");push[[]u8](&f,ev_hash(compiler_image));
    push[[]u8](&f,ev_hash(input));push[[]u8](&f,ev_hash(context));
    push[[]u8](&f,et_genesis(f.data[1],f.data[2],f.data[3]));
    return ExecutionRecorder{.fields=f,.count=0,.valid=(compiler_image.len>0) as i32,.closed=0};
}
fn execution_record_event(rec:*ExecutionRecorder,event:ExecutionEvent)i32{
    if(rec.*.valid!=1||rec.*.closed!=0||rec.*.count>=256||event.operation.len==0||event.status<0||event.status>255){rec.*.valid=0;return 0;}
    let previous:[]u8=rec.*.fields.data[rec.*.fields.len-1];let hash:[]u8=et_link(previous,rec.*.count,event);
    if(ev_digest_ok(hash)==0){_zag_str_free(hash);rec.*.valid=0;return 0;}
    ev_add(&rec.*.fields,event.operation);ev_add(&rec.*.fields,event.request);ev_add(&rec.*.fields,event.response);
    ev_add_int(&rec.*.fields,event.status);ev_add(&rec.*.fields,previous);push[[]u8](&rec.*.fields,hash);
    rec.*.count=rec.*.count+1;return 1;
}
// Final count + terminal status are mandatory. Pin the entire returned record
// outside the transcript to detect suffix deletion, even after rehashing.
fn execution_record_finish(rec:*ExecutionRecorder,status:i32)[]u8{
    if(rec.*.valid!=1||rec.*.closed!=0||status<0||status>255){rec.*.valid=0;return ev_empty();}
    rec.*.closed=1;ev_add_int(&rec.*.fields,rec.*.count);ev_add_int(&rec.*.fields,status);return ev_encode(rec.*.fields);
}
fn execution_transcript_valid(r:EvidenceRecord)i32{
    if(r.valid!=1||r.fields.len<7||ev_equal(ev_get(r,0),"zag-execution-transcript-v1")==0||
        ev_digest_ok(ev_get(r,1))==0||ev_digest_ok(ev_get(r,2))==0||ev_digest_ok(ev_get(r,3))==0){return 0;}
    let count:i32=ev_uint(ev_get(r,r.fields.len-2),256);
    if(count<0||r.fields.len!=7+count*6||ev_uint(ev_get(r,r.fields.len-1),255)<0){return 0;}
    let genesis:[]u8=et_genesis(ev_get(r,1),ev_get(r,2),ev_get(r,3));let ok:i32=ev_equal(genesis,ev_get(r,4));_zag_str_free(genesis);if(ok==0){return 0;}
    let previous:[]u8=ev_get(r,4);let i:i32=0;
    while(i<count){let p:i32=5+i*6;let status:i32=ev_uint(ev_get(r,p+3),255);
        if(ev_get(r,p).len==0||status<0||ev_equal(previous,ev_get(r,p+4))==0){return 0;}
        let event:ExecutionEvent=ExecutionEvent{.operation=ev_get(r,p),.request=ev_get(r,p+1),.response=ev_get(r,p+2),.status=status};
        let hash:[]u8=et_link(previous,i,event);ok=ev_equal(hash,ev_get(r,p+5));_zag_str_free(hash);if(ok==0){return 0;}
        previous=ev_get(r,p+5);i=i+1;
    }return 1;
}
fn execution_transcript_verify(text:[]u8,pin:[]u8,compiler:[]u8,input:[]u8,context:[]u8)i32{
    let r:EvidenceRecord=ev_decode(text,pin);let ok:i32=execution_transcript_valid(r);
    if(ok==1){ok=(ev_matches(compiler,ev_get(r,1))==1&&ev_matches(input,ev_get(r,2))==1&&ev_matches(context,ev_get(r,3))==1) as i32;}
    ev_fields_free(&r.fields);return ok;
}
