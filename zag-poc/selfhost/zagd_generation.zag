// Stable-mode generation metadata. This registry deliberately has no worker
// loader and no executable payload: it records only linked release identities,
// bounded canary progress, quarantine, and rollback. Foreground compilation is
// always the fallback and remains authoritative when any record is absent,
// stale, truncated, mutated, or inconsistent.
@import("zagd_store.zag")

struct ZagdGenerationRead { text: []u8, valid: i32 }

struct ZagdGenerationManifest {
    identity: ZagdHash,
    parent: ZagdHash,
    search_policy: ZagdHash,
    compiler: []u8,
    verifier: []u8,
    canary_required: i32,
    valid: i32,
}

struct ZagdGenerationPointers {
    current: ZagdHash,
    last_known_good: ZagdHash,
    valid: i32,
}

struct ZagdGenerationCanary {
    generation: ZagdHash,
    predecessor: ZagdHash,
    successes: i32,
    failures: i32,
    consecutive_crashes: i32,
    required_successes: i32,
    session_clean: i32,
    quarantined: i32,
    valid: i32,
}

struct ZagdGenerationTransition {
    pointers: ZagdGenerationPointers,
    canary: ZagdGenerationCanary,
    valid: i32,
    started: i32,
    promoted: i32,
    rolled_back: i32,
}

struct ZagdGenerationRegistry {
    pointers: ZagdGenerationPointers,
    canary: ZagdGenerationCanary,
    selected: ZagdHash,
    last_known_good: ZagdHash,
    builtin: ZagdHash,
    record_valid: i32,
    fallback: i32,
    quarantined: i32,
    execution_enabled: i32,
}

fn zagd_generation_required_successes() i32 { return 3; }
fn zagd_generation_crash_limit() i32 { return 3; }
fn zagd_generation_counter_limit() i32 { return 64; }
fn zagd_generation_verifier() []u8 { return "linked-foreground-validation-v1"; }
fn zagd_generation_builtin_policy() ZagdHash {
    return zagd_content_hash("release-linked-search-policy-v1");
}
fn zagd_generation_bad_hash() ZagdHash {
    return ZagdHash{ .first = 0 - 1, .second = 0 - 1, .bytes = 0 - 1 };
}
fn zagd_generation_hash_valid(value: ZagdHash) i32 {
    return (value.first >= 0 && value.second >= 0 && value.bytes >= 0) as i32;
}
fn zagd_generation_hash_empty(value: ZagdHash) i32 {
    return zagd_hash_equal(value, zagd_hash_empty());
}
fn zagd_generation_parse_bounded(value: []u8, maximum: i64) i64 {
    if (value.len == 0 || maximum < 0) { return 0 - 1; }
    let result: i64 = 0;let i: i32 = 0;
    while (i < value.len) {
        if (value[i] < '0' || value[i] > '9') { return 0 - 1; }
        let digit: i64 = (value[i] as i64) - 48;
        if (digit > maximum || result > (maximum - digit) / 10) { return 0 - 1; }
        result = result * 10 + digit;i = i + 1;
    }
    return result;
}
fn zagd_generation_hash_field(text: []u8, key: []u8) ZagdHash {
    let bad: ZagdHash = zagd_generation_bad_hash();let value: []u8 = zagd_record_value(text, key);
    let tabs: i32 = 0;let i: i32 = 0;
    while (i < value.len) { if (value[i] == '\t') { tabs = tabs + 1; } i = i + 1; }
    if (tabs != 2) { return bad; }
    let first: i64 = zagd_generation_parse_bounded(zstore_tab_field(value, 0), 1000000009);
    let second: i64 = zagd_generation_parse_bounded(zstore_tab_field(value, 1), 1000000009);
    let bytes: i64 = zagd_generation_parse_bounded(zstore_tab_field(value, 2), 2147483647);
    if (first < 0 || second < 0 || bytes < 0) { return bad; }
    return ZagdHash{ .first = first, .second = second, .bytes = bytes };
}
fn zagd_generation_token(value: []u8) i32 {
    if (value.len < 1 || value.len > 128) { return 0; }
    let i: i32 = 0;
    while (i < value.len) {
        if (value[i] < 33 || value[i] > 126 || value[i] == '\t' ||
            value[i] == '\r' || value[i] == '\n') { return 0; }
        i = i + 1;
    }
    return 1;
}
fn zagd_generation_append_hash(out: *ArrayList[u8], value: ZagdHash) void {
    zagd_text_append_i64(out, value.first);zagd_text_append_byte(out, '\t');
    zagd_text_append_i64(out, value.second);zagd_text_append_byte(out, '\t');
    zagd_text_append_i64(out, value.bytes);
}
fn zagd_generation_append_checksum(out: *ArrayList[u8]) void {
    let sum: ZagdHash = zagd_content_hash(out.*.data[0..out.*.len]);
    zagd_text_append(out, "checksum_first=");zagd_text_append_i64(out, sum.first);
    zagd_text_append(out, "\nchecksum_second=");zagd_text_append_i64(out, sum.second);
    zagd_text_append(out, "\nchecksum_bytes=");zagd_text_append_i64(out, sum.bytes);
    zagd_text_append_byte(out, '\n');
}
fn zagd_generation_line_count(text: []u8) i32 {
    let count: i32 = 0;let i: i32 = 0;
    while (i < text.len) { if (text[i] == '\n') { count = count + 1; } i = i + 1; }
    return count;
}
fn zagd_generation_field_offset(text: []u8, key: []u8) i32 {
    let i: i32 = 0;
    while (i + key.len + 1 <= text.len) {
        if (i == 0 || text[i - 1] == '\n') {
            let j: i32 = 0;
            while (j < key.len && text[i + j] == key[j]) { j = j + 1; }
            if (j == key.len && text[i + key.len] == '=') { return i; }
        }
        i = i + 1;
    }
    return 0 - 1;
}
fn zagd_generation_checksum_valid(text: []u8) i32 {
    if (text.len < 1 || text.len > 4096 || zstore_single_field(text, "checksum_first") == 0 ||
        zstore_single_field(text, "checksum_second") == 0 ||
        zstore_single_field(text, "checksum_bytes") == 0 ||
        zstore_final_field(text, "checksum_bytes") == 0) { return 0; }
    let mark: i32 = zagd_find_checksum(text);if (mark < 0) { return 0; }
    let sum: ZagdHash = zagd_content_hash(text[0..mark]);
    return (zagd_generation_parse_bounded(zagd_record_value(text, "checksum_first"), 1000000009) == sum.first &&
        zagd_generation_parse_bounded(zagd_record_value(text, "checksum_second"), 1000000009) == sum.second &&
        zagd_generation_parse_bounded(zagd_record_value(text, "checksum_bytes"), 4096) == sum.bytes) as i32;
}

fn zagd_generation_manifest_bad() ZagdGenerationManifest {
    return ZagdGenerationManifest{ .identity = zagd_generation_bad_hash(),
        .parent = zagd_generation_bad_hash(), .search_policy = zagd_generation_bad_hash(),
        .compiler = "", .verifier = "", .canary_required = 0, .valid = 0 };
}
fn zagd_generation_manifest_encode(compiler: []u8, parent: ZagdHash,
        search_policy: ZagdHash) []u8 {
    if (zagd_generation_token(compiler) == 0 || zagd_generation_hash_valid(parent) == 0 ||
        zagd_generation_hash_valid(search_policy) == 0 || search_policy.bytes == 0) { return ""; }
    let out: ArrayList[u8] = zagd_text(768);
    zagd_text_append(&out, "format=zagd-generation-manifest-v1\ncomplete=true\nadvisory=true\nimmutable=true\ntrust_mode=stable\nexecutable_authority=false\nexecution_payload=none\nsandbox_execution_required=true\nforeground_fallback=true\ncompiler=");
    zagd_text_append(&out, compiler);zagd_text_append(&out, "\nverifier=");
    zagd_text_append(&out, zagd_generation_verifier());zagd_text_append(&out, "\nparent_identity=");
    zagd_generation_append_hash(&out, parent);zagd_text_append(&out, "\nsearch_policy_identity=");
    zagd_generation_append_hash(&out, search_policy);
    zagd_text_append(&out, "\ncanary_required=3\nidentity_basis=all-prior-manifest-fields-v1\n");
    let identity: ZagdHash = zagd_content_hash(out.data[0..out.len]);
    zagd_text_append(&out, "generation_identity=");zagd_generation_append_hash(&out, identity);
    zagd_text_append_byte(&out, '\n');zagd_generation_append_checksum(&out);
    return out.data[0..out.len];
}
fn zagd_generation_manifest_decode(text: []u8) ZagdGenerationManifest {
    let bad: ZagdGenerationManifest = zagd_generation_manifest_bad();
    if (zagd_generation_line_count(text) != 19 || zagd_generation_checksum_valid(text) == 0 ||
        !@strEq(zagd_record_value(text, "format"), "zagd-generation-manifest-v1") ||
        !@strEq(zagd_record_value(text, "complete"), "true") ||
        !@strEq(zagd_record_value(text, "advisory"), "true") ||
        !@strEq(zagd_record_value(text, "immutable"), "true") ||
        !@strEq(zagd_record_value(text, "trust_mode"), "stable") ||
        !@strEq(zagd_record_value(text, "executable_authority"), "false") ||
        !@strEq(zagd_record_value(text, "execution_payload"), "none") ||
        !@strEq(zagd_record_value(text, "sandbox_execution_required"), "true") ||
        !@strEq(zagd_record_value(text, "foreground_fallback"), "true") ||
        !@strEq(zagd_record_value(text, "verifier"), zagd_generation_verifier()) ||
        !@strEq(zagd_record_value(text, "identity_basis"), "all-prior-manifest-fields-v1")) { return bad; }
    if (zstore_single_field(text, "format") == 0 || zstore_single_field(text, "complete") == 0 ||
        zstore_single_field(text, "advisory") == 0 || zstore_single_field(text, "immutable") == 0 ||
        zstore_single_field(text, "trust_mode") == 0 || zstore_single_field(text, "executable_authority") == 0 ||
        zstore_single_field(text, "execution_payload") == 0 || zstore_single_field(text, "sandbox_execution_required") == 0 ||
        zstore_single_field(text, "foreground_fallback") == 0 || zstore_single_field(text, "compiler") == 0 ||
        zstore_single_field(text, "verifier") == 0 || zstore_single_field(text, "parent_identity") == 0 ||
        zstore_single_field(text, "search_policy_identity") == 0 || zstore_single_field(text, "canary_required") == 0 ||
        zstore_single_field(text, "identity_basis") == 0 || zstore_single_field(text, "generation_identity") == 0) { return bad; }
    let compiler: []u8 = zagd_record_value(text, "compiler");
    let parent: ZagdHash = zagd_generation_hash_field(text, "parent_identity");
    let policy: ZagdHash = zagd_generation_hash_field(text, "search_policy_identity");
    let identity: ZagdHash = zagd_generation_hash_field(text, "generation_identity");
    let required: i64 = zagd_generation_parse_bounded(zagd_record_value(text, "canary_required"), 64);
    let identity_at: i32 = zagd_generation_field_offset(text, "generation_identity");
    if (zagd_generation_token(compiler) == 0 || zagd_generation_hash_valid(parent) == 0 ||
        zagd_generation_hash_valid(policy) == 0 || policy.bytes == 0 ||
        zagd_generation_hash_valid(identity) == 0 || identity.bytes == 0 ||
        required != zagd_generation_required_successes() || identity_at < 0 ||
        zagd_hash_equal(identity, parent) == 1 ||
        zagd_hash_equal(identity, zagd_content_hash(text[0..identity_at])) == 0) { return bad; }
    return ZagdGenerationManifest{ .identity = identity, .parent = parent,
        .search_policy = policy, .compiler = compiler,
        .verifier = zagd_record_value(text, "verifier"),
        .canary_required = required as i32, .valid = 1 };
}
fn zagd_generation_manifest_compatible(text: []u8, compiler: []u8) ZagdGenerationManifest {
    let manifest: ZagdGenerationManifest = zagd_generation_manifest_decode(text);
    if (manifest.valid == 0 || !@strEq(manifest.compiler, compiler)) { manifest.valid = 0; }
    return manifest;
}

fn zagd_generation_pointers_bad() ZagdGenerationPointers {
    return ZagdGenerationPointers{ .current = zagd_generation_bad_hash(),
        .last_known_good = zagd_generation_bad_hash(), .valid = 0 };
}
fn zagd_generation_pointers_value_valid(value: ZagdGenerationPointers) i32 {
    return (value.valid == 1 && zagd_generation_hash_valid(value.current) == 1 &&
        zagd_generation_hash_valid(value.last_known_good) == 1 && value.current.bytes > 0 &&
        value.last_known_good.bytes > 0) as i32;
}
fn zagd_generation_pointers_encode(value: ZagdGenerationPointers) []u8 {
    if (zagd_generation_pointers_value_valid(value) == 0) { return ""; }
    let out: ArrayList[u8] = zagd_text(512);
    zagd_text_append(&out, "format=zagd-generation-pointers-v1\ncomplete=true\nadvisory=true\nexecutable_authority=false\ntrust_mode=stable\ncurrent=");
    zagd_generation_append_hash(&out, value.current);zagd_text_append(&out, "\nlast_known_good=");
    zagd_generation_append_hash(&out, value.last_known_good);
    zagd_text_append(&out, "\npredecessor_retained=true\nforeground_fallback=true\ngeneration_execution=disabled\n");
    zagd_generation_append_checksum(&out);return out.data[0..out.len];
}
fn zagd_generation_pointers_decode(text: []u8) ZagdGenerationPointers {
    let bad: ZagdGenerationPointers = zagd_generation_pointers_bad();
    if (zagd_generation_line_count(text) != 13 || zagd_generation_checksum_valid(text) == 0 ||
        !@strEq(zagd_record_value(text, "format"), "zagd-generation-pointers-v1") ||
        !@strEq(zagd_record_value(text, "complete"), "true") ||
        !@strEq(zagd_record_value(text, "advisory"), "true") ||
        !@strEq(zagd_record_value(text, "executable_authority"), "false") ||
        !@strEq(zagd_record_value(text, "trust_mode"), "stable") ||
        !@strEq(zagd_record_value(text, "predecessor_retained"), "true") ||
        !@strEq(zagd_record_value(text, "foreground_fallback"), "true") ||
        !@strEq(zagd_record_value(text, "generation_execution"), "disabled")) { return bad; }
    if (zstore_single_field(text, "format") == 0 || zstore_single_field(text, "complete") == 0 ||
        zstore_single_field(text, "advisory") == 0 || zstore_single_field(text, "executable_authority") == 0 ||
        zstore_single_field(text, "trust_mode") == 0 || zstore_single_field(text, "current") == 0 ||
        zstore_single_field(text, "last_known_good") == 0 || zstore_single_field(text, "predecessor_retained") == 0 ||
        zstore_single_field(text, "foreground_fallback") == 0 || zstore_single_field(text, "generation_execution") == 0) { return bad; }
    let current: ZagdHash = zagd_generation_hash_field(text, "current");
    let lkg: ZagdHash = zagd_generation_hash_field(text, "last_known_good");
    if (zagd_generation_hash_valid(current) == 0 || zagd_generation_hash_valid(lkg) == 0 ||
        current.bytes == 0 || lkg.bytes == 0) { return bad; }
    return ZagdGenerationPointers{ .current = current, .last_known_good = lkg, .valid = 1 };
}

fn zagd_generation_canary_bad() ZagdGenerationCanary {
    return ZagdGenerationCanary{ .generation = zagd_generation_bad_hash(),
        .predecessor = zagd_generation_bad_hash(), .successes = 0, .failures = 0,
        .consecutive_crashes = 0, .required_successes = 0, .session_clean = 0,
        .quarantined = 0, .valid = 0 };
}
fn zagd_generation_canary_value_valid(value: ZagdGenerationCanary) i32 {
    let limit: i32 = zagd_generation_counter_limit();
    if (value.valid != 1 || zagd_generation_hash_valid(value.generation) == 0 ||
        zagd_generation_hash_valid(value.predecessor) == 0 || value.generation.bytes == 0 ||
        value.successes < 0 || value.successes > limit || value.failures < 0 || value.failures > limit ||
        value.consecutive_crashes < 0 || value.consecutive_crashes > value.failures ||
        value.consecutive_crashes > limit || value.required_successes != zagd_generation_required_successes() ||
        (value.session_clean != 0 && value.session_clean != 1) ||
        (value.quarantined != 0 && value.quarantined != 1) ||
        (value.quarantined == 1 && (value.consecutive_crashes < zagd_generation_crash_limit() ||
        value.session_clean != 1))) { return 0; }
    return 1;
}
fn zagd_generation_canary_encode(value: ZagdGenerationCanary) []u8 {
    if (zagd_generation_canary_value_valid(value) == 0) { return ""; }
    let out: ArrayList[u8] = zagd_text(640);
    zagd_text_append(&out, "format=zagd-generation-canary-v1\ncomplete=true\nadvisory=true\nexecutable_authority=false\ntrust_mode=stable\ngeneration=");
    zagd_generation_append_hash(&out, value.generation);zagd_text_append(&out, "\npredecessor=");
    zagd_generation_append_hash(&out, value.predecessor);zagd_text_append(&out, "\nsuccesses=");
    zagd_text_append_i64(&out, value.successes);zagd_text_append(&out, "\nfailures=");
    zagd_text_append_i64(&out, value.failures);zagd_text_append(&out, "\nconsecutive_crashes=");
    zagd_text_append_i64(&out, value.consecutive_crashes);zagd_text_append(&out, "\nrequired_successes=");
    zagd_text_append_i64(&out, value.required_successes);zagd_text_append(&out, "\nsession_clean=");
    zagd_text_append_i64(&out, value.session_clean);zagd_text_append(&out, "\nquarantined=");
    zagd_text_append_i64(&out, value.quarantined);
    zagd_text_append(&out, "\nforeground_fallback=true\ngeneration_execution=disabled\n");
    zagd_generation_append_checksum(&out);return out.data[0..out.len];
}
fn zagd_generation_canary_decode(text: []u8) ZagdGenerationCanary {
    let bad: ZagdGenerationCanary = zagd_generation_canary_bad();
    if (zagd_generation_line_count(text) != 18 || zagd_generation_checksum_valid(text) == 0 ||
        !@strEq(zagd_record_value(text, "format"), "zagd-generation-canary-v1") ||
        !@strEq(zagd_record_value(text, "complete"), "true") ||
        !@strEq(zagd_record_value(text, "advisory"), "true") ||
        !@strEq(zagd_record_value(text, "executable_authority"), "false") ||
        !@strEq(zagd_record_value(text, "trust_mode"), "stable") ||
        !@strEq(zagd_record_value(text, "foreground_fallback"), "true") ||
        !@strEq(zagd_record_value(text, "generation_execution"), "disabled")) { return bad; }
    if (zstore_single_field(text, "format") == 0 || zstore_single_field(text, "complete") == 0 ||
        zstore_single_field(text, "advisory") == 0 || zstore_single_field(text, "executable_authority") == 0 ||
        zstore_single_field(text, "trust_mode") == 0 || zstore_single_field(text, "generation") == 0 ||
        zstore_single_field(text, "predecessor") == 0 || zstore_single_field(text, "successes") == 0 ||
        zstore_single_field(text, "failures") == 0 || zstore_single_field(text, "consecutive_crashes") == 0 ||
        zstore_single_field(text, "required_successes") == 0 || zstore_single_field(text, "session_clean") == 0 ||
        zstore_single_field(text, "quarantined") == 0 || zstore_single_field(text, "foreground_fallback") == 0 ||
        zstore_single_field(text, "generation_execution") == 0) { return bad; }
    let generation: ZagdHash = zagd_generation_hash_field(text, "generation");
    let predecessor: ZagdHash = zagd_generation_hash_field(text, "predecessor");
    let successes: i64 = zagd_generation_parse_bounded(zagd_record_value(text, "successes"), 64);
    let failures: i64 = zagd_generation_parse_bounded(zagd_record_value(text, "failures"), 64);
    let crashes: i64 = zagd_generation_parse_bounded(zagd_record_value(text, "consecutive_crashes"), 64);
    let required: i64 = zagd_generation_parse_bounded(zagd_record_value(text, "required_successes"), 64);
    let clean: i64 = zagd_generation_parse_bounded(zagd_record_value(text, "session_clean"), 1);
    let quarantined: i64 = zagd_generation_parse_bounded(zagd_record_value(text, "quarantined"), 1);
    let limit: i64 = zagd_generation_counter_limit() as i64;
    if (zagd_generation_hash_valid(generation) == 0 || zagd_generation_hash_valid(predecessor) == 0 ||
        generation.bytes == 0 || successes < 0 || successes > limit || failures < 0 || failures > limit ||
        crashes < 0 || crashes > failures || crashes > limit || required != zagd_generation_required_successes() ||
        (clean != 0 && clean != 1) || (quarantined != 0 && quarantined != 1) ||
        (quarantined == 1 && (crashes < zagd_generation_crash_limit() || clean != 1))) { return bad; }
    return ZagdGenerationCanary{ .generation = generation, .predecessor = predecessor,
        .successes = successes as i32, .failures = failures as i32,
        .consecutive_crashes = crashes as i32, .required_successes = required as i32,
        .session_clean = clean as i32, .quarantined = quarantined as i32, .valid = 1 };
}

fn zagd_generation_transition_bad(pointers: ZagdGenerationPointers,
        canary: ZagdGenerationCanary) ZagdGenerationTransition {
    return ZagdGenerationTransition{ .pointers = pointers, .canary = canary,
        .valid = 0, .started = 0, .promoted = 0, .rolled_back = 0 };
}
fn zagd_generation_begin_session(pointers: ZagdGenerationPointers,
        canary: ZagdGenerationCanary) ZagdGenerationTransition {
    let out: ZagdGenerationTransition = ZagdGenerationTransition{ .pointers = pointers,
        .canary = canary, .valid = 1, .started = 0, .promoted = 0, .rolled_back = 0 };
    if (zagd_generation_pointers_value_valid(pointers) == 0 ||
        zagd_generation_canary_value_valid(canary) == 0 || canary.quarantined == 1) {
        return zagd_generation_transition_bad(pointers, canary);
    }
    if (zagd_hash_equal(pointers.current, pointers.last_known_good) == 1) {
        if (zagd_hash_equal(canary.generation, pointers.current) == 0 ||
            canary.successes < canary.required_successes) {
            return zagd_generation_transition_bad(pointers, canary);
        }
        out.canary.session_clean = 0;out.started = 1;return out;
    }
    if (zagd_hash_equal(canary.generation, pointers.current) == 0 ||
        zagd_hash_equal(canary.predecessor, pointers.last_known_good) == 0 ||
        canary.successes >= canary.required_successes) {
        return zagd_generation_transition_bad(pointers, canary);
    }
    if (canary.session_clean == 0) {
        if (out.canary.failures < zagd_generation_counter_limit()) { out.canary.failures = out.canary.failures + 1; }
        if (out.canary.consecutive_crashes < zagd_generation_counter_limit()) {
            out.canary.consecutive_crashes = out.canary.consecutive_crashes + 1;
        }
        if (out.canary.consecutive_crashes >= zagd_generation_crash_limit()) {
            out.canary.quarantined = 1;out.canary.session_clean = 1;
            out.pointers.current = out.canary.predecessor;
            out.pointers.last_known_good = out.canary.predecessor;
            out.rolled_back = 1;return out;
        }
    }
    out.canary.session_clean = 0;out.started = 1;return out;
}
fn zagd_generation_finish_session(pointers: ZagdGenerationPointers,
        canary: ZagdGenerationCanary) ZagdGenerationTransition {
    let out: ZagdGenerationTransition = ZagdGenerationTransition{ .pointers = pointers,
        .canary = canary, .valid = 1, .started = 0, .promoted = 0, .rolled_back = 0 };
    if (zagd_generation_pointers_value_valid(pointers) == 0 ||
        zagd_generation_canary_value_valid(canary) == 0 || canary.quarantined == 1 ||
        canary.session_clean != 0 || zagd_hash_equal(canary.generation, pointers.current) == 0) {
        return zagd_generation_transition_bad(pointers, canary);
    }
    out.canary.session_clean = 1;out.canary.consecutive_crashes = 0;
    if (zagd_hash_equal(pointers.current, pointers.last_known_good) == 1) {
        if (canary.successes < canary.required_successes) {
            return zagd_generation_transition_bad(pointers, canary);
        }
        return out;
    }
    if (zagd_hash_equal(canary.predecessor, pointers.last_known_good) == 0 ||
        canary.successes >= canary.required_successes) {
        return zagd_generation_transition_bad(pointers, canary);
    }
    if (out.canary.successes < zagd_generation_counter_limit()) { out.canary.successes = out.canary.successes + 1; }
    if (out.canary.successes >= out.canary.required_successes) {
        out.pointers.last_known_good = out.pointers.current;out.promoted = 1;
    }
    return out;
}

fn zagd_generation_cache_dir(root: []u8) []u8 {
    let base: []u8 = zagd_join_path(root, ".zag-cache");
    let dir: []u8 = zagd_join_path(base, "zagd");zagd_text_free(base);return dir;
}
fn zagd_generation_ensure_dir(root: []u8) i32 {
    let base: []u8 = zagd_join_path(root, ".zag-cache");
    if (zagd_store_mkdir(base) == 0 || zagd_path_is_directory(base) == 0) { zagd_text_free(base);return 0; }
    let dir: []u8 = zagd_join_path(base, "zagd");
    let ok: i32 = zagd_store_mkdir(dir) * zagd_path_is_directory(dir);
    zagd_text_free(dir);zagd_text_free(base);return ok;
}
fn zagd_generation_manifest_path(root: []u8, identity: ZagdHash) []u8 {
    if (zagd_generation_hash_valid(identity) == 0 || identity.bytes == 0) { return ""; }
    let name: ArrayList[u8] = zagd_text(128);zagd_text_append(&name, "generation-");
    zagd_text_append_i64(&name, identity.first);zagd_text_append_byte(&name, '-');
    zagd_text_append_i64(&name, identity.second);zagd_text_append_byte(&name, '-');
    zagd_text_append_i64(&name, identity.bytes);zagd_text_append(&name, ".manifest");
    let dir: []u8 = zagd_generation_cache_dir(root);
    let path: []u8 = zagd_join_path(dir, name.data[0..name.len]);
    free[u8](&name);zagd_text_free(dir);return path;
}
fn zagd_generation_record_path(root: []u8, name: []u8) []u8 {
    let dir: []u8 = zagd_generation_cache_dir(root);
    let path: []u8 = zagd_join_path(dir, name);zagd_text_free(dir);return path;
}
fn zagd_generation_write_new(path: []u8, payload: []u8) i32 {
    let cpath: ArrayList[u8] = zagd_c_string(path);
    let fd: i64 = _zag_raw_syscall(zagd_sys_openat(), zagd_at_fdcwd(),
        zagd_ptr(cpath.data[0..cpath.len]), 655553, 384, 0, 0);
    free[u8](&cpath);if (fd < 0) { return 0; }
    let offset: i32 = 0;let ok: i32 = 1;
    while (offset < payload.len) {
        let wrote: i64 = _zag_raw_syscall(1, fd, zagd_ptr(payload[offset..payload.len]),
            payload.len - offset, 0, 0, 0);
        if (wrote == (0 - 4)) { continue; }
        if (wrote <= 0) { ok = 0;break; }
        offset = offset + (wrote as i32);
    }
    if (ok == 1 && _zag_raw_syscall(74, fd, 0, 0, 0, 0, 0) != 0) { ok = 0; }
    zagd_close(fd);if (ok == 0) { zagd_unlink(path); }return ok;
}
fn zagd_generation_read_bounded(path: []u8, maximum: i32) ZagdGenerationRead {
    let bad: ZagdGenerationRead = ZagdGenerationRead{ .text = "", .valid = 0 };
    if (path.len == 0 || maximum < 1 || maximum > 4096) { return bad; }
    let cpath: ArrayList[u8] = zagd_c_string(path);
    // O_RDONLY|O_NONBLOCK|O_NOFOLLOW|O_CLOEXEC. O_NONBLOCK prevents a raced
    // replacement with a FIFO/device from wedging the standalone checker; the
    // fd-level fstat below still requires a regular file before reading.
    let fd: i64 = _zag_raw_syscall(zagd_sys_openat(), zagd_at_fdcwd(),
        zagd_ptr(cpath.data[0..cpath.len]), 657408, 0, 0, 0);
    free[u8](&cpath);if (fd < 0) { return bad; }
    let stat: ArrayList[u8] = make[u8](144);while (stat.len < 144) { push[u8](&stat, 0); }
    let stat_rc: i64 = _zag_raw_syscall(5, fd, zagd_ptr(stat.data[0..stat.len]), 0, 0, 0, 0);
    let regular: i32 = 0;
    if (stat_rc == 0) { regular = ((zagd_u32_at(stat.data[0..stat.len], 24) / 4096) == 8) as i32; }
    free[u8](&stat);if (regular == 0) { zagd_close(fd);return bad; }
    let bytes: ArrayList[u8] = make[u8](maximum + 1);
    while (bytes.len < maximum + 1) { push[u8](&bytes, 0); }
    let total: i32 = 0;let ok: i32 = 1;let reading: i32 = 1;
    while (reading == 1 && total <= maximum) {
        let got: i64 = _zag_raw_syscall(zagd_sys_read(), fd,
            zagd_ptr(bytes.data[total..maximum + 1]), maximum + 1 - total, 0, 0, 0);
        if (got == (0 - 4)) { continue; }
        if (got < 0) { ok = 0;reading = 0; }
        else if (got == 0) { reading = 0; }
        else { total = total + (got as i32);if (total > maximum) { ok = 0;reading = 0; } }
    }
    zagd_close(fd);
    if (ok == 0) { free[u8](&bytes);return bad; }
    return ZagdGenerationRead{ .text = bytes.data[0..total], .valid = 1 };
}
fn zagd_generation_read_free(value: ZagdGenerationRead) void {
    if (value.valid == 1) { _zag_free(_zag_slice_ptr(value.text)); }
}
fn zagd_generation_write_immutable(path: []u8, payload: []u8) i32 {
    if (path.len == 0 || payload.len == 0 || payload.len > 4096) { return 0; }
    if (zagd_generation_write_new(path, payload) == 1) { return 1; }
    let prior: ZagdGenerationRead = zagd_generation_read_bounded(path, 4096);
    let same: i32 = 0;if (prior.valid == 1) { same = @strEq(prior.text, payload) as i32; }
    zagd_generation_read_free(prior);
    return same;
}
fn zagd_generation_replace(path: []u8, payload: []u8) i32 {
    if (path.len == 0 || payload.len == 0 || payload.len > 4096) { return 0; }
    let temp: []u8 = _zag_str_concat(path, ".tmp");zagd_unlink(temp);
    if (zagd_generation_write_new(temp, payload) == 0) { zagd_text_free(temp);return 0; }
    let a: ArrayList[u8] = zagd_c_string(temp);let b: ArrayList[u8] = zagd_c_string(path);
    let rc: i64 = _zag_raw_syscall(zagd_sys_rename(), zagd_ptr(a.data[0..a.len]),
        zagd_ptr(b.data[0..b.len]), 0, 0, 0, 0);
    free[u8](&b);free[u8](&a);if (rc != 0) { zagd_unlink(temp); }
    zagd_text_free(temp);return (rc == 0) as i32;
}
fn zagd_generation_install_manifest(root: []u8, text: []u8) i32 {
    let manifest: ZagdGenerationManifest = zagd_generation_manifest_decode(text);
    if (manifest.valid == 0 || zagd_generation_ensure_dir(root) == 0) { return 0; }
    let path: []u8 = zagd_generation_manifest_path(root, manifest.identity);
    let written: i32 = zagd_generation_write_immutable(path, text);
    zagd_text_free(path);return written;
}
fn zagd_generation_manifest_on_disk(root: []u8, identity: ZagdHash,
        compiler: []u8, parent: *ZagdHash, search_policy: *ZagdHash) i32 {
    let path: []u8 = zagd_generation_manifest_path(root, identity);
    if (path.len == 0) { return 0; }
    let text: ZagdGenerationRead = zagd_generation_read_bounded(path, 4096);let valid: i32 = 0;
    if (text.valid == 1) {
        let manifest: ZagdGenerationManifest = zagd_generation_manifest_compatible(text.text, compiler);
        valid = (manifest.valid == 1 && zagd_hash_equal(manifest.identity, identity) == 1) as i32;
        if (valid == 1) { parent.* = manifest.parent;search_policy.* = manifest.search_policy; }
    }
    zagd_generation_read_free(text);
    zagd_text_free(path);return valid;
}
fn zagd_generation_builtin_identity(compiler: []u8) ZagdHash {
    let text: []u8 = zagd_generation_manifest_encode(compiler, zagd_hash_empty(),
        zagd_generation_builtin_policy());
    if (text.len == 0) { return zagd_generation_bad_hash(); }
    let identity: ZagdHash = zagd_generation_manifest_decode(text).identity;
    zagd_text_free(text);return identity;
}
fn zagd_generation_default_pointers(builtin: ZagdHash) ZagdGenerationPointers {
    return ZagdGenerationPointers{ .current = builtin, .last_known_good = builtin, .valid = 1 };
}
fn zagd_generation_default_canary(builtin: ZagdHash) ZagdGenerationCanary {
    return ZagdGenerationCanary{ .generation = builtin, .predecessor = zagd_hash_empty(),
        .successes = zagd_generation_required_successes(), .failures = 0,
        .consecutive_crashes = 0, .required_successes = zagd_generation_required_successes(),
        .session_clean = 1, .quarantined = 0, .valid = 1 };
}
fn zagd_generation_registry_fallback(compiler: []u8) ZagdGenerationRegistry {
    let builtin: ZagdHash = zagd_generation_builtin_identity(compiler);
    let pointers: ZagdGenerationPointers = zagd_generation_default_pointers(builtin);
    let canary: ZagdGenerationCanary = zagd_generation_default_canary(builtin);
    return ZagdGenerationRegistry{ .pointers = pointers, .canary = canary,
        .selected = builtin, .last_known_good = builtin, .builtin = builtin,
        .record_valid = 0, .fallback = 1, .quarantined = 0,
        .execution_enabled = 0 };
}
fn zagd_generation_persist(root: []u8, pointers: ZagdGenerationPointers,
        canary: ZagdGenerationCanary) i32 {
    let ptext: []u8 = zagd_generation_pointers_encode(pointers);
    let ctext: []u8 = zagd_generation_canary_encode(canary);
    if (ptext.len == 0 || ctext.len == 0 || zagd_generation_ensure_dir(root) == 0) {
        if (ptext.len > 0) { zagd_text_free(ptext); }if (ctext.len > 0) { zagd_text_free(ctext); }return 0;
    }
    let ppath: []u8 = zagd_generation_record_path(root, "generation-pointers.record");
    let cpath: []u8 = zagd_generation_record_path(root, "generation-canary.record");
    // Canary first: a crash before the pointer replace yields an inconsistent
    // pair and therefore a linked foreground fallback, never a new authority.
    let ok: i32 = zagd_generation_replace(cpath, ctext);
    if (ok == 1) { ok = zagd_generation_replace(ppath, ptext); }
    zagd_text_free(cpath);zagd_text_free(ppath);zagd_text_free(ctext);zagd_text_free(ptext);return ok;
}
fn zagd_generation_load(root: []u8, compiler: []u8) ZagdGenerationRegistry {
    let fallback: ZagdGenerationRegistry = zagd_generation_registry_fallback(compiler);
    if (zagd_generation_hash_valid(fallback.builtin) == 0) { return fallback; }
    let ppath: []u8 = zagd_generation_record_path(root, "generation-pointers.record");
    let cpath: []u8 = zagd_generation_record_path(root, "generation-canary.record");
    let ptext: ZagdGenerationRead = zagd_generation_read_bounded(ppath, 4096);
    let ctext: ZagdGenerationRead = zagd_generation_read_bounded(cpath, 4096);
    zagd_text_free(cpath);zagd_text_free(ppath);
    if (ptext.valid == 0 || ctext.valid == 0) {
        zagd_generation_read_free(ptext);zagd_generation_read_free(ctext);return fallback;
    }
    let pointers: ZagdGenerationPointers = zagd_generation_pointers_decode(ptext.text);
    let canary: ZagdGenerationCanary = zagd_generation_canary_decode(ctext.text);
    zagd_generation_read_free(ctext);zagd_generation_read_free(ptext);
    let current_parent: ZagdHash = zagd_generation_bad_hash();
    let current_policy: ZagdHash = zagd_generation_bad_hash();
    let lkg_parent: ZagdHash = zagd_generation_bad_hash();
    let lkg_policy: ZagdHash = zagd_generation_bad_hash();
    if (pointers.valid == 0 || canary.valid == 0 ||
        zagd_generation_manifest_on_disk(root, pointers.current, compiler,
            &current_parent, &current_policy) == 0 ||
        zagd_generation_manifest_on_disk(root, pointers.last_known_good, compiler,
            &lkg_parent, &lkg_policy) == 0) { return fallback; }
    if (zagd_hash_equal(pointers.last_known_good, fallback.builtin) == 1 &&
        (zagd_generation_hash_empty(lkg_parent) == 0 ||
        zagd_hash_equal(lkg_policy, zagd_generation_builtin_policy()) == 0)) { return fallback; }
    let quarantined: i32 = canary.quarantined;
    if (quarantined == 1) {
        let rejected_parent: ZagdHash = zagd_generation_bad_hash();
        let rejected_policy: ZagdHash = zagd_generation_bad_hash();
        if (zagd_hash_equal(pointers.current, pointers.last_known_good) == 0 ||
            zagd_hash_equal(pointers.current, canary.predecessor) == 0 ||
            zagd_hash_equal(canary.generation, pointers.current) == 1 ||
            zagd_generation_manifest_on_disk(root, canary.generation, compiler,
                &rejected_parent, &rejected_policy) == 0 ||
            zagd_hash_equal(rejected_parent, canary.predecessor) == 0) { return fallback; }
    } else if (zagd_hash_equal(pointers.current, pointers.last_known_good) == 0) {
        if (zagd_hash_equal(canary.generation, pointers.current) == 0 ||
            zagd_hash_equal(canary.predecessor, pointers.last_known_good) == 0 ||
            zagd_hash_equal(current_parent, canary.predecessor) == 0 ||
            canary.successes >= canary.required_successes) { return fallback; }
    } else {
        if (zagd_hash_equal(canary.generation, pointers.current) == 0 ||
            canary.successes < canary.required_successes ||
            zagd_hash_equal(current_parent, canary.predecessor) == 0) { return fallback; }
        if (zagd_generation_hash_empty(canary.predecessor) == 0) {
            let predecessor_parent: ZagdHash = zagd_generation_bad_hash();
            let predecessor_policy: ZagdHash = zagd_generation_bad_hash();
            if (zagd_generation_manifest_on_disk(root, canary.predecessor, compiler,
                &predecessor_parent, &predecessor_policy) == 0) { return fallback; }
        }
    }
    return ZagdGenerationRegistry{ .pointers = pointers, .canary = canary,
        .selected = pointers.current, .last_known_good = pointers.last_known_good,
        .builtin = fallback.builtin, .record_valid = 1, .fallback = quarantined,
        .quarantined = quarantined, .execution_enabled = 0 };
}
fn zagd_generation_initialize_stable(root: []u8, compiler: []u8) ZagdGenerationRegistry {
    let fallback: ZagdGenerationRegistry = zagd_generation_registry_fallback(compiler);
    if (zagd_generation_hash_valid(fallback.builtin) == 0 ||
        zagd_generation_ensure_dir(root) == 0) { return fallback; }
    let manifest_text: []u8 = zagd_generation_manifest_encode(compiler, zagd_hash_empty(),
        zagd_generation_builtin_policy());
    if (manifest_text.len == 0 || zagd_generation_install_manifest(root, manifest_text) == 0) {
        if (manifest_text.len > 0) { zagd_text_free(manifest_text); }return fallback;
    }
    zagd_text_free(manifest_text);
    let loaded: ZagdGenerationRegistry = zagd_generation_load(root, compiler);
    if (loaded.record_valid == 1) { return loaded; }
    if (zagd_generation_persist(root, fallback.pointers, fallback.canary) == 0) { return fallback; }
    return zagd_generation_load(root, compiler);
}
fn zagd_generation_prepare_stable(root: []u8, compiler: []u8) ZagdGenerationRegistry {
    let loaded: ZagdGenerationRegistry = zagd_generation_initialize_stable(root, compiler);
    if (loaded.record_valid == 0 || loaded.quarantined == 1) { return loaded; }
    let transition: ZagdGenerationTransition = zagd_generation_begin_session(loaded.pointers, loaded.canary);
    if (transition.valid == 0 || zagd_generation_persist(root, transition.pointers, transition.canary) == 0) {
        return zagd_generation_registry_fallback(compiler);
    }
    return zagd_generation_load(root, compiler);
}
fn zagd_generation_finish_stable(root: []u8, compiler: []u8) ZagdGenerationRegistry {
    let loaded: ZagdGenerationRegistry = zagd_generation_load(root, compiler);
    if (loaded.record_valid == 0 || loaded.quarantined == 1) { return loaded; }
    let transition: ZagdGenerationTransition = zagd_generation_finish_session(loaded.pointers, loaded.canary);
    if (transition.valid == 0 || zagd_generation_persist(root, transition.pointers, transition.canary) == 0) {
        return zagd_generation_registry_fallback(compiler);
    }
    return zagd_generation_load(root, compiler);
}
