    ok=ok&zdl_field_i64(p,cap,&n,"module_count",e.modules.len);ok=ok&zdl_field_i64(p,cap,&n,"import_count",e.imports.len);ok=ok&zdl_field_i64(p,cap,&n,"resource_count",e.resources.len);
    ok=ok&zdl_field_i64(p,cap,&n,"ast_origin_count",e.ast_origins.len);ok=ok&zdl_field_i64(p,cap,&n,"derived_segment_count",e.derived_segments.len);ok=ok&zdl_field_i64(p,cap,&n,"choice_count",e.choices.len);ok=ok&zdl_field_i64(p,cap,&n,"transform_count",e.transforms.len);ok=ok&zdl_field_i64(p,cap,&n,"compiler_count",e.compilers.len);ok=ok&zdl_field_i64(p,cap,&n,"verifier_count",e.verifiers.len);
