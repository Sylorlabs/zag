        ok=ok&zdl_field_text_i(p,cap,n,"transform_",i,x.name);ok=ok&zdl_field_hash_i(p,cap,n,"transform_input_",i,x.input);ok=ok&zdl_field_hash_i(p,cap,n,"transform_output_",i,x.output);
