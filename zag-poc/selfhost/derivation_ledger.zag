fn zdl_encode_v2(e:ZdlPreparedEvidence)[]u8 @alloc{if(zdl_valid_evidence(e)==0){return zdl_empty_bytes();}return zdl_encode_v2_raw(e);}

fn zdl_decode(text:[]u8)ZdlLedgerView{
    if(text.len<=0){return zdl_bad(0,0);}let fmt:[]u8=zdl_line_value(text,1);
    if(@strEq(fmt,"zagscript-derivation-v1")){if(zdl_fixed_v1_fields_present(text)==0){return zdl_bad(1,1);}return zdl_decode_v1(text);}
    if(@strEq(fmt,"zagscript-derivation-v2")==0){return zdl_bad(0,0);}
    if(zdl_fixed_v2_fields_present(text)==0||zdl_v2_counts_valid(text)==0){return zdl_bad(1,2);}
    let compact_hex:[]u8=zdl_line_value(text,2);let derived_hex:[]u8=zdl_line_value(text,3);let path_hex:[]u8=zdl_line_value(text,4);
    if(compact_hex.len==0||derived_hex.len==0||path_hex.len==0){return zdl_bad(1,2);}
    let compact:[]u8=zdl_hex_decode(compact_hex,zdl_max_source_bytes());let derived:[]u8=zdl_hex_decode(derived_hex,zdl_max_source_bytes());let path:[]u8=zdl_hex_decode(path_hex,1048576);
    let ch:ZagdHash=zdl_parse_hash(zdl_line_value(text,5));let dh:ZagdHash=zdl_parse_hash(zdl_line_value(text,6));let gh:ZagdHash=zdl_parse_hash(zdl_line_value(text,7));let semantic_bytes:[]u8=zdl_hex_decode(zdl_named_value(text,"semantic_manifest_hex"),zdl_max_source_bytes());let smh:ZagdHash=zagd_content_hash(semantic_bytes);let smh_claim:ZagdHash=zdl_parse_hash(zdl_named_value(text,"semantic_manifest_hash"));
    let expected:ZagdHash=zdl_parse_hash(zdl_line_value(text,8));let actual_compact:ZagdHash=zagd_content_hash(compact);let actual_derived:ZagdHash=zagd_content_hash(derived);
    let valid:i32=(compact.len>0&&derived.len>0&&path.len>0&&semantic_bytes.len>0&&zdl_hash_valid(ch)==1&&zdl_hash_valid(dh)==1&&zdl_hash_valid(gh)==1&&zdl_hash_valid(smh)==1&&zdl_hash_valid(smh_claim)==1&&zdl_hash_same(smh,smh_claim)==1&&zdl_hash_valid(expected)==1&&zdl_hash_same(ch,actual_compact)==1&&zdl_hash_same(dh,actual_derived)==1&&zdl_record_checksum_valid(text)==1) as i32;
