// Ownership-safe, bounded derivation ledger codec.
// The encoder owns its output and the decoder allocates independent compact /
// derived snapshots. All parser views are borrowed only inside the decoder;
// no decoded slice points into a temporary buffer. The focused
// decoder checks bounded raw bytes, required fixed-field uniqueness, and the
// record checksum, indexed-section cardinality, and contiguous origin-span
// coverage. Semantic binding of those records to a prepared compiler snapshot
// remains part of the unavailable foreground integration boundary. This is
// not an independent proof.

@import("zagd.zag")
@import("../std/list.zag")

fn zdl_max_record_bytes()i64{return 67108864;}
fn zdl_max_source_bytes()i64{return 8388608;}
fn zdl_max_bound_bytes()i64{return 268435456;}
fn zdl_max_modules()i64{return 4096;}
fn zdl_max_imports()i64{return 16384;}
fn zdl_max_resources()i64{return 4096;}
fn zdl_max_ast_origins()i64{return 262144;}
fn zdl_max_derived_segments()i64{return 131072;}
fn zdl_max_choices()i64{return 64;}
fn zdl_max_transforms()i64{return 32;}
fn zdl_max_generations()i64{return 8;}

struct ZdlModuleEvidence { path:[]u8, source:[]u8 }
struct ZdlImportEvidence { importer:[]u8, imported:[]u8 }
struct ZdlResourceEvidence { path:[]u8, data:[]u8 }
struct ZdlAstOriginEvidence { module:[]u8, stable_id:i64, node_kind:i32, line:i32, col:i32, byte_start:i32, byte_end:i32, exact:i32 }
struct ZdlDerivedSegmentEvidence { derived_start:i32, derived_end:i32, module:[]u8, source:ZagdHash, source_start:i32, source_end:i32, origin_id:i64, origin_domain:[]u8, exact:i32, generated:i32, basis:[]u8 }
struct ZdlChoiceEvidence { name:[]u8, value:[]u8, basis:[]u8 }
struct ZdlTransformEvidence { name:[]u8, input:ZagdHash, output:ZagdHash, inverse:[]u8, proof:[]u8 }
struct ZdlCompilerEvidence { generation:[]u8, image:[]u8 }
struct ZdlVerifierEvidence { generation:[]u8, image:[]u8, independent:i32 }

struct ZdlPreparedEvidence {
    compact_path:[]u8, compact:[]u8, derived:[]u8,
    semantic_manifest:[]u8, semantic_graph:ZagdHash,
    semantic_graph_complete:i32, compiler_checked:i32,
    parity_command:[]u8, parity_exit_zero:i32,
    modules:ArrayList[ZdlModuleEvidence], imports:ArrayList[ZdlImportEvidence],
    resources:ArrayList[ZdlResourceEvidence], ast_origins:ArrayList[ZdlAstOriginEvidence],
    derived_segments:ArrayList[ZdlDerivedSegmentEvidence], choices:ArrayList[ZdlChoiceEvidence],
    transforms:ArrayList[ZdlTransformEvidence], compilers:ArrayList[ZdlCompilerEvidence],
    verifiers:ArrayList[ZdlVerifierEvidence],
}

struct ZdlLedgerView {
    recognized:i32, version:i32, valid:i32,
    compact_path:[]u8, compact:[]u8, derived:[]u8,
    compact_hash:ZagdHash, derived_hash:ZagdHash,
    semantic_manifest:ZagdHash, semantic_graph:ZagdHash,
    module_count:i32, import_count:i32, resource_count:i32,
    ast_origin_count:i32, derived_segment_count:i32,
    choice_count:i32, transform_count:i32, compiler_count:i32, verifier_count:i32,
}

fn zdl_empty_view()ZdlLedgerView{
    return ZdlLedgerView{.recognized=0,.version=0,.valid=0,.compact_path="",.compact="",.derived="",
        .compact_hash=zagd_hash_empty(),.derived_hash=zagd_hash_empty(),
        .semantic_manifest=zagd_hash_empty(),.semantic_graph=zagd_hash_empty(),
        .module_count=0,.import_count=0,.resource_count=0,.ast_origin_count=0,
        .derived_segment_count=0,.choice_count=0,.transform_count=0,.compiler_count=0,.verifier_count=0};
}
fn zdl_bad(recognized:i32,version:i32)ZdlLedgerView @alloc{
    let out:ZdlLedgerView=zdl_empty_view();out.recognized=recognized;out.version=version;return out;
}

fn zdl_empty_bytes()[]u8 @alloc{let p:*u8=_zag_malloc(1) as *u8;return p[0..0];}
fn zdl_hash_text(h:ZagdHash)[]u8 @alloc{
    let p:*u8=_zag_malloc(96) as *u8;let n:i64=0;
    zdl_put_i64(p,96,&n,h.first);zdl_put(p,96,&n,44 as u8);
    zdl_put_i64(p,96,&n,h.second);zdl_put(p,96,&n,44 as u8);zdl_put_i64(p,96,&n,h.bytes);
    return p[0..n];
}
fn zdl_hash_text_v1(h:ZagdHash)[]u8 @alloc{
    let p:*u8=_zag_malloc(96) as *u8;let n:i64=0;
    zdl_put_i64(p,96,&n,h.first);zdl_put(p,96,&n,9 as u8);
    zdl_put_i64(p,96,&n,h.second);zdl_put(p,96,&n,9 as u8);zdl_put_i64(p,96,&n,h.bytes);
    return p[0..n];
}
fn zdl_hex_digit(v:i32)u8{if(v<10){return ('0' as i32+v) as u8;}return ('a' as i32+v-10) as u8;}
fn zdl_hex_value(c:u8)i32{if(c>=48&&c<=57){return (c as i32)-48;}if(c>=97&&c<=102){return (c as i32)-87;}return -1;}
fn zdl_hex_encode(bytes:[]u8)[]u8 @alloc{
    let n:i64=(bytes.len as i64)*2;let p:*u8=_zag_malloc(n+1) as *u8;
    let i:i32=0;while(i<bytes.len){p[(i*2) as i64]=zdl_hex_digit((bytes[i] as i32)/16);p[(i*2+1) as i64]=zdl_hex_digit((bytes[i] as i32)%16);i=i+1;}return p[0..n];
}
fn zdl_hex_decode(text:[]u8,max:i64)[]u8 @alloc{
    if(text.len%2!=0||(text.len as i64)/2>max){return zdl_empty_bytes();}
    let i0:i32=0;while(i0<text.len){if(zdl_hex_value(text[i0])<0||zdl_hex_value(text[i0+1])<0){return zdl_empty_bytes();}i0=i0+2;}
    let n:i64=(text.len as i64)/2;let p:*u8=_zag_malloc(n+1) as *u8;let i:i32=0;
    while(i<text.len){let a:i32=zdl_hex_value(text[i]);let b:i32=zdl_hex_value(text[i+1]);p[(i/2) as i64]=((a*16+b) as u8);i=i+2;}return p[0..n];
}

fn zdl_put(p:*u8,cap:i64,n:*i64,b:u8)i32{if(p==null as *u8||n.*<0||n.*>=cap){return 0;}p[n.*]=b;n.*=n.*+1;return 1;}
fn zdl_put_text(p:*u8,cap:i64,n:*i64,s:[]u8)i32{let i:i32=0;while(i<s.len){if(zdl_put(p,cap,n,s[i])==0){return 0;}i=i+1;}return 1;}
fn zdl_put_i64(p:*u8,cap:i64,n:*i64,v:i64)i32{
    if(v<0){if(zdl_put(p,cap,n,45 as u8)==0){return 0;}if(v==(-9223372036854775807-1)){return zdl_put_text(p,cap,n,"9223372036854775808");}return zdl_put_i64(p,cap,n,0-v);}
    if(v>=10){if(zdl_put_i64(p,cap,n,v/10)==0){return 0;}}
    return zdl_put(p,cap,n,((v%10) as i32+48) as u8);
}
fn zdl_field_text(p:*u8,cap:i64,n:*i64,key:[]u8,value:[]u8)i32{
    return (zdl_put_text(p,cap,n,key)==1&&zdl_put(p,cap,n,61 as u8)==1&&zdl_put_text(p,cap,n,value)==1&&zdl_put(p,cap,n,10 as u8)==1) as i32;
}
fn zdl_field_i64(p:*u8,cap:i64,n:*i64,key:[]u8,value:i64)i32{
    return (zdl_put_text(p,cap,n,key)==1&&zdl_put(p,cap,n,61 as u8)==1&&zdl_put_i64(p,cap,n,value)==1&&zdl_put(p,cap,n,10 as u8)==1) as i32;
}
fn zdl_field_hash(p:*u8,cap:i64,n:*i64,key:[]u8,h:ZagdHash)i32{
    return (zdl_put_text(p,cap,n,key)==1&&zdl_put(p,cap,n,61 as u8)==1&&zdl_put_i64(p,cap,n,h.first)==1&&zdl_put(p,cap,n,44 as u8)==1&&zdl_put_i64(p,cap,n,h.second)==1&&zdl_put(p,cap,n,44 as u8)==1&&zdl_put_i64(p,cap,n,h.bytes)==1&&zdl_put(p,cap,n,10 as u8)==1) as i32;
}
fn zdl_field_hex(p:*u8,cap:i64,n:*i64,key:[]u8,value:[]u8)i32{
    if(zdl_put_text(p,cap,n,key)==0||zdl_put(p,cap,n,61 as u8)==0){return 0;}
    let i:i32=0;while(i<value.len){if(zdl_put(p,cap,n,zdl_hex_digit((value[i] as i32)/16))==0){return 0;}if(zdl_put(p,cap,n,zdl_hex_digit((value[i] as i32)%16))==0){return 0;}i=i+1;}return zdl_put(p,cap,n,10 as u8);
}
fn zdl_field_hash_hex(p:*u8,cap:i64,n:*i64,key:[]u8,h:ZagdHash)i32{return zdl_field_hash(p,cap,n,key,h);}

fn zdl_line_key(id:i32)[]u8{
    if(id==1){return "format";}if(id==2){return "compact_hex";}if(id==3){return "derived_hex";}
    if(id==4){return "compact_path_hex";}if(id==5){return "compact_hash";}if(id==6){return "derived_hash";}
    if(id==7){return "semantic_graph";}if(id==8){return "record_checksum";}if(id==9){return "module_count";}
    if(id==10){return "import_count";}if(id==11){return "resource_count";}if(id==12){return "ast_origin_count";}
    if(id==13){return "derived_segment_count";}if(id==14){return "choice_count";}if(id==15){return "transform_count";}
    if(id==16){return "compiler_count";}if(id==17){return "verifier_count";}return "";
}
fn zdl_line_value(text:[]u8,key_id:i32)[]u8{
    let key:[]u8=zdl_line_key(key_id);
    let start:i32=0;let i:i32=0;
    while(i<=text.len){if(i==text.len||text[i]==10){let line:[]u8=text[start..i];if(line.len>key.len&&@strEq(line[0..key.len],key)&&line[key.len]==61){return line[key.len+1..line.len];}start=i+1;}i=i+1;}return "";
}
fn zdl_named_value(text:[]u8,key:[]u8)[]u8{
    let start:i32=0;let i:i32=0;
    while(i<=text.len){if(i==text.len||text[i]==10){let line:[]u8=text[start..i];if(line.len>key.len&&@strEq(line[0..key.len],key)&&line[key.len]==61){return line[key.len+1..line.len];}start=i+1;}i=i+1;}return "";
}
fn zdl_line_count(text:[]u8,key:[]u8)i32{
    let count:i32=0;let start:i32=0;let i:i32=0;
    while(i<=text.len){if(i==text.len||text[i]==10){let line:[]u8=text[start..i];if(line.len>key.len&&@strEq(line[0..key.len],key)&&line[key.len]==61){count=count+1;}start=i+1;}i=i+1;}
    return count;
}
fn zdl_fixed_v2_fields_present(text:[]u8)i32{
    let ok:i32=1;let i:i32=1;while(i<=17){if(zdl_line_count(text,zdl_line_key(i))!=1){ok=0;}i=i+1;}
    if(zdl_line_count(text,"record_checksum")!=1){ok=0;}return ok;
}
fn zdl_fixed_v1_fields_present(text:[]u8)i32{
    if(zdl_line_count(text,"format")!=1||zdl_line_count(text,"compact_hex")!=1||zdl_line_count(text,"derived_hex")!=1||zdl_line_count(text,"compact_path_hex")!=1||zdl_line_count(text,"compact_hash")!=1||zdl_line_count(text,"derived_hash")!=1){return 0;}return 1;
}
fn zdl_line_has_index(line:[]u8,prefix:[]u8,want:i32)i32{
    if(line.len<=prefix.len||@strEq(line[0..prefix.len],prefix)==0){return 0;}
    let i:i32=prefix.len;if(i>=line.len||line[i]<48||line[i]>57){return 0;}
    let value:i64=0;while(i<line.len&&line[i]>=48&&line[i]<=57){let digit:i64=(line[i] as i64)-48;if(value>214748364){return 0;}value=value*10+digit;i=i+1;}
    if(i>=line.len||line[i]!=61||i+1>line.len){return 0;}
    return (value==(want as i64)) as i32;
}
fn zdl_numbered_fields_valid(text:[]u8,prefix:[]u8,count:i32)i32{
    if(count<0){return 0;}
    let wanted:i32=0;while(wanted<count){let seen:i32=0;let start:i32=0;let i:i32=0;
        while(i<=text.len){if(i==text.len||text[i]==10){let line:[]u8=text[start..i];if(zdl_line_has_index(line,prefix,wanted)==1){seen=seen+1;}start=i+1;}i=i+1;}
        if(seen!=1){return 0;}wanted=wanted+1;}
    // Reject malformed, duplicated, or out-of-range members for this exact
    // section. Prefixes that are intentionally nested (module_ vs
    // module_hash_) are validated by their more specific section below.
    let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]==10){let line:[]u8=text[start..i];if(line.len>prefix.len&&@strEq(line[0..prefix.len],prefix)==1){let j:i32=prefix.len;if(j<line.len&&line[j]>=48&&line[j]<=57){let value:i64=0;while(j<line.len&&line[j]>=48&&line[j]<=57){value=value*10+((line[j] as i64)-48);j=j+1;}if(j>=line.len||line[j]!=61||value<0||value>=(count as i64)){return 0;}}}start=i+1;}i=i+1;}
    return 1;
}
fn zdl_line_value_index(text:[]u8,prefix:[]u8,want:i32)[]u8{
    let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]==10){let line:[]u8=text[start..i];if(zdl_line_has_index(line,prefix,want)==1){let j0:i32=prefix.len;while(j0<line.len&&line[j0]>=48&&line[j0]<=57){j0=j0+1;}return line[j0+1..line.len];}start=i+1;}i=i+1;}return "";
}
fn zdl_numbered_i64_valid(text:[]u8,prefix:[]u8,count:i32,min:i64,max:i64)i32{
    let i:i32=0;while(i<count){let value:i64=zdl_parse_i64(zdl_line_value_index(text,prefix,i),max);if(value<min||value>max){return 0;}i=i+1;}return 1;
}
fn zdl_origin_module_bytes(text:[]u8,origin:i32,modules:i32)i64{
    let path:[]u8=zdl_line_value_index(text,"ast_origin_module_",origin);let i:i32=0;
    while(i<modules){let module_path:[]u8=zdl_line_value_index(text,"module_",i);if(@strEq(path,module_path)==1){return zdl_parse_hash(zdl_line_value_index(text,"module_hash_",i)).bytes;}i=i+1;}
    return -1;
}
fn zdl_v2_spans_valid(text:[]u8,compact_len:i32,derived_len:i32,segments:i32,origins:i32,modules:i32)i32{
    let i:i32=0;while(i<origins){let bs:i64=zdl_parse_i64(zdl_line_value_index(text,"ast_origin_byte_start_",i),2147483647);let be:i64=zdl_parse_i64(zdl_line_value_index(text,"ast_origin_byte_end_",i),2147483647);let line:i64=zdl_parse_i64(zdl_line_value_index(text,"ast_origin_line_",i),2147483647);let col:i64=zdl_parse_i64(zdl_line_value_index(text,"ast_origin_col_",i),2147483647);let module_bytes:i64=zdl_origin_module_bytes(text,i,modules);if(bs<0||be<bs||module_bytes<0||be>module_bytes||line<0||col<0){return 0;}i=i+1;}
    let expected:i64=0;i=0;while(i<segments){let start:i64=zdl_parse_i64(zdl_line_value_index(text,"derived_start_",i),2147483647);let end:i64=zdl_parse_i64(zdl_line_value_index(text,"derived_end_",i),2147483647);if(start<0||end<=start||start!=expected||end>derived_len){return 0;}expected=end;i=i+1;}return (expected==(derived_len as i64)) as i32;
}
fn zdl_v2_sections_valid(text:[]u8,modules:i32,imports:i32,resources:i32,origins:i32,segments:i32,choices:i32,transforms:i32,compilers:i32,verifiers:i32)i32{
    if(zdl_numbered_fields_valid(text,"module_",modules)==0||zdl_numbered_fields_valid(text,"module_hash_",modules)==0||
       zdl_numbered_fields_valid(text,"importer_",imports)==0||zdl_numbered_fields_valid(text,"imported_",imports)==0||
       zdl_numbered_fields_valid(text,"resource_",resources)==0||zdl_numbered_fields_valid(text,"resource_hash_",resources)==0){return 0;}
    if(zdl_numbered_fields_valid(text,"ast_origin_module_",origins)==0||zdl_numbered_fields_valid(text,"ast_origin_stable_id_",origins)==0||zdl_numbered_fields_valid(text,"ast_origin_node_kind_",origins)==0||zdl_numbered_fields_valid(text,"ast_origin_line_",origins)==0||zdl_numbered_fields_valid(text,"ast_origin_col_",origins)==0||zdl_numbered_fields_valid(text,"ast_origin_byte_start_",origins)==0||zdl_numbered_fields_valid(text,"ast_origin_byte_end_",origins)==0||zdl_numbered_fields_valid(text,"ast_origin_exact_",origins)==0){return 0;}
    if(zdl_numbered_fields_valid(text,"derived_start_",segments)==0||zdl_numbered_fields_valid(text,"derived_end_",segments)==0||zdl_numbered_fields_valid(text,"derived_module_",segments)==0||zdl_numbered_fields_valid(text,"derived_source_",segments)==0||zdl_numbered_fields_valid(text,"derived_source_start_",segments)==0||zdl_numbered_fields_valid(text,"derived_source_end_",segments)==0||zdl_numbered_fields_valid(text,"derived_origin_id_",segments)==0||zdl_numbered_fields_valid(text,"derived_origin_domain_",segments)==0||zdl_numbered_fields_valid(text,"derived_exact_",segments)==0||zdl_numbered_fields_valid(text,"derived_generated_",segments)==0||zdl_numbered_fields_valid(text,"derived_basis_",segments)==0){return 0;}
    if(zdl_numbered_fields_valid(text,"choice_",choices)==0||zdl_numbered_fields_valid(text,"choice_value_",choices)==0||zdl_numbered_fields_valid(text,"choice_basis_",choices)==0){return 0;}
    if(zdl_numbered_fields_valid(text,"transform_",transforms)==0||zdl_numbered_fields_valid(text,"transform_input_",transforms)==0||zdl_numbered_fields_valid(text,"transform_output_",transforms)==0||zdl_numbered_fields_valid(text,"transform_inverse_",transforms)==0||zdl_numbered_fields_valid(text,"transform_proof_",transforms)==0){return 0;}
    if(zdl_numbered_fields_valid(text,"compiler_generation_",compilers)==0||zdl_numbered_fields_valid(text,"compiler_image_",compilers)==0||zdl_numbered_fields_valid(text,"verifier_generation_",verifiers)==0||zdl_numbered_fields_valid(text,"verifier_image_",verifiers)==0||zdl_numbered_fields_valid(text,"verifier_independent_",verifiers)==0){return 0;}
    if(zdl_numbered_i64_valid(text,"ast_origin_stable_id_",origins,0,9223372036854775807)==0||zdl_numbered_i64_valid(text,"ast_origin_node_kind_",origins,0,2147483647)==0||zdl_numbered_i64_valid(text,"ast_origin_line_",origins,0,2147483647)==0||zdl_numbered_i64_valid(text,"ast_origin_col_",origins,0,2147483647)==0||zdl_numbered_i64_valid(text,"ast_origin_byte_start_",origins,0,2147483647)==0||zdl_numbered_i64_valid(text,"ast_origin_byte_end_",origins,0,2147483647)==0||zdl_numbered_i64_valid(text,"ast_origin_exact_",origins,0,1)==0){return 0;}
    if(zdl_numbered_i64_valid(text,"derived_start_",segments,0,2147483647)==0||zdl_numbered_i64_valid(text,"derived_end_",segments,0,2147483647)==0||zdl_numbered_i64_valid(text,"derived_source_start_",segments,0,2147483647)==0||zdl_numbered_i64_valid(text,"derived_source_end_",segments,0,2147483647)==0||zdl_numbered_i64_valid(text,"derived_origin_id_",segments,0,9223372036854775807)==0||zdl_numbered_i64_valid(text,"derived_exact_",segments,0,1)==0||zdl_numbered_i64_valid(text,"derived_generated_",segments,0,1)==0){return 0;}
    if(zdl_numbered_i64_valid(text,"verifier_independent_",verifiers,0,1)==0){return 0;}
    return 1;
}
fn zdl_v2_counts_valid(text:[]u8)i32{
    let modules:i64=zdl_parse_i64(zdl_line_value(text,9),zdl_max_modules());let imports:i64=zdl_parse_i64(zdl_line_value(text,10),zdl_max_imports());let resources:i64=zdl_parse_i64(zdl_line_value(text,11),zdl_max_resources());
    let origins:i64=zdl_parse_i64(zdl_line_value(text,12),zdl_max_ast_origins());let segments:i64=zdl_parse_i64(zdl_line_value(text,13),zdl_max_derived_segments());let choices:i64=zdl_parse_i64(zdl_line_value(text,14),zdl_max_choices());let transforms:i64=zdl_parse_i64(zdl_line_value(text,15),zdl_max_transforms());let compilers:i64=zdl_parse_i64(zdl_line_value(text,16),zdl_max_generations());let verifiers:i64=zdl_parse_i64(zdl_line_value(text,17),zdl_max_generations());
    if(modules<1||imports<0||resources<0||origins<1||segments<1||choices!=10||transforms!=3||compilers!=1||verifiers!=1){return 0;}
    if(zdl_line_count(text,"module_graph_checksum")!=1||zdl_line_count(text,"semantic_manifest_hex")!=1||zdl_line_count(text,"semantic_manifest_hash")!=1||zdl_line_count(text,"choice_scope")!=1||zdl_line_count(text,"verifier_kind")!=1||zdl_line_count(text,"compiler_generation")!=1||zdl_line_count(text,"compiler_image_hex")!=1||zdl_line_count(text,"verifier_generation")!=1||zdl_line_count(text,"verifier_image_hex")!=1||zdl_line_count(text,"verifier_independent")!=1){return 0;}
    return zdl_v2_sections_valid(text,modules as i32,imports as i32,resources as i32,origins as i32,segments as i32,choices as i32,transforms as i32,compilers as i32,verifiers as i32);
}
fn zdl_parse_i64(text:[]u8,max:i64)i64{
    if(text.len==0){return -1;}let sign:i64=1;let i0:i32=0;if(text[0]==45){sign=-1;i0=1;}if(i0>=text.len){return -1;}
    let out:i64=0;let i:i32=i0;while(i<text.len){if(text[i]<48||text[i]>57){return -1;}let d:i64=(text[i] as i64)-48;if(out>(max-d)/10){return -1;}out=out*10+d;i=i+1;}return out*sign;
}
fn zdl_parse_hash(text:[]u8)ZagdHash{
