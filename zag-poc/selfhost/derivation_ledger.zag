}
fn zdl_decode_v1(text:[]u8)ZdlLedgerView{
    let compact_hex:[]u8=zdl_line_value(text,2);let derived_hex:[]u8=zdl_line_value(text,3);let path_hex:[]u8=zdl_line_value(text,4);if(compact_hex.len==0||derived_hex.len==0||path_hex.len==0){return zdl_bad(1,1);}
    let compact:[]u8=zdl_hex_decode(compact_hex,zdl_max_source_bytes());let derived:[]u8=zdl_hex_decode(derived_hex,zdl_max_source_bytes());let path:[]u8=zdl_hex_decode(path_hex,1048576);
    let ch:ZagdHash=zdl_parse_hash_v1(zdl_line_value(text,5));let dh:ZagdHash=zdl_parse_hash_v1(zdl_line_value(text,6));let actual_compact:ZagdHash=zagd_content_hash(compact);let actual_derived:ZagdHash=zagd_content_hash(derived);
    let valid:i32=(compact.len>0&&derived.len>0&&path.len>0&&zdl_hash_valid(ch)==1&&zdl_hash_valid(dh)==1&&zdl_hash_same(ch,actual_compact)==1&&zdl_hash_same(dh,actual_derived)==1) as i32;
    return ZdlLedgerView{.recognized=1,.version=1,.valid=valid,.compact_path=path,.compact=compact,.derived=derived,.compact_hash=ch,.derived_hash=dh,.semantic_manifest=zagd_hash_empty(),.semantic_graph=zagd_hash_empty(),.module_count=0,.import_count=0,.resource_count=0,.ast_origin_count=0,.derived_segment_count=0,.choice_count=0,.transform_count=0,.compiler_count=0,.verifier_count=0};
}
