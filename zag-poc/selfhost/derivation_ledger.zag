fn zdl_hash_valid(h:ZagdHash)i32{return (h.first>=0&&h.second>=0&&h.bytes>=0) as i32;}
fn zdl_hash_same(a:ZagdHash,b:ZagdHash)i32{return (a.first==b.first&&a.second==b.second&&a.bytes==b.bytes) as i32;}
