fn zdl_emit_hash_hex_i(p:*u8,cap:i64,n:*i64,prefix:[]u8,index:i32,bytes:[]u8)i32{return zdl_field_hash_i(p,cap,n,prefix,index,zagd_content_hash(bytes));}
fn zdl_field_i64_i(p:*u8,cap:i64,n:*i64,prefix:[]u8,index:i32,value:i64)i32{
