    let first:i64=zdl_parse_i64(text[0..a],9223372036854775807);let second:i64=zdl_parse_i64(text[a+1..b],9223372036854775807);let bytes:i64=zdl_parse_i64(text[b+1..text.len],9223372036854775807);
