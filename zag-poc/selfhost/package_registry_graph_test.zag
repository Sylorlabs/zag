@import("package_registry_graph.zag")

extern fn _zag_allocator_live_bytes() i64

fn graph_check(ok: i32, label: []u8, failures: *i32) void {
    if (ok != 0) { _zag_print("ok  "); _zag_println(label); }
    else { failures.* = failures.* + 1; _zag_print("FAIL "); _zag_println(label); }
}

fn main() i32 {
    let failures: i32 = 0;
    let before: i64 = _zag_allocator_live_bytes();
    let body: []u8 = "format=zag-registry-index-v1\nauthority=local-file-v1\nsignature=none\nentry=alpha\t1.0.0\tsrc/alpha-1.zag\t1,2,3\nentry=alpha\t1.2.0\tsrc/alpha-2.zag\t4,5,6\nentry=beta\t2.0.0\tsrc/beta.zag\t7,8,9\n";
    let index: []u8 = package_registry_finalize(body);
    graph_check(package_registry_index_valid(index) == 1,
        "graph fixture is a canonical local index", &failures);

    let converged: PackageRegistryGraphLookup = package_registry_graph_lookup(
        index, "alpha\t^1.0.0\nalpha\t~1.2.0\nbeta\t^2.0.0");
    graph_check(converged.valid == 1 && converged.edge_count == 3 &&
        converged.package_count == 2 &&
        converged.error == PackageRegistryGraphError.none,
        "all graph edges converge through per-package intersections", &failures);

    let unconstrained: PackageRegistryGraphLookup =
        package_registry_graph_lookup(index, "alpha\t\nalpha\t^1.0.0");
    graph_check(unconstrained.valid == 1 && unconstrained.package_count == 1,
        "an unconstrained edge does not weaken a constrained duplicate", &failures);

    let conflict: PackageRegistryGraphLookup = package_registry_graph_lookup(
        index, "alpha\t^1.0.0\nalpha\t^2.0.0\nbeta\t2.0.0");
    graph_check(conflict.valid == 0 && conflict.edge_count == 3 &&
        conflict.package_count == 0 &&
        conflict.failing_name.len == 5 && @strEq(conflict.failing_name, "alpha") &&
        conflict.error == PackageRegistryGraphError.version_not_found,
        "one incompatible alias fails the whole graph before later edges", &failures);

    let missing: PackageRegistryGraphLookup = package_registry_graph_lookup(
        index, "missing\t*");
    graph_check(missing.valid == 0 &&
        missing.error == PackageRegistryGraphError.package_not_found &&
        @strEq(missing.failing_name, "missing"),
        "an unknown graph package fails closed", &failures);

    let malformed: PackageRegistryGraphLookup = package_registry_graph_lookup(
        index, "alpha\t^1.0.0\nmalformed");
    graph_check(malformed.valid == 0 &&
        malformed.error == PackageRegistryGraphError.invalid_graph,
        "graph records require exactly name and requirement fields", &failures);

    _zag_str_free(index);
    graph_check(_zag_allocator_live_bytes() == before,
        "graph grouping restores the allocator baseline", &failures);
    if (failures == 0) { _zag_println("package registry graph: 6/6"); }
    return failures;
}
