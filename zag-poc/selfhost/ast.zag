// selfhost/ast.zag — the Zag AST, written in Zag.
//
// A tagged-union `Node` over heap pointers (*Node), with child lists held as
// ArrayList[*Node]. Type annotations are kept as []u8 strings (same as the
// bootstrap Zig compiler). Optional children use an i32 flag + a valid pointer
// rather than ?*Node, to keep traversal switches simple.

@import("../std/list.zag")

// `eff` carries a function-type's effect-row annotation when the param/field
// type is `fn(...)... @realtime` / `... ! e` / `... ! pure` (else ""). The
// effect checker reads it; codegen ignores it (pty stays the canonical type).
// `calign` (>0) is the cache-line alignment requested by a `@cacheAlign(N)`
// prefix on a struct field; codegen emits `_Alignas(N)`. 0 = no alignment.
// `contract` is empty for ordinary parameters and fields. Edition-2027 named
// function parameters may carry one exact lifetime contract: `@borrows`,
// `@borrows_mut`, or `@consumes`. Keeping it on the parameter makes a
// multi-pointer foreign boundary precise without changing its C ABI.
struct Param { name: []u8, pty: []u8, eff: []u8, contract: []u8, calign: i32 }
struct FieldInit { name: []u8, val: *Node }

// File-level compilation profile.  This belongs to the parsed compilation
// unit rather than being inferred from a filename or from a generated symbol.
enum ModuleProfile { strict, script }
struct CompilationUnit {
    profile: ModuleProfile,
    decls: ArrayList[*Node],
    modules: ArrayList[ResolvedModule],
    imports: ArrayList[ResolvedImport],
    resources: ArrayList[ResolvedResource],
}
struct ResolvedModule { path: []u8, source: []u8 }
struct ResolvedImport { importer: []u8, imported: []u8 }
struct ResolvedResource { path: []u8, data: []u8 }

// ── type declarations ───────────────────────────────────────────────────────
// `origin` is an exact resolver/parser module path. It is required by the
// advisory semantic graph; synthetic structures use `<root>` explicitly.
// `repr_c` is set only by the edition-2027 `@repr(C) struct` spelling. Ordinary
// structs retain Zag's word-oriented representation; backends must either
// implement this explicit representation or reject it before artifact output.
struct StructDecl { name: []u8, fields: ArrayList[Param], tparams: ArrayList[[]u8], annots: ArrayList[[]u8], is_pub: i32, origin: []u8, repr_c: i32 }
struct EnumDecl   { name: []u8, members: ArrayList[[]u8], annots: ArrayList[[]u8], is_pub: i32 }
struct UnionDecl  { name: []u8, fields: ArrayList[Param] }

// ── statement payloads ──────────────────────────────────────────────────────
struct FnDecl {
    name:      []u8,
    tparams:   ArrayList[[]u8],   // generic type-parameter names (empty if non-generic)
    params:    ArrayList[Param],
    ret:       []u8,
    annots:    ArrayList[[]u8],   // capability/effect annotations (@realtime, @alloc, ...)
    body:      ArrayList[*Node],
    is_extern: i32,
    ret_eff:   []u8,              // effect row of the return type if it is a fn type (else "")
    caps:      i32,               // capture count (>0 only for hoisted capturing closures)
    cap_names: []u8,             // comma-joined capture names (hoisted capturing closures)
    cap_types: []u8,             // comma-joined capture C/Zag types (filled by codegen's fn-value pass)
    line:      i32,              // source line of the fn keyword (0 = synthetic)
    is_pub:    i32,               // 1 if declared with `pub` keyword (module public API), else 0
    origin:    []u8,              // resolved module path (empty only for legacy synthetic ASTs)
}
// `is_global` is set only by the edition-2027 `global let` declaration.
// Keeping it on Let preserves the established traversal contract while making
// source-level static storage explicit rather than treating file-scope `let`
// as an accidental local.
struct Let    { name: []u8, dty: []u8, has_dty: i32, has_init: i32, expr: *Node, eff: []u8, calign: i32, is_global: i32 }
struct Return { has_expr: i32, expr: *Node }
struct If     { cond: *Node, then_body: ArrayList[*Node], els_body: ArrayList[*Node], has_els: i32, cap: []u8, has_cap: i32 }
struct While  { cond: *Node, body: ArrayList[*Node], cap: []u8, has_cap: i32 }
struct Break  { }
struct Continue { }
struct UnsafeBlock { body: ArrayList[*Node] }
struct Assign { target: *Node, expr: *Node }
struct ExprStmt { expr: *Node }

// switch arm: one or more `.tag` patterns, an optional `|cap|` capture, and a
// block body. (else arm is stored separately on the Switch.)
struct SwitchArm {
    tags:    ArrayList[[]u8],
    cap:     []u8,
    has_cap: i32,
    body:    ArrayList[*Node],
}
struct Switch {
    subject:  *Node,
    arms:     ArrayList[SwitchArm],
    els_body: ArrayList[*Node],
    has_els:  i32,
}

// ── expression payloads ─────────────────────────────────────────────────────
struct IntLit { text: []u8 }
struct StrLit { text: []u8 }
struct Ident  { name: []u8 }
struct Bin    { op: []u8, l: *Node, r: *Node }
struct Un     { op: []u8, e: *Node }
struct Call   { callee: *Node, args: ArrayList[*Node], targs: ArrayList[[]u8] }
// ptr_base: set by the codegen type pass — 1 if `base` is a raw pointer/array
// (index directly), 0 if a []T slice value (index via .ptr). See codegen.zag.
struct Index  { base: *Node, idx: *Node, ptr_base: i32 }
struct Field  { base: *Node, fname: []u8 }
struct StructLit { sname: []u8, fields: ArrayList[FieldInit], targs: ArrayList[[]u8] }
struct Cast   { expr: *Node, target: []u8 }
struct Slice  { base: *Node, lo: *Node, hi: *Node, has_hi: i32, ptr_base: i32 }
struct LinkDir { lib: []u8 }
// #embed("file.bin") — compile-time binary file inclusion.
// `literal` preserves the quoted source spelling for formatting and tooling.
// `data` is the raw file contents (no escape decoding); `path` is the
// normalized source-relative path for diagnostics and cache identity. Lowered
// like a string literal but copied verbatim into rodata (no cg_decode_str).
struct EmbedLit { literal: []u8, path: []u8, data: []u8 }

// ── the node union (must be declared last: variants hold the structs above) ──
union Node {
    fn_decl: FnDecl,
    let_:    Let,
    ret:     Return,
    if_:     If,
    while_:  While,
    break_:  Break,
    continue_: Continue,
    unsafe_: UnsafeBlock,
    assign:  Assign,
    estmt:   ExprStmt,
    switch_: Switch,
    ilit:    IntLit,
    slit:    StrLit,
    id:      Ident,
    bin:     Bin,
    un:      Un,
    call:    Call,
    idx:     Index,
    fld:     Field,
    slit_:   StructLit,
    cast_:   Cast,
    slice_:  Slice,
    struct_: StructDecl,
    enum_:   EnumDecl,
    union_:  UnionDecl,
    link_dir: LinkDir,
    embed:   EmbedLit,
}

// Stable per-kind code (for tests / debugging).
fn node_code(n: *Node) i32 {
    return switch (n.*) {
        .fn_decl => |_x| 1,
        .let_    => |_x| 2,
        .ret     => |_x| 3,
        .if_     => |_x| 4,
        .while_  => |_x| 5,
        .assign  => |_x| 6,
        .estmt   => |_x| 7,
        .switch_ => |_x| 8,
        .unsafe_ => |_x| 9,
        .ilit    => |_x| 10,
        .slit    => |_x| 11,
        .id      => |_x| 12,
        .bin     => |_x| 13,
        .un      => |_x| 14,
        .call    => |_x| 15,
        .idx     => |_x| 16,
        .fld     => |_x| 17,
        .slit_   => |_x| 18,
        .cast_   => |_x| 19,
        .slice_  => |_x| 20,
        .struct_ => |_x| 30,
        .enum_   => |_x| 31,
        .union_  => |_x| 32,
        .link_dir => |_x| 33,
        .embed   => |_x| 34,
    };
}

// ── constructors ────────────────────────────────────────────────────────────
fn mk_int(text: []u8) *Node    { return new(Node{ .ilit = IntLit{ .text = text } }); }
fn mk_str(text: []u8) *Node    { return new(Node{ .slit = StrLit{ .text = text } }); }
fn mk_ident(name: []u8) *Node  { return new(Node{ .id = Ident{ .name = name } }); }
fn mk_bin(op: []u8, l: *Node, r: *Node) *Node { return new(Node{ .bin = Bin{ .op = op, .l = l, .r = r } }); }
fn mk_un(op: []u8, e: *Node) *Node { return new(Node{ .un = Un{ .op = op, .e = e } }); }
fn mk_field(base: *Node, fname: []u8) *Node { return new(Node{ .fld = Field{ .base = base, .fname = fname } }); }
fn mk_index(base: *Node, i: *Node) *Node { return new(Node{ .idx = Index{ .base = base, .idx = i, .ptr_base = 1 } }); }
fn mk_cast(expr: *Node, target: []u8) *Node { return new(Node{ .cast_ = Cast{ .expr = expr, .target = target } }); }
fn mk_slice(base: *Node, lo: *Node, hi: *Node, has_hi: i32) *Node {
    return new(Node{ .slice_ = Slice{ .base = base, .lo = lo, .hi = hi, .has_hi = has_hi, .ptr_base = 0 } });
}
fn mk_call(callee: *Node, args: ArrayList[*Node]) *Node {
    return new(Node{ .call = Call{ .callee = callee, .args = args, .targs = make[[]u8](1) } });
}
fn mk_gcall(callee: *Node, args: ArrayList[*Node], targs: ArrayList[[]u8]) *Node {
    return new(Node{ .call = Call{ .callee = callee, .args = args, .targs = targs } });
}
fn mk_estmt(e: *Node) *Node { return new(Node{ .estmt = ExprStmt{ .expr = e } }); }
fn mk_embed(literal: []u8, path: []u8, data: []u8) *Node { return new(Node{ .embed = EmbedLit{ .literal = literal, .path = path, .data = data } }); }
fn mk_assign(t: *Node, e: *Node) *Node { return new(Node{ .assign = Assign{ .target = t, .expr = e } }); }
fn mk_let(name: []u8, dty: []u8, has_dty: i32, has_init: i32, expr: *Node) *Node {
    return new(Node{ .let_ = Let{ .name = name, .dty = dty, .has_dty = has_dty, .has_init = has_init, .expr = expr, .eff = "", .calign = 0, .is_global = 0 } });
}
fn mk_ret(has_expr: i32, expr: *Node) *Node {
    return new(Node{ .ret = Return{ .has_expr = has_expr, .expr = expr } });
}
fn mk_if(cond: *Node, then_body: ArrayList[*Node], els_body: ArrayList[*Node], has_els: i32) *Node {
    return new(Node{ .if_ = If{ .cond = cond, .then_body = then_body, .els_body = els_body, .has_els = has_els, .cap = "", .has_cap = 0 } });
}
fn mk_while(cond: *Node, body: ArrayList[*Node]) *Node {
    return new(Node{ .while_ = While{ .cond = cond, .body = body, .cap = "", .has_cap = 0 } });
}
fn mk_break() *Node { return new(Node{ .break_ = Break{} }); }
fn mk_continue() *Node { return new(Node{ .continue_ = Continue{} }); }
fn mk_unsafe(body: ArrayList[*Node]) *Node { return new(Node{ .unsafe_ = UnsafeBlock{ .body = body } }); }
fn mk_switch(subject: *Node, arms: ArrayList[SwitchArm], els_body: ArrayList[*Node], has_els: i32) *Node {
    return new(Node{ .switch_ = Switch{ .subject = subject, .arms = arms, .els_body = els_body, .has_els = has_els } });
}
