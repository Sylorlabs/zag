@import("parse.zag")
fn main()i32 {
    let src:[]u8="@import(\"zag_const_lib.zag\")\nfn main()i32{return K;}\n";
    let unit:CompilationUnit=parse_compilation_unit_dir(src,"/tmp");
    let found:i32=0;let marked:i32=0;let i:i32=0;
    while(i<unit.decls.len){let d:*Node=unit.decls.data[i];switch(d.*){.fn_decl=>|f|{if(@strEq(f.name,"K")){found=1;let j:i32=0;while(j<f.annots.len){if(@strEq(f.annots.data[j],"_zag_desugared_const")){marked=1;}j=j+1;}}}else=>{}}i=i+1;}
    if(found!=1){return 11;}if(marked!=1){return 12;}return 0;
}
