// Resolve the raw and concrete parameter from the same declaration. Separate
// name-based scans can pair a parameter with another same-named declaration's
// type parameters after import flattening and accidentally erase ownership.
fn zt_res_raw_param_type(decls:ArrayList[*Node],name:[]u8,index:i32,targs:ArrayList[[]u8])[]u8{
    let fallback:[]u8="";let i:i32=0;
    while(i<decls.len){switch(decls.data[i].*){
        .fn_decl=>|f|{if(@strEq(f.name,name)&&index>=0&&index<f.params.len){
            if(fallback.len==0){fallback=f.params.data[index].pty;}
            if(f.tparams.len==targs.len){return f.params.data[index].pty;}
        }}
        else=>{}
    }i=i+1;}
    return fallback;
}
fn zt_res_param_type(decls:ArrayList[*Node],name:[]u8,index:i32,targs:ArrayList[[]u8])[]u8{
    let fallback:[]u8="";let i:i32=0;
    while(i<decls.len){switch(decls.data[i].*){
        .fn_decl=>|f|{if(@strEq(f.name,name)&&index>=0&&index<f.params.len){
            if(fallback.len==0){fallback=f.params.data[index].pty;}
            if(f.tparams.len==targs.len){return zt_subst_type(f.params.data[index].pty,f.tparams,targs);}
        }}
        else=>{}
    }i=i+1;}
    return fallback;
}
fn zt_res_unmodeled_generic_resource_param(decls:ArrayList[*Node],name:[]u8,index:i32,targs:ArrayList[[]u8])i32{
    let raw:[]u8=zt_res_raw_param_type(decls,name,index,targs);
    let concrete:[]u8=zt_res_param_type(decls,name,index,targs);
    return (raw.len>0&&zt_resource_type(raw,decls)==0&&zt_resource_type(concrete,decls)==1) as i32;
}
fn zt_res_pointer_resource_type(ty0:[]u8,decls:ArrayList[*Node])i32{
    let ty:[]u8=ty0;while(ty.len>0&&(ty[0]=='?'||ty[0]=='!')){ty=ty[1..];}
    if(ty.len>1&&ty[0]=='*'){return zt_resource_type(ty[1..],decls);}
    return 0;
}
// A selected field/index path is checked as one exact resource access.  Walking
// its base through the ordinary expression checker would check the aggregate
// root a second time, so releasing `pair.left` could make the unrelated live
// `pair.right` appear unavailable.  Preserve calls and computed-index effects
// in the base without broadening the access back to that root.
fn zt_res_call_base_effects(n:*Node,flow:*ZTResFlow,decls:ArrayList[*Node],context:[]u8,arena:*ArrayList[ZTAggPathNode])i32{
    switch(n.*){
        .id=>{return 0;}
        .fld=>|x|{return zt_res_call_base_effects(x.base,flow,decls,context,arena);}
        .idx=>|x|{return zt_res_call_base_effects(x.base,flow,decls,context,arena)+zt_res_call(x.idx,flow,decls,context,arena);}
        .slice_=>|x|{let errors:i32=zt_res_call_base_effects(x.base,flow,decls,context,arena)+zt_res_call(x.lo,flow,decls,context,arena);if(x.has_hi==1){errors=errors+zt_res_call(x.hi,flow,decls,context,arena);}return errors;}
        .cast_=>|x|{return zt_res_call_base_effects(x.expr,flow,decls,context,arena);}
        .un=>|x|{return zt_res_call_base_effects(x.e,flow,decls,context,arena);}
        else=>{return zt_res_call(n,flow,decls,context,arena);}
    }
}
fn zt_res_allocation_create_consume(flow:*ZTResFlow,c:Call,decls:ArrayList[*Node],context:[]u8,arena:*ArrayList[ZTAggPathNode])i32{
    if(!@strEq(zt_direct_name(c.callee),"@allocationCreate")||c.args.len!=4){return 0;}
    let path:ZTAggPath=zt_agg_expr_path(c.args.data[0],arena);
    if(zt_res_path_state(flow.*,path,arena.*)<0){return 0;}
    let errors:i32=zt_res_transition_under(flow,path,0,context,arena.*);
    if(errors==0){zt_res_clear_loans(flow,path,arena.*);}
    return errors;
}
fn zt_res_call(n:*Node,flow:*ZTResFlow,decls:ArrayList[*Node],context:[]u8,arena:*ArrayList[ZTAggPathNode])i32{
