                    let arg:[]u8=zt_expr_transparent_id(c.args.data[argi]);
                    let owner_id:[]u8=arg;if(owner_id.len==0){owner_id=zt_borrow_contract_arg_name(c.args.data[argi]);}
                    let root:[]u8=zt_borrow_expr_root(c.args.data[argi],aliases,borrows);
                    let existing:i32=zt_borrow_alias_mode(borrows,owner_id);
                    let wrapper:i32=(existing==3) as i32;
                    if(!wrapper&&(existing==1||zt_borrow_root_has(borrows,root,1)==1)){errors=errors+zt_machine_error("cannot create an exclusive mutable borrow while a shared borrow is active",context);}
                    if(!wrapper&&zt_borrow_root_has(borrows,root,2)==1&&existing!=2){errors=errors+zt_machine_error("cannot create a second exclusive mutable borrow while one is active",context);}
                }
                if(mode>0&&retained_result==0){
                    let arg:[]u8=zt_expr_transparent_id(c.args.data[argi]);
                    let parameter_local:i32=((zt_fn_param_contract(decls,name,argi).len>0||zt_fn_inferred_retained_param(decls,name,argi)==1||
                        (argi==0&&zt_fn_has_annot(decls,name,"@borrows")==1)||
                        (argi==0&&zt_fn_has_annot(decls,name,"@borrows_mut")==1)) as i32);
                    let owner_id:[]u8=arg;if(owner_id.len==0){owner_id=zt_borrow_contract_arg_name(c.args.data[argi]);}
                    if(owner_id.len==0&&parameter_local==0){errors=errors+zt_machine_error("borrow contract requires a named owner argument",context);}
                }
                argi=argi+1;
            }
        }
        .bin=>|x|{errors=errors+zt_check_borrow_call(x.l,decls,env,aliases,borrows,context)+zt_check_borrow_call(x.r,decls,env,aliases,borrows,context);}
        .un=>|x|{errors=errors+zt_check_borrow_call(x.e,decls,env,aliases,borrows,context);}
        .idx=>|x|{errors=errors+zt_check_borrow_call(x.base,decls,env,aliases,borrows,context)+zt_check_borrow_call(x.idx,decls,env,aliases,borrows,context);}
        .fld=>|x|{errors=errors+zt_check_borrow_call(x.base,decls,env,aliases,borrows,context);}
        .cast_=>|x|{errors=errors+zt_check_borrow_call(x.expr,decls,env,aliases,borrows,context);}
        .slice_=>|x|{errors=errors+zt_check_borrow_call(x.base,decls,env,aliases,borrows,context)+zt_check_borrow_call(x.lo,decls,env,aliases,borrows,context)+zt_check_borrow_call(x.hi,decls,env,aliases,borrows,context);}
        .slit_=>|x|{let i:i32=0;while(i<x.fields.len){errors=errors+zt_check_borrow_call(x.fields.data[i].val,decls,env,aliases,borrows,context);i=i+1;}}
        else=>{}
    }
    return errors;
}
fn zt_contract_param_name(f:FnDecl)[]u8{if(f.params.len==0){return "";}return f.params.data[0].name;}
fn zt_check_borrow_body(body:ArrayList[*Node],parent_env:ArrayList[ZTBind],aliases:*ArrayList[ZTOwnAlias],borrows:*ArrayList[ZTBorrowAlias],decls:ArrayList[*Node],return_contract:i32,context:[]u8)i32{
    // Borrow analysis asks the shared expression typer whether a computed value
    // can carry an owner identity. Keep the same lexical type environment as
    // the declared-type pass: omitting prior locals made an inline expression
    // such as `get[vsa_b<65>](xs, 0) ^ zero` compare a concrete VSA result with
    // an unknown local and emit a false mismatch. Each recursive body owns a
    // clone so branch-local declarations cannot leak or invalidate a parent's
    // backing allocation.
    let env:ArrayList[ZTBind]=zt_env_clone(parent_env);let initial_aliases:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);let initial_borrows:ArrayList[ZTBorrowAlias]=zt_borrow_clone(borrows.*);
    let errors:i32=0;let i:i32=0;
    while(i<body.len){switch(body.data[i].*){
        .let_=>|l|{if(l.has_init==1){
            errors=errors+zt_check_active_borrow_expr(l.expr,aliases.*,borrows.*,context)+zt_check_borrow_call(l.expr,decls,env,aliases.*,borrows.*,context);
            let source:[]u8=zt_expr_transparent_id(l.expr);
            let call_mode:i32=zt_call_borrow_mode(l.expr,decls);
            // A direct borrow result and a named alias retain identity below.
            // An aggregate/computed expression containing a borrow has no
            // field-sensitive borrow representation yet, so accepting it
            // would lose the owner relation and permit a later release.
            let embedded_root:[]u8=zt_borrowed_expr_root(l.expr,decls,env,aliases.*,borrows.*,context);
            if(embedded_root.len>0&&source.len==0&&call_mode==0){let root_mode:i32=zt_borrow_root_mode(borrows.*,embedded_root);if(root_mode==0){root_mode=1;}let derived_mode:i32=zt_local_borrow_binding_mode(l.expr,root_mode,env,decls,context);zt_alias_set(aliases,l.name,embedded_root);zt_borrow_set(borrows,l.name,embedded_root,derived_mode);}
            // A local copy of a borrow is still that same borrow.  Recording
            // this prevents an alias from laundering a borrowed value into an
            // @consumes call or release operation.
