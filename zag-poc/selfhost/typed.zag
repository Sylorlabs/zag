                }else if(resource_pointee==1&&mode>0){let state:i32=zt_res_access_state(flow.*,arg_path,arena.*);if(state>=0&&state!=1){errors=errors+zt_machine_error("borrowed resource argument is unavailable after move or release",context);}}
                else if(zt_resource_type(pty,decls)==1&&mode==0){let state:i32=zt_res_access_state(flow.*,arg_path,arena.*);if(state!=1){errors=errors+zt_machine_error("resource argument is unavailable after move or release",context);}else{errors=errors+zt_res_transition_under(flow,arg_path,0,context,arena.*);}}
