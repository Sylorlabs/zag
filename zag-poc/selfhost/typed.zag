    return errors;
}
fn zt_res_release_path(flow:*ZTResFlow,path:ZTAggPath,release:[]u8,whole_resource:i32,context:[]u8,arena:ArrayList[ZTAggPathNode])i32{
    let errors:i32=0;let matched:i32=0;let i:i32=0;
    while(i<flow.*.slots.len){let slot:ZTResSlot=flow.*.slots.data[i];let exact:i32=zt_agg_path_equal(arena,path,slot.path);let under:i32=zt_agg_path_prefix(arena,path,slot.path);
        if(exact==1||(whole_resource==1&&under==1)){matched=1;if(slot.state!=1){errors=errors+zt_machine_error("resource is released after move, prior release, or only one control-flow path",context);}else if(whole_resource==0&&!@strEq(slot.release,release)){errors=errors+zt_machine_error(_zag_str_concat("resource slot requires release `",_zag_str_concat(slot.release,_zag_str_concat("`, not `",_zag_str_concat(release,"`")))),context);}else if(zt_res_owner_is_borrowed(flow.*,slot.path.name)==1){errors=errors+zt_machine_error(_zag_str_concat("resource `",_zag_str_concat(slot.path.name,"` cannot be released while a container retains a borrowed view")),context);}else{flow.*.slots.data[i].state=0;}}i=i+1;}
    if(matched==0){errors=errors+zt_machine_error("release/consume does not name one live resource slot",context);}if(matched==1){zt_res_clear_loans(flow,path,arena);}return errors;
