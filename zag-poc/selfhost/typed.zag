            let mode:i32=zt_local_borrow_binding_mode(l.expr,call_mode,env,decls,context);
            if(mode>0){let root:[]u8=zt_call_borrow_root(l.expr,decls,aliases.*,borrows.*);if(root.len>0){zt_borrow_set(borrows,l.name,root,mode);zt_alias_set(aliases,l.name,root);}}
        }
            let local_ty:[]u8=l.dty;
            if(l.has_dty==0&&l.has_init==1){let inferred:ZTExpr=zt_expr_type(l.expr,env,decls,context);if(inferred.known==1){local_ty=inferred.ty;}}
            if(local_ty.len>0){push[ZTBind](&env,ZTBind{.name=l.name,.ty=local_ty});}
        }
        .ret=>|r|{if(r.has_expr==1){errors=errors+zt_check_active_borrow_expr(r.expr,aliases.*,borrows.*,context)+zt_check_borrow_call(r.expr,decls,env,aliases.*,borrows.*,context);let root:[]u8=zt_borrowed_expr_root(r.expr,decls,env,aliases.*,borrows.*,context);if(root.len>0&&return_contract==0){errors=errors+zt_machine_error("parameter-local borrow cannot escape through return without an explicit return-borrow contract",context);}}}
            .assign=>|a|{let realloc_field:i32=zt_mut_borrow_realloc_reassign(a.target,a.expr,aliases.*,borrows.*);errors=errors+zt_check_active_borrow_expr(a.expr,aliases.*,borrows.*,context);if(realloc_field==1){errors=errors+zt_check_realloc_tail_calls(a.expr,decls,env,aliases.*,borrows.*,context);}else{errors=errors+zt_check_borrow_call(a.expr,decls,env,aliases.*,borrows.*,context);}errors=errors+zt_check_borrow_write(a.target,aliases.*,borrows.*,context);let target:[]u8=zt_expr_transparent_id(a.target);let target_base:[]u8=zt_lvalue_base_name(a.target);let source:[]u8=zt_expr_transparent_id(a.expr);let mode:i32=zt_local_borrow_binding_mode(a.expr,zt_call_borrow_mode(a.expr,decls),env,decls,context);let embedded_root:[]u8=zt_borrowed_expr_root(a.expr,decls,env,aliases.*,borrows.*,context);if(realloc_field==1){embedded_root="";}let enclosing:i32=zt_env_has_name(parent_env,target_base);if(embedded_root.len>0&&target.len==0&&target_base.len>0&&enclosing==1){errors=errors+zt_machine_error(_zag_str_concat("borrowed value `",_zag_str_concat(embedded_root,"` cannot be stored in a non-local aggregate")),context);}if(target.len>0){if(source.len>0){let root:[]u8=zt_alias_root(aliases.*,zt_borrow_alias_root(borrows.*,source));zt_alias_set(aliases,target,root);zt_borrow_set(borrows,target,root,zt_borrow_alias_mode(borrows.*,source));}else if(embedded_root.len>0&&mode==0){let root_mode:i32=zt_borrow_root_mode(borrows.*,embedded_root);if(root_mode==0){root_mode=1;}let derived_mode:i32=zt_local_borrow_binding_mode(a.expr,root_mode,env,decls,context);zt_alias_set(aliases,target,embedded_root);zt_borrow_set(borrows,target,embedded_root,derived_mode);}if(mode>0){let root:[]u8=zt_call_borrow_root(a.expr,decls,aliases.*,borrows.*);if(root.len>0){zt_borrow_set(borrows,target,root,mode);zt_alias_set(aliases,target,root);}}}}
        .estmt=>|e|{errors=errors+zt_check_active_borrow_expr(e.expr,aliases.*,borrows.*,context)+zt_check_borrow_call(e.expr,decls,env,aliases.*,borrows.*,context);switch(e.expr.*){.call=>|c|{let name:[]u8=zt_direct_name(c.callee);if(zt_owned_release_name(name)==1&&c.args.len==1){let release_mode:i32=zt_borrow_alias_mode(borrows.*,zt_expr_transparent_id(c.args.data[0]));if(release_mode==1){errors=errors+zt_machine_error("cannot release through a shared borrow",context);}else{errors=errors+zt_check_borrow_write(c.args.data[0],aliases.*,borrows.*,context);}}}else=>{}}}
        .defer_=>|d|{errors=errors+zt_check_active_borrow_expr(d.expr,aliases.*,borrows.*,context)+zt_check_borrow_call(d.expr,decls,env,aliases.*,borrows.*,context);switch(d.expr.*){.call=>|c|{let name:[]u8=zt_direct_name(c.callee);if(zt_owned_release_name(name)==1&&c.args.len==1){let release_mode:i32=zt_borrow_alias_mode(borrows.*,zt_expr_transparent_id(c.args.data[0]));if(release_mode==1){errors=errors+zt_machine_error("cannot release through a shared borrow",context);}else{errors=errors+zt_check_borrow_write(c.args.data[0],aliases.*,borrows.*,context);}}}else=>{}}}
        .unsafe_=>|u|{errors=errors+zt_check_borrow_body(u.body,env,aliases,borrows,decls,return_contract,context);}
        .if_=>|x|{
            errors=errors+zt_check_active_borrow_expr(x.cond,aliases.*,borrows.*,context);
            let basea:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);let baseb:ArrayList[ZTBorrowAlias]=zt_borrow_clone(borrows.*);
            let ta:ArrayList[ZTOwnAlias]=zt_alias_clone(basea);let tb:ArrayList[ZTBorrowAlias]=zt_borrow_clone(baseb);
            errors=errors+zt_check_borrow_body(x.then_body,env,&ta,&tb,decls,return_contract,context);
            let ea:ArrayList[ZTOwnAlias]=zt_alias_clone(basea);let eb:ArrayList[ZTBorrowAlias]=zt_borrow_clone(baseb);
            if(x.has_els==1){errors=errors+zt_check_borrow_body(x.els_body,env,&ea,&eb,decls,return_contract,context);}
            let next_aliases:ArrayList[ZTOwnAlias]=zt_alias_agree(ta,ea);let next_borrows:ArrayList[ZTBorrowAlias]=zt_borrow_may_join(tb,eb);
            free[ZTOwnAlias](&basea);free[ZTBorrowAlias](&baseb);free[ZTOwnAlias](&ta);free[ZTBorrowAlias](&tb);free[ZTOwnAlias](&ea);free[ZTBorrowAlias](&eb);
            zt_alias_replace(aliases,next_aliases);zt_borrow_replace(borrows,next_borrows);
        }
        .while_=>|x|{
            errors=errors+zt_check_active_borrow_expr(x.cond,aliases.*,borrows.*,context);
            let basea:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);let baseb:ArrayList[ZTBorrowAlias]=zt_borrow_clone(borrows.*);
            let wa:ArrayList[ZTOwnAlias]=zt_alias_clone(basea);let wb:ArrayList[ZTBorrowAlias]=zt_borrow_clone(baseb);
            errors=errors+zt_check_borrow_body(x.body,env,&wa,&wb,decls,return_contract,context);
            let next_aliases:ArrayList[ZTOwnAlias]=zt_alias_agree(basea,wa);let next_borrows:ArrayList[ZTBorrowAlias]=zt_borrow_may_join(baseb,wb);
            free[ZTOwnAlias](&basea);free[ZTBorrowAlias](&baseb);free[ZTOwnAlias](&wa);free[ZTBorrowAlias](&wb);
            zt_alias_replace(aliases,next_aliases);zt_borrow_replace(borrows,next_borrows);
        }
        .switch_=>|s|{
            errors=errors+zt_check_active_borrow_expr(s.subject,aliases.*,borrows.*,context);
            let basea:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);let baseb:ArrayList[ZTBorrowAlias]=zt_borrow_clone(borrows.*);
            let ja:ArrayList[ZTOwnAlias]=zt_alias_clone(basea);let jb:ArrayList[ZTBorrowAlias]=zt_borrow_clone(baseb);
            let have:i32=0;let ai:i32=0;
            while(ai<s.arms.len){
                let aa:ArrayList[ZTOwnAlias]=zt_alias_clone(basea);let ab:ArrayList[ZTBorrowAlias]=zt_borrow_clone(baseb);
                errors=errors+zt_check_borrow_body(s.arms.data[ai].body,env,&aa,&ab,decls,return_contract,context);
                if(have==0){free[ZTOwnAlias](&ja);ja=aa;free[ZTBorrowAlias](&jb);jb=ab;have=1;}
                else{
                    let next_aliases:ArrayList[ZTOwnAlias]=zt_alias_agree(ja,aa);free[ZTOwnAlias](&ja);free[ZTOwnAlias](&aa);ja=next_aliases;
                    let next_borrows:ArrayList[ZTBorrowAlias]=zt_borrow_may_join(jb,ab);free[ZTBorrowAlias](&jb);free[ZTBorrowAlias](&ab);jb=next_borrows;
                }
                ai=ai+1;
            }
            let ea:ArrayList[ZTOwnAlias]=zt_alias_clone(basea);let eb:ArrayList[ZTBorrowAlias]=zt_borrow_clone(baseb);
            errors=errors+zt_check_borrow_body(s.els_body,env,&ea,&eb,decls,return_contract,context);
            if(have==0){free[ZTOwnAlias](&ja);ja=ea;free[ZTBorrowAlias](&jb);jb=eb;}
            else{
                let next_aliases:ArrayList[ZTOwnAlias]=zt_alias_agree(ja,ea);free[ZTOwnAlias](&ja);free[ZTOwnAlias](&ea);ja=next_aliases;
                let next_borrows:ArrayList[ZTBorrowAlias]=zt_borrow_may_join(jb,eb);free[ZTBorrowAlias](&jb);free[ZTBorrowAlias](&eb);jb=next_borrows;
            }
            free[ZTOwnAlias](&basea);free[ZTBorrowAlias](&baseb);
            zt_alias_replace(aliases,ja);zt_borrow_replace(borrows,jb);
        }
        else=>{}
    }i=i+1;}zt_borrow_end_scope_locals(env,parent_env.len,aliases,borrows,initial_aliases,initial_borrows);free[ZTBind](&env);free[ZTOwnAlias](&initial_aliases);free[ZTBorrowAlias](&initial_borrows);return errors;
}
fn zt_check_v2_borrow_contracts(decls:ArrayList[*Node],file:[]u8)i32{
    let v2:i32=@strEq(v2_project_edition(file),"2027") as i32;
    let errors:i32=0;let i:i32=0;
    while(i<decls.len){switch(decls.data[i].*){
        .fn_decl=>|f|{
            let context:[]u8=_zag_str_concat("function ",f.name);
            let shared:i32=zt_fn_has_legacy_annot(decls,f.name,"@borrows");let mutable:i32=zt_fn_has_legacy_annot(decls,f.name,"@borrows_mut");
            // Only legacy function annotations enter the auxiliary-parameter
            // validation below.  Explicit first-parameter contracts are
            // surfaced by zt_borrow_mode for call/aggregate provenance, but
            // must coexist with an explicit @consumes value parameter.
            let mode:i32=((mutable==1) as i32)*2+((shared==1) as i32);
            let aliases:ArrayList[ZTOwnAlias]=make[ZTOwnAlias](4);let borrows:ArrayList[ZTBorrowAlias]=make[ZTBorrowAlias](4);let env:ArrayList[ZTBind]=make[ZTBind](f.params.len+4);
            let ei:i32=0;while(ei<f.params.len){let ep:Param=f.params.data[ei];push[ZTBind](&env,ZTBind{.name=ep.name,.ty=ep.pty});ei=ei+1;}
            if(shared==1&&mutable==1){errors=errors+zt_machine_error("@borrows cannot be combined with @borrows_mut",context);}
            let explicit:i32=0;let ci:i32=0;while(ci<f.params.len){if(f.params.data[ci].contract.len>0){explicit=1;}ci=ci+1;}
            if(explicit==1&&v2==0&&@strEq(f.origin,"<root>")){errors=errors+zt_machine_error("parameter lifetime contracts require edition 2027",context);}
            if(v2==1&&explicit==1&&(shared==1||mutable==1||zt_fn_has_legacy_annot(decls,f.name,"@consumes")==1)){errors=errors+zt_machine_error("parameter lifetime contracts cannot be mixed with legacy function-level borrow or consume contracts",context);}
            if(mode>0){
                if(f.params.len<1){errors=errors+zt_machine_error("borrow contract requires a first owner parameter",context);}
                else{
                    let pi:i32=1;
                    while(pi<f.params.len){
                        let aux:[]u8=f.params.data[pi].pty;
                        // A declared C callback is a one-word code pointer, not
                        // a Zag closure value. Permit it as an auxiliary only
                        // on an explicit @cabi extern borrow contract; ordinary
                        // aggregate/callback auxiliaries remain fail-closed.
                        let cabi_callback:i32=((f.is_extern==1&&zt_fn_has_annot(decls,f.name,"@cabi")==1&&zt_cabi_callback_type_ok(aux)==1) as i32);
                        if(zt_borrow_aux_scalar_type(aux)==0&&cabi_callback==0){errors=errors+zt_machine_error("borrow contract auxiliary parameters must be builtin scalars or declared scalar C callbacks",context);}
                        pi=pi+1;
                    }
                    let param:[]u8=zt_contract_param_name(f);zt_borrow_set(&borrows,param,param,mode);zt_alias_set(&aliases,param,param);
                }
            }
            ci=0;while(ci<f.params.len){
                let p:Param=f.params.data[ci];let contract:[]u8=p.contract;
                if(v2==1&&contract.len>0){
                    if(!@strEq(contract,"@borrows")&&!@strEq(contract,"@borrows_mut")&&!@strEq(contract,"@consumes")&&!@strEq(contract,"@retained_by_return")&&zt_starts(contract,"@owned(")==0){errors=errors+zt_machine_error("unknown parameter lifetime/resource contract",context);}
                    else if(@strEq(contract,"@consumes")&&zt_consumable_param_type(p.pty,decls)==0){errors=errors+zt_machine_error("parameter consume contracts require a raw-pointer, Allocation, or structural resource parameter",context);}
                    else if(@strEq(contract,"@borrows")&&zt_borrow_param_kind(p.pty,decls)==0){errors=errors+zt_machine_error("shared parameter borrow contracts require a raw-pointer, Allocation, slice, or pointer-bearing struct view",context);}
                    else if(@strEq(contract,"@borrows_mut")&&zt_borrow_param_kind(p.pty,decls)!=1){errors=errors+zt_machine_error("mutable parameter borrow contracts require a raw-pointer, Allocation, or slice parameter",context);}
                    else if(@strEq(contract,"@retained_by_return")&&zt_borrow_param_kind(p.pty,decls)==0){errors=errors+zt_machine_error("retained-return contracts require a pointer, slice, Allocation, @resource, or pointer-bearing aggregate parameter",context);}
                    if(@strEq(contract,"@borrows")){zt_borrow_set(&borrows,p.name,p.name,1);zt_alias_set(&aliases,p.name,p.name);}
                    else if(@strEq(contract,"@borrows_mut")){zt_borrow_set(&borrows,p.name,p.name,2);zt_alias_set(&aliases,p.name,p.name);}
                    // A retained-return carrier is both a live shared owner
                    // and a mutable result slot: the callee must invalidate
                    // the carrier after transferring its pointer-bearing
                    // value. Mode 3 preserves the result relation while
                    // allowing those checked field writes.
                    else if(@strEq(contract,"@retained_by_return")){zt_borrow_set(&borrows,p.name,p.name,3);zt_alias_set(&aliases,p.name,p.name);}
                }
                if(v2==1&&contract.len==0&&zt_consumes_param(decls,f.name,ci)==0&&(zt_fn_inferred_retained_param(decls,f.name,ci)==1||zt_resource_type(p.pty,decls)==1)){zt_borrow_set(&borrows,p.name,p.name,1);zt_alias_set(&aliases,p.name,p.name);}
                if(v2==1&&@strEq(zt_fn_param_contract(decls,f.name,ci),"@conflict")){errors=errors+zt_machine_error("conflicting parameter lifetime contracts across declarations",context);}
                ci=ci+1;
            }
            let return_mode:i32=mode;if(zt_fn_has_retained_param(decls,f.name)==1){return_mode=1;}
            // The borrow body walk is only authoritative for functions whose
            // signature can carry a lifetime/resource relation.  Running the
            // full recursive provenance pass over every ordinary function in
            // a large module graph was both redundant and a self-hosting
            // compile-time cliff; the separate resource/typed passes still
            // validate ordinary functions and all explicit/resource-bearing
            // signatures remain covered here.
            let needs_body:i32=((mode>0||explicit==1||return_mode!=0) as i32);
            if(needs_body==0&&v2==1){let ri:i32=0;while(ri<f.params.len){if(zt_resource_type(f.params.data[ri].pty,decls)==1){needs_body=1;}ri=ri+1;}}
            if(v2==1&&needs_body==1){errors=errors+zt_check_borrow_body(f.body,env,&aliases,&borrows,decls,return_mode,context);}
            free[ZTBind](&env);free[ZTOwnAlias](&aliases);free[ZTBorrowAlias](&borrows);
        }
        else=>{}
    }i=i+1;}
    return errors;
}

// Capturing closures own a heap environment and enter the edition-2027
// ownership flow: a scalar capture by value may be returned/transferred or
// released with `close` on every path. Pointer captures retain a defining-frame
// address and remain fail-closed. Native lowering also rejects aggregate
// captures until nested heap copies have a destruction protocol.
fn zt_check_v2_closure_lifetimes(decls:ArrayList[*Node],file:[]u8)i32{
    if(@strEq(v2_project_edition(file),"2027")==0){return 0;}
    let errors:i32=0;let i:i32=0;
    while(i<decls.len){switch(decls.data[i].*){
        .fn_decl=>|f|{if(f.caps>0&&zt_find(f.cap_names,'*')>=0){errors=errors+zt_machine_error("capturing pointer closure requires an explicit v2 lifetime contract",_zag_str_concat("closure ",f.name));}}
        else=>{}
    }i=i+1;}
    return errors;
}

fn typed_check_program(decls0: ArrayList[*Node], file: []u8) i32 {
    let decls: ArrayList[[]u8] = zt_decl_names(decls0);
    let errors: i32 = 0;
    let i: i32 = 0;
    while (i < len[*Node](decls0)) {
        switch (get[*Node](decls0, i).*) {
            .struct_ => |s| {
                let context: []u8 = _zag_str_concat("struct ", s.name);
                let layout_target: i32 = zt_layout_target_kind();
                if (s.repr_c == 1) {
                    if (@strEq(v2_project_edition(file), "2027") == 0) {
                        errors = errors + zt_machine_error("@repr(C) requires edition = \"2027\"", context);
                    }
                    if (layout_target == 0) {
                        errors = errors + zt_machine_error("@repr(C) requires one of the supported Linux targets: x86-64, AArch64, or i686", context);
                    }
                    if (len[[]u8](s.tparams) != 0) {
                        errors = errors + zt_machine_error("generic @repr(C) structs are not implemented", context);
                    }
                    if (len[Param](s.fields) == 0) {
                        errors = errors + zt_machine_error("empty @repr(C) structs are not implemented", context);
                    }
                }
                let packed: i32 = zt_struct_layout_annot(s, "@repr(packed)");
                let explicit_align: i32 = zt_struct_explicit_align(s);
                if (packed == 1) {
                    if (@strEq(v2_project_edition(file), "2027") == 0) {
                        errors = errors + zt_machine_error("@repr(packed) requires edition = \"2027\"", context);
                    }
                    if (s.repr_c == 1) {
                        errors = errors + zt_machine_error("@repr(packed) cannot be combined with @repr(C)", context);
                    }
                    if (layout_target == 0) {
                        errors = errors + zt_machine_error("@repr(packed) requires one of the supported Linux targets: x86-64, AArch64, or i686", context);
                    }
                    if (s.tparams.len != 0 || s.fields.len == 0) {
                        errors = errors + zt_machine_error("packed layout requires a non-generic, non-empty struct", context);
                    }
                }
                if (explicit_align != 0 && zt_layout_power_of_two(explicit_align) == 0) {
                    errors = errors + zt_machine_error("explicit struct alignment must be a power of two from 1 through 64", context);
                }
                let packed_offset: i32 = 0;
                let fi: i32 = 0;
                while (fi < len[Param](s.fields)) {
                    if (s.repr_c == 1 && (zt_repr_c_field_supported_target(get[Param](s.fields, fi).pty, layout_target) == 0 ||
                        get[Param](s.fields, fi).calign != 0)) {
                        if (layout_target == 3 && (zt_repr_c_field_supported(get[Param](s.fields, fi).pty) == 1)) {
                            errors = errors + zt_machine_error("i686 @repr(C) fields require 32-bit-or-wider scalar/pointer leaves until subword aggregate lowering is available", context);
                        } else {
                            errors = errors + zt_machine_error("@repr(C) fields require target-supported scalar/pointer C leaves without @cacheAlign", context);
                        }
                    }
                    let field: Param = get[Param](s.fields, fi);
                    if(zt_atomic_i64_forbidden_type(field.pty)==1){errors=errors+zt_machine_error("AtomicI64 cannot be embedded in structs",context);}
                    if (packed == 1) {
                        let field_size: i32 = zt_layout_scalar_size_target(field.pty, layout_target);
                        let field_align: i32 = field_size;
                        if (field_size == 0 || field_align == 0 || zt_repr_c_field_supported_target(field.pty, layout_target) == 0) {
                            errors = errors + zt_machine_error("packed fields must be fixed-width scalars or pointers", context);
                        } else {
                            let required: i32 = field_align;
                            if (field.calign > required) { required = field.calign; }
                            if (required > 1 && packed_offset % required != 0) {
                                errors = errors + zt_machine_error("packed layout would create an unaligned field access", context);
                            }
                            packed_offset = packed_offset + field_size;
                        }
                    }
                    errors = errors + zt_validate_type(get[Param](s.fields, fi).pty, decls, s.tparams, context);
                    fi = fi + 1;
                }
            }
            .union_ => |u| {
                let context: []u8 = _zag_str_concat("union ", u.name);
                let none: ArrayList[[]u8] = make[[]u8](1);
                let fi: i32 = 0;
                while (fi < len[Param](u.fields)) {
                    if(zt_atomic_i64_forbidden_type(get[Param](u.fields,fi).pty)==1){errors=errors+zt_machine_error("AtomicI64 cannot be embedded in unions",context);}
                    errors = errors + zt_validate_type(get[Param](u.fields, fi).pty, decls, none, context);
                    fi = fi + 1;
                }
                free[[]u8](&none);
            }
            .fn_decl => |f| {
                let context: []u8 = _zag_str_concat("function ", f.name);
                let pi: i32 = 0;
                while (pi < len[Param](f.params)) {
                    if(zt_atomic_i64_forbidden_type(get[Param](f.params,pi).pty)==1){errors=errors+zt_machine_error("AtomicI64 cannot be a function parameter",context);}
                    if (zt_is_repr_c_type(get[Param](f.params, pi).pty, decls0) == 1) {
                        errors = errors + zt_repr_c_by_value_error(context);
                    }
                    errors = errors + zt_validate_type(get[Param](f.params, pi).pty, decls, f.tparams, context);
                    pi = pi + 1;
                }
                if(zt_atomic_i64_forbidden_type(f.ret)==1){errors=errors+zt_machine_error("AtomicI64 cannot be a function return type",context);}
                if (zt_is_repr_c_type(f.ret, decls0) == 1) {
                    errors = errors + zt_repr_c_by_value_error(context);
                }
                errors = errors + zt_validate_type(f.ret, decls, f.tparams, context);
                errors = errors + zt_check_body(f.body, decls, f.tparams, context);
            }
            else => { }
        }
        i = i + 1;
    }
    errors = errors + zt_check_globals(decls0, file);
    errors = errors + zt_check_v2_cabi_declarations(decls0, file);
    errors = errors + zt_check_v2_cabi_exports(decls0, file);
    errors = errors + zt_check_v2_resource_declarations(decls0, file);
    errors = errors + zt_check_v2_driver_handles(decls0, file);
    errors = errors + zt_check_driver_profiles(decls0, file);
    errors = errors + zt_check_driver_linux_api_annotations(decls0, file);
    errors = errors + zt_check_expressions(decls0);
    errors = errors + zt_check_machine_control(decls0);
    errors = errors + zt_check_v2_direct_frees(decls0, file);
    errors = errors + zt_check_v2_retained_regions(decls0, file);
    errors = errors + zt_check_v2_stack_address_escapes(decls0, file);
    errors = errors + zt_check_v2_aggregate_provenance(decls0, file);
    errors = errors + zt_check_v2_resources(decls0, file);
    errors = errors + zt_check_v2_borrow_contracts(decls0, file);
    errors = errors + zt_check_v2_closure_lifetimes(decls0, file);
    free[[]u8](&decls);
    if (errors > 0) {
        _zag_eprintln(_zag_str_concat(_zag_str_concat("znc: typed declaration check FAILED for ", file),
                                     _zag_str_concat(" (errors=", _zag_str_concat(_zag_i64_to_str(errors as i64), ")"))));
    }
    return errors;
}
