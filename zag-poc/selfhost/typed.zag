// selfhost/typed.zag — shared declared-type authority for every znc target.
//
// The parser still stores source spellings in the frozen-v1 AST, but every
// target resolves declaration and explicit-local types through this pass before
// lowering. Unknown names are hard errors; no backend may invent a layout.
// This is a real first typed-front-end slice, not yet the complete typed ZIR.

@import("parse.zag")
@import("v2_edition.zag")
@import("vsa_type.zag")

fn zt_starts(s: []u8, prefix: []u8) i32 {
    if (s.len < prefix.len) { return 0; }
    let i: i32 = 0;
    while (i < prefix.len) {
        if (s[i] != prefix[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn zt_find(s: []u8, ch: u8) i32 {
    let i: i32 = 0;
    while (i < s.len) {
        if (s[i] == ch) { return i; }
        i = i + 1;
    }
    return -1;
}

// Explicit representation is target-aware, rather than inherited from the
// host running znc.  These are the scalar/pointer leaves whose initial Linux
// ABIs have a stable width and natural alignment on x86-64, AArch64, and
// i686.  A backend may still reject a particular aggregate lowering, but it
// must never silently substitute the host layout.
fn zt_repr_c_field_supported(ty0: []u8) i32 {
    let ty: []u8 = ty0;
    if (ty.len > 0 && ty[0] == '*') { return 1; }
    if (@strEq(ty, "bool") || @strEq(ty, "i8") || @strEq(ty, "u8") ||
        @strEq(ty, "i16") || @strEq(ty, "u16") || @strEq(ty, "i32") ||
        @strEq(ty, "u32") || @strEq(ty, "i64") || @strEq(ty, "u64") ||
        @strEq(ty, "isize") || @strEq(ty, "usize") || @strEq(ty, "f32") ||
        @strEq(ty, "f64")) { return 1; }
    return 0;
}

// 1 = x86-64, 2 = AArch64, 3 = i686.  Keep this parser in the typed
// authority so @repr(C), layout builtins, and every native backend agree on
// the selected target even when the compiler itself runs on another host.
fn zt_layout_target_kind() i32 {
    let selected: []u8 = "";
    let i: i32 = 1;
    while (i < _zag_argc()) {
        let arg: []u8 = _zag_arg(i);
        if (@strEq(arg, "--target") && i + 1 < _zag_argc()) {
            selected = _zag_arg(i + 1);
            i = i + 1;
        } else if (zt_starts(arg, "--target=") == 1) {
            selected = arg[9..];
        }
        i = i + 1;
    }
    if (selected.len == 0 || @strEq(selected, "x86_64") ||
        @strEq(selected, "x86-64") || @strEq(selected, "linux-x86_64")) { return 1; }
    if (@strEq(selected, "arm64") || @strEq(selected, "aarch64") ||
        @strEq(selected, "linux-arm64")) { return 2; }
    if (@strEq(selected, "i686") || @strEq(selected, "i386") ||
        @strEq(selected, "linux-i686")) { return 3; }
    return 0;
}

fn zt_layout_scalar_size_target(ty: []u8, target: i32) i32 {
    if (@strEq(ty, "bool") || @strEq(ty, "i8") || @strEq(ty, "u8")) { return 1; }
    if (@strEq(ty, "i16") || @strEq(ty, "u16")) { return 2; }
    if (@strEq(ty, "i32") || @strEq(ty, "u32") || @strEq(ty, "f32")) { return 4; }
    if (@strEq(ty, "i64") || @strEq(ty, "u64") || @strEq(ty, "f64")) { return 8; }
    if (@strEq(ty, "isize") || @strEq(ty, "usize") || (ty.len > 0 && ty[0] == '*')) {
        if (target == 3) { return 4; }
        if (target == 1 || target == 2) { return 8; }
        return 0;
    }
    return 0;
}

fn zt_repr_c_field_supported_target(ty: []u8, target: i32) i32 {
    if (zt_repr_c_field_supported(ty) == 0 || target == 0) { return 0; }
    // The i686 aggregate backend represents scalar locals in 32-bit words.
    // Until it has byte/halfword aggregate slots and their exact address
    // lowering, accepting those fields would make @offsetOf truthful while
    // generated accesses were not.  Reject the mismatch at the contract
    // boundary; 32-bit and wider leaves have the same initial layout here.
    if (target == 3 && (@strEq(ty, "bool") || @strEq(ty, "i8") ||
        @strEq(ty, "u8") || @strEq(ty, "i16") || @strEq(ty, "u16"))) { return 0; }
    return (zt_layout_scalar_size_target(ty, target) > 0) as i32;
}

fn zt_is_repr_c_type(ty: []u8, decls: ArrayList[*Node]) i32 {
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .struct_ => |s| {
                if (s.repr_c == 1 && @strEq(s.name, ty)) { return 1; }
            }
            else => { }
        }
        i = i + 1;
    }
    return 0;
}

fn zt_repr_c_by_value_error(context: []u8) i32 {
    return zt_machine_error("@repr(C) aggregates are pointer-only in the initial driver ABI", context);
}

// Layout metadata is carried in the declaration annotation list so imported
// and qualified structs retain the same source-level contract.  These helpers
// are the typed authority for the public layout builtins; backends must use the
// same layout functions rather than guessing from the host compiler ABI.
fn zt_layout_align_value(annot: []u8) i32 {
    if (annot.len < 9 || zt_starts(annot, "@align(") == 0 || annot[annot.len - 1] != ')') { return 0; }
    return _zag_str_to_i64(annot[7..annot.len - 1]) as i32;
}
fn zt_layout_power_of_two(value: i32) i32 {
    if (value <= 0 || value > 64) { return 0; }
    let n: i32 = 1;
    while (n < value) { n = n * 2; }
    return (n == value) as i32;
}
fn zt_struct_layout_annot(s: StructDecl, wanted: []u8) i32 {
    let i: i32 = 0;
    while (i < s.annots.len) {
        if (@strEq(s.annots.data[i], wanted)) { return 1; }
        i = i + 1;
    }
    return 0;
}
fn zt_struct_explicit_align(s: StructDecl) i32 {
    let result: i32 = 0;
    let i: i32 = 0;
    while (i < s.annots.len) {
        let value: i32 = zt_layout_align_value(s.annots.data[i]);
        if (value > 0) { result = value; }
        i = i + 1;
    }
    return result;
}
fn zt_layout_scalar_size(ty: []u8) i32 {
    return zt_layout_scalar_size_target(ty, zt_layout_target_kind());
}
fn zt_layout_declared(ty: []u8, decls: ArrayList[*Node]) i32 {
    if (zt_layout_scalar_size(ty) > 0) { return 1; }
    let base: []u8 = ty;
    if (is_generic_app(ty) == 1) { base = ty[0..zt_find(ty, '[')]; }
    let i: i32 = 0;
    while (i < decls.len) {
        switch (decls.data[i].*) {
            .struct_ => |s| { if (@strEq(s.name, base)) { return 1; } }
            .union_ => |u| { if (@strEq(u.name, base)) { return 1; } }
            .enum_ => |e| { if (@strEq(e.name, base)) { return 1; } }
            else => { }
        }
        i = i + 1;
    }
    return 0;
}
fn zt_layout_field_name(n: *Node) []u8 {
    switch (n.*) {
        .slit => |s| {
            if (s.text.len >= 2 && s.text[0] == '"' && s.text[s.text.len - 1] == '"') {
                return s.text[1..s.text.len - 1];
            }
        }
        else => { }
    }
    return "";
}
fn zt_layout_field_exists(ty: []u8, field: []u8, decls: ArrayList[*Node]) i32 {
    let base: []u8 = ty;
    if (is_generic_app(ty) == 1) { base = ty[0..zt_find(ty, '[')]; }
    let i: i32 = 0;
    while (i < decls.len) {
        switch (decls.data[i].*) {
            .struct_ => |s| {
                if (@strEq(s.name, base)) {
                    let j: i32 = 0;
                    while (j < s.fields.len) {
                        if (@strEq(s.fields.data[j].name, field)) { return 1; }
                        j = j + 1;
                    }
                    return 0;
                }
            }
            else => { }
        }
        i = i + 1;
    }
    return 0;
}
fn zt_layout_builtin(c: Call, decls: ArrayList[*Node], context: []u8) ZTExpr {
    let name: []u8 = zt_direct_name(c.callee);
    if (!@strEq(name, "@alignOf") && !@strEq(name, "@offsetOf")) { return zt_expr_unknown(0); }
    let errors: i32 = 0;
    if (c.targs.len != 1) {
        errors = errors + zt_machine_error("layout builtin requires exactly one type argument", context);
    } else if (zt_layout_declared(c.targs.data[0], decls) == 0 || zt_is_type_param(c.targs.data[0]) == 1) {
        errors = errors + zt_machine_error("layout builtin type argument is not a declared fixed-width or aggregate type", context);
    }
    if (@strEq(name, "@alignOf")) {
        if (c.args.len != 0) { errors = errors + zt_machine_error("@alignOf accepts no value arguments", context); }
    } else {
        if (c.args.len != 1) { errors = errors + zt_machine_error("@offsetOf accepts one string field name", context); }
        else {
            let field: []u8 = zt_layout_field_name(c.args.data[0]);
            if (field.len == 0) { errors = errors + zt_machine_error("@offsetOf field name must be a string literal", context); }
            else if (c.targs.len == 1 && zt_layout_field_exists(c.targs.data[0], field, decls) == 0) {
                errors = errors + zt_machine_error("@offsetOf names no field in its struct type", context);
            }
        }
    }
    return zt_expr_known("i64", 0, errors);
}

fn zt_in_names(names: ArrayList[[]u8], name: []u8) i32 {
    let i: i32 = 0;
    while (i < len[[]u8](names)) {
        if (@strEq(get[[]u8](names, i), name)) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn zt_is_builtin(name: []u8) i32 {
    if (@strEq(name, "void") || @strEq(name, "bool") || @strEq(name, "AtomicI64")) { return 1; }
    if (@strEq(name, "i8") || @strEq(name, "i16") ||
        @strEq(name, "i32") || @strEq(name, "i64") || @strEq(name, "isize")) { return 1; }
    if (@strEq(name, "u8") || @strEq(name, "u16") ||
        @strEq(name, "u32") || @strEq(name, "u64") || @strEq(name, "usize")) { return 1; }
    if (@strEq(name, "f32") || @strEq(name, "f64")) { return 1; }
    if (@strEq(name, "bf16") || @strEq(name, "mx_fp8") ||
        @strEq(name, "mx_fp4")) { return 1; }
    if (@strEq(name, "l16") || @strEq(name, "l32")) { return 1; }
    if (@strEq(name, "p8") || @strEq(name, "p16") ||
        @strEq(name, "p32") || @strEq(name, "p64")) { return 1; }
    if (@strEq(name, "rns_3") || @strEq(name, "quire")) { return 1; }
    if (zt_starts(name, "sat_") == 1 || zt_starts(name, "fixed_") == 1 ||
        zt_starts(name, "lns") == 1) { return 1; }
    if (vsa_type_valid(name) == 1) { return 1; }
    if (@strEq(name, "gpu_buf")) { return 1; }
    // Arbitrary-width signed/unsigned integers are supported v1 extensions.
    if (name.len > 1 && (name[0] == 'i' || name[0] == 'u')) {
        let i: i32 = 1;
        while (i < name.len) {
            if (name[i] < '0' || name[i] > '9') { return 0; }
            i = i + 1;
        }
        return 1;
    }
    return 0;
}

fn zt_decl_names(decls: ArrayList[*Node]) ArrayList[[]u8] {
    let names: ArrayList[[]u8] = make[[]u8](16);
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .struct_ => |s| { push[[]u8](&names, s.name); }
            .enum_   => |e| { push[[]u8](&names, e.name); }
            .union_  => |u| { push[[]u8](&names, u.name); }
            .fn_decl => |f| {
                // The frozen-v1 parser represents `interface Shape` as the
                // metadata declaration `fn __iface_Shape`. Preserve Shape as
                // a real type name until interfaces gain a dedicated AST node.
                if (zt_starts(f.name, "__iface_") == 1 && f.name.len > 8) {
                    push[[]u8](&names, f.name[8..]);
                }
            }
            else => { }
        }
        i = i + 1;
    }
    return names;
}

// Explicit globals are one-word BSS cells. Pointer globals are admitted only
// through this declaration boundary; aggregate/callback/optional storage still
// lacks a destruction and ownership contract and remains rejected.
fn zt_global_scalar_type(ty: []u8) i32 {
    if (ty.len == 0 || @strEq(ty, "void")) { return 0; }
    if (ty[0] == '*') { return 1; }
    if (zt_starts(ty, "[]") == 1 || ty[0] == '?' || ty[0] == '!' || zt_starts(ty, "fn(") == 1) { return 0; }
    if (vsa_type_valid(ty) == 1) { return 0; }
    return zt_is_builtin(ty);
}
fn zt_global_pointer_name(decls: ArrayList[*Node], name: []u8) i32 {
    if (name.len == 0) { return 0; }
    let i: i32 = 0;
    while (i < decls.len) {
        switch (decls.data[i].*) {
            .let_ => |l| {
                if (l.is_global == 1 && @strEq(l.name, name) &&
                    l.has_dty == 1 && l.dty.len > 0 && l.dty[0] == '*') { return 1; }
            }
            else => { }
        }
        i = i + 1;
    }
    return 0;
}
fn zt_is_atomic_i64(ty: []u8) i32 { return @strEq(ty, "AtomicI64") as i32; }
fn zt_contains_atomic_i64(ty: []u8) i32 {
    let needle: []u8 = "AtomicI64";
    let i: i32 = 0;
    while (i + needle.len <= ty.len) {
        let j: i32 = 0;
        while (j < needle.len && ty[i + j] == needle[j]) { j = j + 1; }
        if (j == needle.len) { return 1; }
        i = i + 1;
    }
    return 0;
}

// AtomicI64 is compiler-reserved storage, never a scalar value.  It has no
// user-visible representation: no pointer, field, copy, aggregate, parameter,
// or return boundary may expose its underlying word.
fn zt_atomic_i64_forbidden_type(ty: []u8) i32 {
    if (@strEq(ty, "AtomicI64")) { return 1; }
    return zt_contains_atomic_i64(ty);
}
fn zt_global_zero_initializer(l: Let) i32 {
    if (l.has_init == 0) { return 1; }
    switch (l.expr.*) {
        .ilit => |x| { if (x.text.len == 1 && x.text[0] == '0') { return 1; } }
        else => { }
    }
    return 0;
}
fn zt_check_globals(decls: ArrayList[*Node], file: []u8) i32 {
    if (@strEq(v2_project_edition(file), "2027") == 0) { return 0; }
    let errors: i32 = 0;
    let names: ArrayList[[]u8] = make[[]u8](8);
    let i: i32 = 0;
    while (i < decls.len) {
        switch (decls.data[i].*) {
            .let_ => |l| { if (l.is_global == 1) {
                if (l.has_dty == 0 || zt_global_scalar_type(l.dty) == 0) { errors = errors + zt_machine_error("global storage requires an explicitly typed scalar or pointer; aggregates, callbacks, and optionals have no global lifetime contract", "global declaration"); }
                if (l.has_dty == 1 && zt_atomic_i64_forbidden_type(l.dty) == 1 && zt_is_atomic_i64(l.dty) == 0) { errors = errors + zt_machine_error("AtomicI64 global storage cannot be wrapped or addressed", "global declaration"); }
                if (zt_global_zero_initializer(l) == 0) { errors = errors + zt_machine_error("global storage currently permits only zero initialization", "global declaration"); }
                if (zt_in_names(names, l.name) == 1) { errors = errors + zt_machine_error("duplicate global declaration", "global declaration"); }
                else { push[[]u8](&names, l.name); }
            }}
            else => { }
        }
        i = i + 1;
    }
    free[[]u8](&names);
    return errors;
}
fn zt_seed_globals(env: *ArrayList[ZTBind], decls: ArrayList[*Node]) void {
    let i: i32 = 0;
    while (i < decls.len) {
        switch (decls.data[i].*) { .let_ => |l| { if (l.is_global == 1) { push[ZTBind](env, ZTBind{.name=l.name,.ty=l.dty}); } } else => { } }
        i = i + 1;
    }
}

fn zt_report_unknown(name: []u8, context: []u8) i32 {
    _zag_eprintln(_zag_str_concat(_zag_str_concat(
        _zag_str_concat("error[E0202]: unknown type '", name),
        _zag_str_concat("' in ", context)),
        "; declare the type or use a supported builtin"));
    return 1;
}

fn zt_validate_type(ty0: []u8, decls: ArrayList[[]u8],
                    tparams: ArrayList[[]u8], context: []u8) i32 {
    if (ty0.len == 0) { return 0; }
    let ty: []u8 = ty0;
    while (ty.len > 0) {
        if (zt_starts(ty, "[]") == 1) { ty = ty[2..]; }
        else {
            if (zt_starts(ty, "*const ") == 1) { ty = ty[7..]; }
            else if (zt_starts(ty, "*mut ") == 1) { ty = ty[5..]; }
            else if (zt_starts(ty, "*device ") == 1) { ty = ty[8..]; }
            else if (zt_starts(ty, "*workgroup ") == 1) { ty = ty[11..]; }
            else if (zt_starts(ty, "*host ") == 1) { ty = ty[6..]; }
            else if (@strEq(ty, "*opaque")) { return 0; }
            else if (ty[0] == '*' || ty[0] == '?' || ty[0] == '!') { ty = ty[1..]; }
            else { break; }
        }
    }
    if (ty.len == 0) { return zt_report_unknown(ty0, context); }

    // Function type internals become structured ZType nodes in the next slice.
    if (zt_starts(ty, "fn(") == 1) { return 0; }

    let lb: i32 = zt_find(ty, '[');
    if (lb >= 0) {
        if (ty[ty.len - 1] != ']') { return zt_report_unknown(ty, context); }
        let base: []u8 = ty[0..lb];
        if (zt_is_builtin(base) == 0 && zt_in_names(decls, base) == 0 &&
            zt_in_names(tparams, base) == 0) { return zt_report_unknown(base, context); }
        let errors: i32 = 0;
        let start: i32 = lb + 1;
        let depth: i32 = 0;
        let i: i32 = start;
        while (i < ty.len - 1) {
            if (ty[i] == '[') { depth = depth + 1; }
            if (ty[i] == ']') { depth = depth - 1; }
            if (ty[i] == ',' && depth == 0) {
                errors = errors + zt_validate_type(ty[start..i], decls, tparams, context);
                start = i + 1;
            }
            i = i + 1;
        }
        if (start < ty.len - 1) {
            errors = errors + zt_validate_type(ty[start..ty.len - 1], decls, tparams, context);
        }
        return errors;
    }

    if (zt_is_builtin(ty) == 1 || zt_in_names(decls, ty) == 1 ||
        zt_in_names(tparams, ty) == 1) { return 0; }
    return zt_report_unknown(ty, context);
}

fn zt_check_expr(n: *Node, decls: ArrayList[[]u8],
                 tparams: ArrayList[[]u8], context: []u8) i32 {
    switch (n.*) {
        .bin => |b| { return zt_check_expr(b.l, decls, tparams, context) +
                            zt_check_expr(b.r, decls, tparams, context); }
        .un => |u| { return zt_check_expr(u.e, decls, tparams, context); }
        .call => |c| {
            let errors: i32 = zt_check_expr(c.callee, decls, tparams, context);
            let i: i32 = 0;
            while (i < len[*Node](c.args)) {
                errors = errors + zt_check_expr(get[*Node](c.args, i), decls, tparams, context);
                i = i + 1;
            }
            let ti: i32 = 0;
            while (ti < len[[]u8](c.targs)) {
                errors = errors + zt_validate_type(get[[]u8](c.targs, ti), decls, tparams, context);
                ti = ti + 1;
            }
            return errors;
        }
        .idx => |x| { return zt_check_expr(x.base, decls, tparams, context) +
                            zt_check_expr(x.idx, decls, tparams, context); }
        .fld => |f| { return zt_check_expr(f.base, decls, tparams, context); }
        .slit_ => |s| {
            let errors: i32 = zt_validate_type(s.sname, decls, tparams, context);
            let ti: i32 = 0;
            while (ti < len[[]u8](s.targs)) {
                errors = errors + zt_validate_type(get[[]u8](s.targs, ti), decls, tparams, context);
                ti = ti + 1;
            }
            let i: i32 = 0;
            while (i < len[FieldInit](s.fields)) {
                errors = errors + zt_check_expr(get[FieldInit](s.fields, i).val, decls, tparams, context);
                i = i + 1;
            }
            return errors;
        }
        .cast_ => |c| { return zt_validate_type(c.target, decls, tparams, context) +
                              zt_check_expr(c.expr, decls, tparams, context); }
        .slice_ => |s| { return zt_check_expr(s.base, decls, tparams, context) +
                                zt_check_expr(s.lo, decls, tparams, context) +
                                zt_check_expr(s.hi, decls, tparams, context); }
        else => { return 0; }
    }
}

fn zt_check_body(body: ArrayList[*Node], decls: ArrayList[[]u8],
                 tparams: ArrayList[[]u8], context: []u8) i32 {
    let errors: i32 = 0;
    let i: i32 = 0;
    while (i < len[*Node](body)) {
        let n: *Node = get[*Node](body, i);
        switch (n.*) {
            .let_ => |l| {
                if (l.has_dty == 1) { errors = errors + zt_validate_type(l.dty, decls, tparams, context); }
                if (l.has_init == 1) { errors = errors + zt_check_expr(l.expr, decls, tparams, context); }
            }
            .ret => |r| { if (r.has_expr == 1) { errors = errors + zt_check_expr(r.expr, decls, tparams, context); } }
            .if_ => |x| {
                errors = errors + zt_check_expr(x.cond, decls, tparams, context);
                errors = errors + zt_check_body(x.then_body, decls, tparams, context);
                if (x.has_els == 1) { errors = errors + zt_check_body(x.els_body, decls, tparams, context); }
            }
            .while_ => |w| {
                errors = errors + zt_check_expr(w.cond, decls, tparams, context);
                errors = errors + zt_check_body(w.body, decls, tparams, context);
            }
            .unsafe_ => |u| { errors = errors + zt_check_body(u.body, decls, tparams, context); }
            .defer_ => |d| { errors = errors + zt_check_expr(d.expr, decls, tparams, context); }
            .assign => |a| { errors = errors + zt_check_expr(a.target, decls, tparams, context) +
                                                    zt_check_expr(a.expr, decls, tparams, context); }
            .estmt => |e| { errors = errors + zt_check_expr(e.expr, decls, tparams, context); }
            .switch_ => |s| {
                errors = errors + zt_check_expr(s.subject, decls, tparams, context);
                let ai: i32 = 0;
                while (ai < len[SwitchArm](s.arms)) {
                    errors = errors + zt_check_body(get[SwitchArm](s.arms, ai).body, decls, tparams, context);
                    ai = ai + 1;
                }
                if (s.has_els == 1) { errors = errors + zt_check_body(s.els_body, decls, tparams, context); }
            }
            else => { }
        }
        i = i + 1;
    }
    return errors;
}

// ── expression type vertical slice ──────────────────────────────────────────
// Only types proved by this pass are compared. Backend-specific or unresolved
// generic/interface cases remain unknown and are not guessed.
struct ZTBind { name: []u8, ty: []u8 }
struct ZTExpr { ty: []u8, known: i32, literal: i32, errors: i32 }

fn zt_expr_unknown(errors: i32) ZTExpr {
    return ZTExpr{ .ty = "", .known = 0, .literal = 0, .errors = errors };
}
fn zt_expr_known(ty: []u8, literal: i32, errors: i32) ZTExpr {
    return ZTExpr{ .ty = ty, .known = 1, .literal = literal, .errors = errors };
}
fn zt_has_dot(s: []u8) i32 {
    let i: i32 = 0;
    while (i < s.len) { if (s[i] == '.') { return 1; } i = i + 1; }
    return 0;
}
fn zt_env_get(env: ArrayList[ZTBind], name: []u8) []u8 {
    let i: i32 = len[ZTBind](env) - 1;
    while (i >= 0) {
        let b: ZTBind = get[ZTBind](env, i);
        if (@strEq(b.name, name)) { return b.ty; }
        i = i - 1;
    }
    return "";
}
fn zt_env_has_name(env: ArrayList[ZTBind], name: []u8) i32 {
    let i: i32 = 0;
    while (i < env.len) {
        if (@strEq(env.data[i].name, name)) { return 1; }
        i = i + 1;
    }
    return 0;
}
fn zt_env_clone(env: ArrayList[ZTBind]) ArrayList[ZTBind] {
    let out: ArrayList[ZTBind] = make[ZTBind](len[ZTBind](env) + 8);
    let i: i32 = 0;
    while (i < len[ZTBind](env)) {
        push[ZTBind](&out, get[ZTBind](env, i));
        i = i + 1;
    }
    return out;
}
fn zt_fn_ret(decls: ArrayList[*Node], name: []u8) []u8 {
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| { if (@strEq(f.name, name)) { return f.ret; } }
            else => { }
        }
        i = i + 1;
    }
    return "";
}

// Resolve a generic call result against one declaration atomically. Looking
// up the return spelling and type-parameter list in separate scans can pair
// metadata from different same-named declarations after import flattening.
// That left explicit results such as get[vsa_b<65>](...) unknown to the
// expression checker, which then emitted a false VSA operand mismatch.
fn zt_instantiated_call_ret(decls: ArrayList[*Node], name: []u8,
                            targs: ArrayList[[]u8]) []u8 {
    let fallback: []u8 = "";
    let i: i32 = 0;
    while (i < decls.len) {
        switch (decls.data[i].*) {
            .fn_decl => |f| {
                if (@strEq(f.name, name)) {
                    if (fallback.len == 0) { fallback = f.ret; }
                    if (f.tparams.len == targs.len) {
                        let resolved: []u8 = zt_subst_type(f.ret, f.tparams,
                            targs);
                        if (resolved.len > 0 &&
                            zt_is_type_param(resolved) == 0) {
                            return resolved;
                        }
                    }
                }
            }
            else => { }
        }
        i = i + 1;
    }
    return fallback;
}
// Substitute explicit generic arguments through the complete source-level type
// spelling.  The typed authority runs before monomorphized lowering, so it must
// not report wrapped results such as ?V or !T as concrete types when a call
// supplied V/T explicitly.  Keep this aligned with cg_subst_type.
fn zt_subst_type(t: []u8, names: ArrayList[[]u8], vals: ArrayList[[]u8]) []u8 {
    let i: i32 = 0;
    while (i < len[[]u8](names) && i < len[[]u8](vals)) {
        if (@strEq(t, get[[]u8](names, i))) { return get[[]u8](vals, i); }
        i = i + 1;
    }
    if (t.len > 1) {
        if (t[0] == '*') { return _zag_str_concat("*", zt_subst_type(t[1..], names, vals)); }
        if (t[0] == '?') { return _zag_str_concat("?", zt_subst_type(t[1..], names, vals)); }
        if (t[0] == '!') { return _zag_str_concat("!", zt_subst_type(t[1..], names, vals)); }
    }
    if (t.len > 2 && t[0] == '[' && t[1] == ']') {
        return _zag_str_concat("[]", zt_subst_type(t[2..], names, vals));
    }
    if (is_generic_app(t)) {
        let lb: i32 = index_of(t, '[');
        let args: ArrayList[[]u8] = split_args(t[lb + 1..t.len - 1]);
        let out: []u8 = _zag_str_concat(t[0..lb], "[");
        let ai: i32 = 0;
        while (ai < len[[]u8](args)) {
            if (ai > 0) { out = _zag_str_concat(out, ","); }
            out = _zag_str_concat(out, zt_subst_type(get[[]u8](args, ai), names, vals));
            ai = ai + 1;
        }
        let result:[]u8=_zag_str_concat(out, "]");
        free[[]u8](&args);
        return result;
    }
    return t;
}
// Resolve a field through both a plain named aggregate and an instantiated
// generic aggregate. The expression checker previously compared `Box[T]`
// literally with declaration name `Box`, making every generic field unknown.
// Lifetime analysis must see substituted scalar fields as scalar values while
// still preserving pointer-carrying field types.
fn zt_aggregate_field_type(base_type: []u8, field: []u8,
                           decls: ArrayList[*Node]) []u8 {
    let base: []u8 = base_type;
    let args: ArrayList[[]u8] = make[[]u8](0);
    if (is_generic_app(base_type)) {
        let lb: i32 = index_of(base_type, '[');
        base = base_type[0..lb];
        free[[]u8](&args);
        args = split_args(base_type[lb + 1..base_type.len - 1]);
    }
    let i: i32 = 0;
    while (i < decls.len) {
        switch (decls.data[i].*) {
            .struct_ => |s| {
                if (@strEq(s.name, base)) {
                    let fi: i32 = 0;
                    while (fi < s.fields.len) {
                        if (@strEq(s.fields.data[fi].name, field)) {
                            let result: []u8 = zt_subst_type(
                                s.fields.data[fi].pty, s.tparams, args);
                            free[[]u8](&args);
                            return result;
                        }
                        fi = fi + 1;
                    }
                }
            }
            .union_ => |u| {
                if (@strEq(u.name, base)) {
                    let fi: i32 = 0;
                    while (fi < u.fields.len) {
                        if (@strEq(u.fields.data[fi].name, field)) {
                            let result: []u8 = u.fields.data[fi].pty;
                            free[[]u8](&args);
                            return result;
                        }
                        fi = fi + 1;
                    }
                }
            }
            else => { }
        }
        i = i + 1;
    }
    free[[]u8](&args);
    return "";
}
fn zt_fn_tparams(decls: ArrayList[*Node], name: []u8,
                 fallback: ArrayList[[]u8]) ArrayList[[]u8] {
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| { if (@strEq(f.name, name)) { return f.tparams; } }
            else => { }
        }
        i = i + 1;
    }
    // Unknown calls have no declared parameter/return type to substitute, so
    // a borrowed caller list is a safe allocation-free fallback; its contents
    // are never consulted against an absent declared type.
    return fallback;
}

// Native generic lowering names an instantiated function as `base_arg...`.
// Most typed checks run against the source template, but a few late checks
// also see a normalized declaration or a call whose callee has already been
// rewritten.  Resolve only an unmistakable generated-name suffix here; never
// guess a contract from an unrelated overload with a shared prefix.
fn zt_name_tail(name: []u8) []u8 {
    let start: i32 = 0;
    let i: i32 = 0;
    while (i + 1 < name.len) {
        if (name[i] == '_' && name[i + 1] == '_') { start = i + 2; }
        i = i + 1;
    }
    return name[start..];
}
fn zt_decl_name_matches(candidate: []u8, query: []u8) i32 {
    // Qualified namespaces are semantic identities, not display prefixes.
    // Never match `map__get` to an unrelated unqualified `get` (for example
    // ArrayList.get); private imported implementations are renamed to their
    // exact hidden declaration by the module resolver before this pass.
    return @strEq(candidate, query) as i32;
}
fn zt_generic_decl_name_candidate(candidate: []u8, base: []u8) i32 {
    if (candidate.len <= base.len + 1 || zt_starts(candidate, base) == 0 ||
        candidate[base.len] != '_') { return 0; }
    return 1;
}
fn zt_fn_param(decls: ArrayList[*Node], name: []u8, index: i32) []u8 {
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                if (zt_decl_name_matches(f.name, name) && index >= 0 && index < f.params.len) {
                    // Read the declaration's storage directly.  Qualified
                    // imports with auxiliary scalar parameters exposed a
                    // stale/empty view through the generic `get[Param]`
                    // helper, so the borrow/resource summaries could see the
                    // first parameter only when a callee had one argument.
                    return f.params.data[index].pty;
                }
            }
            else => { }
        }
        i = i + 1;
    }
    // If the call has already been normalized, recover the concrete clone's
    // parameter type.  This is deliberately a fallback after exact lookup.
    i = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                if (zt_generic_decl_name_candidate(f.name, name) == 1 &&
                    f.tparams.len == 0 && index >= 0 && index < f.params.len) {
                    return f.params.data[index].pty;
                }
            }
            else => { }
        }
        i = i + 1;
    }
    return "";
}
fn zt_fn_param_contract(decls: ArrayList[*Node], name: []u8, index: i32) []u8 {
    let found: []u8 = "";
    let exact: i32 = 0;
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                if (zt_decl_name_matches(f.name, name) && index >= 0 && index < f.params.len) {
                    exact = 1;
                    let contract: []u8 = f.params.data[index].contract;
                    // Module flattening can retain more than one declaration
                    // witness for the same foreign symbol. An empty witness
                    // must not hide the explicit contract carried by the
                    // source declaration which authorizes this argument.
                    if (contract.len > 0) {
                        if (found.len > 0 && !@strEq(found, contract)) { return "@conflict"; }
                        found = contract;
                    }
                }
            }
            else => { }
        }
        i = i + 1;
    }
    // An exact declaration, including one with an intentionally empty
    // parameter contract, is authoritative.  The generated-name fallback is
    // only for a late-normalized callee that has no source declaration under
    // its current spelling; scanning every declaration after every normal
    // lookup makes the self-host compiler's ownership pass superlinear.
    if (exact == 1) { return found; }
    // See zt_fn_param: late generic lowering may leave only a concrete clone
    // visible to this authority.  Merge all matching explicit witnesses and
    // retain the same fail-closed conflict behavior as exact lookup.
    i = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                if (zt_generic_decl_name_candidate(f.name, name) == 1 &&
                    f.tparams.len == 0 && index >= 0 && index < f.params.len) {
                    let contract: []u8 = f.params.data[index].contract;
                    if (contract.len > 0) {
                        if (found.len > 0 && !@strEq(found, contract)) { return "@conflict"; }
                        found = contract;
                    }
                }
            }
            else => { }
        }
        i = i + 1;
    }
    return found;
}
// A consuming contract owns only explicit one-owner capability forms. Scalars
// remain ordinary tuning values, while aggregates/slices/callbacks stay
// fail-closed until their component ownership is modeled.
fn zt_owner_param_type(ty: []u8) i32 {
    return ((ty.len > 0 && ty[0] == '*') || @strEq(ty, "Allocation")) as i32;
}
// A bare single-uppercase-letter type is an unresolved generic parameter
// (the same convention `zt_is_type_param` already uses elsewhere): whether it
// is consumable depends on its instantiation, which call-site checks such as
// `zt_res_unmodeled_generic_resource_param` and
// `zt_res_array_list_push_exempt` already enforce per concrete type argument.
// Accepting it here only defers the decision; it does not itself authorize
// an unproven transfer.
fn zt_consumable_param_type(ty:[]u8,decls:ArrayList[*Node])i32{
    return (zt_owner_param_type(ty)==1||zt_resource_type(ty,decls)==1||
        zt_is_type_param(ty)==1) as i32;
}
// A slice is a pointer-length view, not an ownership-transfer capability. An
// exact parameter-local borrow may therefore admit it for the duration of one
// call while @consumes continues to reject it. The borrow pass below keeps the
// descriptor/backing identity live across projections and rejects retention.
// Result 1 is a direct pointer/slice capability and may be shared or mutable.
// Result 2 is a by-value struct view whose transitive representation contains
// pointer-bearing leaves.  A view may be shared for one call, but a mutable
// aggregate borrow needs per-field mutability and is deliberately deferred.
fn zt_borrow_param_kind(ty: []u8, decls: ArrayList[*Node]) i32 {
    if (zt_owner_param_type(ty) == 1 || zt_starts(ty, "[]") == 1) { return 1; }
    if (ty.len == 0 || ty[0] == '?' || ty[0] == '!' || ty[0] == '*' ||
        zt_starts(ty, "[]") == 1) { return 0; }
    let base: []u8 = ty;
    let args: ArrayList[[]u8] = make[[]u8](0);
    if (is_generic_app(ty)) {
        let lb: i32 = index_of(ty, '[');
        base = ty[0..lb];
        free[[]u8](&args);
        args = split_args(ty[lb + 1..ty.len - 1]);
    }
    let result: i32 = 0;
    let i: i32 = 0;
    while (i < decls.len) {
        switch (decls.data[i].*) {
            .struct_ => |s| {
                if (@strEq(s.name, base) && s.tparams.len == args.len) {
                    result = zt_type_carries_borrow(ty, decls, 0) * 2;
                    i = decls.len;
                }
            }
            else => { }
        }
        i = i + 1;
    }
    free[[]u8](&args);
    return result;
}
fn zt_consumes_param(decls: ArrayList[*Node], name: []u8, index: i32) i32 {
    let contract: []u8 = zt_fn_param_contract(decls, name, index);
    if (contract.len > 0) {
        return (@strEq(contract, "@consumes") &&
            zt_consumable_param_type(zt_fn_param(decls, name, index),decls) == 1) as i32;
    }
    if (zt_fn_has_annot(decls, name, "@consumes") == 0) { return 0; }
    return zt_consumable_param_type(zt_fn_param(decls, name, index),decls);
}
// The legacy statement-level ownership checker runs before the generic call
// boundary is substituted.  A bare `T` in std:list.push[T] is therefore not
// an identifiable owner at this stage; treating it as one makes scalar and
// fixed-size vector pushes look like unnamed ownership transfers.  Keep the
// contract visible to the function validator and ZTResFlow, but defer this
// name-only pass until its concrete argument is available.
fn zt_direct_consumes_param(decls:ArrayList[*Node],name:[]u8,index:i32)i32{
    let ty:[]u8=zt_fn_param(decls,name,index);
    while(ty.len>0&&(ty[0]=='?'||ty[0]=='!')){ty=ty[1..];}
    if(zt_is_type_param(ty)==1){return 0;}
    return zt_consumes_param(decls,name,index);
}
// Prove that a returned pointer-bearing value structurally retains `name`.
// Merely mentioning a parameter while computing a result is not enough: a
// callee may allocate and copy from that parameter.  Only value-preserving
// projections and aggregate construction carry an implicit same-source
// lifetime. Calls and binary computations require an explicit contract.
fn zt_lifetime_expr_returns_name(n:*Node,name:[]u8)i32{
    switch(n.*){
        .id=>|x|{return @strEq(x.name,name) as i32;}
        .un=>|x|{return zt_lifetime_expr_returns_name(x.e,name);}
        .idx=>|x|{return zt_lifetime_expr_returns_name(x.base,name);}
        .fld=>|x|{return zt_lifetime_expr_returns_name(x.base,name);}
        .cast_=>|x|{return zt_lifetime_expr_returns_name(x.expr,name);}
        .slice_=>|x|{return zt_lifetime_expr_returns_name(x.base,name);}
        .slit_=>|x|{let hit:i32=0;let i:i32=0;while(i<x.fields.len){hit=hit|zt_lifetime_expr_returns_name(x.fields.data[i].val,name);i=i+1;}return hit;}
        else=>{}
    }
    return 0;
}
fn zt_lifetime_body_returns_name(body:ArrayList[*Node],name:[]u8)i32{
    let i:i32=0;while(i<body.len){switch(body.data[i].*){
        .ret=>|x|{if(x.has_expr==1&&zt_lifetime_expr_returns_name(x.expr,name)==1){return 1;}}
        .unsafe_=>|x|{if(zt_lifetime_body_returns_name(x.body,name)==1){return 1;}}
        .if_=>|x|{if(zt_lifetime_body_returns_name(x.then_body,name)==1||zt_lifetime_body_returns_name(x.els_body,name)==1){return 1;}}
        .while_=>|x|{if(zt_lifetime_body_returns_name(x.body,name)==1){return 1;}}
        .switch_=>|x|{if(zt_lifetime_body_returns_name(x.els_body,name)==1){return 1;}let ai:i32=0;while(ai<x.arms.len){if(zt_lifetime_body_returns_name(x.arms.data[ai].body,name)==1){return 1;}ai=ai+1;}}
        else=>{}
    }i=i+1;}
    return 0;
}
fn zt_fn_inferred_retained_param(decls:ArrayList[*Node],name:[]u8,index:i32)i32{
    let i:i32=0;while(i<decls.len){switch(decls.data[i].*){.fn_decl=>|f|{
        // An explicit parameter contract is already the caller-visible
        // lifetime/resource decision.  Do not silently reinterpret a plain
        // @borrows/@borrows_mut declaration as a retained return just because
        // the body happens to return a projection of that parameter.  Such a
        // return requires the explicit @retained_by_return contract; otherwise
        // the borrowed view remains parameter-local and must be rejected at
        // the return/store boundary.
        if(@strEq(f.name,name)&&f.is_extern==0&&index>=0&&index<f.params.len){
            let contract:[]u8=zt_fn_param_contract(decls,name,index);
            if(contract.len==0&&zt_consumes_param(decls,name,index)==0&&zt_borrow_param_kind(f.params.data[index].pty,decls)==1&&zt_type_carries_borrow(f.ret,decls,0)==1&&zt_lifetime_body_returns_name(f.body,f.params.data[index].name)==1){return 1;}
        }
    }else=>{}}i=i+1;}
    return 0;
}
fn zt_param_borrow_mode(decls:ArrayList[*Node],name:[]u8,index:i32)i32{
    let contract:[]u8=zt_fn_param_contract(decls,name,index);
    // The parameter-local relation is authoritative for this argument.  Do
    // not let the legacy/function-wide consume summary suppress an explicit
    // borrow when a signature intentionally mixes (for example) a mutable
    // buffer borrow with a consuming bus-address parameter.
    if(@strEq(contract,"@borrows_mut")){return 2;}
    if(@strEq(contract,"@borrows")||@strEq(contract,"@retained_by_return")){return 1;}
    if(zt_consumes_param(decls,name,index)==1){return 0;}
    if(index==0){
        if(zt_fn_has_annot(decls,name,"@borrows_mut")==1){return 2;}
        if(zt_fn_has_annot(decls,name,"@borrows")==1){return 1;}
    }
    if(contract.len>0){return 0;}
    if(zt_fn_inferred_retained_param(decls,name,index)==1){return 1;}
    // Structural affinity prevents copying, but does not imply that every
    // ordinary by-value call transfers ownership.  In the absence of an
    // explicit @consumes contract, a resource-bearing value parameter is a
    // shared observation for the duration of the call.  Its body cannot
    // return, store, release, or mutate the observed capability.
    if(zt_resource_type(zt_fn_param(decls,name,index),decls)==1){return 1;}
    return 0;
}
fn zt_fn_first_retained_param(decls:ArrayList[*Node],name:[]u8)i32{
    let found:i32=0-1;let i:i32=0;
    while(i<decls.len){switch(decls.data[i].*){.fn_decl=>|f|{
        if(@strEq(f.name,name)){let pi:i32=0;while(pi<f.params.len){
            if(@strEq(f.params.data[pi].contract,"@retained_by_return")||zt_fn_inferred_retained_param(decls,name,pi)==1||
                // Legacy function-level @borrows is the only implicit
                // retained-return relation.  An explicit first-parameter
                // @borrows/@borrows_mut contract is parameter-local unless
                // it says @retained_by_return; otherwise a pointer/slice
                // return silently launders the owner's lifetime.
                (pi==0&&f.params.data[pi].contract.len==0&&zt_borrow_mode(decls,name)>0&&zt_type_carries_borrow(f.ret,decls,0)==1)){
                if(found>=0&&found!=pi){return found;}found=pi;
            }pi=pi+1;}
        }
    }else=>{}}i=i+1;}
    return found;
}
fn zt_fn_has_retained_param(decls:ArrayList[*Node],name:[]u8)i32{return (zt_fn_first_retained_param(decls,name)>=0) as i32;}
fn zt_fn_has_consumes_contract(decls:ArrayList[*Node],name:[]u8)i32{
    if(zt_fn_has_annot(decls,name,"@consumes")==1){return 1;}
    let i:i32=0;while(i<decls.len){switch(decls.data[i].*){.fn_decl=>|f|{
        if(@strEq(f.name,name)){let pi:i32=0;while(pi<f.params.len){
            if(@strEq(f.params.data[pi].contract,"@consumes")){return 1;}pi=pi+1;
        }}
    }else=>{}}i=i+1;}return 0;
}
fn zt_consumes_owner_named(decls: ArrayList[*Node], fname: []u8, pname: []u8) i32 {
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                if (@strEq(f.name, fname)) {
                    let pi: i32 = 0;
                    while (pi < len[Param](f.params)) {
                        let p: Param = get[Param](f.params, pi);
                        if (@strEq(p.name, pname) && zt_consumes_param(decls, fname, pi) == 1) { return 1; }
                        pi = pi + 1;
                    }
                }
            }
            else => { }
        }
        i = i + 1;
    }
    return 0;
}
// Exact declaration-level annotations are kept separate from the derived
// first-parameter borrow relation.  The aggregate call pass uses the latter,
// while edition validation must still distinguish explicit parameter
// contracts from legacy function-level syntax (otherwise every imported
// `first:@borrows []u8` would be reported as a mixed contract).
fn zt_fn_has_legacy_annot(decls: ArrayList[*Node], name: []u8, annot: []u8) i32 {
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                if (@strEq(f.name, name)) {
                    let ai: i32 = 0;
                    while (ai < len[[]u8](f.annots)) {
                        if (@strEq(get[[]u8](f.annots, ai), annot)) { return 1; }
                        ai = ai + 1;
                    }
                }
            }
            else => { }
        }
        i = i + 1;
    }
    return 0;
}
fn zt_fn_has_legacy_borrow(decls:ArrayList[*Node],name:[]u8)i32{
    let i:i32=0;while(i<decls.len){switch(decls.data[i].*){.fn_decl=>|f|{
        if(@strEq(f.name,name)){let ai:i32=0;while(ai<f.annots.len){let annot:[]u8=f.annots.data[ai];if(@strEq(annot,"@borrows")||@strEq(annot,"@borrows_mut")){return 1;}ai=ai+1;}}
    }else=>{}}i=i+1;}return 0;
}
fn zt_fn_has_annot(decls: ArrayList[*Node], name: []u8, annot: []u8) i32 {
    if (zt_fn_has_legacy_annot(decls, name, annot) == 1) { return 1; }
    if (!@strEq(annot, "@borrows") && !@strEq(annot, "@borrows_mut")) { return 0; }
    let i: i32 = 0;
    while (i < decls.len) {
        switch (decls.data[i].*) {
            .fn_decl => |f| {
                if (@strEq(f.name, name) && f.params.len > 0) {
                    let first: []u8 = f.params.data[0].contract;
                    if (@strEq(annot, "@borrows") &&
                        (@strEq(first, "@borrows") || @strEq(first, "@retained_by_return"))) { return 1; }
                    if (@strEq(annot, "@borrows_mut") && @strEq(first, "@borrows_mut")) { return 1; }
                }
            }
            else => { }
        }
        i = i + 1;
    }
    return 0;
}

// Resource relations retain one canonical identifier inside their annotation
// spelling. The parser has already rejected malformed token shapes; typed
// validation extracts the relationship without guessing about arbitrary
// annotation arguments.
fn zt_relation_arg(value:[]u8,prefix:[]u8)[]u8{
    if(value.len<=prefix.len+1||zt_starts(value,prefix)==0||value[value.len-1]!=')'){return "";}
    return value[prefix.len..value.len-1];
}
fn zt_struct_has_annot(s:StructDecl,annot:[]u8)i32{let i:i32=0;while(i<s.annots.len){if(@strEq(s.annots.data[i],annot)){return 1;}i=i+1;}return 0;}
// A driver handle is a resource with an additional compiler authority rule.
// Keep the recognition annotation-based so imported std:driver names remain
// qualified (`driver__Device`) without making an unqualified user type named
// `Device` special by accident.
fn zt_struct_is_driver_handle(s:StructDecl)i32{
    let i:i32=0;while(i<s.annots.len){let annot:[]u8=s.annots.data[i];
        if(zt_starts(annot,"@driver_handle(")==1&&annot[annot.len-1]==')'){return 1;}
        i=i+1;
    }return 0;
}
fn zt_driver_handle_type(ty0:[]u8,decls:ArrayList[*Node])i32{
    let ty:[]u8=ty0;while(ty.len>0&&(ty[0]=='?'||ty[0]=='!')){ty=ty[1..];}
    if(ty.len==0||ty[0]=='*'||zt_starts(ty,"[]")==1){return 0;}
    let base:[]u8=ty;if(is_generic_app(ty)){base=ty[0..zt_find(ty,'[')];}
    let i:i32=0;while(i<decls.len){switch(decls.data[i].*){
        .struct_=>|s|{if(@strEq(s.name,base)){return zt_struct_is_driver_handle(s);}}
        else=>{}
    }i=i+1;}return 0;
}
fn zt_resource_type_depth(ty0:[]u8,decls:ArrayList[*Node],depth:i32)i32{
    let ty:[]u8=ty0;while(ty.len>0&&(ty[0]=='?'||ty[0]=='!')){ty=ty[1..];}
    if(ty.len==0||ty[0]=='*'||zt_starts(ty,"[]")==1){return 0;}
    if(zt_is_builtin(ty)==1||@strEq(ty,"void")){return 0;}
    // Direct recursive value aggregates are rejected by layout validation,
    // but resource classification runs independently and must still terminate.
    // Pointer/slice recursion stopped above; an over-deep by-value cycle is not
    // evidence of ownership on its own.
    // A deep by-value aggregate is not evidence of affinity merely because
    // the bounded classification walk reached its termination guard. Plain
    // pointer-bearing aggregates are owned by the mutation-aware aggregate
    // provenance pass; returning 1 here manufactures an affine root with no
    // corresponding terminal slots and rejects valid deep field clears.
    if(depth>64){return 0;}
    let base:[]u8=ty;let args:ArrayList[[]u8]=make[[]u8](0);
    if(is_generic_app(ty)){let lb:i32=zt_find(ty,'[');base=ty[0..lb];free[[]u8](&args);args=split_args(ty[lb+1..ty.len-1]);}
    let i:i32=0;while(i<decls.len){switch(decls.data[i].*){.struct_=>|s|{if(@strEq(s.name,base)&&s.tparams.len==args.len){
        if(zt_struct_has_annot(s,"@resource")==1){free[[]u8](&args);return 1;}
        // Affinity is structural.  A plain wrapper around an ArrayList or any
        // other concrete @resource value cannot safely become copyable merely
        // because the outer struct omitted a redundant annotation.
        let fi:i32=0;while(fi<s.fields.len){let field_ty:[]u8=zt_subst_type(s.fields.data[fi].pty,s.tparams,args);if(zt_resource_type_depth(field_ty,decls,depth+1)==1){free[[]u8](&args);return 1;}fi=fi+1;}
        free[[]u8](&args);return 0;
    }}else=>{}}i=i+1;}
    free[[]u8](&args);
    return 0;
}
fn zt_resource_type(ty0:[]u8,decls:ArrayList[*Node])i32{return zt_resource_type_depth(ty0,decls,0);}
// The older name-only allocation flow owns raw allocation identities.  A
// structural resource consume is field-sensitive and belongs exclusively to
// ZTResFlow; seeding its aggregate/pointer name in both passes makes releasing
// one field look like releasing every sibling field.
fn zt_legacy_allocation_consumes_param(decls:ArrayList[*Node],name:[]u8,index:i32)i32{
    if(zt_consumes_param(decls,name,index)==0){return 0;}
    let ty:[]u8=zt_fn_param(decls,name,index);while(ty.len>0&&(ty[0]=='?'||ty[0]=='!')){ty=ty[1..];}
    // A bare generic parameter is not an allocation identity in this
    // name-only legacy lattice.  Its concrete ownership is decided at the
    // call boundary by ZTResFlow after substitution (for example the
    // compiler-owned std:list.push[T] move).  Seeding it here makes the old
    // aggregate pass mistake a generic element store for an unreleased raw
    // owner and reject otherwise valid generic containers.
    if(zt_is_type_param(ty)==1){return 0;}
    if(zt_resource_type(ty,decls)==1){return 0;}
    if(ty.len>1&&ty[0]=='*'&&zt_resource_type(ty[1..],decls)==1){return 0;}
    return 1;
}
fn zt_resource_capability_type(ty0:[]u8,decls:ArrayList[*Node])i32{
    let ty:[]u8=ty0;while(ty.len>0&&(ty[0]=='?'||ty[0]=='!')){ty=ty[1..];}
    if(ty.len==0){return 0;}if(ty[0]=='*'||zt_starts(ty,"[]")==1||@strEq(ty,"Allocation")){return 1;}
    return zt_resource_type(ty,decls);
}
fn zt_release_param_compatible(owner_ty0:[]u8,param_ty0:[]u8,decls:ArrayList[*Node])i32{
    let owner_ty:[]u8=owner_ty0;let param_ty:[]u8=param_ty0;
    while(owner_ty.len>0&&(owner_ty[0]=='?'||owner_ty[0]=='!')){owner_ty=owner_ty[1..];}
    while(param_ty.len>0&&(param_ty[0]=='?'||param_ty[0]=='!')){param_ty=param_ty[1..];}
    // Raw pointer releases are ABI-compatible after an explicit source cast;
    // resource-value releases receive the address of the exact value.
    if(owner_ty.len>0&&owner_ty[0]=='*'&&param_ty.len>0&&param_ty[0]=='*'){return 1;}
    if(param_ty.len>1&&param_ty[0]=='*'){
        let pointee:[]u8=param_ty[1..];if(@strEq(pointee,owner_ty)){return 1;}
        let owner_base:[]u8=owner_ty;let param_base:[]u8=pointee;
        if(is_generic_app(owner_ty)){owner_base=owner_ty[0..zt_find(owner_ty,'[')];}
        if(is_generic_app(pointee)){param_base=pointee[0..zt_find(pointee,'[')];}
        if(@strEq(owner_base,param_base)&&zt_resource_type(owner_ty,decls)==1){return 1;}
    }
    return 0;
}
fn zt_release_relation_valid(decls:ArrayList[*Node],release:[]u8,owner_ty:[]u8)i32{
    if(release.len==0){return 0;}
    // Core allocation terminals are compiler-known and intentionally need no
    // source declaration in a minimal module.
    if(@strEq(release,"_zag_free")||@strEq(release,"delete")||@strEq(release,"zfree")||@strEq(release,"zfree_i")||@strEq(release,"@cacheAlignedFree")||@strEq(release,"close")){return (zt_resource_capability_type(owner_ty,decls)==1) as i32;}
    let valid:i32=0;let i:i32=0;while(i<decls.len){switch(decls.data[i].*){.fn_decl=>|f|{
        if(@strEq(f.name,release)&&f.params.len==1&&zt_release_param_compatible(owner_ty,f.params.data[0].pty,decls)==1){valid=1;}
    }else=>{}}i=i+1;}
    return valid;
}
fn zt_fn_acquires_release(f:FnDecl)[]u8{
    let found:[]u8="";let i:i32=0;while(i<f.annots.len){let arg:[]u8=zt_relation_arg(f.annots.data[i],"@acquires(");if(arg.len>0){if(found.len>0&&!@strEq(found,arg)){return "@conflict";}found=arg;}i=i+1;}return found;
}
// Resolve an explicit fresh-resource contract at the same declaration key as
// the call.  The legacy owner lattice predates @acquires and otherwise treats
// every structural resource return as non-owned, which makes a checked
// resource constructor look like a mixed owned/non-owned function.  Keep the
// declaration/body validation in the resource pass; this helper only exposes
// the already-validated contract to the older compatibility lattice.
fn zt_explicit_owned_acquire_name(decls:ArrayList[*Node],name:[]u8,targs:ArrayList[[]u8])[]u8{
    let i:i32=0;while(i<decls.len){switch(decls.data[i].*){.fn_decl=>|f|{
        if(@strEq(f.name,name)&&f.is_extern==0){
            let release:[]u8=zt_fn_acquires_release(f);
            let ret:[]u8=zt_instantiated_call_ret(decls,name,targs);
            if(release.len>0&&!@strEq(release,"@conflict")&&ret.len>0&&zt_resource_capability_type(ret,decls)==1){return name;}
        }
    }else=>{}}i=i+1;}return "";
}
fn zt_check_v2_resource_declarations(decls:ArrayList[*Node],file:[]u8)i32{
    let v2:i32=@strEq(v2_project_edition(file),"2027") as i32;let errors:i32=0;let i:i32=0;
    while(i<decls.len){switch(decls.data[i].*){
        .struct_=>|s|{
            let context:[]u8=_zag_str_concat("struct ",s.name);let resource_count:i32=0;let ai:i32=0;
            while(ai<s.annots.len){let annot:[]u8=s.annots.data[ai];if(@strEq(annot,"@resource")){resource_count=resource_count+1;}else if(zt_starts(annot,"@acquires(")==1||@strEq(annot,"@retained_by_return")||zt_starts(annot,"@owned(")==1){errors=errors+zt_machine_error("resource acquisition and retention annotations do not apply to a struct declaration",context);}ai=ai+1;}
            if(resource_count>1){errors=errors+zt_machine_error("duplicate @resource annotation",context);}
            if(resource_count>0&&v2==0&&@strEq(s.origin,"<root>")){errors=errors+zt_machine_error("@resource requires edition = \"2027\"",context);}
            if(resource_count>0&&s.repr_c==1){errors=errors+zt_machine_error("@resource cannot be combined with @repr(C)",context);}
            let owned_fields:i32=0;let fi:i32=0;while(fi<s.fields.len){let field:Param=s.fields.data[fi];let release:[]u8=zt_relation_arg(field.contract,"@owned(");
                if(release.len>0){owned_fields=owned_fields+1;if(resource_count==0){errors=errors+zt_machine_error("@owned(release) fields require an @resource struct",context);}if(zt_resource_capability_type(field.pty,decls)==0){errors=errors+zt_machine_error("@owned(release) requires a pointer, Allocation, slice, or @resource field type",context);}else if(zt_release_relation_valid(decls,release,field.pty)==0){errors=errors+zt_machine_error(_zag_str_concat("resource field release relation has no compatible one-parameter function `",_zag_str_concat(release,"`")),context);}}
                else if(field.contract.len>0){errors=errors+zt_machine_error("function parameter lifetime contracts do not apply to struct fields",context);}fi=fi+1;}
            if(resource_count>0&&owned_fields==0){errors=errors+zt_machine_error("@resource struct requires at least one @owned(release) field",context);}
        }
        .fn_decl=>|f|{
            let context:[]u8=_zag_str_concat("function ",f.name);let release:[]u8=zt_fn_acquires_release(f);let acquire_count:i32=0;let ai:i32=0;
            while(ai<f.annots.len){let annot:[]u8=f.annots.data[ai];if(zt_relation_arg(annot,"@acquires(").len>0){acquire_count=acquire_count+1;}else if(@strEq(annot,"@resource")||@strEq(annot,"@retained_by_return")||zt_starts(annot,"@owned(")==1){errors=errors+zt_machine_error("resource type/field annotations do not apply to a function declaration",context);}ai=ai+1;}
            if(acquire_count>1||@strEq(release,"@conflict")){errors=errors+zt_machine_error("function must declare at most one non-conflicting @acquires(release) relation",context);}
            if(acquire_count>0&&v2==0&&@strEq(f.origin,"<root>")){errors=errors+zt_machine_error("@acquires(release) requires edition = \"2027\"",context);}
            if(acquire_count>0){if(zt_resource_capability_type(f.ret,decls)==0){errors=errors+zt_machine_error("@acquires(release) requires an ownership-capable return type",context);}else if(zt_release_relation_valid(decls,release,f.ret)==0){errors=errors+zt_machine_error(_zag_str_concat("acquire relation has no compatible one-parameter release function `",_zag_str_concat(release,"`")),context);}}
            let retained:i32=0;let pi:i32=0;while(pi<f.params.len){let p:Param=f.params.data[pi];if(@strEq(p.contract,"@retained_by_return")){retained=retained+1;if(v2==0&&@strEq(f.origin,"<root>")){errors=errors+zt_machine_error("@retained_by_return requires edition = \"2027\"",context);}if(zt_borrow_param_kind(p.pty,decls)==0){errors=errors+zt_machine_error("@retained_by_return requires a pointer, slice, Allocation, @resource, or pointer-bearing aggregate parameter",context);}}else if(zt_starts(p.contract,"@owned(")==1){errors=errors+zt_machine_error("@owned(release) applies only to fields of an @resource struct",context);}pi=pi+1;}
            if(retained>0&&zt_type_carries_borrow(f.ret,decls,0)==0){errors=errors+zt_machine_error("@retained_by_return requires a pointer-bearing return type",context);}
        }
        else=>{}
    }i=i+1;}
    return errors;
}

// std:driver handles are stronger than ordinary @resource values.  Their
// representation is an implementation detail of the adapter and must not be
// reachable through the source-level aggregate machinery.  Keep this pass
// separate from ZTResFlow: the latter proves ownership transitions, while
// this pass proves that the value was never forged or inspected through a
// field/pointer escape before ownership is considered.
fn zt_driver_ends(s:[]u8,p:[]u8)i32{
    if(s.len<p.len){return 0;}
    return @strEq(s[s.len-p.len..s.len],p) as i32;
}
// Imported runtime declarations are qualified as `module___zag_malloc`:
// the module separator is the two underscores immediately before the native
// symbol's leading underscore.  Require that separator so an unrelated user
// helper such as `my_zag_malloc` cannot acquire compiler-owned allocation
// authority merely by sharing a suffix.
fn zt_qualified_runtime_ends(s:[]u8,p:[]u8)i32{
    if(s.len<p.len+2){return 0;}
    let start:i32=s.len-p.len;
    if(@strEq(s[start..s.len],p)==0){return 0;}
    return ((s[start-2]=='_')&&(s[start-1]=='_')) as i32;
}
fn zt_driver_trusted_origin(origin:[]u8)i32{
    if(zt_driver_ends(origin,"std/driver.zag")==1||zt_driver_ends(origin,"std\\driver.zag")==1){return 1;}
    return 0;
}
// The common contract owns handle declarations; the checked adapter modules
// own the explicitly typed pointer access used to implement emulator state and
// Linux acquisition metadata.  Keep this allowlist source-bound so a user
// function cannot opt into raw access by copying an annotation or naming a
// helper "adapter".  New platform backends must enter this list deliberately.
fn zt_driver_adapter_origin(origin:[]u8)i32{
    if(zt_driver_ends(origin,"std/driver_emulator.zag")==1||zt_driver_ends(origin,"std\\driver_emulator.zag")==1||
       zt_driver_ends(origin,"std/driver_linux.zag")==1||zt_driver_ends(origin,"std\\driver_linux.zag")==1||
       zt_driver_ends(origin,"std/driver_linux_userspace.zag")==1||zt_driver_ends(origin,"std\\driver_linux_userspace.zag")==1||
       zt_driver_ends(origin,"std/driver_linux_kernel.zag")==1||zt_driver_ends(origin,"std\\driver_linux_kernel.zag")==1||
       zt_driver_ends(origin,"std/driver_linux_kbuild.zag")==1||zt_driver_ends(origin,"std\\driver_linux_kbuild.zag")==1||
       zt_driver_ends(origin,"std/driver_linux_6_1.zag")==1||zt_driver_ends(origin,"std\\driver_linux_6_1.zag")==1||
       zt_driver_ends(origin,"std/driver_linux_6_6.zag")==1||zt_driver_ends(origin,"std\\driver_linux_6_6.zag")==1){return 1;}
    return 0;
}
fn zt_driver_capability_origin(origin:[]u8)i32{
    return (zt_driver_trusted_origin(origin)==1||zt_driver_adapter_origin(origin)==1) as i32;
}
fn zt_driver_internal_origin(origin:[]u8)i32{
    return zt_driver_capability_origin(origin);
}
fn zt_driver_handle_pointer_type(ty0:[]u8,decls:ArrayList[*Node])i32{
    let ty:[]u8=ty0;while(ty.len>0&&(ty[0]=='?'||ty[0]=='!')){ty=ty[1..];}
    if(ty.len==0||ty[0]!='*'){return 0;}
    return zt_driver_handle_type(zt_deref_pointee_type(ty),decls);
}
fn zt_driver_value_or_pointer_type(ty0:[]u8,decls:ArrayList[*Node])i32{
    let ty:[]u8=ty0;while(ty.len>0&&(ty[0]=='?'||ty[0]=='!')){ty=ty[1..];}
    if(zt_driver_handle_type(ty,decls)==1||zt_driver_handle_pointer_type(ty,decls)==1){return 1;}
    return 0;
}
fn zt_driver_atomic_pointer_type(ty0:[]u8)i32{
    let ty:[]u8=ty0;while(ty.len>0&&(ty[0]=='?'||ty[0]=='!')){ty=ty[1..];}
    if(ty.len==0||ty[0]!='*'){return 0;}
    ty=ty[1..];
    return (zt_driver_ends(ty,"Atomic[u8]")==1||zt_driver_ends(ty,"Atomic[u16]")==1||
        zt_driver_ends(ty,"Atomic[u32]")==1||zt_driver_ends(ty,"Atomic[u64]")==1) as i32;
}
fn zt_driver_expr_is_id(n:*Node)i32{switch(n.*){.id=>|_|{return 1;}else=>{}}return 0;}
fn zt_driver_raw_machine_name(name:[]u8)i32{
    if(zt_driver_ends(name,"_zag_malloc")==1||zt_driver_ends(name,"_zag_free")==1||
       zt_driver_ends(name,"_zag_load8")==1||zt_driver_ends(name,"_zag_load16")==1||
       zt_driver_ends(name,"_zag_load32")==1||zt_driver_ends(name,"_zag_load64")==1||
       zt_driver_ends(name,"_zag_store8")==1||zt_driver_ends(name,"_zag_store16")==1||
       zt_driver_ends(name,"_zag_store32")==1||zt_driver_ends(name,"_zag_store64")==1){return 1;}
    return 0;
}

// Named aggregate compatibility is deliberately permissive in the legacy
// expression pass.  MMIO is a hardware boundary, so its exact register width
// is checked separately before lowering.  Imported names are compiler-qualified
// (for example `driver__MmioRegister[u32]`), hence the suffix match rather than
// a source-module spelling comparison.
fn zt_driver_mmio_register_type_ok(n:*Node,env:ArrayList[ZTBind],decls:ArrayList[*Node],scalar:[]u8,context:[]u8)i32{
    let actual:ZTExpr=zt_expr_type(n,env,decls,context);
    if(actual.known==0){return zt_machine_error("MMIO register type cannot be proven at the adapter boundary",context);}
    let ty:[]u8=actual.ty;while(ty.len>0&&(ty[0]=='?'||ty[0]=='!')){ty=ty[1..];}
    if(ty.len==0||ty[0]!='*'){return zt_machine_error("typed MMIO operation requires a pointer to its exact MmioRegister width",context);}
    ty=zt_deref_pointee_type(ty);
    let want:[]u8=_zag_str_concat("MmioRegister[",_zag_str_concat(scalar,"]"));
    if(zt_driver_ends(ty,want)==0){return zt_machine_error(_zag_str_concat("typed MMIO operation requires ",want),context);}
    return 0;
}
fn zt_driver_mmio_value_ok(n:*Node,env:ArrayList[ZTBind],decls:ArrayList[*Node],scalar:[]u8,context:[]u8)i32{
    let actual:ZTExpr=zt_expr_type(n,env,decls,context);
    // Integer literals are contextually typed by the exact-width operation.
    if(actual.known==0||actual.literal==1){return 0;}
    if(@strEq(actual.ty,scalar)==0){return zt_machine_error(_zag_str_concat("typed MMIO value must be ",scalar),context);}
    return 0;
}
fn zt_driver_mmio_call(c:Call,env:ArrayList[ZTBind],decls:ArrayList[*Node],context:[]u8)i32{
    let name:[]u8=zt_direct_name(c.callee);let scalar:[]u8="";let argc:i32=0;let value_args:i32=0;
    if(zt_driver_ends(name,"mmio_read8")==1){scalar="u8";argc=1;}
    else if(zt_driver_ends(name,"mmio_read16")==1){scalar="u16";argc=1;}
    else if(zt_driver_ends(name,"mmio_read32")==1){scalar="u32";argc=1;}
    else if(zt_driver_ends(name,"mmio_read64")==1){scalar="u64";argc=1;}
    else if(zt_driver_ends(name,"mmio_write8")==1){scalar="u8";argc=2;value_args=1;}
    else if(zt_driver_ends(name,"mmio_write16")==1){scalar="u16";argc=2;value_args=1;}
    else if(zt_driver_ends(name,"mmio_write32")==1){scalar="u32";argc=2;value_args=1;}
    else if(zt_driver_ends(name,"mmio_write64")==1){scalar="u64";argc=2;value_args=1;}
    else if(zt_driver_ends(name,"mmio_rmw8")==1){scalar="u8";argc=3;value_args=2;}
    else if(zt_driver_ends(name,"mmio_rmw16")==1){scalar="u16";argc=3;value_args=2;}
    else if(zt_driver_ends(name,"mmio_rmw32")==1){scalar="u32";argc=3;value_args=2;}
    else if(zt_driver_ends(name,"mmio_rmw64")==1){scalar="u64";argc=3;value_args=2;}
    else{return 0;}
    let errors:i32=0;
    if(c.args.len!=argc){return zt_machine_error("typed MMIO operation has the wrong argument count",context);}
    if(c.args.len>0){errors=errors+zt_driver_mmio_register_type_ok(c.args.data[0],env,decls,scalar,context);}
    let i:i32=0;while(i<value_args){errors=errors+zt_driver_mmio_value_ok(c.args.data[i+1],env,decls,scalar,context);i=i+1;}
    return errors;
}

fn zt_driver_order_literal(n:*Node)i32{
    switch(n.*){
        .ilit=>|x|{
            if(@strEq(x.text,"0")){return 0;}if(@strEq(x.text,"1")){return 1;}
            if(@strEq(x.text,"2")){return 2;}if(@strEq(x.text,"3")){return 3;}
            if(@strEq(x.text,"4")){return 4;}
        }
        .call=>|c|{
            let name:[]u8=zt_direct_name(c.callee);
            if(name.len>0&&c.args.len==0){
                if(zt_driver_ends(name,"order_relaxed")==1){return 0;}
                if(zt_driver_ends(name,"order_acquire")==1){return 1;}
                if(zt_driver_ends(name,"order_release")==1){return 2;}
                if(zt_driver_ends(name,"order_acq_rel")==1){return 3;}
                if(zt_driver_ends(name,"order_seq_cst")==1){return 4;}
            }
        }
        else=>{}
    }
    return -1;
}
fn zt_driver_atomic_register_type_ok(n:*Node,env:ArrayList[ZTBind],decls:ArrayList[*Node],scalar:[]u8,context:[]u8)i32{
    let actual:ZTExpr=zt_expr_type(n,env,decls,context);
    if(actual.known==0){return zt_machine_error("atomic handle type cannot be proven at the adapter boundary",context);}
    let ty:[]u8=actual.ty;while(ty.len>0&&(ty[0]=='?'||ty[0]=='!')){ty=ty[1..];}
    if(ty.len==0||ty[0]!='*'){return zt_machine_error("typed atomic operation requires a pointer to its exact Atomic width",context);}
    ty=zt_deref_pointee_type(ty);
    let want:[]u8=_zag_str_concat("Atomic[",_zag_str_concat(scalar,"]"));
    if(zt_driver_ends(ty,want)==0){return zt_machine_error(_zag_str_concat("typed atomic operation requires ",want),context);}
    return 0;
}
fn zt_driver_atomic_value_ok(n:*Node,env:ArrayList[ZTBind],decls:ArrayList[*Node],scalar:[]u8,context:[]u8)i32{
    let actual:ZTExpr=zt_expr_type(n,env,decls,context);
    // Integer literals are contextually typed by the exact-width operation.
    if(actual.known==0||actual.literal==1){return 0;}
    if(@strEq(actual.ty,scalar)==0){return zt_machine_error(_zag_str_concat("typed atomic value must be ",scalar),context);}
    return 0;
}
fn zt_driver_register_constant(n:*Node)i32{
    switch(n.*){
        .ilit=>|x|{return _zag_str_to_i64(x.text) as i32;}
        .call=>|c=>{
            let name:[]u8=zt_direct_name(c.callee);
            if(c.args.len==0){
                if(zt_driver_ends(name,"mmio_width_8")==1){return 8;}
                if(zt_driver_ends(name,"mmio_width_16")==1){return 16;}
                if(zt_driver_ends(name,"mmio_width_32")==1){return 32;}
                if(zt_driver_ends(name,"mmio_width_64")==1){return 64;}
                if(zt_driver_ends(name,"endian_native")==1){return 0;}
                if(zt_driver_ends(name,"endian_little")==1){return 1;}
                if(zt_driver_ends(name,"endian_big")==1){return 2;}
            }
        }
        else=>{}
    }
    return -1;
}
fn zt_driver_register_field_call(c:Call,context:[]u8)i32{
    let name:[]u8=zt_direct_name(c.callee);
    let descriptor:i32=(zt_driver_ends(name,"descriptor_field_new")==1) as i32;
    if(zt_driver_ends(name,"register_field_new")==0&&descriptor==0){return 0;}
    if(descriptor==1&&c.args.len!=4){return zt_machine_error("descriptor field declaration expects descriptor bytes, offset, width, and endian",context);}
    if(descriptor==0&&c.args.len!=4){return zt_machine_error("register field declaration expects width, shift, bits, and endian",context);}
    if(descriptor==1){
        let descriptor_bytes:i32=zt_driver_register_constant(c.args.data[0]);
        let offset:i32=zt_driver_register_constant(c.args.data[1]);
        let width:i32=zt_driver_register_constant(c.args.data[2]);
        let endian:i32=zt_driver_register_constant(c.args.data[3]);
        if(descriptor_bytes>=0&&offset>=0&&width>=0&&endian>=0){
            let bytes:i32=0;
            if(width==8){bytes=1;}else if(width==16){bytes=2;}else if(width==32){bytes=4;}else if(width==64){bytes=8;}
            if(bytes==0||descriptor_bytes<=0||offset<0||offset%bytes!=0||offset+bytes>descriptor_bytes||
               (endian!=0&&endian!=1&&endian!=2)){
                return zt_machine_error("invalid typed descriptor field: descriptor extent, offset, width, or endian is unsupported",context);
            }
        }
        return 0;
    }
    let width:i32=zt_driver_register_constant(c.args.data[0]);
    let shift:i32=zt_driver_register_constant(c.args.data[1]);
    let bits:i32=zt_driver_register_constant(c.args.data[2]);
    let endian:i32=zt_driver_register_constant(c.args.data[3]);
    // A runtime-discovered field remains checked by register_field_valid. A
    // declaration made from constants is proved here, before any lowering.
    if(width>=0&&shift>=0&&bits>=0&&endian>=0){
        if((width!=8&&width!=16&&width!=32&&width!=64)||shift<0||bits<=0||bits>width||shift+bits>width||
           (endian!=0&&endian!=1&&endian!=2)){
            return zt_machine_error("invalid typed register bitfield: width, bit range, or endian is unsupported",context);
        }
    }
    return 0;
}
fn zt_driver_atomic_call(c:Call,env:ArrayList[ZTBind],decls:ArrayList[*Node],context:[]u8)i32{
    let name:[]u8=zt_direct_name(c.callee);let scalar:[]u8="";let argc:i32=0;
    // kind: 1=load, 2=store, 3=RMW, 4=compare-exchange, 5=fence.
    let kind:i32=0;let value_count:i32=0;let order_start:i32=-1;let failure_start:i32=-1;
    if(zt_driver_ends(name,"atomic_load8")==1||zt_driver_ends(name,"atomic_load8_value")==1){scalar="u8";argc=2;kind=1;order_start=1;}
    else if(zt_driver_ends(name,"atomic_load16")==1||zt_driver_ends(name,"atomic_load16_value")==1){scalar="u16";argc=2;kind=1;order_start=1;}
    else if(zt_driver_ends(name,"atomic_load32")==1||zt_driver_ends(name,"atomic_load32_value")==1){scalar="u32";argc=2;kind=1;order_start=1;}
    else if(zt_driver_ends(name,"atomic_load64")==1||zt_driver_ends(name,"atomic_load64_value")==1){scalar="u64";argc=2;kind=1;order_start=1;}
    else if(zt_driver_ends(name,"atomic_store8")==1){scalar="u8";argc=3;kind=2;value_count=1;order_start=2;}
    else if(zt_driver_ends(name,"atomic_store16")==1){scalar="u16";argc=3;kind=2;value_count=1;order_start=2;}
    else if(zt_driver_ends(name,"atomic_store32")==1){scalar="u32";argc=3;kind=2;value_count=1;order_start=2;}
    else if(zt_driver_ends(name,"atomic_store64")==1){scalar="u64";argc=3;kind=2;value_count=1;order_start=2;}
    else if(zt_driver_ends(name,"atomic_exchange8")==1||zt_driver_ends(name,"atomic_fetch_add8")==1||zt_driver_ends(name,"atomic_fetch_sub8")==1||zt_driver_ends(name,"atomic_fetch_and8")==1||zt_driver_ends(name,"atomic_fetch_or8")==1||zt_driver_ends(name,"atomic_fetch_xor8")==1){scalar="u8";argc=3;kind=3;value_count=1;order_start=2;}
    else if(zt_driver_ends(name,"atomic_exchange16")==1||zt_driver_ends(name,"atomic_fetch_add16")==1||zt_driver_ends(name,"atomic_fetch_sub16")==1||zt_driver_ends(name,"atomic_fetch_and16")==1||zt_driver_ends(name,"atomic_fetch_or16")==1||zt_driver_ends(name,"atomic_fetch_xor16")==1){scalar="u16";argc=3;kind=3;value_count=1;order_start=2;}
    else if(zt_driver_ends(name,"atomic_exchange32")==1||zt_driver_ends(name,"atomic_fetch_add32")==1||zt_driver_ends(name,"atomic_fetch_sub32")==1||zt_driver_ends(name,"atomic_fetch_and32")==1||zt_driver_ends(name,"atomic_fetch_or32")==1||zt_driver_ends(name,"atomic_fetch_xor32")==1){scalar="u32";argc=3;kind=3;value_count=1;order_start=2;}
    else if(zt_driver_ends(name,"atomic_exchange64")==1||zt_driver_ends(name,"atomic_fetch_add64")==1||zt_driver_ends(name,"atomic_fetch_sub64")==1||zt_driver_ends(name,"atomic_fetch_and64")==1||zt_driver_ends(name,"atomic_fetch_or64")==1||zt_driver_ends(name,"atomic_fetch_xor64")==1){scalar="u64";argc=3;kind=3;value_count=1;order_start=2;}
    else if(zt_driver_ends(name,"atomic_compare_exchange8")==1){scalar="u8";argc=5;kind=4;value_count=2;order_start=3;failure_start=4;}
    else if(zt_driver_ends(name,"atomic_compare_exchange16")==1){scalar="u16";argc=5;kind=4;value_count=2;order_start=3;failure_start=4;}
    else if(zt_driver_ends(name,"atomic_compare_exchange32")==1){scalar="u32";argc=5;kind=4;value_count=2;order_start=3;failure_start=4;}
    else if(zt_driver_ends(name,"atomic_compare_exchange64")==1){scalar="u64";argc=5;kind=4;value_count=2;order_start=3;failure_start=4;}
    else if(zt_driver_ends(name,"atomic_fence")==1){argc=1;kind=5;order_start=0;}
    else{return 0;}
    if(c.args.len!=argc){return zt_machine_error("typed atomic operation has the wrong argument count",context);}
    let errors:i32=0;
    if(kind!=5){errors=zt_driver_atomic_register_type_ok(c.args.data[0],env,decls,scalar,context);}
    let vi:i32=0;while(vi<value_count){errors=errors+zt_driver_atomic_value_ok(c.args.data[vi+1],env,decls,scalar,context);vi=vi+1;}
    let order:i32=zt_driver_order_literal(c.args.data[order_start]);
    if(order<0){return errors+zt_machine_error("atomic memory order must be one of the named order constants",context);}
    if((kind==1&&(order==2||order==3))||(kind==2&&(order==1||order==3))){
        errors=errors+zt_machine_error("atomic load/store memory order is invalid for this operation",context);
    }
    if(kind==4){
        let failure:i32=zt_driver_order_literal(c.args.data[failure_start]);
        if(failure<0){return errors+zt_machine_error("atomic compare-exchange failure order must be one of the named order constants",context);}
        if(failure==2||failure==3){errors=errors+zt_machine_error("atomic compare-exchange failure order cannot be release or acq_rel",context);}
        else if(failure==1&&(order!=1&&order!=3&&order!=4)){errors=errors+zt_machine_error("atomic compare-exchange failure order is stronger than success order",context);}
        else if(failure==4&&order!=4){errors=errors+zt_machine_error("atomic compare-exchange failure order is stronger than success order",context);}
    }
    return errors;
}

fn zt_driver_walk_expr(n:*Node,env:ArrayList[ZTBind],decls:ArrayList[*Node],trusted:i32,context:[]u8)i32{
    switch(n.*){
        .slit_=>|s|{
            let errors:i32=0;
            if(zt_driver_handle_type(s.sname,decls)==1&&trusted==0){errors=errors+zt_machine_error("driver handles are non-forgeable; use a std:driver acquisition function",context);}
            let i:i32=0;while(i<s.fields.len){errors=errors+zt_driver_walk_expr(s.fields.data[i].val,env,decls,trusted,context);i=i+1;}
            return errors;
        }
        .fld=>|f|{
            let errors:i32=zt_driver_walk_expr(f.base,env,decls,trusted,context);
            // `p.*` is the explicit borrow/dereference operation.  A named
            // field after that operation is still an opaque-handle escape.
            if(@strEq(f.fname,"*")&&trusted==0){
                let base:ZTExpr=zt_expr_type(f.base,env,decls,context);
                if(base.known==1&&base.ty.len>0&&base.ty[0]=='*'){
                    return errors+zt_machine_error("driver raw-pointer dereference requires a typed std:driver adapter primitive",context);
                }
            }
            if(!@strEq(f.fname,"*")&&trusted==0){
                let base:ZTExpr=zt_expr_type(f.base,env,decls,context);
                if(base.known==1&&zt_driver_handle_type(base.ty,decls)==1){
                    return errors+zt_machine_error("driver handle fields are opaque outside std:driver",context);
                }
            }
            return errors;
        }
        .cast_=>|c|{
            let errors:i32=zt_driver_walk_expr(c.expr,env,decls,trusted,context);
            if(trusted==0){
                let source:ZTExpr=zt_expr_type(c.expr,env,decls,context);
                if(zt_driver_value_or_pointer_type(c.target,decls)==1||
                   (source.known==1&&zt_driver_value_or_pointer_type(source.ty,decls)==1)){
                    return errors+zt_machine_error("ordinary pointer casts cannot fabricate, copy, or free driver handles",context);
                }
            }
            return errors;
        }
        .call=>|c|{
            let errors:i32=0;
            // A direct acquisition/release call is the typed boundary. Its
            // arguments are still recursively checked, but the handle value
            // itself is not rejected merely because it crosses that declared
            // @borrows/@consumes signature.
            let direct:[]u8=zt_direct_name(c.callee);
            if(direct.len==0){errors=errors+zt_driver_walk_expr(c.callee,env,decls,trusted,context);}
            if(trusted==0&&zt_driver_raw_machine_name(direct)==1){
                errors=errors+zt_machine_error("raw allocation/load/store is not a driver capability; use a typed std:driver adapter",context);
            }
            if(trusted==0){errors=errors+zt_driver_mmio_call(c,env,decls,context);}
            if(trusted==0){errors=errors+zt_driver_atomic_call(c,env,decls,context);}
            if(trusted==0){errors=errors+zt_driver_register_field_call(c,context);}
            let i:i32=0;while(i<c.args.len){errors=errors+zt_driver_walk_expr(c.args.data[i],env,decls,trusted,context);i=i+1;}
            return errors;
        }
        .bin=>|b|{return zt_driver_walk_expr(b.l,env,decls,trusted,context)+zt_driver_walk_expr(b.r,env,decls,trusted,context);}
        .un=>|u|{return zt_driver_walk_expr(u.e,env,decls,trusted,context);}
        .idx=>|x|{return zt_driver_walk_expr(x.base,env,decls,trusted,context)+zt_driver_walk_expr(x.idx,env,decls,trusted,context);}
        .slice_=>|x|{let errors:i32=zt_driver_walk_expr(x.base,env,decls,trusted,context)+zt_driver_walk_expr(x.lo,env,decls,trusted,context);if(x.has_hi==1){return errors+zt_driver_walk_expr(x.hi,env,decls,trusted,context);}return errors;}
        else=>{return 0;}
    }
}

fn zt_driver_walk_body(body:ArrayList[*Node],env:*ArrayList[ZTBind],decls:ArrayList[*Node],trusted:i32,context:[]u8)i32{
    let errors:i32=0;let i:i32=0;while(i<body.len){switch(body.data[i].*){
        .let_=>|l|{
            if(l.has_init==1){errors=errors+zt_driver_walk_expr(l.expr,env.*,decls,trusted,context);}
            let actual:[]u8=l.dty;
            if(l.has_dty==0&&l.has_init==1){actual=zt_expr_type(l.expr,env.*,decls,context).ty;}
            if(l.has_init==1&&zt_driver_value_or_pointer_type(actual,decls)==1&&zt_driver_expr_is_id(l.expr)==1){errors=errors+zt_machine_error("driver handles cannot be copied; use an explicit @borrows or @consumes API",context);}
            if(actual.len>0){push[ZTBind](env,ZTBind{.name=l.name,.ty=actual});}
        }
        .ret=>|r|{if(r.has_expr==1){errors=errors+zt_driver_walk_expr(r.expr,env.*,decls,trusted,context);}}
        .assign=>|a|{errors=errors+zt_driver_walk_expr(a.target,env.*,decls,trusted,context)+zt_driver_walk_expr(a.expr,env.*,decls,trusted,context);if(zt_driver_expr_is_id(a.expr)==1){let target:ZTExpr=zt_expr_type(a.target,env.*,decls,context);if(target.known==1&&zt_driver_value_or_pointer_type(target.ty,decls)==1){errors=errors+zt_machine_error("driver handles cannot be copied by assignment",context);}}}
        .estmt=>|e|{errors=errors+zt_driver_walk_expr(e.expr,env.*,decls,trusted,context);}
        .defer_=>|d|{errors=errors+zt_driver_walk_expr(d.expr,env.*,decls,trusted,context);}
        .unsafe_=>|u|{let ue:ArrayList[ZTBind]=zt_env_clone(env.*);errors=errors+zt_driver_walk_body(u.body,&ue,decls,trusted,context);free[ZTBind](&ue);}
        .if_=>|x|{errors=errors+zt_driver_walk_expr(x.cond,env.*,decls,trusted,context);let te:ArrayList[ZTBind]=zt_env_clone(env.*);errors=errors+zt_driver_walk_body(x.then_body,&te,decls,trusted,context);free[ZTBind](&te);if(x.has_els==1){let ee:ArrayList[ZTBind]=zt_env_clone(env.*);errors=errors+zt_driver_walk_body(x.els_body,&ee,decls,trusted,context);free[ZTBind](&ee);}}
        .while_=>|w|{errors=errors+zt_driver_walk_expr(w.cond,env.*,decls,trusted,context);let we:ArrayList[ZTBind]=zt_env_clone(env.*);errors=errors+zt_driver_walk_body(w.body,&we,decls,trusted,context);free[ZTBind](&we);}
        .switch_=>|s|{errors=errors+zt_driver_walk_expr(s.subject,env.*,decls,trusted,context);let ai:i32=0;while(ai<s.arms.len){let ae:ArrayList[ZTBind]=zt_env_clone(env.*);errors=errors+zt_driver_walk_body(s.arms.data[ai].body,&ae,decls,trusted,context);free[ZTBind](&ae);ai=ai+1;}if(s.has_els==1){let se:ArrayList[ZTBind]=zt_env_clone(env.*);errors=errors+zt_driver_walk_body(s.els_body,&se,decls,trusted,context);free[ZTBind](&se);}}
        else=>{}
    }i=i+1;}return errors;
}

fn zt_check_v2_driver_handles(decls:ArrayList[*Node],file:[]u8)i32{
    if(@strEq(v2_project_edition(file),"2027")==0){return 0;}
    let has_driver:i32=0;let probe:i32=0;while(probe<decls.len){switch(decls.data[probe].*){.struct_=>|s|{if(zt_struct_is_driver_handle(s)==1){has_driver=1;}}else=>{}}probe=probe+1;}
    if(has_driver==0){return 0;}
    let errors:i32=0;let i:i32=0;while(i<decls.len){switch(decls.data[i].*){
        .struct_=>|s|{
            let driver:i32=zt_struct_is_driver_handle(s);
            if(driver==1){
                let context:[]u8=_zag_str_concat("struct ",s.name);
                if(zt_driver_trusted_origin(s.origin)==0){errors=errors+zt_machine_error("@driver_handle declarations are reserved to std:driver",context);}
                if(zt_struct_has_annot(s,"@resource")==0){errors=errors+zt_machine_error("@driver_handle requires @resource ownership",context);}
                let owned:i32=0;let token:i32=0;let fi:i32=0;while(fi<s.fields.len){let field:Param=s.fields.data[fi];let release:[]u8=zt_relation_arg(field.contract,"@owned(");if(release.len>0){owned=owned+1;if(@strEq(field.name,"token")&&@strEq(release,"_zag_free")&&@strEq(field.pty,"*opaque")){token=token+1;}else{errors=errors+zt_machine_error("driver handle owned storage must be exactly `token: @owned(_zag_free) *opaque`",context);}}fi=fi+1;}
                if(owned!=1||token!=1){errors=errors+zt_machine_error("driver handle requires one compiler-owned opaque token",context);}
            }
        }
        .fn_decl=>|f|{
            let env:ArrayList[ZTBind]=make[ZTBind](f.params.len+8);let pi:i32=0;while(pi<f.params.len){push[ZTBind](&env,ZTBind{.name=f.params.data[pi].name,.ty=f.params.data[pi].pty});pi=pi+1;}
            errors=errors+zt_driver_walk_body(f.body,&env,decls,zt_driver_capability_origin(f.origin),_zag_str_concat("function ",f.name));free[ZTBind](&env);
        }
        else=>{}
    }i=i+1;}return errors;
}

// A critical-path profile must expose a syntactic bound before backend
// lowering.  This is intentionally conservative: a relational loop over a
// named bound is accepted, while `while (true)`, retry-until-success, and
// opaque conditions are rejected until a proof-carrying loop form exists.
fn zt_driver_bounded_condition(n:*Node)i32{switch(n.*){
    .bin=>|b|{
        if(@strEq(b.op,"<")||@strEq(b.op,"<=")){switch(b.l.*){.id=>|_|{return 1;}else=>{}}switch(b.r.*){.id=>|_|{return 1;}else=>{}}}
        if(@strEq(b.op,"&&")||@strEq(b.op,"||")){return (zt_driver_bounded_condition(b.l)|zt_driver_bounded_condition(b.r));}
    }
    else=>{}
}return 0;}
fn zt_driver_profile_loops(body:ArrayList[*Node],context:[]u8)i32{
    let errors:i32=0;let i:i32=0;while(i<body.len){switch(body.data[i].*){
        .while_=>|w|{if(zt_driver_bounded_condition(w.cond)==0){errors=errors+zt_machine_error("@realtime/@irq requires a syntactically bounded loop; unbounded retry is unavailable",context);}errors=errors+zt_driver_profile_loops(w.body,context);}
        .if_=>|x|{errors=errors+zt_driver_profile_loops(x.then_body,context);if(x.has_els==1){errors=errors+zt_driver_profile_loops(x.els_body,context);}}
        .unsafe_=>|u|{errors=errors+zt_driver_profile_loops(u.body,context);}
        .switch_=>|s|{let ai:i32=0;while(ai<s.arms.len){errors=errors+zt_driver_profile_loops(s.arms.data[ai].body,context);ai=ai+1;}if(s.has_els==1){errors=errors+zt_driver_profile_loops(s.els_body,context);}}
        else=>{}
}i=i+1;}return errors;
}
fn zt_driver_irq_expr(n:*Node,decls:ArrayList[*Node],trusted:i32,context:[]u8)i32{
    switch(n.*){
        .call=>|c|{
            let errors:i32=0;let name:[]u8=zt_direct_name(c.callee);
            if(name.len==0){errors=errors+zt_machine_error("@irq may call only a statically proven IRQ-safe function",context);}
            else if(trusted==0&&zt_fn_has_annot(decls,name,"@irq")==0&&
                    zt_driver_ends(name,"atomic_fence")==0){
                // All user-visible IRQ device/atomic primitives carry @irq;
                // an unannotated helper is not allowed to become an implicit
                // critical-path capability.
                errors=errors+zt_machine_error("@irq call target must be explicitly annotated @irq",context);
            }
            let i:i32=0;while(i<c.args.len){errors=errors+zt_driver_irq_expr(c.args.data[i],decls,trusted,context);i=i+1;}return errors;
        }
        .bin=>|b|{return zt_driver_irq_expr(b.l,decls,trusted,context)+zt_driver_irq_expr(b.r,decls,trusted,context);}
        .un=>|u|{return zt_driver_irq_expr(u.e,decls,trusted,context);}
        .idx=>|x|{return zt_driver_irq_expr(x.base,decls,trusted,context)+zt_driver_irq_expr(x.idx,decls,trusted,context);}
        .slice_=>|x|{let errors:i32=zt_driver_irq_expr(x.base,decls,trusted,context)+zt_driver_irq_expr(x.lo,decls,trusted,context);if(x.has_hi==1){return errors+zt_driver_irq_expr(x.hi,decls,trusted,context);}return errors;}
        .fld=>|f|{return zt_driver_irq_expr(f.base,decls,trusted,context);}
        .cast_=>|c|{return zt_driver_irq_expr(c.expr,decls,trusted,context);}
        .slit_=>|s|{let errors:i32=0;let i:i32=0;while(i<s.fields.len){errors=errors+zt_driver_irq_expr(s.fields.data[i].val,decls,trusted,context);i=i+1;}return errors;}
        else=>{return 0;}
    }
}
fn zt_driver_irq_body(body:ArrayList[*Node],decls:ArrayList[*Node],trusted:i32,context:[]u8)i32{
    let errors:i32=0;let i:i32=0;while(i<body.len){switch(body.data[i].*){
        .let_=>|l|{if(l.has_init==1){errors=errors+zt_driver_irq_expr(l.expr,decls,trusted,context);}}
        .ret=>|r|{if(r.has_expr==1){errors=errors+zt_driver_irq_expr(r.expr,decls,trusted,context);}}
        .estmt=>|e|{errors=errors+zt_driver_irq_expr(e.expr,decls,trusted,context);}
        .defer_=>|d|{errors=errors+zt_driver_irq_expr(d.expr,decls,trusted,context);}
        .assign=>|a|{errors=errors+zt_driver_irq_expr(a.target,decls,trusted,context)+zt_driver_irq_expr(a.expr,decls,trusted,context);}
        .if_=>|x|{errors=errors+zt_driver_irq_expr(x.cond,decls,trusted,context)+zt_driver_irq_body(x.then_body,decls,trusted,context);if(x.has_els==1){errors=errors+zt_driver_irq_body(x.els_body,decls,trusted,context);}}
        .while_=>|w|{errors=errors+zt_driver_irq_expr(w.cond,decls,trusted,context)+zt_driver_irq_body(w.body,decls,trusted,context);}
        .unsafe_=>|u|{errors=errors+zt_driver_irq_body(u.body,decls,trusted,context);}
        .switch_=>|s|{errors=errors+zt_driver_irq_expr(s.subject,decls,trusted,context);let ai:i32=0;while(ai<s.arms.len){errors=errors+zt_driver_irq_body(s.arms.data[ai].body,decls,trusted,context);ai=ai+1;}if(s.has_els==1){errors=errors+zt_driver_irq_body(s.els_body,decls,trusted,context);}}
        else=>{}
    }i=i+1;}return errors;
}
// @realtime may share the lock-free IRQ-safe subset, but it may not call a
// broader driver lifecycle operation merely because that operation currently
// has an allocation-free emulator implementation. The adapter capability is
// part of the declaration, not an inference from today's body.
fn zt_driver_realtime_expr(n:*Node,decls:ArrayList[*Node],trusted:i32,context:[]u8)i32{
    switch(n.*){
        .call=>|c|{
            let errors:i32=0;let name:[]u8=zt_direct_name(c.callee);
            if(trusted==0&&name.len>0&&zt_fn_has_annot(decls,name,"@blocking")==1){
                errors=errors+zt_machine_error("@realtime cannot call an explicitly @blocking driver primitive",context);
            }
            if(trusted==0&&name.len>0&&
               (zt_fn_has_annot(decls,name,"@driver_init")==1||zt_fn_has_annot(decls,name,"@driver_control")==1||
                zt_fn_has_annot(decls,name,"@driver_teardown")==1)&&
               zt_fn_has_annot(decls,name,"@irq")==0&&zt_fn_has_annot(decls,name,"@realtime")==0){
                errors=errors+zt_machine_error("@realtime requires a realtime-safe or IRQ-safe driver primitive",context);
            }
            let i:i32=0;while(i<c.args.len){errors=errors+zt_driver_realtime_expr(c.args.data[i],decls,trusted,context);i=i+1;}return errors;
        }
        .bin=>|b|{return zt_driver_realtime_expr(b.l,decls,trusted,context)+zt_driver_realtime_expr(b.r,decls,trusted,context);}
        .un=>|u|{return zt_driver_realtime_expr(u.e,decls,trusted,context);}
        .idx=>|x|{return zt_driver_realtime_expr(x.base,decls,trusted,context)+zt_driver_realtime_expr(x.idx,decls,trusted,context);}
        .fld=>|f|{return zt_driver_realtime_expr(f.base,decls,trusted,context);}
        .cast_=>|x|{return zt_driver_realtime_expr(x.expr,decls,trusted,context);}
        .slice_=>|x|{let errors:i32=zt_driver_realtime_expr(x.base,decls,trusted,context)+zt_driver_realtime_expr(x.lo,decls,trusted,context);if(x.has_hi==1){return errors+zt_driver_realtime_expr(x.hi,decls,trusted,context);}return errors;}
        .slit_=>|x|{let errors:i32=0;let i:i32=0;while(i<x.fields.len){errors=errors+zt_driver_realtime_expr(x.fields.data[i].val,decls,trusted,context);i=i+1;}return errors;}
        else=>{}
    }
    return 0;
}
fn zt_driver_realtime_body(body:ArrayList[*Node],decls:ArrayList[*Node],trusted:i32,context:[]u8)i32{
    let errors:i32=0;let i:i32=0;while(i<body.len){switch(body.data[i].*{
        .let_=>|l|{if(l.has_init==1){errors=errors+zt_driver_realtime_expr(l.expr,decls,trusted,context);}}
        .ret=>|r|{if(r.has_expr==1){errors=errors+zt_driver_realtime_expr(r.expr,decls,trusted,context);}}
        .assign=>|a|{errors=errors+zt_driver_realtime_expr(a.target,decls,trusted,context)+zt_driver_realtime_expr(a.expr,decls,trusted,context);}
        .estmt=>|e|{errors=errors+zt_driver_realtime_expr(e.expr,decls,trusted,context);}
        .defer_=>|d|{errors=errors+zt_driver_realtime_expr(d.expr,decls,trusted,context);}
        .unsafe_=>|u|{errors=errors+zt_driver_realtime_body(u.body,decls,trusted,context);}
        .if_=>|x|{errors=errors+zt_driver_realtime_expr(x.cond,decls,trusted,context)+zt_driver_realtime_body(x.then_body,decls,trusted,context);if(x.has_els==1){errors=errors+zt_driver_realtime_body(x.els_body,decls,trusted,context);}}
        .while_=>|w|{errors=errors+zt_driver_realtime_expr(w.cond,decls,trusted,context)+zt_driver_realtime_body(w.body,decls,trusted,context);}
        .switch_=>|s|{errors=errors+zt_driver_realtime_expr(s.subject,decls,trusted,context);let ai:i32=0;while(ai<s.arms.len){errors=errors+zt_driver_realtime_body(s.arms.data[ai].body,decls,trusted,context);ai=ai+1;}if(s.has_els==1){errors=errors+zt_driver_realtime_body(s.els_body,decls,trusted,context);}}
        else=>{}
    }i=i+1;}return errors;
}
fn zt_check_driver_profiles(decls:ArrayList[*Node],file:[]u8)i32{
    if(@strEq(v2_project_edition(file),"2027")==0){return 0;}
    let has_profile:i32=0;let probe:i32=0;while(probe<decls.len){switch(decls.data[probe].*){.fn_decl=>|f|{let ai:i32=0;while(ai<f.annots.len){let a:[]u8=f.annots.data[ai];if(@strEq(a,"@realtime")||@strEq(a,"@irq")||@strEq(a,"@driver_init")||@strEq(a,"@driver_control")||@strEq(a,"@driver_teardown")){has_profile=1;}ai=ai+1;}}else=>{}}probe=probe+1;}
    if(has_profile==0){return 0;}
    let errors:i32=0;let i:i32=0;while(i<decls.len){switch(decls.data[i].*){.fn_decl=>|f|{
        let critical:i32=(zt_fn_has_annot(decls,f.name,"@realtime")==1||zt_fn_has_annot(decls,f.name,"@irq")==1) as i32;
        let profiles:i32=(zt_fn_has_annot(decls,f.name,"@realtime")==1) as i32+
            (zt_fn_has_annot(decls,f.name,"@driver_init")==1) as i32+
            (zt_fn_has_annot(decls,f.name,"@driver_control")==1) as i32+
            (zt_fn_has_annot(decls,f.name,"@driver_teardown")==1) as i32+
            (zt_fn_has_annot(decls,f.name,"@irq")==1) as i32;
        let blocking:i32=(zt_fn_has_annot(decls,f.name,"@blocking")==1) as i32;
        if(profiles>1){errors=errors+zt_machine_error("driver effect profiles are mutually exclusive",_zag_str_concat("function ",f.name));}
        if(blocking==1&&(zt_fn_has_annot(decls,f.name,"@realtime")==1||zt_fn_has_annot(decls,f.name,"@irq")==1)){
            errors=errors+zt_machine_error("@blocking cannot be declared on @realtime or @irq code",_zag_str_concat("function ",f.name));
        }
        if(zt_fn_has_annot(decls,f.name,"@irq")==1&&zt_driver_internal_origin(f.origin)==0){
            let pi:i32=0;while(pi<f.params.len){let p:Param=f.params.data[pi];
                // Keep the raw-pointer spelling check, but also key this
                // boundary off the explicit borrow contract.  Imported and
                // qualified parameter types may be normalized by an earlier
                // parser pass; the @irq rule must remain fail-closed even if
                // that normalization no longer leaves '*' at byte zero.
                let shared_contract:i32=(@strEq(p.contract,"@borrows")||@strEq(p.contract,"@borrows_mut")) as i32;
                let raw_pointer:i32=(p.pty.len>0&&p.pty[0]=='*') as i32;
                if((raw_pointer==1||shared_contract==1)&&zt_driver_handle_pointer_type(p.pty,decls)==0&&zt_driver_atomic_pointer_type(p.pty)==0){
                    errors=errors+zt_machine_error("@irq shared state must use a typed driver handle or Atomic[T] capability",_zag_str_concat("function ",f.name));
                }
                pi=pi+1;
            }
        }
        if(critical==1){errors=errors+zt_driver_profile_loops(f.body,_zag_str_concat("function ",f.name));}
        if(zt_fn_has_annot(decls,f.name,"@irq")==1){errors=errors+zt_driver_irq_body(f.body,decls,zt_driver_internal_origin(f.origin),_zag_str_concat("function ",f.name));}
        if(zt_fn_has_annot(decls,f.name,"@realtime")==1){errors=errors+zt_driver_realtime_body(f.body,decls,zt_driver_internal_origin(f.origin),_zag_str_concat("function ",f.name));}
    }else=>{}}i=i+1;}return errors;
}

// A versioned Linux binding may opt into a compiler-checked declaration tag:
// `@linux_api(series, api, context, effects, ownership)`. This keeps an
// unsupported kernel interface from becoming an ordinary imported function
// whose availability is discovered only after a module is built.
fn zt_driver_api_arg(annotation:[]u8,wanted:i32)i32{
    let prefix:[]u8="@linux_api(";
    if(zt_starts(annotation,prefix)==0){return -1;}
    let start:i32=prefix.len;let ordinal:i32=0;let i:i32=start;
    while(i<annotation.len){
        if(annotation[i]==','||annotation[i]==')'){
            if(ordinal==wanted){return _zag_str_to_i64(annotation[start..i]) as i32;}
            ordinal=ordinal+1;start=i+1;
            if(annotation[i]==')'){break;}
        }
        i=i+1;
    }
    return -1;
}
fn zt_driver_linux_api_decl_valid(annotation:[]u8)i32{
    let series:i32=zt_driver_api_arg(annotation,0);let api:i32=zt_driver_api_arg(annotation,1);
    let context:i32=zt_driver_api_arg(annotation,2);let effects:i32=zt_driver_api_arg(annotation,3);
    let ownership:i32=zt_driver_api_arg(annotation,4);
    if(series<0||api<0||context<0||effects<0||ownership<0){return 0;}
    if((series!=61&&series!=66)||api<1||api>8){return 0;}
    let expected_context:i32=0;let expected_effects:i32=256;let expected_ownership:i32=1;
    if(api==1||api==5){expected_context=5;expected_ownership=3;}
    else if(api==2||api==4||api==6){expected_context=7;expected_ownership=2;}
    else if(api==3||api==7||api==8){expected_context=6;expected_ownership=1;}
    if(api==5){expected_effects=320;}
    return (context==expected_context&&effects==expected_effects&&ownership==expected_ownership) as i32;
}
fn zt_check_driver_linux_api_annotations(decls:ArrayList[*Node],file:[]u8)i32{
    let errors:i32=0;let i:i32=0;
    while(i<decls.len){switch(decls.data[i].*){
        .fn_decl=>|f|{let ai:i32=0;while(ai<f.annots.len){let a:[]u8=f.annots.data[ai];if(zt_starts(a,"@linux_api(")==1){if(@strEq(v2_project_edition(file),"2027")==0){errors=errors+zt_machine_error("@linux_api requires edition = \"2027\"",_zag_str_concat("function ",f.name));}else if(zt_driver_linux_api_decl_valid(a)==0){errors=errors+zt_machine_error("unsupported Linux driver API declaration: series, context, effects, or ownership does not match std:driver",_zag_str_concat("function ",f.name));}}ai=ai+1;}}
        else=>{}
    }i=i+1;}
    return errors;
}

// The first v2 foreign-function boundary is intentionally declaration-driven.
// A bare `extern` is not silently a C declaration: only `extern fn ... @cabi`
// may enter the native System V dynamic-import path.  The validated f64 import
// slice uses SysV XMM registers; aggregates and f32 remain rejected until their
// distinct classification and layout rules have executable conformance coverage.
// A C callback is represented in source as `fn(P...) R`, but it is *not* a
// Zag fat function at the ABI boundary.  The native dynamic lowering admits
// only a direct, captureless named function and passes its code address as one
// SysV word.  Keep the nested signature integer/pointer-only: no aggregates, floats,
// variadics, closures, or hidden environment are implied by this spelling.
fn zt_cabi_callback_type_ok(ty0: []u8) i32 {
    if (ty0.len < 5 || ty0[0] != 'f' || ty0[1] != 'n' || ty0[2] != '(') { return 0; }
    let close: i32 = 0 - 1;
    let i: i32 = 3;
    while (i < ty0.len) {
        if (ty0[i] == ')') { close = i; i = ty0.len; }
        else { i = i + 1; }
    }
    if (close < 0 || close + 1 >= ty0.len) { return 0; }
    let params: []u8 = ty0[3..close];
    let start: i32 = 0;
    i = 0;
    while (i <= params.len) {
        if (i == params.len || params[i] == ',') {
            if (i > start && zt_cabi_scalar_type_ok(params[start..i]) == 0) { return 0; }
            start = i + 1;
        }
        i = i + 1;
    }
    return zt_cabi_scalar_type_ok(ty0[close + 1..]);
}

fn zt_cabi_scalar_type_ok(ty0: []u8) i32 {
    if (ty0.len > 0 && ty0[0] == '*') { return 1; }
    if (@strEq(ty0, "void") || @strEq(ty0, "bool")) { return 1; }
    if (@strEq(ty0, "i8") || @strEq(ty0, "u8") || @strEq(ty0, "i16") || @strEq(ty0, "u16")) { return 1; }
    if (@strEq(ty0, "i32") || @strEq(ty0, "u32") || @strEq(ty0, "i64") || @strEq(ty0, "u64")) { return 1; }
    return 0;
}
fn zt_cabi_import_type_ok(ty0: []u8, decls: ArrayList[*Node]) i32 {
    if (zt_cabi_callback_type_ok(ty0) == 1 || zt_cabi_scalar_type_ok(ty0) == 1) { return 1; }
    if (zt_agg_type_is_value(ty0, decls) == 1) { return 1; }
    return (@strEq(ty0, "f64") as i32);
}

fn zt_check_v2_cabi_declarations(decls: ArrayList[*Node], file: []u8) i32 {
    if (@strEq(v2_project_edition(file), "2027") == 0) { return 0; }
    let errors: i32 = 0;
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                let cabi: i32 = zt_fn_has_annot(decls, f.name, "@cabi");
                // Compiler runtime declarations remain an implementation ABI,
                // never part of the public C ABI surface.
                let runtime: i32 = zt_starts(f.name, "_zag_");
                if (cabi == 1 && f.is_extern == 0) {
                    errors = errors + zt_machine_error("@cabi is valid only on extern functions", _zag_str_concat("function ", f.name));
                }
                if (f.is_extern == 1 && runtime == 0 && cabi == 0) {
                    errors = errors + zt_machine_error("v2 foreign imports require explicit @cabi", _zag_str_concat("function ", f.name));
                }
                if (cabi == 1) {
                    let abi_ok: i32 = zt_cabi_import_type_ok(f.ret, decls);
                    // The return uses XMM0 and does not consume an argument register.
                    let fp_args: i32 = 0;
                    let pi: i32 = 0;
                    while (pi < len[Param](f.params)) {
                        let pty: []u8 = get[Param](f.params, pi).pty;
                        if (zt_cabi_import_type_ok(pty, decls) == 0) { abi_ok = 0; }
                        if (@strEq(pty, "f64")) { fp_args = fp_args + 1; }
                        pi = pi + 1;
                    }
                    if (fp_args > 4) { abi_ok = 0; }
                    if (abi_ok == 0) {
                        errors = errors + zt_machine_error(
                            "v2 @cabi imports support scalar integers, bool, raw pointers, named structs/unions, void, and up to four f64 arguments",
                            _zag_str_concat("function ", f.name)
                        );
                    }
                }
            }
            else => { }
        }
        i = i + 1;
    }
    return errors;
}

// Object-only outbound C surface: the declaration is still a Zag definition,
// but its public scalar/pointer signature is checked before an ET_REL symbol is
// emitted. Layout-sensitive forms remain fail-closed.
fn zt_check_v2_cabi_exports(decls:ArrayList[*Node],file:[]u8)i32{
    if(@strEq(v2_project_edition(file),"2027")==0){return 0;}
    let errors:i32=0;let i:i32=0;while(i<len[*Node](decls)){switch(get[*Node](decls,i).*){.fn_decl=>|f|{
        if(zt_fn_has_annot(decls,f.name,"@cabi_export")==1){
            if(f.is_extern==1||f.is_pub==0||len[[]u8](f.tparams)>0){errors=errors+zt_machine_error("@cabi_export requires a defined non-generic pub function",_zag_str_concat("function ",f.name));}
            if(@strEq(f.name,"main")==1){errors=errors+zt_machine_error("@cabi_export cannot export main", "object entry ownership is reserved to the C linker");}
            let ok:i32=zt_cabi_scalar_type_ok(f.ret);let p:i32=0;while(p<len[Param](f.params)){if(zt_cabi_scalar_type_ok(get[Param](f.params,p).pty)==0){ok=0;}p=p+1;}
            if(ok==0){errors=errors+zt_machine_error("@cabi_export supports only scalar integers, bool, raw pointers, and void",_zag_str_concat("function ",f.name));}
        }
    }else=>{}}i=i+1;}return errors;
}

fn zt_direct_name(n: *Node) []u8 {
    return switch (n.*) { .id => |x| x.name, else => "" };
}
fn zt_is_numeric(t: []u8) i32 {
    if (t.len == 0) { return 0; }
    if (vsa_type_valid(t) == 1) { return 0; }
    if (zt_is_builtin(t) == 0) { return 0; }
    if (@strEq(t, "void") || @strEq(t, "bool") || @strEq(t, "gpu_buf") || @strEq(t, "AtomicI64")) { return 0; }
    return 1;
}
fn zt_is_concrete(t: []u8) i32 {
    if (zt_is_builtin(t) == 1) { return 1; }
    if (zt_starts(t, "[]") == 1 || (t.len > 0 && (t[0] == '*' || t[0] == '?' || t[0] == '!'))) { return 1; }
    return 0;
}
fn zt_is_type_param(t: []u8) i32 {
    if (t.len == 1 && t[0] >= 'A' && t[0] <= 'Z') { return 1; }
    return 0;
}
fn zt_compatible(expected: []u8, actual: ZTExpr) i32 {
    if (actual.known == 0 || expected.len == 0) { return 1; }
    // A generic parameter remains unresolved until monomorphization. Treat it
    // as unknown on either side instead of inventing a concrete conversion.
    if (zt_is_type_param(expected) == 1 || zt_is_type_param(actual.ty) == 1) { return 1; }
    if (@strEq(expected, actual.ty)) { return 1; }
    // A payload constructs its optional/error-union wrapper without an
    // implicit representation-changing conversion.
    if (expected.len > 1 && (expected[0] == '?' || expected[0] == '!') &&
        @strEq(expected[1..], actual.ty)) { return 1; }
    if (actual.literal == 1 && zt_is_numeric(expected) == 1) { return 1; }
    if (actual.literal == 2 && (zt_is_numeric(expected) == 1)) { return 1; }
    // Existing v1 extensions permit word-scalar and specialized-numeric
    // representation conversions. Their precise rules remain backend-owned
    // until the numeric typed-ZIR slice migrates them with differential tests.
    if (zt_is_numeric(expected) == 1 && zt_is_numeric(actual.ty) == 1) { return 1; }
    if ((@strEq(expected, "i32") || @strEq(expected, "i64")) && @strEq(actual.ty, "bool")) { return 1; }
    // Named-type differences may be legal structural-interface coercions.
    if (zt_is_concrete(expected) == 0 && zt_is_concrete(actual.ty) == 0) { return 1; }
    return 0;
}
fn zt_type_error(expected: []u8, actual: []u8, context: []u8) i32 {
    _zag_eprintln(_zag_str_concat(_zag_str_concat(
        _zag_str_concat("error[E0203]: expected ", expected),
        _zag_str_concat(", found ", actual)),
        _zag_str_concat(" in ", context)));
    return 1;
}

// Dereferencing an explicitly qualified v2 pointer removes both the pointer
// and its address/mutability qualifier.  Returning `const i32` from `p.*` for
// `p:*const i32` leaks source syntax into the expression type and makes valid
// returns/assignments fail as `expected i32, found const i32`.
fn zt_deref_pointee_type(ty0:[]u8)[]u8{
    if(ty0.len<=1||ty0[0]!='*'){return "";}
    let ty:[]u8=ty0[1..];
    if(zt_starts(ty,"const ")==1||zt_starts(ty,"mut ")==1||
       zt_starts(ty,"host ")==1||zt_starts(ty,"device ")==1||
       zt_starts(ty,"workgroup ")==1){return ty[index_of(ty,' ')+1..];}
    return ty;
}

fn zt_expr_type(n: *Node, env: ArrayList[ZTBind], decls: ArrayList[*Node], context: []u8) ZTExpr {
    switch (n.*) {
        .ilit => |x| {
            if (zt_has_dot(x.text) == 1) { return zt_expr_known("f32", 2, 0); }
            return zt_expr_known("i32", 1, 0);
        }
        .slit => |_s| { return zt_expr_known("[]u8", 0, 0); }
        .embed => |_e| { return zt_expr_known("[]u8", 0, 0); }
        .id => |x| {
            if (@strEq(x.name, "true") || @strEq(x.name, "false")) { return zt_expr_known("bool", 0, 0); }
            let ty: []u8 = zt_env_get(env, x.name);
            if (zt_is_type_param(ty) == 1) { return zt_expr_unknown(0); }
            if (ty.len > 0) { return zt_expr_known(ty, 0, 0); }
            return zt_expr_unknown(0);
        }
        .cast_ => |c| {
            let inner: ZTExpr = zt_expr_type(c.expr, env, decls, context);
            let errors: i32 = inner.errors;
            if (zt_is_repr_c_type(c.target, decls) == 1) {
                errors = errors + zt_repr_c_by_value_error(context);
            }
            return zt_expr_known(c.target, 0, errors);
        }
        .slit_ => |s| {
            let errors: i32 = 0;
            if (@strEq(s.sname,"Allocation")) {
                errors = errors + zt_machine_error("Allocation is opaque; use SystemAllocator and allocation access operations", context);
            }
            if (zt_is_repr_c_type(s.sname, decls) == 1) {
                errors = errors + zt_repr_c_by_value_error(context);
            }
            let i: i32 = 0;
            while (i < len[FieldInit](s.fields)) {
                errors = errors + zt_expr_type(get[FieldInit](s.fields, i).val, env, decls, context).errors;
                i = i + 1;
            }
            let ty: []u8 = s.sname;
            if (len[[]u8](s.targs) > 0) {
                ty = _zag_str_concat(ty, "[");
                let ti: i32 = 0;
                while (ti < len[[]u8](s.targs)) {
                    if (ti > 0) { ty = _zag_str_concat(ty, ","); }
                    ty = _zag_str_concat(ty, get[[]u8](s.targs, ti));
                    ti = ti + 1;
                }
                ty = _zag_str_concat(ty, "]");
            }
            return zt_expr_known(ty, 0, errors);
        }
        .call => |c| {
            let errors: i32 = 0;
            let name: []u8 = zt_direct_name(c.callee);
            switch (c.callee.*) {
                .fld => |f| {
                    if (zt_is_atomic_i64(zt_expr_type(f.base, env, decls, context).ty) == 1) {
                        if (@strEq(f.fname, "store")) { return zt_expr_known("void", 0, 0); }
                        if (@strEq(f.fname, "load") || @strEq(f.fname, "exchange") ||
                            @strEq(f.fname, "fetch_add") || @strEq(f.fname, "fetch_sub") ||
                            @strEq(f.fname, "fetch_and") || @strEq(f.fname, "fetch_or") ||
                            @strEq(f.fname, "fetch_xor") || @strEq(f.fname, "compare_exchange")) {
                            return zt_expr_known("i64", 0, 0);
                        }
                    }
                }
                else => { }
            }
            let layout: ZTExpr = zt_layout_builtin(c, decls, context);
            if (layout.ty.len > 0) { return layout; }
            // Compiler-lowered thread handles are affine opaque owners.  They
            // deliberately expose neither a TID nor stack address to source.
            if (@strEq(name, "@threadSpawn")) { return zt_expr_known("*opaque", 0, 0); }
            if (@strEq(name, "@threadJoin")) { return zt_expr_known("void", 0, 0); }
            if (@strEq(name, "@atomicI64") && len[*Node](c.args) == 1) { return zt_expr_known("AtomicI64", 0, 0); }
            if (@strEq(name, "@allocationCreate") && len[*Node](c.args) == 4) { return zt_expr_known("Allocation", 0, 0); }
            if (@strEq(name, "@allocationRegionDeinit") && len[*Node](c.args) == 1) { return zt_expr_known("Allocation", 0, 0); }
            if (@strEq(name, "@allocationRegionInit") && len[*Node](c.args) == 1) { return zt_expr_known("i64", 0, 0); }
            if ((@strEq(name, "@allocationLen") || @strEq(name, "@allocationAllocatorId")) && len[*Node](c.args) == 1) { return zt_expr_known("i64", 0, 0); }
            if (@strEq(name, "@allocationReadU8") && len[*Node](c.args) == 2) { return zt_expr_known("u8", 0, 0); }
            if ((@strEq(name, "@allocationValidate") || @strEq(name, "@allocationFree") || @strEq(name, "@allocationWriteU8")) && len[*Node](c.args) > 0) { return zt_expr_known("void", 0, 0); }
            if (@strEq(name, "@vsaZero") || @strEq(name, "@vsaFromWords") ||
                @strEq(name, "@vsaMajority3") || @strEq(name, "@vsaDimension") ||
                @strEq(name, "@vsaWordCount")) {
                let ty: []u8 = "";
                if (len[[]u8](c.targs) == 1 && vsa_type_valid(get[[]u8](c.targs, 0)) == 1) {
                    ty = get[[]u8](c.targs, 0);
                } else {
                    errors = errors + zt_machine_error("VSA builtin requires exactly one valid vsa_b<N> type argument", context);
                }
                if (@strEq(name, "@vsaZero") || @strEq(name, "@vsaDimension") ||
                    @strEq(name, "@vsaWordCount")) {
                    if (len[*Node](c.args) != 0) {
                        errors = errors + zt_machine_error("VSA zero/dimension builtins accept no value arguments", context);
                    }
                } else if (@strEq(name, "@vsaFromWords")) {
                    if (len[*Node](c.args) != 1) {
                        errors = errors + zt_machine_error("@vsaFromWords expects exactly one []i64 or []u64 argument", context);
                    } else {
                        let a: ZTExpr = zt_expr_type(get[*Node](c.args, 0), env, decls, context);
                        errors = errors + a.errors;
                        if (a.known == 1 && !@strEq(a.ty, "[]i64") && !@strEq(a.ty, "[]u64")) {
                            errors = errors + zt_machine_error("@vsaFromWords input must be []i64 or []u64", context);
                        }
                    }
                } else {
                    if (len[*Node](c.args) != 3) {
                        errors = errors + zt_machine_error("@vsaMajority3 expects exactly three vectors", context);
                    } else {
                        let vi: i32 = 0;
                        while (vi < 3) {
                            let a: ZTExpr = zt_expr_type(get[*Node](c.args, vi), env, decls, context);
                            errors = errors + a.errors;
                            if (a.known == 1 && (ty.len == 0 || !@strEq(a.ty, ty))) {
                                errors = errors + zt_type_error(ty, a.ty, context);
                            }
                            vi = vi + 1;
                        }
                    }
                }
                if (ty.len == 0) { return zt_expr_unknown(errors); }
                if (@strEq(name, "@vsaDimension") || @strEq(name, "@vsaWordCount")) {
                    return zt_expr_known("i64", 0, errors);
                }
                return zt_expr_known(ty, 0, errors);
            }
            if (@strEq(name, "@vsaWord")) {
                if (len[[]u8](c.targs) != 0 || len[*Node](c.args) != 2) {
                    errors = errors + zt_machine_error("@vsaWord expects a vector and integer index with no type arguments", context);
                    return zt_expr_known("i64", 0, errors);
                }
                let vector: ZTExpr = zt_expr_type(get[*Node](c.args, 0), env, decls, context);
                let index: ZTExpr = zt_expr_type(get[*Node](c.args, 1), env, decls, context);
                errors = errors + vector.errors + index.errors;
                if (vector.known == 1 && vsa_type_valid(vector.ty) == 0) {
                    errors = errors + zt_machine_error("@vsaWord first argument must be vsa_b<N>", context);
                }
                if (index.known == 1 && !@strEq(index.ty, "i32") && !@strEq(index.ty, "u32") &&
                    !@strEq(index.ty, "i64") && !@strEq(index.ty, "u64")) {
                    errors = errors + zt_machine_error("@vsaWord index must be an integer", context);
                }
                return zt_expr_known("i64", 0, errors);
            }
            if (@strEq(name, "@vsaHamming")) {
                if (len[[]u8](c.targs) != 0 || len[*Node](c.args) != 2) {
                    errors = errors + zt_machine_error("@vsaHamming expects two vectors with no type arguments", context);
                    return zt_expr_known("i64", 0, errors);
                }
                let l: ZTExpr = zt_expr_type(get[*Node](c.args, 0), env, decls, context);
                let r: ZTExpr = zt_expr_type(get[*Node](c.args, 1), env, decls, context);
                errors = errors + l.errors + r.errors;
                if (l.known == 1 && r.known == 1 &&
                    (vsa_type_valid(l.ty) == 0 || !@strEq(l.ty, r.ty))) {
                    errors = errors + zt_machine_error("@vsaHamming operands must have the same vsa_b<N> type", context);
                }
                return zt_expr_known("i64", 0, errors);
            }
            let tparams: ArrayList[[]u8] = zt_fn_tparams(decls, name, c.targs);
            let i: i32 = 0;
            while (i < len[*Node](c.args)) {
                let a: ZTExpr = zt_expr_type(get[*Node](c.args, i), env, decls, context);
                errors = errors + a.errors;
                if (a.known == 1 && zt_is_repr_c_type(a.ty, decls) == 1) {
                    errors = errors + zt_repr_c_by_value_error(_zag_str_concat("call to ", name));
                }
                let expected: []u8 = zt_subst_type(zt_fn_param(decls, name, i), tparams, c.targs);
                // Generic parameters are resolved later; do not pretend T is concrete.
                if (expected.len > 0 && zt_is_builtin(expected) == 1 && zt_compatible(expected, a) == 0) {
                    errors = errors + zt_type_error(expected, a.ty, _zag_str_concat("call to ", name));
                }
                i = i + 1;
            }
            let ret: []u8 = zt_instantiated_call_ret(decls, name, c.targs);
            // An unsubstituted generic result (T/K/V) is not a concrete type.
            if (zt_is_type_param(ret) == 1) { return zt_expr_unknown(errors); }
            if (ret.len > 0) { return zt_expr_known(ret, 0, errors); }
            return zt_expr_unknown(errors);
        }
        .bin => |b| {
            let l: ZTExpr = zt_expr_type(b.l, env, decls, context);
            let r: ZTExpr = zt_expr_type(b.r, env, decls, context);
            let errors: i32 = l.errors + r.errors;
            let lvsa: i32 = 0;
            let rvsa: i32 = 0;
            if (l.known == 1) { lvsa = vsa_type_valid(l.ty); }
            if (r.known == 1) { rvsa = vsa_type_valid(r.ty); }
            if (lvsa == 1 || rvsa == 1) {
                if (lvsa == 0 || rvsa == 0 || !@strEq(l.ty, r.ty)) {
                    errors = errors + zt_type_error(l.ty, r.ty, context);
                    return zt_expr_unknown(errors);
                }
                if (!@strEq(b.op, "^") && !@strEq(b.op, "&") && !@strEq(b.op, "|")) {
                    errors = errors + zt_machine_error("vsa_b<N> supports only ^, &, and | operators; use @vsaHamming for exact comparison", context);
                    return zt_expr_unknown(errors);
                }
                return zt_expr_known(l.ty, 0, errors);
            }
            let arithmetic: i32 = 0;
            if (@strEq(b.op, "+") || @strEq(b.op, "-") || @strEq(b.op, "*") ||
                @strEq(b.op, "/") || @strEq(b.op, "%")) { arithmetic = 1; }
            if (arithmetic == 1 && l.known == 1 && r.known == 1 &&
                (@strEq(l.ty, "bool") || @strEq(r.ty, "bool") ||
                 @strEq(l.ty, "[]u8") || @strEq(r.ty, "[]u8"))) {
                errors = errors + zt_type_error(l.ty, r.ty, context);
            }
            // Raw-pointer ordering would expose an address relation that is
            // not a stable v2 provenance property.  Keep equality available
            // for identity/null tests, but reject < <= > >= before lowering.
            if ((@strEq(b.op, "<") || @strEq(b.op, ">") ||
                 @strEq(b.op, "<=") || @strEq(b.op, ">=")) &&
                ((l.known == 1 && (zt_is_v2_raw_pointer(l.ty) == 1 ||
                                   zt_is_nullable_v2_raw_pointer(l.ty) == 1)) ||
                 (r.known == 1 && (zt_is_v2_raw_pointer(r.ty) == 1 ||
                                   zt_is_nullable_v2_raw_pointer(r.ty) == 1)))) {
                errors = errors + zt_machine_error("raw-pointer ordering comparisons are unsupported; use equality only", context);
            }
            if (@strEq(b.op, "==") || @strEq(b.op, "!=") || @strEq(b.op, "<") ||
                @strEq(b.op, ">") || @strEq(b.op, "<=") || @strEq(b.op, ">=") ||
                @strEq(b.op, "&&") || @strEq(b.op, "||")) {
                return zt_expr_known("bool", 0, errors);
            }
            if (@strEq(b.op, "orelse") && l.known == 1 && l.ty.len > 1 && l.ty[0] == '?') {
                return zt_expr_known(l.ty[1..], 0, errors);
            }
            if (l.known == 1) { return zt_expr_known(l.ty, l.literal, errors); }
            return zt_expr_unknown(errors);
        }
        .un => |u| {
            let e: ZTExpr = zt_expr_type(u.e, env, decls, context);
            if (@strEq(u.op, "try") && e.known == 1 && e.ty.len > 1 && e.ty[0] == '!') {
                return zt_expr_known(e.ty[1..], 0, e.errors);
            }
            if (@strEq(u.op, "&") && e.known == 1) {
                return zt_expr_known(_zag_str_concat("*", e.ty), 0, e.errors);
            }
            return e;
        }
        .idx => |x| { let b:ZTExpr=zt_expr_type(x.base,env,decls,context);let ix:ZTExpr=zt_expr_type(x.idx,env,decls,context);if(b.known==1&&b.ty.len>2&&b.ty[0]=='['&&b.ty[1]==']'){return zt_expr_known(b.ty[2..],0,b.errors+ix.errors);}if(b.known==1&&b.ty.len>1&&b.ty[0]=='*'){return zt_expr_known(b.ty[1..],0,b.errors+ix.errors);}return zt_expr_unknown(b.errors+ix.errors); }
        .slice_ => |x| { let b:ZTExpr=zt_expr_type(x.base,env,decls,context);let lo:ZTExpr=zt_expr_type(x.lo,env,decls,context);let errors:i32=b.errors+lo.errors;if(x.has_hi==1){errors=errors+zt_expr_type(x.hi,env,decls,context).errors;}if(b.known==1&&b.ty.len>2&&b.ty[0]=='['&&b.ty[1]==']'){return zt_expr_known(b.ty,0,errors);}return zt_expr_unknown(errors); }
        .fld => |x| { let b:ZTExpr=zt_expr_type(x.base,env,decls,context);if(b.known==0){return zt_expr_unknown(b.errors);}if(@strEq(x.fname,"*")&&b.ty.len>1&&b.ty[0]=='*'){return zt_expr_known(zt_deref_pointee_type(b.ty),0,b.errors);}let field_type:[]u8=zt_aggregate_field_type(b.ty,x.fname,decls);if(field_type.len>0){return zt_expr_known(field_type,0,b.errors);}return zt_expr_unknown(b.errors); }
        else => { return zt_expr_unknown(0); }
    }
}

fn zt_expr_body(body: ArrayList[*Node], env: *ArrayList[ZTBind], decls: ArrayList[*Node],
                fn_ret: []u8, context: []u8) i32 {
    let errors: i32 = 0;
    let i: i32 = 0;
    while (i < len[*Node](body)) {
        switch (get[*Node](body, i).*) {
            .let_ => |l| {
                let e: ZTExpr = zt_expr_type(l.expr, env.*, decls, context);
                errors = errors + e.errors;
                let ty: []u8 = l.dty;
                if (l.has_dty == 1 && zt_compatible(l.dty, e) == 0) {
                    errors = errors + zt_type_error(l.dty, e.ty, context);
                }
                if (l.has_dty == 0 && e.known == 1) { ty = e.ty; }
                if (zt_is_repr_c_type(ty, decls) == 1) {
                    errors = errors + zt_repr_c_by_value_error(context);
                }
                if (ty.len > 0) { push[ZTBind](env, ZTBind{ .name = l.name, .ty = ty }); }
            }
            .ret => |r| {
                if (r.has_expr == 1) {
                    let e: ZTExpr = zt_expr_type(r.expr, env.*, decls, context);
                    errors = errors + e.errors;
                    if (e.known == 1 && zt_is_repr_c_type(e.ty, decls) == 1) {
                        errors = errors + zt_repr_c_by_value_error(context);
                    }
                    if (zt_compatible(fn_ret, e) == 0) { errors = errors + zt_type_error(fn_ret, e.ty, context); }
                }
            }
            .assign => |a| {
                let e: ZTExpr = zt_expr_type(a.expr, env.*, decls, context);
                errors = errors + e.errors;
                let target: ZTExpr = zt_expr_type(a.target, env.*, decls, context);
                errors = errors + target.errors;
                if ((e.known == 1 && zt_is_repr_c_type(e.ty, decls) == 1) ||
                    (target.known == 1 && zt_is_repr_c_type(target.ty, decls) == 1)) {
                    errors = errors + zt_repr_c_by_value_error(context);
                }
                let name: []u8 = zt_direct_name(a.target);
                let expected: []u8 = zt_env_get(env.*, name);
                if (expected.len > 0 && zt_compatible(expected, e) == 0) {
                    errors = errors + zt_type_error(expected, e.ty, context);
                }
            }
            .if_ => |x| {
                errors = errors + zt_expr_type(x.cond, env.*, decls, context).errors;
                let te: ArrayList[ZTBind] = zt_env_clone(env.*);
                errors = errors + zt_expr_body(x.then_body, &te, decls, fn_ret, context);
                free[ZTBind](&te);
                if (x.has_els == 1) {
                    let ee: ArrayList[ZTBind] = zt_env_clone(env.*);
                    errors = errors + zt_expr_body(x.els_body, &ee, decls, fn_ret, context);
                    free[ZTBind](&ee);
                }
            }
            .while_ => |w| {
                errors = errors + zt_expr_type(w.cond, env.*, decls, context).errors;
                let we: ArrayList[ZTBind] = zt_env_clone(env.*);
                errors = errors + zt_expr_body(w.body, &we, decls, fn_ret, context);
                free[ZTBind](&we);
            }
            .unsafe_ => |u| {
                let ue: ArrayList[ZTBind] = zt_env_clone(env.*);
                errors = errors + zt_expr_body(u.body, &ue, decls, fn_ret, context);
                free[ZTBind](&ue);
            }
            .defer_ => |d| { errors = errors + zt_expr_type(d.expr, env.*, decls, context).errors; }
            .estmt => |e| { errors = errors + zt_expr_type(e.expr, env.*, decls, context).errors; }
            else => { }
        }
        i = i + 1;
    }
    return errors;
}

fn zt_check_expressions(decls: ArrayList[*Node]) i32 {
    let errors: i32 = 0;
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                if (f.is_extern == 0 && zt_starts(f.name, "__iface_") == 0) {
                    let env: ArrayList[ZTBind] = make[ZTBind](len[Param](f.params) + 8);
                    zt_seed_globals(&env, decls);
                    let pi: i32 = 0;
                    while (pi < len[Param](f.params)) {
                        let p: Param = get[Param](f.params, pi);
                        push[ZTBind](&env, ZTBind{ .name = p.name, .ty = p.pty });
                        pi = pi + 1;
                    }
                    errors = errors + zt_expr_body(f.body, &env, decls, f.ret,
                                                   _zag_str_concat("function ", f.name));
                    free[ZTBind](&env);
                }
            }
            else => { }
        }
        i = i + 1;
    }
    return errors;
}

// ── v2 unsafe/raw-pointer vertical slice ───────────────────────────────────
// The parser preserves an unsafe block as a dedicated AST node. This pass
// enforces the lexical boundary for the first raw-pointer operations before
// any target lowering runs. Pointer provenance instrumentation follows in the
// allocator slice; these checks deliberately do not claim that work early.
fn zt_is_v2_raw_pointer(ty: []u8) i32 {
    if (zt_starts(ty, "*const ") == 1 || zt_starts(ty, "*mut ") == 1 ||
        zt_starts(ty, "*device ") == 1 || zt_starts(ty, "*workgroup ") == 1 ||
        zt_starts(ty, "*host ") == 1 || @strEq(ty, "*opaque")) { return 1; }
    return 0;
}

fn zt_is_nullable_v2_raw_pointer(ty: []u8) i32 {
    if (ty.len > 1 && ty[0] == '?' && zt_is_v2_raw_pointer(ty[1..]) == 1) { return 1; }
    return 0;
}

// Zero is not a v2 raw pointer. Generic/host/device/workgroup are distinct
// semantic address spaces; const/mut/opaque remain within the generic space.
fn zt_v2_pointer_space(ty0: []u8) i32 {
    let ty: []u8 = ty0;
    if (zt_is_nullable_v2_raw_pointer(ty) == 1) { ty = ty[1..]; }
    if (zt_starts(ty, "*device ") == 1) { return 2; }
    if (zt_starts(ty, "*workgroup ") == 1) { return 3; }
    if (zt_starts(ty, "*host ") == 1) { return 4; }
    if (zt_is_v2_raw_pointer(ty) == 1) { return 1; }
    return 0;
}

// Volatile/MMIO accepts only explicit qualified raw pointers. Keep qualifier
// stripping here instead of accepting a bare `*T`: this is a v2 raw-pointer
// operation and must retain its explicit address-space and mutability spelling.
fn zt_v2_pointee_type(ty0: []u8) []u8 {
    if (ty0.len < 2 || ty0[0] != '*') { return ""; }
    let ty: []u8 = ty0[1..];
    if (zt_starts(ty, "const ") == 1) { return ty[6..]; }
    if (zt_starts(ty, "mut ") == 1) { return ty[4..]; }
    if (zt_starts(ty, "host ") == 1) { return ty[5..]; }
    return "";
}

fn zt_is_v2_volatile_word_ptr(ty: []u8) i32 {
    let elem: []u8 = zt_v2_pointee_type(ty);
    if (@strEq(elem, "i64") || @strEq(elem, "u64") ||
        @strEq(elem, "isize") || @strEq(elem, "usize")) { return 1; }
    return 0;
}

fn zt_is_v2_volatile_byte_ptr(ty: []u8) i32 {
    return @strEq(zt_v2_pointee_type(ty), "u8");
}

// MMIO register widths are explicit in the intrinsic name.  Keep the
// 16/32-bit forms unsigned so a device transaction cannot accidentally gain
// sign-extension semantics from a signed language scalar; callers may cast
// the returned value when a signed interpretation is intended.
fn zt_is_v2_volatile_half_ptr(ty: []u8) i32 {
    return @strEq(zt_v2_pointee_type(ty), "u16");
}

fn zt_is_v2_volatile_dword_ptr(ty: []u8) i32 {
    return @strEq(zt_v2_pointee_type(ty), "u32");
}

// The first user-visible SIMD surface transports four i32 lanes through raw
// memory.  It remains deliberately narrower than a general vector type: only
// the exact baseline SSE2 operation has a typed contract today.
fn zt_is_v2_simd_i32_ptr(ty: []u8) i32 {
    return @strEq(zt_v2_pointee_type(ty), "i32");
}

fn zt_is_v2_simd_i32_write_ptr(ty: []u8) i32 {
    if (@strEq(zt_v2_pointee_type(ty), "i32") == 0) { return 0; }
    if (zt_starts(ty, "*mut ") == 1 || zt_starts(ty, "*host ") == 1) { return 1; }
    return 0;
}

// Linux futex words are exactly four naturally aligned bytes.  The first
// public wait/wake slice accepts only host-addressable i32 raw pointers; a
// device/workgroup pointer would require a separate GPU synchronization model.
fn zt_is_v2_futex_i32_ptr(ty: []u8) i32 {
    if (@strEq(zt_v2_pointee_type(ty), "i32") == 0) { return 0; }
    if (zt_starts(ty, "*const ") == 1 || zt_starts(ty, "*mut ") == 1 || zt_starts(ty, "*host ") == 1) { return 1; }
    return 0;
}

fn zt_machine_expr_type(n: *Node, env: ArrayList[ZTBind]) []u8 {
    return switch (n.*) {
        .id => |x| zt_env_get(env, x.name),
        .cast_ => |c| c.target,
        .fld => |f| {
            let base_ty: []u8 = zt_machine_expr_type(f.base, env);
            if (@strEq(f.fname, "?") && base_ty.len > 1 && base_ty[0] == '?') {
                return base_ty[1..];
            }
            return "";
        }
        else => "",
    };
}

// Fixed-width atomics are not generic numeric stores.  Integer literals retain
// the normal contextual i64 spelling, but a typed value must already be i64 so
// an i32/u64/bool binding cannot silently become the 64-bit memory payload.
// Unknown generic/backend expressions stay deferred to their later checker.
fn zt_machine_atomic_i64_value(n: *Node, env: ArrayList[ZTBind],
                               decls: ArrayList[*Node], context: []u8) i32 {
    let value: ZTExpr = zt_expr_type(n, env, decls, context);
    if (value.known == 0 || value.literal == 1) { return 1; }
    if (@strEq(value.ty, "i64")) { return 1; }
    return 0;
}

fn zt_machine_atomic_i32_value(n: *Node, env: ArrayList[ZTBind],
                               decls: ArrayList[*Node], context: []u8) i32 {
    let value: ZTExpr = zt_expr_type(n, env, decls, context);
    if (value.known == 0 || value.literal == 1) { return 1; }
    if (@strEq(value.ty, "i32")) { return 1; }
    return 0;
}

// A thread worker is deliberately not a general function value.  The native
// child trampoline can only call a direct, captureless, non-generic `fn() void`
// or `fn(i64) void` label. The scalar form is copied into the affine thread
// handle before clone; pointers, aggregates, captures, returns, and ABI
// adaptation remain rejected at this boundary.
fn zt_thread_worker_ok(decls: ArrayList[*Node], name: []u8, with_i64: i32) i32 {
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                if (@strEq(f.name, name)) {
                    if (f.is_extern == 0 && len[[]u8](f.tparams) == 0 &&
                        len[Param](f.params) == with_i64 && @strEq(f.ret, "void") &&
                        f.caps == 0) {
                        if (with_i64 == 0 || @strEq(get[Param](f.params, 0).pty, "i64")) { return 1; }
                    }
                    return 0;
                }
            }
            else => { }
        }
        i = i + 1;
    }
    return 0;
}

// Memory-order operands are deliberately compile-time literals in this first
// selectable-order slice.  The numeric ABI is stable and documented: 0
// relaxed, 1 acquire, 2 release, 3 acq_rel, 4 seq_cst.  Rejecting a runtime
// value here prevents a caller from smuggling an unvalidated order through a
// raw intrinsic until an order enum/type exists.
fn zt_machine_atomic_order(n: *Node) i32 {
    switch (n.*) {
        .ilit => |x| {
            if (@strEq(x.text, "0")) { return 0; }
            if (@strEq(x.text, "1")) { return 1; }
            if (@strEq(x.text, "2")) { return 2; }
            if (@strEq(x.text, "3")) { return 3; }
            if (@strEq(x.text, "4")) { return 4; }
        }
        else => { }
    }
    return -1;
}

// Compare-exchange has separate success/failure orders.  Failure never writes,
// so release/acq_rel are invalid there; it also cannot be stronger than the
// successful transaction.  These numeric rules are the complete bounded ABI
// contract until order is represented by a first-class language type.
fn zt_machine_atomic_cas_orders_ok(success: i32, failure: i32) i32 {
    if (success < 0 || failure < 0) { return 0; }
    if (failure == 0) { return 1; } // relaxed is never stronger
    if (failure == 1) { return (success == 1 || success == 3 || success == 4) as i32; }
    if (failure == 4) { return (success == 4) as i32; }
    return 0; // failure release/acq_rel
}

fn zt_machine_volatile_value(n: *Node, env: ArrayList[ZTBind],
                             decls: ArrayList[*Node], context: []u8,
                             width: i32) i32 {
    let value: ZTExpr = zt_expr_type(n, env, decls, context);
    // Integer literals are contextually typed by the fixed-width intrinsic.
    if (value.known == 0 || value.literal == 1) { return 1; }
    if (width == 1) { return @strEq(value.ty, "u8"); }
    if (width == 2) { return @strEq(value.ty, "u16"); }
    if (width == 4) { return @strEq(value.ty, "u32"); }
    return 1;
}

fn zt_machine_error(rule: []u8, context: []u8) i32 {
    _zag_eprintln(_zag_str_concat(_zag_str_concat("error[E0204]: ", rule),
                                  _zag_str_concat(" in ", context)));
    return 1;
}

fn zt_check_machine_expr(n: *Node, env: ArrayList[ZTBind], decls: ArrayList[*Node],
                         unsafe_scope: i32, writing: i32, context: []u8) i32 {
    switch (n.*) {
        // A plain `fn(...) T` value cannot yet carry Unsafe or foreign-ABI
        // authority. Letting an unsafe fn or @cabi import escape through that
        // type would make a later indirect call look safe, so reject the
        // conversion until function types have a typed safety/ABI contract.
        // Direct calls are handled below.
        .id => |x| {
            if (zt_is_atomic_i64(zt_machine_expr_type(n, env)) == 1) {
                return zt_machine_error("AtomicI64 storage is opaque; use its atomic receiver operations only", context);
            }
            if (zt_fn_has_annot(decls, x.name, "@unsafe") == 1 ||
                zt_fn_has_annot(decls, x.name, "@cabi") == 1) {
                return zt_machine_error("unsafe or C-ABI function values are not implemented; call the function directly inside unsafe", context);
            }
            return 0;
        }
        .bin => |b| { return zt_check_machine_expr(b.l, env, decls, unsafe_scope, 0, context) +
                            zt_check_machine_expr(b.r, env, decls, unsafe_scope, 0, context); }
        .slit_ => |s| {
            let errors: i32 = 0;
            let fi: i32 = 0;
            while (fi < len[FieldInit](s.fields)) {
                let value: *Node = get[FieldInit](s.fields, fi).val;
                errors = errors + zt_check_machine_expr(value, env, decls, unsafe_scope, 0, context);
                if (zt_is_atomic_i64(zt_expr_type(value, env, decls, context).ty) == 1) {
                    errors = errors + zt_machine_error("AtomicI64 storage cannot be embedded in an aggregate literal", context);
                }
                fi = fi + 1;
            }
            return errors;
        }
        .un => |u| {
            let errors:i32=zt_check_machine_expr(u.e, env, decls, unsafe_scope, 0, context);
            if (zt_is_atomic_i64(zt_machine_expr_type(u.e, env)) == 1) {
                return errors + zt_machine_error("AtomicI64 storage cannot be addressed, cast, or dereferenced", context);
            }
            return errors;
        }
        .call => |c| {
            let direct: []u8 = zt_direct_name(c.callee);
            let errors: i32 = 0;
            let atomic_method:i32=0;
            let atomic_name:[]u8="";
            switch(c.callee.*){.fld=>|f|{if(zt_is_atomic_i64(zt_machine_expr_type(f.base,env))==1){atomic_method=1;atomic_name=f.fname;}}else=>{}}
            // Do not treat the callee of a direct call as a function value;
            // the lexical call-site rule below is its authority.
            if (direct.len == 0 && atomic_method==0) {
                errors = zt_check_machine_expr(c.callee, env, decls, unsafe_scope, 0, context);
            }
            if (atomic_method==1) {
                if(unsafe_scope==0){errors=errors+zt_machine_error("AtomicI64 operations require unsafe",context);}
                if(!(@strEq(atomic_name,"load")||@strEq(atomic_name,"store")||@strEq(atomic_name,"exchange")||@strEq(atomic_name,"fetch_add")||@strEq(atomic_name,"fetch_sub")||@strEq(atomic_name,"fetch_and")||@strEq(atomic_name,"fetch_or")||@strEq(atomic_name,"fetch_xor")||@strEq(atomic_name,"compare_exchange"))){errors=errors+zt_machine_error("unknown AtomicI64 operation",context);}
                let want:i32=2;if(@strEq(atomic_name,"load")){want=1;}if(@strEq(atomic_name,"compare_exchange")){want=4;}
                if(len[*Node](c.args)!=want){errors=errors+zt_machine_error("AtomicI64 operation has the wrong argument count",context);}
                let ai:i32=0;while(ai<len[*Node](c.args)){
                    let a:ZTExpr=zt_expr_type(get[*Node](c.args,ai),env,decls,context);
                    let is_order:i32=0;
                    if(@strEq(atomic_name,"load")&&ai==0){is_order=1;}
                    if(!@strEq(atomic_name,"load")&&!@strEq(atomic_name,"compare_exchange")&&ai==1){is_order=1;}
                    if(@strEq(atomic_name,"compare_exchange")&&(ai==2||ai==3)){is_order=1;}
                    if(is_order==0&&a.known==1&&!@strEq(a.ty,"i64")&&a.literal==0){errors=errors+zt_machine_error("AtomicI64 values must be i64",context);}
                    ai=ai+1;
                }
            }
            if (direct.len > 0 && zt_fn_has_annot(decls, direct, "@unsafe") == 1 && unsafe_scope == 0) {
                errors = errors + zt_machine_error("call to unsafe function requires unsafe", context);
            } else if (direct.len > 0 && zt_fn_has_annot(decls, direct, "@cabi") == 1 && unsafe_scope == 0) {
                errors = errors + zt_machine_error("call to @cabi function requires unsafe", context);
            }
            // Fixed-buffer and arena construction are admitted only by the
            // retained-owner pass below. That pass requires a named checked
            // backing, top-level block lifecycle, reset invalidation, and
            // deinit handoff; no ambient mutable allocator capability exists.
            if (@strEq(direct, "@prefetch")) {
                if (unsafe_scope == 0) {
                    errors = errors + zt_machine_error("prefetch requires unsafe", context);
                }
                if (len[*Node](c.args) != 1) {
                    errors = errors + zt_machine_error("@prefetch expects one raw pointer", context);
                } else {
                    let pty: []u8 = zt_machine_expr_type(get[*Node](c.args, 0), env);
                    if (zt_is_v2_raw_pointer(pty) == 0) {
                        errors = errors + zt_machine_error("@prefetch requires a raw pointer", context);
                    } else if (zt_v2_pointer_space(pty) == 2 || zt_v2_pointer_space(pty) == 3) {
                        errors = errors + zt_machine_error("@prefetch on *device/*workgroup requires a GPU runtime", context);
                    }
                }
            }
            if (@strEq(direct, "@simdAddI32x4") || @strEq(direct, "@simdSubI32x4") ||
                @strEq(direct, "@simdAndI32x4") || @strEq(direct, "@simdOrI32x4") ||
                @strEq(direct, "@simdXorI32x4")) {
                if (unsafe_scope == 0) {
                    errors = errors + zt_machine_error("packed SIMD requires unsafe", context);
                }
                if (len[*Node](c.args) != 3) {
                    errors = errors + zt_machine_error("packed i32x4 SIMD expects dst, lhs, rhs raw i32 pointers", context);
                } else {
                    let dst_ty: []u8 = zt_machine_expr_type(get[*Node](c.args, 0), env);
                    let lhs_ty: []u8 = zt_machine_expr_type(get[*Node](c.args, 1), env);
                    let rhs_ty: []u8 = zt_machine_expr_type(get[*Node](c.args, 2), env);
                    if (zt_is_v2_simd_i32_write_ptr(dst_ty) == 0) {
                        errors = errors + zt_machine_error("packed i32x4 SIMD dst requires *mut/*host i32", context);
                    }
                    if (zt_is_v2_simd_i32_ptr(lhs_ty) == 0 || zt_is_v2_simd_i32_ptr(rhs_ty) == 0) {
                        errors = errors + zt_machine_error("packed i32x4 SIMD inputs require *const/*mut/*host i32", context);
                    }
                }
            }
            if (@strEq(direct, "@volatileLoad") || @strEq(direct, "@volatileStore") ||
                @strEq(direct, "@volatileLoad8") || @strEq(direct, "@volatileStore8") ||
                @strEq(direct, "@volatileLoad16") || @strEq(direct, "@volatileStore16") ||
                @strEq(direct, "@volatileLoad32") || @strEq(direct, "@volatileStore32")) {
                if (unsafe_scope == 0) {
                    errors = errors + zt_machine_error("volatile/MMIO access requires unsafe", context);
                }
                let need: i32 = 1;
                let byte_width: i32 = 0;
                if (@strEq(direct, "@volatileLoad8") || @strEq(direct, "@volatileStore8")) { byte_width = 1; }
                if (@strEq(direct, "@volatileLoad16") || @strEq(direct, "@volatileStore16")) { byte_width = 2; }
                if (@strEq(direct, "@volatileLoad32") || @strEq(direct, "@volatileStore32")) { byte_width = 4; }
                if (@strEq(direct, "@volatileStore") || @strEq(direct, "@volatileStore8") ||
                    @strEq(direct, "@volatileStore16") || @strEq(direct, "@volatileStore32")) { need = 2; }
                if (len[*Node](c.args) != need) {
                    errors = errors + zt_machine_error("volatile/MMIO intrinsic has the wrong argument count", context);
                } else if (len[*Node](c.args) > 0) {
                    let pty: []u8 = zt_machine_expr_type(get[*Node](c.args, 0), env);
                    if ((byte_width == 1 && zt_is_v2_volatile_byte_ptr(pty) == 0) ||
                        (byte_width == 2 && zt_is_v2_volatile_half_ptr(pty) == 0) ||
                        (byte_width == 4 && zt_is_v2_volatile_dword_ptr(pty) == 0) ||
                        (byte_width == 0 && zt_is_v2_volatile_word_ptr(pty) == 0)) {
                        if (byte_width == 1) {
                            errors = errors + zt_machine_error("volatile/MMIO byte access requires *const/*mut/*host u8", context);
                        } else if (byte_width == 2) {
                            errors = errors + zt_machine_error("volatile/MMIO halfword access requires *const/*mut/*host u16", context);
                        } else if (byte_width == 4) {
                            errors = errors + zt_machine_error("volatile/MMIO dword access requires *const/*mut/*host u32", context);
                        } else {
                            errors = errors + zt_machine_error("volatile/MMIO requires *const/*mut/*host i64, u64, isize, or usize", context);
                        }
                    }
                    if ((@strEq(direct, "@volatileStore") || @strEq(direct, "@volatileStore8") ||
                         @strEq(direct, "@volatileStore16") || @strEq(direct, "@volatileStore32")) &&
                        zt_starts(pty, "*const ") == 1) {
                        errors = errors + zt_machine_error("volatile/MMIO store cannot write through *const", context);
                    }
                    if ((@strEq(direct, "@volatileStore8") || @strEq(direct, "@volatileStore16") ||
                         @strEq(direct, "@volatileStore32")) &&
                        zt_machine_volatile_value(get[*Node](c.args, 1), env, decls, context, byte_width) == 0) {
                        if (byte_width == 1) {
                            errors = errors + zt_machine_error("volatile/MMIO byte store value must be u8", context);
                        } else if (byte_width == 2) {
                            errors = errors + zt_machine_error("volatile/MMIO halfword store value must be u16", context);
                        } else {
                            errors = errors + zt_machine_error("volatile/MMIO dword store value must be u32", context);
                        }
                    }
                }
            }
            if (@strEq(direct, "@atomicExchange64") || @strEq(direct, "@atomicLoad64") || @strEq(direct, "@atomicStore64") || @strEq(direct, "@atomicFetchAdd64") || @strEq(direct, "@atomicFetchSub64") || @strEq(direct, "@atomicFetchAnd64") || @strEq(direct, "@atomicFetchOr64") || @strEq(direct, "@atomicFetchXor64")) {
                if (unsafe_scope == 0) {
                    if (@strEq(direct, "@atomicExchange64")) {
                        errors = errors + zt_machine_error("atomic exchange requires unsafe", context);
                    } else if (@strEq(direct, "@atomicFetchAdd64") || @strEq(direct, "@atomicFetchSub64")) {
                        errors = errors + zt_machine_error("atomic fetch-add/sub requires unsafe", context);
                    } else if (@strEq(direct, "@atomicFetchAnd64") || @strEq(direct, "@atomicFetchOr64") || @strEq(direct, "@atomicFetchXor64")) {
                        errors = errors + zt_machine_error("atomic fetch operation requires unsafe", context);
                    } else {
                        errors = errors + zt_machine_error("atomic operation requires unsafe", context);
                    }
                }
                let expected:i32=2;
                if (@strEq(direct,"@atomicLoad64")) { expected=1; }
                if (len[*Node](c.args) != expected) {
                    errors = errors + zt_machine_error("atomic i64 operation has the wrong argument count", context);
                } else {
                    let pty: []u8 = zt_machine_expr_type(get[*Node](c.args, 0), env);
                    let ptr_ok:i32=0;
                    if (@strEq(direct,"@atomicLoad64")) {
                        if (@strEq(pty,"*const i64") || @strEq(pty,"*mut i64")) { ptr_ok=1; }
                    } else if (@strEq(pty,"*mut i64")) { ptr_ok=1; }
                    if (ptr_ok == 0) {
                        if (@strEq(direct, "@atomicExchange64")) {
                            errors = errors + zt_machine_error("@atomicExchange64 requires an explicitly mutable, naturally aligned *mut i64", context);
                        } else if (@strEq(direct, "@atomicFetchAdd64") || @strEq(direct, "@atomicFetchSub64")) {
                            errors = errors + zt_machine_error("atomic fetch-add/sub requires an explicitly mutable, naturally aligned *mut i64", context);
                        } else if (@strEq(direct, "@atomicFetchAnd64") || @strEq(direct, "@atomicFetchOr64") || @strEq(direct, "@atomicFetchXor64")) {
                            errors = errors + zt_machine_error("atomic fetch operation requires an explicitly mutable, naturally aligned *mut i64", context);
                        } else {
                            errors = errors + zt_machine_error("atomic i64 operation requires an explicitly aligned *const/*mut i64; stores/exchanges require *mut", context);
                        }
                    }
                    if (!@strEq(direct, "@atomicLoad64") &&
                        zt_machine_atomic_i64_value(get[*Node](c.args, 1), env, decls, context) == 0) {
                        if (@strEq(direct, "@atomicFetchAdd64") || @strEq(direct, "@atomicFetchSub64")) {
                            errors = errors + zt_machine_error("atomic fetch-add/sub value must be i64", context);
                        } else if (@strEq(direct, "@atomicFetchAnd64") || @strEq(direct, "@atomicFetchOr64") || @strEq(direct, "@atomicFetchXor64")) {
                            errors = errors + zt_machine_error("atomic fetch operation value must be i64", context);
                        } else {
                            errors = errors + zt_machine_error("atomic store/exchange value must be i64", context);
                        }
                    }
                }
            }
            if (@strEq(direct, "@atomicWait32") || @strEq(direct, "@atomicWake32")) {
                if (unsafe_scope == 0) {
                    errors = errors + zt_machine_error("atomic futex operation requires unsafe", context);
                }
                if (len[*Node](c.args) != 2) {
                    errors = errors + zt_machine_error("atomic futex operation expects an i32 raw pointer and i32 value", context);
                } else {
                    let pty: []u8 = zt_machine_expr_type(get[*Node](c.args, 0), env);
                    if (zt_is_v2_futex_i32_ptr(pty) == 0) {
                        errors = errors + zt_machine_error("atomic futex operation requires an explicitly aligned *const/*mut/*host i32", context);
                    }
                    if (zt_machine_atomic_i32_value(get[*Node](c.args, 1), env, decls, context) == 0) {
                        errors = errors + zt_machine_error("atomic futex expected value/count must be i32", context);
                    }
                }
            }
            if (@strEq(direct, "@threadSpawn")) {
                if (unsafe_scope == 0) {
                    errors = errors + zt_machine_error("thread spawn requires unsafe", context);
                }
                if (len[*Node](c.args) != 1 && len[*Node](c.args) != 2) {
                    errors = errors + zt_machine_error("@threadSpawn expects a direct worker, optionally followed by one i64 argument", context);
                } else {
                    let worker: []u8 = zt_direct_name(get[*Node](c.args, 0));
                    let with_i64: i32 = (len[*Node](c.args) == 2) as i32;
                    if (worker.len == 0 || zt_thread_worker_ok(decls, worker, with_i64) == 0) {
                        errors = errors + zt_machine_error("@threadSpawn requires a direct non-generic captureless fn() void or fn(i64) void worker", context);
                    }
                    if (with_i64 == 1 && zt_machine_atomic_i64_value(get[*Node](c.args, 1), env, decls, context) == 0) {
                        errors = errors + zt_machine_error("@threadSpawn worker argument must be i64", context);
                    }
                }
            }
            if (@strEq(direct, "@threadJoin")) {
                if (unsafe_scope == 0) {
                    errors = errors + zt_machine_error("thread join requires unsafe", context);
                }
                if (len[*Node](c.args) != 1) {
                    errors = errors + zt_machine_error("@threadJoin expects one owned *opaque handle", context);
                } else if (@strEq(zt_machine_expr_type(get[*Node](c.args, 0), env), "*opaque") == 0) {
                    errors = errors + zt_machine_error("@threadJoin requires the named *opaque handle returned by @threadSpawn", context);
                }
            }
            if (@strEq(direct, "@atomicCompareExchange64")) {
                if (unsafe_scope == 0) {
                    errors = errors + zt_machine_error("atomic compare-exchange requires unsafe", context);
                }
                if (len[*Node](c.args) != 3) {
                    errors = errors + zt_machine_error("atomic compare-exchange has the wrong argument count", context);
                } else {
                    let pty: []u8 = zt_machine_expr_type(get[*Node](c.args, 0), env);
                    if (@strEq(pty, "*mut i64") == 0) {
                        errors = errors + zt_machine_error("@atomicCompareExchange64 requires an explicitly mutable, naturally aligned *mut i64", context);
                    }
                    if (zt_machine_atomic_i64_value(get[*Node](c.args, 1), env, decls, context) == 0 ||
                        zt_machine_atomic_i64_value(get[*Node](c.args, 2), env, decls, context) == 0) {
                        errors = errors + zt_machine_error("atomic compare-exchange values must be i64", context);
                    }
                }
            }
            if (@strEq(direct, "@atomicLoad64Order") || @strEq(direct, "@atomicStore64Order")) {
                if (unsafe_scope == 0) {
                    errors = errors + zt_machine_error("atomic memory-order operation requires unsafe", context);
                }
                let loading:i32 = (@strEq(direct, "@atomicLoad64Order") as i32);
                let expected:i32 = 2;
                if (loading == 0) { expected = 3; }
                if (len[*Node](c.args) != expected) {
                    errors = errors + zt_machine_error("atomic memory-order operation has the wrong argument count", context);
                } else {
                    let pty:[]u8 = zt_machine_expr_type(get[*Node](c.args, 0), env);
                    let ptr_ok:i32 = 0;
                    if (loading == 1) {
                        if (@strEq(pty, "*const i64") || @strEq(pty, "*mut i64")) { ptr_ok = 1; }
                    } else if (@strEq(pty, "*mut i64")) { ptr_ok = 1; }
                    if (ptr_ok == 0) {
                        errors = errors + zt_machine_error("atomic memory-order operation requires an explicitly aligned *const/*mut i64; stores require *mut", context);
                    }
                    let order_arg:i32 = 1;
                    if (loading == 0) { order_arg = 2; }
                    let order:i32 = zt_machine_atomic_order(get[*Node](c.args, order_arg));
                    if (order < 0) {
                        errors = errors + zt_machine_error("atomic memory order must be an integer literal 0=relaxed, 1=acquire, 2=release, 3=acq_rel, or 4=seq_cst", context);
                    } else if ((loading == 1 && (order == 2 || order == 3)) ||
                               (loading == 0 && (order == 1 || order == 3))) {
                        if (loading == 1) {
                            errors = errors + zt_machine_error("atomic load memory order cannot be release or acq_rel", context);
                        } else {
                            errors = errors + zt_machine_error("atomic store memory order cannot be acquire or acq_rel", context);
                        }
                    }
                    if (loading == 0 && zt_machine_atomic_i64_value(get[*Node](c.args, 1), env, decls, context) == 0) {
                        errors = errors + zt_machine_error("atomic store memory-order value must be an i64", context);
                    }
                }
            }
            if (@strEq(direct, "@atomicExchange64Order") ||
                @strEq(direct, "@atomicFetchAdd64Order") || @strEq(direct, "@atomicFetchSub64Order") ||
                @strEq(direct, "@atomicFetchAnd64Order") || @strEq(direct, "@atomicFetchOr64Order") ||
                @strEq(direct, "@atomicFetchXor64Order")) {
                if (unsafe_scope == 0) {
                    errors = errors + zt_machine_error("atomic read-modify-write memory-order operation requires unsafe", context);
                }
                if (len[*Node](c.args) != 3) {
                    errors = errors + zt_machine_error("atomic read-modify-write memory-order operation expects pointer, i64 value, and order", context);
                } else {
                    let pty:[]u8 = zt_machine_expr_type(get[*Node](c.args, 0), env);
                    if (@strEq(pty, "*mut i64") == 0) {
                        errors = errors + zt_machine_error("atomic read-modify-write memory-order operation requires an explicitly mutable, naturally aligned *mut i64", context);
                    }
                    if (zt_machine_atomic_i64_value(get[*Node](c.args, 1), env, decls, context) == 0) {
                        errors = errors + zt_machine_error("atomic read-modify-write memory-order value must be i64", context);
                    }
                    if (zt_machine_atomic_order(get[*Node](c.args, 2)) < 0) {
                        errors = errors + zt_machine_error("atomic memory order must be an integer literal 0=relaxed, 1=acquire, 2=release, 3=acq_rel, or 4=seq_cst", context);
                    }
                }
            }
            if (@strEq(direct, "@atomicCompareExchange64Order")) {
                if (unsafe_scope == 0) {
                    errors = errors + zt_machine_error("atomic compare-exchange memory-order operation requires unsafe", context);
                }
                if (len[*Node](c.args) != 5) {
                    errors = errors + zt_machine_error("atomic compare-exchange memory-order operation expects pointer, expected, desired, success order, and failure order", context);
                } else {
                    let pty:[]u8 = zt_machine_expr_type(get[*Node](c.args, 0), env);
                    if (@strEq(pty, "*mut i64") == 0) {
                        errors = errors + zt_machine_error("atomic compare-exchange memory-order operation requires an explicitly mutable, naturally aligned *mut i64", context);
                    }
                    if (zt_machine_atomic_i64_value(get[*Node](c.args, 1), env, decls, context) == 0 ||
                        zt_machine_atomic_i64_value(get[*Node](c.args, 2), env, decls, context) == 0) {
                        errors = errors + zt_machine_error("atomic compare-exchange memory-order values must be i64", context);
                    }
                    let success:i32 = zt_machine_atomic_order(get[*Node](c.args, 3));
                    let failure:i32 = zt_machine_atomic_order(get[*Node](c.args, 4));
                    if (success < 0 || failure < 0) {
                        errors = errors + zt_machine_error("atomic memory order must be an integer literal 0=relaxed, 1=acquire, 2=release, 3=acq_rel, or 4=seq_cst", context);
                    } else if (zt_machine_atomic_cas_orders_ok(success, failure) == 0) {
                        errors = errors + zt_machine_error("atomic compare-exchange failure order must be relaxed/acquire/seq_cst and no stronger than success", context);
                    }
                }
            }
            if (@strEq(direct, "@atomicFence")) {
                if (unsafe_scope == 0) {
                    errors = errors + zt_machine_error("atomic fence requires unsafe", context);
                }
                if (len[*Node](c.args) != 1) {
                    errors = errors + zt_machine_error("atomic fence expects one literal memory order", context);
                } else if (zt_machine_atomic_order(get[*Node](c.args, 0)) < 0) {
                    errors = errors + zt_machine_error("atomic fence order must be an integer literal 0=relaxed, 1=acquire, 2=release, 3=acq_rel, or 4=seq_cst", context);
                }
            }
            switch (c.callee.*) {
                .fld => |f| {
                    let ty: []u8 = zt_machine_expr_type(f.base, env);
                    if (@strEq(f.fname, "add") || @strEq(f.fname, "sub") ||
                        @strEq(f.fname, "byte_add")) {
                        if (zt_is_nullable_v2_raw_pointer(ty) == 1) {
                            errors = errors + zt_machine_error("nullable raw pointer must be explicitly unwrapped before pointer arithmetic", context);
                        } else if (@strEq(ty, "*opaque") &&
                                   (@strEq(f.fname, "add") || @strEq(f.fname, "sub"))) {
                            errors = errors + zt_machine_error("*opaque supports byte_add only; convert explicitly to a typed pointer before element arithmetic", context);
                        } else if (zt_is_v2_raw_pointer(ty) == 1 && unsafe_scope == 0) {
                            errors = errors + zt_machine_error("raw-pointer arithmetic requires unsafe", context);
                        }
                    }
                }
                else => { }
            }
            let i: i32 = 0;
            while (i < len[*Node](c.args)) {
                errors = errors + zt_check_machine_expr(get[*Node](c.args, i), env, decls, unsafe_scope, 0, context);
                i = i + 1;
            }
            return errors;
        }
        .idx => |x| {
            let errors: i32 = zt_check_machine_expr(x.base, env, decls, unsafe_scope, 0, context) +
                              zt_check_machine_expr(x.idx, env, decls, unsafe_scope, 0, context);
            let base_ty: []u8 = zt_machine_expr_type(x.base, env);
            if (zt_is_atomic_i64(base_ty)==1) { return errors+zt_machine_error("AtomicI64 storage cannot be indexed",context); }
            if (zt_is_nullable_v2_raw_pointer(base_ty) == 1) {
                errors = errors + zt_machine_error("nullable raw pointer must be explicitly unwrapped before indexing", context);
            } else if (@strEq(base_ty, "*opaque")) {
                errors = errors + zt_machine_error("*opaque cannot be indexed without an explicit typed conversion", context);
            } else if (zt_v2_pointer_space(base_ty) == 2 || zt_v2_pointer_space(base_ty) == 3) {
                errors = errors + zt_machine_error("*device/*workgroup indexing requires a GPU runtime", context);
            } else if (zt_is_v2_raw_pointer(base_ty) == 1 && unsafe_scope == 0) {
                errors = errors + zt_machine_error("raw-pointer indexing requires unsafe", context);
            }
            return errors;
        }
        .fld => |f| {
            let errors: i32 = zt_check_machine_expr(f.base, env, decls, unsafe_scope, 0, context);
            let ty: []u8 = zt_machine_expr_type(f.base, env);
            if (zt_is_atomic_i64(ty)==1) { return errors+zt_machine_error("AtomicI64 has no readable fields",context); }
            if (@strEq(ty,"Allocation")) { return errors+zt_machine_error("Allocation is opaque; use allocation access operations",context); }
            if (@strEq(f.fname, "*")) {
                if (zt_is_nullable_v2_raw_pointer(ty) == 1) {
                    errors = errors + zt_machine_error("nullable raw pointer must be explicitly unwrapped before dereference", context);
                } else if (zt_is_v2_raw_pointer(ty) == 1) {
                    if (unsafe_scope == 0) {
                        errors = errors + zt_machine_error("raw-pointer dereference requires unsafe", context);
                    }
                    if (writing == 1 && zt_starts(ty, "*const ") == 1) {
                        errors = errors + zt_machine_error("cannot write through *const pointer", context);
                    }
                    if (@strEq(ty, "*opaque")) {
                        errors = errors + zt_machine_error("*opaque cannot be dereferenced without an explicit typed conversion", context);
                    } else if (zt_v2_pointer_space(ty) == 2 || zt_v2_pointer_space(ty) == 3) {
                        errors = errors + zt_machine_error("*device/*workgroup dereference requires a GPU runtime", context);
                    }
                }
            }
            return errors;
        }
        .cast_ => |c| {
            let errors: i32 = zt_check_machine_expr(c.expr, env, decls, unsafe_scope, 0, context);
            if (zt_is_atomic_i64(zt_machine_expr_type(c.expr,env))==1) { return errors+zt_machine_error("AtomicI64 storage cannot be cast",context); }
            if (@strEq(zt_machine_expr_type(c.expr,env),"Allocation")) { return errors+zt_machine_error("Allocation storage cannot be cast",context); }
            if (zt_is_v2_raw_pointer(c.target) == 1 && unsafe_scope == 0) {
                errors = errors + zt_machine_error("conversion to a raw pointer requires unsafe", context);
            }
            let source_space: i32 = zt_v2_pointer_space(zt_machine_expr_type(c.expr, env));
            let target_space: i32 = zt_v2_pointer_space(c.target);
            if (source_space > 0 && target_space > 0 && source_space != target_space) {
                errors = errors + zt_machine_error("cannot cast between distinct raw-pointer address spaces", context);
            }
            return errors;
        }
        .slice_ => |s| { return zt_check_machine_expr(s.base, env, decls, unsafe_scope, 0, context) +
                                zt_check_machine_expr(s.lo, env, decls, unsafe_scope, 0, context) +
                                zt_check_machine_expr(s.hi, env, decls, unsafe_scope, 0, context); }
        else => { return 0; }
    }
}

// `Allocation` is moving from a runtime-validated record toward an affine
// language capability.  These are the only direct receiver forms that mint or
// transfer a fresh handle in the current bounded implementation.  Everything
// else that produces an Allocation-shaped value is rejected at a local copy
// boundary until general capability summaries exist.
// A helper return is an Allocation transfer only with an explicit @alloc
// declaration, a declared Allocation result, and no Allocation input that it
// could merely echo.  The annotation is not authority by itself: every return
// must be a direct allocator mint or a transitively proven @alloc helper.  The
// graph walk is bounded by the number of declarations, so recursive cycles do
// not become accidental proof. Unknown and foreign calls remain fail-closed.
fn zt_allocation_return_base(decls:ArrayList[*Node],name:[]u8)i32{let i:i32=0;while(i<decls.len){switch(decls.data[i].*){.fn_decl=>|f|{if(@strEq(f.name,name)&&f.is_extern==0&&zt_fn_has_annot(decls,name,"@alloc")==1&&(@strEq(f.ret,"Allocation")||@strEq(f.ret,"!Allocation"))){let pi:i32=0;while(pi<f.params.len){if(@strEq(f.params.data[pi].pty,"Allocation")){return 0;}pi=pi+1;}return 1;}}else=>{}}i=i+1;}return 0;}
// A branch may transfer a tracked capability only when every arm terminates by
// returning that same sole capability.  Keeping this proof deliberately exact
// avoids treating arbitrary branch-local effects as a capability join.
fn zt_allocation_exact_terminal_transfer(body:ArrayList[*Node],owner:[]u8)i32{let i:i32=0;while(i<body.len){switch(body.data[i].*){.ret=>|r|{return (r.has_expr==1&&@strEq(zt_expr_transparent_id(r.expr),owner)) as i32;}.if_=>|x|{return (x.has_els==1&&zt_allocation_exact_terminal_transfer(x.then_body,owner)==1&&zt_allocation_exact_terminal_transfer(x.els_body,owner)==1) as i32;}.switch_=>|x|{let ai:i32=0;while(ai<x.arms.len){if(zt_allocation_exact_terminal_transfer(x.arms.data[ai].body,owner)==0){return 0;}ai=ai+1;}return zt_allocation_exact_terminal_transfer(x.els_body,owner);}.unsafe_=>|u|{return zt_allocation_exact_terminal_transfer(u.body,owner);}else=>{return 0;}}i=i+1;}return 0;}
fn zt_allocation_owner_transfer_contract(decls:ArrayList[*Node],name:[]u8)i32{
    if(zt_fn_has_consumes_contract(decls,name)==0||zt_fn_has_annot(decls,name,"@returns_owner")==0){return 0;}
    let i:i32=0;while(i<decls.len){switch(decls.data[i].*){.fn_decl=>|f|{if(@strEq(f.name,name)&&f.is_extern==0&&(@strEq(f.ret,"Allocation")||@strEq(f.ret,"!Allocation"))){
        let owner:[]u8="";let count:i32=0;let pi:i32=0;while(pi<f.params.len){if(@strEq(f.params.data[pi].pty,"Allocation")&&zt_consumes_param(decls,name,pi)==1){owner=f.params.data[pi].name;count=count+1;}pi=pi+1;}
        return (count==1&&zt_allocation_exact_terminal_transfer(f.body,owner)==1) as i32;
    }}else=>{}}i=i+1;}return 0;
}
fn zt_allocation_owner_transfer_expr(n:*Node,decls:ArrayList[*Node])i32{switch(n.*){
    .un=>|u|{if(@strEq(u.op,"try")){return zt_allocation_owner_transfer_expr(u.e,decls);}}
    .cast_=>|c|{return zt_allocation_owner_transfer_expr(c.expr,decls);}
    .call=>|c|{return zt_allocation_owner_transfer_contract(decls,zt_direct_name(c.callee));}
    else=>{}
}return 0;}
fn zt_allocation_proven_return_body(body:ArrayList[*Node],decls:ArrayList[*Node],depth:i32)i32{let seen:i32=0;let live:ArrayList[[]u8]=make[[]u8](4);let i:i32=0;while(i<body.len){switch(body.data[i].*){.let_=>|l|{if(l.has_init==1&&(zt_allocation_mint_expr(l.expr,decls)==1||zt_allocation_proven_helper_expr(l.expr,decls,depth)==1)){if(zt_in_names(live,l.name)==1){free[[]u8](&live);return 0;}push[[]u8](&live,l.name);}}.assign=>|a|{if(zt_allocation_mint_expr(a.expr,decls)==1||zt_allocation_proven_helper_expr(a.expr,decls,depth)==1){free[[]u8](&live);return 0;}}.estmt=>|e|{let released:[]u8=zt_allocator_deallocate_owner(e.expr);if(released.len>0){zt_names_remove(&live,released);}}.defer_=>|d|{let released:[]u8=zt_allocator_deallocate_owner(d.expr);if(released.len>0){zt_names_remove(&live,released);}}.ret=>|r|{if(r.has_expr==0){free[[]u8](&live);return 0;}if(zt_allocation_mint_expr(r.expr,decls)==1||zt_allocation_proven_helper_expr(r.expr,decls,depth)==1){if(live.len>0){free[[]u8](&live);return 0;}}else{let local:[]u8=zt_expr_transparent_id(r.expr);if(zt_in_names(live,local)==0){free[[]u8](&live);return 0;}zt_names_remove(&live,local);if(live.len>0){free[[]u8](&live);return 0;}}seen=1;}.if_=>|x|{if(x.has_els==0){free[[]u8](&live);return 0;}if(live.len==1&&zt_allocation_exact_terminal_transfer(x.then_body,live.data[0])==1&&zt_allocation_exact_terminal_transfer(x.els_body,live.data[0])==1){live.len=0;seen=1;}else if(live.len==0&&zt_allocation_proven_return_body(x.then_body,decls,depth)==1&&zt_allocation_proven_return_body(x.els_body,decls,depth)==1){seen=1;}else{free[[]u8](&live);return 0;}}.switch_=>|x|{if(live.len>0){free[[]u8](&live);return 0;}let ai:i32=0;while(ai<x.arms.len){if(zt_allocation_proven_return_body(x.arms.data[ai].body,decls,depth)==0){free[[]u8](&live);return 0;}ai=ai+1;}if(zt_allocation_proven_return_body(x.els_body,decls,depth)==0){free[[]u8](&live);return 0;}seen=1;}.unsafe_=>|u|{if(live.len>0||zt_allocation_proven_return_body(u.body,decls,depth)==0){free[[]u8](&live);return 0;}seen=1;}else=>{}}i=i+1;}let out:i32=(seen==1&&live.len==0) as i32;free[[]u8](&live);return out;}
fn zt_allocation_proven_helper(decls:ArrayList[*Node],name:[]u8,depth:i32)i32{if(depth>=64||zt_allocation_return_base(decls,name)==0){return 0;}let i:i32=0;while(i<decls.len){switch(decls.data[i].*){.fn_decl=>|f|{if(@strEq(f.name,name)){return zt_allocation_proven_return_body(f.body,decls,depth+1);}}else=>{}}i=i+1;}return 0;}
fn zt_allocation_proven_helper_expr(n:*Node,decls:ArrayList[*Node],depth:i32)i32{switch(n.*){.un=>|u|{if(@strEq(u.op,"try")){return zt_allocation_proven_helper_expr(u.e,decls,depth);}}.cast_=>|c|{return zt_allocation_proven_helper_expr(c.expr,decls,depth);}.call=>|c|{return zt_allocation_proven_helper(decls,zt_direct_name(c.callee),depth);}else=>{}}return 0;}
fn zt_allocation_return_contract(decls:ArrayList[*Node],name:[]u8)i32{return zt_allocation_proven_helper(decls,name,0);}
fn zt_allocation_helper_expr(n:*Node,decls:ArrayList[*Node])i32{switch(n.*){.un=>|u|{if(@strEq(u.op,"try")){return zt_allocation_helper_expr(u.e,decls);}}.cast_=>|c|{return zt_allocation_helper_expr(c.expr,decls);}.call=>|c|{return zt_allocation_return_contract(decls,zt_direct_name(c.callee));}else=>{}}return 0;}
fn zt_allocation_mint_expr(n:*Node,decls:ArrayList[*Node])i32{switch(n.*){
    .un=>|u|{if(@strEq(u.op,"try")){return zt_allocation_mint_expr(u.e,decls);}}
    .cast_=>|c|{return zt_allocation_mint_expr(c.expr,decls);}
    .call=>|c|{switch(c.callee.*){.fld=>|f|{
        if((@strEq(f.fname,"allocate")||@strEq(f.fname,"allocate_zeroed"))&&c.args.len==2){return 1;}
        if(@strEq(f.fname,"resize")&&c.args.len==3){return 1;}
        if(@strEq(f.fname,"deinit")&&c.args.len==0){return 1;}
    }else=>{}}}
    else=>{}
}return 0;}
fn zt_allocation_literal_expr(n:*Node)i32{return 0;}

fn zt_check_machine_body(body: ArrayList[*Node], env: *ArrayList[ZTBind], decls: ArrayList[*Node],
                         unsafe_scope: i32, context: []u8) i32 {
    let errors: i32 = 0;
    let i: i32 = 0;
    while (i < len[*Node](body)) {
        switch (get[*Node](body, i).*) {
            .let_ => |l| {
                if(l.has_init==1){let init:ZTExpr=zt_expr_type(l.expr,env.*,decls,context);if(init.known==1&&@strEq(init.ty,"Allocation")&&zt_allocation_mint_expr(l.expr,decls)==0&&zt_allocation_helper_expr(l.expr,decls)==0&&zt_allocation_owner_transfer_expr(l.expr,decls)==0&&zt_allocation_literal_expr(l.expr)==0){errors=errors+zt_machine_error("Allocation is affine; copy and uncontracted transfer are not allowed",context);}}
                if (l.has_dty==1 && zt_atomic_i64_forbidden_type(l.dty)==1 && zt_is_atomic_i64(l.dty)==0) {
                    errors=errors+zt_machine_error("AtomicI64 storage cannot be wrapped or addressed",context);
                }
                if (l.has_dty==1 && zt_is_atomic_i64(l.dty)==1) {
                    if(l.has_init==0){errors=errors+zt_machine_error("AtomicI64 local requires @atomicI64 initializer",context);} else {switch(l.expr.*){.call=>|c|{if(!@strEq(zt_direct_name(c.callee),"@atomicI64")||len[*Node](c.args)!=1){errors=errors+zt_machine_error("AtomicI64 local requires @atomicI64(i64)",context);}}else=>{errors=errors+zt_machine_error("AtomicI64 local requires @atomicI64(i64)",context);}}}
                    if (l.has_init==1) { switch(l.expr.*){.call=>|c|{if(len[*Node](c.args)==1){let init:ZTExpr=zt_expr_type(get[*Node](c.args,0),env.*,decls,context);if(init.known==1&&!@strEq(init.ty,"i64")&&init.literal==0){errors=errors+zt_machine_error("AtomicI64 initializer must be i64",context);}}}else=>{}} }
                }
                if (l.has_dty==0 && l.has_init==1 && zt_is_atomic_i64(zt_expr_type(l.expr,env.*,decls,context).ty)==1) {
                    errors=errors+zt_machine_error("AtomicI64 local requires an explicit AtomicI64 declaration",context);
                }
                if (l.has_init == 1) { errors = errors + zt_check_machine_expr(l.expr, env.*, decls, unsafe_scope, 0, context); }
                if (l.has_dty == 1) { push[ZTBind](env, ZTBind{ .name = l.name, .ty = l.dty }); }
            }
            .ret => |r| { if (r.has_expr == 1) { errors = errors + zt_check_machine_expr(r.expr, env.*, decls, unsafe_scope, 0, context); } }
            .assign => |a| { let assigned:ZTExpr=zt_expr_type(a.expr,env.*,decls,context);if(assigned.known==1&&@strEq(assigned.ty,"Allocation")&&zt_allocation_mint_expr(a.expr,decls)==0&&zt_allocation_helper_expr(a.expr,decls)==0&&zt_allocation_owner_transfer_expr(a.expr,decls)==0&&zt_allocation_literal_expr(a.expr)==0){errors=errors+zt_machine_error("Allocation is affine; copy and uncontracted transfer are not allowed",context);}errors = errors + zt_check_machine_expr(a.target, env.*, decls, unsafe_scope, 1, context) +
                                                    zt_check_machine_expr(a.expr, env.*, decls, unsafe_scope, 0, context); }
            .estmt => |e| { errors = errors + zt_check_machine_expr(e.expr, env.*, decls, unsafe_scope, 0, context); }
            .if_ => |x| {
                errors = errors + zt_check_machine_expr(x.cond, env.*, decls, unsafe_scope, 0, context);
                let te: ArrayList[ZTBind] = zt_env_clone(env.*);
                errors = errors + zt_check_machine_body(x.then_body, &te, decls, unsafe_scope, context);
                free[ZTBind](&te);
                if (x.has_els == 1) {
                    let ee: ArrayList[ZTBind] = zt_env_clone(env.*);
                    errors = errors + zt_check_machine_body(x.els_body, &ee, decls, unsafe_scope, context);
                    free[ZTBind](&ee);
                }
            }
            .while_ => |w| {
                errors = errors + zt_check_machine_expr(w.cond, env.*, decls, unsafe_scope, 0, context);
                let we: ArrayList[ZTBind] = zt_env_clone(env.*);
                errors = errors + zt_check_machine_body(w.body, &we, decls, unsafe_scope, context);
                free[ZTBind](&we);
            }
            .unsafe_ => |u| {
                let ue: ArrayList[ZTBind] = zt_env_clone(env.*);
                errors = errors + zt_check_machine_body(u.body, &ue, decls, 1, context);
                free[ZTBind](&ue);
            }
            .defer_ => |d| { errors = errors + zt_check_machine_expr(d.expr, env.*, decls, unsafe_scope, 0, context); }
            .estmt => |e| { errors = errors + zt_check_machine_expr(e.expr, env.*, decls, unsafe_scope, 0, context); }
            else => { }
        }
        i = i + 1;
    }
    return errors;
}

fn zt_check_machine_control(decls: ArrayList[*Node]) i32 {
    let errors: i32 = 0;
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                let env: ArrayList[ZTBind] = make[ZTBind](len[Param](f.params) + 8);
                zt_seed_globals(&env, decls);
                let pi: i32 = 0;
                while (pi < len[Param](f.params)) {
                    let p: Param = get[Param](f.params, pi);
                    push[ZTBind](&env, ZTBind{ .name = p.name, .ty = p.pty });
                    pi = pi + 1;
                }
                let fn_unsafe: i32 = zt_fn_has_annot(decls, f.name, "@unsafe");
                errors = errors + zt_check_machine_body(f.body, &env, decls, fn_unsafe,
                    _zag_str_concat("function ", f.name));
                free[ZTBind](&env);
            }
            else => { }
        }
        i = i + 1;
    }
    return errors;
}

// Edition-2027 ownership is a conservative, compiler-rooted proof.  It tracks
// named allocation origins, direct aliases, explicit ownership contracts and
// validated owned-return summaries.  It is deliberately not a claim of general
// heap provenance, dynamic bounds, or runtime use-after-free instrumentation.
struct ZTOwnAlias { name: []u8, root: []u8 }
struct ZTOwnSummary { name: []u8, returns_owned: i32, return_param: i32 }
// `return_root` records the single affine identity returned by every owned
// return in a helper.  It is used only to validate the explicit
// `@returns_owner` contract below; a plain owned return remains a fresh
// capability at the caller boundary.
struct ZTOwnReturnInfo { owned: i32, plain: i32, return_root: []u8, return_conflict: i32 }

fn zt_alias_root(aliases:ArrayList[ZTOwnAlias],name:[]u8)[]u8{let i:i32=0;while(i<aliases.len){if(@strEq(aliases.data[i].name,name)){return aliases.data[i].root;}i=i+1;}return name;}
fn zt_alias_set(aliases:*ArrayList[ZTOwnAlias],name:[]u8,root:[]u8)void{let i:i32=0;while(i<aliases.*.len){if(@strEq(aliases.*.data[i].name,name)){aliases.*.data[i].root=root;return;}i=i+1;}push[ZTOwnAlias](aliases,ZTOwnAlias{.name=name,.root=root});}
fn zt_names_clone(names:ArrayList[[]u8])ArrayList[[]u8]{let out:ArrayList[[]u8]=make[[]u8](names.len+1);let i:i32=0;while(i<names.len){push[[]u8](&out,names.data[i]);i=i+1;}return out;}
fn zt_alias_clone(aliases:ArrayList[ZTOwnAlias])ArrayList[ZTOwnAlias]{let out:ArrayList[ZTOwnAlias]=make[ZTOwnAlias](aliases.len+1);let i:i32=0;while(i<aliases.len){push[ZTOwnAlias](&out,aliases.data[i]);i=i+1;}return out;}
fn zt_names_merge(into:*ArrayList[[]u8],from:ArrayList[[]u8])void{let i:i32=0;while(i<from.len){if(zt_in_names(into.*,from.data[i])==0){push[[]u8](into,from.data[i]);}i=i+1;}}
fn zt_names_intersect(a:ArrayList[[]u8],b:ArrayList[[]u8])ArrayList[[]u8]{let out:ArrayList[[]u8]=make[[]u8](a.len+1);let i:i32=0;while(i<a.len){if(zt_in_names(b,a.data[i])==1){push[[]u8](&out,a.data[i]);}i=i+1;}return out;}
fn zt_names_remove(names:*ArrayList[[]u8],name:[]u8)void{let i:i32=0;while(i<names.*.len){if(@strEq(names.*.data[i],name)){let j:i32=i;while(j+1<names.*.len){names.*.data[j]=names.*.data[j+1];j=j+1;}names.*.len=names.*.len-1;return;}i=i+1;}}
fn zt_alias_agree(a:ArrayList[ZTOwnAlias],b:ArrayList[ZTOwnAlias])ArrayList[ZTOwnAlias]{let out:ArrayList[ZTOwnAlias]=make[ZTOwnAlias](a.len+b.len+1);let i:i32=0;while(i<a.len){let x:ZTOwnAlias=a.data[i];if(@strEq(x.root,zt_alias_root(b,x.name))){zt_alias_set(&out,x.name,x.root);}i=i+1;}i=0;while(i<b.len){let x:ZTOwnAlias=b.data[i];if(@strEq(x.root,zt_alias_root(a,x.name))){zt_alias_set(&out,x.name,x.root);}i=i+1;}return out;}
// Flow joins return fresh backing arrays. Replace a state only through these
// helpers so the superseded backing allocation cannot accumulate across
// fixed-point passes or nested control flow. Elements are borrowed AST text.
fn zt_names_replace(dst:*ArrayList[[]u8],next:ArrayList[[]u8])void{free[[]u8](dst);dst.*=next;}
fn zt_alias_replace(dst:*ArrayList[ZTOwnAlias],next:ArrayList[ZTOwnAlias])void{free[ZTOwnAlias](dst);dst.*=next;}
// A representation-only cast preserves the identity of its operand.  This is
// intentionally narrower than a general expression root: field/index/slice
// projections can denote a distinct value, and unary operators can construct
// a different value.  Only the forms below are safe to use when transferring
// a named ownership or borrow alias.
fn zt_expr_transparent_id(n:*Node)[]u8{
    switch(n.*){
        .id=>|x|{return x.name;}
        .cast_=>|x|{return zt_expr_transparent_id(x.expr);}
        // The runtime slice-pointer projection changes representation, not
        // ownership. Recognizing this exact compiler ABI lets edition-2027
        // prove `_zag_free(_zag_slice_ptr(staged))` without treating arbitrary
        // calls or field projections as transparent aliases.
        .call=>|x|{
            if(@strEq(zt_direct_name(x.callee),"_zag_slice_ptr")&&x.args.len==1){
                return zt_expr_transparent_id(x.args.data[0]);
            }
        }
        else=>{}
    }
    return "";
}

fn zt_expr_uses_name(n: *Node, name: []u8, aliases:ArrayList[ZTOwnAlias]) i32 {
    switch (n.*) {
        .id => |x| { return @strEq(zt_alias_root(aliases,x.name), name) as i32; }
        .bin => |x| { return zt_expr_uses_name(x.l,name,aliases)|zt_expr_uses_name(x.r,name,aliases); }
        .un => |x| { return zt_expr_uses_name(x.e,name,aliases); }
        .call => |x| { let hit:i32=zt_expr_uses_name(x.callee,name,aliases);let i:i32=0;while(i<x.args.len){hit=hit|zt_expr_uses_name(x.args.data[i],name,aliases);i=i+1;}return hit; }
        .idx => |x| { return zt_expr_uses_name(x.base,name,aliases)|zt_expr_uses_name(x.idx,name,aliases); }
        .fld => |x| { return zt_expr_uses_name(x.base,name,aliases); }
        .cast_ => |x| { return zt_expr_uses_name(x.expr,name,aliases); }
        .slice_ => |x| { return zt_expr_uses_name(x.base,name,aliases)|zt_expr_uses_name(x.lo,name,aliases)|zt_expr_uses_name(x.hi,name,aliases); }
        .slit_ => |x| { let i:i32=0;while(i<x.fields.len){if(zt_expr_uses_name(x.fields.data[i].val,name,aliases)==1){return 1;}i=i+1;} }
        else => { }
    }
    return 0;
}
fn zt_check_freed_expr(n:*Node,freed:ArrayList[[]u8],aliases:ArrayList[ZTOwnAlias],context:[]u8)i32{let errors:i32=0;let i:i32=0;while(i<freed.len){let name:[]u8=freed.data[i];if(zt_expr_uses_name(n,name,aliases)==1){errors=errors+zt_machine_error(_zag_str_concat("use after free of named allocation `",_zag_str_concat(name,"`")),context);}i=i+1;}return errors;}

fn zt_owner_summary_returns(sums:ArrayList[ZTOwnSummary],name:[]u8)i32{let i:i32=0;while(i<sums.len){if(@strEq(sums.data[i].name,name)){return sums.data[i].returns_owned;}i=i+1;}return 0;}
fn zt_owner_summary_return_param(sums:ArrayList[ZTOwnSummary],name:[]u8)i32{let i:i32=0;while(i<sums.len){if(@strEq(sums.data[i].name,name)){return sums.data[i].return_param;}i=i+1;}return -1;}
fn zt_owned_acquire_name(n:*Node,sums:ArrayList[ZTOwnSummary])[]u8{switch(n.*){.id=>|x|{if(zt_starts(x.name,"__clos_cap_")==1){return x.name;}}.cast_=>|c|{return zt_owned_acquire_name(c.expr,sums);}.un=>|u|{if(@strEq(u.op,"try")){return zt_owned_acquire_name(u.e,sums);}}.call=>|c|{let name:[]u8=zt_direct_name(c.callee);if(@strEq(name,"new")||@strEq(name,"_zag_malloc")||@strEq(name,"_zag_realloc")||zt_qualified_runtime_ends(name,"_zag_malloc")==1||zt_qualified_runtime_ends(name,"_zag_realloc")==1||@strEq(name,"zalloc")||@strEq(name,"zalloc_i")||@strEq(name,"@cacheAlignedAlloc")||@strEq(name,"@threadSpawn")||@strEq(name,"_zag_read_file")||@strEq(name,"_zag_strdup")||@strEq(name,"_zag_str_concat")||@strEq(name,"_zag_i64_to_str")||@strEq(name,"_zag_u64_to_str")||@strEq(name,"_zag_exec_capture")||zt_owner_summary_returns(sums,name)==1){return name;}}else=>{}}return "";}
// The older name-only owner lattice exists for raw allocation capabilities.
// A structural @resource result is instead tracked by its exact @owned fields
// in the resource pass below.  Treating the same constructor as one synthetic
// whole-value allocation duplicates authority: a retained element view then
// looks like a raw allocation escape, and an exact structural move looks like
// an unproven aggregate copy.  Keep the rich owner summary for validating
// @returns_owner itself, but exclude structural results at every legacy use.
fn zt_legacy_owned_acquire_name(n:*Node,sums:ArrayList[ZTOwnSummary],decls:ArrayList[*Node])[]u8{
    let acquired:[]u8=zt_owned_acquire_name(n,sums);
    switch(n.*){
        .call=>|x|{if(acquired.len==0){acquired=zt_explicit_owned_acquire_name(decls,zt_direct_name(x.callee),x.targs);}}
        .cast_=>|x|{if(acquired.len==0){acquired=zt_legacy_owned_acquire_name(x.expr,sums,decls);}}
        .un=>|x|{if(acquired.len==0&&@strEq(x.op,"try")){acquired=zt_legacy_owned_acquire_name(x.e,sums,decls);}}
        else=>{}
    }
    if(acquired.len==0){return "";}
    switch(n.*){
        .cast_=>|x|{return zt_legacy_owned_acquire_name(x.expr,sums,decls);}
        .un=>|x|{if(@strEq(x.op,"try")){return zt_legacy_owned_acquire_name(x.e,sums,decls);}}
        .call=>|x|{let ret:[]u8=zt_instantiated_call_ret(decls,zt_direct_name(x.callee),x.targs);if(ret.len>0&&zt_resource_type(ret,decls)==1&&zt_explicit_owned_acquire_name(decls,zt_direct_name(x.callee),x.targs).len==0){return "";}}
        else=>{}
    }
    return acquired;
}
// `_zag_realloc(owner, size)` is the one runtime operation that consumes one
// named owner and returns its replacement in a single expression.  Preserve
// the ordinary raw-pointer surface, but let the v2 ownership flow recognize
// the direct transparent first argument as an atomic transfer boundary.
fn zt_realloc_source_name(n:*Node)[]u8{switch(n.*){
    .cast_=>|c|{return zt_realloc_source_name(c.expr);}
    .un=>|u|{if(@strEq(u.op,"try")){return zt_realloc_source_name(u.e);}}
    .call=>|c|{if(@strEq(zt_direct_name(c.callee),"_zag_realloc")&&c.args.len==2){return zt_expr_transparent_id(c.args.data[0]);}}
    else=>{}
}return "";}
// A value-producing consuming call is permitted only with an explicit
// `@returns_owner` declaration and a summary proving that every owned return
// is the same consumed parameter.  This is an identity transfer, not a fresh
// allocation: the caller's input name is dead and the result receives the one
// live capability.  Unknown, indirect, and merely annotated calls stay
// fail-closed.
fn zt_return_owner_source_name(n:*Node,sums:ArrayList[ZTOwnSummary])[]u8{switch(n.*){
    .cast_=>|c|{return zt_return_owner_source_name(c.expr,sums);}
    // `try` only unwraps the declared error union. On its success path it
    // preserves the exact returned capability identity, just as it preserves
    // a borrow result elsewhere in this checker.
    .un=>|u|{if(@strEq(u.op,"try")){return zt_return_owner_source_name(u.e,sums);}}
    .call=>|c|{let pi:i32=zt_owner_summary_return_param(sums,zt_direct_name(c.callee));if(pi>=0&&pi<c.args.len){return zt_expr_transparent_id(c.args.data[pi]);}}
    else=>{}
}return "";}
fn zt_owner_transfer_source_name(n:*Node,sums:ArrayList[ZTOwnSummary])[]u8{let source:[]u8=zt_realloc_source_name(n);if(source.len>0){return source;}return zt_return_owner_source_name(n,sums);}
// Potential aggregate-field release and address-of resource consumption are
// deferred to the field-sensitive resource pass. That pass must prove an exact
// live @owned/@resource path; otherwise it restores the older named-owner
// diagnostic. Syntax alone is never authority for an unnamed terminal.
fn zt_resource_terminal_lvalue(n:*Node)i32{switch(n.*){.cast_=>|x|{return zt_resource_terminal_lvalue(x.expr);}.fld=>|_|{return 1;}.un=>|x|{if(@strEq(x.op,"&")){return 1;}return zt_resource_terminal_lvalue(x.e);}else=>{}}return 0;}
// The collection `free[T]` family is a compiler-owned generic release
// boundary. Its argument is normally written as `&local`, which has no
// transparent identifier for the legacy name lattice; the exact structural
// resource pass still handles @resource fields when a slot exists. When no
// structural slot exists (ordinary ArrayList storage), mirror the established
// named-owner terminal rule instead of rejecting a valid collection cleanup.
fn zt_compiler_generic_free(name:[]u8,targs:ArrayList[[]u8],contract:[]u8)i32{
    if(!@strEq(contract,"@consumes")||targs.len!=1){return 0;}
    if(@strEq(name,"free")){return 1;}
    if(name.len>6&&@strEq(name[name.len-6..],"__free")){return 1;}
    return 0;
}
// Exact terminal operations for edition-2027 named owners. Script payloads
// allocated by `_zag_script_alloc` are intentionally absent: their owner is the
// generated context, and only `_zag_script_context_shutdown` releases it.
fn zt_owned_release_name(name:[]u8)i32{
    return (@strEq(name,"delete")||@strEq(name,"_zag_free")||@strEq(name,"zfree")||@strEq(name,"zfree_i")||@strEq(name,"@cacheAlignedFree")||@strEq(name,"@threadJoin")||@strEq(name,"close")||
        @strEq(name,"_zag_str_free")||
        @strEq(name,"_zag_script_context_shutdown")) as i32;
}
// SystemAllocator is a receiver API: its owner is the explicit `block`
// argument, not the receiver.  Keep this recognizer deliberately narrow and
// structural so the existing affine flow can see `try allocator.deallocate(x)`
// before code generation.  The runtime still validates the exact descriptor;
// this adds the earlier source-level no-use-after-consume boundary.
fn zt_allocator_deallocate_owner(n:*Node)[]u8{switch(n.*){
    .un=>|u|{if(@strEq(u.op,"try")){return zt_allocator_deallocate_owner(u.e);}}
    .cast_=>|c|{return zt_allocator_deallocate_owner(c.expr);}
    .call=>|c|{switch(c.callee.*){.fld=>|f|{if(@strEq(f.fname,"deallocate")&&c.args.len==1){return zt_expr_transparent_id(c.args.data[0]);}}else=>{}}
    }
    else=>{}
}return "";}
// `resize` has a different surface shape (it produces the replacement), but
// successful `try allocator.resize(old, bytes, alignment)` consumes `old` just
// as surely as deallocate.  Recognize only the direct receiver form; arbitrary
// helper calls remain uncontracted until the general capability-summary pass.
fn zt_allocator_resize_owner(n:*Node)[]u8{switch(n.*){
    .un=>|u|{if(@strEq(u.op,"try")){return zt_allocator_resize_owner(u.e);}}
    .cast_=>|c|{return zt_allocator_resize_owner(c.expr);}
    .call=>|c|{switch(c.callee.*){.fld=>|f|{if(@strEq(f.fname,"resize")&&c.args.len==3){return zt_expr_transparent_id(c.args.data[0]);}}else=>{}}
    }
    else=>{}
}return "";}
// Releasing or consuming an owner has an immediate flow effect.  It therefore
// cannot be embedded in a value, condition, or another call: this first
// ownership slice has no sequencing contract for such a value-producing use.
// Reject it at the source boundary instead of letting a later leak/escape
// diagnostic misdescribe the program.
fn zt_check_embedded_terminal_call(n:*Node,decls:ArrayList[*Node],root_statement:i32,context:[]u8)i32{
    if(root_statement==0&&zt_allocator_deallocate_owner(n).len>0){return zt_machine_error("SystemAllocator.deallocate must be a standalone statement",context);}
    switch(n.*){
        .call=>|c|{
            let errors:i32=0;let name:[]u8=zt_direct_name(c.callee);
            if(root_statement==0&&(zt_owned_release_name(name)==1||(zt_fn_has_consumes_contract(decls,name)==1&&zt_fn_has_annot(decls,name,"@returns_owner")==0))){
                errors=errors+zt_machine_error("release or @consumes call must be a standalone statement",context);
            }
            errors=errors+zt_check_embedded_terminal_call(c.callee,decls,0,context);
            let i:i32=0;while(i<c.args.len){errors=errors+zt_check_embedded_terminal_call(c.args.data[i],decls,0,context);i=i+1;}
            return errors;
        }
        .bin=>|x|{return zt_check_embedded_terminal_call(x.l,decls,0,context)+zt_check_embedded_terminal_call(x.r,decls,0,context);}
        .un=>|x|{return zt_check_embedded_terminal_call(x.e,decls,0,context);}
        .idx=>|x|{return zt_check_embedded_terminal_call(x.base,decls,0,context)+zt_check_embedded_terminal_call(x.idx,decls,0,context);}
        .fld=>|x|{return zt_check_embedded_terminal_call(x.base,decls,0,context);}
        .cast_=>|x|{return zt_check_embedded_terminal_call(x.expr,decls,0,context);}
        .slice_=>|x|{return zt_check_embedded_terminal_call(x.base,decls,0,context)+zt_check_embedded_terminal_call(x.lo,decls,0,context)+zt_check_embedded_terminal_call(x.hi,decls,0,context);}
        .slit_=>|x|{let errors:i32=0;let i:i32=0;while(i<x.fields.len){errors=errors+zt_check_embedded_terminal_call(x.fields.data[i].val,decls,0,context);i=i+1;}return errors;}
        else=>{}
    }return 0;
}
// These compiler-reserved output bridges synchronously consume their byte
// arguments and never retain a pointer.  Treating them as an unknown external
// call would reject generated Script diagnostics and ordinary output after an
// owned helper result is formed.  Keep this deliberately narrow: user calls
// and every other `_zag_*` bridge remain uncontracted unless they declare a
// normal ownership/borrow annotation.
fn zt_compiler_nonretaining_call(name:[]u8)i32{
    return (@strEq(name,"@strEq")||@strEq(name,"_zag_strcmp")||@strEq(name,"_zag_strcmp_ord")||
        @strEq(name,"_zag_strlen")||@strEq(name,"_zag_str_to_i64")||
        @strEq(name,"_zag_print")||@strEq(name,"_zag_println")||@strEq(name,"_zag_eprintln")||
        @strEq(name,"_zag_write_stdout")||@strEq(name,"_zag_write_stderr")||
        // The compiler-owned bounded descriptor reader completes one read
        // synchronously and retains no caller pointer. Its pointer argument
        // is still declared @borrows_mut in std:rt, so this exemption only
        // suppresses the unknown-call escape path after that typed boundary.
        @strEq(name,"_zag_read_fd")||
        // Public Allocation byte access is a synchronous compiler-owned
        // operation. It validates and touches the allocation but never stores
        // the affine handle or returns a borrow derived from it.
        @strEq(name,"allocation_read_u8")||@strEq(name,"allocation_write_u8")||
        // The bounded SIMD intrinsic completes synchronously and retains none
        // of its three raw-pointer arguments.  Its separate typed/unsafe and
        // checked-access rules remain in force; this only prevents the
        // ownership flow from mistaking a compiler intrinsic for an unknown
        // escaping foreign call.
        @strEq(name,"@simdAddI32x4")||@strEq(name,"@simdSubI32x4")||
        @strEq(name,"@simdAndI32x4")||@strEq(name,"@simdOrI32x4")||
        @strEq(name,"@simdXorI32x4")||
        // @vsaFromWords validates one exact []i64/[]u64 input above, copies
        // every imported word into the returned inline VSA value, and retains
        // no address. Other @-builtins remain fail-closed unless separately
        // proven synchronous by their typed lowering contract.
        @strEq(name,"@vsaFromWords")||
        // Atomic and futex intrinsics synchronously access the supplied word
        // and never retain its address.  They are compiler-owned operations;
        // the typed machine pass still enforces unsafe scope, pointer shape,
        // alignment, and memory-order rules before this ownership exemption.
        @strEq(name,"@atomicLoad64Order")||@strEq(name,"@atomicStore64Order")||
        @strEq(name,"@atomicFetchAdd64Order")||@strEq(name,"@atomicFetchSub64Order")||
        @strEq(name,"@atomicWake32")||@strEq(name,"@atomicWait32")||
        // SystemAllocator registers a bounded compiler-owned provenance record
        // synchronously; allocationCreate consumes that raw allocation into an
        // opaque Allocation capability rather than exposing it through an
        // uncontracted foreign call.
        @strEq(name,"_zag_allocation_register")||@strEq(name,"@allocationCreate")||
        @strEq(name,"@allocationValidate")||@strEq(name,"@allocationFree")||
        @strEq(name,"@allocationLen")||@strEq(name,"@allocationAllocatorId")||
        @strEq(name,"@allocationReadU8")||@strEq(name,"@allocationWriteU8")||
        @strEq(name,"@allocationRegionInit")||@strEq(name,"@allocationRegionDeinit")) as i32;
}
fn zt_owned_expr_root(n:*Node,owned:ArrayList[[]u8],aliases:ArrayList[ZTOwnAlias])[]u8{switch(n.*){.id=>|x|{let root:[]u8=zt_alias_root(aliases,x.name);if(zt_in_names(owned,root)==1){return root;}}.cast_=>|x|{return zt_owned_expr_root(x.expr,owned,aliases);}.fld=>|x|{return zt_owned_expr_root(x.base,owned,aliases);}.idx=>|x|{return zt_owned_expr_root(x.base,owned,aliases);}.slice_=>|x|{return zt_owned_expr_root(x.base,owned,aliases);}.un=>|x|{return zt_owned_expr_root(x.e,owned,aliases);}.call=>|x|{if(@strEq(zt_direct_name(x.callee),"_zag_slice_ptr")&&x.args.len==1){return zt_owned_expr_root(x.args.data[0],owned,aliases);}}.slit_=>|x|{let root:[]u8="";let i:i32=0;while(i<x.fields.len){let field_root:[]u8=zt_owned_expr_root(x.fields.data[i].val,owned,aliases);if(field_root.len>0){if(root.len>0&&@strEq(root,field_root)==0){return "";}root=field_root;}i=i+1;}return root;}else=>{}}return "";}

fn zt_return_info_body(body:ArrayList[*Node],must:*ArrayList[[]u8],may:*ArrayList[[]u8],aliases:*ArrayList[ZTOwnAlias],sums:ArrayList[ZTOwnSummary],info:*ZTOwnReturnInfo)void{
    let i:i32=0;while(i<body.len){switch(body.data[i].*){
        .let_=>|l|{if(l.has_init==1){if(zt_owned_acquire_name(l.expr,sums).len>0){let source:[]u8=zt_owner_transfer_source_name(l.expr,sums);if(source.len>0){let root:[]u8=zt_alias_root(aliases.*,source);zt_names_remove(must,root);zt_names_remove(may,root);}if(zt_in_names(must.*,l.name)==0){push[[]u8](must,l.name);}if(zt_in_names(may.*,l.name)==0){push[[]u8](may,l.name);}zt_alias_set(aliases,l.name,l.name);}else{let source:[]u8=zt_expr_transparent_id(l.expr);if(source.len>0){zt_alias_set(aliases,l.name,zt_alias_root(aliases.*,source));}}}}
        .assign=>|a|{let target:[]u8=zt_expr_transparent_id(a.target);if(target.len>0){if(zt_owned_acquire_name(a.expr,sums).len>0){let source:[]u8=zt_owner_transfer_source_name(a.expr,sums);if(source.len>0){let root:[]u8=zt_alias_root(aliases.*,source);zt_names_remove(must,root);zt_names_remove(may,root);}if(zt_in_names(must.*,target)==0){push[[]u8](must,target);}if(zt_in_names(may.*,target)==0){push[[]u8](may,target);}zt_alias_set(aliases,target,target);}else{let source:[]u8=zt_expr_transparent_id(a.expr);if(source.len>0){zt_alias_set(aliases,target,zt_alias_root(aliases.*,source));}}}}
        .ret=>|r|{if(r.has_expr==0){info.*.plain=1;}else{let root:[]u8=zt_owned_expr_root(r.expr,must.*,aliases.*);if(zt_owned_acquire_name(r.expr,sums).len>0||root.len>0){info.*.owned=1;if(root.len==0){info.*.return_conflict=1;}else if(info.*.return_root.len==0){info.*.return_root=root;}else if(@strEq(info.*.return_root,root)==0){info.*.return_conflict=1;}}else if(zt_owned_expr_root(r.expr,may.*,aliases.*).len>0){info.*.owned=1;info.*.plain=1;info.*.return_conflict=1;}else{info.*.plain=1;}}}
        .unsafe_=>|u|{zt_return_info_body(u.body,must,may,aliases,sums,info);}
        .if_=>|x|{
            let tm:ArrayList[[]u8]=zt_names_clone(must.*);let ty:ArrayList[[]u8]=zt_names_clone(may.*);let ta:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);
            zt_return_info_body(x.then_body,&tm,&ty,&ta,sums,info);
            let em:ArrayList[[]u8]=zt_names_clone(must.*);let ey:ArrayList[[]u8]=zt_names_clone(may.*);let ea:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);
            zt_return_info_body(x.els_body,&em,&ey,&ea,sums,info);
            let next_must:ArrayList[[]u8]=zt_names_intersect(tm,em);
            let next_may:ArrayList[[]u8]=zt_names_clone(ty);zt_names_merge(&next_may,ey);
            let next_aliases:ArrayList[ZTOwnAlias]=zt_alias_agree(ta,ea);
            free[[]u8](&tm);free[[]u8](&ty);free[ZTOwnAlias](&ta);
            free[[]u8](&em);free[[]u8](&ey);free[ZTOwnAlias](&ea);
            zt_names_replace(must,next_must);zt_names_replace(may,next_may);zt_alias_replace(aliases,next_aliases);
        }
        .while_=>|x|{
            let bm:ArrayList[[]u8]=zt_names_clone(must.*);let by:ArrayList[[]u8]=zt_names_clone(may.*);let ba:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);
            let wm:ArrayList[[]u8]=zt_names_clone(bm);let wy:ArrayList[[]u8]=zt_names_clone(by);let wa:ArrayList[ZTOwnAlias]=zt_alias_clone(ba);
            zt_return_info_body(x.body,&wm,&wy,&wa,sums,info);
            let next_must:ArrayList[[]u8]=zt_names_intersect(bm,wm);
            let next_may:ArrayList[[]u8]=zt_names_clone(by);zt_names_merge(&next_may,wy);
            let next_aliases:ArrayList[ZTOwnAlias]=zt_alias_agree(ba,wa);
            free[[]u8](&bm);free[[]u8](&by);free[ZTOwnAlias](&ba);
            free[[]u8](&wm);free[[]u8](&wy);free[ZTOwnAlias](&wa);
            zt_names_replace(must,next_must);zt_names_replace(may,next_may);zt_alias_replace(aliases,next_aliases);
        }
        .switch_=>|x|{
            let bm:ArrayList[[]u8]=zt_names_clone(must.*);let by:ArrayList[[]u8]=zt_names_clone(may.*);let ba:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);
            let jm:ArrayList[[]u8]=make[[]u8](bm.len+2);let jy:ArrayList[[]u8]=make[[]u8](by.len+2);let ja:ArrayList[ZTOwnAlias]=zt_alias_clone(ba);
            let have:i32=0;let ai:i32=0;
            while(ai<x.arms.len){
                let am:ArrayList[[]u8]=zt_names_clone(bm);let ay:ArrayList[[]u8]=zt_names_clone(by);let aa:ArrayList[ZTOwnAlias]=zt_alias_clone(ba);
                zt_return_info_body(x.arms.data[ai].body,&am,&ay,&aa,sums,info);
                if(have==0){
                    free[[]u8](&jm);jm=am;free[[]u8](&jy);jy=ay;free[ZTOwnAlias](&ja);ja=aa;have=1;
                }else{
                    let next_must:ArrayList[[]u8]=zt_names_intersect(jm,am);free[[]u8](&jm);free[[]u8](&am);jm=next_must;
                    zt_names_merge(&jy,ay);free[[]u8](&ay);
                    let next_aliases:ArrayList[ZTOwnAlias]=zt_alias_agree(ja,aa);free[ZTOwnAlias](&ja);free[ZTOwnAlias](&aa);ja=next_aliases;
                }
                ai=ai+1;
            }
            let em:ArrayList[[]u8]=zt_names_clone(bm);let ey:ArrayList[[]u8]=zt_names_clone(by);let ea:ArrayList[ZTOwnAlias]=zt_alias_clone(ba);
            zt_return_info_body(x.els_body,&em,&ey,&ea,sums,info);
            if(have==0){
                free[[]u8](&jm);jm=em;free[[]u8](&jy);jy=ey;free[ZTOwnAlias](&ja);ja=ea;
            }else{
                let next_must:ArrayList[[]u8]=zt_names_intersect(jm,em);free[[]u8](&jm);free[[]u8](&em);jm=next_must;
                zt_names_merge(&jy,ey);free[[]u8](&ey);
                let next_aliases:ArrayList[ZTOwnAlias]=zt_alias_agree(ja,ea);free[ZTOwnAlias](&ja);free[ZTOwnAlias](&ea);ja=next_aliases;
            }
            free[[]u8](&bm);free[[]u8](&by);free[ZTOwnAlias](&ba);
            zt_names_replace(must,jm);zt_names_replace(may,jy);zt_alias_replace(aliases,ja);
        }
        else=>{}
    }i=i+1;}
}
fn zt_fn_return_info(f:FnDecl,decls:ArrayList[*Node],sums:ArrayList[ZTOwnSummary])ZTOwnReturnInfo{
    let info:ZTOwnReturnInfo=ZTOwnReturnInfo{.owned=0,.plain=0,.return_root="",.return_conflict=0};
    let must:ArrayList[[]u8]=make[[]u8](4);let may:ArrayList[[]u8]=make[[]u8](4);let aliases:ArrayList[ZTOwnAlias]=make[ZTOwnAlias](4);
    if(zt_fn_has_consumes_contract(decls,f.name)==1){let pi:i32=0;while(pi<f.params.len){let p:Param=f.params.data[pi];if(zt_consumes_param(decls,f.name,pi)==1){push[[]u8](&must,p.name);push[[]u8](&may,p.name);zt_alias_set(&aliases,p.name,p.name);}pi=pi+1;}}
    zt_return_info_body(f.body,&must,&may,&aliases,sums,&info);
    free[[]u8](&must);free[[]u8](&may);free[ZTOwnAlias](&aliases);
    return info;
}
fn zt_build_owner_summaries(decls:ArrayList[*Node])ArrayList[ZTOwnSummary]{let sums:ArrayList[ZTOwnSummary]=make[ZTOwnSummary](decls.len+1);let i:i32=0;while(i<decls.len){switch(decls.data[i].*){.fn_decl=>|f|{if(f.is_extern==0){push[ZTOwnSummary](&sums,ZTOwnSummary{.name=f.name,.returns_owned=0,.return_param=-1});}}else=>{}}i=i+1;}let pass:i32=0;while(pass<=sums.len){i=0;while(i<decls.len){switch(decls.data[i].*){.fn_decl=>|f|{if(f.is_extern==0){let info:ZTOwnReturnInfo=zt_fn_return_info(f,decls,sums);let explicit:[]u8=zt_fn_acquires_release(f);let explicit_owned:i32=(explicit.len>0&&!@strEq(explicit,"@conflict")&&zt_resource_capability_type(f.ret,decls)==1) as i32;let si:i32=0;while(si<sums.len){if(@strEq(sums.data[si].name,f.name)){if((info.owned==1&&info.plain==0)||explicit_owned==1){sums.data[si].returns_owned=1;}if(zt_fn_has_annot(decls,f.name,"@returns_owner")==1&&info.owned==1&&info.plain==0&&info.return_conflict==0&&info.return_root.len>0){let pi:i32=0;while(pi<f.params.len){if(@strEq(f.params.data[pi].name,info.return_root)&&zt_consumes_param(decls,f.name,pi)==1){sums.data[si].return_param=pi;}pi=pi+1;}}}si=si+1;}}}else=>{}}i=i+1;}pass=pass+1;}return sums;}
fn zt_compiler_owned_mixed_return_exception(f:FnDecl)i32{
    // std:process uses one private selector to choose ScriptContext-owned
    // storage or ordinary native storage. The selector never exposes that
    // pointer as a public result; its exact compiler-owned origin and private
    // name are checked here, while ordinary user helpers remain fail-closed.
    return (f.is_pub==0&&@strEq(f.name,"process_alloc")&&
        (zt_driver_ends(f.origin,"std/process.zag")==1||
         zt_driver_ends(f.origin,"std\\process.zag")==1)) as i32;
}
fn zt_check_owner_summary_errors(decls:ArrayList[*Node],sums:ArrayList[ZTOwnSummary])i32{let errors:i32=0;let i:i32=0;while(i<decls.len){switch(decls.data[i].*){.fn_decl=>|f|{if(f.is_extern==0){let info:ZTOwnReturnInfo=zt_fn_return_info(f,decls,sums);if(info.owned==1&&info.plain==1&&zt_compiler_owned_mixed_return_exception(f)==0){errors=errors+zt_machine_error(_zag_str_concat("function `",_zag_str_concat(f.name,"` mixes owned and non-owned return provenance")),_zag_str_concat("function ",f.name));}if(zt_fn_has_annot(decls,f.name,"@returns_owner")==1&&zt_owner_summary_return_param(sums,f.name)<0){errors=errors+zt_machine_error("@returns_owner requires every owned return to be the same @consumes owner parameter",_zag_str_concat("function ",f.name));}}}else=>{}}i=i+1;}return errors;}

fn zt_collect_owned_body(body:ArrayList[*Node],owned:*ArrayList[[]u8],returned:*ArrayList[[]u8],aliases:*ArrayList[ZTOwnAlias],decls:ArrayList[*Node],sums:ArrayList[ZTOwnSummary])void{let i:i32=0;while(i<body.len){switch(body.data[i].*){
    .let_=>|l|{if(l.has_init==1){if(zt_legacy_owned_acquire_name(l.expr,sums,decls).len>0){let source:[]u8=zt_owner_transfer_source_name(l.expr,sums);if(source.len>0){zt_names_remove(owned,zt_alias_root(aliases.*,source));}if(zt_in_names(owned.*,l.name)==0){push[[]u8](owned,l.name);}zt_alias_set(aliases,l.name,l.name);}else{let source:[]u8=zt_expr_transparent_id(l.expr);if(source.len>0){zt_alias_set(aliases,l.name,zt_alias_root(aliases.*,source));}}}}
    .assign=>|a|{let target:[]u8=zt_expr_transparent_id(a.target);let source:[]u8=zt_expr_transparent_id(a.expr);let acquired:[]u8=zt_legacy_owned_acquire_name(a.expr,sums,decls);if(target.len>0){if(acquired.len>0){let transfer_source:[]u8=zt_owner_transfer_source_name(a.expr,sums);if(transfer_source.len>0){zt_names_remove(owned,zt_alias_root(aliases.*,transfer_source));}if(zt_in_names(owned.*,target)==0){push[[]u8](owned,target);}zt_alias_set(aliases,target,target);}else if(source.len>0){zt_alias_set(aliases,target,zt_alias_root(aliases.*,source));}else{zt_alias_set(aliases,target,"");}}}
    .ret=>|r|{if(r.has_expr==1){let root:[]u8=zt_owned_expr_root(r.expr,owned.*,aliases.*);if(root.len>0&&zt_in_names(returned.*,root)==0){push[[]u8](returned,root);}}}
    .if_=>|x|{let ta:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);zt_collect_owned_body(x.then_body,owned,returned,&ta,decls,sums);let ea:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);zt_collect_owned_body(x.els_body,owned,returned,&ea,decls,sums);free[ZTOwnAlias](&ta);free[ZTOwnAlias](&ea);}
    .while_=>|x|{let wa:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);zt_collect_owned_body(x.body,owned,returned,&wa,decls,sums);free[ZTOwnAlias](&wa);}
    .unsafe_=>|x|{zt_collect_owned_body(x.body,owned,returned,aliases,decls,sums);}
    .switch_=>|x|{let ai:i32=0;while(ai<x.arms.len){let aa:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);zt_collect_owned_body(x.arms.data[ai].body,owned,returned,&aa,decls,sums);free[ZTOwnAlias](&aa);ai=ai+1;}let ea:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);zt_collect_owned_body(x.els_body,owned,returned,&ea,decls,sums);free[ZTOwnAlias](&ea);}
    else=>{}
}i=i+1;}}

fn zt_check_direct_free_body(body:ArrayList[*Node],freed:*ArrayList[[]u8],aliases:*ArrayList[ZTOwnAlias],decls:ArrayList[*Node],sums:ArrayList[ZTOwnSummary],context:[]u8)i32{
    let errors:i32=0;let i:i32=0;
    while(i<body.len){switch(body.data[i].*){
        .let_=>|l|{if(l.has_init==1){errors=errors+zt_check_embedded_terminal_call(l.expr,decls,0,context)+zt_check_freed_expr(l.expr,freed.*,aliases.*,context);let legacy:[]u8=zt_legacy_owned_acquire_name(l.expr,sums,decls);if(legacy.len>0){zt_alias_set(aliases,l.name,l.name);}else{let source:[]u8=zt_expr_transparent_id(l.expr);if(source.len>0){zt_alias_set(aliases,l.name,zt_alias_root(aliases.*,source));}}let transferred:[]u8="";if(legacy.len>0){transferred=zt_return_owner_source_name(l.expr,sums);}if(transferred.len>0){let root:[]u8=zt_alias_root(aliases.*,transferred);if(zt_in_names(freed.*,root)==0){push[[]u8](freed,root);}}}}
        .ret=>|r|{if(r.has_expr==1){errors=errors+zt_check_embedded_terminal_call(r.expr,decls,0,context)+zt_check_freed_expr(r.expr,freed.*,aliases.*,context);}}
        .assign=>|a|{errors=errors+zt_check_embedded_terminal_call(a.target,decls,0,context)+zt_check_embedded_terminal_call(a.expr,decls,0,context)+zt_check_freed_expr(a.target,freed.*,aliases.*,context)+zt_check_freed_expr(a.expr,freed.*,aliases.*,context);let legacy:[]u8=zt_legacy_owned_acquire_name(a.expr,sums,decls);let transferred:[]u8="";if(legacy.len>0){transferred=zt_return_owner_source_name(a.expr,sums);}let transferred_root:[]u8=zt_alias_root(aliases.*,transferred);let target:[]u8=zt_expr_transparent_id(a.target);let source:[]u8=zt_expr_transparent_id(a.expr);if(target.len>0){if(legacy.len>0){zt_alias_set(aliases,target,target);}else if(source.len>0){zt_alias_set(aliases,target,zt_alias_root(aliases.*,source));}else{zt_alias_set(aliases,target,"");}}if(transferred.len>0&&zt_in_names(freed.*,transferred_root)==0){push[[]u8](freed,transferred_root);}}
        .estmt=>|e|{let allocator_owner:[]u8=zt_allocator_deallocate_owner(e.expr);if(allocator_owner.len>0){let root:[]u8=zt_alias_root(aliases.*,allocator_owner);if(zt_in_names(freed.*,root)==1){errors=errors+zt_machine_error("use after consumed SystemAllocator handle",context);}else{push[[]u8](freed,root);}}else{switch(e.expr.*){.call=>|c|{let name:[]u8=zt_direct_name(c.callee);if(zt_owned_release_name(name)==1&&c.args.len==1){let owner:[]u8=zt_expr_transparent_id(c.args.data[0]);if(owner.len==0){if(zt_resource_terminal_lvalue(c.args.data[0])==0){errors=errors+zt_machine_error("release requires a named owner argument",context);}}else{let root:[]u8=zt_alias_root(aliases.*,owner);if(zt_in_names(freed.*,root)==1){errors=errors+zt_machine_error("double free of named allocation",context);}else{push[[]u8](freed,root);}}}else if(zt_fn_has_consumes_contract(decls,name)==1){let ai:i32=0;while(ai<c.args.len){if(zt_direct_consumes_param(decls,name,ai)==1){let owner:[]u8=zt_expr_transparent_id(c.args.data[ai]);if(owner.len==0){if(zt_resource_terminal_lvalue(c.args.data[ai])==0){errors=errors+zt_machine_error("@consumes requires named owner arguments",context);}}else{let root:[]u8=zt_alias_root(aliases.*,owner);if(zt_in_names(freed.*,root)==1){errors=errors+zt_machine_error("consumes an already released owner",context);}else{push[[]u8](freed,root);}}}ai=ai+1;}}else{errors=errors+zt_check_embedded_terminal_call(e.expr,decls,1,context)+zt_check_freed_expr(e.expr,freed.*,aliases.*,context);}}else=>{errors=errors+zt_check_embedded_terminal_call(e.expr,decls,1,context)+zt_check_freed_expr(e.expr,freed.*,aliases.*,context);}}}}
        .unsafe_=>|u|{errors=errors+zt_check_direct_free_body(u.body,freed,aliases,decls,sums,context);}
        .defer_=>|d|{let allocator_owner:[]u8=zt_allocator_deallocate_owner(d.expr);if(allocator_owner.len>0){let root:[]u8=zt_alias_root(aliases.*,allocator_owner);if(zt_in_names(freed.*,root)==1){errors=errors+zt_machine_error("use after consumed SystemAllocator handle",context);}else{push[[]u8](freed,root);}}else{switch(d.expr.*){.call=>|c|{let name:[]u8=zt_direct_name(c.callee);if(zt_owned_release_name(name)==1&&c.args.len==1){let owner:[]u8=zt_expr_transparent_id(c.args.data[0]);if(owner.len==0){if(zt_resource_terminal_lvalue(c.args.data[0])==0){errors=errors+zt_machine_error("release requires a named owner argument",context);}}else{let root:[]u8=zt_alias_root(aliases.*,owner);if(zt_in_names(freed.*,root)==1){errors=errors+zt_machine_error("deferred double free of named allocation",context);}else{push[[]u8](freed,root);}}}else if(zt_fn_has_consumes_contract(decls,name)==1){let ai:i32=0;while(ai<c.args.len){if(zt_direct_consumes_param(decls,name,ai)==1){let owner:[]u8=zt_expr_transparent_id(c.args.data[ai]);if(owner.len==0){if(zt_resource_terminal_lvalue(c.args.data[ai])==0){errors=errors+zt_machine_error("@consumes requires named owner arguments",context);}}else{let root:[]u8=zt_alias_root(aliases.*,owner);if(zt_in_names(freed.*,root)==1){errors=errors+zt_machine_error("deferred consumes an already released owner",context);}else{push[[]u8](freed,root);}}}ai=ai+1;}}else{errors=errors+zt_check_embedded_terminal_call(d.expr,decls,1,context)+zt_check_freed_expr(d.expr,freed.*,aliases.*,context);}}else=>{errors=errors+zt_check_embedded_terminal_call(d.expr,decls,1,context)+zt_check_freed_expr(d.expr,freed.*,aliases.*,context);}}}}
        .if_=>|x|{
            errors=errors+zt_check_embedded_terminal_call(x.cond,decls,0,context)+zt_check_freed_expr(x.cond,freed.*,aliases.*,context);
            let base:ArrayList[[]u8]=zt_names_clone(freed.*);let basea:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);
            let tf:ArrayList[[]u8]=zt_names_clone(base);let ta:ArrayList[ZTOwnAlias]=zt_alias_clone(basea);
            errors=errors+zt_check_direct_free_body(x.then_body,&tf,&ta,decls,sums,context);
            let ef:ArrayList[[]u8]=zt_names_clone(base);let ea:ArrayList[ZTOwnAlias]=zt_alias_clone(basea);
            if(x.has_els==1){errors=errors+zt_check_direct_free_body(x.els_body,&ef,&ea,decls,sums,context);}
            let next_aliases:ArrayList[ZTOwnAlias]=zt_alias_agree(ta,ea);
            zt_names_merge(freed,tf);zt_names_merge(freed,ef);
            free[[]u8](&base);free[ZTOwnAlias](&basea);free[[]u8](&tf);free[ZTOwnAlias](&ta);free[[]u8](&ef);free[ZTOwnAlias](&ea);
            zt_alias_replace(aliases,next_aliases);
        }
        .while_=>|x|{
            errors=errors+zt_check_embedded_terminal_call(x.cond,decls,0,context)+zt_check_freed_expr(x.cond,freed.*,aliases.*,context);
            let basea:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);
            let wf:ArrayList[[]u8]=zt_names_clone(freed.*);let wa:ArrayList[ZTOwnAlias]=zt_alias_clone(basea);
            errors=errors+zt_check_direct_free_body(x.body,&wf,&wa,decls,sums,context);
            let next_aliases:ArrayList[ZTOwnAlias]=zt_alias_agree(basea,wa);
            zt_names_merge(freed,wf);
            free[ZTOwnAlias](&basea);free[[]u8](&wf);free[ZTOwnAlias](&wa);
            zt_alias_replace(aliases,next_aliases);
        }
        .switch_=>|x|{
            errors=errors+zt_check_embedded_terminal_call(x.subject,decls,0,context)+zt_check_freed_expr(x.subject,freed.*,aliases.*,context);
            let base:ArrayList[[]u8]=zt_names_clone(freed.*);let basea:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);
            let joined:ArrayList[[]u8]=zt_names_clone(base);let joined_alias:ArrayList[ZTOwnAlias]=zt_alias_clone(basea);
            let have:i32=0;let ai:i32=0;
            while(ai<x.arms.len){
                let af:ArrayList[[]u8]=zt_names_clone(base);let aa:ArrayList[ZTOwnAlias]=zt_alias_clone(basea);
                errors=errors+zt_check_direct_free_body(x.arms.data[ai].body,&af,&aa,decls,sums,context);
                zt_names_merge(&joined,af);free[[]u8](&af);
                if(have==0){free[ZTOwnAlias](&joined_alias);joined_alias=aa;have=1;}
                else{let next_aliases:ArrayList[ZTOwnAlias]=zt_alias_agree(joined_alias,aa);free[ZTOwnAlias](&joined_alias);free[ZTOwnAlias](&aa);joined_alias=next_aliases;}
                ai=ai+1;
            }
            let ef:ArrayList[[]u8]=zt_names_clone(base);let ea:ArrayList[ZTOwnAlias]=zt_alias_clone(basea);
            errors=errors+zt_check_direct_free_body(x.els_body,&ef,&ea,decls,sums,context);
            zt_names_merge(&joined,ef);free[[]u8](&ef);
            if(have==0){free[ZTOwnAlias](&joined_alias);joined_alias=ea;}
            else{let next_aliases:ArrayList[ZTOwnAlias]=zt_alias_agree(joined_alias,ea);free[ZTOwnAlias](&joined_alias);free[ZTOwnAlias](&ea);joined_alias=next_aliases;}
            zt_names_merge(freed,joined);
            free[[]u8](&base);free[ZTOwnAlias](&basea);free[[]u8](&joined);
            zt_alias_replace(aliases,joined_alias);
        }
        else=>{}
    }i=i+1;}return errors;
}

// Per-owner terminal lattice: 0 live, 1 discharged on every path, 2 differs.
fn zt_owner_terminal_state(body:ArrayList[*Node],root:[]u8,aliases:*ArrayList[ZTOwnAlias],decls:ArrayList[*Node],sums:ArrayList[ZTOwnSummary],state:i32)i32{
    let out:i32=state;let i:i32=0;
    while(i<body.len){switch(body.data[i].*){
        .let_=>|l|{if(l.has_init==1){if(zt_legacy_owned_acquire_name(l.expr,sums,decls).len>0){let source:[]u8=zt_owner_transfer_source_name(l.expr,sums);if(source.len>0&&@strEq(zt_alias_root(aliases.*,source),root)){out=1;}zt_alias_set(aliases,l.name,l.name);}else{let source:[]u8=zt_expr_transparent_id(l.expr);if(source.len>0){zt_alias_set(aliases,l.name,zt_alias_root(aliases.*,source));}}}}
        .assign=>|a|{let target:[]u8=zt_expr_transparent_id(a.target);let source:[]u8=zt_expr_transparent_id(a.expr);if(target.len>0){if(zt_legacy_owned_acquire_name(a.expr,sums,decls).len>0){let transfer_source:[]u8=zt_owner_transfer_source_name(a.expr,sums);if(transfer_source.len>0&&@strEq(zt_alias_root(aliases.*,transfer_source),root)&&@strEq(target,root)==0){out=1;}zt_alias_set(aliases,target,target);}else if(source.len>0){zt_alias_set(aliases,target,zt_alias_root(aliases.*,source));}else{zt_alias_set(aliases,target,"");}}}
        .ret=>|r|{if(r.has_expr==1&&zt_expr_uses_name(r.expr,root,aliases.*)==1){out=1;}}
        .estmt=>|e|{let allocator_owner:[]u8=zt_allocator_deallocate_owner(e.expr);if(allocator_owner.len>0&&@strEq(zt_alias_root(aliases.*,allocator_owner),root)){out=1;}else{switch(e.expr.*){.call=>|c|{let name:[]u8=zt_direct_name(c.callee);if(zt_owned_release_name(name)==1&&c.args.len==1&&zt_expr_uses_name(c.args.data[0],root,aliases.*)==1){out=1;}else if(zt_fn_has_consumes_contract(decls,name)==1){let ai:i32=0;while(ai<c.args.len){if(zt_consumes_param(decls,name,ai)==1&&zt_expr_uses_name(c.args.data[ai],root,aliases.*)==1){out=1;}ai=ai+1;}}}else=>{}}}}
        .unsafe_=>|u|{out=zt_owner_terminal_state(u.body,root,aliases,decls,sums,out);}
        .defer_=>|d|{let allocator_owner:[]u8=zt_allocator_deallocate_owner(d.expr);if(allocator_owner.len>0&&@strEq(zt_alias_root(aliases.*,allocator_owner),root)){out=1;}else{switch(d.expr.*){.call=>|c|{let name:[]u8=zt_direct_name(c.callee);if(zt_owned_release_name(name)==1&&c.args.len==1&&zt_expr_uses_name(c.args.data[0],root,aliases.*)==1){out=1;}else if(zt_fn_has_consumes_contract(decls,name)==1){let ai:i32=0;while(ai<c.args.len){if(zt_consumes_param(decls,name,ai)==1&&zt_expr_uses_name(c.args.data[ai],root,aliases.*)==1){out=1;}ai=ai+1;}}}else=>{}}}}
        .if_=>|x|{
            let basea:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);
            let ta:ArrayList[ZTOwnAlias]=zt_alias_clone(basea);let ts:i32=zt_owner_terminal_state(x.then_body,root,&ta,decls,sums,out);
            let ea:ArrayList[ZTOwnAlias]=zt_alias_clone(basea);let es:i32=out;if(x.has_els==1){es=zt_owner_terminal_state(x.els_body,root,&ea,decls,sums,out);}
            let next_aliases:ArrayList[ZTOwnAlias]=zt_alias_agree(ta,ea);
            free[ZTOwnAlias](&basea);free[ZTOwnAlias](&ta);free[ZTOwnAlias](&ea);
            zt_alias_replace(aliases,next_aliases);
            if(ts==es){out=ts;}else{out=2;}
        }
        .while_=>|x|{
            let basea:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);let wa:ArrayList[ZTOwnAlias]=zt_alias_clone(basea);
            let ws:i32=zt_owner_terminal_state(x.body,root,&wa,decls,sums,out);
            let next_aliases:ArrayList[ZTOwnAlias]=zt_alias_agree(basea,wa);
            free[ZTOwnAlias](&basea);free[ZTOwnAlias](&wa);zt_alias_replace(aliases,next_aliases);
            if(ws!=out){out=2;}
        }
        .switch_=>|x|{
            let basea:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);let joined:i32=-1;
            let joined_alias:ArrayList[ZTOwnAlias]=zt_alias_clone(basea);let have:i32=0;let ai:i32=0;
            while(ai<x.arms.len){
                let aa:ArrayList[ZTOwnAlias]=zt_alias_clone(basea);
                let arm:i32=zt_owner_terminal_state(x.arms.data[ai].body,root,&aa,decls,sums,out);
                if(joined<0){joined=arm;}else if(joined!=arm){joined=2;}
                if(have==0){free[ZTOwnAlias](&joined_alias);joined_alias=aa;have=1;}
                else{let next_aliases:ArrayList[ZTOwnAlias]=zt_alias_agree(joined_alias,aa);free[ZTOwnAlias](&joined_alias);free[ZTOwnAlias](&aa);joined_alias=next_aliases;}
                ai=ai+1;
            }
            let ea:ArrayList[ZTOwnAlias]=zt_alias_clone(basea);let els:i32=zt_owner_terminal_state(x.els_body,root,&ea,decls,sums,out);
            if(joined<0){joined=els;}else if(joined!=els){joined=2;}
            if(have==0){free[ZTOwnAlias](&joined_alias);joined_alias=ea;}
            else{let next_aliases:ArrayList[ZTOwnAlias]=zt_alias_agree(joined_alias,ea);free[ZTOwnAlias](&joined_alias);free[ZTOwnAlias](&ea);joined_alias=next_aliases;}
            free[ZTOwnAlias](&basea);zt_alias_replace(aliases,joined_alias);out=joined;
        }
        else=>{}
    }i=i+1;}return out;
}

// Calls are checked recursively so casts, aggregates, and nested calls cannot
// launder an owned root past the explicit contract boundary.
fn zt_check_owned_call(n:*Node,owned:ArrayList[[]u8],aliases:ArrayList[ZTOwnAlias],decls:ArrayList[*Node],context:[]u8)i32{
    let errors:i32=0;
    switch(n.*){
        .call=>|c|{let name:[]u8=zt_direct_name(c.callee);let allocator_consume:i32=0;switch(c.callee.*){.fld=>|f|{if((@strEq(f.fname,"deallocate")&&c.args.len==1)||(@strEq(f.fname,"resize")&&c.args.len==3)){allocator_consume=1;}}else=>{}}let ai:i32=0;while(ai<c.args.len){let contracted:i32=(((zt_owned_release_name(name)==1&&ai==0)||(allocator_consume==1&&ai==0)||@strEq(name,"_zag_realloc")||@strEq(name,"_zag_slice_ptr")||zt_compiler_nonretaining_call(name)==1||zt_param_borrow_mode(decls,name,ai)>0||zt_consumes_param(decls,name,ai)==1) as i32);let oi:i32=0;while(oi<owned.len){let root:[]u8=owned.data[oi];if(contracted==0&&zt_expr_uses_name(c.args.data[ai],root,aliases)==1){let shown:[]u8=name;if(shown.len==0){shown="<indirect>";}errors=errors+zt_machine_error(_zag_str_concat("owned allocation escapes through uncontracted call `",_zag_str_concat(shown,_zag_str_concat("` (root `",_zag_str_concat(root,"`)")))),context);}oi=oi+1;}errors=errors+zt_check_owned_call(c.args.data[ai],owned,aliases,decls,context);ai=ai+1;}}
        .bin=>|x|{errors=errors+zt_check_owned_call(x.l,owned,aliases,decls,context)+zt_check_owned_call(x.r,owned,aliases,decls,context);}
        .un=>|x|{errors=errors+zt_check_owned_call(x.e,owned,aliases,decls,context);}
        .idx=>|x|{errors=errors+zt_check_owned_call(x.base,owned,aliases,decls,context)+zt_check_owned_call(x.idx,owned,aliases,decls,context);}
        .fld=>|x|{errors=errors+zt_check_owned_call(x.base,owned,aliases,decls,context);}
        .cast_=>|x|{errors=errors+zt_check_owned_call(x.expr,owned,aliases,decls,context);}
        .slice_=>|x|{errors=errors+zt_check_owned_call(x.base,owned,aliases,decls,context)+zt_check_owned_call(x.lo,owned,aliases,decls,context)+zt_check_owned_call(x.hi,owned,aliases,decls,context);}
        .slit_=>|x|{let i:i32=0;while(i<x.fields.len){errors=errors+zt_check_owned_call(x.fields.data[i].val,owned,aliases,decls,context);i=i+1;}}
        else=>{}
    }
    return errors;
}
// Control expressions are call-capable too.  Check their arguments before
// descending into branch bodies so an owner cannot escape only through a
// condition or switch subject and then appear safely released afterwards.
fn zt_check_owned_escapes_body(body:ArrayList[*Node],owned:ArrayList[[]u8],aliases:*ArrayList[ZTOwnAlias],decls:ArrayList[*Node],sums:ArrayList[ZTOwnSummary],context:[]u8)i32{
    let errors:i32=0;let i:i32=0;while(i<body.len){switch(body.data[i].*){
        .let_=>|l|{if(l.has_init==1){errors=errors+zt_check_owned_call(l.expr,owned,aliases.*,decls,context);if(zt_legacy_owned_acquire_name(l.expr,sums,decls).len>0){zt_alias_set(aliases,l.name,l.name);}else{let source:[]u8=zt_expr_transparent_id(l.expr);if(source.len>0){zt_alias_set(aliases,l.name,zt_alias_root(aliases.*,source));}}}}
        .assign=>|a|{errors=errors+zt_check_owned_call(a.expr,owned,aliases.*,decls,context);let target:[]u8=zt_expr_transparent_id(a.target);let source:[]u8=zt_expr_transparent_id(a.expr);if(target.len>0){if(zt_legacy_owned_acquire_name(a.expr,sums,decls).len>0){zt_alias_set(aliases,target,target);}else if(source.len>0){zt_alias_set(aliases,target,zt_alias_root(aliases.*,source));}}}
        .ret=>|r|{if(r.has_expr==1){errors=errors+zt_check_owned_call(r.expr,owned,aliases.*,decls,context);}}
        .estmt=>|e|{errors=errors+zt_check_owned_call(e.expr,owned,aliases.*,decls,context);}
        .unsafe_=>|u|{errors=errors+zt_check_owned_escapes_body(u.body,owned,aliases,decls,sums,context);}
        .defer_=>|d|{errors=errors+zt_check_owned_call(d.expr,owned,aliases.*,decls,context);}
        .if_=>|x|{
            errors=errors+zt_check_owned_call(x.cond,owned,aliases.*,decls,context);
            let base:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);let ta:ArrayList[ZTOwnAlias]=zt_alias_clone(base);
            errors=errors+zt_check_owned_escapes_body(x.then_body,owned,&ta,decls,sums,context);
            let ea:ArrayList[ZTOwnAlias]=zt_alias_clone(base);if(x.has_els==1){errors=errors+zt_check_owned_escapes_body(x.els_body,owned,&ea,decls,sums,context);}
            let next_aliases:ArrayList[ZTOwnAlias]=zt_alias_agree(ta,ea);
            free[ZTOwnAlias](&base);free[ZTOwnAlias](&ta);free[ZTOwnAlias](&ea);zt_alias_replace(aliases,next_aliases);
        }
        .while_=>|x|{
            errors=errors+zt_check_owned_call(x.cond,owned,aliases.*,decls,context);
            let base:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);let wa:ArrayList[ZTOwnAlias]=zt_alias_clone(base);
            errors=errors+zt_check_owned_escapes_body(x.body,owned,&wa,decls,sums,context);
            let next_aliases:ArrayList[ZTOwnAlias]=zt_alias_agree(base,wa);
            free[ZTOwnAlias](&base);free[ZTOwnAlias](&wa);zt_alias_replace(aliases,next_aliases);
        }
        .switch_=>|x|{
            errors=errors+zt_check_owned_call(x.subject,owned,aliases.*,decls,context);
            let base:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);let joined:ArrayList[ZTOwnAlias]=zt_alias_clone(base);
            let have:i32=0;let ai:i32=0;
            while(ai<x.arms.len){
                let aa:ArrayList[ZTOwnAlias]=zt_alias_clone(base);
                errors=errors+zt_check_owned_escapes_body(x.arms.data[ai].body,owned,&aa,decls,sums,context);
                if(have==0){free[ZTOwnAlias](&joined);joined=aa;have=1;}
                else{let next_aliases:ArrayList[ZTOwnAlias]=zt_alias_agree(joined,aa);free[ZTOwnAlias](&joined);free[ZTOwnAlias](&aa);joined=next_aliases;}
                ai=ai+1;
            }
            let ea:ArrayList[ZTOwnAlias]=zt_alias_clone(base);errors=errors+zt_check_owned_escapes_body(x.els_body,owned,&ea,decls,sums,context);
            if(have==0){free[ZTOwnAlias](&joined);joined=ea;}
            else{let next_aliases:ArrayList[ZTOwnAlias]=zt_alias_agree(joined,ea);free[ZTOwnAlias](&joined);free[ZTOwnAlias](&ea);joined=next_aliases;}
            free[ZTOwnAlias](&base);zt_alias_replace(aliases,joined);
        }
        else=>{}
    }i=i+1;}return errors;
}

// Reject replacing a still-live owner. This is a fail-closed generation guard;
// a later ownership IR can assign distinct origin IDs and permit proven reuse.
// Aggregate provenance owns field paths while the older direct-owner lattice
// owns names.  Once a named owner is placed in a value aggregate, terminal
// accounting belongs to the aggregate pass below: it can see a later exact
// field consume, whereas the name-only lattice deliberately cannot guess that
// `box.ptr` is the original capability.  Keep this predicate syntactic and
// narrow; aggregate terminal accounting remains the authority that proves the
// capability was actually discharged.
fn zt_expr_stores_owner_in_aggregate(n:*Node,owner:[]u8,aliases:ArrayList[ZTOwnAlias])i32{switch(n.*){
    .slit_=>|x|{let i:i32=0;while(i<x.fields.len){if(zt_expr_uses_name(x.fields.data[i].val,owner,aliases)==1){return 1;}i=i+1;}}
    .call=>|x|{let i:i32=0;while(i<x.args.len){if(zt_expr_stores_owner_in_aggregate(x.args.data[i],owner,aliases)==1){return 1;}i=i+1;}}
    .bin=>|x|{return zt_expr_stores_owner_in_aggregate(x.l,owner,aliases)|zt_expr_stores_owner_in_aggregate(x.r,owner,aliases);}
    .un=>|x|{return zt_expr_stores_owner_in_aggregate(x.e,owner,aliases);}
    .idx=>|x|{return zt_expr_stores_owner_in_aggregate(x.base,owner,aliases)|zt_expr_stores_owner_in_aggregate(x.idx,owner,aliases);}
    .fld=>|x|{return zt_expr_stores_owner_in_aggregate(x.base,owner,aliases);}
    .cast_=>|x|{return zt_expr_stores_owner_in_aggregate(x.expr,owner,aliases);}
    .slice_=>|x|{return zt_expr_stores_owner_in_aggregate(x.base,owner,aliases);}
    else=>{}
}return 0;}
fn zt_body_stores_owner_in_aggregate(body:ArrayList[*Node],owner:[]u8,aliases:*ArrayList[ZTOwnAlias])i32{let i:i32=0;while(i<body.len){switch(body.data[i].*){
    .let_=>|x|{if(x.has_init==1){if(zt_expr_stores_owner_in_aggregate(x.expr,owner,aliases.*)==1){return 1;}let src:[]u8=zt_expr_transparent_id(x.expr);if(src.len>0){zt_alias_set(aliases,x.name,zt_alias_root(aliases.*,src));}}}
    .assign=>|x|{if(zt_expr_stores_owner_in_aggregate(x.expr,owner,aliases.*)==1){return 1;}let dst:[]u8=zt_expr_transparent_id(x.target);let src:[]u8=zt_expr_transparent_id(x.expr);if(dst.len>0&&src.len>0){zt_alias_set(aliases,dst,zt_alias_root(aliases.*,src));}}
    .unsafe_=>|x|{if(zt_body_stores_owner_in_aggregate(x.body,owner,aliases)==1){return 1;}}
    .if_=>|x|{let a:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);let b:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);let hit:i32=zt_body_stores_owner_in_aggregate(x.then_body,owner,&a)|zt_body_stores_owner_in_aggregate(x.els_body,owner,&b);free[ZTOwnAlias](&a);free[ZTOwnAlias](&b);if(hit==1){return 1;}}
    .while_=>|x|{let a:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);let hit:i32=zt_body_stores_owner_in_aggregate(x.body,owner,&a);free[ZTOwnAlias](&a);if(hit==1){return 1;}}
    .switch_=>|x|{let ai:i32=0;while(ai<x.arms.len){let a:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);let hit:i32=zt_body_stores_owner_in_aggregate(x.arms.data[ai].body,owner,&a);free[ZTOwnAlias](&a);if(hit==1){return 1;}ai=ai+1;}let a:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);let hit:i32=zt_body_stores_owner_in_aggregate(x.els_body,owner,&a);free[ZTOwnAlias](&a);if(hit==1){return 1;}}
    else=>{}
}i=i+1;}return 0;}
fn zt_check_owner_state_body(body:ArrayList[*Node],live:*ArrayList[[]u8],aliases:*ArrayList[ZTOwnAlias],decls:ArrayList[*Node],sums:ArrayList[ZTOwnSummary],context:[]u8)i32{
    let errors:i32=0;let i:i32=0;while(i<body.len){switch(body.data[i].*){
        .let_=>|l|{if(l.has_init==1){if(zt_legacy_owned_acquire_name(l.expr,sums,decls).len>0){let source:[]u8=zt_owner_transfer_source_name(l.expr,sums);if(source.len>0){zt_names_remove(live,zt_alias_root(aliases.*,source));}let old:[]u8=zt_alias_root(aliases.*,l.name);if(zt_in_names(live.*,old)==1){errors=errors+zt_machine_error(_zag_str_concat("live owned allocation `",_zag_str_concat(old,"` is overwritten before release or transfer")),context);}if(zt_in_names(live.*,l.name)==0){push[[]u8](live,l.name);}zt_alias_set(aliases,l.name,l.name);}else{let source:[]u8=zt_expr_transparent_id(l.expr);if(source.len>0){zt_alias_set(aliases,l.name,zt_alias_root(aliases.*,source));}}}}
        .assign=>|a|{let target:[]u8=zt_expr_transparent_id(a.target);if(target.len>0){if(zt_legacy_owned_acquire_name(a.expr,sums,decls).len>0){let source:[]u8=zt_owner_transfer_source_name(a.expr,sums);if(source.len>0){zt_names_remove(live,zt_alias_root(aliases.*,source));}let old:[]u8=zt_alias_root(aliases.*,target);if(zt_in_names(live.*,old)==1){errors=errors+zt_machine_error(_zag_str_concat("live owned allocation `",_zag_str_concat(old,"` is overwritten before release or transfer")),context);}if(zt_in_names(live.*,target)==0){push[[]u8](live,target);}zt_alias_set(aliases,target,target);}else{let source:[]u8=zt_expr_transparent_id(a.expr);if(source.len>0){zt_alias_set(aliases,target,zt_alias_root(aliases.*,source));}}}}
        .ret=>|r|{if(r.has_expr==1){let root:[]u8=zt_owned_expr_root(r.expr,live.*,aliases.*);if(root.len>0){zt_names_remove(live,root);}}}
        .estmt=>|e|{switch(e.expr.*){.call=>|c|{let name:[]u8=zt_direct_name(c.callee);if(zt_owned_release_name(name)==1&&c.args.len==1){let root:[]u8=zt_owned_expr_root(c.args.data[0],live.*,aliases.*);if(root.len>0){zt_names_remove(live,root);}}else if(zt_fn_has_consumes_contract(decls,name)==1){let ai:i32=0;while(ai<c.args.len){if(zt_consumes_param(decls,name,ai)==1){let root:[]u8=zt_owned_expr_root(c.args.data[ai],live.*,aliases.*);if(root.len>0){zt_names_remove(live,root);}}ai=ai+1;}}}else=>{}}}
        .unsafe_=>|u|{errors=errors+zt_check_owner_state_body(u.body,live,aliases,decls,sums,context);}
        .defer_=>|d|{switch(d.expr.*){.call=>|c|{let name:[]u8=zt_direct_name(c.callee);if(zt_owned_release_name(name)==1&&c.args.len==1){let root:[]u8=zt_owned_expr_root(c.args.data[0],live.*,aliases.*);if(root.len>0){zt_names_remove(live,root);}}else if(zt_fn_has_consumes_contract(decls,name)==1){let ai:i32=0;while(ai<c.args.len){if(zt_consumes_param(decls,name,ai)==1){let root:[]u8=zt_owned_expr_root(c.args.data[ai],live.*,aliases.*);if(root.len>0){zt_names_remove(live,root);}}ai=ai+1;}}}else=>{}}}
        .if_=>|x|{
            let base:ArrayList[[]u8]=zt_names_clone(live.*);let basea:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);
            let tl:ArrayList[[]u8]=zt_names_clone(base);let ta:ArrayList[ZTOwnAlias]=zt_alias_clone(basea);
            errors=errors+zt_check_owner_state_body(x.then_body,&tl,&ta,decls,sums,context);
            let el:ArrayList[[]u8]=zt_names_clone(base);let ea:ArrayList[ZTOwnAlias]=zt_alias_clone(basea);
            if(x.has_els==1){errors=errors+zt_check_owner_state_body(x.els_body,&el,&ea,decls,sums,context);}
            let next_live:ArrayList[[]u8]=zt_names_clone(tl);zt_names_merge(&next_live,el);
            let next_aliases:ArrayList[ZTOwnAlias]=zt_alias_agree(ta,ea);
            free[[]u8](&base);free[ZTOwnAlias](&basea);free[[]u8](&tl);free[ZTOwnAlias](&ta);free[[]u8](&el);free[ZTOwnAlias](&ea);
            zt_names_replace(live,next_live);zt_alias_replace(aliases,next_aliases);
        }
        .while_=>|x|{
            let base:ArrayList[[]u8]=zt_names_clone(live.*);let basea:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);
            let wl:ArrayList[[]u8]=zt_names_clone(base);let wa:ArrayList[ZTOwnAlias]=zt_alias_clone(basea);
            errors=errors+zt_check_owner_state_body(x.body,&wl,&wa,decls,sums,context);
            let next_live:ArrayList[[]u8]=zt_names_clone(base);zt_names_merge(&next_live,wl);
            let next_aliases:ArrayList[ZTOwnAlias]=zt_alias_agree(basea,wa);
            free[[]u8](&base);free[ZTOwnAlias](&basea);free[[]u8](&wl);free[ZTOwnAlias](&wa);
            zt_names_replace(live,next_live);zt_alias_replace(aliases,next_aliases);
        }
        .switch_=>|x|{
            let base:ArrayList[[]u8]=zt_names_clone(live.*);let basea:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);
            let joined:ArrayList[[]u8]=make[[]u8](base.len+2);let joined_alias:ArrayList[ZTOwnAlias]=zt_alias_clone(basea);
            let have:i32=0;let ai:i32=0;
            while(ai<x.arms.len){
                let al:ArrayList[[]u8]=zt_names_clone(base);let aa:ArrayList[ZTOwnAlias]=zt_alias_clone(basea);
                errors=errors+zt_check_owner_state_body(x.arms.data[ai].body,&al,&aa,decls,sums,context);
                zt_names_merge(&joined,al);free[[]u8](&al);
                if(have==0){free[ZTOwnAlias](&joined_alias);joined_alias=aa;have=1;}
                else{let next_aliases:ArrayList[ZTOwnAlias]=zt_alias_agree(joined_alias,aa);free[ZTOwnAlias](&joined_alias);free[ZTOwnAlias](&aa);joined_alias=next_aliases;}
                ai=ai+1;
            }
            let el:ArrayList[[]u8]=zt_names_clone(base);let ea:ArrayList[ZTOwnAlias]=zt_alias_clone(basea);
            errors=errors+zt_check_owner_state_body(x.els_body,&el,&ea,decls,sums,context);
            zt_names_merge(&joined,el);free[[]u8](&el);
            if(have==0){free[ZTOwnAlias](&joined_alias);joined_alias=ea;}
            else{let next_aliases:ArrayList[ZTOwnAlias]=zt_alias_agree(joined_alias,ea);free[ZTOwnAlias](&joined_alias);free[ZTOwnAlias](&ea);joined_alias=next_aliases;}
            free[[]u8](&base);free[ZTOwnAlias](&basea);
            zt_names_replace(live,joined);zt_alias_replace(aliases,joined_alias);
        }
        else=>{}
    }i=i+1;}return errors;
}

fn zt_check_v2_direct_frees(decls:ArrayList[*Node],file:[]u8)i32{
    if(@strEq(v2_project_edition(file),"2027")==0){return 0;}
    let sums:ArrayList[ZTOwnSummary]=zt_build_owner_summaries(decls);
    let errors:i32=zt_check_owner_summary_errors(decls,sums);let i:i32=0;
    while(i<decls.len){switch(decls.data[i].*){
        .fn_decl=>|f|{
            let context:[]u8=_zag_str_concat("function ",f.name);
            let consumes:i32=zt_fn_has_consumes_contract(decls,f.name);
            // This legacy named-owner pass must not reinterpret an explicit
            // first-parameter @borrows_mut plus a separate generic
            // @consumes value parameter as a mixed function-level contract.
            // Explicit relations are checked by the v2 borrow/resource passes.
            let borrow:i32=((zt_fn_has_legacy_annot(decls,f.name,"@borrows") == 1 ||
                zt_fn_has_legacy_annot(decls,f.name,"@borrows_mut") == 1) as i32);
            // Parameter-level contracts are independent relations: a
            // mutable borrow of the container may coexist with a consuming
            // element parameter (for example std:list.push[T]). Only the
            // legacy function-level annotations are a mixed-contract error.
            let legacy_consumes:i32=zt_fn_has_legacy_annot(decls,f.name,"@consumes");
            if(legacy_consumes==1&&borrow>0){errors=errors+zt_machine_error("@consumes cannot be combined with a borrow contract",context);}
            if(consumes==1){let owner_params:i32=0;let pi:i32=0;while(pi<f.params.len){if(zt_consumes_param(decls,f.name,pi)==1){owner_params=owner_params+1;}pi=pi+1;}if(owner_params==0){errors=errors+zt_machine_error("@consumes requires at least one raw-pointer or Allocation owner parameter",context);}}
            let freed:ArrayList[[]u8]=make[[]u8](4);let aliases:ArrayList[ZTOwnAlias]=make[ZTOwnAlias](4);
            errors=errors+zt_check_direct_free_body(f.body,&freed,&aliases,decls,sums,context);
            free[[]u8](&freed);free[ZTOwnAlias](&aliases);
            let owned:ArrayList[[]u8]=make[[]u8](4);let returned:ArrayList[[]u8]=make[[]u8](2);let transfer_aliases:ArrayList[ZTOwnAlias]=make[ZTOwnAlias](4);
            if(consumes==1&&f.is_extern==0){let pi:i32=0;while(pi<f.params.len){let p:Param=f.params.data[pi];if(zt_legacy_allocation_consumes_param(decls,f.name,pi)==1){push[[]u8](&owned,p.name);zt_alias_set(&transfer_aliases,p.name,p.name);}pi=pi+1;}}
            zt_collect_owned_body(f.body,&owned,&returned,&transfer_aliases,decls,sums);
            free[[]u8](&returned);free[ZTOwnAlias](&transfer_aliases);
            let escape_aliases:ArrayList[ZTOwnAlias]=make[ZTOwnAlias](4);if(consumes==1&&f.is_extern==0){let pi:i32=0;while(pi<f.params.len){let p:Param=f.params.data[pi];if(zt_legacy_allocation_consumes_param(decls,f.name,pi)==1){zt_alias_set(&escape_aliases,p.name,p.name);}pi=pi+1;}}
            errors=errors+zt_check_owned_escapes_body(f.body,owned,&escape_aliases,decls,sums,context);
            free[ZTOwnAlias](&escape_aliases);
            let live:ArrayList[[]u8]=make[[]u8](4);let state_aliases:ArrayList[ZTOwnAlias]=make[ZTOwnAlias](4);if(consumes==1&&f.is_extern==0){let pi:i32=0;while(pi<f.params.len){let p:Param=f.params.data[pi];if(zt_legacy_allocation_consumes_param(decls,f.name,pi)==1){push[[]u8](&live,p.name);zt_alias_set(&state_aliases,p.name,p.name);}pi=pi+1;}}
            errors=errors+zt_check_owner_state_body(f.body,&live,&state_aliases,decls,sums,context);
            free[[]u8](&live);free[ZTOwnAlias](&state_aliases);
            let oi:i32=0;while(oi<owned.len){
                let name:[]u8=owned.data[oi];let flow_aliases:ArrayList[ZTOwnAlias]=make[ZTOwnAlias](4);
                if(consumes==1&&f.is_extern==0){let pi:i32=0;while(pi<f.params.len){let p:Param=f.params.data[pi];if(zt_legacy_allocation_consumes_param(decls,f.name,pi)==1){zt_alias_set(&flow_aliases,p.name,p.name);}pi=pi+1;}}
                let terminal:i32=zt_owner_terminal_state(f.body,name,&flow_aliases,decls,sums,0);
                free[ZTOwnAlias](&flow_aliases);
                let aggregate_aliases:ArrayList[ZTOwnAlias]=make[ZTOwnAlias](4);let aggregate_owned:i32=zt_body_stores_owner_in_aggregate(f.body,name,&aggregate_aliases);free[ZTOwnAlias](&aggregate_aliases);
                if(aggregate_owned==0){if(terminal==0){if(consumes==1&&f.is_extern==0&&zt_consumes_owner_named(decls,f.name,name)==1){errors=errors+zt_machine_error(_zag_str_concat("@consumes parameter `",_zag_str_concat(name,"` is not released or transferred on every control-flow path")),context);}else{errors=errors+zt_machine_error(_zag_str_concat("owned allocation `",_zag_str_concat(name,"` is neither released nor returned")),context);}}
                else if(terminal==2){if(consumes==1&&f.is_extern==0&&zt_consumes_owner_named(decls,f.name,name)==1){errors=errors+zt_machine_error(_zag_str_concat("@consumes parameter `",_zag_str_concat(name,"` is not released or transferred on every control-flow path")),context);}else{errors=errors+zt_machine_error(_zag_str_concat("owned allocation `",_zag_str_concat(name,"` is not released or returned on every control-flow path")),context);}}}
                oi=oi+1;
            }
            free[[]u8](&owned);
        }
        else=>{}
    }i=i+1;}
    free[ZTOwnSummary](&sums);
    return errors;
}

// ── edition-2027 retained fixed-buffer owner ──────────────────────────────
// This is intentionally a *small* ownership extension, not a general
// allocator protocol.  A region may be created from one named Allocation at a
// top-level let and must be deinitialized into one new named Allocation before
// the function exits.  Blocks, reset, aliases, aggregate storage, calls, and
// control-flow lifetimes remain rejected.  Keeping the grammar this narrow
// makes the backing-root handoff visible to the older owner lattice above.
struct ZTRetainedState { backing: []u8, allocator: []u8, released: []u8, phase: i32, generation: i32, kind: i32 }
struct ZTRetainedBlock { name: []u8, generation: i32 }
// kind 1 is FixedBufferAllocator and kind 2 is ArenaAllocator. Both are
// checked retained regions over one backing Allocation, but their distinct
// source types prevent an arena capability from being silently passed through
// the fixed-buffer surface.
fn zt_retained_ctor_kind(n:*Node)i32{switch(n.*){.un=>|u|{if(@strEq(u.op,"try")){return zt_retained_ctor_kind(u.e);}}.cast_=>|c|{return zt_retained_ctor_kind(c.expr);}.call=>|c|{let name:[]u8=zt_direct_name(c.callee);if(c.args.len==1&&@strEq(name,"fixed_buffer_allocator")){return 1;}if(c.args.len==1&&@strEq(name,"arena_allocator")){return 2;}}else=>{}}return 0;}
fn zt_retained_ctor_backing(n:*Node)[]u8{switch(n.*){.un=>|u|{if(@strEq(u.op,"try")){return zt_retained_ctor_backing(u.e);}}.cast_=>|c|{return zt_retained_ctor_backing(c.expr);}.call=>|c|{if(zt_retained_ctor_kind(n)>0){return zt_expr_transparent_id(c.args.data[0]);}}else=>{}}return "";}
fn zt_retained_deinit_receiver(n:*Node)[]u8{switch(n.*){.un=>|u|{if(@strEq(u.op,"try")){return zt_retained_deinit_receiver(u.e);}}.cast_=>|c|{return zt_retained_deinit_receiver(c.expr);}.call=>|c|{if(c.args.len==0){switch(c.callee.*){.fld=>|f|{if(@strEq(f.fname,"deinit")){return zt_expr_transparent_id(f.base);}}else=>{}}}}else=>{}}return "";}
fn zt_retained_reset_receiver(n:*Node)[]u8{switch(n.*){.un=>|u|{if(@strEq(u.op,"try")){return zt_retained_reset_receiver(u.e);}}.cast_=>|c|{return zt_retained_reset_receiver(c.expr);}.call=>|c|{if(c.args.len==0){switch(c.callee.*){.fld=>|f|{if(@strEq(f.fname,"reset")){return zt_expr_transparent_id(f.base);}}else=>{}}}}else=>{}}return "";}
fn zt_retained_telemetry_receiver(n:*Node)[]u8{switch(n.*){.un=>|u|{if(@strEq(u.op,"try")){return zt_retained_telemetry_receiver(u.e);}}.cast_=>|c|{return zt_retained_telemetry_receiver(c.expr);}.call=>|c|{if(c.args.len==0){switch(c.callee.*){.fld=>|f|{if(@strEq(f.fname,"telemetry")){return zt_expr_transparent_id(f.base);}}else=>{}}}}else=>{}}return "";}
fn zt_retained_block_alloc_receiver(n:*Node)[]u8{switch(n.*){.un=>|u|{if(@strEq(u.op,"try")){return zt_retained_block_alloc_receiver(u.e);}}.cast_=>|c|{return zt_retained_block_alloc_receiver(c.expr);}.call=>|c|{if(c.args.len==2){switch(c.callee.*){.fld=>|f|{if(@strEq(f.fname,"allocate")){return zt_expr_transparent_id(f.base);}}else=>{}}}}else=>{}}return "";}
// A caught allocation may be evaluated only as a discarded expression.  Its
// fallback must be one already-live block, so no new alias survives either the
// success or failure path. This admits direct OOM/cursor-stability probes
// without exposing a forgeable null block or weakening block ownership.
fn zt_retained_discarded_alloc_receiver(n:*Node)[]u8{switch(n.*){.call=>|c|{let name:[]u8=zt_direct_name(c.callee);if((@strEq(name,"__catch")&&c.args.len==2)||(@strEq(name,"__catchc")&&c.args.len==3)){return zt_retained_block_alloc_receiver(c.args.data[0]);}}.cast_=>|x|{return zt_retained_discarded_alloc_receiver(x.expr);}else=>{}}return "";}
fn zt_retained_discarded_alloc_fallback(n:*Node)[]u8{switch(n.*){.call=>|c|{let name:[]u8=zt_direct_name(c.callee);if(@strEq(name,"__catch")&&c.args.len==2){return zt_expr_transparent_id(c.args.data[1]);}if(@strEq(name,"__catchc")&&c.args.len==3){return zt_expr_transparent_id(c.args.data[2]);}}.cast_=>|x|{return zt_retained_discarded_alloc_fallback(x.expr);}else=>{}}return "";}
fn zt_retained_read_type(n:*Node)[]u8{switch(n.*){.un=>|u|{if(@strEq(u.op,"try")){return zt_retained_read_type(u.e);}}.cast_=>|c|{return zt_retained_read_type(c.expr);}.call=>|c|{let name:[]u8=zt_direct_name(c.callee);if(c.args.len==2&&(@strEq(name,"fixed_buffer_read_u8")||@strEq(name,"arena_read_u8"))){return "u8";}if(c.args.len==2&&@strEq(name,"arena_read_u64")){return "u64";}if(c.args.len==1&&@strEq(name,"arena_block_len")){return "i64";}}else=>{}}return "";}
fn zt_retained_access_arg(n:*Node,read:i32)[]u8{switch(n.*){.un=>|u|{if(@strEq(u.op,"try")){return zt_retained_access_arg(u.e,read);}}.cast_=>|c|{return zt_retained_access_arg(c.expr,read);}.call=>|c|{let name:[]u8=zt_direct_name(c.callee);if(read==1&&zt_retained_read_type(n).len>0){return zt_expr_transparent_id(c.args.data[0]);}if(read==0&&((c.args.len==3&&(@strEq(name,"fixed_buffer_write_u8")||@strEq(name,"arena_write_u8")||@strEq(name,"arena_write_u64")))||(c.args.len==4&&@strEq(name,"arena_fill_u8")))){return zt_expr_transparent_id(c.args.data[0]);}}else=>{}}return "";}
fn zt_retained_is_direct_call(name:[]u8)i32{return (@strEq(name,"fixed_buffer_allocator")||@strEq(name,"arena_allocator")||@strEq(name,"fixed_buffer_read_u8")||@strEq(name,"fixed_buffer_write_u8")||@strEq(name,"arena_read_u8")||@strEq(name,"arena_write_u8")||@strEq(name,"arena_read_u64")||@strEq(name,"arena_write_u64")||@strEq(name,"arena_fill_u8")||@strEq(name,"arena_block_len")) as i32;}
fn zt_retained_has_fixed_call(n:*Node,allocator:[]u8)i32{switch(n.*){.call=>|c|{let direct:[]u8=zt_direct_name(c.callee);if(zt_retained_is_direct_call(direct)==1){return 1;}switch(c.callee.*){.fld=>|f|{if(allocator.len>0&&@strEq(zt_expr_transparent_id(f.base),allocator)){return 1;}}else=>{}}let i:i32=0;while(i<c.args.len){if(zt_retained_has_fixed_call(c.args.data[i],allocator)==1){return 1;}i=i+1;}}.bin=>|x|{return zt_retained_has_fixed_call(x.l,allocator)|zt_retained_has_fixed_call(x.r,allocator);}.un=>|x|{return zt_retained_has_fixed_call(x.e,allocator);}.idx=>|x|{return zt_retained_has_fixed_call(x.base,allocator)|zt_retained_has_fixed_call(x.idx,allocator);}.fld=>|x|{return zt_retained_has_fixed_call(x.base,allocator);}.cast_=>|x|{return zt_retained_has_fixed_call(x.expr,allocator);}.slice_=>|x|{return zt_retained_has_fixed_call(x.base,allocator)|zt_retained_has_fixed_call(x.lo,allocator)|zt_retained_has_fixed_call(x.hi,allocator);}.slit_=>|x|{let i:i32=0;while(i<x.fields.len){if(zt_retained_has_fixed_call(x.fields.data[i].val,allocator)==1){return 1;}i=i+1;}}else=>{}}return 0;}
// A loop may repeatedly allocate an ephemeral block and reset the same live
// region.  That is the bounded arena's intended steady state: reset advances
// the generation before the next iteration, so no block can cross it.  Keep
// this narrow syntactic proof; any return, assignment, nested control flow,
// deinit, or unrecognised fixed-buffer operation remains fail-closed.
fn zt_retained_reset_loop_safe(body:ArrayList[*Node],s:ZTRetainedState)i32{let i:i32=0;while(i<body.len){switch(body.data[i].*){
    .let_=>|l|{if(l.has_init==1&&zt_retained_has_fixed_call(l.expr,s.allocator)==1&&@strEq(zt_retained_block_alloc_receiver(l.expr),s.allocator)==0){return 0;}}
    .estmt=>|e|{if(zt_retained_has_fixed_call(e.expr,s.allocator)==1){let rr:[]u8=zt_retained_reset_receiver(e.expr);let wb:[]u8=zt_retained_access_arg(e.expr,0);if(!@strEq(rr,s.allocator)&&wb.len==0){return 0;}}}
    .assign=>|a|{if(zt_retained_has_fixed_call(a.expr,s.allocator)==1||zt_retained_has_fixed_call(a.target,s.allocator)==1){return 0;}}
    .ret=>|_r|{return 0;}.if_=>|_x|{return 0;}.while_=>|_w|{return 0;}.switch_=>|_sw|{return 0;}.unsafe_=>|_u|{return 0;}
    else=>{}
}i=i+1;}return 1;}
fn zt_retained_expr_name(n:*Node,name:[]u8)i32{if(name.len==0){return 0;}switch(n.*){.id=>|x|{return @strEq(x.name,name) as i32;}.bin=>|x|{return zt_retained_expr_name(x.l,name)|zt_retained_expr_name(x.r,name);}.un=>|x|{return zt_retained_expr_name(x.e,name);}.call=>|x|{let hit:i32=zt_retained_expr_name(x.callee,name);let i:i32=0;while(i<x.args.len){hit=hit|zt_retained_expr_name(x.args.data[i],name);i=i+1;}return hit;}.idx=>|x|{return zt_retained_expr_name(x.base,name)|zt_retained_expr_name(x.idx,name);}.fld=>|x|{return zt_retained_expr_name(x.base,name);}.cast_=>|x|{return zt_retained_expr_name(x.expr,name);}.slice_=>|x|{return zt_retained_expr_name(x.base,name)|zt_retained_expr_name(x.lo,name)|zt_retained_expr_name(x.hi,name);}.slit_=>|x|{let i:i32=0;while(i<x.fields.len){if(zt_retained_expr_name(x.fields.data[i].val,name)==1){return 1;}i=i+1;}}else=>{}}return 0;}
fn zt_retained_uses_live(n:*Node,s:ZTRetainedState)i32{if(s.phase==0){return 0;}return zt_retained_expr_name(n,s.backing)|zt_retained_expr_name(n,s.allocator);}
fn zt_retained_block_generation(blocks:ArrayList[ZTRetainedBlock],name:[]u8)i32{let i:i32=0;while(i<blocks.len){if(@strEq(blocks.data[i].name,name)){return blocks.data[i].generation;}i=i+1;}return -1;}
fn zt_retained_uses_blocks(n:*Node,blocks:ArrayList[ZTRetainedBlock])i32{let i:i32=0;while(i<blocks.len){if(zt_retained_expr_name(n,blocks.data[i].name)==1){return 1;}i=i+1;}return 0;}
fn zt_retained_control_has(body:ArrayList[*Node],s:ZTRetainedState)i32{let i:i32=0;while(i<body.len){switch(body.data[i].*){.let_=>|l|{if(l.has_init==1&&(zt_retained_has_fixed_call(l.expr,s.allocator)==1||zt_retained_uses_live(l.expr,s)==1)){return 1;}}.assign=>|a|{if(zt_retained_has_fixed_call(a.expr,s.allocator)==1||zt_retained_uses_live(a.target,s)==1||zt_retained_uses_live(a.expr,s)==1){return 1;}}.ret=>|r|{if(r.has_expr==1&&zt_retained_uses_live(r.expr,s)==1){return 1;}}.estmt=>|e|{if(zt_retained_has_fixed_call(e.expr,s.allocator)==1||zt_retained_uses_live(e.expr,s)==1){return 1;}}.defer_=>|d|{if(zt_retained_has_fixed_call(d.expr,s.allocator)==1||zt_retained_uses_live(d.expr,s)==1){return 1;}}.unsafe_=>|u|{if(zt_retained_control_has(u.body,s)==1){return 1;}}.if_=>|x|{if(zt_retained_uses_live(x.cond,s)==1||zt_retained_control_has(x.then_body,s)==1||zt_retained_control_has(x.els_body,s)==1){return 1;}}.while_=>|x|{if(zt_retained_uses_live(x.cond,s)==1||zt_retained_control_has(x.body,s)==1){return 1;}}.switch_=>|x|{if(zt_retained_uses_live(x.subject,s)==1||zt_retained_control_has(x.els_body,s)==1){return 1;}let ai:i32=0;while(ai<x.arms.len){if(zt_retained_control_has(x.arms.data[ai].body,s)==1){return 1;}ai=ai+1;}}else=>{}}i=i+1;}return 0;}
fn zt_retained_control_uses_blocks(body:ArrayList[*Node],blocks:ArrayList[ZTRetainedBlock])i32{let i:i32=0;while(i<body.len){switch(body.data[i].*){.let_=>|l|{if(l.has_init==1&&zt_retained_uses_blocks(l.expr,blocks)==1){return 1;}}.assign=>|a|{if(zt_retained_uses_blocks(a.target,blocks)==1||zt_retained_uses_blocks(a.expr,blocks)==1){return 1;}}.ret=>|r|{if(r.has_expr==1&&zt_retained_uses_blocks(r.expr,blocks)==1){return 1;}}.estmt=>|e|{if(zt_retained_uses_blocks(e.expr,blocks)==1){return 1;}}.defer_=>|d|{if(zt_retained_uses_blocks(d.expr,blocks)==1){return 1;}}.unsafe_=>|u|{if(zt_retained_control_uses_blocks(u.body,blocks)==1){return 1;}}.if_=>|x|{if(zt_retained_uses_blocks(x.cond,blocks)==1||zt_retained_control_uses_blocks(x.then_body,blocks)==1||zt_retained_control_uses_blocks(x.els_body,blocks)==1){return 1;}}.while_=>|x|{if(zt_retained_uses_blocks(x.cond,blocks)==1||zt_retained_control_uses_blocks(x.body,blocks)==1){return 1;}}.switch_=>|x|{if(zt_retained_uses_blocks(x.subject,blocks)==1||zt_retained_control_uses_blocks(x.els_body,blocks)==1){return 1;}let ai:i32=0;while(ai<x.arms.len){if(zt_retained_control_uses_blocks(x.arms.data[ai].body,blocks)==1){return 1;}ai=ai+1;}}else=>{}}i=i+1;}return 0;}
fn zt_check_v2_retained_regions(decls:ArrayList[*Node],file:[]u8)i32{
    if(@strEq(v2_project_edition(file),"2027")==0){return 0;}let errors:i32=0;let fi:i32=0;
    while(fi<decls.len){switch(decls.data[fi].*){.fn_decl=>|f|{
        let context:[]u8=_zag_str_concat("function ",f.name);let s:ZTRetainedState=ZTRetainedState{.backing="",.allocator="",.released="",.phase=0,.generation=1,.kind=0};let blocks:ArrayList[ZTRetainedBlock]=make[ZTRetainedBlock](4);let pi:i32=0;
        while(pi<f.params.len){let helper:i32=(@strEq(f.name,"fixed_buffer_read_u8")||@strEq(f.name,"fixed_buffer_write_u8")||@strEq(f.name,"arena_read_u8")||@strEq(f.name,"arena_write_u8")||@strEq(f.name,"arena_read_u64")||@strEq(f.name,"arena_write_u64")||@strEq(f.name,"arena_fill_u8")||@strEq(f.name,"arena_block_len")) as i32;if(@strEq(f.params.data[pi].pty,"FixedBufferAllocator")||@strEq(f.params.data[pi].pty,"ArenaAllocator")||((@strEq(f.params.data[pi].pty,"FixedBufferBlock")||@strEq(f.params.data[pi].pty,"ArenaBlock"))&&helper==0)){errors=errors+zt_machine_error("retained allocator capabilities are only admitted through the top-level lifecycle",context);}pi=pi+1;}
        let i:i32=0;while(i<f.body.len){switch(f.body.data[i].*){
            .let_=>|l|{let backing:[]u8=zt_retained_ctor_backing(l.expr);let ctor_kind:i32=zt_retained_ctor_kind(l.expr);let receiver:[]u8=zt_retained_deinit_receiver(l.expr);let telemetry_receiver:[]u8=zt_retained_telemetry_receiver(l.expr);let block_receiver:[]u8=zt_retained_block_alloc_receiver(l.expr);let read_block:[]u8=zt_retained_access_arg(l.expr,1);
                if(backing.len>0){let good_type:i32=((ctor_kind==1&&@strEq(l.dty,"FixedBufferAllocator"))||(ctor_kind==2&&@strEq(l.dty,"ArenaAllocator"))) as i32;if(s.phase!=0||good_type==0){errors=errors+zt_machine_error("retained allocator construction requires one top-level checked backing lifecycle",context);}else{s.backing=backing;s.allocator=l.name;s.phase=1;s.kind=ctor_kind;}}
                else if(receiver.len>0){if(s.phase!=1||@strEq(receiver,s.allocator)==0||@strEq(l.dty,"Allocation")==0||@strEq(l.name,s.backing)==1||@strEq(l.name,s.allocator)==1){errors=errors+zt_machine_error("fixed-buffer deinit must be top-level `let released:Allocation = try allocator.deinit()` with a fresh released binding",context);}else{s.released=l.name;s.phase=2;}}
                else if(telemetry_receiver.len>0){if(s.phase!=1||s.kind!=2||@strEq(telemetry_receiver,s.allocator)==0||@strEq(l.dty,"ArenaTelemetry")==0){errors=errors+zt_machine_error("arena telemetry requires the live ArenaAllocator and an ArenaTelemetry result",context);}}
                else if(block_receiver.len>0&&((s.kind==1&&@strEq(l.dty,"FixedBufferBlock"))||(s.kind==2&&@strEq(l.dty,"ArenaBlock")))){if(s.phase!=1||@strEq(block_receiver,s.allocator)==0||zt_retained_block_generation(blocks,l.name)>=0){errors=errors+zt_machine_error("retained allocation requires a fresh top-level block binding",context);}else{push[ZTRetainedBlock](&blocks,ZTRetainedBlock{.name=l.name,.generation=s.generation});}}
                else if(read_block.len>0){let expected:[]u8=zt_retained_read_type(l.expr);if(s.phase!=1||zt_retained_block_generation(blocks,read_block)!=s.generation||@strEq(l.dty,expected)==0){errors=errors+zt_machine_error("retained reads require one live named block and the accessor's exact result type",context);}}
                else if(zt_retained_has_fixed_call(l.expr,s.allocator)==1){errors=errors+zt_machine_error("fixed-buffer aliases and unrecognized block operations are unsupported",context);}
                else if(zt_retained_uses_live(l.expr,s)==1||zt_retained_uses_blocks(l.expr,blocks)==1){errors=errors+zt_machine_error("retained backing, allocator, and blocks cannot be copied, escaped, or used outside their lifecycle operations",context);}
            }
            .assign=>|a|{if(zt_retained_has_fixed_call(a.expr,s.allocator)==1||zt_retained_uses_live(a.target,s)==1||zt_retained_uses_live(a.expr,s)==1||zt_retained_uses_blocks(a.target,blocks)==1||zt_retained_uses_blocks(a.expr,blocks)==1){errors=errors+zt_machine_error("retained backing, allocator, and blocks cannot be assigned or escaped",context);}}
            .ret=>|r|{if(r.has_expr==1&&(zt_retained_uses_live(r.expr,s)==1||zt_retained_uses_blocks(r.expr,blocks)==1)){errors=errors+zt_machine_error("retained backing, allocator, or block cannot escape through return",context);}}
            .estmt=>|e|{let write_block:[]u8=zt_retained_access_arg(e.expr,0);let reset_receiver:[]u8=zt_retained_reset_receiver(e.expr);let discarded_receiver:[]u8=zt_retained_discarded_alloc_receiver(e.expr);let discarded_fallback:[]u8=zt_retained_discarded_alloc_fallback(e.expr);if(discarded_receiver.len>0){if(s.phase!=1||@strEq(discarded_receiver,s.allocator)==0||zt_retained_block_generation(blocks,discarded_fallback)!=s.generation){errors=errors+zt_machine_error("discarded caught allocation requires the live allocator and one current fallback block",context);}}else if(write_block.len>0){if(s.phase!=1||zt_retained_block_generation(blocks,write_block)!=s.generation){errors=errors+zt_machine_error("fixed-buffer writes require one live named FixedBufferBlock",context);}}else if(reset_receiver.len>0){if(s.phase!=1||@strEq(reset_receiver,s.allocator)==0){errors=errors+zt_machine_error("fixed-buffer reset requires the live retained allocator receiver",context);}else{s.generation=s.generation+1;if(s.generation==0){s.generation=1;}}}else if(zt_retained_has_fixed_call(e.expr,s.allocator)==1||zt_retained_uses_live(e.expr,s)==1||zt_retained_uses_blocks(e.expr,blocks)==1){errors=errors+zt_machine_error("retained backing, allocator, and blocks cannot be released, escaped, or used outside checked accessors",context);}}
            .defer_=>|d|{if(zt_retained_has_fixed_call(d.expr,s.allocator)==1||zt_retained_uses_live(d.expr,s)==1||zt_retained_uses_blocks(d.expr,blocks)==1){errors=errors+zt_machine_error("retained backing, allocator, and blocks cannot be released, escaped, or used outside checked accessors",context);}}
            .unsafe_=>|u|{if(zt_retained_control_has(u.body,s)==1||zt_retained_control_uses_blocks(u.body,blocks)==1){errors=errors+zt_machine_error("retained fixed-buffer lifecycle operations are forbidden inside unsafe or control-flow containers",context);}}
            .if_=>|x|{if(zt_retained_uses_live(x.cond,s)==1||zt_retained_uses_blocks(x.cond,blocks)==1||zt_retained_control_has(x.then_body,s)==1||zt_retained_control_has(x.els_body,s)==1||zt_retained_control_uses_blocks(x.then_body,blocks)==1||zt_retained_control_uses_blocks(x.els_body,blocks)==1){errors=errors+zt_machine_error("retained fixed-buffer lifecycle operations are forbidden inside unsafe or control-flow containers",context);}}
            .while_=>|x|{if(zt_retained_uses_live(x.cond,s)==1||zt_retained_uses_blocks(x.cond,blocks)==1||zt_retained_control_uses_blocks(x.body,blocks)==1||(zt_retained_control_has(x.body,s)==1&&zt_retained_reset_loop_safe(x.body,s)==0)){errors=errors+zt_machine_error("retained fixed-buffer lifecycle operations are forbidden inside unsafe or control-flow containers",context);}}
            .switch_=>|x|{if(zt_retained_uses_live(x.subject,s)==1||zt_retained_uses_blocks(x.subject,blocks)==1||zt_retained_control_has(x.els_body,s)==1||zt_retained_control_uses_blocks(x.els_body,blocks)==1){errors=errors+zt_machine_error("retained fixed-buffer lifecycle operations are forbidden inside unsafe or control-flow containers",context);}let ai:i32=0;while(ai<x.arms.len){if(zt_retained_control_has(x.arms.data[ai].body,s)==1||zt_retained_control_uses_blocks(x.arms.data[ai].body,blocks)==1){errors=errors+zt_machine_error("retained fixed-buffer lifecycle operations are forbidden inside unsafe or control-flow containers",context);}ai=ai+1;}}
            else=>{}
        }i=i+1;}
        if(s.phase==1){errors=errors+zt_machine_error("FixedBufferAllocator must be deinitialized before function exit",context);}
        free[ZTRetainedBlock](&blocks);
    }else=>{}}fi=fi+1;}return errors;
}

// ── edition-2027 stack-address return slice ───────────────────────────────
// Native lowering represents `&local` as an address in the current frame.
// Returning that address would therefore create a dangling pointer as soon as
// the callee returns. This deliberately bounded pass proves direct local and
// local-field addresses, direct aliases, and aggregate literals returned
// through pointer-carrying structs or unions. The mutation-aware named-
// container pass below owns aggregate aliases, field updates, and pass/store
// escapes. Together they still do not claim arbitrary heap-graph provenance,
// callback/global lifetime proof, or a complete lifetime system.
//
// A local whose lowered representation is already a pointer is excluded:
// cg_lower_addr deliberately evaluates `&p` for a pointer local as the pointer
// value that p denotes, not as the address of p's frame slot.
fn zt_stack_alias_root(aliases:ArrayList[ZTOwnAlias],name:[]u8)[]u8{let i:i32=0;while(i<aliases.len){if(@strEq(aliases.data[i].name,name)){return aliases.data[i].root;}i=i+1;}return "";}
fn zt_stack_local_has(locals:ArrayList[ZTBind],name:[]u8)i32{return (zt_env_get(locals,name).len>0) as i32;}
// Looking for an address anywhere inside a scalar return expression is
// unsound: `return p.*`, `return load(&x)`, and comparisons involving an
// address all return copied scalar values, not the frame address itself.
// Analyze raw pointers and aggregates whose declared representation can carry
// one. Aggregate fields are followed through named struct/union declarations;
// generic struct fields use the return type's explicit arguments. This is a
// type-directed gate for the escape walk, not a complete layout computation.
fn zt_stack_return_may_carry_address(ty0:[]u8,decls:ArrayList[*Node],depth:i32)i32{
    if(depth>16){return 1;}
    let ty:[]u8=ty0;
    while(ty.len>0&&(ty[0]=='!'||ty[0]=='?')){ty=ty[1..];}
    if(ty.len>0&&ty[0]=='*'){return 1;}
    if(zt_starts(ty,"[]")==1){return 1;}
    let base:[]u8=ty;
    let args:ArrayList[[]u8]=make[[]u8](0);
    if(is_generic_app(ty)){
        let lb:i32=zt_find(ty,'[');
        base=ty[0..lb];
        free[[]u8](&args);
        args=split_args(ty[lb+1..ty.len-1]);
    }
    let i:i32=0;
    while(i<decls.len){
        switch(decls.data[i].*){
            .struct_=>|s|{
                if(@strEq(s.name,base)){
                    let carries:i32=0;let fi:i32=0;
                    while(fi<s.fields.len&&carries==0){
                        let field_ty:[]u8=zt_subst_type(s.fields.data[fi].pty,s.tparams,args);
                        if(zt_stack_return_may_carry_address(field_ty,decls,depth+1)==1){carries=1;}
                        fi=fi+1;
                    }
                    free[[]u8](&args);
                    return carries;
                }
            }
            .union_=>|u|{
                if(@strEq(u.name,base)){
                    let carries:i32=0;let fi:i32=0;
                    while(fi<u.fields.len&&carries==0){
                        if(zt_stack_return_may_carry_address(u.fields.data[fi].pty,decls,depth+1)==1){carries=1;}
                        fi=fi+1;
                    }
                    free[[]u8](&args);
                    return carries;
                }
            }
            else=>{}
        }
        i=i+1;
    }
    free[[]u8](&args);
    return 0;
}
fn zt_stack_addressable_local_root(n:*Node,locals:ArrayList[ZTBind])[]u8{switch(n.*){
    .id=>|x|{if(zt_stack_local_has(locals,x.name)==1){return x.name;}}
    .cast_=>|x|{return zt_stack_addressable_local_root(x.expr,locals);}
    .fld=>|x|{return zt_stack_addressable_local_root(x.base,locals);}
    else=>{}
}return "";}
fn zt_stack_direct_address_root(n:*Node,locals:ArrayList[ZTBind],aliases:ArrayList[ZTOwnAlias])[]u8{switch(n.*){
    .id=>|x|{return zt_stack_alias_root(aliases,x.name);}
    .cast_=>|x|{return zt_stack_direct_address_root(x.expr,locals,aliases);}
    .un=>|x|{if(@strEq(x.op,"&")){return zt_stack_addressable_local_root(x.e,locals);}}
    else=>{}
}return "";}
fn zt_stack_pointer_value_type(ty0:[]u8)i32{let ty:[]u8=ty0;while(ty.len>0&&(ty[0]=='!'||ty[0]=='?')){ty=ty[1..];}return ((ty.len>0&&ty[0]=='*')||zt_starts(ty,"[]")==1) as i32;}
// Return expressions are searched recursively so a direct address cannot be
// hidden by a cast, aggregate literal, or an immediately returned call result.
// The latter is conservative: without an explicit non-escaping call contract,
// the compiler cannot prove that a returned call does not forward its argument.
fn zt_stack_return_address_root(n:*Node,locals:ArrayList[ZTBind],aliases:ArrayList[ZTOwnAlias],decls:ArrayList[*Node])[]u8{let direct:[]u8=zt_stack_direct_address_root(n,locals,aliases);if(direct.len>0){return direct;}switch(n.*){
    .bin=>|x|{let left:[]u8=zt_stack_return_address_root(x.l,locals,aliases,decls);if(left.len>0){return left;}return zt_stack_return_address_root(x.r,locals,aliases,decls);}
    .un=>|x|{return zt_stack_return_address_root(x.e,locals,aliases,decls);}
    .call=>|x|{let name:[]u8=zt_direct_name(x.callee);if(zt_fn_has_annot(decls,name,"@returns_owner")==1){return "";}let result_ty:[]u8=zt_instantiated_call_ret(decls,name,x.targs);if(zt_resource_type(result_ty,decls)==1&&zt_fn_first_retained_param(decls,name)<0){return "";}let callee:[]u8=zt_stack_return_address_root(x.callee,locals,aliases,decls);if(callee.len>0){return callee;}let i:i32=0;while(i<x.args.len){let root:[]u8=zt_stack_return_address_root(x.args.data[i],locals,aliases,decls);if(root.len>0){return root;}i=i+1;}}
    .idx=>|x|{let base:[]u8=zt_stack_return_address_root(x.base,locals,aliases,decls);if(base.len>0){return base;}return zt_stack_return_address_root(x.idx,locals,aliases,decls);}
    .fld=>|x|{return zt_stack_return_address_root(x.base,locals,aliases,decls);}
    .slice_=>|x|{let base:[]u8=zt_stack_return_address_root(x.base,locals,aliases,decls);if(base.len>0){return base;}let lo:[]u8=zt_stack_return_address_root(x.lo,locals,aliases,decls);if(lo.len>0){return lo;}if(x.has_hi==1){return zt_stack_return_address_root(x.hi,locals,aliases,decls);}}
    .slit_=>|x|{let i:i32=0;while(i<x.fields.len){let root:[]u8=zt_stack_return_address_root(x.fields.data[i].val,locals,aliases,decls);if(root.len>0){return root;}i=i+1;}}
    else=>{}
}return "";}
fn zt_check_stack_address_body(body:ArrayList[*Node],env:*ArrayList[ZTBind],locals:*ArrayList[ZTBind],aliases:*ArrayList[ZTOwnAlias],decls:ArrayList[*Node],context:[]u8)i32{
    let errors:i32=0;let i:i32=0;while(i<body.len){switch(body.data[i].*){
        .let_=>|l|{let ty:[]u8=l.dty;if(l.has_dty==0&&l.has_init==1){let inferred:ZTExpr=zt_expr_type(l.expr,env.*,decls,context);if(inferred.known==1){ty=inferred.ty;}}if(ty.len==0){ty="?";}if(l.has_init==1){let root:[]u8=zt_stack_direct_address_root(l.expr,locals.*,aliases.*);if(zt_stack_pointer_value_type(ty)==1||zt_stack_return_may_carry_address(ty,decls,0)==1){root=zt_stack_return_address_root(l.expr,locals.*,aliases.*,decls);}zt_alias_set(aliases,l.name,root);}push[ZTBind](env,ZTBind{.name=l.name,.ty=ty});if(ty[0]!='*'){push[ZTBind](locals,ZTBind{.name=l.name,.ty=ty});}}
        .assign=>|a|{let target:[]u8=zt_expr_transparent_id(a.target);if(target.len>0){let root:[]u8=zt_stack_direct_address_root(a.expr,locals.*,aliases.*);let target_ty:[]u8=zt_env_get(env.*,target);if(zt_stack_pointer_value_type(target_ty)==1||zt_stack_return_may_carry_address(target_ty,decls,0)==1){root=zt_stack_return_address_root(a.expr,locals.*,aliases.*,decls);}zt_alias_set(aliases,target,root);}}
        .ret=>|r|{if(r.has_expr==1){let root:[]u8=zt_stack_return_address_root(r.expr,locals.*,aliases.*,decls);if(root.len>0){errors=errors+zt_machine_error(_zag_str_concat("address of local `",_zag_str_concat(root,"` escapes through return")),context);}}}
        // unsafe is a lexical safety authority, not a lifetime escape hatch.
        // Keep the current dataflow state so an outer alias assigned inside the
        // block remains visible at the function return boundary.
        .unsafe_=>|u|{errors=errors+zt_check_stack_address_body(u.body,env,locals,aliases,decls,context);}
        .if_=>|x|{
            let base_env:ArrayList[ZTBind]=zt_env_clone(env.*);let base_locals:ArrayList[ZTBind]=zt_env_clone(locals.*);let base_aliases:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);
            let te:ArrayList[ZTBind]=zt_env_clone(base_env);let tl:ArrayList[ZTBind]=zt_env_clone(base_locals);let ta:ArrayList[ZTOwnAlias]=zt_alias_clone(base_aliases);
            errors=errors+zt_check_stack_address_body(x.then_body,&te,&tl,&ta,decls,context);
            let ee:ArrayList[ZTBind]=zt_env_clone(base_env);let el:ArrayList[ZTBind]=zt_env_clone(base_locals);let ea:ArrayList[ZTOwnAlias]=zt_alias_clone(base_aliases);
            if(x.has_els==1){errors=errors+zt_check_stack_address_body(x.els_body,&ee,&el,&ea,decls,context);}
            let next_aliases:ArrayList[ZTOwnAlias]=zt_alias_agree(ta,ea);
            free[ZTBind](&base_env);free[ZTBind](&base_locals);free[ZTOwnAlias](&base_aliases);
            free[ZTBind](&te);free[ZTBind](&tl);free[ZTOwnAlias](&ta);free[ZTBind](&ee);free[ZTBind](&el);free[ZTOwnAlias](&ea);
            zt_alias_replace(aliases,next_aliases);
        }
        .while_=>|x|{
            let base_env:ArrayList[ZTBind]=zt_env_clone(env.*);let base_locals:ArrayList[ZTBind]=zt_env_clone(locals.*);let base_aliases:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);
            let we:ArrayList[ZTBind]=zt_env_clone(base_env);let wl:ArrayList[ZTBind]=zt_env_clone(base_locals);let wa:ArrayList[ZTOwnAlias]=zt_alias_clone(base_aliases);
            errors=errors+zt_check_stack_address_body(x.body,&we,&wl,&wa,decls,context);
            let next_aliases:ArrayList[ZTOwnAlias]=zt_alias_agree(base_aliases,wa);
            free[ZTBind](&base_env);free[ZTBind](&base_locals);free[ZTOwnAlias](&base_aliases);
            free[ZTBind](&we);free[ZTBind](&wl);free[ZTOwnAlias](&wa);zt_alias_replace(aliases,next_aliases);
        }
        .switch_=>|x|{
            let base_env:ArrayList[ZTBind]=zt_env_clone(env.*);let base_locals:ArrayList[ZTBind]=zt_env_clone(locals.*);let base_aliases:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);
            let joined:ArrayList[ZTOwnAlias]=zt_alias_clone(base_aliases);let have:i32=0;let ai:i32=0;
            while(ai<x.arms.len){
                let ae:ArrayList[ZTBind]=zt_env_clone(base_env);let al:ArrayList[ZTBind]=zt_env_clone(base_locals);let aa:ArrayList[ZTOwnAlias]=zt_alias_clone(base_aliases);
                errors=errors+zt_check_stack_address_body(x.arms.data[ai].body,&ae,&al,&aa,decls,context);
                free[ZTBind](&ae);free[ZTBind](&al);
                if(have==0){free[ZTOwnAlias](&joined);joined=aa;have=1;}
                else{let next_aliases:ArrayList[ZTOwnAlias]=zt_alias_agree(joined,aa);free[ZTOwnAlias](&joined);free[ZTOwnAlias](&aa);joined=next_aliases;}
                ai=ai+1;
            }
            let ee:ArrayList[ZTBind]=zt_env_clone(base_env);let el:ArrayList[ZTBind]=zt_env_clone(base_locals);let ea:ArrayList[ZTOwnAlias]=zt_alias_clone(base_aliases);
            if(x.has_els==1){errors=errors+zt_check_stack_address_body(x.els_body,&ee,&el,&ea,decls,context);}
            free[ZTBind](&ee);free[ZTBind](&el);
            if(have==0){free[ZTOwnAlias](&joined);joined=ea;}
            else{let next_aliases:ArrayList[ZTOwnAlias]=zt_alias_agree(joined,ea);free[ZTOwnAlias](&joined);free[ZTOwnAlias](&ea);joined=next_aliases;}
            free[ZTBind](&base_env);free[ZTBind](&base_locals);free[ZTOwnAlias](&base_aliases);zt_alias_replace(aliases,joined);
        }
        else=>{}
    }i=i+1;}return errors;
}
fn zt_check_v2_stack_address_escapes(decls:ArrayList[*Node],file:[]u8)i32{
    if(@strEq(v2_project_edition(file),"2027")==0){return 0;}
    let errors:i32=0;let i:i32=0;
    while(i<decls.len){switch(decls.data[i].*){
        // Aggregate returns are checked by the field-sensitive provenance
        // pass below. Running this root-only walk for them would reject a
        // stale aggregate alias before an exact field overwrite can clear
        // the address. Keep this pass for direct pointer/slice returns, while
        // still using aggregate aliases inside those functions when a pointer
        // is extracted from a local aggregate.
        .fn_decl=>|f|{if(f.is_extern==0&&zt_stack_pointer_value_type(f.ret)==1){
            let context:[]u8=_zag_str_concat("function ",f.name);let env:ArrayList[ZTBind]=make[ZTBind](f.params.len+8);
            let pi:i32=0;while(pi<f.params.len){let p:Param=f.params.data[pi];push[ZTBind](&env,ZTBind{.name=p.name,.ty=p.pty});pi=pi+1;}
            let locals:ArrayList[ZTBind]=make[ZTBind](4);let aliases:ArrayList[ZTOwnAlias]=make[ZTOwnAlias](4);
            errors=errors+zt_check_stack_address_body(f.body,&env,&locals,&aliases,decls,context);
            free[ZTBind](&env);free[ZTBind](&locals);free[ZTOwnAlias](&aliases);
        }}
        else=>{}
    }i=i+1;}
    return errors;
}

// ── edition-2027 mutation-aware aggregate provenance ──────────────────────
// The direct ownership and stack-return passes above prove scalar names and
// aggregate literals.  This pass preserves those proven roots after they are
// stored in a named struct/union value. Provenance is attached to an interned
// field path so a field overwrite clears only that field, a value copy keeps
// an independent copy, and a whole-value overwrite clears the complete prior
// value. Paths are interned in a per-function arena and grow with the source
// expression, rather than imposing an arbitrary nesting cutoff.
//
// kind 1 is an owned allocation root; kind 2 is a current-frame address root;
// kind 3 is a parameter-local loan root carried through a pointer-bearing view.
// Elements are borrowed AST strings.  No source spelling is synthesized.
struct ZTAggPath {
    name: []u8,
    node: i32,
    depth: i32,
}
struct ZTAggPathNode { parent: i32, field: []u8 }
struct ZTAggProv { path: ZTAggPath, root: []u8, kind: i32, uncertain: i32 }
struct ZTAggFlow {
    prov: ArrayList[ZTAggProv],
    retained_roots: ArrayList[[]u8],
    mutable_roots: ArrayList[[]u8],
    return_ty: []u8,
    owners: ArrayList[[]u8],
    owner_aliases: ArrayList[ZTOwnAlias],
    freed: ArrayList[[]u8],
    moved: ArrayList[[]u8],
    env: ArrayList[ZTBind],
    locals: ArrayList[ZTBind],
    stack_aliases: ArrayList[ZTOwnAlias],
    containers: ArrayList[[]u8],
    bindings: ArrayList[[]u8],
}

fn zt_agg_empty_path()ZTAggPath{return ZTAggPath{.name="",.node=-1,.depth=0};}
fn zt_agg_root_path(name:[]u8)ZTAggPath{return ZTAggPath{.name=name,.node=-1,.depth=0};}
fn zt_agg_path_append(arena:*ArrayList[ZTAggPathNode],p0:ZTAggPath,field:[]u8)ZTAggPath{
    let p:ZTAggPath=p0;
    if(p.name.len==0){return p;}
    let i:i32=0;while(i<arena.*.len){let x:ZTAggPathNode=arena.*.data[i];if(x.parent==p.node&&@strEq(x.field,field)){p.node=i;p.depth=p.depth+1;return p;}i=i+1;}
    push[ZTAggPathNode](arena,ZTAggPathNode{.parent=p.node,.field=field});p.node=arena.*.len-1;p.depth=p.depth+1;
    return p;
}
fn zt_agg_expr_path(n:*Node,arena:*ArrayList[ZTAggPathNode])ZTAggPath{
    switch(n.*){
        .id=>|x|{return zt_agg_root_path(x.name);}
        .cast_=>|x|{return zt_agg_expr_path(x.expr,arena);}
        .un=>|x|{return zt_agg_expr_path(x.e,arena);}
        .fld=>|x|{return zt_agg_path_append(arena,zt_agg_expr_path(x.base,arena),x.fname);}
        // An element aliases storage beneath its base but is not the base's
        // ownership slot.  Collapsing `list.data[i]` to `list.data` made an
        // ordinary scalar element write look like replacement of the list's
        // live allocation capability.  A wildcard component preserves the
        // conservative overlap while keeping terminal identity distinct.
        .idx=>|x|{return zt_agg_path_append(arena,zt_agg_expr_path(x.base,arena),"[]");}
        .slice_=>|x|{return zt_agg_path_append(arena,zt_agg_expr_path(x.base,arena),"[]");}
        else=>{}
    }
    return zt_agg_empty_path();
}
fn zt_agg_path_prefix(arena:ArrayList[ZTAggPathNode],a:ZTAggPath,b:ZTAggPath)i32{
    if(a.name.len==0||b.name.len==0||@strEq(a.name,b.name)==0||a.depth>b.depth){return 0;}
    let bn:i32=b.node;let skip:i32=b.depth-a.depth;let i:i32=0;while(i<skip){bn=arena.data[bn].parent;i=i+1;}
    let an:i32=a.node;while(an>=0&&bn>=0){if(@strEq(arena.data[an].field,arena.data[bn].field)==0){return 0;}an=arena.data[an].parent;bn=arena.data[bn].parent;}
    if(an!=bn){return 0;}
    return 1;
}
fn zt_agg_path_equal(arena:ArrayList[ZTAggPathNode],a:ZTAggPath,b:ZTAggPath)i32{
    if(a.depth!=b.depth){return 0;}
    return zt_agg_path_prefix(arena,a,b);
}
fn zt_agg_prov_clone(src:ArrayList[ZTAggProv])ArrayList[ZTAggProv]{let out:ArrayList[ZTAggProv]=make[ZTAggProv](src.len+1);let i:i32=0;while(i<src.len){push[ZTAggProv](&out,src.data[i]);i=i+1;}return out;}
fn zt_agg_prov_has(dst:ArrayList[ZTAggProv],x:ZTAggProv,arena:ArrayList[ZTAggPathNode])i32{let i:i32=0;while(i<dst.len){let y:ZTAggProv=dst.data[i];if(y.kind==x.kind&&y.uncertain==x.uncertain&&@strEq(y.root,x.root)&&zt_agg_path_equal(arena,y.path,x.path)==1){return 1;}i=i+1;}return 0;}
fn zt_agg_prov_merge(dst:*ArrayList[ZTAggProv],src:ArrayList[ZTAggProv],arena:ArrayList[ZTAggPathNode])void{let i:i32=0;while(i<src.len){if(zt_agg_prov_has(dst.*,src.data[i],arena)==0){push[ZTAggProv](dst,src.data[i]);}i=i+1;}}
fn zt_agg_prov_replace(dst:*ArrayList[ZTAggProv],next:ArrayList[ZTAggProv])void{free[ZTAggProv](dst);dst.*=next;}
fn zt_agg_prov_clear(prov:*ArrayList[ZTAggProv],target:ZTAggPath,arena:ArrayList[ZTAggPathNode])void{
    if(target.name.len==0){return;}
    let i:i32=0;
    while(i<prov.*.len){
        let entry:ZTAggProv=prov.*.data[i];
        if(zt_agg_path_prefix(arena,target,entry.path)==1){
            let j:i32=i;while(j+1<prov.*.len){prov.*.data[j]=prov.*.data[j+1];j=j+1;}prov.*.len=prov.*.len-1;
        }else{i=i+1;}
    }
}
fn zt_agg_prov_root(prov:ArrayList[ZTAggProv],path:ZTAggPath,kind:i32,arena:ArrayList[ZTAggPathNode])[]u8{
    if(path.name.len==0){return "";}
    let i:i32=0;while(i<prov.len){let x:ZTAggProv=prov.data[i];if(x.kind==kind&&(zt_agg_path_prefix(arena,path,x.path)==1||zt_agg_path_prefix(arena,x.path,path)==1)){return x.root;}i=i+1;}return "";
}
fn zt_agg_expr_stored_root(n:*Node,prov:ArrayList[ZTAggProv],kind:i32,arena:*ArrayList[ZTAggPathNode])[]u8{
    let path:ZTAggPath=zt_agg_expr_path(n,arena);let direct:[]u8=zt_agg_prov_root(prov,path,kind,arena.*);if(direct.len>0){return direct;}
    switch(n.*){
        .bin=>|x|{let l:[]u8=zt_agg_expr_stored_root(x.l,prov,kind,arena);if(l.len>0){return l;}return zt_agg_expr_stored_root(x.r,prov,kind,arena);}
        .un=>|x|{return zt_agg_expr_stored_root(x.e,prov,kind,arena);}
        // Call arguments are not part of a result unless the callee declares
        // a return relation. zt_agg_write_expr handles retained-return calls.
        .call=>|x|{}
        .idx=>|x|{let b:[]u8=zt_agg_expr_stored_root(x.base,prov,kind,arena);if(b.len>0){return b;}return zt_agg_expr_stored_root(x.idx,prov,kind,arena);}
        .slice_=>|x|{let b:[]u8=zt_agg_expr_stored_root(x.base,prov,kind,arena);if(b.len>0){return b;}let lo:[]u8=zt_agg_expr_stored_root(x.lo,prov,kind,arena);if(lo.len>0){return lo;}if(x.has_hi==1){return zt_agg_expr_stored_root(x.hi,prov,kind,arena);}}
        .slit_=>|x|{let i:i32=0;while(i<x.fields.len){let root:[]u8=zt_agg_expr_stored_root(x.fields.data[i].val,prov,kind,arena);if(root.len>0){return root;}i=i+1;}}
        else=>{}
    }
    return "";
}
fn zt_agg_expr_has_stored_root(n:*Node,prov:ArrayList[ZTAggProv],kind:i32,wanted:[]u8,arena:*ArrayList[ZTAggPathNode])i32{
    let path:ZTAggPath=zt_agg_expr_path(n,arena);
    if(path.name.len>0){let i:i32=0;while(i<prov.len){let x:ZTAggProv=prov.data[i];if(x.kind==kind&&@strEq(x.root,wanted)&&(zt_agg_path_prefix(arena.*,path,x.path)==1||zt_agg_path_prefix(arena.*,x.path,path)==1)){return 1;}i=i+1;}}
    switch(n.*){
        .bin=>|x|{return zt_agg_expr_has_stored_root(x.l,prov,kind,wanted,arena)|zt_agg_expr_has_stored_root(x.r,prov,kind,wanted,arena);}
        .un=>|x|{return zt_agg_expr_has_stored_root(x.e,prov,kind,wanted,arena);}
        .call=>|x|{}
        .idx=>|x|{return zt_agg_expr_has_stored_root(x.base,prov,kind,wanted,arena)|zt_agg_expr_has_stored_root(x.idx,prov,kind,wanted,arena);}
        .slice_=>|x|{if(zt_agg_expr_has_stored_root(x.base,prov,kind,wanted,arena)==1||zt_agg_expr_has_stored_root(x.lo,prov,kind,wanted,arena)==1){return 1;}if(x.has_hi==1){return zt_agg_expr_has_stored_root(x.hi,prov,kind,wanted,arena);}}
        .slit_=>|x|{let i:i32=0;while(i<x.fields.len){if(zt_agg_expr_has_stored_root(x.fields.data[i].val,prov,kind,wanted,arena)==1){return 1;}i=i+1;}}
        else=>{}
    }
    return 0;
}
fn zt_agg_return_expr_has_root(n:*Node,flow:ZTAggFlow,wanted:[]u8,decls:ArrayList[*Node],arena:*ArrayList[ZTAggPathNode])i32{
    // An indexed expression loads the value stored in an element; it does not
    // return an address into the borrowed container.  Keep the aggregate loan
    // rule for direct fields and explicit address-of projections, but do not
    // reject a pointer-valued element read such as
    // `source.*.data[last]`.  Casts and `try` wrappers preserve this distinction
    // by unwrapping before the path check.  An address-of wrapper falls through
    // so `&source[idx]` remains tied to the container and is rejected.
    switch(n.*){
        .idx=>|_|{return 0;}
        .cast_=>|x|{return zt_agg_return_expr_has_root(x.expr,flow,wanted,decls,arena);}
        .un=>|x|{if(!@strEq(x.op,"&")){return zt_agg_return_expr_has_root(x.e,flow,wanted,decls,arena);}}
        else=>{}
    }
    // A pointer-bearing aggregate may contain ordinary scalar fields copied
    // from a borrowed input.  Those scalar loads do not retain the input's
    // backing storage and must not make a freshly constructed aggregate look
    // like a returned view.  Keep the conservative path test for values that
    // can actually carry a borrow (pointers, slices, or pointer-bearing
    // aggregates), while scalar fields remain ordinary value snapshots.
    let value:ZTExpr=zt_expr_type(n,flow.env,decls,"");
    if(value.known==1&&zt_type_carries_borrow(value.ty,decls,0)==0){return 0;}
    let path:ZTAggPath=zt_agg_expr_path(n,arena);if(path.name.len>0&&zt_agg_expr_has_stored_root(n,flow.prov,3,wanted,arena)==1){return 1;}
    switch(n.*){
        .call=>|x|{let name:[]u8=zt_direct_name(x.callee);let i:i32=0;while(i<x.args.len){if((@strEq(zt_fn_param_contract(decls,name,i),"@retained_by_return")||zt_fn_inferred_retained_param(decls,name,i)==1)&&zt_agg_expr_has_stored_root(x.args.data[i],flow.prov,3,wanted,arena)==1){return 1;}i=i+1;}if(zt_fn_has_legacy_borrow(decls,name)==1&&x.args.len>0){return zt_agg_expr_has_stored_root(x.args.data[0],flow.prov,3,wanted,arena);}}
        .cast_=>|x|{return zt_agg_return_expr_has_root(x.expr,flow,wanted,decls,arena);}
        .un=>|x|{return zt_agg_return_expr_has_root(x.e,flow,wanted,decls,arena);}
        .slit_=>|x|{
            let i:i32=0;
            while(i<x.fields.len){
                // A pointer-bearing result may still contain scalar snapshots
                // read from a borrowed input.  Resolve the destination field
                // type independently of the expression's incomplete/unknown
                // type so a scalar field cannot taint the whole aggregate.
                let field_ty:[]u8=zt_aggregate_field_type(flow.return_ty,x.fields.data[i].name,decls);
                if(field_ty.len>0&&zt_type_carries_borrow(field_ty,decls,0)==0){}
                else if(zt_agg_return_expr_has_root(x.fields.data[i].val,flow,wanted,decls,arena)==1){return 1;}
                i=i+1;
            }
        }
        .bin=>|x|{return zt_agg_return_expr_has_root(x.l,flow,wanted,decls,arena)|zt_agg_return_expr_has_root(x.r,flow,wanted,decls,arena);}
        else=>{}
    }
    return 0;
}
fn zt_agg_return_loan_error(n:*Node,flow:ZTAggFlow,decls:ArrayList[*Node],context:[]u8,arena:*ArrayList[ZTAggPathNode])i32{
    let i:i32=0;while(i<flow.prov.len){let entry:ZTAggProv=flow.prov.data[i];
        if(entry.kind==3&&zt_agg_return_expr_has_root(n,flow,entry.root,decls,arena)==1&&zt_in_names(flow.retained_roots,entry.root)==0){
            return zt_machine_error(_zag_str_concat("parameter-local borrowed view cannot escape through return (root `",_zag_str_concat(entry.root,"`)")),context);
        }
        i=i+1;
    }
    return 0;
}
fn zt_agg_type_is_value(ty:[]u8,decls:ArrayList[*Node])i32{
    if(ty.len==0||ty[0]=='*'||ty[0]=='?'||ty[0]=='!'||zt_starts(ty,"[]")==1){return 0;}
    let base:[]u8=ty;if(is_generic_app(ty)){let lb:i32=zt_find(ty,'[');base=ty[0..lb];}
    let i:i32=0;while(i<decls.len){switch(decls.data[i].*){.struct_=>|s|{if(@strEq(s.name,base)){return 1;}}.union_=>|u|{if(@strEq(u.name,base)){return 1;}}else=>{}}i=i+1;}
    return 0;
}
fn zt_agg_add_entry(prov:*ArrayList[ZTAggProv],path:ZTAggPath,root:[]u8,kind:i32,uncertain:i32,arena:ArrayList[ZTAggPathNode])void{
    if(path.name.len==0||root.len==0){return;}
    let x:ZTAggProv=ZTAggProv{.path=path,.root=root,.kind=kind,.uncertain=uncertain};
    if(zt_agg_prov_has(prov.*,x,arena)==0){push[ZTAggProv](prov,x);}
}
fn zt_agg_remap_suffix(arena:*ArrayList[ZTAggPathNode],src_depth:i32,node:i32,depth:i32,dst0:ZTAggPath)ZTAggPath{
    let dst:ZTAggPath=dst0;
    if(depth<=src_depth||node<0){return dst;}
    let item:ZTAggPathNode=arena.*.data[node];
    dst=zt_agg_remap_suffix(arena,src_depth,item.parent,depth-1,dst);
    return zt_agg_path_append(arena,dst,item.field);
}
fn zt_agg_remap_path(arena:*ArrayList[ZTAggPathNode],src:ZTAggPath,dst:ZTAggPath,value:ZTAggPath)ZTAggPath{
    let out:ZTAggPath=zt_agg_remap_suffix(arena,src.depth,value.node,value.depth,dst);
    return out;
}
fn zt_agg_root_is_allocation(flow:ZTAggFlow,root:[]u8)i32{return @strEq(zt_env_get(flow.env,root),"Allocation") as i32;}
fn zt_agg_acquires_owner(n:*Node,ty:[]u8,decls:ArrayList[*Node],sums:ArrayList[ZTOwnSummary])i32{
    // Structural resources have their own exact field slots.  Seeding the
    // aggregate-allocation lattice as well invents a second whole-value owner.
    if(zt_resource_type(ty,decls)==0&&zt_owned_acquire_name(n,sums).len>0){return 1;}
    if(@strEq(ty,"Allocation")&&(zt_allocation_mint_expr(n,decls)==1||zt_allocation_helper_expr(n,decls)==1)){return 1;}
    return 0;
}
fn zt_agg_write_expr(flow:*ZTAggFlow,target:ZTAggPath,n:*Node,old:ArrayList[ZTAggProv],decls:ArrayList[*Node],sums:ArrayList[ZTOwnSummary],context:[]u8,arena:*ArrayList[ZTAggPathNode])i32{
    let errors:i32=0;
    let source:ZTAggPath=zt_agg_expr_path(n,arena);
    let value:ZTExpr=zt_expr_type(n,flow.*.env,decls,context);
    let carries_loan:i32=(value.known==0||zt_type_carries_borrow(value.ty,decls,0)==1) as i32;
    if(source.name.len>0){
        let i:i32=0;while(i<old.len){let x:ZTAggProv=old.data[i];if(zt_agg_path_prefix(arena.*,source,x.path)==1){
            if(x.kind==3&&carries_loan==0){}
            else if(x.kind==2&&carries_loan==0){}
            else if(x.kind==1&&zt_agg_root_is_allocation(flow.*,x.root)==1&&zt_agg_path_equal(arena.*,source,target)==0){errors=errors+zt_machine_error("Allocation aggregate copy is not allowed; transfer the capability through an explicit consuming boundary",context);}
            else{zt_agg_add_entry(&flow.*.prov,zt_agg_remap_path(arena,source,target,x.path),x.root,x.kind,x.uncertain,arena.*);}
        }else if(x.kind==3&&carries_loan==1&&zt_agg_path_prefix(arena.*,x.path,source)==1){
            zt_agg_add_entry(&flow.*.prov,target,x.root,3,x.uncertain,arena.*);
        }i=i+1;}
    }
    switch(n.*){
        .cast_=>|x|{errors=errors+zt_agg_write_expr(flow,target,x.expr,old,decls,sums,context,arena);}
        .un=>|x|{
            // Preserve the address-of node while recording aggregate stack
            // provenance. Descending straight to `x.e` loses the only
            // lifetime-bearing operation, so `Box{.ptr = &x}` used to be
            // recorded only at the aggregate root. A later `box.ptr = null`
            // could then clear no entry and produce a false return escape.
            if(@strEq(x.op,"&")){let stack:[]u8=zt_stack_direct_address_root(n,flow.*.locals,flow.*.stack_aliases);if(stack.len>0){zt_agg_add_entry(&flow.*.prov,target,stack,2,0,arena.*);}}
            else{errors=errors+zt_agg_write_expr(flow,target,x.e,old,decls,sums,context,arena);}
        }
        .slice_=>|x|{errors=errors+zt_agg_write_expr(flow,target,x.base,old,decls,sums,context,arena);}
        .slit_=>|x|{let i:i32=0;while(i<x.fields.len){errors=errors+zt_agg_write_expr(flow,zt_agg_path_append(arena,target,x.fields.data[i].name),x.fields.data[i].val,old,decls,sums,context,arena);i=i+1;}}
        .call=>|x|{
            // A retained-return contract ties the complete result value to
            // every annotated input. The public relation intentionally does
            // not guess a result field: overwriting the whole result clears
            // the loan, while a partial overwrite remains conservative.
            let name:[]u8=zt_direct_name(x.callee);let ai:i32=0;
            while(ai<x.args.len){if(@strEq(zt_fn_param_contract(decls,name,ai),"@retained_by_return")||zt_fn_inferred_retained_param(decls,name,ai)==1||
                (ai==0&&zt_fn_has_legacy_borrow(decls,name)==1&&zt_type_carries_borrow(zt_instantiated_call_ret(decls,name,x.targs),decls,0)==1)){
                let pi:i32=0;while(pi<old.len){let entry:ZTAggProv=old.data[pi];if(entry.kind==3&&zt_agg_expr_has_stored_root(x.args.data[ai],old,3,entry.root,arena)==1){zt_agg_add_entry(&flow.*.prov,target,entry.root,3,entry.uncertain,arena.*);}pi=pi+1;}
            }ai=ai+1;}
        }
        else=>{
            let owner:[]u8=zt_owned_expr_root(n,flow.*.owners,flow.*.owner_aliases);
            if(owner.len>0){
                zt_agg_add_entry(&flow.*.prov,target,owner,1,0,arena.*);
                if(target.depth>0&&zt_agg_root_is_allocation(flow.*,owner)==1&&zt_in_names(flow.*.moved,owner)==0){push[[]u8](&flow.*.moved,owner);}
            }
            // Field assignments may arrive through casts or an explicit
            // address-of expression. The direct alias helper intentionally
            // handles only transparent aliases; use the return-address
            // walker as the aggregate fallback so `box.ptr = &local` is
            // recorded even when the assigned value is wrapped.
            let stack:[]u8="";
            // Scalar snapshots cannot retain a frame address. Avoid walking
            // their complete expression tree; pointer-bearing aggregates and
            // unknown expressions still receive the conservative escape walk.
            if(value.known==0||zt_type_carries_borrow(value.ty,decls,0)==1){
                stack=zt_stack_direct_address_root(n,flow.*.locals,flow.*.stack_aliases);
                if(stack.len==0){stack=zt_stack_return_address_root(n,flow.*.locals,flow.*.stack_aliases,decls);}
            }
            if(stack.len>0){zt_agg_add_entry(&flow.*.prov,target,stack,2,0,arena.*);}
            if(target.depth>0&&zt_resource_type(value.ty,decls)==0&&zt_owned_acquire_name(n,sums).len>0){
                zt_agg_add_entry(&flow.*.prov,target,"<unnamed-aggregate-owner>",1,1,arena.*);
                errors=errors+zt_machine_error("owned allocation stored in an aggregate requires a named owner binding",context);
            }
        }
    }
    return errors;
}
fn zt_agg_assign_value(flow:*ZTAggFlow,target:ZTAggPath,n:*Node,decls:ArrayList[*Node],sums:ArrayList[ZTOwnSummary],context:[]u8,arena:*ArrayList[ZTAggPathNode])i32{
    let old:ArrayList[ZTAggProv]=zt_agg_prov_clone(flow.*.prov);
    zt_agg_prov_clear(&flow.*.prov,target,arena.*);
    let value:ZTExpr=zt_expr_type(n,flow.*.env,decls,context);
    // A raw stack address is lifetime-bearing even when the nominal pointer
    // type is not classified as a borrowed view. Keep the provenance walk
    // active for that exact expression so a field assignment such as
    // `box.ptr = &local` cannot evade the aggregate return/call checks.
    let stack:[]u8="";
    // Stack-address propagation is narrower than general expression
    // provenance: a freshly returned aggregate may contain a scalar snapshot
    // copied from a borrowed source without carrying that source's frame
    // address. The existing pointer-bearing type classifier is sufficient for
    // this distinction and avoids a second recursive type walk in the
    // aggregate-assignment hot path.
    let carries_address:i32=0;
    if(value.known==0||zt_type_carries_borrow(value.ty,decls,0)==1){
        stack=zt_stack_return_address_root(n,flow.*.locals,flow.*.stack_aliases,decls);
        if(stack.len>0){carries_address=1;}
    }
    if(value.known==1&&carries_address==0&&stack.len==0){free[ZTAggProv](&old);return 0;}
    let errors:i32=zt_agg_write_expr(flow,target,n,old,decls,sums,context,arena);
    // Compound literals are walked field-by-field above. Only retain the
    // coarse target entry when that walk did not already capture a precise
    // stack-bearing field; otherwise a later field clear cannot remove the
    // root entry without incorrectly discarding sibling provenance.
    if(stack.len>0&&carries_address==1&&zt_agg_prov_root(flow.*.prov,target,2,arena.*).len==0){zt_agg_add_entry(&flow.*.prov,target,stack,2,0,arena.*);}
    free[ZTAggProv](&old);
    return errors;
}
fn zt_agg_flow_new(cap:i32)ZTAggFlow{return ZTAggFlow{
    .prov=make[ZTAggProv](cap),.retained_roots=make[[]u8](cap),.mutable_roots=make[[]u8](cap),.return_ty="",.owners=make[[]u8](cap),.owner_aliases=make[ZTOwnAlias](cap),.freed=make[[]u8](cap),.moved=make[[]u8](cap),
    .env=make[ZTBind](cap),.locals=make[ZTBind](cap),.stack_aliases=make[ZTOwnAlias](cap),.containers=make[[]u8](cap),.bindings=make[[]u8](cap),
};}
fn zt_agg_flow_clone(src:ZTAggFlow)ZTAggFlow{return ZTAggFlow{
    .prov=zt_agg_prov_clone(src.prov),.retained_roots=zt_names_clone(src.retained_roots),.mutable_roots=zt_names_clone(src.mutable_roots),.return_ty=src.return_ty,.owners=zt_names_clone(src.owners),.owner_aliases=zt_alias_clone(src.owner_aliases),.freed=zt_names_clone(src.freed),.moved=zt_names_clone(src.moved),
    .env=zt_env_clone(src.env),.locals=zt_env_clone(src.locals),.stack_aliases=zt_alias_clone(src.stack_aliases),.containers=zt_names_clone(src.containers),.bindings=zt_names_clone(src.bindings),
};}
fn zt_agg_flow_free(flow:*ZTAggFlow)void{
    free[ZTAggProv](&flow.*.prov);free[[]u8](&flow.*.retained_roots);free[[]u8](&flow.*.mutable_roots);free[[]u8](&flow.*.owners);free[ZTOwnAlias](&flow.*.owner_aliases);free[[]u8](&flow.*.freed);free[[]u8](&flow.*.moved);
    free[ZTBind](&flow.*.env);free[ZTBind](&flow.*.locals);free[ZTOwnAlias](&flow.*.stack_aliases);free[[]u8](&flow.*.containers);free[[]u8](&flow.*.bindings);
}
fn zt_agg_flow_join(base:ZTAggFlow,a:ZTAggFlow,b:ZTAggFlow,arena:ArrayList[ZTAggPathNode])ZTAggFlow{
    let out:ZTAggFlow=zt_agg_flow_clone(base);
    let prov:ArrayList[ZTAggProv]=make[ZTAggProv](a.prov.len+b.prov.len+1);zt_agg_prov_merge(&prov,a.prov,arena);zt_agg_prov_merge(&prov,b.prov,arena);zt_agg_prov_replace(&out.prov,prov);
    let owners:ArrayList[[]u8]=make[[]u8](a.owners.len+b.owners.len+1);zt_names_merge(&owners,a.owners);zt_names_merge(&owners,b.owners);zt_names_replace(&out.owners,owners);
    let freed:ArrayList[[]u8]=make[[]u8](a.freed.len+b.freed.len+1);zt_names_merge(&freed,a.freed);zt_names_merge(&freed,b.freed);zt_names_replace(&out.freed,freed);
    let moved:ArrayList[[]u8]=make[[]u8](a.moved.len+b.moved.len+1);zt_names_merge(&moved,a.moved);zt_names_merge(&moved,b.moved);zt_names_replace(&out.moved,moved);
    let owner_aliases:ArrayList[ZTOwnAlias]=zt_alias_agree(a.owner_aliases,b.owner_aliases);zt_alias_replace(&out.owner_aliases,owner_aliases);
    let stack_aliases:ArrayList[ZTOwnAlias]=zt_alias_agree(a.stack_aliases,b.stack_aliases);zt_alias_replace(&out.stack_aliases,stack_aliases);
    return out;
}
fn zt_agg_flow_replace(dst:*ZTAggFlow,next:ZTAggFlow)void{zt_agg_flow_free(dst);dst.*=next;}
fn zt_agg_check_freed_expr(n:*Node,flow:ZTAggFlow,context:[]u8,arena:*ArrayList[ZTAggPathNode])i32{
    let errors:i32=0;let i:i32=0;
    while(i<flow.freed.len){let root:[]u8=flow.freed.data[i];if(root.len>0&&(zt_agg_expr_has_stored_root(n,flow.prov,1,root,arena)==1||zt_expr_uses_name(n,root,flow.owner_aliases)==1)){
        if(zt_agg_root_is_allocation(flow,root)==1){errors=errors+zt_machine_error("use after consumed SystemAllocator handle",context);}
        else{errors=errors+zt_machine_error(_zag_str_concat("use after free of named allocation `",_zag_str_concat(root,"`")),context);}
    }i=i+1;}
    i=0;while(i<flow.moved.len){let root:[]u8=flow.moved.data[i];if(root.len>0&&zt_in_names(flow.freed,root)==0&&zt_expr_uses_name(n,root,flow.owner_aliases)==1){errors=errors+zt_machine_error("use after moved Allocation handle",context);}i=i+1;}
    return errors;
}
fn zt_agg_mark_released(flow:*ZTAggFlow,root:[]u8)void{if(root.len==0){return;}if(zt_in_names(flow.*.freed,root)==0){push[[]u8](&flow.*.freed,root);}zt_names_remove(&flow.*.owners,root);}
fn zt_agg_exact_consumable_root(prov:ArrayList[ZTAggProv],path:ZTAggPath,arena:ArrayList[ZTAggPathNode])[]u8{
    if(path.name.len==0||path.depth==0){return "";}
    let root:[]u8="";let found:i32=0;let i:i32=0;
    while(i<prov.len){let x:ZTAggProv=prov.data[i];if(x.kind==1&&(zt_agg_path_prefix(arena,path,x.path)==1||zt_agg_path_prefix(arena,x.path,path)==1)){
        if(x.uncertain==1||zt_agg_path_equal(arena,path,x.path)==0){return "";}
        if(found==1&&@strEq(root,x.root)==0){return "";}root=x.root;found=1;
    }i=i+1;}
    return root;
}
fn zt_agg_check_calls(n:*Node,flow:*ZTAggFlow,decls:ArrayList[*Node],context:[]u8,arena:*ArrayList[ZTAggPathNode])i32{
    let errors:i32=0;
    switch(n.*){
        .call=>|c|{
            let ai:i32=0;while(ai<c.args.len){errors=errors+zt_agg_check_calls(c.args.data[ai],flow,decls,context,arena);ai=ai+1;}
            let name:[]u8=zt_direct_name(c.callee);let nonretaining:i32=(zt_compiler_nonretaining_call(name)==1||@strEq(name,"_zag_realloc")||@strEq(name,"_zag_slice_ptr")) as i32;let allocator_consume:i32=0;switch(c.callee.*){.fld=>|f|{
                if((@strEq(f.fname,"deallocate")&&c.args.len==1)||(@strEq(f.fname,"resize")&&c.args.len==3)){allocator_consume=1;}
            }else=>{}}
            ai=0;while(ai<c.args.len){
                let borrow:i32=zt_param_borrow_mode(decls,name,ai);
                let consumes:i32=(((zt_owned_release_name(name)==1&&ai==0)||(allocator_consume==1&&ai==0)||zt_consumes_param(decls,name,ai)==1) as i32);
                let owner:[]u8=zt_agg_expr_stored_root(c.args.data[ai],flow.*.prov,1,arena);
                let arg_value:ZTExpr=zt_expr_type(c.args.data[ai],flow.*.env,decls,context);
                // A scalar field extracted from a pointer-bearing aggregate
                // is an exact value snapshot, not a stack address. Only
                // unknown or pointer-bearing arguments may inherit stack
                // provenance from their enclosing aggregate path.
                let stack:[]u8="";
                if(arg_value.known==0||zt_type_carries_borrow(arg_value.ty,decls,0)==1){
                    stack=zt_agg_expr_stored_root(c.args.data[ai],flow.*.prov,2,arena);
                }
                let loan:[]u8="";
                if(arg_value.known==0||zt_type_carries_borrow(arg_value.ty,decls,0)==1){loan=zt_agg_expr_stored_root(c.args.data[ai],flow.*.prov,3,arena);}
                let scalar_only:i32=0;
                if(owner.len>0||stack.len>0||loan.len>0){scalar_only=zt_callee_param_scalar_only(decls,name,ai);}
                if(owner.len>0){
                    if(consumes==1&&c.args.len>0){
                        let path:ZTAggPath=zt_agg_expr_path(c.args.data[ai],arena);
                        let exact:[]u8=zt_agg_exact_consumable_root(flow.*.prov,path,arena.*);
                        if(exact.len>0){
                            if(zt_in_names(flow.*.freed,exact)==1){errors=errors+zt_machine_error("double free of aggregate-stored allocation",context);}else{zt_agg_mark_released(flow,exact);}
                        }else{errors=errors+zt_machine_error(_zag_str_concat("aggregate ownership transfer is not explicit (root `",_zag_str_concat(owner,"`)")),context);}
                    }else if(borrow==0&&nonretaining==0){
                        let shown:[]u8=name;if(shown.len==0){shown="<indirect>";}
                        errors=errors+zt_machine_error(_zag_str_concat("owned allocation escapes through uncontracted call `",_zag_str_concat(shown,_zag_str_concat("` (root `",_zag_str_concat(owner,"`)")))),context);
                    }
                }
                if(stack.len>0&&borrow==0&&nonretaining==0){
                    let shown:[]u8=name;if(shown.len==0){shown="<indirect>";}
                    errors=errors+zt_machine_error(_zag_str_concat("address of local `",_zag_str_concat(stack,_zag_str_concat("` escapes through aggregate argument to uncontracted call `",_zag_str_concat(shown,"`")))),context);
                }
                if(loan.len>0){
                    if(consumes==1){if(zt_in_names(flow.*.mutable_roots,loan)==0){errors=errors+zt_machine_error(_zag_str_concat("cannot pass a borrowed view to a consuming call (root `",_zag_str_concat(loan,"`)")),context);}}
                    else if(borrow==0&&nonretaining==0){let shown:[]u8=name;if(shown.len==0){shown="<indirect>";}errors=errors+zt_machine_error(_zag_str_concat("borrowed view `",_zag_str_concat(loan,_zag_str_concat("` escapes through uncontracted call `",_zag_str_concat(shown,"`")))),context);}
                }
                ai=ai+1;
            }
            ai=0;while(ai<c.args.len){
                let consumes:i32=(((zt_owned_release_name(name)==1&&ai==0)||(allocator_consume==1&&ai==0)||zt_consumes_param(decls,name,ai)==1) as i32);
                if(consumes==1){let direct:[]u8=zt_owned_expr_root(c.args.data[ai],flow.*.owners,flow.*.owner_aliases);if(direct.len>0){if(zt_in_names(flow.*.freed,direct)==1){errors=errors+zt_machine_error("use after consumed SystemAllocator handle",context);}else{zt_agg_mark_released(flow,direct);}}}
                ai=ai+1;
            }
        }
        .bin=>|x|{errors=errors+zt_agg_check_calls(x.l,flow,decls,context,arena)+zt_agg_check_calls(x.r,flow,decls,context,arena);}
        .un=>|x|{errors=errors+zt_agg_check_calls(x.e,flow,decls,context,arena);}
        .idx=>|x|{errors=errors+zt_agg_check_calls(x.base,flow,decls,context,arena)+zt_agg_check_calls(x.idx,flow,decls,context,arena);}
        .fld=>|x|{errors=errors+zt_agg_check_calls(x.base,flow,decls,context,arena);}
        .cast_=>|x|{errors=errors+zt_agg_check_calls(x.expr,flow,decls,context,arena);}
        .slice_=>|x|{errors=errors+zt_agg_check_calls(x.base,flow,decls,context,arena)+zt_agg_check_calls(x.lo,flow,decls,context,arena);if(x.has_hi==1){errors=errors+zt_agg_check_calls(x.hi,flow,decls,context,arena);}}
        .slit_=>|x|{let i:i32=0;while(i<x.fields.len){errors=errors+zt_agg_check_calls(x.fields.data[i].val,flow,decls,context,arena);i=i+1;}}
        else=>{}
    }
    return errors;
}
fn zt_agg_nonlocal_store(n:*Node,target:ZTAggPath,flow:ZTAggFlow,decls:ArrayList[*Node],sums:ArrayList[ZTOwnSummary],context:[]u8,arena:*ArrayList[ZTAggPathNode])i32{
    let value:ZTExpr=zt_expr_type(n,flow.env,decls,context);
    if(value.known==1&&zt_type_carries_borrow(value.ty,decls,0)==0){return 0;}
    let owner:[]u8=zt_agg_expr_stored_root(n,flow.prov,1,arena);if(owner.len==0){owner=zt_owned_expr_root(n,flow.owners,flow.owner_aliases);}
    if(owner.len==0){let oi:i32=0;while(oi<flow.owners.len&&owner.len==0){if(zt_expr_uses_name(n,flow.owners.data[oi],flow.owner_aliases)==1){owner=flow.owners.data[oi];}oi=oi+1;}}
    let stack:[]u8=zt_agg_expr_stored_root(n,flow.prov,2,arena);if(stack.len==0){stack=zt_stack_return_address_root(n,flow.locals,flow.stack_aliases,decls);}
    let loan:[]u8=zt_agg_expr_stored_root(n,flow.prov,3,arena);
    // A mutable parameter borrow permits writes to scalar fields, but it is
    // still caller-owned storage.  A pointer-bearing value written through
    // that view can retain another parameter's lifetime and therefore must
    // pass the same non-local aggregate escape checks as any other caller
    // object.  Scalar stores return above before this classification.
    let local:i32=(target.name.len>0&&((target.depth==0&&zt_in_names(flow.bindings,target.name)==1)||zt_in_names(flow.containers,target.name)==1)) as i32;
    if(local==1){return 0;}
    let errors:i32=0;
    // A root `global let` raw-pointer cell is the explicit unsafe shared
    // memory boundary used by the bounded thread/runtime APIs.  Permit a
    // direct raw-pointer value (including null and mmap-derived addresses)
    // into that one-word cell when no tracked owner, stack address, or loan is
    // being smuggled across the boundary.  Aggregate globals and all tracked
    // lifetime-bearing values remain fail-closed below.
    let global_pointer:i32=((target.depth==0&&zt_global_pointer_name(decls,target.name)==1&&value.known==1&&value.ty.len>0&&value.ty[0]=='*'&&owner.len==0&&stack.len==0&&loan.len==0) as i32);
    if(global_pointer==1){return 0;}
    // A non-local raw-pointer store is permitted for a fresh, compiler-known
    // producer or an already tracked owner. Reconstructing a pointer from an
    // integer (or forwarding an otherwise untracked pointer) has no lifetime
    // identity and must not become a global escape hatch.
    let fresh:i32=(zt_owned_acquire_name(n,sums).len>0) as i32;
    if(target.depth==0&&value.known==1&&zt_type_carries_borrow(value.ty,decls,0)==1&&owner.len==0&&stack.len==0&&loan.len==0&&fresh==0){errors=errors+zt_machine_error("owned allocation escapes through non-local aggregate store (root `<untracked>`)",context);}
    if(owner.len>0){errors=errors+zt_machine_error(_zag_str_concat("owned allocation escapes through non-local aggregate store (root `",_zag_str_concat(owner,"`)")),context);}
    if(stack.len>0){errors=errors+zt_machine_error(_zag_str_concat("address of local `",_zag_str_concat(stack,"` escapes through non-local aggregate store")),context);}
    if(loan.len>0){errors=errors+zt_machine_error(_zag_str_concat("borrowed view `",_zag_str_concat(loan,"` cannot be stored in a non-local aggregate")),context);}
    return errors;
}
fn zt_agg_check_body(body:ArrayList[*Node],flow:*ZTAggFlow,decls:ArrayList[*Node],sums:ArrayList[ZTOwnSummary],context:[]u8,arena:*ArrayList[ZTAggPathNode])i32{
    let errors:i32=0;let i:i32=0;
    while(i<body.len){switch(body.data[i].*){
        .let_=>|l|{
            if(l.has_init==1){errors=errors+zt_agg_check_freed_expr(l.expr,flow.*,context,arena)+zt_agg_check_calls(l.expr,flow,decls,context,arena);}
            let ty:[]u8=l.dty;if(l.has_dty==0&&l.has_init==1){let inferred:ZTExpr=zt_expr_type(l.expr,flow.*.env,decls,context);if(inferred.known==1){ty=inferred.ty;}}
            if(ty.len==0){ty="?";}push[ZTBind](&flow.*.env,ZTBind{.name=l.name,.ty=ty});
            if(zt_in_names(flow.*.bindings,l.name)==0){push[[]u8](&flow.*.bindings,l.name);}
            if(ty[0]!='*'){push[ZTBind](&flow.*.locals,ZTBind{.name=l.name,.ty=ty});}
            if(zt_agg_type_is_value(ty,decls)==1){if(zt_in_names(flow.*.containers,l.name)==0){push[[]u8](&flow.*.containers,l.name);}if(l.has_init==1){errors=errors+zt_agg_assign_value(flow,zt_agg_root_path(l.name),l.expr,decls,sums,context,arena);}}
            else if(l.has_init==1&&(zt_agg_expr_stored_root(l.expr,flow.*.prov,1,arena).len>0||zt_agg_expr_stored_root(l.expr,flow.*.prov,2,arena).len>0)){errors=errors+zt_agg_assign_value(flow,zt_agg_root_path(l.name),l.expr,decls,sums,context,arena);}
            if(l.has_init==1){
                if(zt_agg_acquires_owner(l.expr,ty,decls,sums)==1){if(zt_in_names(flow.*.owners,l.name)==0){push[[]u8](&flow.*.owners,l.name);}zt_alias_set(&flow.*.owner_aliases,l.name,l.name);}
                else{let source:[]u8=zt_expr_transparent_id(l.expr);if(source.len>0){zt_alias_set(&flow.*.owner_aliases,l.name,zt_alias_root(flow.*.owner_aliases,source));}}
                zt_alias_set(&flow.*.stack_aliases,l.name,zt_stack_direct_address_root(l.expr,flow.*.locals,flow.*.stack_aliases));
            }
        }
        .assign=>|a|{
            errors=errors+zt_agg_check_freed_expr(a.expr,flow.*,context,arena)+zt_agg_check_calls(a.expr,flow,decls,context,arena);
            let target:ZTAggPath=zt_agg_expr_path(a.target,arena);
            errors=errors+zt_agg_nonlocal_store(a.expr,target,flow.*,decls,sums,context,arena);
            if(target.name.len>0&&zt_in_names(flow.*.containers,target.name)==1){errors=errors+zt_agg_assign_value(flow,target,a.expr,decls,sums,context,arena);}
            let direct:[]u8=zt_expr_transparent_id(a.target);
            if(direct.len>0){
                if(zt_in_names(flow.*.containers,direct)==0){
                    if(zt_agg_expr_stored_root(a.expr,flow.*.prov,1,arena).len>0||zt_agg_expr_stored_root(a.expr,flow.*.prov,2,arena).len>0){errors=errors+zt_agg_assign_value(flow,zt_agg_root_path(direct),a.expr,decls,sums,context,arena);}
                    else{zt_agg_prov_clear(&flow.*.prov,zt_agg_root_path(direct),arena.*);}
                }
                if(zt_agg_acquires_owner(a.expr,zt_env_get(flow.*.env,direct),decls,sums)==1){if(zt_in_names(flow.*.owners,direct)==0){push[[]u8](&flow.*.owners,direct);}zt_alias_set(&flow.*.owner_aliases,direct,direct);}
                else{let source:[]u8=zt_expr_transparent_id(a.expr);if(source.len>0){zt_alias_set(&flow.*.owner_aliases,direct,zt_alias_root(flow.*.owner_aliases,source));}}
                zt_alias_set(&flow.*.stack_aliases,direct,zt_stack_direct_address_root(a.expr,flow.*.locals,flow.*.stack_aliases));
            }
        }
        .ret=>|r|{if(r.has_expr==1){
            errors=errors+zt_agg_check_freed_expr(r.expr,flow.*,context,arena)+zt_agg_check_calls(r.expr,flow,decls,context,arena);
            let may_carry:i32=zt_type_carries_borrow(flow.*.return_ty,decls,0);
            let owner:[]u8="";if(may_carry==1){owner=zt_agg_expr_stored_root(r.expr,flow.*.prov,1,arena);}if(owner.len>0){errors=errors+zt_machine_error(_zag_str_concat("owned allocation stored in an aggregate escapes through return (root `",_zag_str_concat(owner,"`)")),context);}
            // A direct named owner may cross this function boundary, but an
            // aggregate value cannot: its field path is the ownership record.
            // Remove only the direct root so aggregate returns remain
            // fail-closed and aggregate terminal accounting can report leaks.
            if(owner.len==0){let direct:[]u8=zt_owned_expr_root(r.expr,flow.*.owners,flow.*.owner_aliases);if(direct.len>0){zt_names_remove(&flow.*.owners,direct);}}
            let stack:[]u8="";if(may_carry==1){stack=zt_agg_expr_stored_root(r.expr,flow.*.prov,2,arena);}
            // Direct aggregate literals have no preceding assignment for the
            // mutation-aware path table to observe. Check their expression
            // here, after the exact stored-field lookup, so a literal
            // `Box{.ptr = &local}` is rejected while `value` remains governed
            // by field-sensitive clear/overwrite provenance.
            if(stack.len==0&&may_carry==1){
                // Only a direct aggregate literal needs this expression-level
                // fallback. Scalar and direct-pointer return expressions are
                // handled by their respective passes; searching those trees
                // here would mistake `return p.*` for returning `&p`.
                switch(r.expr.*){.slit_=>{stack=zt_stack_return_address_root(r.expr,flow.*.locals,flow.*.stack_aliases,decls);}else=>{}}
            }
            if(stack.len>0){errors=errors+zt_machine_error(_zag_str_concat("address of local `",_zag_str_concat(stack,"` escapes through return")),context);}if(may_carry==1){errors=errors+zt_agg_return_loan_error(r.expr,flow.*,decls,context,arena);}
        }}
        .estmt=>|e|{errors=errors+zt_agg_check_freed_expr(e.expr,flow.*,context,arena)+zt_agg_check_calls(e.expr,flow,decls,context,arena);}
        .defer_=>|d|{errors=errors+zt_agg_check_freed_expr(d.expr,flow.*,context,arena)+zt_agg_check_calls(d.expr,flow,decls,context,arena);}
        .unsafe_=>|u|{errors=errors+zt_agg_check_body(u.body,flow,decls,sums,context,arena);}
        .if_=>|x|{
            errors=errors+zt_agg_check_freed_expr(x.cond,flow.*,context,arena)+zt_agg_check_calls(x.cond,flow,decls,context,arena);
            let base:ZTAggFlow=zt_agg_flow_clone(flow.*);let then_flow:ZTAggFlow=zt_agg_flow_clone(base);errors=errors+zt_agg_check_body(x.then_body,&then_flow,decls,sums,context,arena);
            let else_flow:ZTAggFlow=zt_agg_flow_clone(base);if(x.has_els==1){errors=errors+zt_agg_check_body(x.els_body,&else_flow,decls,sums,context,arena);}
            let joined:ZTAggFlow=zt_agg_flow_join(base,then_flow,else_flow,arena.*);
            zt_agg_flow_free(&base);zt_agg_flow_free(&then_flow);zt_agg_flow_free(&else_flow);zt_agg_flow_replace(flow,joined);
        }
        .while_=>|x|{
            errors=errors+zt_agg_check_freed_expr(x.cond,flow.*,context,arena)+zt_agg_check_calls(x.cond,flow,decls,context,arena);
            let base:ZTAggFlow=zt_agg_flow_clone(flow.*);let loop_flow:ZTAggFlow=zt_agg_flow_clone(base);errors=errors+zt_agg_check_body(x.body,&loop_flow,decls,sums,context,arena);
            let joined:ZTAggFlow=zt_agg_flow_join(base,base,loop_flow,arena.*);
            zt_agg_flow_free(&base);zt_agg_flow_free(&loop_flow);zt_agg_flow_replace(flow,joined);
        }
        .switch_=>|x|{
            errors=errors+zt_agg_check_freed_expr(x.subject,flow.*,context,arena)+zt_agg_check_calls(x.subject,flow,decls,context,arena);
            let base:ZTAggFlow=zt_agg_flow_clone(flow.*);let joined:ZTAggFlow=zt_agg_flow_clone(base);let ai:i32=0;
            while(ai<x.arms.len){let arm:ZTAggFlow=zt_agg_flow_clone(base);errors=errors+zt_agg_check_body(x.arms.data[ai].body,&arm,decls,sums,context,arena);let next:ZTAggFlow=zt_agg_flow_join(base,joined,arm,arena.*);zt_agg_flow_free(&joined);zt_agg_flow_free(&arm);joined=next;ai=ai+1;}
            if(x.has_els==1){let els:ZTAggFlow=zt_agg_flow_clone(base);errors=errors+zt_agg_check_body(x.els_body,&els,decls,sums,context,arena);let next:ZTAggFlow=zt_agg_flow_join(base,joined,els,arena.*);zt_agg_flow_free(&joined);zt_agg_flow_free(&els);joined=next;}
            zt_agg_flow_free(&base);zt_agg_flow_replace(flow,joined);
        }
        else=>{}
    }i=i+1;}
    return errors;
}
fn zt_check_v2_aggregate_provenance(decls:ArrayList[*Node],file:[]u8)i32{
    if(@strEq(v2_project_edition(file),"2027")==0){return 0;}
    let sums:ArrayList[ZTOwnSummary]=zt_build_owner_summaries(decls);let errors:i32=0;let i:i32=0;
    while(i<decls.len){switch(decls.data[i].*){.fn_decl=>|f|{if(f.is_extern==0){
        let flow:ZTAggFlow=zt_agg_flow_new(f.params.len+8);flow.return_ty=f.ret;let arena:ArrayList[ZTAggPathNode]=make[ZTAggPathNode](16);let pi:i32=0;while(pi<f.params.len){let p:Param=f.params.data[pi];push[ZTBind](&flow.env,ZTBind{.name=p.name,.ty=p.pty});let borrow_mode:i32=zt_param_borrow_mode(decls,f.name,pi);if(borrow_mode>0){zt_agg_add_entry(&flow.prov,zt_agg_root_path(p.name),p.name,3,0,arena);}if((@strEq(p.contract,"@retained_by_return")||zt_fn_inferred_retained_param(decls,f.name,pi)==1||(pi==0&&zt_fn_has_legacy_borrow(decls,f.name)==1&&zt_type_carries_borrow(f.ret,decls,0)==1))&&zt_in_names(flow.retained_roots,p.name)==0){push[[]u8](&flow.retained_roots,p.name);}if(borrow_mode==2&&zt_in_names(flow.mutable_roots,p.name)==0){push[[]u8](&flow.mutable_roots,p.name);}pi=pi+1;}
        if(zt_fn_has_consumes_contract(decls,f.name)==1){let pi:i32=0;while(pi<f.params.len){let p:Param=f.params.data[pi];if(zt_legacy_allocation_consumes_param(decls,f.name,pi)==1){push[[]u8](&flow.owners,p.name);zt_alias_set(&flow.owner_aliases,p.name,p.name);}pi=pi+1;}}
        errors=errors+zt_agg_check_body(f.body,&flow,decls,sums,_zag_str_concat("function ",f.name),&arena);
        // This is the terminal half of aggregate ownership transfer.  A root
        // deliberately leaves the name-only checker once stored in a value
        // aggregate; it must therefore be discharged here on every path.
        let oi:i32=0;while(oi<flow.owners.len){let root:[]u8=flow.owners.data[oi];let aliases:ArrayList[ZTOwnAlias]=make[ZTOwnAlias](4);let aggregate_owned:i32=zt_body_stores_owner_in_aggregate(f.body,root,&aliases);free[ZTOwnAlias](&aliases);if(aggregate_owned==1){if(zt_fn_has_consumes_contract(decls,f.name)==1&&zt_consumes_owner_named(decls,f.name,root)==1){errors=errors+zt_machine_error(_zag_str_concat("@consumes parameter `",_zag_str_concat(root,"` is not released or transferred on every control-flow path")),_zag_str_concat("function ",f.name));}else{errors=errors+zt_machine_error(_zag_str_concat("owned allocation `",_zag_str_concat(root,"` is neither released nor returned through aggregate provenance")),_zag_str_concat("function ",f.name));}}oi=oi+1;}
        zt_agg_flow_free(&flow);free[ZTAggPathNode](&arena);
    }}else=>{}}i=i+1;}
    free[ZTOwnSummary](&sums);
    return errors;
}

// ── edition-2027 affine resources and retained aggregate loans ─────────────
// A resource slot is one exact @owned field (or one raw @acquires result).
// Values move by remapping those slots; a destructor empties the exact slot.
// Loans record which local/container still retains a view into a resource
// root, allowing generic collection mutation to extend that lifetime without
// making the collection implementation or element type compiler-known.
struct ZTResSlot { path:ZTAggPath, ty:[]u8, release:[]u8, state:i32 }
struct ZTResLoan { holder:ZTAggPath, owner:[]u8 }
struct ZTLoanStoreSummary { matched:i32, destination:i32, source:i32 }
struct ZTResFlow {
    slots:ArrayList[ZTResSlot],
    loans:ArrayList[ZTResLoan],
    // Fresh raw-pointer identities are kept separately from affine resource
    // slots.  The aggregate provenance pass owns ordinary pointer aggregates;
    // this small ledger exists only long enough to prove that a fresh raw
    // producer is consumed by a structural @resource literal or transferred
    // to another raw local.  Keeping the identities separate avoids counting
    // one malloc pointer in both ownership systems.
    raw_producers:ArrayList[[]u8],
    env:ArrayList[ZTBind],
    bindings:ArrayList[[]u8],
    terminated:i32,
    return_ty:[]u8,
}
fn zt_res_flow_new(cap:i32)ZTResFlow{return ZTResFlow{.slots=make[ZTResSlot](cap),.loans=make[ZTResLoan](cap),.raw_producers=make[[]u8](cap),.env=make[ZTBind](cap),.bindings=make[[]u8](cap),.terminated=0,.return_ty=""};}
fn zt_res_flow_clone(src:ZTResFlow)ZTResFlow{let out:ZTResFlow=zt_res_flow_new(src.slots.len+src.loans.len+src.raw_producers.len+4);let i:i32=0;while(i<src.slots.len){push[ZTResSlot](&out.slots,src.slots.data[i]);i=i+1;}i=0;while(i<src.loans.len){push[ZTResLoan](&out.loans,src.loans.data[i]);i=i+1;}free[[]u8](&out.raw_producers);out.raw_producers=zt_names_clone(src.raw_producers);free[ZTBind](&out.env);out.env=zt_env_clone(src.env);free[[]u8](&out.bindings);out.bindings=zt_names_clone(src.bindings);out.terminated=src.terminated;out.return_ty=src.return_ty;return out;}
fn zt_res_flow_free(flow:*ZTResFlow)void{free[ZTResSlot](&flow.*.slots);free[ZTResLoan](&flow.*.loans);free[[]u8](&flow.*.raw_producers);free[ZTBind](&flow.*.env);free[[]u8](&flow.*.bindings);}
fn zt_res_flow_replace(dst:*ZTResFlow,next:ZTResFlow)void{zt_res_flow_free(dst);dst.*=next;}
fn zt_res_slot_has(slots:ArrayList[ZTResSlot],path:ZTAggPath,arena:ArrayList[ZTAggPathNode])i32{let i:i32=0;while(i<slots.len){if(zt_agg_path_equal(arena,slots.data[i].path,path)==1){return i;}i=i+1;}return -1;}
fn zt_res_slot_remove(flow:*ZTResFlow,path:ZTAggPath,arena:ArrayList[ZTAggPathNode])void{let found:i32=zt_res_slot_has(flow.*.slots,path,arena);if(found<0){return;}let i:i32=found;while(i+1<flow.*.slots.len){flow.*.slots.data[i]=flow.*.slots.data[i+1];i=i+1;}flow.*.slots.len=flow.*.slots.len-1;}
fn zt_res_raw_has(flow:ZTResFlow,name:[]u8)i32{if(name.len==0){return 0;}return zt_in_names(flow.raw_producers,name);}
fn zt_res_raw_add(flow:*ZTResFlow,name:[]u8)void{if(name.len>0&&zt_res_raw_has(flow.*,name)==0){push[[]u8](&flow.*.raw_producers,name);}}
fn zt_res_raw_remove(flow:*ZTResFlow,name:[]u8)void{if(name.len>0){zt_names_remove(&flow.*.raw_producers,name);}}
fn zt_res_loan_has(loans:ArrayList[ZTResLoan],loan:ZTResLoan,arena:ArrayList[ZTAggPathNode])i32{let i:i32=0;while(i<loans.len){if(@strEq(loans.data[i].owner,loan.owner)&&zt_agg_path_equal(arena,loans.data[i].holder,loan.holder)==1){return 1;}i=i+1;}return 0;}
fn zt_res_add_loan(flow:*ZTResFlow,holder:ZTAggPath,owner:[]u8,arena:ArrayList[ZTAggPathNode])void{if(holder.name.len==0||owner.len==0){return;}let loan:ZTResLoan=ZTResLoan{.holder=holder,.owner=owner};if(zt_res_loan_has(flow.*.loans,loan,arena)==0){push[ZTResLoan](&flow.*.loans,loan);}}
fn zt_res_clear_loans(flow:*ZTResFlow,holder:ZTAggPath,arena:ArrayList[ZTAggPathNode])void{let i:i32=0;while(i<flow.*.loans.len){if(zt_agg_path_prefix(arena,holder,flow.*.loans.data[i].holder)==1){let j:i32=i;while(j+1<flow.*.loans.len){flow.*.loans.data[j]=flow.*.loans.data[j+1];j=j+1;}flow.*.loans.len=flow.*.loans.len-1;}else{i=i+1;}}}
fn zt_res_owner_is_borrowed(flow:ZTResFlow,owner:[]u8)i32{let i:i32=0;while(i<flow.loans.len){if(@strEq(flow.loans.data[i].owner,owner)){return 1;}i=i+1;}return 0;}
fn zt_res_struct_for_type(ty0:[]u8,decls:ArrayList[*Node])i32{let ty:[]u8=ty0;while(ty.len>0&&(ty[0]=='?'||ty[0]=='!')){ty=ty[1..];}if(zt_resource_type(ty,decls)==0){return -1;}let base:[]u8=ty;if(is_generic_app(ty)){base=ty[0..zt_find(ty,'[')];}let i:i32=0;while(i<decls.len){switch(decls.data[i].*){.struct_=>|s|{if(@strEq(s.name,base)){return i;}}else=>{}}i=i+1;}return -1;}
fn zt_res_add_type_slots_depth(flow:*ZTResFlow,path:ZTAggPath,ty0:[]u8,state:i32,decls:ArrayList[*Node],arena:*ArrayList[ZTAggPathNode],depth:i32)void{
    if(depth>64){return;}
    let ty:[]u8=ty0;while(ty.len>0&&(ty[0]=='?'||ty[0]=='!')){ty=ty[1..];}let di:i32=zt_res_struct_for_type(ty,decls);if(di<0){return;}
    let args:ArrayList[[]u8]=make[[]u8](0);if(is_generic_app(ty)){let lb:i32=zt_find(ty,'[');free[[]u8](&args);args=split_args(ty[lb+1..ty.len-1]);}
    switch(decls.data[di].*){.struct_=>|s|{let fi:i32=0;while(fi<s.fields.len){let field:Param=s.fields.data[fi];let release:[]u8=zt_relation_arg(field.contract,"@owned(");let field_ty:[]u8=zt_subst_type(field.pty,s.tparams,args);let field_path:ZTAggPath=zt_agg_path_append(arena,path,field.name);if(release.len>0){let existing:i32=zt_res_slot_has(flow.*.slots,field_path,arena.*);if(existing>=0){flow.*.slots.data[existing]=ZTResSlot{.path=field_path,.ty=field_ty,.release=release,.state=state};}else{push[ZTResSlot](&flow.*.slots,ZTResSlot{.path=field_path,.ty=field_ty,.release=release,.state=state});}}
        // An explicit @owned relation is the terminal for that field.  Plain
        // fields whose concrete substituted type is itself structural resource
        // storage recurse to its exact terminal slots instead of double-counting
        // the outer field and its payload.
        else if(zt_resource_type(field_ty,decls)==1){zt_res_add_type_slots_depth(flow,field_path,field_ty,state,decls,arena,depth+1);}
        fi=fi+1;}}else=>{}}
    free[[]u8](&args);
}
fn zt_res_add_type_slots(flow:*ZTResFlow,path:ZTAggPath,ty0:[]u8,state:i32,decls:ArrayList[*Node],arena:*ArrayList[ZTAggPathNode])void{zt_res_add_type_slots_depth(flow,path,ty0,state,decls,arena,0);}
fn zt_res_path_state(flow:ZTResFlow,path:ZTAggPath,arena:ArrayList[ZTAggPathNode])i32{let found:i32=0;let state:i32=0;let i:i32=0;while(i<flow.slots.len){let slot:ZTResSlot=flow.slots.data[i];if(zt_agg_path_prefix(arena,path,slot.path)==1||zt_agg_path_prefix(arena,slot.path,path)==1){found=1;if(slot.state>state){state=slot.state;}}i=i+1;}if(found==0){return -1;}return state;}
// Reads and writes require every resource slot overlapping the selected path
// to remain live.  `zt_res_path_state` intentionally returns a join-friendly
// maximum, which is useful for transfer discovery but could otherwise hide a
// released sibling behind another live slot.  A scalar field has no slot of
// its own, so fall back to the resource root before declaring it untracked.
fn zt_res_access_state(flow:ZTResFlow,path:ZTAggPath,arena:ArrayList[ZTAggPathNode])i32{
    if(path.name.len==0){return -1;}
    let found:i32=0;let i:i32=0;
    while(i<flow.slots.len){let slot:ZTResSlot=flow.slots.data[i];
        if(zt_agg_path_prefix(arena,path,slot.path)==1||zt_agg_path_prefix(arena,slot.path,path)==1){found=1;if(slot.state!=1){return slot.state;}}
        i=i+1;
    }
    if(found==1){return 1;}
    if(path.depth>0){return zt_res_access_state(flow,zt_agg_root_path(path.name),arena);}
    return -1;
}
fn zt_res_check_access_path(flow:ZTResFlow,path:ZTAggPath,context:[]u8,arena:ArrayList[ZTAggPathNode])i32{
    let state:i32=zt_res_access_state(flow,path,arena);
    if(state>=0&&state!=1){return zt_machine_error("resource read/write is unavailable after move or release",context);}
    return 0;
}
fn zt_res_address_path(n:*Node,arena:*ArrayList[ZTAggPathNode])ZTAggPath{
    switch(n.*){
        .cast_=>|x|{return zt_res_address_path(x.expr,arena);}
        .un=>|x|{if(@strEq(x.op,"&")){return zt_agg_expr_path(x.e,arena);}}
        else=>{}
    }
    return zt_agg_empty_path();
}
// An indexed interior pointer is a checked raw-memory observation, not an
// affine resource handle. The runtime's checked dereference path validates its
// alignment, bounds, and generation. Direct addresses of a resource value (or
// a resource field) remain rejected by exact-owner tracking.
fn zt_res_indexed_address(n:*Node)i32{switch(n.*){
    .cast_=>|x|{return zt_res_indexed_address(x.expr);}
    .un=>|x|{if(@strEq(x.op,"&")){switch(x.e.*){.idx=>{return 1;}else=>{}}}}
    else=>{}
}return 0;}
fn zt_res_set_under(flow:*ZTResFlow,path:ZTAggPath,state:i32,arena:ArrayList[ZTAggPathNode])i32{let changed:i32=0;let i:i32=0;while(i<flow.*.slots.len){if(zt_agg_path_prefix(arena,path,flow.*.slots.data[i].path)==1){flow.*.slots.data[i].state=state;changed=1;}i=i+1;}return changed;}
fn zt_res_transition_under(flow:*ZTResFlow,path:ZTAggPath,state:i32,context:[]u8,arena:ArrayList[ZTAggPathNode])i32{
    let changed:i32=zt_res_set_under(flow,path,state,arena);
    if(changed==1){return 0;}
    return zt_machine_error("resource transition has no tracked owned fields",context);
}
fn zt_res_remap_slots(flow:*ZTResFlow,src:ZTAggPath,dst:ZTAggPath,arena:*ArrayList[ZTAggPathNode])i32{let moved:i32=0;let count:i32=flow.*.slots.len;let i:i32=0;while(i<count){let slot:ZTResSlot=flow.*.slots.data[i];if(slot.state==1&&zt_agg_path_prefix(arena.*,src,slot.path)==1){let target:ZTAggPath=zt_agg_remap_path(arena,src,dst,slot.path);let existing:i32=zt_res_slot_has(flow.*.slots,target,arena.*);let next:ZTResSlot=ZTResSlot{.path=target,.ty=slot.ty,.release=slot.release,.state=1};if(existing>=0){flow.*.slots.data[existing]=next;}else{push[ZTResSlot](&flow.*.slots,next);}flow.*.slots.data[i].state=0;moved=1;}i=i+1;}return moved;}
// A plain value aggregate can still carry an affine raw-pointer slot.  Keep
// that slot path-sensitive when a literal stores the pointer, so a later
// consuming return-owner call can move `box.ptr` into its result instead of
// treating the field as an unrelated/untracked name.  This deliberately
// follows only literal field construction; arbitrary calls and computed
// pointer fabrication remain outside the resource proof.
fn zt_res_move_literal_slots(flow:*ZTResFlow,target:ZTAggPath,n:*Node,arena:*ArrayList[ZTAggPathNode])i32{
    switch(n.*){
        .cast_=>|x|{return zt_res_move_literal_slots(flow,target,x.expr,arena);}
        .un=>|x|{if(@strEq(x.op,"try")){return zt_res_move_literal_slots(flow,target,x.e,arena);}}
        .slit_=>|x|{
            let errors:i32=0;let fi:i32=0;while(fi<x.fields.len){let init:FieldInit=x.fields.data[fi];let field_path:ZTAggPath=zt_agg_path_append(arena,target,init.name);let source:ZTAggPath=zt_agg_expr_path(init.val,arena);let moved:i32=0;
                if(source.name.len>0){let state:i32=zt_res_access_state(flow.*,source,arena.*);if(state>=0){if(state!=1){errors=errors+zt_machine_error("resource move source is unavailable after move or release","aggregate literal");}else if(source.depth==0&&zt_res_raw_has(flow.*,source.name)==1){
                    // Once a raw pointer enters an ordinary value aggregate,
                    // the mutation-aware aggregate pass owns that path. Drop
                    // the root resource slot instead of creating a second
                    // owner for the aggregate field.
                    zt_res_slot_remove(flow,source,arena.*);zt_res_raw_remove(flow,source.name);moved=1;
                }else if(zt_res_remap_slots(flow,source,field_path,arena)==1){zt_res_remap_loans(flow,source,field_path,arena);moved=1;}else{errors=errors+zt_machine_error("resource move has no live owned fields","aggregate literal");}}else if(source.depth==0&&zt_res_raw_has(flow.*,source.name)==1){
                    // Plain pointer aggregates remain under the aggregate
                    // provenance checker. Consume the short-lived raw
                    // producer identity here so the resource checker does not
                    // later mistake the same pointer for an unconsumed local.
                    zt_res_raw_remove(flow,source.name);moved=1;
                }}
                if(moved==0){switch(init.val.*){.slit_=>{errors=errors+zt_res_move_literal_slots(flow,field_path,init.val,arena);}else=>{}}}
                fi=fi+1;
            }return errors;
        }
        else=>{}
    }
    return 0;
}
fn zt_res_remap_loans(flow:*ZTResFlow,src:ZTAggPath,dst:ZTAggPath,arena:*ArrayList[ZTAggPathNode])void{
    let next:ArrayList[ZTResLoan]=make[ZTResLoan](flow.*.loans.len+1);let i:i32=0;
    while(i<flow.*.loans.len){let loan:ZTResLoan=flow.*.loans.data[i];let holder:ZTAggPath=loan.holder;let owner:[]u8=loan.owner;
        if(zt_agg_path_prefix(arena.*,src,holder)==1){holder=zt_agg_remap_path(arena,src,dst,holder);}
        if(@strEq(owner,src.name)){owner=dst.name;}
        let mapped:ZTResLoan=ZTResLoan{.holder=holder,.owner=owner};if(zt_res_loan_has(next,mapped,arena.*)==0){push[ZTResLoan](&next,mapped);}i=i+1;
    }
    free[ZTResLoan](&flow.*.loans);flow.*.loans=next;
}
fn zt_res_expr_uses_name(n:*Node,name:[]u8)i32{switch(n.*){.id=>|x|{return @strEq(x.name,name) as i32;}.bin=>|x|{return zt_res_expr_uses_name(x.l,name)|zt_res_expr_uses_name(x.r,name);}.un=>|x|{return zt_res_expr_uses_name(x.e,name);}.call=>|x|{let i:i32=0;while(i<x.args.len){if(zt_res_expr_uses_name(x.args.data[i],name)==1){return 1;}i=i+1;}}.idx=>|x|{return zt_res_expr_uses_name(x.base,name)|zt_res_expr_uses_name(x.idx,name);}.fld=>|x|{return zt_res_expr_uses_name(x.base,name);}.cast_=>|x|{return zt_res_expr_uses_name(x.expr,name);}.slice_=>|x|{return zt_res_expr_uses_name(x.base,name)|zt_res_expr_uses_name(x.lo,name)|(x.has_hi*zt_res_expr_uses_name(x.hi,name));}.slit_=>|x|{let i:i32=0;while(i<x.fields.len){if(zt_res_expr_uses_name(x.fields.data[i].val,name)==1){return 1;}i=i+1;}}else=>{}}return 0;}
fn zt_res_body_store_pair(body:ArrayList[*Node],destination:[]u8,source:[]u8,arena:*ArrayList[ZTAggPathNode])i32{let i:i32=0;while(i<body.len){switch(body.data[i].*){.assign=>|x|{let target:ZTAggPath=zt_agg_expr_path(x.target,arena);if(@strEq(target.name,destination)&&zt_res_expr_uses_name(x.expr,source)==1){return 1;}}.unsafe_=>|x|{if(zt_res_body_store_pair(x.body,destination,source,arena)==1){return 1;}}.if_=>|x|{if(zt_res_body_store_pair(x.then_body,destination,source,arena)==1||zt_res_body_store_pair(x.els_body,destination,source,arena)==1){return 1;}}.while_=>|x|{if(zt_res_body_store_pair(x.body,destination,source,arena)==1){return 1;}}.switch_=>|x|{if(zt_res_body_store_pair(x.els_body,destination,source,arena)==1){return 1;}let ai:i32=0;while(ai<x.arms.len){if(zt_res_body_store_pair(x.arms.data[ai].body,destination,source,arena)==1){return 1;}ai=ai+1;}}else=>{}}i=i+1;}return 0;}
fn zt_loan_store_summary(decls:ArrayList[*Node],name:[]u8,arena:*ArrayList[ZTAggPathNode])ZTLoanStoreSummary{let out:ZTLoanStoreSummary=ZTLoanStoreSummary{.matched=0,.destination=-1,.source=-1};let i:i32=0;while(i<decls.len){switch(decls.data[i].*){.fn_decl=>|f|{if(@strEq(f.name,name)&&f.is_extern==0){let di:i32=0;while(di<f.params.len){if(zt_param_borrow_mode(decls,name,di)==2){let si:i32=0;while(si<f.params.len){if(si!=di&&zt_res_body_store_pair(f.body,f.params.data[di].name,f.params.data[si].name,arena)==1){if(out.matched==1&&(out.destination!=di||out.source!=si)){return ZTLoanStoreSummary{.matched=0,.destination=-1,.source=-1};}out=ZTLoanStoreSummary{.matched=1,.destination=di,.source=si};}si=si+1;}}di=di+1;}}}else=>{}}i=i+1;}return out;}
fn zt_res_owner_for_path(flow:ZTResFlow,path:ZTAggPath,arena:ArrayList[ZTAggPathNode])[]u8{let i:i32=0;while(i<flow.slots.len){let slot:ZTResSlot=flow.slots.data[i];if(slot.state==1&&(zt_agg_path_prefix(arena,slot.path,path)==1||zt_agg_path_prefix(arena,path,slot.path)==1)){return slot.path.name;}i=i+1;}return "";}
fn zt_res_expr_loans(flow:ZTResFlow,n:*Node,dst:ZTAggPath,arena:*ArrayList[ZTAggPathNode],out:*ArrayList[ZTResLoan])void{
    let path:ZTAggPath=zt_agg_expr_path(n,arena);if(path.name.len>0){let i:i32=0;while(i<flow.loans.len){let loan:ZTResLoan=flow.loans.data[i];if(zt_agg_path_prefix(arena.*,path,loan.holder)==1){let candidate:ZTResLoan=ZTResLoan{.holder=zt_agg_remap_path(arena,path,dst,loan.holder),.owner=loan.owner};if(zt_res_loan_has(out.*,candidate,arena.*)==0){push[ZTResLoan](out,candidate);}}i=i+1;}}
    switch(n.*){.slice_=>|x|{let owner:[]u8=zt_res_owner_for_path(flow,zt_agg_expr_path(x.base,arena),arena.*);if(owner.len>0){let candidate:ZTResLoan=ZTResLoan{.holder=dst,.owner=owner};if(zt_res_loan_has(out.*,candidate,arena.*)==0){push[ZTResLoan](out,candidate);}}}.cast_=>|x|{zt_res_expr_loans(flow,x.expr,dst,arena,out);}.un=>|x|{zt_res_expr_loans(flow,x.e,dst,arena,out);}.slit_=>|x|{let i:i32=0;while(i<x.fields.len){zt_res_expr_loans(flow,x.fields.data[i].val,zt_agg_path_append(arena,dst,x.fields.data[i].name),arena,out);i=i+1;}}else=>{}}
}
// A resource-bearing value loaded from indexed storage is a shared view of
// that storage, never a fresh owner.  Resolve the live backing owner without
// teaching the generic loan copier that every scalar indexed load is a loan.
fn zt_res_indexed_view_owner(flow:ZTResFlow,n:*Node,arena:*ArrayList[ZTAggPathNode])[]u8{
    switch(n.*){
        .cast_=>|x|{return zt_res_indexed_view_owner(flow,x.expr,arena);}
        .un=>|x|{return zt_res_indexed_view_owner(flow,x.e,arena);}
        .idx=>|x|{
            let base:ZTAggPath=zt_agg_expr_path(x.base,arena);
            let owner:[]u8=zt_res_owner_for_path(flow,base,arena.*);if(owner.len>0){return owner;}
            let i:i32=0;while(i<flow.loans.len){let loan:ZTResLoan=flow.loans.data[i];if(zt_agg_path_prefix(arena.*,base,loan.holder)==1||zt_agg_path_prefix(arena.*,loan.holder,base)==1){return loan.owner;}i=i+1;}
        }
        else=>{}
    }
    return "";
}
fn zt_res_assign_loans(flow:*ZTResFlow,target:ZTAggPath,n:*Node,arena:*ArrayList[ZTAggPathNode])void{let found:ArrayList[ZTResLoan]=make[ZTResLoan](4);zt_res_expr_loans(flow.*,n,target,arena,&found);zt_res_clear_loans(flow,target,arena.*);let i:i32=0;while(i<found.len){zt_res_add_loan(flow,found.data[i].holder,found.data[i].owner,arena.*);i=i+1;}free[ZTResLoan](&found);}
fn zt_res_call_acquire_release(decls:ArrayList[*Node],n:*Node)[]u8{switch(n.*){.cast_=>|x|{return zt_res_call_acquire_release(decls,x.expr);}.un=>|x|{if(@strEq(x.op,"try")){return zt_res_call_acquire_release(decls,x.e);}}.call=>|x|{let name:[]u8=zt_direct_name(x.callee);let i:i32=0;while(i<decls.len){switch(decls.data[i].*){.fn_decl=>|f|{if(@strEq(f.name,name)){let release:[]u8=zt_fn_acquires_release(f);if(release.len>0&&!@strEq(release,"@conflict")){return release;}}}else=>{}}i=i+1;}}else=>{}}return "";}
fn zt_res_known_acquire_release(n:*Node)[]u8{switch(n.*){.cast_=>|x|{return zt_res_known_acquire_release(x.expr);}.un=>|x|{if(@strEq(x.op,"try")){return zt_res_known_acquire_release(x.e);}}.call=>|x|{let name:[]u8=zt_direct_name(x.callee);if(@strEq(name,"new")){return "delete";}if(@strEq(name,"_zag_malloc")||@strEq(name,"_zag_realloc")||zt_qualified_runtime_ends(name,"_zag_malloc")==1||zt_qualified_runtime_ends(name,"_zag_realloc")==1){return "_zag_free";}}else=>{}}return "";}
// Resolve the exact owner argument of a verified consuming return. The caller
// keeps that slot live until the result binding is installed; this avoids
// dropping the source before `zt_res_init_value` can remap it to the returned
// binding. A direct return uses the same helper to discharge the source at the
// function boundary.
fn zt_res_returns_owner_source(n:*Node,decls:ArrayList[*Node],arena:*ArrayList[ZTAggPathNode])ZTAggPath{
    switch(n.*){
        .cast_=>|x|{return zt_res_returns_owner_source(x.expr,decls,arena);}
        .un=>|x|{if(@strEq(x.op,"try")){return zt_res_returns_owner_source(x.e,decls,arena);}}
        .call=>|x|{let name:[]u8=zt_direct_name(x.callee);if(zt_fn_has_annot(decls,name,"@returns_owner")==1){let ai:i32=0;while(ai<x.args.len){if(zt_consumes_param(decls,name,ai)==1||@strEq(zt_fn_param_contract(decls,name,ai),"@consumes")){return zt_agg_expr_path(x.args.data[ai],arena);}ai=ai+1;}}}
        else=>{}
    }
    return zt_agg_empty_path();
}
// Reallocating an owned field in place is an atomic capability replacement.
// It neither creates a branch-local second owner nor leaves the old field
// released on only one path. This is also valid through a mutable borrowed
// resource parameter: the caller retains the same live owned field.
fn zt_res_realloc_reassign(target:*Node,expr:*Node)i32{
    switch(expr.*){
        .cast_=>|x|{return zt_res_realloc_reassign(target,x.expr);}
        .call=>|x|{if(@strEq(zt_direct_name(x.callee),"_zag_realloc")&&x.args.len==2&&zt_same_lvalue(target,x.args.data[0])==1){return 1;}}
        else=>{}
    }
    return 0;
}
fn zt_res_realloc_tail_calls(n:*Node,flow:*ZTResFlow,decls:ArrayList[*Node],context:[]u8,arena:*ArrayList[ZTAggPathNode])i32{
    switch(n.*){
        .cast_=>|x|{return zt_res_realloc_tail_calls(x.expr,flow,decls,context,arena);}
        .call=>|x|{let errors:i32=0;let i:i32=1;while(i<x.args.len){errors=errors+zt_res_call(x.args.data[i],flow,decls,context,arena);i=i+1;}return errors;}
        else=>{}
    }
    return 0;
}
fn zt_res_retained_call_loans(flow:*ZTResFlow,n:*Node,target:ZTAggPath,decls:ArrayList[*Node],arena:*ArrayList[ZTAggPathNode])void{
    switch(n.*){
        .cast_=>|x|{zt_res_retained_call_loans(flow,x.expr,target,decls,arena);}
        .un=>|x|{if(@strEq(x.op,"try")){zt_res_retained_call_loans(flow,x.e,target,decls,arena);}}
        .call=>|x|{
            let name:[]u8=zt_direct_name(x.callee);
            // A concrete pointer-free result cannot retain a view even when
            // the generic declaration returns `T`.  Keeping the raw spelling
            // here pinned scalar `get[i32]` results to their ArrayList owner.
            let result_ty:[]u8=zt_instantiated_call_ret(decls,name,x.targs);
            if(result_ty.len>0&&zt_type_carries_borrow(result_ty,decls,0)==0){return;}
            let i:i32=0;while(i<x.args.len){
                if(@strEq(zt_fn_param_contract(decls,name,i),"@retained_by_return")||zt_fn_inferred_retained_param(decls,name,i)==1||
                    (i==0&&zt_fn_has_legacy_borrow(decls,name)==1&&zt_type_carries_borrow(zt_instantiated_call_ret(decls,name,x.targs),decls,0)==1)){
                    let found:ArrayList[ZTResLoan]=make[ZTResLoan](2);
                    zt_res_expr_loans(flow.*,x.args.data[i],target,arena,&found);
                    let owner:[]u8=zt_res_owner_for_path(flow.*,zt_agg_expr_path(x.args.data[i],arena),arena.*);
                    if(owner.len>0){zt_res_add_loan(flow,target,owner,arena.*);}
                    let li:i32=0;while(li<found.len){zt_res_add_loan(flow,target,found.data[li].owner,arena.*);li=li+1;}
                    free[ZTResLoan](&found);
                }
                i=i+1;
            }
        }
        else=>{}
    }
}
fn zt_res_array_list_type(ty0:[]u8)i32{
    let ty:[]u8=ty0;
    while(ty.len>0&&(ty[0]=='?'||ty[0]=='!'||ty[0]=='*')){ty=ty[1..];}
    let base:[]u8=ty;if(is_generic_app(ty)){base=ty[0..zt_find(ty,'[')];}
    return @strEq(base,"ArrayList") as i32;
}
fn zt_res_array_list_operation_name(name:[]u8)i32{
    return (@strEq(name,"push")||@strEq(name,"set")||@strEq(name,"pop")) as i32;
}
// ArrayList's storage model does not yet carry one affine slot per element.
// Reject insertion, overwrite, and extraction before they can silently
// duplicate or discard ownership. `get` is different: @retained_by_return
// makes its resource-bearing result a shared view tied to the list owner, so
// it can be inspected but cannot be consumed, stored, or outlive the list.
// Even an explicit @consumes value parameter is not enough for `push`: the
// list's ordinary `free` operation still releases only its backing buffer and
// has no per-element drop proof. All three mutating/extracting operations
// therefore remain fail-closed until an element-state destructor contract is
// wired.
fn zt_res_array_list_push_exempt(decls:ArrayList[*Node],name:[]u8)i32{
    return 0;
}
fn zt_res_array_list_resource_operation(decls:ArrayList[*Node],c:Call)i32{
    let name:[]u8=zt_direct_name(c.callee);
    if(c.targs.len!=1||zt_res_array_list_operation_name(name)==0||zt_resource_type(c.targs.data[0],decls)==0){return 0;}
    if(zt_res_array_list_push_exempt(decls,name)==1){return 0;}
    let i:i32=0;while(i<decls.len){switch(decls.data[i].*){
        .fn_decl=>|f|{if(@strEq(f.name,name)&&f.tparams.len==1){
            if(zt_res_array_list_type(f.ret)==1){return 1;}
            if(f.params.len>0&&zt_res_array_list_type(f.params.data[0].pty)==1){return 1;}
        }}
        else=>{}
    }i=i+1;}
    return 0;
}

fn zt_res_raw_call_ret(decls:ArrayList[*Node],name:[]u8,targs:ArrayList[[]u8])[]u8{
    let fallback:[]u8="";let i:i32=0;
    while(i<decls.len){switch(decls.data[i].*){
        .fn_decl=>|f|{if(@strEq(f.name,name)){if(fallback.len==0){fallback=f.ret;}if(f.tparams.len==targs.len){return f.ret;}}}
        else=>{}
    }i=i+1;}
    return fallback;
}
fn zt_res_fresh_resource_expr(decls:ArrayList[*Node],n:*Node)i32{
    switch(n.*){
        .cast_=>|x|{return zt_res_fresh_resource_expr(decls,x.expr);}
        .un=>|x|{if(@strEq(x.op,"try")){return zt_res_fresh_resource_expr(decls,x.e);}}
        .slit_=>|x|{return zt_resource_type(x.sname,decls);}
        .call=>|x|{
            if(zt_res_array_list_resource_operation(decls,x)==1){return 0;}
            let name:[]u8=zt_direct_name(x.callee);
            let raw:[]u8=zt_res_raw_call_ret(decls,name,x.targs);
            let concrete:[]u8=zt_instantiated_call_ret(decls,name,x.targs);
            return (zt_resource_type(raw,decls)==1&&zt_resource_type(concrete,decls)==1) as i32;
        }
        else=>{}
    }
    return 0;
}
fn zt_res_construct_literal(flow:*ZTResFlow,target:ZTAggPath,ty:[]u8,n:*Node,decls:ArrayList[*Node],context:[]u8,arena:*ArrayList[ZTAggPathNode])i32{
    let errors:i32=0;let handled:i32=0;
    switch(n.*){
        .slit_=>|x|{
            handled=1;zt_res_add_type_slots(flow,target,ty,0,decls,arena);
            let fi:i32=0;while(fi<x.fields.len){let init:FieldInit=x.fields.data[fi];
                let field_path:ZTAggPath=zt_agg_path_append(arena,target,init.name);
                if(zt_res_path_state(flow.*,field_path,arena.*)>=0){
                    let source:ZTAggPath=zt_agg_expr_path(init.val,arena);let acquired:i32=0;
                    let tracked:i32=zt_res_path_state(flow.*,source,arena.*);
                    if(source.name.len>0&&tracked>=0){
                        let state:i32=zt_res_access_state(flow.*,source,arena.*);
                        if(state!=1){errors=errors+zt_machine_error("resource move source is unavailable after move or release",context);}
                        else if(zt_res_remap_slots(flow,source,field_path,arena)==1){zt_res_remap_loans(flow,source,field_path,arena);if(source.depth==0&&zt_res_raw_has(flow.*,source.name)==1){zt_res_raw_remove(flow,source.name);}acquired=1;}
                        else{errors=errors+zt_machine_error("resource move has no live owned fields",context);}
                    }else if(source.depth==0&&zt_res_raw_has(flow.*,source.name)==1){
                        // A fresh raw producer is now owned by this exact
                        // structural field. The field slot below becomes the
                        // sole affine representation of that ownership.
                        zt_res_raw_remove(flow,source.name);acquired=1;
                    }else if(zt_res_call_acquire_release(decls,init.val).len>0||zt_res_known_acquire_release(init.val).len>0||zt_res_fresh_resource_expr(decls,init.val)==1){acquired=1;}
                    // An adapter-owned opaque token is intentionally not a
                    // compiler-known raw allocation. The trusted std:driver
                    // factory has already checked that its @consumes token is
                    // an owned acquisition; the driver-handle authority pass
                    // rejects the same literal in ordinary user code.
