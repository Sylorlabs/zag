            if(store.matched==1&&store.destination<c.args.len&&store.source<c.args.len){let dst:ZTAggPath=zt_agg_expr_path(c.args.data[store.destination],arena);let retained:ArrayList[ZTResLoan]=make[ZTResLoan](4);zt_res_expr_loans(flow.*,c.args.data[store.source],dst,arena,&retained);let li:i32=0;while(li<retained.len){zt_res_add_loan(flow,retained.data[li].holder,retained.data[li].owner,arena.*);li=li+1;}free[ZTResLoan](&retained);}
            ai=0;while(ai<c.args.len){let contract:[]u8=zt_fn_param_contract(decls,name,ai);let mode:i32=zt_param_borrow_mode(decls,name,ai);let consuming_contract:i32=((@strEq(contract,"@consumes")||zt_consumes_param(decls,name,ai)==1) as i32);let pty:[]u8=zt_res_param_type(decls,name,ai,c.targs);let arg_path:ZTAggPath=zt_agg_expr_path(c.args.data[ai],arena);let resource_pointee:i32=zt_res_pointer_resource_type(pty,decls);
