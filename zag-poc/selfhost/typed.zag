        .fld=>|x|{errors=errors+zt_res_check_access_path(flow.*,zt_agg_expr_path(n,arena),context,arena.*);errors=errors+zt_res_call_base_effects(x.base,flow,decls,context,arena);}
        .cast_=>|x|{errors=errors+zt_res_call(x.expr,flow,decls,context,arena);}
        .slice_=>|x|{errors=errors+zt_res_check_access_path(flow.*,zt_agg_expr_path(n,arena),context,arena.*);errors=errors+zt_res_call_base_effects(x.base,flow,decls,context,arena)+zt_res_call(x.lo,flow,decls,context,arena);if(x.has_hi==1){errors=errors+zt_res_call(x.hi,flow,decls,context,arena);}}
        .slit_=>|x|{let i:i32=0;while(i<x.fields.len){errors=errors+zt_res_call(x.fields.data[i].val,flow,decls,context,arena);i=i+1;}}
        .id=>|x|{errors=errors+zt_res_check_access_path(flow.*,zt_agg_root_path(x.name),context,arena.*);}
        else=>{}
