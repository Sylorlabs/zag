}
fn zt_res_init_value(flow:*ZTResFlow,target:ZTAggPath,ty:[]u8,n:*Node,decls:ArrayList[*Node],context:[]u8,arena:*ArrayList[ZTAggPathNode])i32{
    let errors:i32=0;let source:ZTAggPath=zt_agg_expr_path(n,arena);
    // `_zag_realloc` consumes the old named raw owner and returns its
    // replacement. The call checker intentionally visits only the size
    // argument; perform the exact slot remap when the result receives a new
    // binding so the old name cannot leak at function exit.
    let realloc_source:[]u8=zt_realloc_source_name(n);
    if(realloc_source.len>0){
        let old_path:ZTAggPath=zt_agg_root_path(realloc_source);
        let old_state:i32=zt_res_access_state(flow.*,old_path,arena.*);
        let existing:i32=zt_res_access_state(flow.*,target,arena.*);
        // Raw malloc/realloc identities are intentionally kept outside the
        // structural release-slot lattice. Transfer that identity here so a
        // replacement binding remains tied to the same aggregate owner.
        if(old_state<0&&zt_res_raw_has(flow.*,realloc_source)==1){
            if(existing==1||existing==2||existing==3){return errors+zt_machine_error("live resource is overwritten before release or move",context);}
            zt_res_raw_remove(flow,realloc_source);if(target.depth==0&&target.name.len>0){zt_res_raw_add(flow,target.name);}return errors;
        }
        if(old_state!=1){return errors+zt_machine_error("reallocates a resource after move or release",context);}
        if(existing==1||existing==2||existing==3){return errors+zt_machine_error("live resource is overwritten before release or move",context);}
        if(zt_res_remap_slots(flow,old_path,target,arena)==0){return errors+zt_machine_error("realloc has no live owned source",context);}
        zt_res_remap_loans(flow,old_path,target,arena);
        return errors;
    }
    // A stored pointer would sever the exact lvalue identity required to move
    // or release a resource later. Direct `callee(&owner)` borrows/consumes are
    // still modeled at the call boundary; only an escaping alias is rejected.
    let addressed:ZTAggPath=zt_res_address_path(n,arena);
    if(addressed.name.len>0&&zt_res_access_state(flow.*,addressed,arena.*)>=0&&zt_res_indexed_address(n)==0){return errors+zt_machine_error("resource pointer alias escapes exact owner tracking",context);}
    let returned_source:ZTAggPath=zt_res_returns_owner_source(n,decls,arena);
    if(returned_source.name.len>0){
        let state:i32=zt_res_access_state(flow.*,returned_source,arena.*);
        // Allocation and aggregate-owned raw pointers are governed by the
        // aggregate provenance pass when no exact ZTRes slot exists at the
        // spelled source path.  Do not manufacture a second resource error;
        // plain raw slots are remapped below and structural resources still
        // require the exact live slot here.
        if(state>=0){
            let existing:i32=zt_res_access_state(flow.*,target,arena.*);
            if(state!=1){return errors+zt_machine_error("resource move source is unavailable after move or release",context);}
            if(existing==1||existing==2||existing==3){return errors+zt_machine_error("live resource is overwritten before release or move",context);}
            if(zt_res_remap_slots(flow,returned_source,target,arena)==0){return errors+zt_machine_error("resource move has no live owned fields",context);}
            zt_res_remap_loans(flow,returned_source,target,arena);
            if(returned_source.depth==0&&target.depth==0&&zt_res_raw_has(flow.*,returned_source.name)==1){zt_res_raw_remove(flow,returned_source.name);zt_res_raw_add(flow,target.name);}
        }
        return errors;
    }
    // Raw pointers produced by `new`/malloc are tracked by release slots even
    // though their nominal type is not a structural @resource. A plain local
    // alias must therefore move the slot just like an aggregate resource;
    // otherwise returning the alias leaves the original owner live.
    let tracked_source:i32=zt_res_path_state(flow.*,source,arena.*);
    if(source.name.len>0&&tracked_source>=0&&zt_resource_type(ty,decls)==0&&zt_res_slot_has(flow.*.slots,source,arena.*)>=0){
        let state:i32=zt_res_access_state(flow.*,source,arena.*);
        if(state!=1){return errors+zt_machine_error("resource move source is unavailable after move or release",context);}
        if(zt_res_remap_slots(flow,source,target,arena)==0){return errors+zt_machine_error("resource move has no live owned fields",context);}
        zt_res_remap_loans(flow,source,target,arena);if(source.depth==0&&target.depth==0&&zt_res_raw_has(flow.*,source.name)==1){zt_res_raw_remove(flow,source.name);zt_res_raw_add(flow,target.name);}return errors;
    }
    if(zt_resource_type(ty,decls)==0){errors=errors+zt_res_move_literal_slots(flow,target,n,arena);}
    if(zt_resource_type(ty,decls)==1){
        let existing:i32=zt_res_access_state(flow.*,target,arena.*);
        if(existing==1||existing==2||existing==3){errors=errors+zt_machine_error("live resource is overwritten before release or move",context);return errors;}
        // Rebinding a local view ends its prior loan before the new ownership
        // or borrow relation is installed.
        zt_res_clear_loans(flow,target,arena.*);
        let constructed:i32=zt_res_construct_literal(flow,target,ty,n,decls,context,arena);
        if(constructed>=0){return errors+constructed;}
        let tracked:i32=zt_res_path_state(flow.*,source,arena.*);
        if(source.name.len>0&&tracked>=0){
            if(zt_res_access_state(flow.*,source,arena.*)!=1){return errors+zt_machine_error("resource move source is unavailable after move or release",context);}
            if(zt_res_remap_slots(flow,source,target,arena)==0){errors=errors+zt_machine_error("resource move has no live owned fields",context);}
            else{zt_res_remap_loans(flow,source,target,arena);}
        }else if(zt_res_fresh_resource_expr(decls,n)==1){zt_res_add_type_slots(flow,target,ty,1,decls,arena);}
        else{
            let borrowed:i32=0;let found:ArrayList[ZTResLoan]=make[ZTResLoan](2);zt_res_expr_loans(flow.*,n,target,arena,&found);
            let li:i32=0;while(li<found.len){zt_res_add_loan(flow,found.data[li].holder,found.data[li].owner,arena.*);borrowed=1;li=li+1;}free[ZTResLoan](&found);
            let indexed_owner:[]u8=zt_res_indexed_view_owner(flow.*,n,arena);if(indexed_owner.len>0){zt_res_add_loan(flow,target,indexed_owner,arena.*);borrowed=1;}
            let before:i32=flow.*.loans.len;zt_res_retained_call_loans(flow,n,target,decls,arena);if(flow.*.loans.len>before){borrowed=1;}
            if(borrowed==0){errors=errors+zt_machine_error("resource initialization requires a fresh producer, live move source, or retained shared view",context);}
        }
        return errors;
    }
    let release:[]u8=zt_res_call_acquire_release(decls,n);if(release.len==0){release=zt_res_known_acquire_release(n);}
    if(release.len>0){
        // Raw pointer producers are already owned by the legacy aggregate
        // provenance pass. Keep only their exact local identity in a separate
        // short-lived ledger so a structural @resource literal can consume
        // the producer without double-counting the pointer as a release slot.
        if(zt_resource_type(ty,decls)==0){
            if(source.depth==0&&source.name.len>0){zt_res_raw_remove(flow,source.name);}
            if(target.depth==0&&target.name.len>0){zt_res_raw_add(flow,target.name);}
            let existing:i32=zt_res_slot_has(flow.*.slots,target,arena.*);if(existing>=0&&flow.*.slots.data[existing].state!=0){errors=errors+zt_machine_error("live acquired resource is overwritten before release",context);}let slot:ZTResSlot=ZTResSlot{.path=target,.ty=ty,.release=release,.state=1};if(existing>=0){flow.*.slots.data[existing]=slot;}else{push[ZTResSlot](&flow.*.slots,slot);}
            return errors;
        }
        let existing:i32=zt_res_slot_has(flow.*.slots,target,arena.*);if(existing>=0&&flow.*.slots.data[existing].state!=0){errors=errors+zt_machine_error("live acquired resource is overwritten before release",context);}let initial:i32=1;if(ty.len>0&&ty[0]=='?'){initial=3;}let slot:ZTResSlot=ZTResSlot{.path=target,.ty=ty,.release=release,.state=initial};if(existing>=0){flow.*.slots.data[existing]=slot;}else{push[ZTResSlot](&flow.*.slots,slot);}zt_res_retained_call_loans(flow,n,target,decls,arena);return errors;}
    let target_slot:i32=zt_res_slot_has(flow.*.slots,target,arena.*);
    if(target_slot>=0){
        if(flow.*.slots.data[target_slot].state==1){return errors+zt_machine_error("live acquired resource is overwritten before release",context);}
        return errors+zt_machine_error("resource read/write is unavailable after move or release",context);
    }
    zt_res_assign_loans(flow,target,n,arena);
    // Pure Zag constructors may return an ordinary aggregate view rather than
    // a newly acquired raw capability. Preserve the declared retained inputs
    // in that result just as the foreign @acquires path above does.
    zt_res_retained_call_loans(flow,n,target,decls,arena);return errors;
}
fn zt_res_join(base:ZTResFlow,a:ZTResFlow,b:ZTResFlow,arena:ArrayList[ZTAggPathNode])ZTResFlow{if(a.terminated==1&&b.terminated==0){return zt_res_flow_clone(b);}if(b.terminated==1&&a.terminated==0){return zt_res_flow_clone(a);}let out:ZTResFlow=zt_res_flow_clone(base);out.terminated=a.terminated&b.terminated;let all:ArrayList[ZTResSlot]=make[ZTResSlot](a.slots.len+b.slots.len+1);let i:i32=0;while(i<a.slots.len){push[ZTResSlot](&all,a.slots.data[i]);i=i+1;}i=0;while(i<b.slots.len){if(zt_res_slot_has(all,b.slots.data[i].path,arena)<0){push[ZTResSlot](&all,b.slots.data[i]);}i=i+1;}free[ZTResSlot](&out.slots);out.slots=all;i=0;while(i<out.slots.len){let ia:i32=zt_res_slot_has(a.slots,out.slots.data[i].path,arena);let ib:i32=zt_res_slot_has(b.slots,out.slots.data[i].path,arena);let sa:i32=0;let sb:i32=0;if(ia>=0){sa=a.slots.data[ia].state;}if(ib>=0){sb=b.slots.data[ib].state;}if(sa==sb){out.slots.data[i].state=sa;}else{out.slots.data[i].state=2;}i=i+1;}free[ZTResLoan](&out.loans);out.loans=make[ZTResLoan](a.loans.len+b.loans.len+1);i=0;while(i<a.loans.len){zt_res_add_loan(&out,a.loans.data[i].holder,a.loans.data[i].owner,arena);i=i+1;}i=0;while(i<b.loans.len){zt_res_add_loan(&out,b.loans.data[i].holder,b.loans.data[i].owner,arena);i=i+1;}
    // A raw identity is valid after a join only when both paths still own it.
    // If one path consumed or released it, dropping it here is conservative;
    // aggregate provenance remains responsible for the underlying pointer.
    free[[]u8](&out.raw_producers);out.raw_producers=make[[]u8](a.raw_producers.len+b.raw_producers.len+1);i=0;while(i<a.raw_producers.len){if(zt_res_raw_has(b,a.raw_producers.data[i])==1){push[[]u8](&out.raw_producers,a.raw_producers.data[i]);}i=i+1;}return out;}
fn zt_res_live_errors(flow:ZTResFlow,context:[]u8)i32{let errors:i32=0;let si:i32=0;while(si<flow.slots.len){let slot:ZTResSlot=flow.slots.data[si];if(slot.state!=0){if(slot.state==2){errors=errors+zt_machine_error("resource is released or moved on only some control-flow paths",context);}else if(slot.state==3){errors=errors+zt_machine_error("nullable acquired resource is not proven absent or released",context);}else{errors=errors+zt_machine_error(_zag_str_concat("resource owned by `",_zag_str_concat(slot.path.name,"` is neither released, moved, nor returned")),context);}}si=si+1;}return errors;}
fn zt_res_null_path(n:*Node,arena:*ArrayList[ZTAggPathNode])ZTAggPath{switch(n.*){.bin=>|x|{if(@strEq(x.op,"==")||@strEq(x.op,"!=")){let left:ZTAggPath=zt_agg_expr_path(x.l,arena);let right:ZTAggPath=zt_agg_expr_path(x.r,arena);let lid:[]u8=zt_expr_transparent_id(x.l);let rid:[]u8=zt_expr_transparent_id(x.r);if(@strEq(rid,"null")){return left;}if(@strEq(lid,"null")){return right;}}}else=>{}}return zt_agg_empty_path();}
fn zt_res_null_is_equal(n:*Node)i32{switch(n.*){.bin=>|x|{return @strEq(x.op,"==") as i32;}else=>{}}return 0;}
// Raw allocator returns use non-optional pointer syntax but may still return
// null.  A direct null test therefore refines both the explicit nullable
// state (3) and a live raw allocation state (1): the null arm owns nothing,
// while the non-null arm retains the release obligation.
fn zt_res_refine_null(cond:*Node,yes:*ZTResFlow,no:*ZTResFlow,arena:*ArrayList[ZTAggPathNode])void{let path:ZTAggPath=zt_res_null_path(cond,arena);if(path.name.len==0){return;}let yi:i32=zt_res_slot_has(yes.*.slots,path,arena.*);let ni:i32=zt_res_slot_has(no.*.slots,path,arena.*);if(yi<0||ni<0||((yes.*.slots.data[yi].state!=3&&yes.*.slots.data[yi].state!=1)||(no.*.slots.data[ni].state!=3&&no.*.slots.data[ni].state!=1))){return;}if(zt_res_null_is_equal(cond)==1){yes.*.slots.data[yi].state=0;no.*.slots.data[ni].state=1;}else{yes.*.slots.data[yi].state=1;no.*.slots.data[ni].state=0;}}
fn zt_res_move_return_values(flow:*ZTResFlow,n:*Node,decls:ArrayList[*Node],context:[]u8,arena:*ArrayList[ZTAggPathNode])i32{
    let errors:i32=0;
    switch(n.*){
        .cast_=>|x|{return zt_res_move_return_values(flow,x.expr,decls,context,arena);}
        .un=>|x|{if(@strEq(x.op,"try")){return zt_res_move_return_values(flow,x.e,decls,context,arena);}return errors;}
        .slit_=>|x|{let i:i32=0;while(i<x.fields.len){errors=errors+zt_res_move_return_values(flow,x.fields.data[i].val,decls,context,arena);i=i+1;}return errors;}
        else=>{}
    }
    let value:ZTExpr=zt_expr_type(n,flow.*.env,decls,context);let path:ZTAggPath=zt_agg_expr_path(n,arena);
    let returned_owner:ZTAggPath=zt_res_returns_owner_source(n,decls,arena);
    if(returned_owner.name.len>0){let owner_state:i32=zt_res_access_state(flow.*,returned_owner,arena.*);if(owner_state==1){let moved_errors:i32=zt_res_transition_under(flow,returned_owner,0,context,arena.*);errors=errors+moved_errors;if(moved_errors==0){zt_res_clear_loans(flow,returned_owner,arena.*);}}return errors;}
    // Raw acquired pointers use the same exact release slots as structural
    // resources, but their nominal type is not itself `@resource`.  A direct
    // return of a tracked slot is therefore a valid ownership transfer even
    // when the value expression is `*T`; an untracked pointer remains outside
    // this flow and is not silently promoted.
    let tracked:i32=zt_res_path_state(flow.*,path,arena.*);
    if(path.name.len>0&&tracked==1&&(value.known==1&&zt_resource_type(value.ty,decls)==1||zt_res_slot_has(flow.*.slots,path,arena.*)>=0)){let moved_errors:i32=zt_res_transition_under(flow,path,0,context,arena.*);errors=errors+moved_errors;if(moved_errors==0){zt_res_clear_loans(flow,path,arena.*);}}
    return errors;
}
fn zt_res_scope_binding(flow:ZTResFlow,start:i32,name:[]u8)i32{let i:i32=start;while(i<flow.bindings.len){if(@strEq(flow.bindings.data[i],name)){return 1;}i=i+1;}return 0;}
fn zt_res_end_scope(flow:*ZTResFlow,binding_start:i32,env_start:i32,context:[]u8,arena:ArrayList[ZTAggPathNode])i32{
    let errors:i32=0;let bi:i32=binding_start;
    if(flow.*.terminated==0){while(bi<flow.*.bindings.len){let local:[]u8=flow.*.bindings.data[bi];let si:i32=0;while(si<flow.*.slots.len){let slot:ZTResSlot=flow.*.slots.data[si];if(@strEq(slot.path.name,local)&&slot.state!=0){errors=errors+zt_machine_error(_zag_str_concat("resource owned by `",_zag_str_concat(local,"` is neither released, moved, nor returned before its scope ends")),context);flow.*.slots.data[si].state=0;}si=si+1;}bi=bi+1;}}
    let kept:ArrayList[ZTResLoan]=make[ZTResLoan](flow.*.loans.len+1);let li:i32=0;while(li<flow.*.loans.len){let loan:ZTResLoan=flow.*.loans.data[li];let holder_local:i32=zt_res_scope_binding(flow.*,binding_start,loan.holder.name);let owner_local:i32=zt_res_scope_binding(flow.*,binding_start,loan.owner);if(holder_local==0&&owner_local==1&&flow.*.terminated==0){errors=errors+zt_machine_error("borrowed view escapes a local resource scope",context);}if(holder_local==0&&owner_local==0&&zt_res_loan_has(kept,loan,arena)==0){push[ZTResLoan](&kept,loan);}li=li+1;}
    free[ZTResLoan](&flow.*.loans);flow.*.loans=kept;flow.*.bindings.len=binding_start;flow.*.env.len=env_start;return errors;
}
fn zt_res_check_scoped_body(body:ArrayList[*Node],flow:*ZTResFlow,decls:ArrayList[*Node],context:[]u8,arena:*ArrayList[ZTAggPathNode])i32{
    let binding_start:i32=flow.*.bindings.len;let env_start:i32=flow.*.env.len;let errors:i32=zt_res_check_body(body,flow,decls,context,arena);return errors+zt_res_end_scope(flow,binding_start,env_start,context,arena.*);
}
fn zt_res_check_body(body:ArrayList[*Node],flow:*ZTResFlow,decls:ArrayList[*Node],context:[]u8,arena:*ArrayList[ZTAggPathNode])i32{
    let errors:i32=0;let i:i32=0;while(i<body.len){switch(body.data[i].*){
        .let_=>|l|{if(l.has_init==1){errors=errors+zt_res_call(l.expr,flow,decls,context,arena);}let ty:[]u8=l.dty;if(l.has_dty==0&&l.has_init==1){let value:ZTExpr=zt_expr_type(l.expr,flow.*.env,decls,context);if(value.known==1){ty=value.ty;}}if(ty.len==0){ty="?";}push[ZTBind](&flow.*.env,ZTBind{.name=l.name,.ty=ty});if(zt_in_names(flow.*.bindings,l.name)==0){push[[]u8](&flow.*.bindings,l.name);}if(l.has_init==1){errors=errors+zt_res_init_value(flow,zt_agg_root_path(l.name),ty,l.expr,decls,context,arena);}}
        .assign=>|a|{let target:ZTAggPath=zt_agg_expr_path(a.target,arena);if(target.depth>0){errors=errors+zt_res_call(a.target,flow,decls,context,arena);}if(zt_res_realloc_reassign(a.target,a.expr)==1){let state:i32=zt_res_path_state(flow.*,target,arena.*);if(state>=0&&state!=1){errors=errors+zt_machine_error("reallocates a resource field after move or release",context);}errors=errors+zt_res_realloc_tail_calls(a.expr,flow,decls,context,arena);}else{errors=errors+zt_res_call(a.expr,flow,decls,context,arena);let value:ZTExpr=zt_expr_type(a.target,flow.*.env,decls,context);let ty:[]u8="";if(value.known==1){ty=value.ty;}if(ty.len>0){errors=errors+zt_res_init_value(flow,target,ty,a.expr,decls,context,arena);}else{zt_res_assign_loans(flow,target,a.expr,arena);}}}
        .ret=>|r|{if(r.has_expr==1){errors=errors+zt_res_call(r.expr,flow,decls,context,arena);if(zt_resource_type(flow.*.return_ty,decls)==1){let returned:ZTAggPath=zt_agg_root_path("<resource-return>");errors=errors+zt_res_init_value(flow,returned,flow.*.return_ty,r.expr,decls,context,arena);let moved_errors:i32=zt_res_transition_under(flow,returned,0,context,arena.*);errors=errors+moved_errors;if(moved_errors==0){zt_res_clear_loans(flow,returned,arena.*);}}else{errors=errors+zt_res_move_return_values(flow,r.expr,decls,context,arena);}}errors=errors+zt_res_live_errors(flow.*,context);flow.*.terminated=1;i=body.len;}
        .estmt=>|e|{errors=errors+zt_res_call(e.expr,flow,decls,context,arena);}
        .defer_=>|d|{errors=errors+zt_res_call(d.expr,flow,decls,context,arena);}
        .unsafe_=>|u|{errors=errors+zt_res_check_scoped_body(u.body,flow,decls,context,arena);}
        .if_=>|x|{errors=errors+zt_res_call(x.cond,flow,decls,context,arena);let base:ZTResFlow=zt_res_flow_clone(flow.*);let a:ZTResFlow=zt_res_flow_clone(base);let b:ZTResFlow=zt_res_flow_clone(base);zt_res_refine_null(x.cond,&a,&b,arena);errors=errors+zt_res_check_scoped_body(x.then_body,&a,decls,context,arena);if(x.has_els==1){errors=errors+zt_res_check_scoped_body(x.els_body,&b,decls,context,arena);}let joined:ZTResFlow=zt_res_join(base,a,b,arena.*);zt_res_flow_free(&base);zt_res_flow_free(&a);zt_res_flow_free(&b);zt_res_flow_replace(flow,joined);}
        .while_=>|x|{errors=errors+zt_res_call(x.cond,flow,decls,context,arena);let base:ZTResFlow=zt_res_flow_clone(flow.*);let a:ZTResFlow=zt_res_flow_clone(base);errors=errors+zt_res_check_scoped_body(x.body,&a,decls,context,arena);let joined:ZTResFlow=zt_res_join(base,base,a,arena.*);zt_res_flow_free(&base);zt_res_flow_free(&a);zt_res_flow_replace(flow,joined);}
        .switch_=>|x|{errors=errors+zt_res_call(x.subject,flow,decls,context,arena);let base:ZTResFlow=zt_res_flow_clone(flow.*);let joined:ZTResFlow=zt_res_flow_clone(base);let have:i32=0;let ai:i32=0;while(ai<x.arms.len){let arm:ZTResFlow=zt_res_flow_clone(base);errors=errors+zt_res_check_scoped_body(x.arms.data[ai].body,&arm,decls,context,arena);if(have==0){zt_res_flow_free(&joined);joined=arm;have=1;}else{let next:ZTResFlow=zt_res_join(base,joined,arm,arena.*);zt_res_flow_free(&joined);zt_res_flow_free(&arm);joined=next;}ai=ai+1;}if(x.has_els==1){let els:ZTResFlow=zt_res_flow_clone(base);errors=errors+zt_res_check_scoped_body(x.els_body,&els,decls,context,arena);if(have==0){zt_res_flow_free(&joined);joined=els;have=1;}else{let next:ZTResFlow=zt_res_join(base,joined,els,arena.*);zt_res_flow_free(&joined);zt_res_flow_free(&els);joined=next;}}zt_res_flow_free(&base);zt_res_flow_replace(flow,joined);}
        else=>{}
    }i=i+1;}return errors;
}
fn zt_check_resource_flows(decls:ArrayList[*Node])i32{
    let errors:i32=0;let i:i32=0;
    while(i<decls.len){switch(decls.data[i].*){.fn_decl=>|f|{if(f.is_extern==0){let flow:ZTResFlow=zt_res_flow_new(f.params.len+8);flow.return_ty=f.ret;let arena:ArrayList[ZTAggPathNode]=make[ZTAggPathNode](16);let pi:i32=0;while(pi<f.params.len){let p:Param=f.params.data[pi];push[ZTBind](&flow.env,ZTBind{.name=p.name,.ty=p.pty});
        // Structural resource parameters are observations unless the signature
        // explicitly transfers ownership.  Only @consumes seeds live slots in
        // the callee; otherwise returning/storing/releasing the value has no
        // owned source and remains fail-closed.
        if(zt_resource_type(p.pty,decls)==1&&zt_consumes_param(decls,f.name,pi)==1){zt_res_add_type_slots(&flow,zt_agg_root_path(p.name),p.pty,1,decls,&arena);}
        else if(zt_consumes_param(decls,f.name,pi)==1&&p.pty.len>1&&p.pty[0]=='*'&&zt_resource_type(p.pty[1..],decls)==1){zt_res_add_type_slots(&flow,zt_agg_path_append(&arena,zt_agg_root_path(p.name),"*"),p.pty[1..],1,decls,&arena);}pi=pi+1;}let context:[]u8=_zag_str_concat("function ",f.name);errors=errors+zt_res_check_body(f.body,&flow,decls,context,&arena);if(flow.terminated==0){errors=errors+zt_res_live_errors(flow,context);}zt_res_flow_free(&flow);free[ZTAggPathNode](&arena);}}else=>{}}i=i+1;}return errors;
}
fn zt_check_v2_resources(decls:ArrayList[*Node],file:[]u8)i32{if(@strEq(v2_project_edition(file),"2027")==0){return 0;}return zt_check_resource_flows(decls);}

// ── edition-2027 explicit borrow-contract slice ───────────────────────────
// Contracts are deliberately opt-in.  @borrows declares that the first named
// parameter is shared/read-only.  @borrows_mut permits mutation by the callee;
// only an explicit retained-return relation makes a pointer-bearing result an
// escaping exclusive borrow for the remainder of this function. A fresh
// aggregate result has no source lifetime. We have no lexical end-borrow syntax
// yet, so a proven retained result remains conservative: callers must not use
// the owner (or a non-borrow alias) while it remains active.
//
// This pass is edition-2027 only.  It does not reinterpret ordinary pointers
// or calls in 2026 projects, and it never assumes an unknown call borrows.
struct ZTBorrowAlias { name: []u8, root: []u8, mode: i32 }
fn zt_borrow_replace(dst:*ArrayList[ZTBorrowAlias],next:ArrayList[ZTBorrowAlias])void{free[ZTBorrowAlias](dst);dst.*=next;}
fn zt_borrow_mode(decls:ArrayList[*Node],name:[]u8)i32{if(zt_fn_has_annot(decls,name,"@borrows_mut")==1){return 2;}if(zt_fn_has_annot(decls,name,"@borrows")==1){return 1;}return 0;}
// A borrow contract has exactly one tracked owner: parameter zero. Later
// parameters may tune that operation only when they are plain builtin scalar
// values, so they cannot carry a second owner, borrowed pointer, aggregate, or
// callback across the contract boundary.
fn zt_borrow_aux_scalar_type(ty:[]u8)i32{
    if(ty.len==0||@strEq(ty,"void")){return 0;}
    if(ty[0]=='*'||ty[0]=='?'||ty[0]=='!'||zt_starts(ty,"[]")==1||zt_starts(ty,"fn(")==1){return 0;}
    return zt_is_builtin(ty);
}
// Borrow identity follows values only when their representation can carry a
// pointer or another modeled resource. Reading a field or indexed element
// loads the value stored there; it does not take an address into the borrowed
// container. Explicit address-of projections remain tied to the container and
// are checked on escape below.
fn zt_type_carries_borrow(ty0:[]u8,decls:ArrayList[*Node],depth:i32)i32{
    if(ty0.len==0){return 1;}
    let ty:[]u8=ty0;
    if((ty[0]=='!'||ty[0]=='?')&&ty.len>1){return zt_type_carries_borrow(ty[1..],decls,depth);}
    if(ty[0]=='*'||zt_starts(ty,"[]")==1||zt_starts(ty,"fn(")==1||@strEq(ty,"Allocation")){return 1;}
    if(zt_is_builtin(ty)==1||@strEq(ty,"void")){return 0;}
    if(depth>64){return 1;}
    let base:[]u8=ty;let args:ArrayList[[]u8]=make[[]u8](0);
    if(is_generic_app(ty)){
        let lb:i32=index_of(ty,'[');base=ty[0..lb];free[[]u8](&args);
        args=split_args(ty[lb+1..ty.len-1]);
    }
    let i:i32=0;while(i<decls.len){switch(decls.data[i].*){
        .enum_=>|e|{if(@strEq(e.name,ty)){return 0;}}
        .struct_=>|s|{if(@strEq(s.name,base)&&s.tparams.len==args.len){let fi:i32=0;while(fi<s.fields.len){let field_ty:[]u8=zt_subst_type(s.fields.data[fi].pty,s.tparams,args);if(zt_type_carries_borrow(field_ty,decls,depth+1)==1){free[[]u8](&args);return 1;}fi=fi+1;}free[[]u8](&args);return 0;}}
        .union_=>|u|{if(@strEq(u.name,ty)){let fi:i32=0;while(fi<u.fields.len){if(zt_type_carries_borrow(u.fields.data[fi].pty,decls,depth+1)==1){return 1;}fi=fi+1;}return 0;}}
        else=>{}
    }i=i+1;}
    free[[]u8](&args);
    return 1;
}

// A visible Zag callee that observes only pointer-free projections does not
// receive a lifetime capability even when its by-value parameter's complete
// type contains pointers.  This summary is intentionally narrow: any whole
// value use, pointer-bearing projection, local alias, store, return, or call
// without an exact borrow contract fails closed.  It lets helpers read scalar
// identity/layout fields without forcing a dishonest whole-value annotation.
struct ZTParamProjection { matched:i32, ty:[]u8 }
fn zt_param_projection(n:*Node,param:[]u8,param_ty:[]u8,decls:ArrayList[*Node])ZTParamProjection{
    switch(n.*){
        .id=>|x|{if(@strEq(x.name,param)){return ZTParamProjection{.matched=1,.ty=param_ty};}}
        .cast_=>|x|{let base:ZTParamProjection=zt_param_projection(x.expr,param,param_ty,decls);if(base.matched==1){return ZTParamProjection{.matched=1,.ty=x.target};}}
        .un=>|x|{let base:ZTParamProjection=zt_param_projection(x.e,param,param_ty,decls);if(base.matched==1){if(@strEq(x.op,"*")&&base.ty.len>1&&base.ty[0]=='*'){return ZTParamProjection{.matched=1,.ty=base.ty[1..]};}if(@strEq(x.op,"&")){return ZTParamProjection{.matched=1,.ty="*opaque"};}return base;}}
        .fld=>|x|{let base:ZTParamProjection=zt_param_projection(x.base,param,param_ty,decls);if(base.matched==1){if(@strEq(x.fname,"*")&&base.ty.len>1&&base.ty[0]=='*'){return ZTParamProjection{.matched=1,.ty=base.ty[1..]};}if(@strEq(x.fname,"len")&&zt_starts(base.ty,"[]")==1){return ZTParamProjection{.matched=1,.ty="i32"};}return ZTParamProjection{.matched=1,.ty=zt_aggregate_field_type(base.ty,x.fname,decls)};}}
        .idx=>|x|{let base:ZTParamProjection=zt_param_projection(x.base,param,param_ty,decls);if(base.matched==1){if(base.ty.len>2&&zt_starts(base.ty,"[]")==1){return ZTParamProjection{.matched=1,.ty=base.ty[2..]};}if(base.ty.len>1&&base.ty[0]=='*'){return ZTParamProjection{.matched=1,.ty=base.ty[1..]};}return ZTParamProjection{.matched=1,.ty=""};}}
        .slice_=>|x|{let base:ZTParamProjection=zt_param_projection(x.base,param,param_ty,decls);if(base.matched==1){return base;}}
        else=>{}
    }
    return ZTParamProjection{.matched=0,.ty=""};
}
fn zt_param_projection_pointer_free(p:ZTParamProjection,decls:ArrayList[*Node])i32{return (p.matched==1&&p.ty.len>0&&zt_type_carries_borrow(p.ty,decls,0)==0) as i32;}
fn zt_param_scalar_expr_safe_depth(n:*Node,param:[]u8,param_ty:[]u8,decls:ArrayList[*Node],depth:i32)i32{
    if(depth>64){return 0;}
    let projection:ZTParamProjection=zt_param_projection(n,param,param_ty,decls);
    if(projection.matched==1){return zt_param_projection_pointer_free(projection,decls);}
    switch(n.*){
        .bin=>|x|{return zt_param_scalar_expr_safe_depth(x.l,param,param_ty,decls,depth)&zt_param_scalar_expr_safe_depth(x.r,param,param_ty,decls,depth);}
        .un=>|x|{return zt_param_scalar_expr_safe_depth(x.e,param,param_ty,decls,depth);}
        .call=>|x|{
            let name:[]u8=zt_direct_name(x.callee);let i:i32=0;
            while(i<x.args.len){let arg:ZTParamProjection=zt_param_projection(x.args.data[i],param,param_ty,decls);if(arg.matched==1){if(zt_param_projection_pointer_free(arg,decls)==0&&zt_param_borrow_mode(decls,name,i)==0&&zt_callee_param_scalar_only_depth(decls,name,i,depth+1)==0){return 0;}}else if(zt_param_scalar_expr_safe_depth(x.args.data[i],param,param_ty,decls,depth)==0){return 0;}i=i+1;}
            return 1;
        }
        .idx=>|x|{return zt_param_scalar_expr_safe_depth(x.base,param,param_ty,decls,depth)&zt_param_scalar_expr_safe_depth(x.idx,param,param_ty,decls,depth);}
        .fld=>|x|{return zt_param_scalar_expr_safe_depth(x.base,param,param_ty,decls,depth);}
        .cast_=>|x|{return zt_param_scalar_expr_safe_depth(x.expr,param,param_ty,decls,depth);}
        .slice_=>|x|{let safe:i32=zt_param_scalar_expr_safe_depth(x.base,param,param_ty,decls,depth)&zt_param_scalar_expr_safe_depth(x.lo,param,param_ty,decls,depth);if(x.has_hi==1){safe=safe&zt_param_scalar_expr_safe_depth(x.hi,param,param_ty,decls,depth);}return safe;}
        .slit_=>|x|{let i:i32=0;while(i<x.fields.len){if(zt_param_scalar_expr_safe_depth(x.fields.data[i].val,param,param_ty,decls,depth)==0){return 0;}i=i+1;}return 1;}
        else=>{}
    }
    return 1;
}
fn zt_param_target_uses(n:*Node,param:[]u8,param_ty:[]u8,decls:ArrayList[*Node])i32{
    if(zt_param_projection(n,param,param_ty,decls).matched==1){return 1;}
    switch(n.*){.idx=>|x|{return zt_param_target_uses(x.base,param,param_ty,decls)|zt_param_target_uses(x.idx,param,param_ty,decls);}.fld=>|x|{return zt_param_target_uses(x.base,param,param_ty,decls);}.un=>|x|{return zt_param_target_uses(x.e,param,param_ty,decls);}.cast_=>|x|{return zt_param_target_uses(x.expr,param,param_ty,decls);}else=>{}}
    return 0;
}
fn zt_param_scalar_body_safe_depth(body:ArrayList[*Node],param:[]u8,param_ty:[]u8,decls:ArrayList[*Node],depth:i32)i32{
    if(depth>64){return 0;}
    let i:i32=0;while(i<body.len){switch(body.data[i].*){
        .let_=>|x|{if(x.has_init==1&&zt_param_scalar_expr_safe_depth(x.expr,param,param_ty,decls,depth)==0){return 0;}}
        .ret=>|x|{if(x.has_expr==1&&zt_param_scalar_expr_safe_depth(x.expr,param,param_ty,decls,depth)==0){return 0;}}
        .assign=>|x|{if(zt_param_target_uses(x.target,param,param_ty,decls)==1||zt_param_scalar_expr_safe_depth(x.expr,param,param_ty,decls,depth)==0){return 0;}}
        .estmt=>|x|{if(zt_param_scalar_expr_safe_depth(x.expr,param,param_ty,decls,depth)==0){return 0;}}
        .defer_=>|x|{if(zt_param_scalar_expr_safe_depth(x.expr,param,param_ty,decls,depth)==0){return 0;}}
        .unsafe_=>|x|{if(zt_param_scalar_body_safe_depth(x.body,param,param_ty,decls,depth)==0){return 0;}}
        .if_=>|x|{if(zt_param_scalar_expr_safe_depth(x.cond,param,param_ty,decls,depth)==0||zt_param_scalar_body_safe_depth(x.then_body,param,param_ty,decls,depth)==0||zt_param_scalar_body_safe_depth(x.els_body,param,param_ty,decls,depth)==0){return 0;}}
        .while_=>|x|{if(zt_param_scalar_expr_safe_depth(x.cond,param,param_ty,decls,depth)==0||zt_param_scalar_body_safe_depth(x.body,param,param_ty,decls,depth)==0){return 0;}}
        .switch_=>|x|{if(zt_param_scalar_expr_safe_depth(x.subject,param,param_ty,decls,depth)==0||zt_param_scalar_body_safe_depth(x.els_body,param,param_ty,decls,depth)==0){return 0;}let ai:i32=0;while(ai<x.arms.len){if(zt_param_scalar_body_safe_depth(x.arms.data[ai].body,param,param_ty,decls,depth)==0){return 0;}ai=ai+1;}}
        else=>{}
    }i=i+1;}
    return 1;
}
fn zt_param_body_observes(body:ArrayList[*Node],param:[]u8)i32{
    let i:i32=0;while(i<body.len){switch(body.data[i].*){
        .let_=>|x|{if(x.has_init==1&&zt_res_expr_uses_name(x.expr,param)==1){return 1;}}
        .ret=>|x|{if(x.has_expr==1&&zt_res_expr_uses_name(x.expr,param)==1){return 1;}}
        .assign=>|x|{if(zt_res_expr_uses_name(x.target,param)==1||zt_res_expr_uses_name(x.expr,param)==1){return 1;}}
        .estmt=>|x|{if(zt_res_expr_uses_name(x.expr,param)==1){return 1;}}
        .defer_=>|x|{if(zt_res_expr_uses_name(x.expr,param)==1){return 1;}}
        .unsafe_=>|x|{if(zt_param_body_observes(x.body,param)==1){return 1;}}
        .if_=>|x|{if(zt_res_expr_uses_name(x.cond,param)==1||zt_param_body_observes(x.then_body,param)==1||zt_param_body_observes(x.els_body,param)==1){return 1;}}
        .while_=>|x|{if(zt_res_expr_uses_name(x.cond,param)==1||zt_param_body_observes(x.body,param)==1){return 1;}}
        .switch_=>|x|{if(zt_res_expr_uses_name(x.subject,param)==1||zt_param_body_observes(x.els_body,param)==1){return 1;}let ai:i32=0;while(ai<x.arms.len){if(zt_param_body_observes(x.arms.data[ai].body,param)==1){return 1;}ai=ai+1;}}
        else=>{}
    }i=i+1;}return 0;
}
fn zt_callee_param_scalar_only_depth(decls:ArrayList[*Node],name:[]u8,index:i32,depth:i32)i32{
    if(depth>64){return 0;}
    if(name.len==0||index<0){return 0;}let found:i32=0;let i:i32=0;
    while(i<decls.len){switch(decls.data[i].*){.fn_decl=>|f|{if(@strEq(f.name,name)){if(f.is_extern==1||index>=f.params.len){return 0;}let p:Param=f.params.data[index];if(zt_borrow_param_kind(p.pty,decls)==0||zt_param_scalar_body_safe_depth(f.body,p.name,p.pty,decls,depth)==0||(zt_resource_type(p.pty,decls)==1&&zt_param_body_observes(f.body,p.name)==0)){return 0;}found=1;}}else=>{}}i=i+1;}
    return found;
}
fn zt_callee_param_scalar_only(decls:ArrayList[*Node],name:[]u8,index:i32)i32{return zt_callee_param_scalar_only_depth(decls,name,index,0);}
fn zt_borrow_alias_mode(borrows:ArrayList[ZTBorrowAlias],name:[]u8)i32{let i:i32=0;while(i<borrows.len){if(@strEq(borrows.data[i].name,name)){return borrows.data[i].mode;}i=i+1;}return 0;}
fn zt_borrow_alias_root(borrows:ArrayList[ZTBorrowAlias],name:[]u8)[]u8{let i:i32=0;while(i<borrows.len){if(@strEq(borrows.data[i].name,name)){return borrows.data[i].root;}i=i+1;}return name;}
fn zt_borrow_set(borrows:*ArrayList[ZTBorrowAlias],name:[]u8,root:[]u8,mode:i32)void{let i:i32=0;while(i<borrows.*.len){if(@strEq(borrows.*.data[i].name,name)){borrows.*.data[i]=ZTBorrowAlias{.name=name,.root=root,.mode=mode};return;}i=i+1;}push[ZTBorrowAlias](borrows,ZTBorrowAlias{.name=name,.root=root,.mode=mode});}
fn zt_borrow_clone(borrows:ArrayList[ZTBorrowAlias])ArrayList[ZTBorrowAlias]{let out:ArrayList[ZTBorrowAlias]=make[ZTBorrowAlias](borrows.len+1);let i:i32=0;while(i<borrows.len){push[ZTBorrowAlias](&out,borrows.data[i]);i=i+1;}return out;}
// A borrow which is active on any control-flow path is still active after the
// join. This is a may-analysis: forgetting a one-sided borrow would permit a
// later owner release/use while that path still retains the borrowed value.
// Preserve conflicting bindings as separate records so root availability also
// remains conservative; ordinary name lookup may use the first record, but no
// possible borrowed root is dropped from owner-side checks.
fn zt_borrow_may_add(out:*ArrayList[ZTBorrowAlias],x:ZTBorrowAlias)void{let i:i32=0;while(i<out.*.len){let y:ZTBorrowAlias=out.*.data[i];if(@strEq(y.name,x.name)&&@strEq(y.root,x.root)&&y.mode==x.mode){return;}i=i+1;}push[ZTBorrowAlias](out,x);}
fn zt_borrow_may_join(a:ArrayList[ZTBorrowAlias],b:ArrayList[ZTBorrowAlias])ArrayList[ZTBorrowAlias]{let out:ArrayList[ZTBorrowAlias]=make[ZTBorrowAlias](a.len+b.len+1);let i:i32=0;while(i<a.len){zt_borrow_may_add(&out,a.data[i]);i=i+1;}i=0;while(i<b.len){zt_borrow_may_add(&out,b.data[i]);i=i+1;}return out;}
// Mode 3 is a writable local aggregate containing a shared loan. It keeps the
// backing owner unavailable like mode 1 while allowing unrelated fields of
// the local container to be initialized or updated.
fn zt_borrow_root_has(borrows:ArrayList[ZTBorrowAlias],root:[]u8,mode:i32)i32{let i:i32=0;while(i<borrows.len){let actual:i32=borrows.data[i].mode;if((actual==mode||(mode==1&&actual==3))&&@strEq(borrows.data[i].root,root)){return 1;}i=i+1;}return 0;}
fn zt_borrow_root_mode(borrows:ArrayList[ZTBorrowAlias],root:[]u8)i32{let mode:i32=0;let i:i32=0;while(i<borrows.len){if(@strEq(borrows.data[i].root,root)&&borrows.data[i].mode>mode){mode=borrows.data[i].mode;}i=i+1;}return mode;}
// Function-level borrow contracts accept a direct projection of one named
// owner (for example `&iterator` or `bytes[0..n]`).  Keep that lexical root
// available for retained-return tracking without admitting arbitrary calls,
// binary expressions, or temporaries as lifetime carriers.
fn zt_borrow_contract_arg_name(n:*Node)[]u8{
    switch(n.*){
        .id=>|x|{return x.name;}
        .cast_=>|x|{return zt_borrow_contract_arg_name(x.expr);}
        .fld=>|x|{return zt_borrow_contract_arg_name(x.base);}
        .idx=>|x|{return zt_borrow_contract_arg_name(x.base);}
        .slice_=>|x|{return zt_borrow_contract_arg_name(x.base);}
        .un=>|x|{if(@strEq(x.op,"&")||@strEq(x.op,"*")){return zt_borrow_contract_arg_name(x.e);}}
        else=>{}
    }
    return "";
}
fn zt_borrow_expr_root(n:*Node,aliases:ArrayList[ZTOwnAlias],borrows:ArrayList[ZTBorrowAlias])[]u8{let name:[]u8=zt_borrow_contract_arg_name(n);if(name.len==0){return "";}let b:[]u8=zt_borrow_alias_root(borrows,name);return zt_alias_root(aliases,b);}
fn zt_borrowed_lvalue_root(n:*Node,aliases:ArrayList[ZTOwnAlias],borrows:ArrayList[ZTBorrowAlias])[]u8{
    switch(n.*){
        .id=>|x|{let root:[]u8=zt_alias_root(aliases,zt_borrow_alias_root(borrows,x.name));if(zt_borrow_alias_mode(borrows,x.name)>0||zt_borrow_root_has(borrows,root,1)==1||zt_borrow_root_has(borrows,root,2)==1){return root;}}
        .cast_=>|x|{return zt_borrowed_lvalue_root(x.expr,aliases,borrows);}
        .un=>|x|{if(@strEq(x.op,"*")){return zt_borrowed_lvalue_root(x.e,aliases,borrows);}}
        .fld=>|x|{return zt_borrowed_lvalue_root(x.base,aliases,borrows);}
        .idx=>|x|{return zt_borrowed_lvalue_root(x.base,aliases,borrows);}
        else=>{}
    }
    return "";
}
fn zt_borrowed_expr_root(n:*Node,decls:ArrayList[*Node],env:ArrayList[ZTBind],aliases:ArrayList[ZTOwnAlias],borrows:ArrayList[ZTBorrowAlias],context:[]u8)[]u8{
    switch(n.*){
        .id=>|x|{let root:[]u8=zt_alias_root(aliases,zt_borrow_alias_root(borrows,x.name));if(zt_borrow_alias_mode(borrows,x.name)>0||zt_borrow_root_has(borrows,root,1)==1||zt_borrow_root_has(borrows,root,2)==1){return root;}}
        .cast_=>|x|{let t:ZTExpr=zt_expr_type(n,env,decls,context);if(t.known==1&&zt_type_carries_borrow(t.ty,decls,0)==0){return "";}return zt_borrowed_expr_root(x.expr,decls,env,aliases,borrows,context);}
        .un=>|x|{if(@strEq(x.op,"&")){return zt_borrowed_lvalue_root(x.e,aliases,borrows);}let t:ZTExpr=zt_expr_type(n,env,decls,context);if(t.known==1&&zt_type_carries_borrow(t.ty,decls,0)==0){return "";}return zt_borrowed_expr_root(x.e,decls,env,aliases,borrows,context);}
        .fld=>|x|{let base:ZTExpr=zt_expr_type(x.base,env,decls,context);if(@strEq(x.fname,"len")&&base.known==1&&zt_starts(base.ty,"[]")==1){return "";}let t:ZTExpr=zt_expr_type(n,env,decls,context);if(t.known==1&&zt_type_carries_borrow(t.ty,decls,0)==0){return "";}return zt_borrowed_expr_root(x.base,decls,env,aliases,borrows,context);}
        // Indexing loads an element value.  Even when that value contains a
        // pointer, the pointer was stored in the element; it is not an address
        // into the container backing allocation.  Only an explicit `&xs[i]`
        // reaches zt_borrowed_lvalue_root and inherits the container lifetime.
        .idx=>|_|{return "";}
        .slice_=>|x|{return zt_borrowed_expr_root(x.base,decls,env,aliases,borrows,context);}
        .bin=>|x|{let t:ZTExpr=zt_expr_type(n,env,decls,context);if(t.known==1&&zt_type_carries_borrow(t.ty,decls,0)==0){return "";}let l:[]u8=zt_borrowed_expr_root(x.l,decls,env,aliases,borrows,context);if(l.len>0){return l;}return zt_borrowed_expr_root(x.r,decls,env,aliases,borrows,context);}
        .slit_=>|x|{let i:i32=0;while(i<x.fields.len){let value:ZTExpr=zt_expr_type(x.fields.data[i].val,env,decls,context);if(value.known==0||zt_type_carries_borrow(value.ty,decls,0)==1){let root:[]u8=zt_borrowed_expr_root(x.fields.data[i].val,decls,env,aliases,borrows,context);if(root.len>0){return root;}}i=i+1;}}
        // A retained-return parameter is an explicit result-borrow relation.
        // The scalar borrow pass follows the first relation; the aggregate and
        // resource passes below preserve every retained input independently.
        // Only an explicit/legacy retained-return summary propagates a source
        // owner into a pointer-bearing result. An ordinary @borrows helper
        // may instead return a freshly allocated copy with no source lifetime.
        .call=>|x|{let result:ZTExpr=zt_expr_type(n,env,decls,context);if(result.known==1&&zt_type_carries_borrow(result.ty,decls,0)==0){return "";}let name:[]u8=zt_direct_name(x.callee);if(@strEq(name,"_zag_slice_ptr")&&x.args.len==1){return zt_borrowed_expr_root(x.args.data[0],decls,env,aliases,borrows,context);}let retained:i32=zt_fn_first_retained_param(decls,name);if(retained>=0&&retained<x.args.len){let root:[]u8=zt_borrow_expr_root(x.args.data[retained],aliases,borrows);if(root.len>0){return root;}}}
        else=>{}
    }
    return "";
}
fn zt_check_active_borrow_expr(n:*Node,aliases:ArrayList[ZTOwnAlias],borrows:ArrayList[ZTBorrowAlias],context:[]u8)i32{switch(n.*){.id=>|x|{let root:[]u8=zt_alias_root(aliases,zt_borrow_alias_root(borrows,x.name));if(zt_borrow_root_has(borrows,root,2)==1&&zt_borrow_alias_mode(borrows,x.name)!=2){return zt_machine_error(_zag_str_concat("owner `",_zag_str_concat(root,"` is unavailable while an exclusive mutable borrow is active")),context);}}.bin=>|x|{return zt_check_active_borrow_expr(x.l,aliases,borrows,context)+zt_check_active_borrow_expr(x.r,aliases,borrows,context);}.un=>|x|{return zt_check_active_borrow_expr(x.e,aliases,borrows,context);}.call=>|x|{let errors:i32=zt_check_active_borrow_expr(x.callee,aliases,borrows,context);let i:i32=0;while(i<x.args.len){errors=errors+zt_check_active_borrow_expr(x.args.data[i],aliases,borrows,context);i=i+1;}return errors;}.idx=>|x|{return zt_check_active_borrow_expr(x.base,aliases,borrows,context)+zt_check_active_borrow_expr(x.idx,aliases,borrows,context);}.fld=>|x|{return zt_check_active_borrow_expr(x.base,aliases,borrows,context);}.cast_=>|x|{return zt_check_active_borrow_expr(x.expr,aliases,borrows,context);}.slice_=>|x|{return zt_check_active_borrow_expr(x.base,aliases,borrows,context)+zt_check_active_borrow_expr(x.lo,aliases,borrows,context)+zt_check_active_borrow_expr(x.hi,aliases,borrows,context);}.slit_=>|x|{let errors:i32=0;let i:i32=0;while(i<x.fields.len){errors=errors+zt_check_active_borrow_expr(x.fields.data[i].val,aliases,borrows,context);i=i+1;}return errors;}else=>{}}return 0;}
fn zt_same_lvalue(a:*Node,b:*Node)i32{
    switch(a.*){.cast_=>|x|{return zt_same_lvalue(x.expr,b);}else=>{}}
    switch(b.*){.cast_=>|x|{return zt_same_lvalue(a,x.expr);}else=>{}}
    switch(a.*){
        .id=>|x|{switch(b.*){.id=>|y|{return @strEq(x.name,y.name) as i32;}else=>{}}}
        .un=>|x|{switch(b.*){.un=>|y|{if(@strEq(x.op,y.op)){return zt_same_lvalue(x.e,y.e);}}else=>{}}}
        .fld=>|x|{switch(b.*){.fld=>|y|{if(@strEq(x.fname,y.fname)){return zt_same_lvalue(x.base,y.base);}}else=>{}}}
        .idx=>|x|{switch(b.*){.idx=>|y|{if(zt_same_lvalue(x.base,y.base)==1){return zt_same_lvalue(x.idx,y.idx);}}else=>{}}}
        else=>{}
    }
    return 0;
}
// Return the lexical base of an assignable aggregate path.  The direct borrow
// pass only owns scalar alias tracking; the field-sensitive aggregate pass
// decides whether a named base is local, a permitted mutable parameter, or a
// non-local escape.  Keeping that decision in one place prevents a local
// `spec.name = borrowed_name` assignment from being rejected merely because a
// field lvalue has no transparent scalar identifier.
fn zt_lvalue_base_name(n:*Node)[]u8{
    switch(n.*){
        .id=>|x|{return x.name;}
        .cast_=>|x|{return zt_lvalue_base_name(x.expr);}
        .un=>|x|{return zt_lvalue_base_name(x.e);}
        .fld=>|x|{return zt_lvalue_base_name(x.base);}
        .idx=>|x|{return zt_lvalue_base_name(x.base);}
        else=>{}
    }
    return "";
}
fn zt_mut_borrow_realloc_reassign(target:*Node,expr:*Node,aliases:ArrayList[ZTOwnAlias],borrows:ArrayList[ZTBorrowAlias])i32{
    switch(expr.*){
        .cast_=>|x|{return zt_mut_borrow_realloc_reassign(target,x.expr,aliases,borrows);}
        .call=>|x|{if(@strEq(zt_direct_name(x.callee),"_zag_realloc")&&x.args.len==2&&zt_same_lvalue(target,x.args.data[0])==1){let root:[]u8=zt_borrowed_lvalue_root(target,aliases,borrows);if(root.len>0&&zt_borrow_root_mode(borrows,root)==2){return 1;}}}
        else=>{}
    }
    return 0;
}
fn zt_check_realloc_tail_calls(n:*Node,decls:ArrayList[*Node],env:ArrayList[ZTBind],aliases:ArrayList[ZTOwnAlias],borrows:ArrayList[ZTBorrowAlias],context:[]u8)i32{
    switch(n.*){
        .cast_=>|x|{return zt_check_realloc_tail_calls(x.expr,decls,env,aliases,borrows,context);}
        .call=>|x|{let errors:i32=0;let i:i32=1;while(i<x.args.len){errors=errors+zt_check_borrow_call(x.args.data[i],decls,env,aliases,borrows,context);i=i+1;}return errors;}
        else=>{}
    }
    return 0;
}
fn zt_check_borrow_write(n:*Node,aliases:ArrayList[ZTOwnAlias],borrows:ArrayList[ZTBorrowAlias],context:[]u8)i32{switch(n.*){.id=>|x|{let root:[]u8=zt_alias_root(aliases,zt_borrow_alias_root(borrows,x.name));let mode:i32=zt_borrow_alias_mode(borrows,x.name);if(mode==1&&zt_borrow_root_has(borrows,root,3)==0){return zt_machine_error("cannot mutate through a shared borrow",context);}if(zt_borrow_root_has(borrows,root,2)==1&&mode!=2&&mode!=3){return zt_machine_error(_zag_str_concat("cannot mutate owner `",_zag_str_concat(root,"` while an exclusive mutable borrow is active")),context);}if(zt_borrow_root_has(borrows,root,1)==1&&mode!=2&&mode!=3){return zt_machine_error(_zag_str_concat("cannot mutate owner `",_zag_str_concat(root,"` while a shared borrow is active")),context);}}.fld=>|x|{return zt_check_borrow_write(x.base,aliases,borrows,context);}.idx=>|x|{return zt_check_borrow_write(x.base,aliases,borrows,context);}.un=>|x|{return zt_check_borrow_write(x.e,aliases,borrows,context);}else=>{}}return 0;}
fn zt_local_borrow_binding_mode(n:*Node,mode:i32,env:ArrayList[ZTBind],decls:ArrayList[*Node],context:[]u8)i32{
    if(mode==0){return 0;}
    // Parameter contracts describe what a call may observe while it runs.  A
    // local loan must survive the call only when the returned value can carry
    // that identity.  Treating a scalar result from `get`/`len` as a retained
    // view kept its source container borrowed until function exit and falsely
    // rejected the later, perfectly ordered `free`.
    let value:ZTExpr=zt_expr_type(n,env,decls,context);
    if(value.known==1&&zt_type_carries_borrow(value.ty,decls,0)==0){return 0;}
    if(mode==1&&value.known==1&&zt_borrow_param_kind(value.ty,decls)==2){return 3;}
    return mode;
}
fn zt_alias_remove_name(aliases:*ArrayList[ZTOwnAlias],name:[]u8)void{let i:i32=0;while(i<aliases.*.len){if(@strEq(aliases.*.data[i].name,name)){let j:i32=i;while(j+1<aliases.*.len){aliases.*.data[j]=aliases.*.data[j+1];j=j+1;}aliases.*.len=aliases.*.len-1;}else{i=i+1;}}}
fn zt_borrow_remove_name(borrows:*ArrayList[ZTBorrowAlias],name:[]u8)void{let i:i32=0;while(i<borrows.*.len){if(@strEq(borrows.*.data[i].name,name)){let j:i32=i;while(j+1<borrows.*.len){borrows.*.data[j]=borrows.*.data[j+1];j=j+1;}borrows.*.len=borrows.*.len-1;}else{i=i+1;}}}
// A returned borrow has no lexical end marker in the current v2 surface. If a
// borrow-valued local is created inside a branch/loop, dropping only its name
// at scope exit would erase the owner-side may-borrow state and permit a later
// release. Preserve an anonymous root marker; it cannot be used as a value
// alias, but zt_borrow_root_has still keeps the owner unavailable.
fn zt_borrow_scope_type(env:ArrayList[ZTBind],name:[]u8)[]u8{let i:i32=0;while(i<env.len){if(@strEq(env.data[i].name,name)){return env.data[i].ty;}i=i+1;}return "";}
fn zt_borrow_preserve_scope_roots(borrows:*ArrayList[ZTBorrowAlias],name:[]u8,env:ArrayList[ZTBind])void{
    // A direct pointer/slice local has no value-level lexical destructor, so
    // a branch/loop/switch result must conservatively keep its owner borrowed
    // after the local name disappears. Aggregate views do have a lexical
    // value boundary; retaining those roots here would reject the valid
    // `SurfaceSpec`-then-free pattern.
    let ty:[]u8=zt_borrow_scope_type(env,name);
    let direct:i32=((ty.len>0&&ty[0]=='*')||zt_starts(ty,"[]")==1||@strEq(ty,"Allocation")) as i32;
    if(direct==0){return;}
    let i:i32=0;while(i<borrows.*.len){let entry:ZTBorrowAlias=borrows.*.data[i];if(@strEq(entry.name,name)){zt_borrow_may_add(borrows,ZTBorrowAlias{.name="<scope-borrow>",.root=entry.root,.mode=entry.mode});}i=i+1;}
}
fn zt_borrow_end_scope_locals(env:ArrayList[ZTBind],start:i32,aliases:*ArrayList[ZTOwnAlias],borrows:*ArrayList[ZTBorrowAlias],initial_aliases:ArrayList[ZTOwnAlias],initial_borrows:ArrayList[ZTBorrowAlias])void{let i:i32=start;while(i<env.len){let name:[]u8=env.data[i].name;zt_borrow_preserve_scope_roots(borrows,name,env);zt_alias_remove_name(aliases,name);zt_borrow_remove_name(borrows,name);let ai:i32=0;while(ai<initial_aliases.len){if(@strEq(initial_aliases.data[ai].name,name)){zt_alias_set(aliases,name,initial_aliases.data[ai].root);}ai=ai+1;}let bi:i32=0;while(bi<initial_borrows.len){if(@strEq(initial_borrows.data[bi].name,name)){zt_borrow_may_add(borrows,initial_borrows.data[bi]);}bi=bi+1;}i=i+1;}}
// `try` preserves the returned value's
// borrow identity.  Dropping that identity here let a fallible borrow-return
// be rebound as an ordinary value and could then permit release of its owner.
// A parameter-local @borrows contract lasts for the call only. A returned
// pointer-bearing aggregate is not automatically a view of that parameter:
// the callee may have copied into fresh storage. Only a retained-return
// summary creates a caller-side result loan.
fn zt_call_borrow_mode(n:*Node,decls:ArrayList[*Node])i32{switch(n.*){.call=>|c|{let name:[]u8=zt_direct_name(c.callee);let retained:i32=zt_fn_first_retained_param(decls,name);if(retained>=0){let mode:i32=zt_borrow_mode(decls,name);if(mode>0){return mode;}return 1;}}.cast_=>|c|{return zt_call_borrow_mode(c.expr,decls);}.un=>|u|{if(@strEq(u.op,"try")){return zt_call_borrow_mode(u.e,decls);}}else=>{}}return 0;}
fn zt_call_borrow_root(n:*Node,decls:ArrayList[*Node],aliases:ArrayList[ZTOwnAlias],borrows:ArrayList[ZTBorrowAlias])[]u8{switch(n.*){.call=>|c|{let name:[]u8=zt_direct_name(c.callee);let retained:i32=zt_fn_first_retained_param(decls,name);if(retained>=0&&retained<c.args.len){return zt_borrow_expr_root(c.args.data[retained],aliases,borrows);}}.cast_=>|c|{return zt_call_borrow_root(c.expr,decls,aliases,borrows);}.un=>|u|{if(@strEq(u.op,"try")){return zt_call_borrow_root(u.e,decls,aliases,borrows);}}else=>{}}return "";}
fn zt_check_borrow_call(n:*Node,decls:ArrayList[*Node],env:ArrayList[ZTBind],aliases:ArrayList[ZTOwnAlias],borrows:ArrayList[ZTBorrowAlias],context:[]u8)i32{
    let errors:i32=0;
    switch(n.*){
        .call=>|c|{
            let ai:i32=0;while(ai<c.args.len){errors=errors+zt_check_borrow_call(c.args.data[ai],decls,env,aliases,borrows,context);ai=ai+1;}
            let name:[]u8=zt_direct_name(c.callee);let argi:i32=0;
            while(argi<c.args.len){
                let mode:i32=zt_param_borrow_mode(decls,name,argi);
                let borrowed_root:[]u8=zt_borrowed_expr_root(c.args.data[argi],decls,env,aliases,borrows,context);
                if(borrowed_root.len>0){
                    let scalar_only:i32=zt_callee_param_scalar_only(decls,name,argi);
                    let consuming:i32=(((zt_owned_release_name(name)==1&&argi==0)||zt_consumes_param(decls,name,argi)==1) as i32);
                    if(consuming==1){if(zt_borrow_root_mode(borrows,borrowed_root)!=2){errors=errors+zt_machine_error(_zag_str_concat("cannot pass a borrow to a consuming call (root `",_zag_str_concat(borrowed_root,"`)")),context);}}
                    else if(mode==0&&zt_compiler_nonretaining_call(name)==0&&!@strEq(name,"_zag_slice_ptr")){let shown:[]u8=name;if(shown.len==0){shown="<indirect>";}errors=errors+zt_machine_error(_zag_str_concat("borrowed value `",_zag_str_concat(borrowed_root,_zag_str_concat("` escapes through uncontracted call `",_zag_str_concat(shown,"`")))),context);}
                }
                // A retained-return parameter borrows the owner through the
                // result value, not for the remainder of the caller's
                // function.  The result binding records that relation and
                // drops it at the binding's lexical boundary; marking the
                // argument itself here would leak the borrow past a temporary
                // aggregate such as `SurfaceSpec` and reject a later owner
                // release.  Inferred retained relations have the same
                // result-scoped lifetime.
                let retained_result:i32=((@strEq(zt_fn_param_contract(decls,name,argi),"@retained_by_return")||zt_fn_inferred_retained_param(decls,name,argi)==1) as i32);
                // A retained result still creates a new live loan in the
                // caller. Check it against existing aliases before the
                // parameter-local/retained-result distinction below;
                // otherwise `inspect(p)` followed by `edit(p)` could create
                // an exclusive view while a shared view was already live.
