// selfhost/typed.zag — shared declared-type authority for every znc target.
//
// The parser still stores source spellings in the frozen-v1 AST, but every
// target resolves declaration and explicit-local types through this pass before
// lowering. Unknown names are hard errors; no backend may invent a layout.
// This is a real first typed-front-end slice, not yet the complete typed ZIR.

@import("parse.zag")
@import("v2_edition.zag")

fn zt_starts(s: []u8, prefix: []u8) i32 {
    if (s.len < prefix.len) { return 0; }
    let i: i32 = 0;
    while (i < prefix.len) {
        if (s[i] != prefix[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn zt_find(s: []u8, ch: u8) i32 {
    let i: i32 = 0;
    while (i < s.len) {
        if (s[i] == ch) { return i; }
        i = i + 1;
    }
    return -1;
}

fn zt_in_names(names: ArrayList[[]u8], name: []u8) i32 {
    let i: i32 = 0;
    while (i < len[[]u8](names)) {
        if (@strEq(get[[]u8](names, i), name)) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn zt_is_builtin(name: []u8) i32 {
    if (@strEq(name, "void") || @strEq(name, "bool")) { return 1; }
    if (@strEq(name, "i8") || @strEq(name, "i16") ||
        @strEq(name, "i32") || @strEq(name, "i64") || @strEq(name, "isize")) { return 1; }
    if (@strEq(name, "u8") || @strEq(name, "u16") ||
        @strEq(name, "u32") || @strEq(name, "u64") || @strEq(name, "usize")) { return 1; }
    if (@strEq(name, "f32") || @strEq(name, "f64")) { return 1; }
    if (@strEq(name, "bf16") || @strEq(name, "mx_fp8") ||
        @strEq(name, "mx_fp4")) { return 1; }
    if (@strEq(name, "l16") || @strEq(name, "l32")) { return 1; }
    if (@strEq(name, "p8") || @strEq(name, "p16") ||
        @strEq(name, "p32") || @strEq(name, "p64")) { return 1; }
    if (@strEq(name, "rns_3") || @strEq(name, "quire")) { return 1; }
    if (zt_starts(name, "sat_") == 1 || zt_starts(name, "fixed_") == 1 ||
        zt_starts(name, "lns") == 1 || zt_starts(name, "vsa_") == 1) { return 1; }
    if (@strEq(name, "gpu_buf")) { return 1; }
    // Arbitrary-width signed/unsigned integers are supported v1 extensions.
    if (name.len > 1 && (name[0] == 'i' || name[0] == 'u')) {
        let i: i32 = 1;
        while (i < name.len) {
            if (name[i] < '0' || name[i] > '9') { return 0; }
            i = i + 1;
        }
        return 1;
    }
    return 0;
}

fn zt_decl_names(decls: ArrayList[*Node]) ArrayList[[]u8] {
    let names: ArrayList[[]u8] = make[[]u8](16);
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .struct_ => |s| { push[[]u8](&names, s.name); }
            .enum_   => |e| { push[[]u8](&names, e.name); }
            .union_  => |u| { push[[]u8](&names, u.name); }
            .fn_decl => |f| {
                // The frozen-v1 parser represents `interface Shape` as the
                // metadata declaration `fn __iface_Shape`. Preserve Shape as
                // a real type name until interfaces gain a dedicated AST node.
                if (zt_starts(f.name, "__iface_") == 1 && f.name.len > 8) {
                    push[[]u8](&names, f.name[8..]);
                }
            }
            else => { }
        }
        i = i + 1;
    }
    return names;
}

fn zt_report_unknown(name: []u8, context: []u8) i32 {
    _zag_eprintln(_zag_str_concat(_zag_str_concat(
        _zag_str_concat("error[E0202]: unknown type '", name),
        _zag_str_concat("' in ", context)),
        "; declare the type or use a supported builtin"));
    return 1;
}

fn zt_validate_type(ty0: []u8, decls: ArrayList[[]u8],
                    tparams: ArrayList[[]u8], context: []u8) i32 {
    if (ty0.len == 0) { return 0; }
    let ty: []u8 = ty0;
    while (ty.len > 0) {
        if (zt_starts(ty, "[]") == 1) { ty = ty[2..]; }
        else {
            if (zt_starts(ty, "*const ") == 1) { ty = ty[7..]; }
            else if (zt_starts(ty, "*mut ") == 1) { ty = ty[5..]; }
            else if (zt_starts(ty, "*device ") == 1) { ty = ty[8..]; }
            else if (zt_starts(ty, "*workgroup ") == 1) { ty = ty[11..]; }
            else if (zt_starts(ty, "*host ") == 1) { ty = ty[6..]; }
            else if (@strEq(ty, "*opaque")) { return 0; }
            else if (ty[0] == '*' || ty[0] == '?' || ty[0] == '!') { ty = ty[1..]; }
            else { break; }
        }
    }
    if (ty.len == 0) { return zt_report_unknown(ty0, context); }

    // Function type internals become structured ZType nodes in the next slice.
    if (zt_starts(ty, "fn(") == 1) { return 0; }

    let lb: i32 = zt_find(ty, '[');
    if (lb >= 0) {
        if (ty[ty.len - 1] != ']') { return zt_report_unknown(ty, context); }
        let base: []u8 = ty[0..lb];
        if (zt_is_builtin(base) == 0 && zt_in_names(decls, base) == 0 &&
            zt_in_names(tparams, base) == 0) { return zt_report_unknown(base, context); }
        let errors: i32 = 0;
        let start: i32 = lb + 1;
        let depth: i32 = 0;
        let i: i32 = start;
        while (i < ty.len - 1) {
            if (ty[i] == '[') { depth = depth + 1; }
            if (ty[i] == ']') { depth = depth - 1; }
            if (ty[i] == ',' && depth == 0) {
                errors = errors + zt_validate_type(ty[start..i], decls, tparams, context);
                start = i + 1;
            }
            i = i + 1;
        }
        if (start < ty.len - 1) {
            errors = errors + zt_validate_type(ty[start..ty.len - 1], decls, tparams, context);
        }
        return errors;
    }

    if (zt_is_builtin(ty) == 1 || zt_in_names(decls, ty) == 1 ||
        zt_in_names(tparams, ty) == 1) { return 0; }
    return zt_report_unknown(ty, context);
}

fn zt_check_expr(n: *Node, decls: ArrayList[[]u8],
                 tparams: ArrayList[[]u8], context: []u8) i32 {
    switch (n.*) {
        .bin => |b| { return zt_check_expr(b.l, decls, tparams, context) +
                            zt_check_expr(b.r, decls, tparams, context); }
        .un => |u| { return zt_check_expr(u.e, decls, tparams, context); }
        .call => |c| {
            let errors: i32 = zt_check_expr(c.callee, decls, tparams, context);
            let i: i32 = 0;
            while (i < len[*Node](c.args)) {
                errors = errors + zt_check_expr(get[*Node](c.args, i), decls, tparams, context);
                i = i + 1;
            }
            let ti: i32 = 0;
            while (ti < len[[]u8](c.targs)) {
                errors = errors + zt_validate_type(get[[]u8](c.targs, ti), decls, tparams, context);
                ti = ti + 1;
            }
            return errors;
        }
        .idx => |x| { return zt_check_expr(x.base, decls, tparams, context) +
                            zt_check_expr(x.idx, decls, tparams, context); }
        .fld => |f| { return zt_check_expr(f.base, decls, tparams, context); }
        .slit_ => |s| {
            let errors: i32 = zt_validate_type(s.sname, decls, tparams, context);
            let ti: i32 = 0;
            while (ti < len[[]u8](s.targs)) {
                errors = errors + zt_validate_type(get[[]u8](s.targs, ti), decls, tparams, context);
                ti = ti + 1;
            }
            let i: i32 = 0;
            while (i < len[FieldInit](s.fields)) {
                errors = errors + zt_check_expr(get[FieldInit](s.fields, i).val, decls, tparams, context);
                i = i + 1;
            }
            return errors;
        }
        .cast_ => |c| { return zt_validate_type(c.target, decls, tparams, context) +
                              zt_check_expr(c.expr, decls, tparams, context); }
        .slice_ => |s| { return zt_check_expr(s.base, decls, tparams, context) +
                                zt_check_expr(s.lo, decls, tparams, context) +
                                zt_check_expr(s.hi, decls, tparams, context); }
        else => { return 0; }
    }
}

fn zt_check_body(body: ArrayList[*Node], decls: ArrayList[[]u8],
                 tparams: ArrayList[[]u8], context: []u8) i32 {
    let errors: i32 = 0;
    let i: i32 = 0;
    while (i < len[*Node](body)) {
        let n: *Node = get[*Node](body, i);
        switch (n.*) {
            .let_ => |l| {
                if (l.has_dty == 1) { errors = errors + zt_validate_type(l.dty, decls, tparams, context); }
                if (l.has_init == 1) { errors = errors + zt_check_expr(l.expr, decls, tparams, context); }
            }
            .ret => |r| { if (r.has_expr == 1) { errors = errors + zt_check_expr(r.expr, decls, tparams, context); } }
            .if_ => |x| {
                errors = errors + zt_check_expr(x.cond, decls, tparams, context);
                errors = errors + zt_check_body(x.then_body, decls, tparams, context);
                if (x.has_els == 1) { errors = errors + zt_check_body(x.els_body, decls, tparams, context); }
            }
            .while_ => |w| {
                errors = errors + zt_check_expr(w.cond, decls, tparams, context);
                errors = errors + zt_check_body(w.body, decls, tparams, context);
            }
            .unsafe_ => |u| { errors = errors + zt_check_body(u.body, decls, tparams, context); }
            .assign => |a| { errors = errors + zt_check_expr(a.target, decls, tparams, context) +
                                                    zt_check_expr(a.expr, decls, tparams, context); }
            .estmt => |e| { errors = errors + zt_check_expr(e.expr, decls, tparams, context); }
            .switch_ => |s| {
                errors = errors + zt_check_expr(s.subject, decls, tparams, context);
                let ai: i32 = 0;
                while (ai < len[SwitchArm](s.arms)) {
                    errors = errors + zt_check_body(get[SwitchArm](s.arms, ai).body, decls, tparams, context);
                    ai = ai + 1;
                }
                if (s.has_els == 1) { errors = errors + zt_check_body(s.els_body, decls, tparams, context); }
            }
            else => { }
        }
        i = i + 1;
    }
    return errors;
}

// ── expression type vertical slice ──────────────────────────────────────────
// Only types proved by this pass are compared. Backend-specific or unresolved
// generic/interface cases remain unknown and are not guessed.
struct ZTBind { name: []u8, ty: []u8 }
struct ZTExpr { ty: []u8, known: i32, literal: i32, errors: i32 }

fn zt_expr_unknown(errors: i32) ZTExpr {
    return ZTExpr{ .ty = "", .known = 0, .literal = 0, .errors = errors };
}
fn zt_expr_known(ty: []u8, literal: i32, errors: i32) ZTExpr {
    return ZTExpr{ .ty = ty, .known = 1, .literal = literal, .errors = errors };
}
fn zt_has_dot(s: []u8) i32 {
    let i: i32 = 0;
    while (i < s.len) { if (s[i] == '.') { return 1; } i = i + 1; }
    return 0;
}
fn zt_env_get(env: ArrayList[ZTBind], name: []u8) []u8 {
    let i: i32 = len[ZTBind](env) - 1;
    while (i >= 0) {
        let b: ZTBind = get[ZTBind](env, i);
        if (@strEq(b.name, name)) { return b.ty; }
        i = i - 1;
    }
    return "";
}
fn zt_env_clone(env: ArrayList[ZTBind]) ArrayList[ZTBind] {
    let out: ArrayList[ZTBind] = make[ZTBind](len[ZTBind](env) + 8);
    let i: i32 = 0;
    while (i < len[ZTBind](env)) {
        push[ZTBind](&out, get[ZTBind](env, i));
        i = i + 1;
    }
    return out;
}
fn zt_fn_ret(decls: ArrayList[*Node], name: []u8) []u8 {
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| { if (@strEq(f.name, name)) { return f.ret; } }
            else => { }
        }
        i = i + 1;
    }
    return "";
}
fn zt_fn_param(decls: ArrayList[*Node], name: []u8, index: i32) []u8 {
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                if (@strEq(f.name, name) && index < len[Param](f.params)) {
                    return get[Param](f.params, index).pty;
                }
            }
            else => { }
        }
        i = i + 1;
    }
    return "";
}
fn zt_fn_has_annot(decls: ArrayList[*Node], name: []u8, annot: []u8) i32 {
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                if (@strEq(f.name, name)) {
                    let ai: i32 = 0;
                    while (ai < len[[]u8](f.annots)) {
                        if (@strEq(get[[]u8](f.annots, ai), annot)) { return 1; }
                        ai = ai + 1;
                    }
                }
            }
            else => { }
        }
        i = i + 1;
    }
    return 0;
}
fn zt_direct_name(n: *Node) []u8 {
    return switch (n.*) { .id => |x| x.name, else => "" };
}
fn zt_is_numeric(t: []u8) i32 {
    if (t.len == 0) { return 0; }
    if (zt_is_builtin(t) == 0) { return 0; }
    if (@strEq(t, "void") || @strEq(t, "bool") || @strEq(t, "gpu_buf")) { return 0; }
    return 1;
}
fn zt_is_concrete(t: []u8) i32 {
    if (zt_is_builtin(t) == 1) { return 1; }
    if (zt_starts(t, "[]") == 1 || (t.len > 0 && (t[0] == '*' || t[0] == '?' || t[0] == '!'))) { return 1; }
    return 0;
}
fn zt_is_type_param(t: []u8) i32 {
    if (t.len == 1 && t[0] >= 'A' && t[0] <= 'Z') { return 1; }
    return 0;
}
fn zt_compatible(expected: []u8, actual: ZTExpr) i32 {
    if (actual.known == 0 || expected.len == 0) { return 1; }
    // A generic parameter remains unresolved until monomorphization. Treat it
    // as unknown on either side instead of inventing a concrete conversion.
    if (zt_is_type_param(expected) == 1 || zt_is_type_param(actual.ty) == 1) { return 1; }
    if (@strEq(expected, actual.ty)) { return 1; }
    // A payload constructs its optional/error-union wrapper without an
    // implicit representation-changing conversion.
    if (expected.len > 1 && (expected[0] == '?' || expected[0] == '!') &&
        @strEq(expected[1..], actual.ty)) { return 1; }
    if (actual.literal == 1 && zt_is_numeric(expected) == 1) { return 1; }
    if (actual.literal == 2 && (zt_is_numeric(expected) == 1)) { return 1; }
    // Existing v1 extensions permit word-scalar and specialized-numeric
    // representation conversions. Their precise rules remain backend-owned
    // until the numeric typed-ZIR slice migrates them with differential tests.
    if (zt_is_numeric(expected) == 1 && zt_is_numeric(actual.ty) == 1) { return 1; }
    if ((@strEq(expected, "i32") || @strEq(expected, "i64")) && @strEq(actual.ty, "bool")) { return 1; }
    // Named-type differences may be legal structural-interface coercions.
    if (zt_is_concrete(expected) == 0 && zt_is_concrete(actual.ty) == 0) { return 1; }
    return 0;
}
fn zt_type_error(expected: []u8, actual: []u8, context: []u8) i32 {
    _zag_eprintln(_zag_str_concat(_zag_str_concat(
        _zag_str_concat("error[E0203]: expected ", expected),
        _zag_str_concat(", found ", actual)),
        _zag_str_concat(" in ", context)));
    return 1;
}

fn zt_expr_type(n: *Node, env: ArrayList[ZTBind], decls: ArrayList[*Node], context: []u8) ZTExpr {
    switch (n.*) {
        .ilit => |x| {
            if (zt_has_dot(x.text) == 1) { return zt_expr_known("f32", 2, 0); }
            return zt_expr_known("i32", 1, 0);
        }
        .slit => |_s| { return zt_expr_known("[]u8", 0, 0); }
        .id => |x| {
            if (@strEq(x.name, "true") || @strEq(x.name, "false")) { return zt_expr_known("bool", 0, 0); }
            let ty: []u8 = zt_env_get(env, x.name);
            if (zt_is_type_param(ty) == 1) { return zt_expr_unknown(0); }
            if (ty.len > 0) { return zt_expr_known(ty, 0, 0); }
            return zt_expr_unknown(0);
        }
        .cast_ => |c| {
            let inner: ZTExpr = zt_expr_type(c.expr, env, decls, context);
            return zt_expr_known(c.target, 0, inner.errors);
        }
        .slit_ => |s| {
            let errors: i32 = 0;
            let i: i32 = 0;
            while (i < len[FieldInit](s.fields)) {
                errors = errors + zt_expr_type(get[FieldInit](s.fields, i).val, env, decls, context).errors;
                i = i + 1;
            }
            let ty: []u8 = s.sname;
            if (len[[]u8](s.targs) > 0) {
                ty = _zag_str_concat(ty, "[");
                let ti: i32 = 0;
                while (ti < len[[]u8](s.targs)) {
                    if (ti > 0) { ty = _zag_str_concat(ty, ","); }
                    ty = _zag_str_concat(ty, get[[]u8](s.targs, ti));
                    ti = ti + 1;
                }
                ty = _zag_str_concat(ty, "]");
            }
            return zt_expr_known(ty, 0, errors);
        }
        .call => |c| {
            let errors: i32 = 0;
            let name: []u8 = zt_direct_name(c.callee);
            let i: i32 = 0;
            while (i < len[*Node](c.args)) {
                let a: ZTExpr = zt_expr_type(get[*Node](c.args, i), env, decls, context);
                errors = errors + a.errors;
                let expected: []u8 = zt_fn_param(decls, name, i);
                // Generic parameters are resolved later; do not pretend T is concrete.
                if (expected.len > 0 && zt_is_builtin(expected) == 1 && zt_compatible(expected, a) == 0) {
                    errors = errors + zt_type_error(expected, a.ty, _zag_str_concat("call to ", name));
                }
                i = i + 1;
            }
            let ret: []u8 = zt_fn_ret(decls, name);
            // An unsubstituted generic result (T/K/V) is not a concrete type.
            if (zt_is_type_param(ret) == 1) { return zt_expr_unknown(errors); }
            if (ret.len > 0) { return zt_expr_known(ret, 0, errors); }
            return zt_expr_unknown(errors);
        }
        .bin => |b| {
            let l: ZTExpr = zt_expr_type(b.l, env, decls, context);
            let r: ZTExpr = zt_expr_type(b.r, env, decls, context);
            let errors: i32 = l.errors + r.errors;
            let arithmetic: i32 = 0;
            if (@strEq(b.op, "+") || @strEq(b.op, "-") || @strEq(b.op, "*") ||
                @strEq(b.op, "/") || @strEq(b.op, "%")) { arithmetic = 1; }
            if (arithmetic == 1 && l.known == 1 && r.known == 1 &&
                (@strEq(l.ty, "bool") || @strEq(r.ty, "bool") ||
                 @strEq(l.ty, "[]u8") || @strEq(r.ty, "[]u8"))) {
                errors = errors + zt_type_error(l.ty, r.ty, context);
            }
            if (@strEq(b.op, "==") || @strEq(b.op, "!=") || @strEq(b.op, "<") ||
                @strEq(b.op, ">") || @strEq(b.op, "<=") || @strEq(b.op, ">=") ||
                @strEq(b.op, "&&") || @strEq(b.op, "||")) {
                return zt_expr_known("bool", 0, errors);
            }
            if (@strEq(b.op, "orelse") && l.known == 1 && l.ty.len > 1 && l.ty[0] == '?') {
                return zt_expr_known(l.ty[1..], 0, errors);
            }
            if (l.known == 1) { return zt_expr_known(l.ty, l.literal, errors); }
            return zt_expr_unknown(errors);
        }
        .un => |u| {
            let e: ZTExpr = zt_expr_type(u.e, env, decls, context);
            if (@strEq(u.op, "try") && e.known == 1 && e.ty.len > 1 && e.ty[0] == '!') {
                return zt_expr_known(e.ty[1..], 0, e.errors);
            }
            if (@strEq(u.op, "&") && e.known == 1) {
                return zt_expr_known(_zag_str_concat("*", e.ty), 0, e.errors);
            }
            return e;
        }
        else => { return zt_expr_unknown(0); }
    }
}

fn zt_expr_body(body: ArrayList[*Node], env: *ArrayList[ZTBind], decls: ArrayList[*Node],
                fn_ret: []u8, context: []u8) i32 {
    let errors: i32 = 0;
    let i: i32 = 0;
    while (i < len[*Node](body)) {
        switch (get[*Node](body, i).*) {
            .let_ => |l| {
                let e: ZTExpr = zt_expr_type(l.expr, env.*, decls, context);
                errors = errors + e.errors;
                let ty: []u8 = l.dty;
                if (l.has_dty == 1 && zt_compatible(l.dty, e) == 0) {
                    errors = errors + zt_type_error(l.dty, e.ty, context);
                }
                if (l.has_dty == 0 && e.known == 1) { ty = e.ty; }
                if (ty.len > 0) { push[ZTBind](env, ZTBind{ .name = l.name, .ty = ty }); }
            }
            .ret => |r| {
                if (r.has_expr == 1) {
                    let e: ZTExpr = zt_expr_type(r.expr, env.*, decls, context);
                    errors = errors + e.errors;
                    if (zt_compatible(fn_ret, e) == 0) { errors = errors + zt_type_error(fn_ret, e.ty, context); }
                }
            }
            .assign => |a| {
                let e: ZTExpr = zt_expr_type(a.expr, env.*, decls, context);
                errors = errors + e.errors;
                let name: []u8 = zt_direct_name(a.target);
                let expected: []u8 = zt_env_get(env.*, name);
                if (expected.len > 0 && zt_compatible(expected, e) == 0) {
                    errors = errors + zt_type_error(expected, e.ty, context);
                }
            }
            .if_ => |x| {
                errors = errors + zt_expr_type(x.cond, env.*, decls, context).errors;
                let te: ArrayList[ZTBind] = zt_env_clone(env.*);
                errors = errors + zt_expr_body(x.then_body, &te, decls, fn_ret, context);
                if (x.has_els == 1) {
                    let ee: ArrayList[ZTBind] = zt_env_clone(env.*);
                    errors = errors + zt_expr_body(x.els_body, &ee, decls, fn_ret, context);
                }
            }
            .while_ => |w| {
                errors = errors + zt_expr_type(w.cond, env.*, decls, context).errors;
                let we: ArrayList[ZTBind] = zt_env_clone(env.*);
                errors = errors + zt_expr_body(w.body, &we, decls, fn_ret, context);
            }
            .unsafe_ => |u| {
                let ue: ArrayList[ZTBind] = zt_env_clone(env.*);
                errors = errors + zt_expr_body(u.body, &ue, decls, fn_ret, context);
            }
            .estmt => |e| { errors = errors + zt_expr_type(e.expr, env.*, decls, context).errors; }
            else => { }
        }
        i = i + 1;
    }
    return errors;
}

fn zt_check_expressions(decls: ArrayList[*Node]) i32 {
    let errors: i32 = 0;
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                if (f.is_extern == 0 && zt_starts(f.name, "__iface_") == 0) {
                    let env: ArrayList[ZTBind] = make[ZTBind](len[Param](f.params) + 8);
                    let pi: i32 = 0;
                    while (pi < len[Param](f.params)) {
                        let p: Param = get[Param](f.params, pi);
                        push[ZTBind](&env, ZTBind{ .name = p.name, .ty = p.pty });
                        pi = pi + 1;
                    }
                    errors = errors + zt_expr_body(f.body, &env, decls, f.ret,
                                                   _zag_str_concat("function ", f.name));
                }
            }
            else => { }
        }
        i = i + 1;
    }
    return errors;
}

// ── v2 unsafe/raw-pointer vertical slice ───────────────────────────────────
// The parser preserves an unsafe block as a dedicated AST node. This pass
// enforces the lexical boundary for the first raw-pointer operations before
// any target lowering runs. Pointer provenance instrumentation follows in the
// allocator slice; these checks deliberately do not claim that work early.
fn zt_is_v2_raw_pointer(ty: []u8) i32 {
    if (zt_starts(ty, "*const ") == 1 || zt_starts(ty, "*mut ") == 1 ||
        zt_starts(ty, "*device ") == 1 || zt_starts(ty, "*workgroup ") == 1 ||
        zt_starts(ty, "*host ") == 1 || @strEq(ty, "*opaque")) { return 1; }
    return 0;
}

fn zt_is_nullable_v2_raw_pointer(ty: []u8) i32 {
    if (ty.len > 1 && ty[0] == '?' && zt_is_v2_raw_pointer(ty[1..]) == 1) { return 1; }
    return 0;
}

// Zero is not a v2 raw pointer. Generic/host/device/workgroup are distinct
// semantic address spaces; const/mut/opaque remain within the generic space.
fn zt_v2_pointer_space(ty0: []u8) i32 {
    let ty: []u8 = ty0;
    if (zt_is_nullable_v2_raw_pointer(ty) == 1) { ty = ty[1..]; }
    if (zt_starts(ty, "*device ") == 1) { return 2; }
    if (zt_starts(ty, "*workgroup ") == 1) { return 3; }
    if (zt_starts(ty, "*host ") == 1) { return 4; }
    if (zt_is_v2_raw_pointer(ty) == 1) { return 1; }
    return 0;
}

fn zt_machine_expr_type(n: *Node, env: ArrayList[ZTBind]) []u8 {
    return switch (n.*) {
        .id => |x| zt_env_get(env, x.name),
        .cast_ => |c| c.target,
        .fld => |f| {
            let base_ty: []u8 = zt_machine_expr_type(f.base, env);
            if (@strEq(f.fname, "?") && base_ty.len > 1 && base_ty[0] == '?') {
                return base_ty[1..];
            }
            return "";
        }
        else => "",
    };
}

fn zt_machine_error(rule: []u8, context: []u8) i32 {
    _zag_eprintln(_zag_str_concat(_zag_str_concat("error[E0204]: ", rule),
                                  _zag_str_concat(" in ", context)));
    return 1;
}

fn zt_check_machine_expr(n: *Node, env: ArrayList[ZTBind], decls: ArrayList[*Node],
                         unsafe_scope: i32, writing: i32, context: []u8) i32 {
    switch (n.*) {
        // A plain `fn(...) T` value cannot yet carry the Unsafe effect.  Letting
        // an `unsafe fn` escape through that type would make a later indirect
        // call look safe, so reject the conversion until function types have a
        // typed safety contract. Direct calls are handled below.
        .id => |x| {
            if (zt_fn_has_annot(decls, x.name, "@unsafe") == 1) {
                return zt_machine_error("unsafe function values are not implemented; call the function directly inside unsafe", context);
            }
            return 0;
        }
        .bin => |b| { return zt_check_machine_expr(b.l, env, decls, unsafe_scope, 0, context) +
                            zt_check_machine_expr(b.r, env, decls, unsafe_scope, 0, context); }
        .un => |u| { return zt_check_machine_expr(u.e, env, decls, unsafe_scope, 0, context); }
        .call => |c| {
            let direct: []u8 = zt_direct_name(c.callee);
            let errors: i32 = 0;
            // Do not treat the callee of a direct call as a function value;
            // the lexical call-site rule below is its authority.
            if (direct.len == 0) {
                errors = zt_check_machine_expr(c.callee, env, decls, unsafe_scope, 0, context);
            }
            if (direct.len > 0 && zt_fn_has_annot(decls, direct, "@unsafe") == 1 && unsafe_scope == 0) {
                errors = errors + zt_machine_error("call to unsafe function requires unsafe", context);
            }
            switch (c.callee.*) {
                .fld => |f| {
                    let ty: []u8 = zt_machine_expr_type(f.base, env);
                    if (zt_is_v2_raw_pointer(ty) == 1 &&
                        (@strEq(f.fname, "add") || @strEq(f.fname, "sub") ||
                         @strEq(f.fname, "byte_add")) && unsafe_scope == 0) {
                        errors = errors + zt_machine_error("raw-pointer arithmetic requires unsafe", context);
                    }
                }
                else => { }
            }
            let i: i32 = 0;
            while (i < len[*Node](c.args)) {
                errors = errors + zt_check_machine_expr(get[*Node](c.args, i), env, decls, unsafe_scope, 0, context);
                i = i + 1;
            }
            return errors;
        }
        .idx => |x| {
            let errors: i32 = zt_check_machine_expr(x.base, env, decls, unsafe_scope, 0, context) +
                              zt_check_machine_expr(x.idx, env, decls, unsafe_scope, 0, context);
            if (zt_is_v2_raw_pointer(zt_machine_expr_type(x.base, env)) == 1 && unsafe_scope == 0) {
                errors = errors + zt_machine_error("raw-pointer indexing requires unsafe", context);
            }
            return errors;
        }
        .fld => |f| {
            let errors: i32 = zt_check_machine_expr(f.base, env, decls, unsafe_scope, 0, context);
            let ty: []u8 = zt_machine_expr_type(f.base, env);
            if (@strEq(f.fname, "*")) {
                if (zt_is_nullable_v2_raw_pointer(ty) == 1) {
                    errors = errors + zt_machine_error("nullable raw pointer must be explicitly unwrapped before dereference", context);
                } else if (zt_is_v2_raw_pointer(ty) == 1) {
                    if (unsafe_scope == 0) {
                        errors = errors + zt_machine_error("raw-pointer dereference requires unsafe", context);
                    }
                    if (writing == 1 && zt_starts(ty, "*const ") == 1) {
                        errors = errors + zt_machine_error("cannot write through *const pointer", context);
                    }
                    if (@strEq(ty, "*opaque")) {
                        errors = errors + zt_machine_error("*opaque cannot be dereferenced without an explicit typed conversion", context);
                    }
                }
            }
            return errors;
        }
        .cast_ => |c| {
            let errors: i32 = zt_check_machine_expr(c.expr, env, decls, unsafe_scope, 0, context);
            if (zt_is_v2_raw_pointer(c.target) == 1 && unsafe_scope == 0) {
                errors = errors + zt_machine_error("conversion to a raw pointer requires unsafe", context);
            }
            let source_space: i32 = zt_v2_pointer_space(zt_machine_expr_type(c.expr, env));
            let target_space: i32 = zt_v2_pointer_space(c.target);
            if (source_space > 0 && target_space > 0 && source_space != target_space) {
                errors = errors + zt_machine_error("cannot cast between distinct raw-pointer address spaces", context);
            }
            return errors;
        }
        .slice_ => |s| { return zt_check_machine_expr(s.base, env, decls, unsafe_scope, 0, context) +
                                zt_check_machine_expr(s.lo, env, decls, unsafe_scope, 0, context) +
                                zt_check_machine_expr(s.hi, env, decls, unsafe_scope, 0, context); }
        else => { return 0; }
    }
}

fn zt_check_machine_body(body: ArrayList[*Node], env: *ArrayList[ZTBind], decls: ArrayList[*Node],
                         unsafe_scope: i32, context: []u8) i32 {
    let errors: i32 = 0;
    let i: i32 = 0;
    while (i < len[*Node](body)) {
        switch (get[*Node](body, i).*) {
            .let_ => |l| {
                if (l.has_init == 1) { errors = errors + zt_check_machine_expr(l.expr, env.*, decls, unsafe_scope, 0, context); }
                if (l.has_dty == 1) { push[ZTBind](env, ZTBind{ .name = l.name, .ty = l.dty }); }
            }
            .ret => |r| { if (r.has_expr == 1) { errors = errors + zt_check_machine_expr(r.expr, env.*, decls, unsafe_scope, 0, context); } }
            .assign => |a| { errors = errors + zt_check_machine_expr(a.target, env.*, decls, unsafe_scope, 1, context) +
                                                    zt_check_machine_expr(a.expr, env.*, decls, unsafe_scope, 0, context); }
            .estmt => |e| { errors = errors + zt_check_machine_expr(e.expr, env.*, decls, unsafe_scope, 0, context); }
            .if_ => |x| {
                errors = errors + zt_check_machine_expr(x.cond, env.*, decls, unsafe_scope, 0, context);
                let te: ArrayList[ZTBind] = zt_env_clone(env.*);
                errors = errors + zt_check_machine_body(x.then_body, &te, decls, unsafe_scope, context);
                if (x.has_els == 1) {
                    let ee: ArrayList[ZTBind] = zt_env_clone(env.*);
                    errors = errors + zt_check_machine_body(x.els_body, &ee, decls, unsafe_scope, context);
                }
            }
            .while_ => |w| {
                errors = errors + zt_check_machine_expr(w.cond, env.*, decls, unsafe_scope, 0, context);
                let we: ArrayList[ZTBind] = zt_env_clone(env.*);
                errors = errors + zt_check_machine_body(w.body, &we, decls, unsafe_scope, context);
            }
            .unsafe_ => |u| {
                let ue: ArrayList[ZTBind] = zt_env_clone(env.*);
                errors = errors + zt_check_machine_body(u.body, &ue, decls, 1, context);
            }
            else => { }
        }
        i = i + 1;
    }
    return errors;
}

fn zt_check_machine_control(decls: ArrayList[*Node]) i32 {
    let errors: i32 = 0;
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                let env: ArrayList[ZTBind] = make[ZTBind](len[Param](f.params) + 8);
                let pi: i32 = 0;
                while (pi < len[Param](f.params)) {
                    let p: Param = get[Param](f.params, pi);
                    push[ZTBind](&env, ZTBind{ .name = p.name, .ty = p.pty });
                    pi = pi + 1;
                }
                let fn_unsafe: i32 = zt_fn_has_annot(decls, f.name, "@unsafe");
                errors = errors + zt_check_machine_body(f.body, &env, decls, fn_unsafe,
                    _zag_str_concat("function ", f.name));
            }
            else => { }
        }
        i = i + 1;
    }
    return errors;
}

// Conservative first lifetime check for the v2 allocator milestone.  It only
// follows a straight-line named `delete`/`_zag_free` call; branches and aliases
// stay for dynamic instrumentation rather than being guessed here.
fn zt_check_direct_free_body(body: ArrayList[*Node], freed: *ArrayList[[]u8], context: []u8) i32 {
    let errors: i32 = 0;
    let i: i32 = 0;
    while (i < len[*Node](body)) {
        switch (get[*Node](body, i).*) {
            .estmt => |e| {
                switch (e.expr.*) {
                    .call => |c| {
                        let name: []u8 = zt_direct_name(c.callee);
                        if ((@strEq(name, "delete") || @strEq(name, "_zag_free")) && len[*Node](c.args) == 1) {
                            switch (get[*Node](c.args, 0).*) {
                                .id => |p| {
                                    if (zt_in_names(freed.*, p.name) == 1) {
                                        errors = errors + zt_machine_error("double free of named allocation", context);
                                    } else { push[[]u8](freed, p.name); }
                                }
                                else => { }
                            }
                        }
                    }
                    else => { }
                }
            }
            .unsafe_ => |u| { errors = errors + zt_check_direct_free_body(u.body, freed, context); }
            else => { }
        }
        i = i + 1;
    }
    return errors;
}

fn zt_check_v2_direct_frees(decls: ArrayList[*Node], file: []u8) i32 {
    if (@strEq(v2_project_edition(file), "2027") == 0) { return 0; }
    let errors: i32 = 0; let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| { let freed: ArrayList[[]u8] = make[[]u8](4); errors = errors + zt_check_direct_free_body(f.body, &freed, _zag_str_concat("function ", f.name)); }
            else => { }
        }
        i = i + 1;
    }
    return errors;
}

fn typed_check_program(decls0: ArrayList[*Node], file: []u8) i32 {
    let decls: ArrayList[[]u8] = zt_decl_names(decls0);
    let errors: i32 = 0;
    let i: i32 = 0;
    while (i < len[*Node](decls0)) {
        switch (get[*Node](decls0, i).*) {
            .struct_ => |s| {
                let context: []u8 = _zag_str_concat("struct ", s.name);
                let fi: i32 = 0;
                while (fi < len[Param](s.fields)) {
                    errors = errors + zt_validate_type(get[Param](s.fields, fi).pty, decls, s.tparams, context);
                    fi = fi + 1;
                }
            }
            .union_ => |u| {
                let context: []u8 = _zag_str_concat("union ", u.name);
                let none: ArrayList[[]u8] = make[[]u8](1);
                let fi: i32 = 0;
                while (fi < len[Param](u.fields)) {
                    errors = errors + zt_validate_type(get[Param](u.fields, fi).pty, decls, none, context);
                    fi = fi + 1;
                }
            }
            .fn_decl => |f| {
                let context: []u8 = _zag_str_concat("function ", f.name);
                let pi: i32 = 0;
                while (pi < len[Param](f.params)) {
                    errors = errors + zt_validate_type(get[Param](f.params, pi).pty, decls, f.tparams, context);
                    pi = pi + 1;
                }
                errors = errors + zt_validate_type(f.ret, decls, f.tparams, context);
                errors = errors + zt_check_body(f.body, decls, f.tparams, context);
            }
            else => { }
        }
        i = i + 1;
    }
    errors = errors + zt_check_expressions(decls0);
    errors = errors + zt_check_machine_control(decls0);
    errors = errors + zt_check_v2_direct_frees(decls0, file);
    if (errors > 0) {
        _zag_eprintln(_zag_str_concat(_zag_str_concat("znc: typed declaration check FAILED for ", file),
                                     _zag_str_concat(" (errors=", _zag_str_concat(_zag_i64_to_str(errors as i64), ")"))));
    }
    return errors;
}
