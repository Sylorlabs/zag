                }
                fi=fi+1;
            }
            let si:i32=0;while(si<flow.*.slots.len){let slot:ZTResSlot=flow.*.slots.data[si];
                if(zt_agg_path_prefix(arena.*,target,slot.path)==1&&slot.state!=1){errors=errors+zt_machine_error("@resource construction does not initialize every @owned field",context);}
                si=si+1;
            }
        }
        else=>{}
    }
