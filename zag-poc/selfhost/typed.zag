// selfhost/typed.zag — shared declared-type authority for every znc target.
//
// The parser still stores source spellings in the frozen-v1 AST, but every
// target resolves declaration and explicit-local types through this pass before
// lowering. Unknown names are hard errors; no backend may invent a layout.
// This is a real first typed-front-end slice, not yet the complete typed ZIR.

@import("parse.zag")
@import("v2_edition.zag")

fn zt_starts(s: []u8, prefix: []u8) i32 {
    if (s.len < prefix.len) { return 0; }
    let i: i32 = 0;
    while (i < prefix.len) {
        if (s[i] != prefix[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn zt_find(s: []u8, ch: u8) i32 {
    let i: i32 = 0;
    while (i < s.len) {
        if (s[i] == ch) { return i; }
        i = i + 1;
    }
    return -1;
}

fn zt_in_names(names: ArrayList[[]u8], name: []u8) i32 {
    let i: i32 = 0;
    while (i < len[[]u8](names)) {
        if (@strEq(get[[]u8](names, i), name)) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn zt_is_builtin(name: []u8) i32 {
    if (@strEq(name, "void") || @strEq(name, "bool")) { return 1; }
    if (@strEq(name, "i8") || @strEq(name, "i16") ||
        @strEq(name, "i32") || @strEq(name, "i64") || @strEq(name, "isize")) { return 1; }
    if (@strEq(name, "u8") || @strEq(name, "u16") ||
        @strEq(name, "u32") || @strEq(name, "u64") || @strEq(name, "usize")) { return 1; }
    if (@strEq(name, "f32") || @strEq(name, "f64")) { return 1; }
    if (@strEq(name, "bf16") || @strEq(name, "mx_fp8") ||
        @strEq(name, "mx_fp4")) { return 1; }
    if (@strEq(name, "l16") || @strEq(name, "l32")) { return 1; }
    if (@strEq(name, "p8") || @strEq(name, "p16") ||
        @strEq(name, "p32") || @strEq(name, "p64")) { return 1; }
    if (@strEq(name, "rns_3") || @strEq(name, "quire")) { return 1; }
    if (zt_starts(name, "sat_") == 1 || zt_starts(name, "fixed_") == 1 ||
        zt_starts(name, "lns") == 1 || zt_starts(name, "vsa_") == 1) { return 1; }
    if (@strEq(name, "gpu_buf")) { return 1; }
    // Arbitrary-width signed/unsigned integers are supported v1 extensions.
    if (name.len > 1 && (name[0] == 'i' || name[0] == 'u')) {
        let i: i32 = 1;
        while (i < name.len) {
            if (name[i] < '0' || name[i] > '9') { return 0; }
            i = i + 1;
        }
        return 1;
    }
    return 0;
}

fn zt_decl_names(decls: ArrayList[*Node]) ArrayList[[]u8] {
    let names: ArrayList[[]u8] = make[[]u8](16);
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .struct_ => |s| { push[[]u8](&names, s.name); }
            .enum_   => |e| { push[[]u8](&names, e.name); }
            .union_  => |u| { push[[]u8](&names, u.name); }
            .fn_decl => |f| {
                // The frozen-v1 parser represents `interface Shape` as the
                // metadata declaration `fn __iface_Shape`. Preserve Shape as
                // a real type name until interfaces gain a dedicated AST node.
                if (zt_starts(f.name, "__iface_") == 1 && f.name.len > 8) {
                    push[[]u8](&names, f.name[8..]);
                }
            }
            else => { }
        }
        i = i + 1;
    }
    return names;
}

fn zt_report_unknown(name: []u8, context: []u8) i32 {
    _zag_eprintln(_zag_str_concat(_zag_str_concat(
        _zag_str_concat("error[E0202]: unknown type '", name),
        _zag_str_concat("' in ", context)),
        "; declare the type or use a supported builtin"));
    return 1;
}

fn zt_validate_type(ty0: []u8, decls: ArrayList[[]u8],
                    tparams: ArrayList[[]u8], context: []u8) i32 {
    if (ty0.len == 0) { return 0; }
    let ty: []u8 = ty0;
    while (ty.len > 0) {
        if (zt_starts(ty, "[]") == 1) { ty = ty[2..]; }
        else {
            if (zt_starts(ty, "*const ") == 1) { ty = ty[7..]; }
            else if (zt_starts(ty, "*mut ") == 1) { ty = ty[5..]; }
            else if (zt_starts(ty, "*device ") == 1) { ty = ty[8..]; }
            else if (zt_starts(ty, "*workgroup ") == 1) { ty = ty[11..]; }
            else if (zt_starts(ty, "*host ") == 1) { ty = ty[6..]; }
            else if (@strEq(ty, "*opaque")) { return 0; }
            else if (ty[0] == '*' || ty[0] == '?' || ty[0] == '!') { ty = ty[1..]; }
            else { break; }
        }
    }
    if (ty.len == 0) { return zt_report_unknown(ty0, context); }

    // Function type internals become structured ZType nodes in the next slice.
    if (zt_starts(ty, "fn(") == 1) { return 0; }

    let lb: i32 = zt_find(ty, '[');
    if (lb >= 0) {
        if (ty[ty.len - 1] != ']') { return zt_report_unknown(ty, context); }
        let base: []u8 = ty[0..lb];
        if (zt_is_builtin(base) == 0 && zt_in_names(decls, base) == 0 &&
            zt_in_names(tparams, base) == 0) { return zt_report_unknown(base, context); }
        let errors: i32 = 0;
        let start: i32 = lb + 1;
        let depth: i32 = 0;
        let i: i32 = start;
        while (i < ty.len - 1) {
            if (ty[i] == '[') { depth = depth + 1; }
            if (ty[i] == ']') { depth = depth - 1; }
            if (ty[i] == ',' && depth == 0) {
                errors = errors + zt_validate_type(ty[start..i], decls, tparams, context);
                start = i + 1;
            }
            i = i + 1;
        }
        if (start < ty.len - 1) {
            errors = errors + zt_validate_type(ty[start..ty.len - 1], decls, tparams, context);
        }
        return errors;
    }

    if (zt_is_builtin(ty) == 1 || zt_in_names(decls, ty) == 1 ||
        zt_in_names(tparams, ty) == 1) { return 0; }
    return zt_report_unknown(ty, context);
}

fn zt_check_expr(n: *Node, decls: ArrayList[[]u8],
                 tparams: ArrayList[[]u8], context: []u8) i32 {
    switch (n.*) {
        .bin => |b| { return zt_check_expr(b.l, decls, tparams, context) +
                            zt_check_expr(b.r, decls, tparams, context); }
        .un => |u| { return zt_check_expr(u.e, decls, tparams, context); }
        .call => |c| {
            let errors: i32 = zt_check_expr(c.callee, decls, tparams, context);
            let i: i32 = 0;
            while (i < len[*Node](c.args)) {
                errors = errors + zt_check_expr(get[*Node](c.args, i), decls, tparams, context);
                i = i + 1;
            }
            let ti: i32 = 0;
            while (ti < len[[]u8](c.targs)) {
                errors = errors + zt_validate_type(get[[]u8](c.targs, ti), decls, tparams, context);
                ti = ti + 1;
            }
            return errors;
        }
        .idx => |x| { return zt_check_expr(x.base, decls, tparams, context) +
                            zt_check_expr(x.idx, decls, tparams, context); }
        .fld => |f| { return zt_check_expr(f.base, decls, tparams, context); }
        .slit_ => |s| {
            let errors: i32 = zt_validate_type(s.sname, decls, tparams, context);
            let ti: i32 = 0;
            while (ti < len[[]u8](s.targs)) {
                errors = errors + zt_validate_type(get[[]u8](s.targs, ti), decls, tparams, context);
                ti = ti + 1;
            }
            let i: i32 = 0;
            while (i < len[FieldInit](s.fields)) {
                errors = errors + zt_check_expr(get[FieldInit](s.fields, i).val, decls, tparams, context);
                i = i + 1;
            }
            return errors;
        }
        .cast_ => |c| { return zt_validate_type(c.target, decls, tparams, context) +
                              zt_check_expr(c.expr, decls, tparams, context); }
        .slice_ => |s| { return zt_check_expr(s.base, decls, tparams, context) +
                                zt_check_expr(s.lo, decls, tparams, context) +
                                zt_check_expr(s.hi, decls, tparams, context); }
        else => { return 0; }
    }
}

fn zt_check_body(body: ArrayList[*Node], decls: ArrayList[[]u8],
                 tparams: ArrayList[[]u8], context: []u8) i32 {
    let errors: i32 = 0;
    let i: i32 = 0;
    while (i < len[*Node](body)) {
        let n: *Node = get[*Node](body, i);
        switch (n.*) {
            .let_ => |l| {
                if (l.has_dty == 1) { errors = errors + zt_validate_type(l.dty, decls, tparams, context); }
                if (l.has_init == 1) { errors = errors + zt_check_expr(l.expr, decls, tparams, context); }
            }
            .ret => |r| { if (r.has_expr == 1) { errors = errors + zt_check_expr(r.expr, decls, tparams, context); } }
            .if_ => |x| {
                errors = errors + zt_check_expr(x.cond, decls, tparams, context);
                errors = errors + zt_check_body(x.then_body, decls, tparams, context);
                if (x.has_els == 1) { errors = errors + zt_check_body(x.els_body, decls, tparams, context); }
            }
            .while_ => |w| {
                errors = errors + zt_check_expr(w.cond, decls, tparams, context);
                errors = errors + zt_check_body(w.body, decls, tparams, context);
            }
            .unsafe_ => |u| { errors = errors + zt_check_body(u.body, decls, tparams, context); }
            .assign => |a| { errors = errors + zt_check_expr(a.target, decls, tparams, context) +
                                                    zt_check_expr(a.expr, decls, tparams, context); }
            .estmt => |e| { errors = errors + zt_check_expr(e.expr, decls, tparams, context); }
            .switch_ => |s| {
                errors = errors + zt_check_expr(s.subject, decls, tparams, context);
                let ai: i32 = 0;
                while (ai < len[SwitchArm](s.arms)) {
                    errors = errors + zt_check_body(get[SwitchArm](s.arms, ai).body, decls, tparams, context);
                    ai = ai + 1;
                }
                if (s.has_els == 1) { errors = errors + zt_check_body(s.els_body, decls, tparams, context); }
            }
            else => { }
        }
        i = i + 1;
    }
    return errors;
}

// ── expression type vertical slice ──────────────────────────────────────────
// Only types proved by this pass are compared. Backend-specific or unresolved
// generic/interface cases remain unknown and are not guessed.
struct ZTBind { name: []u8, ty: []u8 }
struct ZTExpr { ty: []u8, known: i32, literal: i32, errors: i32 }

fn zt_expr_unknown(errors: i32) ZTExpr {
    return ZTExpr{ .ty = "", .known = 0, .literal = 0, .errors = errors };
}
fn zt_expr_known(ty: []u8, literal: i32, errors: i32) ZTExpr {
    return ZTExpr{ .ty = ty, .known = 1, .literal = literal, .errors = errors };
}
fn zt_has_dot(s: []u8) i32 {
    let i: i32 = 0;
    while (i < s.len) { if (s[i] == '.') { return 1; } i = i + 1; }
    return 0;
}
fn zt_env_get(env: ArrayList[ZTBind], name: []u8) []u8 {
    let i: i32 = len[ZTBind](env) - 1;
    while (i >= 0) {
        let b: ZTBind = get[ZTBind](env, i);
        if (@strEq(b.name, name)) { return b.ty; }
        i = i - 1;
    }
    return "";
}
fn zt_env_clone(env: ArrayList[ZTBind]) ArrayList[ZTBind] {
    let out: ArrayList[ZTBind] = make[ZTBind](len[ZTBind](env) + 8);
    let i: i32 = 0;
    while (i < len[ZTBind](env)) {
        push[ZTBind](&out, get[ZTBind](env, i));
        i = i + 1;
    }
    return out;
}
fn zt_fn_ret(decls: ArrayList[*Node], name: []u8) []u8 {
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| { if (@strEq(f.name, name)) { return f.ret; } }
            else => { }
        }
        i = i + 1;
    }
    return "";
}
// Substitute explicit generic arguments through the complete source-level type
// spelling.  The typed authority runs before monomorphized lowering, so it must
// not report wrapped results such as ?V or !T as concrete types when a call
// supplied V/T explicitly.  Keep this aligned with cg_subst_type.
fn zt_subst_type(t: []u8, names: ArrayList[[]u8], vals: ArrayList[[]u8]) []u8 {
    let i: i32 = 0;
    while (i < len[[]u8](names) && i < len[[]u8](vals)) {
        if (@strEq(t, get[[]u8](names, i))) { return get[[]u8](vals, i); }
        i = i + 1;
    }
    if (t.len > 1) {
        if (t[0] == '*') { return _zag_str_concat("*", zt_subst_type(t[1..], names, vals)); }
        if (t[0] == '?') { return _zag_str_concat("?", zt_subst_type(t[1..], names, vals)); }
        if (t[0] == '!') { return _zag_str_concat("!", zt_subst_type(t[1..], names, vals)); }
    }
    if (t.len > 2 && t[0] == '[' && t[1] == ']') {
        return _zag_str_concat("[]", zt_subst_type(t[2..], names, vals));
    }
    if (is_generic_app(t)) {
        let lb: i32 = index_of(t, '[');
        let args: ArrayList[[]u8] = split_args(t[lb + 1..t.len - 1]);
        let out: []u8 = _zag_str_concat(t[0..lb], "[");
        let ai: i32 = 0;
        while (ai < len[[]u8](args)) {
            if (ai > 0) { out = _zag_str_concat(out, ","); }
            out = _zag_str_concat(out, zt_subst_type(get[[]u8](args, ai), names, vals));
            ai = ai + 1;
        }
        return _zag_str_concat(out, "]");
    }
    return t;
}
fn zt_fn_tparams(decls: ArrayList[*Node], name: []u8) ArrayList[[]u8] {
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| { if (@strEq(f.name, name)) { return f.tparams; } }
            else => { }
        }
        i = i + 1;
    }
    return make[[]u8](0);
}
fn zt_fn_param(decls: ArrayList[*Node], name: []u8, index: i32) []u8 {
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                if (@strEq(f.name, name) && index < len[Param](f.params)) {
                    return get[Param](f.params, index).pty;
                }
            }
            else => { }
        }
        i = i + 1;
    }
    return "";
}
fn zt_fn_has_annot(decls: ArrayList[*Node], name: []u8, annot: []u8) i32 {
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                if (@strEq(f.name, name)) {
                    let ai: i32 = 0;
                    while (ai < len[[]u8](f.annots)) {
                        if (@strEq(get[[]u8](f.annots, ai), annot)) { return 1; }
                        ai = ai + 1;
                    }
                }
            }
            else => { }
        }
        i = i + 1;
    }
    return 0;
}
fn zt_direct_name(n: *Node) []u8 {
    return switch (n.*) { .id => |x| x.name, else => "" };
}
fn zt_is_numeric(t: []u8) i32 {
    if (t.len == 0) { return 0; }
    if (zt_is_builtin(t) == 0) { return 0; }
    if (@strEq(t, "void") || @strEq(t, "bool") || @strEq(t, "gpu_buf")) { return 0; }
    return 1;
}
fn zt_is_concrete(t: []u8) i32 {
    if (zt_is_builtin(t) == 1) { return 1; }
    if (zt_starts(t, "[]") == 1 || (t.len > 0 && (t[0] == '*' || t[0] == '?' || t[0] == '!'))) { return 1; }
    return 0;
}
fn zt_is_type_param(t: []u8) i32 {
    if (t.len == 1 && t[0] >= 'A' && t[0] <= 'Z') { return 1; }
    return 0;
}
fn zt_compatible(expected: []u8, actual: ZTExpr) i32 {
    if (actual.known == 0 || expected.len == 0) { return 1; }
    // A generic parameter remains unresolved until monomorphization. Treat it
    // as unknown on either side instead of inventing a concrete conversion.
    if (zt_is_type_param(expected) == 1 || zt_is_type_param(actual.ty) == 1) { return 1; }
    if (@strEq(expected, actual.ty)) { return 1; }
    // A payload constructs its optional/error-union wrapper without an
    // implicit representation-changing conversion.
    if (expected.len > 1 && (expected[0] == '?' || expected[0] == '!') &&
        @strEq(expected[1..], actual.ty)) { return 1; }
    if (actual.literal == 1 && zt_is_numeric(expected) == 1) { return 1; }
    if (actual.literal == 2 && (zt_is_numeric(expected) == 1)) { return 1; }
    // Existing v1 extensions permit word-scalar and specialized-numeric
    // representation conversions. Their precise rules remain backend-owned
    // until the numeric typed-ZIR slice migrates them with differential tests.
    if (zt_is_numeric(expected) == 1 && zt_is_numeric(actual.ty) == 1) { return 1; }
    if ((@strEq(expected, "i32") || @strEq(expected, "i64")) && @strEq(actual.ty, "bool")) { return 1; }
    // Named-type differences may be legal structural-interface coercions.
    if (zt_is_concrete(expected) == 0 && zt_is_concrete(actual.ty) == 0) { return 1; }
    return 0;
}
fn zt_type_error(expected: []u8, actual: []u8, context: []u8) i32 {
    _zag_eprintln(_zag_str_concat(_zag_str_concat(
        _zag_str_concat("error[E0203]: expected ", expected),
        _zag_str_concat(", found ", actual)),
        _zag_str_concat(" in ", context)));
    return 1;
}

fn zt_expr_type(n: *Node, env: ArrayList[ZTBind], decls: ArrayList[*Node], context: []u8) ZTExpr {
    switch (n.*) {
        .ilit => |x| {
            if (zt_has_dot(x.text) == 1) { return zt_expr_known("f32", 2, 0); }
            return zt_expr_known("i32", 1, 0);
        }
        .slit => |_s| { return zt_expr_known("[]u8", 0, 0); }
        .id => |x| {
            if (@strEq(x.name, "true") || @strEq(x.name, "false")) { return zt_expr_known("bool", 0, 0); }
            let ty: []u8 = zt_env_get(env, x.name);
            if (zt_is_type_param(ty) == 1) { return zt_expr_unknown(0); }
            if (ty.len > 0) { return zt_expr_known(ty, 0, 0); }
            return zt_expr_unknown(0);
        }
        .cast_ => |c| {
            let inner: ZTExpr = zt_expr_type(c.expr, env, decls, context);
            return zt_expr_known(c.target, 0, inner.errors);
        }
        .slit_ => |s| {
            let errors: i32 = 0;
            let i: i32 = 0;
            while (i < len[FieldInit](s.fields)) {
                errors = errors + zt_expr_type(get[FieldInit](s.fields, i).val, env, decls, context).errors;
                i = i + 1;
            }
            let ty: []u8 = s.sname;
            if (len[[]u8](s.targs) > 0) {
                ty = _zag_str_concat(ty, "[");
                let ti: i32 = 0;
                while (ti < len[[]u8](s.targs)) {
                    if (ti > 0) { ty = _zag_str_concat(ty, ","); }
                    ty = _zag_str_concat(ty, get[[]u8](s.targs, ti));
                    ti = ti + 1;
                }
                ty = _zag_str_concat(ty, "]");
            }
            return zt_expr_known(ty, 0, errors);
        }
        .call => |c| {
            let errors: i32 = 0;
            let name: []u8 = zt_direct_name(c.callee);
            let tparams: ArrayList[[]u8] = zt_fn_tparams(decls, name);
            let i: i32 = 0;
            while (i < len[*Node](c.args)) {
                let a: ZTExpr = zt_expr_type(get[*Node](c.args, i), env, decls, context);
                errors = errors + a.errors;
                let expected: []u8 = zt_subst_type(zt_fn_param(decls, name, i), tparams, c.targs);
                // Generic parameters are resolved later; do not pretend T is concrete.
                if (expected.len > 0 && zt_is_builtin(expected) == 1 && zt_compatible(expected, a) == 0) {
                    errors = errors + zt_type_error(expected, a.ty, _zag_str_concat("call to ", name));
                }
                i = i + 1;
            }
            let ret: []u8 = zt_subst_type(zt_fn_ret(decls, name), tparams, c.targs);
            // An unsubstituted generic result (T/K/V) is not a concrete type.
            if (zt_is_type_param(ret) == 1) { return zt_expr_unknown(errors); }
            if (ret.len > 0) { return zt_expr_known(ret, 0, errors); }
            return zt_expr_unknown(errors);
        }
        .bin => |b| {
            let l: ZTExpr = zt_expr_type(b.l, env, decls, context);
            let r: ZTExpr = zt_expr_type(b.r, env, decls, context);
            let errors: i32 = l.errors + r.errors;
            let arithmetic: i32 = 0;
            if (@strEq(b.op, "+") || @strEq(b.op, "-") || @strEq(b.op, "*") ||
                @strEq(b.op, "/") || @strEq(b.op, "%")) { arithmetic = 1; }
            if (arithmetic == 1 && l.known == 1 && r.known == 1 &&
                (@strEq(l.ty, "bool") || @strEq(r.ty, "bool") ||
                 @strEq(l.ty, "[]u8") || @strEq(r.ty, "[]u8"))) {
                errors = errors + zt_type_error(l.ty, r.ty, context);
            }
            if (@strEq(b.op, "==") || @strEq(b.op, "!=") || @strEq(b.op, "<") ||
                @strEq(b.op, ">") || @strEq(b.op, "<=") || @strEq(b.op, ">=") ||
                @strEq(b.op, "&&") || @strEq(b.op, "||")) {
                return zt_expr_known("bool", 0, errors);
            }
            if (@strEq(b.op, "orelse") && l.known == 1 && l.ty.len > 1 && l.ty[0] == '?') {
                return zt_expr_known(l.ty[1..], 0, errors);
            }
            if (l.known == 1) { return zt_expr_known(l.ty, l.literal, errors); }
            return zt_expr_unknown(errors);
        }
        .un => |u| {
            let e: ZTExpr = zt_expr_type(u.e, env, decls, context);
            if (@strEq(u.op, "try") && e.known == 1 && e.ty.len > 1 && e.ty[0] == '!') {
                return zt_expr_known(e.ty[1..], 0, e.errors);
            }
            if (@strEq(u.op, "&") && e.known == 1) {
                return zt_expr_known(_zag_str_concat("*", e.ty), 0, e.errors);
            }
            return e;
        }
        .idx => |x| { let b:ZTExpr=zt_expr_type(x.base,env,decls,context);let ix:ZTExpr=zt_expr_type(x.idx,env,decls,context);if(b.known==1&&b.ty.len>2&&b.ty[0]=='['&&b.ty[1]==']'){return zt_expr_known(b.ty[2..],0,b.errors+ix.errors);}if(b.known==1&&b.ty.len>1&&b.ty[0]=='*'){return zt_expr_known(b.ty[1..],0,b.errors+ix.errors);}return zt_expr_unknown(b.errors+ix.errors); }
        .slice_ => |x| { let b:ZTExpr=zt_expr_type(x.base,env,decls,context);let lo:ZTExpr=zt_expr_type(x.lo,env,decls,context);let errors:i32=b.errors+lo.errors;if(x.has_hi==1){errors=errors+zt_expr_type(x.hi,env,decls,context).errors;}if(b.known==1&&b.ty.len>2&&b.ty[0]=='['&&b.ty[1]==']'){return zt_expr_known(b.ty,0,errors);}return zt_expr_unknown(errors); }
        .fld => |x| { let b:ZTExpr=zt_expr_type(x.base,env,decls,context);if(b.known==0){return zt_expr_unknown(b.errors);}let i:i32=0;while(i<decls.len){switch(decls.data[i].*){.struct_=>|s|{if(@strEq(s.name,b.ty)){let j:i32=0;while(j<s.fields.len){if(@strEq(s.fields.data[j].name,x.fname)){return zt_expr_known(s.fields.data[j].pty,0,b.errors);}j=j+1;}}}else=>{}}i=i+1;}return zt_expr_unknown(b.errors); }
        else => { return zt_expr_unknown(0); }
    }
}

fn zt_expr_body(body: ArrayList[*Node], env: *ArrayList[ZTBind], decls: ArrayList[*Node],
                fn_ret: []u8, context: []u8) i32 {
    let errors: i32 = 0;
    let i: i32 = 0;
    while (i < len[*Node](body)) {
        switch (get[*Node](body, i).*) {
            .let_ => |l| {
                let e: ZTExpr = zt_expr_type(l.expr, env.*, decls, context);
                errors = errors + e.errors;
                let ty: []u8 = l.dty;
                if (l.has_dty == 1 && zt_compatible(l.dty, e) == 0) {
                    errors = errors + zt_type_error(l.dty, e.ty, context);
                }
                if (l.has_dty == 0 && e.known == 1) { ty = e.ty; }
                if (ty.len > 0) { push[ZTBind](env, ZTBind{ .name = l.name, .ty = ty }); }
            }
            .ret => |r| {
                if (r.has_expr == 1) {
                    let e: ZTExpr = zt_expr_type(r.expr, env.*, decls, context);
                    errors = errors + e.errors;
                    if (zt_compatible(fn_ret, e) == 0) { errors = errors + zt_type_error(fn_ret, e.ty, context); }
                }
            }
            .assign => |a| {
                let e: ZTExpr = zt_expr_type(a.expr, env.*, decls, context);
                errors = errors + e.errors;
                let name: []u8 = zt_direct_name(a.target);
                let expected: []u8 = zt_env_get(env.*, name);
                if (expected.len > 0 && zt_compatible(expected, e) == 0) {
                    errors = errors + zt_type_error(expected, e.ty, context);
                }
            }
            .if_ => |x| {
                errors = errors + zt_expr_type(x.cond, env.*, decls, context).errors;
                let te: ArrayList[ZTBind] = zt_env_clone(env.*);
                errors = errors + zt_expr_body(x.then_body, &te, decls, fn_ret, context);
                if (x.has_els == 1) {
                    let ee: ArrayList[ZTBind] = zt_env_clone(env.*);
                    errors = errors + zt_expr_body(x.els_body, &ee, decls, fn_ret, context);
                }
            }
            .while_ => |w| {
                errors = errors + zt_expr_type(w.cond, env.*, decls, context).errors;
                let we: ArrayList[ZTBind] = zt_env_clone(env.*);
                errors = errors + zt_expr_body(w.body, &we, decls, fn_ret, context);
            }
            .unsafe_ => |u| {
                let ue: ArrayList[ZTBind] = zt_env_clone(env.*);
                errors = errors + zt_expr_body(u.body, &ue, decls, fn_ret, context);
            }
            .estmt => |e| { errors = errors + zt_expr_type(e.expr, env.*, decls, context).errors; }
            else => { }
        }
        i = i + 1;
    }
    return errors;
}

fn zt_check_expressions(decls: ArrayList[*Node]) i32 {
    let errors: i32 = 0;
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                if (f.is_extern == 0 && zt_starts(f.name, "__iface_") == 0) {
                    let env: ArrayList[ZTBind] = make[ZTBind](len[Param](f.params) + 8);
                    let pi: i32 = 0;
                    while (pi < len[Param](f.params)) {
                        let p: Param = get[Param](f.params, pi);
                        push[ZTBind](&env, ZTBind{ .name = p.name, .ty = p.pty });
                        pi = pi + 1;
                    }
                    errors = errors + zt_expr_body(f.body, &env, decls, f.ret,
                                                   _zag_str_concat("function ", f.name));
                }
            }
            else => { }
        }
        i = i + 1;
    }
    return errors;
}

// ── v2 unsafe/raw-pointer vertical slice ───────────────────────────────────
// The parser preserves an unsafe block as a dedicated AST node. This pass
// enforces the lexical boundary for the first raw-pointer operations before
// any target lowering runs. Pointer provenance instrumentation follows in the
// allocator slice; these checks deliberately do not claim that work early.
fn zt_is_v2_raw_pointer(ty: []u8) i32 {
    if (zt_starts(ty, "*const ") == 1 || zt_starts(ty, "*mut ") == 1 ||
        zt_starts(ty, "*device ") == 1 || zt_starts(ty, "*workgroup ") == 1 ||
        zt_starts(ty, "*host ") == 1 || @strEq(ty, "*opaque")) { return 1; }
    return 0;
}

fn zt_is_nullable_v2_raw_pointer(ty: []u8) i32 {
    if (ty.len > 1 && ty[0] == '?' && zt_is_v2_raw_pointer(ty[1..]) == 1) { return 1; }
    return 0;
}

// Zero is not a v2 raw pointer. Generic/host/device/workgroup are distinct
// semantic address spaces; const/mut/opaque remain within the generic space.
fn zt_v2_pointer_space(ty0: []u8) i32 {
    let ty: []u8 = ty0;
    if (zt_is_nullable_v2_raw_pointer(ty) == 1) { ty = ty[1..]; }
    if (zt_starts(ty, "*device ") == 1) { return 2; }
    if (zt_starts(ty, "*workgroup ") == 1) { return 3; }
    if (zt_starts(ty, "*host ") == 1) { return 4; }
    if (zt_is_v2_raw_pointer(ty) == 1) { return 1; }
    return 0;
}

fn zt_machine_expr_type(n: *Node, env: ArrayList[ZTBind]) []u8 {
    return switch (n.*) {
        .id => |x| zt_env_get(env, x.name),
        .cast_ => |c| c.target,
        .fld => |f| {
            let base_ty: []u8 = zt_machine_expr_type(f.base, env);
            if (@strEq(f.fname, "?") && base_ty.len > 1 && base_ty[0] == '?') {
                return base_ty[1..];
            }
            return "";
        }
        else => "",
    };
}

fn zt_machine_error(rule: []u8, context: []u8) i32 {
    _zag_eprintln(_zag_str_concat(_zag_str_concat("error[E0204]: ", rule),
                                  _zag_str_concat(" in ", context)));
    return 1;
}

fn zt_check_machine_expr(n: *Node, env: ArrayList[ZTBind], decls: ArrayList[*Node],
                         unsafe_scope: i32, writing: i32, context: []u8) i32 {
    switch (n.*) {
        // A plain `fn(...) T` value cannot yet carry the Unsafe effect.  Letting
        // an `unsafe fn` escape through that type would make a later indirect
        // call look safe, so reject the conversion until function types have a
        // typed safety contract. Direct calls are handled below.
        .id => |x| {
            if (zt_fn_has_annot(decls, x.name, "@unsafe") == 1) {
                return zt_machine_error("unsafe function values are not implemented; call the function directly inside unsafe", context);
            }
            return 0;
        }
        .bin => |b| { return zt_check_machine_expr(b.l, env, decls, unsafe_scope, 0, context) +
                            zt_check_machine_expr(b.r, env, decls, unsafe_scope, 0, context); }
        .un => |u| { return zt_check_machine_expr(u.e, env, decls, unsafe_scope, 0, context); }
        .call => |c| {
            let direct: []u8 = zt_direct_name(c.callee);
            let errors: i32 = 0;
            // Do not treat the callee of a direct call as a function value;
            // the lexical call-site rule below is its authority.
            if (direct.len == 0) {
                errors = zt_check_machine_expr(c.callee, env, decls, unsafe_scope, 0, context);
            }
            if (direct.len > 0 && zt_fn_has_annot(decls, direct, "@unsafe") == 1 && unsafe_scope == 0) {
                errors = errors + zt_machine_error("call to unsafe function requires unsafe", context);
            }
            switch (c.callee.*) {
                .fld => |f| {
                    let ty: []u8 = zt_machine_expr_type(f.base, env);
                    if (zt_is_v2_raw_pointer(ty) == 1 &&
                        (@strEq(f.fname, "add") || @strEq(f.fname, "sub") ||
                         @strEq(f.fname, "byte_add")) && unsafe_scope == 0) {
                        errors = errors + zt_machine_error("raw-pointer arithmetic requires unsafe", context);
                    }
                }
                else => { }
            }
            let i: i32 = 0;
            while (i < len[*Node](c.args)) {
                errors = errors + zt_check_machine_expr(get[*Node](c.args, i), env, decls, unsafe_scope, 0, context);
                i = i + 1;
            }
            return errors;
        }
        .idx => |x| {
            let errors: i32 = zt_check_machine_expr(x.base, env, decls, unsafe_scope, 0, context) +
                              zt_check_machine_expr(x.idx, env, decls, unsafe_scope, 0, context);
            if (zt_is_v2_raw_pointer(zt_machine_expr_type(x.base, env)) == 1 && unsafe_scope == 0) {
                errors = errors + zt_machine_error("raw-pointer indexing requires unsafe", context);
            }
            return errors;
        }
        .fld => |f| {
            let errors: i32 = zt_check_machine_expr(f.base, env, decls, unsafe_scope, 0, context);
            let ty: []u8 = zt_machine_expr_type(f.base, env);
            if (@strEq(f.fname, "*")) {
                if (zt_is_nullable_v2_raw_pointer(ty) == 1) {
                    errors = errors + zt_machine_error("nullable raw pointer must be explicitly unwrapped before dereference", context);
                } else if (zt_is_v2_raw_pointer(ty) == 1) {
                    if (unsafe_scope == 0) {
                        errors = errors + zt_machine_error("raw-pointer dereference requires unsafe", context);
                    }
                    if (writing == 1 && zt_starts(ty, "*const ") == 1) {
                        errors = errors + zt_machine_error("cannot write through *const pointer", context);
                    }
                    if (@strEq(ty, "*opaque")) {
                        errors = errors + zt_machine_error("*opaque cannot be dereferenced without an explicit typed conversion", context);
                    }
                }
            }
            return errors;
        }
        .cast_ => |c| {
            let errors: i32 = zt_check_machine_expr(c.expr, env, decls, unsafe_scope, 0, context);
            if (zt_is_v2_raw_pointer(c.target) == 1 && unsafe_scope == 0) {
                errors = errors + zt_machine_error("conversion to a raw pointer requires unsafe", context);
            }
            let source_space: i32 = zt_v2_pointer_space(zt_machine_expr_type(c.expr, env));
            let target_space: i32 = zt_v2_pointer_space(c.target);
            if (source_space > 0 && target_space > 0 && source_space != target_space) {
                errors = errors + zt_machine_error("cannot cast between distinct raw-pointer address spaces", context);
            }
            return errors;
        }
        .slice_ => |s| { return zt_check_machine_expr(s.base, env, decls, unsafe_scope, 0, context) +
                                zt_check_machine_expr(s.lo, env, decls, unsafe_scope, 0, context) +
                                zt_check_machine_expr(s.hi, env, decls, unsafe_scope, 0, context); }
        else => { return 0; }
    }
}

fn zt_check_machine_body(body: ArrayList[*Node], env: *ArrayList[ZTBind], decls: ArrayList[*Node],
                         unsafe_scope: i32, context: []u8) i32 {
    let errors: i32 = 0;
    let i: i32 = 0;
    while (i < len[*Node](body)) {
        switch (get[*Node](body, i).*) {
            .let_ => |l| {
                if (l.has_init == 1) { errors = errors + zt_check_machine_expr(l.expr, env.*, decls, unsafe_scope, 0, context); }
                if (l.has_dty == 1) { push[ZTBind](env, ZTBind{ .name = l.name, .ty = l.dty }); }
            }
            .ret => |r| { if (r.has_expr == 1) { errors = errors + zt_check_machine_expr(r.expr, env.*, decls, unsafe_scope, 0, context); } }
            .assign => |a| { errors = errors + zt_check_machine_expr(a.target, env.*, decls, unsafe_scope, 1, context) +
                                                    zt_check_machine_expr(a.expr, env.*, decls, unsafe_scope, 0, context); }
            .estmt => |e| { errors = errors + zt_check_machine_expr(e.expr, env.*, decls, unsafe_scope, 0, context); }
            .if_ => |x| {
                errors = errors + zt_check_machine_expr(x.cond, env.*, decls, unsafe_scope, 0, context);
                let te: ArrayList[ZTBind] = zt_env_clone(env.*);
                errors = errors + zt_check_machine_body(x.then_body, &te, decls, unsafe_scope, context);
                if (x.has_els == 1) {
                    let ee: ArrayList[ZTBind] = zt_env_clone(env.*);
                    errors = errors + zt_check_machine_body(x.els_body, &ee, decls, unsafe_scope, context);
                }
            }
            .while_ => |w| {
                errors = errors + zt_check_machine_expr(w.cond, env.*, decls, unsafe_scope, 0, context);
                let we: ArrayList[ZTBind] = zt_env_clone(env.*);
                errors = errors + zt_check_machine_body(w.body, &we, decls, unsafe_scope, context);
            }
            .unsafe_ => |u| {
                let ue: ArrayList[ZTBind] = zt_env_clone(env.*);
                errors = errors + zt_check_machine_body(u.body, &ue, decls, 1, context);
            }
            else => { }
        }
        i = i + 1;
    }
    return errors;
}

fn zt_check_machine_control(decls: ArrayList[*Node]) i32 {
    let errors: i32 = 0;
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                let env: ArrayList[ZTBind] = make[ZTBind](len[Param](f.params) + 8);
                let pi: i32 = 0;
                while (pi < len[Param](f.params)) {
                    let p: Param = get[Param](f.params, pi);
                    push[ZTBind](&env, ZTBind{ .name = p.name, .ty = p.pty });
                    pi = pi + 1;
                }
                let fn_unsafe: i32 = zt_fn_has_annot(decls, f.name, "@unsafe");
                errors = errors + zt_check_machine_body(f.body, &env, decls, fn_unsafe,
                    _zag_str_concat("function ", f.name));
            }
            else => { }
        }
        i = i + 1;
    }
    return errors;
}

// Conservative first lifetime check for the v2 allocator milestone. It follows
// straight-line named allocations through explicit release and rejects a later
// use of that same name. Simple local aliases are resolved to their root;
// branches, escaping aliases, and unknown calls remain outside this proof
// slice rather than being guessed as safe.
struct ZTOwnAlias { name: []u8, root: []u8 }
fn zt_alias_root(aliases:ArrayList[ZTOwnAlias],name:[]u8)[]u8{let i:i32=0;while(i<aliases.len){if(@strEq(aliases.data[i].name,name)){return aliases.data[i].root;}i=i+1;}return name;}
fn zt_alias_set(aliases:*ArrayList[ZTOwnAlias],name:[]u8,root:[]u8)void{let i:i32=0;while(i<aliases.*.len){if(@strEq(aliases.*.data[i].name,name)){aliases.*.data[i].root=root;return;}i=i+1;}push[ZTOwnAlias](aliases,ZTOwnAlias{.name=name,.root=root});}
fn zt_names_clone(names:ArrayList[[]u8])ArrayList[[]u8]{let out:ArrayList[[]u8]=make[[]u8](names.len+1);let i:i32=0;while(i<names.len){push[[]u8](&out,names.data[i]);i=i+1;}return out;}
fn zt_alias_clone(aliases:ArrayList[ZTOwnAlias])ArrayList[ZTOwnAlias]{let out:ArrayList[ZTOwnAlias]=make[ZTOwnAlias](aliases.len+1);let i:i32=0;while(i<aliases.len){push[ZTOwnAlias](&out,aliases.data[i]);i=i+1;}return out;}
fn zt_names_merge(into:*ArrayList[[]u8],from:ArrayList[[]u8])void{let i:i32=0;while(i<from.len){if(zt_in_names(into.*,from.data[i])==0){push[[]u8](into,from.data[i]);}i=i+1;}}
fn zt_expr_direct_id(n:*Node)[]u8{switch(n.*){.id=>|x|{return x.name;}else=>{}}return "";}
fn zt_expr_uses_name(n: *Node, name: []u8, aliases:ArrayList[ZTOwnAlias]) i32 {
    switch (n.*) {
        .id => |x| { return @strEq(zt_alias_root(aliases,x.name), name) as i32; }
        .bin => |x| { return zt_expr_uses_name(x.l, name,aliases) | zt_expr_uses_name(x.r, name,aliases); }
        .un => |x| { return zt_expr_uses_name(x.e, name,aliases); }
        .call => |x| { let hit:i32=zt_expr_uses_name(x.callee,name,aliases);let i:i32=0;while(i<len[*Node](x.args)){hit=hit|zt_expr_uses_name(get[*Node](x.args,i),name,aliases);i=i+1;}return hit; }
        .idx => |x| { return zt_expr_uses_name(x.base,name,aliases)|zt_expr_uses_name(x.idx,name,aliases); }
        .fld => |x| { return zt_expr_uses_name(x.base,name,aliases); }
        .cast_ => |x| { return zt_expr_uses_name(x.expr,name,aliases); }
        .slice_ => |x| { return zt_expr_uses_name(x.base,name,aliases)|zt_expr_uses_name(x.lo,name,aliases)|zt_expr_uses_name(x.hi,name,aliases); }
        .slit_ => |x| { let i:i32=0;while(i<len[FieldInit](x.fields)){if(zt_expr_uses_name(get[FieldInit](x.fields,i).val,name,aliases)==1){return 1;}i=i+1;} }
        else => { }
    }
    return 0;
}
fn zt_check_freed_expr(n:*Node,freed:ArrayList[[]u8],aliases:ArrayList[ZTOwnAlias],context:[]u8) i32 {let errors:i32=0;let i:i32=0;while(i<len[[]u8](freed)){let name:[]u8=get[[]u8](freed,i);if(zt_expr_uses_name(n,name,aliases)==1){errors=errors+zt_machine_error(_zag_str_concat("use after free of named allocation `",_zag_str_concat(name,"`")),context);}i=i+1;}return errors;}
fn zt_owned_acquire_name(n:*Node)[]u8{switch(n.*){.cast_=>|c|{return zt_owned_acquire_name(c.expr);}.call=>|c|{let name:[]u8=zt_direct_name(c.callee);if(@strEq(name,"new")||@strEq(name,"_zag_malloc")||@strEq(name,"_zag_realloc")||@strEq(name,"zalloc")||@strEq(name,"zalloc_i")||@strEq(name,"@cacheAlignedAlloc")){return name;}}else=>{}}return "";}
fn zt_collect_owned_body(body:ArrayList[*Node],owned:*ArrayList[[]u8],returned:*ArrayList[[]u8],aliases:*ArrayList[ZTOwnAlias])void{let i:i32=0;while(i<body.len){switch(body.data[i].*){.let_=>|l|{if(l.has_init==1){if(zt_owned_acquire_name(l.expr).len>0&&zt_in_names(owned.*,l.name)==0){push[[]u8](owned,l.name);}let source:[]u8=zt_expr_direct_id(l.expr);if(source.len>0){zt_alias_set(aliases,l.name,zt_alias_root(aliases.*,source));}}}.assign=>|a|{let target:[]u8=zt_expr_direct_id(a.target);let source:[]u8=zt_expr_direct_id(a.expr);if(target.len>0){if(source.len>0){zt_alias_set(aliases,target,zt_alias_root(aliases.*,source));}else{zt_alias_set(aliases,target,"");}}}.ret=>|r|{if(r.has_expr==1){let name:[]u8=zt_expr_direct_id(r.expr);if(name.len>0){let root:[]u8=zt_alias_root(aliases.*,name);if(zt_in_names(returned.*,root)==0){push[[]u8](returned,root);}}}}.if_=>|x|{let ta:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);zt_collect_owned_body(x.then_body,owned,returned,&ta);let ea:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);zt_collect_owned_body(x.els_body,owned,returned,&ea);}.while_=>|x|{let wa:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);zt_collect_owned_body(x.body,owned,returned,&wa);}.unsafe_=>|x|{zt_collect_owned_body(x.body,owned,returned,aliases);}.switch_=>|x|{let ai:i32=0;while(ai<len[SwitchArm](x.arms)){let aa:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);zt_collect_owned_body(get[SwitchArm](x.arms,ai).body,owned,returned,&aa);ai=ai+1;}let ea:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);zt_collect_owned_body(x.els_body,owned,returned,&ea);}else=>{}}i=i+1;}}
fn zt_check_direct_free_body(body: ArrayList[*Node], freed: *ArrayList[[]u8], aliases:*ArrayList[ZTOwnAlias], decls:ArrayList[*Node], context: []u8) i32 {
    let errors: i32 = 0;
    let i: i32 = 0;
    while (i < len[*Node](body)) {
        switch (get[*Node](body, i).*) {
            .let_ => |l| { if(l.has_init==1){errors=errors+zt_check_freed_expr(l.expr,freed.*,aliases.*,context);let source:[]u8=zt_expr_direct_id(l.expr);if(source.len>0){zt_alias_set(aliases,l.name,zt_alias_root(aliases.*,source));}} }
            .ret => |r| { if(r.has_expr==1){errors=errors+zt_check_freed_expr(r.expr,freed.*,aliases.*,context);} }
            .assign => |a| { errors=errors+zt_check_freed_expr(a.target,freed.*,aliases.*,context)+zt_check_freed_expr(a.expr,freed.*,aliases.*,context);let target:[]u8=zt_expr_direct_id(a.target);let source:[]u8=zt_expr_direct_id(a.expr);if(target.len>0){if(source.len>0){zt_alias_set(aliases,target,zt_alias_root(aliases.*,source));}else{zt_alias_set(aliases,target,"");}} }
            .estmt => |e| {
                switch (e.expr.*) {
                    .call => |c| {
                        let name: []u8 = zt_direct_name(c.callee);
                        if ((@strEq(name, "delete") || @strEq(name, "_zag_free")) && len[*Node](c.args) == 1) {
                            switch (get[*Node](c.args, 0).*) {
                                .id => |p| {
                                    let root:[]u8=zt_alias_root(aliases.*,p.name);if (zt_in_names(freed.*, root) == 1) {
                                        errors = errors + zt_machine_error("double free of named allocation", context);
                                    } else { push[[]u8](freed, root); }
                                }
                                else => { }
                            }
                        } else { if(zt_fn_has_annot(decls,name,"@consumes")==1&&c.args.len==1){switch(c.args.data[0].*){.id=>|p|{let root:[]u8=zt_alias_root(aliases.*,p.name);if(zt_in_names(freed.*,root)==1){errors=errors+zt_machine_error("consumes an already released owner",context);}else{push[[]u8](freed,root);}}else=>{errors=errors+zt_machine_error("@consumes requires a named owner argument",context);}}}else{errors=errors+zt_check_freed_expr(e.expr,freed.*,aliases.*,context);} }
                    }
                    else => { errors=errors+zt_check_freed_expr(e.expr,freed.*,aliases.*,context); }
                }
            }
            .unsafe_ => |u| { errors = errors + zt_check_direct_free_body(u.body, freed, aliases, decls, context); }
            .if_ => |x| { errors=errors+zt_check_freed_expr(x.cond,freed.*,aliases.*,context);let base:ArrayList[[]u8]=zt_names_clone(freed.*);let tf:ArrayList[[]u8]=zt_names_clone(base);let ta:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);errors=errors+zt_check_direct_free_body(x.then_body,&tf,&ta,decls,context);if(x.has_els==1){let ef:ArrayList[[]u8]=zt_names_clone(base);let ea:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);errors=errors+zt_check_direct_free_body(x.els_body,&ef,&ea,decls,context);zt_names_merge(freed,&ef);}zt_names_merge(freed,&tf); }
            .while_ => |w| { errors=errors+zt_check_freed_expr(w.cond,freed.*,aliases.*,context);let wf:ArrayList[[]u8]=zt_names_clone(freed.*);let wa:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);errors=errors+zt_check_direct_free_body(w.body,&wf,&wa,decls,context);zt_names_merge(freed,&wf); }
            else => { }
        }
        i = i + 1;
    }
    return errors;
}

fn zt_check_v2_direct_frees(decls: ArrayList[*Node], file: []u8) i32 {
    if (@strEq(v2_project_edition(file), "2027") == 0) { return 0; }
    let errors: i32 = 0; let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| { let freed: ArrayList[[]u8] = make[[]u8](4);let aliases:ArrayList[ZTOwnAlias]=make[ZTOwnAlias](4);let context:[]u8=_zag_str_concat("function ",f.name); errors = errors + zt_check_direct_free_body(f.body, &freed, &aliases, decls, context);let owned:ArrayList[[]u8]=make[[]u8](4);let returned:ArrayList[[]u8]=make[[]u8](2);let transfer_aliases:ArrayList[ZTOwnAlias]=make[ZTOwnAlias](4);zt_collect_owned_body(f.body,&owned,&returned,&transfer_aliases);let oi:i32=0;while(oi<owned.len){let name:[]u8=owned.data[oi];if(zt_in_names(freed,name)==0&&zt_in_names(returned,name)==0){errors=errors+zt_machine_error(_zag_str_concat("owned allocation `",_zag_str_concat(name,"` is neither released nor returned")),context);}oi=oi+1;} }
            else => { }
        }
        i = i + 1;
    }
    return errors;
}

// ── edition-2027 explicit borrow-contract slice ───────────────────────────
// Contracts are deliberately opt-in.  @borrows declares that the first named
// parameter is shared/read-only.  @borrows_mut permits mutation by the callee;
// when its result is bound to a local, that local is an escaping exclusive
// borrow for the remainder of this function.  We have no lexical end-borrow
// syntax yet, so retaining that exclusive state is conservative: callers must
// not use the owner (or a non-borrow alias) while it remains active.
//
// This pass is edition-2027 only.  It does not reinterpret ordinary pointers
// or calls in 2026 projects, and it never assumes an unknown call borrows.
struct ZTBorrowAlias { name: []u8, root: []u8, mode: i32 }
fn zt_borrow_mode(decls:ArrayList[*Node],name:[]u8)i32{if(zt_fn_has_annot(decls,name,"@borrows_mut")==1){return 2;}if(zt_fn_has_annot(decls,name,"@borrows")==1){return 1;}return 0;}
fn zt_borrow_alias_mode(borrows:ArrayList[ZTBorrowAlias],name:[]u8)i32{let i:i32=0;while(i<borrows.len){if(@strEq(borrows.data[i].name,name)){return borrows.data[i].mode;}i=i+1;}return 0;}
fn zt_borrow_alias_root(borrows:ArrayList[ZTBorrowAlias],name:[]u8)[]u8{let i:i32=0;while(i<borrows.len){if(@strEq(borrows.data[i].name,name)){return borrows.data[i].root;}i=i+1;}return name;}
fn zt_borrow_set(borrows:*ArrayList[ZTBorrowAlias],name:[]u8,root:[]u8,mode:i32)void{let i:i32=0;while(i<borrows.*.len){if(@strEq(borrows.*.data[i].name,name)){borrows.*.data[i]=ZTBorrowAlias{.name=name,.root=root,.mode=mode};return;}i=i+1;}push[ZTBorrowAlias](borrows,ZTBorrowAlias{.name=name,.root=root,.mode=mode});}
fn zt_borrow_root_has(borrows:ArrayList[ZTBorrowAlias],root:[]u8,mode:i32)i32{let i:i32=0;while(i<borrows.len){if(borrows.data[i].mode==mode&&@strEq(borrows.data[i].root,root)){return 1;}i=i+1;}return 0;}
fn zt_borrow_expr_root(n:*Node,aliases:ArrayList[ZTOwnAlias],borrows:ArrayList[ZTBorrowAlias])[]u8{let name:[]u8=zt_expr_direct_id(n);if(name.len==0){return "";}let b:[]u8=zt_borrow_alias_root(borrows,name);return zt_alias_root(aliases,b);}
fn zt_check_active_borrow_expr(n:*Node,aliases:ArrayList[ZTOwnAlias],borrows:ArrayList[ZTBorrowAlias],context:[]u8)i32{switch(n.*){.id=>|x|{let root:[]u8=zt_alias_root(aliases,zt_borrow_alias_root(borrows,x.name));if(zt_borrow_root_has(borrows,root,2)==1&&zt_borrow_alias_mode(borrows,x.name)!=2){return zt_machine_error(_zag_str_concat("owner `",_zag_str_concat(root,"` is unavailable while an exclusive mutable borrow is active")),context);}}.bin=>|x|{return zt_check_active_borrow_expr(x.l,aliases,borrows,context)+zt_check_active_borrow_expr(x.r,aliases,borrows,context);}.un=>|x|{return zt_check_active_borrow_expr(x.e,aliases,borrows,context);}.call=>|x|{let errors:i32=zt_check_active_borrow_expr(x.callee,aliases,borrows,context);let i:i32=0;while(i<x.args.len){errors=errors+zt_check_active_borrow_expr(x.args.data[i],aliases,borrows,context);i=i+1;}return errors;}.idx=>|x|{return zt_check_active_borrow_expr(x.base,aliases,borrows,context)+zt_check_active_borrow_expr(x.idx,aliases,borrows,context);}.fld=>|x|{return zt_check_active_borrow_expr(x.base,aliases,borrows,context);}.cast_=>|x|{return zt_check_active_borrow_expr(x.expr,aliases,borrows,context);}.slice_=>|x|{return zt_check_active_borrow_expr(x.base,aliases,borrows,context)+zt_check_active_borrow_expr(x.lo,aliases,borrows,context)+zt_check_active_borrow_expr(x.hi,aliases,borrows,context);}.slit_=>|x|{let errors:i32=0;let i:i32=0;while(i<x.fields.len){errors=errors+zt_check_active_borrow_expr(x.fields.data[i].val,aliases,borrows,context);i=i+1;}return errors;}else=>{}}return 0;}
fn zt_check_borrow_write(n:*Node,aliases:ArrayList[ZTOwnAlias],borrows:ArrayList[ZTBorrowAlias],context:[]u8)i32{switch(n.*){.id=>|x|{let root:[]u8=zt_alias_root(aliases,zt_borrow_alias_root(borrows,x.name));let mode:i32=zt_borrow_alias_mode(borrows,x.name);if(mode==1){return zt_machine_error("cannot mutate through a shared borrow",context);}if(zt_borrow_root_has(borrows,root,2)==1&&mode!=2){return zt_machine_error(_zag_str_concat("cannot mutate owner `",_zag_str_concat(root,"` while an exclusive mutable borrow is active")),context);}if(zt_borrow_root_has(borrows,root,1)==1&&mode!=2){return zt_machine_error(_zag_str_concat("cannot mutate owner `",_zag_str_concat(root,"` while a shared borrow is active")),context);}}.fld=>|x|{return zt_check_borrow_write(x.base,aliases,borrows,context);}.idx=>|x|{return zt_check_borrow_write(x.base,aliases,borrows,context);}.un=>|x|{return zt_check_borrow_write(x.e,aliases,borrows,context);}else=>{}}return 0;}
fn zt_call_borrow_mode(n:*Node,decls:ArrayList[*Node])i32{switch(n.*){.call=>|c|{return zt_borrow_mode(decls,zt_direct_name(c.callee));}else=>{}}return 0;}
fn zt_check_borrow_call(n:*Node,decls:ArrayList[*Node],aliases:ArrayList[ZTOwnAlias],borrows:ArrayList[ZTBorrowAlias],context:[]u8)i32{switch(n.*){.call=>|c|{let name:[]u8=zt_direct_name(c.callee);if(zt_fn_has_annot(decls,name,"@consumes")==1&&c.args.len==1&&zt_borrow_alias_mode(borrows,zt_expr_direct_id(c.args.data[0]))>0){return zt_machine_error("cannot pass a borrow to a consuming call",context);}let mode:i32=zt_borrow_mode(decls,name);if(mode==0){return 0;}if(c.args.len!=1){return zt_machine_error("borrow contract requires exactly one named owner argument",context);}let arg:[]u8=zt_expr_direct_id(c.args.data[0]);if(arg.len==0){return zt_machine_error("borrow contract requires a named owner argument",context);}let root:[]u8=zt_borrow_expr_root(c.args.data[0],aliases,borrows);let existing:i32=zt_borrow_alias_mode(borrows,arg);if(mode==2&&(existing==1||zt_borrow_root_has(borrows,root,1)==1)){return zt_machine_error("cannot create an exclusive mutable borrow while a shared borrow is active",context);}if(mode==2&&zt_borrow_root_has(borrows,root,2)==1&&existing!=2){return zt_machine_error("cannot create a second exclusive mutable borrow while one is active",context);}}else=>{}}return 0;}
fn zt_contract_param_name(f:FnDecl)[]u8{if(f.params.len==0){return "";}return f.params.data[0].name;}
fn zt_check_borrow_body(body:ArrayList[*Node],aliases:*ArrayList[ZTOwnAlias],borrows:*ArrayList[ZTBorrowAlias],decls:ArrayList[*Node],context:[]u8)i32{
    let errors:i32=0;let i:i32=0;
    while(i<body.len){switch(body.data[i].*){
        .let_=>|l|{if(l.has_init==1){
            errors=errors+zt_check_active_borrow_expr(l.expr,aliases.*,borrows.*,context)+zt_check_borrow_call(l.expr,decls,aliases.*,borrows.*,context);
            let source:[]u8=zt_expr_direct_id(l.expr);
            // A local copy of a borrow is still that same borrow.  Recording
            // this prevents an alias from laundering a borrowed value into an
            // @consumes call or release operation.
            if(source.len>0){let root:[]u8=zt_alias_root(aliases.*,zt_borrow_alias_root(borrows.*,source));zt_alias_set(aliases,l.name,root);let copied_mode:i32=zt_borrow_alias_mode(borrows.*,source);if(copied_mode>0){zt_borrow_set(borrows,l.name,root,copied_mode);}}
            let mode:i32=zt_call_borrow_mode(l.expr,decls);
            if(mode>0){let call:*Node=l.expr;switch(call.*){.call=>|c|{let root:[]u8=zt_borrow_expr_root(c.args.data[0],aliases.*,borrows.*);zt_borrow_set(borrows,l.name,root,mode);}else=>{}}}
        }}
        .ret=>|r|{if(r.has_expr==1){errors=errors+zt_check_active_borrow_expr(r.expr,aliases.*,borrows.*,context)+zt_check_borrow_call(r.expr,decls,aliases.*,borrows.*,context);}}
        .assign=>|a|{errors=errors+zt_check_active_borrow_expr(a.expr,aliases.*,borrows.*,context)+zt_check_borrow_call(a.expr,decls,aliases.*,borrows.*,context)+zt_check_borrow_write(a.target,aliases.*,borrows.*,context);}
        .estmt=>|e|{errors=errors+zt_check_active_borrow_expr(e.expr,aliases.*,borrows.*,context)+zt_check_borrow_call(e.expr,decls,aliases.*,borrows.*,context);switch(e.expr.*){.call=>|c|{let name:[]u8=zt_direct_name(c.callee);if((@strEq(name,"delete")||@strEq(name,"_zag_free"))&&c.args.len==1){if(zt_borrow_alias_mode(borrows.*,zt_expr_direct_id(c.args.data[0]))>0){errors=errors+zt_machine_error("cannot release through a borrow",context);}else{errors=errors+zt_check_borrow_write(c.args.data[0],aliases.*,borrows.*,context);}}}else=>{}}}
        .unsafe_=>|u|{errors=errors+zt_check_borrow_body(u.body,aliases,borrows,decls,context);}
        .if_=>|x|{errors=errors+zt_check_active_borrow_expr(x.cond,aliases.*,borrows.*,context);let ta:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);let tb:ArrayList[ZTBorrowAlias]=make[ZTBorrowAlias](borrows.*.len+1);let bi:i32=0;while(bi<borrows.*.len){push[ZTBorrowAlias](&tb,borrows.*.data[bi]);bi=bi+1;}errors=errors+zt_check_borrow_body(x.then_body,&ta,&tb,decls,context);if(x.has_els==1){let ea:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);let eb:ArrayList[ZTBorrowAlias]=make[ZTBorrowAlias](borrows.*.len+1);bi=0;while(bi<borrows.*.len){push[ZTBorrowAlias](&eb,borrows.*.data[bi]);bi=bi+1;}errors=errors+zt_check_borrow_body(x.els_body,&ea,&eb,decls,context);}}
        .while_=>|x|{errors=errors+zt_check_active_borrow_expr(x.cond,aliases.*,borrows.*,context);let wa:ArrayList[ZTOwnAlias]=zt_alias_clone(aliases.*);let wb:ArrayList[ZTBorrowAlias]=make[ZTBorrowAlias](borrows.*.len+1);let bi:i32=0;while(bi<borrows.*.len){push[ZTBorrowAlias](&wb,borrows.*.data[bi]);bi=bi+1;}errors=errors+zt_check_borrow_body(x.body,&wa,&wb,decls,context);}
        else=>{}
    }i=i+1;}return errors;
}
fn zt_check_v2_borrow_contracts(decls:ArrayList[*Node],file:[]u8)i32{if(@strEq(v2_project_edition(file),"2027")==0){return 0;}let errors:i32=0;let i:i32=0;while(i<decls.len){switch(decls.data[i].*){.fn_decl=>|f|{let mode:i32=zt_borrow_mode(decls,f.name);let aliases:ArrayList[ZTOwnAlias]=make[ZTOwnAlias](4);let borrows:ArrayList[ZTBorrowAlias]=make[ZTBorrowAlias](4);if(mode>0){let param:[]u8=zt_contract_param_name(f);if(param.len==0){errors=errors+zt_machine_error("borrow contract requires a first parameter",_zag_str_concat("function ",f.name));}else{zt_borrow_set(&borrows,param,param,mode);}}errors=errors+zt_check_borrow_body(f.body,&aliases,&borrows,decls,_zag_str_concat("function ",f.name));}else=>{}}i=i+1;}return errors;}

fn typed_check_program(decls0: ArrayList[*Node], file: []u8) i32 {
    let decls: ArrayList[[]u8] = zt_decl_names(decls0);
    let errors: i32 = 0;
    let i: i32 = 0;
    while (i < len[*Node](decls0)) {
        switch (get[*Node](decls0, i).*) {
            .struct_ => |s| {
                let context: []u8 = _zag_str_concat("struct ", s.name);
                let fi: i32 = 0;
                while (fi < len[Param](s.fields)) {
                    errors = errors + zt_validate_type(get[Param](s.fields, fi).pty, decls, s.tparams, context);
                    fi = fi + 1;
                }
            }
            .union_ => |u| {
                let context: []u8 = _zag_str_concat("union ", u.name);
                let none: ArrayList[[]u8] = make[[]u8](1);
                let fi: i32 = 0;
                while (fi < len[Param](u.fields)) {
                    errors = errors + zt_validate_type(get[Param](u.fields, fi).pty, decls, none, context);
                    fi = fi + 1;
                }
            }
            .fn_decl => |f| {
                let context: []u8 = _zag_str_concat("function ", f.name);
                let pi: i32 = 0;
                while (pi < len[Param](f.params)) {
                    errors = errors + zt_validate_type(get[Param](f.params, pi).pty, decls, f.tparams, context);
                    pi = pi + 1;
                }
                errors = errors + zt_validate_type(f.ret, decls, f.tparams, context);
                errors = errors + zt_check_body(f.body, decls, f.tparams, context);
            }
            else => { }
        }
        i = i + 1;
    }
    errors = errors + zt_check_expressions(decls0);
    errors = errors + zt_check_machine_control(decls0);
    errors = errors + zt_check_v2_direct_frees(decls0, file);
    errors = errors + zt_check_v2_borrow_contracts(decls0, file);
    if (errors > 0) {
        _zag_eprintln(_zag_str_concat(_zag_str_concat("znc: typed declaration check FAILED for ", file),
                                     _zag_str_concat(" (errors=", _zag_str_concat(_zag_i64_to_str(errors as i64), ")"))));
    }
    return errors;
}
