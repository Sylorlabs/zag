// selfhost/msl.zag — Zag → Metal Shading Language (MSL) encoder for Metal compute.
//
// This is the compiler-owned MSL encoder used by both the first-class gpu-metal
// target and the legacy metal-compat spelling. It takes Zag @kernel source and
// emits MSL text that is loaded by the native Metal.framework runtime on macOS.
//
// The reviewed native profile intentionally matches the bounded GFX10.1 slice:
// fill, depth-write, and depth-tested packed-RGB blend. Unknown AST shapes fail
// closed instead of silently falling through to another GPU backend.
//
// The fill kernel maps to MSL as:
//   #include <metal_stdlib>
//   using namespace metal;
//   kernel void fillKernel(device int* out [[buffer(0)]],
//                           constant int& value [[buffer(1)]],
//                           constant int& count [[buffer(2)]],
//                           uint gid [[thread_position_in_grid]]) {
//       if (gid < count) { out[gid] = value; }
//   }

@import("parse.zag")

// ── kernel validation (mirrors spirv.zag) ───────────────────────────────────
fn msl_is_id(n: *Node, want: []u8) bool {
    return switch (n.*) {
        .id => |x| @strEq(x.name, want),
        else => false,
    };
}

fn msl_is_zero(n: *Node) bool {
    return switch (n.*) {
        .ilit => |x| @strEq(x.text, "0"),
        else => false,
    };
}

fn msl_is_builtin_dim(n: *Node, name: []u8) bool {
    let ok: bool = false;
    switch (n.*) {
        .call => |c| {
            if (!msl_is_id(c.callee, name) || len[*Node](c.args) != 1) { return false; }
            ok = msl_is_zero(get[*Node](c.args, 0));
        }
        else => { }
    }
    return ok;
}

fn msl_is_global_index(n: *Node) bool {
    let ok: bool = false;
    switch (n.*) {
        .bin => |add| {
            if (!@strEq(add.op, "+") || !msl_is_builtin_dim(add.r, "@gpuThreadIdx")) { return false; }
            switch (add.l.*) {
                .bin => |mul| {
                    ok = @strEq(mul.op, "*") &&
                        msl_is_builtin_dim(mul.l, "@gpuBlockIdx") &&
                        msl_is_builtin_dim(mul.r, "@gpuBlockDim");
                }
                else => { }
            }
        }
        else => { }
    }
    return ok;
}

fn msl_has_annot(f: FnDecl, want: []u8) bool {
    let i: i32 = 0;
    while (i < len[[]u8](f.annots)) {
        if (@strEq(get[[]u8](f.annots, i), want)) { return true; }
        i = i + 1;
    }
    return false;
}

fn msl_is_fill_kernel(f: FnDecl) bool {
    if (!msl_has_annot(f, "@kernel") || len[Param](f.params) != 3 ||
        !@strEq(f.ret, "void") || len[*Node](f.body) != 2) { return false; }
    let p_out: Param = get[Param](f.params, 0);
    let p_val: Param = get[Param](f.params, 1);
    let p_cnt: Param = get[Param](f.params, 2);
    if (!@strEq(p_out.pty, "[]i32") || !@strEq(p_val.pty, "i32") ||
        !@strEq(p_cnt.pty, "i32")) { return false; }
    let idx_name: []u8 = "";
    switch (get[*Node](f.body, 0).*) {
        .let_ => |l| {
            if (l.has_init == 0 || !msl_is_global_index(l.expr)) { return false; }
            idx_name = l.name;
        }
        else => { return false; }
    }
    let valid: bool = false;
    switch (get[*Node](f.body, 1).*) {
        .if_ => |x| {
            if (x.has_els != 0 || len[*Node](x.then_body) != 1) { return false; }
            let cond_ok: bool = switch (x.cond.*) {
                .bin => |b| @strEq(b.op, "<") && msl_is_id(b.l, idx_name) && msl_is_id(b.r, p_cnt.name),
                else => false,
            };
            if (!cond_ok) { return false; }
            switch (get[*Node](x.then_body, 0).*) {
                .assign => |a| {
                    if (!msl_is_id(a.expr, p_val.name)) { return false; }
                    valid = switch (a.target.*) {
                        .idx => |ix| msl_is_id(ix.base, p_out.name) && msl_is_id(ix.idx, idx_name),
                        else => false,
                    };
                }
                else => { }
            }
        }
        else => { }
    }
    return valid;
}

fn msl_is_index_of(n:*Node,base_name:[]u8,idx_name:[]u8) bool {
    let ok:bool=false;
    switch(n.*) {
        .idx=>|ix| { ok=msl_is_id(ix.base,base_name)&&msl_is_id(ix.idx,idx_name); }
        else=>{ }
    }
    return ok;
}

fn msl_is_depth_kernel(f:FnDecl) bool {
    if(!msl_has_annot(f,"@kernel")||len[Param](f.params)!=4||
        !@strEq(f.ret,"void")||len[*Node](f.body)!=2){return false;}
    let pc:Param=get[Param](f.params,0);let pd:Param=get[Param](f.params,1);
    let pv:Param=get[Param](f.params,2);let pz:Param=get[Param](f.params,3);
    if(!@strEq(pc.pty,"[]i32")||!@strEq(pd.pty,"[]i32")||
        !@strEq(pv.pty,"i32")||!@strEq(pz.pty,"i32")){return false;}
    let idx:[]u8="";
    switch(get[*Node](f.body,0).*) {
        .let_=>|l|{if(l.has_init==0||!msl_is_global_index(l.expr)){return false;}idx=l.name;}
        else=>{return false;}
    }
    let valid:bool=false;
    switch(get[*Node](f.body,1).*) {
        .if_=>|x|{
            if(x.has_els!=0||len[*Node](x.then_body)!=2){return false;}
            let cond:bool=false;
            switch(x.cond.*) {
                .bin=>|b|{cond=@strEq(b.op,"<=")&&msl_is_id(b.l,pz.name)&&msl_is_index_of(b.r,pd.name,idx);}
                else=>{ }
            }
            if(!cond){return false;}
            let color_ok:bool=false;let depth_ok:bool=false;
            switch(get[*Node](x.then_body,0).*) {
                .assign=>|a|{color_ok=msl_is_id(a.expr,pv.name)&&msl_is_index_of(a.target,pc.name,idx);}
                else=>{ }
            }
            switch(get[*Node](x.then_body,1).*) {
                .assign=>|a|{depth_ok=msl_is_id(a.expr,pz.name)&&msl_is_index_of(a.target,pd.name,idx);}
                else=>{ }
            }
            valid=color_ok&&depth_ok;
        }
        else=>{ }
    }
    return valid;
}

fn msl_is_blend_expr(n:*Node,value_name:[]u8,color_name:[]u8,
                     alpha_name:[]u8,idx_name:[]u8) bool {
    let ok:bool=false;
    switch(n.*) {
        .call=>|c|{
            if(!msl_is_id(c.callee,"@gpuBlend")||len[*Node](c.args)!=3){return false;}
            ok=msl_is_id(get[*Node](c.args,0),value_name)&&
                msl_is_index_of(get[*Node](c.args,1),color_name,idx_name)&&
                msl_is_id(get[*Node](c.args,2),alpha_name);
        }
        else=>{ }
    }
    return ok;
}

fn msl_is_blend_kernel(f:FnDecl) bool {
    if(!msl_has_annot(f,"@kernel")||len[Param](f.params)!=5||
        !@strEq(f.ret,"void")||len[*Node](f.body)!=2){return false;}
    let pc:Param=get[Param](f.params,0);let pd:Param=get[Param](f.params,1);
    let pv:Param=get[Param](f.params,2);let pz:Param=get[Param](f.params,3);
    let pa:Param=get[Param](f.params,4);
    if(!@strEq(pc.pty,"[]i32")||!@strEq(pd.pty,"[]i32")||
        !@strEq(pv.pty,"i32")||!@strEq(pz.pty,"i32")||
        !@strEq(pa.pty,"i32")){return false;}
    let idx:[]u8="";
    switch(get[*Node](f.body,0).*) {
        .let_=>|l|{if(l.has_init==0||!msl_is_global_index(l.expr)){return false;}idx=l.name;}
        else=>{return false;}
    }
    let valid:bool=false;
    switch(get[*Node](f.body,1).*) {
        .if_=>|x|{
            if(x.has_els!=0||len[*Node](x.then_body)!=2){return false;}
            let cond:bool=false;
            switch(x.cond.*) {
                .bin=>|b|{cond=@strEq(b.op,"<=")&&msl_is_id(b.l,pz.name)&&msl_is_index_of(b.r,pd.name,idx);}
                else=>{ }
            }
            if(!cond){return false;}
            let color_ok:bool=false;let depth_ok:bool=false;
            switch(get[*Node](x.then_body,0).*) {
                .assign=>|a|{color_ok=msl_is_blend_expr(a.expr,pv.name,pc.name,pa.name,idx)&&msl_is_index_of(a.target,pc.name,idx);}
                else=>{ }
            }
            switch(get[*Node](x.then_body,1).*) {
                .assign=>|a|{depth_ok=msl_is_id(a.expr,pz.name)&&msl_is_index_of(a.target,pd.name,idx);}
                else=>{ }
            }
            valid=color_ok&&depth_ok;
        }
        else=>{ }
    }
    return valid;
}

fn msl_find_profile(decls: ArrayList[*Node]) i32 {
    let found: i32 = 0;
    let kernels: i32 = 0;
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                if (msl_has_annot(f, "@kernel") || msl_has_annot(f, "@device")) {
                    kernels = kernels + 1;
                    if (msl_is_fill_kernel(f)) { found = 1; }
                    else if (msl_is_depth_kernel(f)) { found = 2; }
                    else if (msl_is_blend_kernel(f)) { found = 3; }
                }
            }
            else => { }
        }
        i = i + 1;
    }
    if (kernels != 1) { return 0; }
    return found;
}

// ── MSL text emission for the fill kernel ───────────────────────────────────
fn msl_emit_fill(out: *ArrayList[u8]) void {
    let header: []u8 = "#include <metal_stdlib>\nusing namespace metal;\n\n";
    let i: i32 = 0;
    while (i < header.len) { push[u8](out, header[i]); i = i + 1; }

    let kernel: []u8 = "kernel void fillKernel(device int* out [[buffer(0)]],\n                              constant int& value [[buffer(1)]],\n                              constant int& count [[buffer(2)]],\n                              uint gid [[thread_position_in_grid]]) {\n    if (gid < count) {\n        out[gid] = value;\n    }\n}\n";
    i = 0;
    while (i < kernel.len) { push[u8](out, kernel[i]); i = i + 1; }
}

fn msl_emit_text(out:*ArrayList[u8],text:[]u8) void {
    let i:i32=0;
    while(i<text.len){push[u8](out,text[i]);i=i+1;}
}

fn msl_emit_depth(out:*ArrayList[u8]) void {
    msl_emit_text(out,"#include <metal_stdlib>\nusing namespace metal;\n\n");
    msl_emit_text(out,"kernel void depthWriteKernel(device int* color [[buffer(0)]],\n                              device int* depth [[buffer(1)]],\n                              constant int& value [[buffer(2)]],\n                              constant int& z [[buffer(3)]],\n                              uint gid [[thread_position_in_grid]]) {\n    if (z <= depth[gid]) {\n        color[gid] = value;\n        depth[gid] = z;\n    }\n}\n");
}

fn msl_emit_blend(out:*ArrayList[u8]) void {
    msl_emit_text(out,"#include <metal_stdlib>\nusing namespace metal;\n\n");
    msl_emit_text(out,"kernel void blendDepthKernel(device int* color [[buffer(0)]],\n                              device int* depth [[buffer(1)]],\n                              constant int& value [[buffer(2)]],\n                              constant int& z [[buffer(3)]],\n                              constant int& alpha [[buffer(4)]],\n                              uint gid [[thread_position_in_grid]]) {\n    if (z <= depth[gid]) {\n        int old = color[gid];\n        int inv = 256 - alpha;\n        int r = ((((value >> 16) & 255) * alpha) + (((old >> 16) & 255) * inv)) / 256;\n        int g = ((((value >> 8) & 255) * alpha) + (((old >> 8) & 255) * inv)) / 256;\n        int b = (((value & 255) * alpha) + ((old & 255) * inv)) / 256;\n        color[gid] = (r << 16) | (g << 8) | b;\n        depth[gid] = z;\n    }\n}\n");
}

// ── public entry point ──────────────────────────────────────────────────────
fn emit_msl(src: []u8, errors: *i32) ArrayList[u8] {
    let decls: ArrayList[*Node] = parse_program(src);
    let out: ArrayList[u8] = make[u8](256);
    let profile: i32 = msl_find_profile(decls);
    if (profile == 0) {
        _zag_println("znc[msl]: unsupported kernel: require exactly one reviewed bounded fill @kernel; loops, host effects, unsafe pointers, and unknown forms are rejected");
        errors.* = errors.* + 1;
        return out;
    }
    if (profile == 1) {
        msl_emit_fill(&out);
    } else if (profile == 2) {
        msl_emit_depth(&out);
    } else if (profile == 3) {
        msl_emit_blend(&out);
    } else {
        _zag_println("znc[msl]: supported native profiles are fill, depth-write, and depth-tested packed RGB blend");
        errors.* = errors.* + 1;
        return out;
    }
    return out;
}

fn emit_msl_dir(src: []u8, base_dir: []u8, errors: *i32) ArrayList[u8] {
    let decls: ArrayList[*Node] = parse_program_dir(src, base_dir);
    let out: ArrayList[u8] = make[u8](256);
    let profile: i32 = msl_find_profile(decls);
    if (profile == 0) {
        _zag_println("znc[msl]: unsupported kernel: require exactly one reviewed bounded fill @kernel; loops, host effects, unsafe pointers, and unknown forms are rejected");
        errors.* = errors.* + 1;
        return out;
    }
    if (profile == 1) {
        msl_emit_fill(&out);
    } else if (profile == 2) {
        msl_emit_depth(&out);
    } else if (profile == 3) {
        msl_emit_blend(&out);
    } else {
        _zag_println("znc[msl]: supported native profiles are fill, depth-write, and depth-tested packed RGB blend");
        errors.* = errors.* + 1;
        return out;
    }
    return out;
}
