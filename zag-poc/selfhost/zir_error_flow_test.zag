@import("zir.zag")
@import("sema.zag")
@import("../std/map.zag") as map

fn zef_check(ok:i32,name:[]u8,fail:*i32)void{
    if(ok==1){_zag_println(_zag_str_concat("ok  ",name));}
    else{_zag_eprintln(_zag_str_concat("XX  ",name));fail.*=fail.*+1;}
}
fn zef_find(blk:ZBlock,name:[]u8)i32{
    let i:i32=0;while(i<blk.ops.len){if(@strEq(blk.ops.data[i].name,name)){return i;}i=i+1;}return 0-1;
}

fn main()i32{
    let fail:i32=0;
    let unit:CompilationUnit=parse_compilation_unit_dir(
        "error { Err } fn fail(x:i32) !i32 { return x; } fn calc(x:i32) !i32 { let y:i32=try fail(x); return y; }\n", ".");
    let eff:map.StringMap[i32]=analyze(unit.decls);
    let authority:ZirAuthority=zir_prepare_production_with_origins(unit.decls,eff,unit.origins);
    let report:ZirContractReport=zir_verify_contracts(authority.module);
    zef_check(authority.valid==1&&authority.coverage_complete==1&&report.valid==1,
        "try lowers to a valid typed error-flow contract",&fail);
    let calc:ZFunc=authority.module.funcs.data[1];
    let pi:i32=zef_find(calc.body,"error.propagate");
    zef_check(pi>=0,"error propagation is explicit in ZIR",&fail);
    if(pi>=0){
        let op:ZOp=calc.body.ops.data[pi];
        zef_check(op.operands.len==1&&op.results.len==1&&
            @strEq(op.operands.data[0].ty,"!i32")&&@strEq(op.results.data[0].ty,"i32")&&
            @strEq(attr_val(op,"error_type"),"!i32")&&
            @strEq(attr_val(op,"result_type"),"i32")&&
            @strEq(attr_val(op,"propagates"),"1")&&op.origin.complete==1&&op.origin.exact==1,
            "error propagation carries exact types and origin",&fail);
    }
    let bad_type:ZModule=zir_clone_module(authority.module);
    bad_type.funcs.data[1].body.ops.data[pi].results.data[0].ty="i64";
    zef_check(zir_verify_contracts(bad_type).valid==0,
        "mismatched propagated result is rejected",&fail);
    let bad_attr:ZModule=zir_clone_module(authority.module);
    bad_attr.funcs.data[1].body.ops.data[pi].attrs.data[2].val="0";
    zef_check(zir_verify_contracts(bad_attr).valid==0,
        "forged propagation attribute is rejected",&fail);
    let bad_origin:ZModule=zir_clone_module(authority.module);
    bad_origin.funcs.data[1].body.ops.data[pi].origin.exact=0;
    zef_check(zir_verify_contracts(bad_origin).valid==0,
        "inexact propagation origin is rejected",&fail);
    let invalid:CompilationUnit=parse_compilation_unit_dir(
        "fn calc(x:i32) i32 { let y:i32=try x; return y; }\n", ".");
    let invalid_eff:map.StringMap[i32]=analyze(invalid.decls);
    let invalid_ir:ZirAuthority=zir_prepare_production_with_origins(invalid.decls,invalid_eff,invalid.origins);
    zef_check(invalid_ir.coverage_complete==0&&invalid_ir.coverage_errors>0,
        "try outside an error return fails closed",&fail);
    _zag_println(_zag_str_concat("zir-error-flow pass=",_zag_i64_to_str((6-fail) as i64)));
    if(fail>0){return 1;}return 0;
}
