// Bounded typed semantic-region equality saturation for zagd.
@import("zagd.zag")
@import("script_auto.zag")
struct ZagdSaturationRegion { source:[]u8, expression:[]u8, bits:i32, variables:i32, valid:i32 }
struct ZagdSaturationResult { ok:i32, error:[]u8, generated:[]u8, proof_record:[]u8, source_identity:ZagdHash, cost:i32, candidates:i32, assignments:i32, work_bound:i64 }
fn zagd_saturation_bad_region()ZagdSaturationRegion{return ZagdSaturationRegion{.source="",.expression="",.bits=0,.variables=0,.valid=0};}
fn zagd_saturation_bad(message:[]u8)ZagdSaturationResult{return ZagdSaturationResult{.ok=0,.error=message,.generated="",.proof_record="",.source_identity=zagd_hash_empty(),.cost=0,.candidates=0,.assignments=0,.work_bound=0};}
fn zagd_saturation_type_bits(value:[]u8)i32{if(@strEq(value,"u1")){return 1;}if(@strEq(value,"u2")){return 2;}if(@strEq(value,"u3")){return 3;}if(@strEq(value,"u4")){return 4;}return 0;}
fn zagd_saturation_decimal(value:[]u8,maximum:i32)i32{if(value.len==0||value.len>2){return -1;}let out:i32=0;let i:i32=0;while(i<value.len){if(value[i]<'0'||value[i]>'9'){return -1;}out=out*10+((value[i] as i32)-48);if(out>maximum){return -1;}i=i+1;}return out;}
fn zagd_saturation_record_value(text:[]u8,key:[]u8)[]u8{let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>key.len&&@strEq(line[0..key.len],key)&&line[key.len]=='='){return line[key.len+1..line.len];}start=i+1;}i=i+1;}return "";}
fn zagd_saturation_single_field(text:[]u8,key:[]u8)i32{let count:i32=0;let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>key.len&&@strEq(line[0..key.len],key)&&line[key.len]=='='){count=count+1;}start=i+1;}i=i+1;}return (count==1) as i32;}
fn zagd_saturation_extract(text:[]u8)ZagdSaturationRegion{let bad:ZagdSaturationRegion=zagd_saturation_bad_region();if(text.len<1||text.len>1024||text[text.len-1]!='\n'){return bad;}if(zagd_saturation_single_field(text,"format")==0||zagd_saturation_single_field(text,"type")==0||zagd_saturation_single_field(text,"variables")==0||zagd_saturation_single_field(text,"effects")==0||zagd_saturation_single_field(text,"expr")==0){return bad;}let lines:i32=0;let i:i32=0;while(i<text.len){if(text[i]=='\n'){lines=lines+1;}i=i+1;}if(lines!=5||!@strEq(zagd_saturation_record_value(text,"format"),"zagd-typed-region-v1")||!@strEq(zagd_saturation_record_value(text,"effects"),"pure")){return bad;}let bits:i32=zagd_saturation_type_bits(zagd_saturation_record_value(text,"type"));let variables:i32=zagd_saturation_decimal(zagd_saturation_record_value(text,"variables"),2);let expression:[]u8=zagd_saturation_record_value(text,"expr");if(bits<1||variables<0||expression.len<1||expression.len>511){return bad;}return ZagdSaturationRegion{.source=text,.expression=expression,.bits=bits,.variables=variables,.valid=1};}
fn zagd_saturation_run(region:ZagdSaturationRegion,compiler:[]u8,target:[]u8,work_budget:i64)ZagdSaturationResult{if(region.valid!=1||compiler.len<1||target.len<1){return zagd_saturation_bad("invalid_region");}let config:ScriptAutoConfig=ScriptAutoConfig{.bits=region.bits,.variables=region.variables,.work_budget=work_budget,.source_id=region.source,.compiler_id=compiler,.target_id=target};let selected:ScriptAutoResult=script_auto_optimize(region.expression,config);if(selected.ok!=1){return zagd_saturation_bad(selected.error);}if(script_auto_verify_record(region.expression,config,selected.record)!=1){script_auto_result_free(&selected);return zagd_saturation_bad("proof_rejected");}let out:ZagdSaturationResult=ZagdSaturationResult{.ok=1,.error="",.generated=selected.generated,.proof_record=selected.record,.source_identity=zagd_content_hash(region.source),.cost=selected.cost,.candidates=selected.candidates,.assignments=selected.assignments,.work_bound=selected.work_bound};selected.generated="";selected.record="";script_auto_result_free(&selected);return out;}
fn zagd_saturation_result_free(result:*ZagdSaturationResult)void{if(result.*.generated.len>0){_zag_free(_zag_slice_ptr(result.*.generated));}if(result.*.proof_record.len>0){_zag_free(_zag_slice_ptr(result.*.proof_record));}result.*=zagd_saturation_bad("released");}
