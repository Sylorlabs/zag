// Exact-key profile ingestion and bounded backend-region planning.
// Profile data is advisory and can never authorize a semantic rewrite.
@import("zagd_store.zag")

struct ZagdProfileSample { region:[]u8, count:i64 }
struct ZagdProfile { samples:ArrayList[ZagdProfileSample], valid:i32 }
struct ZagdBackendFeatures { popcnt:i32, bmi1:i32, packed_simd:i32 }
struct ZagdBackendRegionPlan { region:[]u8, kind:i32, selected:i32, supported:i32, reason:[]u8 }

fn zagd_backend_none()i32{return 0;}
fn zagd_backend_popcnt()i32{return 1;}
fn zagd_backend_bmi1_andn()i32{return 2;}
fn zagd_backend_packed_simd()i32{return 3;}

fn zp_safe_region(s:[]u8)i32{if(s.len==0||s.len>128){return 0;}let i:i32=0;while(i<s.len){let c:u8=s[i];if(!((c>='a'&&c<='z')||(c>='A'&&c<='Z')||(c>='0'&&c<='9')||c=='_'||c=='.'||c=='-')){return 0;}i=i+1;}return 1;}
fn zp_line_value(line:[]u8,key:[]u8)[]u8{if(line.len>key.len&&@strEq(line[0..key.len],key)&&line[key.len]=='='){return line[key.len+1..];}return "";}
fn zp_checksum_valid(text:[]u8)i32{let marker:[]u8="checksum_first=";let mark:i32=0-1;let i:i32=0;while(i+marker.len<=text.len){if((i==0||text[i-1]=='\n')&&@strEq(text[i..i+marker.len],marker)){mark=i;}i=i+1;}if(mark<0){return 0;}let value:[]u8=zagd_record_value(text,"checksum_first");if(mark+marker.len+value.len+1!=text.len){return 0;}return (zagd_parse_nonnegative(value)==zagd_content_hash(text[0..mark]).first) as i32;}

// Required identity fields bind samples to one compiler/source/target. Unknown,
// stale, truncated, oversized, or malformed records are misses.
fn zagd_profile_decode(text:[]u8,compiler:ZagdHash,source:ZagdHash,target:ZagdHash,max_samples:i32)ZagdProfile{
    let out:ZagdProfile=ZagdProfile{.samples=make[ZagdProfileSample](4),.valid=0};if(max_samples<1||max_samples>4096||!@strEq(zagd_record_value(text,"format"),"zagd-profile-v1")||zagd_parse_nonnegative(zagd_record_value(text,"compiler_first"))!=compiler.first||zagd_parse_nonnegative(zagd_record_value(text,"compiler_second"))!=compiler.second||zagd_parse_nonnegative(zagd_record_value(text,"source_first"))!=source.first||zagd_parse_nonnegative(zagd_record_value(text,"source_second"))!=source.second||zagd_parse_nonnegative(zagd_record_value(text,"target_first"))!=target.first||zagd_parse_nonnegative(zagd_record_value(text,"target_second"))!=target.second||zp_checksum_valid(text)==0){return out;}
    let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];let value:[]u8=zp_line_value(line,"hot");if(value.len>0){let tab:i32=0-1;let j:i32=0;while(j<value.len){if(value[j]=='\t'){tab=j;}j=j+1;}if(tab<1||out.samples.len>=max_samples){return out;}let region:[]u8=value[0..tab];let count:i64=zagd_parse_nonnegative(value[tab+1..]);if(zp_safe_region(region)==0||count<=0){return out;}push[ZagdProfileSample](&out.samples,ZagdProfileSample{.region=region,.count=count});}start=i+1;}i=i+1;}out.valid=1;return out;
}

fn zp_before(a:ZagdProfileSample,b:ZagdProfileSample)i32{if(a.count>b.count){return 1;}if(a.count<b.count){return 0;}let n:i32=a.region.len;if(b.region.len<n){n=b.region.len;}let i:i32=0;while(i<n){if(a.region[i]<b.region[i]){return 1;}if(a.region[i]>b.region[i]){return 0;}i=i+1;}return (a.region.len<b.region.len) as i32;}
fn zagd_select_hot_regions(profile:ZagdProfile,budget:i32)ArrayList[ZagdProfileSample]{let out:ArrayList[ZagdProfileSample]=make[ZagdProfileSample](4);if(profile.valid==0||budget<1){return out;}let used:ArrayList[i32]=make[i32](profile.samples.len+1);let i:i32=0;while(i<profile.samples.len){push[i32](&used,0);i=i+1;}while(out.len<budget&&out.len<profile.samples.len){let best:i32=0-1;i=0;while(i<profile.samples.len){if(used.data[i]==0&&(best<0||zp_before(profile.samples.data[i],profile.samples.data[best])==1)){best=i;}i=i+1;}if(best<0){break;}used.data[best]=1;push[ZagdProfileSample](&out,profile.samples.data[best]);}free[i32](&used);return out;}

// Only optional instructions already emitted and tested by ncodegen may become
// selected plans. Packed SIMD is recorded as unsupported until a packed encoder
// and differential tests exist; CPUID alone never selects it.
fn zagd_backend_plan(hot:ArrayList[ZagdProfileSample],features:ZagdBackendFeatures)ArrayList[ZagdBackendRegionPlan]{let out:ArrayList[ZagdBackendRegionPlan]=make[ZagdBackendRegionPlan](hot.len+1);let i:i32=0;while(i<hot.len){let r:[]u8=hot.data[i].region;if(@strEq(r,"popcount")){push[ZagdBackendRegionPlan](&out,ZagdBackendRegionPlan{.region=r,.kind=zagd_backend_popcnt(),.selected=features.popcnt,.supported=features.popcnt,.reason="implemented POPCNT lowering"});}else if(@strEq(r,"andn")){push[ZagdBackendRegionPlan](&out,ZagdBackendRegionPlan{.region=r,.kind=zagd_backend_bmi1_andn(),.selected=features.bmi1,.supported=features.bmi1,.reason="implemented BMI1 ANDN lowering"});}else if(@strEq(r,"simd-packed")){push[ZagdBackendRegionPlan](&out,ZagdBackendRegionPlan{.region=r,.kind=zagd_backend_packed_simd(),.selected=0,.supported=0,.reason="packed SIMD encoder not implemented"});}else{push[ZagdBackendRegionPlan](&out,ZagdBackendRegionPlan{.region=r,.kind=zagd_backend_none(),.selected=0,.supported=0,.reason="no validated backend candidate"});}i=i+1;}return out;}
