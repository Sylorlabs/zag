// Bounded offline package registry authority for ZagScript 1.0.
// Entries are canonical, authenticated with HMAC-SHA256 under an explicit
// trust key, selected deterministically, and closed transitively with bounds.
@import("native/macho_arm64.zag")

struct PackageRegistryEntry {
    name: []u8,
    major: i32,
    minor: i32,
    patch: i32,
    root: []u8,
    digest: []u8,
    deps: []u8,
    signature: []u8,
    valid: i32,
}
struct PackageRegistry { entries: ArrayList[PackageRegistryEntry], valid: i32 }
struct PackageRegistryClosure { indices: ArrayList[i32], valid: i32 }

fn package_registry_text(out: *ArrayList[u8], text: []u8) void {
    let i: i32 = 0;
    while (i < text.len) { push[u8](out, text[i]); i = i + 1; }
}
fn package_registry_number(out: *ArrayList[u8], value: i32) void {
    let text: []u8 = _zag_i64_to_str(value as i64);
    package_registry_text(out, text); _zag_str_free(text);
}
fn package_registry_field(text: []u8, want: i32, separator: u8) []u8 {
    let field: i32 = 0; let start: i32 = 0; let i: i32 = 0;
    while (i <= text.len) {
        if (i == text.len || text[i] == separator) {
            if (field == want) { return text[start..i]; }
            field = field + 1; start = i + 1;
        }
        i = i + 1;
    }
    return "";
}
fn package_registry_fields_exact(text: []u8, count: i32, separator: u8) i32 {
    let fields: i32 = 1; let i: i32 = 0;
    while (i < text.len) { if (text[i] == separator) { fields = fields + 1; } i = i + 1; }
    return (fields == count) as i32;
}
fn package_registry_uint(text: []u8) i32 {
    if (text.len == 0 || text.len > 4 || (text.len > 1 && text[0] == '0')) { return 0 - 1; }
    let value: i32 = 0; let i: i32 = 0;
    while (i < text.len) {
        if (text[i] < '0' || text[i] > '9') { return 0 - 1; }
        value = value * 10 + ((text[i] as i32) - 48);
        if (value > 9999) { return 0 - 1; }
        i = i + 1;
    }
    return value;
}
fn package_registry_name_ok(name: []u8) i32 {
    if (name.len < 1 || name.len > 64) { return 0; }
    let i: i32 = 0;
    while (i < name.len) {
        let c: u8 = name[i];
        if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
            (c >= '0' && c <= '9') || c == '_' || c == '-')) { return 0; }
        i = i + 1;
    }
    return 1;
}
fn package_registry_root_ok(root: []u8) i32 {
    if (root.len < 8 || root.len > 512 || root.len < 7 ||
        !@strEq(root[0..7], "vendor/") || root[root.len - 1] == '/') { return 0; }
    let start: i32 = 0; let i: i32 = 0;
    while (i <= root.len) {
        if (i == root.len || root[i] == '/') {
            let segment: []u8 = root[start..i];
            if (segment.len == 0 || @strEq(segment, ".") || @strEq(segment, "..")) { return 0; }
            let j: i32 = 0;
            while (j < segment.len) {
                let c: u8 = segment[j];
                if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
                    (c >= '0' && c <= '9') || c == '_' || c == '-' || c == '.')) { return 0; }
                j = j + 1;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return 1;
}
fn package_registry_hex_ok(text: []u8) i32 {
    if (text.len != 64) { return 0; }
    let i: i32 = 0;
    while (i < text.len) {
        let c: u8 = text[i];
        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) { return 0; }
        i = i + 1;
    }
    return 1;
}
fn package_registry_dep_ok(dep: []u8) i32 {
    let at: i32 = 0;
    while (at < dep.len && dep[at] != '@') { at = at + 1; }
    return (at > 0 && at < dep.len - 1 && package_registry_name_ok(dep[0..at]) == 1 &&
        package_registry_uint(dep[at + 1..dep.len]) >= 0) as i32;
}
fn package_registry_deps_ok(deps: []u8) i32 {
    if (@strEq(deps, "-")) { return 1; }
    if (deps.len < 3 || deps.len > 512) { return 0; }
    let position: i32 = 0; let count: i32 = 0;
    while (position <= deps.len) {
        let end: i32 = position;
        while (end < deps.len && deps[end] != ',') { end = end + 1; }
        if (package_registry_dep_ok(deps[position..end]) == 0) { return 0; }
        count = count + 1; if (count > 16) { return 0; }
        if (end >= deps.len) { position = deps.len + 1; } else { position = end + 1; }
    }
    return 1;
}
fn package_registry_basis(entry: PackageRegistryEntry) ArrayList[u8] {
    let out: ArrayList[u8] = make[u8](768);
    package_registry_text(&out, entry.name); push[u8](&out, '|');
    package_registry_number(&out, entry.major); push[u8](&out, '|');
    package_registry_number(&out, entry.minor); push[u8](&out, '|');
    package_registry_number(&out, entry.patch); push[u8](&out, '|');
    package_registry_text(&out, entry.root); push[u8](&out, '|');
    package_registry_text(&out, entry.digest); push[u8](&out, '|');
    package_registry_text(&out, entry.deps); return out;
}
fn package_registry_hmac(key: []u8, message: []u8) ArrayList[u8] {
    let bad: ArrayList[u8] = make[u8](0);
    if (key.len < 1 || key.len > 64 || message.len > 4096) { return bad; }
    let block: ArrayList[u8] = make[u8](64); let i: i32 = 0;
    while (i < 64) { push[u8](&block, 0); i = i + 1; }
    i = 0; while (i < key.len) { set[u8](&block, i, key[i]); i = i + 1; }
    let inner: ArrayList[u8] = make[u8](64 + message.len); i = 0;
    while (i < 64) { push[u8](&inner, (get[u8](block, i) ^ 54) as u8); i = i + 1; }
    i = 0; while (i < message.len) { push[u8](&inner, message[i]); i = i + 1; }
    let inner_hash: ArrayList[u8] = macho_sha256(inner.data[0..inner.len]);
    let outer: ArrayList[u8] = make[u8](96); i = 0;
    while (i < 64) { push[u8](&outer, (get[u8](block, i) ^ 92) as u8); i = i + 1; }
    i = 0; while (i < inner_hash.len) { push[u8](&outer, get[u8](inner_hash, i)); i = i + 1; }
    let result: ArrayList[u8] = macho_sha256(outer.data[0..outer.len]);
    free[u8](&outer); free[u8](&inner_hash); free[u8](&inner); free[u8](&block); return result;
}
fn package_registry_hex(bytes: ArrayList[u8]) ArrayList[u8] {
    let out: ArrayList[u8] = make[u8](bytes.len * 2); let alphabet: []u8 = "0123456789abcdef"; let i: i32 = 0;
    while (i < bytes.len) { let b: u8 = get[u8](bytes, i); push[u8](&out, alphabet[(b / 16) as i32]); push[u8](&out, alphabet[(b % 16) as i32]); i = i + 1; }
    return out;
}
fn package_registry_equal(a: ArrayList[u8], b: []u8) i32 {
    if (a.len != b.len) { return 0; } let difference: i32 = 0; let i: i32 = 0;
    while (i < a.len) { difference = difference | ((get[u8](a, i) ^ b[i]) as i32); i = i + 1; }
    return (difference == 0) as i32;
}
fn package_registry_signature_valid(entry: PackageRegistryEntry, key: []u8) i32 {
    let basis: ArrayList[u8] = package_registry_basis(entry);
    let mac: ArrayList[u8] = package_registry_hmac(key, basis.data[0..basis.len]);
    let hex: ArrayList[u8] = package_registry_hex(mac);
    let ok: i32 = package_registry_equal(hex, entry.signature);
    free[u8](&hex); free[u8](&mac); free[u8](&basis); return ok;
}
fn package_registry_compare(a: []u8, b: []u8) i32 {
    let length: i32 = a.len; if (b.len < length) { length = b.len; }
    let i: i32 = 0; while (i < length) { if (a[i] < b[i]) { return 0 - 1; } if (a[i] > b[i]) { return 1; } i = i + 1; }
    if (a.len < b.len) { return 0 - 1; } if (a.len > b.len) { return 1; } return 0;
}
fn package_registry_after(a: PackageRegistryEntry, b: PackageRegistryEntry) i32 {
    let order: i32 = package_registry_compare(a.name, b.name);
    if (order != 0) { return (order > 0) as i32; }
    if (a.major != b.major) { return (a.major > b.major) as i32; }
    if (a.minor != b.minor) { return (a.minor > b.minor) as i32; }
    return (a.patch > b.patch) as i32;
}
fn package_registry_parse(text: []u8, key: []u8) PackageRegistry {
    let out: PackageRegistry = PackageRegistry{ .entries=make[PackageRegistryEntry](16), .valid=0 };
    if (text.len < 32 || text.len > 1048576 || text[text.len - 1] != '\n') { return out; }
    let header_end: i32 = 0; while (header_end < text.len && text[header_end] != '\n') { header_end = header_end + 1; }
    if (header_end >= text.len || !@strEq(text[0..header_end], "format=zag-offline-registry-v1")) { return out; }
    let position: i32 = header_end + 1; let previous: PackageRegistryEntry = PackageRegistryEntry{ .name="",.major=0,.minor=0,.patch=0,.root="",.digest="",.deps="",.signature="",.valid=0 }; let have_previous: i32 = 0;
    while (position < text.len) {
        let end: i32 = position; while (end < text.len && text[end] != '\n') { end = end + 1; }
        if (end >= text.len) { return out; } let line: []u8 = text[position..end];
        if (line.len < 9 || !@strEq(line[0..8], "package=")) { return out; }
        let body: []u8 = line[8..line.len]; if (package_registry_fields_exact(body, 8, '\t') == 0) { return out; }
        let entry: PackageRegistryEntry = PackageRegistryEntry{
            .name=package_registry_field(body,0,'\t'), .major=package_registry_uint(package_registry_field(body,1,'\t')),
            .minor=package_registry_uint(package_registry_field(body,2,'\t')), .patch=package_registry_uint(package_registry_field(body,3,'\t')),
            .root=package_registry_field(body,4,'\t'), .digest=package_registry_field(body,5,'\t'), .deps=package_registry_field(body,6,'\t'),
            .signature=package_registry_field(body,7,'\t'), .valid=1 };
        if (package_registry_name_ok(entry.name)==0 || entry.major<0 || entry.minor<0 || entry.patch<0 ||
            package_registry_root_ok(entry.root)==0 || package_registry_hex_ok(entry.digest)==0 || package_registry_deps_ok(entry.deps)==0 ||
            package_registry_hex_ok(entry.signature)==0 || package_registry_signature_valid(entry,key)==0) { return out; }
        if (have_previous==1 && package_registry_after(entry,previous)==0) { return out; }
        if (out.entries.len>=256) { return out; } push[PackageRegistryEntry](&out.entries,entry); previous=entry; have_previous=1; position=end+1;
    }
    if (out.entries.len<1) { return out; } out.valid=1; return out;
}
fn package_registry_release(registry:*PackageRegistry)void{free[PackageRegistryEntry](&registry.*.entries);registry.*.valid=0;}
fn package_registry_select(registry:PackageRegistry,name:[]u8,major:i32)i32 {
    if(registry.valid!=1||package_registry_name_ok(name)==0||major<0){return -1;}let best:i32=-1;let i:i32=0;
    while(i<registry.entries.len){let entry:PackageRegistryEntry=registry.entries.data[i];if(@strEq(entry.name,name)&&entry.major==major){if(best<0||entry.minor>registry.entries.data[best].minor||(entry.minor==registry.entries.data[best].minor&&entry.patch>registry.entries.data[best].patch)){best=i;}}i=i+1;}return best;
}
fn package_registry_closure(registry:PackageRegistry,name:[]u8,major:i32)PackageRegistryClosure {
    let out:PackageRegistryClosure=PackageRegistryClosure{.indices=make[i32](16),.valid=0};let first:i32=package_registry_select(registry,name,major);if(first<0){return out;}push[i32](&out.indices,first);let cursor:i32=0;
    while(cursor<out.indices.len){if(out.indices.len>64){return out;}let entry:PackageRegistryEntry=registry.entries.data[out.indices.data[cursor]];if(!@strEq(entry.deps,"-")){let position:i32=0;while(position<=entry.deps.len){let end:i32=position;while(end<entry.deps.len&&entry.deps[end]!=','){end=end+1;}let item:[]u8=entry.deps[position..end];let at:i32=0;while(at<item.len&&item[at]!='@'){at=at+1;}let dep_name:[]u8=item[0..at];let dep_major:i32=package_registry_uint(item[at+1..item.len]);let found:i32=package_registry_select(registry,dep_name,dep_major);if(found<0){return out;}let seen:i32=0;let i:i32=0;while(i<out.indices.len){let selected:PackageRegistryEntry=registry.entries.data[out.indices.data[i]];if(@strEq(selected.name,dep_name)){if(out.indices.data[i]!=found){return out;}seen=1;}i=i+1;}if(seen==0){push[i32](&out.indices,found);}if(end>=entry.deps.len){position=entry.deps.len+1;}else{position=end+1;}}}cursor=cursor+1;}out.valid=1;return out;
}
fn package_registry_closure_release(value:*PackageRegistryClosure)void{free[i32](&value.*.indices);value.*.valid=0;}
