@import("fmt.zag")
@import("astjson.zag")
@import("semantic_manifest.zag")

fn rc_has(text:[]u8,needle:[]u8)i32{
    let i:i32=0;while(i+needle.len<=text.len){let j:i32=0;while(j<needle.len&&text[i+j]==needle[j]){j=j+1;}if(j==needle.len){return 1;}i=i+1;}return 0;
}
fn rc_annots_has(items:ArrayList[[]u8],want:[]u8)i32{
    let i:i32=0;while(i<len[[]u8](items)){if(@strEq(get[[]u8](items,i),want)){return 1;}i=i+1;}return 0;
}
fn rc_check(ok:i32,label:[]u8,fail:*i32)void{
    if(ok==0){_zag_println(_zag_str_concat("resource syntax FAIL: ",label));fail.*=fail.*+1;}
}
fn rc_layout_identity(src:[]u8)ZagdHash{
    let decls:ArrayList[*Node]=parse_program(src);let out:ZagdHash=zagd_hash_empty();let i:i32=0;
    while(i<len[*Node](decls)){switch(get[*Node](decls,i).*){.struct_=>|s|{if(s.is_pub==1){
        let shape:[]u8=_zag_str_concat(sm_resource_struct_prefix(s),"struct ");
        if(s.repr_c==1){shape=_zag_str_concat(sm_resource_struct_prefix(s),"@repr(C) struct ");}
        shape=_zag_str_concat(shape,_zag_str_concat(s.name,sm_type_params_text(s.tparams)));
        let j:i32=0;while(j<len[Param](s.fields)){shape=_zag_str_concat(shape,_zag_str_concat("|",sm_param_text(get[Param](s.fields,j))));j=j+1;}
        out=sm_add(out,shape);
    }}else=>{}}i=i+1;}return out;
}
fn rc_public_identity(src:[]u8)ZagdHash{
    let decls:ArrayList[*Node]=parse_program(src);let out:ZagdHash=zagd_hash_empty();let i:i32=0;
    while(i<len[*Node](decls)){switch(get[*Node](decls,i).*){.fn_decl=>|f|{if(f.is_pub==1){
        let sig:[]u8=_zag_str_concat("fn ",_zag_str_concat(f.name,sm_type_params_text(f.tparams)));
        let j:i32=0;while(j<len[Param](f.params)){sig=_zag_str_concat(sig,_zag_str_concat("|",sm_param_text(get[Param](f.params,j))));j=j+1;}
        sig=_zag_str_concat(sig,_zag_str_concat("->",_zag_str_concat(f.ret,_zag_str_concat("!",f.ret_eff))));
        sig=_zag_str_concat(sig,sm_resource_fn_contract(f));out=sm_add(out,sig);
    }}else=>{}}i=i+1;}return out;
}

fn main()i32{
    let fail:i32=0;
    let source:[]u8="@metadata(outer(inner,2)) @resource pub struct ResourceBox[T] { payload:@owned(release_box) *T, count:i32 } pub fn release_box[T](value:*T) void { } pub extern fn acquire(backing:@retained_by_return []u8) ?*ResourceBox[u8] @cabi @acquires(release_box);";
    let decls:ArrayList[*Node]=parse_program(source);
    let saw_resource:i32=0;let saw_acquire:i32=0;let i:i32=0;
    while(i<len[*Node](decls)){switch(get[*Node](decls,i).*){
        .struct_=>|s|{if(@strEq(s.name,"ResourceBox")){
            saw_resource=1;rc_check((len[[]u8](s.tparams)==1&&@strEq(get[[]u8](s.tparams,0),"T")) as i32,"generic type parameters were not retained",&fail);
            rc_check(rc_annots_has(s.annots,"@resource"),"@resource missing from StructDecl.annots",&fail);
            rc_check(rc_annots_has(s.annots,"@metadata(outer(inner,2))"),"balanced declaration annotation was not canonicalized",&fail);
            rc_check((len[Param](s.fields)==2&&@strEq(get[Param](s.fields,0).contract,"@owned(release_box)")) as i32,"@owned relation missing from field contract",&fail);
        }}
        .fn_decl=>|f|{if(@strEq(f.name,"acquire")){
            saw_acquire=1;rc_check((len[Param](f.params)==1&&@strEq(get[Param](f.params,0).contract,"@retained_by_return")) as i32,"retained backing parameter contract missing",&fail);
            rc_check(rc_annots_has(f.annots,"@acquires(release_box)"),"@acquires relation missing from FnDecl.annots",&fail);
        }}
        else=>{}
    }i=i+1;}
    rc_check(saw_resource*saw_acquire,"resource declarations were not parsed",&fail);

    let formatted:ArrayList[u8]=fmt_program(source);let formatted_text:[]u8=formatted.data[0..formatted.len];
    rc_check(rc_has(formatted_text,"@metadata(outer(inner,2))\n@resource\npub struct ResourceBox[T]"),"formatter lost canonical resource/generic declaration metadata",&fail);
    rc_check(rc_has(formatted_text,"payload: @owned(release_box) *T"),"formatter lost owned field relation",&fail);
    rc_check(rc_has(formatted_text,"backing: @retained_by_return []u8"),"formatter lost retained parameter relation",&fail);
    rc_check(rc_has(formatted_text,"@acquires(release_box)"),"formatter lost acquiring return relation",&fail);
    let reformatted:ArrayList[u8]=fmt_program(formatted_text);
    rc_check(@strEq(formatted_text,reformatted.data[0..reformatted.len]) as i32,"resource formatting is not idempotent",&fail);

    let json:ArrayList[u8]=ast_json(source);let json_text:[]u8=json.data[0..json.len];
    rc_check(rc_has(json_text,"\"annots\": [\"@metadata(outer(inner,2))\", \"@resource\"]"),"AST JSON lost resource struct annotations",&fail);
    rc_check(rc_has(json_text,"\"contract\": \"@owned(release_box)\""),"AST JSON lost owned field relation",&fail);
    rc_check(rc_has(json_text,"\"contract\": \"@retained_by_return\""),"AST JSON lost retained parameter relation",&fail);
    rc_check(rc_has(json_text,"\"@acquires(release_box)\""),"AST JSON lost acquiring function relation",&fail);

    let names:ArrayList[[]u8]=collect_decl_names(decls);let private_names:ArrayList[[]u8]=make[[]u8](0);i=0;let qualified_resource:i32=0;let qualified_acquire:i32=0;
    while(i<len[*Node](decls)){let q:*Node=qualify_decl(get[*Node](decls,i),names,private_names,"kit",0);switch(q.*){
        .struct_=>|s|{if(@strEq(s.name,"kit__ResourceBox")){qualified_resource=(@strEq(get[Param](s.fields,0).contract,"@owned(kit__release_box)")) as i32;}}
        .fn_decl=>|f|{if(@strEq(f.name,"acquire")){qualified_acquire=(f.is_extern==1&&rc_annots_has(f.annots,"@acquires(kit__release_box)")) as i32;}}
        else=>{}
    }i=i+1;}
    rc_check(qualified_resource,"qualified import left a stale local field-release relation",&fail);
    rc_check(qualified_acquire,"qualified import changed the FFI name or left a stale acquire-release relation",&fail);
    rc_check(@strEq(q_resource_relation("@owned(_zag_free)",names,"kit"),"@owned(_zag_free)") as i32,"runtime/extern release relation was incorrectly qualified",&fail);

    let resource_layout:ZagdHash=rc_layout_identity("@resource pub struct Box[T] { ptr:@owned(release_box) *T }");
    let plain_layout:ZagdHash=rc_layout_identity("pub struct Box[T] { ptr:*T }");
    let other_release_layout:ZagdHash=rc_layout_identity("@resource pub struct Box[T] { ptr:@owned(release_other) *T }");
    rc_check((zagd_hash_equal(resource_layout,plain_layout)==0) as i32,"@resource/@owned missing from layout identity",&fail);
    rc_check((zagd_hash_equal(resource_layout,other_release_layout)==0) as i32,"field release relation missing from layout identity",&fail);
    let acquire_identity:ZagdHash=rc_public_identity("pub fn release_box(p:*u8) void { } pub fn release_other(p:*u8) void { } pub extern fn acquire(backing:@retained_by_return []u8) ?*u8 @acquires(release_box);");
    let acquire_other_identity:ZagdHash=rc_public_identity("pub fn release_box(p:*u8) void { } pub fn release_other(p:*u8) void { } pub extern fn acquire(backing:@retained_by_return []u8) ?*u8 @acquires(release_other);");
    let acquire_unretained_identity:ZagdHash=rc_public_identity("pub fn release_box(p:*u8) void { } pub fn release_other(p:*u8) void { } pub extern fn acquire(backing:[]u8) ?*u8 @acquires(release_box);");
    rc_check((zagd_hash_equal(acquire_identity,acquire_other_identity)==0) as i32,"@acquires relation missing from public identity",&fail);
    rc_check((zagd_hash_equal(acquire_identity,acquire_unretained_identity)==0) as i32,"@retained_by_return missing from public identity",&fail);

    // Resource affinity propagates through plain and generic value wrappers.
    // Pointer boundaries remain non-owning, and slot expansion stops at the
    // explicit @owned terminal rather than counting both wrapper and payload.
    let structural:ArrayList[*Node]=parse_program("fn release_leaf(p:*u8)void{} @resource struct Leaf { data:@owned(release_leaf) *u8 } struct Wrapper { leaf:Leaf } struct Generic[T] { value:T }");
    rc_check(zt_resource_type("Wrapper",structural),"plain wrapper lost nested resource affinity",&fail);
    rc_check(zt_resource_type("Generic[Leaf]",structural),"generic wrapper lost substituted resource affinity",&fail);
    rc_check((zt_resource_type("*Wrapper",structural)==0) as i32,"pointer boundary incorrectly became an owned resource value",&fail);
    let resource_flow:ZTResFlow=zt_res_flow_new(2);let resource_arena:ArrayList[ZTAggPathNode]=make[ZTAggPathNode](4);
    zt_res_add_type_slots(&resource_flow,zt_agg_root_path("wrapped"),"Generic[Wrapper]",1,structural,&resource_arena);
    rc_check((resource_flow.slots.len==1&&@strEq(resource_flow.slots.data[0].release,"release_leaf")) as i32,"nested structural wrapper did not expand to exactly one owned terminal",&fail);
    zt_res_flow_free(&resource_flow);free[ZTAggPathNode](&resource_arena);

    let observe_source:[]u8="extern fn release_leaf(p:@consumes *u8)void; @resource struct Leaf { data:@owned(release_leaf) *u8 } struct Wrapper { leaf:Leaf } fn observe(value:Wrapper)i32{return 1;} fn dispose(value:@consumes Wrapper)void{release_leaf(value.leaf.data);}";
    let observe_decls:ArrayList[*Node]=parse_program(observe_source);
    rc_check((zt_param_borrow_mode(observe_decls,"observe",0)==1) as i32,"structural by-value parameter did not default to shared observation",&fail);
    rc_check((zt_consumes_param(observe_decls,"dispose",0)==1) as i32,"explicit structural @consumes parameter did not transfer ownership",&fail);
    rc_check((zt_check_resource_flows(observe_decls)==0) as i32,"shared observation or explicit structural consume failed resource flow",&fail);
    let returned:ArrayList[*Node]=parse_program(_zag_str_concat(observe_source," fn escape(value:Wrapper)Wrapper{return value;}"));
    rc_check((zt_check_resource_flows(returned)>0) as i32,"unannotated structural observation escaped through return",&fail);
    let stored:ArrayList[*Node]=parse_program(_zag_str_concat(observe_source," struct Holder { item:Wrapper } fn store(out:*Holder,value:Wrapper)void{out.*.item=value;}"));
    rc_check((zt_check_resource_flows(stored)>0) as i32,"unannotated structural observation escaped through store",&fail);

    let siblings:ArrayList[*Node]=parse_program("extern fn release_leaf(p:@consumes *u8)void; @resource struct Pair { left:@owned(release_leaf) *u8, right:@owned(release_leaf) *u8 } fn destroy(value:@consumes *Pair)i32{release_leaf(value.*.left);let live:i32=(value.*.right!=null) as i32;release_leaf(value.*.right);return live;}");
    rc_check((zt_check_resource_flows(siblings)==0) as i32,"releasing one resource field invalidated a live sibling field",&fail);

    let wrapped_return:ArrayList[*Node]=parse_program("extern fn release_leaf(p:@consumes *u8)void; @resource struct Leaf { data:@owned(release_leaf) *u8 } struct Result { leaf:Leaf, code:i32 } fn wrap(value:@consumes Leaf)Result @returns_owner{return Result{.leaf=value,.code=0};}");
    let wrapped_summaries:ArrayList[ZTOwnSummary]=zt_build_owner_summaries(wrapped_return);
    rc_check((zt_owner_summary_return_param(wrapped_summaries,"wrap")==0&&zt_check_owner_summary_errors(wrapped_return,wrapped_summaries)==0) as i32,"aggregate @returns_owner did not preserve its unique consumed root",&fail);
    free[ZTOwnSummary](&wrapped_summaries);
    let conflicting_return:ArrayList[*Node]=parse_program("extern fn release_leaf(p:@consumes *u8)void; @resource struct Leaf { data:@owned(release_leaf) *u8 } struct Pair { left:Leaf, right:Leaf } fn bad(left:@consumes Leaf,right:@consumes Leaf)Pair @returns_owner{return Pair{.left=left,.right=right};}");
    let conflicting_summaries:ArrayList[ZTOwnSummary]=zt_build_owner_summaries(conflicting_return);
    rc_check((zt_check_owner_summary_errors(conflicting_return,conflicting_summaries)>0) as i32,"aggregate @returns_owner accepted conflicting consumed roots",&fail);
    free[ZTOwnSummary](&conflicting_summaries);
    rc_check((zt_legacy_allocation_consumes_param(siblings,"destroy",0)==0) as i32,"legacy whole-owner flow retained a structural resource destructor parameter",&fail);

    // Imported runtime declarations carry the `module___symbol` spelling;
    // allocation authority must recognize that exact separator but reject a
    // user helper that merely shares the `_zag_malloc` suffix.
    rc_check(zt_qualified_runtime_ends("rt___zag_malloc","_zag_malloc"),"qualified runtime allocator name was not recognized",&fail);
    rc_check((zt_qualified_runtime_ends("user_zag_malloc","_zag_malloc")==0) as i32,"unqualified suffix acquired runtime allocator authority",&fail);
    let qualified_alloc:ArrayList[*Node]=parse_program("extern fn rt___zag_malloc(n:i32)*i8 @alloc; @resource struct List[T] { data:@owned(_zag_free) *T, len:i32, cap:i32 } fn make[T]()List[T]{let raw:*i8=rt___zag_malloc(8);return List[T]{.data=raw as *T,.len=0,.cap=1};}");
    rc_check((zt_check_resource_flows(qualified_alloc)==0) as i32,"qualified runtime allocation did not initialize the owned list field",&fail);



    if(fail==0){_zag_println("resource syntax: 39/39");}return fail;
}
