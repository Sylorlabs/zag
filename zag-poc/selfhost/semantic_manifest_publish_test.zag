@import("parse.zag")
@import("sema.zag")
@import("semantic_manifest_publish.zag")
extern fn _zag_read_file(path:[]u8)[]u8
// The publisher normally obtains this target predicate from the compiler
// driver. Standalone native coverage supplies the exact macOS branch directly.
fn macos_arm64_target()i32{return 1;}
fn main()i32{
    if(smp_valid_startup_cwd("/")==0||smp_valid_startup_cwd("/tmp/zag project")==0||
       smp_valid_startup_cwd("relative")==1||smp_valid_startup_cwd("/tmp/../escape")==1||
       smp_valid_startup_cwd("/tmp//double")==1||smp_valid_startup_cwd("/tmp/bad\npath")==1){return 8;}
    let root:[]u8="/tmp/zag-semantic-publish-test";smp_mkdir(root);
    let src:[]u8="pub fn api(x:i32) i32 { return x; }";
    let u:CompilationUnit=parse_compilation_unit_dir(src,".");
    let e:map.StringMap[i32]=analyze(u.decls);
    if(semantic_manifest_publish(root,"app.zag",src,u,e)==0){return 1;}
    let text:[]u8=_zag_read_file(_zag_str_concat(root,"/.zag-cache/zagd/semantic.record"));
    if(semantic_manifest_decode(text).valid==0||!@strEq(smf_value(text,"detail_level"),"full")){return 2;}
    let publish_cwd:[]u8=smp_cwd();
    let mac_paths_ok:i32=(publish_cwd.len>1&&publish_cwd[0]=='/'&&
        sm_text_has(text,"module_node=app.zag\t")) as i32;
    if(mac_paths_ok==0){_zag_str_free(publish_cwd);return 6;}
    // A nested compiler invocation must be able to turn lexical parser paths
    // into stable project-relative graph nodes. Returning `.` on Darwin made
    // `znc suggest` reject an otherwise valid record as a stale module graph.
    let nested_root:[]u8=_zag_str_concat(publish_cwd,"/nested-project");
    let nested_input:[]u8=_zag_str_concat(nested_root,"/src/deep/lib.zag");
    let nested_node:[]u8=sm_project_graph_path("src/deep/app.zag",nested_input,
        publish_cwd,nested_root);
    let nested_ok:i32=@strEq(nested_node,"src/deep/lib.zag") as i32;
    sm_project_graph_path_free(nested_input,publish_cwd,nested_root,nested_node);
    _zag_str_free(nested_input);_zag_str_free(nested_root);
    _zag_str_free(publish_cwd);if(nested_ok==0){return 7;}

    // Cross the merged-source threshold without adding expression complexity.
    // The selected record must remain an exact compact graph rather than the
    // former incomplete memory-ceiling summary.
    let large:ArrayList[u8]=make[u8](524289);let i:i32=0;while(i<524289){push[u8](&large,' ');i=i+1;}
    push[ResolvedModule](&u.modules,ResolvedModule{.path="large.zag",.source=large.data[0..large.len]});
    let bounded:[]u8=smp_bounded_manifest(root,"app.zag",src,u,e);
    let path_base:[]u8=smp_cwd();
    let expected:*SemanticManifest=semantic_manifest_build_compact_published("app.zag",src,u.profile,u.decls,e,u.modules,u.imports,u.resources,path_base,root);
    let large_path:[]u8=sm_project_graph_path("app.zag","large.zag",path_base,root);
    let large_node:[]u8=_zag_str_concat("module_node=",_zag_str_concat(large_path,"\t"));
    let view:SemanticManifestView=semantic_manifest_decode(bounded);
    if(view.valid==0||view.graph_complete!=1||!@strEq(smf_value(bounded,"detail_level"),"compact")){return 3;}
    if(zagd_hash_equal(view.graph_identity,semantic_manifest_decode(expected.*.text).graph_identity)==0){return 4;}
    if(!sm_text_has(bounded,large_node)||sm_text_has(bounded,"expr_fact=")||bounded.len>8388608){return 5;}
    sm_project_graph_path_free("large.zag",path_base,root,large_path);
    if(path_base.len>0){_zag_str_free(path_base);}
    free[u8](&large);
    _zag_println("semantic manifest publish: pass=9 fail=0");return 0;
}
