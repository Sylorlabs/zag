@import("parse.zag")
@import("sema.zag")
@import("semantic_manifest_publish.zag")
extern fn _zag_read_file(path:[]u8)[]u8
fn main()i32{let root:[]u8="/tmp/zag-semantic-publish-test";smp_mkdir(root);let src:[]u8="pub fn api(x:i32) i32 { return x; }";let u:CompilationUnit=parse_compilation_unit_dir(src,".");let e:map.StringMap[i32]=analyze(u.decls);if(semantic_manifest_publish(root,"app.zag",src,u.profile,u.decls,e)==0){return 1;}let text:[]u8=_zag_read_file(_zag_str_concat(root,"/.zag-cache/zagd/semantic.record"));if(semantic_manifest_decode(text).valid==0){return 2;}_zag_println("semantic manifest publish: pass=2 fail=0");return 0;}
