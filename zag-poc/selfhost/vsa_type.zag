// Canonical binary-VSA type authority shared by semantic and backend passes.
// A valid spelling is exactly vsa_b<N>, where N is a canonical positive base-10
// integer. The implementation ceiling bounds compiler work and native frame
// size; it is not a fixed set of supported dimensions.

fn vsa_type_prefix(t: []u8) i32 {
    if (t.len < 8) { return 0; }
    return (t[0] == 'v' && t[1] == 's' && t[2] == 'a' && t[3] == '_' &&
        t[4] == 'b' && t[5] == '<') as i32;
}

fn vsa_type_max_dimension() i32 { return 1048576; }

// Returns -1 for malformed/out-of-range spellings.
fn vsa_type_dimension(t: []u8) i32 {
    if (vsa_type_prefix(t) == 0 || t[t.len - 1] != '>') { return 0 - 1; }
    let i: i32 = 6;
    if (i >= t.len - 1) { return 0 - 1; }
    // Canonical decimal: no leading zero and no separators/signs.
    if (t[i] == '0') { return 0 - 1; }
    let value: i32 = 0;
    while (i < t.len - 1) {
        let c: u8 = t[i];
        if (c < '0' || c > '9') { return 0 - 1; }
        let digit: i32 = (c as i32) - 48;
        if (value > (vsa_type_max_dimension() - digit) / 10) { return 0 - 1; }
        value = value * 10 + digit;
        i = i + 1;
    }
    if (value < 1 || value > vsa_type_max_dimension()) { return 0 - 1; }
    return value;
}

fn vsa_type_valid(t: []u8) i32 {
    return (vsa_type_dimension(t) > 0) as i32;
}

fn vsa_type_words(t: []u8) i32 {
    let dimension: i32 = vsa_type_dimension(t);
    if (dimension < 1) { return 0; }
    return (dimension + 63) / 64;
}

fn vsa_type_final_bits(t: []u8) i32 {
    let dimension: i32 = vsa_type_dimension(t);
    if (dimension < 1) { return 0; }
    let bits: i32 = dimension % 64;
    if (bits == 0) { return 64; }
    return bits;
}

fn vsa_type_final_mask(t: []u8) i64 {
    let bits: i32 = vsa_type_final_bits(t);
    if (bits == 64) { return 0 - 1; }
    if (bits < 1) { return 0; }
    let mask: i64 = 0;
    let i: i32 = 0;
    while (i < bits) {
        mask = (mask << 1) | 1;
        i = i + 1;
    }
    return mask;
}

