@import("zir.zag")
@import("sema.zag")
@import("../std/map.zag") as map

fn za_check(ok:i32,name:[]u8,fail:*i32)void{
    if(ok==1){_zag_println(_zag_str_concat("ok  ",name));}
    else{_zag_eprintln(_zag_str_concat("XX  ",name));fail.*=fail.*+1;}
}

fn za_count_ops(blk:ZBlock,name:[]u8)i32{
    let count:i32=0;let i:i32=0;while(i<blk.ops.len){let op:ZOp=blk.ops.data[i];
        if(@strEq(op.name,name)){count=count+1;}let ri:i32=0;while(ri<op.regions.len){let region:ZRegion=op.regions.data[ri];
            let bi:i32=0;while(bi<region.blocks.len){count=count+za_count_ops(region.blocks.data[bi],name);bi=bi+1;}ri=ri+1;}i=i+1;}
    return count;
}

fn za_count_constant_value(blk:ZBlock,value:[]u8)i32{
    let count:i32=0;let i:i32=0;while(i<blk.ops.len){let op:ZOp=blk.ops.data[i];
        if(@strEq(op.name,"arith.constant")&&@strEq(attr_val(op,"value"),value)){count=count+1;}
        let ri:i32=0;while(ri<op.regions.len){let region:ZRegion=op.regions.data[ri];
            let bi:i32=0;while(bi<region.blocks.len){count=count+
                za_count_constant_value(region.blocks.data[bi],value);bi=bi+1;}ri=ri+1;}i=i+1;}
    return count;
}

fn za_rejected_to_raw(raw:ZModule,decls:ArrayList[*Node],proposal:ZirTransformProposal)i32{
    let checked:ZirTransformCheck=zir_check_const_i32_add(raw,proposal);
    let selected:ZirAuthority=zir_select_foreground_transform(raw,decls,proposal);
    return (checked.accepted==0&&selected.valid==1&&selected.transform_count==0&&
        @strEq(selected.transform_status,"candidate_rejected_raw_fallback")&&
        zir_module_equal(selected.module,raw)==1) as i32;
}

fn za_source_policy_rejected_to_raw(raw:ZModule,decls:ArrayList[*Node],
    origins:ArrayList[NodeOrigin],policy:ZirTransformPolicy,
    proposal:ZirTransformProposal)i32{
    let checked:ZirTransformCheck=zir_check_const_i32_add_source_policy(
        raw,decls,origins,policy,proposal);
    let selected:ZirAuthority=zir_select_foreground_transform_source_policy(
        raw,decls,origins,policy,proposal);
    return (checked.accepted==0&&selected.valid==1&&selected.transform_count==0&&
        @strEq(selected.transform_status,"candidate_rejected_raw_fallback")&&
        zir_module_equal(selected.module,raw)==1) as i32;
}

fn za_mutate_source_origin(origins:*ArrayList[NodeOrigin],stable_id:i64)i32{
    let i:i32=0;while(i<origins.*.len){
        if(origins.*.data[i].stable_id==stable_id){
            origins.*.data[i].stable_id=origins.*.data[i].stable_id+1;return 1;}
        i=i+1;
    }
    return 0;
}

fn za_mutate_nested_origin(m:*ZModule,fi:i32)i32{
    let f:ZFunc=m.*.funcs.data[fi];let i:i32=0;while(i<f.body.ops.len){
        let op:ZOp=f.body.ops.data[i];let r:i32=0;while(r<op.regions.len){
            let region:ZRegion=op.regions.data[r];let b:i32=0;while(b<region.blocks.len){
                let block:ZBlock=region.blocks.data[b];if(block.ops.len>0){
                    block.ops.data[0].origin.line=block.ops.data[0].origin.line+1;
                    region.blocks.data[b]=block;op.regions.data[r]=region;
                    f.body.ops.data[i]=op;m.*.funcs.data[fi]=f;return 1;}
                b=b+1;}r=r+1;}i=i+1;}
    return 0;
}

fn za_mutate_contract_op(m:*ZModule,name:[]u8,mode:i32)i32{
    let fi:i32=0;while(fi<m.*.funcs.len){let f:ZFunc=m.*.funcs.data[fi];let oi:i32=0;
        while(oi<f.body.ops.len){let op:ZOp=f.body.ops.data[oi];if(@strEq(op.name,name)){
            if(mode==1&&op.operands.len>1){op.operands.data[0].ty="f64";}
            if(mode==2){op.effects=1;}
            if(mode==5){op.effects=2048;}
            if(mode==3&&op.results.len>0){op.results.data[0].ownership="unknown";}
            if(mode==4){op.origin.exact=0;}
            if(mode==6&&op.results.len>0){op.results.data[0].ownership="forged";}
            if(mode==7&&op.results.len>0){op.results.data[0].alias_region="forged";}
            if(mode==8&&op.results.len>0){op.results.data[0].lifetime="forged";}
            if(mode==9&&op.results.len>0){op.results.data[0].layout="forged";}
            if(mode==10&&op.attrs.len>0){op.attrs.data[0].val="31";}
            f.body.ops.data[oi]=op;m.*.funcs.data[fi]=f;return 1;
        }oi=oi+1;}fi=fi+1;}
    return 0;
}

fn za_mutate_unary_types(m:*ZModule,name:[]u8,ty:[]u8)i32{
    let fi:i32=0;while(fi<m.*.funcs.len){let f:ZFunc=m.*.funcs.data[fi];let oi:i32=0;
        while(oi<f.body.ops.len){let op:ZOp=f.body.ops.data[oi];
            if(@strEq(op.name,name)&&op.operands.len==1&&op.results.len==1){
                op.operands.data[0].ty=ty;op.results.data[0].ty=ty;
                f.body.ops.data[oi]=op;m.*.funcs.data[fi]=f;return 1;
            }oi=oi+1;
        }fi=fi+1;
    }
    return 0;
}

fn za_mutate_call_signature(m:*ZModule,mode:i32)i32{
    let fi:i32=0;while(fi<m.*.funcs.len){let f:ZFunc=m.*.funcs.data[fi];let oi:i32=0;
        while(oi<f.body.ops.len){let op:ZOp=f.body.ops.data[oi];
            if(@strEq(op.name,"func.call")){
                if(mode==1&&op.operands.len>0){op.operands.data[0].ty="i64";}
                if(mode==2){op.operands.len=0;}
                if(mode==3&&op.results.len>0){op.results.data[0].ty="i64";}
                f.body.ops.data[oi]=op;m.*.funcs.data[fi]=f;return 1;
            }
            oi=oi+1;
        }fi=fi+1;
    }
    return 0;
}

fn za_mutate_memory_access(m:*ZModule,name:[]u8,mode:i32)i32{
    let fi:i32=0;while(fi<m.*.funcs.len){let f:ZFunc=m.*.funcs.data[fi];let oi:i32=0;
        while(oi<f.body.ops.len){let op:ZOp=f.body.ops.data[oi];
            if(@strEq(op.name,name)){
                if(mode==1){op.reads="heap";}
                if(mode==2){op.writes="heap";}
                if(mode==3&&op.operands.len>0){op.operands.data[0].alias_region="heap";}
                if(mode==4&&op.operands.len>1){op.operands.data[1].alias_region="heap";}
                f.body.ops.data[oi]=op;m.*.funcs.data[fi]=f;return 1;
            }
            oi=oi+1;
        }fi=fi+1;
    }
    return 0;
}

fn za_mutate_memref_element(m:*ZModule,name:[]u8,mode:i32)i32{
    let fi:i32=0;while(fi<m.*.funcs.len){let f:ZFunc=m.*.funcs.data[fi];let oi:i32=0;
        while(oi<f.body.ops.len){let op:ZOp=f.body.ops.data[oi];
            if(@strEq(op.name,name)){
                if(mode==1&&op.attrs.len>0){op.attrs.data[0].val="f64";}
                if(mode==2){op.attrs.len=0;}
                f.body.ops.data[oi]=op;m.*.funcs.data[fi]=f;return 1;
            }
            oi=oi+1;
        }fi=fi+1;
    }
    return 0;
}

fn za_mutate_loop_condition_marker(m:*ZModule)i32{
    let fi:i32=0;while(fi<m.*.funcs.len){
        let f:ZFunc=m.*.funcs.data[fi];let oi:i32=0;
        while(oi<f.body.ops.len){let op:ZOp=f.body.ops.data[oi];
            if(@strEq(op.name,"scf.while")&&op.regions.len==2&&op.regions.data[0].blocks.len==1){
                let block:ZBlock=op.regions.data[0].blocks.data[0];
                if(block.ops.len>0){
                    block.ops.data[block.ops.len-1].name="scf.yield";
                    op.regions.data[0].blocks.data[0]=block;
                    f.body.ops.data[oi]=op;m.*.funcs.data[fi]=f;return 1;
                }
            }
            oi=oi+1;
        }
        fi=fi+1;
    }
    return 0;
}

fn za_mutate_switch_duplicate_default(m:*ZModule)i32{
    let fi:i32=0;while(fi<m.*.funcs.len){
        let f:ZFunc=m.*.funcs.data[fi];let oi:i32=0;
        while(oi<f.body.ops.len){let op:ZOp=f.body.ops.data[oi];
            if(@strEq(op.name,"zag.switch")&&op.regions.len>1&&
               op.regions.data[0].blocks.len==1&&op.regions.data[0].blocks.data[0].ops.len>0){
                let first:ZOp=op.regions.data[0].blocks.data[0].ops.data[0];
                first.name="zag.default";first.attrs.len=0;
                op.regions.data[0].blocks.data[0].ops.data[0]=first;
                f.body.ops.data[oi]=op;m.*.funcs.data[fi]=f;return 1;
            }
            oi=oi+1;
        }
        fi=fi+1;
    }
    return 0;
}

fn za_break_untouched_operand(m:*ZModule,fi:i32,skip:i32)i32{
    let f:ZFunc=m.*.funcs.data[fi];let i:i32=0;while(i<f.body.ops.len){
        if(i!=skip&&f.body.ops.data[i].operands.len>0){
            f.body.ops.data[i].operands.data[0].name="%forged-undefined";
            m.*.funcs.data[fi]=f;return 1;}i=i+1;}
    return 0;
}

fn main()i32{
    let fail:i32=0;
    let supported:CompilationUnit=parse_compilation_unit_dir(
        "fn add(x:i32,y:i32) i32 { return x+y; }\nfn main() i32 { return add(40,2); }\n",".");
    let supported_eff:map.StringMap[i32]=analyze(supported.decls);
    let authority:ZirAuthority=zir_prepare_production_with_origins(supported.decls,supported_eff,supported.origins);
    za_check(authority.valid==1&&authority.verify_errors==0,
        "production authority verifies",&fail);
    za_check(@strEq(authority.module.schema_version,"zag-ir-v1") as i32,
        "versioned IR schema",&fail);
    za_check(@strEq(authority.module.transform_version,"zag-transform-v1") as i32,
        "reserved transformation schema identifier",&fail);
    za_check(authority.module.funcs.len==2&&authority.coverage_complete==1,
        "supported scalar program has complete SSA coverage",&fail);
    za_check(za_count_ops(authority.module.funcs.data[1].body,"func.call")==1,
        "one source call lowers to exactly one IR call",&fail);
    let add:ZFunc=authority.module.funcs.data[0];
    za_check(@strEq(add.origin.module,"<root>") as i32&&add.origin.line==1&&
        add.origin.byte_start==0&&add.origin.byte_end==39&&add.origin.complete==1&&
        add.origin.exact==1&&authority.origin_complete==1&&authority.origin_exact==1,
        "declaration and operation origins are exact",&fail);
    za_check(add.params.len==2&&@strEq(add.params.data[0].ownership,"borrowed") as i32&&
        @strEq(add.params.data[0].layout,"declared") as i32,
        "typed value ownership lifetime and layout metadata",&fail);

    let neg_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i32 { let base:i32=41; let answer:i32=-base; return answer+83; }\n", ".");
    let neg_eff:map.StringMap[i32]=analyze(neg_unit.decls);
    let neg_ir:ZirAuthority=zir_prepare_production_with_origins(neg_unit.decls,neg_eff,neg_unit.origins);
    let neg_bad:ZModule=zir_clone_module(neg_ir.module);
    za_check(neg_ir.valid==1&&za_mutate_unary_types(&neg_bad,"arith.negsi","bool")==1&&
        zir_verify_contracts(neg_bad).valid==0,
        "contract verifier rejects non-integer arith.negsi",&fail);
    let fneg_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn negate(x:f64) f64 { return -x; } fn main() i32 { let x:f64=1.0; let y:f64=negate(x); return y as i32; }\n", ".");
    let fneg_eff:map.StringMap[i32]=analyze(fneg_unit.decls);
    let fneg_ir:ZirAuthority=zir_prepare_production_with_origins(fneg_unit.decls,fneg_eff,fneg_unit.origins);
    let fneg_bad:ZModule=zir_clone_module(fneg_ir.module);
    za_check(fneg_ir.valid==1&&za_count_ops(fneg_ir.module.funcs.data[0].body,"arith.negf")==1&&
        za_mutate_unary_types(&fneg_bad,"arith.negf","i64")==1&&
        zir_verify_contracts(fneg_bad).valid==0,
        "contract verifier rejects non-floating arith.negf",&fail);

    let xor_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i32 { let left:i32=21; let right:i32=63; return left^right; }\n", ".");
    let xor_eff:map.StringMap[i32]=analyze(xor_unit.decls);
    let xor_ir:ZirAuthority=zir_prepare_production_with_origins(xor_unit.decls,xor_eff,xor_unit.origins);
    za_check(xor_ir.valid==1&&xor_ir.coverage_complete==1&&xor_ir.coverage_errors==0&&
        za_count_ops(xor_ir.module.funcs.data[0].body,"arith.xori")==1,
        "typed integer XOR lowers to arith.xori",&fail);
    let xor_bad:ZModule=zir_clone_module(xor_ir.module);
    za_check(za_mutate_contract_op(&xor_bad,"arith.xori",1)==1&&
        zir_verify_contracts(xor_bad).valid==0&&
        zir_verify_contracts(xor_bad).type_complete==0,
        "contract verifier rejects mismatched arith.xori types",&fail);

    let and_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i32 { let left:i32=21; let right:i32=63; return left&right; }\n", ".");
    let and_eff:map.StringMap[i32]=analyze(and_unit.decls);
    let and_ir:ZirAuthority=zir_prepare_production_with_origins(and_unit.decls,and_eff,and_unit.origins);
    za_check(and_ir.valid==1&&and_ir.coverage_complete==1&&and_ir.coverage_errors==0&&
        za_count_ops(and_ir.module.funcs.data[0].body,"arith.andsi")==1,
        "typed integer AND lowers to arith.andsi",&fail);
    let and_bad:ZModule=zir_clone_module(and_ir.module);
    za_check(za_mutate_contract_op(&and_bad,"arith.andsi",1)==1&&
        zir_verify_contracts(and_bad).valid==0&&
        zir_verify_contracts(and_bad).type_complete==0,
        "contract verifier rejects mismatched arith.andsi types",&fail);

    let or_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i32 { let left:i32=16; let right:i32=3; return left | right; }\n", ".");
    let or_eff:map.StringMap[i32]=analyze(or_unit.decls);
    let or_ir:ZirAuthority=zir_prepare_production_with_origins(or_unit.decls,or_eff,or_unit.origins);
    za_check(or_ir.valid==1&&or_ir.coverage_complete==1&&or_ir.coverage_errors==0&&
        za_count_ops(or_ir.module.funcs.data[0].body,"arith.orsi")==1,
        "typed integer OR lowers to arith.orsi",&fail);
    let or_bad:ZModule=zir_clone_module(or_ir.module);
    za_check(za_mutate_contract_op(&or_bad,"arith.orsi",1)==1&&
        zir_verify_contracts(or_bad).valid==0&&
        zir_verify_contracts(or_bad).type_complete==0,
        "contract verifier rejects mismatched arith.orsi types",&fail);

    let shl_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i32 { let left:i32=3; let count:i32=4; return left << count; }\n", ".");
    let shl_eff:map.StringMap[i32]=analyze(shl_unit.decls);
    let shl_ir:ZirAuthority=zir_prepare_production_with_origins(shl_unit.decls,shl_eff,shl_unit.origins);
    za_check(shl_ir.valid==1&&shl_ir.coverage_complete==1&&shl_ir.coverage_errors==0&&
        zir_verify_contracts(shl_ir.module).valid==1&&
        za_count_ops(shl_ir.module.funcs.data[0].body,"arith.shli")==1,
        "typed integer left shift lowers to width-checked arith.shli",&fail);
    let shl_bad:ZModule=zir_clone_module(shl_ir.module);
    za_check(za_mutate_contract_op(&shl_bad,"arith.shli",1)==1&&
        zir_verify_contracts(shl_bad).valid==0&&
        zir_verify_contracts(shl_bad).type_complete==0,
        "contract verifier rejects mismatched arith.shli types",&fail);
    let shl_width_bad:ZModule=zir_clone_module(shl_ir.module);
    za_check(za_mutate_contract_op(&shl_width_bad,"arith.shli",10)==1&&
        zir_verify_contracts(shl_width_bad).valid==0,
        "contract verifier rejects invalid arith.shli width",&fail);

    let shr_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i64 { let left:i64=128; let count:i64=3; return left >> count; }\n", ".");
    let shr_eff:map.StringMap[i32]=analyze(shr_unit.decls);
    let shr_ir:ZirAuthority=zir_prepare_production_with_origins(shr_unit.decls,shr_eff,shr_unit.origins);
    za_check(shr_ir.valid==1&&shr_ir.coverage_complete==1&&shr_ir.coverage_errors==0&&
        za_count_ops(shr_ir.module.funcs.data[0].body,"arith.shrsi")==1,
        "typed integer right shift lowers to arith.shrsi",&fail);

    let cmp_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i32 { let left:i32=4; let right:i32=4; let eq:bool=left==right; let ne:bool=left!=right; let lt:bool=left<right; let le:bool=left<=right; let gt:bool=left>right; let ge:bool=left>=right; if(eq){return 1;} return 0; }\n", ".");
    let cmp_eff:map.StringMap[i32]=analyze(cmp_unit.decls);
    let cmp_ir:ZirAuthority=zir_prepare_production_with_origins(cmp_unit.decls,cmp_eff,cmp_unit.origins);
    za_check(cmp_ir.valid==1&&cmp_ir.coverage_complete==1&&cmp_ir.coverage_errors==0&&
        zir_verify_contracts(cmp_ir.module).valid==1&&
        za_count_ops(cmp_ir.module.funcs.data[0].body,"arith.cmpi")==6,
        "exact i32 comparisons lower all six predicates to arith.cmpi",&fail);
    let cmp_bad:ZModule=zir_clone_module(cmp_ir.module);
    za_check(za_mutate_contract_op(&cmp_bad,"arith.cmpi",1)==1&&
        zir_verify_contracts(cmp_bad).valid==0&&
        zir_verify_contracts(cmp_bad).type_complete==0,
        "contract verifier rejects mismatched integer comparison types",&fail);
    let contracts:ZirContractReport=zir_verify_contracts(authority.module);
    za_check(authority.contract_valid==1&&authority.contract_errors==0&&
        contracts.valid==1&&contracts.errors==0&&contracts.checked_ops>0&&
        contracts.checked_values>0&&contracts.type_complete==1&&
        contracts.effects_complete==1&&contracts.ownership_complete==1&&
        contracts.alias_complete==1&&contracts.lifetime_complete==1&&
        contracts.layout_complete==1&&contracts.origin_complete==1,
        "independent typed effect ownership alias lifetime layout contract verifier",&fail);
    let bad_contract_type:ZModule=zir_clone_module(authority.module);
    za_check(za_mutate_contract_op(&bad_contract_type,"arith.addi",1)==1&&
        zir_verify_contracts(bad_contract_type).valid==0&&
        zir_verify_contracts(bad_contract_type).type_complete==0,
        "contract verifier rejects mismatched arithmetic types",&fail);
    let bad_contract_effect:ZModule=zir_clone_module(authority.module);
    za_check(za_mutate_contract_op(&bad_contract_effect,"arith.constant",2)==1&&
        zir_verify_contracts(bad_contract_effect).valid==0&&
        zir_verify_contracts(bad_contract_effect).effects_complete==0,
        "contract verifier rejects effects outside the function mask",&fail);
    let bad_contract_unknown_effect:ZModule=zir_clone_module(authority.module);
    za_check(za_mutate_contract_op(&bad_contract_unknown_effect,"arith.constant",5)==1&&
        zir_verify_contracts(bad_contract_unknown_effect).valid==0&&
        zir_verify_contracts(bad_contract_unknown_effect).effects_complete==0,
        "contract verifier rejects unknown effect bits",&fail);
    let bad_contract_owner:ZModule=zir_clone_module(authority.module);
    za_check(za_mutate_contract_op(&bad_contract_owner,"arith.constant",3)==1&&
        zir_verify_contracts(bad_contract_owner).valid==0&&
        zir_verify_contracts(bad_contract_owner).ownership_complete==0,
        "contract verifier rejects unknown ownership",&fail);
    let bad_contract_ownership_domain:ZModule=zir_clone_module(authority.module);
    za_check(za_mutate_contract_op(&bad_contract_ownership_domain,"arith.constant",6)==1&&
        zir_verify_contracts(bad_contract_ownership_domain).valid==0&&
        zir_verify_contracts(bad_contract_ownership_domain).ownership_complete==0,
        "contract verifier rejects forged ownership domain",&fail);
    let bad_contract_alias_domain:ZModule=zir_clone_module(authority.module);
    za_check(za_mutate_contract_op(&bad_contract_alias_domain,"arith.constant",7)==1&&
        zir_verify_contracts(bad_contract_alias_domain).valid==0&&
        zir_verify_contracts(bad_contract_alias_domain).alias_complete==0,
        "contract verifier rejects forged alias domain",&fail);
    let bad_contract_lifetime_domain:ZModule=zir_clone_module(authority.module);
    za_check(za_mutate_contract_op(&bad_contract_lifetime_domain,"arith.constant",8)==1&&
        zir_verify_contracts(bad_contract_lifetime_domain).valid==0&&
        zir_verify_contracts(bad_contract_lifetime_domain).lifetime_complete==0,
        "contract verifier rejects forged lifetime domain",&fail);
    let bad_contract_layout_domain:ZModule=zir_clone_module(authority.module);
    za_check(za_mutate_contract_op(&bad_contract_layout_domain,"arith.constant",9)==1&&
        zir_verify_contracts(bad_contract_layout_domain).valid==0&&
        zir_verify_contracts(bad_contract_layout_domain).layout_complete==0,
        "contract verifier rejects forged layout domain",&fail);
    let bad_contract_origin:ZModule=zir_clone_module(authority.module);
    za_check(za_mutate_contract_op(&bad_contract_origin,"arith.constant",4)==1&&
        zir_verify_contracts(bad_contract_origin).valid==0&&
        zir_verify_contracts(bad_contract_origin).origin_complete==0,
        "contract verifier rejects inexact origins",&fail);

    // Memory operations must bind their declared access region to the
    // memref's alias metadata. A valid label alone is insufficient: otherwise
    // a forged load/store could claim a different region while retaining a
    // native memory route.
    let memory_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i32 { let x:i32=7; x=x+1; return x; }\n", ".");
    let memory_eff:map.StringMap[i32]=analyze(memory_unit.decls);
    let memory_ir:ZirAuthority=zir_prepare_production_with_origins(
        memory_unit.decls,memory_eff,memory_unit.origins);
    let bad_load_access:ZModule=zir_clone_module(memory_ir.module);
    let bad_load_alias:ZModule=zir_clone_module(memory_ir.module);
    let bad_store_access:ZModule=zir_clone_module(memory_ir.module);
    let bad_store_alias:ZModule=zir_clone_module(memory_ir.module);
    za_check(memory_ir.contract_valid==1&&
        za_mutate_memory_access(&bad_load_access,"memref.load",1)==1&&
        zir_verify_contracts(bad_load_access).valid==0&&
        za_mutate_memory_access(&bad_load_alias,"memref.load",3)==1&&
        zir_verify_contracts(bad_load_alias).valid==0&&
        za_mutate_memory_access(&bad_store_access,"memref.store",2)==1&&
        zir_verify_contracts(bad_store_access).valid==0&&
        za_mutate_memory_access(&bad_store_alias,"memref.store",4)==1&&
        zir_verify_contracts(bad_store_alias).valid==0,
        "memory access regions bind to memref alias metadata",&fail);
    let bad_alloc_elem:ZModule=zir_clone_module(memory_ir.module);
    let bad_load_elem:ZModule=zir_clone_module(memory_ir.module);
    let bad_store_elem:ZModule=zir_clone_module(memory_ir.module);
    let bad_load_attrs:ZModule=zir_clone_module(memory_ir.module);
    za_check(za_mutate_memref_element(&bad_alloc_elem,"memref.alloca",1)==1&&
        zir_verify_contracts(bad_alloc_elem).valid==0&&
        za_mutate_memref_element(&bad_load_elem,"memref.load",1)==1&&
        zir_verify_contracts(bad_load_elem).valid==0&&
        za_mutate_memref_element(&bad_store_elem,"memref.store",1)==1&&
        zir_verify_contracts(bad_store_elem).valid==0&&
        za_mutate_memref_element(&bad_load_attrs,"memref.load",2)==1&&
        zir_verify_contracts(bad_load_attrs).valid==0,
        "memref element witnesses bind allocation and access types",&fail);
    let pure_regions:ZirRegionExtraction=zir_extract_semantic_regions(authority.module);
    za_check(pure_regions.valid==1&&pure_regions.complete==1&&
        pure_regions.automatic==0&&pure_regions.source_changes==0&&
        pure_regions.executable_authority==0&&pure_regions.regions.len>0&&
        pure_regions.rejected_regions==0&&
        @strEq(pure_regions.reason,"bounded pure semantic regions"),
        "bounded semantic-region extraction is metadata-only",&fail);
    za_check(pure_regions.regions.data[0].op_count>0&&
        pure_regions.regions.data[0].first_origin.complete==1&&
        pure_regions.regions.data[0].first_origin.exact==1&&
        pure_regions.regions.data[0].last_origin.complete==1&&
        pure_regions.regions.data[0].last_origin.exact==1,
        "semantic regions retain exact first and last source origins",&fail);
    let nested_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i32 { if (1==1) { return 42; } return 0; }\n", ".");
    let nested_eff:map.StringMap[i32]=analyze(nested_unit.decls);
    let nested_ir:ZirAuthority=zir_prepare_production_with_origins(
        nested_unit.decls,nested_eff,nested_unit.origins);
    let nested_regions:ZirRegionExtraction=zir_extract_semantic_regions(nested_ir.module);
    let nested_path_found:i32=0;let nested_region_i:i32=0;
    while(nested_region_i<nested_regions.regions.len){
        let nested_region:ZirSemanticRegion=nested_regions.regions.data[nested_region_i];
        if(nested_region.depth==1&&!@strEq(nested_region.path,"root")){nested_path_found=1;}
        nested_region_i=nested_region_i+1;
    }
    za_check(nested_regions.valid==1&&nested_regions.complete==0&&
        nested_regions.rejected_regions>0&&nested_regions.executable_authority==0&&
        nested_path_found==1,
        "nested control flow records lexical pure regions without authority",&fail);
    let effect_module:ZModule=authority.module;
    effect_module.funcs.data[0].body.ops.data[0].effects=1;
    let effect_regions:ZirRegionExtraction=zir_extract_semantic_regions(effect_module);
    za_check(effect_regions.valid==1&&effect_regions.complete==0&&
        effect_regions.rejected_regions>0,
        "effectful operations are excluded from pure regions",&fail);
    let origin_module:ZModule=authority.module;
    origin_module.funcs.data[0].body.ops.data[0].origin.exact=0;
    let origin_regions:ZirRegionExtraction=zir_extract_semantic_regions(origin_module);
    za_check(origin_regions.valid==1&&origin_regions.complete==0&&
        origin_regions.rejected_regions>0,
        "inexact operation origins fail closed",&fail);
    let schema_module:ZModule=authority.module;schema_module.schema_version="zag-ir-v0";
    let schema_regions:ZirRegionExtraction=zir_extract_semantic_regions(schema_module);
    za_check(schema_regions.valid==0&&schema_regions.complete==0&&
        @strEq(schema_regions.reason,"unsupported IR schema"),
        "unknown semantic-region schema is rejected",&fail);

    // The public production entry remains raw. A separate bounded seam below
    // proves source/policy binding without silently changing that driver path.
    let overflow_source:[]u8=
        "fn main() i32 { let x:i32=2147483647+1; if (x<0) { return 42; } else { return 1; } }\n";
    let overflow_unit:CompilationUnit=parse_compilation_unit_dir(overflow_source,".");
    let overflow_eff:map.StringMap[i32]=analyze(overflow_unit.decls);
    let overflow_raw:ZModule=build_module(overflow_unit.decls,overflow_eff,overflow_unit.origins);
    let overflow_baseline:ZirAuthority=zir_select_foreground_transform(overflow_raw,
        overflow_unit.decls,zir_no_transform_proposal(overflow_raw));
    let overflow_ir:ZirAuthority=zir_prepare_production_with_origins(
        overflow_unit.decls,overflow_eff,overflow_unit.origins);
    let overflow_raw_body:ZBlock=overflow_baseline.module.funcs.data[0].body;
    let overflow_production_body:ZBlock=overflow_ir.module.funcs.data[0].body;
    za_check(overflow_baseline.valid==1&&overflow_baseline.transform_count==0&&
        @strEq(overflow_baseline.transform_status,"verified_no_transform")&&
        za_count_ops(overflow_raw_body,"arith.addi")==1&&
        za_count_constant_value(overflow_raw_body,"2147483648")==0,
        "verified raw fallback preserves width-sensitive i32 add",&fail);
    za_check(overflow_ir.valid==1&&overflow_ir.transform_count==0&&
        @strEq(overflow_ir.transform_status,"verified_no_transform")&&
        @strEq(overflow_ir.transform_rule,"none")&&
        @strEq(overflow_ir.transform_checker,"not-run")&&
        za_count_ops(overflow_production_body,"arith.addi")==1&&
        za_count_constant_value(overflow_production_body,"-2147483648")==0&&
        za_count_constant_value(overflow_production_body,"2147483648")==0,
        "production disables automatic semantic transforms",&fail);

    let good:ZirTransformProposal=zir_propose_const_i32_add(overflow_raw);
    let test_selected:ZirAuthority=zir_select_foreground_transform(
        overflow_raw,overflow_unit.decls,good);
    let policy:ZirTransformPolicy=zir_transform_policy_const_i32_add_default();
    let source_checked:ZirTransformCheck=zir_check_const_i32_add_source_policy(
        overflow_raw,overflow_unit.decls,overflow_unit.origins,policy,good);
    let source_selected:ZirAuthority=zir_select_foreground_transform_source_policy(
        overflow_raw,overflow_unit.decls,overflow_unit.origins,policy,good);
    let test_selected_body:ZBlock=test_selected.module.funcs.data[0].body;
    za_check(good.proposed==1&&good.certificate.transform_count==1&&
        zir_check_const_i32_add(overflow_raw,good).accepted==1&&
        test_selected.transform_count==1&&
        @strEq(test_selected.transform_status,"test_only_structural_transform")&&
        za_count_ops(test_selected_body,"arith.addi")==0&&
        za_count_constant_value(test_selected_body,"-2147483648")==1&&
        zir_identity_equal(good.certificate.before,zir_semantic_identity(overflow_raw))==1&&
        zir_identity_equal(good.certificate.after,zir_semantic_identity(good.candidate))==1,
        "test-only certificate binds and checks both complete module identities",&fail);
    let source_selected_body:ZBlock=source_selected.module.funcs.data[0].body;
    za_check(source_checked.accepted==1&&
        @strEq(source_checked.reason,"foreground_source_policy_checked")&&
        source_selected.transform_count==1&&
        @strEq(source_selected.transform_status,"foreground_source_policy_checked")&&
        @strEq(source_selected.transform_checker,zir_transform_checker_const_i32_add())&&
        za_count_ops(source_selected_body,"arith.addi")==0&&
        za_count_constant_value(source_selected_body,"-2147483648")==1,
        "checker independently binds explicit i32 source and foreground policy",&fail);

    let raw_identity:ZirSemanticIdentity=zir_semantic_identity(overflow_raw);
    let isolated_none:ZirTransformProposal=zir_no_transform_proposal(overflow_raw);
    let isolated_cert:ZirTransformProposal=zir_propose_const_i32_add(overflow_raw);
    isolated_cert.candidate.funcs.data[0].name[0]='X';
    isolated_cert.candidate.funcs.data[0].body.ops.data[0].attrs.data[0].val[0]='9';
    isolated_cert.certificate.function_name[0]='Y';
    isolated_cert.certificate.function_origin.module[0]='Z';
    za_check(isolated_none.proposed==0&&isolated_none.candidate.funcs.len==0&&
        zir_identity_equal(raw_identity,zir_semantic_identity(overflow_raw))==1&&
        @strEq(overflow_raw.funcs.data[0].name,"main")&&
        @strEq(overflow_source,
            "fn main() i32 { let x:i32=2147483647+1; if (x<0) { return 42; } else { return 1; } }\n"),
        "candidate certificate byte mutation cannot alias raw IR or AST source",&fail);

    let bad_header:ZirTransformProposal=zir_propose_const_i32_add(overflow_raw);
    bad_header.certificate.format="zag-ir-transform-certificate-v0";
    let bad_schema:ZirTransformProposal=zir_propose_const_i32_add(overflow_raw);
    bad_schema.certificate.identity_schema="zag-ir-semantic-identity-v0";
    let bad_rule:ZirTransformProposal=zir_propose_const_i32_add(overflow_raw);
    bad_rule.certificate.rule="const-i64-add-v1";
    let bad_checker:ZirTransformProposal=zir_propose_const_i32_add(overflow_raw);
    bad_checker.certificate.checker="producer-self-check";
    let bad_verifier:ZirTransformProposal=zir_propose_const_i32_add(overflow_raw);
    bad_verifier.certificate.ir_verifier="unchecked";
    let duplicate_count:ZirTransformProposal=zir_propose_const_i32_add(overflow_raw);
    duplicate_count.certificate.transform_count=2;
    let duplicate_proposal:ZirTransformProposal=zir_propose_const_i32_add(overflow_raw);
    duplicate_proposal.proposed=2;
    za_check(za_rejected_to_raw(overflow_raw,overflow_unit.decls,bad_header)==1&&
        za_rejected_to_raw(overflow_raw,overflow_unit.decls,bad_schema)==1&&
        za_rejected_to_raw(overflow_raw,overflow_unit.decls,bad_rule)==1&&
        za_rejected_to_raw(overflow_raw,overflow_unit.decls,bad_checker)==1&&
        za_rejected_to_raw(overflow_raw,overflow_unit.decls,bad_verifier)==1&&
        za_rejected_to_raw(overflow_raw,overflow_unit.decls,duplicate_count)==1&&
        za_rejected_to_raw(overflow_raw,overflow_unit.decls,duplicate_proposal)==1,
        "malformed version rule verifier and duplicate evidence select raw",&fail);

    let checked_policy:ZirTransformPolicy=policy;checked_policy.safety_checked=1;
    let sanitized_policy:ZirTransformPolicy=policy;sanitized_policy.sanitize_memory=1;
    let edition_policy:ZirTransformPolicy=policy;edition_policy.edition="2027";
    let arithmetic_policy:ZirTransformPolicy=policy;
    arithmetic_policy.arithmetic="i32-checked-overflow-v1";
    let target_policy:ZirTransformPolicy=policy;target_policy.target="linux-aarch64";
    za_check(za_source_policy_rejected_to_raw(overflow_raw,overflow_unit.decls,
            overflow_unit.origins,checked_policy,good)==1&&
        za_source_policy_rejected_to_raw(overflow_raw,overflow_unit.decls,
            overflow_unit.origins,sanitized_policy,good)==1&&
        za_source_policy_rejected_to_raw(overflow_raw,overflow_unit.decls,
            overflow_unit.origins,edition_policy,good)==1&&
        za_source_policy_rejected_to_raw(overflow_raw,overflow_unit.decls,
            overflow_unit.origins,arithmetic_policy,good)==1&&
        za_source_policy_rejected_to_raw(overflow_raw,overflow_unit.decls,
            overflow_unit.origins,target_policy,good)==1,
        "checked sanitize edition arithmetic and target policy changes select raw",&fail);

    // All substituted sources retain the same node kinds and byte positions as
    // the certified source. Stable IDs alone therefore cannot authorize them;
    // the checker must re-resolve type, operator, and canonical literal facts.
    let wrong_type_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i32 { let x:u32=2147483647+1; if (x<0) { return 42; } else { return 1; } }\n",".");
    let wrong_op_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i32 { let x:i32=2147483647-1; if (x<0) { return 42; } else { return 1; } }\n",".");
    let noncanonical_source_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i32 { let x:i32=0214748364+1; if (x<0) { return 42; } else { return 1; } }\n",".");
    za_check(za_source_policy_rejected_to_raw(overflow_raw,wrong_type_unit.decls,
            wrong_type_unit.origins,policy,good)==1&&
        za_source_policy_rejected_to_raw(overflow_raw,wrong_op_unit.decls,
            wrong_op_unit.origins,policy,good)==1&&
        za_source_policy_rejected_to_raw(overflow_raw,noncanonical_source_unit.decls,
            noncanonical_source_unit.origins,policy,good)==1,
        "same-span type operator and noncanonical source substitutions select raw",&fail);

    let changed_origin_unit:CompilationUnit=parse_compilation_unit_dir(overflow_source,".");
    let changed_source_origin:i32=za_mutate_source_origin(&changed_origin_unit.origins,
        good.certificate.op_origin.stable_id);
    za_check(changed_source_origin==1&&
        za_source_policy_rejected_to_raw(overflow_raw,changed_origin_unit.decls,
            changed_origin_unit.origins,policy,good)==1,
        "source-origin mutation selects raw",&fail);

    let bad_policy_fact:ZirTransformProposal=zir_propose_const_i32_add(overflow_raw);
    bad_policy_fact.certificate.arithmetic_policy="i32-checked-overflow-v1";
    let bad_context_fact:ZirTransformProposal=zir_propose_const_i32_add(overflow_raw);
    bad_context_fact.certificate.source_context="inferred-i32";
    za_check(za_source_policy_rejected_to_raw(overflow_raw,overflow_unit.decls,
            overflow_unit.origins,policy,bad_policy_fact)==1&&
        za_source_policy_rejected_to_raw(overflow_raw,overflow_unit.decls,
            overflow_unit.origins,policy,bad_context_fact)==1,
        "certificate policy and contextual-type mutations select raw",&fail);

    let bad_before:ZirTransformProposal=zir_propose_const_i32_add(overflow_raw);
    bad_before.certificate.before.first=bad_before.certificate.before.first+1;
    let bad_after:ZirTransformProposal=zir_propose_const_i32_add(overflow_raw);
    bad_after.certificate.after.bytes=bad_after.certificate.after.bytes+1;
    let stale_raw:ZModule=zir_clone_module(overflow_raw);
    stale_raw.funcs.data[0].name="stale-main";
    let stale_proposal:ZirTransformProposal=zir_propose_const_i32_add(overflow_raw);
    za_check(za_rejected_to_raw(overflow_raw,overflow_unit.decls,bad_before)==1&&
        za_rejected_to_raw(overflow_raw,overflow_unit.decls,bad_after)==1&&
        za_rejected_to_raw(stale_raw,overflow_unit.decls,stale_proposal)==1,
        "mutated and stale full-module identities select raw",&fail);

    let bad_function_index:ZirTransformProposal=zir_propose_const_i32_add(overflow_raw);
    bad_function_index.certificate.function_index=99;
    let bad_op_index:ZirTransformProposal=zir_propose_const_i32_add(overflow_raw);
    bad_op_index.certificate.op_index=0;
    let duplicate_defs:ZirTransformProposal=zir_propose_const_i32_add(overflow_raw);
    duplicate_defs.certificate.rhs_def_index=duplicate_defs.certificate.lhs_def_index;
    za_check(za_rejected_to_raw(overflow_raw,overflow_unit.decls,bad_function_index)==1&&
        za_rejected_to_raw(overflow_raw,overflow_unit.decls,bad_op_index)==1&&
        za_rejected_to_raw(overflow_raw,overflow_unit.decls,duplicate_defs)==1,
        "out-of-range and duplicate operation evidence select raw",&fail);

    let bad_ssa:ZirTransformProposal=zir_propose_const_i32_add(overflow_raw);
    bad_ssa.certificate.lhs_ssa="%forged";
    let bad_origin:ZirTransformProposal=zir_propose_const_i32_add(overflow_raw);
    bad_origin.certificate.op_origin.stable_id=bad_origin.certificate.op_origin.stable_id+1;
    let bad_number:ZirTransformProposal=zir_propose_const_i32_add(overflow_raw);
    bad_number.certificate.result_value=0;
    za_check(za_rejected_to_raw(overflow_raw,overflow_unit.decls,bad_ssa)==1&&
        za_rejected_to_raw(overflow_raw,overflow_unit.decls,bad_origin)==1&&
        za_rejected_to_raw(overflow_raw,overflow_unit.decls,bad_number)==1,
        "forged SSA origin and numeric facts select raw",&fail);

    let forged_result:ZirTransformProposal=zir_propose_const_i32_add(overflow_raw);
    forged_result.candidate.funcs.data[forged_result.certificate.function_index].body.ops.data[
        forged_result.certificate.op_index].attrs.data[0].val="0";
    forged_result.certificate.after=zir_semantic_identity(forged_result.candidate);
    let forged_effect:ZirTransformProposal=zir_propose_const_i32_add(overflow_raw);
    forged_effect.candidate.funcs.data[forged_effect.certificate.function_index].body.ops.data[
        forged_effect.certificate.op_index].effects=1;
    forged_effect.certificate.after=zir_semantic_identity(forged_effect.candidate);
    let forged_value_meta:ZirTransformProposal=zir_propose_const_i32_add(overflow_raw);
    forged_value_meta.candidate.funcs.data[forged_value_meta.certificate.function_index].body.ops.data[
        forged_value_meta.certificate.op_index].results.data[0].layout="forged-layout";
    forged_value_meta.certificate.after=zir_semantic_identity(forged_value_meta.candidate);
    za_check(za_rejected_to_raw(overflow_raw,overflow_unit.decls,forged_result)==1&&
        za_rejected_to_raw(overflow_raw,overflow_unit.decls,forged_effect)==1&&
        za_rejected_to_raw(overflow_raw,overflow_unit.decls,forged_value_meta)==1,
        "re-signed wrong result effect and result metadata select raw",&fail);

    let forged_function:ZirTransformProposal=zir_propose_const_i32_add(overflow_raw);
    forged_function.candidate.funcs.data[forged_function.certificate.function_index].ret="i64";
    forged_function.certificate.after=zir_semantic_identity(forged_function.candidate);
    let forged_region:ZirTransformProposal=zir_propose_const_i32_add(overflow_raw);
    let changed_region:i32=za_mutate_nested_origin(&forged_region.candidate,
        forged_region.certificate.function_index);
    forged_region.certificate.after=zir_semantic_identity(forged_region.candidate);
    let forged_use:ZirTransformProposal=zir_propose_const_i32_add(overflow_raw);
    let changed_use:i32=za_break_untouched_operand(&forged_use.candidate,
        forged_use.certificate.function_index,forged_use.certificate.op_index);
    forged_use.certificate.after=zir_semantic_identity(forged_use.candidate);
    za_check(za_rejected_to_raw(overflow_raw,overflow_unit.decls,forged_function)==1&&
        changed_region==1&&za_rejected_to_raw(overflow_raw,overflow_unit.decls,forged_region)==1&&
        changed_use==1&&za_rejected_to_raw(overflow_raw,overflow_unit.decls,forged_use)==1,
        "re-signed untouched function region and invalid use select raw",&fail);

    za_check(ztp_parse_i32("+1").valid==0&&ztp_parse_i32("01").valid==0&&
        ztp_parse_i32("-0").valid==0&&ztp_parse_i32("2147483648").valid==0&&
        ztp_parse_i32("-2147483649").valid==0&&ztp_parse_i32("1x").valid==0&&
        ztc_parse_i32("+1").valid==0&&ztc_parse_i32("01").valid==0&&
        ztc_parse_i32("-0").valid==0&&ztc_parse_i32("2147483648").valid==0&&
        ztc_parse_i32("-2147483649").valid==0&&ztc_parse_i32("1x").valid==0&&
        ztc_wrap_i32_add(2147483647,1)==(0-2147483648)&&
        ztc_wrap_i32_add(0-2147483648,0-1)==2147483647,
        "producer and checker enforce canonical bounded i32 text and wrapping",&fail);

    let same_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i32 { let x:i32=1; return x+x; }\n",".");
    let same_eff:map.StringMap[i32]=analyze(same_unit.decls);
    let same_raw:ZModule=build_module(same_unit.decls,same_eff,same_unit.origins);
    let nested_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i32 { if (true) { return 1+2; } else { return 0; } }\n",".");
    let nested_eff:map.StringMap[i32]=analyze(nested_unit.decls);
    let nested_raw:ZModule=build_module(nested_unit.decls,nested_eff,nested_unit.origins);
    let i64_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i64 { return (1 as i64)+(2 as i64); }\n",".");
    let i64_eff:map.StringMap[i32]=analyze(i64_unit.decls);
    let i64_raw:ZModule=build_module(i64_unit.decls,i64_eff,i64_unit.origins);
    let i64_add_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i64 { let x:i64=1+2; return x; }\n",".");
    let i64_add_eff:map.StringMap[i32]=analyze(i64_add_unit.decls);
    let i64_add_raw:ZModule=build_module(i64_add_unit.decls,i64_add_eff,i64_add_unit.origins);
    let i64_add_proposal:ZirTransformProposal=zir_propose_const_i64_add(i64_add_raw);
    let i64_add_policy:ZirTransformPolicy=zir_transform_policy_const_i64_add_default();
    let i64_add_check:ZirTransformCheck=zir_check_const_i64_add_source_policy(
        i64_add_raw,i64_add_unit.decls,i64_add_unit.origins,i64_add_policy,i64_add_proposal);
    let i64_add_selected:ZirAuthority=zir_select_foreground_transform_source_policy(
        i64_add_raw,i64_add_unit.decls,i64_add_unit.origins,i64_add_policy,i64_add_proposal);
    za_check(i64_add_proposal.proposed==1&&i64_add_check.accepted==1&&
        i64_add_selected.transform_count==1&&
        @strEq(i64_add_selected.transform_rule,zir_transform_rule_const_i64_add())&&
        @strEq(i64_add_selected.transform_status,"foreground_i64_source_policy_checked")&&
        @strEq(i64_add_selected.certificate.result_type,"i64")&&
        za_count_constant_value(i64_add_selected.module.funcs.data[0].body,"3")==1,
        "bounded i64 add certificate binds explicit source policy and result",&fail);
    let i64_bad_policy:ZirTransformPolicy=zir_transform_policy_const_i32_add_default();
    let i64_bad_selected:ZirAuthority=zir_select_foreground_transform_source_policy(
        i64_add_raw,i64_add_unit.decls,i64_add_unit.origins,i64_bad_policy,i64_add_proposal);
    za_check(i64_bad_selected.transform_count==0&&
        @strEq(i64_bad_selected.transform_status,"candidate_rejected_raw_fallback")&&
        zir_module_equal(i64_bad_selected.module,i64_add_raw)==1,
        "i64 certificate rejects mismatched arithmetic policy to raw",&fail);
    let i64_large_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i64 { let x:i64=4611686018427387904+1; return x; }\n",".");
    let i64_large_eff:map.StringMap[i32]=analyze(i64_large_unit.decls);
    let i64_large_raw:ZModule=build_module(i64_large_unit.decls,i64_large_eff,i64_large_unit.origins);
    za_check(zir_propose_const_i64_add(i64_large_raw).proposed==0,
        "i64 certificate rejects operands outside its defined no-overflow bound",&fail);
    let bool_eq_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() bool { return true == false; }\n",".");
    let bool_eq_eff:map.StringMap[i32]=analyze(bool_eq_unit.decls);
    let bool_eq_raw:ZModule=build_module(bool_eq_unit.decls,bool_eq_eff,bool_eq_unit.origins);
    let bool_eq_proposal:ZirTransformProposal=zir_propose_const_bool_cmp(bool_eq_raw);
    let bool_policy:ZirTransformPolicy=zir_transform_policy_const_bool_cmp_default();
    let bool_eq_check:ZirTransformCheck=zir_check_const_bool_cmp_source_policy(
        bool_eq_raw,bool_eq_unit.decls,bool_eq_unit.origins,bool_policy,bool_eq_proposal);
    let bool_eq_selected:ZirAuthority=zir_select_foreground_transform_source_policy(
        bool_eq_raw,bool_eq_unit.decls,bool_eq_unit.origins,bool_policy,bool_eq_proposal);
    za_check(bool_eq_proposal.proposed==1&&bool_eq_check.accepted==1&&
        bool_eq_selected.transform_count==1&&
        @strEq(bool_eq_selected.transform_status,"foreground_bool_source_policy_checked")&&
        @strEq(bool_eq_selected.transform_rule,zir_transform_rule_const_bool_cmp())&&
        @strEq(bool_eq_selected.transform_checker,zir_transform_checker_const_bool_cmp())&&
        @strEq(bool_eq_selected.certificate.result_type,"bool")&&
        bool_eq_selected.certificate.lhs_value==1&&bool_eq_selected.certificate.rhs_value==0&&
        bool_eq_selected.certificate.result_value==0&&
        za_count_ops(bool_eq_selected.module.funcs.data[0].body,"arith.cmpi")==0&&
        @strEq(attr_val(bool_eq_selected.module.funcs.data[0].body.ops.data[bool_eq_selected.certificate.op_index],"value"),"0"),
        "bounded bool equality certificate binds source policy and result",&fail);
    let bool_ne_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() bool { return true != false; }\n",".");
    let bool_ne_eff:map.StringMap[i32]=analyze(bool_ne_unit.decls);
    let bool_ne_raw:ZModule=build_module(bool_ne_unit.decls,bool_ne_eff,bool_ne_unit.origins);
    let bool_ne_proposal:ZirTransformProposal=zir_propose_const_bool_cmp(bool_ne_raw);
    let bool_ne_selected:ZirAuthority=zir_select_foreground_transform_source_policy(
        bool_ne_raw,bool_ne_unit.decls,bool_ne_unit.origins,bool_policy,bool_ne_proposal);
    za_check(bool_ne_proposal.proposed==1&&bool_ne_selected.transform_count==1&&
        @strEq(bool_ne_selected.transform_status,"foreground_bool_source_policy_checked")&&
        bool_ne_selected.certificate.result_value==1&&
        za_count_ops(bool_ne_selected.module.funcs.data[0].body,"arith.cmpi")==0&&
        @strEq(attr_val(bool_ne_selected.module.funcs.data[0].body.ops.data[bool_ne_selected.certificate.op_index],"value"),"1"),
        "bounded bool inequality certificate folds ne",&fail);
    let bool_bad_policy:ZirAuthority=zir_select_foreground_transform_source_policy(
        bool_eq_raw,bool_eq_unit.decls,bool_eq_unit.origins,
        zir_transform_policy_const_i32_add_default(),bool_eq_proposal);
    za_check(bool_bad_policy.transform_count==0&&
        @strEq(bool_bad_policy.transform_status,"candidate_rejected_raw_fallback")&&
        zir_module_equal(bool_bad_policy.module,bool_eq_raw)==1,
        "bool certificate rejects mismatched policy to raw",&fail);
    let bool_bad_candidate:ZirTransformProposal=zir_propose_const_bool_cmp(bool_eq_raw);
    bool_bad_candidate.candidate.funcs.data[0].body.ops.data[bool_bad_candidate.certificate.op_index].attrs.data[0].val="1";
    bool_bad_candidate.certificate.after=zir_semantic_identity(bool_bad_candidate.candidate);
    za_check(zir_check_const_bool_cmp(bool_eq_raw,bool_bad_candidate).accepted==0&&
        zir_select_foreground_transform_source_policy(bool_eq_raw,bool_eq_unit.decls,
            bool_eq_unit.origins,bool_policy,bool_bad_candidate).transform_count==0,
        "bool certificate rejects mutated result to raw",&fail);
    let bad_cmp_contract:ZModule=zir_clone_module(bool_eq_raw);
    let bad_cmp_i:i32=0;
    while(bad_cmp_i<bad_cmp_contract.funcs.data[0].body.ops.len){
        if(@strEq(bad_cmp_contract.funcs.data[0].body.ops.data[bad_cmp_i].name,"arith.cmpi")){
            bad_cmp_contract.funcs.data[0].body.ops.data[bad_cmp_i].attrs.data[0].val="unordered";
        }
        bad_cmp_i=bad_cmp_i+1;
    }
    za_check(zir_verify_contracts(bad_cmp_contract).valid==0,
        "independent IR contract rejects unknown comparison predicate",&fail);
    let effect_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i32 { print_i32(7); return 1+2; }\n",".");
    let effect_eff:map.StringMap[i32]=analyze(effect_unit.decls);
    let effect_raw:ZModule=build_module(effect_unit.decls,effect_eff,effect_unit.origins);
    let noncanonical_raw:ZModule=zir_clone_module(overflow_raw);
    noncanonical_raw.funcs.data[good.certificate.function_index].body.ops.data[
        good.certificate.lhs_def_index].attrs.data[0].val="02147483647";
    let duplicate_raw:ZModule=zir_clone_module(overflow_raw);
    let duplicate_value:ZVal=duplicate_raw.funcs.data[good.certificate.function_index].body.ops.data[
        good.certificate.lhs_def_index].results.data[0];
    duplicate_raw.funcs.data[good.certificate.function_index].body.ops.data[
        good.certificate.rhs_def_index].results.data[0]=duplicate_value;
    duplicate_raw.funcs.data[good.certificate.function_index].body.ops.data[
        good.certificate.op_index].operands.data[1]=duplicate_value;
    za_check(zir_propose_const_i32_add(same_raw).proposed==0&&
        zir_propose_const_i32_add(nested_raw).proposed==0&&
        zir_propose_const_i32_add(i64_raw).proposed==0&&
        zir_propose_const_i32_add(effect_raw).proposed==0&&
        zir_propose_const_i32_add(noncanonical_raw).proposed==0&&
        verify_module(duplicate_raw)==0&&zir_module_ssa_unique_all(duplicate_raw)==0&&
        zir_propose_const_i32_add(duplicate_raw).proposed==0,
        "same-definition nested non-i32 effectful noncanonical and duplicate IR stay out of domain",&fail);

    let loop_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i32 { let x:i32=0; while (x < 1) { x=x+1; } return x; }\n",".");
    let loop_eff:map.StringMap[i32]=analyze(loop_unit.decls);
    let loop_ir:ZirAuthority=zir_prepare_production_with_origins(loop_unit.decls,loop_eff,loop_unit.origins);
    if(loop_ir.coverage_complete==0){_zag_eprintln(_zag_str_concat(
        "loop coverage errors=",_zag_i64_to_str(loop_ir.coverage_errors as i64)));}
    za_check(loop_ir.valid==1&&loop_ir.coverage_complete==1,
        "structured while has complete SSA region coverage",&fail);
    let bad_loop_control:ZModule=zir_clone_module(loop_ir.module);
    za_check(za_mutate_loop_condition_marker(&bad_loop_control)==1&&
        zir_verify_control_flow(bad_loop_control)>0&&
        zir_verify_contracts(bad_loop_control).valid==0,
        "while condition terminator is bound to its condition region",&fail);

    let region_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn cleanup() void { return; }\nfn main() i32 { defer cleanup(); switch (1) { 1 => { return 7; } else => { return 0; } } }\n",".");
    let region_eff:map.StringMap[i32]=analyze(region_unit.decls);
    let region_ir:ZirAuthority=zir_prepare_production_with_origins(region_unit.decls,region_eff,region_unit.origins);
    let region_body:ZBlock=region_ir.module.funcs.data[1].body;
    za_check(region_ir.coverage_complete==1&&za_count_ops(region_body,"zag.defer")==1&&
        za_count_ops(region_body,"zag.switch")==1&&za_count_ops(region_body,"zag.case")==1&&
        za_count_ops(region_body,"zag.default")==1,
        "defer and noncapturing switch have explicit semantic regions",&fail);
    let bad_switch_control:ZModule=zir_clone_module(region_ir.module);
    za_check(za_mutate_switch_duplicate_default(&bad_switch_control)==1&&
        zir_verify_control_flow(bad_switch_control)>0&&
        zir_verify_contracts(bad_switch_control).valid==0,
        "switch arms require one leading case/default marker",&fail);
    let bad_break_control:ZModule=zir_clone_module(authority.module);
    let stray_break:ZOp=mk_op("scf.break");
    push[ZOp](&bad_break_control.funcs.data[0].body.ops,stray_break);
    za_check(zir_verify_control_flow(bad_break_control)>0,
        "break outside a loop region is rejected",&fail);

    let aggregate:CompilationUnit=parse_compilation_unit_dir(
        "struct Pair { x:i32, y:i32 }\nfn main() i32 { let p:Pair=Pair{.x=7,.y=9}; let x:i32=p.x; let s:[]u8=\"hi\"; let c:u8=s[0]; let tail:[]u8=s[1..]; return x as i32; }\n",".");
    let aggregate_eff:map.StringMap[i32]=analyze(aggregate.decls);
    let aggregate_ir:ZirAuthority=zir_prepare_production_with_origins(aggregate.decls,aggregate_eff,aggregate.origins);
    let aggregate_body:ZBlock=aggregate_ir.module.funcs.data[0].body;
    za_check(aggregate_ir.coverage_complete==1&&za_count_ops(aggregate_body,"zag.struct.constant")==1&&
        za_count_ops(aggregate_body,"zag.field")==1&&za_count_ops(aggregate_body,"zag.string.constant")==1&&
        za_count_ops(aggregate_body,"zag.index")==1&&za_count_ops(aggregate_body,"zag.slice")==1&&
        za_count_ops(aggregate_body,"zag.cast")==1,
        "typed aggregate string index slice and cast operations have SSA coverage",&fail);

    let call_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn add(x:i32,y:i32) i32 { return x+y; } fn main() i32 { return add(40,2); }\n",".");
    let call_eff:map.StringMap[i32]=analyze(call_unit.decls);
    let call_ir:ZirAuthority=zir_prepare_production_with_origins(
        call_unit.decls,call_eff,call_unit.origins);
    let bad_call_type:ZModule=zir_clone_module(call_ir.module);
    let bad_call_count:ZModule=zir_clone_module(call_ir.module);
    let bad_call_result:ZModule=zir_clone_module(call_ir.module);
    za_check(call_ir.valid==1&&
        za_mutate_call_signature(&bad_call_type,1)==1&&
        zir_verify_contracts(bad_call_type).valid==0&&
        za_mutate_call_signature(&bad_call_count,2)==1&&
        zir_verify_contracts(bad_call_count).valid==0&&
        za_mutate_call_signature(&bad_call_result,3)==1&&
        zir_verify_contracts(bad_call_result).valid==0,
        "resolved call parameter count types and result signatures are verified",&fail);
    let unresolved_call:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i32 { return missing(40); }\n",".");
    let unresolved_eff:map.StringMap[i32]=analyze(unresolved_call.decls);
    let unresolved_ir:ZirAuthority=zir_prepare_production_with_origins(
        unresolved_call.decls,unresolved_eff,unresolved_call.origins);
    za_check(unresolved_ir.coverage_complete==0&&unresolved_ir.coverage_errors>0&&
        @strEq(unresolved_ir.transform_status,"verified_raw_ast_bridge_incomplete"),
        "unresolved calls fail closed before typed-IR authority",&fail);

    let embed_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i32 { let asset: []u8 = #embed(\"tests/package_resolution/workspace/vendor_consumer/vendor/toolkit/src/detail/assets/value.txt\"); if (asset[0] != 118) { return 0; } return 42; }\n",
        ".");
    let embed_eff:map.StringMap[i32]=analyze(embed_unit.decls);
    let embed_ir:ZirAuthority=zir_prepare_production_with_origins(
        embed_unit.decls,embed_eff,embed_unit.origins);
    if(embed_ir.valid==0){
        _zag_eprintln(_zag_str_concat("embed authority diagnostic: ",embed_ir.contract_reason));
    }
    za_check(embed_ir.valid==1&&embed_ir.verify_errors==0&&embed_ir.coverage_complete==1,
        "embedded byte indexing remains represented by production IR",&fail);

    let unsupported:CompilationUnit=parse_compilation_unit_dir(
        "struct Pair { x:i32 }\nfn main() i32 { let p:Pair=Pair{.x=1}; p.x=2; return p.x; }\n",".");
    let unsupported_eff:map.StringMap[i32]=analyze(unsupported.decls);
    let partial:ZirAuthority=zir_prepare_production_with_origins(unsupported.decls,unsupported_eff,unsupported.origins);
    za_check(partial.valid==1&&partial.coverage_complete==0&&partial.transform_count==0&&
        @strEq(partial.transform_status,"verified_raw_ast_bridge_incomplete"),
        "incomplete raw coverage is named as an AST bridge rather than full verification",&fail);

    let bad_module:ZModule=zir_clone_module(authority.module);
    let bad:ZOp=mk_op("func.return");
    push[ZVal](&bad.operands,zir_value("%never-defined","i32","unknown",
        "unknown","unknown","unknown",zir_unknown_origin()));
    push[ZOp](&bad_module.funcs.data[0].body.ops,bad);
    za_check(verify_module(bad_module)>0,
        "def-before-use verifier rejects forged IR",&fail);

    let scoped_regions:ZModule=zir_clone_module(authority.module);
    let child_block:ZBlock=one_block();
    let child_const:ZOp=mk_op("arith.constant");
    let child_value:ZVal=zir_value("%child-only","i32","ssa","none",
        "function","target-default",zir_unknown_origin());
    push[ZVal](&child_const.results,child_value);
    push[ZAttr](&child_const.attrs,ZAttr{.key="value",.val="7"});
    push[ZOp](&child_block.ops,child_const);
    let child_region:ZRegion=region_of(child_block);
    let region_op:ZOp=mk_op("scf.if");
    push[ZRegion](&region_op.regions,child_region);
    push[ZOp](&scoped_regions.funcs.data[0].body.ops,region_op);
    let escaped_return:ZOp=mk_op("func.return");
    push[ZVal](&escaped_return.operands,child_value);
    push[ZOp](&scoped_regions.funcs.data[0].body.ops,escaped_return);
    za_check(verify_module(scoped_regions)>0,
        "nested-region definitions cannot escape into the parent verifier scope",&fail);

    let sibling_regions:ZModule=zir_clone_module(authority.module);
    let sibling_def_block:ZBlock=one_block();
    let sibling_const:ZOp=mk_op("arith.constant");
    let sibling_value:ZVal=zir_value("%sibling-only","i32","ssa","none",
        "function","target-default",zir_unknown_origin());
    push[ZVal](&sibling_const.results,sibling_value);
    push[ZAttr](&sibling_const.attrs,ZAttr{.key="value",.val="9"});
    push[ZOp](&sibling_def_block.ops,sibling_const);
    let sibling_use_block:ZBlock=one_block();
    let sibling_return:ZOp=mk_op("func.return");
    push[ZVal](&sibling_return.operands,sibling_value);
    push[ZOp](&sibling_use_block.ops,sibling_return);
    let sibling_if:ZOp=mk_op("scf.if");
    push[ZRegion](&sibling_if.regions,region_of(sibling_def_block));
    push[ZRegion](&sibling_if.regions,region_of(sibling_use_block));
    push[ZOp](&sibling_regions.funcs.data[0].body.ops,sibling_if);
    za_check(verify_module(sibling_regions)>0,
        "nested-region definitions cannot leak into a sibling verifier scope",&fail);

    if(fail==0){_zag_println("zir-authority pass=75 fail=0");return 0;}
    return 1;
}
