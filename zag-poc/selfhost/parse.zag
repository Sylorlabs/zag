        push[*Node](out, new(Node{ .fn_decl = FnDecl{
            .name = "__zag_compiler_script_uncaught_7f3a", .tparams = make[[]u8](1), .params = report_params,
            .ret = "i32", .annots = make[[]u8](1), .body = report_body,
            .is_extern = 0, .ret_eff = "", .caps = 0, .cap_names = "",
            .cap_types = "", .line = 0, .is_pub = 0, .origin = "" } }));
        let hidden_params: ArrayList[Param] = make[Param](1);
        push[Param](&hidden_params, Param{ .name = "__zag_script_context", .pty = "*opaque", .eff = "", .contract = "", .calign = 0 });
        push[*Node](out, new(Node{ .fn_decl = FnDecl{
            .name = "__zag_compiler_script_body_7f3a", .tparams = make[[]u8](1), .params = hidden_params,
            .ret = "!i32", .annots = make[[]u8](1), .body = script_body,
            .is_extern = 0, .ret_eff = "", .caps = 0, .cap_names = "",
            .cap_types = "", .line = 1, .is_pub = 0, .origin = "<root>" } }));

        let wrapper: ArrayList[*Node] = make[*Node](5);
        // Compiler-only ScriptContext ABI:
        //   memory limit, capability bits, validated execution-policy bits.
        // The foreground driver replaces these defaults with project/CLI
        // policy after parsing. They are never source-visible declarations.
        let init_args: ArrayList[*Node] = make[*Node](3);
        push[*Node](&init_args, mk_int("67108864"));
        push[*Node](&init_args, mk_int("7"));
        push[*Node](&init_args, mk_int("16843009"));
        push[*Node](&wrapper, mk_let("__zag_script_context", "*opaque", 1, 1,
            mk_call(mk_ident("_zag_script_context_init"), init_args)));
        let body_args: ArrayList[*Node] = make[*Node](1);
        push[*Node](&body_args, mk_ident("__zag_script_context"));
        let caught_args: ArrayList[*Node] = make[*Node](3);
        push[*Node](&caught_args, mk_call(mk_ident("__zag_compiler_script_body_7f3a"), body_args));
        push[*Node](&caught_args, mk_ident("__zag_script_error_code"));
        let report_args: ArrayList[*Node] = make[*Node](1);
        push[*Node](&report_args, mk_ident("__zag_script_error_code"));
        push[*Node](&caught_args, mk_call(mk_ident("__zag_compiler_script_uncaught_7f3a"), report_args));
        push[*Node](&wrapper, mk_let("__zag_script_status", "i32", 1, 1,
            mk_call(mk_ident("__catchc"), caught_args)));
        let shutdown_args: ArrayList[*Node] = make[*Node](1);
        push[*Node](&shutdown_args, mk_ident("__zag_script_context"));
        push[*Node](&wrapper, mk_estmt(mk_call(mk_ident("_zag_script_context_shutdown"), shutdown_args)));
        push[*Node](&wrapper, mk_ret(1, mk_ident("__zag_script_status")));
        push[*Node](out, new(Node{ .fn_decl = FnDecl{
            .name = "main", .tparams = make[[]u8](1), .params = make[Param](1),
            .ret = "i32", .annots = make[[]u8](1), .body = wrapper,
            .is_extern = 0, .ret_eff = "", .caps = 0, .cap_names = "",
            .cap_types = "", .line = 0, .is_pub = 0, .origin = "" } }));
    }
}

// Parse a whole program, resolving @imports relative to `base_dir`.
fn parse_compilation_unit_dir(src: []u8, base_dir: []u8) CompilationUnit {
    let seen: ArrayList[[]u8] = make[[]u8](8);
    let decls: ArrayList[*Node] = make[*Node](8);
    let aliases: ArrayList[[]u8] = make[[]u8](4);
    let loading: ArrayList[[]u8] = make[[]u8](8);
    let modules:ArrayList[ResolvedModule]=make[ResolvedModule](8);let imports:ArrayList[ResolvedImport]=make[ResolvedImport](8);let resources:ArrayList[ResolvedResource]=make[ResolvedResource](8);let origins:ArrayList[NodeOrigin]=make[NodeOrigin](64);push[ResolvedModule](&modules,ResolvedModule{.path="<root>",.source=src});
    // Validate zag.mod deps before compiling
    check_zag_mod(base_dir);
    let profile_code: i32 = 0;
    resolve_src(src, base_dir, &seen, &decls, &aliases, &loading, 1, &profile_code,"<root>",&modules,&imports,&resources,&origins);
    // Global alias pass: collapse every `alias.member` → `alias__member` across
    // all decls (aliases propagate through flat re-imports).
    rewrite_decls(decls, aliases, &origins);
    let profile: ModuleProfile = ModuleProfile.strict;
    if (profile_code == 1) { profile = ModuleProfile.script; }
    let registry_graph_complete:i32=1;
    let registry_graph_edges:[]u8=parser_registry_graph_edges(imports,base_dir,
        &registry_graph_complete);
    if(registry_graph_complete==1&&registry_graph_edges.len>0){
        let nested_graph_lock:i32=0;
        let graph_lock_path:[]u8=parser_registry_graph_lock_path(imports,base_dir,
            &nested_graph_lock);
        if(nested_graph_lock!=0){
            _zag_eprintln("zag: error: nested registry graph lock requires root-owned aggregate graph admission");
            _zag_exit(1);
        }
        if(graph_lock_path.len>0){
            let graph_lock_read:PackageNoFollowRead=package_import_read_nofollow(
                graph_lock_path);
            let graph_ok:i32=(graph_lock_read.ok==1&&
                package_import_graph_lock_edges_valid(graph_lock_read.bytes,
                    registry_graph_edges)==1) as i32;
            package_import_free_read(graph_lock_read.bytes);
            _zag_str_free(graph_lock_path);
            if(graph_ok==0){
                _zag_eprintln("zag: error: explicit registry graph lock does not cover the complete import graph");
                _zag_exit(1);
            }
        }
    }
    return CompilationUnit{ .profile = profile, .decls = decls, .modules=modules, .imports=imports, .resources=resources, .origins=origins,
        .registry_graph_edges=registry_graph_edges,
        .registry_graph_complete=registry_graph_complete };
}

fn script_default_memory_limit() i64 { return 67108864; }
fn script_min_memory_limit() i64 { return 1048576; }
fn script_max_memory_limit() i64 { return 2147483648; }

// Change only the compiler-generated root wrapper's context limit. Imported
// modules have no wrapper and are never visited. Returns 0 on success, 1 for
// an invalid range or malformed/non-script unit.
fn compilation_unit_set_script_memory_limit(unit: *CompilationUnit, limit_bytes: i64) i32 {
    if (limit_bytes < script_min_memory_limit() || limit_bytes > script_max_memory_limit()) { return 1; }
    if (unit.*.profile != ModuleProfile.script) { return 1; }
    let text: []u8 = _zag_i64_to_str(limit_bytes);
    let i: i32 = 0;
    while (i < len[*Node](unit.*.decls)) {
        switch (get[*Node](unit.*.decls, i).*) {
            .fn_decl => |f| {
                if (@strEq(f.name, "main") && len[*Node](f.body) > 0) {
                    switch (get[*Node](f.body, 0).*) {
                        .let_ => |binding| { switch (binding.expr.*) {
                            .call => |call| { switch (call.callee.*) {
                                .id => |id| {
                                    if (@strEq(id.name, "_zag_script_context_init") && len[*Node](call.args) == 3) {
                                        let arg: *Node = get[*Node](call.args, 0);
                                        arg.* = mk_int(text).*;
                                        return 0;
                                    }
                                }
                                else => { }
                            } }
                            else => { }
                        } }
                        else => { }
                    }
                }
            }
            else => { }
        }
        i = i + 1;
    }
    return 1;
}

// Packed policy fields are byte-sized ids:
// allocator | cpu<<8 | device<<16 | layout<<24.
// Allocator ids 1 (one process-lifetime arena) and 2 (bounded per-allocation
// heap with deterministic shutdown reclamation), device=CPU,
// layout=compiler-owned, and generic/native x86 CPU policies are implementable.
// Keeping this
// mutation on the compiler-owned root wrapper ensures imported modules receive
// neither hidden context nor policy changes.
fn script_execution_policy_bits(allocator_id:i32, cpu_id:i32,
    device_id:i32, layout_id:i32) i64 {
    return (allocator_id as i64) + ((cpu_id as i64) * 256) +
        ((device_id as i64) * 65536) + ((layout_id as i64) * 16777216);
}

fn script_execution_policy_supported(bits:i64) i32 {
    if (bits == script_execution_policy_bits(1, 1, 1, 1)) { return 1; }
    if (bits == script_execution_policy_bits(1, 2, 1, 1)) { return 1; }
    if (bits == script_execution_policy_bits(2, 1, 1, 1)) { return 1; }
    if (bits == script_execution_policy_bits(2, 2, 1, 1)) { return 1; }
    return 0;
}

fn compilation_unit_set_script_runtime_policy(unit:*CompilationUnit,
    capability_bits:i64, execution_policy_bits:i64) i32 {
    if (unit.*.profile != ModuleProfile.script || capability_bits < 0 ||
        capability_bits > 15 ||
        script_execution_policy_supported(execution_policy_bits) == 0) { return 1; }
    let i:i32 = 0;
    while (i < len[*Node](unit.*.decls)) {
        switch (get[*Node](unit.*.decls, i).*) {
            .fn_decl => |f| {
                if (@strEq(f.name, "main") && len[*Node](f.body) > 0) {
                    switch (get[*Node](f.body, 0).*) {
                        .let_ => |binding| { switch (binding.expr.*) {
                            .call => |call| { switch (call.callee.*) {
                                .id => |id| {
                                    if (@strEq(id.name, "_zag_script_context_init") &&
                                        len[*Node](call.args) == 3) {
                                        let capabilities:*Node = get[*Node](call.args, 1);
                                        capabilities.* =
                                            mk_int(_zag_i64_to_str(capability_bits)).*;
                                        let execution:*Node = get[*Node](call.args, 2);
                                        execution.* =
                                            mk_int(_zag_i64_to_str(execution_policy_bits)).*;
                                        return 0;
                                    }
                                }
                                else => { }
                            } }
                            else => { }
                        } }
                        else => { }
                    }
                }
            }
            else => { }
        }
        i = i + 1;
    }
    return 1;
}

fn compilation_unit_set_script_source_label(unit: *CompilationUnit, path: []u8) i32 {
    if (unit.*.profile != ModuleProfile.script) { return 1; }
    let i: i32 = 0;
    while (i < len[*Node](unit.*.decls)) {
        switch (get[*Node](unit.*.decls, i).*) {
            .fn_decl => |f| {
                if (@strEq(f.name, "__zag_compiler_script_uncaught_7f3a")) {
                    let j: i32 = 0;
                    while (j < len[*Node](f.body)) {
                        switch (get[*Node](f.body, j).*) {
                            .estmt => |statement| { switch (statement.expr.*) {
                                .call => |call| {
                                    if (len[*Node](call.args) == 1) {
                                        let arg: *Node = get[*Node](call.args, 0);
                                        switch (arg.*) {
                                            .slit => |literal| {
                                                if (literal.text.len >= 22 && @strEq(literal.text[0..22], "operation: root script")) {
                                                    arg.* = mk_str(_zag_str_concat("source: ", _zag_str_concat(path,
                                                        _zag_str_concat("; ",literal.text)))).*;
                                                    return 0;
                                                }
                                            }
                                            else => { }
                                        }
                                    }
                                }
                                else => { }
                            } }
                            else => { }
                        }
                        j = j + 1;
                    }
                }
            }
            else => { }
        }
        i = i + 1;
    }
    return 1;
}

// Explicit compiler/embedding API. The supplied value is authoritative over
// the 64 MiB default. Existing parse_compilation_unit_dir callers are unchanged.
fn parse_compilation_unit_dir_with_script_limit(src: []u8, base_dir: []u8, limit_bytes: i64) CompilationUnit {
    let unit: CompilationUnit = parse_compilation_unit_dir(src, base_dir);
    if (compilation_unit_set_script_memory_limit(&unit, limit_bytes) != 0) {
        _zag_eprintln("Zag Script memory limit must be between 1048576 and 2147483648 bytes and requires a script root");
        _zag_exit(1);
    }
    return unit;
}

fn parse_program_dir(src: []u8, base_dir: []u8) ArrayList[*Node] {
    return parse_compilation_unit_dir(src, base_dir).decls;
}

// Parse a whole program (decls: struct / enum / union / fn / extern fn).
// Back-compat entry: resolves imports relative to the current directory.
fn parse_program(src: []u8) ArrayList[*Node] {
    return parse_program_dir(src, "");
}
