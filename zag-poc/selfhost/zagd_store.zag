// Persistent cache policy/transaction primitives. Cache data is advisory only.
@import("zagd.zag")
@import("zagd_linux.zag")

struct ZagdStoreKey { compiler:ZagdHash, target:ZagdHash, profile:ZagdHash, config:ZagdHash, snapshot:ZagdHash }
struct ZagdStoreRecord { key:ZagdStoreKey, checksum:ZagdHash, bytes:i64, complete:i32, executable_authority:i32, timestamp_ms:i64 }
struct ZagdFileRecord { path:[]u8, content:ZagdHash }
struct ZagdSnapshotRecord { identity:ZagdHash, parent:ZagdHash, file_count:i32, valid:i32 }
struct ZagdArtifactRecord { identity:ZagdHash, source:ZagdHash, valid:i32 }

fn zagd_parse_nonnegative(s:[]u8)i64{if(s.len==0){return 0-1;}let n:i64=0;let i:i32=0;while(i<s.len){if(s[i]<'0'||s[i]>'9'){return 0-1;}n=n*10+((s[i] as i64)-48);i=i+1;}return n;}
fn zagd_record_value(text:[]u8,key:[]u8)[]u8{let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>key.len&&@strEq(line[0..key.len],key)&&line[key.len]=='='){return line[key.len+1..];}start=i+1;}i=i+1;}return "";}
fn zagd_find_checksum(text:[]u8)i32{let marker:[]u8="checksum_first=";let i:i32=0;while(i+marker.len<=text.len){let j:i32=0;while(j<marker.len&&text[i+j]==marker[j]){j=j+1;}if(j==marker.len&&(i==0||text[i-1]=='\n')){return i;}i=i+1;}return 0-1;}
fn zstore_tab_field(line:[]u8,want:i32)[]u8{let field:i32=0;let start:i32=0;let i:i32=0;while(i<=line.len){if(i==line.len||line[i]=='\t'){if(field==want){return line[start..i];}field=field+1;start=i+1;}i=i+1;}return "";}
fn zstore_final_field(text:[]u8,key:[]u8)i32{let value:[]u8=zagd_record_value(text,key);let i:i32=0;while(i+key.len+1<=text.len){if((i==0||text[i-1]=='\n')&&@strEq(text[i..i+key.len],key)&&text[i+key.len]=='='){return (i+key.len+1+value.len+1==text.len) as i32;}i=i+1;}return 0;}

// Validate the persisted advisory snapshot before reusing its identity. Any
// truncation, corruption, old format, or executable-authority claim is a miss.
fn zagd_snapshot_record_decode(text:[]u8)ZagdSnapshotRecord{
    let bad:ZagdSnapshotRecord=ZagdSnapshotRecord{.identity=zagd_hash_empty(),.parent=zagd_hash_empty(),.file_count=0,.valid=0};
    if(!@strEq(zagd_record_value(text,"advisory"),"true")||!@strEq(zagd_record_value(text,"executable_authority"),"false")){return bad;}
    let mark:i32=zagd_find_checksum(text);if(mark<0){return bad;}let body:[]u8=text[0..mark];
    let sf:i64=zagd_parse_nonnegative(zagd_record_value(text,"snapshot_first"));let ss:i64=zagd_parse_nonnegative(zagd_record_value(text,"snapshot_second"));let pf:i64=zagd_parse_nonnegative(zagd_record_value(text,"parent_first"));let count:i64=zagd_parse_nonnegative(zagd_record_value(text,"file_count"));let cf:i64=zagd_parse_nonnegative(zagd_record_value(text,"checksum_first"));let cs:i64=zagd_parse_nonnegative(zagd_record_value(text,"checksum_second"));
    if(sf<0||ss<0||pf<0||count<0||count>2147483647||cf<0||cs<0){return bad;}let sum:ZagdHash=zagd_content_hash(body);if(sum.first!=cf||sum.second!=cs){return bad;}
    return ZagdSnapshotRecord{.identity=ZagdHash{.first=sf,.second=ss,.bytes=0},.parent=ZagdHash{.first=pf,.second=0,.bytes=0},.file_count=count as i32,.valid=1};
}
fn zagd_snapshot_record_compatible(text:[]u8,compiler:[]u8,target:[]u8,mode:[]u8)ZagdSnapshotRecord{
    let decoded:ZagdSnapshotRecord=zagd_snapshot_record_decode(text);if(decoded.valid==0){return decoded;}
    if(!@strEq(zagd_record_value(text,"compiler"),compiler)||!@strEq(zagd_record_value(text,"target"),target)||!@strEq(zagd_record_value(text,"mode"),mode)){decoded.valid=0;}
    return decoded;
}
fn zagd_artifact_record_decode(text:[]u8,compiler:[]u8,target:[]u8,source:ZagdHash)ZagdArtifactRecord{let bad:ZagdArtifactRecord=ZagdArtifactRecord{.identity=zagd_hash_empty(),.source=zagd_hash_empty(),.valid=0};if(!@strEq(zagd_record_value(text,"format"),"zagd-artifact-index-v1")||!@strEq(zagd_record_value(text,"advisory"),"true")||!@strEq(zagd_record_value(text,"executable_authority"),"false")||!@strEq(zagd_record_value(text,"complete"),"true")||!@strEq(zagd_record_value(text,"compiler"),compiler)||!@strEq(zagd_record_value(text,"target"),target)||zstore_final_field(text,"checksum_second")==0){return bad;}let mark:i32=zagd_find_checksum(text);if(mark<0){return bad;}let sum:ZagdHash=zagd_content_hash(text[0..mark]);if(zagd_parse_nonnegative(zagd_record_value(text,"checksum_first"))!=sum.first||zagd_parse_nonnegative(zagd_record_value(text,"checksum_second"))!=sum.second){return bad;}let sf:[]u8=zagd_record_value(text,"semantic_source");let ai:[]u8=zagd_record_value(text,"artifact_identity");let got_source:ZagdHash=ZagdHash{.first=zagd_parse_nonnegative(zstore_tab_field(sf,0)),.second=zagd_parse_nonnegative(zstore_tab_field(sf,1)),.bytes=zagd_parse_nonnegative(zstore_tab_field(sf,2))};let identity:ZagdHash=ZagdHash{.first=zagd_parse_nonnegative(zstore_tab_field(ai,0)),.second=zagd_parse_nonnegative(zstore_tab_field(ai,1)),.bytes=zagd_parse_nonnegative(zstore_tab_field(ai,2))};if(got_source.first<0||identity.first<0||zagd_hash_equal(got_source,source)==0){return bad;}return ZagdArtifactRecord{.identity=identity,.source=got_source,.valid=1};}

fn zagd_canonical_relative(path:[]u8) i32 {
    if(path.len==0||path[0]=='/'||path[path.len-1]=='/'){return 0;}
    let start:i32=0; let i:i32=0;
    while(i<=path.len){
        if(i<path.len&&path[i]=='\\'){return 0;}
        if(i==path.len||path[i]=='/'){
            if(i==start){return 0;}
            let n:i32=i-start;
            if(n==1&&path[start]=='.'){return 0;}
            if(n==2&&path[start]=='.'&&path[start+1]=='.'){return 0;}
            start=i+1;
        }
        i=i+1;
    }
    return 1;
}
fn zagd_store_key_equal(a:ZagdStoreKey,b:ZagdStoreKey)i32{return zagd_hash_equal(a.compiler,b.compiler)*zagd_hash_equal(a.target,b.target)*zagd_hash_equal(a.profile,b.profile)*zagd_hash_equal(a.config,b.config)*zagd_hash_equal(a.snapshot,b.snapshot);}
fn zagd_store_accept(r:ZagdStoreRecord,want:ZagdStoreKey,payload:[]u8,max:i64)i32{if(r.complete!=1||r.executable_authority!=0||r.bytes<0||r.bytes>max||r.bytes!=payload.len){return 0;}if(zagd_store_key_equal(r.key,want)==0){return 0;}return zagd_hash_equal(r.checksum,zagd_content_hash(payload));}
fn zagd_store_record(key:ZagdStoreKey,payload:[]u8,now:i64)ZagdStoreRecord{return ZagdStoreRecord{.key=key,.checksum=zagd_content_hash(payload),.bytes=payload.len,.complete=1,.executable_authority=0,.timestamp_ms=now};}
fn zagd_store_evict(current:i64,incoming:i64,limit:i64)i64{if(limit<0||incoming<0||incoming>limit){return 0-1;}if(current>limit-incoming){return current-(limit-incoming);}return 0;}
fn zagd_sys_rename()i64{return 82;}
fn zagd_sys_mkdir()i64{return 83;}
fn zagd_store_mkdir(path:[]u8)i32{let p:ArrayList[u8]=zagd_c_string(path);let rc:i64=_zag_raw_syscall(zagd_sys_mkdir(),zagd_ptr(p.data[0..p.len]),493,0,0,0,0);if(rc==0||rc==(0-17)){return 1;}return 0;}
// Caller supplies a unique temp path in the same directory. Rename is atomic on
// Linux for same-filesystem paths. Failed/incomplete writes never replace final.
fn zagd_store_transaction(temp:[]u8,final:[]u8,payload:[]u8)i32{if(_zag_write_file(temp,payload)!=0){return 0;}let a:ArrayList[u8]=zagd_c_string(temp);let b:ArrayList[u8]=zagd_c_string(final);let rc:i64=_zag_raw_syscall(zagd_sys_rename(),zagd_ptr(a.data[0..a.len]),zagd_ptr(b.data[0..b.len]),0,0,0,0);if(rc!=0){zagd_unlink(temp);return 0;}return 1;}
