// Persistent cache policy/transaction primitives. Cache data is advisory only.
@import("zagd.zag")
@import("zagd_linux.zag")

struct ZagdStoreKey { compiler:ZagdHash, target:ZagdHash, profile:ZagdHash, config:ZagdHash, snapshot:ZagdHash }
struct ZagdStoreRecord { key:ZagdStoreKey, checksum:ZagdHash, bytes:i64, complete:i32, executable_authority:i32, timestamp_ms:i64 }
struct ZagdFileRecord { path:[]u8, content:ZagdHash }

fn zagd_canonical_relative(path:[]u8) i32 {
    if(path.len==0||path[0]=='/'||path[path.len-1]=='/'){return 0;}
    let start:i32=0; let i:i32=0;
    while(i<=path.len){
        if(i<path.len&&path[i]=='\\'){return 0;}
        if(i==path.len||path[i]=='/'){
            if(i==start){return 0;}
            let n:i32=i-start;
            if(n==1&&path[start]=='.'){return 0;}
            if(n==2&&path[start]=='.'&&path[start+1]=='.'){return 0;}
            start=i+1;
        }
        i=i+1;
    }
    return 1;
}
fn zagd_store_key_equal(a:ZagdStoreKey,b:ZagdStoreKey)i32{return zagd_hash_equal(a.compiler,b.compiler)*zagd_hash_equal(a.target,b.target)*zagd_hash_equal(a.profile,b.profile)*zagd_hash_equal(a.config,b.config)*zagd_hash_equal(a.snapshot,b.snapshot);}
fn zagd_store_accept(r:ZagdStoreRecord,want:ZagdStoreKey,payload:[]u8,max:i64)i32{if(r.complete!=1||r.executable_authority!=0||r.bytes<0||r.bytes>max||r.bytes!=payload.len){return 0;}if(zagd_store_key_equal(r.key,want)==0){return 0;}return zagd_hash_equal(r.checksum,zagd_content_hash(payload));}
fn zagd_store_record(key:ZagdStoreKey,payload:[]u8,now:i64)ZagdStoreRecord{return ZagdStoreRecord{.key=key,.checksum=zagd_content_hash(payload),.bytes=payload.len,.complete=1,.executable_authority=0,.timestamp_ms=now};}
fn zagd_store_evict(current:i64,incoming:i64,limit:i64)i64{if(limit<0||incoming<0||incoming>limit){return 0-1;}if(current>limit-incoming){return current-(limit-incoming);}return 0;}
fn zagd_sys_rename()i64{return 82;}
// Caller supplies a unique temp path in the same directory. Rename is atomic on
// Linux for same-filesystem paths. Failed/incomplete writes never replace final.
fn zagd_store_transaction(temp:[]u8,final:[]u8,payload:[]u8)i32{if(_zag_write_file(temp,payload)!=0){return 0;}let a:ArrayList[u8]=zagd_c_string(temp);let b:ArrayList[u8]=zagd_c_string(final);let rc:i64=_zag_raw_syscall(zagd_sys_rename(),zagd_ptr(a.data[0..a.len]),zagd_ptr(b.data[0..b.len]),0,0,0,0);if(rc!=0){zagd_unlink(temp);return 0;}return 1;}
