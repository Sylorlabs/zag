// Persistent cache policy/transaction primitives. Cache data is advisory only.
@import("zagd.zag")
@import("zagd_linux.zag")

struct ZagdStoreKey { compiler:ZagdHash, target:ZagdHash, profile:ZagdHash, config:ZagdHash, snapshot:ZagdHash }
struct ZagdStoreRecord { key:ZagdStoreKey, checksum:ZagdHash, bytes:i64, complete:i32, executable_authority:i32, timestamp_ms:i64 }
struct ZagdFileRecord { path:[]u8, content:ZagdHash }
struct ZagdSnapshotRecord {
    identity:ZagdHash,
    parent:ZagdHash,
    root_project:ZagdHash,
    root_module:[]u8,
    root_module_present:i32,
    root_source:ZagdHash,
    semantic_graph:ZagdHash,
    semantic_graph_complete:i32,
    timestamp_ms:i64,
    file_count:i32,
    valid:i32,
}
struct ZagdArtifactRecord { identity:ZagdHash, source:ZagdHash, valid:i32 }

fn zagd_parse_nonnegative(s:[]u8)i64{if(s.len==0){return 0-1;}let n:i64=0;let i:i32=0;while(i<s.len){if(s[i]<'0'||s[i]>'9'){return 0-1;}n=n*10+((s[i] as i64)-48);i=i+1;}return n;}
fn zagd_record_value(text:[]u8,key:[]u8)[]u8{let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>key.len&&@strEq(line[0..key.len],key)&&line[key.len]=='='){return line[key.len+1..];}start=i+1;}i=i+1;}return "";}
fn zagd_find_checksum(text:[]u8)i32{let marker:[]u8="checksum_first=";let i:i32=0;while(i+marker.len<=text.len){let j:i32=0;while(j<marker.len&&text[i+j]==marker[j]){j=j+1;}if(j==marker.len&&(i==0||text[i-1]=='\n')){return i;}i=i+1;}return 0-1;}
fn zstore_tab_field(line:[]u8,want:i32)[]u8{let field:i32=0;let start:i32=0;let i:i32=0;while(i<=line.len){if(i==line.len||line[i]=='\t'){if(field==want){return line[start..i];}field=field+1;start=i+1;}i=i+1;}return "";}
fn zstore_final_field(text:[]u8,key:[]u8)i32{let value:[]u8=zagd_record_value(text,key);let i:i32=0;while(i+key.len+1<=text.len){if((i==0||text[i-1]=='\n')&&@strEq(text[i..i+key.len],key)&&text[i+key.len]=='='){return (i+key.len+1+value.len+1==text.len) as i32;}i=i+1;}return 0;}
fn zstore_single_field(text:[]u8,key:[]u8)i32{let count:i32=0;let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>key.len&&@strEq(line[0..key.len],key)&&line[key.len]=='='){count=count+1;}start=i+1;}i=i+1;}return (count==1) as i32;}
fn zstore_hash(text:[]u8,key:[]u8)ZagdHash{let bad:ZagdHash=ZagdHash{.first=0-1,.second=0-1,.bytes=0-1};let value:[]u8=zagd_record_value(text,key);let tabs:i32=0;let i:i32=0;while(i<value.len){if(value[i]=='\t'){tabs=tabs+1;}i=i+1;}if(tabs!=2){return bad;}let first:i64=zagd_parse_nonnegative(zstore_tab_field(value,0));let second:i64=zagd_parse_nonnegative(zstore_tab_field(value,1));let bytes:i64=zagd_parse_nonnegative(zstore_tab_field(value,2));if(first<0||second<0||bytes<0){return bad;}return ZagdHash{.first=first,.second=second,.bytes=bytes};}

// Validate the persisted advisory snapshot before reusing its identity. Any
// truncation, corruption, old format, or executable-authority claim is a miss.
fn zagd_snapshot_record_decode(text:[]u8)ZagdSnapshotRecord{
    let bad:ZagdSnapshotRecord=ZagdSnapshotRecord{.identity=zagd_hash_empty(),.parent=zagd_hash_empty(),.root_project=zagd_hash_empty(),.root_module="",.root_module_present=0,.root_source=zagd_hash_empty(),.semantic_graph=zagd_hash_empty(),.semantic_graph_complete=0,.timestamp_ms=0,.file_count=0,.valid=0};
    if(!@strEq(zagd_record_value(text,"format"),"zagd-snapshot-v2")||
        !@strEq(zagd_record_value(text,"advisory"),"true")||
        !@strEq(zagd_record_value(text,"executable_authority"),"false")||
        !@strEq(zagd_record_value(text,"complete"),"true")||
        !@strEq(zagd_record_value(text,"validity"),"valid")||
        !@strEq(zagd_record_value(text,"profile"),"regular-or-script-root")||
        !@strEq(zagd_record_value(text,"timestamp_basis"),"linux-monotonic-ms")||
        !@strEq(zagd_record_value(text,"timestamp_in_identity"),"false")){return bad;}
    if(zstore_single_field(text,"format")==0||zstore_single_field(text,"advisory")==0||
        zstore_single_field(text,"executable_authority")==0||zstore_single_field(text,"complete")==0||
        zstore_single_field(text,"validity")==0||zstore_single_field(text,"compiler")==0||
        zstore_single_field(text,"target")==0||zstore_single_field(text,"profile")==0||
        zstore_single_field(text,"mode")==0||zstore_single_field(text,"root_module_present")==0||
        zstore_single_field(text,"root_module")==0||zstore_single_field(text,"root_project")==0||
        zstore_single_field(text,"root_source")==0||zstore_single_field(text,"semantic_graph")==0||
        zstore_single_field(text,"semantic_graph_complete")==0||zstore_single_field(text,"timestamp_ms")==0||
        zstore_single_field(text,"timestamp_basis")==0||zstore_single_field(text,"timestamp_in_identity")==0||
        zstore_single_field(text,"snapshot_identity")==0||zstore_single_field(text,"parent_identity")==0||
        zstore_single_field(text,"file_count")==0||zstore_single_field(text,"checksum_first")==0||
        zstore_single_field(text,"checksum_second")==0||zstore_final_field(text,"checksum_second")==0){return bad;}
    let mark:i32=zagd_find_checksum(text);if(mark<0){return bad;}let body:[]u8=text[0..mark];
    let identity:ZagdHash=zstore_hash(text,"snapshot_identity");let parent:ZagdHash=zstore_hash(text,"parent_identity");
    let root_project:ZagdHash=zstore_hash(text,"root_project");let root_source:ZagdHash=zstore_hash(text,"root_source");
    let graph:ZagdHash=zstore_hash(text,"semantic_graph");
    let root_present:i64=zagd_parse_nonnegative(zagd_record_value(text,"root_module_present"));
    let graph_complete:i64=zagd_parse_nonnegative(zagd_record_value(text,"semantic_graph_complete"));
    let timestamp:i64=zagd_parse_nonnegative(zagd_record_value(text,"timestamp_ms"));
    let count:i64=zagd_parse_nonnegative(zagd_record_value(text,"file_count"));
    let cf:i64=zagd_parse_nonnegative(zagd_record_value(text,"checksum_first"));let cs:i64=zagd_parse_nonnegative(zagd_record_value(text,"checksum_second"));
    if(identity.first<0||parent.first<0||root_project.first<0||root_source.first<0||graph.first<0||
        (root_present!=0&&root_present!=1)||(graph_complete!=0&&graph_complete!=1)||timestamp<0||
        count<0||count>2147483647||cf<0||cs<0){return bad;}
    let module_field:[]u8=zagd_record_value(text,"root_module");let module:[]u8="";
    if(root_present==1){if(zagd_canonical_relative(module_field)==0){return bad;}module=module_field;}
    else if(!@strEq(module_field,"<unspecified>")||zagd_hash_equal(root_source,zagd_hash_empty())==0){return bad;}
    if(graph_complete==0&&zagd_hash_equal(graph,zagd_hash_empty())==0){return bad;}
    let sum:ZagdHash=zagd_content_hash(body);if(sum.first!=cf||sum.second!=cs){return bad;}
    return ZagdSnapshotRecord{.identity=identity,.parent=parent,.root_project=root_project,
        .root_module=module,.root_module_present=root_present as i32,.root_source=root_source,
        .semantic_graph=graph,.semantic_graph_complete=graph_complete as i32,
        .timestamp_ms=timestamp,.file_count=count as i32,.valid=1};
}
fn zagd_snapshot_record_compatible(text:[]u8,compiler:[]u8,target:[]u8,mode:[]u8,
        root_module:[]u8,root_source:ZagdHash,root_project:ZagdHash,
        semantic_graph:ZagdHash,semantic_graph_complete:i32)ZagdSnapshotRecord{
    let decoded:ZagdSnapshotRecord=zagd_snapshot_record_decode(text);if(decoded.valid==0){return decoded;}
    if(!@strEq(zagd_record_value(text,"compiler"),compiler)||!@strEq(zagd_record_value(text,"target"),target)||
        !@strEq(zagd_record_value(text,"mode"),mode)||decoded.root_module_present!=(root_module.len>0) as i32||
        !@strEq(decoded.root_module,root_module)||zagd_hash_equal(decoded.root_source,root_source)==0||
        zagd_hash_equal(decoded.root_project,root_project)==0||
        decoded.semantic_graph_complete!=semantic_graph_complete||
        zagd_hash_equal(decoded.semantic_graph,semantic_graph)==0){decoded.valid=0;}
    return decoded;
}
fn zagd_artifact_record_decode(text:[]u8,compiler:[]u8,target:[]u8,source:ZagdHash)ZagdArtifactRecord{let bad:ZagdArtifactRecord=ZagdArtifactRecord{.identity=zagd_hash_empty(),.source=zagd_hash_empty(),.valid=0};if(!@strEq(zagd_record_value(text,"format"),"zagd-artifact-index-v2")||!@strEq(zagd_record_value(text,"advisory"),"true")||!@strEq(zagd_record_value(text,"executable_authority"),"false")||!@strEq(zagd_record_value(text,"complete"),"true")||!@strEq(zagd_record_value(text,"foreground_machine_cache_authority"),"false")||!@strEq(zagd_record_value(text,"compiler"),compiler)||!@strEq(zagd_record_value(text,"target"),target)||zstore_final_field(text,"checksum_second")==0){return bad;}let mark:i32=zagd_find_checksum(text);if(mark<0){return bad;}let sum:ZagdHash=zagd_content_hash(text[0..mark]);if(zagd_parse_nonnegative(zagd_record_value(text,"checksum_first"))!=sum.first||zagd_parse_nonnegative(zagd_record_value(text,"checksum_second"))!=sum.second){return bad;}let sf:[]u8=zagd_record_value(text,"semantic_source");let ai:[]u8=zagd_record_value(text,"artifact_identity");let graph:[]u8=zagd_record_value(text,"graph_identity");let machine:[]u8=zagd_record_value(text,"foreground_machine_cache_link");let complete:i64=zagd_parse_nonnegative(zagd_record_value(text,"graph_complete"));let got_source:ZagdHash=ZagdHash{.first=zagd_parse_nonnegative(zstore_tab_field(sf,0)),.second=zagd_parse_nonnegative(zstore_tab_field(sf,1)),.bytes=zagd_parse_nonnegative(zstore_tab_field(sf,2))};let identity:ZagdHash=ZagdHash{.first=zagd_parse_nonnegative(zstore_tab_field(ai,0)),.second=zagd_parse_nonnegative(zstore_tab_field(ai,1)),.bytes=zagd_parse_nonnegative(zstore_tab_field(ai,2))};let graph_id:ZagdHash=ZagdHash{.first=zagd_parse_nonnegative(zstore_tab_field(graph,0)),.second=zagd_parse_nonnegative(zstore_tab_field(graph,1)),.bytes=zagd_parse_nonnegative(zstore_tab_field(graph,2))};let machine_id:ZagdHash=ZagdHash{.first=zagd_parse_nonnegative(zstore_tab_field(machine,0)),.second=zagd_parse_nonnegative(zstore_tab_field(machine,1)),.bytes=zagd_parse_nonnegative(zstore_tab_field(machine,2))};if(got_source.first<0||identity.first<0||graph_id.first<0||machine_id.first<0||(complete!=0&&complete!=1)||zagd_hash_equal(got_source,source)==0){return bad;}return ZagdArtifactRecord{.identity=identity,.source=got_source,.valid=1};}

fn zagd_canonical_relative(path:[]u8) i32 {
    if(path.len==0||path[0]=='/'||path[path.len-1]=='/'){return 0;}
    let start:i32=0; let i:i32=0;
    while(i<=path.len){
        if(i<path.len&&path[i]=='\\'){return 0;}
        if(i==path.len||path[i]=='/'){
            if(i==start){return 0;}
            let n:i32=i-start;
            if(n==1&&path[start]=='.'){return 0;}
            if(n==2&&path[start]=='.'&&path[start+1]=='.'){return 0;}
            start=i+1;
        }
        i=i+1;
    }
    return 1;
}
fn zagd_store_key_equal(a:ZagdStoreKey,b:ZagdStoreKey)i32{return zagd_hash_equal(a.compiler,b.compiler)*zagd_hash_equal(a.target,b.target)*zagd_hash_equal(a.profile,b.profile)*zagd_hash_equal(a.config,b.config)*zagd_hash_equal(a.snapshot,b.snapshot);}
fn zagd_store_accept(r:ZagdStoreRecord,want:ZagdStoreKey,payload:[]u8,max:i64)i32{if(r.complete!=1||r.executable_authority!=0||r.bytes<0||r.bytes>max||r.bytes!=payload.len){return 0;}if(zagd_store_key_equal(r.key,want)==0){return 0;}return zagd_hash_equal(r.checksum,zagd_content_hash(payload));}
fn zagd_store_record(key:ZagdStoreKey,payload:[]u8,now:i64)ZagdStoreRecord{return ZagdStoreRecord{.key=key,.checksum=zagd_content_hash(payload),.bytes=payload.len,.complete=1,.executable_authority=0,.timestamp_ms=now};}
fn zagd_store_evict(current:i64,incoming:i64,limit:i64)i64{if(limit<0||incoming<0||incoming>limit){return 0-1;}if(current>limit-incoming){return current-(limit-incoming);}return 0;}
fn zagd_sys_rename()i64{return 82;}
fn zagd_sys_mkdir()i64{return 83;}
fn zagd_store_mkdir(path:[]u8)i32{
    let p:ArrayList[u8]=zagd_c_string(path);
    // Keep the Linux-only store helper bootstrap-safe on Mach-O seeds: the
    // syscall identity is fixed, so the native backend can fail it closed
    // instead of attempting to lower a computed legacy number.
    let rc:i64=_zag_raw_syscall(83,zagd_ptr(p.data[0..p.len]),493,0,0,0,0);
    // The C-string bridge is syscall-lifetime storage, not cache state.
    // Snapshot publication calls this on every stable edit, so every return
    // must release it or allocator live bytes grow with the event count.
    free[u8](&p);
    return (rc==0||rc==(0-17)) as i32;
}
// Caller supplies a unique temp path in the same directory. Rename is atomic on
// Linux for same-filesystem paths. Failed/incomplete writes never replace final.
fn zagd_store_transaction(temp:[]u8,final:[]u8,payload:[]u8)i32{
    if(_zag_write_file(temp,payload)!=0){return 0;}
    let a:ArrayList[u8]=zagd_c_string(temp);
    let b:ArrayList[u8]=zagd_c_string(final);
    let rc:i64=_zag_raw_syscall(82,zagd_ptr(a.data[0..a.len]),
        zagd_ptr(b.data[0..b.len]),0,0,0,0);
    // rename(2) does not retain either pathname. Release both bridges before
    // branching so success and cleanup-after-failure have identical lifetime.
    free[u8](&b);
    free[u8](&a);
    if(rc!=0){zagd_unlink(temp);return 0;}
    return 1;
}
