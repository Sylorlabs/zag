@import("zagd_profile.zag")
fn zpc(ok:i32,name:[]u8,f:*i32)void{if(ok==0){_zag_print("FAIL profile: ");_zag_println(name);f.*=f.*+1;}}
fn zpt_comma_hash(h:ZagdHash)[]u8{return _zag_str_concat(_zag_i64_to_str(h.first),_zag_str_concat(",",_zag_str_concat(_zag_i64_to_str(h.second),_zag_str_concat(",",_zag_i64_to_str(h.bytes)))));}
fn zpt_tab_hash(h:ZagdHash)[]u8{return _zag_str_concat(_zag_i64_to_str(h.first),_zag_str_concat("\t",_zag_str_concat(_zag_i64_to_str(h.second),_zag_str_concat("\t",_zag_i64_to_str(h.bytes)))));}
fn zpt_manifest(source_text:[]u8,declared:i32,graph_tag:[]u8)[]u8{
    let source:ZagdHash=zagd_content_hash(source_text);let zero:ZagdHash=zagd_hash_empty();let graph:ZagdHash=zagd_content_hash(graph_tag);
    let body:[]u8="format=zag-semantic-manifest-v1\nadvisory=true\nexecutable_authority=false\ncomplete=true\nmodule=app.zag\nprofile=strict\n";
    body=_zag_str_concat(body,_zag_str_concat("source=",_zag_str_concat(zpt_comma_hash(source),"\n")));
    body=_zag_str_concat(body,_zag_str_concat("public=",_zag_str_concat(zpt_comma_hash(zero),"\n")));
    body=_zag_str_concat(body,_zag_str_concat("effects=",_zag_str_concat(zpt_comma_hash(zero),"\n")));
    body=_zag_str_concat(body,_zag_str_concat("layouts=",_zag_str_concat(zpt_comma_hash(zero),"\n")));
    body=_zag_str_concat(body,_zag_str_concat("graph=",_zag_str_concat(zpt_comma_hash(graph),"\ngraph_complete=1\n")));
    if(declared==1){body=_zag_str_concat(body,"decl_fn=popcount\t11,12,13\tline=1\teffect=0\n");}
    body=_zag_str_concat(body,_zag_str_concat("module_node=app.zag\t",_zag_str_concat(zpt_comma_hash(source),"\n")));
    return _zag_str_concat(body,_zag_str_concat("checksum=",_zag_str_concat(zpt_comma_hash(zagd_content_hash(body)),"\n")));
}
fn zpt_plan(manifest:[]u8,compiler_version:[]u8,foreground_compiler:ZagdHash,target_key:[]u8,declared:i32)[]u8{
    let view:SemanticManifestView=semantic_manifest_decode(manifest);let semantic:ZagdHash=zagd_profile_semantic_identity(manifest,compiler_version,target_key);let target:ZagdHash=zagd_content_hash(target_key);
    let body:[]u8="format=zagd-profile-plan-v3\nadvisory=true\nexecutable_authority=false\nforeground_consumption=metadata-only\ncodegen_effect=none\nmode=deep\nsource_changes=false\ntarget=linux-x86_64\nprovenance=measured-profile-and-derived-validation\n";
    body=_zag_str_concat(body,_zag_str_concat("compiler=",_zag_str_concat(compiler_version,"\n")));
    body=_zag_str_concat(body,_zag_str_concat("foreground_compiler_identity=",_zag_str_concat(zpt_tab_hash(foreground_compiler),"\n")));
    body=_zag_str_concat(body,_zag_str_concat("cpu_profile=x86-64-v1\ncpu_detection=defined\ntarget_cache_key=",_zag_str_concat(target_key,"\n")));
    body=_zag_str_concat(body,_zag_str_concat("semantic_source=",_zag_str_concat(zpt_tab_hash(view.source),"\n")));
    body=_zag_str_concat(body,_zag_str_concat("semantic_graph=",_zag_str_concat(zpt_tab_hash(view.graph_identity),"\nsemantic_graph_complete=1\n")));
    body=_zag_str_concat(body,_zag_str_concat("profile_source_identity=",_zag_str_concat(zpt_tab_hash(semantic),"\n")));
    body=_zag_str_concat(body,_zag_str_concat("target_identity=",_zag_str_concat(zpt_tab_hash(target),"\n")));
    body=_zag_str_concat(body,"profile_compiler_identity=1\t2\t3\nprofile_payload_identity=4\t5\t6\nprofile_samples=1\nhot_regions=1\n");
    let decision:[]u8="rejected";let permitted:i32=0;if(declared==1){decision="advisory_only";permitted=1;}
    body=_zag_str_concat(body,_zag_str_concat("semantic_identity=",_zag_str_concat(zpt_tab_hash(semantic),"\n")));
    body=_zag_str_concat(body,_zag_str_concat("region=popcount\tcount=100\tbackend_kind=1\tsemantic_declared=",_zag_str_concat(_zag_i64_to_str(declared),_zag_str_concat("\tinstruction_permitted=",_zag_str_concat(_zag_i64_to_str(permitted),_zag_str_concat("\tdecision=",_zag_str_concat(decision,"\treason=test fixture\n")))))));
    body=_zag_str_concat(body,_zag_str_concat("eligible_regions=",_zag_str_concat(_zag_i64_to_str(declared),"\n")));
    let sum:ZagdHash=zagd_content_hash(body);
    return _zag_str_concat(body,_zag_str_concat("checksum_first=",_zag_str_concat(_zag_i64_to_str(sum.first),_zag_str_concat("\nchecksum_second=",_zag_str_concat(_zag_i64_to_str(sum.second),_zag_str_concat("\nchecksum_bytes=",_zag_str_concat(_zag_i64_to_str(sum.bytes),"\n")))))));
}
fn zpt_candidate(manifest:[]u8,compiler_version:[]u8,compiler_identity:ZagdHash,target_key:[]u8)[]u8{
    let view:SemanticManifestView=semantic_manifest_decode(manifest);
    let semantic:ZagdHash=zagd_profile_semantic_identity(manifest,compiler_version,target_key);
    let target:ZagdHash=zagd_content_hash(target_key);
    let body:[]u8="format=zagd-candidates-v2\nadvisory=true\nexecutable_authority=false\nsource_changes=false\nsemantic_detail_level=full\nlifetime_analysis_available=true\nlifetime_advice_supported=false\nlifetime_advice_automatic=false\nlifetime_advice_source_changes=false\nlifetime_provenance=proven-foreground-ast\nlifetime_pairs=0\nlifetime_reusable_bytes=0\nlifetime_analysis_bound=64\nlifetime_validity=linux-x86_64-local-raw-word-zalloc-exactly-one-zfree-no-alias-escape-call-exposure\nselection=script-default-cpu\ncpu_profile=generic\ntarget_cache_key=";
    body=_zag_str_concat(body,_zag_str_concat(target_key,"\nsource="));body=_zag_str_concat(body,_zag_str_concat(zpt_tab_hash(view.source),"\nsemantic_identity="));
    body=_zag_str_concat(body,_zag_str_concat(zpt_tab_hash(semantic),"\ncompiler="));body=_zag_str_concat(body,_zag_str_concat(compiler_version,"\ncompiler_identity="));
    body=_zag_str_concat(body,_zag_str_concat(zpt_tab_hash(compiler_identity),"\ntarget="));body=_zag_str_concat(body,_zag_str_concat(zpt_tab_hash(target),"\ngenerated=5\nfinalists=1\n"));
    body=_zag_str_concat(body,"candidate=51\tautomatic=1\tsupported=1\tequivalent=1\tprovenance=derived\tevidence_basis=derived\tvalidity=Script root\trejected_reason=\truntime_ns=0\tmemory_bytes=0\n");
    body=_zag_str_concat(body,"candidate=11\tautomatic=0\tsupported=0\tequivalent=0\tprovenance=unknown\tevidence_basis=unknown\tvalidity=unavailable\trejected_reason=not implemented\truntime_ns=-1\tmemory_bytes=-1\n");
    body=_zag_str_concat(body,"candidate=12\tautomatic=0\tsupported=0\tequivalent=0\tprovenance=unknown\tevidence_basis=unknown\tvalidity=unavailable\trejected_reason=not implemented\truntime_ns=-1\tmemory_bytes=-1\n");
    body=_zag_str_concat(body,"candidate=21\tautomatic=0\tsupported=0\tequivalent=0\tprovenance=unknown\tevidence_basis=unknown\tvalidity=unavailable\trejected_reason=not implemented\truntime_ns=-1\tmemory_bytes=-1\n");
    body=_zag_str_concat(body,"candidate=31\tautomatic=0\tsupported=0\tequivalent=0\tprovenance=unknown\tevidence_basis=unknown\tvalidity=unavailable\trejected_reason=not implemented\truntime_ns=-1\tmemory_bytes=-1\n");
    let sum:ZagdHash=zagd_content_hash(body);
    return _zag_str_concat(body,_zag_str_concat("checksum_first=",_zag_str_concat(_zag_i64_to_str(sum.first),_zag_str_concat("\nchecksum_second=",_zag_str_concat(_zag_i64_to_str(sum.second),_zag_str_concat("\nchecksum_bytes=",_zag_str_concat(_zag_i64_to_str(sum.bytes),"\n")))))));
}
fn zpt_candidate_with_unknown(candidate:[]u8)[]u8{
    let mark:i32=zagd_find_checksum(candidate);
    let body:[]u8=_zag_str_concat(candidate[0..mark],"unknown_future_field=1\n");
    let sum:ZagdHash=zagd_content_hash(body);
    return _zag_str_concat(body,_zag_str_concat("checksum_first=",_zag_str_concat(_zag_i64_to_str(sum.first),_zag_str_concat("\nchecksum_second=",_zag_str_concat(_zag_i64_to_str(sum.second),_zag_str_concat("\nchecksum_bytes=",_zag_str_concat(_zag_i64_to_str(sum.bytes),"\n")))))));
}
fn zpt_candidate_with_duplicate(candidate:[]u8)[]u8{
    let mark:i32=zagd_find_checksum(candidate);
    let body:[]u8=_zag_str_concat(candidate[0..mark],"semantic_detail_level=duplicate\n");
    let sum:ZagdHash=zagd_content_hash(body);
    return _zag_str_concat(body,_zag_str_concat("checksum_first=",_zag_str_concat(_zag_i64_to_str(sum.first),_zag_str_concat("\nchecksum_second=",_zag_str_concat(_zag_i64_to_str(sum.second),_zag_str_concat("\nchecksum_bytes=",_zag_str_concat(_zag_i64_to_str(sum.bytes),"\n")))))));
}
fn zpt_replace_first(text:[]u8,needle:[]u8,replacement:[]u8)[]u8{
    let i:i32=0;
    while(i+needle.len<=text.len){
        if(@strEq(text[i..i+needle.len],needle)){
            return _zag_str_concat(text[0..i],_zag_str_concat(replacement,text[i+needle.len..]));
        }
        i=i+1;
    }
    return text;
}
fn zpt_candidate_with_roadmap_runtime(candidate:[]u8)[]u8{
    let mutated:[]u8=zpt_replace_first(candidate,"runtime_ns=-1","runtime_ns=7");
    let mark:i32=zagd_find_checksum(mutated);
    let body:[]u8=mutated[0..mark];
    let sum:ZagdHash=zagd_content_hash(body);
    return _zag_str_concat(body,_zag_str_concat("checksum_first=",_zag_str_concat(_zag_i64_to_str(sum.first),_zag_str_concat("\nchecksum_second=",_zag_str_concat(_zag_i64_to_str(sum.second),_zag_str_concat("\nchecksum_bytes=",_zag_str_concat(_zag_i64_to_str(sum.bytes),"\n")))))));
}
fn main()i32{
    let f:i32=0;let compiler:ZagdHash=zagd_content_hash("compiler-a");let source:ZagdHash=zagd_content_hash("source");let target:ZagdHash=zagd_content_hash("target");
    let body:[]u8="format=zagd-profile-v1\n";
    body=_zag_str_concat(body,_zag_str_concat("compiler_first=",_zag_str_concat(_zag_i64_to_str(compiler.first),"\n")));
    body=_zag_str_concat(body,_zag_str_concat("compiler_second=",_zag_str_concat(_zag_i64_to_str(compiler.second),"\n")));
    body=_zag_str_concat(body,_zag_str_concat("source_first=",_zag_str_concat(_zag_i64_to_str(source.first),"\n")));
    body=_zag_str_concat(body,_zag_str_concat("source_second=",_zag_str_concat(_zag_i64_to_str(source.second),"\n")));
    body=_zag_str_concat(body,_zag_str_concat("target_first=",_zag_str_concat(_zag_i64_to_str(target.first),"\n")));
    body=_zag_str_concat(body,_zag_str_concat("target_second=",_zag_str_concat(_zag_i64_to_str(target.second),"\n")));
    body=_zag_str_concat(body,"hot=andn\t90\nhot=popcount\t100\nhot=simd-packed\t100\n");
    let text:[]u8=_zag_str_concat(body,_zag_str_concat("checksum_first=",_zag_str_concat(_zag_i64_to_str(zagd_content_hash(body).first),"\n")));
    let p:ZagdProfile=zagd_profile_decode(text,compiler,source,target,8);zpc(p.valid==1&&p.samples.len==3,"exact ingestion",&f);
    zpc(zagd_profile_decode(text,zagd_content_hash("compiler-b"),source,target,8).valid==0,"stale compiler",&f);zpc(zagd_profile_decode(text,compiler,zagd_content_hash("other"),target,8).valid==0,"stale source",&f);zpc(zagd_profile_decode(_zag_str_concat(text,"x"),compiler,source,target,8).valid==0,"corrupt record",&f);
    let hot:ArrayList[ZagdProfileSample]=zagd_select_hot_regions(p,2);zpc(hot.len==2&&@strEq(hot.data[0].region,"popcount")&&@strEq(hot.data[1].region,"simd-packed"),"bounded deterministic ranking",&f);
    let plans:ArrayList[ZagdBackendRegionPlan]=zagd_backend_plan(hot,ZagdBackendFeatures{.popcnt=1,.bmi1=1,.packed_simd=1});zpc(plans.data[0].selected==1&&plans.data[0].kind==zagd_backend_popcnt(),"implemented feature selected",&f);zpc(plans.data[1].selected==0&&plans.data[1].supported==0,"unimplemented SIMD rejected",&f);
    let tz_hot:ArrayList[ZagdProfileSample]=make[ZagdProfileSample](1);push[ZagdProfileSample](&tz_hot,ZagdProfileSample{.region="trailing_zeros",.count=7});
    let tz_plan:ArrayList[ZagdBackendRegionPlan]=zagd_backend_plan(tz_hot,ZagdBackendFeatures{.popcnt=0,.bmi1=1,.packed_simd=0});
    zpc(tz_plan.len==1&&tz_plan.data[0].selected==1&&tz_plan.data[0].supported==1&&tz_plan.data[0].kind==zagd_backend_tzcnt()&&@strEq(tz_plan.data[0].reason,"implemented TZCNT lowering"),"implemented TZCNT profile selection",&f);
    let tz_generic:ArrayList[ZagdBackendRegionPlan]=zagd_backend_plan(tz_hot,ZagdBackendFeatures{.popcnt=0,.bmi1=0,.packed_simd=0});
    zpc(tz_generic.data[0].selected==0&&tz_generic.data[0].supported==0&&tz_generic.data[0].kind==zagd_backend_tzcnt(),"generic TZCNT profile fallback",&f);
    let manifest:[]u8="decl_fn=popcount\t1,2,3\tline=1\n";
    let checked:ArrayList[ZagdBackendRegionPlan]=zagd_backend_plan_validated(hot,ZagdBackendFeatures{.popcnt=1,.bmi1=1,.packed_simd=1},manifest);
    zpc(checked.data[0].selected==1&&checked.data[0].supported==1,"declared hot region remains advisory candidate",&f);
    zpc(checked.data[1].selected==0&&checked.data[1].supported==0&&@strEq(checked.data[1].reason,"profile region absent from current semantic manifest"),"absent hot region rejected",&f);
    zpc(zagd_profile_manifest_declared("// decl_fn=andn\n","andn")==0,"comments do not establish profile region",&f);

    let compiler_version:[]u8="test-compiler-v1";let foreground_compiler:ZagdHash=zagd_content_hash("foreground compiler image");let target_key:[]u8="linux-x86_64|x86-64-v1|sse2";
    let semantic:[]u8=zpt_manifest("fn popcount() i32{return 1;}",1,"graph-a");let plan:[]u8=zpt_plan(semantic,compiler_version,foreground_compiler,target_key,1);
    let use:ZagdForegroundProfileUse=zagd_foreground_profile_consume(plan,semantic,compiler_version,foreground_compiler,target_key);
    zpc(use.valid==1&&use.metadata_consumed==1&&use.hot_regions==1&&use.eligible_regions==1&&use.codegen_effect==0,"foreground metadata-only consumption",&f);
    let stale_compiler:ZagdForegroundProfileUse=zagd_foreground_profile_consume(plan,semantic,compiler_version,zagd_content_hash("replacement compiler"),target_key);
    zpc(stale_compiler.valid==0&&stale_compiler.metadata_consumed==0&&stale_compiler.codegen_effect==0&&@strEq(stale_compiler.reason,"stale-compiler"),"foreground exact compiler binding",&f);
    let stale_source:[]u8=zpt_manifest("fn popcount() i32{return 2;}",1,"graph-a");
    zpc(@strEq(zagd_foreground_profile_consume(plan,stale_source,compiler_version,foreground_compiler,target_key).reason,"stale-source"),"foreground source binding",&f);
    let stale_graph:[]u8=zpt_manifest("fn popcount() i32{return 1;}",1,"graph-b");
    zpc(@strEq(zagd_foreground_profile_consume(plan,stale_graph,compiler_version,foreground_compiler,target_key).reason,"stale-graph"),"foreground graph binding",&f);
    zpc(@strEq(zagd_foreground_profile_consume(plan,semantic,compiler_version,foreground_compiler,"linux-x86_64|native|sse2").reason,"stale-target"),"foreground target binding",&f);
    let missing_decl:[]u8=zpt_manifest("fn main() i32{return 0;}",0,"graph-c");let false_region:[]u8=zpt_plan(missing_decl,compiler_version,foreground_compiler,target_key,1);
    zpc(@strEq(zagd_foreground_profile_consume(false_region,missing_decl,compiler_version,foreground_compiler,target_key).reason,"stale-region"),"foreground declaration binding",&f);
    let corrupt:ZagdForegroundProfileUse=zagd_foreground_profile_consume(_zag_str_concat(plan,"x"),semantic,compiler_version,foreground_compiler,target_key);
    zpc(corrupt.valid==0&&corrupt.codegen_effect==0,"foreground corruption fails closed",&f);
    let candidate:[]u8=zpt_candidate(semantic,compiler_version,foreground_compiler,target_key);
    let candidate_use:ZagdForegroundCandidateUse=zagd_foreground_candidate_consume(candidate,semantic,compiler_version,foreground_compiler,target_key);
    zpc(candidate_use.valid==1&&candidate_use.metadata_consumed==1&&candidate_use.candidate_kind==51&&
        @strEq(candidate_use.selection,"script-default-cpu")&&@strEq(candidate_use.cpu_profile,"generic")&&
        @strEq(candidate_use.reason,"validated-source-bound-proposal"),"foreground candidate binding",&f);
    zpc(zagd_foreground_candidate_consume(candidate,semantic,compiler_version,zagd_content_hash("replacement compiler"),target_key).valid==0,"candidate compiler mutation",&f);
    zpc(zagd_foreground_candidate_consume(_zag_str_concat(candidate,"x"),semantic,compiler_version,foreground_compiler,target_key).valid==0,"candidate checksum mutation",&f);
    zpc(zagd_foreground_candidate_consume(zpt_candidate_with_unknown(candidate),semantic,compiler_version,foreground_compiler,target_key).valid==0,"candidate unknown key",&f);
    zpc(zagd_foreground_candidate_consume(zpt_candidate_with_duplicate(candidate),semantic,compiler_version,foreground_compiler,target_key).valid==0,"candidate duplicate key",&f);
    zpc(zagd_foreground_candidate_consume(zpt_candidate_with_roadmap_runtime(candidate),semantic,compiler_version,foreground_compiler,target_key).valid==0,"candidate roadmap metadata mutation",&f);
    zpc(zagd_foreground_candidate_consume(candidate,stale_source,compiler_version,foreground_compiler,target_key).valid==0,"candidate source mutation",&f);
    if(f==0){_zag_println("zagd profile planning: PASS");}return f;
}
