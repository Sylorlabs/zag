@import("zagd_generation_candidate.zag")
fn zgc_expect(ok:i32,label:[]u8,f:*i32)void{if(ok==1){return;}_zag_eprintln(_zag_str_concat("zagd generation candidate test: ",label));f.*=f.*+1;}
fn main()i32{
 let compiler:[]u8="generation-test-v1";let target:[]u8="finite-u4-v1";let f:i32=0;let empty:ZagdHash=zagd_hash_empty();
 let builtin_text:[]u8=zagd_generation_manifest_encode(compiler,empty,zagd_generation_builtin_policy());let builtin:ZagdGenerationManifest=zagd_generation_manifest_decode(builtin_text);zgc_expect(builtin.valid==1,"builtin manifest",&f);
 let region:[]u8="format=zagd-typed-region-v1\ntype=u4\nvariables=1\neffects=pure\nexpr=x 0 +\n";let sat:ZagdSaturationResult=zagd_saturation_run(zagd_saturation_extract(region),compiler,target,20000000);zgc_expect(sat.ok==1,"candidate saturation",&f);let policy:ZagdHash=zagd_content_hash(sat.proof_record);
 let candidate_text:[]u8=zagd_generation_manifest_encode(compiler,builtin.identity,policy);let candidate:ZagdGenerationManifest=zagd_generation_manifest_decode(candidate_text);zgc_expect(candidate.valid==1&&zagd_hash_equal(candidate.parent,builtin.identity)==1&&zagd_hash_equal(candidate.search_policy,policy)==1,"candidate manifest binds proof",&f);
 let pointers:ZagdGenerationPointers=ZagdGenerationPointers{.current=candidate.identity,.last_known_good=builtin.identity,.valid=1};let canary:ZagdGenerationCanary=zagd_generation_candidate_active(candidate.identity,builtin.identity);let round:i32=0;let promoted:i32=0;
 while(round<zagd_generation_required_successes()){let replay:ZagdSaturationResult=zagd_saturation_run(zagd_saturation_extract(region),compiler,target,20000000);zgc_expect(replay.ok==1&&zagd_hash_equal(zagd_content_hash(replay.proof_record),candidate.search_policy)==1,"sandbox replay matches immutable proof",&f);let begun:ZagdGenerationTransition=zagd_generation_begin_session(pointers,canary);let finished:ZagdGenerationTransition=zagd_generation_finish_session(begun.pointers,begun.canary);zgc_expect(begun.valid==1&&begun.started==1&&finished.valid==1,"clean canary transition",&f);pointers=finished.pointers;canary=finished.canary;promoted=finished.promoted;round=round+1;zagd_saturation_result_free(&replay);}
 zgc_expect(promoted==1&&canary.successes==3&&zagd_hash_equal(pointers.current,pointers.last_known_good)==1,"candidate promoted after bounded successes",&f);
 let second_region:[]u8="format=zagd-typed-region-v1\ntype=u4\nvariables=1\neffects=pure\nexpr=x 1 + 1 -\n";let second_sat:ZagdSaturationResult=zagd_saturation_run(zagd_saturation_extract(second_region),compiler,target,20000000);let second_text:[]u8=zagd_generation_manifest_encode(compiler,candidate.identity,zagd_content_hash(second_sat.proof_record));let second:ZagdGenerationManifest=zagd_generation_manifest_decode(second_text);let rp:ZagdGenerationPointers=ZagdGenerationPointers{.current=second.identity,.last_known_good=candidate.identity,.valid=1};let rc:ZagdGenerationCanary=zagd_generation_candidate_active(second.identity,candidate.identity);let wrong:[]u8="format=zagd-typed-region-v1\ntype=u4\nvariables=1\neffects=pure\nexpr=x 2 +\n";let tries:i32=0;let rolled:i32=0;
 while(tries<zagd_generation_crash_limit()){let replay:ZagdSaturationResult=zagd_saturation_run(zagd_saturation_extract(wrong),compiler,target,20000000);zgc_expect(replay.ok==1&&zagd_hash_equal(zagd_content_hash(replay.proof_record),second.search_policy)==0,"mismatched proof rejected",&f);let begun:ZagdGenerationTransition=zagd_generation_begin_session(rp,rc);let rejected:ZagdGenerationTransition=zagd_generation_candidate_reject(begun.pointers,begun.canary);zgc_expect(begun.valid==1&&begun.started==1&&rejected.valid==1,"failed canary transition",&f);rp=rejected.pointers;rc=rejected.canary;rolled=rejected.rolled_back;tries=tries+1;zagd_saturation_result_free(&replay);}
 zgc_expect(rolled==1&&rc.quarantined==1&&rc.consecutive_crashes==3&&zagd_hash_equal(rp.current,candidate.identity)==1&&zagd_hash_equal(rp.last_known_good,candidate.identity)==1,"repeated failure quarantines and rolls back",&f);
 zagd_saturation_result_free(&second_sat);zagd_saturation_result_free(&sat);zagd_text_free(second_text);zagd_text_free(candidate_text);zagd_text_free(builtin_text);if(f==0){_zag_println("zagd sandboxed generation promotion/rollback: PASS");}return f;
}
