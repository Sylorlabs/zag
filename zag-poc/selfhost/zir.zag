// Test-only companion rule for an explicitly typed, pure bool predicate. It
// is intentionally limited to canonical `arith.cmpi` eq/ne over exact bool
// constants. Short-circuit control flow, effects, unknown values, and other
// predicates remain on the raw foreground path.
fn ztp_parse_bool(text:[]u8)ZirI32Literal{
    if(@strEq(text,"0")){return ZirI32Literal{.value=0,.valid=1};}
    if(@strEq(text,"1")){return ZirI32Literal{.value=1,.valid=1};}
    return ZirI32Literal{.value=0,.valid=0};
}
fn ztp_const_shape_bool(op:ZOp,want:ZVal)ZirI32Literal{
    let bad:ZirI32Literal=ZirI32Literal{.value=0,.valid=0};
    if(!@strEq(op.name,"arith.constant")||op.results.len!=1||op.operands.len!=0||
       op.attrs.len!=1||op.regions.len!=0||op.effects!=0||!@strEq(op.reads,"none")||
       !@strEq(op.writes,"none")||!@strEq(op.attrs.data[0].key,"value")||
       !@strEq(op.results.data[0].ty,"bool")||zir_value_equal(op.results.data[0],want)==0||
       zir_origin_rule_usable(op.origin)==0||zir_origin_rule_usable(op.results.data[0].origin)==0){return bad;}
    return ztp_parse_bool(op.attrs.data[0].val);
}
fn ztp_prior_constant_bool(blk:ZBlock,before:i32,want:ZVal)ZirConstMatch{
    let found:i32=0;let index:i32=0-1;let value:i64=0;let i:i32=0;
    while(i<before){let op:ZOp=blk.ops.data[i];let r:i32=0;
        while(r<op.results.len){if(@strEq(op.results.data[r].name,want.name)){
            found=found+1;if(r!=0){return ZirConstMatch{.index=0-1,.value=0,.valid=0};}
            let parsed:ZirI32Literal=ztp_const_shape_bool(op,want);if(parsed.valid==0){return ZirConstMatch{.index=0-1,.value=0,.valid=0};}
            index=i;value=parsed.value;}r=r+1;}i=i+1;}
    return ZirConstMatch{.index=index,.value=value,.valid=(found==1) as i32};
}
fn zir_propose_const_bool_cmp(raw:ZModule)ZirTransformProposal{
    if(verify_module(raw)!=0||zir_module_ssa_unique_all(raw)==0||!@strEq(raw.schema_version,"zag-ir-v1")||
       !@strEq(raw.transform_version,"zag-transform-v1")||raw.coverage_complete!=1||
       raw.coverage_errors!=0||raw.origin_complete!=1||raw.origin_exact!=1){return zir_no_transform_proposal(raw);}
    let fi:i32=0;while(fi<raw.funcs.len){let f:ZFunc=raw.funcs.data[fi];
        if(f.effects==0&&f.coverage_complete==1&&f.coverage_errors==0&&zir_origin_rule_usable(f.origin)==1){
            let oi:i32=0;while(oi<f.body.ops.len){let cmp:ZOp=f.body.ops.data[oi];
                if(@strEq(cmp.name,"arith.cmpi")&&cmp.results.len==1&&cmp.operands.len==2&&
                   cmp.attrs.len==1&&@strEq(cmp.attrs.data[0].key,"predicate")&&
                   (@strEq(cmp.attrs.data[0].val,"eq")||@strEq(cmp.attrs.data[0].val,"ne"))&&
                   cmp.regions.len==0&&cmp.effects==0&&@strEq(cmp.reads,"none")&&@strEq(cmp.writes,"none")&&
                   @strEq(cmp.results.data[0].ty,"bool")&&@strEq(cmp.operands.data[0].ty,"bool")&&
                   @strEq(cmp.operands.data[1].ty,"bool")&&zir_origin_rule_usable(cmp.origin)==1&&
                   zir_origin_rule_usable(cmp.results.data[0].origin)==1){
                    let lhs:ZirConstMatch=ztp_prior_constant_bool(f.body,oi,cmp.operands.data[0]);
                    let rhs:ZirConstMatch=ztp_prior_constant_bool(f.body,oi,cmp.operands.data[1]);
                    if(lhs.valid==1&&rhs.valid==1&&lhs.index!=rhs.index&&
                       !@strEq(cmp.operands.data[0].name,cmp.operands.data[1].name)&&
                       !@strEq(cmp.results.data[0].name,cmp.operands.data[0].name)&&
                       !@strEq(cmp.results.data[0].name,cmp.operands.data[1].name)&&
                       zir_count_ssa_function(f,cmp.operands.data[0].name)==1&&
                       zir_count_ssa_function(f,cmp.operands.data[1].name)==1&&
                       zir_count_ssa_function(f,cmp.results.data[0].name)==1){
                        let candidate:ZModule=zir_clone_module(raw);let old:ZOp=candidate.funcs.data[fi].body.ops.data[oi];
                        let result:i64=0;if(@strEq(cmp.attrs.data[0].val,"eq")){result=(lhs.value==rhs.value) as i64;}else{result=(lhs.value!=rhs.value) as i64;}
                        let replacement:ZOp=ZOp{.name=zir_clone_text("arith.constant"),.results=old.results,
                            .operands=make[ZVal](0),.attrs=make[ZAttr](1),.regions=make[ZRegion](0),
                            .effects=old.effects,.reads=old.reads,.writes=old.writes,.origin=old.origin};
                        push[ZAttr](&replacement.attrs,ZAttr{.key=zir_clone_text("value"),.val=_zag_i64_to_str(result)});
                        candidate.funcs.data[fi].body.ops.data[oi]=replacement;
                        let cert:ZirTransformCertificate=ZirTransformCertificate{
                            .format=zir_clone_text(zir_transform_cert_format()),.identity_schema=zir_clone_text(zir_transform_identity_schema()),
                            .rule=zir_clone_text(zir_transform_rule_const_bool_cmp()),.checker=zir_clone_text(zir_transform_checker_const_bool_cmp()),
                            .ir_verifier=zir_clone_text(zir_ir_verifier_name()),.before=zir_semantic_identity(raw),.after=zir_semantic_identity(candidate),
                            .function_index=fi,.op_index=oi,.lhs_def_index=lhs.index,.rhs_def_index=rhs.index,.transform_count=1,
                            .function_name=zir_clone_text(f.name),.lhs_ssa=zir_clone_text(cmp.operands.data[0].name),
                            .rhs_ssa=zir_clone_text(cmp.operands.data[1].name),.result_ssa=zir_clone_text(cmp.results.data[0].name),
                            .result_type=zir_clone_text(cmp.results.data[0].ty),.source_context=zir_clone_text(zir_transform_source_context_const_bool_cmp()),
                            .policy_target=zir_clone_text(zir_transform_target_linux_x86_64()),.policy_edition=zir_clone_text(zir_transform_edition_regular()),
                            .arithmetic_policy=zir_clone_text(zir_transform_arithmetic_bool_predicate()),.safety_checked=0,.sanitize_memory=0,.automatic_selection=1,
                            .function_origin=zir_clone_origin(f.origin),.op_origin=zir_clone_origin(cmp.origin),
                            .lhs_def_origin=zir_clone_origin(f.body.ops.data[lhs.index].origin),.rhs_def_origin=zir_clone_origin(f.body.ops.data[rhs.index].origin),
                            .lhs_origin=zir_clone_origin(cmp.operands.data[0].origin),.rhs_origin=zir_clone_origin(cmp.operands.data[1].origin),
                            .result_origin=zir_clone_origin(cmp.results.data[0].origin),.lhs_value=lhs.value,.rhs_value=rhs.value,.result_value=result,.valid=1};
                        return ZirTransformProposal{.candidate=candidate,.certificate=cert,.proposed=1};
                    }
                }
                oi=oi+1;}
        }
        fi=fi+1;}
    return zir_no_transform_proposal(raw);
}

fn ztc_reject(reason:[]u8)ZirTransformCheck{return ZirTransformCheck{.accepted=0,.reason=reason};}

// Checker-side parser is deliberately independent from ztp_parse_i32.
fn ztc_parse_i32(text:[]u8)ZirI32Literal{
    let bad:ZirI32Literal=ZirI32Literal{.value=0,.valid=0};if(text.len<1){return bad;}
    let start:i32=0;let negative:i32=0;if(text[0]=='-'){negative=1;start=1;}
    if(start==text.len||text[start]=='+'){return bad;}
    if(text[start]=='0'){if(start+1!=text.len||negative==1){return bad;}}
    let limit:i64=2147483647;if(negative==1){limit=2147483648;}
    let value:i64=0;let i:i32=start;while(i<text.len){
        if(text[i]<'0'||text[i]>'9'){return bad;}let digit:i64=(text[i] as i64)-48;
        if(value>(limit-digit)/10){return bad;}value=value*10+digit;i=i+1;}
    if(negative==1){return ZirI32Literal{.value=0-value,.valid=1};}
    return ZirI32Literal{.value=value,.valid=1};
}
fn ztc_constant_at(op:ZOp,want:ZVal)ZirI32Literal{
    let bad:ZirI32Literal=ZirI32Literal{.value=0,.valid=0};
    if(op.name.len!=14||!@strEq(op.name,"arith.constant")||op.results.len!=1||
       op.operands.len!=0||op.attrs.len!=1||op.regions.len!=0||op.effects!=0||
       !@strEq(op.reads,"none")||!@strEq(op.writes,"none")||
       !@strEq(op.attrs.data[0].key,"value")||!@strEq(op.results.data[0].ty,"i32")||
       zir_value_equal(op.results.data[0],want)==0||zir_origin_rule_usable(op.origin)==0||
       zir_origin_rule_usable(op.results.data[0].origin)==0){return bad;}
    return ztc_parse_i32(op.attrs.data[0].val);
}
fn ztc_prior_constant(blk:ZBlock,before:i32,want:ZVal)ZirConstMatch{
    let hits:i32=0;let at:i32=before-1;let selected:i32=0-1;let value:i64=0;
    while(at>=0){let op:ZOp=blk.ops.data[at];let r:i32=op.results.len-1;
        while(r>=0){if(@strEq(op.results.data[r].name,want.name)){
            hits=hits+1;if(r!=0){return ZirConstMatch{.index=0-1,.value=0,.valid=0};}
            let literal:ZirI32Literal=ztc_constant_at(op,want);if(literal.valid!=1){return ZirConstMatch{.index=0-1,.value=0,.valid=0};}
            selected=at;value=literal.value;}r=r-1;}at=at-1;}
    if(hits!=1){return ZirConstMatch{.index=0-1,.value=0,.valid=0};}
    return ZirConstMatch{.index=selected,.value=value,.valid=1};
}
fn ztc_wrap_i32_add(a:i64,b:i64)i64{
    let ua:i64=a;let ub:i64=b;if(ua<0){ua=ua+4294967296;}if(ub<0){ub=ub+4294967296;}
    let word:i64=(ua+ub)%4294967296;if(word>=2147483648){return word-4294967296;}return word;
}
fn ztc_candidate_constant(op:ZOp,raw_result:ZVal,expected:i64)i32{
    if(!@strEq(op.name,"arith.constant")||op.results.len!=1||op.operands.len!=0||
       op.attrs.len!=1||op.regions.len!=0||op.effects!=0||!@strEq(op.reads,"none")||
       !@strEq(op.writes,"none")||!@strEq(op.attrs.data[0].key,"value")||
       zir_value_equal(op.results.data[0],raw_result)==0){return 0;}
    let parsed:ZirI32Literal=ztc_parse_i32(op.attrs.data[0].val);
    return (parsed.valid==1&&parsed.value==expected) as i32;
}
fn ztc_parse_bool(text:[]u8)ZirI32Literal{
    if(@strEq(text,"0")){return ZirI32Literal{.value=0,.valid=1};}
    if(@strEq(text,"1")){return ZirI32Literal{.value=1,.valid=1};}
    return ZirI32Literal{.value=0,.valid=0};
}
fn ztc_constant_at_bool(op:ZOp,want:ZVal)ZirI32Literal{
    let bad:ZirI32Literal=ZirI32Literal{.value=0,.valid=0};
    if(!@strEq(op.name,"arith.constant")||op.results.len!=1||op.operands.len!=0||op.attrs.len!=1||
       op.regions.len!=0||op.effects!=0||!@strEq(op.reads,"none")||!@strEq(op.writes,"none")||
       !@strEq(op.attrs.data[0].key,"value")||!@strEq(op.results.data[0].ty,"bool")||
       zir_value_equal(op.results.data[0],want)==0||zir_origin_rule_usable(op.origin)==0||
       zir_origin_rule_usable(op.results.data[0].origin)==0){return bad;}
    return ztc_parse_bool(op.attrs.data[0].val);
}
fn ztc_prior_constant_bool(blk:ZBlock,before:i32,want:ZVal)ZirConstMatch{
    let hits:i32=0;let at:i32=before-1;let selected:i32=0-1;let value:i64=0;
    while(at>=0){let op:ZOp=blk.ops.data[at];let r:i32=op.results.len-1;
        while(r>=0){if(@strEq(op.results.data[r].name,want.name)){
            hits=hits+1;if(r!=0){return ZirConstMatch{.index=0-1,.value=0,.valid=0};}
            let literal:ZirI32Literal=ztc_constant_at_bool(op,want);if(literal.valid!=1){return ZirConstMatch{.index=0-1,.value=0,.valid=0};}
            selected=at;value=literal.value;}r=r-1;}at=at-1;}
    if(hits!=1){return ZirConstMatch{.index=0-1,.value=0,.valid=0};}
    return ZirConstMatch{.index=selected,.value=value,.valid=1};
}
fn ztc_candidate_constant_bool(op:ZOp,raw_result:ZVal,expected:i64)i32{
    if(!@strEq(op.name,"arith.constant")||op.results.len!=1||op.operands.len!=0||op.attrs.len!=1||
       op.regions.len!=0||op.effects!=0||!@strEq(op.reads,"none")||!@strEq(op.writes,"none")||
       !@strEq(op.attrs.data[0].key,"value")||zir_value_equal(op.results.data[0],raw_result)==0){return 0;}
    let parsed:ZirI32Literal=ztc_parse_bool(op.attrs.data[0].val);return (parsed.valid==1&&parsed.value==expected) as i32;
}

// This checker does not call the producer or any producer precondition,
// parsing, or arithmetic helper. Acceptance is bounded to exactly one rewrite.
fn zir_check_const_i32_add(raw:ZModule,proposal:ZirTransformProposal)ZirTransformCheck{
    if(proposal.proposed!=1){return ztc_reject("proposal-count");}
    let c:ZirTransformCertificate=proposal.certificate;
    if(c.valid!=1||!@strEq(c.format,zir_transform_cert_format())||
       !@strEq(c.identity_schema,zir_transform_identity_schema())||
       !@strEq(c.rule,zir_transform_rule_const_i32_add())||
       !@strEq(c.checker,zir_transform_checker_const_i32_add())||
       !@strEq(c.ir_verifier,zir_ir_verifier_name())||c.transform_count!=1){
        return ztc_reject("certificate-header");}
    if(!@strEq(c.source_context,zir_transform_source_context_const_i32_add())||
       !@strEq(c.policy_target,zir_transform_target_linux_x86_64())||
       !@strEq(c.policy_edition,zir_transform_edition_regular())||
       !@strEq(c.arithmetic_policy,zir_transform_arithmetic_i32_wrap())||
       c.safety_checked!=0||c.sanitize_memory!=0||c.automatic_selection!=1){
        return ztc_reject("certificate-policy");}
    let script_envelope:i32=zir_script_generated_envelope(raw);
    let candidate_script_envelope:i32=zir_script_generated_envelope(proposal.candidate);
    let raw_contract:ZirContractReport=zir_verify_contracts(raw);
    let candidate_contract:ZirContractReport=zir_verify_contracts(proposal.candidate);
    let raw_domain_incomplete:i32=(!@strEq(raw.schema_version,"zag-ir-v1")||
       !@strEq(raw.transform_version,"zag-transform-v1")||raw.coverage_complete!=1||
       raw.coverage_errors!=0||raw.origin_complete!=1||raw.origin_exact!=1||
       raw_contract.valid==0) as i32;
    if(raw_domain_incomplete==1&&script_envelope==0){return ztc_reject("raw-domain");}
    if(script_envelope==1&&candidate_script_envelope!=1){return ztc_reject("candidate-envelope");}
    if(raw_domain_incomplete==0&&candidate_contract.valid==0&&candidate_script_envelope==0){return ztc_reject("candidate-contract");}
    if(verify_module(raw)!=0||verify_module(proposal.candidate)!=0||
       zir_module_ssa_unique_all(raw)==0||zir_module_ssa_unique_all(proposal.candidate)==0){
        return ztc_reject("ir-verifier");}
    if(zir_identity_equal(c.before,zir_semantic_identity(raw))==0||
       zir_identity_equal(c.after,zir_semantic_identity(proposal.candidate))==0||
       zir_identity_equal(c.before,c.after)==1){return ztc_reject("semantic-identity");}
    if(c.function_index<0||c.function_index>=raw.funcs.len||
       c.function_index>=proposal.candidate.funcs.len){return ztc_reject("function-index");}
    let rf:ZFunc=raw.funcs.data[c.function_index];let cf:ZFunc=proposal.candidate.funcs.data[c.function_index];
    if(c.op_index<0||c.op_index>=rf.body.ops.len||c.op_index>=cf.body.ops.len||
       c.lhs_def_index<0||c.rhs_def_index<0||c.lhs_def_index>=c.op_index||
       c.rhs_def_index>=c.op_index||c.lhs_def_index==c.rhs_def_index){return ztc_reject("op-index");}
    if(zir_module_equal_except_top_op(raw,proposal.candidate,c.function_index,c.op_index)==0){
        return ztc_reject("untouched-metadata");}
    if(rf.effects!=0||rf.coverage_complete!=1||rf.coverage_errors!=0||
       zir_origin_rule_usable(rf.origin)==0){return ztc_reject("function-domain");}
    let add:ZOp=rf.body.ops.data[c.op_index];
    if(!@strEq(add.name,"arith.addi")||add.results.len!=1||add.operands.len!=2||
       add.attrs.len!=0||add.regions.len!=0||add.effects!=0||!@strEq(add.reads,"none")||
       !@strEq(add.writes,"none")||!@strEq(add.results.data[0].ty,"i32")||
       !@strEq(add.operands.data[0].ty,"i32")||!@strEq(add.operands.data[1].ty,"i32")||
       zir_origin_rule_usable(add.origin)==0||zir_origin_rule_usable(add.results.data[0].origin)==0){
        return ztc_reject("add-domain");}
    let lhs:ZirConstMatch=ztc_prior_constant(rf.body,c.op_index,add.operands.data[0]);
    let rhs:ZirConstMatch=ztc_prior_constant(rf.body,c.op_index,add.operands.data[1]);
    if(lhs.valid!=1||rhs.valid!=1||lhs.index!=c.lhs_def_index||rhs.index!=c.rhs_def_index||
       lhs.index==rhs.index||@strEq(add.operands.data[0].name,add.operands.data[1].name)||
       @strEq(add.results.data[0].name,add.operands.data[0].name)||
       @strEq(add.results.data[0].name,add.operands.data[1].name)||
       zir_count_ssa_function(rf,add.operands.data[0].name)!=1||
       zir_count_ssa_function(rf,add.operands.data[1].name)!=1||
       zir_count_ssa_function(rf,add.results.data[0].name)!=1||
       zir_count_ssa_function(cf,add.operands.data[0].name)!=1||
       zir_count_ssa_function(cf,add.operands.data[1].name)!=1||
       zir_count_ssa_function(cf,add.results.data[0].name)!=1){return ztc_reject("ssa-domain");}
    let expected:i64=ztc_wrap_i32_add(lhs.value,rhs.value);
    if(ztc_candidate_constant(cf.body.ops.data[c.op_index],add.results.data[0],expected)==0||
       zir_origin_equal(cf.body.ops.data[c.op_index].origin,add.origin)==0){
        return ztc_reject("candidate-result");}
    if(!@strEq(c.function_name,rf.name)||!@strEq(c.lhs_ssa,add.operands.data[0].name)||
       !@strEq(c.rhs_ssa,add.operands.data[1].name)||!@strEq(c.result_ssa,add.results.data[0].name)||
       !@strEq(c.result_type,"i32")||zir_origin_equal(c.function_origin,rf.origin)==0||
       zir_origin_equal(c.op_origin,add.origin)==0||
       zir_origin_equal(c.lhs_def_origin,rf.body.ops.data[lhs.index].origin)==0||
       zir_origin_equal(c.rhs_def_origin,rf.body.ops.data[rhs.index].origin)==0||
       zir_origin_equal(c.lhs_origin,add.operands.data[0].origin)==0||
       zir_origin_equal(c.rhs_origin,add.operands.data[1].origin)==0||
       zir_origin_equal(c.result_origin,add.results.data[0].origin)==0||
       c.lhs_value!=lhs.value||c.rhs_value!=rhs.value||c.result_value!=expected){
        return ztc_reject("certificate-facts");}
    return ZirTransformCheck{.accepted=1,.reason="structural_rule_checked_test_only"};
}

// Independent checker for the source-bound unary-negation rule.  It accepts
// only the exact `0 - positive-i32-constant` SSA shape produced for a unary
// source literal, rejects MIN_INT before any wrapped arithmetic, and binds
// every replacement fact to the unchanged origins and identities.
fn zir_check_const_i32_neg(raw:ZModule,proposal:ZirTransformProposal)ZirTransformCheck{
    if(proposal.proposed!=1){return ztc_reject("proposal-count");}
    let c:ZirTransformCertificate=proposal.certificate;
    if(c.valid!=1||!@strEq(c.format,zir_transform_cert_format())||
       !@strEq(c.identity_schema,zir_transform_identity_schema())||
       !@strEq(c.rule,zir_transform_rule_const_i32_neg())||
       !@strEq(c.checker,zir_transform_checker_const_i32_neg())||
       !@strEq(c.ir_verifier,zir_ir_verifier_name())||c.transform_count!=1){
        return ztc_reject("certificate-header");}
    if(!@strEq(c.source_context,zir_transform_source_context_const_i32_neg())||
       !@strEq(c.policy_target,zir_transform_target_linux_x86_64())||
       !@strEq(c.policy_edition,zir_transform_edition_regular())||
       !@strEq(c.arithmetic_policy,zir_transform_arithmetic_i32_wrap())||
       c.safety_checked!=0||c.sanitize_memory!=0||c.automatic_selection!=1){
        return ztc_reject("certificate-policy");}
    if(!@strEq(raw.schema_version,"zag-ir-v1")||!@strEq(raw.transform_version,"zag-transform-v1")||
       raw.coverage_complete!=1||raw.coverage_errors!=0||raw.origin_complete!=1||raw.origin_exact!=1||
       zir_verify_contracts(raw).valid==0||zir_verify_contracts(proposal.candidate).valid==0||
       verify_module(raw)!=0||verify_module(proposal.candidate)!=0||
       zir_module_ssa_unique_all(raw)==0||zir_module_ssa_unique_all(proposal.candidate)==0){
        return ztc_reject("raw-domain");}
    if(zir_identity_equal(c.before,zir_semantic_identity(raw))==0||
       zir_identity_equal(c.after,zir_semantic_identity(proposal.candidate))==0||
       zir_identity_equal(c.before,c.after)==1){return ztc_reject("semantic-identity");}
    if(c.function_index<0||c.function_index>=raw.funcs.len||
       c.function_index>=proposal.candidate.funcs.len){return ztc_reject("function-index");}
    let rf:ZFunc=raw.funcs.data[c.function_index];let cf:ZFunc=proposal.candidate.funcs.data[c.function_index];
    if(c.op_index<0||c.op_index>=rf.body.ops.len||c.op_index>=cf.body.ops.len||
       c.lhs_def_index<0||c.rhs_def_index<0||c.lhs_def_index>=c.op_index||
       c.rhs_def_index>=c.op_index||c.lhs_def_index==c.rhs_def_index||
       zir_module_equal_except_top_op(raw,proposal.candidate,c.function_index,c.op_index)==0){
        return ztc_reject("op-index");}
    if(rf.effects!=0||rf.coverage_complete!=1||rf.coverage_errors!=0||
       zir_origin_rule_usable(rf.origin)==0){return ztc_reject("function-domain");}
    let sub:ZOp=rf.body.ops.data[c.op_index];
    if(!@strEq(sub.name,"arith.subi")||sub.results.len!=1||sub.operands.len!=2||
       sub.attrs.len!=0||sub.regions.len!=0||sub.effects!=0||!@strEq(sub.reads,"none")||
       !@strEq(sub.writes,"none")||!@strEq(sub.results.data[0].ty,"i32")||
       !@strEq(sub.operands.data[0].ty,"i32")||!@strEq(sub.operands.data[1].ty,"i32")||
       zir_origin_rule_usable(sub.origin)==0||zir_origin_rule_usable(sub.results.data[0].origin)==0){
        return ztc_reject("neg-domain");}
    let lhs:ZirConstMatch=ztc_prior_constant(rf.body,c.op_index,sub.operands.data[0]);
    let rhs:ZirConstMatch=ztc_prior_constant(rf.body,c.op_index,sub.operands.data[1]);
    if(lhs.valid!=1||rhs.valid!=1||lhs.index!=c.lhs_def_index||rhs.index!=c.rhs_def_index||
       lhs.index==rhs.index||lhs.value!=0||rhs.value<0||rhs.value>2147483647||
       @strEq(sub.operands.data[0].name,sub.operands.data[1].name)||
       @strEq(sub.results.data[0].name,sub.operands.data[0].name)||
       @strEq(sub.results.data[0].name,sub.operands.data[1].name)||
       zir_count_ssa_function(rf,sub.operands.data[0].name)!=1||
       zir_count_ssa_function(rf,sub.operands.data[1].name)!=1||
       zir_count_ssa_function(rf,sub.results.data[0].name)!=1||
       zir_count_ssa_function(cf,sub.operands.data[0].name)!=1||
       zir_count_ssa_function(cf,sub.operands.data[1].name)!=1||
       zir_count_ssa_function(cf,sub.results.data[0].name)!=1){return ztc_reject("ssa-domain");}
    let expected:i64=0-rhs.value;
    if(ztc_candidate_constant(cf.body.ops.data[c.op_index],sub.results.data[0],expected)==0||
       zir_origin_equal(cf.body.ops.data[c.op_index].origin,sub.origin)==0){return ztc_reject("candidate-result");}
    if(!@strEq(c.function_name,rf.name)||!@strEq(c.lhs_ssa,sub.operands.data[0].name)||
       !@strEq(c.rhs_ssa,sub.operands.data[1].name)||!@strEq(c.result_ssa,sub.results.data[0].name)||
       !@strEq(c.result_type,"i32")||zir_origin_equal(c.function_origin,rf.origin)==0||
       zir_origin_equal(c.op_origin,sub.origin)==0||
       zir_origin_equal(c.lhs_def_origin,rf.body.ops.data[lhs.index].origin)==0||
       zir_origin_equal(c.rhs_def_origin,rf.body.ops.data[rhs.index].origin)==0||
       zir_origin_equal(c.lhs_origin,sub.operands.data[0].origin)==0||
       zir_origin_equal(c.rhs_origin,sub.operands.data[1].origin)==0||
       zir_origin_equal(c.result_origin,sub.results.data[0].origin)==0||
       c.lhs_value!=lhs.value||c.rhs_value!=rhs.value||c.result_value!=expected){
        return ztc_reject("certificate-facts");}
    return ZirTransformCheck{.accepted=1,.reason="structural_negation_checked_test_only"};
}

// Independent structural checker for the bounded bool predicate rule. It
// re-parses bool literals, validates the exact eq/ne predicate, and binds the
// replacement to the unchanged SSA/origin identities before accepting it.
fn zir_check_const_bool_cmp(raw:ZModule,proposal:ZirTransformProposal)ZirTransformCheck{
    if(proposal.proposed!=1){return ztc_reject("proposal-count");}let c:ZirTransformCertificate=proposal.certificate;
    if(c.valid!=1||!@strEq(c.format,zir_transform_cert_format())||!@strEq(c.identity_schema,zir_transform_identity_schema())||
       !@strEq(c.rule,zir_transform_rule_const_bool_cmp())||!@strEq(c.checker,zir_transform_checker_const_bool_cmp())||
       !@strEq(c.ir_verifier,zir_ir_verifier_name())||c.transform_count!=1){return ztc_reject("certificate-header");}
    if(!@strEq(c.source_context,zir_transform_source_context_const_bool_cmp())||
       !@strEq(c.policy_target,zir_transform_target_linux_x86_64())||!@strEq(c.policy_edition,zir_transform_edition_regular())||
       !@strEq(c.arithmetic_policy,zir_transform_arithmetic_bool_predicate())||c.safety_checked!=0||
       c.sanitize_memory!=0||c.automatic_selection!=1){return ztc_reject("certificate-policy");}
    if(!@strEq(raw.schema_version,"zag-ir-v1")||!@strEq(raw.transform_version,"zag-transform-v1")||raw.coverage_complete!=1||
       raw.coverage_errors!=0||raw.origin_complete!=1||raw.origin_exact!=1||zir_verify_contracts(raw).valid==0||
       zir_verify_contracts(proposal.candidate).valid==0||verify_module(raw)!=0||verify_module(proposal.candidate)!=0||
       zir_module_ssa_unique_all(raw)==0||zir_module_ssa_unique_all(proposal.candidate)==0){return ztc_reject("raw-domain");}
    if(zir_identity_equal(c.before,zir_semantic_identity(raw))==0||zir_identity_equal(c.after,zir_semantic_identity(proposal.candidate))==0||
       zir_identity_equal(c.before,c.after)==1){return ztc_reject("semantic-identity");}
    if(c.function_index<0||c.function_index>=raw.funcs.len||c.function_index>=proposal.candidate.funcs.len){return ztc_reject("function-index");}
    let rf:ZFunc=raw.funcs.data[c.function_index];let cf:ZFunc=proposal.candidate.funcs.data[c.function_index];
    if(c.op_index<0||c.op_index>=rf.body.ops.len||c.op_index>=cf.body.ops.len||c.lhs_def_index<0||c.rhs_def_index<0||
       c.lhs_def_index>=c.op_index||c.rhs_def_index>=c.op_index||c.lhs_def_index==c.rhs_def_index||
       zir_module_equal_except_top_op(raw,proposal.candidate,c.function_index,c.op_index)==0){return ztc_reject("op-index");}
    if(rf.effects!=0||rf.coverage_complete!=1||rf.coverage_errors!=0||zir_origin_rule_usable(rf.origin)==0){return ztc_reject("function-domain");}
    let cmp:ZOp=rf.body.ops.data[c.op_index];
    if(!@strEq(cmp.name,"arith.cmpi")||cmp.results.len!=1||cmp.operands.len!=2||cmp.attrs.len!=1||
       !@strEq(cmp.attrs.data[0].key,"predicate")||(!@strEq(cmp.attrs.data[0].val,"eq")&&!@strEq(cmp.attrs.data[0].val,"ne"))||
       cmp.regions.len!=0||cmp.effects!=0||!@strEq(cmp.reads,"none")||!@strEq(cmp.writes,"none")||
       !@strEq(cmp.results.data[0].ty,"bool")||!@strEq(cmp.operands.data[0].ty,"bool")||
       !@strEq(cmp.operands.data[1].ty,"bool")||zir_origin_rule_usable(cmp.origin)==0||
       zir_origin_rule_usable(cmp.results.data[0].origin)==0){return ztc_reject("cmp-domain");}
    let lhs:ZirConstMatch=ztc_prior_constant_bool(rf.body,c.op_index,cmp.operands.data[0]);let rhs:ZirConstMatch=ztc_prior_constant_bool(rf.body,c.op_index,cmp.operands.data[1]);
    if(lhs.valid!=1||rhs.valid!=1||lhs.index!=c.lhs_def_index||rhs.index!=c.rhs_def_index||lhs.index==rhs.index||
       @strEq(cmp.operands.data[0].name,cmp.operands.data[1].name)||@strEq(cmp.results.data[0].name,cmp.operands.data[0].name)||
       @strEq(cmp.results.data[0].name,cmp.operands.data[1].name)||zir_count_ssa_function(rf,cmp.operands.data[0].name)!=1||
       zir_count_ssa_function(rf,cmp.operands.data[1].name)!=1||zir_count_ssa_function(rf,cmp.results.data[0].name)!=1||
       zir_count_ssa_function(cf,cmp.operands.data[0].name)!=1||zir_count_ssa_function(cf,cmp.operands.data[1].name)!=1||
       zir_count_ssa_function(cf,cmp.results.data[0].name)!=1){return ztc_reject("ssa-domain");}
    let expected:i64=0;if(@strEq(cmp.attrs.data[0].val,"eq")){expected=(lhs.value==rhs.value) as i64;}else{expected=(lhs.value!=rhs.value) as i64;}
    if(ztc_candidate_constant_bool(cf.body.ops.data[c.op_index],cmp.results.data[0],expected)==0||
       zir_origin_equal(cf.body.ops.data[c.op_index].origin,cmp.origin)==0){return ztc_reject("candidate-result");}
    if(!@strEq(c.function_name,rf.name)||!@strEq(c.lhs_ssa,cmp.operands.data[0].name)||!@strEq(c.rhs_ssa,cmp.operands.data[1].name)||
       !@strEq(c.result_ssa,cmp.results.data[0].name)||!@strEq(c.result_type,"bool")||zir_origin_equal(c.function_origin,rf.origin)==0||
       zir_origin_equal(c.op_origin,cmp.origin)==0||zir_origin_equal(c.lhs_def_origin,rf.body.ops.data[lhs.index].origin)==0||
       zir_origin_equal(c.rhs_def_origin,rf.body.ops.data[rhs.index].origin)==0||zir_origin_equal(c.lhs_origin,cmp.operands.data[0].origin)==0||
       zir_origin_equal(c.rhs_origin,cmp.operands.data[1].origin)==0||zir_origin_equal(c.result_origin,cmp.results.data[0].origin)==0||
       c.lhs_value!=lhs.value||c.rhs_value!=rhs.value||c.result_value!=expected){return ztc_reject("certificate-facts");}
    return ZirTransformCheck{.accepted=1,.reason="structural_bool_predicate_checked_test_only"};
}

// Resolve source semantics independently from the producer and from ZIR's
// value-type strings.  The first rule admits only a direct `a + b` whose two
// children are canonical integer literals and whose contextual i32 type is
// explicit in source: either an annotated local initializer or an i32 return.
// Nested, inferred, assigned, argument-coerced, and imported contexts remain
// raw until a real typed-expression authority can bind them.
fn ztc_source_literal_matches(n:*Node,origins:ArrayList[NodeOrigin],want:ZOrigin,
    want_def:ZOrigin,value:i64)i32{
    switch(n.*){
        .ilit=>|lit|{
            let parsed:ZirI32Literal=ztc_parse_i32(lit.text);
            let own:ZOrigin=zir_node_origin(origins,n);
            return (parsed.valid==1&&parsed.value==value&&
                zir_origin_equal(own,want)==1&&zir_origin_equal(own,want_def)==1) as i32;
        }
        else=>{}
    }
    return 0;
}
fn ztc_source_neg_matches(n:*Node,origins:ArrayList[NodeOrigin],
    c:ZirTransformCertificate)i32{
    let own:ZOrigin=zir_node_origin(origins,n);
    if(zir_origin_equal(own,c.op_origin)==0||zir_origin_equal(own,c.result_origin)==0){return 0;}
    switch(n.*){
        .un=>|u|{if(!@strEq(u.op,"-")){return 0;}
            return ztc_source_literal_matches(u.e,origins,c.rhs_origin,
                c.rhs_def_origin,c.rhs_value);}
        else=>{}
    }
    return 0;
}
fn ztc_source_stmt_context_const_i32_neg(stmt:*Node,f:FnDecl,
    origins:ArrayList[NodeOrigin],c:ZirTransformCertificate)i32{
    switch(stmt.*){
        .let_=>|local|{if(local.has_init==1&&local.has_dty==1&&
            @strEq(local.dty,"i32")&&ztc_source_neg_matches(local.expr,origins,c)==1){return 1;}}
        .ret=>|r|{if(r.has_expr==1&&@strEq(f.ret,"i32")&&
            ztc_source_neg_matches(r.expr,origins,c)==1){return 1;}}
        else=>{}
    }
    return 0;
}
fn ztc_source_context_const_i32_neg(decls:ArrayList[*Node],
    origins:ArrayList[NodeOrigin],c:ZirTransformCertificate)i32{
    let function_hits:i32=0;let context_hits:i32=0;let i:i32=0;
    while(i<decls.len){let node:*Node=decls.data[i];switch(node.*){
        .fn_decl=>|f|{let own:ZOrigin=zir_node_origin(origins,node);
            if(f.is_extern==0&&@strEq(f.name,c.function_name)&&
               zir_origin_equal(own,c.function_origin)==1){
                function_hits=function_hits+1;let s:i32=0;while(s<f.body.len){
                    context_hits=context_hits+ztc_source_stmt_context_const_i32_neg(
                        f.body.data[s],f,origins,c);s=s+1;}
            }}
        else=>{}
    }i=i+1;}
    return (function_hits==1&&context_hits==1) as i32;
}
fn ztc_source_add_matches(n:*Node,origins:ArrayList[NodeOrigin],
    c:ZirTransformCertificate)i32{
    let own:ZOrigin=zir_node_origin(origins,n);
    if(zir_origin_equal(own,c.op_origin)==0||zir_origin_equal(own,c.result_origin)==0){return 0;}
    switch(n.*){
        .bin=>|b|{
            if(!@strEq(b.op,"+")){return 0;}
            return (ztc_source_literal_matches(b.l,origins,c.lhs_origin,
                    c.lhs_def_origin,c.lhs_value)==1&&
                ztc_source_literal_matches(b.r,origins,c.rhs_origin,
                    c.rhs_def_origin,c.rhs_value)==1) as i32;
        }
        else=>{}
    }
    return 0;
}
fn ztc_source_stmt_context(stmt:*Node,f:FnDecl,origins:ArrayList[NodeOrigin],
    c:ZirTransformCertificate)i32{
    switch(stmt.*){
        .let_=>|local|{
            if(local.has_init==1&&local.has_dty==1&&@strEq(local.dty,"i32")&&
               ztc_source_add_matches(local.expr,origins,c)==1){return 1;}
        }
        .ret=>|r|{
            if(r.has_expr==1&&@strEq(f.ret,"i32")&&
               ztc_source_add_matches(r.expr,origins,c)==1){return 1;}
        }
        else=>{}
    }
    return 0;
}
fn ztc_source_context_const_i32_add(decls:ArrayList[*Node],origins:ArrayList[NodeOrigin],
    c:ZirTransformCertificate)i32{
    let function_hits:i32=0;let context_hits:i32=0;let i:i32=0;
    while(i<decls.len){let node:*Node=decls.data[i];switch(node.*){
        .fn_decl=>|f|{
            let own:ZOrigin=zir_node_origin(origins,node);
            if(f.is_extern==0&&@strEq(f.name,c.function_name)&&
               zir_origin_equal(own,c.function_origin)==1){
                function_hits=function_hits+1;let s:i32=0;
                while(s<f.body.len){context_hits=context_hits+
                    ztc_source_stmt_context(f.body.data[s],f,origins,c);s=s+1;}
            }
        }
        else=>{}
    }i=i+1;}
    return (function_hits==1&&context_hits==1) as i32;
}

fn zir_script_generated_decls(decls:ArrayList[*Node])i32{
    let uncaught:i32=0;let body:i32=0;let main:i32=0;let i:i32=0;
    while(i<decls.len){switch(decls.data[i].*){
        .fn_decl=>|f|{
            if(@strEq(f.name,"__zag_compiler_script_uncaught_7f3a")){uncaught=uncaught+1;}
            if(@strEq(f.name,"__zag_compiler_script_body_7f3a")){body=body+1;}
            if(@strEq(f.name,"main")){main=main+1;}
        }
        else=>{}
    }i=i+1;}
    return (uncaught==1&&body==1&&main==1) as i32;
}

// The source/policy checker reuses only the independently coded structural
// checker, then binds facts that the raw ZIR cannot authoritatively supply.
// The policy comes from the caller; the certificate must agree with it but
// cannot grant itself a target, edition, wrapping rule, or safety exemption.
fn zir_check_const_i32_add_source_policy(raw:ZModule,decls:ArrayList[*Node],
    origins:ArrayList[NodeOrigin],policy:ZirTransformPolicy,
    proposal:ZirTransformProposal)ZirTransformCheck{
    let structural:ZirTransformCheck=zir_check_const_i32_add(raw,proposal);
    if(structural.accepted!=1){return structural;}
    if(zir_script_generated_envelope(raw)==1&&zir_script_generated_decls(decls)==0){
        return ztc_reject("script-envelope-source");
    }
    if(zir_transform_policy_const_i32_add_allowed(policy)==0){return ztc_reject("policy-domain");}
    let c:ZirTransformCertificate=proposal.certificate;
    if(!@strEq(c.policy_target,policy.target)||!@strEq(c.policy_edition,policy.edition)||
       !@strEq(c.arithmetic_policy,policy.arithmetic)||
       c.safety_checked!=policy.safety_checked||c.sanitize_memory!=policy.sanitize_memory||
       c.automatic_selection!=policy.automatic_selection){return ztc_reject("policy-binding");}
    if(ztc_source_context_const_i32_add(decls,origins,c)!=1){return ztc_reject("source-context");}
    return ZirTransformCheck{.accepted=1,.reason="foreground_source_policy_checked"};
}

fn zir_check_const_i32_neg_source_policy(raw:ZModule,decls:ArrayList[*Node],
    origins:ArrayList[NodeOrigin],policy:ZirTransformPolicy,
    proposal:ZirTransformProposal)ZirTransformCheck{
    let structural:ZirTransformCheck=zir_check_const_i32_neg(raw,proposal);
    if(structural.accepted!=1){return structural;}
    if(zir_transform_policy_const_i32_add_allowed(policy)==0){return ztc_reject("policy-domain");}
    let c:ZirTransformCertificate=proposal.certificate;
    if(!@strEq(c.policy_target,policy.target)||!@strEq(c.policy_edition,policy.edition)||
       !@strEq(c.arithmetic_policy,policy.arithmetic)||
       c.safety_checked!=policy.safety_checked||c.sanitize_memory!=policy.sanitize_memory||
       c.automatic_selection!=policy.automatic_selection){return ztc_reject("policy-binding");}
    if(ztc_source_context_const_i32_neg(decls,origins,c)!=1){return ztc_reject("source-context");}
    return ZirTransformCheck{.accepted=1,.reason="foreground_negation_source_policy_checked"};
}

fn ztc_source_bool_literal_matches(n:*Node,origins:ArrayList[NodeOrigin],want:ZOrigin,
    want_def:ZOrigin,value:i64)i32{
    switch(n.*){
        .id=>|id|{let expected:[]u8="false";if(value==1){expected="true";}
            let own:ZOrigin=zir_node_origin(origins,n);
            return (@strEq(id.name,expected)&&zir_origin_equal(own,want)==1&&zir_origin_equal(own,want_def)==1) as i32;}
        else=>{}
    }
    return 0;
}
fn ztc_source_bool_cmp_matches(n:*Node,origins:ArrayList[NodeOrigin],c:ZirTransformCertificate)i32{
    let own:ZOrigin=zir_node_origin(origins,n);if(zir_origin_equal(own,c.op_origin)==0||zir_origin_equal(own,c.result_origin)==0){return 0;}
    switch(n.*){
        .bin=>|b|{
            if((@strEq(b.op,"==")&&c.result_value!=((c.lhs_value==c.rhs_value) as i64))||
               (@strEq(b.op,"!=")&&c.result_value!=((c.lhs_value!=c.rhs_value) as i64))){return 0;}
            if(!@strEq(b.op,"==")&&!@strEq(b.op,"!=")){return 0;}
            return (ztc_source_bool_literal_matches(b.l,origins,c.lhs_origin,c.lhs_def_origin,c.lhs_value)==1&&
                ztc_source_bool_literal_matches(b.r,origins,c.rhs_origin,c.rhs_def_origin,c.rhs_value)==1) as i32;
        }
        else=>{}
    }
    return 0;
}
fn ztc_source_stmt_context_bool_cmp(stmt:*Node,f:FnDecl,origins:ArrayList[NodeOrigin],c:ZirTransformCertificate)i32{
    switch(stmt.*){
        .let_=>|local|{if(local.has_init==1&&local.has_dty==1&&@strEq(local.dty,"bool")&&ztc_source_bool_cmp_matches(local.expr,origins,c)==1){return 1;}}
        .ret=>|r|{if(r.has_expr==1&&@strEq(f.ret,"bool")&&ztc_source_bool_cmp_matches(r.expr,origins,c)==1){return 1;}}
        else=>{}
    }
    return 0;
}
fn ztc_source_context_const_bool_cmp(decls:ArrayList[*Node],origins:ArrayList[NodeOrigin],c:ZirTransformCertificate)i32{
    let function_hits:i32=0;let context_hits:i32=0;let i:i32=0;while(i<decls.len){let node:*Node=decls.data[i];switch(node.*){
        .fn_decl=>|f|{let own:ZOrigin=zir_node_origin(origins,node);if(f.is_extern==0&&@strEq(f.name,c.function_name)&&zir_origin_equal(own,c.function_origin)==1){
            function_hits=function_hits+1;let s:i32=0;while(s<f.body.len){context_hits=context_hits+ztc_source_stmt_context_bool_cmp(f.body.data[s],f,origins,c);s=s+1;}}
        }
        else=>{}
    }i=i+1;}
    return (function_hits==1&&context_hits==1) as i32;
}
fn zir_check_const_bool_cmp_source_policy(raw:ZModule,decls:ArrayList[*Node],origins:ArrayList[NodeOrigin],policy:ZirTransformPolicy,proposal:ZirTransformProposal)ZirTransformCheck{
    let structural:ZirTransformCheck=zir_check_const_bool_cmp(raw,proposal);if(structural.accepted!=1){return structural;}
    if(zir_transform_policy_const_bool_cmp_allowed(policy)==0){return ztc_reject("policy-domain");}
    let c:ZirTransformCertificate=proposal.certificate;
    if(!@strEq(c.policy_target,policy.target)||!@strEq(c.policy_edition,policy.edition)||!@strEq(c.arithmetic_policy,policy.arithmetic)||
       c.safety_checked!=policy.safety_checked||c.sanitize_memory!=policy.sanitize_memory||c.automatic_selection!=policy.automatic_selection){return ztc_reject("policy-binding");}
    if(ztc_source_context_const_bool_cmp(decls,origins,c)!=1){return ztc_reject("source-context");}
    return ZirTransformCheck{.accepted=1,.reason="foreground_bool_source_policy_checked"};
}

fn ztc_parse_i64_defined(text:[]u8)ZirI32Literal{
    let bad:ZirI32Literal=ZirI32Literal{.value=0,.valid=0};if(text.len<1){return bad;}
    let start:i32=0;let negative:i32=0;if(text[0]=='-'){negative=1;start=1;}
    if(start==text.len||text[start]=='+'){return bad;}
    if(text[start]=='0'&&(start+1!=text.len||negative==1)){return bad;}
    let limit:i64=4611686018427387903;let value:i64=0;let i:i32=start;
    while(i<text.len){if(text[i]<'0'||text[i]>'9'){return bad;}
        let digit:i64=(text[i] as i64)-48;if(value>(limit-digit)/10){return bad;}
        value=value*10+digit;i=i+1;}
    if(negative==1){return ZirI32Literal{.value=0-value,.valid=1};}
    return ZirI32Literal{.value=value,.valid=1};
}
fn ztc_constant_at_i64(op:ZOp,want:ZVal)ZirI32Literal{
    let bad:ZirI32Literal=ZirI32Literal{.value=0,.valid=0};
    if(!@strEq(op.name,"arith.constant")||op.results.len!=1||op.operands.len!=0||op.attrs.len!=1||
       op.regions.len!=0||op.effects!=0||!@strEq(op.reads,"none")||!@strEq(op.writes,"none")||
       !@strEq(op.attrs.data[0].key,"value")||!@strEq(op.results.data[0].ty,"i64")||
       zir_value_equal(op.results.data[0],want)==0||zir_origin_rule_usable(op.origin)==0||
       zir_origin_rule_usable(op.results.data[0].origin)==0){return bad;}
    return ztc_parse_i64_defined(op.attrs.data[0].val);
}
fn ztc_prior_constant_i64(blk:ZBlock,before:i32,want:ZVal)ZirConstMatch{
    let hits:i32=0;let at:i32=before-1;let selected:i32=0-1;let value:i64=0;
    while(at>=0){let op:ZOp=blk.ops.data[at];let r:i32=op.results.len-1;
        while(r>=0){if(@strEq(op.results.data[r].name,want.name)){
            hits=hits+1;if(r!=0){return ZirConstMatch{.index=0-1,.value=0,.valid=0};}
            let literal:ZirI32Literal=ztc_constant_at_i64(op,want);if(literal.valid!=1){return ZirConstMatch{.index=0-1,.value=0,.valid=0};}
            selected=at;value=literal.value;}r=r-1;}at=at-1;}
    if(hits!=1){return ZirConstMatch{.index=0-1,.value=0,.valid=0};}
    return ZirConstMatch{.index=selected,.value=value,.valid=1};
}
fn ztc_candidate_constant_i64(op:ZOp,raw_result:ZVal,expected:i64)i32{
    if(!@strEq(op.name,"arith.constant")||op.results.len!=1||op.operands.len!=0||op.attrs.len!=1||
       op.regions.len!=0||op.effects!=0||!@strEq(op.reads,"none")||!@strEq(op.writes,"none")||
       !@strEq(op.attrs.data[0].key,"value")||zir_value_equal(op.results.data[0],raw_result)==0){return 0;}
    let parsed:ZirI32Literal=ztc_parse_i64_defined(op.attrs.data[0].val);
    return (parsed.valid==1&&parsed.value==expected) as i32;
}
fn zir_check_const_i64_add(raw:ZModule,proposal:ZirTransformProposal)ZirTransformCheck{
    if(proposal.proposed!=1){return ztc_reject("proposal-count");}let c:ZirTransformCertificate=proposal.certificate;
    if(c.valid!=1||!@strEq(c.format,zir_transform_cert_format())||!@strEq(c.identity_schema,zir_transform_identity_schema())||
       !@strEq(c.rule,zir_transform_rule_const_i64_add())||!@strEq(c.checker,zir_transform_checker_const_i64_add())||
       !@strEq(c.ir_verifier,zir_ir_verifier_name())||c.transform_count!=1){return ztc_reject("certificate-header");}
    if(!@strEq(c.source_context,zir_transform_source_context_const_i64_add())||
       !@strEq(c.policy_target,zir_transform_target_linux_x86_64())||!@strEq(c.policy_edition,zir_transform_edition_regular())||
       !@strEq(c.arithmetic_policy,zir_transform_arithmetic_i64_defined())||c.safety_checked!=0||c.sanitize_memory!=0||c.automatic_selection!=1){return ztc_reject("certificate-policy");}
    if(!@strEq(raw.schema_version,"zag-ir-v1")||!@strEq(raw.transform_version,"zag-transform-v1")||raw.coverage_complete!=1||raw.coverage_errors!=0||
       raw.origin_complete!=1||raw.origin_exact!=1||zir_verify_contracts(raw).valid==0||zir_verify_contracts(proposal.candidate).valid==0||
       verify_module(raw)!=0||verify_module(proposal.candidate)!=0||zir_module_ssa_unique_all(raw)==0||zir_module_ssa_unique_all(proposal.candidate)==0){return ztc_reject("raw-domain");}
    if(zir_identity_equal(c.before,zir_semantic_identity(raw))==0||zir_identity_equal(c.after,zir_semantic_identity(proposal.candidate))==0||zir_identity_equal(c.before,c.after)==1){return ztc_reject("semantic-identity");}
    if(c.function_index<0||c.function_index>=raw.funcs.len||c.function_index>=proposal.candidate.funcs.len){return ztc_reject("function-index");}
    let rf:ZFunc=raw.funcs.data[c.function_index];let cf:ZFunc=proposal.candidate.funcs.data[c.function_index];
    if(c.op_index<0||c.op_index>=rf.body.ops.len||c.op_index>=cf.body.ops.len||c.lhs_def_index<0||c.rhs_def_index<0||
       c.lhs_def_index>=c.op_index||c.rhs_def_index>=c.op_index||c.lhs_def_index==c.rhs_def_index||
       zir_module_equal_except_top_op(raw,proposal.candidate,c.function_index,c.op_index)==0){return ztc_reject("op-index");}
    if(rf.effects!=0||rf.coverage_complete!=1||rf.coverage_errors!=0||zir_origin_rule_usable(rf.origin)==0){return ztc_reject("function-domain");}
    let add:ZOp=rf.body.ops.data[c.op_index];
    if(!@strEq(add.name,"arith.addi")||add.results.len!=1||add.operands.len!=2||add.attrs.len!=0||add.regions.len!=0||add.effects!=0||
       !@strEq(add.reads,"none")||!@strEq(add.writes,"none")||!@strEq(add.results.data[0].ty,"i64")||
       !@strEq(add.operands.data[0].ty,"i64")||!@strEq(add.operands.data[1].ty,"i64")||zir_origin_rule_usable(add.origin)==0||
       zir_origin_rule_usable(add.results.data[0].origin)==0){return ztc_reject("add-domain");}
    let lhs:ZirConstMatch=ztc_prior_constant_i64(rf.body,c.op_index,add.operands.data[0]);let rhs:ZirConstMatch=ztc_prior_constant_i64(rf.body,c.op_index,add.operands.data[1]);
    if(lhs.valid!=1||rhs.valid!=1||lhs.index!=c.lhs_def_index||rhs.index!=c.rhs_def_index||lhs.index==rhs.index||
       @strEq(add.operands.data[0].name,add.operands.data[1].name)||@strEq(add.results.data[0].name,add.operands.data[0].name)||
       @strEq(add.results.data[0].name,add.operands.data[1].name)||zir_count_ssa_function(rf,add.operands.data[0].name)!=1||
       zir_count_ssa_function(rf,add.operands.data[1].name)!=1||zir_count_ssa_function(rf,add.results.data[0].name)!=1||
       zir_count_ssa_function(cf,add.operands.data[0].name)!=1||zir_count_ssa_function(cf,add.operands.data[1].name)!=1||
       zir_count_ssa_function(cf,add.results.data[0].name)!=1){return ztc_reject("ssa-domain");}
    let expected:i64=lhs.value+rhs.value;
    if(ztc_candidate_constant_i64(cf.body.ops.data[c.op_index],add.results.data[0],expected)==0||zir_origin_equal(cf.body.ops.data[c.op_index].origin,add.origin)==0){return ztc_reject("candidate-result");}
    if(!@strEq(c.function_name,rf.name)||!@strEq(c.lhs_ssa,add.operands.data[0].name)||!@strEq(c.rhs_ssa,add.operands.data[1].name)||
       !@strEq(c.result_ssa,add.results.data[0].name)||!@strEq(c.result_type,"i64")||zir_origin_equal(c.function_origin,rf.origin)==0||
       zir_origin_equal(c.op_origin,add.origin)==0||zir_origin_equal(c.lhs_def_origin,rf.body.ops.data[lhs.index].origin)==0||
       zir_origin_equal(c.rhs_def_origin,rf.body.ops.data[rhs.index].origin)==0||zir_origin_equal(c.lhs_origin,add.operands.data[0].origin)==0||
       zir_origin_equal(c.rhs_origin,add.operands.data[1].origin)==0||zir_origin_equal(c.result_origin,add.results.data[0].origin)==0||
       c.lhs_value!=lhs.value||c.rhs_value!=rhs.value||c.result_value!=expected){return ztc_reject("certificate-facts");}
    return ZirTransformCheck{.accepted=1,.reason="foreground_i64_source_policy_checked"};
}
fn ztc_source_context_const_i64_add(decls:ArrayList[*Node],origins:ArrayList[NodeOrigin],c:ZirTransformCertificate)i32{
    let function_hits:i32=0;let context_hits:i32=0;let i:i32=0;while(i<decls.len){let node:*Node=decls.data[i];switch(node.*){
        .fn_decl=>|f|{let own:ZOrigin=zir_node_origin(origins,node);if(f.is_extern==0&&@strEq(f.name,c.function_name)&&zir_origin_equal(own,c.function_origin)==1){
            function_hits=function_hits+1;let s:i32=0;while(s<f.body.len){switch(f.body.data[s].*){
                .let_=>|local|{if(local.has_init==1&&local.has_dty==1&&@strEq(local.dty,"i64")&&ztc_source_add_matches(local.expr,origins,c)==1){context_hits=context_hits+1;}}
                .ret=>|r|{if(r.has_expr==1&&@strEq(f.ret,"i64")&&ztc_source_add_matches(r.expr,origins,c)==1){context_hits=context_hits+1;}}
                else=>{}}s=s+1;}
        }}else=>{}}i=i+1;}
    return (function_hits==1&&context_hits==1) as i32;
}
fn zir_check_const_i64_add_source_policy(raw:ZModule,decls:ArrayList[*Node],origins:ArrayList[NodeOrigin],policy:ZirTransformPolicy,proposal:ZirTransformProposal)ZirTransformCheck{
    let structural:ZirTransformCheck=zir_check_const_i64_add(raw,proposal);if(structural.accepted!=1){return structural;}
    if(zir_transform_policy_const_i64_add_allowed(policy)==0){return ztc_reject("policy-domain");}let c:ZirTransformCertificate=proposal.certificate;
    if(!@strEq(c.policy_target,policy.target)||!@strEq(c.policy_edition,policy.edition)||!@strEq(c.arithmetic_policy,policy.arithmetic)||
       c.safety_checked!=policy.safety_checked||c.sanitize_memory!=policy.sanitize_memory||c.automatic_selection!=policy.automatic_selection){return ztc_reject("policy-binding");}
    if(ztc_source_context_const_i64_add(decls,origins,c)!=1){return ztc_reject("source-context");}
    return ZirTransformCheck{.accepted=1,.reason="foreground_i64_source_policy_checked"};
}

fn zir_authority_selected(module:ZModule,decls:ArrayList[*Node],valid:i32,errors:i32,
    status:[]u8,rule:[]u8,checker:[]u8,count:i32,cert:ZirTransformCertificate)ZirAuthority{
    let contract:ZirContractReport=zir_verify_contracts(module);
    return ZirAuthority{.module=module,.ast_bridge=decls,.valid=valid,
        .verify_errors=errors,.coverage_complete=module.coverage_complete,
        .coverage_errors=module.coverage_errors,.origin_complete=module.origin_complete,
        .origin_exact=module.origin_exact,.transform_status=status,.transform_rule=rule,
        .transform_checker=checker,.transform_count=count,.certificate=cert,
        .contract_valid=contract.valid,.contract_errors=contract.errors,
        .contract_checked_ops=contract.checked_ops,.contract_checked_values=contract.checked_values,
        .contract_type_complete=contract.type_complete,.contract_effects_complete=contract.effects_complete,
        .contract_ownership_complete=contract.ownership_complete,.contract_alias_complete=contract.alias_complete,
        .contract_lifetime_complete=contract.lifetime_complete,.contract_layout_complete=contract.layout_complete,
        .contract_origin_complete=contract.origin_complete,.contract_reason=contract.reason};
}
// Unsupported source constructs deliberately produce a partial raw module.
// Their placeholder values and incomplete regions are not semantic authority,
// but they must still reach the AST bridge. Keep strict def-before-use and SSA
// checks for complete modules (including forged complete IR); only the bounded
// incomplete route may carry structural gaps, and it is never eligible for
// direct ZIR lowering or a transformation.
fn zir_selection_structural_ok(raw:ZModule,errors:i32)i32{
    if(raw.coverage_complete!=1||raw.coverage_errors!=0){return 1;}
    return (errors==0&&zir_module_ssa_unique_all(raw)==1) as i32;
}
fn zir_select_foreground_transform(raw:ZModule,decls:ArrayList[*Node],proposal:ZirTransformProposal)ZirAuthority{
    let errors:i32=verify_module(raw);
    // A builder-produced module with a def-before-use gap is not direct-ZIR
    // authority. Demote it to the same explicit AST-bridge boundary as any
    // unsupported source construct; keep the standalone verifier strict for
    // forged/negative tests and preserve the diagnostic count.
    if(errors>0){raw.coverage_complete=0;raw.coverage_errors=raw.coverage_errors+errors;}
    let valid:i32=(zir_selection_structural_ok(raw,errors)==1&&
        @strEq(raw.schema_version,"zag-ir-v1")&&
        @strEq(raw.transform_version,"zag-transform-v1")&&
        raw.funcs.len==zir_nonextern_function_count(decls)&&
        ((raw.coverage_complete==0||raw.origin_complete==0||raw.origin_exact==0||
          zir_verify_contracts(raw).valid==1) as i32)) as i32;
    if(valid==0){return zir_authority_selected(raw,decls,0,errors,"raw_ir_invalid","none",
        "not-run",0,zir_transform_certificate_none());}
    if(proposal.proposed==0){let status:[]u8="verified_no_transform";
        if(raw.coverage_complete!=1||raw.coverage_errors!=0){
            status="verified_raw_ast_bridge_incomplete";}
        return zir_authority_selected(raw,decls,1,errors,status,"none","not-run",0,
            zir_transform_certificate_none());}
    let checked:ZirTransformCheck=zir_check_const_i32_add(raw,proposal);
    if(checked.accepted!=1){return zir_authority_selected(raw,decls,1,errors,
        "candidate_rejected_raw_fallback","none",zir_transform_structural_checker_const_i32_add(),
        0,zir_transform_certificate_none());}
    return zir_authority_selected(proposal.candidate,decls,1,0,
        "test_only_structural_transform",zir_transform_rule_const_i32_add(),
        zir_transform_structural_checker_const_i32_add(),1,proposal.certificate);
}

// This is the only selector whose transformed result is eligible for a native
// production backend. It fails back to the verified raw module for every
// absent, malformed, source-unbound, or policy-ineligible proposal.
fn zir_select_foreground_transform_source_policy(raw:ZModule,decls:ArrayList[*Node],
    origins:ArrayList[NodeOrigin],policy:ZirTransformPolicy,
    proposal:ZirTransformProposal)ZirAuthority{
    let errors:i32=verify_module(raw);
    if(errors>0){raw.coverage_complete=0;raw.coverage_errors=raw.coverage_errors+errors;}
    let valid:i32=(zir_selection_structural_ok(raw,errors)==1&&
        @strEq(raw.schema_version,"zag-ir-v1")&&
        @strEq(raw.transform_version,"zag-transform-v1")&&
        raw.funcs.len==zir_nonextern_function_count(decls)&&
        ((raw.coverage_complete==0||raw.origin_complete==0||raw.origin_exact==0||
          zir_verify_contracts(raw).valid==1) as i32)) as i32;
    if(valid==0){return zir_authority_selected(raw,decls,0,errors,"raw_ir_invalid","none",
        "not-run",0,zir_transform_certificate_none());}
    if(proposal.proposed==0){let status:[]u8="verified_no_transform";
        if(raw.coverage_complete!=1||raw.coverage_errors!=0){
            status="verified_raw_ast_bridge_incomplete";}
        return zir_authority_selected(raw,decls,1,errors,status,"none","not-run",0,
            zir_transform_certificate_none());}
    let checked:ZirTransformCheck=zir_check_const_i32_add_source_policy(raw,decls,
        origins,policy,proposal);
    if(@strEq(proposal.certificate.rule,zir_transform_rule_const_i32_neg())){
        checked=zir_check_const_i32_neg_source_policy(raw,decls,origins,policy,proposal);
    }
    if(@strEq(proposal.certificate.rule,zir_transform_rule_const_i64_add())){
        checked=zir_check_const_i64_add_source_policy(raw,decls,origins,policy,proposal);
    }
    if(@strEq(proposal.certificate.rule,zir_transform_rule_const_bool_cmp())){
        checked=zir_check_const_bool_cmp_source_policy(raw,decls,origins,policy,proposal);
    }
    if(checked.accepted!=1){let rejected_checker:[]u8=zir_transform_checker_const_i32_add();
        if(@strEq(proposal.certificate.rule,zir_transform_rule_const_i32_neg())){
            rejected_checker=zir_transform_checker_const_i32_neg();}
        if(@strEq(proposal.certificate.rule,zir_transform_rule_const_i64_add())){
            rejected_checker=zir_transform_checker_const_i64_add();}
        if(@strEq(proposal.certificate.rule,zir_transform_rule_const_bool_cmp())){
            rejected_checker=zir_transform_checker_const_bool_cmp();}
        return zir_authority_selected(raw,decls,1,errors,
            "candidate_rejected_raw_fallback","none",rejected_checker,
            0,zir_transform_certificate_none());}
    if(@strEq(proposal.certificate.rule,zir_transform_rule_const_i64_add())){
        return zir_authority_selected(proposal.candidate,decls,1,0,
            "foreground_i64_source_policy_checked",zir_transform_rule_const_i64_add(),
            zir_transform_checker_const_i64_add(),1,proposal.certificate);
    }
    if(@strEq(proposal.certificate.rule,zir_transform_rule_const_i32_neg())){
        return zir_authority_selected(proposal.candidate,decls,1,0,
            "foreground_negation_source_policy_checked",zir_transform_rule_const_i32_neg(),
            zir_transform_checker_const_i32_neg(),1,proposal.certificate);
    }
    if(@strEq(proposal.certificate.rule,zir_transform_rule_const_bool_cmp())){
        return zir_authority_selected(proposal.candidate,decls,1,0,
            "foreground_bool_source_policy_checked",zir_transform_rule_const_bool_cmp(),
            zir_transform_checker_const_bool_cmp(),1,proposal.certificate);
    }
    return zir_authority_selected(proposal.candidate,decls,1,0,
        "foreground_source_policy_checked",zir_transform_rule_const_i32_add(),
        zir_transform_checker_const_i32_add(),1,proposal.certificate);
}

// ── experimental pass: integer constant folding ───────────────────────────────────
// Retained for isolated audits only. It is not production authority: its i64
// evaluator does not establish result-width semantics, and one ConstBind table
// is shared through nested regions. Re-enable only behind an independently
// checked, type-correct transformation contract.
struct ConstBind { name: []u8, val: i64 }
fn const_find(cs: ArrayList[ConstBind], n: []u8, found: *i32) i64 {
    let i: i32 = 0;
    while (i < len[ConstBind](cs)) {
        let c: ConstBind = get[ConstBind](cs, i);
        if (@strEq(c.name, n)) { found.* = 1; return c.val; }
        i = i + 1;
    }
    found.* = 0;
    return 0;
}
fn parse_i64(s: []u8) i64 {
    let neg: i32 = 0;
    let i: i32 = 0;
    if (s.len > 0 && s[0] == '-') { neg = 1; i = 1; }
    let acc: i64 = 0;
    while (i < s.len) {
        let d: i32 = (s[i] as i32) - 48;
        if (d < 0 || d > 9) { return acc; }
        acc = acc * 10 + (d as i64);
        i = i + 1;
    }
    if (neg == 1) { return 0 - acc; }
    return acc;
}
fn apply_int_op(name: []u8, a: i64, b: i64, ok: *i32) i64 {
    ok.* = 1;
    if (@strEq(name, "arith.addi")) { return a + b; }
    if (@strEq(name, "arith.subi")) { return a - b; }
    if (@strEq(name, "arith.muli")) { return a * b; }
    if (@strEq(name, "arith.divsi")) { if (b == 0) { ok.* = 0; return 0; } return a / b; }
    if (@strEq(name, "arith.remsi")) { if (b == 0) { ok.* = 0; return 0; } return a % b; }
    if (@strEq(name, "arith.andsi")) { return a & b; }
    if (@strEq(name, "arith.orsi")) { return a | b; }
    ok.* = 0;
    return 0;
}
// returns a folded copy of the block; `folded` counts rewrites.
fn fold_block(blk: ZBlock, cs: *ArrayList[ConstBind], folded: *i32) ZBlock {
    let out: ZBlock = one_block();
    let i: i32 = 0;
    while (i < len[ZOp](blk.ops)) {
        let o: ZOp = get[ZOp](blk.ops, i);
        if (@strEq(o.name, "arith.constant") && len[ZVal](o.results) == 1) {
            push[ConstBind](cs, ConstBind{ .name = get[ZVal](o.results, 0).name, .val = parse_i64(get[ZAttr](o.attrs, 0).val) });
            push[ZOp](&out.ops, o);
        } else if (len[ZVal](o.operands) == 2 && len[ZVal](o.results) == 1 && int_op(o.name) == 1) {
            let f1: i32 = 0; let f2: i32 = 0;
            let a: i64 = const_find(cs.*, get[ZVal](o.operands, 0).name, &f1);
            let bb: i64 = const_find(cs.*, get[ZVal](o.operands, 1).name, &f2);
            let ok: i32 = 0;
            let v: i64 = apply_int_op(o.name, a, bb, &ok);
            if (f1 == 1 && f2 == 1 && ok == 1) {
                // rewrite to a constant
                let res: ZVal = get[ZVal](o.results, 0);
                let c: ZOp = mk_op("arith.constant");c.effects=o.effects;
                c.reads=o.reads;c.writes=o.writes;c.origin=o.origin;
                push[ZVal](&c.results, res);
                push[ZAttr](&c.attrs, ZAttr{ .key = "value", .val = _zag_i64_to_str(v) });
                push[ZOp](&out.ops, c);
                push[ConstBind](cs, ConstBind{ .name = res.name, .val = v });
                folded.* = folded.* + 1;
            } else {
                push[ZOp](&out.ops, fold_regions(o, cs, folded));
            }
        } else {
            push[ZOp](&out.ops, fold_regions(o, cs, folded));
        }
        i = i + 1;
    }
    return out;
}
fn int_op(name: []u8) i32 {
    if (@strEq(name, "arith.addi") || @strEq(name, "arith.subi") || @strEq(name, "arith.muli")
        || @strEq(name, "arith.divsi") || @strEq(name, "arith.remsi")||
        @strEq(name, "arith.andsi") || @strEq(name, "arith.orsi")) { return 1; }
    return 0;
}
fn fold_regions(o: ZOp, cs: *ArrayList[ConstBind], folded: *i32) ZOp {
    if (len[ZRegion](o.regions) == 0) { return o; }
    let no: ZOp = ZOp{ .name = o.name, .results = o.results,
        .operands = o.operands, .attrs = o.attrs, .regions = make[ZRegion](1),
        .effects=o.effects,.reads=o.reads,.writes=o.writes,.origin=o.origin };
    let rg: i32 = 0;
    while (rg < len[ZRegion](o.regions)) {
        let reg: ZRegion = get[ZRegion](o.regions, rg);
        let nr: ZRegion = ZRegion{ .blocks = make[ZBlock](1) };
        let bb: i32 = 0;
        while (bb < len[ZBlock](reg.blocks)) { push[ZBlock](&nr.blocks, fold_block(get[ZBlock](reg.blocks, bb), cs, folded)); bb = bb + 1; }
        push[ZRegion](&no.regions, nr);
        rg = rg + 1;
    }
    return no;
}
fn fold_module(m: ZModule) ZModule {
    let out: ZModule = ZModule{ .funcs = make[ZFunc](4),
        .schema_version=m.schema_version,.transform_version=m.transform_version,
        .coverage_complete=m.coverage_complete,.coverage_errors=m.coverage_errors,
        .origin_complete=m.origin_complete,.origin_exact=m.origin_exact };
    let i: i32 = 0;
    while (i < len[ZFunc](m.funcs)) {
        let f: ZFunc = get[ZFunc](m.funcs, i);
        let cs: ArrayList[ConstBind] = make[ConstBind](8);
        let folded: i32 = 0;
        let nb: ZBlock = fold_block(f.body, &cs, &folded);
        push[ZFunc](&out.funcs, ZFunc{ .name = f.name, .params = f.params,
            .ret = f.ret, .body = nb,.effects=f.effects,.origin=f.origin,
            .coverage_complete=f.coverage_complete,
            .coverage_errors=f.coverage_errors });
        i = i + 1;
    }
    return out;
}

// ── printer: MLIR text ───────────────────────────────────────────────────────
fn pad(buf: *ArrayList[u8], n: i32) void { let i: i32 = 0; while (i < n) { emit_z(buf, "  "); i = i + 1; } }
fn emit_z(buf: *ArrayList[u8], s: []u8) void { let i: i32 = 0; while (i < s.len) { push[u8](buf, s[i]); i = i + 1; } }

fn print_mlir(m: ZModule) ArrayList[u8] {
    let buf: ArrayList[u8] = make[u8](256);
    emit_z(&buf, "// ZIR → MLIR (func/arith/memref/scf dialects)\n");
    emit_z(&buf, "// schema=");emit_z(&buf,m.schema_version);
    emit_z(&buf," transform=");emit_z(&buf,m.transform_version);
    emit_z(&buf," coverage_complete=");emit_z(&buf,_zag_i64_to_str(m.coverage_complete));
    emit_z(&buf," coverage_errors=");emit_z(&buf,_zag_i64_to_str(m.coverage_errors));
    emit_z(&buf," origin_complete=");emit_z(&buf,_zag_i64_to_str(m.origin_complete));
    emit_z(&buf," origin_exact=");emit_z(&buf,_zag_i64_to_str(m.origin_exact));emit_z(&buf,"\n");
    emit_z(&buf, "module {\n");
    let i: i32 = 0;
    while (i < len[ZFunc](m.funcs)) {
        let f: ZFunc = get[ZFunc](m.funcs, i);
        pad(&buf, 1); emit_z(&buf, "func.func @"); emit_z(&buf, f.name); emit_z(&buf, "(");
        let p: i32 = 0;
        while (p < len[ZVal](f.params)) {
            if (p > 0) { emit_z(&buf, ", "); }
            let pv: ZVal = get[ZVal](f.params, p);
            emit_z(&buf, pv.name); emit_z(&buf, ": "); emit_z(&buf, pv.ty);
            p = p + 1;
        }
        emit_z(&buf, ")");
        if (!@strEq(f.ret, "void")) { emit_z(&buf, " -> "); emit_z(&buf, f.ret); }
        emit_z(&buf," attributes {zag.effects = ");emit_z(&buf,_zag_i64_to_str(f.effects));
        emit_z(&buf,", zag.origin = \"");emit_z(&buf,f.origin.module);
        emit_z(&buf,"\", zag.line = ");emit_z(&buf,_zag_i64_to_str(f.origin.line));
        emit_z(&buf,", zag.coverage_complete = ");emit_z(&buf,_zag_i64_to_str(f.coverage_complete));emit_z(&buf,"}");
        emit_z(&buf, " {\n");
        print_block_mlir(&buf, f.body, 2);
        pad(&buf, 1); emit_z(&buf, "}\n");
        i = i + 1;
    }
    emit_z(&buf, "}\n");
    return buf;
}
fn print_block_mlir(buf: *ArrayList[u8], blk: ZBlock, ind: i32) void {
    let i: i32 = 0;
    while (i < len[ZOp](blk.ops)) {
        let o: ZOp = get[ZOp](blk.ops, i);
        print_op_mlir(buf, o, ind);
        i = i + 1;
    }
}
fn print_op_mlir(buf: *ArrayList[u8], o: ZOp, ind: i32) void {
    pad(buf, ind);
    if (@strEq(o.name, "arith.constant")) {
        let r: ZVal = get[ZVal](o.results, 0);
        emit_z(buf, r.name); emit_z(buf, " = arith.constant "); emit_z(buf, attr_val(o, "value")); emit_z(buf, " : "); emit_z(buf, r.ty); emit_z(buf, "\n");
    } else if (@strEq(o.name, "arith.cmpi") || @strEq(o.name, "arith.cmpf")) {
        let r: ZVal = get[ZVal](o.results, 0);
        emit_z(buf, r.name); emit_z(buf, " = "); emit_z(buf, o.name); emit_z(buf, " "); emit_z(buf, attr_val(o, "predicate")); emit_z(buf, ", ");
        emit_z(buf, get[ZVal](o.operands, 0).name); emit_z(buf, ", "); emit_z(buf, get[ZVal](o.operands, 1).name);
        emit_z(buf, " : "); emit_z(buf, get[ZVal](o.operands, 0).ty); emit_z(buf, "\n");
    } else if (@strEq(o.name, "memref.alloca")) {
        let r: ZVal = get[ZVal](o.results, 0);
        emit_z(buf, r.name); emit_z(buf, " = memref.alloca() : memref<"); emit_z(buf, attr_val(o, "elem")); emit_z(buf, ">\n");
    } else if (@strEq(o.name, "memref.load")) {
        let r: ZVal = get[ZVal](o.results, 0);
        emit_z(buf, r.name); emit_z(buf, " = memref.load "); emit_z(buf, get[ZVal](o.operands, 0).name); emit_z(buf, "[] : memref<"); emit_z(buf, attr_val(o, "elem")); emit_z(buf, ">\n");
    } else if (@strEq(o.name, "memref.store")) {
        emit_z(buf, "memref.store "); emit_z(buf, get[ZVal](o.operands, 0).name); emit_z(buf, ", "); emit_z(buf, get[ZVal](o.operands, 1).name); emit_z(buf, "[] : memref<"); emit_z(buf, attr_val(o, "elem")); emit_z(buf, ">\n");
    } else if (@strEq(o.name, "func.call")) {
        if (len[ZVal](o.results) == 1) { emit_z(buf, get[ZVal](o.results, 0).name); emit_z(buf, " = "); }
        emit_z(buf, "func.call @"); emit_z(buf, attr_val(o, "callee")); emit_z(buf, "(");
        print_operands(buf, o); emit_z(buf, ")\n");
    } else if (@strEq(o.name,"task.abi")) {
        emit_z(buf,"task.abi {abi=\"");emit_z(buf,attr_val(o,"abi"));
        emit_z(buf,"\", handle_type=\"");emit_z(buf,attr_val(o,"handle_type"));
        emit_z(buf,"\", result_type=\"");emit_z(buf,attr_val(o,"result_type"));
        emit_z(buf,"\", ownership=\"");emit_z(buf,attr_val(o,"ownership"));
        emit_z(buf,"\", cancellation=\"");emit_z(buf,attr_val(o,"cancellation"));
        emit_z(buf,"\", scheduler=\"");emit_z(buf,attr_val(o,"scheduler"));emit_z(buf,"\"}\n");
    } else if (@strEq(o.name,"task.spawn")) {
        let r:ZVal=get[ZVal](o.results,0);emit_z(buf,r.name);emit_z(buf," = task.spawn @");
        emit_z(buf,attr_val(o,"callee"));emit_z(buf,"(");print_operands(buf,o);emit_z(buf,") : ");emit_z(buf,r.ty);emit_z(buf,"\n");
    } else if (@strEq(o.name,"task.await")||@strEq(o.name,"task.cancel")||@strEq(o.name,"task.join")) {
        let r:ZVal=get[ZVal](o.results,0);emit_z(buf,r.name);emit_z(buf," = ");emit_z(buf,o.name);
        emit_z(buf," ");emit_z(buf,get[ZVal](o.operands,0).name);emit_z(buf," : ");emit_z(buf,r.ty);emit_z(buf,"\n");
    } else if (@strEq(o.name, "func.return")) {
        emit_z(buf, "func.return");
        if (len[ZVal](o.operands) == 1) { emit_z(buf, " "); emit_z(buf, get[ZVal](o.operands, 0).name); emit_z(buf, " : "); emit_z(buf, get[ZVal](o.operands, 0).ty); }
        emit_z(buf, "\n");
    } else if (@strEq(o.name, "scf.if")) {
        emit_z(buf, "scf.if "); emit_z(buf, get[ZVal](o.operands, 0).name); emit_z(buf, " {\n");
        print_region0(buf, o, 0, ind + 1);
        pad(buf, ind); emit_z(buf, "}");
        if (len[ZRegion](o.regions) == 2) { emit_z(buf, " else {\n"); print_region0(buf, o, 1, ind + 1); pad(buf, ind); emit_z(buf, "}"); }
        emit_z(buf, "\n");
    } else if (@strEq(o.name,"scf.while")) {
        emit_z(buf,"scf.while {\n");print_region0(buf,o,0,ind+1);
        pad(buf,ind);emit_z(buf,"} do {\n");print_region0(buf,o,1,ind+1);
        pad(buf,ind);emit_z(buf,"}\n");
    } else if (@strEq(o.name,"scf.condition")) {
        emit_z(buf,"scf.condition(");emit_z(buf,get[ZVal](o.operands,0).name);
        emit_z(buf,")\n");
    } else if (@strEq(o.name,"scf.yield")||@strEq(o.name,"scf.break")||
        @strEq(o.name,"scf.continue")) {
        emit_z(buf,o.name);emit_z(buf,"\n");
    } else {
        // generic arith.* binary
        let r: ZVal = get[ZVal](o.results, 0);
        emit_z(buf, r.name); emit_z(buf, " = "); emit_z(buf, o.name); emit_z(buf, " ");
        print_operands(buf, o); emit_z(buf, " : "); emit_z(buf, r.ty); emit_z(buf, "\n");
    }
}
fn print_operands(buf: *ArrayList[u8], o: ZOp) void {
    let i: i32 = 0;
    while (i < len[ZVal](o.operands)) { if (i > 0) { emit_z(buf, ", "); } emit_z(buf, get[ZVal](o.operands, i).name); i = i + 1; }
}
fn print_region0(buf: *ArrayList[u8], o: ZOp, ri: i32, ind: i32) void {
    let reg: ZRegion = get[ZRegion](o.regions, ri);
    let bb: i32 = 0;
    while (bb < len[ZBlock](reg.blocks)) { print_block_mlir(buf, get[ZBlock](reg.blocks, bb), ind); bb = bb + 1; }
}

// ── printer: C (the CPU backend, same IR) ────────────────────────────────────
fn c_type(t: []u8) []u8 {
    if (@strEq(t, "i32") || @strEq(t, "bool")) { return "int32_t"; }
    if (@strEq(t, "i64")) { return "int64_t"; }
    if (@strEq(t, "f32")) { return "float"; }
    if (@strEq(t, "f64")) { return "double"; }
    if (@strEq(t, "void")) { return "void"; }
    return "int32_t";
}
fn cvar(name: []u8) []u8 { if (name.len > 0 && name[0] == '%') { return name[1..]; } return name; }

fn print_c(m: ZModule) ArrayList[u8] {
    let buf: ArrayList[u8] = make[u8](256);
    emit_z(&buf, "#include <stdint.h>\n#include <stdio.h>\n");
    emit_z(&buf, "static void print_i32(int32_t x){ printf(\"%d\\n\", x); }\n");
    // forward declarations
    let i: i32 = 0;
    while (i < len[ZFunc](m.funcs)) { print_c_sig(&buf, get[ZFunc](m.funcs, i)); emit_z(&buf, ";\n"); i = i + 1; }
    i = 0;
    while (i < len[ZFunc](m.funcs)) {
        let f: ZFunc = get[ZFunc](m.funcs, i);
        print_c_sig(&buf, f); emit_z(&buf, " {\n");
        print_block_c(&buf, f.body, 1);
        emit_z(&buf, "}\n");
        i = i + 1;
    }
    return buf;
}
fn print_c_sig(buf: *ArrayList[u8], f: ZFunc) void {
    emit_z(buf, c_type(f.ret)); emit_z(buf, " "); emit_z(buf, f.name); emit_z(buf, "(");
    if (len[ZVal](f.params) == 0) { emit_z(buf, "void"); }
    let p: i32 = 0;
    while (p < len[ZVal](f.params)) {
        if (p > 0) { emit_z(buf, ", "); }
        let pv: ZVal = get[ZVal](f.params, p);
        emit_z(buf, c_type(pv.ty)); emit_z(buf, " "); emit_z(buf, cvar(pv.name));
        p = p + 1;
    }
    emit_z(buf, ")");
}
fn cpad(buf: *ArrayList[u8], n: i32) void { let i: i32 = 0; while (i < n) { emit_z(buf, "    "); i = i + 1; } }
fn print_block_c(buf: *ArrayList[u8], blk: ZBlock, ind: i32) void {
    let i: i32 = 0;
    while (i < len[ZOp](blk.ops)) { print_op_c(buf, get[ZOp](blk.ops, i), ind); i = i + 1; }
}
fn print_op_c(buf: *ArrayList[u8], o: ZOp, ind: i32) void {
    cpad(buf, ind);
    if (@strEq(o.name, "arith.constant")) {
        let r: ZVal = get[ZVal](o.results, 0);
        emit_z(buf, c_type(r.ty)); emit_z(buf, " "); emit_z(buf, cvar(r.name)); emit_z(buf, " = "); emit_z(buf, attr_val(o, "value")); emit_z(buf, ";\n");
    } else if (@strEq(o.name, "memref.alloca")) {
        let r: ZVal = get[ZVal](o.results, 0);
        emit_z(buf, c_type(attr_val(o, "elem"))); emit_z(buf, " "); emit_z(buf, cvar(r.name)); emit_z(buf, ";\n");
    } else if (@strEq(o.name, "memref.load")) {
        let r: ZVal = get[ZVal](o.results, 0);
        emit_z(buf, c_type(r.ty)); emit_z(buf, " "); emit_z(buf, cvar(r.name)); emit_z(buf, " = "); emit_z(buf, cvar(get[ZVal](o.operands, 0).name)); emit_z(buf, ";\n");
    } else if (@strEq(o.name, "memref.store")) {
        emit_z(buf, cvar(get[ZVal](o.operands, 1).name)); emit_z(buf, " = "); emit_z(buf, cvar(get[ZVal](o.operands, 0).name)); emit_z(buf, ";\n");
    } else if (@strEq(o.name, "func.call")) {
        if (len[ZVal](o.results) == 1) { let r: ZVal = get[ZVal](o.results, 0); emit_z(buf, c_type(r.ty)); emit_z(buf, " "); emit_z(buf, cvar(r.name)); emit_z(buf, " = "); }
        emit_z(buf, attr_val(o, "callee")); emit_z(buf, "(");
        print_operands_c(buf, o); emit_z(buf, ");\n");
    } else if (@strEq(o.name,"task.abi")) {
        emit_z(buf,"/* task.abi ");emit_z(buf,attr_val(o,"abi"));emit_z(buf," ");
        emit_z(buf,attr_val(o,"handle_type"));emit_z(buf," */\n");
    } else if (@strEq(o.name,"task.spawn")) {
        let r:ZVal=get[ZVal](o.results,0);emit_z(buf,"/* task.spawn @");emit_z(buf,attr_val(o,"callee"));
        emit_z(buf," */ ");emit_z(buf,c_type(r.ty));emit_z(buf," ");emit_z(buf,cvar(r.name));emit_z(buf," = 0;\n");
    } else if (@strEq(o.name,"task.await")||@strEq(o.name,"task.cancel")||@strEq(o.name,"task.join")) {
        let r:ZVal=get[ZVal](o.results,0);emit_z(buf,"/* ");emit_z(buf,o.name);emit_z(buf," */ ");
        emit_z(buf,c_type(r.ty));emit_z(buf," ");emit_z(buf,cvar(r.name));emit_z(buf," = 0;\n");
    } else if (@strEq(o.name, "func.return")) {
        emit_z(buf, "return");
        if (len[ZVal](o.operands) == 1) { emit_z(buf, " "); emit_z(buf, cvar(get[ZVal](o.operands, 0).name)); }
        emit_z(buf, ";\n");
    } else if (@strEq(o.name, "scf.if")) {
        emit_z(buf, "if ("); emit_z(buf, cvar(get[ZVal](o.operands, 0).name)); emit_z(buf, ") {\n");
        print_region0_c(buf, o, 0, ind + 1);
        cpad(buf, ind); emit_z(buf, "}");
        if (len[ZRegion](o.regions) == 2) { emit_z(buf, " else {\n"); print_region0_c(buf, o, 1, ind + 1); cpad(buf, ind); emit_z(buf, "}"); }
        emit_z(buf, "\n");
    } else if (@strEq(o.name,"scf.while")) {
        emit_z(buf,"for (;;) {\n");print_region0_c(buf,o,0,ind+1);
        print_region0_c(buf,o,1,ind+1);cpad(buf,ind);emit_z(buf,"}\n");
    } else if (@strEq(o.name,"scf.condition")) {
        emit_z(buf,"if (!(");emit_z(buf,cvar(get[ZVal](o.operands,0).name));
        emit_z(buf,")) break;\n");
    } else if (@strEq(o.name,"scf.yield")) {
        emit_z(buf,"/* scf.yield */\n");
    } else if (@strEq(o.name,"scf.break")) {
        emit_z(buf,"break;\n");
    } else if (@strEq(o.name,"scf.continue")) {
        emit_z(buf,"continue;\n");
    } else {
        // binary arith / cmp → C operator
        let r: ZVal = get[ZVal](o.results, 0);
        emit_z(buf, c_type(r.ty)); emit_z(buf, " "); emit_z(buf, cvar(r.name)); emit_z(buf, " = ");
        emit_z(buf, cvar(get[ZVal](o.operands, 0).name)); emit_z(buf, " "); emit_z(buf, c_binop(o)); emit_z(buf, " "); emit_z(buf, cvar(get[ZVal](o.operands, 1).name)); emit_z(buf, ";\n");
    }
}
fn c_binop(o: ZOp) []u8 {
    if (@strEq(o.name, "arith.addi") || @strEq(o.name, "arith.addf")) { return "+"; }
    if (@strEq(o.name, "arith.subi") || @strEq(o.name, "arith.subf")) { return "-"; }
    if (@strEq(o.name, "arith.muli") || @strEq(o.name, "arith.mulf")) { return "*"; }
    if (@strEq(o.name, "arith.divsi") || @strEq(o.name, "arith.divf")) { return "/"; }
    if (@strEq(o.name, "arith.remsi")) { return "%"; }
    if (@strEq(o.name, "arith.xori")) { return "^"; }
    if (@strEq(o.name, "arith.andsi")) { return "&"; }
    if (@strEq(o.name, "arith.orsi")) { return "|"; }
    if (@strEq(o.name, "arith.shli")) { return "<<"; }
    if (@strEq(o.name, "arith.shrsi")) { return ">>"; }
    if (@strEq(o.name, "arith.cmpi") || @strEq(o.name, "arith.cmpf")) { return c_pred(attr_val(o, "predicate")); }
    return "+";
}
fn c_pred(p: []u8) []u8 {
    if (@strEq(p, "eq")) { return "=="; }
    if (@strEq(p, "ne")) { return "!="; }
    if (@strEq(p, "slt")) { return "<"; }
    if (@strEq(p, "sgt")) { return ">"; }
    if (@strEq(p, "sle")) { return "<="; }
    if (@strEq(p, "sge")) { return ">="; }
    return "==";
}
fn print_operands_c(buf: *ArrayList[u8], o: ZOp) void {
    let i: i32 = 0;
    while (i < len[ZVal](o.operands)) { if (i > 0) { emit_z(buf, ", "); } emit_z(buf, cvar(get[ZVal](o.operands, i).name)); i = i + 1; }
}
fn print_region0_c(buf: *ArrayList[u8], o: ZOp, ri: i32, ind: i32) void {
    let reg: ZRegion = get[ZRegion](o.regions, ri);
    let bb: i32 = 0;
    while (bb < len[ZBlock](reg.blocks)) { print_block_c(buf, get[ZBlock](reg.blocks, bb), ind); bb = bb + 1; }
}

// ── top-level entry points (used by the driver) ──────────────────────────────
fn zir_nonextern_function_count(decls:ArrayList[*Node])i32{
    let count:i32=0;let i:i32=0;while(i<decls.len){switch(decls.data[i].*){
        .fn_decl=>|f|{if(f.is_extern==0){count=count+1;}}else=>{}}i=i+1;}return count;
}

// Build and verify the versioned IR contract consumed by today's production
// driver. Raw ZIR remains the correctness fallback and this entry point must
// not infer target/edition/safety policy or invoke a transform producer.
fn zir_prepare_production_with_origins(decls:ArrayList[*Node],eff:map.StringMap[i32],origins:ArrayList[NodeOrigin])ZirAuthority{
    let raw:ZModule=build_module(decls,eff,origins);
    return zir_select_foreground_transform(raw,decls,zir_no_transform_proposal(raw));
}

// Production-capable seam for the one bounded rule. The caller must construct
// `policy` from resolved compiler state; until the public driver does that it
// continues to call the raw-only entry point above. The source-policy checker,
// not the producer, decides whether the candidate may replace raw ZIR.
fn zir_prepare_const_i32_add_source_policy_with_origins(decls:ArrayList[*Node],
    eff:map.StringMap[i32],origins:ArrayList[NodeOrigin],
    policy:ZirTransformPolicy)ZirAuthority{
    let raw:ZModule=build_module(decls,eff,origins);
    let proposal:ZirTransformProposal=zir_propose_const_i32_add(raw);
    return zir_select_foreground_transform_source_policy(raw,decls,origins,policy,proposal);
}
fn zir_prepare_const_i32_neg_source_policy_with_origins(decls:ArrayList[*Node],
    eff:map.StringMap[i32],origins:ArrayList[NodeOrigin],policy:ZirTransformPolicy)ZirAuthority{
    let raw:ZModule=build_module(decls,eff,origins);
    let proposal:ZirTransformProposal=zir_propose_const_i32_neg(raw);
    return zir_select_foreground_transform_source_policy(raw,decls,origins,policy,proposal);
}
fn zir_prepare_const_i64_add_source_policy_with_origins(decls:ArrayList[*Node],
    eff:map.StringMap[i32],origins:ArrayList[NodeOrigin],policy:ZirTransformPolicy)ZirAuthority{
    let raw:ZModule=build_module(decls,eff,origins);
    let proposal:ZirTransformProposal=zir_propose_const_i64_add(raw);
    return zir_select_foreground_transform_source_policy(raw,decls,origins,policy,proposal);
}
fn zir_prepare_const_bool_cmp_source_policy_with_origins(decls:ArrayList[*Node],
    eff:map.StringMap[i32],origins:ArrayList[NodeOrigin],policy:ZirTransformPolicy)ZirAuthority{
    let raw:ZModule=build_module(decls,eff,origins);
    let proposal:ZirTransformProposal=zir_propose_const_bool_cmp(raw);
    return zir_select_foreground_transform_source_policy(raw,decls,origins,policy,proposal);
}

fn zir_prepare_production(decls:ArrayList[*Node],eff:map.StringMap[i32])ZirAuthority{
    return zir_prepare_production_with_origins(decls,eff,make[NodeOrigin](1));
}

// Build and verify production ZIR; emit MLIR text.
fn zir_to_mlir(src: []u8, dir: []u8) ArrayList[u8] {
    let unit:CompilationUnit=parse_compilation_unit_dir(src,dir);let decls:ArrayList[*Node]=unit.decls;
    let eff:map.StringMap[i32]=analyze(decls);
    let authority:ZirAuthority=zir_prepare_production_with_origins(decls,eff,unit.origins);
    return print_mlir(authority.module);
}
// Build and verify production ZIR; emit C.
fn zir_to_c(src: []u8, dir: []u8) ArrayList[u8] {
    let unit:CompilationUnit=parse_compilation_unit_dir(src,dir);let decls:ArrayList[*Node]=unit.decls;
    let eff:map.StringMap[i32]=analyze(decls);
    let authority:ZirAuthority=zir_prepare_production_with_origins(decls,eff,unit.origins);
    return print_c(authority.module);
}
// Diagnostics line: function count plus verification/coverage/origin status.
fn zir_stats(src: []u8, dir: []u8) ArrayList[u8] {
    let unit:CompilationUnit=parse_compilation_unit_dir(src,dir);let decls:ArrayList[*Node]=unit.decls;
    let eff:map.StringMap[i32]=analyze(decls);
    let authority:ZirAuthority=zir_prepare_production_with_origins(decls,eff,unit.origins);
    let m:ZModule=authority.module;let errs:i32=authority.verify_errors;
    let buf: ArrayList[u8] = make[u8](64);
    emit_z(&buf, "zir: ");
    emit_z(&buf, _zag_i64_to_str(len[ZFunc](m.funcs) as i64));
    emit_z(&buf, " funcs, verify-errors=");
    emit_z(&buf, _zag_i64_to_str(errs as i64));
    emit_z(&buf, ", coverage-complete=");
    emit_z(&buf, _zag_i64_to_str(authority.coverage_complete));
    emit_z(&buf, ", coverage-errors=");
    emit_z(&buf, _zag_i64_to_str(authority.coverage_errors));
    emit_z(&buf, ", origin-complete=");
    emit_z(&buf, _zag_i64_to_str(authority.origin_complete));
    emit_z(&buf, ", origin-exact=");
    emit_z(&buf, _zag_i64_to_str(authority.origin_exact));
    emit_z(&buf, "\n");
    return buf;
}
