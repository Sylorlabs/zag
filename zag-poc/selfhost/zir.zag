                            .after=zir_semantic_identity(candidate),.function_index=fi,.op_index=oi,.lhs_def_index=lhs.index,
                            .rhs_def_index=rhs.index,.transform_count=1,.function_name=zir_clone_text(f.name),
                            .lhs_ssa=zir_clone_text(add.operands.data[0].name),.rhs_ssa=zir_clone_text(add.operands.data[1].name),
                            .result_ssa=zir_clone_text(add.results.data[0].name),.result_type=zir_clone_text(add.results.data[0].ty),
                            .source_context=zir_clone_text(zir_transform_source_context_const_i64_add()),
