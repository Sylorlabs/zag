// The producer scans in stable function/op order and emits at most one proposal.
fn zir_propose_const_i32_add(raw:ZModule)ZirTransformProposal{
    let script_envelope:i32=zir_script_generated_envelope(raw);
    if(verify_module(raw)!=0||zir_module_ssa_unique_all(raw)==0||!@strEq(raw.schema_version,"zag-ir-v1")||
       !@strEq(raw.transform_version,"zag-transform-v1")||
       (((raw.coverage_complete!=1||raw.coverage_errors!=0||raw.origin_complete!=1||
          raw.origin_exact!=1) as i32)==1&&script_envelope==0)){
        return zir_no_transform_proposal(raw);}
    let fi:i32=0;while(fi<raw.funcs.len){let f:ZFunc=raw.funcs.data[fi];
        if(f.effects==0&&f.coverage_complete==1&&f.coverage_errors==0&&
           zir_origin_rule_usable(f.origin)==1){let oi:i32=0;while(oi<f.body.ops.len){
            let add:ZOp=f.body.ops.data[oi];
            if(@strEq(add.name,"arith.addi")&&add.results.len==1&&add.operands.len==2&&
               add.attrs.len==0&&add.regions.len==0&&add.effects==0&&
               @strEq(add.reads,"none")&&@strEq(add.writes,"none")&&
               @strEq(add.results.data[0].ty,"i32")&&@strEq(add.operands.data[0].ty,"i32")&&
               @strEq(add.operands.data[1].ty,"i32")&&zir_origin_rule_usable(add.origin)==1&&
               zir_origin_rule_usable(add.results.data[0].origin)==1){
                let lhs:ZirConstMatch=ztp_prior_constant(f.body,oi,add.operands.data[0]);
                let rhs:ZirConstMatch=ztp_prior_constant(f.body,oi,add.operands.data[1]);
                if(lhs.valid==1&&rhs.valid==1&&lhs.index!=rhs.index&&
                   !@strEq(add.operands.data[0].name,add.operands.data[1].name)&&
                   !@strEq(add.results.data[0].name,add.operands.data[0].name)&&
                   !@strEq(add.results.data[0].name,add.operands.data[1].name)&&
                   zir_count_ssa_function(f,add.operands.data[0].name)==1&&
                   zir_count_ssa_function(f,add.operands.data[1].name)==1&&
                   zir_count_ssa_function(f,add.results.data[0].name)==1){
                    let candidate:ZModule=zir_clone_module(raw);
                    let old:ZOp=candidate.funcs.data[fi].body.ops.data[oi];
                    let result:i64=ztp_wrap_i32_add(lhs.value,rhs.value);
                    let replacement:ZOp=ZOp{.name=zir_clone_text("arith.constant"),
                        .results=old.results,.operands=make[ZVal](0),.attrs=make[ZAttr](1),
                        .regions=make[ZRegion](0),.effects=old.effects,
                        .reads=old.reads,.writes=old.writes,.origin=old.origin};
                    push[ZAttr](&replacement.attrs,ZAttr{.key=zir_clone_text("value"),
                        .val=_zag_i64_to_str(result)});
                    candidate.funcs.data[fi].body.ops.data[oi]=replacement;
                    let cert:ZirTransformCertificate=ZirTransformCertificate{
                        .format=zir_clone_text(zir_transform_cert_format()),
                        .identity_schema=zir_clone_text(zir_transform_identity_schema()),
                        .rule=zir_clone_text(zir_transform_rule_const_i32_add()),
                        .checker=zir_clone_text(zir_transform_checker_const_i32_add()),
                        .ir_verifier=zir_clone_text(zir_ir_verifier_name()),
                        .before=zir_semantic_identity(raw),.after=zir_semantic_identity(candidate),
                        .function_index=fi,.op_index=oi,.lhs_def_index=lhs.index,
                        .rhs_def_index=rhs.index,.transform_count=1,
                        .function_name=zir_clone_text(f.name),
                        .lhs_ssa=zir_clone_text(add.operands.data[0].name),
                        .rhs_ssa=zir_clone_text(add.operands.data[1].name),
                        .result_ssa=zir_clone_text(add.results.data[0].name),
                        .result_type=zir_clone_text(add.results.data[0].ty),
                        .source_context=zir_clone_text(zir_transform_source_context_const_i32_add()),
                        .policy_target=zir_clone_text(zir_transform_target_linux_x86_64()),
                        .policy_edition=zir_clone_text(zir_transform_edition_regular()),
                        .arithmetic_policy=zir_clone_text(zir_transform_arithmetic_i32_wrap()),
                        .safety_checked=0,.sanitize_memory=0,.automatic_selection=1,
                        .function_origin=zir_clone_origin(f.origin),
                        .op_origin=zir_clone_origin(add.origin),
                        .lhs_def_origin=zir_clone_origin(f.body.ops.data[lhs.index].origin),
                        .rhs_def_origin=zir_clone_origin(f.body.ops.data[rhs.index].origin),
                        .lhs_origin=zir_clone_origin(add.operands.data[0].origin),
                        .rhs_origin=zir_clone_origin(add.operands.data[1].origin),
                        .result_origin=zir_clone_origin(add.results.data[0].origin),
                        .lhs_value=lhs.value,.rhs_value=rhs.value,.result_value=result,.valid=1};
                    return ZirTransformProposal{.candidate=candidate,.certificate=cert,.proposed=1};
                }
            }
            oi=oi+1;}
        }
        fi=fi+1;
    }
    return zir_no_transform_proposal(raw);
}

// A source-bound unary-negation rule.  The current AST->ZIR lowering spells
// unary `-literal` as `0 - literal`; this producer recognizes only that exact
// typed i32 shape, with a zero left constant and one positive right constant.
// Source policy below is still required, so an ordinary subtraction cannot
// acquire negation authority merely by matching the low-level shape.
fn zir_propose_const_i32_neg(raw:ZModule)ZirTransformProposal{
    if(verify_module(raw)!=0||zir_module_ssa_unique_all(raw)==0||!@strEq(raw.schema_version,"zag-ir-v1")||
       !@strEq(raw.transform_version,"zag-transform-v1")||raw.coverage_complete!=1||
       raw.coverage_errors!=0||raw.origin_complete!=1||raw.origin_exact!=1){
        return zir_no_transform_proposal(raw);}
    let fi:i32=0;while(fi<raw.funcs.len){let f:ZFunc=raw.funcs.data[fi];
        if(f.effects==0&&f.coverage_complete==1&&f.coverage_errors==0&&
           zir_origin_rule_usable(f.origin)==1){let oi:i32=0;while(oi<f.body.ops.len){
            let sub:ZOp=f.body.ops.data[oi];
            if(@strEq(sub.name,"arith.subi")&&sub.results.len==1&&sub.operands.len==2&&
               sub.attrs.len==0&&sub.regions.len==0&&sub.effects==0&&
               @strEq(sub.reads,"none")&&@strEq(sub.writes,"none")&&
               @strEq(sub.results.data[0].ty,"i32")&&@strEq(sub.operands.data[0].ty,"i32")&&
               @strEq(sub.operands.data[1].ty,"i32")&&zir_origin_rule_usable(sub.origin)==1&&
               zir_origin_rule_usable(sub.results.data[0].origin)==1){
                let lhs:ZirConstMatch=ztp_prior_constant(f.body,oi,sub.operands.data[0]);
                let rhs:ZirConstMatch=ztp_prior_constant(f.body,oi,sub.operands.data[1]);
                if(lhs.valid==1&&rhs.valid==1&&lhs.value==0&&rhs.value>=0&&
                   rhs.value<=2147483647&&lhs.index!=rhs.index&&
                   !@strEq(sub.operands.data[0].name,sub.operands.data[1].name)&&
                   !@strEq(sub.results.data[0].name,sub.operands.data[0].name)&&
                   !@strEq(sub.results.data[0].name,sub.operands.data[1].name)&&
                   zir_count_ssa_function(f,sub.operands.data[0].name)==1&&
                   zir_count_ssa_function(f,sub.operands.data[1].name)==1&&
                   zir_count_ssa_function(f,sub.results.data[0].name)==1){
                    let candidate:ZModule=zir_clone_module(raw);
                    let old:ZOp=candidate.funcs.data[fi].body.ops.data[oi];
                    let result:i64=0-rhs.value;
                    let replacement:ZOp=ZOp{.name=zir_clone_text("arith.constant"),
                        .results=old.results,.operands=make[ZVal](0),.attrs=make[ZAttr](1),
                        .regions=make[ZRegion](0),.effects=old.effects,.reads=old.reads,
                        .writes=old.writes,.origin=old.origin};
                    push[ZAttr](&replacement.attrs,ZAttr{.key=zir_clone_text("value"),
                        .val=_zag_i64_to_str(result)});
                    candidate.funcs.data[fi].body.ops.data[oi]=replacement;
                    let cert:ZirTransformCertificate=ZirTransformCertificate{
                        .format=zir_clone_text(zir_transform_cert_format()),
                        .identity_schema=zir_clone_text(zir_transform_identity_schema()),
                        .rule=zir_clone_text(zir_transform_rule_const_i32_neg()),
                        .checker=zir_clone_text(zir_transform_checker_const_i32_neg()),
                        .ir_verifier=zir_clone_text(zir_ir_verifier_name()),
                        .before=zir_semantic_identity(raw),.after=zir_semantic_identity(candidate),
                        .function_index=fi,.op_index=oi,.lhs_def_index=lhs.index,
                        .rhs_def_index=rhs.index,.transform_count=1,.function_name=zir_clone_text(f.name),
                        .lhs_ssa=zir_clone_text(sub.operands.data[0].name),
                        .rhs_ssa=zir_clone_text(sub.operands.data[1].name),
                        .result_ssa=zir_clone_text(sub.results.data[0].name),
                        .result_type=zir_clone_text(sub.results.data[0].ty),
                        .source_context=zir_clone_text(zir_transform_source_context_const_i32_neg()),
                        .policy_target=zir_clone_text(zir_transform_target_linux_x86_64()),
                        .policy_edition=zir_clone_text(zir_transform_edition_regular()),
                        .arithmetic_policy=zir_clone_text(zir_transform_arithmetic_i32_wrap()),
                        .safety_checked=0,.sanitize_memory=0,.automatic_selection=1,
                        .function_origin=zir_clone_origin(f.origin),.op_origin=zir_clone_origin(sub.origin),
                        .lhs_def_origin=zir_clone_origin(f.body.ops.data[lhs.index].origin),
                        .rhs_def_origin=zir_clone_origin(f.body.ops.data[rhs.index].origin),
                        .lhs_origin=zir_clone_origin(sub.operands.data[0].origin),
                        .rhs_origin=zir_clone_origin(sub.operands.data[1].origin),
                        .result_origin=zir_clone_origin(sub.results.data[0].origin),
                        .lhs_value=lhs.value,.rhs_value=rhs.value,.result_value=result,.valid=1};
                    return ZirTransformProposal{.candidate=candidate,.certificate=cert,.proposed=1};
                }
            }
            oi=oi+1;}
        }
        fi=fi+1;
    }
    return zir_no_transform_proposal(raw);
}

// Test-only companion rule for an explicitly typed, non-overflowing i64 add.
// It is deliberately narrower than the backend's ordinary i64 support: the
// source-policy checker must bind an explicit i64 context before this rule can
// be selected.  Production preparation remains raw/no-transform.
fn ztp_parse_i64_defined(text:[]u8)ZirI32Literal{
    let bad:ZirI32Literal=ZirI32Literal{.value=0,.valid=0};if(text.len==0){return bad;}
    let negative:i32=(text[0]=='-') as i32;let at:i32=negative;
    if(at>=text.len||text[at]=='+'){return bad;}
    if(text[at]=='0'&&(at+1<text.len||negative==1)){return bad;}
    // Keep the proof arithmetic below inside signed i64 without relying on
    // a wrapping intermediate.  The rule is "defined/no-overflow", not an
    // i64 two's-complement transform.
    let limit:i64=4611686018427387903;let magnitude:i64=0;
    while(at<text.len){let ch:u8=text[at];if(ch<'0'||ch>'9'){return bad;}
        let digit:i64=(ch as i64)-48;if(magnitude>(limit-digit)/10){return bad;}
        magnitude=magnitude*10+digit;at=at+1;}
    if(negative==1){return ZirI32Literal{.value=0-magnitude,.valid=1};}
    return ZirI32Literal{.value=magnitude,.valid=1};
}
fn ztp_const_shape_i64(op:ZOp,want:ZVal)ZirI32Literal{
    let bad:ZirI32Literal=ZirI32Literal{.value=0,.valid=0};
    if(!@strEq(op.name,"arith.constant")||op.results.len!=1||op.operands.len!=0||
       op.attrs.len!=1||op.regions.len!=0||op.effects!=0||!@strEq(op.reads,"none")||
       !@strEq(op.writes,"none")||!@strEq(op.attrs.data[0].key,"value")||
       !@strEq(op.results.data[0].ty,"i64")||zir_value_equal(op.results.data[0],want)==0||
       zir_origin_rule_usable(op.origin)==0||zir_origin_rule_usable(op.results.data[0].origin)==0){return bad;}
    return ztp_parse_i64_defined(op.attrs.data[0].val);
}
fn ztp_prior_constant_i64(blk:ZBlock,before:i32,want:ZVal)ZirConstMatch{
    let found:i32=0;let index:i32=0-1;let value:i64=0;let i:i32=0;
    while(i<before){let op:ZOp=blk.ops.data[i];let r:i32=0;
        while(r<op.results.len){if(@strEq(op.results.data[r].name,want.name)){
            found=found+1;if(r!=0){return ZirConstMatch{.index=0-1,.value=0,.valid=0};}
            let parsed:ZirI32Literal=ztp_const_shape_i64(op,want);
            if(parsed.valid==0){return ZirConstMatch{.index=0-1,.value=0,.valid=0};}
            index=i;value=parsed.value;}r=r+1;}i=i+1;}
    return ZirConstMatch{.index=index,.value=value,.valid=(found==1) as i32};
}
fn zir_propose_const_i64_add(raw:ZModule)ZirTransformProposal{
