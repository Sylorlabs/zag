                            .arithmetic_policy=zir_clone_text(zir_transform_arithmetic_i64_defined()),.safety_checked=0,.sanitize_memory=0,.automatic_selection=1,
                            .function_origin=zir_clone_origin(f.origin),.op_origin=zir_clone_origin(add.origin),
