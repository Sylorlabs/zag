               zir_origin_rule_usable(f.origin)==0||f.body.ops.len==0){return 0;}
        }
        i=i+1;
    }
    return (uncaught==1&&body==1&&main==1&&user>0&&
        m.coverage_errors==wrapper_errors) as i32;
