// selfhost/zir.zag — ZIR: Zag's native, lightweight, MLIR-shaped IR.
//
// This is the "MLIR design, none of the LLVM weight" path. ZIR adopts MLIR's
// shape — everything is an Operation with SSA results/operands, named
// attributes, and nested Regions/Blocks — as Zag's own in-memory middle-end.
// There is NO dependency on libMLIR/LLVM: ~one file of Zag.
//
//   AST  ──build──▶  raw ZIR  ──verify──▶  print/lower
//                                             ├─ MLIR text (interop)
//                                             └─ native/C backends
//
// Production verifies and selects raw structured IR. Deliberately narrow rules
// have separately coded producer/checker contracts; regular transforms remain
// explicit foreground opt-ins, while the bounded Script add rule additionally
// requires a current measured winner and the same source/policy binding.
// The older general constant folder remains experimental and excluded. MLIR
// text is one *output* of ZIR, not a dependency.
//
// Current representational coverage includes scalar arithmetic, comparisons, mutable
// locals, calls, returns, structured if/while/switch/defer regions, strings,
// embeds, casts, struct values, fields, indexes, and slices. Unknown types,
// unbound contextual types, captures, mutation targets, and backend-only
// operations remain fail-closed.

@import("parse.zag")   // AST (Node/...) + ArrayList + string helpers
@import("sema.zag")    // authoritative effect fixpoint used by ZIR contracts
@import("../std/map.zag") as map
@import("zir_contract.zag") // shared IR schema, identity, and certificate types

// ── builder ──────────────────────────────────────────────────────────────────
struct ZB { ctr: i32, origin: ZOrigin, effects: i32, coverage_errors: i32,
    current_ret:[]u8, expected_type:[]u8, current_module:[]u8,
    origins:ArrayList[NodeOrigin] }

fn zir_function_origin(f:FnDecl) ZOrigin {
    return ZOrigin{ .module=f.origin, .line=f.line, .byte_start=0,
        .byte_end=0, .stable_id=0, .complete=0,.exact=0 };
}

fn zir_node_origin(origins:ArrayList[NodeOrigin],n:*Node)ZOrigin{
    let o:NodeOrigin=node_origin_find(origins,n);if(o.stable_id==0){return zir_unknown_origin();}
    return ZOrigin{.module=o.module,.line=o.line,.byte_start=o.byte_start,
        .byte_end=o.byte_end,.stable_id=o.stable_id,.complete=1,.exact=o.exact};
}

fn zir_value(name:[]u8,ty:[]u8,ownership:[]u8,alias_region:[]u8,
    lifetime:[]u8,layout:[]u8,origin:ZOrigin) ZVal {
    return ZVal{ .name=name, .ty=ty, .ownership=ownership,
        .alias_region=alias_region, .lifetime=lifetime, .layout=layout,
        .origin=origin };
}

fn zfresh(b: *ZB, ty: []u8) ZVal {
    b.*.ctr = b.*.ctr + 1;
    return zir_value(_zag_str_concat("%v", _zag_i64_to_str(b.*.ctr as i64)),
        ty,"ssa","none","function","target-default",b.*.origin);
}

fn mk_op(name: []u8) ZOp {
    return ZOp{ .name = name, .results = make[ZVal](1), .operands = make[ZVal](2),
                .attrs = make[ZAttr](1), .regions = make[ZRegion](1),
                .effects=0, .reads="none", .writes="none",
                .origin=zir_unknown_origin() };
}
fn mk_op_at(b:*ZB,name:[]u8) ZOp {
    let o:ZOp=mk_op(name);o.origin=b.*.origin;o.effects=b.*.effects;return o;
}
fn one_block() ZBlock { return ZBlock{ .ops = make[ZOp](8) }; }
fn region_of(blk: ZBlock) ZRegion { let r: ZRegion = ZRegion{ .blocks = make[ZBlock](1) }; push[ZBlock](&r.blocks, blk); return r; }

fn zir_task_attr(o:*ZOp,key:[]u8,val:[]u8)void{
    push[ZAttr](&o.*.attrs,ZAttr{.key=key,.val=val});
}

fn zir_task_handle_compatible(ty:[]u8)i32{
    // `*opaque` remains the source spelling (including a null sentinel),
    // while `task_i64` is the typed SSA spelling carried by task operations.
    return (@strEq(ty,zir_task_handle_type())||@strEq(ty,"*opaque")) as i32;
}

fn zir_task_abi_metadata(b:*ZB,blk:*ZBlock,f:FnDecl,origin:ZOrigin)void{
    b.*.origin=origin;let o:ZOp=mk_op_at(b,"task.abi");o.effects=0;o.reads="none";o.writes="none";
    zir_task_attr(&o,"abi",zir_task_abi_version());
    zir_task_attr(&o,"handle_type",zir_task_handle_type());
    zir_task_attr(&o,"result_type",f.ret);
    zir_task_attr(&o,"ownership",zir_task_ownership_mode());
    zir_task_attr(&o,"cancellation",zir_task_cancellation_mode());
    zir_task_attr(&o,"scheduler",zir_task_scheduler_mode());
    push[ZOp](&blk.*.ops,o);
}

// ── locals environment (name → value or alloca slot) ─────────────────────────
// `fn_target` is populated only for an immutable, explicitly typed local that
// names a parser-hoisted captureless closure or an exact source-local named
// function. Unresolved, captured, imported, extern, generic, and reassigned
// values remain on the checked AST bridge.
struct ZBind { name: []u8, val: ZVal, is_alloca: i32, initialized: i32, fn_target: []u8 }

fn env_find(env: ArrayList[ZBind], name: []u8) ZBind {
    let i: i32 = len[ZBind](env) - 1;
    while (i >= 0) {
        let b: ZBind = get[ZBind](env, i);
        // Mutable-local stack slots are reserved at function entry but are not
        // source-visible until their declaration initializer has completed.
        if (b.initialized == 1 && @strEq(b.name, name)) { return b; }
        i = i - 1;
    }
    return ZBind{ .name = "", .val = zir_value("%undef","i32","unknown",
        "unknown","unknown","unknown",zir_unknown_origin()), .is_alloca = 0,
        .initialized = 0, .fn_target = "" };
}

fn env_pending_index(env: ArrayList[ZBind], name: []u8, scope_start: i32) i32 {
    // Preallocation follows declaration order, so the first still-pending
    // matching entry is the exact declaration currently being lowered.
    let i:i32=scope_start;while(i<env.len){let b:ZBind=env.data[i];
        if(b.initialized==0&&b.is_alloca==1&&@strEq(b.name,name)){return i;}
        i=i+1;
    }
    return 0-1;
}

// ZBind is deliberately a compact append-only lexical environment.  Region
// lowering must still be lexical: bindings introduced by one structured child
// cannot be visible in a sibling or after the child, and an outer shadowed
// binding must become visible again.  Marks are indices rather than copied
// environments so this remains bounded and preserves the existing mutable
// preallocation model.
fn env_scope_mark(env: *ArrayList[ZBind]) i32 { return env.*.len; }
fn env_scope_end(env: *ArrayList[ZBind], mark: i32) void { env.*.len = mark; }

// Mutable locals need an alloca before their initializer is lowered.  Keep
// that preallocation scoped to the body that owns the declaration; otherwise
// a nested mutable declaration would be mistaken for a live sibling binding.
// `assigned_in` is intentionally conservative and already accounts for
// assignments in nested structured bodies.
fn prealloc_scope(b: *ZB, blk: *ZBlock, body: ArrayList[*Node],
    env: *ArrayList[ZBind]) void {
    let i: i32 = 0;
    while (i < body.len) {
        switch (body.data[i].*) {
            .let_ => |l| {
                if (assigned_in(body, l.name) == 1) {
                    b.*.origin = zir_node_origin(b.*.origins, body.data[i]);
                    let ty: []u8 = "i32";
                    if (l.has_dty == 1) { ty = l.dty; }
                    let slot: ZVal = op_alloca(b, blk, ty);
                    push[ZBind](env, ZBind{ .name = l.name, .val = slot,
                        .is_alloca = 1, .initialized = 0, .fn_target = "" });
                }
            }
            else => { }
        }
        i = i + 1;
    }
}

// ── op constructors (emit into a block's op list, return the result value) ───
fn op_const(b: *ZB, blk: *ZBlock, text: []u8, ty: []u8) ZVal {
    let r: ZVal = zfresh(b, ty);
    let o: ZOp = mk_op_at(b,"arith.constant");
    push[ZVal](&o.results, r);
    push[ZAttr](&o.attrs, ZAttr{ .key = "value", .val = text });
    push[ZOp](&blk.*.ops, o);
    return r;
}

fn int_arith_name(op: []u8) []u8 {
    if (@strEq(op, "+")) { return "arith.addi"; }
    if (@strEq(op, "-")) { return "arith.subi"; }
    if (@strEq(op, "*")) { return "arith.muli"; }
    if (@strEq(op, "/")) { return "arith.divsi"; }
    if (@strEq(op, "%")) { return "arith.remsi"; }
    if (@strEq(op, "^")) { return "arith.xori"; }
    // Integer bitwise AND has a distinct ZIR name from eager boolean `&&`.
    // Keep the typed scalar contract unambiguous while the source parser
    // continues to use the same binary-expression representation.
    if (@strEq(op, "&")) { return "arith.andsi"; }
    // Integer bitwise OR likewise remains distinct from eager boolean `||`.
    if (@strEq(op, "|")) { return "arith.orsi"; }
    // Scalar shifts use signed-result operations with an explicit width
    // attribute.  Shift counts are values of the same exact integer type;
    // the native route validates 0 <= count < width before using CL.
    if (@strEq(op, "<<")) { return "arith.shli"; }
    if (@strEq(op, ">>")) { return "arith.shrsi"; }
    return "";
}
fn bool_logic_name(op: []u8) []u8 {
    if (@strEq(op, "&&")) { return "arith.andi"; }
    if (@strEq(op, "||")) { return "arith.ori"; }
    return "";
}
fn float_arith_name(op: []u8) []u8 {
    if (@strEq(op, "+")) { return "arith.addf"; }
    if (@strEq(op, "-")) { return "arith.subf"; }
    if (@strEq(op, "*")) { return "arith.mulf"; }
    if (@strEq(op, "/")) { return "arith.divf"; }
    return "";
}
fn cmp_pred(op: []u8) []u8 {
    if (@strEq(op, "==")) { return "eq"; }
    if (@strEq(op, "!=")) { return "ne"; }
    if (@strEq(op, "<"))  { return "slt"; }
    if (@strEq(op, ">"))  { return "sgt"; }
    if (@strEq(op, "<=")) { return "sle"; }
    if (@strEq(op, ">=")) { return "sge"; }
    return "";
}
fn is_cmp(op: []u8) i32 {
    if (cmp_pred(op).len > 0) { return 1; }
    return 0;
}
fn zir_is_float_ty(t: []u8) i32 {
    if (@strEq(t, "f32") || @strEq(t, "f64")) { return 1; }
    return 0;
}

fn zir_literal_context_type(t: []u8) i32 {
    if (@strEq(t, "i8") || @strEq(t, "u8") || @strEq(t, "i16") ||
        @strEq(t, "u16") || @strEq(t, "i32") || @strEq(t, "u32") ||
        @strEq(t, "i64") || @strEq(t, "u64") || @strEq(t, "isize") ||
        @strEq(t, "usize") || @strEq(t, "f32") || @strEq(t, "f64")) {
        return 1;
    }
    return 0;
}

// The direct scalar backend may consume one deliberately narrow inferred-local
// domain.  Keep the proof here, next to AST -> ZIR construction, instead of
// treating the ZIR result type as authority: contextual calls, identifiers,
// casts, and all non-integer literals remain bridge-only until their source
// typing is represented explicitly in ZIR. The separate declaration-aware
// helper below admits only a bounded, source-local i32 scalar call.
fn zir_i32_magnitude(text:[]u8,limit:i64)i32{
    if(text.len==0||text[0]=='+'||(text[0]=='0'&&text.len!=1)){return 0;}
    let value:i64=0;let i:i32=0;while(i<text.len){
        if(text[i]<'0'||text[i]>'9'){return 0;}
        let digit:i64=(text[i] as i64)-48;
        if(value>(limit-digit)/10){return 0;}
        value=value*10+digit;i=i+1;
    }
    return 1;
}
fn zir_i32_literal(text:[]u8)i32{
    if(text.len==0||text[0]=='+'){return 0;}
    if(text[0]=='-'){
        if(text.len==1||text[1]=='0'){return 0;}
        return zir_i32_magnitude(text[1..text.len],2147483648);
    }
    return zir_i32_magnitude(text,2147483647);
}
fn zir_inferred_i32_expr(n:*Node)i32{
    switch(n.*){
        .ilit=>|x|{return zir_i32_literal(x.text);}
        .un=>|u|{if(!@strEq(u.op,"-")){return 0;}
            switch(u.e.*){.ilit=>|x|{return (x.text.len>0&&x.text[0]!='0'&&
                zir_i32_magnitude(x.text,2147483648)==1) as i32;}
                else=>{return 0;}}
        }
        .bin=>|b|{let ok:i32=(@strEq(b.op,"+")||@strEq(b.op,"-")||
            @strEq(b.op,"*")||@strEq(b.op,"/")||@strEq(b.op,"%")) as i32;
            return (ok==1&&zir_inferred_i32_expr(b.l)==1&&
                zir_inferred_i32_expr(b.r)==1) as i32;}
        else=>{return 0;}
    }
}

// A deliberately narrow extension of the inferred-i32 proof: a direct scalar
// call whose declaration is fully visible in the current module, or an
// explicitly qualified imported public declaration. Unqualified imports,
// extern, generic, captured, and non-i32 calls remain bridge-only until their
// source contracts are represented in ZIR. Arity is bounded at six
// arguments; larger calls remain on the checked AST bridge.
fn zir_imported_scalar_fn_base(f:FnDecl,name:[]u8)i32{
    // Qualified imports are flattened by parse.zag as `alias__member`. The
    // parser-produced provenance bit distinguishes an explicit alias
    // clone from an unqualified imported declaration whose source name merely
    // contains `__`. Name shape is not authority for this proof.
    return (@strEq(f.name,name)&&f.origin.len>0&&!@strEq(f.origin,"<root>")&&
        f.is_pub==1&&f.import_qualified==1&&
        !(name.len>1&&name[0]=='_'&&name[1]=='_')&&f.is_extern==0&&
        f.tparams.len==0&&f.caps==0&&f.cap_names.len==0&&f.body.len>0) as i32;
}
fn zir_local_nullary_i32_fn(dl:ArrayList[*Node],name:[]u8)i32{
    let i:i32=0;while(i<dl.len){switch(dl.data[i].*){
        .fn_decl=>|f|{
            if(@strEq(f.name,name)&&f.is_extern==0&&f.tparams.len==0&&
               (@strEq(f.origin,"<root>")||zir_imported_scalar_fn_base(f,name)==1)&&
               zir_fn_has_annot(f,"@task_async")==0&&
               f.params.len==0&&
               f.caps==0&&f.cap_names.len==0&&@strEq(f.ret,"i32")&&
               f.body.len>0){return 1;}
        }
        else=>{}
    }i=i+1;}return 0;
}
fn zir_local_unary_i32_fn(dl:ArrayList[*Node],name:[]u8)i32{
    let i:i32=0;while(i<dl.len){switch(dl.data[i].*){
        .fn_decl=>|f|{
            if(@strEq(f.name,name)&&f.is_extern==0&&f.tparams.len==0&&
               (@strEq(f.origin,"<root>")||zir_imported_scalar_fn_base(f,name)==1)&&
               zir_fn_has_annot(f,"@task_async")==0&&
               f.params.len==1&&
               @strEq(f.params.data[0].pty,"i32")&&f.caps==0&&
               f.cap_names.len==0&&@strEq(f.ret,"i32")&&f.body.len>0){return 1;}
        }
        else=>{}
    }i=i+1;}return 0;
}
fn zir_local_binary_i32_fn(dl:ArrayList[*Node],name:[]u8)i32{
    let i:i32=0;while(i<dl.len){switch(dl.data[i].*){
        .fn_decl=>|f|{
            if(@strEq(f.name,name)&&f.is_extern==0&&f.tparams.len==0&&
               (@strEq(f.origin,"<root>")||zir_imported_scalar_fn_base(f,name)==1)&&
               zir_fn_has_annot(f,"@task_async")==0&&
               f.params.len==2&&
               @strEq(f.params.data[0].pty,"i32")&&
               @strEq(f.params.data[1].pty,"i32")&&f.caps==0&&
               f.cap_names.len==0&&@strEq(f.ret,"i32")&&f.body.len>0){return 1;}
        }
        else=>{}
    }i=i+1;}return 0;
}
fn zir_local_ternary_i32_fn(dl:ArrayList[*Node],name:[]u8)i32{
    let i:i32=0;while(i<dl.len){switch(dl.data[i].*){
        .fn_decl=>|f|{
            if(@strEq(f.name,name)&&f.is_extern==0&&f.tparams.len==0&&
               (@strEq(f.origin,"<root>")||zir_imported_scalar_fn_base(f,name)==1)&&
               zir_fn_has_annot(f,"@task_async")==0&&
               f.params.len==3&&
               @strEq(f.params.data[0].pty,"i32")&&
               @strEq(f.params.data[1].pty,"i32")&&
               @strEq(f.params.data[2].pty,"i32")&&f.caps==0&&
               f.cap_names.len==0&&@strEq(f.ret,"i32")&&f.body.len>0){return 1;}
        }
        else=>{}
    }i=i+1;}return 0;
}
fn zir_local_quaternary_i32_fn(dl:ArrayList[*Node],name:[]u8)i32{
    let i:i32=0;while(i<dl.len){switch(dl.data[i].*){
        .fn_decl=>|f|{
            if(@strEq(f.name,name)&&f.is_extern==0&&f.tparams.len==0&&
               (@strEq(f.origin,"<root>")||zir_imported_scalar_fn_base(f,name)==1)&&
               zir_fn_has_annot(f,"@task_async")==0&&
               f.params.len==4&&
               @strEq(f.params.data[0].pty,"i32")&&
               @strEq(f.params.data[1].pty,"i32")&&
               @strEq(f.params.data[2].pty,"i32")&&
               @strEq(f.params.data[3].pty,"i32")&&f.caps==0&&
               f.cap_names.len==0&&@strEq(f.ret,"i32")&&f.body.len>0){return 1;}
        }
        else=>{}
    }i=i+1;}return 0;
}
fn zir_local_quinary_i32_fn(dl:ArrayList[*Node],name:[]u8)i32{
    let i:i32=0;while(i<dl.len){switch(dl.data[i].*{
        .fn_decl=>|f|{
            if(@strEq(f.name,name)&&f.is_extern==0&&f.tparams.len==0&&
               (@strEq(f.origin,"<root>")||zir_imported_scalar_fn_base(f,name)==1)&&
               zir_fn_has_annot(f,"@task_async")==0&&
               f.params.len==5&&
               @strEq(f.params.data[0].pty,"i32")&&
               @strEq(f.params.data[1].pty,"i32")&&
               @strEq(f.params.data[2].pty,"i32")&&
               @strEq(f.params.data[3].pty,"i32")&&
               @strEq(f.params.data[4].pty,"i32")&&f.caps==0&&
               f.cap_names.len==0&&@strEq(f.ret,"i32")&&f.body.len>0){return 1;}
        }
        else=>{}
    }i=i+1;}return 0;
}
fn zir_local_senary_i32_fn(dl:ArrayList[*Node],name:[]u8)i32{
    let i:i32=0;while(i<dl.len){switch(dl.data[i].*{
        .fn_decl=>|f|{
            if(@strEq(f.name,name)&&f.is_extern==0&&f.tparams.len==0&&
               (@strEq(f.origin,"<root>")||zir_imported_scalar_fn_base(f,name)==1)&&
               zir_fn_has_annot(f,"@task_async")==0&&
               f.params.len==6&&
               @strEq(f.params.data[0].pty,"i32")&&
               @strEq(f.params.data[1].pty,"i32")&&
               @strEq(f.params.data[2].pty,"i32")&&
               @strEq(f.params.data[3].pty,"i32")&&
               @strEq(f.params.data[4].pty,"i32")&&
               @strEq(f.params.data[5].pty,"i32")&&f.caps==0&&
               f.cap_names.len==0&&@strEq(f.ret,"i32")&&f.body.len>0){return 1;}
        }
        else=>{}
    }i=i+1;}return 0;
}
fn zir_local_septenary_i32_fn(dl:ArrayList[*Node],name:[]u8)i32{
    let i:i32=0;while(i<dl.len){switch(dl.data[i].*{
        .fn_decl=>|f|{
            if(@strEq(f.name,name)&&f.is_extern==0&&f.tparams.len==0&&
               (@strEq(f.origin,"<root>")||zir_imported_scalar_fn_base(f,name)==1)&&
               zir_fn_has_annot(f,"@task_async")==0&&
               f.params.len==7&&
               @strEq(f.params.data[0].pty,"i32")&&
               @strEq(f.params.data[1].pty,"i32")&&
               @strEq(f.params.data[2].pty,"i32")&&
               @strEq(f.params.data[3].pty,"i32")&&
               @strEq(f.params.data[4].pty,"i32")&&
               @strEq(f.params.data[5].pty,"i32")&&
               @strEq(f.params.data[6].pty,"i32")&&f.caps==0&&
               f.cap_names.len==0&&@strEq(f.ret,"i32")&&f.body.len>0){return 1;}
        }
        else=>{}
    }i=i+1;}return 0;
}
fn zir_inferred_i32_expr_call(n:*Node,dl:ArrayList[*Node])i32{
    switch(n.*){
        .call=>|c|{
            let name:[]u8=ident_name(c.callee);
            if(name.len==0||has_dot(name)==1){return 0;}
            if(c.args.len==0){return zir_local_nullary_i32_fn(dl,name);}
            if(c.args.len==2){
                if(zir_local_binary_i32_fn(dl,name)==0){return 0;}
                return (zir_inferred_i32_expr(c.args.data[0])==1&&
                    zir_inferred_i32_expr(c.args.data[1])==1) as i32;
            }
            if(c.args.len==3){
                if(zir_local_ternary_i32_fn(dl,name)==0){return 0;}
                return (zir_inferred_i32_expr(c.args.data[0])==1&&
                    zir_inferred_i32_expr(c.args.data[1])==1&&
                    zir_inferred_i32_expr(c.args.data[2])==1) as i32;
            }
            if(c.args.len==4){
                if(zir_local_quaternary_i32_fn(dl,name)==0){return 0;}
                return (zir_inferred_i32_expr(c.args.data[0])==1&&
                    zir_inferred_i32_expr(c.args.data[1])==1&&
                    zir_inferred_i32_expr(c.args.data[2])==1&&
                    zir_inferred_i32_expr(c.args.data[3])==1) as i32;
            }
            if(c.args.len==5){
                if(zir_local_quinary_i32_fn(dl,name)==0){return 0;}
                return (zir_inferred_i32_expr(c.args.data[0])==1&&
                    zir_inferred_i32_expr(c.args.data[1])==1&&
                    zir_inferred_i32_expr(c.args.data[2])==1&&
                    zir_inferred_i32_expr(c.args.data[3])==1&&
                    zir_inferred_i32_expr(c.args.data[4])==1) as i32;
            }
            if(c.args.len==6){
                if(zir_local_senary_i32_fn(dl,name)==0){return 0;}
                return (zir_inferred_i32_expr(c.args.data[0])==1&&
                    zir_inferred_i32_expr(c.args.data[1])==1&&
                    zir_inferred_i32_expr(c.args.data[2])==1&&
                    zir_inferred_i32_expr(c.args.data[3])==1&&
                    zir_inferred_i32_expr(c.args.data[4])==1&&
                    zir_inferred_i32_expr(c.args.data[5])==1) as i32;
            }
            if(c.args.len==7){
                if(zir_local_septenary_i32_fn(dl,name)==0){return 0;}
                return (zir_inferred_i32_expr(c.args.data[0])==1&&
                    zir_inferred_i32_expr(c.args.data[1])==1&&
                    zir_inferred_i32_expr(c.args.data[2])==1&&
                    zir_inferred_i32_expr(c.args.data[3])==1&&
                    zir_inferred_i32_expr(c.args.data[4])==1&&
                    zir_inferred_i32_expr(c.args.data[5])==1&&
                    zir_inferred_i32_expr(c.args.data[6])==1) as i32;
            }
            if(c.args.len!=1||zir_local_unary_i32_fn(dl,name)==0){return 0;}
            return zir_inferred_i32_expr(get[*Node](c.args,0));}
        else=>{return 0;}
    }
}

// Keep inferred i64 locals equally narrow: only a nullary, one-, two-,
// three-, four-, five-, six-, or seven-argument captureless source-local or explicitly qualified imported
// public function with an explicitly declared i64 return is admitted. Every
// argument additionally needs a canonical integer expression under the
// declaration-provided i64 parameter type. Unqualified imports, arbitrary
// contextual expressions, and mismatched parameter types remain on the
// checked AST bridge until their source typing is represented in ZIR.
fn zir_i64_magnitude(text:[]u8,limit:i64)i32{
    if(text.len==0||text[0]=='+'||(text[0]=='0'&&text.len!=1)){return 0;}
    let value:i64=0;let i:i32=0;while(i<text.len){
        if(text[i]<'0'||text[i]>'9'){return 0;}
        let digit:i64=(text[i] as i64)-48;
        if(value>(limit-digit)/10){return 0;}
        value=value*10+digit;i=i+1;
    }
    return 1;
}
fn zir_i64_literal(text:[]u8)i32{
    if(text.len==0||text[0]=='+'){return 0;}
    if(text[0]=='-'){
        if(text.len==1||text[1]=='0'){return 0;}
        return zir_i64_magnitude(text[1..text.len],9223372036854775807);
    }
    return zir_i64_magnitude(text,9223372036854775807);
}
fn zir_inferred_i64_expr(n:*Node)i32{
    switch(n.*){
        .ilit=>|x|{return zir_i64_literal(x.text);}
        .un=>|u|{if(!@strEq(u.op,"-")){return 0;}
            switch(u.e.*){.ilit=>|x|{return (x.text.len>0&&x.text[0]!='0'&&
                zir_i64_magnitude(x.text,9223372036854775807)==1) as i32;}
                else=>{return 0;}}
        }
        .bin=>|b|{let ok:i32=(@strEq(b.op,"+")||@strEq(b.op,"-")||
            @strEq(b.op,"*")||@strEq(b.op,"/")||@strEq(b.op,"%")) as i32;
            return (ok==1&&zir_inferred_i64_expr(b.l)==1&&
                zir_inferred_i64_expr(b.r)==1) as i32;}
        else=>{return 0;}
    }
}
fn zir_local_nullary_i64_fn(dl:ArrayList[*Node],name:[]u8)i32{
    let i:i32=0;while(i<dl.len){switch(dl.data[i].*){
        .fn_decl=>|f|{
            if(@strEq(f.name,name)&&f.is_extern==0&&f.tparams.len==0&&
               (@strEq(f.origin,"<root>")||zir_imported_scalar_fn_base(f,name)==1)&&
               zir_fn_has_annot(f,"@task_async")==0&&
               f.params.len==0&&
               f.caps==0&&f.cap_names.len==0&&@strEq(f.ret,"i64")&&
               f.body.len>0){return 1;}
        }
        else=>{}
    }i=i+1;}return 0;
}
fn zir_local_unary_i64_fn(dl:ArrayList[*Node],name:[]u8)i32{
    let i:i32=0;while(i<dl.len){switch(dl.data[i].*){
        .fn_decl=>|f|{
            if(@strEq(f.name,name)&&f.is_extern==0&&f.tparams.len==0&&
               (@strEq(f.origin,"<root>")||zir_imported_scalar_fn_base(f,name)==1)&&
               zir_fn_has_annot(f,"@task_async")==0&&
               f.params.len==1&&
               @strEq(f.params.data[0].pty,"i64")&&f.caps==0&&
               f.cap_names.len==0&&@strEq(f.ret,"i64")&&f.body.len>0){return 1;}
        }
        else=>{}
    }i=i+1;}return 0;
}
fn zir_local_binary_i64_fn(dl:ArrayList[*Node],name:[]u8)i32{
    let i:i32=0;while(i<dl.len){switch(dl.data[i].*){
        .fn_decl=>|f|{
            if(@strEq(f.name,name)&&f.is_extern==0&&f.tparams.len==0&&
               (@strEq(f.origin,"<root>")||zir_imported_scalar_fn_base(f,name)==1)&&
               zir_fn_has_annot(f,"@task_async")==0&&
               f.params.len==2&&
               @strEq(f.params.data[0].pty,"i64")&&
               @strEq(f.params.data[1].pty,"i64")&&f.caps==0&&
               f.cap_names.len==0&&@strEq(f.ret,"i64")&&f.body.len>0){return 1;}
        }
        else=>{}
    }i=i+1;}return 0;
}
fn zir_local_ternary_i64_fn(dl:ArrayList[*Node],name:[]u8)i32{
    let i:i32=0;while(i<dl.len){switch(dl.data[i].*){
        .fn_decl=>|f|{
            if(@strEq(f.name,name)&&f.is_extern==0&&f.tparams.len==0&&
               (@strEq(f.origin,"<root>")||zir_imported_scalar_fn_base(f,name)==1)&&
               zir_fn_has_annot(f,"@task_async")==0&&
               f.params.len==3&&
               @strEq(f.params.data[0].pty,"i64")&&
               @strEq(f.params.data[1].pty,"i64")&&
               @strEq(f.params.data[2].pty,"i64")&&f.caps==0&&
               f.cap_names.len==0&&@strEq(f.ret,"i64")&&f.body.len>0){return 1;}
        }
        else=>{}
    }i=i+1;}return 0;
}
fn zir_local_quaternary_i64_fn(dl:ArrayList[*Node],name:[]u8)i32{
    let i:i32=0;while(i<dl.len){switch(dl.data[i].*){
        .fn_decl=>|f|{
            if(@strEq(f.name,name)&&f.is_extern==0&&f.tparams.len==0&&
               (@strEq(f.origin,"<root>")||zir_imported_scalar_fn_base(f,name)==1)&&
               zir_fn_has_annot(f,"@task_async")==0&&
               f.params.len==4&&
               @strEq(f.params.data[0].pty,"i64")&&
               @strEq(f.params.data[1].pty,"i64")&&
               @strEq(f.params.data[2].pty,"i64")&&
               @strEq(f.params.data[3].pty,"i64")&&f.caps==0&&
               f.cap_names.len==0&&@strEq(f.ret,"i64")&&f.body.len>0){return 1;}
        }
        else=>{}
    }i=i+1;}return 0;
}
fn zir_local_quinary_i64_fn(dl:ArrayList[*Node],name:[]u8)i32{
    let i:i32=0;while(i<dl.len){switch(dl.data[i].*{
        .fn_decl=>|f|{
            if(@strEq(f.name,name)&&f.is_extern==0&&f.tparams.len==0&&
               (@strEq(f.origin,"<root>")||zir_imported_scalar_fn_base(f,name)==1)&&
               zir_fn_has_annot(f,"@task_async")==0&&
               f.params.len==5&&
               @strEq(f.params.data[0].pty,"i64")&&
               @strEq(f.params.data[1].pty,"i64")&&
               @strEq(f.params.data[2].pty,"i64")&&
               @strEq(f.params.data[3].pty,"i64")&&
               @strEq(f.params.data[4].pty,"i64")&&f.caps==0&&
               f.cap_names.len==0&&@strEq(f.ret,"i64")&&f.body.len>0){return 1;}
        }
        else=>{}
    }i=i+1;}return 0;
}
fn zir_local_senary_i64_fn(dl:ArrayList[*Node],name:[]u8)i32{
    let i:i32=0;while(i<dl.len){switch(dl.data[i].*{
        .fn_decl=>|f|{
            if(@strEq(f.name,name)&&f.is_extern==0&&f.tparams.len==0&&
               (@strEq(f.origin,"<root>")||zir_imported_scalar_fn_base(f,name)==1)&&
               zir_fn_has_annot(f,"@task_async")==0&&
               f.params.len==6&&
               @strEq(f.params.data[0].pty,"i64")&&
               @strEq(f.params.data[1].pty,"i64")&&
               @strEq(f.params.data[2].pty,"i64")&&
               @strEq(f.params.data[3].pty,"i64")&&
               @strEq(f.params.data[4].pty,"i64")&&
               @strEq(f.params.data[5].pty,"i64")&&f.caps==0&&
               f.cap_names.len==0&&@strEq(f.ret,"i64")&&f.body.len>0){return 1;}
        }
        else=>{}
    }i=i+1;}return 0;
}
fn zir_local_septenary_i64_fn(dl:ArrayList[*Node],name:[]u8)i32{
    let i:i32=0;while(i<dl.len){switch(dl.data[i].*{
        .fn_decl=>|f|{
            if(@strEq(f.name,name)&&f.is_extern==0&&f.tparams.len==0&&
               (@strEq(f.origin,"<root>")||zir_imported_scalar_fn_base(f,name)==1)&&
               zir_fn_has_annot(f,"@task_async")==0&&
               f.params.len==7&&
               @strEq(f.params.data[0].pty,"i64")&&
               @strEq(f.params.data[1].pty,"i64")&&
               @strEq(f.params.data[2].pty,"i64")&&
               @strEq(f.params.data[3].pty,"i64")&&
               @strEq(f.params.data[4].pty,"i64")&&
               @strEq(f.params.data[5].pty,"i64")&&
               @strEq(f.params.data[6].pty,"i64")&&f.caps==0&&
               f.cap_names.len==0&&@strEq(f.ret,"i64")&&f.body.len>0){return 1;}
        }
        else=>{}
    }i=i+1;}return 0;
}
fn zir_inferred_i64_expr_call(n:*Node,dl:ArrayList[*Node])i32{
    switch(n.*){
        .call=>|c|{
            let name:[]u8=ident_name(c.callee);
            if(name.len==0||has_dot(name)==1){return 0;}
            if(c.args.len==0){return zir_local_nullary_i64_fn(dl,name);}
            if(c.args.len==2){
                if(zir_local_binary_i64_fn(dl,name)==0){return 0;}
                return (zir_inferred_i64_expr(c.args.data[0])==1&&
                    zir_inferred_i64_expr(c.args.data[1])==1) as i32;
            }
            if(c.args.len==3){
                if(zir_local_ternary_i64_fn(dl,name)==0){return 0;}
                return (zir_inferred_i64_expr(c.args.data[0])==1&&
                    zir_inferred_i64_expr(c.args.data[1])==1&&
                    zir_inferred_i64_expr(c.args.data[2])==1) as i32;
            }
            if(c.args.len==4){
                if(zir_local_quaternary_i64_fn(dl,name)==0){return 0;}
                return (zir_inferred_i64_expr(c.args.data[0])==1&&
                    zir_inferred_i64_expr(c.args.data[1])==1&&
                    zir_inferred_i64_expr(c.args.data[2])==1&&
                    zir_inferred_i64_expr(c.args.data[3])==1) as i32;
            }
            if(c.args.len==5){
                if(zir_local_quinary_i64_fn(dl,name)==0){return 0;}
                return (zir_inferred_i64_expr(c.args.data[0])==1&&
                    zir_inferred_i64_expr(c.args.data[1])==1&&
                    zir_inferred_i64_expr(c.args.data[2])==1&&
                    zir_inferred_i64_expr(c.args.data[3])==1&&
                    zir_inferred_i64_expr(c.args.data[4])==1) as i32;
            }
            if(c.args.len==6){
                if(zir_local_senary_i64_fn(dl,name)==0){return 0;}
                return (zir_inferred_i64_expr(c.args.data[0])==1&&
                    zir_inferred_i64_expr(c.args.data[1])==1&&
                    zir_inferred_i64_expr(c.args.data[2])==1&&
                    zir_inferred_i64_expr(c.args.data[3])==1&&
                    zir_inferred_i64_expr(c.args.data[4])==1&&
                    zir_inferred_i64_expr(c.args.data[5])==1) as i32;
            }
            if(c.args.len==7){
                if(zir_local_septenary_i64_fn(dl,name)==0){return 0;}
                return (zir_inferred_i64_expr(c.args.data[0])==1&&
                    zir_inferred_i64_expr(c.args.data[1])==1&&
                    zir_inferred_i64_expr(c.args.data[2])==1&&
                    zir_inferred_i64_expr(c.args.data[3])==1&&
                    zir_inferred_i64_expr(c.args.data[4])==1&&
                    zir_inferred_i64_expr(c.args.data[5])==1&&
                    zir_inferred_i64_expr(c.args.data[6])==1) as i32;
            }
            if(c.args.len!=1||zir_local_unary_i64_fn(dl,name)==0){return 0;}
            return zir_inferred_i64_expr(get[*Node](c.args,0));
        }
        else=>{return 0;}
    }
}

fn zir_starts_with(s:[]u8,prefix:[]u8)i32{
    if(s.len<prefix.len){return 0;}let i:i32=0;while(i<prefix.len){if(s[i]!=prefix[i]){return 0;}i=i+1;}return 1;
}
fn zir_fn_decl_type(f:FnDecl)[]u8{
    let out:[]u8="fn(";let i:i32=0;while(i<f.params.len){if(i>0){out=_zag_str_concat(out,",");}out=_zag_str_concat(out,f.params.data[i].pty);i=i+1;}
    return _zag_str_concat(_zag_str_concat(out,")"),f.ret);
}
// Resolve only parser-hoisted, captureless closures whose explicit local type
// exactly matches the declaration. The immutable local binding is a separate
// proof step in lower_stmt; arbitrary function values remain bridge-only.
fn zir_local_closure_fn_target(dl:ArrayList[*Node],name:[]u8,expected:[]u8)[]u8{
    if(zir_starts_with(name,"__clos_")==0||zir_starts_with(name,"__clos_cap_")==1||expected.len==0){return "";}
    let i:i32=0;while(i<dl.len){switch(dl.data[i].*){
        .fn_decl=>|f|{if(@strEq(f.name,name)&&@strEq(f.origin,"<root>")&&
            f.is_extern==0&&f.caps==0&&f.tparams.len==0&&
            @strEq(zir_fn_decl_type(f),expected)){return f.name;}}
        else=>{}
    }i=i+1;}return "";
}

// Resolve a plain source-local function value only when the declaration is an
// exact, root-owned, non-generic, non-extern, captureless function and the
// parser's canonical function type matches the explicit local type. This is a
// separate proof from the parser-hoisted `__clos_` path: imported/qualified,
// captured, mutable, generic, extern, and mismatched values remain bridge-only.
fn zir_local_named_fn_target(dl:ArrayList[*Node],name:[]u8,expected:[]u8)[]u8{
    if(name.len==0||expected.len==0||has_dot(name)==1||
       zir_starts_with(name,"__clos_")==1){return "";}
    let i:i32=0;while(i<dl.len){switch(dl.data[i].*){
        .fn_decl=>|f|{if(@strEq(f.name,name)&&@strEq(f.origin,"<root>")&&
            f.is_extern==0&&f.caps==0&&f.cap_names.len==0&&f.tparams.len==0&&
            f.body.len>0&&@strEq(zir_fn_decl_type(f),expected)){return f.name;}}
        else=>{}
    }i=i+1;}return "";
}

fn op_bin(b: *ZB, blk: *ZBlock, op: []u8, l: ZVal, r: ZVal) ZVal {
    // Literal widening and other contextual coercions are not yet materialized
// in ZIR. Preserve the structural expression, but make the module ineligible
// for semantic authority when its operand types do not already agree.
    if (!@strEq(l.ty, r.ty)) { b.*.coverage_errors=b.*.coverage_errors+1; }
    if (is_cmp(op) == 1) {
        let res: ZVal = zfresh(b, "bool");
        let cn: []u8 = "arith.cmpi";
        if (zir_is_float_ty(l.ty) == 1) { cn = "arith.cmpf"; }
        let o: ZOp = mk_op_at(b,cn);
        push[ZVal](&o.results, res);
        push[ZVal](&o.operands, l);
        push[ZVal](&o.operands, r);
        push[ZAttr](&o.attrs, ZAttr{ .key = "predicate", .val = cmp_pred(op) });
        push[ZOp](&blk.*.ops, o);
        return res;
    }
    let bnm:[]u8=bool_logic_name(op);
    if(bnm.len>0){
        let res:ZVal=zfresh(b,"bool");
        if(!@strEq(l.ty,"bool")||!@strEq(r.ty,"bool")){b.*.coverage_errors=b.*.coverage_errors+1;}
        let o:ZOp=mk_op_at(b,bnm);push[ZVal](&o.results,res);push[ZVal](&o.operands,l);
        push[ZVal](&o.operands,r);push[ZOp](&blk.*.ops,o);return res;
    }
    let res: ZVal = zfresh(b, l.ty);
    let nm: []u8 = int_arith_name(op);
    if (zir_is_float_ty(l.ty) == 1) {
        nm = float_arith_name(op);
    }
    // Integer bitwise scalar operations are limited to exact i32/i64
    // operands/results. Bool, float, narrow, and arbitrary-width forms stay
    // on the checked bridge until their source-width/normalization contracts
    // are represented.
    if ((@strEq(nm, "arith.xori")||@strEq(nm, "arith.andsi")||
         @strEq(nm, "arith.orsi")||@strEq(nm, "arith.shli")||
         @strEq(nm, "arith.shrsi")) &&
        !(@strEq(l.ty, "i32") || @strEq(l.ty, "i64"))) {
        b.*.coverage_errors = b.*.coverage_errors + 1;
    }
    // Unsupported operators remain on the mature AST backend. Mark the
    // partial ZIR bridge-only instead of manufacturing an unknown operation
    // that the contract verifier must reject.
    if (nm.len == 0) { b.*.coverage_errors = b.*.coverage_errors + 1; }
    let o: ZOp = mk_op_at(b,nm);
    push[ZVal](&o.results, res);
    push[ZVal](&o.operands, l);
    push[ZVal](&o.operands, r);
    if(@strEq(nm,"arith.shli")||@strEq(nm,"arith.shrsi")){
        let width:[]u8="";if(@strEq(l.ty,"i32")){width="32";}
        if(@strEq(l.ty,"i64")){width="64";}
        push[ZAttr](&o.attrs,ZAttr{.key="width",.val=width});
    }
    push[ZOp](&blk.*.ops, o);
    return res;
}

fn op_alloca(b: *ZB, blk: *ZBlock, ty: []u8) ZVal {
    let slot: ZVal = zfresh(b, _zag_str_concat(_zag_str_concat("memref<", ty), ">"));
    let o: ZOp = mk_op_at(b,"memref.alloca");o.writes="stack";
    let owned:ZVal=zir_value(slot.name,slot.ty,"owned","stack","function",
        "target-default",slot.origin);push[ZVal](&o.results,owned);
    // `owned` replaces the generic SSA ownership assigned by zfresh.
    push[ZAttr](&o.attrs, ZAttr{ .key = "elem", .val = ty });
    push[ZOp](&blk.*.ops, o);
    return owned;
}
fn op_load(b: *ZB, blk: *ZBlock, slot: ZVal, ty: []u8) ZVal {
    let r: ZVal = zfresh(b, ty);
    let o: ZOp = mk_op_at(b,"memref.load");o.reads=slot.alias_region;
    push[ZVal](&o.results, r);
    push[ZVal](&o.operands, slot);
    push[ZAttr](&o.attrs, ZAttr{ .key = "elem", .val = ty });
    push[ZOp](&blk.*.ops, o);
    return r;
}
fn op_store(b: *ZB, blk: *ZBlock, v: ZVal, slot: ZVal, ty: []u8) void {
    let o: ZOp = mk_op_at(b,"memref.store");o.writes=slot.alias_region;
    push[ZVal](&o.operands, v);
    push[ZVal](&o.operands, slot);
    push[ZAttr](&o.attrs, ZAttr{ .key = "elem", .val = ty });
    push[ZOp](&blk.*.ops, o);
}

// ── AST → ZIR ────────────────────────────────────────────────────────────────
fn ident_name(n: *Node) []u8 {
    return switch (n.*) {
        .id => |x| x.name,
        else => "",
    };
}
fn has_dot(s: []u8) i32 {
    let i: i32 = 0;
    while (i < s.len) { if (s[i] == '.') { return 1; } i = i + 1; }
    return 0;
}

// reassigned-anywhere scan (mutable locals become alloca slots)
fn assigned_in(body: ArrayList[*Node], name: []u8) i32 {
    let i: i32 = 0;
    while (i < len[*Node](body)) {
        let s: *Node = get[*Node](body, i);
        switch (s.*) {
            .assign => |a| { if (@strEq(ident_name(a.target), name)) { return 1; } }
            .if_    => |iff| {
                if (assigned_in(iff.then_body, name) == 1) { return 1; }
                if (iff.has_els == 1) { if (assigned_in(iff.els_body, name) == 1) { return 1; } }
            }
            .while_ => |w| { if (assigned_in(w.body, name) == 1) { return 1; } }
            .unsafe_ => |u| { if (assigned_in(u.body, name) == 1) { return 1; } }
            .switch_ => |sw| {
                let ai:i32=0;while(ai<sw.arms.len){
                    if(assigned_in(sw.arms.data[ai].body,name)==1){return 1;}ai=ai+1;}
                if(sw.has_els==1&&assigned_in(sw.els_body,name)==1){return 1;}
            }
            else => { }
        }
        i = i + 1;
    }
    return 0;
}

fn zir_struct_field_type(dl:ArrayList[*Node],ty:[]u8,name:[]u8)[]u8{
    if(@strEq(name,"len")&&ty.len>=2&&ty[0]=='['){return "i64";}
    let base:[]u8=ty;if(base.len>0&&base[0]=='*'){base=base[1..base.len];}
    let i:i32=0;while(i<dl.len){switch(dl.data[i].*){.struct_=>|s|{if(@strEq(s.name,base)){
        let fi:i32=0;while(fi<s.fields.len){let field:Param=s.fields.data[fi];if(@strEq(field.name,name)){return field.pty;}fi=fi+1;}}}else=>{}}i=i+1;}
    return "";
}

fn zir_index_type(ty:[]u8)[]u8{
    if(ty.len>=3&&ty[0]=='['&&ty[1]==']'){return ty[2..ty.len];}
    if(ty.len>=2&&ty[0]=='*'){return ty[1..ty.len];}
    if(ty.len>=3&&ty[0]=='['){let i:i32=1;while(i<ty.len&&ty[i]!=']'){i=i+1;}
        if(i+1<ty.len){return ty[i+1..ty.len];}}
    return "";
}

fn zir_value_op(b:*ZB,blk:*ZBlock,name:[]u8,operands:ArrayList[ZVal],ty:[]u8)ZVal{
    let o:ZOp=mk_op_at(b,name);let i:i32=0;while(i<operands.len){push[ZVal](&o.operands,operands.data[i]);i=i+1;}
    let r:ZVal=zfresh(b,ty);push[ZVal](&o.results,r);push[ZOp](&blk.*.ops,o);return r;
}

fn zir_error_inner_type(ty:[]u8)[]u8{
    if(ty.len>1&&ty[0]=='!'){return ty[1..ty.len];}
    return "";
}

// Keep the existing source/policy-bound literal-negation transform stable:
// canonical `-literal` remains represented as `0 - literal`. Non-literal
// explicitly typed integer negation uses the dedicated typed ZIR unary op.
fn zir_neg_operand_is_literal(n:*Node)i32{
    switch(n.*){.ilit=>{return 1;}else=>{return 0;}}
}

fn lower_expr(b: *ZB, blk: *ZBlock, n: *Node, env: *ArrayList[ZBind], dl: ArrayList[*Node]) ZVal {
    let own:ZOrigin=zir_node_origin(b.*.origins,n);b.*.origin=own;
    switch (n.*) {
        .ilit => |x| {
            let ty: []u8 = "i32";
            if (b.*.expected_type.len > 0 &&
                zir_literal_context_type(b.*.expected_type) == 1) {
                ty = b.*.expected_type;
            } else if (has_dot(x.text) == 1) { ty = "f32"; }
            b.*.origin=own;return op_const(b, blk, x.text, ty);
        }
        .slit => |x| {
            let args:ArrayList[ZVal]=make[ZVal](1);b.*.origin=own;
            let r:ZVal=zir_value_op(b,blk,"zag.string.constant",args,"[]u8");
            let oi:i32=blk.*.ops.len-1;push[ZAttr](&blk.*.ops.data[oi].attrs,
                ZAttr{.key="value",.val=x.text});return r;
        }
        .embed => |x| {
            let args:ArrayList[ZVal]=make[ZVal](1);b.*.origin=own;
            let r:ZVal=zir_value_op(b,blk,"zag.embed.constant",args,"[]u8");
            let oi:i32=blk.*.ops.len-1;push[ZAttr](&blk.*.ops.data[oi].attrs,
                ZAttr{.key="path",.val=x.path});return r;
        }
        .id => |x| {
            if(@strEq(x.name,"true")){b.*.origin=own;return op_const(b,blk,"1","bool");}
            if(@strEq(x.name,"false")){b.*.origin=own;return op_const(b,blk,"0","bool");}
            if(@strEq(x.name,"null")){let args:ArrayList[ZVal]=make[ZVal](1);b.*.origin=own;
                // A task operation may request the typed null-handle spelling;
                // ordinary source nulls retain their opaque pointer type.
                let null_ty:[]u8="*opaque";
                if(@strEq(b.*.expected_type,zir_task_handle_type())){null_ty=zir_task_handle_type();}
                return zir_value_op(b,blk,"zag.null",args,null_ty);}
            let bd: ZBind = env_find(env.*, x.name);
            if (@strEq(bd.val.name,"%undef")) {
                let closure_target:[]u8=zir_local_closure_fn_target(dl,x.name,b.*.expected_type);
                if(closure_target.len>0){b.*.origin=own;return zir_value(closure_target,
                    b.*.expected_type,"borrowed","function","function","declared",own);}
                let named_target:[]u8=zir_local_named_fn_target(dl,x.name,b.*.expected_type);
                if(named_target.len>0){b.*.origin=own;return zir_value(named_target,
                    b.*.expected_type,"borrowed","function","function","declared",own);}
                // Function/global/field resolution is outside the current SSA
                // subset. Mark coverage incomplete and use a defined opaque
                // placeholder so the verifier checks real SSA structure rather
                // than reporting a fabricated def-before-use failure.
                b.*.coverage_errors=b.*.coverage_errors+1;
                b.*.origin=own;return op_const(b,blk,"0","i32");
            }
            if (bd.is_alloca == 1) {
                b.*.origin=own;return op_load(b, blk, bd.val, memref_elem(bd.val.ty));
            }
            return bd.val;
        }
        .bin => |bb| {
            // Once the left operand has a concrete source type, literals and
            // other context-sensitive right operands must be lowered in that
            // same type.  This is especially important for `wide > 0` and
            // mixed-width arithmetic: preserving only the outer let/return
            // context still leaves the comparison's literal as i32.
            let previous:[]u8=b.*.expected_type;
            let l: ZVal = lower_expr(b, blk, bb.l, env, dl);
            b.*.expected_type=l.ty;
            let r: ZVal = lower_expr(b, blk, bb.r, env, dl);
            b.*.expected_type=previous;
            b.*.origin=own;return op_bin(b, blk, bb.op, l, r);
        }
        .un => |u| {
            let v: ZVal = lower_expr(b, blk, u.e, env, dl);
            if(@strEq(u.op,"try")){
                let inner:[]u8=zir_error_inner_type(v.ty);
                if(inner.len==0||zir_error_inner_type(b.*.current_ret).len==0||
                   !@strEq(zir_error_inner_type(b.*.current_ret),inner)){
                    b.*.coverage_errors=b.*.coverage_errors+1;return v;
                }
                let o:ZOp=mk_op_at(b,"error.propagate");
                push[ZAttr](&o.attrs,ZAttr{.key="error_type",.val=v.ty});
                push[ZAttr](&o.attrs,ZAttr{.key="result_type",.val=inner});
                push[ZAttr](&o.attrs,ZAttr{.key="propagates",.val="1"});
                push[ZVal](&o.operands,v);let r:ZVal=zfresh(b,inner);
                push[ZVal](&o.results,r);push[ZOp](&blk.*.ops,o);return r;
            }
            if (@strEq(u.op, "-")) {
                if((@strEq(v.ty,"i32")||@strEq(v.ty,"i64"))&&
                   zir_neg_operand_is_literal(u.e)==0){
                    b.*.origin=own;let r:ZVal=zfresh(b,v.ty);let o:ZOp=mk_op_at(b,"arith.negsi");
                    push[ZVal](&o.results,r);push[ZVal](&o.operands,v);push[ZOp](&blk.*.ops,o);return r;
                }
                if((@strEq(v.ty,"f32")||@strEq(v.ty,"f64"))&&
                   zir_neg_operand_is_literal(u.e)==0){
                    b.*.origin=own;let r:ZVal=zfresh(b,v.ty);let o:ZOp=mk_op_at(b,"arith.negf");
                    push[ZVal](&o.results,r);push[ZVal](&o.operands,v);push[ZOp](&blk.*.ops,o);return r;
                }
                let z: ZVal = op_const(b, blk, "0", v.ty);
                b.*.origin=own;return op_bin(b, blk, "-", z, v);
            }
            if(@strEq(u.op,"!")&&@strEq(v.ty,"bool")){
                b.*.origin=own;let r:ZVal=zfresh(b,"bool");let o:ZOp=mk_op_at(b,"arith.not");
                push[ZVal](&o.results,r);push[ZVal](&o.operands,v);push[ZOp](&blk.*.ops,o);return r;
            }
            return v;
        }
        .call => |c| { return lower_call(b, blk, c, env, dl,own); }
        .cast_ => |c| {
            let v:ZVal=lower_expr(b,blk,c.expr,env,dl);let args:ArrayList[ZVal]=make[ZVal](1);
            push[ZVal](&args,v);b.*.origin=own;return zir_value_op(b,blk,"zag.cast",args,c.target);
        }
        .slit_ => |s| {
            let args:ArrayList[ZVal]=make[ZVal](s.fields.len);let i:i32=0;
            while(i<s.fields.len){push[ZVal](&args,lower_expr(b,blk,s.fields.data[i].val,env,dl));i=i+1;}
            b.*.origin=own;let r:ZVal=zir_value_op(b,blk,"zag.struct.constant",args,s.sname);
            let oi:i32=blk.*.ops.len-1;i=0;while(i<s.fields.len){push[ZAttr](&blk.*.ops.data[oi].attrs,
                ZAttr{.key=_zag_str_concat("field.",_zag_i64_to_str(i as i64)),.val=s.fields.data[i].name});i=i+1;}
            return r;
        }
        .fld => |f| {
            let base:ZVal=lower_expr(b,blk,f.base,env,dl);let ty:[]u8=zir_struct_field_type(dl,base.ty,f.fname);
            if(ty.len==0){b.*.coverage_errors=b.*.coverage_errors+1;ty="i32";}
            let args:ArrayList[ZVal]=make[ZVal](1);push[ZVal](&args,base);b.*.origin=own;
            let r:ZVal=zir_value_op(b,blk,"zag.field",args,ty);let oi:i32=blk.*.ops.len-1;
            push[ZAttr](&blk.*.ops.data[oi].attrs,ZAttr{.key="field",.val=f.fname});return r;
        }
        .idx => |x| {
            let base:ZVal=lower_expr(b,blk,x.base,env,dl);let index:ZVal=lower_expr(b,blk,x.idx,env,dl);
            let ty:[]u8=zir_index_type(base.ty);if(ty.len==0){b.*.coverage_errors=b.*.coverage_errors+1;ty="i32";}
            let args:ArrayList[ZVal]=make[ZVal](2);push[ZVal](&args,base);push[ZVal](&args,index);b.*.origin=own;
            return zir_value_op(b,blk,"zag.index",args,ty);
        }
        .slice_ => |x| {
            let base:ZVal=lower_expr(b,blk,x.base,env,dl);let lo:ZVal=lower_expr(b,blk,x.lo,env,dl);
            let args:ArrayList[ZVal]=make[ZVal](3);push[ZVal](&args,base);push[ZVal](&args,lo);
            if(x.has_hi==1){push[ZVal](&args,lower_expr(b,blk,x.hi,env,dl));}b.*.origin=own;
            return zir_value_op(b,blk,"zag.slice",args,base.ty);
        }
        else => { }
    }
    b.*.coverage_errors=b.*.coverage_errors+1;
    b.*.origin=own;return op_const(b, blk, "0", "i32");
}

fn memref_elem(t: []u8) []u8 {
    // "memref<i32>" → "i32"
    if (t.len > 8 && t[0] == 'm') { return t[7..t.len - 1]; }
    return t;
}

fn zir_fn_decl_exists(dl:ArrayList[*Node],name:[]u8)i32{
    let i:i32=0;while(i<dl.len){switch(dl.data[i].*){
        .fn_decl=>|f|{if(@strEq(f.name,name)){return 1;}}
        else=>{}
    }i=i+1;}
    // print_i32 is a compiler-provided bridge with no source declaration.
    if(@strEq(name,"print_i32")){return 1;}
    return 0;
}

// A direct call is admitted by provenance, never by the spelling of its
// lowered symbol. Root-owned functions are local authority. Imported
// functions are authority only when the parser recorded an explicit,
// public-qualified alias; private/imported spellings (including compiler
// hidden `__` names and unqualified source names) remain on the checked AST
// bridge. Calls between declarations from the same imported module are
// allowed so a public imported body may call its private helper internally.
fn zir_fn_call_provenance_allowed(dl:ArrayList[*Node],name:[]u8,caller_module:[]u8)i32{
    if(@strEq(name,"print_i32")){return 1;}
    let i:i32=0;while(i<dl.len){switch(dl.data[i].*){
        .fn_decl=>|f|{if(@strEq(f.name,name)){
            if(@strEq(f.origin,"<root>")&&@strEq(caller_module,"<root>")){return 1;}
            if(f.origin.len>0&&@strEq(f.origin,caller_module)){return 1;}
            return (f.import_qualified==1&&f.is_pub==1&&f.is_extern==0) as i32;
        }}
        else=>{}
    }i=i+1;}return 0;
}

fn zir_fn_has_annot(f:FnDecl,want:[]u8)i32{
    let i:i32=0;while(i<f.annots.len){if(@strEq(f.annots.data[i],want)){return 1;}i=i+1;}
    return 0;
}

fn zir_source_type_compatible(expected:[]u8,actual:[]u8)i32{
    if(@strEq(expected,actual)){return 1;}
    // Source async declarations intentionally expose `*opaque`; the typed IR
    // refines that value to the versioned TaskI64 handle after the spawn op.
    if((@strEq(expected,"*opaque")&&@strEq(actual,zir_task_handle_type()))||
       (@strEq(expected,zir_task_handle_type())&&@strEq(actual,"*opaque"))){return 1;}
    return 0;
}

fn zir_async_fn_decl(dl:ArrayList[*Node],name:[]u8)i32{
    let i:i32=0;while(i<dl.len){switch(dl.data[i].*){
        .fn_decl=>|f|{if(@strEq(f.name,name)&&zir_fn_has_annot(f,"@task_async")==1){return 1;}}
        else=>{}
    }i=i+1;}return 0;
}

fn zir_task_spawn_record(b:*ZB,blk:*ZBlock,worker:[]u8,result_type:[]u8,
    args:ArrayList[ZVal],own:ZOrigin)ZVal{
    b.*.origin=own;let o:ZOp=mk_op_at(b,"task.spawn");
    zir_task_attr(&o,"abi",zir_task_abi_version());
    zir_task_attr(&o,"handle_type",zir_task_handle_type());
    zir_task_attr(&o,"result_type",result_type);
    zir_task_attr(&o,"ownership","owned");
    zir_task_attr(&o,"cancellation",zir_task_cancellation_mode());
    zir_task_attr(&o,"scheduler",zir_task_scheduler_mode());
    zir_task_attr(&o,"callee",worker);
    zir_task_attr(&o,"consumes","0");
    let i:i32=0;while(i<args.len){push[ZVal](&o.operands,args.data[i]);i=i+1;}
    let r:ZVal=zfresh(b,zir_task_handle_type());
    r.ownership="owned";r.alias_region="heap";r.lifetime="function";r.layout="target-default";
    push[ZVal](&o.results,r);push[ZOp](&blk.*.ops,o);return r;
}

fn zir_task_handle_op(b:*ZB,blk:*ZBlock,name:[]u8,arg:ZVal,own:ZOrigin)ZVal{
    b.*.origin=own;let o:ZOp=mk_op_at(b,name);
    zir_task_attr(&o,"abi",zir_task_abi_version());
    zir_task_attr(&o,"handle_type",zir_task_handle_type());
    zir_task_attr(&o,"result_type","i64");
    let consumes:[]u8="0";if(@strEq(name,"task.await")){consumes="1";}
    zir_task_attr(&o,"consumes",consumes);
    zir_task_attr(&o,"cancellation",zir_task_cancellation_mode());
    push[ZVal](&o.operands,arg);
    let r:ZVal=zfresh(b,"i64");push[ZVal](&o.results,r);push[ZOp](&blk.*.ops,o);return r;
}

fn lower_call(b: *ZB, blk: *ZBlock, c: Call, env: *ArrayList[ZBind], dl: ArrayList[*Node],own:ZOrigin) ZVal {
    let cn: []u8 = ident_name(c.callee);
    let bound:ZBind=env_find(env.*,cn);if(bound.fn_target.len>0){cn=bound.fn_target;}

    // A direct language async call has a source result of `*opaque`, but its
    // ZIR result is the versioned affine TaskI64 handle.  Keep the worker body
    // and spawn operation explicit; native admission remains fail-closed.
    if(zir_async_fn_decl(dl,cn)==1){
        if(zir_fn_call_provenance_allowed(dl,cn,b.*.current_module)==0){b.*.coverage_errors=b.*.coverage_errors+1;}
        let argvals:ArrayList[ZVal]=make[ZVal](2);let i:i32=0;
        while(i<c.args.len){let expected:[]u8=zir_fn_param_type(dl,cn,i);
            if(expected.len==0){b.*.coverage_errors=b.*.coverage_errors+1;}
            let previous:[]u8=b.*.expected_type;b.*.expected_type=expected;
            let arg:ZVal=lower_expr(b,blk,c.args.data[i],env,dl);b.*.expected_type=previous;
            if(expected.len>0&&zir_source_type_compatible(expected,arg.ty)==0){b.*.coverage_errors=b.*.coverage_errors+1;}
            push[ZVal](&argvals,arg);i=i+1;}
        if(c.args.len>1){b.*.coverage_errors=b.*.coverage_errors+1;}
        return zir_task_spawn_record(b,blk,cn,zir_fn_ret_type(dl,cn),argvals,own);
    }

    // The raw bounded TaskI64 intrinsic uses the same typed spawn record. The
    // worker expression is a direct symbol and is represented by the callee
    // attribute rather than a fabricated SSA function value.
    if(@strEq(cn,"@taskSpawn")){
        let worker:[]u8="";if(c.args.len>0){worker=ident_name(c.args.data[0]);}
        if(worker.len==0||zir_fn_decl_exists(dl,worker)==0||
           zir_fn_call_provenance_allowed(dl,worker,b.*.current_module)==0){b.*.coverage_errors=b.*.coverage_errors+1;}
        let argvals:ArrayList[ZVal]=make[ZVal](1);
        if(c.args.len==2){let previous:[]u8=b.*.expected_type;b.*.expected_type="i64";
            let input:ZVal=lower_expr(b,blk,c.args.data[1],env,dl);b.*.expected_type=previous;
            if(!@strEq(input.ty,"i64")){b.*.coverage_errors=b.*.coverage_errors+1;}push[ZVal](&argvals,input);
        }else{b.*.coverage_errors=b.*.coverage_errors+1;}
        return zir_task_spawn_record(b,blk,worker,"i64",argvals,own);
    }

    if(@strEq(cn,"@taskAwait")||@strEq(cn,"@taskCancel")){
        let handle:ZVal=zir_value("%undef",zir_task_handle_type(),"unknown","unknown","unknown","unknown",zir_unknown_origin());
        if(c.args.len==1){let previous:[]u8=b.*.expected_type;b.*.expected_type=zir_task_handle_type();
            handle=lower_expr(b,blk,c.args.data[0],env,dl);b.*.expected_type=previous;
            if(zir_task_handle_compatible(handle.ty)==0){b.*.coverage_errors=b.*.coverage_errors+1;}
        }else{b.*.coverage_errors=b.*.coverage_errors+1;}
        let opname:[]u8="task.cancel";if(@strEq(cn,"@taskAwait")){opname="task.await";}
        return zir_task_handle_op(b,blk,opname,handle,own);
    }

    if(cn.len==0||zir_fn_decl_exists(dl,cn)==0||
       zir_fn_call_provenance_allowed(dl,cn,b.*.current_module)==0){
        b.*.coverage_errors=b.*.coverage_errors+1;
    }
    let argvals: ArrayList[ZVal] = make[ZVal](2);
    let i: i32 = 0;
    while (i < len[*Node](c.args)) {
        let expected:[]u8=zir_fn_param_type(dl,cn,i);
        let previous:[]u8=b.*.expected_type;b.*.expected_type=expected;
        let arg:ZVal=lower_expr(b, blk, get[*Node](c.args, i), env, dl);
        b.*.expected_type=previous;
        if(expected.len>0&&zir_source_type_compatible(expected,arg.ty)==0){
            b.*.coverage_errors=b.*.coverage_errors+1;
        }
        push[ZVal](&argvals,arg);
        i = i + 1;
    }
    let rty: []u8 = zir_fn_ret_type(dl, cn);
    b.*.origin=own;
    let o: ZOp = mk_op_at(b,"func.call");
    push[ZAttr](&o.attrs, ZAttr{ .key = "callee", .val = cn });
    let k: i32 = 0;
    while (k < len[ZVal](argvals)) { push[ZVal](&o.operands, get[ZVal](argvals, k)); k = k + 1; }
    if (@strEq(rty, "void")) {
        push[ZOp](&blk.*.ops, o);
        return zir_value("","void","none","none","statement","none",b.*.origin);
    }
    let r: ZVal = zfresh(b, rty);
    push[ZVal](&o.results, r);
    push[ZOp](&blk.*.ops, o);
    return r;
}

fn zir_fn_ret_type(dl: ArrayList[*Node], name: []u8) []u8 {
    let i: i32 = 0;
    while (i < len[*Node](dl)) {
        switch (get[*Node](dl, i).*) {
            .fn_decl => |f| { if (@strEq(f.name, name)) { return f.ret; } }
            else => { }
        }
        i = i + 1;
    }
    if (@strEq(name, "print_i32")) { return "void"; }
    return "i32";   // unknown callee → assume i32-returning
}

fn zir_fn_param_type(dl:ArrayList[*Node],name:[]u8,index:i32)[]u8{
    let i:i32=0;while(i<dl.len){switch(dl.data[i].*){
        .fn_decl=>|f|{if(@strEq(f.name,name)&&index>=0&&index<f.params.len){
            return f.params.data[index].pty;
        }}
        else=>{}
    }i=i+1;}
    return "";
}

fn lower_block(b: *ZB, blk: *ZBlock, body: ArrayList[*Node], env: *ArrayList[ZBind],
    dl: ArrayList[*Node], scope_start: i32) void {
    prealloc_scope(b, blk, body, env);
    let i: i32 = 0;
    while (i < len[*Node](body)) {
        lower_stmt(b, blk, get[*Node](body, i), env, dl, scope_start);
        i = i + 1;
    }
}

fn zir_switch_tags(tags:ArrayList[[]u8])[]u8{
    let out:[]u8="";let i:i32=0;while(i<tags.len){if(i>0){out=_zag_str_concat(out,",");}
        out=_zag_str_concat(out,tags.data[i]);i=i+1;}return out;
}

fn lower_stmt(b: *ZB, blk: *ZBlock, n: *Node, env: *ArrayList[ZBind],
    dl: ArrayList[*Node], scope_start: i32) void {
    let own:ZOrigin=zir_node_origin(b.*.origins,n);b.*.origin=own;
    switch (n.*) {
        .let_ => |l| {
            let previous:[]u8=b.*.expected_type;
            if(l.has_dty==1){b.*.expected_type=l.dty;}else{b.*.expected_type="";}
            let v: ZVal = lower_expr(b, blk, l.expr, env, dl);
            b.*.expected_type=previous;
            let inferred_i32:i32=(l.has_dty==0&&@strEq(v.ty,"i32")&&
                (zir_inferred_i32_expr(l.expr)==1||
                 zir_inferred_i32_expr_call(l.expr,dl)==1)) as i32;
            let inferred_i64:i32=(l.has_dty==0&&@strEq(v.ty,"i64")&&
                zir_inferred_i64_expr_call(l.expr,dl)==1) as i32;
            if((l.has_dty==0&&inferred_i32==0&&inferred_i64==0)||
               (l.has_dty==1&&zir_source_type_compatible(l.dty,v.ty)==0)){
                b.*.coverage_errors=b.*.coverage_errors+1;
            }
            let pending:i32=env_pending_index(env.*,l.name,scope_start);
            b.*.origin=own;
            if (pending >= 0) {
                let bd:ZBind=env.*.data[pending];
                op_store(b, blk, v, bd.val, memref_elem(bd.val.ty));
                env.*.data[pending].initialized=1;
            } else {
                let fn_target:[]u8="";
                if(l.has_dty==1&&pending<0){
                    fn_target=zir_local_closure_fn_target(dl,ident_name(l.expr),l.dty);
                    if(fn_target.len==0){fn_target=zir_local_named_fn_target(dl,ident_name(l.expr),l.dty);}
                }
                push[ZBind](env, ZBind{ .name = l.name, .val = v,
                    .is_alloca = 0,.initialized=1,.fn_target=fn_target });
            }
        }
        .assign => |a| {
            let target_name:[]u8=ident_name(a.target);
            let target_bind:ZBind=env_find(env.*,target_name);
            let previous:[]u8=b.*.expected_type;
            if(target_bind.is_alloca==1){b.*.expected_type=memref_elem(target_bind.val.ty);}else{b.*.expected_type="";}
            let v: ZVal = lower_expr(b, blk, a.expr, env, dl);
            b.*.expected_type=previous;
            let bd: ZBind = target_bind;
            b.*.origin=own;
            if(@strEq(bd.val.name,"%undef")||bd.is_alloca!=1){
                b.*.coverage_errors=b.*.coverage_errors+1;
            }else{let elem:[]u8=memref_elem(bd.val.ty);
                if(zir_source_type_compatible(elem,v.ty)==0){b.*.coverage_errors=b.*.coverage_errors+1;}
                op_store(b, blk, v, bd.val, elem);}
        }
        .ret => |r| {
            let rv:ZVal=zir_value("","void","none","none","statement","none",own);
            if(r.has_expr==1){let previous:[]u8=b.*.expected_type;b.*.expected_type=b.*.current_ret;
                rv=lower_expr(b,blk,r.expr,env,dl);b.*.expected_type=previous;}b.*.origin=own;
            let return_inner:[]u8=zir_error_inner_type(b.*.current_ret);
            let return_ok:i32=(return_inner.len>0&&@strEq(rv.ty,return_inner)) as i32;
            if((r.has_expr==0&&!@strEq(b.*.current_ret,"void"))||
               (r.has_expr==1&&(!@strEq(rv.ty,b.*.current_ret)&&return_ok==0||
                @strEq(b.*.current_ret,"void")))){
                b.*.coverage_errors=b.*.coverage_errors+1;
            }
            let o: ZOp = mk_op_at(b,"func.return");
            if (r.has_expr == 1) { push[ZVal](&o.operands,rv); }
            push[ZOp](&blk.*.ops, o);
        }
        .if_ => |iff| {
            let c: ZVal = lower_expr(b, blk, iff.cond, env, dl);
            b.*.origin=own;
            let o: ZOp = mk_op_at(b,"scf.if");
            push[ZVal](&o.operands, c);
            let tb: ZBlock = one_block();
            let then_mark:i32=env_scope_mark(env);
            lower_block(b, &tb, iff.then_body, env, dl, then_mark);
            env_scope_end(env,then_mark);
            push[ZRegion](&o.regions, region_of(tb));
            if (iff.has_els == 1) {
                let eb: ZBlock = one_block();
                let else_mark:i32=env_scope_mark(env);
                lower_block(b, &eb, iff.els_body, env, dl, else_mark);
                env_scope_end(env,else_mark);
                push[ZRegion](&o.regions, region_of(eb));
            }
            o.origin=own;
            push[ZOp](&blk.*.ops, o);
        }
        .while_ => |w| {
            // The condition is a region, not a precomputed operand: mutable
            // alloca-backed locals must be reloaded on every iteration.
            b.*.origin=own;let o:ZOp=mk_op_at(b,"scf.while");
            let cb:ZBlock=one_block();
            let cond:ZVal=lower_expr(b,&cb,w.cond,env,dl);
            let condition:ZOp=mk_op_at(b,"scf.condition");
            push[ZVal](&condition.operands,cond);push[ZOp](&cb.ops,condition);
            push[ZRegion](&o.regions,region_of(cb));
            let wb:ZBlock=one_block();let body_mark:i32=env_scope_mark(env);
            lower_block(b,&wb,w.body,env,dl,body_mark);env_scope_end(env,body_mark);
            let yield_op:ZOp=mk_op_at(b,"scf.yield");push[ZOp](&wb.ops,yield_op);
            push[ZRegion](&o.regions,region_of(wb));o.origin=own;push[ZOp](&blk.*.ops,o);
        }
        .break_ => |_| { b.*.origin=own;let o:ZOp=mk_op_at(b,"scf.break");push[ZOp](&blk.*.ops,o); }
        .continue_ => |_| { b.*.origin=own;let o:ZOp=mk_op_at(b,"scf.continue");push[ZOp](&blk.*.ops,o); }
        .unsafe_ => |u| {
            let unsafe_mark:i32=env_scope_mark(env);
            lower_block(b, blk, u.body, env, dl, unsafe_mark);
            env_scope_end(env,unsafe_mark);
        }
        .defer_ => |d| {
            b.*.origin=own;let o:ZOp=mk_op_at(b,"zag.defer");push[ZAttr](&o.attrs,
                ZAttr{.key="on_error",.val=_zag_i64_to_str(d.is_err as i64)});
            let db:ZBlock=one_block();let _v:ZVal=lower_expr(b,&db,d.expr,env,dl);b.*.origin=own;
            let yield_op:ZOp=mk_op_at(b,"zag.yield");push[ZOp](&db.ops,yield_op);
            push[ZRegion](&o.regions,region_of(db));push[ZOp](&blk.*.ops,o);
        }
        .switch_ => |sw| {
            let subject:ZVal=lower_expr(b,blk,sw.subject,env,dl);b.*.origin=own;
            let o:ZOp=mk_op_at(b,"zag.switch");push[ZVal](&o.operands,subject);
            let ai:i32=0;while(ai<sw.arms.len){let arm:SwitchArm=sw.arms.data[ai];let ab:ZBlock=one_block();
                let case_op:ZOp=mk_op_at(b,"zag.case");push[ZAttr](&case_op.attrs,
                    ZAttr{.key="patterns",.val=zir_switch_tags(arm.tags)});
                push[ZOp](&ab.ops,case_op);if(arm.has_cap==1){b.*.coverage_errors=b.*.coverage_errors+1;}
                let arm_mark:i32=env_scope_mark(env);
                lower_block(b,&ab,arm.body,env,dl,arm_mark);env_scope_end(env,arm_mark);
                push[ZRegion](&o.regions,region_of(ab));ai=ai+1;}
            if(sw.has_els==1){let eb:ZBlock=one_block();let default_op:ZOp=mk_op_at(b,"zag.default");
                push[ZOp](&eb.ops,default_op);let default_mark:i32=env_scope_mark(env);
                lower_block(b,&eb,sw.els_body,env,dl,default_mark);env_scope_end(env,default_mark);
                push[ZRegion](&o.regions,region_of(eb));}
            o.origin=own;push[ZOp](&blk.*.ops,o);
        }
        .estmt => |e| { let _v: ZVal = lower_expr(b, blk, e.expr, env, dl); }
        else => { b.*.coverage_errors=b.*.coverage_errors+1; }
    }
}

fn lower_fn(b: *ZB, node:*Node,f: FnDecl, dl: ArrayList[*Node], effects:i32) ZFunc {
    b.*.origin=zir_node_origin(b.*.origins,node);if(b.*.origin.complete==0){b.*.origin=zir_function_origin(f);}b.*.effects=effects;b.*.current_ret=f.ret;
    b.*.current_module=f.origin;
    let function_origin:ZOrigin=b.*.origin;
    let coverage_start:i32=b.*.coverage_errors;
    // Preserve the worker's declared result type for its body, while recording
    // the source-level ABI change to an affine TaskI64 handle as an explicit
    // metadata operation.  Native admission still rejects task operations
    // until a differential task backend exists.
    let params: ArrayList[ZVal] = make[ZVal](2);
    let env: ArrayList[ZBind] = make[ZBind](8);
    let i: i32 = 0;
    while (i < len[Param](f.params)) {
        let p: Param = get[Param](f.params, i);
        let pv: ZVal = zir_value(_zag_str_concat("%", p.name),p.pty,
            "borrowed","param","function","declared",b.*.origin);
        push[ZVal](&params, pv);
        push[ZBind](&env, ZBind{ .name = p.name, .val = pv,
            .is_alloca = 0,.initialized=1,.fn_target="" });
        i = i + 1;
    }
    let blk: ZBlock = one_block();
    if(zir_fn_has_annot(f,"@task_async")==1){zir_task_abi_metadata(b,&blk,f,function_origin);}
    // The top-level body owns its preallocated mutable locals.  Structured
    // children repeat the same bounded step under their own environment mark.
    lower_block(b, &blk, f.body, &env, dl, 0);
    return ZFunc{ .name = f.name, .params = params, .ret = f.ret, .body = blk,
        .effects=effects,.origin=function_origin,
        .coverage_complete=(b.*.coverage_errors==coverage_start) as i32,
        .coverage_errors=b.*.coverage_errors-coverage_start };
}

fn zir_block_origins_complete(blk:ZBlock)i32{
    let i:i32=0;while(i<blk.ops.len){let op:ZOp=blk.ops.data[i];if(op.origin.complete==0){return 0;}
        let ri:i32=0;while(ri<op.regions.len){let region:ZRegion=op.regions.data[ri];let bi:i32=0;
            while(bi<region.blocks.len){if(zir_block_origins_complete(region.blocks.data[bi])==0){return 0;}bi=bi+1;}ri=ri+1;}i=i+1;}
    return 1;
}

fn zir_block_origins_exact(blk:ZBlock)i32{
    let i:i32=0;while(i<blk.ops.len){let op:ZOp=blk.ops.data[i];if(op.origin.exact==0){return 0;}
        let ri:i32=0;while(ri<op.regions.len){let region:ZRegion=op.regions.data[ri];let bi:i32=0;
            while(bi<region.blocks.len){if(zir_block_origins_exact(region.blocks.data[bi])==0){return 0;}bi=bi+1;}ri=ri+1;}i=i+1;}
    return 1;
}

fn build_module(dl: ArrayList[*Node],eff:map.StringMap[i32],origins:ArrayList[NodeOrigin]) ZModule {
    let b: ZB = ZB{ .ctr = 0,.origin=zir_unknown_origin(),.effects=0,
        .coverage_errors=0,.current_ret="void",.expected_type="",.current_module="",.origins=origins };
    let m: ZModule = ZModule{ .funcs = make[ZFunc](4),
        .schema_version="zag-ir-v1",.transform_version="zag-transform-v1",
        .coverage_complete=1,.coverage_errors=0,.origin_complete=1,.origin_exact=1 };
    let i: i32 = 0;
    while (i < len[*Node](dl)) {
        switch (get[*Node](dl, i).*) {
            .fn_decl => |f| { if (f.is_extern == 0) {
                let mask:i32=map.get[i32](eff,f.name) orelse 0;
                let zf:ZFunc=lower_fn(&b,get[*Node](dl,i),f,dl,mask);push[ZFunc](&m.funcs,zf);
                if(zf.coverage_complete==0){m.coverage_complete=0;}
                m.coverage_errors=m.coverage_errors+zf.coverage_errors;
                if(zf.origin.complete==0||zir_block_origins_complete(zf.body)==0){m.origin_complete=0;}
                if(zf.origin.exact==0||zir_block_origins_exact(zf.body)==0){m.origin_exact=0;}
            } }
            else => { }
        }
        i = i + 1;
    }
    return m;
}

// Extract only the smallest useful semantic unit: a contiguous top-level run
// of effect-free operations with complete, exact source origins and no nested
// regions.  The result is an inspectable provenance record, never a candidate
// rewrite.  Any unsupported operation makes the extraction incomplete while
// preserving the accepted pure runs for explanation and future analysis.
fn zir_region_access_merge(a:[]u8,b:[]u8)[]u8{
    if(a.len==0||@strEq(a,"none")){return b;}
    if(b.len==0||@strEq(b,"none")){return a;}
    if(@strEq(a,b)){return a;}
    return "multiple";
}

fn zir_region_op_eligible(op:ZOp)i32{
    return (op.name.len>0&&op.effects==0&&op.regions.len==0&&
        op.origin.complete==1&&op.origin.exact==1&&
        !@strEq(op.reads,"unknown")&&!@strEq(op.writes,"unknown")) as i32;
}

fn zir_semantic_collect_block(out:*ZirRegionExtraction,fname:[]u8,blk:ZBlock,
    path:[]u8,depth:i32,ordinal:*i32)void{
    let start:i32=0-1;let count:i32=0;let reads:[]u8="none";let writes:[]u8="none";
    let first:ZOrigin=zir_unknown_origin();let last:ZOrigin=zir_unknown_origin();
    let oi:i32=0;while(oi<blk.ops.len){
        let op:ZOp=blk.ops.data[oi];let eligible:i32=zir_region_op_eligible(op);
        if(eligible==1){
            if(start<0){start=oi;count=0;reads=op.reads;writes=op.writes;first=op.origin;}
            else{reads=zir_region_access_merge(reads,op.reads);writes=zir_region_access_merge(writes,op.writes);}
            last=op.origin;count=count+1;
        }else{
            if(start>=0){
                if(out.*.regions.len>=64){out.*.valid=0;out.*.complete=0;out.*.reason="semantic region limit exceeded";return;}
                push[ZirSemanticRegion](&out.*.regions,ZirSemanticRegion{.function_name=fname,
                    .path=path,.depth=depth,.ordinal=ordinal.*,.op_start=start,.op_count=count,.effects=0,
                    .reads=reads,.writes=writes,.first_origin=first,.last_origin=last,.complete=1,.exact=1});
                ordinal.*=ordinal.*+1;start=0-1;count=0;
            }
            out.*.rejected_regions=out.*.rejected_regions+1;out.*.complete=0;
            // Structured operations are themselves outside the flat pure
            // domain, but their child blocks still have independent lexical
            // regions worth describing. Never grant executable authority.
            let ri:i32=0;while(ri<op.regions.len){
                let reg:ZRegion=op.regions.data[ri];let bi:i32=0;
                while(bi<reg.blocks.len){
                    let child_path:[]u8=_zag_str_concat(path,_zag_str_concat("/",_zag_i64_to_str(oi as i64)));
                    child_path=_zag_str_concat(child_path,_zag_str_concat("/",_zag_i64_to_str(ri as i64)));
                    child_path=_zag_str_concat(child_path,_zag_str_concat("/",_zag_i64_to_str(bi as i64)));
                    zir_semantic_collect_block(out,fname,reg.blocks.data[bi],child_path,depth+1,ordinal);
                    if(out.*.valid==0){return;}bi=bi+1;
                }ri=ri+1;
            }
        }
        oi=oi+1;
    }
    if(start>=0){
        if(out.*.regions.len>=64){out.*.valid=0;out.*.complete=0;out.*.reason="semantic region limit exceeded";return;}
        push[ZirSemanticRegion](&out.*.regions,ZirSemanticRegion{.function_name=fname,
            .path=path,.depth=depth,.ordinal=ordinal.*,.op_start=start,.op_count=count,.effects=0,
            .reads=reads,.writes=writes,.first_origin=first,.last_origin=last,.complete=1,.exact=1});
        ordinal.*=ordinal.*+1;
    }
}

fn zir_extract_semantic_regions(m:ZModule)ZirRegionExtraction{
    let out:ZirRegionExtraction=ZirRegionExtraction{.valid=1,.complete=1,
        .automatic=0,.source_changes=0,.executable_authority=0,
        .regions=make[ZirSemanticRegion](8),.rejected_regions=0,.reason=""};
    if(!@strEq(m.schema_version,"zag-ir-v1")||
        !@strEq(m.transform_version,"zag-transform-v1")){
        out.valid=0;out.complete=0;out.reason="unsupported IR schema";return out;}
    if(m.coverage_complete==0||m.origin_complete==0||m.origin_exact==0){
        out.valid=0;out.complete=0;out.reason="IR coverage or origin map is incomplete";return out;}
    let fi:i32=0;while(fi<m.funcs.len){
        let ordinal:i32=0;let f:ZFunc=m.funcs.data[fi];zir_semantic_collect_block(&out,f.name,f.body,"root",0,&ordinal);
        if(out.valid==0){return out;}fi=fi+1;
    }
    if(out.complete==0){out.reason="one or more operations remain outside the bounded pure-region domain";}
    else{out.reason="bounded pure semantic regions";}
    return out;
}

// ── pass: SSA verifier (def-before-use) ──────────────────────────────────────
fn verify_module(m: ZModule) i32 {
    let errs: i32 = 0;
    let i: i32 = 0;
    while (i < len[ZFunc](m.funcs)) {
        let f: ZFunc = get[ZFunc](m.funcs, i);
        // Definitions are looked up for every operand.  Keep a bounded hash
        // set rather than linearly scanning the complete prefix for each
        // operand; this is still the same def-before-use rule, but avoids a
        // quadratic verifier on large self-hosting modules.
        let defined: map.StringMap[i32] = map.make[i32](32);
        let p: i32 = 0;
        while (p < len[ZVal](f.params)) {
            map.put[i32](&defined, get[ZVal](f.params, p).name, 1);
            p = p + 1;
        }
        errs = errs + verify_block(f.body, &defined);
        map.free[i32](&defined);
        i = i + 1;
    }
    return errs;
}
fn name_seen(defined: map.StringMap[i32], n: []u8) i32 {
    return map.has[i32](defined, n) as i32;
}

// Nested regions are lexical verifier scopes.  A child may read definitions
// from its containing block, but definitions made in one child block must not
// leak into a sibling or back into the parent.  The old verifier shared one
// mutable map through every region, which accepted a use after a region ended
// (and a use in a sibling block) as if it were dominated by the child.
fn zir_defined_clone(src: map.StringMap[i32]) map.StringMap[i32] {
    let out: map.StringMap[i32] = map.make[i32](src.cap + 4);
    let i: i32 = 0;
    while (i < src.cap) {
        if (src.entries[i].used == 1) {
            map.put[i32](&out, src.entries[i].key, src.entries[i].val);
        }
        i = i + 1;
    }
    return out;
}
fn verify_block(blk: ZBlock, defined: *map.StringMap[i32]) i32 {
    let errs: i32 = 0;
    let i: i32 = 0;
    while (i < len[ZOp](blk.ops)) {
        let o: ZOp = get[ZOp](blk.ops, i);
        let k: i32 = 0;
        while (k < len[ZVal](o.operands)) {
            let nm: []u8 = get[ZVal](o.operands, k).name;
            if (nm.len > 0 && name_seen(defined.*, nm) == 0) { errs = errs + 1; }
            k = k + 1;
        }
        // Nested blocks see a snapshot of outer definitions plus their own
        // results.  Never let a child definition escape its region or leak
        // into a sibling block.
        let rg: i32 = 0;
        while (rg < len[ZRegion](o.regions)) {
            let reg: ZRegion = get[ZRegion](o.regions, rg);
            let bb: i32 = 0;
            while (bb < len[ZBlock](reg.blocks)) {
                let child_defined: map.StringMap[i32] = zir_defined_clone(defined.*);
                errs = errs + verify_block(get[ZBlock](reg.blocks, bb), &child_defined);
                map.free[i32](&child_defined);
                bb = bb + 1;
            }
            rg = rg + 1;
        }
        let rr: i32 = 0;
        while (rr < len[ZVal](o.results)) {
            map.put[i32](defined, get[ZVal](o.results, rr).name, 1);
            rr = rr + 1;
        }
        i = i + 1;
    }
    return errs;
}

// Structured-control verifier.  The SSA pass above proves only that a value
// is defined before an operand uses it.  This independent pass binds each
// control marker to the region that owns it, checks terminator placement, and
// prevents loop/defer/switch markers from being forged in an unrelated block.
// Contexts: 0=function, 1=if branch, 2=while condition, 3=while body,
// 4=defer body, 5=switch arm.  `loops` is the number of enclosing while
// regions, so break/continue remain legal through nested if/switch arms.
fn zir_cf_block(blk:ZBlock,context:i32,loops:i32)i32{
    let errors:i32=0;
    let i:i32=0;
    while(i<blk.ops.len){
        let op:ZOp=blk.ops.data[i];
        let last:i32=((i+1)==blk.ops.len) as i32;
        if(@strEq(op.name,"scf.condition")){
            if(context!=2||last==0){errors=errors+1;}
        }else if(@strEq(op.name,"scf.yield")){
            if(context!=3||last==0){errors=errors+1;}
        }else if(@strEq(op.name,"zag.yield")){
            if(context!=4||last==0){errors=errors+1;}
        }else if(@strEq(op.name,"scf.break")||@strEq(op.name,"scf.continue")){
            if(loops<=0||context==2||context==4){errors=errors+1;}
        }else if(@strEq(op.name,"func.return")){
            if(context==2||context==4){errors=errors+1;}
        }else if(@strEq(op.name,"zag.case")||@strEq(op.name,"zag.default")){
            if(context!=5||i!=0){errors=errors+1;}
            if(@strEq(op.name,"zag.case")&&attr_val(op,"patterns").len==0){errors=errors+1;}
            if(@strEq(op.name,"zag.default")&&op.attrs.len!=0){errors=errors+1;}
        }

        if(@strEq(op.name,"scf.if")){
            if((op.regions.len!=1&&op.regions.len!=2)){errors=errors+1;}
            else{
                let ri:i32=0;while(ri<op.regions.len){
                    let region:ZRegion=op.regions.data[ri];
                    if(region.blocks.len!=1){errors=errors+1;}
                    else{errors=errors+zir_cf_block(region.blocks.data[0],1,loops);}
                    ri=ri+1;
                }
            }
        }else if(@strEq(op.name,"scf.while")){
            if(op.regions.len!=2){errors=errors+1;}
            else{
                let cond:ZRegion=op.regions.data[0];let body:ZRegion=op.regions.data[1];
                if(cond.blocks.len!=1){errors=errors+1;}
                else{errors=errors+zir_cf_block(cond.blocks.data[0],2,loops+1);}
                if(body.blocks.len!=1){errors=errors+1;}
                else{errors=errors+zir_cf_block(body.blocks.data[0],3,loops+1);}
            }
        }else if(@strEq(op.name,"zag.defer")){
            if(op.regions.len!=1){errors=errors+1;}
            else{
                let region:ZRegion=op.regions.data[0];
                if(region.blocks.len!=1){errors=errors+1;}
                else{errors=errors+zir_cf_block(region.blocks.data[0],4,loops);}
            }
        }else if(@strEq(op.name,"zag.switch")){
            if(op.regions.len==0){errors=errors+1;}
            let defaults:i32=0;let ri:i32=0;
            while(ri<op.regions.len){
                let region:ZRegion=op.regions.data[ri];
                if(region.blocks.len!=1||region.blocks.data[0].ops.len==0){errors=errors+1;}
                else{
                    let first:ZOp=region.blocks.data[0].ops.data[0];
                    if(@strEq(first.name,"zag.default")){defaults=defaults+1;}
                    errors=errors+zir_cf_block(region.blocks.data[0],5,loops);
                }
                ri=ri+1;
            }
            if(defaults>1){errors=errors+1;}
        }else if(op.regions.len>0){
            // Unknown region-bearing operations are already rejected by the
            // typed contract pass. Still recurse so malformed markers cannot
            // evade this verifier through an unrecognized wrapper.
            let ri:i32=0;while(ri<op.regions.len){
                let region:ZRegion=op.regions.data[ri];let bi:i32=0;
                while(bi<region.blocks.len){errors=errors+zir_cf_block(region.blocks.data[bi],context,loops);bi=bi+1;}
                ri=ri+1;
            }
        }
        i=i+1;
    }
    return errors;
}

fn zir_verify_control_flow(m:ZModule)i32{
    let errors:i32=0;let fi:i32=0;
    while(fi<m.funcs.len){errors=errors+zir_cf_block(m.funcs.data[fi].body,0,0);fi=fi+1;}
    return errors;
}

fn zir_contract_error(r:*ZirContractReport,reason:[]u8,kind:i32)void{
    r.*.valid=0;r.*.errors=r.*.errors+1;r.*.reason=reason;
    if(kind==1){r.*.type_complete=0;}
    if(kind==2){r.*.effects_complete=0;}
    if(kind==3){r.*.ownership_complete=0;}
    if(kind==4){r.*.alias_complete=0;r.*.lifetime_complete=0;r.*.layout_complete=0;}
    if(kind==5){r.*.origin_complete=0;}
}

fn zir_contract_origin_ok(o:ZOrigin)i32{
    return (o.complete==1&&o.exact==1&&o.module.len>0&&o.line>0&&
        o.byte_start>=0&&o.byte_end>=o.byte_start&&o.stable_id!=0) as i32;
}

fn zir_contract_value(v:ZVal,r:*ZirContractReport)void{
    r.*.checked_values=r.*.checked_values+1;
    if(v.ty.len==0||@strEq(v.ty,"unknown")||@strEq(v.ty,"<unknown>")){
        zir_contract_error(r,"value type is missing or unknown",1);
    }
    if(@strEq(v.ty,"void")){if(v.name.len!=0){zir_contract_error(r,"void value has an SSA name",1);}}
    else if(v.name.len==0){zir_contract_error(r,"non-void value has no SSA name",1);}
    if(@strEq(v.ownership,"unknown")||v.ownership.len==0||
       zir_contract_ownership_valid(v.ownership)==0){
        zir_contract_error(r,"value ownership is unknown",3);
    }
    if(@strEq(v.alias_region,"unknown")||v.alias_region.len==0||
       @strEq(v.lifetime,"unknown")||v.lifetime.len==0||
       @strEq(v.layout,"unknown")||v.layout.len==0||
       zir_contract_alias_valid(v.alias_region)==0||
       zir_contract_lifetime_valid(v.lifetime)==0||
       zir_contract_layout_valid(v.layout)==0){
        zir_contract_error(r,"value alias lifetime or layout is unknown",4);
    }
    if(zir_contract_origin_ok(v.origin)==0){zir_contract_error(r,"value origin is incomplete",5);}
}

fn zir_contract_binary_int(name:[]u8)i32{
    return (@strEq(name,"arith.addi")||@strEq(name,"arith.subi")||
        @strEq(name,"arith.muli")||@strEq(name,"arith.divsi")||
        @strEq(name,"arith.remsi")||@strEq(name,"arith.xori")||
        @strEq(name,"arith.andsi")||@strEq(name,"arith.orsi")||
        @strEq(name,"arith.shli")||@strEq(name,"arith.shrsi")) as i32;
}
fn zir_contract_binary_float(name:[]u8)i32{
    return (@strEq(name,"arith.addf")||@strEq(name,"arith.subf")||
        @strEq(name,"arith.mulf")||@strEq(name,"arith.divf")) as i32;
}
fn zir_contract_float_type(ty:[]u8)i32{
    return (@strEq(ty,"f32")||@strEq(ty,"f64")) as i32;
}
fn zir_contract_binary_bool(name:[]u8)i32{
    return (@strEq(name,"arith.andi")||@strEq(name,"arith.ori")) as i32;
}
fn zir_contract_unary_int(name:[]u8)i32{return @strEq(name,"arith.negsi") as i32;}
fn zir_contract_unary_float(name:[]u8)i32{return @strEq(name,"arith.negf") as i32;}
fn zir_contract_unary_bool(name:[]u8)i32{return @strEq(name,"arith.not") as i32;}
fn zir_contract_cmp_predicate(value:[]u8)i32{
    return (@strEq(value,"eq")||@strEq(value,"ne")||@strEq(value,"slt")||
        @strEq(value,"sle")||@strEq(value,"sgt")||@strEq(value,"sge")) as i32;
}

// Keep the IR contract's effect universe in lock-step with sema.zag:
// Alloc, Panic, IO, Lock, Raises, Unsafe, Atomic, FFI, Device, GPUHost.
// Unknown bits must never become executable authority merely because they fit
// inside an i32 mask.
fn zir_contract_effect_mask_valid(mask:i32)i32{
    return (mask>=0&&(mask&1023)==mask) as i32;
}

fn zir_contract_ownership_valid(value:[]u8)i32{
    return (@strEq(value,"none")||@strEq(value,"ssa")||@strEq(value,"borrowed")||
        @strEq(value,"owned")||@strEq(value,"shared")) as i32;
}
fn zir_contract_alias_valid(value:[]u8)i32{
    return (@strEq(value,"none")||@strEq(value,"param")||@strEq(value,"stack")||
        @strEq(value,"heap")||@strEq(value,"global")) as i32;
}
fn zir_contract_lifetime_valid(value:[]u8)i32{
    return (@strEq(value,"none")||@strEq(value,"statement")||@strEq(value,"function")||
        @strEq(value,"module")||@strEq(value,"static")) as i32;
}
fn zir_contract_layout_valid(value:[]u8)i32{
    return (@strEq(value,"none")||@strEq(value,"declared")||@strEq(value,"target-default")||
        @strEq(value,"packed")||@strEq(value,"aligned")) as i32;
}

// Memory-region labels are part of the typed IR contract, not free-form
// annotations.  Keep the bounded vocabulary in one checker-side function so
// a forged operation cannot smuggle an arbitrary region into a native route.
// `multiple` is reserved for metadata-only aggregation across a pure region;
// individual operations must still bind a concrete region below.
fn zir_contract_access_valid(value:[]u8)i32{
    return (@strEq(value,"none")||@strEq(value,"param")||@strEq(value,"stack")||
        @strEq(value,"heap")||@strEq(value,"global")||@strEq(value,"multiple")) as i32;
}

fn zir_task_attr_exact(o:ZOp,index:i32,key:[]u8,val:[]u8)i32{
    return (index>=0&&index<o.attrs.len&&@strEq(o.attrs.data[index].key,key)&&
        @strEq(o.attrs.data[index].val,val)) as i32;
}

fn zir_contract_task_op(o:ZOp,ret:[]u8,r:*ZirContractReport)void{
    if(@strEq(o.name,"task.abi")){
        if(o.operands.len!=0||o.results.len!=0||o.regions.len!=0||o.attrs.len!=6||
           !@strEq(ret,"i64")||o.effects!=0||!@strEq(o.reads,"none")||!@strEq(o.writes,"none")||
           zir_task_attr_exact(o,0,"abi",zir_task_abi_version())==0||
           zir_task_attr_exact(o,1,"handle_type",zir_task_handle_type())==0||
           zir_task_attr_exact(o,2,"result_type",ret)==0||
           zir_task_attr_exact(o,3,"ownership",zir_task_ownership_mode())==0||
           zir_task_attr_exact(o,4,"cancellation",zir_task_cancellation_mode())==0||
           zir_task_attr_exact(o,5,"scheduler",zir_task_scheduler_mode())==0){
            zir_contract_error(r,"malformed TaskI64 ABI metadata",1);
        }
        return;
    }
    if(@strEq(o.name,"task.spawn")){
        if(o.operands.len>1||o.results.len!=1||o.regions.len!=0||o.attrs.len!=8||
           !@strEq(o.results.data[0].ty,zir_task_handle_type())||
           !@strEq(o.results.data[0].ownership,"owned")||
           !@strEq(o.results.data[0].alias_region,"heap")||
           !@strEq(o.results.data[0].lifetime,"function")||
           !@strEq(o.results.data[0].layout,"target-default")||
           zir_task_attr_exact(o,0,"abi",zir_task_abi_version())==0||
           zir_task_attr_exact(o,1,"handle_type",zir_task_handle_type())==0||
           attr_val(o,"result_type").len==0||
           zir_task_attr_exact(o,3,"ownership","owned")==0||
           zir_task_attr_exact(o,4,"cancellation",zir_task_cancellation_mode())==0||
           zir_task_attr_exact(o,5,"scheduler",zir_task_scheduler_mode())==0||
           attr_val(o,"callee").len==0||
           zir_task_attr_exact(o,7,"consumes","0")==0){
            zir_contract_error(r,"malformed TaskI64 spawn record",1);
        }
        return;
    }
    if(@strEq(o.name,"task.await")||@strEq(o.name,"task.cancel")||@strEq(o.name,"task.join")){
        let expected_consume:[]u8="0";if(!@strEq(o.name,"task.cancel")){expected_consume="1";}
        let valid_handle:i32=0;
        if(o.operands.len==1){let h:ZVal=o.operands.data[0];
            valid_handle=zir_task_handle_compatible(h.ty);
            if(@strEq(h.ty,zir_task_handle_type())&&!@strEq(h.ownership,"owned")){valid_handle=0;}
            if(@strEq(h.ty,"*opaque")&&!(@strEq(h.ownership,"owned")||@strEq(h.ownership,"ssa"))){valid_handle=0;}
        }
        if(o.operands.len!=1||o.results.len!=1||o.regions.len!=0||o.attrs.len!=5||valid_handle==0||
           !@strEq(o.results.data[0].ty,"i64")||
           zir_task_attr_exact(o,0,"abi",zir_task_abi_version())==0||
           zir_task_attr_exact(o,1,"handle_type",zir_task_handle_type())==0||
           zir_task_attr_exact(o,2,"result_type","i64")==0||
           zir_task_attr_exact(o,3,"consumes",expected_consume)==0||
           zir_task_attr_exact(o,4,"cancellation",zir_task_cancellation_mode())==0){
            zir_contract_error(r,"malformed TaskI64 handle operation",1);
        }
        return;
    }
}

fn zir_contract_op(o:ZOp,ret:[]u8,fn_effects:i32,r:*ZirContractReport)void{
    r.*.checked_ops=r.*.checked_ops+1;
    if(zir_contract_origin_ok(o.origin)==0){zir_contract_error(r,"operation origin is incomplete",5);}
    if(zir_contract_effect_mask_valid(o.effects)==0||
       zir_contract_effect_mask_valid(fn_effects)==0||
       (o.effects & fn_effects)!=o.effects){
        zir_contract_error(r,"operation effects exceed function effects",2);
    }
    if(o.reads.len==0||o.writes.len==0||@strEq(o.reads,"unknown")||@strEq(o.writes,"unknown")||
       zir_contract_access_valid(o.reads)==0||zir_contract_access_valid(o.writes)==0){
        zir_contract_error(r,"operation memory effects are unknown",2);
    }
    let i:i32=0;while(i<o.operands.len){zir_contract_value(o.operands.data[i],r);i=i+1;}
    i=0;while(i<o.results.len){zir_contract_value(o.results.data[i],r);i=i+1;}
    if(@strEq(o.name,"error.propagate")){
        let inner:[]u8=zir_error_inner_type(ret);
        if(o.operands.len!=1||o.results.len!=1||o.regions.len!=0||o.attrs.len!=3||
           inner.len==0||!@strEq(o.operands.data[0].ty,ret)||
           !@strEq(o.results.data[0].ty,inner)||
           !@strEq(o.attrs.data[0].key,"error_type")||!@strEq(o.attrs.data[0].val,ret)||
           !@strEq(o.attrs.data[1].key,"result_type")||!@strEq(o.attrs.data[1].val,inner)||
           !@strEq(o.attrs.data[2].key,"propagates")||!@strEq(o.attrs.data[2].val,"1")){
            zir_contract_error(r,"malformed error propagation",1);
        }
    }else if(@strEq(o.name,"task.abi")||@strEq(o.name,"task.spawn")||
       @strEq(o.name,"task.await")||@strEq(o.name,"task.cancel")||@strEq(o.name,"task.join")){
        zir_contract_task_op(o,ret,r);
    }else if(@strEq(o.name,"arith.constant")){
        if(o.operands.len!=0||o.results.len!=1||attr_val(o,"value").len==0){
            zir_contract_error(r,"malformed arithmetic constant",1);
        }
    }else if(zir_contract_unary_float(o.name)==1){
        if(o.operands.len!=1||o.results.len!=1||!@strEq(o.operands.data[0].ty,o.results.data[0].ty)||
           zir_contract_float_type(o.results.data[0].ty)==0){
            zir_contract_error(r,"floating-point unary types do not agree",1);
        }
    }else if(zir_contract_unary_int(o.name)==1){
        if(o.operands.len!=1||o.results.len!=1||
           (!@strEq(o.operands.data[0].ty,"i32")&&!@strEq(o.operands.data[0].ty,"i64"))||
           !@strEq(o.operands.data[0].ty,o.results.data[0].ty)){
            zir_contract_error(r,"integer unary types do not agree",1);
        }
    }else if(zir_contract_unary_bool(o.name)==1){
        if(o.operands.len!=1||o.results.len!=1||!@strEq(o.operands.data[0].ty,"bool")||
           !@strEq(o.results.data[0].ty,"bool")){zir_contract_error(r,"boolean unary types do not agree",1);}
    }else if(zir_contract_binary_int(o.name)==1){
        if(o.operands.len!=2||o.results.len!=1||
           !@strEq(o.operands.data[0].ty,o.operands.data[1].ty)||
           !@strEq(o.operands.data[0].ty,o.results.data[0].ty)||
           ((@strEq(o.name,"arith.xori")||@strEq(o.name,"arith.andsi")||
             @strEq(o.name,"arith.orsi")||@strEq(o.name,"arith.shli")||
             @strEq(o.name,"arith.shrsi"))&&
            !(@strEq(o.results.data[0].ty,"i32")||@strEq(o.results.data[0].ty,"i64")))||
           ((@strEq(o.name,"arith.shli")||@strEq(o.name,"arith.shrsi"))&&
            (o.attrs.len!=1||!@strEq(o.attrs.data[0].key,"width")||
             ((@strEq(o.results.data[0].ty,"i32")&&!@strEq(o.attrs.data[0].val,"32"))||
              (@strEq(o.results.data[0].ty,"i64")&&!@strEq(o.attrs.data[0].val,"64")))))){
            zir_contract_error(r,"integer operation types do not agree",1);
        }
    }else if(zir_contract_binary_float(o.name)==1){
        if(o.operands.len!=2||o.results.len!=1||
           !@strEq(o.operands.data[0].ty,o.operands.data[1].ty)||
           !@strEq(o.operands.data[0].ty,o.results.data[0].ty)||
           zir_contract_float_type(o.results.data[0].ty)==0){
            zir_contract_error(r,"floating-point operation types do not agree",1);
        }
    }else if(zir_contract_binary_bool(o.name)==1){
        if(o.operands.len!=2||o.results.len!=1||!@strEq(o.operands.data[0].ty,"bool")||
           !@strEq(o.operands.data[1].ty,"bool")||!@strEq(o.results.data[0].ty,"bool")){
            zir_contract_error(r,"boolean operation types do not agree",1);
        }
    }else if(@strEq(o.name,"arith.cmpi")){
        if(o.operands.len!=2||o.results.len!=1||!@strEq(o.results.data[0].ty,"bool")||
           !@strEq(o.operands.data[0].ty,o.operands.data[1].ty)||o.attrs.len!=1||
           !@strEq(o.attrs.data[0].key,"predicate")||zir_contract_cmp_predicate(o.attrs.data[0].val)==0){
            zir_contract_error(r,"comparison types do not agree",1);
        }
    }else if(@strEq(o.name,"arith.cmpf")){
        if(o.operands.len!=2||o.results.len!=1||!@strEq(o.results.data[0].ty,"bool")||
           !@strEq(o.operands.data[0].ty,o.operands.data[1].ty)||
           zir_contract_float_type(o.operands.data[0].ty)==0||o.attrs.len!=1||
           !@strEq(o.attrs.data[0].key,"predicate")||zir_contract_cmp_predicate(o.attrs.data[0].val)==0){
            zir_contract_error(r,"floating-point comparison types do not agree",1);
        }
    }else if(@strEq(o.name,"memref.alloca")){
        // The element attribute is part of the ownership/layout boundary,
        // not decorative text. Without this check a forged memref can keep
        // a valid stack-owned result while changing the type that a backend
        // believes it allocated.
        if(o.operands.len!=0||o.results.len!=1||o.attrs.len!=1||
           !@strEq(o.attrs.data[0].key,"elem")||o.results.data[0].ty.len<8||
           o.results.data[0].ty[0]!='m'||!@strEq(o.results.data[0].ownership,"owned")||
           !@strEq(o.results.data[0].alias_region,"stack")||
           !@strEq(o.results.data[0].lifetime,"function")||
           !@strEq(o.results.data[0].layout,"target-default")||
           !@strEq(o.attrs.data[0].val,memref_elem(o.results.data[0].ty))||
           !@strEq(o.writes,"stack")){zir_contract_error(r,"malformed owned stack allocation",3);}
    }else if(@strEq(o.name,"memref.load")){
        // Loads/stores carry an exact element witness. This keeps the typed
        // operation contract tied to the same memref element and alias region
        // that ownership checking validated.
        if(o.operands.len!=1||o.results.len!=1||o.attrs.len!=1||
           !@strEq(o.attrs.data[0].key,"elem")||o.operands.data[0].ty.len<8||
           o.operands.data[0].ty[0]!='m'||!@strEq(memref_elem(o.operands.data[0].ty),o.results.data[0].ty)||
           !@strEq(o.attrs.data[0].val,o.results.data[0].ty)||
           @strEq(o.reads,"none")||!@strEq(o.reads,o.operands.data[0].alias_region)||
           @strEq(o.operands.data[0].alias_region,"none")||
           @strEq(o.operands.data[0].alias_region,"multiple")){
            zir_contract_error(r,"malformed memory load",1);}
    }else if(@strEq(o.name,"memref.store")){
        if(o.operands.len!=2||o.results.len!=0||o.attrs.len!=1||
           !@strEq(o.attrs.data[0].key,"elem")||o.operands.data[1].ty.len<8||
           o.operands.data[1].ty[0]!='m'||!@strEq(memref_elem(o.operands.data[1].ty),o.operands.data[0].ty)||
           !@strEq(o.attrs.data[0].val,o.operands.data[0].ty)||
           @strEq(o.writes,"none")||!@strEq(o.writes,o.operands.data[1].alias_region)||
           @strEq(o.operands.data[1].alias_region,"none")||
           @strEq(o.operands.data[1].alias_region,"multiple")){
            zir_contract_error(r,"malformed memory store",1);}
    }else if(@strEq(o.name,"func.call")){
        if(attr_val(o,"callee").len==0||o.results.len>1){zir_contract_error(r,"malformed function call",1);}
    }else if(@strEq(o.name,"func.return")){
        let error_inner:[]u8=zir_error_inner_type(ret);
        if((@strEq(ret,"void")&&o.operands.len!=0)||
           (!@strEq(ret,"void")&&(o.operands.len!=1||
             (!@strEq(o.operands.data[0].ty,ret)&&
              (error_inner.len==0||!@strEq(o.operands.data[0].ty,error_inner)))))){
            zir_contract_error(r,"return type does not match function",1);
        }
    }else if(@strEq(o.name,"scf.if")){
        if(o.operands.len!=1||!@strEq(o.operands.data[0].ty,"bool")||
           (o.regions.len!=1&&o.regions.len!=2)){zir_contract_error(r,"malformed if region",1);}
    }else if(@strEq(o.name,"scf.while")){
        if(o.regions.len!=2){zir_contract_error(r,"malformed while regions",1);}
    }else if(@strEq(o.name,"scf.condition")){
        if(o.operands.len!=1||!@strEq(o.operands.data[0].ty,"bool")){zir_contract_error(r,"malformed loop condition",1);}
    }else if(@strEq(o.name,"scf.yield")||@strEq(o.name,"scf.break")||
             @strEq(o.name,"scf.continue")||@strEq(o.name,"zag.case")||
             @strEq(o.name,"zag.default")||@strEq(o.name,"zag.yield")){
        if(o.results.len!=0){zir_contract_error(r,"control marker has a result",1);}
    }else if(@strEq(o.name,"zag.string.constant")||@strEq(o.name,"zag.embed.constant")){
        if(o.operands.len!=0||o.results.len!=1||!@strEq(o.results.data[0].ty,"[]u8")){zir_contract_error(r,"malformed byte constant",1);}
    }else if(@strEq(o.name,"zag.null")){
        if(o.operands.len!=0||o.results.len!=1){zir_contract_error(r,"malformed null value",1);}
    }else if(@strEq(o.name,"zag.cast")){
        if(o.operands.len!=1||o.results.len!=1){zir_contract_error(r,"malformed cast",1);}
    }else if(@strEq(o.name,"zag.struct.constant")){
        if(o.operands.len==0||o.results.len!=1){zir_contract_error(r,"malformed struct value",1);}
    }else if(@strEq(o.name,"zag.field")||@strEq(o.name,"zag.index")||@strEq(o.name,"zag.slice")){
        if(o.results.len!=1||o.operands.len==0){zir_contract_error(r,"malformed aggregate access",1);}
    }else if(@strEq(o.name,"zag.defer")){
        if(o.regions.len!=1||o.results.len!=0){zir_contract_error(r,"malformed defer region",1);}
    }else if(@strEq(o.name,"zag.switch")){
        if(o.operands.len!=1||o.regions.len==0){zir_contract_error(r,"malformed switch region",1);}
    }else{
        zir_contract_error(r,"unknown ZIR operation",1);
    }
    let rg:i32=0;while(rg<o.regions.len){let region:ZRegion=o.regions.data[rg];let bi:i32=0;
        while(bi<region.blocks.len){let block:ZBlock=region.blocks.data[bi];let oi:i32=0;
            while(oi<block.ops.len){zir_contract_op(block.ops.data[oi],ret,fn_effects,r);oi=oi+1;}bi=bi+1;}rg=rg+1;}
}

// Resolve calls against declarations represented in this module. Compiler and
// runtime externs are intentionally outside this bounded declaration-bound
// proof domain and retain their separate ABI/runtime validation.
fn zir_contract_fn_index(m:ZModule,name:[]u8)i32{
    let i:i32=0;while(i<m.funcs.len){if(@strEq(m.funcs.data[i].name,name)){return i;}i=i+1;}
    return 0-1;
}
fn zir_contract_call_op(o:ZOp,m:ZModule,r:*ZirContractReport)void{
    if(!@strEq(o.name,"func.call")){return;}
    let name:[]u8=attr_val(o,"callee");let fi:i32=zir_contract_fn_index(m,name);
    if(fi<0){return;}
    let callee:ZFunc=m.funcs.data[fi];
    if(o.operands.len!=callee.params.len){
        zir_contract_error(r,"call argument count does not match declaration",1);
    }
    let i:i32=0;while(i<o.operands.len&&i<callee.params.len){
        if(!@strEq(o.operands.data[i].ty,callee.params.data[i].ty)){
            zir_contract_error(r,"call argument type does not match declaration",1);
        }
        i=i+1;
    }
    if(@strEq(callee.ret,"void")){
        if(o.results.len!=0){zir_contract_error(r,"void call has a result",1);}
    }else if(o.results.len!=1||!@strEq(o.results.data[0].ty,callee.ret)){
        zir_contract_error(r,"call result type does not match declaration",1);
    }
    if((callee.effects & o.effects)!=callee.effects){
        zir_contract_error(r,"call effects exceed caller operation contract",2);
    }
}
fn zir_contract_calls_block(blk:ZBlock,m:ZModule,r:*ZirContractReport)void{
    let i:i32=0;while(i<blk.ops.len){let o:ZOp=blk.ops.data[i];
        zir_contract_call_op(o,m,r);
        let ri:i32=0;while(ri<o.regions.len){let region:ZRegion=o.regions.data[ri];
            let bi:i32=0;while(bi<region.blocks.len){
                zir_contract_calls_block(region.blocks.data[bi],m,r);bi=bi+1;
            }ri=ri+1;
        }i=i+1;
    }
}

fn zir_verify_contracts(m:ZModule)ZirContractReport{
    let report:ZirContractReport=ZirContractReport{.valid=1,.errors=0,.checked_ops=0,.checked_values=0,
        .type_complete=1,.effects_complete=1,.ownership_complete=1,.alias_complete=1,
        .lifetime_complete=1,.layout_complete=1,.origin_complete=1,.reason="typed/effect/ownership contract verified"};
    if(!@strEq(m.schema_version,"zag-ir-v1")||!@strEq(m.transform_version,"zag-transform-v1")||
       m.coverage_complete==0||m.origin_complete==0||m.origin_exact==0){
        zir_contract_error(&report,"module schema coverage or origins are incomplete",1);return report;
    }
    let fi:i32=0;while(fi<m.funcs.len){let f:ZFunc=m.funcs.data[fi];
        if(zir_contract_origin_ok(f.origin)==0){zir_contract_error(&report,"function origin is incomplete",5);}
        if(f.ret.len==0||@strEq(f.ret,"unknown")){zir_contract_error(&report,"function return type is unknown",1);}
        if(zir_contract_effect_mask_valid(f.effects)==0){zir_contract_error(&report,"function effect mask is invalid",2);}
        let pi:i32=0;while(pi<f.params.len){zir_contract_value(f.params.data[pi],&report);pi=pi+1;}
        let oi:i32=0;while(oi<f.body.ops.len){zir_contract_op(f.body.ops.data[oi],f.ret,f.effects,&report);oi=oi+1;}
        zir_contract_calls_block(f.body,m,&report);
        fi=fi+1;
    }
    let control_errors:i32=zir_verify_control_flow(m);
    if(control_errors>0){
        report.valid=0;report.errors=report.errors+control_errors;
        report.type_complete=0;report.reason="structured control-flow invariants failed";
    }
    if(report.errors>0){report.reason="one or more ZIR contract invariants failed";}
    return report;
}

// ── test-only checked transform contract: const-i32-add-v1 ─────────────────
// This is intentionally one bounded rule contract, not a general optimizer.
// The public production preparation still never calls the producer. A separate
// source/policy-bound seam can select it only after the checker re-resolves an
// exact source context and independently supplied compiler policy; verified raw
// ZIR remains the fallback for every rejected or absent fact.
fn zir_transform_policy_const_i32_add_default()ZirTransformPolicy{
    return ZirTransformPolicy{.target=zir_transform_target_linux_x86_64(),
        .edition=zir_transform_edition_regular(),
        .arithmetic=zir_transform_arithmetic_i32_wrap(),.safety_checked=0,
        .sanitize_memory=0,.automatic_selection=1};
}
fn zir_transform_policy_none()ZirTransformPolicy{
    return ZirTransformPolicy{.target="",.edition="",.arithmetic="",
        .safety_checked=0,.sanitize_memory=0,.automatic_selection=0};
}
fn zir_transform_policy_const_i32_add_allowed(p:ZirTransformPolicy)i32{
    return (@strEq(p.target,zir_transform_target_linux_x86_64())&&
        @strEq(p.edition,zir_transform_edition_regular())&&
        @strEq(p.arithmetic,zir_transform_arithmetic_i32_wrap())&&
        p.safety_checked==0&&p.sanitize_memory==0&&p.automatic_selection==1) as i32;
}
fn zir_transform_policy_const_i64_add_default()ZirTransformPolicy{
    return ZirTransformPolicy{.target=zir_transform_target_linux_x86_64(),
        .edition=zir_transform_edition_regular(),
        .arithmetic=zir_transform_arithmetic_i64_defined(),.safety_checked=0,
        .sanitize_memory=0,.automatic_selection=1};
}
fn zir_transform_policy_const_i64_add_allowed(p:ZirTransformPolicy)i32{
    return (@strEq(p.target,zir_transform_target_linux_x86_64())&&
        @strEq(p.edition,zir_transform_edition_regular())&&
        @strEq(p.arithmetic,zir_transform_arithmetic_i64_defined())&&
        p.safety_checked==0&&p.sanitize_memory==0&&p.automatic_selection==1) as i32;
}
fn zir_transform_policy_const_bool_cmp_default()ZirTransformPolicy{
    return ZirTransformPolicy{.target=zir_transform_target_linux_x86_64(),
        .edition=zir_transform_edition_regular(),
        .arithmetic=zir_transform_arithmetic_bool_predicate(),.safety_checked=0,
        .sanitize_memory=0,.automatic_selection=1};
}
fn zir_transform_policy_const_bool_cmp_allowed(p:ZirTransformPolicy)i32{
    return (@strEq(p.target,zir_transform_target_linux_x86_64())&&
        @strEq(p.edition,zir_transform_edition_regular())&&
        @strEq(p.arithmetic,zir_transform_arithmetic_bool_predicate())&&
        p.safety_checked==0&&p.sanitize_memory==0&&p.automatic_selection==1) as i32;
}

fn zir_origin_equal(a:ZOrigin,b:ZOrigin)i32{
    return (@strEq(a.module,b.module)&&a.line==b.line&&a.byte_start==b.byte_start&&
        a.byte_end==b.byte_end&&a.stable_id==b.stable_id&&a.complete==b.complete&&
        a.exact==b.exact) as i32;
}
fn zir_value_equal(a:ZVal,b:ZVal)i32{
    return (@strEq(a.name,b.name)&&@strEq(a.ty,b.ty)&&@strEq(a.ownership,b.ownership)&&
        @strEq(a.alias_region,b.alias_region)&&@strEq(a.lifetime,b.lifetime)&&
        @strEq(a.layout,b.layout)&&zir_origin_equal(a.origin,b.origin)==1) as i32;
}
fn zir_attr_equal(a:ZAttr,b:ZAttr)i32{
    return (@strEq(a.key,b.key)&&@strEq(a.val,b.val)) as i32;
}
fn zir_block_equal(a:ZBlock,b:ZBlock)i32{
    if(a.ops.len!=b.ops.len){return 0;}let i:i32=0;
    while(i<a.ops.len){if(zir_op_equal(a.ops.data[i],b.ops.data[i])==0){return 0;}i=i+1;}
    return 1;
}
fn zir_region_equal(a:ZRegion,b:ZRegion)i32{
    if(a.blocks.len!=b.blocks.len){return 0;}let i:i32=0;
    while(i<a.blocks.len){if(zir_block_equal(a.blocks.data[i],b.blocks.data[i])==0){return 0;}i=i+1;}
    return 1;
}
fn zir_op_equal(a:ZOp,b:ZOp)i32{
    if(!@strEq(a.name,b.name)||a.effects!=b.effects||!@strEq(a.reads,b.reads)||
       !@strEq(a.writes,b.writes)||zir_origin_equal(a.origin,b.origin)==0||
       a.results.len!=b.results.len||a.operands.len!=b.operands.len||
       a.attrs.len!=b.attrs.len||a.regions.len!=b.regions.len){return 0;}
    let i:i32=0;while(i<a.results.len){if(zir_value_equal(a.results.data[i],b.results.data[i])==0){return 0;}i=i+1;}
    i=0;while(i<a.operands.len){if(zir_value_equal(a.operands.data[i],b.operands.data[i])==0){return 0;}i=i+1;}
    i=0;while(i<a.attrs.len){if(zir_attr_equal(a.attrs.data[i],b.attrs.data[i])==0){return 0;}i=i+1;}
    i=0;while(i<a.regions.len){if(zir_region_equal(a.regions.data[i],b.regions.data[i])==0){return 0;}i=i+1;}
    return 1;
}
fn zir_function_meta_equal(a:ZFunc,b:ZFunc)i32{
    if(!@strEq(a.name,b.name)||!@strEq(a.ret,b.ret)||a.effects!=b.effects||
       zir_origin_equal(a.origin,b.origin)==0||a.coverage_complete!=b.coverage_complete||
       a.coverage_errors!=b.coverage_errors||a.params.len!=b.params.len){return 0;}
    let i:i32=0;while(i<a.params.len){if(zir_value_equal(a.params.data[i],b.params.data[i])==0){return 0;}i=i+1;}
    return 1;
}
fn zir_function_equal(a:ZFunc,b:ZFunc)i32{
    return (zir_function_meta_equal(a,b)==1&&zir_block_equal(a.body,b.body)==1) as i32;
}
fn zir_module_equal(a:ZModule,b:ZModule)i32{
    if(!@strEq(a.schema_version,b.schema_version)||!@strEq(a.transform_version,b.transform_version)||
       a.coverage_complete!=b.coverage_complete||a.coverage_errors!=b.coverage_errors||
       a.origin_complete!=b.origin_complete||a.origin_exact!=b.origin_exact||
       a.funcs.len!=b.funcs.len){return 0;}
    let i:i32=0;while(i<a.funcs.len){if(zir_function_equal(a.funcs.data[i],b.funcs.data[i])==0){return 0;}i=i+1;}
    return 1;
}
fn zir_module_equal_except_top_op(a:ZModule,b:ZModule,fi:i32,oi:i32)i32{
    if(!@strEq(a.schema_version,b.schema_version)||!@strEq(a.transform_version,b.transform_version)||
       a.coverage_complete!=b.coverage_complete||a.coverage_errors!=b.coverage_errors||
       a.origin_complete!=b.origin_complete||a.origin_exact!=b.origin_exact||
       a.funcs.len!=b.funcs.len){return 0;}
    let i:i32=0;while(i<a.funcs.len){
        if(i!=fi){if(zir_function_equal(a.funcs.data[i],b.funcs.data[i])==0){return 0;}}
        else{let af:ZFunc=a.funcs.data[i];let bf:ZFunc=b.funcs.data[i];
            if(zir_function_meta_equal(af,bf)==0||af.body.ops.len!=bf.body.ops.len){return 0;}
            let j:i32=0;while(j<af.body.ops.len){if(j!=oi&&zir_op_equal(af.body.ops.data[j],bf.body.ops.data[j])==0){return 0;}j=j+1;}}
        i=i+1;
    }
    return 1;
}

// Candidate arrays and text are owned separately from raw ZIR, so corrupting a
// proposal cannot corrupt the fallback module through shared storage.
fn zir_clone_text(s:[]u8)[]u8{
    if(s.len==0){return "";}let out:ArrayList[u8]=make[u8](s.len);let i:i32=0;
    while(i<s.len){push[u8](&out,s[i]);i=i+1;}return out.data[0..out.len];
}
fn zir_clone_origin(o:ZOrigin)ZOrigin{return ZOrigin{.module=zir_clone_text(o.module),
    .line=o.line,.byte_start=o.byte_start,.byte_end=o.byte_end,.stable_id=o.stable_id,
    .complete=o.complete,.exact=o.exact};}
fn zir_clone_value(v:ZVal)ZVal{return ZVal{.name=zir_clone_text(v.name),.ty=zir_clone_text(v.ty),
    .ownership=zir_clone_text(v.ownership),.alias_region=zir_clone_text(v.alias_region),
    .lifetime=zir_clone_text(v.lifetime),.layout=zir_clone_text(v.layout),.origin=zir_clone_origin(v.origin)};}
fn zir_clone_attr(a:ZAttr)ZAttr{return ZAttr{.key=zir_clone_text(a.key),.val=zir_clone_text(a.val)};}
fn zir_clone_block(blk:ZBlock)ZBlock{
    let out:ZBlock=ZBlock{.ops=make[ZOp](blk.ops.len)};let i:i32=0;
    while(i<blk.ops.len){push[ZOp](&out.ops,zir_clone_op(blk.ops.data[i]));i=i+1;}return out;
}
fn zir_clone_region(region:ZRegion)ZRegion{
    let out:ZRegion=ZRegion{.blocks=make[ZBlock](region.blocks.len)};let i:i32=0;
    while(i<region.blocks.len){push[ZBlock](&out.blocks,zir_clone_block(region.blocks.data[i]));i=i+1;}return out;
}
fn zir_clone_op(op:ZOp)ZOp{
    let out:ZOp=ZOp{.name=zir_clone_text(op.name),.results=make[ZVal](op.results.len),
        .operands=make[ZVal](op.operands.len),.attrs=make[ZAttr](op.attrs.len),
        .regions=make[ZRegion](op.regions.len),.effects=op.effects,
        .reads=zir_clone_text(op.reads),.writes=zir_clone_text(op.writes),
        .origin=zir_clone_origin(op.origin)};
    let i:i32=0;while(i<op.results.len){push[ZVal](&out.results,zir_clone_value(op.results.data[i]));i=i+1;}
    i=0;while(i<op.operands.len){push[ZVal](&out.operands,zir_clone_value(op.operands.data[i]));i=i+1;}
    i=0;while(i<op.attrs.len){push[ZAttr](&out.attrs,zir_clone_attr(op.attrs.data[i]));i=i+1;}
    i=0;while(i<op.regions.len){push[ZRegion](&out.regions,zir_clone_region(op.regions.data[i]));i=i+1;}
    return out;
}
fn zir_clone_function(f:ZFunc)ZFunc{
    let params:ArrayList[ZVal]=make[ZVal](f.params.len);let i:i32=0;
    while(i<f.params.len){push[ZVal](&params,zir_clone_value(f.params.data[i]));i=i+1;}
    return ZFunc{.name=zir_clone_text(f.name),.params=params,.ret=zir_clone_text(f.ret),
        .body=zir_clone_block(f.body),.effects=f.effects,.origin=zir_clone_origin(f.origin),
        .coverage_complete=f.coverage_complete,.coverage_errors=f.coverage_errors};
}
fn zir_clone_module(m:ZModule)ZModule{
    let funcs:ArrayList[ZFunc]=make[ZFunc](m.funcs.len);let i:i32=0;
    while(i<m.funcs.len){push[ZFunc](&funcs,zir_clone_function(m.funcs.data[i]));i=i+1;}
    return ZModule{.funcs=funcs,.schema_version=zir_clone_text(m.schema_version),
        .transform_version=zir_clone_text(m.transform_version),
        .coverage_complete=m.coverage_complete,.coverage_errors=m.coverage_errors,
        .origin_complete=m.origin_complete,.origin_exact=m.origin_exact};
}

fn zir_origin_rule_usable(o:ZOrigin)i32{
    return (o.complete==1&&o.exact==1&&o.stable_id!=0&&o.module.len>0&&o.line>0&&
        o.byte_start>=0&&o.byte_end>=o.byte_start) as i32;
}
fn zir_count_ssa_block(blk:ZBlock,name:[]u8)i32{
    let count:i32=0;let i:i32=0;while(i<blk.ops.len){let op:ZOp=blk.ops.data[i];
        let j:i32=0;while(j<op.results.len){if(@strEq(op.results.data[j].name,name)){count=count+1;}j=j+1;}
        let r:i32=0;while(r<op.regions.len){let b:i32=0;while(b<op.regions.data[r].blocks.len){
            count=count+zir_count_ssa_block(op.regions.data[r].blocks.data[b],name);b=b+1;}r=r+1;}i=i+1;}
    return count;
}
fn zir_count_ssa_function(f:ZFunc,name:[]u8)i32{
    let count:i32=zir_count_ssa_block(f.body,name);let i:i32=0;
    while(i<f.params.len){if(@strEq(f.params.data[i].name,name)){count=count+1;}i=i+1;}return count;
}
// Count every definition once, then check the same table.  The previous
// implementation called zir_count_ssa_function for every result, repeatedly
// walking the complete function and turning large self-hosting modules into
// an accidental quadratic (or worse with nested regions) verifier workload.
fn zir_ssa_count_block(blk:ZBlock,counts:*map.StringMap[i32]) void {
    let i:i32=0;
    while(i<blk.ops.len){
        let op:ZOp=blk.ops.data[i];let r:i32=0;
        while(r<op.results.len){
            let name:[]u8=op.results.data[r].name;
            let old:i32=map.get[i32](counts.*,name) orelse 0;
            map.put[i32](counts,name,old+1);r=r+1;
        }
        let g:i32=0;while(g<op.regions.len){let b:i32=0;
            while(b<op.regions.data[g].blocks.len){
                zir_ssa_count_block(op.regions.data[g].blocks.data[b],counts);b=b+1;
            }g=g+1;
        }
        i=i+1;
    }
}
fn zir_ssa_check_block(blk:ZBlock,counts:map.StringMap[i32])i32{
    let i:i32=0;while(i<blk.ops.len){
        let op:ZOp=blk.ops.data[i];let r:i32=0;
        while(r<op.results.len){
            let name:[]u8=op.results.data[r].name;
            if(name.len==0||(map.get[i32](counts,name) orelse 0)!=1){return 0;}r=r+1;
        }
        let g:i32=0;while(g<op.regions.len){let b:i32=0;
            while(b<op.regions.data[g].blocks.len){
                if(zir_ssa_check_block(op.regions.data[g].blocks.data[b],counts)==0){return 0;}b=b+1;
            }g=g+1;
        }
        i=i+1;
    }
    return 1;
}
fn zir_function_ssa_unique_all(f:ZFunc)i32{
    let counts:map.StringMap[i32]=map.make[i32](32);let i:i32=0;
    while(i<f.params.len){
        let name:[]u8=f.params.data[i].name;
        if(name.len==0){map.free[i32](&counts);return 0;}
        let old:i32=map.get[i32](counts,name) orelse 0;
        map.put[i32](&counts,name,old+1);i=i+1;
    }
    zir_ssa_count_block(f.body,&counts);
    let ok:i32=zir_ssa_check_block(f.body,counts);
    if(ok==1){let p:i32=0;while(p<f.params.len){
        if((map.get[i32](counts,f.params.data[p].name) orelse 0)!=1){map.free[i32](&counts);return 0;}
        p=p+1;
    }}
    map.free[i32](&counts);return ok;
}
// Retain the block-shaped helper for focused verifier tests.  It builds one
// count table for the containing function and checks only the requested block.
fn zir_block_ssa_unique_all(blk:ZBlock,f:ZFunc)i32{
    let counts:map.StringMap[i32]=map.make[i32](32);let p:i32=0;
    while(p<f.params.len){let name:[]u8=f.params.data[p].name;
        let old:i32=map.get[i32](counts,name) orelse 0;map.put[i32](&counts,name,old+1);p=p+1;}
    zir_ssa_count_block(f.body,&counts);let ok:i32=zir_ssa_check_block(blk,counts);
    map.free[i32](&counts);return ok;
}
fn zir_module_ssa_unique_all(m:ZModule)i32{
    let i:i32=0;while(i<m.funcs.len){if(zir_function_ssa_unique_all(m.funcs.data[i])==0){return 0;}i=i+1;}
    return 1;
}

struct ZirI32Literal { value:i64, valid:i32 }
struct ZirConstMatch { index:i32, value:i64, valid:i32 }

// Producer-side canonical parser. It never performs signed i64 overflow.
fn ztp_parse_i32(text:[]u8)ZirI32Literal{
    let bad:ZirI32Literal=ZirI32Literal{.value=0,.valid=0};if(text.len==0){return bad;}
    let negative:i32=(text[0]=='-') as i32;let at:i32=negative;
    if(at>=text.len||text[at]=='+'){return bad;}
    if(text[at]=='0'&&(at+1<text.len||negative==1)){return bad;}
    let magnitude:i64=0;while(at<text.len){let ch:u8=text[at];if(ch<'0'||ch>'9'){return bad;}
        magnitude=magnitude*10+((ch as i64)-48);if(magnitude>2147483648){return bad;}at=at+1;}
    if(negative==1){return ZirI32Literal{.value=0-magnitude,.valid=1};}
    if(magnitude>2147483647){return bad;}return ZirI32Literal{.value=magnitude,.valid=1};
}
fn ztp_const_shape(op:ZOp,want:ZVal)ZirI32Literal{
    let bad:ZirI32Literal=ZirI32Literal{.value=0,.valid=0};
    if(!@strEq(op.name,"arith.constant")||op.results.len!=1||op.operands.len!=0||
       op.attrs.len!=1||op.regions.len!=0||op.effects!=0||!@strEq(op.reads,"none")||
       !@strEq(op.writes,"none")||!@strEq(op.attrs.data[0].key,"value")||
       !@strEq(op.results.data[0].ty,"i32")||zir_value_equal(op.results.data[0],want)==0||
       zir_origin_rule_usable(op.origin)==0||zir_origin_rule_usable(op.results.data[0].origin)==0){return bad;}
    return ztp_parse_i32(op.attrs.data[0].val);
}
fn ztp_prior_constant(blk:ZBlock,before:i32,want:ZVal)ZirConstMatch{
    let found:i32=0;let index:i32=0-1;let value:i64=0;let i:i32=0;
    while(i<before){let op:ZOp=blk.ops.data[i];let r:i32=0;
        while(r<op.results.len){if(@strEq(op.results.data[r].name,want.name)){
            found=found+1;if(r!=0){return ZirConstMatch{.index=0-1,.value=0,.valid=0};}
            let parsed:ZirI32Literal=ztp_const_shape(op,want);if(parsed.valid==0){return ZirConstMatch{.index=0-1,.value=0,.valid=0};}
            index=i;value=parsed.value;}r=r+1;}i=i+1;}
    return ZirConstMatch{.index=index,.value=value,.valid=(found==1) as i32};
}
fn ztp_wrap_i32_add(a:i64,b:i64)i64{
    let sum:i64=a+b;if(sum>2147483647){return sum-4294967296;}
    if(sum<(0-2147483648)){return sum+4294967296;}return sum;
}
fn zir_no_transform_proposal(raw:ZModule)ZirTransformProposal{
    // The selector never consults a candidate when proposed=0. Keep a distinct
    // empty sentinel instead of aliasing raw or leaking an unused full clone on
    // every production build/view.
    let no_funcs:ArrayList[ZFunc]=ArrayList[ZFunc]{.data=0 as *ZFunc,.len=0,.cap=0};
    let empty:ZModule=ZModule{.funcs=no_funcs,.schema_version="",
        .transform_version="",.coverage_complete=0,.coverage_errors=0,
        .origin_complete=0,.origin_exact=0};
    return ZirTransformProposal{.candidate=empty,
        .certificate=zir_transform_certificate_none(),.proposed=0};
}

// Script source is wrapped in three compiler-owned functions before it reaches
// ZIR.  Those wrappers intentionally carry runtime effects and incomplete
// origins, so the whole module cannot satisfy the ordinary complete-module
// transform domain.  Keep a separate, exact envelope for the one bounded
// source rule: every compiler wrapper must have its v1 ABI/coverage shape, and
// every user function must still be complete, effect-free, and source-bound.
// This is not a general exemption for incomplete IR; a forged or partially
// lowered user function remains outside the producer and checker domains.
fn zir_script_generated_envelope(m:ZModule)i32{
    if(!@strEq(m.schema_version,"zag-ir-v1")||
       !@strEq(m.transform_version,"zag-transform-v1")||
       m.coverage_complete!=0||m.origin_complete!=0||m.origin_exact!=0||
       m.funcs.len<4){return 0;}
    let uncaught:i32=0;let body:i32=0;let main:i32=0;let user:i32=0;
    let wrapper_errors:i32=0;let i:i32=0;
    while(i<m.funcs.len){let f:ZFunc=m.funcs.data[i];
        if(@strEq(f.name,"__zag_compiler_script_uncaught_7f3a")){
            if(uncaught==1||f.params.len!=1||!@strEq(f.ret,"i32")||f.effects!=5||
               f.coverage_complete!=0||f.coverage_errors!=4||f.body.ops.len!=8||
               f.origin.complete!=0||f.origin.exact!=0||f.origin.stable_id!=0||
               !@strEq(f.params.data[0].ty,"i32")){return 0;}
            uncaught=1;wrapper_errors=wrapper_errors+f.coverage_errors;
        }else if(@strEq(f.name,"__zag_compiler_script_body_7f3a")){
            if(body==1||f.params.len!=1||!@strEq(f.ret,"!i32")||f.effects!=16||
               f.coverage_complete!=1||f.coverage_errors!=0||f.body.ops.len<1||
               f.origin.complete!=0||f.origin.exact!=0||f.origin.stable_id!=0||
               !@strEq(f.params.data[0].ty,"*opaque")){return 0;}
            body=1;
        }else if(@strEq(f.name,"main")){
            if(main==1||f.params.len!=0||!@strEq(f.ret,"i32")||f.effects!=23||
               f.coverage_complete!=0||f.coverage_errors!=9||f.body.ops.len!=11||
               f.origin.complete!=0||f.origin.exact!=0||f.origin.stable_id!=0){return 0;}
            main=1;wrapper_errors=wrapper_errors+f.coverage_errors;
        }else{
            user=user+1;
