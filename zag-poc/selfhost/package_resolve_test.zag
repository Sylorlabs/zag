@import("package_resolve.zag")

extern fn _zag_allocator_live_bytes() i64

fn package_test(condition: i32, name: []u8, failures: *i32) void {
    if (condition != 0) {
        _zag_print("ok  "); _zag_println(name);
    } else {
        failures.* = failures.* + 1;
        _zag_print("FAIL "); _zag_println(name);
    }
}

fn main() i32 {
    let failures: i32 = 0;
    let base: []u8 = "tests/package_resolution/workspace/consumer/src";
    let resolved: PackageImportResolution = package_import_resolve(
        "pkg:toolkit/src/toolkit.zag", base);
    package_test(resolved.matched == 1 && resolved.error == PackageImportError.none &&
        resolved.manifest_source_owned == 1 &&
        package_import_starts_with(resolved.manifest_source,
            "name = \"package-resolution-consumer\"") == 1 &&
        package_import_starts_with(resolved.path,
            "tests/package_resolution/workspace/consumer/../toolkit/src/toolkit.zag") == 1,
        "declared sibling path retains the exact nearest manifest snapshot", &failures);
    package_import_resolution_release(&resolved);
    package_import_resolution_release(&resolved);
    package_test(resolved.manifest_source_owned == 0 &&
        resolved.lockfile_source_owned == 0,
        "successful local result release is idempotent", &failures);

    let absent: PackageImportResolution = package_import_resolve(
        "pkg:absent/src/toolkit.zag", base);
    package_test(absent.error == PackageImportError.dependency_not_found,
        "undeclared dependency fails closed", &failures);
    package_import_resolution_release(&absent);

    let traversal: PackageImportResolution = package_import_resolve(
        "pkg:toolkit/../consumer/src/main.zag", base);
    package_test(traversal.error == PackageImportError.invalid_specifier,
        "module traversal fails before filesystem resolution", &failures);
    package_import_resolution_release(&traversal);

    let release_live_before:i64=_zag_allocator_live_bytes();
    let unmatched:PackageImportResolution=package_import_resolve(
        "std:toolkit",".");
    package_import_resolution_release(&unmatched);
    package_import_resolution_release(&unmatched);
    let invalid:PackageImportResolution=package_import_resolve("pkg:toolkit",".");
    package_import_resolution_release(&invalid);
    package_import_resolution_release(&invalid);
    let empty_owned:PackageImportResolution=package_import_result("pkg:empty/x.zag");
    empty_owned.manifest_source=_zag_read_file("/dev/null");
    empty_owned.lockfile_source=_zag_read_file("/dev/null");
    if(empty_owned.manifest_source.len>=0){empty_owned.manifest_source_owned=1;}
    if(empty_owned.lockfile_source.len>=0){empty_owned.lockfile_source_owned=1;}
    let empty_reads_ok:i32=(empty_owned.manifest_source.len==0&&
        empty_owned.lockfile_source.len==0) as i32;
    package_import_resolution_release(&empty_owned);
    package_import_resolution_release(&empty_owned);
    package_test(empty_reads_ok==1&&
        _zag_allocator_live_bytes()==release_live_before,
        "unmatched invalid and owned empty manifest/lock results release exactly once",
        &failures);

    let duplicate: PackageManifestDependency = package_manifest_dependency(
        "[deps]\nkit = { path = \"../one\" }\nkit = { path = \"../two\" }\n",
        "kit");
    package_test(duplicate.valid == 1 && duplicate.count == 2,
        "duplicate dependency declarations remain visible to fail-closed resolution",
        &failures);

    package_test(package_import_local_path_safe("../toolkit") == 1,
        "parent-relative ordinary local dependency path remains supported", &failures);
    package_test(package_import_local_path_safe("/tmp/toolkit") == 0,
        "absolute dependency paths fail closed", &failures);
    package_test(package_import_local_path_safe("~/toolkit") == 0,
        "home-expanded dependency paths fail closed", &failures);
    package_test(package_import_local_path_safe("git@host:toolkit") == 0,
        "scp-like dependency paths fail closed", &failures);
    package_test(package_import_local_path_safe("..\\toolkit") == 0,
        "backslash dependency paths fail closed", &failures);
    package_test(package_import_local_path_safe("https://example.com/kit") == 0,
        "URL dependency paths fail closed", &failures);
    package_test(package_import_sibling_path_safe("../toolkit") == 1 &&
        package_import_sibling_path_safe("../../toolkit") == 0 &&
        package_import_sibling_path_safe("../toolkit/detail") == 0 &&
        package_import_sibling_path_safe("./toolkit") == 0 &&
        package_import_sibling_path_safe("vendor/toolkit") == 0,
        "sibling roots require exactly one parent-relative safe-name segment",
        &failures);

    package_test(package_import_vendor_path_safe("vendor/toolkit") == 1 &&
        package_import_vendor_path_safe("vendor/../toolkit") == 0 &&
        package_import_vendor_path_safe("../vendor/toolkit") == 0,
        "vendor roots are explicit and traversal-free", &failures);
    package_test(package_import_vendor_table_valid(
        "{ path = \"vendor/toolkit\", mode = \"vendor\" }") == 1 &&
        package_import_vendor_table_valid(
        "{ path = \"vendor/toolkit\", mode = \"vendor\", future = \"x\" }") == 0 &&
        package_import_vendor_table_valid(
        "{ path = \"vendor/toolkit\", mode = \"vendor\", mode = \"vendor\" }") == 0,
        "vendor manifest subset rejects unknown and duplicate fields", &failures);
    package_test(package_import_sibling_table_valid(
        "{ path = \"../toolkit\", mode = \"sibling\" }") == 1 &&
        package_import_sibling_table_valid(
        "{ path = \"../toolkit\", mode = \"vendor\" }") == 0 &&
        package_import_sibling_table_valid(
        "{ path = \"../../toolkit\", mode = \"sibling\" }") == 0 &&
        package_import_sibling_table_valid(
        "{ path = \"../toolkit\", mode = \"sibling\", future = \"x\" }") == 0,
        "sibling lock manifest subset accepts only the explicit bounded mode", &failures);
    package_test(package_lock_checksum("1,2,3").valid == 1 &&
        package_lock_checksum("01,2,3").valid == 0 &&
        package_lock_checksum("1,2,8388609").valid == 0,
        "lock checksums use bounded canonical decimal fields", &failures);

    package_test(package_semver_parse("1.2.3").valid == 1 &&
        package_semver_parse("1.2.3").major == 1 &&
        package_semver_parse("1.2.3").minor == 2 &&
        package_semver_parse("1.2.3").patch == 3 &&
        package_semver_parse("01.2.3").valid == 0 &&
        package_semver_parse("1.2").valid == 0,
        "dependency versions require canonical major.minor.patch triples", &failures);
    package_test(package_version_satisfies("1.2.3", "1.2.3") == 1 &&
        package_version_satisfies("1.2.3", "1.2.4") == 0 &&
        package_version_satisfies("^1.2.3", "1.9.0") == 1 &&
        package_version_satisfies("^1.2.3", "2.0.0") == 0 &&
        package_version_satisfies("~1.2.3", "1.2.9") == 1 &&
        package_version_satisfies("~1.2.3", "1.3.0") == 0,
        "exact caret and tilde requirements use deterministic bounded ranges", &failures);
    package_test(package_manifest_version_conflict(
        "[deps]\na = { path = \"../toolkit\", version = \"1.4.2\" }\nb = { path = \"../toolkit\", version = \"2.0.0\" }\n") == 1 &&
        package_manifest_version_conflict(
        "[deps]\na = { path = \"../toolkit\", version = \"^1.2.3\" }\nb = { path = \"../toolkit\", version = \"~1.4.0\" }\n") == 0,
        "same-root exact version conflicts fail closed while overlapping ranges remain compatible", &failures);
    package_test(package_version_requirements_compatible("^1.2.3", "~1.4.0") == 1 &&
        package_version_requirements_compatible("^1.2.3", "~2.0.0") == 0 &&
        package_version_requirements_compatible("~1.2.3", "~1.3.0") == 0 &&
        package_version_requirements_compatible("^0.2.3", "~0.2.9") == 1,
        "caret and tilde intervals reject provably disjoint range pairs", &failures);

    // Exercise the shared registry selector with converging graph edges.
    // The checksum is generated from the exact canonical index body so this
    // test covers the same validation boundary used by the foreground
    // resolver, rather than a hand-built unchecked fixture.
    let registry_body:[]u8="format=zag-registry-index-v1\nauthority=local-file-v1\nsignature=none\nentry=alpha\t1.0.0\tsrc/alpha-1.zag\t1,2,3\nentry=alpha\t1.2.0\tsrc/alpha-2.zag\t4,5,6\nentry=alpha\t2.0.0\tsrc/alpha-2.zag\t7,8,9\n";
    let registry_sum:PackageRawChecksum=package_raw_checksum(registry_body);
    let registry_sum_text:[]u8=_zag_str_concat(_zag_i64_to_str(registry_sum.first),
        _zag_str_concat(",",_zag_str_concat(_zag_i64_to_str(registry_sum.second),
        _zag_str_concat(",",_zag_i64_to_str(registry_sum.bytes)))));
    let registry_index:[]u8=_zag_str_concat(registry_body,
        _zag_str_concat("checksum=",_zag_str_concat(registry_sum_text,"\n")));
    package_test(package_registry_index_valid_local(registry_index)==1 &&
        package_registry_index_select_all(registry_index,"alpha",
            "^1.0.0\n~1.2.0",0).found==1 &&
        @strEq(package_registry_index_select_all(registry_index,"alpha",
            "^1.0.0\n~1.2.0",0).version,"1.2.0"),
        "registry selector chooses one highest version satisfying every edge", &failures);
    package_test(package_registry_index_select_all(registry_index,"alpha",
        "^1.0.0\n^2.0.0",0).found==0 &&
        package_registry_index_select_all(registry_index,"alpha",
        "^1.0.0\n^2.0.0",0).error==PackageImportError.dependency_version_mismatch,
        "registry selector rejects incompatible converging requirements", &failures);
    package_test(package_registry_index_select_all(registry_index,"alpha",
        "^1.0.0\n",0).error==PackageImportError.invalid_lockfile,
        "registry selector rejects an incomplete requirement set", &failures);
    _zag_str_free(registry_index);_zag_str_free(registry_sum_text);
    let versioned:PackageManifestDependency=package_manifest_dependency(
        "[deps]\nkit = { path = \"../one\", version = \"^1.2.3\" }\n", "kit");
    package_test(versioned.valid == 1 && versioned.count == 1 &&
        @strEq(versioned.version, "^1.2.3") &&
        package_import_vendor_table_valid(
            "{ path = \"vendor/kit\", mode = \"vendor\", version = \"~1.2.3\" }") == 1 &&
        package_import_vendor_table_valid(
            "{ path = \"vendor/kit\", mode = \"vendor\", version = \"1.2\" }") == 0,
        "manifest and vendor tables retain only valid version requirements", &failures);
    package_test(@strEq(package_manifest_project_version(
        "name = \"kit\"\nversion = \"1.4.2\"\nedition = \"2026\"\n"), "1.4.2") &&
        @strEq(package_manifest_project_version(
        "name = \"kit\"\nversion = \"0\"\n"), "0") &&
        @strEq(package_manifest_project_version(
        "version = \"1.0.0\"\nversion = \"1.0.1\"\n"), ""),
        "dependency root version is read from its own top-level manifest", &failures);
    let mismatch:PackageImportResolution=package_import_resolve(
        "pkg:toolkit/src/toolkit.zag",
        "tests/package_resolution/workspace/version_mismatch/src");
    package_test(mismatch.error == PackageImportError.dependency_version_mismatch &&
        mismatch.manifest.len > 0 && mismatch.manifest_source_owned == 0,
        "on-disk dependency version mismatch fails before module resolution", &failures);
    package_import_resolution_release(&mismatch);

    let vendor: PackageImportResolution = package_import_resolve(
        "pkg:toolkit/src/toolkit.zag",
        "tests/package_resolution/workspace/vendor_consumer/src");
    package_test(vendor.error == PackageImportError.none && vendor.locked == 1 &&
        vendor.manifest_source_owned == 1 && vendor.lockfile_source_owned == 1 &&
        package_import_starts_with(vendor.manifest_source,
            "name = \"package-resolution-vendor-consumer\"") == 1 &&
        package_import_starts_with(vendor.lockfile_source,
            "format=zag-local-lock-v1\n") == 1 &&
        vendor.checksum.first == 264865380 && vendor.checksum.second == 882918846 &&
        vendor.checksum.bytes == 86,
        "vendored import retains exact manifest and canonical lock snapshots", &failures);
    let vendor_source: []u8 = _zag_read_file(
        "tests/package_resolution/workspace/vendor_consumer/vendor/toolkit/src/toolkit.zag");
    package_test(vendor_source.len >= 0 &&
        package_import_locked_bytes_match(vendor, vendor_source) == 1 &&
        package_import_locked_bytes_match(vendor,
            "pub fn answer() i32 { return 7; }\n") == 0,
        "loaded source bytes are revalidated against the selected checksum", &failures);
    if (vendor_source.len >= 0) { _zag_free(_zag_slice_ptr(vendor_source)); }
    package_import_resolution_release(&vendor);
    package_import_resolution_release(&vendor);

    let sibling: PackageImportResolution = package_import_resolve(
        "pkg:toolkit/src/toolkit.zag",
        "tests/package_resolution/workspace/sibling_consumer/src");
    package_test(sibling.error == PackageImportError.none &&
        sibling.locked == 1 && sibling.sibling_mode == 1 &&
        sibling.manifest_source_owned == 1 && sibling.lockfile_source_owned == 1 &&
        @strEq(sibling.lockfile_source, "format=zag-local-lock-v1\nentry=toolkit\t../toolkit\tsrc/toolkit.zag\t264865380,882918846,86\n") &&
        sibling.checksum.first == 264865380 &&
        sibling.checksum.second == 882918846 && sibling.checksum.bytes == 86,
        "locked sibling import retains exact manifest and direct-entry lock snapshots",
        &failures);
    package_import_resolution_release(&sibling);
    package_import_resolution_release(&sibling);

    let live_before:i64=_zag_allocator_live_bytes();
    let repeat:i32=0;
    let repeated_ok:i32=1;
    while(repeat<32){
        let one:PackageImportResolution=package_import_resolve(
            "pkg:toolkit/src/toolkit.zag",
            "tests/package_resolution/workspace/vendor_consumer/src");
        if(one.error!=PackageImportError.none||one.locked!=1){repeated_ok=0;}
        package_import_resolution_release(&one);
        repeat=repeat+1;
    }
    package_test(repeated_ok==1&&_zag_allocator_live_bytes()==live_before,
        "repeated locked resolution releases retained manifest lock module and path reads",
        &failures);

    let generated:PackageLockGeneratedEntry=package_lock_generated_entry(
        "pkg:toolkit/src/toolkit.zag",
        "tests/package_resolution/workspace/vendor_consumer/src/main.zag");
    package_test(generated.valid==1&&@strEq(generated.alias,"toolkit")&&
        @strEq(generated.root,"vendor/toolkit")&&
        @strEq(generated.module,"src/toolkit.zag")&&
        generated.checksum.first==264865380&&generated.checksum.second==882918846&&
        generated.checksum.bytes==86,
        "lock generator collects an explicit vendor tuple before lock creation",
        &failures);
    package_lock_generated_release(&generated);
    let nonvendor:PackageLockGeneratedEntry=package_lock_generated_entry(
        "pkg:toolkit/src/toolkit.zag",
        "tests/package_resolution/workspace/consumer/src/main.zag");
    package_test(nonvendor.valid==0,
        "lock generator rejects an unlocked sibling dependency", &failures);
    package_lock_generated_release(&nonvendor);
    let transitive_base:PackageLockGeneratedEntry=PackageLockGeneratedEntry{
        .alias="toolkit",.root="vendor/toolkit",.module="src/toolkit.zag",
        .mode="vendor",
        .checksum=PackageRawChecksum{.first=0,.second=0,.bytes=0},.valid=1};
    let transitive:PackageLockGeneratedEntry=package_lock_generated_relative_entry(
        "tests/package_resolution/workspace/vendor_consumer/vendor/toolkit/src/detail/value.zag",
        transitive_base);
    package_test(transitive.valid==1&&@strEq(transitive.alias,"toolkit")&&
        @strEq(transitive.root,"vendor/toolkit")&&
        @strEq(transitive.module,"src/detail/value.zag")&&
        transitive.checksum.first==612409951&&transitive.checksum.second==542644199&&
        transitive.checksum.bytes==127,
        "lock generator binds a discovered relative import below the vendor root", &failures);
    package_lock_generated_release(&transitive);
    let resource:PackageLockGeneratedEntry=package_lock_generated_resource_entry(
        "tests/package_resolution/workspace/vendor_consumer/vendor/toolkit/src/detail/assets/value.txt",
        transitive_base);
    package_test(resource.valid==1&&@strEq(resource.alias,"toolkit")&&
        @strEq(resource.root,"vendor/toolkit")&&
        @strEq(resource.module,"src/detail/assets/value.txt")&&
        resource.checksum.first==338234035&&resource.checksum.second==571087611&&
        resource.checksum.bytes==13,
        "lock generator binds an embedded resource below the vendor root", &failures);
    package_lock_generated_release(&resource);
    let sibling_base:PackageLockGeneratedEntry=PackageLockGeneratedEntry{
        .alias="toolkit",.root="../toolkit",.module="src/toolkit.zag",
        .mode="sibling",
        .checksum=PackageRawChecksum{.first=0,.second=0,.bytes=0},.valid=1};
    let sibling_transitive:PackageLockGeneratedEntry=package_lock_generated_relative_entry(
        "../toolkit/src/detail/value.zag",
        sibling_base);
    package_test(sibling_transitive.valid==0,
        "sibling lock generation remains direct-entry only", &failures);
    package_lock_generated_release(&sibling_transitive);

    let missing_live_before:i64=_zag_allocator_live_bytes();
    let missing_repeat:i32=0;
    let missing_repeated_ok:i32=1;
    while(missing_repeat<32){
        let missing:PackageImportResolution=package_import_resolve(
            "pkg:toolkit/src/toolkit.zag",
            "/__zag_package_manifest_absent_probe__/one/two/three/four/five");
        if(missing.error!=PackageImportError.manifest_not_found){
            missing_repeated_ok=0;
        }
        package_import_resolution_release(&missing);
        missing_repeat=missing_repeat+1;
    }
    package_test(missing_repeated_ok==1&&
        _zag_allocator_live_bytes()==missing_live_before,
        "deep missing-manifest search releases every candidate path",
        &failures);

    _zag_print("Package resolver unit: fail=");
    _zag_print_i64(failures as i64); _zag_println("");
    if (failures == 0) { return 0; }
    return 1;
}
