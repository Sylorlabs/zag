// Bounded, monomorphic compact-def signature resolution. Imported by
// script_syntax.zag: all constraints use its original-source CST token spans.
// There is no backend-specific type inference or dynamic value representation.
struct ZsiSlot { ty:[]u8, label:[]u8, line:i32 }
struct ZsiEdge { a:i32, b:i32 }
struct ZsiVar { name:[]u8, scope:i32, slot:i32 }
struct ZsiParam { name:[]u8, annotation:[]u8, slot:i32 }
struct ZsiFn {
    name:[]u8, line_index:i32, end_index:i32,
    params:ArrayList[ZsiParam], annotation:[]u8, result:i32,
    returns:i32,
}
struct ZsiState {
    src:[]u8, cst:ZsCst, slots:ArrayList[ZsiSlot],
    edges:ArrayList[ZsiEdge], vars:ArrayList[ZsiVar], funcs:ArrayList[ZsiFn],
}
fn zsi_error(line:i32,message:[]u8)void{
    _zag_eprintln(_zag_str_concat("Zag Script inference at line ",
        _zag_str_concat(_zag_i64_to_str(line as i64),_zag_str_concat(": ",message))));
    _zag_exit(1);
}
fn zsi_text(st:*ZsiState,i:i32)[]u8{
    let t:ZsCstToken=st.cst.tokens.data[i];
    return st.src[t.byte_start..t.byte_end];
}
fn zsi_is(st:*ZsiState,i:i32,s:[]u8)i32{return @strEq(zsi_text(st,i),s) as i32;}
fn zsi_slot(st:*ZsiState,ty:[]u8,label:[]u8,line:i32)i32{
    if(st.slots.len>=4096){zsi_error(line,"constraint slot limit (4096) exceeded; split the module");}
    let n:i32=st.slots.len;
    push[ZsiSlot](&st.slots,ZsiSlot{.ty=ty,.label=label,.line=line});return n;
}
fn zsi_edge(st:*ZsiState,a:i32,b:i32)void{
    if(st.edges.len>=8192){zsi_error(1,"constraint edge limit (8192) exceeded; split the module");}
    push[ZsiEdge](&st.edges,ZsiEdge{.a=a,.b=b});
}
fn zsi_known(st:*ZsiState,slot:i32,ty:[]u8,line:i32)void{
    zsi_edge(st,slot,zsi_slot(st,ty,"expression",line));
}
fn zsi_var_find(st:*ZsiState,scope:i32,name:[]u8)i32{
    let i:i32=0;while(i<st.vars.len){
        let v:ZsiVar=st.vars.data[i];
        if(v.scope==scope&&@strEq(v.name,name)){return v.slot;}i=i+1;
    }return -1;
}
fn zsi_var(st:*ZsiState,scope:i32,name:[]u8,line:i32)i32{
    let old:i32=zsi_var_find(st,scope,name);if(old>=0){return old;}
    let slot:i32=zsi_slot(st,"",name,line);
    push[ZsiVar](&st.vars,ZsiVar{.name=name,.scope=scope,.slot=slot});return slot;
}
fn zsi_function(st:*ZsiState,name:[]u8)i32{
    let i:i32=0;while(i<st.funcs.len){if(@strEq(st.funcs.data[i].name,name)){return i;}i=i+1;}return -1;
}
fn zsi_type(st:*ZsiState,a:i32,b:i32)[]u8{
    let out:ArrayList[u8]=make[u8](32);let i:i32=a;
    while(i<b){zs_app(&out,zsi_text(st,i));i=i+1;}
    return zs_type_name(out.data[0..out.len]);
}
fn zsi_close(st:*ZsiState,a:i32,b:i32)i32{
    let depth:i32=0;let i:i32=a;
    while(i<b){let s:[]u8=zsi_text(st,i);
        if(@strEq(s,"(")||@strEq(s,"[")||@strEq(s,"{")){depth=depth+1;}
        else if(@strEq(s,")")||@strEq(s,"]")||@strEq(s,"}")){
            depth=depth-1;if(depth==0){return i;}
        }i=i+1;
    }return -1;
}
fn zsi_collect(st:*ZsiState)void{
    let li:i32=0;
    while(li<st.cst.lines.len){
        let node:ZsCstLine=st.cst.lines.data[li];let a:i32=node.token_start;let b:i32=node.token_end;
        if(a<b&&zsi_is(st,a,"def")==1){
            if(node.indent!=0){zsi_error(node.line,"nested def/closures require explicit canonical Zag");}
            if(st.funcs.len>=128){zsi_error(node.line,"function limit (128) exceeded; split the module");}
            if(a+3>=b||zsi_is(st,a+2,"(")==0||zsi_is(st,b-1,":")==0){zsi_error(node.line,"malformed def signature");}
            let name:[]u8=zsi_text(st,a+1);
            if(zsi_function(st,name)>=0){zsi_error(node.line,_zag_str_concat("duplicate function ",name));}
            let rp:i32=zsi_close(st,a+2,b);
            if(rp<0){zsi_error(node.line,"missing closing parameter parenthesis");}
            let f:ZsiFn=ZsiFn{.name=name,.line_index=li,.end_index=st.cst.lines.len,
                .params=make[ZsiParam](4),.annotation="",.result=zsi_slot(st,"",_zag_str_concat(name," return"),node.line),.returns=0};
            let scope:i32=st.funcs.len;let i:i32=a+3;
            while(i<rp){
                let start:i32=i;let depth:i32=0;
                while(i<rp){
                    let word:[]u8=zsi_text(st,i);
                    if(depth==0&&@strEq(word,",")){break;}
                    if(@strEq(word,"(")||@strEq(word,"[")){depth=depth+1;}
                    else if(@strEq(word,")")||@strEq(word,"]")){depth=depth-1;}
                    if(@strEq(word,"=")){zsi_error(node.line,"default parameters are outside bounded inference; annotate a canonical function");}
                    i=i+1;
                }
                let pname:[]u8=zsi_text(st,start);let ann:[]u8="";
                if(i>start+1){
                    if(zsi_is(st,start+1,":")==0||i==start+2){zsi_error(node.line,"expected parameter name or name: type");}
                    ann=zsi_type(st,start+2,i);
                }
                if(zsi_var_find(st,scope,pname)>=0){zsi_error(node.line,"duplicate parameter");}
                let slot:i32=zsi_var(st,scope,pname,node.line);
                st.slots.data[slot].ty=ann;
                push[ZsiParam](&f.params,ZsiParam{.name=pname,.annotation=ann,.slot=slot});i=i+1;
            }
            if(rp+1<b-1){
                let ra:i32=rp+2;
                if(zsi_is(st,rp+1,"-")==1&&ra<b-1&&zsi_is(st,ra,">")==1){ra=ra+1;}
                else if(zsi_is(st,rp+1,"->")==0){zsi_error(node.line,"expected -> return type");}
                if(ra>=b-1){zsi_error(node.line,"missing return type");}
                f.annotation=zsi_type(st,ra,b-1);st.slots.data[f.result].ty=f.annotation;
            }
            let end:i32=li+1;
            while(end<st.cst.lines.len){
                let n:ZsCstLine=st.cst.lines.data[end];
                if(n.token_start<n.token_end&&n.indent<=node.indent){break;}end=end+1;
            }
            f.end_index=end;push[ZsiFn](&st.funcs,f);
        }
        li=li+1;
    }
}
// Return the last lowest-precedence operator, excluding unary +/-.
// Tokens retain literal kinds so punctuation inside quotes is never scanned.
fn zsi_binary(st:*ZsiState,a:i32,b:i32)i32{
    let depth:i32=0;let best:i32=-1;let precedence:i32=99;let i:i32=a;
    while(i<b){
        let s:[]u8=zsi_text(st,i);let p:i32=99;
        if(@strEq(s,"(")||@strEq(s,"[")||@strEq(s,"{")){depth=depth+1;}
        else if(@strEq(s,")")||@strEq(s,"]")||@strEq(s,"}")){depth=depth-1;}
        else if(depth==0&&i>a){
            if(@strEq(s,"or")||@strEq(s,"||")){p=1;}
            else if(@strEq(s,"and")||@strEq(s,"&&")){p=2;}
            else if(@strEq(s,"==")||@strEq(s,"!=")||@strEq(s,"<")||@strEq(s,">")||@strEq(s,"<=")||@strEq(s,">=")){p=3;}
            else if(@strEq(s,"+")||@strEq(s,"-")){p=4;}
            else if(@strEq(s,"*")||@strEq(s,"/")||@strEq(s,"%")){p=5;}
            if(p==4){
                let prev:ZsCstToken=st.cst.tokens.data[i-1];
                let pv:[]u8=zsi_text(st,i-1);
                if(prev.kind==4||@strEq(pv,"and")||@strEq(pv,"or")||@strEq(pv,"not")){p=99;}
            }
            if(p<99&&p<=precedence){best=i;precedence=p;}
        }i=i+1;
    }return best;
}
fn zsi_wrapped(ty:[]u8)bool{
    return zs_starts(ty,"?")||zs_starts(ty,"!");
}
fn zsi_expr(st:*ZsiState,scope:i32,a:i32,b:i32,depth:i32)i32{
    let line:i32=1;if(a<st.cst.tokens.len){line=st.cst.tokens.data[a].line;}
    if(depth>64){zsi_error(line,"expression nesting limit (64) exceeded");}
    if(a>=b){return zsi_slot(st,"void","empty return",line);}
    if(zsi_is(st,a,"(")==1&&zsi_close(st,a,b)==b-1){return zsi_expr(st,scope,a+1,b-1,depth+1);}
    if(a+1<b&&zsi_is(st,a,"f")==1){
        let first:ZsCstToken=st.cst.tokens.data[a];let last:ZsCstToken=st.cst.tokens.data[b-1];
        if(zs_fstring_at(st.src,first.byte_start)&&zs_fstring_end(st.src,first.byte_start)==last.byte_end){
            return zsi_slot(st,"[]u8","interpolated string",line);
        }
    }
    let op:i32=zsi_binary(st,a,b);
    if(op>=0){
        let lhs:i32=zsi_expr(st,scope,a,op,depth+1);let rhs:i32=zsi_expr(st,scope,op+1,b,depth+1);
        let word:[]u8=zsi_text(st,op);
        zsi_edge(st,lhs,rhs);
        if(@strEq(word,"and")||@strEq(word,"or")||@strEq(word,"&&")||@strEq(word,"||")){
            zsi_known(st,lhs,"bool",line);return lhs;
        }
        if(@strEq(word,"==")||@strEq(word,"!=")||@strEq(word,"<")||@strEq(word,">")||@strEq(word,"<=")||@strEq(word,">=")){
            return zsi_slot(st,"bool","comparison",line);
        }
        zsi_known(st,lhs,"integer",line);return lhs;
    }
    if(zsi_is(st,a,"not")==1||zsi_is(st,a,"!")==1||zsi_is(st,a,"-")==1||zsi_is(st,a,"+")==1){
        let value:i32=zsi_expr(st,scope,a+1,b,depth+1);
        if(zsi_is(st,a,"not")==1||zsi_is(st,a,"!")==1){zsi_known(st,value,"bool",line);}
        else{zsi_known(st,value,"integer",line);}return value;
    }
    if(b==a+1){
        let t:ZsCstToken=st.cst.tokens.data[a];let s:[]u8=zsi_text(st,a);
        if(t.kind==3){return zsi_slot(st,"[]u8","string literal",line);}
        if(@strEq(s,"True")||@strEq(s,"False")||@strEq(s,"true")||@strEq(s,"false")){return zsi_slot(st,"bool","boolean literal",line);}
        if(t.kind==2){
            if(s[0]!=39&&!zs_starts(s,"0x")&&!zs_starts(s,"0X")&&
                (zs_find(s,".")>=0||zs_find(s,"e")>=0||zs_find(s,"E")>=0)){return zsi_slot(st,"f64","float literal",line);}
            return zsi_slot(st,"integer","integer literal",line);
        }
        if(@strEq(s,"None")||@strEq(s,"null")){return zsi_slot(st,"null","null requires an annotation",line);}
        return zsi_var(st,scope,s,line);
    }
    if(a+2<b&&zsi_is(st,a+1,"{")==1&&zsi_close(st,a+1,b)==b-1){
        // Named records keep nominal identity. Field validation and evaluation
        // order remain the shared parser/type checker's responsibility.
        return zsi_slot(st,zsi_text(st,a),"named record",line);
    }
    if(a+2<b&&zsi_is(st,a+1,"(")==1&&zsi_close(st,a+1,b)==b-1){
        let name:[]u8=zsi_text(st,a);let fi:i32=zsi_function(st,name);
        // A local value shadows a function, just as in the ordinary checker.
        if(zsi_var_find(st,scope,name)>=0){fi=-1;}
        let i:i32=a+2;let count:i32=0;
        while(i<b-1){
            let start:i32=i;let nesting:i32=0;
            while(i<b-1){
                let w:[]u8=zsi_text(st,i);
                if(nesting==0&&@strEq(w,",")){break;}
                if(@strEq(w,"(")||@strEq(w,"[")||@strEq(w,"{")){nesting=nesting+1;}
                else if(@strEq(w,")")||@strEq(w,"]")||@strEq(w,"}")){nesting=nesting-1;}
                i=i+1;
            }
            let arg:i32=zsi_expr(st,scope,start,i,depth+1);
            if(fi>=0){
                if(count>=st.funcs.data[fi].params.len){zsi_error(line,_zag_str_concat("too many arguments for ",name));}
                let param:ZsiParam=st.funcs.data[fi].params.data[count];
                // Optional/error injection is a typed-checker conversion, not
                // equality of scalar types. Keep these annotations authoritative.
                if(!zsi_wrapped(param.annotation)){zsi_edge(st,arg,param.slot);}
            }
            if(fi<0&&@strEq(name,"@strEq")){zsi_known(st,arg,"[]u8",line);}
            count=count+1;i=i+1;
        }
        if(fi>=0){
            if(count!=st.funcs.data[fi].params.len){zsi_error(line,_zag_str_concat("wrong argument count for ",name));}
            return st.funcs.data[fi].result;
        }
        // Unknown/imported calls are left to the ordinary checker. Their return
        // types cannot become evidence for an omitted signature.
        if(@strEq(name,"@strEq")){
            if(count!=2){zsi_error(line,"@strEq expects two arguments");}
            return zsi_slot(st,"bool","string equality",line);}
        return zsi_slot(st,"","external call requires an annotation",line);
    }
    return zsi_slot(st,"","unsupported expression requires an annotation",line);
}
fn zsi_scope(st:*ZsiState,li:i32)i32{
    let i:i32=0;while(i<st.funcs.len){
        let f:ZsiFn=st.funcs.data[i];if(li>f.line_index&&li<f.end_index){return i;}i=i+1;
    }return -1;
}
fn zsi_constraints(st:*ZsiState)void{
    let li:i32=0;while(li<st.cst.lines.len){
        let n:ZsCstLine=st.cst.lines.data[li];let a:i32=n.token_start;let b:i32=n.token_end;
        let scope:i32=zsi_scope(st,li);
        if(a<b&&zsi_is(st,b-1,";")==1){b=b-1;}
        if(a<b&&zsi_is(st,a,"def")==0&&zsi_is(st,a,"script")==0){
            if(zsi_is(st,a,"return")==1){
                if(scope>=0){let value:i32=zsi_expr(st,scope,a+1,b,0);
                    if(!zsi_wrapped(st.funcs.data[scope].annotation)){zsi_edge(st,st.funcs.data[scope].result,value);}
                    st.funcs.data[scope].returns=st.funcs.data[scope].returns+1;}
            }else if(zsi_is(st,a,"if")==1||zsi_is(st,a,"elif")==1||zsi_is(st,a,"while")==1){
                let end:i32=b;if(zsi_is(st,b-1,":")==1){end=b-1;}
                zsi_known(st,zsi_expr(st,scope,a+1,end,0),"bool",n.line);
            }else if(zsi_is(st,a,"else")==0&&zsi_is(st,a,"pass")==0){
                let eq:i32=-1;let nesting:i32=0;let i:i32=a;
                while(i<b){let w:[]u8=zsi_text(st,i);
                    if(@strEq(w,"(")||@strEq(w,"[")){nesting=nesting+1;}
                    else if(@strEq(w,")")||@strEq(w,"]")){nesting=nesting-1;}
                    else if(nesting==0&&(@strEq(w,"=")||@strEq(w,"+=")||@strEq(w,"-=")||@strEq(w,"*=")||@strEq(w,"/=")||@strEq(w,"%="))){eq=i;break;}
                    i=i+1;
                }
                if(eq>a){
                    let start:i32=a;if(zsi_is(st,a,"let")==1){start=a+1;}
                    let lhs_end:i32=eq;let compound:i32=(zsi_is(st,eq,"=")==0) as i32;
                    if(eq>start+1&&zsi_is(st,eq,"=")==1){
                        let prev:[]u8=zsi_text(st,eq-1);
                        if(@strEq(prev,"+")||@strEq(prev,"-")||@strEq(prev,"*")||@strEq(prev,"/")||@strEq(prev,"%")){lhs_end=eq-1;compound=1;}
                    }
                    if(lhs_end==start+1||zsi_is(st,start+1,":")==1){
                        let slot:i32=zsi_var(st,scope,zsi_text(st,start),n.line);
                        let ann:[]u8="";
                        if(lhs_end>start+1){ann=zsi_type(st,start+2,lhs_end);zsi_known(st,slot,ann,n.line);}
                        let value:i32=zsi_expr(st,scope,eq+1,b,0);
                        if(!zsi_wrapped(ann)){zsi_edge(st,slot,value);}
                        if(compound==1){zsi_known(st,slot,"integer",n.line);}
                    }else{let ignored:i32=zsi_expr(st,scope,eq+1,b,0);}
                }else{let ignored:i32=zsi_expr(st,scope,a,b,0);}
            }
        }li=li+1;
    }
    let fi:i32=0;while(fi<st.funcs.len){
        if(st.funcs.data[fi].returns==0&&!zsi_wrapped(st.funcs.data[fi].annotation)){zsi_known(st,st.funcs.data[fi].result,"void",st.cst.lines.data[st.funcs.data[fi].line_index].line);}
        fi=fi+1;
    }
}
fn zsi_numeric(ty:[]u8)i32{
    return (@strEq(ty,"integer")||@strEq(ty,"i8")||@strEq(ty,"i16")||@strEq(ty,"i32")||@strEq(ty,"i64")||
        @strEq(ty,"u8")||@strEq(ty,"u16")||@strEq(ty,"u32")||@strEq(ty,"u64")||@strEq(ty,"f32")||@strEq(ty,"f64")) as i32;
}
fn zsi_solve(st:*ZsiState)void{
    let changed:i32=1;let rounds:i32=0;
    while(changed==1){
        if(rounds>st.slots.len+1){zsi_error(1,"fixed point limit exceeded");}
        changed=0;rounds=rounds+1;let i:i32=0;
        while(i<st.edges.len){
            let edge:ZsiEdge=st.edges.data[i];let a:ZsiSlot=st.slots.data[edge.a];let b:ZsiSlot=st.slots.data[edge.b];
            let ty:[]u8=a.ty;
            if(ty.len==0){ty=b.ty;}
            else if(b.ty.len>0&&!@strEq(ty,b.ty)){
                if(@strEq(ty,"null")&&(zsi_wrapped(b.ty)||zs_starts(b.ty,"*"))){ty=b.ty;}
                else if(@strEq(b.ty,"null")&&(zsi_wrapped(ty)||zs_starts(ty,"*"))){}
                else if(@strEq(ty,"integer")&&zsi_numeric(b.ty)==1){ty=b.ty;}
                else if(!(@strEq(b.ty,"integer")&&zsi_numeric(ty)==1)){
                    zsi_error(a.line,_zag_str_concat("conflicting types for ",_zag_str_concat(a.label,
                        _zag_str_concat(": ",_zag_str_concat(a.ty,_zag_str_concat(" versus ",b.ty))))));
                }
            }
            if(!@strEq(a.ty,ty)){st.slots.data[edge.a].ty=ty;changed=1;}
            if(!@strEq(b.ty,ty)){st.slots.data[edge.b].ty=ty;changed=1;}i=i+1;
        }
    }
}
fn zsi_resolved(st:*ZsiState,slot:i32)[]u8{
    let s:ZsiSlot=st.slots.data[slot];
    if(s.ty.len==0||@strEq(s.ty,"null")){zsi_error(s.line,_zag_str_concat("ambiguous type for ",_zag_str_concat(s.label,"; add an explicit annotation")));}
    if(@strEq(s.ty,"integer")){return "i64";}
    return s.ty;
}
// Conservative total-return check for compact if/elif/else suites. Loops are
// not assumed to execute or terminate; an explicit annotation delegates more
// involved control-flow proofs to the ordinary checker.
fn zsi_next_line(st:*ZsiState,a:i32,b:i32)i32{
    let i:i32=a;while(i<b){
        let n:ZsCstLine=st.cst.lines.data[i];
        if(n.token_start<n.token_end){return i;}i=i+1;
    }return b;
}
fn zsi_suite_returns(st:*ZsiState,a:i32,b:i32,depth:i32)i32{
    if(depth>64){zsi_error(1,"control-flow nesting limit (64) exceeded");}
    let i:i32=zsi_next_line(st,a,b);
    if(i>=b){return 0;}
    let indent:i32=st.cst.lines.data[i].indent;
    while(i<b){
        let n:ZsCstLine=st.cst.lines.data[i];
        if(n.indent!=indent){return 0;}
        if(zsi_is(st,n.token_start,"return")==1){return 1;}
        let end:i32=zsi_next_line(st,i+1,b);
        while(end<b&&st.cst.lines.data[end].indent>indent){end=zsi_next_line(st,end+1,b);}
        if(zsi_is(st,n.token_start,"if")==1){
            let all:i32=zsi_suite_returns(st,i+1,end,depth+1);let has_else:i32=0;
            while(end<b){
                let branch:ZsCstLine=st.cst.lines.data[end];
                if(branch.indent!=indent){break;}
                let is_else:i32=zsi_is(st,branch.token_start,"else");
                if(is_else==0&&zsi_is(st,branch.token_start,"elif")==0){break;}
                let finish:i32=zsi_next_line(st,end+1,b);
                while(finish<b&&st.cst.lines.data[finish].indent>indent){finish=zsi_next_line(st,finish+1,b);}
                if(zsi_suite_returns(st,end+1,finish,depth+1)==0){all=0;}
                if(is_else==1){has_else=1;}end=finish;
            }
            if(all==1&&has_else==1){return 1;}
        }
        i=end;
    }return 0;
}
fn zs_infer_signatures(src:[]u8,cst:ZsCst)ZsiState{
    let st:ZsiState=ZsiState{.src=src,.cst=cst,.slots=make[ZsiSlot](32),.edges=make[ZsiEdge](32),
        .vars=make[ZsiVar](16),.funcs=make[ZsiFn](8)};
    zsi_collect(&st);
    if(st.funcs.len==0){return st;}
    zsi_constraints(&st);zsi_solve(&st);
    let i:i32=0;while(i<st.funcs.len){
        let f:ZsiFn=st.funcs.data[i];let ret:[]u8=zsi_resolved(&st,f.result);
        if(f.annotation.len==0&&!@strEq(ret,"void")&&zsi_suite_returns(&st,f.line_index+1,f.end_index,0)==0){
            zsi_error(st.cst.lines.data[f.line_index].line,_zag_str_concat("not all paths return a value in ",f.name));
        }
        let pi:i32=0;while(pi<f.params.len){let ty:[]u8=zsi_resolved(&st,f.params.data[pi].slot);pi=pi+1;}
        i=i+1;
    }
    return st;
}
fn zs_emit_inferred_def(out:*ArrayList[u8],st:*ZsiState,line_index:i32)void{
    let i:i32=0;while(i<st.funcs.len){
        let f:ZsiFn=st.funcs.data[i];
        if(f.line_index==line_index){
            zs_app(out,"fn ");zs_app(out,f.name);zs_ch(out,'(');
            let pi:i32=0;while(pi<f.params.len){
                let p:ZsiParam=f.params.data[pi];if(pi>0){zs_app(out,", ");}
                zs_app(out,p.name);zs_ch(out,':');zs_app(out,zsi_resolved(st,p.slot));pi=pi+1;
            }
            zs_app(out,") ");zs_app(out,zsi_resolved(st,f.result));zs_app(out," {\n");return;
        }i=i+1;
    }
    zsi_error(line_index+1,"missing resolved signature");
}
