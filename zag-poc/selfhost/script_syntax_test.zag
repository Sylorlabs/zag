@import("script_syntax.zag")

fn cst_check(ok:i32,name:[]u8,fail:*i32)void{
    if(ok==1){_zag_println(_zag_str_concat("ok  ",name));}
    else{_zag_eprintln(_zag_str_concat("XX  ",name));fail.*=fail.*+1;}
}

fn cst_text_map_bounds(src:[]u8,cst:ZsCst)ZsMapLiteralBounds{
    let bad:ZsMapLiteralBounds=ZsMapLiteralBounds{.first=-1,.last=-1,.valid=0};
    if(cst.lines.len<2){return bad;}
    let node:ZsCstLine=cst.lines.data[1];
    let assignment:ZsAssignmentBounds=zs_assignment_bounds_cst(src,node,cst.tokens,
        node.content_start,node.content_end);
    if(assignment.valid==0){return bad;}
    return zs_cst_map_text_literal_bounds(src,cst.tokens,
        node.content_start+assignment.rhs_start,node.content_end);
}

fn main()i32{
    let fail:i32=0;
    let source:[]u8="script;\r\n# café  \r\nif true:\r\n\tprint(\"λ\")\r\n";
    let cst:ZsCst=script_syntax_cst(source);
    cst_check(cst.valid==1,"CST valid",&fail);
    cst_check(script_syntax_cst_valid(cst)==1,"CST validates parser boundary",&fail);
    cst_check(@strEq(script_syntax_cst_reconstruct(cst),source) as i32,
        "lossless CRLF Unicode reconstruction",&fail);
    cst_check(cst.lines.len==5,"logical lines include terminal blank",&fail);
    cst_check(cst.lines.data[0].raw_start==0&&cst.lines.data[0].raw_end==9&&
        cst.lines.data[0].content_start==0&&cst.lines.data[0].content_end==7,
        "exact first-line byte span",&fail);
    cst_check(cst.lines.data[1].kind==1&&cst.lines.data[2].kind==3&&
        cst.lines.data[3].indent==1,"comment block and indentation kinds",&fail);
    cst_check(cst.lines.data[0].header_kind==1&&cst.lines.data[2].header_kind==2,
        "shared-token header classification",&fail);
    let header_source:ZsCst=script_syntax_cst(
        "script;\nif true:\n  print(1)\nelse:\n  print(2)\nwhile false:\n  pass\nfor x in range(2):\n  pass\ndef f(x):\n  return x\n");
    let seen_if:i32=0;let seen_else:i32=0;let seen_while:i32=0;
    let seen_for:i32=0;let seen_def:i32=0;let hi:i32=0;
    while(hi<header_source.lines.len){let hk:i32=header_source.lines.data[hi].header_kind;
        if(hk==2){seen_if=1;}else if(hk==4){seen_else=1;}
        else if(hk==5){seen_while=1;}else if(hk==7){seen_for=1;}
        else if(hk==6){seen_def=1;}hi=hi+1;}
    cst_check(header_source.valid==1&&seen_if==1&&seen_else==1&&seen_while==1&&
        seen_for==1&&seen_def==1,"all layout headers classify from tokens",&fail);
    cst_check(cst.tokens.len>=9&&cst.lines.data[0].token_start==0&&
        cst.lines.data[0].token_end==2&&cst.tokens.data[0].kind==1&&
        @strEq(source[cst.tokens.data[0].byte_start..cst.tokens.data[0].byte_end],"script"),
        "token spans retain source bytes",&fail);
    let shared_tokens:ArrayList[Token]=lex(zs_cst_lex_input(source,1));let shared_count:i32=0;let si:i32=0;
    while(si<shared_tokens.len){if(tk_code(shared_tokens.data[si].kind)!=tk_code(Tk.Eof)){shared_count=shared_count+1;}si=si+1;}
    cst_check(cst.tokens.len==shared_count,"CST token index uses shared lexer stream",&fail);
    cst_check(cst.layouts.len==2&&cst.layouts.data[0].kind==1&&
        cst.layouts.data[0].indent==1&&cst.layouts.data[1].kind==3,
        "indent and EOF-dedent layout events",&fail);
    let token_cursor:i32=0;let ti:i32=0;let token_ordered:i32=1;
    while(ti<cst.tokens.len){
        let tok:ZsCstToken=cst.tokens.data[ti];
        if(tok.byte_start<0||tok.byte_end<=tok.byte_start||
            tok.byte_end>source.len||tok.byte_start<token_cursor||tok.line<1||tok.col<1){token_ordered=0;}
        token_cursor=tok.byte_end;ti=ti+1;
    }
    cst_check(token_ordered==1,"token spans are ordered and bounded",&fail);
    cst_check(cst.lines.data[0].token_start==0&&
        cst.lines.data[1].token_start==cst.lines.data[1].token_end&&
        cst.lines.data[2].token_end>cst.lines.data[2].token_start&&
        cst.lines.data[4].token_start==cst.lines.data[4].token_end,
        "each line carries an exact token range",&fail);
    let token_same:ZsCst=script_syntax_cst(source);
    cst_check(token_same.tokens.len==cst.tokens.len&&
        token_same.tokens.data[2].origin_id==cst.tokens.data[2].origin_id,
        "token origin IDs are stable",&fail);
    let broken:ZsCst=script_syntax_cst(source);
    broken.lines.data[0].token_start=1;
    cst_check(script_syntax_cst_valid(broken)==0,
        "invalid CST token range fails closed",&fail);
    let reordered:ZsCst=script_syntax_cst(source);
    let first_start:i32=reordered.tokens.data[0].byte_start;
    let first_end:i32=reordered.tokens.data[0].byte_end;
    reordered.tokens.data[0].byte_start=reordered.tokens.data[1].byte_start;
    reordered.tokens.data[0].byte_end=reordered.tokens.data[1].byte_end;
    reordered.tokens.data[1].byte_start=first_start;
    reordered.tokens.data[1].byte_end=first_end;
    cst_check(script_syntax_cst_valid(reordered)==0,
        "out-of-order CST token spans fail closed",&fail);
    let broken_raw_span:ZsCst=script_syntax_cst(source);
    broken_raw_span.lines.data[0].raw_end=source.len+1;
    cst_check(script_syntax_cst_valid(broken_raw_span)==0,
        "out-of-bounds CST raw span fails closed",&fail);
    let bad_layout:ZsCst=script_syntax_cst("script;\nif true:\n  print(1)\n print(2)\n");
    cst_check(bad_layout.valid==0&&bad_layout.recoveries.len==1&&
        bad_layout.recoveries.data[0].kind==1&&
        bad_layout.recoveries.data[0].byte_start==bad_layout.lines.data[3].content_start&&
        script_syntax_cst_valid(bad_layout)==0,
        "inconsistent dedent fails closed",&fail);
    let broken_recovery:ZsCst=script_syntax_cst("script;\nif true:\n  print(1)\n print(2)\n");
    broken_recovery.recoveries.data[0].byte_end=broken_recovery.source.len+1;
    cst_check(script_syntax_cst_valid(broken_recovery)==0,
        "invalid recovery span fails closed",&fail);
    let strict_columns:ZsCst=script_syntax_cst("fn main() i32 {\n  return 0;\n return 1;\n}");
    cst_check(strict_columns.valid==0&&script_syntax_cst_valid(strict_columns)==1,
        "strict brace source ignores indentation recovery",&fail);
    cst_check(zs_has_canonical_brace("script;\n# {\nvalue = 1\n")==0,
        "hash-comment braces do not select strict parsing",&fail);
    cst_check(zs_has_canonical_brace("script;\n// }\nvalue = 1\n")==0,
        "slash-comment braces do not select strict parsing",&fail);
    cst_check(zs_has_canonical_brace("script;\nvalue = '{'\n")==0&&
        zs_has_canonical_brace("script;\nvalue = \"}\"\n")==0,
        "quoted braces do not select strict parsing",&fail);
    let mixed_indent:ZsCst=script_syntax_cst("script;\n\t print(1)\n");
    cst_check(mixed_indent.valid==0&&mixed_indent.recoveries.len==1&&
        mixed_indent.recoveries.data[0].kind==2&&
        script_syntax_cst_valid(mixed_indent)==0,
        "mixed indentation records recovery and fails closed",&fail);
    let unexpected_indent:ZsCst=script_syntax_cst(
        "script;\nvalue = 1\n  print(2)\n");
    cst_check(unexpected_indent.valid==0&&unexpected_indent.recoveries.len==1&&
        unexpected_indent.recoveries.data[0].kind==7&&
        unexpected_indent.recoveries.data[0].byte_start==unexpected_indent.lines.data[2].raw_start&&
        script_syntax_cst_valid(unexpected_indent)==0,
        "indentation without a block header records localized recovery",&fail);
    let comment_gap_indent:ZsCst=script_syntax_cst(
        "script;\nif true:\n# comment\n  pass\n");
    cst_check(comment_gap_indent.valid==1&&comment_gap_indent.recoveries.len==0&&
        script_syntax_cst_valid(comment_gap_indent)==1,
        "comment lines do not break a pending block indentation",&fail);
    let missing_body:ZsCst=script_syntax_cst(
        "script;\nif true:\nreturn 1\n");
    cst_check(missing_body.valid==0&&missing_body.recoveries.len==1&&
        missing_body.recoveries.data[0].kind==8&&
        missing_body.recoveries.data[0].line==3&&
        script_syntax_cst_valid(missing_body)==0,
        "missing block body before the next statement fails closed",&fail);
    let eof_body:ZsCst=script_syntax_cst("script;\nwhile false:\n");
    cst_check(eof_body.valid==0&&eof_body.recoveries.len==1&&
        eof_body.recoveries.data[0].kind==8&&
        eof_body.recoveries.data[0].byte_start==eof_body.source.len&&
        script_syntax_cst_valid(eof_body)==0,
        "missing block body at EOF has a stable zero-width recovery",&fail);
    let malformed:ArrayList[u8]=make[u8](16);
    push[u8](&malformed,'s');push[u8](&malformed,'c');push[u8](&malformed,'r');
    push[u8](&malformed,'i');push[u8](&malformed,'p');push[u8](&malformed,'t');
    push[u8](&malformed,';');push[u8](&malformed,10);
    // An overlong three-byte sequence is rejected as one localized recovery
    // unit, including its contiguous continuation bytes.
    push[u8](&malformed,224);push[u8](&malformed,128);push[u8](&malformed,128);
    let malformed_cst:ZsCst=script_syntax_cst(malformed.data[0..malformed.len]);
    cst_check(malformed_cst.valid==0&&malformed_cst.recoveries.len==1&&
        malformed_cst.recoveries.data[0].kind==3&&
        malformed_cst.recoveries.data[0].byte_start==8&&
        malformed_cst.recoveries.data[0].byte_end==malformed.len&&
        malformed_cst.recoveries.data[0].line==2&&
        malformed_cst.recoveries.data[0].col==1&&
        malformed_cst.recoveries.data[0].origin_id==
            zs_origin_id(malformed_cst.source,8,malformed.len,2)&&
        malformed_cst.recoveries.data[0].origin_id>0&&
        script_syntax_cst_valid(malformed_cst)==0,
        "invalid UTF-8 source records complete recovery origin and fails closed",&fail);
    let malformed_same:ZsCst=script_syntax_cst(malformed.data[0..malformed.len]);
    cst_check(malformed_same.recoveries.data[0].origin_id==
        malformed_cst.recoveries.data[0].origin_id,
        "invalid-byte recovery origin IDs are deterministic",&fail);
    let multiple_bad:ArrayList[u8]=make[u8](32);
    zs_app(&multiple_bad,"script;\n");
    // Two disjoint malformed units on one physical line must remain separate
    // recovery spans, even when the first unit is an overlong sequence.
    push[u8](&multiple_bad,224);push[u8](&multiple_bad,128);push[u8](&multiple_bad,128);
    zs_app(&multiple_bad,"ok ");push[u8](&multiple_bad,245);zs_app(&multiple_bad,"x\n");
    let multiple_bad_cst:ZsCst=script_syntax_cst(multiple_bad.data[0..multiple_bad.len]);
    let first_bad:ZsCstRecovery=multiple_bad_cst.recoveries.data[0];
    let second_bad:ZsCstRecovery=multiple_bad_cst.recoveries.data[1];
    cst_check(multiple_bad_cst.valid==0&&multiple_bad_cst.recoveries.len==2&&
        first_bad.kind==3&&first_bad.byte_start==8&&first_bad.byte_end==11&&
        second_bad.kind==3&&second_bad.byte_start==14&&second_bad.byte_end==15&&
        first_bad.line==2&&second_bad.line==2&&
        first_bad.col==1&&second_bad.col==7&&
        first_bad.origin_id==zs_origin_id(multiple_bad_cst.source,8,11,2)&&
        second_bad.origin_id==zs_origin_id(multiple_bad_cst.source,14,15,2)&&
        script_syntax_cst_valid(multiple_bad_cst)==0,
        "multiple malformed UTF-8 units retain disjoint recovery spans",&fail);
    let truncated_utf8:ZsCst=script_syntax_cst("script;\n\xe2\x82");
    let bad_continuation:ZsCst=script_syntax_cst("script;\n\xe2A\x80");
    let stray_continuation:ZsCst=script_syntax_cst("script;\n\x80");
    let surrogate_utf8:ZsCst=script_syntax_cst("script;\n\xed\xa0\x80");
    let out_of_range_utf8:ZsCst=script_syntax_cst("script;\n\xf4\x90\x80\x80");
    cst_check(truncated_utf8.valid==0&&truncated_utf8.recoveries.len==1&&
        truncated_utf8.recoveries.data[0].byte_start==8&&
        truncated_utf8.recoveries.data[0].byte_end==10&&
        bad_continuation.valid==0&&bad_continuation.recoveries.len==2&&
        bad_continuation.recoveries.data[0].byte_start==8&&
        bad_continuation.recoveries.data[0].byte_end==9&&
        bad_continuation.recoveries.data[1].byte_start==10&&
        bad_continuation.recoveries.data[1].byte_end==11&&
        stray_continuation.valid==0&&stray_continuation.recoveries.len==1&&
        stray_continuation.recoveries.data[0].byte_start==8&&
        stray_continuation.recoveries.data[0].byte_end==9&&
        surrogate_utf8.valid==0&&surrogate_utf8.recoveries.len==1&&
        surrogate_utf8.recoveries.data[0].byte_start==8&&
        surrogate_utf8.recoveries.data[0].byte_end==11&&
        out_of_range_utf8.valid==0&&out_of_range_utf8.recoveries.len==1&&
        out_of_range_utf8.recoveries.data[0].byte_start==8&&
        out_of_range_utf8.recoveries.data[0].byte_end==12&&
        script_syntax_cst_valid(truncated_utf8)==0&&
        script_syntax_cst_valid(bad_continuation)==0&&
        script_syntax_cst_valid(stray_continuation)==0&&
        script_syntax_cst_valid(surrogate_utf8)==0&&
        script_syntax_cst_valid(out_of_range_utf8)==0,
        "UTF-8 truncation, continuation, surrogate, and range boundaries fail closed",&fail);
    // Valid multibyte scalars must advance the recovery cursor by scalar width;
    // malformed units on either side remain disjoint and retain physical lines.
    let unicode_gap:ZsCst=script_syntax_cst("script;\n😀\xe2\x82\né\x80\n");
    let unicode_gap_same:ZsCst=script_syntax_cst(unicode_gap.source);
    cst_check(unicode_gap.valid==0&&unicode_gap.recoveries.len==2&&
        unicode_gap.recoveries.data[0].byte_start==12&&
        unicode_gap.recoveries.data[0].byte_end==14&&
        unicode_gap.recoveries.data[0].line==2&&
        unicode_gap.recoveries.data[0].col==5&&
        unicode_gap.recoveries.data[0].origin_id==zs_origin_id(unicode_gap.source,12,14,2)&&
        unicode_gap.recoveries.data[1].byte_start==17&&
        unicode_gap.recoveries.data[1].byte_end==18&&
        unicode_gap.recoveries.data[1].line==3&&
        unicode_gap.recoveries.data[1].col==3&&
        unicode_gap.recoveries.data[1].origin_id==zs_origin_id(unicode_gap.source,17,18,3)&&
        unicode_gap_same.recoveries.data[0].origin_id==unicode_gap.recoveries.data[0].origin_id&&
        unicode_gap_same.recoveries.data[1].origin_id==unicode_gap.recoveries.data[1].origin_id&&
        script_syntax_cst_valid(unicode_gap)==0,
        "multibyte scalars preserve disjoint UTF-8 recovery spans and lines",&fail);
    let invalid_lead_unit:ZsCst=script_syntax_cst("script;\n\xc0\xaf ok\n");
    cst_check(invalid_lead_unit.valid==0&&invalid_lead_unit.recoveries.len==1&&
        invalid_lead_unit.recoveries.data[0].byte_start==8&&
        invalid_lead_unit.recoveries.data[0].byte_end==10&&
        invalid_lead_unit.recoveries.data[0].col==1&&
        invalid_lead_unit.recoveries.data[0].origin_id==
            zs_origin_id(invalid_lead_unit.source,8,10,2)&&
        script_syntax_cst_valid(invalid_lead_unit)==0,
        "invalid UTF-8 lead retains its contiguous continuation bytes",&fail);
    let nul_source:ArrayList[u8]=make[u8](9);
    push[u8](&nul_source,'s');push[u8](&nul_source,'c');push[u8](&nul_source,'r');
    push[u8](&nul_source,'i');push[u8](&nul_source,'p');push[u8](&nul_source,'t');
    push[u8](&nul_source,';');push[u8](&nul_source,10);push[u8](&nul_source,0);
    let nul_cst:ZsCst=script_syntax_cst(nul_source.data[0..nul_source.len]);
    cst_check(nul_cst.valid==0&&nul_cst.recoveries.len==1&&
        nul_cst.recoveries.data[0].kind==3&&
        nul_cst.recoveries.data[0].line==2&&
        nul_cst.recoveries.data[0].col==1&&
        script_syntax_cst_valid(nul_cst)==0,
        "NUL source records recovery and fails closed",&fail);

    let unterminated_string:ZsCst=script_syntax_cst(
        "script;\nprint(\"unterminated\n");
    cst_check(unterminated_string.valid==0&&
        unterminated_string.recoveries.len==1&&
        unterminated_string.recoveries.data[0].kind==4&&
        unterminated_string.recoveries.data[0].byte_start==14&&
        unterminated_string.recoveries.data[0].line==2&&
        unterminated_string.recoveries.data[0].col==7&&
        unterminated_string.recoveries.data[0].origin_id>0&&
        script_syntax_cst_valid(unterminated_string)==0,
        "unterminated string records stable localized recovery",&fail);
    let unterminated_escape_source:ArrayList[u8]=make[u8](32);
    zs_app(&unterminated_escape_source,"script;\nvalue = \"unterminated");
    push[u8](&unterminated_escape_source,92);
    let unterminated_escape:ZsCst=script_syntax_cst(
        unterminated_escape_source.data[0..unterminated_escape_source.len]);
    cst_check(unterminated_escape.valid==0&&
        unterminated_escape.recoveries.len==1&&
        unterminated_escape.recoveries.data[0].kind==14&&
        unterminated_escape.recoveries.data[0].byte_start==29&&
        unterminated_escape.recoveries.data[0].byte_end==30&&
        unterminated_escape.recoveries.data[0].line==2&&
        unterminated_escape.recoveries.data[0].origin_id==
            zs_origin_id(unterminated_escape.source,29,30,2)&&
        script_syntax_cst_valid(unterminated_escape)==0,
        "unterminated string escape records the exact backslash recovery",&fail);
    let multiline_delimiters:[]u8="script;\nvalue = [\n  1,\n  2,\n]\n";
    let multiline_cst:ZsCst=script_syntax_cst(multiline_delimiters);
    let multiline_owner:ZsCstLine=multiline_cst.lines.data[1];
    cst_check(multiline_cst.valid==1&&script_syntax_cst_valid(multiline_cst)==1&&
        multiline_owner.logical_owner==1&&multiline_owner.delimiter_after==1&&
        multiline_owner.logical_raw_end>multiline_owner.raw_end&&
        multiline_owner.logical_token_end>multiline_owner.token_end&&
        multiline_cst.lines.data[2].delimiter_before==1&&
        multiline_cst.lines.data[4].delimiter_before==1&&
        multiline_cst.lines.data[4].delimiter_after==0,
        "balanced delimiters preserve one logical CST envelope",&fail);
    cst_check(multiline_cst.lines.data[2].logical_owner==1,
        "first continuation retains logical owner",&fail);
    cst_check(multiline_cst.lines.data[3].logical_owner==1,
        "nested continuation retains logical owner",&fail);
    cst_check(multiline_cst.lines.data[4].logical_owner==1&&
        multiline_owner.logical_token_end==multiline_cst.lines.data[4].token_end,
        "closing continuation completes logical token range",&fail);
    let multiline_list_view:[]u8=script_syntax_normalize(
        "script;\nvalues = [\n  1,\n  choose(2,\n    3),\n]\n");
    cst_check(zs_find(multiline_list_view,"list(1, choose(2, 3));")>=0&&
        zs_find(multiline_list_view,"values = [")<0,
        "multiline list assignment projects through shared tokens",&fail);
    let multiline_call_view:[]u8=script_syntax_normalize(
        "script;\nvalue = choose(\n  1,\n  2\n)\n");
    cst_check(zs_find(multiline_call_view,"choose(")>=0&&
        zs_find(multiline_call_view,"1, 2)")>=0,
        "multiline call assignment projects through shared tokens",&fail);
    let multiline_if_source:[]u8="script;\nif (\n  true\n):\n  return 42\n";
    let multiline_if_cst:ZsCst=script_syntax_cst(multiline_if_source);
    let multiline_if_owner:ZsCstLine=multiline_if_cst.lines.data[1];
    let multiline_if_view:[]u8=script_syntax_normalize(multiline_if_source);
    cst_check(multiline_if_cst.valid==1&&script_syntax_cst_valid(multiline_if_cst)==1&&
        multiline_if_owner.header_kind==2&&zs_find(multiline_if_view,"if (true) {")>=0&&
        zs_find(multiline_if_view,"return 42;")>=0,
        "multiline if header projects through one logical CST envelope",&fail);
    let multiline_if_missing_colon:ZsCst=script_syntax_cst(
        "script;\nif (\n  true\n)\n  return 42\n");
    cst_check(multiline_if_missing_colon.valid==0&&
        multiline_if_missing_colon.recoveries.len==1&&
        multiline_if_missing_colon.recoveries.data[0].kind==6&&
        script_syntax_cst_valid(multiline_if_missing_colon)==0,
        "multiline if missing colon fails closed",&fail);
    let multiline_while_source:[]u8="script;\nwhile (\n  true\n):\n  pass\n";
    let multiline_while_cst:ZsCst=script_syntax_cst(multiline_while_source);
    let multiline_while_view:[]u8=script_syntax_normalize(multiline_while_source);
    cst_check(multiline_while_cst.valid==1&&multiline_while_cst.lines.data[1].header_kind==5&&
        zs_find(multiline_while_view,"while (true) {")>=0,
        "multiline while header projects through one logical CST envelope",&fail);
    let multiline_while_missing_colon:ZsCst=script_syntax_cst(
        "script;\nwhile (\n  true\n)\n  pass\n");
    cst_check(multiline_while_missing_colon.valid==0&&
        multiline_while_missing_colon.recoveries.len==1&&
        multiline_while_missing_colon.recoveries.data[0].kind==6,
        "multiline while missing colon fails closed",&fail);
    let multiline_for_source:[]u8="script;\nfor x in range(\n  2\n):\n  pass\n";
    let multiline_for_cst:ZsCst=script_syntax_cst(multiline_for_source);
    let multiline_for_view:[]u8=script_syntax_normalize(multiline_for_source);
    cst_check(multiline_for_cst.valid==1&&multiline_for_cst.lines.data[1].header_kind==7&&
        zs_find(multiline_for_view,"for (0..2) |x| {")>=0,
        "multiline for header projects through one logical CST envelope",&fail);
    let multiline_def_source:[]u8="script;\ndef add(\n  left,\n  right\n) -> i64:\n  return left + right\n";
    let multiline_def_cst:ZsCst=script_syntax_cst(multiline_def_source);
    let multiline_def_view:[]u8=script_syntax_normalize(multiline_def_source);
    cst_check(multiline_def_cst.valid==1&&multiline_def_cst.lines.data[1].header_kind==6&&
        zs_find(multiline_def_view,"fn add(left:i64, right:i64) i64 {")>=0,
        "multiline def header projects through one logical CST envelope",&fail);
    let mismatched_delimiter:ZsCst=script_syntax_cst(
        "script;\nvalue = [1)\n");
    cst_check(mismatched_delimiter.valid==0&&mismatched_delimiter.recoveries.len==1&&
        mismatched_delimiter.recoveries.data[0].kind==9&&
        mismatched_delimiter.recoveries.data[0].origin_id>0&&
        script_syntax_cst_valid(mismatched_delimiter)==0,
        "mismatched closing delimiter records localized recovery",&fail);
    let unterminated_delimiter:ZsCst=script_syntax_cst(
        "script;\nvalue = [1\n");
    cst_check(unterminated_delimiter.valid==0&&unterminated_delimiter.recoveries.len==1&&
        unterminated_delimiter.recoveries.data[0].kind==10&&
        unterminated_delimiter.recoveries.data[0].byte_start==unterminated_delimiter.source.len&&
        unterminated_delimiter.recoveries.data[0].byte_end==unterminated_delimiter.source.len&&
        unterminated_delimiter.recoveries.data[0].origin_id>0&&
        script_syntax_cst_valid(unterminated_delimiter)==0,
        "unterminated delimiter records stable EOF recovery",&fail);
    let comment_quote:ZsCst=script_syntax_cst(
        "script;\n# comment with \" quote\nprint(1)\n");
    cst_check(comment_quote.valid==1&&comment_quote.recoveries.len==0&&
        script_syntax_cst_valid(comment_quote)==1,
        "comment quotes do not create literal recovery",&fail);
    let inline_comments:ZsCst=script_syntax_cst(
        "script; # profile note\nif true: # header note\n  print(\"# literal\") # statement note\nelse: # continuation note\n  pass\n");
    cst_check(inline_comments.valid==1&&script_syntax_cst_valid(inline_comments)==1&&
        inline_comments.lines.data[1].header_kind==2&&
        inline_comments.lines.data[3].header_kind==4,
        "inline Script comments stay outside CST headers",&fail);
    let inline_view:[]u8=script_syntax_normalize(
        "script; # profile note\nif true: # header note\n  print(\"# literal\") # statement note\nelse: # continuation note\n  pass\n");
    cst_check(zs_find(inline_view,"if (true) {")>=0&&zs_find(inline_view,"else {")>=0&&
        zs_find(inline_view,"println(\"# literal\");")>=0&&
        zs_find(inline_view,"header note")<0&&zs_find(inline_view,"statement note")<0,
        "inline comments are stripped only from normalized code",&fail);
    let slash_comment_view:[]u8=script_syntax_normalize(
        "script;\n// .allocator .device .layout\nprintln(\"slash comment\");\n");
    cst_check(zs_find(slash_comment_view,"// .allocator .device .layout")>=0&&
        zs_find(slash_comment_view,"println(\"slash comment\");")>=0,
        "strict slash comments remain trivia in Script projection",&fail);
    let cst_expr_view:[]u8=script_syntax_normalize(
        "script;\nif choose(1, 2) and text == \"=\":\n  print(values[choose(0, 1)])\n");
    cst_check(zs_find(cst_expr_view,"if (choose(1, 2) && text == \"=\") {")>=0&&
        zs_find(cst_expr_view,"println(item_at(values, choose(0, 1)));")>=0,
        "header and nested expression lowering consumes CST token ranges",&fail);
    let cst_statement_view:[]u8=script_syntax_normalize(
        "script;\nvalues = [choose(1, 2) and text == \"=\"]\nvalues.append(choose(0, 1) or False)\nprint(values[choose(0, 1)])\n");
    cst_check(zs_find(cst_statement_view,"list(choose(1, 2) && text == \"=\");")>=0&&
        zs_find(cst_statement_view,"append(values, choose(0, 1) || false);")>=0&&
        zs_find(cst_statement_view,"println(item_at(values, choose(0, 1)));")>=0,
        "assignment append and ordinary expressions consume CST token ranges",&fail);
    let bad_if:ZsCst=script_syntax_cst("script;\nif true\n  print(1)\n");
    cst_check(bad_if.valid==0&&bad_if.recoveries.len==1&&
        bad_if.recoveries.data[0].kind==6&&script_syntax_cst_valid(bad_if)==0,
        "missing header colon records localized recovery",&fail);
    let bad_for:ZsCst=script_syntax_cst("script;\nfor value range(2):\n  print(value)\n");
    cst_check(bad_for.valid==0&&bad_for.recoveries.len==1&&
        bad_for.recoveries.data[0].kind==6&&script_syntax_cst_valid(bad_for)==0,
        "malformed for header fails closed",&fail);
    let bad_for_binding:ZsCst=script_syntax_cst(
        "script;\nfor 1 in range(2):\n  pass\n");
    cst_check(bad_for_binding.valid==0&&bad_for_binding.recoveries.len==1&&
        bad_for_binding.recoveries.data[0].kind==6&&
        script_syntax_cst_valid(bad_for_binding)==0,
        "for binding must be a shared-lexer identifier",&fail);
    let bad_for_separator:ZsCst=script_syntax_cst(
        "script;\nfor value each in range(2):\n  pass\n");
    cst_check(bad_for_separator.valid==0&&bad_for_separator.recoveries.len==1&&
        bad_for_separator.recoveries.data[0].kind==6&&
        script_syntax_cst_valid(bad_for_separator)==0,
        "for separator must be the token-derived `in` boundary",&fail);
    let bad_def:ZsCst=script_syntax_cst("script;\ndef :\n  pass\n");
    cst_check(bad_def.valid==0&&bad_def.recoveries.len==1&&
        bad_def.recoveries.data[0].kind==6&&script_syntax_cst_valid(bad_def)==0,
        "malformed def header fails closed",&fail);

    let same:ZsCst=script_syntax_cst(source);
    cst_check(cst.lines.data[0].origin_id==same.lines.data[0].origin_id&&
        cst.lines.data[3].origin_id==same.lines.data[3].origin_id,
        "stable origin IDs",&fail);
    cst_check(cst.lines.data[0].origin_id!=cst.lines.data[1].origin_id,
        "distinct source origins",&fail);

    let projected:ZsNormalized=script_syntax_normalize_with_origins(source);
    let cursor:i32=0;let i:i32=0;let ordered:i32=1;
    while(i<projected.origins.len){
        let segment:ZsOriginSegment=projected.origins.data[i];
        if(segment.generated_start!=cursor||segment.generated_end<=segment.generated_start||
            segment.source_start<0||segment.source_end<segment.source_start||segment.origin_id<0){ordered=0;}
        cursor=segment.generated_end;i=i+1;
    }
    cst_check(projected.origins.len>0&&ordered==1&&cursor==projected.source.len,
        "complete ordered generated-origin coverage",&fail);
    cst_check(zs_find(projected.source,"if (true) {")>=0&&
        zs_find(projected.source,"println(\"λ\");")>=0,
        "CST feeds ordinary Zag normalization",&fail);
    let continuation_source:[]u8="script;\nif true:\n    print(1)\nelse:\n    print(2)\n";
    let continuation_view:ZsNormalized=script_syntax_normalize_with_origins(continuation_source);
    cst_check(zs_find(continuation_view.source,"if (true) {")>=0&&
        zs_find(continuation_view.source,"else {")>=0&&
        zs_find(continuation_view.source,"println(2);")>=0,
        "same-level else continuation survives CST dedent",&fail);
    let python_shape_source:[]u8="script;\n\ndef doubled(value):\n    return value * 2\n\nscores = [8, 10, 6]\nscores.append(9)\n\nif len(scores) == 4:\n    print(scores[2])\nelse:\n    return 1\n";
    let python_shape_view:ZsNormalized=script_syntax_normalize_with_origins(python_shape_source);
    cst_check(zs_find(python_shape_view.source,"else {")>=0,
        "function followed by top-level else continuation",&fail);
    let token_header_view:ZsNormalized=script_syntax_normalize_with_origins(
        "script;\nlet n:i32=0\nif n < 2:\n    n = n + 1\nelif n == 2:\n    n = 3\nwhile n < 4:\n    n = n + 1\nfor x in range(2):\n    n = n + x\n");
    cst_check(zs_find(token_header_view.source,"if (n < 2)")>=0&&
        zs_find(token_header_view.source,"else if (n == 2)")>=0&&
        zs_find(token_header_view.source,"while (n < 4)")>=0&&
        zs_find(token_header_view.source,"for (0..2) |x|")>=0,
        "header expressions lower from CST token spans",&fail);
    let conditional_source:[]u8="script;\nif  true  : # header note\n  pass\n";
    let conditional_cst:ZsCst=script_syntax_cst(conditional_source);
    let conditional_node:ZsCstLine=conditional_cst.lines.data[1];
    let conditional_bounds:ZsHeaderBounds=zs_cst_header_bounds(conditional_source,
        conditional_node,conditional_cst.tokens);
    cst_check(conditional_bounds.valid==1&&
        @strEq(conditional_source[conditional_bounds.expr_start..conditional_bounds.expr_end],"true")&&
        @strEq(conditional_source[conditional_bounds.colon_start..conditional_bounds.colon_end],":"),
        "conditional expression and colon bounds come from CST tokens",&fail);
    let missing_colon_cst:ZsCst=script_syntax_cst("script;\nwhile true\n  pass\n");
    cst_check(zs_cst_header_bounds("script;\nwhile true\n  pass\n",
        missing_colon_cst.lines.data[1],missing_colon_cst.tokens).valid==0,
        "missing conditional colon has no projected header bounds",&fail);
    let trailing_operator_source:[]u8="script;\nvalue = 1 +\n";
    let trailing_operator_cst:ZsCst=script_syntax_cst(trailing_operator_source);
    let multiline_operator_cst:ZsCst=script_syntax_cst(
        "script;\nvalue = choose(\n  1 +\n  2\n)\n");
    cst_check(trailing_operator_cst.valid==0&&
        trailing_operator_cst.recoveries.len==1&&
        trailing_operator_cst.recoveries.data[0].kind==11&&
        trailing_operator_cst.recoveries.data[0].byte_start==18&&
        trailing_operator_cst.recoveries.data[0].byte_end==19&&
        trailing_operator_cst.recoveries.data[0].line==2&&
        trailing_operator_cst.recoveries.data[0].message.len>0&&
        trailing_operator_cst.recoveries.data[0].origin_id==
            zs_origin_id(trailing_operator_cst.source,18,19,2)&&
        script_syntax_cst_valid(trailing_operator_cst)==0&&
        multiline_operator_cst.valid==1&&
        multiline_operator_cst.recoveries.len==0&&
        script_syntax_cst_valid(multiline_operator_cst)==1,
        "top-level trailing operator recovers while delimiter continuation defers",&fail);
    let trailing_member_source:[]u8="script;\nvalue = item.\n";
    let trailing_member_cst:ZsCst=script_syntax_cst(trailing_member_source);
    let complete_member_cst:ZsCst=script_syntax_cst(
        "script;\nvalue = item.field\n");
    cst_check(trailing_member_cst.valid==0&&
        trailing_member_cst.recoveries.len==1&&
        trailing_member_cst.recoveries.data[0].kind==12&&
        trailing_member_cst.recoveries.data[0].byte_start==20&&
        trailing_member_cst.recoveries.data[0].byte_end==21&&
        trailing_member_cst.recoveries.data[0].line==2&&
        trailing_member_cst.recoveries.data[0].message.len>0&&
        trailing_member_cst.recoveries.data[0].origin_id==
            zs_origin_id(trailing_member_cst.source,20,21,2)&&
        script_syntax_cst_valid(trailing_member_cst)==0&&
        complete_member_cst.valid==1&&complete_member_cst.recoveries.len==0&&
        script_syntax_cst_valid(complete_member_cst)==1,
        "incomplete member access recovers while complete access remains indexed",&fail);
    let malformed_interpolation_cst:ZsCst=script_syntax_cst(
        "script;\nvalue = \"hello {name\"\n");
    let complete_interpolation_cst:ZsCst=script_syntax_cst(
        "script;\nvalue = \"hello {name}\"\n");
    let escaped_interpolation_cst:ZsCst=script_syntax_cst(
        "script;\nvalue = \"hello {{name}}\"\n");
    cst_check(malformed_interpolation_cst.valid==0&&
        malformed_interpolation_cst.recoveries.len==1&&
        malformed_interpolation_cst.recoveries.data[0].kind==13&&
        malformed_interpolation_cst.recoveries.data[0].byte_start==23&&
        malformed_interpolation_cst.recoveries.data[0].byte_end==24&&
        malformed_interpolation_cst.recoveries.data[0].line==2&&
        malformed_interpolation_cst.recoveries.data[0].origin_id==
            zs_origin_id(malformed_interpolation_cst.source,23,24,2)&&
        script_syntax_cst_valid(malformed_interpolation_cst)==0&&
        complete_interpolation_cst.valid==1&&
        complete_interpolation_cst.recoveries.len==0&&
        escaped_interpolation_cst.valid==1&&
        escaped_interpolation_cst.recoveries.len==0,
        "malformed interpolation braces recover while complete and escaped braces remain valid",&fail);
    let range_source:[]u8="script;\nfor x in range ( 0 , choose(1, 2) ) :\n    n = n + x\n";
    let range_tokens:ZsNormalized=script_syntax_normalize_with_origins(range_source);
    cst_check(zs_find(range_tokens.source,"for (0..choose(1, 2)) |x|")>=0,
        "range bounds use nested token spans",&fail);
    let range_cst:ZsCst=script_syntax_cst(range_source);
    let range_node:ZsCstLine=range_cst.lines.data[1];
    let range_bounds:ZsForExprBounds=zs_cst_for_expr_bounds(range_source,
        range_node,range_cst.tokens);
    cst_check(range_bounds.valid==1&&range_bounds.is_range==1&&
        @strEq(range_source[range_bounds.lower_start..range_bounds.lower_end],"0")&&
        @strEq(range_source[range_bounds.upper_start..range_bounds.upper_end],"choose(1, 2)"),
        "for range lower and upper spans come from shared CST tokens",&fail);
    let collection_source:[]u8="script;\nfor item in values[choose(0, 1)]:\n    print(item)\n";
    let collection_cst:ZsCst=script_syntax_cst(collection_source);
    let collection_node:ZsCstLine=collection_cst.lines.data[1];
    let collection_bounds:ZsForExprBounds=zs_cst_for_expr_bounds(collection_source,
        collection_node,collection_cst.tokens);
    cst_check(collection_bounds.valid==1&&collection_bounds.is_range==0&&
        @strEq(collection_source[collection_bounds.collection_start..
            collection_bounds.collection_end],"values[choose(0, 1)]"),
        "for collection span comes from shared CST tokens",&fail);
    let expr_source:[]u8="script;\nvalue = choose(1, 2)\n";
    let expr_cst:ZsCst=script_syntax_cst(expr_source);
    let expr_node:ZsCstLine=expr_cst.lines.data[1];
    let expr_first:ZsCstToken=expr_cst.tokens.data[expr_node.token_start];
    let expr_bad_cut:ZsExprTokenBounds=zs_cst_expr_token_bounds(expr_source,
        expr_cst.tokens,expr_first.byte_start+1,expr_first.byte_end);
    let expr_bad_empty:ZsExprTokenBounds=zs_cst_expr_token_bounds(expr_source,
        expr_cst.tokens,expr_first.byte_end,expr_first.byte_end);
    cst_check(expr_bad_cut.valid==0&&expr_bad_empty.valid==0,
        "malformed expression token intervals fail closed",&fail);

    let strict:[]u8="fn main() i32 { return 0; }";
    let strict_view:ZsNormalized=script_syntax_normalize_with_origins(strict);
    cst_check(@strEq(strict_view.source,strict) as i32,
        "strict Zag remains byte exact",&fail);
    cst_check(strict_view.origins.len==1&&strict_view.origins.data[0].exact==1,
        "identity projection is explicitly exact",&fail);
    let equal_len:ZsNormalized=script_syntax_normalize_with_origins("script;\nreturn None;\n");
    cst_check(equal_len.origins.len>=2&&equal_len.origins.data[1].exact==0,
        "equal-length rewrites are not misclassified as exact",&fail);
    let no_newline:[]u8="script;\nreturn 7";
    cst_check(@strEq(script_syntax_cst_reconstruct(script_syntax_cst(no_newline)),no_newline) as i32,
        "final line without newline is lossless",&fail);
    let string_header:[]u8=script_syntax_normalize("script;\nvalue = \"if true:\"\n");
    cst_check(zs_find(string_header,"if ( ")<0&&zs_find(string_header,"if (true)")<0,
        "string contents cannot become a header",&fail);
    cst_check(zs_find_assignment_token("value = \"a=b\"")==6&&
        zs_find_assignment_token("value == 1")==-1&&
        zs_find_assignment_token("call(value = 1)")==-1,
        "top-level assignment comes from shared tokens",&fail);
    let statement_source:[]u8="script;\nvalue = call(\"a=b\", other == 1)\n";
    let statement_cst:ZsCst=script_syntax_cst(statement_source);
    let statement_node:ZsCstLine=statement_cst.lines.data[1];
    let statement_bounds:ZsAssignmentBounds=zs_assignment_bounds_cst(statement_source,
        statement_node,statement_cst.tokens,statement_node.content_start,
        statement_node.content_end);
    let statement_eq:i32=zs_find_assignment_cst(statement_source,statement_node,
        statement_cst.tokens,statement_node.content_start,statement_node.content_end);
    let statement_append:ZsAppendBounds=zs_append_bounds_cst(statement_source,
        statement_node,statement_cst.tokens,statement_node.content_start,
        statement_node.content_end);
    cst_check(statement_eq==6&&statement_bounds.eq==6&&
        statement_bounds.annotation_colon<0&&statement_append.valid==0,
        "statement boundaries come from the enclosing CST token range",&fail);
    let typed_assignment_source:[]u8="script;\nlet value: Pair[i32, i64] = 1\n";
    let typed_assignment_cst:ZsCst=script_syntax_cst(typed_assignment_source);
    let typed_assignment_node:ZsCstLine=typed_assignment_cst.lines.data[1];
    let typed_assignment:ZsAssignmentBounds=zs_assignment_bounds_cst(
        typed_assignment_source,typed_assignment_node,typed_assignment_cst.tokens,
        typed_assignment_node.content_start,typed_assignment_node.content_end);
    cst_check(typed_assignment.valid==1&&typed_assignment.annotation_colon>0&&
