@import("script_syntax.zag")

fn cst_check(ok:i32,name:[]u8,fail:*i32)void{
    if(ok==1){_zag_println(_zag_str_concat("ok  ",name));}
    else{_zag_eprintln(_zag_str_concat("XX  ",name));fail.*=fail.*+1;}
}

fn main()i32{
    let fail:i32=0;
    let source:[]u8="script;\r\n# café  \r\nif true:\r\n\tprint(\"λ\")\r\n";
    let cst:ZsCst=script_syntax_cst(source);
    cst_check(cst.valid==1,"CST valid",&fail);
    cst_check(script_syntax_cst_valid(cst)==1,"CST validates parser boundary",&fail);
    cst_check(@strEq(script_syntax_cst_reconstruct(cst),source) as i32,
        "lossless CRLF Unicode reconstruction",&fail);
    cst_check(cst.lines.len==5,"logical lines include terminal blank",&fail);
    cst_check(cst.lines.data[0].raw_start==0&&cst.lines.data[0].raw_end==9&&
        cst.lines.data[0].content_start==0&&cst.lines.data[0].content_end==7,
        "exact first-line byte span",&fail);
    cst_check(cst.lines.data[1].kind==1&&cst.lines.data[2].kind==3&&
        cst.lines.data[3].indent==1,"comment block and indentation kinds",&fail);
    cst_check(cst.tokens.len>=9&&cst.lines.data[0].token_start==0&&
        cst.lines.data[0].token_end==2&&cst.tokens.data[0].kind==1&&
        @strEq(source[cst.tokens.data[0].byte_start..cst.tokens.data[0].byte_end],"script"),
        "token spans retain source bytes",&fail);
    let shared_tokens:ArrayList[Token]=lex(source);let shared_count:i32=0;let si:i32=0;
    while(si<shared_tokens.len){if(tk_code(shared_tokens.data[si].kind)!=tk_code(Tk.Eof)){shared_count=shared_count+1;}si=si+1;}
    cst_check(cst.tokens.len==shared_count,"CST token index uses shared lexer stream",&fail);
    cst_check(cst.layouts.len==2&&cst.layouts.data[0].kind==1&&
        cst.layouts.data[0].indent==1&&cst.layouts.data[1].kind==3,
        "indent and EOF-dedent layout events",&fail);
    let token_cursor:i32=0;let ti:i32=0;let token_ordered:i32=1;
    while(ti<cst.tokens.len){
        let tok:ZsCstToken=cst.tokens.data[ti];
        if(tok.byte_start<0||tok.byte_end<=tok.byte_start||
            tok.byte_end>source.len||tok.byte_start<token_cursor||tok.line<1||tok.col<1){token_ordered=0;}
        token_cursor=tok.byte_end;ti=ti+1;
    }
    cst_check(token_ordered==1,"token spans are ordered and bounded",&fail);
    cst_check(cst.lines.data[0].token_start==0&&
        cst.lines.data[1].token_end>cst.lines.data[1].token_start&&
        cst.lines.data[2].token_end>cst.lines.data[2].token_start&&
        cst.lines.data[4].token_start==cst.lines.data[4].token_end,
        "each line carries an exact token range",&fail);
    let token_same:ZsCst=script_syntax_cst(source);
    cst_check(token_same.tokens.len==cst.tokens.len&&
        token_same.tokens.data[2].origin_id==cst.tokens.data[2].origin_id,
        "token origin IDs are stable",&fail);
    let broken:ZsCst=script_syntax_cst(source);
    broken.lines.data[0].token_start=1;
    cst_check(script_syntax_cst_valid(broken)==0,
        "invalid CST token range fails closed",&fail);
    let reordered:ZsCst=script_syntax_cst(source);
    let first_start:i32=reordered.tokens.data[0].byte_start;
    let first_end:i32=reordered.tokens.data[0].byte_end;
    reordered.tokens.data[0].byte_start=reordered.tokens.data[1].byte_start;
    reordered.tokens.data[0].byte_end=reordered.tokens.data[1].byte_end;
    reordered.tokens.data[1].byte_start=first_start;
    reordered.tokens.data[1].byte_end=first_end;
    cst_check(script_syntax_cst_valid(reordered)==0,
        "out-of-order CST token spans fail closed",&fail);
    let bad_layout:ZsCst=script_syntax_cst("script;\nif true:\n  print(1)\n print(2)\n");
    cst_check(bad_layout.valid==0&&bad_layout.recoveries.len==1&&
        bad_layout.recoveries.data[0].kind==1&&
        bad_layout.recoveries.data[0].byte_start==bad_layout.lines.data[3].content_start&&
        script_syntax_cst_valid(bad_layout)==0,
        "inconsistent dedent fails closed",&fail);
    let broken_recovery:ZsCst=script_syntax_cst("script;\nif true:\n  print(1)\n print(2)\n");
    broken_recovery.recoveries.data[0].byte_end=broken_recovery.source.len+1;
    cst_check(script_syntax_cst_valid(broken_recovery)==0,
        "invalid recovery span fails closed",&fail);
    let strict_columns:ZsCst=script_syntax_cst("fn main() i32 {\n  return 0;\n return 1;\n}");
    cst_check(strict_columns.valid==0&&script_syntax_cst_valid(strict_columns)==1,
        "strict brace source ignores indentation recovery",&fail);
    let mixed_indent:ZsCst=script_syntax_cst("script;\n\t print(1)\n");
    cst_check(mixed_indent.valid==0&&mixed_indent.recoveries.len==1&&
        mixed_indent.recoveries.data[0].kind==2&&
        script_syntax_cst_valid(mixed_indent)==0,
        "mixed indentation records recovery and fails closed",&fail);
    let malformed:ArrayList[u8]=make[u8](16);
    push[u8](&malformed,'s');push[u8](&malformed,'c');push[u8](&malformed,'r');
    push[u8](&malformed,'i');push[u8](&malformed,'p');push[u8](&malformed,'t');
    push[u8](&malformed,';');push[u8](&malformed,10);push[u8](&malformed,255);
    let malformed_cst:ZsCst=script_syntax_cst(malformed.data[0..malformed.len]);
    cst_check(malformed_cst.valid==0&&malformed_cst.recoveries.len==1&&
        malformed_cst.recoveries.data[0].kind==3&&
        script_syntax_cst_valid(malformed_cst)==0,
        "invalid UTF-8 source records recovery and fails closed",&fail);
    let nul_source:ArrayList[u8]=make[u8](9);
    push[u8](&nul_source,'s');push[u8](&nul_source,'c');push[u8](&nul_source,'r');
    push[u8](&nul_source,'i');push[u8](&nul_source,'p');push[u8](&nul_source,'t');
    push[u8](&nul_source,';');push[u8](&nul_source,10);push[u8](&nul_source,0);
    let nul_cst:ZsCst=script_syntax_cst(nul_source.data[0..nul_source.len]);
    cst_check(nul_cst.valid==0&&nul_cst.recoveries.len==1&&
        nul_cst.recoveries.data[0].kind==3&&
        script_syntax_cst_valid(nul_cst)==0,
        "NUL source records recovery and fails closed",&fail);

    let same:ZsCst=script_syntax_cst(source);
    cst_check(cst.lines.data[0].origin_id==same.lines.data[0].origin_id&&
        cst.lines.data[3].origin_id==same.lines.data[3].origin_id,
        "stable origin IDs",&fail);
    cst_check(cst.lines.data[0].origin_id!=cst.lines.data[1].origin_id,
        "distinct source origins",&fail);

    let projected:ZsNormalized=script_syntax_normalize_with_origins(source);
    let cursor:i32=0;let i:i32=0;let ordered:i32=1;
    while(i<projected.origins.len){
        let segment:ZsOriginSegment=projected.origins.data[i];
        if(segment.generated_start!=cursor||segment.generated_end<=segment.generated_start||
            segment.source_start<0||segment.source_end<segment.source_start||segment.origin_id<0){ordered=0;}
        cursor=segment.generated_end;i=i+1;
    }
    cst_check(projected.origins.len>0&&ordered==1&&cursor==projected.source.len,
        "complete ordered generated-origin coverage",&fail);
    cst_check(zs_find(projected.source,"if (true) {")>=0&&
        zs_find(projected.source,"println(\"λ\");")>=0,
        "CST feeds ordinary Zag normalization",&fail);
    let continuation_source:[]u8="script;\nif true:\n    print(1)\nelse:\n    print(2)\n";
    let continuation_view:ZsNormalized=script_syntax_normalize_with_origins(continuation_source);
    cst_check(zs_find(continuation_view.source,"if (true) {")>=0&&
        zs_find(continuation_view.source,"else {")>=0&&
        zs_find(continuation_view.source,"println(2);")>=0,
        "same-level else continuation survives CST dedent",&fail);
    let python_shape_source:[]u8="script;\n\ndef doubled(value):\n    return value * 2\n\nscores = [8, 10, 6]\nscores.append(9)\n\nif len(scores) == 4:\n    print(scores[2])\nelse:\n    return 1\n";
    let python_shape_view:ZsNormalized=script_syntax_normalize_with_origins(python_shape_source);
    cst_check(zs_find(python_shape_view.source,"else {")>=0,
        "function followed by top-level else continuation",&fail);

    let strict:[]u8="fn main() i32 { return 0; }";
    let strict_view:ZsNormalized=script_syntax_normalize_with_origins(strict);
    cst_check(@strEq(strict_view.source,strict) as i32,
        "strict Zag remains byte exact",&fail);
    cst_check(strict_view.origins.len==1&&strict_view.origins.data[0].exact==1,
        "identity projection is explicitly exact",&fail);
    let equal_len:ZsNormalized=script_syntax_normalize_with_origins("script;\nreturn None;\n");
    cst_check(equal_len.origins.len>=2&&equal_len.origins.data[1].exact==0,
        "equal-length rewrites are not misclassified as exact",&fail);
    let no_newline:[]u8="script;\nreturn 7";
    cst_check(@strEq(script_syntax_cst_reconstruct(script_syntax_cst(no_newline)),no_newline) as i32,
        "final line without newline is lossless",&fail);
    let string_header:[]u8=script_syntax_normalize("script;\nvalue = \"if true:\"\n");
    cst_check(zs_find(string_header,"if ( ")<0&&zs_find(string_header,"if (true)")<0,
        "string contents cannot become a header",&fail);
    if(fail==0){_zag_println("script-cst pass=31 fail=0");return 0;}
    return 1;
}
