            typed_assignment.annotation_colon]==':',
        "typed assignment annotation colon comes from CST tokens",&fail);
    let inferred_source:[]u8="script;\ncount = 1 + 2\nready = true and false\n";
    let inferred_cst:ZsCst=script_syntax_cst(inferred_source);
    let inferred_bindings:ArrayList[ZsInterpBinding]=make[ZsInterpBinding](4);
    let inferred_count_node:ZsCstLine=inferred_cst.lines.data[1];
    let inferred_ready_node:ZsCstLine=inferred_cst.lines.data[2];
    let inferred_count:ZsAssignmentBounds=zs_assignment_bounds_cst(inferred_source,
        inferred_count_node,inferred_cst.tokens,inferred_count_node.content_start,
        inferred_count_node.content_end);
    let inferred_ready:ZsAssignmentBounds=zs_assignment_bounds_cst(inferred_source,
        inferred_ready_node,inferred_cst.tokens,inferred_ready_node.content_start,
        inferred_ready_node.content_end);
    cst_check(zs_interp_expr_kind_cst(inferred_source,inferred_count_node,
        inferred_cst.tokens,inferred_count_node.content_start,
        inferred_count_node.content_end,inferred_count,inferred_bindings)==2&&
        zs_interp_expr_kind_cst(inferred_source,inferred_ready_node,
        inferred_cst.tokens,inferred_ready_node.content_start,
        inferred_ready_node.content_end,inferred_ready,inferred_bindings)==3,
        "assignment type facts consume shared CST RHS tokens",&fail);
    let map_literal_source:[]u8="script;\nlet values = {-1: 10, 1: 20};\n";
    let map_literal_cst:ZsCst=script_syntax_cst(map_literal_source);
    let map_literal_view:[]u8=script_syntax_normalize(map_literal_source);
    cst_check(zs_has_script_map_literal_cst(map_literal_source,map_literal_cst)==1&&
        zs_find(map_literal_view,"map();")>=0&&
        zs_find(map_literal_view,"map_put(values, -1, 10);")>=0&&
        zs_find(map_literal_view,"map_put(values, 1, 20);")>=0&&
        zs_map_i32_magnitude("2147483647",2147483647)==1&&
        zs_map_i32_magnitude("2147483648",2147483647)==0&&
        zs_map_i32_magnitude("0x7fffffff",2147483647)==1&&
        zs_map_i32_magnitude("0x80000000",2147483647)==0&&
        zs_map_i32_magnitude("0x80000000",2147483648)==1&&
        zs_map_i32_magnitude("1",0)==0&&
        zs_map_i32_magnitude("0x",2147483647)==0&&
        zs_map_i32_magnitude("0x__",2147483647)==0&&
        zs_map_i32_magnitude("18446744073709551616",2147483647)==0,
        "homogeneous integer map literals lower through CST calls",&fail);
    let strict_map_source:[]u8="script;\nlet values = {1: 10};\nif (map_get(values, 1) != 10) { return 1; }\nif (true) {\n    let nested = {3: 30};\n    if (map_get(nested, 3) != 30) { return 2; }\n}\nreturn 0;\n";
    let strict_map_view:ZsNormalized=script_syntax_normalize_with_origins(strict_map_source);
    let nested_only_source:[]u8="script;\nif (true) {\n    let nested = {3: 30};\n    if (map_get(nested, 3) != 30) { return 1; }\n}\nreturn 0;\n";
    let nested_only_cst:ZsCst=script_syntax_cst(nested_only_source);
    let nested_only_view:ZsNormalized=script_syntax_normalize_with_origins(nested_only_source);
    cst_check(zs_find(strict_map_view.source,"map_put(values, 1, 10);")>=0&&
        zs_find(strict_map_view.source,"map_put(nested, 3, 30);")>=0&&
        zs_find(strict_map_view.source,"if (map_get(values, 1) != 10) { return 1; }")>=0&&
        zs_find(strict_map_view.source,"};")<0&&strict_map_view.origins.len>=4&&
        zs_has_script_map_literal_cst(nested_only_source,nested_only_cst)==1&&
        zs_find(nested_only_view.source,"map_put(nested, 3, 30);")>=0&&
        zs_find(nested_only_view.source,"if (true) {")>=0,
        "strict-brace Script rewrites only map literal assignments",&fail);
    let strict_cursor:i32=0;let strict_source_cursor:i32=0;
    let strict_ordered:i32=1;let strict_inexact:i32=0;let strict_i:i32=0;
    while(strict_i<strict_map_view.origins.len){
        let segment:ZsOriginSegment=strict_map_view.origins.data[strict_i];
        if(segment.generated_start!=strict_cursor||
           segment.generated_end<=segment.generated_start||
           segment.generated_end>strict_map_view.source.len||
           segment.source_start!=strict_source_cursor||
           segment.source_end<=segment.source_start||
           segment.source_end>strict_map_source.len||segment.origin_id<0||
           (segment.exact!=0&&segment.exact!=1)){strict_ordered=0;}
        if(segment.exact==0){strict_inexact=strict_inexact+1;}
        strict_cursor=segment.generated_end;strict_source_cursor=segment.source_end;
        strict_i=strict_i+1;
    }
    cst_check(strict_ordered==1&&strict_cursor==strict_map_view.source.len&&
        strict_source_cursor==strict_map_source.len&&strict_inexact==2,
        "strict-map origins cover generated and source ranges",&fail);
    let text_map_literal_source:[]u8="script;\nlet values = {\"alpha\": \"one\", \"\": \"empty\"};\n";
    let text_map_literal_cst:ZsCst=script_syntax_cst(text_map_literal_source);
    let text_map_literal_view:[]u8=script_syntax_normalize(text_map_literal_source);
    cst_check(zs_has_script_map_literal_cst(text_map_literal_source,text_map_literal_cst)==1&&
        zs_find(text_map_literal_view,"text_map();")>=0&&
        zs_find(text_map_literal_view,"text_map_put(values, \"alpha\", \"one\");")>=0&&
        zs_find(text_map_literal_view,"text_map_put(values, \"\", \"empty\");")>=0,
        "homogeneous text map literals lower through CST calls",&fail);
    let multiline_map_source:[]u8="script;\nlet values = {\n    1: 10,\n    2: 20\n};\nreturn map_len(values);\n";
    let multiline_map_cst:ZsCst=script_syntax_cst(multiline_map_source);
    let multiline_map_view:ZsNormalized=script_syntax_normalize_with_origins(
        multiline_map_source);
    cst_check(zs_has_script_map_literal_cst(multiline_map_source,multiline_map_cst)==1&&
        zs_find(multiline_map_view.source,"map_put(values, 1, 10);")>=0&&
        zs_find(multiline_map_view.source,"map_put(values, 2, 20);")>=0&&
        multiline_map_view.origins.len>=3,
        "multiline integer map literals lower through one CST envelope",&fail);
    let multiline_text_map_source:[]u8="script;\nlet values = {\n    \"alpha\": \"one\",\n    \"beta\": \"two\"\n};\nreturn text_map_len(values);\n";
    let multiline_text_map_cst:ZsCst=script_syntax_cst(multiline_text_map_source);
    let multiline_text_map_view:ZsNormalized=script_syntax_normalize_with_origins(
        multiline_text_map_source);
    cst_check(zs_has_script_map_literal_cst(multiline_text_map_source,
        multiline_text_map_cst)==1&&
        zs_find(multiline_text_map_view.source,
            "text_map_put(values, \"alpha\", \"one\");")>=0&&
        zs_find(multiline_text_map_view.source,
            "text_map_put(values, \"beta\", \"two\");")>=0,
        "multiline text map literals lower through one CST envelope",&fail);
    let text_map_escape_source:[]u8=
        "script;\nlet values = {\"{{key}}\": \"{{value}}\"};\n";
    let text_map_escape_cst:ZsCst=script_syntax_cst(text_map_escape_source);
    let text_map_escape_bounds:ZsMapLiteralBounds=cst_text_map_bounds(
        text_map_escape_source,text_map_escape_cst);
    let text_map_escape_view:ZsNormalized=script_syntax_normalize_with_origins(
        text_map_escape_source);
    let text_map_escape_origin:i32=0;let text_map_escape_origin_i:i32=0;
    while(text_map_escape_origin_i<text_map_escape_view.origins.len){
        let segment:ZsOriginSegment=text_map_escape_view.origins.data[text_map_escape_origin_i];
        if(segment.source_start==text_map_escape_cst.lines.data[1].raw_start&&
           segment.source_end==text_map_escape_cst.lines.data[1].raw_end&&
           segment.origin_id==text_map_escape_cst.lines.data[1].origin_id&&
           segment.exact==0){text_map_escape_origin=1;}
        text_map_escape_origin_i=text_map_escape_origin_i+1;
    }
    cst_check(text_map_escape_bounds.valid==1&&
        zs_find(text_map_escape_view.source,
            "text_map_put(values, \"{key}\", \"{value}\");")>=0&&
        text_map_escape_origin==1&&text_map_escape_cst.lines.data[1].raw_end>
            text_map_escape_cst.lines.data[1].raw_start,
        "text map doubled braces stay literal with source origin span",&fail);
    let text_map_key_interp_source:[]u8=
        "script;\nlet values = {\"{key}\": \"value\"};\n";
    let text_map_key_interp_cst:ZsCst=script_syntax_cst(text_map_key_interp_source);
    cst_check(zs_has_script_map_literal_cst(text_map_key_interp_source,
        text_map_key_interp_cst)==1&&
        cst_text_map_bounds(text_map_key_interp_source,text_map_key_interp_cst).valid==0,
        "text map key interpolation is rejected by CST bounds",&fail);
    let text_map_value_interp_source:[]u8=
        "script;\nlet values = {\"key\": \"{value}\"};\n";
    let text_map_value_interp_cst:ZsCst=script_syntax_cst(text_map_value_interp_source);
    cst_check(zs_has_script_map_literal_cst(text_map_value_interp_source,
        text_map_value_interp_cst)==1&&
        cst_text_map_bounds(text_map_value_interp_source,text_map_value_interp_cst).valid==0,
        "text map value interpolation is rejected by CST bounds",&fail);
    let text_map_empty_source:[]u8="script;\nlet values = {};\n";
    let text_map_empty_cst:ZsCst=script_syntax_cst(text_map_empty_source);
    cst_check(zs_has_script_map_literal_cst(text_map_empty_source,text_map_empty_cst)==1&&
        cst_text_map_bounds(text_map_empty_source,text_map_empty_cst).valid==0,
        "empty text map literal is rejected by CST bounds",&fail);
    let text_map_malformed_source:[]u8="script;\nlet values = {\"key\":};\n";
    let text_map_malformed_cst:ZsCst=script_syntax_cst(text_map_malformed_source);
    let text_map_mixed_source:[]u8="script;\nlet values = {\"key\": 1};\n";
    let text_map_mixed_cst:ZsCst=script_syntax_cst(text_map_mixed_source);
    cst_check(zs_has_script_map_literal_cst(text_map_malformed_source,
        text_map_malformed_cst)==1&&
        cst_text_map_bounds(text_map_malformed_source,text_map_malformed_cst).valid==0&&
        zs_has_script_map_literal_cst(text_map_mixed_source,text_map_mixed_cst)==1&&
        cst_text_map_bounds(text_map_mixed_source,text_map_mixed_cst).valid==0,
        "malformed text map entry forms fail closed",&fail);
    let text_map_nested_source:[]u8=
        "script;\nlet values = {\"outer\": {\"inner\": \"value\"}};\n";
    let text_map_nested_cst:ZsCst=script_syntax_cst(text_map_nested_source);
    cst_check(zs_has_script_map_literal_cst(text_map_nested_source,text_map_nested_cst)==1&&
        cst_text_map_bounds(text_map_nested_source,text_map_nested_cst).valid==0,
        "same-line nested text map literal is rejected",&fail);
    let nested_text_map_source:[]u8="script;\nif (true) {\n    let nested = {\"key\": \"value\"};\n    if (!text_map_has(nested, \"key\")) { return 1; }\n}\nreturn 0;\n";
    let nested_text_map_view:ZsNormalized=script_syntax_normalize_with_origins(nested_text_map_source);
    cst_check(zs_find(nested_text_map_view.source,
        "text_map_put(nested, \"key\", \"value\");")>=0&&
        zs_find(nested_text_map_view.source,"if (true) {")>=0,
        "strict-brace text map literals rewrite standalone nested lines",&fail);
    let append_source:[]u8="script;\nvalues.append(call(\")\"))\n";
    let append_cst:ZsCst=script_syntax_cst(append_source);
    let append_node:ZsCstLine=append_cst.lines.data[1];
    let append_cst_bounds:ZsAppendBounds=zs_append_bounds_cst(append_source,
        append_node,append_cst.tokens,append_node.content_start,
        append_node.content_end);
    cst_check(append_cst_bounds.valid==1&&append_cst_bounds.receiver_start==0&&
        append_cst_bounds.arg_end>append_cst_bounds.arg_start,
        "nested append bounds come from shared CST tokens",&fail);
    let nested_assignment:[]u8=script_syntax_normalize(
        "script;\nvalue = call(\"a=b\", other == 1)\n");
    cst_check(zs_find(nested_assignment,"call(\"a=b\", other == 1);")>=0,
        "nested equals remain expression syntax",&fail);
    let def_token_view:[]u8=script_syntax_normalize(
        "script;\ndef add(left, right) -> i32:\n    return left + right\n");
    cst_check(zs_find(def_token_view,"fn add(left:i64, right:i64) i32 {")>=0,
        "function delimiters and return type use shared tokens",&fail);
    let def_cst_source:[]u8="script;\ndef add (left: Pair[i32, i64], right) -> Result[i32, []u8]: # note\n    return right\n";
    let def_cst:ZsCst=script_syntax_cst(def_cst_source);
    let def_node:ZsCstLine=def_cst.lines.data[1];
    let def_bounds:ZsDefBounds=zs_def_bounds_cst(def_cst_source,def_node,
        def_cst.tokens,def_node.content_start,def_node.content_end);
    cst_check(def_bounds.valid==1&&
        @strEq(def_cst_source[def_node.content_start+def_bounds.name_start..
            def_node.content_start+def_bounds.name_end],"add")&&
        def_bounds.rp>def_bounds.lp&&def_bounds.ret_end>def_bounds.ret_start&&
        @strEq(def_cst_source[def_node.content_start+def_bounds.ret_start..
            def_node.content_start+def_bounds.ret_end],"Result[i32, []u8]"),
        "def name parameter and return bounds come from the CST token range",&fail);
    let def_param_probe:ArrayList[u8]=make[u8](32);
    cst_check(zs_emit_def_params_cst(&def_param_probe,def_cst_source,def_node,
        def_cst.tokens,def_node.content_start,def_bounds)==1&&
        @strEq(def_param_probe.data[0..def_param_probe.len],
            "left:Pair[i32, i64], right:i64"),
        "parameter segmentation and emission consume CST tokens",&fail);
    let malformed_nested_source:[]u8="script;\ndef broken(value: Pair[i32, []u8):\n    pass\n";
    let malformed_nested_cst:ZsCst=script_syntax_cst(malformed_nested_source);
    let malformed_nested_node:ZsCstLine=malformed_nested_cst.lines.data[1];
    let malformed_nested_bounds:ZsDefBounds=zs_def_bounds_cst(malformed_nested_source,
        malformed_nested_node,malformed_nested_cst.tokens,
        malformed_nested_node.content_start,malformed_nested_node.content_end);
    let malformed_default_source:[]u8="script;\ndef broken(value = 1):\n    pass\n";
    let malformed_default_cst:ZsCst=script_syntax_cst(malformed_default_source);
    let malformed_default_node:ZsCstLine=malformed_default_cst.lines.data[1];
    let malformed_default_bounds:ZsDefBounds=zs_def_bounds_cst(malformed_default_source,
        malformed_default_node,malformed_default_cst.tokens,
        malformed_default_node.content_start,malformed_default_node.content_end);
    let malformed_probe:ArrayList[u8]=make[u8](16);
    let nested_rejected:i32=zs_emit_def_params_cst(&malformed_probe,
        malformed_nested_source,malformed_nested_node,malformed_nested_cst.tokens,
        malformed_nested_node.content_start,malformed_nested_bounds);
    let default_rejected:i32=zs_emit_def_params_cst(&malformed_probe,
        malformed_default_source,malformed_default_node,malformed_default_cst.tokens,
        malformed_default_node.content_start,malformed_default_bounds);
    cst_check(malformed_nested_bounds.valid==1&&malformed_default_bounds.valid==1&&
        nested_rejected==0&&default_rejected==0,
        "malformed nested and default parameters fail closed",&fail);
    let def_comment_view:[]u8=script_syntax_normalize(def_cst_source);
    cst_check(zs_find(def_comment_view,"fn add(left:Pair[i32, i64], right:i64) Result[i32, []u8] {")>=0,
        "def lowering keeps shared-token bounds stable across trivia",&fail);
    let append_tokens:ZsAppendBounds=zs_append_bounds("values.append(call(\")\"))");
    let append_view:[]u8=script_syntax_normalize("script;\nvalues.append(call(\")\"))\n");
    cst_check(append_tokens.valid==1&&
        append_tokens.arg_end>append_tokens.arg_start&&
        zs_find(append_view,"append(values, call(\")\"));")>=0&&
        zs_append_bounds("call(values.append(1))").valid==0,
        "append lowering uses shared token boundaries",&fail);
    let crossed_delimiter_source:[]u8="script;\nvalue = call([1, 2)\n";
    let crossed_delimiter_cst:ZsCst=script_syntax_cst(crossed_delimiter_source);
    let crossed_delimiter_node:ZsCstLine=crossed_delimiter_cst.lines.data[1];
    let crossed_assignment:ZsAssignmentBounds=zs_assignment_bounds_cst(
        crossed_delimiter_source,crossed_delimiter_node,crossed_delimiter_cst.tokens,
        crossed_delimiter_node.content_start,crossed_delimiter_node.content_end);
    let crossed_expr:ZsExprTokenBounds=zs_cst_expr_token_bounds(
        crossed_delimiter_source,crossed_delimiter_cst.tokens,
        crossed_delimiter_node.content_start+crossed_assignment.rhs_start,
        crossed_delimiter_node.content_end);
    cst_check(crossed_assignment.valid==1&&crossed_expr.valid==0&&
        crossed_delimiter_cst.recoveries.len>0,
        "crossed nested delimiters fail closed with localized recovery",&fail);
    let generic_def_view:[]u8=script_syntax_normalize(
        "script;\ndef pair(first: Pair[i32, i64], second):\n    return second\n");
    cst_check(zs_find(generic_def_view,"fn pair(first:Pair[i32, i64], second:i64) i64 {")>=0,
        "parameter commas use nested shared-token depth",&fail);
    let parser_projection:ZsNormalized=script_syntax_normalize_with_origins(
        "script;\nlet n:i32=1\n");
    let parser_input:ZsParserInput=script_syntax_parser_input(parser_projection);
    cst_check(parser_input.tokens.len>0&&parser_input.cst.valid==1&&
        parser_input.origins.len>0,
        "shared parser input binds CST and origin projection",&fail);
    let forged_tokens:ArrayList[Token]=parser_input.tokens;
    forged_tokens.data[0].byte_start=parser_projection.source.len+1;
    cst_check(script_syntax_parser_tokens_valid(parser_projection,forged_tokens)==0,
        "shared parser input rejects an escaped token",&fail);
    if(fail==0){_zag_println("script-cst pass=112 fail=0");return 0;}
    return 1;
}
