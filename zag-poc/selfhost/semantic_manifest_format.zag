// Reader side of the foreground semantic manifest. Kept AST-free so zagd can
// validate compiler output without importing or reimplementing sema.
@import("zagd.zag")
struct SemanticManifestView { module:[]u8, source:ZagdHash, public_identity:ZagdHash, effect_identity:ZagdHash, layout_identity:ZagdHash, valid:i32 }
struct SemanticInvalidation { semantic_changed:i32, declaration_dependents:i32, layout_changed:i32, codegen_invalidated:i32, comment_only:i32 }
fn smf_value(text:[]u8,key:[]u8)[]u8{let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>key.len&&@strEq(line[0..key.len],key)&&line[key.len]=='='){return line[key.len+1..];}start=i+1;}i=i+1;}return "";}
fn smf_uint(s:[]u8)i64{if(s.len==0){return 0-1;}let n:i64=0;let i:i32=0;while(i<s.len){if(s[i]<'0'||s[i]>'9'){return 0-1;}n=n*10+((s[i] as i64)-48);i=i+1;}return n;}
fn smf_part(s:[]u8,want:i32)[]u8{let field:i32=0;let start:i32=0;let i:i32=0;while(i<=s.len){if(i==s.len||s[i]==','){if(field==want){return s[start..i];}field=field+1;start=i+1;}i=i+1;}return "";}
fn smf_hash(s:[]u8)ZagdHash{return ZagdHash{.first=smf_uint(smf_part(s,0)),.second=smf_uint(smf_part(s,1)),.bytes=smf_uint(smf_part(s,2))};}
fn smf_checksum_mark(text:[]u8)i32{let marker:[]u8="checksum=";let i:i32=0;while(i+marker.len<=text.len){let j:i32=0;while(j<marker.len&&text[i+j]==marker[j]){j=j+1;}if(j==marker.len&&(i==0||text[i-1]=='\n')){return i;}i=i+1;}return 0-1;}
fn semantic_manifest_decode(text:[]u8)SemanticManifestView{let bad:SemanticManifestView=SemanticManifestView{.module="",.source=zagd_hash_empty(),.public_identity=zagd_hash_empty(),.effect_identity=zagd_hash_empty(),.layout_identity=zagd_hash_empty(),.valid=0};if(!@strEq(smf_value(text,"format"),"zag-semantic-manifest-v1")||!@strEq(smf_value(text,"advisory"),"true")||!@strEq(smf_value(text,"executable_authority"),"false")||!@strEq(smf_value(text,"complete"),"true")){return bad;}let mark:i32=smf_checksum_mark(text);if(mark<0){return bad;}let checksum_text:[]u8=smf_value(text,"checksum");if(mark+9+checksum_text.len+1!=text.len){return bad;}let actual:ZagdHash=zagd_content_hash(text[0..mark]);let claimed:ZagdHash=smf_hash(checksum_text);if(zagd_hash_equal(actual,claimed)==0){return bad;}let source:ZagdHash=smf_hash(smf_value(text,"source"));let pubh:ZagdHash=smf_hash(smf_value(text,"public"));let effh:ZagdHash=smf_hash(smf_value(text,"effects"));let layh:ZagdHash=smf_hash(smf_value(text,"layouts"));if(source.first<0||source.second<0||source.bytes<0||pubh.first<0||effh.first<0||layh.first<0){return bad;}return SemanticManifestView{.module=smf_value(text,"module"),.source=source,.public_identity=pubh,.effect_identity=effh,.layout_identity=layh,.valid=1};}
fn semantic_manifest_direct_dependents(text:[]u8,changed:[]u8)i32{if(semantic_manifest_decode(text).valid==0){return 0;}let count:i32=0;let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>12&&@strEq(line[0..12],"import_edge=")){let edge:[]u8=line[12..];let tab:i32=0;while(tab<edge.len&&edge[tab]!='\t'){tab=tab+1;}if(tab<edge.len&&@strEq(edge[tab+1..],changed)){count=count+1;}}start=i+1;}i=i+1;}return count;}
fn smf_seen(items:ArrayList[[]u8],value:[]u8)i32{let i:i32=0;while(i<len[[]u8](items)){if(@strEq(get[[]u8](items,i),value)){return 1;}i=i+1;}return 0;}
// Reverse transitive closure: if A imports B and B changes publicly, A is
// affected. The explicit visited set makes diamonds deterministic and cycles
// finite. The changed module itself is not included in the returned count.
fn semantic_manifest_transitive_dependents(text:[]u8,changed:[]u8)i32{if(semantic_manifest_decode(text).valid==0){return 0;}let reached:ArrayList[[]u8]=make[[]u8](8);push[[]u8](&reached,changed);let cursor:i32=0;while(cursor<len[[]u8](reached)){let target:[]u8=get[[]u8](reached,cursor);let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>12&&@strEq(line[0..12],"import_edge=")){let edge:[]u8=line[12..];let tab:i32=0;while(tab<edge.len&&edge[tab]!='\t'){tab=tab+1;}if(tab<edge.len&&@strEq(edge[tab+1..],target)){let importer:[]u8=edge[0..tab];if(smf_seen(reached,importer)==0){push[[]u8](&reached,importer);}}}start=i+1;}i=i+1;}cursor=cursor+1;}return len[[]u8](reached)-1;}
fn semantic_manifest_transitive_callers(text:[]u8,changed:[]u8)i32{if(semantic_manifest_decode(text).valid==0){return 0;}let reached:ArrayList[[]u8]=make[[]u8](8);push[[]u8](&reached,changed);let cursor:i32=0;while(cursor<len[[]u8](reached)){let target:[]u8=get[[]u8](reached,cursor);let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>10&&@strEq(line[0..10],"call_edge=")){let edge:[]u8=line[10..];let tab:i32=0;while(tab<edge.len&&edge[tab]!='\t'){tab=tab+1;}if(tab<edge.len&&@strEq(edge[tab+1..],target)){let caller:[]u8=edge[0..tab];if(smf_seen(reached,caller)==0){push[[]u8](&reached,caller);}}}start=i+1;}i=i+1;}cursor=cursor+1;}return len[[]u8](reached)-1;}
fn semantic_manifest_module_stale(text:[]u8,path:[]u8,current:ZagdHash)i32{let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>12&&@strEq(line[0..12],"module_node=")){let node:[]u8=line[12..];let tab:i32=0;while(tab<node.len&&node[tab]!='\t'){tab=tab+1;}if(tab<node.len&&@strEq(node[0..tab],path)){if(zagd_hash_equal(smf_hash(node[tab+1..]),current)==0){return 1;}return 0;}}start=i+1;}i=i+1;}return 0;}
fn semantic_manifest_decl_count(text:[]u8)i32{if(semantic_manifest_decode(text).valid==0){return 0;}let count:i32=0;let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>8&&@strEq(line[0..8],"decl_fn=")){count=count+1;}start=i+1;}i=i+1;}return count;}
fn semantic_manifest_constant_count(text:[]u8)i32{if(semantic_manifest_decode(text).valid==0){return 0;}let count:i32=0;let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>8&&@strEq(line[0..8],"fact_fn=")&&smf_line_has(line,"\tconstant_return=1")){count=count+1;}start=i+1;}i=i+1;}return count;}
fn semantic_manifest_fact_count(text:[]u8,needle:[]u8)i32{if(semantic_manifest_decode(text).valid==0){return 0;}let count:i32=0;let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>8&&@strEq(line[0..8],"fact_fn=")&&smf_line_has(line,needle)){count=count+1;}start=i+1;}i=i+1;}return count;}
fn smf_line_has(line:[]u8,needle:[]u8)bool{let i:i32=0;while(i+needle.len<=line.len){let j:i32=0;while(j<needle.len&&line[i+j]==needle[j]){j=j+1;}if(j==needle.len){return true;}i=i+1;}return false;}
fn smf_decl_name(line:[]u8)[]u8{if(line.len<=8||!@strEq(line[0..8],"decl_fn=")){return "";}let i:i32=8;while(i<line.len&&line[i]!='\t'){i=i+1;}return line[8..i];}
fn smf_decl_line(text:[]u8,name:[]u8)[]u8{let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(@strEq(smf_decl_name(line),name)){return line;}start=i+1;}i=i+1;}return "";}
fn smf_decl_identity(line:[]u8)[]u8{let mark:i32=0;let i:i32=0;while(i+6<=line.len){if(@strEq(line[i..i+6],"\tline=")){mark=i;let end:i32=i+1;while(end<line.len&&line[end]!='\t'){end=end+1;}return _zag_str_concat(line[0..mark],line[end..]);}i=i+1;}return line;}
fn semantic_manifest_changed_decl_dependents(old:[]u8,new:[]u8)i32{if(semantic_manifest_decode(old).valid==0||semantic_manifest_decode(new).valid==0){return 0;}let total:i32=0;let start:i32=0;let i:i32=0;while(i<=new.len){if(i==new.len||new[i]=='\n'){let line:[]u8=new[start..i];let name:[]u8=smf_decl_name(line);if(name.len>0&&!@strEq(smf_decl_identity(line),smf_decl_identity(smf_decl_line(old,name)))){total=total+1+semantic_manifest_transitive_callers(new,name);}start=i+1;}i=i+1;}start=0;i=0;while(i<=old.len){if(i==old.len||old[i]=='\n'){let line:[]u8=old[start..i];let name:[]u8=smf_decl_name(line);if(name.len>0&&smf_decl_line(new,name).len==0){total=total+1+semantic_manifest_transitive_callers(old,name);}start=i+1;}i=i+1;}return total;}
fn semantic_manifest_invalidation(old:[]u8,new:[]u8)SemanticInvalidation{let a:SemanticManifestView=semantic_manifest_decode(old);let b:SemanticManifestView=semantic_manifest_decode(new);if(a.valid==0||b.valid==0){return SemanticInvalidation{.semantic_changed=1,.declaration_dependents=0,.layout_changed=1,.codegen_invalidated=1,.comment_only=0};}let decl:i32=semantic_manifest_changed_decl_dependents(old,new);let layout:i32=1-zagd_hash_equal(a.layout_identity,b.layout_identity);let semantic:i32=decl>0||layout==1||zagd_hash_equal(a.effect_identity,b.effect_identity)==0;let comment:i32=(semantic==0&&zagd_hash_equal(a.source,b.source)==0) as i32;return SemanticInvalidation{.semantic_changed=semantic,.declaration_dependents=decl,.layout_changed=layout,.codegen_invalidated=(semantic==1) as i32,.comment_only=comment};}
fn semantic_manifest_artifact_identity(text:[]u8,compiler:[]u8,target:[]u8)ZagdHash{let v:SemanticManifestView=semantic_manifest_decode(text);if(v.valid==0){return zagd_hash_empty();}let seed:[]u8=_zag_str_concat("artifact-v1\ncompiler=",_zag_str_concat(compiler,_zag_str_concat("\ntarget=",_zag_str_concat(target,_zag_str_concat("\npublic=",_zag_str_concat(_zag_i64_to_str(v.public_identity.first),_zag_str_concat("\neffects=",_zag_str_concat(_zag_i64_to_str(v.effect_identity.first),_zag_str_concat("\nlayouts=",_zag_i64_to_str(v.layout_identity.first))))))))));let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(smf_decl_name(line).len>0){seed=_zag_str_concat(seed,_zag_str_concat("\n",smf_decl_identity(line)));}start=i+1;}i=i+1;}return zagd_content_hash(seed);}
