// Reader side of the foreground semantic manifest. Kept AST-free so zagd can
// validate compiler output without importing or reimplementing sema.
@import("zagd.zag")
// `graph_identity` names the compiler-produced declaration/module/type/call
// graph.  `graph_complete` is deliberately separate from the record checksum:
// a checksum-valid manifest may still be unable to prove an exact edge because
// an older AST node has no declaration origin.  Consumers must then fall back
// to whole-manifest invalidation instead of guessing an edge from source text.
struct SemanticManifestView { module:[]u8, source:ZagdHash, public_identity:ZagdHash, effect_identity:ZagdHash, layout_identity:ZagdHash, graph_identity:ZagdHash, graph_complete:i32, valid:i32 }
struct SemanticInvalidation { semantic_changed:i32, declaration_dependents:i32, layout_changed:i32, codegen_invalidated:i32, comment_only:i32 }
// `reusable_bytes` is the largest exact shared capacity among the proven
// ordered pairs, not a sum: pair relationships can be transitive and summing
// them would overstate a realizable saving.
struct SemanticBufferLifetimeFacts { pairs:i32, reusable_bytes:i64, valid:i32 }
fn smf_value(text:[]u8,key:[]u8)[]u8{let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>key.len&&@strEq(line[0..key.len],key)&&line[key.len]=='='){return line[key.len+1..];}start=i+1;}i=i+1;}return "";}
fn smf_uint(s:[]u8)i64{if(s.len==0){return 0-1;}let n:i64=0;let i:i32=0;while(i<s.len){if(s[i]<'0'||s[i]>'9'){return 0-1;}n=n*10+((s[i] as i64)-48);i=i+1;}return n;}
fn smf_part(s:[]u8,want:i32)[]u8{let field:i32=0;let start:i32=0;let i:i32=0;while(i<=s.len){if(i==s.len||s[i]==','){if(field==want){return s[start..i];}field=field+1;start=i+1;}i=i+1;}return "";}
fn smf_hash(s:[]u8)ZagdHash{return ZagdHash{.first=smf_uint(smf_part(s,0)),.second=smf_uint(smf_part(s,1)),.bytes=smf_uint(smf_part(s,2))};}
fn smf_checksum_mark(text:[]u8)i32{let marker:[]u8="checksum=";let i:i32=0;while(i+marker.len<=text.len){let j:i32=0;while(j<marker.len&&text[i+j]==marker[j]){j=j+1;}if(j==marker.len&&(i==0||text[i-1]=='\n')){return i;}i=i+1;}return 0-1;}
fn semantic_manifest_decode(text:[]u8)SemanticManifestView{let bad:SemanticManifestView=SemanticManifestView{.module="",.source=zagd_hash_empty(),.public_identity=zagd_hash_empty(),.effect_identity=zagd_hash_empty(),.layout_identity=zagd_hash_empty(),.graph_identity=zagd_hash_empty(),.graph_complete=0,.valid=0};if(!@strEq(smf_value(text,"format"),"zag-semantic-manifest-v1")||!@strEq(smf_value(text,"advisory"),"true")||!@strEq(smf_value(text,"executable_authority"),"false")||!@strEq(smf_value(text,"complete"),"true")){return bad;}let mark:i32=smf_checksum_mark(text);if(mark<0){return bad;}let checksum_text:[]u8=smf_value(text,"checksum");if(mark+9+checksum_text.len+1!=text.len){return bad;}let actual:ZagdHash=zagd_content_hash(text[0..mark]);let claimed:ZagdHash=smf_hash(checksum_text);if(zagd_hash_equal(actual,claimed)==0){return bad;}let source:ZagdHash=smf_hash(smf_value(text,"source"));let pubh:ZagdHash=smf_hash(smf_value(text,"public"));let effh:ZagdHash=smf_hash(smf_value(text,"effects"));let layh:ZagdHash=smf_hash(smf_value(text,"layouts"));let graph:ZagdHash=smf_hash(smf_value(text,"graph"));let complete:i64=smf_uint(smf_value(text,"graph_complete"));if(source.first<0||source.second<0||source.bytes<0||pubh.first<0||effh.first<0||layh.first<0||graph.first<0||(complete!=0&&complete!=1)){return bad;}return SemanticManifestView{.module=smf_value(text,"module"),.source=source,.public_identity=pubh,.effect_identity=effh,.layout_identity=layh,.graph_identity=graph,.graph_complete=complete as i32,.valid=1};}
fn smf_tab_field(line:[]u8,key:[]u8)[]u8{let i:i32=0;while(i+key.len+1<=line.len){if((i==0||line[i-1]=='\t')&&@strEq(line[i..i+key.len],key)&&line[i+key.len]=='='){let start:i32=i+key.len+1;let end:i32=start;while(end<line.len&&line[end]!='\t'){end=end+1;}return line[start..end];}while(i<line.len&&line[i]!='\t'){i=i+1;}i=i+1;}return "";}
fn smf_tab_field_count(line:[]u8,key:[]u8)i32{let count:i32=0;let i:i32=0;while(i+key.len+1<=line.len){if((i==0||line[i-1]=='\t')&&@strEq(line[i..i+key.len],key)&&line[i+key.len]=='='){count=count+1;}while(i<line.len&&line[i]!='\t'){i=i+1;}i=i+1;}return count;}
fn smf_bounded_uint(s:[]u8,max:i64)i64{if(s.len==0){return 0-1;}let n:i64=0;let i:i32=0;while(i<s.len){if(s[i]<'0'||s[i]>'9'){return 0-1;}let digit:i64=(s[i] as i64)-48;if(n>(max-digit)/10){return 0-1;}n=n*10+digit;i=i+1;}return n;}
fn semantic_manifest_buffer_lifetime_facts(text:[]u8)SemanticBufferLifetimeFacts{
    let bad:SemanticBufferLifetimeFacts=SemanticBufferLifetimeFacts{.pairs=0,.reusable_bytes=0,.valid=0};
    if(semantic_manifest_decode(text).valid==0){return bad;}
    let out:SemanticBufferLifetimeFacts=SemanticBufferLifetimeFacts{.pairs=0,.reusable_bytes=0,.valid=1};let start:i32=0;let i:i32=0;
    while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];
        if(line.len>12&&@strEq(line[0..12],"buffer_pair=")){
            let required:ArrayList[[]u8]=make[[]u8](18);push[[]u8](&required,"buffer_pair");push[[]u8](&required,"first");push[[]u8](&required,"first_bytes");push[[]u8](&required,"first_alloc_stmt");push[[]u8](&required,"first_free_stmt");push[[]u8](&required,"second");push[[]u8](&required,"second_bytes");push[[]u8](&required,"second_alloc_stmt");push[[]u8](&required,"second_free_stmt");push[[]u8](&required,"reuse_bytes");push[[]u8](&required,"word_bytes");push[[]u8](&required,"non_overlap");push[[]u8](&required,"basis");push[[]u8](&required,"automatic");push[[]u8](&required,"source_changes");push[[]u8](&required,"executable_authority");push[[]u8](&required,"analysis_bound");push[[]u8](&required,"validity");
            let ri:i32=0;while(ri<len[[]u8](required)){if(smf_tab_field_count(line,get[[]u8](required,ri))!=1){free[[]u8](&required);return bad;}ri=ri+1;}free[[]u8](&required);
            let fn_name:[]u8=smf_tab_field(line,"buffer_pair");let first:[]u8=smf_tab_field(line,"first");let second:[]u8=smf_tab_field(line,"second");
            let first_bytes:i64=smf_bounded_uint(smf_tab_field(line,"first_bytes"),8000000);let second_bytes:i64=smf_bounded_uint(smf_tab_field(line,"second_bytes"),8000000);let reuse:i64=smf_bounded_uint(smf_tab_field(line,"reuse_bytes"),8000000);
            let first_alloc:i64=smf_bounded_uint(smf_tab_field(line,"first_alloc_stmt"),2147483647);let first_free:i64=smf_bounded_uint(smf_tab_field(line,"first_free_stmt"),2147483647);let second_alloc:i64=smf_bounded_uint(smf_tab_field(line,"second_alloc_stmt"),2147483647);let second_free:i64=smf_bounded_uint(smf_tab_field(line,"second_free_stmt"),2147483647);
            let expected:i64=first_bytes;if(second_bytes<expected){expected=second_bytes;}
            if(fn_name.len==0||first.len==0||second.len==0||@strEq(first,second)||first_bytes<=0||second_bytes<=0||first_bytes%8!=0||second_bytes%8!=0||reuse!=expected||first_alloc<0||first_free<=first_alloc||second_alloc<=first_free||second_free<=second_alloc||
                !@strEq(smf_tab_field(line,"word_bytes"),"8")||!@strEq(smf_tab_field(line,"non_overlap"),"1")||!@strEq(smf_tab_field(line,"basis"),"proven-foreground-ast")||!@strEq(smf_tab_field(line,"automatic"),"0")||!@strEq(smf_tab_field(line,"source_changes"),"0")||!@strEq(smf_tab_field(line,"executable_authority"),"0")||!@strEq(smf_tab_field(line,"analysis_bound"),"64")||!@strEq(smf_tab_field(line,"validity"),"linux-x86_64-local-raw-word-zalloc-exactly-one-zfree-no-alias-escape-call-exposure")){return bad;}
            out.pairs=out.pairs+1;if(out.pairs>4096){return bad;}if(reuse>out.reusable_bytes){out.reusable_bytes=reuse;}
        }
        start=i+1;}i=i+1;
    }return out;
}
fn semantic_manifest_direct_dependents(text:[]u8,changed:[]u8)i32{if(semantic_manifest_decode(text).valid==0){return 0;}let count:i32=0;let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>12&&@strEq(line[0..12],"import_edge=")){let edge:[]u8=line[12..];let tab:i32=0;while(tab<edge.len&&edge[tab]!='\t'){tab=tab+1;}if(tab<edge.len&&@strEq(edge[tab+1..],changed)){count=count+1;}}start=i+1;}i=i+1;}return count;}
fn smf_seen(items:ArrayList[[]u8],value:[]u8)i32{let i:i32=0;while(i<len[[]u8](items)){if(@strEq(get[[]u8](items,i),value)){return 1;}i=i+1;}return 0;}
// Reverse transitive closure: if A imports B and B changes publicly, A is
// affected. The explicit visited set makes diamonds deterministic and cycles
// finite. The changed module itself is not included in the returned count.
fn semantic_manifest_transitive_dependents(text:[]u8,changed:[]u8)i32{if(semantic_manifest_decode(text).valid==0){return 0;}let reached:ArrayList[[]u8]=make[[]u8](8);push[[]u8](&reached,changed);let cursor:i32=0;while(cursor<len[[]u8](reached)){let target:[]u8=get[[]u8](reached,cursor);let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>12&&@strEq(line[0..12],"import_edge=")){let edge:[]u8=line[12..];let tab:i32=0;while(tab<edge.len&&edge[tab]!='\t'){tab=tab+1;}if(tab<edge.len&&@strEq(edge[tab+1..],target)){let importer:[]u8=edge[0..tab];if(smf_seen(reached,importer)==0){push[[]u8](&reached,importer);}}}start=i+1;}i=i+1;}cursor=cursor+1;}let total:i32=len[[]u8](reached)-1;free[[]u8](&reached);return total;}
fn semantic_manifest_transitive_callers(text:[]u8,changed:[]u8)i32{if(semantic_manifest_decode(text).valid==0){return 0;}let reached:ArrayList[[]u8]=make[[]u8](8);push[[]u8](&reached,changed);let cursor:i32=0;while(cursor<len[[]u8](reached)){let target:[]u8=get[[]u8](reached,cursor);let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>10&&@strEq(line[0..10],"call_edge=")){let edge:[]u8=line[10..];let tab:i32=0;while(tab<edge.len&&edge[tab]!='\t'){tab=tab+1;}if(tab<edge.len&&@strEq(edge[tab+1..],target)){let caller:[]u8=edge[0..tab];if(smf_seen(reached,caller)==0){push[[]u8](&reached,caller);}}}start=i+1;}i=i+1;}cursor=cursor+1;}let total:i32=len[[]u8](reached)-1;free[[]u8](&reached);return total;}
fn semantic_manifest_module_stale(text:[]u8,path:[]u8,current:ZagdHash)i32{let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>12&&@strEq(line[0..12],"module_node=")){let node:[]u8=line[12..];let tab:i32=0;while(tab<node.len&&node[tab]!='\t'){tab=tab+1;}if(tab<node.len&&@strEq(node[0..tab],path)){if(zagd_hash_equal(smf_hash(node[tab+1..]),current)==0){return 1;}return 0;}}start=i+1;}i=i+1;}return 0;}
fn semantic_manifest_dependency_input_stale(text:[]u8,path:[]u8,current:ZagdHash)i32{
    if(semantic_manifest_decode(text).valid==0){return 1;}
    let prefix:[]u8="dependency_input_node=";let start:i32=0;let i:i32=0;
    while(i<=text.len){if(i==text.len||text[i]=='\n'){
        let line:[]u8=text[start..i];if(line.len>prefix.len&&
            @strEq(line[0..prefix.len],prefix)){
            let node:[]u8=line[prefix.len..line.len];let tab:i32=0;
            while(tab<node.len&&node[tab]!='\t'){tab=tab+1;}
            if(tab<node.len&&@strEq(node[0..tab],path)){
                return 1-zagd_hash_equal(smf_hash(node[tab+1..node.len]),current);
            }
        }start=i+1;
    }i=i+1;}return 0;
}
fn semantic_manifest_decl_count(text:[]u8)i32{if(semantic_manifest_decode(text).valid==0){return 0;}let count:i32=0;let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>8&&@strEq(line[0..8],"decl_fn=")){count=count+1;}start=i+1;}i=i+1;}return count;}
fn semantic_manifest_constant_count(text:[]u8)i32{if(semantic_manifest_decode(text).valid==0){return 0;}let count:i32=0;let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>8&&@strEq(line[0..8],"fact_fn=")&&smf_line_has(line,"\tconstant_return=1")){count=count+1;}start=i+1;}i=i+1;}return count;}
fn semantic_manifest_fact_count(text:[]u8,needle:[]u8)i32{if(semantic_manifest_decode(text).valid==0){return 0;}let count:i32=0;let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>8&&@strEq(line[0..8],"fact_fn=")&&smf_line_has(line,needle)){count=count+1;}start=i+1;}i=i+1;}return count;}
fn smf_line_has(line:[]u8,needle:[]u8)bool{let i:i32=0;while(i+needle.len<=line.len){let j:i32=0;while(j<needle.len&&line[i+j]==needle[j]){j=j+1;}if(j==needle.len){return true;}i=i+1;}return false;}
fn smf_decl_name(line:[]u8)[]u8{if(line.len<=8||!@strEq(line[0..8],"decl_fn=")){return "";}let i:i32=8;while(i<line.len&&line[i]!='\t'){i=i+1;}return line[8..i];}
fn smf_decl_line(text:[]u8,name:[]u8)[]u8{let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(@strEq(smf_decl_name(line),name)){return line;}start=i+1;}i=i+1;}return "";}
// Declaration identities intentionally ignore their source-line witness.  Do
// this as two borrowed segments rather than constructing a concatenated
// temporary for every declaration comparison in the daemon event loop.
fn smf_decl_line_mark(line:[]u8)i32{let i:i32=0;while(i+6<=line.len){if(@strEq(line[i..i+6],"\tline=")){return i;}i=i+1;}return 0-1;}
fn smf_decl_line_after(line:[]u8,mark:i32)i32{if(mark<0){return line.len;}let end:i32=mark+1;while(end<line.len&&line[end]!='\t'){end=end+1;}return end;}
fn smf_bytes_equal(a:[]u8,b:[]u8)i32{if(a.len!=b.len){return 0;}let i:i32=0;while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}return 1;}
fn smf_decl_identity_equal(a:[]u8,b:[]u8)i32{let am:i32=smf_decl_line_mark(a);let bm:i32=smf_decl_line_mark(b);let ae:i32=smf_decl_line_after(a,am);let be:i32=smf_decl_line_after(b,bm);let ap:i32=a.len;if(am>=0){ap=am;}let bp:i32=b.len;if(bm>=0){bp=bm;}if(smf_bytes_equal(a[0..ap],b[0..bp])==0){return 0;}return smf_bytes_equal(a[ae..a.len],b[be..b.len]);}
fn smf_hash_extend_decl_identity(seed:ZagdHash,line:[]u8)ZagdHash{let mark:i32=smf_decl_line_mark(line);if(mark<0){return zagd_hash_extend(seed,line);}let after:i32=smf_decl_line_after(line,mark);let out:ZagdHash=zagd_hash_extend(seed,line[0..mark]);return zagd_hash_extend(out,line[after..line.len]);}
fn semantic_manifest_changed_decl_dependents(old:[]u8,new:[]u8)i32{if(semantic_manifest_decode(old).valid==0||semantic_manifest_decode(new).valid==0){return 0;}let total:i32=0;let start:i32=0;let i:i32=0;while(i<=new.len){if(i==new.len||new[i]=='\n'){let line:[]u8=new[start..i];let name:[]u8=smf_decl_name(line);if(name.len>0&&smf_decl_identity_equal(line,smf_decl_line(old,name))==0){total=total+1+semantic_manifest_transitive_callers(new,name);}start=i+1;}i=i+1;}start=0;i=0;while(i<=old.len){if(i==old.len||old[i]=='\n'){let line:[]u8=old[start..i];let name:[]u8=smf_decl_name(line);if(name.len>0&&smf_decl_line(new,name).len==0){total=total+1+semantic_manifest_transitive_callers(old,name);}start=i+1;}i=i+1;}return total;}
fn semantic_manifest_invalidation(old:[]u8,new:[]u8)SemanticInvalidation{let a:SemanticManifestView=semantic_manifest_decode(old);let b:SemanticManifestView=semantic_manifest_decode(new);if(a.valid==0||b.valid==0){return SemanticInvalidation{.semantic_changed=1,.declaration_dependents=0,.layout_changed=1,.codegen_invalidated=1,.comment_only=0};}let decl:i32=semantic_manifest_changed_decl_dependents(old,new);let layout:i32=1-zagd_hash_equal(a.layout_identity,b.layout_identity);let profile_changed:i32=(1-@strEq(smf_value(old,"profile"),smf_value(new,"profile"))) as i32;let graph_changed:i32=1-zagd_hash_equal(a.graph_identity,b.graph_identity);let semantic:i32=decl>0||layout==1||profile_changed==1||graph_changed==1||zagd_hash_equal(a.effect_identity,b.effect_identity)==0;let comment:i32=(semantic==0&&zagd_hash_equal(a.source,b.source)==0) as i32;// An incomplete AST graph must never make a localized caller claim.
    if(semantic==1&&(a.graph_complete==0||b.graph_complete==0)){decl=semantic_manifest_decl_count(new);if(decl==0){decl=semantic_manifest_decl_count(old);}}
    return SemanticInvalidation{.semantic_changed=semantic,.declaration_dependents=decl,.layout_changed=layout,.codegen_invalidated=(semantic==1) as i32,.comment_only=comment};}
// Append a decimal witness without `_zag_i64_to_str`: the identity paths run
// for every stable event and must not retain a chain of runtime strings.
fn smf_append_i64(out:*ArrayList[u8],value:i64)void{let n:i64=value;if(n==0){push[u8](out,'0');return;}if(n<0){push[u8](out,'-');}let digits:ArrayList[u8]=make[u8](24);while(n!=0){let q:i64=n/10;let rem:i64=n-q*10;if(rem<0){rem=0-rem;}push[u8](&digits,(rem+48) as u8);n=q;}let i:i32=digits.len-1;while(i>=0){push[u8](out,digits.data[i]);i=i-1;}free[u8](&digits);}
fn smf_append(out:*ArrayList[u8],text:[]u8)void{let i:i32=0;while(i<text.len){push[u8](out,text[i]);i=i+1;}}
fn smf_append_hash(out:*ArrayList[u8],value:ZagdHash)void{
    smf_append_i64(out,value.first);smf_append(out,",");
    smf_append_i64(out,value.second);smf_append(out,",");
    smf_append_i64(out,value.bytes);
}
fn smf_artifact_header(v:SemanticManifestView,compiler:[]u8,target:[]u8)ZagdHash{
    let header:ArrayList[u8]=make[u8](192);
    smf_append(&header,"artifact-v3\ncompiler=");smf_append(&header,compiler);
    smf_append(&header,"\ntarget=");smf_append(&header,target);
    smf_append(&header,"\npublic=");smf_append_hash(&header,v.public_identity);
    smf_append(&header,"\neffects=");smf_append_hash(&header,v.effect_identity);
    smf_append(&header,"\nlayouts=");smf_append_hash(&header,v.layout_identity);
    smf_append(&header,"\ngraph=");smf_append_hash(&header,v.graph_identity);
    smf_append(&header,"\ngraph_complete=");smf_append_i64(&header,v.graph_complete);
    let out:ZagdHash=zagd_content_hash(header.data[0..header.len]);
    free[u8](&header);return out;
}
fn semantic_manifest_artifact_identity(text:[]u8,compiler:[]u8,target:[]u8)ZagdHash{let v:SemanticManifestView=semantic_manifest_decode(text);if(v.valid==0){return zagd_hash_empty();}let seed:ZagdHash=smf_artifact_header(v,compiler,target);let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(smf_decl_name(line).len>0){seed=zagd_hash_extend(seed,"\n");seed=smf_hash_extend_decl_identity(seed,line);}start=i+1;}i=i+1;}return seed;}
// The foreground cache remains the sole executable cache authority. This link
// is a checksum-bound whole-program identity for advisory artifact accounting;
// it is never a machine-code payload or permission to skip foreground checks.
fn semantic_manifest_machine_cache_link(text:[]u8,compiler:[]u8,target:[]u8)ZagdHash{let artifact:ZagdHash=semantic_manifest_artifact_identity(text,compiler,target);let encoded:ArrayList[u8]=make[u8](80);smf_append_i64(&encoded,artifact.first);smf_append(&encoded,",");smf_append_i64(&encoded,artifact.second);smf_append(&encoded,",");smf_append_i64(&encoded,artifact.bytes);let seed:ZagdHash=zagd_hash_extend(zagd_hash_empty(),"foreground-machine-link-v2\n");let out:ZagdHash=zagd_hash_extend(seed,encoded.data[0..encoded.len]);free[u8](&encoded);return out;}
