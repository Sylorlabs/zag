// Small parser projection harness: compile this with an existing compiler to
// exercise the current shared parser without rebuilding the compiler driver.
@import("fmt.zag")
fn main()i32{
    if(_zag_argc()!=2){return 2;}
    let source:[]u8=_zag_read_file(_zag_arg(1));if(source.len<0){return 3;}
    let rendered:ArrayList[u8]=fmt_program(source);
    _zag_print(rendered.data[0..rendered.len]);return 0;
}
