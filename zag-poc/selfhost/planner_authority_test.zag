@import("planner_authority.zag")
fn pa(ok:i32,msg:[]u8,f:*i32)void{if(ok==1){return;}_zag_print("FAIL planner authority: ");_zag_println(msg);f.*=f.*+1;}
fn main() i32 {
 let f:i32=0; let src:[]u8="fn main() i32 { return 42; }";
 let cfg:PlannerConfig=planner_parse_config("mode=light\nallocator=bounded\ndevice=cpu\nlayout=soa\ncpu=generic\n"); pa(cfg.valid==1&&@strEq(cfg.mode,"light"),"config parses",&f);
 let none:PlannerChoices=planner_empty_choices(); let regular:PlannerResolution=planner_resolve(0,src,cfg,none,1);
 pa(regular.source_changed==0&&@strEq(regular.source,src),"regular source unchanged",&f); pa(regular.automatic_count==0,"regular Zag gets no automatic choices",&f); pa(regular.unresolved_count==0&&regular.diagnostic.len==0,"regular Zag remains quiet without analyzer findings",&f);
 let script:PlannerResolution=planner_resolve(1,src,cfg,none,0); pa(script.automatic_count==4&&@strEq(script.choices.allocator,"bounded")&&@strEq(script.choices.layout,"soa"),"script defaults selected",&f); pa(script.source_changed==0,"script planning does not rewrite source",&f);
 let explicit:PlannerChoices=PlannerChoices{.allocator="custom",.device="gpu",.layout="aos",.cpu="native",.allocator_explicit=1,.device_explicit=1,.layout_explicit=1,.cpu_explicit=1}; let kept:PlannerResolution=planner_resolve(1,src,cfg,explicit,0);
 pa(kept.automatic_count==0&&@strEq(kept.choices.allocator,"custom")&&@strEq(kept.choices.device,"gpu")&&@strEq(kept.choices.layout,"aos")&&@strEq(kept.choices.cpu,"native"),"all explicit choices win",&f);
 let bad:PlannerConfig=planner_parse_config("magic=yes\n"); pa(bad.valid==0&&bad.diagnostic.len>0,"unknown config rejected",&f); pa(kept.provenance.len>0,"provenance emitted",&f);
 let changed:PlannerConfig=planner_parse_config("# project override\nmode=adaptive\ncpu=x86-64-v1\n"); pa(changed.valid==1&&@strEq(changed.mode,"adaptive")&&@strEq(changed.default_cpu,"x86-64-v1"),"mode and defaults easy to override",&f);
 if(f==0){_zag_println("planner authority: pass=10 fail=0");} return f;
}
