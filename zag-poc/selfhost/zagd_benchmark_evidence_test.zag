@import("zagd_store.zag")

fn append_evidence_values(out:*ArrayList[u8],name:[]u8,count:i32,value:i64)void{
    zagd_text_append(out,name);zagd_text_append_byte(out,'=');let i:i32=0;while(i<count){if(i>0){zagd_text_append_byte(out,',');}zagd_text_append_i64(out,value);i=i+1;}zagd_text_append_byte(out,'\n');
}
fn append_hash(out:*ArrayList[u8],name:[]u8,h:ZagdHash)void{
    zagd_text_append(out,name);zagd_text_append_byte(out,'=');zagd_text_append_i64(out,h.first);zagd_text_append_byte(out,'\t');zagd_text_append_i64(out,h.second);zagd_text_append_byte(out,'\t');zagd_text_append_i64(out,h.bytes);zagd_text_append_byte(out,'\n');
}
fn evidence_text_variant_legacy(status:[]u8,winner:i32,eligible:i32,confidence:i32,no_regression:i32,target_ok:i32)[]u8{
    let body:ArrayList[u8]=zagd_text(4096);let target_key:[]u8="linux-x86_64|x86-64-v1|sse2";let target_identity:ZagdHash=zagd_content_hash(target_key);if(target_ok==0){target_identity=zagd_content_hash("different-target");}
    zagd_text_append(&body,"format=zagd-benchmark-evidence-v1\nadvisory=true\nexecutable_authority=false\nforeground_consumption=none\nreference=/tmp/reference\n");append_hash(&body,"reference_identity",ZagdHash{.first=1,.second=2,.bytes=10});zagd_text_append(&body,"finalist=/tmp/finalist\n");append_hash(&body,"finalist_identity",ZagdHash{.first=3,.second=4,.bytes=11});append_hash(&body,"semantic_identity",ZagdHash{.first=5,.second=6,.bytes=12});zagd_text_append(&body,"target_cache_key=");zagd_text_append(&body,target_key);zagd_text_append_byte(&body,'\n');append_hash(&body,"target_identity",target_identity);zagd_text_append(&body,"workload_count=1\nworkload=1\npolicy_status=");zagd_text_append(&body,status);zagd_text_append(&body,"\npolicy_winner_kind=");zagd_text_append_i64(&body,winner);zagd_text_append(&body,"\npolicy_evaluated=1\npolicy_eligible=");zagd_text_append_i64(&body,eligible);zagd_text_append(&body,"\npolicy_confidence_percent=");zagd_text_append_i64(&body,confidence);zagd_text_append(&body,"\npolicy_no_regression=");zagd_text_append_i64(&body,no_regression);zagd_text_append(&body,"\npolicy_advisory=1\n");append_evidence_values(&body,"reference_warmups",3,2000000);append_evidence_values(&body,"finalist_warmups",3,2000000);append_evidence_values(&body,"noise_reference",30,2000000);append_evidence_values(&body,"noise_repeat",30,2000000);append_evidence_values(&body,"reference_runs",30,2000000);append_evidence_values(&body,"finalist_runs",30,2000000);let sum:ZagdHash=zagd_content_hash(body.data[0..body.len]);zagd_text_append(&body,"checksum_first=");zagd_text_append_i64(&body,sum.first);zagd_text_append(&body,"\nchecksum_second=");zagd_text_append_i64(&body,sum.second);zagd_text_append(&body,"\nchecksum_bytes=");zagd_text_append_i64(&body,sum.bytes);zagd_text_append_byte(&body,'\n');return body.data[0..body.len];
}

fn evidence_text_variant(status:[]u8,winner:i32,eligible:i32,confidence:i32,no_regression:i32,target_ok:i32,transform:[]u8)[]u8{
    let body:ArrayList[u8]=zagd_text(4096);let target_key:[]u8="linux-x86_64|x86-64-v1|sse2";let target_identity:ZagdHash=zagd_content_hash(target_key);if(target_ok==0){target_identity=zagd_content_hash("different-target");}
    let finalist_value:i64=2000000;let score:i64=0;if(@strEq(status,"verified_best_measured")){finalist_value=1000000;score=1000000;}
    zagd_text_append(&body,"format=zagd-benchmark-evidence-v2\nadvisory=true\nexecutable_authority=false\nforeground_consumption=none\nreference=/tmp/reference\n");append_hash(&body,"reference_identity",ZagdHash{.first=1,.second=2,.bytes=10});zagd_text_append(&body,"finalist=/tmp/finalist\n");append_hash(&body,"finalist_identity",ZagdHash{.first=3,.second=4,.bytes=11});append_hash(&body,"semantic_identity",ZagdHash{.first=5,.second=6,.bytes=12});zagd_text_append(&body,"target_cache_key=");zagd_text_append(&body,target_key);zagd_text_append_byte(&body,'\n');append_hash(&body,"target_identity",target_identity);zagd_text_append(&body,"transform=");zagd_text_append(&body,transform);zagd_text_append(&body,"\nworkload_count=1\nworkload=1\npolicy_status=");zagd_text_append(&body,status);zagd_text_append(&body,"\npolicy_winner_kind=");zagd_text_append_i64(&body,winner);zagd_text_append(&body,"\npolicy_evaluated=1\npolicy_eligible=");zagd_text_append_i64(&body,eligible);zagd_text_append(&body,"\npolicy_confidence_percent=");zagd_text_append_i64(&body,confidence);zagd_text_append(&body,"\npolicy_no_regression=");zagd_text_append_i64(&body,no_regression);zagd_text_append(&body,"\npolicy_advisory=1\npeak_memory_bytes=4096\nbinary_size_bytes=100\npolicy_runtime_score_ns=");zagd_text_append_i64(&body,score);zagd_text_append_byte(&body,'\n');append_evidence_values(&body,"reference_warmups",3,2000000);append_evidence_values(&body,"finalist_warmups",3,finalist_value);append_evidence_values(&body,"noise_reference",30,2000000);append_evidence_values(&body,"noise_repeat",30,2000000);append_evidence_values(&body,"reference_runs",30,2000000);append_evidence_values(&body,"finalist_runs",30,finalist_value);let sum:ZagdHash=zagd_content_hash(body.data[0..body.len]);zagd_text_append(&body,"checksum_first=");zagd_text_append_i64(&body,sum.first);zagd_text_append(&body,"\nchecksum_second=");zagd_text_append_i64(&body,sum.second);zagd_text_append(&body,"\nchecksum_bytes=");zagd_text_append_i64(&body,sum.bytes);zagd_text_append_byte(&body,'\n');return body.data[0..body.len];
}

fn main()i32{
    let failures:i32=0;let text:[]u8=evidence_text_variant("verified_no_win",0,0,0,0,1,"const-i32-add-v1");let decoded:ZagdBenchmarkEvidenceRecord=zagd_benchmark_evidence_decode(text);
    if(decoded.valid!=1||decoded.warmup_samples!=3||decoded.calibration_samples!=30||decoded.paired_samples!=30||decoded.advisory!=1){failures=failures+1;}
    let payload_record:ZagdBenchmarkEvidenceRecord=decoded;payload_record.reference_identity=zagd_content_hash("reference-bytes");payload_record.finalist_identity=zagd_content_hash("finalist-bytes");if(zagd_benchmark_evidence_payloads_current(payload_record,"reference-bytes","finalist-bytes")!=1||zagd_benchmark_evidence_payloads_current(payload_record,"changed-reference","finalist-bytes")!=0||zagd_benchmark_evidence_payloads_current(payload_record,"reference-bytes","changed-finalist")!=0){failures=failures+1;}
    if(zagd_benchmark_evidence_decode(evidence_text_variant("verified_best_measured",1,1,99,1,1,"const-i32-add-v1")).valid!=1){failures=failures+1;}
    if(zagd_benchmark_evidence_decode(evidence_text_variant("verified_best_measured",1,1,99,1,1,"const-i64-add-v1")).valid!=0){failures=failures+1;}
    if(zagd_benchmark_evidence_decode(evidence_text_variant("forged",0,0,0,0,1,"const-i32-add-v1")).valid!=0){failures=failures+1;}
    if(zagd_benchmark_evidence_decode(evidence_text_variant("verified_no_win",1,0,0,0,1,"const-i32-add-v1")).valid!=0){failures=failures+1;}
    if(zagd_benchmark_evidence_decode(evidence_text_variant("verified_best_measured",1,0,99,1,1,"const-i32-add-v1")).valid!=0){failures=failures+1;}
    if(zagd_benchmark_evidence_decode(evidence_text_variant("verified_no_win",0,0,0,0,0,"const-i32-add-v1")).valid!=0){failures=failures+1;}
    let tampered:[]u8=_zag_str_concat(text,"x");if(zagd_benchmark_evidence_decode(tampered).valid!=0){failures=failures+1;}_zag_free(_zag_slice_ptr(tampered));
    let duplicate:[]u8=_zag_str_concat(text,"advisory=true\n");if(zagd_benchmark_evidence_decode(duplicate).valid!=0){failures=failures+1;}_zag_free(_zag_slice_ptr(duplicate));
    if(zagd_benchmark_evidence_decode(evidence_text_variant_legacy("verified_no_win",0,0,0,0,1)).valid!=0){failures=failures+1;}
    if(failures==0){_zag_println("zagd benchmark evidence: 10/10");return 0;}_zag_print("zagd benchmark evidence: ");_zag_print_i64(failures as i64);_zag_println(" failures");return 1;
}
