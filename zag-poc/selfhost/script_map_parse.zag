// Literal AST marker consumed by typed.zag. Key/value evaluation remains in
// source order; the type checker selects one homogeneous ScriptMap[T].
fn script_map_parse_error(p:*Parser,message:[]u8)void{
    let t:Token=cur(p);
    diag_emit("E0021",message,p.*.origin,t.line,t.col,1,
        "map literals require string keys and one homogeneous value type",
        "write {\"key\": value}; annotate empty maps as ScriptMap[T]",p.*.source);
    _zag_exit(1);
}
fn parse_script_map(p:*Parser)*Node{
    let start:i32=p.*.i;let open:Token=adv(p);
    let args:ArrayList[*Node]=make[*Node](8);push[*Node](&args,mk_ident("__zag_script_context"));
    let count:i32=0;
    while(!at_k(p,Tk.Rbrace)){
        if(at_k(p,Tk.Eof)){script_map_parse_error(p,"unterminated map literal");}
        if(count>=64){script_map_parse_error(p,"map literal exceeds 64 entries");}
        let key:*Node=parse_expr(p);
        if(!at_k(p,Tk.Colon)){script_map_parse_error(p,"map key must be followed by ':'");}
        let colon:Token=adv(p);
        if(at_k(p,Tk.Rbrace)||at_k(p,Tk.Comma)||at_k(p,Tk.Eof)){script_map_parse_error(p,"map entry requires a value");}
        let value:*Node=parse_expr(p);push[*Node](&args,key);push[*Node](&args,value);count=count+1;
        if(at_k(p,Tk.Comma)){let comma:Token=adv(p);}
        else if(!at_k(p,Tk.Rbrace)){script_map_parse_error(p,"map entries must be separated by ','");}
    }
    let close:Token=adv(p);
    return parser_mark(p,mk_call(mk_ident("__zag_script_map_literal"),args),start);
}

fn script_parser_body_has_call(body:ArrayList[*Node],name:[]u8)i32{
    let i:i32=0;while(i<body.len){if(script_parser_has_call(body.data[i],name)==1){return 1;}i=i+1;}return 0;
}
fn script_parser_has_call(n:*Node,name:[]u8)i32{
    switch(n.*){
        .call=>|c|{switch(c.callee.*){.id=>|id|{if(@strEq(id.name,name)){return 1;}}else=>{}}
            if(script_parser_has_call(c.callee,name)==1){return 1;}
            return script_parser_body_has_call(c.args,name);}
        .fn_decl=>|f|{return script_parser_body_has_call(f.body,name);}
        .let_=>|x|{if(x.has_init==1){return script_parser_has_call(x.expr,name);}}
        .ret=>|x|{if(x.has_expr==1){return script_parser_has_call(x.expr,name);}}
        .estmt=>|x|{return script_parser_has_call(x.expr,name);}
        .assign=>|x|{return script_parser_has_call(x.target,name)|script_parser_has_call(x.expr,name);}
        .if_=>|x|{return script_parser_has_call(x.cond,name)|script_parser_body_has_call(x.then_body,name)|script_parser_body_has_call(x.els_body,name);}
        .while_=>|x|{return script_parser_has_call(x.cond,name)|script_parser_body_has_call(x.body,name);}
        .unsafe_=>|x|{return script_parser_body_has_call(x.body,name);}
        .defer_=>|x|{return script_parser_has_call(x.expr,name);}
        .bin=>|x|{return script_parser_has_call(x.l,name)|script_parser_has_call(x.r,name);}
        .un=>|x|{return script_parser_has_call(x.e,name);}
        .cast_=>|x|{return script_parser_has_call(x.expr,name);}
        .idx=>|x|{return script_parser_has_call(x.base,name)|script_parser_has_call(x.idx,name);}
        .fld=>|x|{return script_parser_has_call(x.base,name);}
        .slice_=>|x|{let found:i32=script_parser_has_call(x.base,name)|script_parser_has_call(x.lo,name);if(x.has_hi==1){found=found|script_parser_has_call(x.hi,name);}return found;}
        .slit_=>|x|{let i:i32=0;while(i<x.fields.len){if(script_parser_has_call(x.fields.data[i].val,name)==1){return 1;}i=i+1;}}
        .switch_=>|x|{if(script_parser_has_call(x.subject,name)==1||script_parser_body_has_call(x.els_body,name)==1){return 1;}
            let i:i32=0;while(i<x.arms.len){if(script_parser_body_has_call(x.arms.data[i].body,name)==1){return 1;}i=i+1;}}
        else=>{}
    }return 0;
}
fn script_map_body_present(body:ArrayList[*Node])i32{return script_parser_body_has_call(body,"__zag_script_map_literal");}
fn script_map_decls_present(decls:ArrayList[*Node])i32{return script_parser_body_has_call(decls,"__zag_script_map_literal");}
