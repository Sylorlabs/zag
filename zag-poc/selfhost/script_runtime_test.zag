@import("script_runtime.zag")

fn sr_expect(ok: i32, label: []u8, failures: *i32) void {
    if (ok == 1) { return; }
    _zag_print("FAIL script runtime: ");
    _zag_println(label);
    failures.* = failures.* + 1;
}

fn main() i32 {
    let failures: i32 = 0;
    let fake_args: ArrayList[[]u8] = make[[]u8](2);
    push[[]u8](&fake_args, "app.zag");
    push[[]u8](&fake_args, "input.txt");
    let ctx: ScriptContext = script_context_init_with(8, fake_args);

    sr_expect(len[[]u8](ctx.args) == 2, "arguments represented in context", &failures);
    sr_expect(@strEq(get[[]u8](ctx.args, 1), "input.txt"), "argument order preserved", &failures);
    sr_expect(ctx.capabilities.filesystem_read == 1 && ctx.capabilities.network == 0 &&
        ctx.capabilities.process == 0 && ctx.capabilities.device == 0,
        "capabilities are concrete and conservative", &failures);
    sr_expect(ctx.limits.max_memory_bytes == 8 && ctx.limits.process_timeout_ms == 30000,
        "limits are concrete", &failures);

    let first: ScriptAllocation = script_alloc(&ctx, 5);
    sr_expect(first.ok == 1 && first.bytes.len == 5, "bounded allocation succeeds", &failures);
    sr_expect(ctx.allocator.used_bytes == 5 && ctx.allocator.allocation_count == 1,
        "successful allocation accounted", &failures);
    let over: ScriptAllocation = script_alloc(&ctx, 4);
    sr_expect(over.ok == 0 && @strEq(over.diagnostic, "script memory limit exceeded"),
        "limit failure is explicit", &failures);
    sr_expect(ctx.allocator.used_bytes == 5 && ctx.allocator.failed_allocations == 1,
        "failed allocation does not consume budget", &failures);
    let rest: ScriptAllocation = script_alloc(&ctx, 3);
    sr_expect(rest.ok == 1 && ctx.allocator.used_bytes == 8, "remaining budget usable", &failures);

    let wide_ctx: ScriptContext = script_context_init_with(3000000000, fake_args);
    let oversized: ScriptAllocation = script_alloc(&wide_ctx, 2147483648);
    sr_expect(oversized.ok == 0 && oversized.bytes.len == 0 &&
        wide_ctx.allocator.used_bytes == 0, "native representation overflow rejected without allocation", &failures);

    script_shutdown(&ctx);
    sr_expect(ctx.runtime.running == 0 && ctx.runtime.output_flushed == 1 &&
        ctx.runtime.shutdown_complete == 1, "shutdown and flush state deterministic", &failures);
    script_shutdown(&ctx);
    sr_expect(ctx.runtime.shutdown_complete == 1, "shutdown is idempotent", &failures);
    let late: ScriptAllocation = script_alloc(&ctx, 0);
    sr_expect(late.ok == 0 && late.diagnostic.len > 0, "allocation after shutdown rejected", &failures);

    if (failures == 0) { _zag_println("script runtime: pass=13 fail=0"); }
    return failures;
}
