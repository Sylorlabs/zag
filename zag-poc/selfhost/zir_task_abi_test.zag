@import("zir.zag")
@import("sema.zag")
@import("../std/map.zag") as map

fn zta_check(ok:i32,name:[]u8,fail:*i32)void{
    if(ok==1){_zag_println(_zag_str_concat("ok  ",name));}
    else{_zag_eprintln(_zag_str_concat("XX  ",name));fail.*=fail.*+1;}
}

fn zta_find_op(blk:ZBlock,name:[]u8)i32{
    let i:i32=0;while(i<blk.ops.len){if(@strEq(blk.ops.data[i].name,name)){return i;}i=i+1;}return 0-1;
}

fn main()i32{
    let fail:i32=0;
    let unit:CompilationUnit=parse_compilation_unit_dir(
        "async fn worker(input:i64) i64 { return input + 1; }\nfn main() i32 { unsafe { let h:*opaque=worker(41); let value:i64=await(h); let rc:i64=cancel(h); return value as i32; } }\n",
        ".");
    let eff:map.StringMap[i32]=analyze(unit.decls);
    let authority:ZirAuthority=zir_prepare_production_with_origins(unit.decls,eff,unit.origins);
    let report:ZirContractReport=zir_verify_contracts(authority.module);
    zta_check(authority.valid==1&&authority.coverage_complete==1&&report.valid==1,
        "typed TaskI64 source lowers to a valid ZIR contract",&fail);
    let worker:ZFunc=authority.module.funcs.data[0];
    let caller:ZFunc=authority.module.funcs.data[1];
    let abi_i:i32=zta_find_op(worker.body,"task.abi");
    let spawn_i:i32=zta_find_op(caller.body,"task.spawn");
    let await_i:i32=zta_find_op(caller.body,"task.await");
    let cancel_i:i32=zta_find_op(caller.body,"task.cancel");
    zta_check(abi_i==0&&spawn_i>=0&&await_i>=0&&cancel_i>=0,
        "async ABI and handle transitions are explicit operations",&fail);
    let abi:ZOp=worker.body.ops.data[abi_i];
    zta_check(abi.attrs.len==6&&@strEq(attr_val(abi,"abi"),zir_task_abi_version())&&
        @strEq(attr_val(abi,"handle_type"),zir_task_handle_type())&&
        @strEq(attr_val(abi,"result_type"),"i64")&&
        @strEq(attr_val(abi,"ownership"),zir_task_ownership_mode())&&
        @strEq(attr_val(abi,"cancellation"),zir_task_cancellation_mode())&&
        @strEq(attr_val(abi,"scheduler"),zir_task_scheduler_mode())&&
        abi.origin.complete==1&&abi.origin.exact==1,
        "TaskI64 ABI metadata is versioned and source-origin exact",&fail);
    let spawn:ZOp=caller.body.ops.data[spawn_i];
    zta_check(spawn.results.len==1&&@strEq(spawn.results.data[0].ty,zir_task_handle_type())&&
        @strEq(spawn.results.data[0].ownership,"owned")&&
        @strEq(attr_val(spawn,"callee"),"worker")&&
        @strEq(attr_val(spawn,"consumes"),"0"),
        "spawn carries an owned heap TaskI64 result",&fail);
    let await_op:ZOp=caller.body.ops.data[await_i];
    let cancel_op:ZOp=caller.body.ops.data[cancel_i];
    zta_check(await_op.operands.len==1&&await_op.results.len==1&&
        @strEq(await_op.operands.data[0].ty,zir_task_handle_type())&&
        @strEq(attr_val(await_op,"consumes"),"1")&&
        cancel_op.operands.len==1&&cancel_op.results.len==1&&
        @strEq(cancel_op.operands.data[0].ty,zir_task_handle_type())&&
        @strEq(attr_val(cancel_op,"consumes"),"0"),
        "await and cancel encode affine consumption policy",&fail);

    let bad_abi:ZModule=zir_clone_module(authority.module);
    bad_abi.funcs.data[0].body.ops.data[0].attrs.data[0].val="task_i64.v0";
    zta_check(zir_verify_contracts(bad_abi).valid==0,
        "stale task ABI versions are rejected",&fail);
    let bad_spawn:ZModule=zir_clone_module(authority.module);
    let bad_spawn_i:i32=zta_find_op(bad_spawn.funcs.data[1].body,"task.spawn");
    bad_spawn.funcs.data[1].body.ops.data[bad_spawn_i].results.data[0].ownership="borrowed";
    zta_check(zir_verify_contracts(bad_spawn).valid==0,
        "forged task ownership is rejected",&fail);
    let bad_await:ZModule=zir_clone_module(authority.module);
    let bad_await_i:i32=zta_find_op(bad_await.funcs.data[1].body,"task.await");
    bad_await.funcs.data[1].body.ops.data[bad_await_i].attrs.data[3].val="0";
    zta_check(zir_verify_contracts(bad_await).valid==0,
        "truncated await consumption evidence is rejected",&fail);
    let bad_origin:ZModule=zir_clone_module(authority.module);
    let bad_cancel_i:i32=zta_find_op(bad_origin.funcs.data[1].body,"task.cancel");
    bad_origin.funcs.data[1].body.ops.data[bad_cancel_i].origin.exact=0;
    zta_check(zir_verify_contracts(bad_origin).valid==0,
        "task operation origin gaps are rejected",&fail);
    _zag_println(_zag_str_concat("zir-task-abi pass=",_zag_i64_to_str((10-fail) as i64)));
    if(fail>0){return 1;}return 0;
}
