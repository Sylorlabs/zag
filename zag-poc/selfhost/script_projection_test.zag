@import("script_projection.zag")

fn projection_check(ok:i32,name:[]u8,fail:*i32)void{
    if(ok==1){_zag_println(_zag_str_concat("ok  ",name));}
    else{_zag_eprintln(_zag_str_concat("XX  ",name));fail.*=fail.*+1;}
}

fn main()i32{
    let fail:i32=0;
    let compact:[]u8="script;\nlet answer: i32 = 40 + 2;\nreturn answer;\n";
    let baseline:[]u8="// generated policy\nfn body() i32 {\nlet answer: i32 = 40 + 2;\nreturn answer;\n}\nfn main() i32 { return body(); }\n";
    let edited:[]u8="// generated policy\nfn body() i32 {\nlet answer: i32 = 40 + 3;\nreturn answer;\n}\nfn main() i32 { return body(); }\n";
    let projected:ZsProjection=script_projection(compact,baseline,edited);
    projection_check(projected.ok==1&&@strEq(projected.compact,
        "script;\nlet answer: i32 = 40 + 3;\nreturn answer;\n"),
        "localized body edit projects to compact source",&fail);

    let inserted:[]u8="// generated policy\nfn body() i32 {\nlet answer: i32 = 40 + 2;\nprintln(\"checked\");\nreturn answer;\n}\nfn main() i32 { return body(); }\n";
    let insertion:ZsProjection=script_projection(compact,baseline,inserted);
    projection_check(insertion.ok==1&&zsp_find_from(insertion.compact,
        "println(\"checked\");",0)>=0,"localized insertion projects",&fail);

    let deleted:[]u8="// generated policy\nfn body() i32 {\nreturn answer;\n}\nfn main() i32 { return body(); }\n";
    let deletion:ZsProjection=script_projection(compact,baseline,deleted);
    projection_check(deletion.ok==1&&zsp_find_from(deletion.compact,
        "let answer",0)<0&&zsp_find_from(deletion.compact,"return answer;",0)>=0,
        "localized deletion projects",&fail);

    let wrapper_edit:[]u8="// changed policy\nfn body() i32 {\nlet answer: i32 = 40 + 2;\nreturn answer;\n}\nfn main() i32 { return body(); }\n";
    let generated:ZsProjection=script_projection(compact,baseline,wrapper_edit);
    projection_check(generated.ok==0&&generated.conflict_end>generated.conflict_start,
        "generated-only edit conflicts",&fail);

    let duplicate_compact:[]u8="script;\nreturn answer;\nreturn answer;\n";
    let duplicate_baseline:[]u8="header\nreturn answer;\nfooter\n";
    let duplicate_edit:[]u8="header\nreturn other;\nfooter\n";
    let ambiguous:ZsProjection=script_projection(duplicate_compact,duplicate_baseline,duplicate_edit);
    projection_check(ambiguous.ok==0&&ambiguous.conflict_end>ambiguous.conflict_start,
        "duplicate compact context conflicts",&fail);

    let unchanged:ZsProjection=script_projection(compact,baseline,baseline);
    projection_check(unchanged.ok==1&&@strEq(unchanged.compact,compact),
        "unchanged derivation is exact",&fail);

    let compact_many:[]u8="script;\nlet first: i32 = 40;\nlet second: i32 = 2;\nreturn first + second;\n";
    let baseline_many:[]u8="// generated policy\nfn body() i32 {\nlet first: i32 = 40;\n// generated accounting\nlet second: i32 = 2;\nreturn first + second;\n}\nfn main() i32 { return body(); }\n";
    let edited_many:[]u8="// generated policy\nfn body() i32 {\nlet first: i32 = 41;\n// generated accounting\nlet second: i32 = 3;\nreturn first + second;\n}\nfn main() i32 { return body(); }\n";
    let many:ZsProjection=script_projection(compact_many,baseline_many,edited_many);
    projection_check(many.ok==1&&@strEq(many.compact,
        "script;\nlet first: i32 = 41;\nlet second: i32 = 3;\nreturn first + second;\n"),
        "multiple separated source edits project",&fail);

    // A pure move is admitted only when every compact line is unique and the
    // generated-line sequence is unchanged.  The projector reconstructs the
    // compact file from exact source lines, so generated wrapper bytes cannot
    // leak into the result.
    let reorder_baseline:[]u8="// generated policy\nfn body() i32 {\nlet first: i32 = 40;\n// generated accounting\nlet second: i32 = 2;\nreturn first + second;\n}\nfn main() i32 { return body(); }\n";
    let reorder_edited:[]u8="// generated policy\nfn body() i32 {\nlet second: i32 = 2;\n// generated accounting\nlet first: i32 = 40;\nreturn first + second;\n}\nfn main() i32 { return body(); }\n";
    let reordered:ZsProjection=script_projection(compact_many,reorder_baseline,reorder_edited);
    projection_check(reordered.ok==1&&@strEq(reordered.compact,
        "script;\nlet second: i32 = 2;\nlet first: i32 = 40;\nreturn first + second;\n")&&
        @strEq(reordered.reason,"unique compact source line reorder"),
        "unique source line reorder projects",&fail);

    // A changed generated line must not be treated as a source move, even if
    // a source line was also moved.  This is the fail-closed boundary for the
    // bounded reorder proof.
    let reorder_generated_edit:[]u8="// generated policy\nfn body() i32 {\nlet second: i32 = 2;\n// edited generated accounting\nlet first: i32 = 40;\nreturn first + second;\n}\nfn main() i32 { return body(); }\n";
    let reorder_conflict:ZsProjection=script_projection(compact_many,reorder_baseline,reorder_generated_edit);
    projection_check(reorder_conflict.ok==0&&reorder_conflict.conflict_end>reorder_conflict.conflict_start,
        "generated edit during source reorder conflicts",&fail);

    // A source edit followed by an unmappable generated edit must remain a
    // conflict, and its offsets must refer to the complete derived baseline,
    // not the sliced region used by the multi-region fallback.
    let mixed_baseline:[]u8="// generated policy\nfn body() i32 {\nlet first: i32 = 40;\n// generated accounting\nlet second: i32 = 2;\nreturn first + second;\n}\nfn main() i32 { return body(); }\n";
    let mixed_edited:[]u8="// generated policy\nfn body() i32 {\nlet first: i32 = 41;\n// edited generated accounting\nlet second: i32 = 2;\nreturn first + second;\n}\nfn main() i32 { return body(); }\n";
    let mixed:ZsProjection=script_projection(compact_many,mixed_baseline,mixed_edited);
    let generated_at:i32=zsp_find_from(mixed_baseline,"// generated accounting",0);
    let source_at:i32=zsp_find_from(mixed_baseline,"let first: i32 = 40;",0);
    projection_check(mixed.ok==0&&mixed.conflict_end>mixed.conflict_start&&
        mixed.conflict_start>=source_at&&mixed.conflict_start<generated_at,
        "multi-region conflict offsets stay in global baseline coordinates",&fail);

    // A generated wrapper line can accidentally have the same text as a
    // compact line.  Text-only context matching must not then project a
    // generated-only replacement onto a different compact statement.
    let collision_compact:[]u8="script;\nreturn answer;\nreturn first;\n";
    let collision_baseline:[]u8="header\nreturn answer;\nfooter\n";
    let collision_edited:[]u8="header\nreturn first;\nfooter\n";
    let collision:ZsProjection=script_projection(collision_compact,
        collision_baseline,collision_edited);
    projection_check(collision.ok==0&&collision.conflict_end>collision.conflict_start,
        "generated line colliding with compact text conflicts",&fail);

    // A parser-hoisted captureless closure carries an exact origin for its
    // single return statement.  Permit an edit to that body while preserving
    // the generated declaration and suffix byte-for-byte; the projection is
    // reconstructed from compact bytes, never from generated wrapper text.
    let closure_compact:[]u8="script;\nlet f: fn(i32) i32 = fn[](x: i32) i32 { return x + 40; };\nreturn f(2);\n";
    let closure_baseline:[]u8="fn __clos_0(x: i32) i32 {\n    return x + 40;\n}\n\nfn main() i32 { return 0; }\n";
    let closure_edited:[]u8="fn __clos_0(x: i32) i32 {\n    return x + 41;\n}\n\nfn main() i32 { return 0; }\n";
    let closure_projected:ZsProjection=script_projection(closure_compact,
        closure_baseline,closure_edited);
    projection_check(closure_projected.ok==1&&
        @strEq(closure_projected.compact,
            "script;\nlet f: fn(i32) i32 = fn[](x: i32) i32 { return x + 41; };\nreturn f(2);\n")&&
        @strEq(closure_projected.reason,"captureless closure body origin"),
        "captureless closure body edit projects by origin",&fail);

    let closure_conflict_edit:[]u8="fn __clos_1(x: i32) i32 {\n    return x + 41;\n}\n\nfn main() i32 { return 0; }\n";
    let closure_conflict:ZsProjection=script_projection(closure_compact,
        closure_baseline,closure_conflict_edit);
    projection_check(closure_conflict.ok==0&&
        closure_conflict.conflict_start>0&&
        closure_conflict.conflict_end>closure_conflict.conflict_start&&
        closure_conflict.conflict_start<closure_baseline.len&&
        closure_conflict.conflict_end<=closure_baseline.len,
        "captureless closure generated suffix edit conflicts",&fail);

    // The same origin projection remains valid at the five-parameter scalar
    // boundary. Preserve the generated declaration exactly while projecting
    // only the compact closure's return expression.
    let closure_five_compact:[]u8="script;\nlet f: fn(i64,i64,i64,i64,i64) i64 = fn[](a:i64,b:i64,c:i64,d:i64,e:i64) i64 { return a + b + c + d + e; };\nreturn f(8,8,8,9,9);\n";
    let closure_five_baseline:[]u8="fn __clos_0(a: i64, b: i64, c: i64, d: i64, e: i64) i64 {\n    return a + b + c + d + e;\n}\n\nfn main() i64 { return 0; }\n";
    let closure_five_edited:[]u8="fn __clos_0(a: i64, b: i64, c: i64, d: i64, e: i64) i64 {\n    return a + b + c + d + e + 1;\n}\n\nfn main() i64 { return 0; }\n";
    let closure_five_projected:ZsProjection=script_projection(closure_five_compact,
        closure_five_baseline,closure_five_edited);
    projection_check(closure_five_projected.ok==1&&
        @strEq(closure_five_projected.compact,
            "script;\nlet f: fn(i64,i64,i64,i64,i64) i64 = fn[](a:i64,b:i64,c:i64,d:i64,e:i64) i64 { return a + b + c + d + e + 1; };\nreturn f(8,8,8,9,9);\n")&&
        @strEq(closure_five_projected.reason,"captureless closure body origin"),
        "five-parameter closure body edit projects by origin",&fail);

    let closure_five_header_edit:[]u8="fn __clos_1(a: i64, b: i64, c: i64, d: i64, e: i64) i64 {\n    return a + b + c + d + e + 1;\n}\n\nfn main() i64 { return 0; }\n";
    let closure_five_conflict:ZsProjection=script_projection(closure_five_compact,
        closure_five_baseline,closure_five_header_edit);
    projection_check(closure_five_conflict.ok==0&&
        closure_five_conflict.conflict_end>closure_five_conflict.conflict_start&&
        closure_five_conflict.conflict_end<=closure_five_baseline.len,
        "five-parameter closure generated header edit conflicts",&fail);

    let closure_two_compact:[]u8="script;\nlet f: fn(i64) i64 = fn[](x:i64) i64 { let y: i64 = x + 1; return y; };\nreturn f(2);\n";
    let closure_two_baseline:[]u8="fn __clos_0(x: i64) i64 {\n    let y: i64 = x + 1;\n    return y;\n}\n\nfn main() i64 { return 0; }\n";
    let closure_two_edited:[]u8="fn __clos_0(x: i64) i64 {\n    let y: i64 = x + 1;\n    return y + 1;\n}\n\nfn main() i64 { return 0; }\n";
    let closure_two_projected:ZsProjection=script_projection(closure_two_compact,
        closure_two_baseline,closure_two_edited);
    projection_check(closure_two_projected.ok==1&&
        @strEq(closure_two_projected.compact,
            "script;\nlet f: fn(i64) i64 = fn[](x:i64) i64 { let y: i64 = x + 1; return y + 1; };\nreturn f(2);\n")&&
        @strEq(closure_two_projected.reason,"captureless closure two-body origin"),
        "two-statement closure return edit projects by origin",&fail);
    let closure_two_assignment_edit:[]u8="fn __clos_0(x: i64) i64 {\n    let y: i64 = x + 2;\n    return y + 1;\n}\n\nfn main() i64 { return 0; }\n";
    let closure_two_assignment_conflict:ZsProjection=script_projection(closure_two_compact,
        closure_two_baseline,closure_two_assignment_edit);
    projection_check(closure_two_assignment_conflict.ok==0&&
        closure_two_assignment_conflict.conflict_end>closure_two_assignment_conflict.conflict_start,
        "two-statement closure local edit conflicts",&fail);

    let closure_three_compact:[]u8="script;\nlet f: fn(i64) i64 = fn[](x:i64) i64 { let y: i64 = x + 1; let z: i64 = y + 2; return z; };\nreturn f(2);\n";
    let closure_three_baseline:[]u8="fn __clos_0(x: i64) i64 {\n    let y: i64 = x + 1;\n    let z: i64 = y + 2;\n    return z;\n}\n\nfn main() i64 { return 0; }\n";
    let closure_three_edited:[]u8="fn __clos_0(x: i64) i64 {\n    let y: i64 = x + 1;\n    let z: i64 = y + 2;\n    return z + 1;\n}\n\nfn main() i64 { return 0; }\n";
    let closure_three_projected:ZsProjection=script_projection(closure_three_compact,
        closure_three_baseline,closure_three_edited);
    projection_check(closure_three_projected.ok==1&&
        @strEq(closure_three_projected.compact,
            "script;\nlet f: fn(i64) i64 = fn[](x:i64) i64 { let y: i64 = x + 1; let z: i64 = y + 2; return z + 1; };\nreturn f(2);\n")&&
        @strEq(closure_three_projected.reason,"captureless closure three-body origin"),
        "three-statement closure return edit projects by origin",&fail);
    let closure_three_local_edit:[]u8="fn __clos_0(x: i64) i64 {\n    let y: i64 = x + 1;\n    let z: i64 = y + 3;\n    return z + 1;\n}\n\nfn main() i64 { return 0; }\n";
    let closure_three_local_conflict:ZsProjection=script_projection(closure_three_compact,
        closure_three_baseline,closure_three_local_edit);
    projection_check(closure_three_local_conflict.ok==0&&
        closure_three_local_conflict.conflict_end>closure_three_local_conflict.conflict_start,
        "three-statement closure local edit conflicts",&fail);

    let closure_four_compact:[]u8="script;\nlet f: fn(i64) i64 = fn[](x:i64) i64 { let y: i64 = x + 1; let z: i64 = y + 2; let q: i64 = z + 3; return q; };\nreturn f(2);\n";
    let closure_four_baseline:[]u8="fn __clos_0(x: i64) i64 {\n    let y: i64 = x + 1;\n    let z: i64 = y + 2;\n    let q: i64 = z + 3;\n    return q;\n}\n\nfn main() i64 { return 0; }\n";
    let closure_four_edited:[]u8="fn __clos_0(x: i64) i64 {\n    let y: i64 = x + 1;\n    let z: i64 = y + 2;\n    let q: i64 = z + 3;\n    return q + 1;\n}\n\nfn main() i64 { return 0; }\n";
    let closure_four_projected:ZsProjection=script_projection(closure_four_compact,closure_four_baseline,closure_four_edited);
    projection_check(closure_four_projected.ok==1&&
        @strEq(closure_four_projected.compact,"script;\nlet f: fn(i64) i64 = fn[](x:i64) i64 { let y: i64 = x + 1; let z: i64 = y + 2; let q: i64 = z + 3; return q + 1; };\nreturn f(2);\n")&&
        @strEq(closure_four_projected.reason,"captureless closure four-body origin"),
        "four-statement closure return edit projects by origin",&fail);
    let closure_four_local_edit:[]u8="fn __clos_0(x: i64) i64 {\n    let y: i64 = x + 1;\n    let z: i64 = y + 2;\n    let q: i64 = z + 4;\n    return q + 1;\n}\n\nfn main() i64 { return 0; }\n";
    let closure_four_local_conflict:ZsProjection=script_projection(closure_four_compact,closure_four_baseline,closure_four_local_edit);
    projection_check(closure_four_local_conflict.ok==0&&closure_four_local_conflict.conflict_end>closure_four_local_conflict.conflict_start,
        "four-statement closure local edit conflicts",&fail);

    let closure_five_compact:[]u8="script;\nlet f: fn(i64) i64 = fn[](x:i64) i64 { let a: i64 = x + 1; let b: i64 = a + 2; let c: i64 = b + 3; let d: i64 = c + 4; return d; };\nreturn f(2);\n";
    let closure_five_baseline:[]u8="fn __clos_0(x: i64) i64 {\n    let a: i64 = x + 1;\n    let b: i64 = a + 2;\n    let c: i64 = b + 3;\n    let d: i64 = c + 4;\n    return d;\n}\n\nfn main() i64 { return 0; }\n";
    let closure_five_edited:[]u8="fn __clos_0(x: i64) i64 {\n    let a: i64 = x + 1;\n    let b: i64 = a + 2;\n    let c: i64 = b + 3;\n    let d: i64 = c + 4;\n    return d + 1;\n}\n\nfn main() i64 { return 0; }\n";
    let closure_five_projected:ZsProjection=script_projection(closure_five_compact,closure_five_baseline,closure_five_edited);
    projection_check(closure_five_projected.ok==1&&
        @strEq(closure_five_projected.compact,"script;\nlet f: fn(i64) i64 = fn[](x:i64) i64 { let a: i64 = x + 1; let b: i64 = a + 2; let c: i64 = b + 3; let d: i64 = c + 4; return d + 1; };\nreturn f(2);\n")&&
        @strEq(closure_five_projected.reason,"captureless closure five-body origin"),
        "five-statement closure return edit projects by origin",&fail);
    let closure_five_local_edit:[]u8="fn __clos_0(x: i64) i64 {\n    let a: i64 = x + 1;\n    let b: i64 = a + 2;\n    let c: i64 = b + 4;\n    let d: i64 = c + 4;\n    return d + 1;\n}\n\nfn main() i64 { return 0; }\n";
    let closure_five_local_conflict:ZsProjection=script_projection(closure_five_compact,closure_five_baseline,closure_five_local_edit);
    projection_check(closure_five_local_conflict.ok==0&&closure_five_local_conflict.conflict_end>closure_five_local_conflict.conflict_start,
        "five-statement closure local edit conflicts",&fail);

    let cap_compact:[]u8="script;\nlet base: i32 = 40;\nlet f: fn(i32) i32 = fn[base](x: i32) i32 { return x + base; };\nreturn f(2);\n";
    let cap_base:[]u8="fn[base] closure\n    let base: i32 = 40;\n    return x + base;\nend\n";
    let cap_edit:[]u8="fn[base] closure\n    let base: i32 = 40;\n    return x + base + 1;\nend\n";
    let cap_ok:ZsProjection=script_projection(cap_compact,cap_base,cap_edit);
    projection_check(cap_ok.ok==1&&@strEq(cap_ok.reason,"captured scalar closure body origin")&&@strEq(cap_ok.compact,"script;\nlet base: i32 = 40;\nlet f: fn(i32) i32 = fn[base](x: i32) i32 { return x + base + 1; };\nreturn f(2);\n"),"captured scalar return projects exact bytes",&fail);
    let cap_init:[]u8="fn[base] closure\n    let base: i32 = 41;\n    return x + base;\nend\n";
    projection_check(script_projection(cap_compact,cap_base,cap_init).ok==0,"captured initializer edit conflicts",&fail);
    let cap_header:[]u8="fn[delta] closure\n    let base: i32 = 40;\n    return x + base + 1;\nend\n";
    projection_check(script_projection(cap_compact,cap_base,cap_header).ok==0,"captured header edit conflicts",&fail);
    let cap_dup:[]u8="fn[base] closure\n    return x + base;\nend\nfn[base] closure\n    return x + base;\nend\n";
    projection_check(script_projection(cap_compact,cap_base,cap_dup).ok==0,"duplicate captured context conflicts",&fail);
    let cap_ptr_compact:[]u8="script;\nlet base: i32 = 40;\nlet f: fn(i32) i32 = fn[&base](x: i32) i32 { return x + base; };\nreturn f(2);\n";
    projection_check(script_projection(cap_ptr_compact,cap_base,cap_edit).ok==0,"pointer captured context conflicts",&fail);
    let cap_missing_close:[]u8="script;\nlet f: fn(i32) i32 = fn[base(x: i32) i32 { return x + base; };\nreturn f(2);\n";
    projection_check(script_projection(cap_missing_close,cap_base,cap_edit).ok==0,"malformed captured context conflicts",&fail);
    let cap_multi_compact:[]u8="script;\nlet base: i32 = 40;\nlet delta: i32 = 2;\nlet f: fn(i32) i32 = fn[base,delta](x: i32) i32 { return x + base + delta; };\nreturn f(2);\n";
    let cap_multi_base:[]u8="fn[base,delta] closure\n    let base: i32 = 40;\n    let delta: i32 = 2;\n    return x + base + delta;\nend\n";
    let cap_multi_edit:[]u8="fn[base,delta] closure\n    let base: i32 = 40;\n    let delta: i32 = 2;\n    return x + base + delta + 1;\nend\n";
    let cap_multi:ZsProjection=script_projection(cap_multi_compact,cap_multi_base,cap_multi_edit);
    projection_check(cap_multi.ok==1&&@strEq(cap_multi.compact,"script;\nlet base: i32 = 40;\nlet delta: i32 = 2;\nlet f: fn(i32) i32 = fn[base,delta](x: i32) i32 { return x + base + delta + 1; };\nreturn f(2);\n"),"multi captured return projects exact bytes",&fail);
    if(fail==0){_zag_println("script-projection pass=30 fail=0");return 0;}
    return 1;
}
