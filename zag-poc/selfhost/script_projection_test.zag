@import("script_projection.zag")

fn projection_check(ok:i32,name:[]u8,fail:*i32)void{
    if(ok==1){_zag_println(_zag_str_concat("ok  ",name));}
    else{_zag_eprintln(_zag_str_concat("XX  ",name));fail.*=fail.*+1;}
}

fn main()i32{
    let fail:i32=0;
    let compact:[]u8="script;\nlet answer: i32 = 40 + 2;\nreturn answer;\n";
    let baseline:[]u8="// generated policy\nfn body() i32 {\nlet answer: i32 = 40 + 2;\nreturn answer;\n}\nfn main() i32 { return body(); }\n";
    let edited:[]u8="// generated policy\nfn body() i32 {\nlet answer: i32 = 40 + 3;\nreturn answer;\n}\nfn main() i32 { return body(); }\n";
    let projected:ZsProjection=script_projection(compact,baseline,edited);
    projection_check(projected.ok==1&&@strEq(projected.compact,
        "script;\nlet answer: i32 = 40 + 3;\nreturn answer;\n"),
        "localized body edit projects to compact source",&fail);

    let inserted:[]u8="// generated policy\nfn body() i32 {\nlet answer: i32 = 40 + 2;\nprintln(\"checked\");\nreturn answer;\n}\nfn main() i32 { return body(); }\n";
    let insertion:ZsProjection=script_projection(compact,baseline,inserted);
    projection_check(insertion.ok==1&&zsp_find_from(insertion.compact,
        "println(\"checked\");",0)>=0,"localized insertion projects",&fail);

    let deleted:[]u8="// generated policy\nfn body() i32 {\nreturn answer;\n}\nfn main() i32 { return body(); }\n";
    let deletion:ZsProjection=script_projection(compact,baseline,deleted);
    projection_check(deletion.ok==1&&zsp_find_from(deletion.compact,
        "let answer",0)<0&&zsp_find_from(deletion.compact,"return answer;",0)>=0,
        "localized deletion projects",&fail);

    let wrapper_edit:[]u8="// changed policy\nfn body() i32 {\nlet answer: i32 = 40 + 2;\nreturn answer;\n}\nfn main() i32 { return body(); }\n";
    let generated:ZsProjection=script_projection(compact,baseline,wrapper_edit);
    projection_check(generated.ok==0&&generated.conflict_end>generated.conflict_start,
        "generated-only edit conflicts",&fail);

    let duplicate_compact:[]u8="script;\nreturn answer;\nreturn answer;\n";
    let duplicate_baseline:[]u8="header\nreturn answer;\nfooter\n";
    let duplicate_edit:[]u8="header\nreturn other;\nfooter\n";
    let ambiguous:ZsProjection=script_projection(duplicate_compact,duplicate_baseline,duplicate_edit);
    projection_check(ambiguous.ok==0&&ambiguous.conflict_end>ambiguous.conflict_start,
        "duplicate compact context conflicts",&fail);

    let unchanged:ZsProjection=script_projection(compact,baseline,baseline);
    projection_check(unchanged.ok==1&&@strEq(unchanged.compact,compact),
        "unchanged derivation is exact",&fail);

    // A nested map lookup within a typed interpolation must project exactly
    // through the generated wrapper, preserving both sets of string quotes.
    let map_compact:[]u8="script;\nlet names = {\"a\": \"Ada\"};\nlet greeting = f\"hi {names[\"a\"]}\";\nprintln(greeting);\n";
    let map_baseline:[]u8="// generated policy\nfn body() i32 {\nlet names = {\"a\": \"Ada\"};\nlet greeting = f\"hi {names[\"a\"]}\";\nprintln(greeting);\nreturn 0;\n}\nfn main() i32 { return body(); }\n";
    let map_edited:[]u8="// generated policy\nfn body() i32 {\nlet names = {\"a\": \"Ada\"};\nlet greeting = f\"hello {names[\"a\"]}\";\nprintln(greeting);\nreturn 0;\n}\nfn main() i32 { return body(); }\n";
    let map_expected:[]u8="script;\nlet names = {\"a\": \"Ada\"};\nlet greeting = f\"hello {names[\"a\"]}\";\nprintln(greeting);\n";
    let map_projected:ZsProjection=script_projection(map_compact,map_baseline,map_edited);
    projection_check(map_projected.ok==1&&@strEq(map_projected.compact,map_expected),
        "nested interpolation map expression projects exactly",&fail);

    if(fail==0){_zag_println("script-projection pass=7 fail=0");return 0;}
    return 1;
}
