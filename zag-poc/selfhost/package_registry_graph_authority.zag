@import("package_registry_transitive.zag")

// Explicit opt-in foreground seam. The caller supplies the complete graph
// lock before asking for a selected package. Ordinary package_registry_lookup
// remains unchanged; this API does not fetch or import module bytes.
enum PackageRegistryGraphAuthorityError {
    none,
    invalid_query,
    invalid_lock,
    lock_mismatch,
    package_not_found,
    version_not_found,
}

struct PackageRegistryGraphAuthorizedLookup {
    authorized: i32,
    found: i32,
    name: []u8,
    version: []u8,
    source: []u8,
    checksum: PackageRawChecksum,
    error: PackageRegistryGraphAuthorityError,
}

// A complete graph-lock is deliberately supplied by the foreground caller.
// Keeping the context as borrowed bytes avoids hidden filesystem reads and
// preserves the default resolver's existing behavior until parser-owned graph
// construction is available.
struct PackageRegistryGraphAuthorityContext {
    index: []u8,
    edges: []u8,
    lock: []u8,
}

fn package_registry_graph_authority_bad(
    error: PackageRegistryGraphAuthorityError)
    PackageRegistryGraphAuthorizedLookup {
    return PackageRegistryGraphAuthorizedLookup{.authorized = 0, .found = 0,
        .name = "", .version = "", .source = "",
        .checksum = PackageRawChecksum{.first = 0, .second = 0, .bytes = 0},
        .error = error};
}

fn package_registry_graph_authority_has_target(edges: []u8,
    name: []u8) i32 {
    let count: i32 = package_registry_transitive_line_count(edges);
    let line_no: i32 = 0;
    while (line_no < count) {
        let line: []u8 = package_registry_line(edges, line_no);
        if (@strEq(package_registry_transitive_part(line, 1), name)) {
            return 1;
        }
        line_no = line_no + 1;
    }
    return 0;
}

fn package_registry_graph_authority_lock_entry(lock: []u8,
    name: []u8) PackageRegistryGraphLockEntry {
    let bad: PackageRegistryGraphLockEntry = PackageRegistryGraphLockEntry{
        .name = "", .version = "", .source = "",
        .checksum = PackageRawChecksum{.first = 0, .second = 0, .bytes = 0},
        .valid = 0};
    let count: i32 = package_registry_graph_lock_line_count(lock);
    let line_no: i32 = 1;
    while (line_no < count - 2) {
        let entry: PackageRegistryGraphLockEntry =
            package_registry_graph_lock_entry(package_registry_line(lock, line_no));
        if (entry.valid == 1 && @strEq(entry.name, name)) { return entry; }
        line_no = line_no + 1;
    }
    return bad;
}

fn package_registry_graph_lock_authorized_select(index: []u8,
    edges: []u8, lock: []u8, name: []u8)
    PackageRegistryGraphAuthorizedLookup {
    if (package_import_safe_name(name) == 0 ||
        package_registry_graph_authority_has_target(edges, name) == 0) {
        return package_registry_graph_authority_bad(
            PackageRegistryGraphAuthorityError.invalid_query);
    }
    let checked: PackageRegistryGraphLockCheck =
        package_registry_graph_lock_verify(index, edges, lock);
    if (checked.valid == 0) {
        let error: PackageRegistryGraphAuthorityError =
            PackageRegistryGraphAuthorityError.lock_mismatch;
        if (checked.error == PackageRegistryTransitiveError.invalid_lock) {
            error = PackageRegistryGraphAuthorityError.invalid_lock;
        }
        return package_registry_graph_authority_bad(error);
    }
    let grouped: []u8 = package_registry_transitive_group(edges, name);
    let selected: PackageRegistryLookup =
        package_registry_lookup_all(index, name, grouped);
    if (grouped.len > 0) { _zag_str_free(grouped); }
    if (selected.found == 0) {
        let error: PackageRegistryGraphAuthorityError =
            PackageRegistryGraphAuthorityError.version_not_found;
        if (selected.error == PackageRegistryError.package_not_found) {
            error = PackageRegistryGraphAuthorityError.package_not_found;
        }
        return package_registry_graph_authority_bad(error);
    }
    let pinned: PackageRegistryGraphLockEntry =
        package_registry_graph_authority_lock_entry(lock, name);
    if (pinned.valid == 0 || !@strEq(pinned.version, selected.version) ||
        !@strEq(pinned.source, selected.source) ||
        package_raw_checksum_equal(pinned.checksum, selected.checksum) == 0) {
        return package_registry_graph_authority_bad(
            PackageRegistryGraphAuthorityError.lock_mismatch);
    }
    return PackageRegistryGraphAuthorizedLookup{.authorized = 1, .found = 1,
        .name = selected.name, .version = selected.version,
        .source = selected.source, .checksum = selected.checksum,
        .error = PackageRegistryGraphAuthorityError.none};
}

// Explicit foreground admission for a registry import result. This is an
// opt-in post-resolution check: package_import_resolve remains the stable
// default and callers must provide the exact graph index, edge set, and lock
// bytes that govern the compilation. A result is authorized only when the
// graph verifier and selected version/source/raw checksum all agree.
fn package_import_registry_graph_authorize(
    result: *PackageImportResolution,
    context: PackageRegistryGraphAuthorityContext)
    PackageRegistryGraphAuthorityError {
    if (result.*.matched == 0 || result.*.registry_mode == 0 ||
        result.*.dependency.len == 0 || result.*.registry_version.len == 0 ||
        result.*.registry_source.len == 0 || context.index.len == 0 ||
        context.edges.len == 0 || context.lock.len == 0) {
        result.*.graph_authorized = 0;
        result.*.error = PackageImportError.registry_lock_mismatch;
        return PackageRegistryGraphAuthorityError.invalid_query;
    }
    let selected: PackageRegistryGraphAuthorizedLookup =
        package_registry_graph_lock_authorized_select(context.index,
            context.edges, context.lock, result.*.dependency);
    if (selected.authorized == 0 || selected.found == 0 ||
        !@strEq(selected.version, result.*.registry_version) ||
        !@strEq(selected.source, result.*.registry_source) ||
        package_raw_checksum_equal(selected.checksum, result.*.checksum) == 0) {
        result.*.graph_authorized = 0;
        result.*.error = PackageImportError.registry_lock_mismatch;
        if (selected.error == PackageRegistryGraphAuthorityError.invalid_query) {
            return PackageRegistryGraphAuthorityError.invalid_query;
        }
        if (selected.error == PackageRegistryGraphAuthorityError.invalid_lock) {
            return PackageRegistryGraphAuthorityError.invalid_lock;
        }
        return PackageRegistryGraphAuthorityError.lock_mismatch;
    }
    result.*.graph_authorized = 1;
    result.*.error = PackageImportError.none;
    return PackageRegistryGraphAuthorityError.none;
}
