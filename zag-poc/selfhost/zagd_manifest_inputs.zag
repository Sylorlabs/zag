// AST-free daemon validation for compiler-published module and dependency-input
// snapshots. Keeping this boundary separate makes the exact foreground record
// currentness contract directly testable without starting a background daemon.

@import("zagd.zag")
@import("zagd_linux.zag")
@import("semantic_manifest_format.zag")

fn zmi_source_path_is_zs(path:[]u8)i32{
    return (path.len>=3&&@strEq(path[path.len-3..],".zs")) as i32;
}
fn zmi_source_starts_script(source:[]u8)i32{
    let i:i32=0;
    while(i<source.len){
        while(i<source.len&&(source[i]==' '||source[i]=='\t'||
            source[i]=='\n'||source[i]=='\r')){i=i+1;}
        if(i+1<source.len&&source[i]=='/'&&source[i+1]=='/'){
            while(i<source.len&&source[i]!='\n'){i=i+1;}
        }else{
            if(i+7<=source.len&&@strEq(source[i..i+7],"script;")){return 1;}
            return 0;
        }
    }
    return 0;
}

// Published inputs may be canonical absolute paths, canonical project-relative
// paths, or canonical leading-parent paths for reviewed sibling dependencies.
// Interior traversal and control characters fail closed.
fn zagd_dependency_input_path_safe(path:[]u8)i32{
    if(path.len==0||path[path.len-1]=='/'){return 0;}
    let absolute:i32=(path[0]=='/') as i32;let start:i32=absolute;
    let normal_seen:i32=0;let i:i32=start;
    while(i<=path.len){
        if(i<path.len&&(path[i]=='\n'||path[i]=='\r'||path[i]=='\t'||
            path[i]==0||path[i]=='\\')){return 0;}
        if(i==path.len||path[i]=='/'){
            if(i==start){return 0;}let segment:[]u8=path[start..i];
            if(@strEq(segment,".")){return 0;}
            if(@strEq(segment,"..")){
                if(absolute==1||normal_seen==1){return 0;}
            }else{normal_seen=1;}
            start=i+1;
        }
        i=i+1;
    }
    return 1;
}
fn zagd_dependency_input_path(root:[]u8,name:[]u8)[]u8{
    if(name.len>0&&name[0]=='/'){return zagd_text_clone(name);}
    return zagd_join_path(root,name);
}

// Validate every compiler-published source and dependency-input node against
// the bytes currently on disk. No record is executable authority; a mismatch is
// an advisory miss that forces foreground regeneration.
fn zagd_manifest_modules_current(root:[]u8,text:[]u8)i32{
    let view:SemanticManifestView=semantic_manifest_decode(text);
    if(view.valid==0){return 0;}
    let found:i32=0;let start:i32=0;let i:i32=0;
    while(i<=text.len){
        if(i==text.len||text[i]=='\n'){
            let line:[]u8=text[start..i];
            if(line.len>12&&@strEq(line[0..12],"module_node=")){
                let node:[]u8=line[12..];let tab:i32=0;
                while(tab<node.len&&node[tab]!='\t'){tab=tab+1;}
                if(tab==node.len){return 0;}
                let name:[]u8=node[0..tab];
                if(zagd_dependency_input_path_safe(name)==0){return 0;}
                let path:[]u8=zagd_dependency_input_path(root,name);
                if(zagd_path_is_regular(path)==0){zagd_text_free(path);return 0;}
                let bytes:[]u8=_zag_read_file(path);
                if(bytes.len<0){zagd_text_free(path);return 0;}
                let source:[]u8=bytes;let injected:i32=0;
                if(@strEq(name,view.module)&&zmi_source_path_is_zs(path)==1&&
                    zmi_source_starts_script(bytes)==0){
                    source=_zag_str_concat("script;\n",bytes);injected=1;
                }
                let current:ZagdHash=zagd_content_hash(source);
                if(injected==1){_zag_free(_zag_slice_ptr(source));}
                _zag_free(_zag_slice_ptr(bytes));
                let matches:i32=zagd_hash_equal(current,smf_hash(node[tab+1..]));
                zagd_text_free(path);if(matches==0){return 0;}found=found+1;
            }else{
                let prefix:[]u8="dependency_input_node=";
                if(line.len>prefix.len&&@strEq(line[0..prefix.len],prefix)){
                    let node:[]u8=line[prefix.len..line.len];let tab:i32=0;
                    while(tab<node.len&&node[tab]!='\t'){tab=tab+1;}
                    if(tab==node.len){return 0;}
                    let name:[]u8=node[0..tab];
                    if(zagd_dependency_input_path_safe(name)==0){return 0;}
                    let path:[]u8=zagd_dependency_input_path(root,name);
                    if(zagd_path_is_regular(path)==0){zagd_text_free(path);return 0;}
                    let bytes:[]u8=_zag_read_file(path);
                    if(bytes.len<0){zagd_text_free(path);return 0;}
                    let matches:i32=zagd_hash_equal(zagd_content_hash(bytes),
                        smf_hash(node[tab+1..node.len]));
                    _zag_free(_zag_slice_ptr(bytes));zagd_text_free(path);
                    if(matches==0){return 0;}
                }
            }
            start=i+1;
        }
        i=i+1;
    }
    return (found>0) as i32;
}
