// Typed projection harness; deliberately excludes the compiler driver.
@import("fmt.zag")
@import("typed.zag")
fn main()i32{
    if(_zag_argc()!=2){return 2;}
    let path:[]u8=_zag_arg(1);let src:[]u8=_zag_read_file(path);if(src.len<0){return 3;}
    let unit:CompilationUnit=parse_compilation_unit_dir(src,dir_of(path));
    if(zt_check_expressions(unit.decls)!=0){return 1;}
    let out:ArrayList[u8]=make[u8](1024);let i:i32=0;
    let scanned:FmtFile=fmt_scan_file(src);
    while(i<scanned.headers.len){fmt_app(&out,scanned.headers.data[i]);fmt_ch(&out,10);i=i+1;}
    i=0;while(i<unit.decls.len){
        let node:*Node=unit.decls.data[i];let origin:NodeOrigin=node_origin_find(unit.origins,node);
        if(@strEq(origin.module,"<root>")){fmt_decl(&out,node);}
        i=i+1;
    }
    _zag_print(out.data[0..out.len]);return 0;
}
