// Shared bounded canonical evidence codec. SHA-256 is the existing native
// implementation, not the advisory ZagdHash checksum. No compiler authority is
// imported here. All returned buffers/lists are owned; decoded fields are owned.
@import("native/macho_arm64.zag")

struct EvidenceRecord { fields:ArrayList[[]u8], valid:i32 }

fn ev_max_bytes()i32{return 1048576;}
fn ev_max_fields()i32{return 8192;}
fn ev_empty()[]u8{return _zag_str_concat("","");}
fn ev_text(out:*ArrayList[u8],text:[]u8)void{
    let i:i32=0;while(i<text.len){push[u8](out,text[i]);i=i+1;}
}
fn ev_equal(a:[]u8,b:[]u8)i32{
    if(a.len!=b.len){return 0;}let i:i32=0;
    while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}return 1;
}
fn ev_hex_digit(c:u8)i32{
    if(c>='0'&&c<='9'){return (c as i32)-48;}
    if(c>='a'&&c<='f'){return (c as i32)-87;}return -1;
}
fn ev_digest_ok(text:[]u8)i32{
    if(text.len!=64){return 0;}let i:i32=0;
    while(i<64){if(ev_hex_digit(text[i])<0){return 0;}i=i+1;}return 1;
}
fn ev_hex_append(out:*ArrayList[u8],bytes:[]u8)void{
    let alphabet:[]u8="0123456789abcdef";let i:i32=0;
    while(i<bytes.len){let b:i32=bytes[i] as i32;
        push[u8](out,alphabet[b/16]);push[u8](out,alphabet[b%16]);i=i+1;}
}
fn ev_hash(bytes:[]u8)[]u8{
    if(bytes.len<0||bytes.len>67108864){return ev_empty();}
    let digest:ArrayList[u8]=macho_sha256(bytes);let out:ArrayList[u8]=make[u8](64);
    ev_hex_append(&out,digest.data[0..digest.len]);
    let result:[]u8=_zag_str_concat("",out.data[0..out.len]);
    free[u8](&out);free[u8](&digest);return result;
}
fn ev_matches(bytes:[]u8,digest:[]u8)i32{
    if(ev_digest_ok(digest)==0){return 0;}let actual:[]u8=ev_hash(bytes);
    let ok:i32=ev_equal(actual,digest);_zag_str_free(actual);return ok;
}
// Decimal is canonical and bounded before multiplication (no signs/overflow).
fn ev_uint(text:[]u8,max:i32)i32{
    if(text.len==0||(text.len>1&&text[0]=='0')){return -1;}
    let n:i64=0;let i:i32=0;while(i<text.len){
        let d:i64=(text[i] as i64)-48;if(d<0||d>9){return -1;}
        if(n>((max as i64)-d)/10){return -1;}n=n*10+d;
        if(n>max){return -1;}i=i+1;
    }return n as i32;
}
fn ev_add(fields:*ArrayList[[]u8],value:[]u8)void{
    push[[]u8](fields,_zag_str_concat("",value));
}
fn ev_add_int(fields:*ArrayList[[]u8],value:i32)void{
    push[[]u8](fields,_zag_i64_to_str(value as i64));
}
fn ev_fields_free(fields:*ArrayList[[]u8])void{
    let i:i32=0;while(i<fields.*.len){_zag_str_free(fields.*.data[i]);i=i+1;}
    free[[]u8](fields);
}
fn ev_get(record:EvidenceRecord,index:i32)[]u8{
    if(record.valid!=1||index<0||index>=record.fields.len){return "";}
    return record.fields.data[index];
}
// Wire: literal header, one lowercase hex line per positional field (empty
// fields are empty lines), then ! + SHA256(all preceding bytes) + LF. The
// schema is field zero. No unknown/duplicate keys or alternate encodings exist.
fn ev_encode(fields:ArrayList[[]u8])[]u8{
    if(fields.len<1||fields.len>ev_max_fields()){return ev_empty();}
    let size:i64=7+66;let i:i32=0;
    while(i<fields.len){let n:i32=fields.data[i].len;
        if(n<0||n>ev_max_bytes()){return ev_empty();}
        size=size+(n as i64)*2+1;if(size>ev_max_bytes()){return ev_empty();}i=i+1;
    }
    let out:ArrayList[u8]=make[u8](size as i32);ev_text(&out,"ZAGEV1\n");i=0;
    while(i<fields.len){ev_hex_append(&out,fields.data[i]);push[u8](&out,'\n');i=i+1;}
    let sum:[]u8=ev_hash(out.data[0..out.len]);push[u8](&out,'!');ev_text(&out,sum);push[u8](&out,'\n');
    let result:[]u8=_zag_str_concat("",out.data[0..out.len]);free[u8](&out);_zag_str_free(sum);return result;
}
fn ev_decode(text:[]u8,pin:[]u8)EvidenceRecord{
    let out:EvidenceRecord=EvidenceRecord{.fields=make[[]u8](8),.valid=0};
    if(text.len<74||text.len>ev_max_bytes()||ev_matches(text,pin)==0){return out;}
    if(ev_equal(text[0..7],"ZAGEV1\n")==0){return out;}
    let end:i32=text.len-66;
    if(text[end]!='!'||text[text.len-1]!='\n'||ev_matches(text[0..end],text[end+1..text.len-1])==0){return out;}
    // Validate the whole framing before allocating any field buffers.
    let start:i32=7;let i:i32=7;let count:i32=0;
    while(i<end){if(text[i]=='\n'){
        if((i-start)%2!=0){return out;}count=count+1;
        if(count>ev_max_fields()){return out;}start=i+1;
    }else if(ev_hex_digit(text[i])<0){return out;}i=i+1;}
    if(start!=end||count<1){return out;}
    start=7;i=7;while(i<end){if(text[i]=='\n'){
        let bytes:ArrayList[u8]=make[u8]((i-start)/2);let j:i32=start;
        while(j<i){push[u8](&bytes,(ev_hex_digit(text[j])*16+ev_hex_digit(text[j+1])) as u8);j=j+2;}
        ev_add(&out.fields,bytes.data[0..bytes.len]);free[u8](&bytes);start=i+1;
    }i=i+1;}out.valid=1;return out;
}
fn evidence_record_verify(text:[]u8,pin:[]u8)i32{
    let record:EvidenceRecord=ev_decode(text,pin);let ok: i32=record.valid;
    ev_fields_free(&record.fields);return ok;
}
