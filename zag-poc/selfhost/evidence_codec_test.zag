@import("artifact_provenance.zag")
@import("content_addressed_build.zag")
@import("hostile_replay.zag")
@import("../tests/fixtures/evidence_replay_callbacks.zag")

struct EvidenceTests { checks: i32, failures: i32 }

fn ect_check(ok: i32, label: []u8, tests: *EvidenceTests) void {
    tests.*.checks = tests.*.checks + 1;
    if (ok == 1) {
        _zag_println(label);
    } else {
        let message: []u8 = _zag_str_concat("FAIL: ", label);
        _zag_eprintln(message);
        _zag_str_free(message);
        tests.*.failures = tests.*.failures + 1;
    }
}

fn ect_tamper(record: []u8) []u8 {
    let out: []u8 = _zag_str_concat("", record);
    if (out.len > 8) { out[8] = (out[8] as i32 + 1) as u8; }
    return out;
}

fn ect_replace(record: *EvidenceRecord, index: i32, value: []u8) void {
    _zag_str_free(record.*.fields.data[index]);
    record.*.fields.data[index] = _zag_str_concat("", value);
}

fn ect_provenance(tests: *EvidenceTests) void {
    let inputs: ArrayList[ArtifactInput] = make[ArtifactInput](1);
    push[ArtifactInput](&inputs, ArtifactInput{ .name = "source.zag",
        .digest = ev_hash("source"), .provenance = ev_hash("source-origin"),
        .kind = "sealed" });
    let custody: ArrayList[ArtifactCustody] = make[ArtifactCustody](1);
    push[ArtifactCustody](&custody, ArtifactCustody{
        .from = "generator", .to = "builder", .action = "sealed-build" });
    let record: []u8 = artifact_provenance_encode("artifact", "generator",
        "compiler", "sealed", inputs, custody);
    let repeat: []u8 = artifact_provenance_encode("artifact", "generator",
        "compiler", "sealed", inputs, custody);
    let pin: []u8 = ev_hash(record);
    ect_check(record.len > 0 && ev_equal(record, repeat) == 1,
        "provenance: deterministic", tests);
    ect_check(artifact_provenance_verify(record, pin, "artifact", "compiler") == 1,
        "provenance: pinned declared-sealed record verifies", tests);
    let bad: []u8 = ect_tamper(record);
    ect_check(artifact_provenance_verify(bad, pin, "artifact", "compiler") == 0,
        "provenance: tamper rejected", tests);
    let input: ArtifactInput = inputs.data[0];
    input.kind = "synthetic";
    inputs.data[0] = input;
    let refused: []u8 = artifact_provenance_encode("artifact", "generator",
        "compiler", "sealed", inputs, custody);
    ect_check(refused.len == 0, "provenance: synthetic input cannot claim sealed", tests);
    let synthetic: []u8 = artifact_provenance_encode("artifact", "generator",
        "compiler", "synthetic", inputs, custody);
    let synthetic_pin: []u8 = ev_hash(synthetic);
    ect_check(artifact_provenance_verify(synthetic, synthetic_pin, "artifact", "compiler") == 1,
        "provenance: synthetic classification verifies", tests);
    ect_check(artifact_provenance_verify(synthetic, pin, "artifact", "compiler") == 0,
        "provenance: rewritten classification cannot use trusted old pin", tests);
    _zag_str_free(record);
    _zag_str_free(repeat);
    _zag_str_free(pin);
    _zag_str_free(bad);
    _zag_str_free(refused);
    _zag_str_free(synthetic);
    _zag_str_free(synthetic_pin);
    _zag_str_free(input.digest);
    _zag_str_free(input.provenance);
    free[ArtifactInput](&inputs);
    free[ArtifactCustody](&custody);
}

fn ect_build(tests: *EvidenceTests) void {
    let compiler_pin: []u8 = ev_hash("compiler");
    let wrong_pin: []u8 = ev_hash("other-compiler");
    let inputs: BuildReceiptInputs = BuildReceiptInputs{
        .source = "source", .compiler = "compiler", .target = "native",
        .artifact = "artifact", .provenance = "provenance" };
    let record: []u8 = content_build_receipt_encode(inputs.source, inputs.compiler,
        inputs.target, inputs.artifact, inputs.provenance, compiler_pin);
    let pin: []u8 = ev_hash(record);
    ect_check(record.len > 0 && content_build_receipt_verify(record, pin, inputs, compiler_pin) == 1,
        "build: matching compiler pin issues verifiable v2 receipt", tests);
    let refused: []u8 = content_build_receipt_encode(inputs.source, inputs.compiler,
        inputs.target, inputs.artifact, inputs.provenance, wrong_pin);
    ect_check(refused.len == 0, "build: compiler mismatch refuses issuance", tests);
    _zag_str_free(refused);
    refused = content_build_receipt_encode(inputs.source, inputs.compiler,
        inputs.target, inputs.artifact, inputs.provenance, "");
    ect_check(refused.len == 0, "build: missing compiler pin refuses issuance", tests);
    _zag_str_free(refused);
    refused = content_build_receipt_encode(inputs.source, inputs.compiler,
        inputs.target, inputs.artifact, inputs.provenance,
        "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz");
    ect_check(refused.len == 0, "build: malformed compiler pin refuses issuance", tests);
    _zag_str_free(refused);
    ect_check(content_build_receipt_verify(record, pin, inputs, wrong_pin) == 0,
        "build: verification enforces independent compiler pin", tests);
    ect_check(content_build_receipt_verify(record, pin, inputs, "") == 0,
        "build: verification refuses missing pin", tests);
    let changed: BuildReceiptInputs = inputs;
    changed.source = "changed";
    ect_check(content_build_receipt_verify(record, pin, changed, compiler_pin) == 0,
        "build: changed source rejected", tests);
    changed = inputs;
    changed.compiler = "other-compiler";
    ect_check(content_build_receipt_verify(record, pin, changed, compiler_pin) == 0,
        "build: substituted compiler image rejected", tests);
    changed = inputs;
    changed.artifact = "changed-artifact";
    ect_check(content_build_receipt_verify(record, pin, changed, compiler_pin) == 0,
        "build: substituted artifact rejected", tests);
    let decoded: EvidenceRecord = ev_decode(record, pin);
    ect_replace(&decoded, 7, "enforced");
    let forged: []u8 = ev_encode(decoded.fields);
    let forged_pin: []u8 = ev_hash(forged);
    ect_check(content_build_receipt_verify(forged, forged_pin, inputs, compiler_pin) == 0,
        "build: rehashed literal enforced is not compiler-pin evidence", tests);
    ev_fields_free(&decoded.fields);
    _zag_str_free(forged);
    _zag_str_free(forged_pin);
    _zag_str_free(record);
    _zag_str_free(pin);
    _zag_str_free(compiler_pin);
    _zag_str_free(wrong_pin);
}

fn ect_replay(tests: *EvidenceTests) void {
    let binary: ArrayList[u8] = make[u8](3);
    push[u8](&binary, 0);
    push[u8](&binary, 255);
    push[u8](&binary, 10);
    let cases: ArrayList[ReplayCase] = make[ReplayCase](4);
    push[ReplayCase](&cases, ReplayCase{ .name = "base", .input = "normal",
        .expected = "ok", .parent = "", .mutation = "recorded" });
    push[ReplayCase](&cases, ReplayCase{ .name = "mutant", .input = "evil",
        .expected = "reject", .parent = "base", .mutation = "replace-input" });
    push[ReplayCase](&cases, ReplayCase{ .name = "empty", .input = "",
        .expected = "", .parent = "base", .mutation = "delete-input" });
    push[ReplayCase](&cases, ReplayCase{ .name = "binary", .input = binary.data[0..3],
        .expected = binary.data[0..3], .parent = "", .mutation = "recorded" });
    let record: []u8 = hostile_replay_encode("compiler", cases);
    let pin: []u8 = ev_hash(record);
    let compiler_pin: []u8 = ev_hash("compiler");
    ect_check(record.len > 0 && hostile_replay_verify(record, pin, "compiler") == 1,
        "replay: corpus accepts empty and binary input/output", tests);

    let good: ReplayResult = hostile_replay_run(record, pin, "compiler", compiler_pin,
        "guard-v1", evidence_guard);
    ect_check(good.valid == 1 && good.passed == 1 && good.executed == 4 &&
        good.mutants == 2 && good.mismatches == 0 && good.survivors == 0,
        "replay: real module passes recorded cases and mutants", tests);
    let transcript_pin: []u8 = ev_hash(good.transcript);
    ect_check(execution_transcript_verify(good.transcript, transcript_pin, "compiler", record, "guard-v1") == 1,
        "replay: actual-call transcript verifies", tests);
    let events: EvidenceRecord = ev_decode(good.transcript, transcript_pin);
    ect_check(ev_equal(ev_get(events, 12), "evil") == 1 &&
        ev_equal(ev_get(events, 13), "reject") == 1 &&
        ev_equal(ev_get(events, 14), "0") == 1 && ev_get(events, 18).len == 0 &&
        ev_get(events, 19).len == 0 && ev_equal(ev_get(events, 25), binary.data[0..3]) == 1,
        "replay: transcript contains actual requests and binary/empty responses", tests);
    ect_replace(&events, 13, "ok");
    let forged: []u8 = ev_encode(events.fields);
    let forged_pin: []u8 = ev_hash(forged);
    ect_check(execution_transcript_verify(forged, forged_pin, "compiler", record, "guard-v1") == 0,
        "replay: rehashed outer record cannot hide altered event", tests);
    ev_fields_free(&events.fields);
    _zag_str_free(forged);
    _zag_str_free(forged_pin);

    let repeat: ReplayResult = hostile_replay_run(record, pin, "compiler", compiler_pin,
        "guard-v1", evidence_guard);
    ect_check(ev_equal(good.transcript, repeat.transcript) == 1,
        "replay: same actual calls produce deterministic transcript", tests);
    hostile_replay_result_free(&repeat);
    let changed: ReplayResult = hostile_replay_run(record, pin, "compiler", compiler_pin,
        "guard-regression", evidence_guard_regression);
    ect_check(changed.valid == 1 && changed.passed == 0 && changed.executed == 4 &&
        changed.mismatches == 1 && changed.mutant_mismatches == 1 && changed.survivors == 1,
        "replay: changed module exposes mutant survivor and mismatch", tests);
    let changed_pin: []u8 = ev_hash(changed.transcript);
    events = ev_decode(changed.transcript, changed_pin);
    ect_check(execution_transcript_verify(changed.transcript, changed_pin, "compiler", record, "guard-regression") == 1 &&
        ev_equal(ev_get(events, 13), "ok") == 1 && ev_equal(ev_get(events, 14), "1") == 1 &&
        ev_equal(ev_get(events, events.fields.len - 1), "1") == 1,
        "replay: failure transcript records actual ok, mismatch and failing terminal status", tests);
    ev_fields_free(&events.fields);
    _zag_str_free(changed_pin);
    hostile_replay_result_free(&changed);
    changed = hostile_replay_run(record, pin, "compiler", compiler_pin,
        "always-wrong", evidence_always_wrong);
    ect_check(changed.valid == 1 && changed.passed == 0 && changed.executed == 4 &&
        changed.mismatches == 4 && changed.mutant_mismatches == 2 && changed.survivors == 2,
        "replay: all mismatches counted without stopping after first", tests);
    hostile_replay_result_free(&changed);

    let wrong_pin: []u8 = ev_hash("other-compiler");
    let refused: ReplayResult = hostile_replay_run(record, pin, "compiler", wrong_pin,
        "guard", evidence_must_not_run);
    ect_check(refused.valid == 0 && refused.executed == 0 && refused.transcript.len == 0,
        "replay: compiler mismatch rejected before callback", tests);
    hostile_replay_result_free(&refused);
    refused = hostile_replay_run(record, pin, "other-compiler", wrong_pin,
        "guard", evidence_must_not_run);
    ect_check(refused.valid == 0 && refused.executed == 0,
        "replay: corpus compiler binding rejected before callback", tests);
    hostile_replay_result_free(&refused);
    refused = hostile_replay_run(record, pin, "compiler", "",
        "guard", evidence_must_not_run);
    ect_check(refused.valid == 0 && refused.executed == 0,
        "replay: missing compiler pin rejected before callback", tests);
    hostile_replay_result_free(&refused);
    let tampered: []u8 = ect_tamper(record);
    refused = hostile_replay_run(tampered, pin, "compiler", compiler_pin,
        "guard", evidence_must_not_run);
    ect_check(refused.valid == 0 && refused.executed == 0,
        "replay: tampered corpus rejected before callback", tests);
    hostile_replay_result_free(&refused);
    refused = hostile_replay_run(record, pin, "compiler", compiler_pin,
        "oversized", evidence_oversized_callback);
    ect_check(refused.valid == 0 && refused.passed == 0 && refused.executed == 1 && refused.transcript.len == 0,
        "replay: oversized observation fails closed after actual call", tests);
    hostile_replay_result_free(&refused);
    refused = hostile_replay_run(record, pin, "compiler", compiler_pin,
        "callback-error", evidence_failed_callback);
    ect_check(refused.valid == 0 && refused.passed == 0 && refused.executed == 1 && refused.transcript.len == 0,
        "replay: callback error discards partial observation and transcript", tests);
    hostile_replay_result_free(&refused);
    let isolated: ReplayResult = hostile_replay_run(record, pin, "compiler", compiler_pin,
        "mutating", evidence_mutating_callback);
    let isolated_pin: []u8 = ev_hash(isolated.transcript);
    events = ev_decode(isolated.transcript, isolated_pin);
    ect_check(isolated.valid == 1 && ev_equal(ev_get(events, 6), "normal") == 1 &&
        ev_equal(ev_get(events, 7), "Xormal") == 1 && ev_matches(record, pin) == 1,
        "replay: callback mutation cannot rewrite corpus or recorded request", tests);
    ev_fields_free(&events.fields);
    _zag_str_free(isolated_pin);
    hostile_replay_result_free(&isolated);

    let decoded: EvidenceRecord = ev_decode(record, pin);
    ect_replace(&decoded, 10, "base");
    forged = ev_encode(decoded.fields);
    forged_pin = ev_hash(forged);
    ect_check(hostile_replay_verify(forged, forged_pin, "compiler") == 0,
        "replay: duplicate names rejected even with recomputed record pin", tests);
    refused = hostile_replay_run(forged, forged_pin, "compiler", compiler_pin,
        "guard", evidence_must_not_run);
    ect_check(refused.valid == 0 && refused.executed == 0,
        "replay: duplicate corpus invokes no callbacks", tests);
    hostile_replay_result_free(&refused);
    ev_fields_free(&decoded.fields);
    _zag_str_free(forged);
    _zag_str_free(forged_pin);
    decoded = ev_decode(record, pin);
    ect_replace(&decoded, 13, "later-parent");
    forged = ev_encode(decoded.fields);
    forged_pin = ev_hash(forged);
    refused = hostile_replay_run(forged, forged_pin, "compiler", compiler_pin,
        "guard", evidence_must_not_run);
    ect_check(refused.valid == 0 && refused.executed == 0,
        "replay: malformed later case prevents even first callback", tests);
    hostile_replay_result_free(&refused);
    ev_fields_free(&decoded.fields);
    _zag_str_free(forged);
    _zag_str_free(forged_pin);
    let mutant: ReplayCase = cases.data[1];
    mutant.name = "base";
    cases.data[1] = mutant;
    let invalid: []u8 = hostile_replay_encode("compiler", cases);
    ect_check(invalid.len == 0, "replay: encoder rejects duplicate names", tests);
    _zag_str_free(invalid);
    mutant.name = "mutant";
    mutant.parent = "missing";
    cases.data[1] = mutant;
    invalid = hostile_replay_encode("compiler", cases);
    ect_check(invalid.len == 0, "replay: encoder rejects missing mutant parent", tests);
    _zag_str_free(invalid);
    mutant.parent = "base";
    mutant.input = "normal";
    cases.data[1] = mutant;
    invalid = hostile_replay_encode("compiler", cases);
    ect_check(invalid.len == 0, "replay: encoder rejects unchanged mutant input", tests);
    _zag_str_free(invalid);
    mutant.mutation = "";
    cases.data[1] = mutant;
    invalid = hostile_replay_encode("compiler", cases);
    ect_check(invalid.len == 0, "replay: invalid case cleanup after preceding valid case", tests);
    _zag_str_free(invalid);

    hostile_replay_result_free(&good);
    _zag_str_free(transcript_pin);
    _zag_str_free(wrong_pin);
    _zag_str_free(tampered);
    _zag_str_free(record);
    _zag_str_free(pin);
    _zag_str_free(compiler_pin);
    free[ReplayCase](&cases);
    free[u8](&binary);
}

fn main() i32 {
    let tests: EvidenceTests = EvidenceTests{ .checks = 0, .failures = 0 };
    ect_provenance(&tests);
    ect_build(&tests);
    ect_replay(&tests);
    let count: []u8 = _zag_i64_to_str(tests.checks as i64);
    let failed: []u8 = _zag_i64_to_str(tests.failures as i64);
    _zag_print("evidence-codec checks=");
    _zag_print(count);
    _zag_print(" fail=");
    _zag_println(failed);
    _zag_str_free(count);
    _zag_str_free(failed);
    return (tests.failures != 0) as i32;
}
