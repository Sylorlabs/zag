// Local package import resolution shared by every compiler backend through
// parse.zag. The first contract is deliberately small and reproducible:
//
//   [deps]
//   zagkit = { path = "../zagkit" }
//
//   @import("pkg:zagkit/src/zagkit.zag") as zagkit
//
// Dependency paths are resolved relative to the nearest ancestor zag.mod.
// An explicit `mode = "vendor"` dependency additionally requires a canonical
// zag.lock beside that manifest.  The lock binds the dependency alias, declared
// vendor root, explicit module path, and the module's raw bytes.  There is no
// environment search path, registry lookup, download, version solving, or
// implicit entry-point convention in this layer.

@import("../std/list.zag")

enum PackageImportError {
    none,
    invalid_specifier,
    manifest_not_found,
    invalid_manifest,
    dependency_not_found,
    duplicate_dependency,
    invalid_dependency_path,
    module_not_found,
    invalid_vendor_dependency,
    lockfile_not_found,
    invalid_lockfile,
    lock_entry_not_found,
    checksum_mismatch,
    dependency_input_changed,
    manifest_dependency_missing,
    manifest_dependency_cycle,
    manifest_closure_limit,
}

// Two bounded modular accumulators avoid target-dependent overflow semantics.
// This is a deterministic raw-byte checksum, not a signature or a
// cryptographic authenticity claim.
struct PackageRawChecksum {
    first: i64,
    second: i64,
    bytes: i64,
}

struct PackageImportResolution {
    matched: i32,
    path: []u8,
    manifest: []u8,
    manifest_source: []u8,
    manifest_source_owned: i32,
    dependency: []u8,
    specifier: []u8,
    lockfile: []u8,
    lockfile_source: []u8,
    lockfile_source_owned: i32,
    locked: i32,
    checksum: PackageRawChecksum,
    error: PackageImportError,
}

struct PackageManifestDependency {
    path: []u8,
    mode: []u8,
    count: i32,
    valid: i32,
}

// The manifest is the source-level dependency API.  These records own their
// strings; callers may therefore retain a parsed manifest while recursively
// loading its children.  `package_manifest_dependency` above remains the
// borrowed, single-alias query used by the existing import/lock path.
struct PackageManifestDependencyEntry {
    alias: []u8,
    path: []u8,
    mode: []u8,
    valid: i32,
}

struct PackageManifest {
    path: []u8,
    name: []u8,
    version: []u8,
    compiler_pin: []u8,
    deps: ArrayList[PackageManifestDependencyEntry],
    valid: i32,
}

struct PackageClosureNode {
    manifest: []u8,
    name: []u8,
    version: []u8,
    compiler_pin: []u8,
    checksum: PackageRawChecksum,
    // Owned exact read used to parse metadata/pins. Consumers needing SHA-256
    // must hash this snapshot, never reopen the manifest after traversal.
    source: []u8,
}

struct PackageClosureEdge {
    from: []u8,
    alias: []u8,
    path: []u8,
    mode: []u8,
    to: []u8,
}

struct PackageManifestClosure {
    root: []u8,
    nodes: ArrayList[PackageClosureNode],
    edges: ArrayList[PackageClosureEdge],
    error: PackageImportError,
    valid: i32,
}

struct PackageChecksumParse {
    checksum: PackageRawChecksum,
    valid: i32,
}

struct PackageLockCheck {
    checksum: PackageRawChecksum,
    found: i32,
    mismatch: i32,
    valid: i32,
}

// A generator entry is deliberately separate from PackageLockCheck.  The
// validator consumes an existing lock and therefore requires the lockfile to
// exist; the bounded `znc package lock` command collects the same exact
// manifest/dependency/module tuple before a lock exists.  All text fields are
// owned by the returned entry and must be released by the caller.
struct PackageLockGeneratedEntry {
    alias: []u8,
    root: []u8,
    module: []u8,
    checksum: PackageRawChecksum,
    valid: i32,
}

fn package_lock_generated_bad() PackageLockGeneratedEntry {
    return PackageLockGeneratedEntry{
        .alias = "", .root = "", .module = "",
        .checksum = PackageRawChecksum{ .first = 0, .second = 0, .bytes = 0 },
        .valid = 0,
    };
}

fn package_lock_generated_release(entry: *PackageLockGeneratedEntry) void {
    if (entry.*.alias.len > 0) { _zag_str_free(entry.*.alias); }
    if (entry.*.root.len > 0) { _zag_str_free(entry.*.root); }
    if (entry.*.module.len > 0) { _zag_str_free(entry.*.module); }
    entry.*.alias = ""; entry.*.root = ""; entry.*.module = "";
    entry.*.valid = 0;
}

fn package_import_result(specifier: []u8) PackageImportResolution {
    return PackageImportResolution{
        .matched = 0, .path = "", .manifest = "", .manifest_source = "",
        .manifest_source_owned = 0,
        .dependency = "", .specifier = specifier, .lockfile = "",
        .lockfile_source = "", .lockfile_source_owned = 0, .locked = 0,
        .checksum = PackageRawChecksum{ .first = 0, .second = 0, .bytes = 0 },
        .error = PackageImportError.none,
    };
}

fn package_import_starts_with(text: []u8, prefix: []u8) i32 {
    if (text.len < prefix.len) { return 0; }
    let i: i32 = 0;
    while (i < prefix.len) {
        if (text[i] != prefix[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn package_import_dir(path: []u8) []u8 {
    let last: i32 = 0 - 1;
    let i: i32 = 0;
    while (i < path.len) {
        if (path[i] == '/') { last = i; }
        i = i + 1;
    }
    if (last < 0) { return ""; }
    if (last == 0) { return "/"; }
    return path[0..last];
}

fn package_import_join(base: []u8, child: []u8) []u8 {
    if (child.len > 0 && child[0] == '/') { return child; }
    if (base.len == 0 || @strEq(base, ".")) {
        return _zag_str_concat("./", child);
    }
    if (@strEq(base, "/")) { return _zag_str_concat("/", child); }
    let prefix: []u8 = _zag_str_concat(base, "/");
    let joined: []u8 = _zag_str_concat(prefix, child);
    _zag_str_free(prefix);
    return joined;
}

fn package_import_trim(text: []u8) []u8 {
    let start: i32 = 0;
    while (start < text.len && (text[start] == ' ' || text[start] == '\t')) {
        start = start + 1;
    }
    let end: i32 = text.len;
    while (end > start && (text[end - 1] == ' ' || text[end - 1] == '\t' ||
        text[end - 1] == '\r')) {
        end = end - 1;
    }
    return text[start..end];
}

fn package_import_unquote(text: []u8) []u8 {
    let value: []u8 = package_import_trim(text);
    if (value.len < 2 || value[0] != '"' || value[value.len - 1] != '"') {
        return "";
    }
    return value[1..value.len - 1];
}

fn package_import_safe_name(name: []u8) i32 {
    if (name.len == 0 || name.len > 64) { return 0; }
    let i: i32 = 0;
    while (i < name.len) {
        let c: u8 = name[i];
        let safe: i32 = ((c >= 'a' && c <= 'z') ||
            (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') ||
            c == '_' || c == '-') as i32;
        if (safe == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn package_import_safe_segment(segment: []u8) i32 {
    return (segment.len > 0 && !@strEq(segment, ".") &&
        !@strEq(segment, "..")) as i32;
}

fn package_import_module_safe(module: []u8) i32 {
    if (module.len < 5 || module.len > 1024 || module[0] == '/' ||
        module[module.len - 1] == '/') { return 0; }
    if (module[module.len - 4] != '.' || module[module.len - 3] != 'z' ||
        module[module.len - 2] != 'a' || module[module.len - 1] != 'g') { return 0; }
    let segment_start: i32 = 0;
    let i: i32 = 0;
    while (i < module.len) {
        if (module[i] == '/') {
            let segment: []u8 = module[segment_start..i];
            if (package_import_safe_segment(segment) == 0) { return 0; }
            segment_start = i + 1;
        } else {
            let c: u8 = module[i];
            let safe: i32 = ((c >= 'a' && c <= 'z') ||
                (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') ||
                c == '_' || c == '-' || c == '.') as i32;
            if (safe == 0) { return 0; }
        }
        i = i + 1;
    }
    return package_import_safe_segment(module[segment_start..module.len]);
}

fn package_toolchain_pin_safe(pin: []u8) i32 {
    if (pin.len != 71 || !@strEq(pin[0..7], "sha256:")) { return 0; }
    let i: i32 = 7;
    while (i < pin.len) {
        let c: u8 = pin[i];
        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn package_import_local_path_safe(path: []u8) i32 {
    if (path.len == 0 || path.len > 4096 || path[0] == '/' ||
        path[0] == '~') { return 0; }
    let i: i32 = 0;
    while (i < path.len) {
        let c: u8 = path[i];
        if (c == 0 || c == '\n' || c == '\r' || c == '\\' || c == ':') {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

fn package_import_vendor_path_safe(path: []u8) i32 {
    if (package_import_starts_with(path, "vendor/") == 0 ||
        package_import_local_path_safe(path) == 0) { return 0; }
    let segment_start: i32 = 0;
    let i: i32 = 0;
    while (i < path.len) {
        if (path[i] == '/') {
            let segment: []u8 = path[segment_start..i];
            if (package_import_safe_segment(segment) == 0) { return 0; }
            let j: i32 = 0;
            while (j < segment.len) {
                let c: u8 = segment[j];
                let safe: i32 = ((c >= 'a' && c <= 'z') ||
                    (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') ||
                    c == '_' || c == '-' || c == '.') as i32;
                if (safe == 0) { return 0; }
                j = j + 1;
            }
            segment_start = i + 1;
        }
        i = i + 1;
    }
    let final_segment: []u8 = path[segment_start..path.len];
    if (package_import_safe_segment(final_segment) == 0) { return 0; }
    let j: i32 = 0;
    while (j < final_segment.len) {
        let c: u8 = final_segment[j];
        let safe: i32 = ((c >= 'a' && c <= 'z') ||
            (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') ||
            c == '_' || c == '-' || c == '.') as i32;
        if (safe == 0) { return 0; }
        j = j + 1;
    }
    return 1;
}

fn package_import_field_mentioned(table: []u8, field: []u8) i32 {
    let i: i32 = 0;
    while (i + field.len <= table.len) {
        let before: i32 = (i == 0 || table[i - 1] == '{' ||
            table[i - 1] == ',' || table[i - 1] == ' ' ||
            table[i - 1] == '\t') as i32;
        let matched: i32 = before;
        let j: i32 = 0;
        while (j < field.len && matched != 0) {
            if (table[i + j] != field[j]) { matched = 0; }
            j = j + 1;
        }
        if (matched != 0) {
            let after: i32 = i + field.len;
            if (after == table.len || table[after] == '=' ||
                table[after] == ' ' || table[after] == '\t') { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

// Vendor declarations intentionally use a tiny strict inline-table grammar.
// Exactly one quoted `path` and one quoted `mode = "vendor"` are accepted;
// duplicate, unknown, or malformed fields fail closed.
fn package_import_vendor_table_valid(raw: []u8) i32 {
    let table: []u8 = package_import_trim(raw);
    if (table.len < 5 || table[0] != '{' ||
        table[table.len - 1] != '}') { return 0; }
    let body: []u8 = package_import_trim(table[1..table.len - 1]);
    if (body.len == 0) { return 0; }
    let path_count: i32 = 0;
    let mode_count: i32 = 0;
    let pair_count: i32 = 0;
    let position: i32 = 0;
    while (position <= body.len) {
        let end: i32 = position;
        while (end < body.len && body[end] != ',') { end = end + 1; }
        let pair: []u8 = package_import_trim(body[position..end]);
        if (pair.len == 0) { return 0; }
        let equals: i32 = 0 - 1;
        let equals_count: i32 = 0;
        let i: i32 = 0;
        while (i < pair.len) {
            if (pair[i] == '=') { equals = i; equals_count = equals_count + 1; }
            i = i + 1;
        }
        if (equals_count != 1 || equals <= 0) { return 0; }
        let key: []u8 = package_import_trim(pair[0..equals]);
        let value: []u8 = package_import_unquote(pair[equals + 1..pair.len]);
        if (value.len == 0) { return 0; }
        if (@strEq(key, "path")) {
            path_count = path_count + 1;
        } else if (@strEq(key, "mode")) {
            mode_count = mode_count + 1;
            if (!@strEq(value, "vendor")) { return 0; }
        } else {
            return 0;
        }
        pair_count = pair_count + 1;
        if (end >= body.len) { position = body.len + 1; }
        else { position = end + 1; }
    }
    return (pair_count == 2 && path_count == 1 && mode_count == 1) as i32;
}

fn package_raw_checksum(data: []u8) PackageRawChecksum {
    let a: i64 = 216613626;
    let b: i64 = 131542391;
    let i: i32 = 0;
    while (i < data.len) {
        let byte: i64 = data[i] as i64;
        a = (a * 257 + byte + 1) % 1000000007;
        b = (b * 263 + byte + 1) % 1000000009;
        i = i + 1;
    }
    return PackageRawChecksum{ .first = a, .second = b, .bytes = data.len };
}

fn package_raw_checksum_equal(a: PackageRawChecksum,
    b: PackageRawChecksum) i32 {
    return (a.first == b.first && a.second == b.second &&
        a.bytes == b.bytes) as i32;
}

fn package_lock_part(text: []u8, want: i32, separator: u8) []u8 {
    let field: i32 = 0;
    let start: i32 = 0;
    let i: i32 = 0;
    while (i < text.len) {
        if (text[i] == separator) {
            if (field == want) { return text[start..i]; }
            field = field + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    if (field == want) { return text[start..text.len]; }
    return "";
}

fn package_lock_parts_exact(text: []u8, count: i32, separator: u8) i32 {
    if (count <= 0) { return 0; }
    let fields: i32 = 1;
    let i: i32 = 0;
    while (i < text.len) {
        if (text[i] == separator) { fields = fields + 1; }
        i = i + 1;
    }
    return (fields == count) as i32;
}

fn package_lock_uint(text: []u8, maximum: i64) i64 {
    if (text.len == 0 || (text.len > 1 && text[0] == '0')) { return 0 - 1; }
    let value: i64 = 0;
    let i: i32 = 0;
    while (i < text.len) {
        if (text[i] < '0' || text[i] > '9') { return 0 - 1; }
        let digit: i64 = (text[i] as i64) - 48;
        if (value > (maximum - digit) / 10) { return 0 - 1; }
        value = value * 10 + digit;
        i = i + 1;
    }
    return value;
}

fn package_lock_checksum(text: []u8) PackageChecksumParse {
    let bad: PackageChecksumParse = PackageChecksumParse{
        .checksum = PackageRawChecksum{ .first = 0, .second = 0, .bytes = 0 },
        .valid = 0,
    };
    if (package_lock_parts_exact(text, 3, ',') == 0) { return bad; }
    let first: i64 = package_lock_uint(package_lock_part(text, 0, ','), 1000000006);
    let second: i64 = package_lock_uint(package_lock_part(text, 1, ','), 1000000008);
    let bytes: i64 = package_lock_uint(package_lock_part(text, 2, ','), 8388608);
    if (first < 0 || second < 0 || bytes < 0) { return bad; }
    return PackageChecksumParse{
        .checksum = PackageRawChecksum{ .first = first, .second = second, .bytes = bytes },
        .valid = 1,
    };
}

fn package_lock_compare(a: []u8, b: []u8) i32 {
    let common: i32 = a.len;
    if (b.len < common) { common = b.len; }
    let i: i32 = 0;
    while (i < common) {
        if (a[i] < b[i]) { return 0 - 1; }
        if (a[i] > b[i]) { return 1; }
        i = i + 1;
    }
    if (a.len < b.len) { return 0 - 1; }
    if (a.len > b.len) { return 1; }
    return 0;
}

fn package_lock_tuple_after(alias: []u8, root: []u8, module: []u8,
    previous_alias: []u8, previous_root: []u8, previous_module: []u8) i32 {
    let order: i32 = package_lock_compare(alias, previous_alias);
    if (order != 0) { return (order > 0) as i32; }
    order = package_lock_compare(root, previous_root);
    if (order != 0) { return (order > 0) as i32; }
    return (package_lock_compare(module, previous_module) > 0) as i32;
}

fn package_import_manifest(base_dir: []u8) []u8 {
    let current: []u8 = base_dir;
    if (current.len == 0) { current = "."; }
    let depth: i32 = 0;
    while (depth < 64) {
        let candidate: []u8 = package_import_join(current, "zag.mod");
        if (_zag_file_exists(candidate) == 1) { return candidate; }
        _zag_str_free(candidate);
        let parent: []u8 = package_import_dir(current);
        if (parent.len == 0) {
            if (@strEq(current, ".")) { return ""; }
            current = ".";
        } else {
            if (@strEq(parent, current)) { return ""; }
            current = parent;
        }
        depth = depth + 1;
    }
    return "";
}

fn package_import_field(table: []u8, field: []u8) []u8 {
    let i: i32 = 0;
    while (i + field.len <= table.len) {
        let boundary_before: i32 = (i == 0 || table[i - 1] == '{' ||
            table[i - 1] == ',' || table[i - 1] == ' ' || table[i - 1] == '\t') as i32;
        let match_: i32 = boundary_before;
        let j: i32 = 0;
        while (j < field.len && match_ != 0) {
            if (table[i + j] != field[j]) { match_ = 0; }
            j = j + 1;
        }
        if (match_ != 0) {
            let cursor: i32 = i + field.len;
            while (cursor < table.len && (table[cursor] == ' ' || table[cursor] == '\t')) {
                cursor = cursor + 1;
            }
            if (cursor < table.len && table[cursor] == '=') {
                cursor = cursor + 1;
                while (cursor < table.len && (table[cursor] == ' ' || table[cursor] == '\t')) {
                    cursor = cursor + 1;
                }
                if (cursor >= table.len || table[cursor] != '"') { return ""; }
                let end: i32 = cursor + 1;
                while (end < table.len && table[end] != '"') { end = end + 1; }
                if (end >= table.len) { return ""; }
                return table[cursor + 1..end];
            }
        }
        i = i + 1;
    }
    return "";
}

fn package_manifest_dependency(source: []u8,
    dependency: []u8) PackageManifestDependency {
    let result: PackageManifestDependency = PackageManifestDependency{
        .path = "", .mode = "", .count = 0, .valid = 1,
    };
    if (source.len < 0 || source.len > 1048576) {
        result.valid = 0; return result;
    }
    let in_deps: i32 = 0;
    let position: i32 = 0;
    while (position <= source.len) {
        let end: i32 = position;
        while (end < source.len && source[end] != '\n') { end = end + 1; }
        let line: []u8 = package_import_trim(source[position..end]);
        if (line.len > 0 && line[0] != '#') {
            if (line[0] == '[') {
                let close: i32 = 1;
                while (close < line.len && line[close] != ']') { close = close + 1; }
                if (close >= line.len) { result.valid = 0; return result; }
                in_deps = @strEq(package_import_trim(line[1..close]), "deps") as i32;
            } else if (in_deps != 0) {
                let equals: i32 = 0;
                while (equals < line.len && line[equals] != '=') { equals = equals + 1; }
                if (equals >= line.len) { result.valid = 0; return result; }
                let key: []u8 = package_import_trim(line[0..equals]);
                if (@strEq(key, dependency)) {
                    let raw: []u8 = package_import_trim(line[equals + 1..line.len]);
                    let path: []u8 = "";
                    let mode: []u8 = "";
                    if (raw.len > 0 && raw[0] == '{') {
                        path = package_import_field(raw, "path");
                        mode = package_import_field(raw, "mode");
                        if (package_import_field_mentioned(raw, "mode") != 0 &&
                            package_import_vendor_table_valid(raw) == 0) {
                            result.valid = 0;
                        }
                    } else {
                        path = package_import_unquote(raw);
                    }
                    result.count = result.count + 1;
                    if (path.len == 0) { result.valid = 0; }
                    result.path = path;
                    result.mode = mode;
                }
            }
        }
        if (end >= source.len) { position = source.len + 1; }
        else { position = end + 1; }
    }
    return result;
}

fn package_manifest_owned_entry_release(entry: *PackageManifestDependencyEntry) void {
    if (entry.*.alias.len > 0) { _zag_str_free(entry.*.alias); }
    if (entry.*.path.len > 0) { _zag_str_free(entry.*.path); }
    if (entry.*.mode.len > 0) { _zag_str_free(entry.*.mode); }
    entry.*.alias = ""; entry.*.path = ""; entry.*.mode = ""; entry.*.valid = 0;
}

fn package_manifest_release(manifest: *PackageManifest) void {
    if (manifest.*.path.len > 0) { _zag_str_free(manifest.*.path); }
    if (manifest.*.name.len > 0) { _zag_str_free(manifest.*.name); }
    if (manifest.*.version.len > 0) { _zag_str_free(manifest.*.version); }
    if (manifest.*.compiler_pin.len > 0) { _zag_str_free(manifest.*.compiler_pin); }
    let i: i32 = 0;
    while (i < manifest.*.deps.len) {
        package_manifest_owned_entry_release(&manifest.*.deps.data[i]);
        i = i + 1;
    }
    free[PackageManifestDependencyEntry](&manifest.*.deps);
    manifest.*.path = ""; manifest.*.name = ""; manifest.*.version = ""; manifest.*.compiler_pin = "";
    manifest.*.valid = 0;
}

fn package_manifest_bad(path: []u8) PackageManifest {
    return PackageManifest{.path = _zag_str_concat("", path), .name = "",
        .version = "", .compiler_pin = "", .deps = make[PackageManifestDependencyEntry](4), .valid = 0};
}

// No escapes in the bounded manifest subset. In particular, fields cannot
// inject tabs/newlines into the canonical closure record.
fn package_manifest_string(raw: []u8) i32 {
    if (raw.len < 2 || raw[0] != '"' || raw[raw.len - 1] != '"') { return 0; }
    let i: i32 = 1;
    while (i < raw.len - 1) {
        if (raw[i] < 32 || raw[i] == 127 || raw[i] == '"' || raw[i] == '\\') { return 0; }
        i = i + 1;
    }
    return 1;
}

fn package_manifest_local_table_valid(raw: []u8) i32 {
    if (raw.len < 2 || raw[0] != '{' || raw[raw.len - 1] != '}') { return 0; }
    let body: []u8 = package_import_trim(raw[1..raw.len - 1]);
    let eq: i32 = 0;
    while (eq < body.len && body[eq] != '=') { eq = eq + 1; }
    if (eq == body.len || !@strEq(package_import_trim(body[0..eq]), "path")) { return 0; }
    return package_manifest_string(package_import_trim(body[eq + 1..body.len]));
}

fn package_manifest_link_table_valid(raw: []u8) i32 {
    if (raw.len < 2 || raw[0] != '{' || raw[raw.len - 1] != '}') { return 0; }
    let body: []u8 = package_import_trim(raw[1..raw.len - 1]);
    let eq: i32 = 0;
    while (eq < body.len && body[eq] != '=') { eq = eq + 1; }
    if (eq == body.len || !@strEq(package_import_trim(body[0..eq]), "link")) { return 0; }
    return package_manifest_string(package_import_trim(body[eq + 1..body.len]));
}

// Native libraries can carry both a link name and a search path. They do not
// refer to Zag source manifests, even though they contain a `path` field.
// Require exactly two quoted fields to avoid silently dropping malformed
// manifest data from the authenticated source closure.
fn package_manifest_link_path_table_valid(raw: []u8) i32 {
    if (raw.len < 2 || raw[0] != '{' || raw[raw.len - 1] != '}') { return 0; }
    let body: []u8 = package_import_trim(raw[1..raw.len - 1]);
    let comma: i32 = 0;
    while (comma < body.len && body[comma] != ',') { comma = comma + 1; }
    if (comma == body.len) { return 0; }
    let link_seen: i32 = 0;
    let path_seen: i32 = 0;
    let part: i32 = 0;
    while (part < 2) {
        let pair: []u8 = "";
        if (part == 0) { pair = package_import_trim(body[0..comma]); }
        else { pair = package_import_trim(body[comma + 1..body.len]); }
        let eq: i32 = 0;
        while (eq < pair.len && pair[eq] != '=') { eq = eq + 1; }
        if (eq == pair.len) { return 0; }
        let key: []u8 = package_import_trim(pair[0..eq]);
        let value: []u8 = package_import_trim(pair[eq + 1..pair.len]);
        if (package_manifest_string(value) == 0 || value.len == 2) { return 0; }
        if (@strEq(key, "link")) { link_seen = link_seen + 1; }
        else if (@strEq(key, "path")) { path_seen = path_seen + 1; }
        else { return 0; }
        part = part + 1;
    }
    return (link_seen == 1 && path_seen == 1) as i32;
}

// The first-class manifest parser accepts the package metadata used by the
// existing top-level zag.mod as well as an optional [package] section.  Only
// path/mode dependency fields are part of this resolver API; unknown fields
// fail closed rather than being silently ignored.
fn package_manifest_parse(path: []u8, source: []u8) PackageManifest {
    let out: PackageManifest = package_manifest_bad(path);
    if (source.len < 0 || source.len > 1048576) { return out; }
    let section: i32 = 0;
    let position: i32 = 0;
    while (position <= source.len) {
        let end: i32 = position;
        while (end < source.len && source[end] != '\n') { end = end + 1; }
        let line: []u8 = package_import_trim(source[position..end]);
        if (line.len > 0 && line[0] != '#') {
            if (line[0] == '[') {
                let close: i32 = 1;
                while (close < line.len && line[close] != ']') { close = close + 1; }
                if (close != line.len - 1) { package_manifest_release(&out); return package_manifest_bad(path); }
                let title: []u8 = package_import_trim(line[1..close]);
                if (@strEq(title, "package")) { section = 1; }
                else if (@strEq(title, "deps")) { section = 2; }
                else if (@strEq(title, "toolchain")) { section = 3; }
                else { section = 4; }
            } else {
                let equals: i32 = 0;
                while (equals < line.len && line[equals] != '=') { equals = equals + 1; }
                if (equals >= line.len) { package_manifest_release(&out); return package_manifest_bad(path); }
                let key: []u8 = package_import_trim(line[0..equals]);
                let raw: []u8 = package_import_trim(line[equals + 1..line.len]);
                if (section == 3) {
                    if (@strEq(key, "compiler")) {
                        let pin: []u8 = package_import_unquote(raw);
                        if (out.compiler_pin.len > 0 || package_toolchain_pin_safe(pin) == 0) {
                            package_manifest_release(&out); return package_manifest_bad(path);
                        }
                        out.compiler_pin = _zag_str_concat("", pin);
                    } else {
                        package_manifest_release(&out); return package_manifest_bad(path);
                    }
                } else if (section == 1 || section == 0) {
                    if (@strEq(key, "name")) {
                        if (out.name.len > 0 || package_manifest_string(raw) == 0 || raw.len == 2) {
                            package_manifest_release(&out); return package_manifest_bad(path);
                        }
                        out.name = _zag_str_concat("", package_import_unquote(raw));
                    }
                    else if (@strEq(key, "version")) {
                        if (out.version.len > 0 || package_manifest_string(raw) == 0 || raw.len == 2) {
                            package_manifest_release(&out); return package_manifest_bad(path);
                        }
                        out.version = _zag_str_concat("", package_import_unquote(raw));
                    }
                    else if (section == 1 && !@strEq(key, "edition")) {
                        package_manifest_release(&out); return package_manifest_bad(path);
                    }
                } else if (section == 2) {
                    let path_value: []u8 = "";
                    let mode_value: []u8 = "";
                    if (raw.len > 0 && raw[0] == '{') {
                        if (raw[raw.len - 1] != '}') {
                            package_manifest_release(&out); return package_manifest_bad(path);
                        }
                        // Link-only entries are compiler/linker inputs, not
                        // local package edges, and remain outside the source
                        // closure while retaining existing zag.mod support.
                        if (package_import_field_mentioned(raw, "link") != 0 &&
                            package_import_field_mentioned(raw, "mode") == 0) {
                            let link_valid: i32 = 0;
                            if (package_import_field_mentioned(raw, "path") != 0) {
                                link_valid = package_manifest_link_path_table_valid(raw);
                            } else {
                                link_valid = package_manifest_link_table_valid(raw);
                            }
                            if (link_valid != 0) {
                                if (end >= source.len) { position = source.len + 1; }
                                else { position = end + 1; }
                                continue;
                            }
                            package_manifest_release(&out); return package_manifest_bad(path);
                        }
                        if (package_import_field_mentioned(raw, "path") == 0) {
                            package_manifest_release(&out); return package_manifest_bad(path);
                        }
                        // The strict vendor grammar is also the strict table
                        // grammar whenever mode is present.  A local table may
                        // omit mode but may not contain any other field.
                        if (package_import_field_mentioned(raw, "mode") != 0) {
                            if (package_import_vendor_table_valid(raw) == 0) {
                                package_manifest_release(&out); return package_manifest_bad(path);
                            }
                        } else if (package_manifest_local_table_valid(raw) == 0) {
                            package_manifest_release(&out); return package_manifest_bad(path);
                        }
                        path_value = package_import_field(raw, "path");
                        mode_value = package_import_field(raw, "mode");
                    } else {
                        if (package_manifest_string(raw) == 0) { package_manifest_release(&out); return package_manifest_bad(path); }
                        // The quoted shorthand is the existing link form.
                        if (end >= source.len) { position = source.len + 1; }
                        else { position = end + 1; }
                        continue;
                    }
                    if (package_import_safe_name(key) == 0 || path_value.len == 0 ||
                        package_import_local_path_safe(path_value) == 0 ||
                        (mode_value.len > 0 && (!@strEq(mode_value, "vendor") ||
                            package_import_vendor_path_safe(path_value) == 0))) {
                        package_manifest_release(&out); return package_manifest_bad(path);
                    }
                    let duplicate: i32 = 0;
                    let di: i32 = 0;
                    while (di < out.deps.len) {
                        if (@strEq(out.deps.data[di].alias, key)) { duplicate = 1; }
                        di = di + 1;
                    }
                    if (duplicate != 0 || out.deps.len >= 256) {
                        package_manifest_release(&out); return package_manifest_bad(path);
                    }
                    push[PackageManifestDependencyEntry](&out.deps,
                        PackageManifestDependencyEntry{.alias = _zag_str_concat("", key),
                            .path = _zag_str_concat("", path_value),
                            .mode = _zag_str_concat("", mode_value), .valid = 1});
                }
            }
        }
        if (end >= source.len) { position = source.len + 1; }
        else { position = end + 1; }
    }
    if (out.name.len > 0) { out.valid = 1; }
    return out;
}

fn package_manifest_path_normalize(path: []u8) []u8 {
    let absolute: i32 = (path.len > 0 && path[0] == '/') as i32;
    let parts: ArrayList[[]u8] = make[[]u8](8);
    let start: i32 = 0;
    let i: i32 = 0;
    while (i <= path.len) {
        if (i == path.len || path[i] == '/') {
            let part: []u8 = path[start..i];
            if (part.len == 0 || @strEq(part, ".")) { }
            else if (@strEq(part, "..")) {
                if (parts.len > 0 && !@strEq(parts.data[parts.len - 1], "..")) {
                    let _drop: []u8 = pop[[]u8](&parts);
                } else if (absolute == 0) { push[[]u8](&parts, part); }
            } else { push[[]u8](&parts, part); }
            start = i + 1;
        }
        i = i + 1;
    }
    let out: []u8 = "";
    if (absolute == 1) { out = _zag_str_concat("", "/"); }
    i = 0;
    while (i < parts.len) {
        if (out.len > 0 && !(absolute == 1 && i == 0)) { package_closure_append(&out, "/"); }
        package_closure_append(&out, parts.data[i]); i = i + 1;
    }
    free[[]u8](&parts);
    if (out.len == 0) { return _zag_str_concat("", "."); }
    return out;
}

fn package_closure_node_index(closure: PackageManifestClosure, path: []u8) i32 {
    let i: i32 = 0;
    while (i < closure.nodes.len) {
        if (@strEq(closure.nodes.data[i].manifest, path)) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn package_closure_active(active: ArrayList[[]u8], path: []u8) i32 {
    let i: i32 = 0;
    while (i < active.len) { if (@strEq(active.data[i], path)) { return 1; } i = i + 1; }
    return 0;
}

fn package_closure_compare(a: PackageManifestDependencyEntry,
    b: PackageManifestDependencyEntry) i32 {
    let common: i32 = a.alias.len;
    if (b.alias.len < common) { common = b.alias.len; }
    let i: i32 = 0;
    while (i < common) {
        if (a.alias[i] < b.alias[i]) { return 0 - 1; }
        if (a.alias[i] > b.alias[i]) { return 1; }
        i = i + 1;
    }
    if (a.alias.len < b.alias.len) { return 0 - 1; }
    if (a.alias.len > b.alias.len) { return 1; }
    return 0;
}

fn package_manifest_deps_sort(deps: *ArrayList[PackageManifestDependencyEntry]) void {
    let i: i32 = 1;
    while (i < deps.*.len) {
        let j: i32 = i;
        while (j > 0 && package_closure_compare(deps.*.data[j], deps.*.data[j - 1]) < 0) {
            let swap: PackageManifestDependencyEntry = deps.*.data[j];
            deps.*.data[j] = deps.*.data[j - 1]; deps.*.data[j - 1] = swap; j = j - 1;
        }
        i = i + 1;
    }
}

fn package_manifest_closure_visit(closure: *PackageManifestClosure,
    manifest_path: []u8, active: *ArrayList[[]u8]) void {
    if (closure.*.error != PackageImportError.none) { return; }
    if (package_closure_active(active.*, manifest_path) != 0) {
        closure.*.error = PackageImportError.manifest_dependency_cycle; return;
    }
    if (package_closure_node_index(closure.*, manifest_path) >= 0) { return; }
    if (closure.*.nodes.len >= 256 || active.*.len >= 64 || closure.*.edges.len > 4096) {
        closure.*.error = PackageImportError.manifest_closure_limit; return;
    }
    if (_zag_file_exists(manifest_path) == 0) {
        closure.*.error = PackageImportError.manifest_dependency_missing; return;
    }
    let source: []u8 = _zag_read_file(manifest_path);
    let manifest: PackageManifest = package_manifest_parse(manifest_path, source);
    if (source.len < 0 || manifest.valid == 0) {
        if (source.len >= 0) { package_import_free_read(source); }
        package_manifest_release(&manifest);
        closure.*.error = PackageImportError.invalid_manifest; return;
    }
    push[PackageClosureNode](&closure.*.nodes, PackageClosureNode{
        .manifest = _zag_str_concat("", manifest.path), .name = _zag_str_concat("", manifest.name),
        .version = _zag_str_concat("", manifest.version), .compiler_pin = _zag_str_concat("", manifest.compiler_pin),
        .checksum = package_raw_checksum(source), .source = source});
    push[[]u8](active, manifest_path);
    package_manifest_deps_sort(&manifest.deps);
    let i: i32 = 0;
    while (i < manifest.deps.len && closure.*.error == PackageImportError.none) {
        let dep: PackageManifestDependencyEntry = manifest.deps.data[i];
        let root: []u8 = package_import_join(package_import_dir(manifest_path), dep.path);
        let child_raw: []u8 = package_import_join(root, "zag.mod");
        let child: []u8 = package_manifest_path_normalize(child_raw);
        _zag_str_free(child_raw);
        _zag_str_free(root);
        if (_zag_file_exists(child) == 0) {
            closure.*.error = PackageImportError.manifest_dependency_missing;
        } else if (package_closure_active(active.*, child) != 0) {
            closure.*.error = PackageImportError.manifest_dependency_cycle;
        } else {
            push[PackageClosureEdge](&closure.*.edges, PackageClosureEdge{
                .from = _zag_str_concat("", manifest_path), .alias = _zag_str_concat("", dep.alias),
                .path = _zag_str_concat("", dep.path), .mode = _zag_str_concat("", dep.mode),
                .to = _zag_str_concat("", child)});
            package_manifest_closure_visit(closure, child, active);
        }
        _zag_str_free(child); i = i + 1;
    }
    let _pop: []u8 = pop[[]u8](active);
    package_manifest_release(&manifest);
}

fn package_manifest_closure_release(closure: *PackageManifestClosure) void {
    if (closure.*.root.len > 0) { _zag_str_free(closure.*.root); }
    let i: i32 = 0;
    while (i < closure.*.nodes.len) {
        if (closure.*.nodes.data[i].manifest.len > 0) { _zag_str_free(closure.*.nodes.data[i].manifest); }
        if (closure.*.nodes.data[i].name.len > 0) { _zag_str_free(closure.*.nodes.data[i].name); }
        if (closure.*.nodes.data[i].version.len > 0) { _zag_str_free(closure.*.nodes.data[i].version); }
        if (closure.*.nodes.data[i].compiler_pin.len > 0) { _zag_str_free(closure.*.nodes.data[i].compiler_pin); }
        package_import_free_read(closure.*.nodes.data[i].source);
        i = i + 1;
    }
    i = 0; while (i < closure.*.edges.len) {
        if (closure.*.edges.data[i].from.len > 0) { _zag_str_free(closure.*.edges.data[i].from); }
        if (closure.*.edges.data[i].alias.len > 0) { _zag_str_free(closure.*.edges.data[i].alias); }
        if (closure.*.edges.data[i].path.len > 0) { _zag_str_free(closure.*.edges.data[i].path); }
        if (closure.*.edges.data[i].mode.len > 0) { _zag_str_free(closure.*.edges.data[i].mode); }
        if (closure.*.edges.data[i].to.len > 0) { _zag_str_free(closure.*.edges.data[i].to); }
        i = i + 1;
    }
    free[PackageClosureNode](&closure.*.nodes); free[PackageClosureEdge](&closure.*.edges);
    closure.*.root = ""; closure.*.valid = 0;
}

fn package_manifest_closure(base_dir: []u8) PackageManifestClosure {
    let root: []u8 = package_import_manifest(base_dir);
    let out: PackageManifestClosure = PackageManifestClosure{
        .root = "", .nodes = make[PackageClosureNode](8), .edges = make[PackageClosureEdge](8),
        .error = PackageImportError.none, .valid = 0};
    if (root.len == 0) { out.error = PackageImportError.manifest_not_found; return out; }
    out.root = package_manifest_path_normalize(root); _zag_str_free(root);
    let active: ArrayList[[]u8] = make[[]u8](8);
    package_manifest_closure_visit(&out, out.root, &active);
    free[[]u8](&active);
    if (out.error == PackageImportError.none && out.nodes.len > 0) { out.valid = 1; }
    return out;
}

fn package_closure_append(out: *[]u8, text: []u8) void {
    let next: []u8 = _zag_str_concat(out.*, text);
    if (out.*.len > 0) { _zag_str_free(out.*); }
    out.* = next;
}

fn package_closure_checksum_text(sum: PackageRawChecksum) []u8 {
    let first: []u8 = _zag_i64_to_str(sum.first);
    let second: []u8 = _zag_i64_to_str(sum.second);
    let bytes: []u8 = _zag_i64_to_str(sum.bytes);
    let out: []u8 = "";
    package_closure_append(&out, first); package_closure_append(&out, ",");
    package_closure_append(&out, second); package_closure_append(&out, ",");
    package_closure_append(&out, bytes);
    _zag_str_free(first); _zag_str_free(second); _zag_str_free(bytes);
    return out;
}

// Canonical closure API: the root is followed by a deterministic depth-first
// traversal whose children are byte-sorted by dependency alias.  The output
// contains exact manifest checksums and every manifest edge, so consumers can
// compare it byte-for-byte without reproducing filesystem traversal order.
fn package_manifest_closure_render(closure: PackageManifestClosure) []u8 {
    if (closure.valid == 0) { return ""; }
    let out: []u8 = _zag_str_concat("", "format=zag-dependency-closure-v1\n");
    package_closure_append(&out, "root="); package_closure_append(&out, closure.root);
    package_closure_append(&out, "\n");
    let i: i32 = 0;
    while (i < closure.nodes.len) {
        let node: PackageClosureNode = closure.nodes.data[i];
        let sum: []u8 = package_closure_checksum_text(node.checksum);
        package_closure_append(&out, "node="); package_closure_append(&out, node.manifest);
        package_closure_append(&out, "\t"); package_closure_append(&out, node.name);
        package_closure_append(&out, "\t"); package_closure_append(&out, node.version);
        package_closure_append(&out, "\t"); package_closure_append(&out, node.compiler_pin);
        package_closure_append(&out, "\t"); package_closure_append(&out, sum);
        package_closure_append(&out, "\n"); _zag_str_free(sum);
        i = i + 1;
    }
    i = 0;
    while (i < closure.edges.len) {
        let current_edge: PackageClosureEdge = closure.edges.data[i];
        package_closure_append(&out, "edge="); package_closure_append(&out, current_edge.from);
        package_closure_append(&out, "\t"); package_closure_append(&out, current_edge.alias);
        package_closure_append(&out, "\t"); package_closure_append(&out, current_edge.path);
        package_closure_append(&out, "\t"); package_closure_append(&out, current_edge.mode);
        package_closure_append(&out, "\t"); package_closure_append(&out, current_edge.to);
        package_closure_append(&out, "\n"); i = i + 1;
    }
    return out;
}

fn package_lock_validate(lock: []u8, manifest_source: []u8,
    manifest_path: []u8, requested_alias: []u8, requested_root: []u8,
    requested_module: []u8) PackageLockCheck {
    let bad: PackageLockCheck = PackageLockCheck{
        .checksum = PackageRawChecksum{ .first = 0, .second = 0, .bytes = 0 },
        .found = 0, .mismatch = 0, .valid = 0,
    };
    let result: PackageLockCheck = bad;
    if (lock.len <= 0 || lock.len > 1048576 || lock[lock.len - 1] != '\n') {
        return bad;
    }
    let header_end: i32 = 0;
    while (header_end < lock.len && lock[header_end] != '\n') {
        header_end = header_end + 1;
    }
    if (header_end >= lock.len ||
        !@strEq(lock[0..header_end], "format=zag-local-lock-v1")) { return bad; }

    let previous_alias: []u8 = "";
    let previous_root: []u8 = "";
    let previous_module: []u8 = "";
    let entries: i32 = 0;
    let total_bytes: i64 = 0;
    let position: i32 = header_end + 1;
    while (position < lock.len) {
        let end: i32 = position;
        while (end < lock.len && lock[end] != '\n') { end = end + 1; }
        if (end >= lock.len) { return bad; }
        let line: []u8 = lock[position..end];
        // Comments are provenance bytes, not records. Requiring one space and
        // printable ASCII keeps their spelling canonical while allowing a
        // comment-only lock edit to remain a valid, identity-changing input.
        if (line.len >= 2 && line[0] == '#' && line[1] == ' ') {
            let ci: i32 = 2;
            while (ci < line.len) {
                if (line[ci] < 32 || line[ci] > 126) { return bad; }
                ci = ci + 1;
            }
        } else {
            if (line.len <= 6 || !@strEq(line[0..6], "entry=")) { return bad; }
            let fields: []u8 = line[6..line.len];
            if (package_lock_parts_exact(fields, 4, '\t') == 0) { return bad; }
            let alias: []u8 = package_lock_part(fields, 0, '\t');
            let root: []u8 = package_lock_part(fields, 1, '\t');
            let module: []u8 = package_lock_part(fields, 2, '\t');
            let parsed: PackageChecksumParse = package_lock_checksum(
                package_lock_part(fields, 3, '\t'));
            if (package_import_safe_name(alias) == 0 ||
                package_import_vendor_path_safe(root) == 0 ||
                package_import_module_safe(module) == 0 || parsed.valid == 0) {
                return bad;
            }
            if (entries > 0 && package_lock_tuple_after(alias, root, module,
                previous_alias, previous_root, previous_module) == 0) { return bad; }
            previous_alias = alias;
            previous_root = root;
            previous_module = module;
            entries = entries + 1;
            if (entries > 256) { return bad; }

            let declared: PackageManifestDependency = package_manifest_dependency(
                manifest_source, alias);
            if (declared.valid == 0 || declared.count != 1 ||
                !@strEq(declared.mode, "vendor") || !@strEq(declared.path, root)) {
                return bad;
            }

            let dependency_root: []u8 = package_import_join(
                package_import_dir(manifest_path), root);
            let module_path: []u8 = package_import_join(dependency_root, module);
            _zag_str_free(dependency_root);
            if (_zag_file_exists(module_path) == 0) {
                _zag_str_free(module_path);
                return bad;
            }
            let bytes: []u8 = _zag_read_file(module_path);
            _zag_str_free(module_path);
            if (bytes.len < 0 || bytes.len > 8388608) {
                if (bytes.len >= 0) { _zag_free(_zag_slice_ptr(bytes)); }
                return bad;
            }
            total_bytes = total_bytes + bytes.len;
            if (total_bytes > 67108864) {
                _zag_free(_zag_slice_ptr(bytes));
                return bad;
            }
            let actual: PackageRawChecksum = package_raw_checksum(bytes);
            _zag_free(_zag_slice_ptr(bytes));
            if (package_raw_checksum_equal(actual, parsed.checksum) == 0) {
                result.mismatch = 1;
            }
            if (@strEq(alias, requested_alias) && @strEq(root, requested_root) &&
                @strEq(module, requested_module)) {
                result.found = result.found + 1;
                result.checksum = parsed.checksum;
            }
        }
        position = end + 1;
    }
    result.valid = 1;
    return result;
}

fn package_import_free_read(bytes: []u8) void {
    if (bytes.len >= 0) { _zag_free(_zag_slice_ptr(bytes)); }
}

// Resolution paths and successful manifest/lock snapshots are owned by the
// result; specifier/dependency slices are borrowed from the caller. The parser
// may transfer successful snapshot buffers into CompilationUnit.resources;
// direct-library and error callers release everything here.
fn package_import_resolution_release(result: *PackageImportResolution) void {
    if (result.*.path.len > 0) { _zag_str_free(result.*.path); }
    if (result.*.manifest.len > 0) { _zag_str_free(result.*.manifest); }
    if (result.*.lockfile.len > 0) { _zag_str_free(result.*.lockfile); }
    if (result.*.manifest_source_owned != 0) {
        package_import_free_read(result.*.manifest_source);
    }
    if (result.*.lockfile_source_owned != 0) {
        package_import_free_read(result.*.lockfile_source);
    }
    result.*.path = "";
    result.*.manifest = "";
    result.*.manifest_source = "";
    result.*.manifest_source_owned = 0;
    result.*.lockfile = "";
    result.*.lockfile_source = "";
    result.*.lockfile_source_owned = 0;
}

// The command-line lock generator must be able to parse the exact vendored
// graph before its first zag.lock exists.  This private mode is enabled only
// by the `znc package lock` dispatcher; ordinary foreground compilation never
// bypasses a vendor lock validation.
fn package_import_lock_generation_mode() i32 {
    let i: i32 = 0;
    while (i < _zag_argc()) {
        if (@strEq(_zag_arg(i), "--package-lock")) { return 1; }
        i = i + 1;
    }
    if (_zag_argc() >= 3 && @strEq(_zag_arg(1), "package") &&
        @strEq(_zag_arg(2), "lock")) { return 1; }
    return 0;
}

fn package_import_resolve(specifier: []u8,
    base_dir: []u8) PackageImportResolution {
    let result: PackageImportResolution = package_import_result(specifier);
    if (package_import_starts_with(specifier, "pkg:") == 0) { return result; }
    result.matched = 1;
    let slash: i32 = 4;
    while (slash < specifier.len && specifier[slash] != '/') { slash = slash + 1; }
    if (slash >= specifier.len) {
        result.error = PackageImportError.invalid_specifier; return result;
    }
    result.dependency = specifier[4..slash];
    let module: []u8 = specifier[slash + 1..specifier.len];
    if (package_import_safe_name(result.dependency) == 0 ||
        package_import_module_safe(module) == 0) {
        result.error = PackageImportError.invalid_specifier; return result;
    }
    result.manifest = package_import_manifest(base_dir);
    if (result.manifest.len == 0) {
        result.error = PackageImportError.manifest_not_found; return result;
    }
    let source: []u8 = _zag_read_file(result.manifest);
    let declared: PackageManifestDependency =
        package_manifest_dependency(source, result.dependency);
    if (declared.valid == 0) {
        package_import_free_read(source);
        result.error = PackageImportError.invalid_manifest; return result;
    }
    if (declared.count == 0) {
        package_import_free_read(source);
        result.error = PackageImportError.dependency_not_found; return result;
    }
    if (declared.count != 1) {
        package_import_free_read(source);
        result.error = PackageImportError.duplicate_dependency; return result;
    }
    if (package_import_local_path_safe(declared.path) == 0) {
        package_import_free_read(source);
        result.error = PackageImportError.invalid_dependency_path; return result;
    }
    if (declared.mode.len > 0 && !@strEq(declared.mode, "vendor")) {
        package_import_free_read(source);
        result.error = PackageImportError.invalid_manifest; return result;
    }
    if (@strEq(declared.mode, "vendor") &&
        package_import_vendor_path_safe(declared.path) == 0) {
        package_import_free_read(source);
        result.error = PackageImportError.invalid_vendor_dependency; return result;
    }
    let dependency_root: []u8 = package_import_join(
        package_import_dir(result.manifest), declared.path);
    result.path = package_import_join(dependency_root, module);
    _zag_str_free(dependency_root);
    if (_zag_file_exists(result.path) == 0) {
        package_import_free_read(source);
        result.error = PackageImportError.module_not_found; return result;
    }
    if (@strEq(declared.mode, "vendor")) {
        result.lockfile = package_import_join(
            package_import_dir(result.manifest), "zag.lock");
        if (package_import_lock_generation_mode() == 1) {
            result.manifest_source = source;
            result.manifest_source_owned = 1;
            return result;
        }
        if (_zag_file_exists(result.lockfile) == 0) {
            package_import_free_read(source);
            result.error = PackageImportError.lockfile_not_found; return result;
        }
        let lock: []u8 = _zag_read_file(result.lockfile);
        if (lock.len < 0) {
            package_import_free_read(source);
            result.error = PackageImportError.invalid_lockfile; return result;
        }
        let checked: PackageLockCheck = package_lock_validate(lock, source,
            result.manifest, result.dependency, declared.path, module);
        if (checked.valid == 0) {
            package_import_free_read(lock);
            package_import_free_read(source);
            result.error = PackageImportError.invalid_lockfile; return result;
        }
        if (checked.found != 1) {
            package_import_free_read(lock);
            package_import_free_read(source);
            result.error = PackageImportError.lock_entry_not_found; return result;
        }
        if (checked.mismatch != 0) {
            package_import_free_read(lock);
            package_import_free_read(source);
            result.error = PackageImportError.checksum_mismatch; return result;
        }
        result.locked = 1;
        result.checksum = checked.checksum;
        result.lockfile_source = lock;
        result.lockfile_source_owned = 1;
    }
    result.manifest_source = source;
    result.manifest_source_owned = 1;
    return result;
}

// Collect one canonical lock entry without reading an existing zag.lock.
// This is intentionally limited to explicit `pkg:` imports whose declared
// dependency is already `mode = "vendor"`; ordinary sibling imports and
// non-Zag assets remain outside this module-granular generator contract.
fn package_lock_generated_entry(specifier: []u8,
    importer: []u8) PackageLockGeneratedEntry {
    let bad: PackageLockGeneratedEntry = package_lock_generated_bad();
    if (package_import_starts_with(specifier, "pkg:") == 0) { return bad; }
    let slash: i32 = 4;
    while (slash < specifier.len && specifier[slash] != '/') { slash = slash + 1; }
    if (slash >= specifier.len) { return bad; }
    let alias: []u8 = specifier[4..slash];
    let module: []u8 = specifier[slash + 1..specifier.len];
    if (package_import_safe_name(alias) == 0 ||
        package_import_module_safe(module) == 0) { return bad; }

    let base_dir: []u8 = package_import_dir(importer);
    let manifest: []u8 = package_import_manifest(base_dir);
    if (manifest.len == 0) { return bad; }
    let source: []u8 = _zag_read_file(manifest);
    if (source.len < 0) {
        _zag_str_free(manifest);
        return bad;
    }
    let declared: PackageManifestDependency = package_manifest_dependency(source, alias);
    if (declared.valid == 0 || declared.count != 1 ||
        !@strEq(declared.mode, "vendor") ||
        package_import_vendor_path_safe(declared.path) == 0) {
        package_import_free_read(source); _zag_str_free(manifest);
        return bad;
    }
    let root_copy: []u8 = _zag_str_concat("", declared.path);
    let dependency_root: []u8 = package_import_join(
        package_import_dir(manifest), declared.path);
    let module_path: []u8 = package_import_join(dependency_root, module);
    _zag_str_free(dependency_root);
    if (_zag_file_exists(module_path) == 0) {
        _zag_str_free(module_path); _zag_str_free(root_copy);
        package_import_free_read(source);
        _zag_str_free(manifest); return bad;
    }
    let bytes: []u8 = _zag_read_file(module_path);
    _zag_str_free(module_path); package_import_free_read(source);
    _zag_str_free(manifest);
    if (bytes.len < 0 || bytes.len > 8388608) {
        if (bytes.len >= 0) { package_import_free_read(bytes); }
        _zag_str_free(root_copy);
        return bad;
    }
    let result: PackageLockGeneratedEntry = PackageLockGeneratedEntry{
        .alias = _zag_str_concat("", alias),
        .root = root_copy,
        .module = _zag_str_concat("", module),
        .checksum = package_raw_checksum(bytes),
        .valid = 1,
    };
    package_import_free_read(bytes);
    return result;
}

// The resolver checks the path's bytes before load.  The parser calls this
// again on the exact source slice it retained for compilation, closing the
// check/read race without transferring source ownership into the resolver.
fn package_import_locked_bytes_match(result: PackageImportResolution,
    source: []u8) i32 {
    if (result.locked == 0) { return 1; }
    return package_raw_checksum_equal(package_raw_checksum(source),
        result.checksum);
}

fn package_import_report(result: PackageImportResolution) void {
    _zag_print("zag: error: package import '");
    _zag_print(result.specifier);
    _zag_print("': ");
    if (result.error == PackageImportError.invalid_specifier) {
        _zag_println("expected pkg:<dependency>/<relative-module.zag> without traversal");
    } else if (result.error == PackageImportError.manifest_not_found) {
        _zag_println("no ancestor zag.mod declares local dependencies");
    } else if (result.error == PackageImportError.invalid_manifest) {
        _zag_print("invalid or missing path entry for dependency '");
        _zag_print(result.dependency); _zag_print("' in "); _zag_println(result.manifest);
    } else if (result.error == PackageImportError.dependency_not_found) {
        _zag_print("dependency '"); _zag_print(result.dependency);
        _zag_print("' is not declared in "); _zag_println(result.manifest);
    } else if (result.error == PackageImportError.duplicate_dependency) {
        _zag_print("dependency '"); _zag_print(result.dependency);
        _zag_print("' is declared more than once in "); _zag_println(result.manifest);
    } else if (result.error == PackageImportError.invalid_dependency_path) {
        _zag_println("dependency path must be relative and use '/' without '~', ':', or backslash");
    } else if (result.error == PackageImportError.module_not_found) {
        _zag_print("resolved module does not exist at "); _zag_println(result.path);
    } else if (result.error == PackageImportError.invalid_vendor_dependency) {
        _zag_println("vendor dependency path must be a traversal-free vendor/<name> root");
    } else if (result.error == PackageImportError.lockfile_not_found) {
        _zag_print("vendor dependency requires canonical lockfile ");
        _zag_println(result.lockfile);
    } else if (result.error == PackageImportError.invalid_lockfile) {
        _zag_print("invalid canonical vendor lockfile "); _zag_println(result.lockfile);
    } else if (result.error == PackageImportError.lock_entry_not_found) {
        _zag_print("canonical vendor lockfile has no exact alias/root/module entry in ");
        _zag_println(result.lockfile);
    } else if (result.error == PackageImportError.checksum_mismatch) {
        _zag_print("vendor module raw checksum mismatch under ");
        _zag_println(result.lockfile);
    } else if (result.error == PackageImportError.dependency_input_changed) {
        _zag_println("manifest or lock bytes changed during this compilation");
    } else {
        _zag_println("resolution failed");
    }
}
