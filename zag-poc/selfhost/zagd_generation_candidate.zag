// Bounded executable generation authority. Candidates execute only in the
// finite pure semantic-region sandbox and receive no ambient capabilities.
@import("zagd_generation.zag")
@import("zagd_saturation.zag")
struct ZagdGenerationCandidateResult { ok:i32, error:[]u8, staged:i32, executed:i32, promoted:i32, rolled_back:i32, registry:ZagdGenerationRegistry }
fn zagd_generation_candidate_bad(message:[]u8,compiler:[]u8)ZagdGenerationCandidateResult{return ZagdGenerationCandidateResult{.ok=0,.error=message,.staged=0,.executed=0,.promoted=0,.rolled_back=0,.registry=zagd_generation_registry_fallback(compiler)};}
fn zagd_generation_candidate_active(generation:ZagdHash,predecessor:ZagdHash)ZagdGenerationCanary{return ZagdGenerationCanary{.generation=generation,.predecessor=predecessor,.successes=0,.failures=0,.consecutive_crashes=0,.required_successes=zagd_generation_required_successes(),.session_clean=1,.quarantined=0,.valid=1};}
fn zagd_generation_candidate_stage(root:[]u8,compiler:[]u8,region_text:[]u8,target:[]u8,work_budget:i64)ZagdGenerationCandidateResult{let base:ZagdGenerationRegistry=zagd_generation_initialize_stable(root,compiler);if(base.record_valid!=1||base.quarantined==1||zagd_hash_equal(base.pointers.current,base.pointers.last_known_good)==0){return zagd_generation_candidate_bad("registry_not_stable",compiler);}let region:ZagdSaturationRegion=zagd_saturation_extract(region_text);let saturated:ZagdSaturationResult=zagd_saturation_run(region,compiler,target,work_budget);if(saturated.ok!=1){let message:[]u8=saturated.error;zagd_saturation_result_free(&saturated);return zagd_generation_candidate_bad(message,compiler);}let proof_identity:ZagdHash=zagd_content_hash(saturated.proof_record);let manifest_text:[]u8=zagd_generation_manifest_encode(compiler,base.pointers.last_known_good,proof_identity);zagd_saturation_result_free(&saturated);if(manifest_text.len==0){return zagd_generation_candidate_bad("manifest_encode_failed",compiler);}let manifest:ZagdGenerationManifest=zagd_generation_manifest_decode(manifest_text);if(manifest.valid!=1||zagd_generation_install_manifest(root,manifest_text)==0){zagd_text_free(manifest_text);return zagd_generation_candidate_bad("manifest_install_failed",compiler);}zagd_text_free(manifest_text);let pointers:ZagdGenerationPointers=ZagdGenerationPointers{.current=manifest.identity,.last_known_good=base.pointers.last_known_good,.valid=1};let canary:ZagdGenerationCanary=zagd_generation_candidate_active(manifest.identity,base.pointers.last_known_good);if(zagd_generation_persist(root,pointers,canary)==0){return zagd_generation_candidate_bad("persist_failed",compiler);}let loaded:ZagdGenerationRegistry=zagd_generation_load(root,compiler);if(loaded.record_valid!=1||zagd_hash_equal(loaded.selected,manifest.identity)==0){return zagd_generation_candidate_bad("staged_load_failed",compiler);}return ZagdGenerationCandidateResult{.ok=1,.error="",.staged=1,.executed=0,.promoted=0,.rolled_back=0,.registry=loaded};}
fn zagd_generation_candidate_reject(pointers:ZagdGenerationPointers,canary:ZagdGenerationCanary)ZagdGenerationTransition{let out:ZagdGenerationTransition=ZagdGenerationTransition{.pointers=pointers,.canary=canary,.valid=1,.started=0,.promoted=0,.rolled_back=0};if(zagd_generation_pointers_value_valid(pointers)==0||zagd_generation_canary_value_valid(canary)==0||canary.quarantined==1||zagd_hash_equal(pointers.current,pointers.last_known_good)==1||canary.session_clean!=0){return zagd_generation_transition_bad(pointers,canary);}if(out.canary.failures<zagd_generation_counter_limit()){out.canary.failures=out.canary.failures+1;}if(out.canary.consecutive_crashes<zagd_generation_counter_limit()){out.canary.consecutive_crashes=out.canary.consecutive_crashes+1;}out.canary.session_clean=1;if(out.canary.consecutive_crashes>=zagd_generation_crash_limit()){out.canary.quarantined=1;out.pointers.current=out.canary.predecessor;out.pointers.last_known_good=out.canary.predecessor;out.rolled_back=1;}return out;}
fn zagd_generation_candidate_validate(root:[]u8,compiler:[]u8,region_text:[]u8,target:[]u8,work_budget:i64)ZagdGenerationCandidateResult{let loaded:ZagdGenerationRegistry=zagd_generation_load(root,compiler);if(loaded.record_valid!=1||loaded.quarantined==1||zagd_hash_equal(loaded.pointers.current,loaded.pointers.last_known_good)==1){return zagd_generation_candidate_bad("no_active_candidate",compiler);}let parent:ZagdHash=zagd_generation_bad_hash();let policy:ZagdHash=zagd_generation_bad_hash();if(zagd_generation_manifest_on_disk(root,loaded.pointers.current,compiler,&parent,&policy)==0||zagd_hash_equal(parent,loaded.pointers.last_known_good)==0){return zagd_generation_candidate_bad("candidate_manifest_invalid",compiler);}let begun:ZagdGenerationTransition=zagd_generation_begin_session(loaded.pointers,loaded.canary);if(begun.valid!=1||begun.started!=1||zagd_generation_persist(root,begun.pointers,begun.canary)==0){return zagd_generation_candidate_bad("candidate_start_failed",compiler);}let region:ZagdSaturationRegion=zagd_saturation_extract(region_text);let saturated:ZagdSaturationResult=zagd_saturation_run(region,compiler,target,work_budget);let proof_ok:i32=(saturated.ok==1&&zagd_hash_equal(zagd_content_hash(saturated.proof_record),policy)==1) as i32;zagd_saturation_result_free(&saturated);if(proof_ok==0){let rejected:ZagdGenerationTransition=zagd_generation_candidate_reject(begun.pointers,begun.canary);if(rejected.valid==0||zagd_generation_persist(root,rejected.pointers,rejected.canary)==0){return zagd_generation_candidate_bad("candidate_reject_persist_failed",compiler);}let after:ZagdGenerationRegistry=zagd_generation_load(root,compiler);return ZagdGenerationCandidateResult{.ok=0,.error="proof_mismatch",.staged=0,.executed=1,.promoted=0,.rolled_back=rejected.rolled_back,.registry=after};}let finished:ZagdGenerationTransition=zagd_generation_finish_session(begun.pointers,begun.canary);if(finished.valid!=1||zagd_generation_persist(root,finished.pointers,finished.canary)==0){return zagd_generation_candidate_bad("candidate_finish_failed",compiler);}let after:ZagdGenerationRegistry=zagd_generation_load(root,compiler);return ZagdGenerationCandidateResult{.ok=1,.error="",.staged=0,.executed=1,.promoted=finished.promoted,.rolled_back=0,.registry=after};}
