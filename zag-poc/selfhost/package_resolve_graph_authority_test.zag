@import("package_registry_graph_authority.zag")

extern fn _zag_allocator_live_bytes() i64

fn graph_resolve_check(ok: i32, label: []u8, failures: *i32) void {
    if (ok != 0) { _zag_print("ok  "); _zag_println(label); }
    else { failures.* = failures.* + 1; _zag_print("FAIL "); _zag_println(label); }
}

fn main() i32 {
    let failures: i32 = 0;
    let before: i64 = _zag_allocator_live_bytes();
    let body: []u8 = "format=zag-registry-index-v1\nauthority=local-file-v1\nsignature=none\nentry=alpha\t1.0.0\tsrc/alpha.zag\t1,2,3\nentry=alpha\t1.2.0\tsrc/alpha-new.zag\t4,5,6\nentry=beta\t2.0.0\tsrc/beta.zag\t7,8,9\n";
    let index: []u8 = package_registry_finalize(body);
    let edges: []u8 = "root\talpha\t^1.0.0\nroot\tbeta\t^2.0.0\nalpha\tbeta\t^2.0.0";
    let lock: PackageRegistryGraphLock =
        package_registry_graph_lock_create(index, edges);
    let context: PackageRegistryGraphAuthorityContext =
        PackageRegistryGraphAuthorityContext{.index = index, .edges = edges,
            .lock = lock.bytes};

    let valid: PackageImportResolution = package_import_result(
        "pkg:alpha/src/alpha-new.zag");
    valid.matched = 1; valid.registry_mode = 1; valid.dependency = "alpha";
    valid.registry_version = "1.2.0";
    valid.registry_source = "src/alpha-new.zag";
    valid.checksum = PackageRawChecksum{.first = 4, .second = 5, .bytes = 6};
    let valid_error: PackageRegistryGraphAuthorityError =
        package_import_registry_graph_authorize(&valid, context);
    graph_resolve_check(valid_error == PackageRegistryGraphAuthorityError.none &&
        valid.graph_authorized == 1 && valid.error == PackageImportError.none,
        "foreground registry result is admitted only after graph-lock tuple match",
        &failures);

    let stale_version: PackageImportResolution = package_import_result(
        "pkg:alpha/src/alpha-new.zag");
    stale_version.matched = 1; stale_version.registry_mode = 1;
    stale_version.dependency = "alpha";
    stale_version.registry_version = "1.0.0";
    stale_version.registry_source = "src/alpha-new.zag";
    stale_version.checksum = PackageRawChecksum{.first = 4, .second = 5, .bytes = 6};
    let stale_version_error: PackageRegistryGraphAuthorityError =
        package_import_registry_graph_authorize(&stale_version, context);
    graph_resolve_check(stale_version_error == PackageRegistryGraphAuthorityError.lock_mismatch &&
        stale_version.graph_authorized == 0 &&
        stale_version.error == PackageImportError.registry_lock_mismatch,
        "stale registry version fails closed", &failures);

    let stale_source: PackageImportResolution = package_import_result(
        "pkg:alpha/src/other.zag");
    stale_source.matched = 1; stale_source.registry_mode = 1;
    stale_source.dependency = "alpha";
    stale_source.registry_version = "1.2.0";
    stale_source.registry_source = "src/other.zag";
    stale_source.checksum = PackageRawChecksum{.first = 4, .second = 5, .bytes = 6};
    let stale_source_error: PackageRegistryGraphAuthorityError =
        package_import_registry_graph_authorize(&stale_source, context);
    graph_resolve_check(stale_source_error == PackageRegistryGraphAuthorityError.lock_mismatch &&
        stale_source.graph_authorized == 0,
        "stale registry source fails closed", &failures);

    let stale_checksum: PackageImportResolution = package_import_result(
        "pkg:alpha/src/alpha-new.zag");
    stale_checksum.matched = 1; stale_checksum.registry_mode = 1;
    stale_checksum.dependency = "alpha";
    stale_checksum.registry_version = "1.2.0";
    stale_checksum.registry_source = "src/alpha-new.zag";
    stale_checksum.checksum = PackageRawChecksum{.first = 4, .second = 5, .bytes = 7};
    let stale_checksum_error: PackageRegistryGraphAuthorityError =
        package_import_registry_graph_authorize(&stale_checksum, context);
    graph_resolve_check(stale_checksum_error == PackageRegistryGraphAuthorityError.lock_mismatch &&
        stale_checksum.graph_authorized == 0,
        "stale registry checksum fails closed", &failures);

    let forged: []u8 = _zag_str_concat(lock.bytes, "x");
    let forged_context: PackageRegistryGraphAuthorityContext =
        PackageRegistryGraphAuthorityContext{.index = index, .edges = edges,
            .lock = forged};
    let forged_result: PackageImportResolution = package_import_result(
        "pkg:alpha/src/alpha-new.zag");
    forged_result.matched = 1; forged_result.registry_mode = 1;
    forged_result.dependency = "alpha";
    forged_result.registry_version = "1.2.0";
    forged_result.registry_source = "src/alpha-new.zag";
    forged_result.checksum = PackageRawChecksum{.first = 4, .second = 5, .bytes = 6};
    let forged_error: PackageRegistryGraphAuthorityError =
        package_import_registry_graph_authorize(&forged_result, forged_context);
    graph_resolve_check(forged_error == PackageRegistryGraphAuthorityError.invalid_lock &&
        forged_result.graph_authorized == 0,
        "forged graph lock is rejected before import admission", &failures);
    _zag_str_free(forged);

    let ordinary: PackageImportResolution = package_import_result("pkg:alpha/x.zag");
    ordinary.matched = 1; ordinary.registry_mode = 0; ordinary.dependency = "alpha";
    let ordinary_error: PackageRegistryGraphAuthorityError =
        package_import_registry_graph_authorize(&ordinary, context);
    graph_resolve_check(ordinary_error == PackageRegistryGraphAuthorityError.invalid_query &&
        ordinary.graph_authorized == 0 &&
        ordinary.error == PackageImportError.registry_lock_mismatch,
        "non-registry result cannot opt into graph-lock authority", &failures);

    let lookup: PackageRegistryLookup = package_registry_lookup(index,
        "alpha", "^1.0.0");
    graph_resolve_check(lookup.found == 1 && @strEq(lookup.version, "1.2.0"),
        "ordinary registry lookup remains unchanged", &failures);

    package_import_resolution_release(&valid);
    package_import_resolution_release(&stale_version);
    package_import_resolution_release(&stale_source);
    package_import_resolution_release(&stale_checksum);
    package_import_resolution_release(&forged_result);
    package_import_resolution_release(&ordinary);
    if (lock.bytes.len > 0) { _zag_str_free(lock.bytes); }
    _zag_str_free(index);
    graph_resolve_check(_zag_allocator_live_bytes() == before,
        "graph-authorized result seam restores allocator baseline", &failures);
    if (failures == 0) { _zag_println("package resolve graph authority: 8/8"); }
    return failures;
}
