// Darwin/Apple-Silicon adapter for zagd.
//
// macOS does not expose Linux inotify. This adapter uses Darwin kqueue vnode
// events for the project root, with a bounded polling fallback only if the
// native event handles cannot be opened. It keeps planner state advisory: a
// missed event can only delay metadata refresh and never changes foreground
// compiler correctness.

@import("zagd.zag")
@import("../std/list.zag")

extern fn _zag_raw_syscall(num: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64) i64
extern fn _zag_darwin_fork() i64
extern fn _zag_argc() i32
extern fn _zag_arg(i: i32) []u8
extern fn _zag_read_file(path: []u8) []u8
extern fn _zag_write_file(path: []u8, content: []u8) i32
extern fn _zag_file_exists(path: []u8) i32
extern fn _zag_exec_cmd(command: []u8) i32
extern fn _zag_slice_ptr(s: []u8) *i8

struct ZmdTimespec { sec: i64, nsec: i64 }
// Exact Darwin `struct kevent` layout on 64-bit arm64: the SDK applies
// `#pragma pack(4)`, leaving the six fields at offsets 0, 8, 10, 12, 16, 24.
struct ZmdKevent { ident: i64, filter: i16, flags: u16, fflags: u32, data: i64, udata: i64 }

fn zmd_kqueue() i64 { return _zag_raw_syscall(362, 0, 0, 0, 0, 0, 0); }

fn zmd_open_event_dir(path: []u8) i64 {
    let cpath: ArrayList[u8] = zmd_cstr(path);
    // Darwin open(2), O_EVTONLY. A directory descriptor is sufficient for
    // EVFILT_VNODE; unlike Linux inotify it has no translated syscall ABI.
    return _zag_raw_syscall(5, _zag_slice_ptr(cpath.data[0..cpath.len]) as i64,
        32768, 0, 0, 0, 0);
}

fn zmd_close(fd: i64) void { let _rc: i64 = _zag_raw_syscall(6, fd, 0, 0, 0, 0, 0); }

fn zmd_kqueue_watch(kq: i64, dirfd: i64) i64 {
    let change: ZmdKevent = ZmdKevent{.ident=dirfd,.filter=(-4) as i16,
        .flags=33 as u16,.fflags=127 as u32,.data=0,.udata=0};
    let timeout: ZmdTimespec = ZmdTimespec{.sec=0,.nsec=0};
    // Darwin kevent(2): install EVFILT_VNODE | EV_ADD | EV_CLEAR. The SDK ABI
    // is six arguments after the syscall number, exactly matching the raw
    // runtime escape hatch.
    return _zag_raw_syscall(363, kq, (&change) as i64, 1, 0, 0,
        (&timeout) as i64);
}

fn zmd_kqueue_wait(kq: i64) i64 {
    let event: ZmdKevent = ZmdKevent{.ident=0,.filter=0,.flags=0,.fflags=0,.data=0,.udata=0};
    let timeout: ZmdTimespec = ZmdTimespec{.sec=0,.nsec=250000000};
    return _zag_raw_syscall(363, kq, 0, 0, (&event) as i64, 1,
        (&timeout) as i64);
}

fn zmd_sleep_ms(ms: i64) void {
    let wait: i64 = ms;
    if (wait < 1) { wait = 1; }
    let ts: ZmdTimespec = ZmdTimespec{.sec=wait / 1000,
        .nsec=(wait % 1000) * 1000000};
    // Darwin arm64 nanosleep(2), with the Darwin syscall number carried by
    // the macOS-only raw-syscall adapter.
    let _rc: i64 = _zag_raw_syscall(240, (&ts) as i64, 0, 0, 0, 0, 0);
}

fn zmd_pid() i64 { return _zag_raw_syscall(20, 0, 0, 0, 0, 0, 0); }
fn zmd_fork() i64 { return _zag_darwin_fork(); }

fn zmd_cstr(value: []u8) ArrayList[u8] {
    let out: ArrayList[u8] = make[u8](value.len + 1);
    let i: i32 = 0;
    while (i < value.len) { push[u8](&out, value[i]); i = i + 1; }
    push[u8](&out, 0 as u8);
    return out;
}

fn zmd_unlink(path: []u8) void {
    let cpath: ArrayList[u8] = zmd_cstr(path);
    // Darwin unlink(2).
    let _rc: i64 = _zag_raw_syscall(10, _zag_slice_ptr(cpath.data[0..cpath.len]) as i64,
        0, 0, 0, 0, 0);
}

fn zmd_join(root: []u8, leaf: []u8) []u8 {
    if (root.len > 0 && root[root.len - 1] == '/') { return _zag_str_concat(root, leaf); }
    return _zag_str_concat(root, _zag_str_concat("/", leaf));
}

fn zmd_quote(value: []u8) []u8 {
    let out: []u8 = "'";
    let i: i32 = 0;
    while (i < value.len) {
        if (value[i] == '\'') { out = _zag_str_concat(out, "'\\''"); }
        else { out = _zag_str_concat(out, value[i..i + 1]); }
        i = i + 1;
    }
    return _zag_str_concat(out, "'");
}

fn zmd_dir(path: []u8) []u8 {
    let last: i32 = 0 - 1;
    let i: i32 = 0;
    while (i < path.len) { if (path[i] == '/') { last = i; } i = i + 1; }
    if (last < 0) { return "."; }
    if (last == 0) { return "/"; }
    return path[0..last];
}

fn zmd_status(root: []u8, pid: i64, mode: []u8, state: []u8, events: i64, native_events: i32) void {
    let watcher: []u8 = "watcher=polling-root-module\n";
    if (native_events == 1) { watcher = "watcher=kqueue-root\n"; }
    let text: []u8 = _zag_str_concat("advisory=true\nexecutable_authority=false\ntarget=macos-arm64\n", watcher);
    text = _zag_str_concat(text, _zag_str_concat("pid=", _zag_i64_to_str(pid)));
    text = _zag_str_concat(text, _zag_str_concat("\nmode=", mode));
    text = _zag_str_concat(text, _zag_str_concat("\nstate=", state));
    text = _zag_str_concat(text, _zag_str_concat("\nevents=", _zag_i64_to_str(events)));
    let _rc: i32 = _zag_write_file(zmd_join(root, ".zagd.status"), _zag_str_concat(text, "\n"));
}

fn zmd_check(root: []u8, source: []u8) void {
    if (source.len == 0 || _zag_file_exists(source) == 0) { return; }
    let compiler: []u8 = zmd_join(zmd_dir(_zag_arg(0)), "znc");
    let command: []u8 = _zag_str_concat(zmd_quote(compiler),
        _zag_str_concat(" check ", _zag_str_concat(zmd_quote(source), " --no-zagd --no-analyze >/dev/null 2>/dev/null")));
    let _rc: i32 = _zag_exec_cmd(command);
}

fn zmd_arg_value(flag: []u8) []u8 {
    let i: i32 = 1;
    while (i + 1 < _zag_argc()) {
        if (@strEq(_zag_arg(i), flag)) { return _zag_arg(i + 1); }
        i = i + 1;
    }
    return "";
}

fn main() i32 {
    let root: []u8 = zmd_arg_value("--root");
    if (root.len == 0) { root = "."; }
    let source: []u8 = zmd_arg_value("--root-source");
    let mode: []u8 = zmd_arg_value("--mode");
    if (mode.len == 0) { mode = "light"; }
    let stop: []u8 = zmd_join(root, ".zagd.stop");
    let lock: []u8 = zmd_join(root, ".zagd.lock");

    if (@strEq(mode, "off")) {
        let _stop: i32 = _zag_write_file(stop, "stop\n");
        zmd_unlink(lock);
        zmd_status(root, 0, mode, "stopped", 0, 0);
        return 0;
    }

    // --daemonize is a presence flag, so inspect the complete argument list.
    let ai: i32 = 1; let want_daemon: i32 = 0;
    while (ai < _zag_argc()) { if (@strEq(_zag_arg(ai), "--daemonize")) { want_daemon = 1; } ai = ai + 1; }
    if (want_daemon == 1) {
        let child: i64 = zmd_fork();
        if (child < 0) { return 1; }
        if (child > 0) { return 0; }
    }

    zmd_unlink(stop);
    let kq: i64 = zmd_kqueue();
    let event_dir: i64 = zmd_open_event_dir(root);
    // Watch the root source separately as well as the project directory.  A
    // kqueue vnode watch is descriptor-scoped (not recursive like inotify),
    // so this preserves prompt native notification when the entry module is
    // nested below the project root.
    let event_source: i64 = zmd_open_event_dir(source);
    let native_events: i32 = (kq >= 0 && event_dir >= 0 && zmd_kqueue_watch(kq, event_dir) >= 0) as i32;
    if (native_events == 1 && event_source >= 0) { let _source_watch: i64 = zmd_kqueue_watch(kq, event_source); }
    if (native_events == 0) { if (event_dir >= 0) { zmd_close(event_dir); } if (event_source >= 0) { zmd_close(event_source); } if (kq >= 0) { zmd_close(kq); } }
    let pid: i64 = zmd_pid();
    let _lock: i32 = _zag_write_file(lock, _zag_str_concat(_zag_i64_to_str(pid), "\n"));
    let prior: []u8 = _zag_read_file(source);
    let prior_hash: ZagdHash = zagd_content_hash(prior);
    let events: i64 = 0;
    zmd_status(root, pid, mode, "idle", events, native_events);

    while (_zag_file_exists(stop) == 0) {
        let changed: i32 = 1;
        if (native_events == 1) { changed = (zmd_kqueue_wait(kq) > 0) as i32; }
        else { zmd_sleep_ms(250); }
        if (changed == 1) {
            let current: []u8 = _zag_read_file(source);
            let current_hash: ZagdHash = zagd_content_hash(current);
            if (zagd_hash_equal(prior_hash, current_hash) == 0) {
            prior_hash = current_hash;
            events = events + 1;
            zmd_status(root, pid, mode, "checking", events, native_events);
            zmd_check(root, source);
            zmd_status(root, pid, mode, "idle", events, native_events);
            }
        }
    }
    if (native_events == 1) { zmd_close(event_dir); if (event_source >= 0) { zmd_close(event_source); } zmd_close(kq); }
    zmd_unlink(stop); zmd_unlink(lock);
    zmd_status(root, pid, mode, "stopped", events, native_events);
    return 0;
}
