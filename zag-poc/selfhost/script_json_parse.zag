// Root-only JSON convenience binding, before implicit module loading. Existing
// source declarations/imports therefore win even when they share facade names.
fn script_json_call_kind(name:[]u8)i32{
    if(@strEq(name,"script_json_stringify_string")||@strEq(name,"script_json_stringify_string_bounded")){return 1;}
    if(@strEq(name,"script_json_encode_context")||@strEq(name,"script_json_encode_context_bounded")){return 2;}
    if(@strEq(name,"script_json_parse")||@strEq(name,"script_json_parse_bounded")||
       @strEq(name,"script_json_document_free")||@strEq(name,"script_json_root")||
       @strEq(name,"script_json_get")||@strEq(name,"script_json_at")||
       @strEq(name,"script_json_string")||@strEq(name,"script_json_int")||
       @strEq(name,"script_json_float")||@strEq(name,"script_json_bool")||
       @strEq(name,"script_json_length")||@strEq(name,"script_json_member_key")||
       @strEq(name,"script_json_encode")||@strEq(name,"script_json_encode_bounded")||
       @strEq(name,"script_json_encoded_free")||@strEq(name,"script_json_ok")||
       @strEq(name,"script_json_missing")||@strEq(name,"script_json_null")||
       @strEq(name,"script_json_wrong_type")||@strEq(name,"script_json_invalid")||
       @strEq(name,"script_json_number_range")){return 4;}
    return 0;
}
fn script_json_bind_body(body:ArrayList[*Node],decls:ArrayList[*Node])i32{
    let flags:i32=0;let i:i32=0;while(i<body.len){flags=flags|script_json_bind_node(body.data[i],decls);i=i+1;}return flags;
}
fn script_json_bind_node(n:*Node,decls:ArrayList[*Node])i32{
    let flags:i32=0;
    switch(n.*){
        .call=>|c|{
            flags=script_json_bind_node(c.callee,decls)|script_json_bind_body(c.args,decls);
            switch(c.callee.*){.id=>|id|{
                let kind:i32=script_json_call_kind(id.name);
                if(kind>0&&script_has_user_fn(decls,id.name)==0){
                    if(kind==1||kind==2){
                        let args:ArrayList[*Node]=make[*Node](c.args.len+1);
                        push[*Node](&args,mk_cast(mk_ident("__zag_script_context"),"*i8"));
                        let i:i32=0;while(i<c.args.len){push[*Node](&args,c.args.data[i]);i=i+1;}
                        n.*=mk_gcall(c.callee,args,c.targs).*;
                    }
                    if(kind==1){flags=flags|1;}else{flags=flags|2;}
                }
            }else=>{}}
        }
        .let_=>|x|{if(x.has_init==1){flags=script_json_bind_node(x.expr,decls);}}
        .ret=>|x|{if(x.has_expr==1){flags=script_json_bind_node(x.expr,decls);}}
        .estmt=>|x|{flags=script_json_bind_node(x.expr,decls);}
        .assign=>|x|{flags=script_json_bind_node(x.target,decls)|script_json_bind_node(x.expr,decls);}
        .if_=>|x|{flags=script_json_bind_node(x.cond,decls)|script_json_bind_body(x.then_body,decls)|script_json_bind_body(x.els_body,decls);}
        .while_=>|x|{flags=script_json_bind_node(x.cond,decls)|script_json_bind_body(x.body,decls);}
        .unsafe_=>|x|{flags=script_json_bind_body(x.body,decls);}
        .defer_=>|x|{flags=script_json_bind_node(x.expr,decls);}
        .bin=>|x|{flags=script_json_bind_node(x.l,decls)|script_json_bind_node(x.r,decls);}
        .un=>|x|{flags=script_json_bind_node(x.e,decls);}
        .cast_=>|x|{flags=script_json_bind_node(x.expr,decls);}
        .idx=>|x|{flags=script_json_bind_node(x.base,decls)|script_json_bind_node(x.idx,decls);}
        .fld=>|x|{flags=script_json_bind_node(x.base,decls);}
        .slice_=>|x|{flags=script_json_bind_node(x.base,decls)|script_json_bind_node(x.lo,decls);if(x.has_hi==1){flags=flags|script_json_bind_node(x.hi,decls);}}
        .slit_=>|x|{let i:i32=0;while(i<x.fields.len){flags=flags|script_json_bind_node(x.fields.data[i].val,decls);i=i+1;}}
        .switch_=>|x|{flags=script_json_bind_node(x.subject,decls)|script_json_bind_body(x.els_body,decls);
            let i:i32=0;while(i<x.arms.len){flags=flags|script_json_bind_body(x.arms.data[i].body,decls);i=i+1;}}
        else=>{}
    }return flags;
}
