// Edition gate for v2-only surface syntax.
//
// This deliberately runs before parsing.  It protects edition 2026 from
// accidentally accepting a later construct through generic identifier parsing,
// and guarantees no backend can emit an artifact after that error.

@import("../std/rt.zag")

fn v2_dir_of(path: []u8) []u8 {
    let i: i32 = path.len - 1;
    while (i >= 0) {
        if (path[i] == '/') {
            if (i == 0) { return "/"; }
            return path[0..i];
        }
        i = i - 1;
    }
    return ".";
}

fn v2_join(dir: []u8, leaf: []u8) []u8 {
    if (@strEq(dir, ".")) { return leaf; }
    if (@strEq(dir, "/")) { return _zag_str_concat("/", leaf); }
    return _zag_str_concat(dir, _zag_str_concat("/", leaf));
}

// Return the nearest project edition, defaulting to frozen v1 for
// absent/malformed manifests.  Sources routinely live below the project root,
// so manifest discovery walks upward rather than requiring zag.mod beside each
// source file.  The manifest remains intentionally simple:
// `edition = "2027"`.
fn v2_project_edition(path: []u8) []u8 {
    let dir: []u8 = v2_dir_of(path);
    let keep_looking: i32 = 1;
    while (keep_looking == 1) {
        let modpath: []u8 = v2_join(dir, "zag.mod");
        if (_zag_file_exists(modpath) == 1) {
            let text: []u8 = _zag_read_file(modpath);
            let i: i32 = 0;
            while (i + 10 <= text.len) {
                if (text[i] == 'e' && text[i + 1] == 'd' && text[i + 2] == 'i' &&
                    text[i + 3] == 't' && text[i + 4] == 'i' && text[i + 5] == 'o' &&
                    text[i + 6] == 'n') {
                    let j: i32 = i + 7;
                    while (j < text.len && (text[j] == ' ' || text[j] == '\t' || text[j] == '=')) { j = j + 1; }
                    if (j < text.len && text[j] == '"') {
                        let k: i32 = j + 1;
                        while (k < text.len && text[k] != '"') { k = k + 1; }
                        if (k < text.len) { return text[j + 1..k]; }
                    }
                }
                i = i + 1;
            }
        }
        let parent: []u8 = v2_dir_of(dir);
        if (@strEq(parent, dir)) { keep_looking = 0; }
        else { dir = parent; }
    }
    return "2026";
}

fn v2_ident_char(c: u8) i32 {
    if (c >= 'a' && c <= 'z') { return 1; }
    if (c >= 'A' && c <= 'Z') { return 1; }
    if (c >= '0' && c <= '9') { return 1; }
    if (c == '_') { return 1; }
    return 0;
}

fn v2_repr_space(c: u8) i32 {
    if (c == ' ' || c == '\t' || c == '\n' || c == '\r') { return 1; }
    return 0;
}

// 0 = absent, 1 = the implemented @repr(C), 2 = another/malformed @repr form.
// Comments, strings, and character literals are skipped so mentioning future
// syntax in documentation never opts a frozen-edition source into v2.
fn v2_repr_form(src: []u8) i32 {
    let i: i32 = 0;
    let saw_c: i32 = 0;
    while (i < src.len) {
        if (src[i] == '/' && i + 1 < src.len && src[i + 1] == '/') {
            i = i + 2;
            while (i < src.len && src[i] != '\n') { i = i + 1; }
        } else if (src[i] == '/' && i + 1 < src.len && src[i + 1] == '*') {
            let depth: i32 = 1;
            i = i + 2;
            while (i < src.len && depth > 0) {
                if (i + 1 < src.len && src[i] == '/' && src[i + 1] == '*') { depth = depth + 1; i = i + 2; }
                else if (i + 1 < src.len && src[i] == '*' && src[i + 1] == '/') { depth = depth - 1; i = i + 2; }
                else { i = i + 1; }
            }
        } else if (src[i] == '"' || src[i] == '\'') {
            let quote: u8 = src[i];
            i = i + 1;
            while (i < src.len && src[i] != quote) {
                if (src[i] == '\\' && i + 1 < src.len) { i = i + 2; }
                else { i = i + 1; }
            }
            if (i < src.len) { i = i + 1; }
        } else if (src[i] == '@' && i + 5 <= src.len &&
            src[i + 1] == 'r' && src[i + 2] == 'e' && src[i + 3] == 'p' && src[i + 4] == 'r' &&
            (i + 5 == src.len || v2_ident_char(src[i + 5]) == 0)) {
            let j: i32 = i + 5;
            while (j < src.len && v2_repr_space(src[j]) == 1) { j = j + 1; }
            if (j >= src.len || src[j] != '(') { return 2; }
            j = j + 1;
            while (j < src.len && v2_repr_space(src[j]) == 1) { j = j + 1; }
            if (j >= src.len || src[j] != 'C') { return 2; }
            j = j + 1;
            while (j < src.len && v2_repr_space(src[j]) == 1) { j = j + 1; }
            if (j >= src.len || src[j] != ')') { return 2; }
            saw_c = 1;
            i = j + 1;
        } else { i = i + 1; }
    }
    return saw_c;
}

fn v2_starts_with(s: []u8, prefix: []u8) i32 {
    if (s.len < prefix.len) { return 0; }
    let i: i32 = 0;
    while (i < prefix.len) {
        if (s[i] != prefix[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

// A recognized-looking v2 option must never be silently ignored by the v1
// driver.  Keep this rejection beside the edition gate until the option has a
// specified implementation and a positive/negative execution suite.
fn v2_validate_options() i32 {
    let i: i32 = 1;
    while (i < _zag_argc()) {
        let arg: []u8 = _zag_arg(i);
        if (@strEq(arg, "--safety=checked") == 1 || @strEq(arg, "--sanitize=memory") == 1) {
            // Implemented by the native x86-64 lowering path.  The source
            // edition check below keeps it from changing frozen v1 behavior.
        } else if (@strEq(arg, "--emit-shared") == 1 || @strEq(arg, "--shared") == 1 ||
            @strEq(arg, "--emit-dylib") == 1 || @strEq(arg, "--emit-lib") == 1 ||
            @strEq(arg, "--emit=shared") == 1 ||
            @strEq(arg, "--emit-object") == 1 || @strEq(arg, "--emit=obj") == 1 ||
            @strEq(arg, "-c") == 1 || @strEq(arg, "--pie") == 1 ||
            @strEq(arg, "-pie") == 1 || @strEq(arg, "--whole-archive") == 1 ||
            @strEq(arg, "--no-whole-archive") == 1 ||
            v2_starts_with(arg, "--dynamic-linker") == 1 ||
            v2_starts_with(arg, "--rpath") == 1 || v2_starts_with(arg, "--soname") == 1 ||
            v2_starts_with(arg, "--export") == 1 ||
            @strEq(arg, "-g") == 1 || @strEq(arg, "--debug-info") == 1 ||
            @strEq(arg, "--emit-debug") == 1 || @strEq(arg, "--strip") == 1 ||
            @strEq(arg, "--strip-debug") == 1 || @strEq(arg, "--emit-asm") == 1 ||
            @strEq(arg, "-S") == 1 || @strEq(arg, "--emit-ir") == 1 ||
            @strEq(arg, "--emit-llvm") == 1 ||
            (v2_starts_with(arg, "--debug") == 1 && @strEq(arg, "--debug") == 0) ||
            v2_starts_with(arg, "-fsanitize") == 1 ||
            v2_starts_with(arg, "-fno-sanitize") == 1 ||
            v2_starts_with(arg, "-m") == 1 ||
            v2_starts_with(arg, "-C") == 1 ||
            v2_starts_with(arg, "--target-cpu") == 1 ||
            v2_starts_with(arg, "--cpu-feature") == 1 ||
            v2_starts_with(arg, "--features") == 1 ||
            v2_starts_with(arg, "--safety") == 1 ||
            v2_starts_with(arg, "--sanitize") == 1 ||
            v2_starts_with(arg, "--target-feature") == 1 ||
            v2_starts_with(arg, "--gpu-runtime") == 1 ||
            v2_starts_with(arg, "--edition") == 1) {
            _zag_eprintln(_zag_str_concat("E0202: v2 compiler option is not implemented: ", arg));
            _zag_eprintln("note: the option was rejected; no executable was emitted");
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn v2_has_cli_option(want: []u8) i32 {
    let i: i32 = 1;
    while (i < _zag_argc()) {
        if (@strEq(_zag_arg(i), want)) { return 1; }
        i = i + 1;
    }
    return 0;
}

// Scan source tokens rather than substrings: a v1 comment or string mentioning
// "unsafe" must not change the program's edition requirements.
fn v2_has_word(src: []u8, word: []u8) i32 {
    let i: i32 = 0;
    while (i < src.len) {
        if (src[i] == '/' && i + 1 < src.len && src[i + 1] == '/') {
            i = i + 2;
            while (i < src.len && src[i] != '\n') { i = i + 1; }
        } else if (src[i] == '"') {
            i = i + 1;
            while (i < src.len && src[i] != '"') {
                if (src[i] == '\\' && i + 1 < src.len) { i = i + 2; }
                else { i = i + 1; }
            }
            if (i < src.len) { i = i + 1; }
        } else if (i + word.len <= src.len &&
                   (i == 0 || v2_ident_char(src[i - 1]) == 0)) {
        let j: i32 = 0;
        let same: i32 = 1;
        while (j < word.len && same == 1) {
            if (src[i + j] != word[j]) { same = 0; }
            j = j + 1;
        }
            if (same == 1 &&
                (i + word.len == src.len || v2_ident_char(src[i + word.len]) == 0)) {
                return 1;
            }
            i = i + 1;
        } else { i = i + 1; }
    }
    return 0;
}

// Return the one-based source line of the first reserved token while honoring
// the same comment/string rules as the edition gate.  Diagnostics must point
// at the actual imported source that triggered E0200 instead of forcing users
// to guess which file in an import graph contains a future-edition word.
fn v2_word_line(src: []u8, word: []u8) i32 {
    let i: i32 = 0;
    let line: i32 = 1;
    while (i < src.len) {
        if (src[i] == '/' && i + 1 < src.len && src[i + 1] == '/') {
            i = i + 2;
            while (i < src.len && src[i] != '\n') { i = i + 1; }
        } else if (src[i] == '"') {
            i = i + 1;
            while (i < src.len && src[i] != '"') {
                if (src[i] == '\\' && i + 1 < src.len) { i = i + 2; }
                else {
                    if (src[i] == '\n') { line = line + 1; }
                    i = i + 1;
                }
            }
            if (i < src.len) { i = i + 1; }
        } else if (src[i] == '\n') {
            line = line + 1;
            i = i + 1;
        } else if (i + word.len <= src.len &&
                   (i == 0 || v2_ident_char(src[i - 1]) == 0)) {
            let j: i32 = 0;
            let same: i32 = 1;
            while (j < word.len && same == 1) {
                if (src[i + j] != word[j]) { same = 0; }
                j = j + 1;
            }
            if (same == 1 &&
                (i + word.len == src.len || v2_ident_char(src[i + word.len]) == 0)) {
                return line;
            }
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
    return 0;
}

fn v2_reserved_word(src: []u8) []u8 {
    if (v2_word_line(src, "unsafe") > 0) { return "unsafe"; }
    if (v2_word_line(src, "global") > 0) { return "global"; }
    if (v2_word_line(src, "volatile") > 0) { return "volatile"; }
    if (v2_word_line(src, "atomic") > 0) { return "atomic"; }
    if (v2_word_line(src, "asm") > 0) { return "asm"; }
    return "";
}

// Pointer qualifiers are v2 syntax but their component words can be ordinary
// v1 identifiers (`const` is already a v1 declaration form).  Recognize them
// only immediately after a pointer star so edition 2026 gets the precise
// E0200 boundary instead of a downstream parser/codegen accident.
fn v2_has_pointer_qualifier(src: []u8, word: []u8) i32 {
    let i: i32 = 0;
    while (i < src.len) {
        if (src[i] == '/' && i + 1 < src.len && src[i + 1] == '/') {
            i = i + 2;
            while (i < src.len && src[i] != '\n') { i = i + 1; }
        } else if (src[i] == '"') {
            i = i + 1;
            while (i < src.len && src[i] != '"') {
                if (src[i] == '\\' && i + 1 < src.len) { i = i + 2; }
                else { i = i + 1; }
            }
            if (i < src.len) { i = i + 1; }
        } else if (src[i] == '*') {
            let j: i32 = i + 1;
            while (j < src.len && (src[j] == ' ' || src[j] == '\t' || src[j] == '\n' || src[j] == '\r')) { j = j + 1; }
            let k: i32 = 0;
            let same: i32 = 1;
            while (k < word.len && same == 1 && j + k < src.len) {
                if (src[j + k] != word[k]) { same = 0; }
                k = k + 1;
            }
            if (same == 1 && k == word.len &&
                (j + word.len == src.len || v2_ident_char(src[j + word.len]) == 0)) { return 1; }
            i = i + 1;
        } else { i = i + 1; }
    }
    return 0;
}

// Accepted unsafe forms are lexical blocks and unsafe function declarations.
// Other future forms remain fail-closed at the edition gate.
fn v2_unsafe_words_are_supported(src: []u8) i32 {
    let i: i32 = 0;
    while (i < src.len) {
        if (src[i] == '/' && i + 1 < src.len && src[i + 1] == '/') {
            i = i + 2;
            while (i < src.len && src[i] != '\n') { i = i + 1; }
        } else if (src[i] == '"') {
            i = i + 1;
            while (i < src.len && src[i] != '"') {
                if (src[i] == '\\' && i + 1 < src.len) { i = i + 2; }
                else { i = i + 1; }
            }
            if (i < src.len) { i = i + 1; }
        } else if (i + 6 <= src.len &&
                   (i == 0 || v2_ident_char(src[i - 1]) == 0) &&
                   src[i] == 'u' && src[i + 1] == 'n' && src[i + 2] == 's' &&
                   src[i + 3] == 'a' && src[i + 4] == 'f' && src[i + 5] == 'e' &&
                   (i + 6 == src.len || v2_ident_char(src[i + 6]) == 0)) {
            let j: i32 = i + 6;
            while (j < src.len && (src[j] == ' ' || src[j] == '\t' ||
                                   src[j] == '\n' || src[j] == '\r')) { j = j + 1; }
            if (j >= src.len) { return 0; }
            if (src[j] != '{') {
                if (j + 2 > src.len || src[j] != 'f' || src[j + 1] != 'n' ||
                    (j + 2 < src.len && v2_ident_char(src[j + 2]) == 1)) { return 0; }
            }
            i = j + 1;
        } else { i = i + 1; }
    }
    return 1;
}

// 0 = permitted v1 source; 1 = hard error.  V2 forms remain rejected in 2027
// until their typed lowering exists; that is an intentional, honest boundary.
fn v2_validate_source(path: []u8, src: []u8) i32 {
    let uses_unsafe: i32 = v2_has_word(src, "unsafe");
    let uses_pointer: i32 = v2_has_pointer_qualifier(src, "const") +
        v2_has_pointer_qualifier(src, "mut") + v2_has_pointer_qualifier(src, "opaque") +
        v2_has_pointer_qualifier(src, "device") + v2_has_pointer_qualifier(src, "workgroup") +
        v2_has_pointer_qualifier(src, "host");
    let uses_global: i32 = v2_has_word(src, "global");
    let unsupported: i32 = v2_has_word(src, "volatile") + v2_has_word(src, "atomic") +
        v2_has_word(src, "asm");
    let safety_checked: i32 = v2_has_cli_option("--safety=checked");
    let sanitize_memory: i32 = v2_has_cli_option("--sanitize=memory");
    let repr_form: i32 = v2_repr_form(src);
    let uses_repr: i32 = (repr_form > 0) as i32;
    let uses_v2: i32 = uses_unsafe + uses_pointer + uses_global + unsupported + safety_checked + sanitize_memory + uses_repr;
    if (uses_v2 == 0) { return 0; }
    let edition: []u8 = v2_project_edition(path);
    if (@strEq(edition, "2027") == 0) {
        _zag_eprintln("E0200: v2 machine-control syntax requires `edition = \"2027\"` in zag.mod");
        let path_message: []u8 = _zag_str_concat("  --> ", path);
        _zag_eprintln(path_message);
        _zag_str_free(path_message);
        let reserved: []u8 = v2_reserved_word(src);
        if (reserved.len > 0) {
            let line_text: []u8 = _zag_i64_to_str(v2_word_line(src, reserved) as i64);
            let line_suffix: []u8 = _zag_str_concat("` at source line ", line_text);
            let token_suffix: []u8 = _zag_str_concat(reserved, line_suffix);
            let token_message: []u8 = _zag_str_concat("note: detected reserved token `", token_suffix);
            _zag_eprintln(token_message);
            _zag_str_free(line_text);
            _zag_str_free(line_suffix);
            _zag_str_free(token_suffix);
            _zag_str_free(token_message);
        }
        _zag_eprintln("note: edition 2026 is frozen; this source was not compiled and no executable was emitted");
        return 1;
    }
    if (unsupported > 0 || repr_form == 2 || (uses_unsafe > 0 && v2_unsafe_words_are_supported(src) == 0)) {
        _zag_eprintln("E0201: selected v2 machine-control syntax is not implemented by this compiler build");
        _zag_eprintln("note: @repr(C), lexical unsafe blocks, and raw-pointer type qualifiers are implemented; the requested construct was rejected before code generation");
        return 1;
    }
    return 0;
}
