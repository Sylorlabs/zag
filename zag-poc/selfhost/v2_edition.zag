// Edition gate for v2-only surface syntax.
//
// This deliberately runs before parsing.  It protects edition 2026 from
// accidentally accepting a later construct through generic identifier parsing,
// and guarantees no backend can emit an artifact after that error.

@import("../std/rt.zag")

fn v2_dir_of(path: []u8) []u8 {
    let i: i32 = path.len - 1;
    while (i >= 0) {
        if (path[i] == '/') {
            if (i == 0) { return "/"; }
            return path[0..i];
        }
        i = i - 1;
    }
    return ".";
}

fn v2_join(dir: []u8, leaf: []u8) []u8 {
    if (@strEq(dir, ".")) { return leaf; }
    if (@strEq(dir, "/")) { return _zag_str_concat("/", leaf); }
    return _zag_str_concat(dir, _zag_str_concat("/", leaf));
}

// Return the nearest project edition, defaulting to frozen v1 for
// absent/malformed manifests.  Sources routinely live below the project root,
// so manifest discovery walks upward rather than requiring zag.mod beside each
// source file.  The manifest remains intentionally simple:
// `edition = "2027"`.
fn v2_project_edition(path: []u8) []u8 {
    let dir: []u8 = v2_dir_of(path);
    let keep_looking: i32 = 1;
    while (keep_looking == 1) {
        let modpath: []u8 = v2_join(dir, "zag.mod");
        if (_zag_file_exists(modpath) == 1) {
            let text: []u8 = _zag_read_file(modpath);
            let i: i32 = 0;
            while (i + 10 <= text.len) {
                if (text[i] == 'e' && text[i + 1] == 'd' && text[i + 2] == 'i' &&
                    text[i + 3] == 't' && text[i + 4] == 'i' && text[i + 5] == 'o' &&
                    text[i + 6] == 'n') {
                    let j: i32 = i + 7;
                    while (j < text.len && (text[j] == ' ' || text[j] == '\t' || text[j] == '=')) { j = j + 1; }
                    if (j < text.len && text[j] == '"') {
                        let k: i32 = j + 1;
                        while (k < text.len && text[k] != '"') { k = k + 1; }
                        if (k < text.len) { return text[j + 1..k]; }
                    }
                }
                i = i + 1;
            }
        }
        let parent: []u8 = v2_dir_of(dir);
        if (@strEq(parent, dir)) { keep_looking = 0; }
        else { dir = parent; }
    }
    return "2026";
}

fn v2_ident_char(c: u8) i32 {
    if (c >= 'a' && c <= 'z') { return 1; }
    if (c >= 'A' && c <= 'Z') { return 1; }
    if (c >= '0' && c <= '9') { return 1; }
    if (c == '_') { return 1; }
    return 0;
}

fn v2_starts_with(s: []u8, prefix: []u8) i32 {
    if (s.len < prefix.len) { return 0; }
    let i: i32 = 0;
    while (i < prefix.len) {
        if (s[i] != prefix[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

// A recognized-looking v2 option must never be silently ignored by the v1
// driver.  Keep this rejection beside the edition gate until the option has a
// specified implementation and a positive/negative execution suite.
fn v2_validate_options() i32 {
    let i: i32 = 1;
    while (i < _zag_argc()) {
        let arg: []u8 = _zag_arg(i);
        if (v2_starts_with(arg, "--safety") == 1 ||
            v2_starts_with(arg, "--sanitize") == 1 ||
            v2_starts_with(arg, "--target-feature") == 1 ||
            v2_starts_with(arg, "--gpu-runtime") == 1 ||
            v2_starts_with(arg, "--edition") == 1) {
            _zag_eprintln(_zag_str_concat("E0202: v2 compiler option is not implemented: ", arg));
            _zag_eprintln("note: the option was rejected; no executable was emitted");
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// Scan source tokens rather than substrings: a v1 comment or string mentioning
// "unsafe" must not change the program's edition requirements.
fn v2_has_word(src: []u8, word: []u8) i32 {
    let i: i32 = 0;
    while (i < src.len) {
        if (src[i] == '/' && i + 1 < src.len && src[i + 1] == '/') {
            i = i + 2;
            while (i < src.len && src[i] != '\n') { i = i + 1; }
        } else if (src[i] == '"') {
            i = i + 1;
            while (i < src.len && src[i] != '"') {
                if (src[i] == '\\' && i + 1 < src.len) { i = i + 2; }
                else { i = i + 1; }
            }
            if (i < src.len) { i = i + 1; }
        } else if (i + word.len <= src.len &&
                   (i == 0 || v2_ident_char(src[i - 1]) == 0)) {
        let j: i32 = 0;
        let same: i32 = 1;
        while (j < word.len && same == 1) {
            if (src[i + j] != word[j]) { same = 0; }
            j = j + 1;
        }
            if (same == 1 &&
                (i + word.len == src.len || v2_ident_char(src[i + word.len]) == 0)) {
                return 1;
            }
            i = i + 1;
        } else { i = i + 1; }
    }
    return 0;
}

// Pointer qualifiers are v2 syntax but their component words can be ordinary
// v1 identifiers (`const` is already a v1 declaration form).  Recognize them
// only immediately after a pointer star so edition 2026 gets the precise
// E0200 boundary instead of a downstream parser/codegen accident.
fn v2_has_pointer_qualifier(src: []u8, word: []u8) i32 {
    let i: i32 = 0;
    while (i < src.len) {
        if (src[i] == '/' && i + 1 < src.len && src[i + 1] == '/') {
            i = i + 2;
            while (i < src.len && src[i] != '\n') { i = i + 1; }
        } else if (src[i] == '"') {
            i = i + 1;
            while (i < src.len && src[i] != '"') {
                if (src[i] == '\\' && i + 1 < src.len) { i = i + 2; }
                else { i = i + 1; }
            }
            if (i < src.len) { i = i + 1; }
        } else if (src[i] == '*') {
            let j: i32 = i + 1;
            while (j < src.len && (src[j] == ' ' || src[j] == '\t' || src[j] == '\n' || src[j] == '\r')) { j = j + 1; }
            let k: i32 = 0;
            let same: i32 = 1;
            while (k < word.len && same == 1 && j + k < src.len) {
                if (src[j + k] != word[k]) { same = 0; }
                k = k + 1;
            }
            if (same == 1 && k == word.len &&
                (j + word.len == src.len || v2_ident_char(src[j + word.len]) == 0)) { return 1; }
            i = i + 1;
        } else { i = i + 1; }
    }
    return 0;
}

// Accepted unsafe forms are lexical blocks and unsafe function declarations.
// Other future forms remain fail-closed at the edition gate.
fn v2_unsafe_words_are_supported(src: []u8) i32 {
    let i: i32 = 0;
    while (i < src.len) {
        if (src[i] == '/' && i + 1 < src.len && src[i + 1] == '/') {
            i = i + 2;
            while (i < src.len && src[i] != '\n') { i = i + 1; }
        } else if (src[i] == '"') {
            i = i + 1;
            while (i < src.len && src[i] != '"') {
                if (src[i] == '\\' && i + 1 < src.len) { i = i + 2; }
                else { i = i + 1; }
            }
            if (i < src.len) { i = i + 1; }
        } else if (i + 6 <= src.len &&
                   (i == 0 || v2_ident_char(src[i - 1]) == 0) &&
                   src[i] == 'u' && src[i + 1] == 'n' && src[i + 2] == 's' &&
                   src[i + 3] == 'a' && src[i + 4] == 'f' && src[i + 5] == 'e' &&
                   (i + 6 == src.len || v2_ident_char(src[i + 6]) == 0)) {
            let j: i32 = i + 6;
            while (j < src.len && (src[j] == ' ' || src[j] == '\t' ||
                                   src[j] == '\n' || src[j] == '\r')) { j = j + 1; }
            if (j >= src.len) { return 0; }
            if (src[j] != '{') {
                if (j + 2 > src.len || src[j] != 'f' || src[j + 1] != 'n' ||
                    (j + 2 < src.len && v2_ident_char(src[j + 2]) == 1)) { return 0; }
            }
            i = j + 1;
        } else { i = i + 1; }
    }
    return 1;
}

// 0 = permitted v1 source; 1 = hard error.  V2 forms remain rejected in 2027
// until their typed lowering exists; that is an intentional, honest boundary.
fn v2_validate_source(path: []u8, src: []u8) i32 {
    let uses_unsafe: i32 = v2_has_word(src, "unsafe");
    let uses_pointer: i32 = v2_has_pointer_qualifier(src, "const") +
        v2_has_pointer_qualifier(src, "mut") + v2_has_pointer_qualifier(src, "opaque") +
        v2_has_pointer_qualifier(src, "device") + v2_has_pointer_qualifier(src, "workgroup") +
        v2_has_pointer_qualifier(src, "host");
    let unsupported: i32 = v2_has_word(src, "volatile") + v2_has_word(src, "atomic") +
        v2_has_word(src, "asm");
    let uses_v2: i32 = uses_unsafe + uses_pointer + unsupported;
    if (uses_v2 == 0) { return 0; }
    let edition: []u8 = v2_project_edition(path);
    if (@strEq(edition, "2027") == 0) {
        _zag_eprintln("E0200: v2 machine-control syntax requires `edition = \"2027\"` in zag.mod");
        _zag_eprintln("note: edition 2026 is frozen; this source was not compiled and no executable was emitted");
        return 1;
    }
    if (unsupported > 0 || (uses_unsafe > 0 && v2_unsafe_words_are_supported(src) == 0)) {
        _zag_eprintln("E0201: selected v2 machine-control syntax is not implemented by this compiler build");
        _zag_eprintln("note: lexical unsafe blocks and raw-pointer type qualifiers are implemented; the requested construct was rejected before code generation");
        return 1;
    }
    return 0;
}
