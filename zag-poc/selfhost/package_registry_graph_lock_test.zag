@import("package_registry_transitive.zag")

extern fn _zag_allocator_live_bytes() i64

fn lock_check(ok: i32, label: []u8, failures: *i32) void {
    if (ok != 0) { _zag_print("ok  "); _zag_println(label); }
    else { failures.* = failures.* + 1; _zag_print("FAIL "); _zag_println(label); }
}

fn main() i32 {
    let failures: i32 = 0;
    let before: i64 = _zag_allocator_live_bytes();
    let body: []u8 = "format=zag-registry-index-v1\nauthority=local-file-v1\nsignature=none\nentry=alpha\t1.0.0\tsrc/alpha.zag\t1,2,3\nentry=alpha\t1.2.0\tsrc/alpha-new.zag\t4,5,6\nentry=beta\t2.0.0\tsrc/beta.zag\t7,8,9\n";
    let index: []u8 = package_registry_finalize(body);
    let edges: []u8 = "root\talpha\t^1.0.0\nroot\tbeta\t^2.0.0\nalpha\tbeta\t^2.0.0";
    let lock: PackageRegistryGraphLock =
        package_registry_graph_lock_create(index, edges);
    let checked: PackageRegistryGraphLockCheck =
        package_registry_graph_lock_verify(index, edges, lock.bytes);
    lock_check(checked.valid == 1 && checked.entry_count == 2 &&
        checked.error == PackageRegistryTransitiveError.none,
        "generated graph lock verifies against exact index and edges", &failures);

    let forged: []u8 = _zag_str_concat(lock.bytes, "x");
    let forged_check: PackageRegistryGraphLockCheck =
        package_registry_graph_lock_verify(index, edges, forged);
    lock_check(forged_check.valid == 0 &&
        forged_check.error == PackageRegistryTransitiveError.invalid_lock,
        "appended lock bytes fail the envelope checksum", &failures);
    _zag_str_free(forged);

    let reduced_edges: []u8 = "root\talpha\t^1.0.0";
    let reduced_lock: PackageRegistryGraphLock =
        package_registry_graph_lock_create(index, reduced_edges);
    let reduced_check: PackageRegistryGraphLockCheck =
        package_registry_graph_lock_verify(index, edges, reduced_lock.bytes);
    lock_check(reduced_check.valid == 0 &&
        reduced_check.error == PackageRegistryTransitiveError.lock_mismatch,
        "lock coverage mismatch fails before publication", &failures);

    let changed_body: []u8 = "format=zag-registry-index-v1\nauthority=local-file-v1\nsignature=none\nentry=alpha\t1.0.0\tsrc/alpha.zag\t1,2,3\nentry=alpha\t1.2.0\tsrc/alpha-new.zag\t8,8,8\nentry=beta\t2.0.0\tsrc/beta.zag\t7,8,9\n";
    let changed_index: []u8 = package_registry_finalize(changed_body);
    let changed_check: PackageRegistryGraphLockCheck =
        package_registry_graph_lock_verify(changed_index, edges, lock.bytes);
    lock_check(changed_check.valid == 0 &&
        changed_check.error == PackageRegistryTransitiveError.lock_mismatch &&
        @strEq(changed_check.failing_name, "alpha"),
        "changed indexed checksum invalidates the old lock selection", &failures);

    let truncated: []u8 = lock.bytes[0..lock.bytes.len - 1];
    let truncated_check: PackageRegistryGraphLockCheck =
        package_registry_graph_lock_verify(index, edges, truncated);
    lock_check(truncated_check.valid == 0 &&
        truncated_check.error == PackageRegistryTransitiveError.invalid_lock,
        "truncated lock fails closed", &failures);

    if (lock.bytes.len > 0) { _zag_str_free(lock.bytes); }
    if (reduced_lock.bytes.len > 0) { _zag_str_free(reduced_lock.bytes); }
    _zag_str_free(changed_index); _zag_str_free(index);
    lock_check(_zag_allocator_live_bytes() == before,
        "lock verification restores allocator baseline", &failures);
    if (failures == 0) { _zag_println("package registry graph lock: 5/5"); }
    return failures;
}
