// Origin-bound authority for the process platform's private runtime bridge.
@import("../parse.zag")

fn process_script_platform_origin() []u8 {
    // Resolve the sibling of the *selected* std:process, including installed
    // layouts. Do not trust a basename or add a new resolver search fallback.
    return canon_path(join_path(dir_of(resolve_import_path("std:process", ".")), "process_platform.zag"));
}

fn process_script_intrinsic(name: []u8) i32 {
    return (@strEq(name,"_zag_process_platform_capabilities") ||
        @strEq(name,"_zag_process_wait_readable") ||
        @strEq(name,"_zag_process_read_disposition")) as i32;
}

fn process_script_runtime_pair(owner: []u8, name: []u8) i32 {
    if (@strEq(name,"_zag_process_platform_capabilities")) { return @strEq(owner,"process_platform_capabilities") as i32; }
    if (@strEq(name,"_zag_process_wait_readable")) { return @strEq(owner,"process_platform_wait_readable") as i32; }
    if (@strEq(name,"_zag_process_read_disposition")) { return @strEq(owner,"process_platform_read_disposition") as i32; }
    if (!@strEq(name,"_zag_raw_syscall")) { return 0; }
    return (@strEq(owner,"process_platform_pipe") || @strEq(owner,"process_platform_nonblocking") ||
        @strEq(owner,"process_platform_close") || @strEq(owner,"process_platform_fork") ||
        @strEq(owner,"process_platform_set_group") || @strEq(owner,"process_platform_dup2") ||
        @strEq(owner,"process_platform_exec_shell") || @strEq(owner,"process_platform_read") ||
        @strEq(owner,"process_platform_wait") || @strEq(owner,"process_platform_kill_group") ||
        @strEq(owner,"process_platform_kill_child")) as i32;
}

fn process_script_runtime_authorized(decls: ArrayList[*Node], owner: []u8, name: []u8) i32 {
    if (process_script_runtime_pair(owner,name) == 0) { return 0; }
    let expected: []u8 = process_script_platform_origin();
    let runtime: []u8 = canon_path(resolve_import_path("std:rt", "."));
    let owner_found: i32 = 0;
    let bridge_found: i32 = 0;
    let i: i32 = 0;
    while (i < decls.len) {
        switch (decls.data[i].*) {
            .fn_decl => |f| {
                if (@strEq(f.name,owner)) {
                    if (f.is_extern != 0 || !@strEq(f.origin,expected)) { return 0; }
                    owner_found = owner_found + 1;
                }
                if (@strEq(f.name,name)) {
                    if (f.is_extern != 1) { return 0; }
                    if (!@strEq(f.origin,expected) &&
                        !(@strEq(name,"_zag_raw_syscall") && @strEq(f.origin,runtime))) { return 0; }
                    bridge_found = 1;
                }
            }
            else => {}
        }
        i = i + 1;
    }
    return (owner_found == 1 && bridge_found == 1) as i32;
}
