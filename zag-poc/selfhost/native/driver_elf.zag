// selfhost/native/driver_elf.zag — deterministic Linux driver ET_REL writer.
//
// This writer consumes the actual target encoder's text and relocation records.
// It is intentionally separate from the executable and narrow C-ABI writers:
// a driver object has kernel metadata, writable data, data/text relocations,
// and retained DWARF sections.  No executable image is wrapped or relabeled as
// a module here.
//
// The current backend contract is deliberately small: the source must expose
// kernel entry/exit functions and all foreign calls must already be represented
// by target relocations.  Unsupported ABI/data forms are rejected by the caller
// before this writer is reached.

@import("../../std/list.zag")
@import("../../std/rt.zag")

struct DriverElfSymbol {
    name: []u8,
    offset: i32,
    size: i32,
    defined: i32,
    section: i32,
    bind: i32,
    type_: i32,
}

struct DriverElfReloc {
    offset: i32,
    symbol: i32,
    typ: i32,
    addend: i64,
}

struct DriverElfSpec {
    machine: i32,
    word_size: i32,
    text: ArrayList[u8],
    data: ArrayList[u8],
    modinfo: ArrayList[u8],
    symbols: ArrayList[DriverElfSymbol],
    imports: ArrayList[[]u8],
    text_relocs: ArrayList[DriverElfReloc],
    data_relocs: ArrayList[DriverElfReloc],
    debug_abbrev: ArrayList[u8],
    debug_info: ArrayList[u8],
    debug_line: ArrayList[u8],
}

fn driver_elf_eb(buf: *ArrayList[u8], value: i64) void {
    push[u8](buf, (value & 255) as u8);
}

fn driver_elf_le(buf: *ArrayList[u8], value: i64, count: i32) void {
    let v: i64 = value;
    let i: i32 = 0;
    while (i < count) {
        let b: i64 = v & 255;
        driver_elf_eb(buf, b);
        v = (v - b) / 256;
        i = i + 1;
    }
}

fn driver_elf_align(buf: *ArrayList[u8], alignment: i32) void {
    while ((buf.*.len % alignment) != 0) { driver_elf_eb(buf, 0); }
}

fn driver_elf_cstr(buf: *ArrayList[u8], value: []u8) void {
    let i: i32 = 0;
    while (i < value.len) {
        driver_elf_eb(buf, value[i] as i64);
        i = i + 1;
    }
    driver_elf_eb(buf, 0);
}

fn driver_elf_copy(buf: *ArrayList[u8], value: ArrayList[u8]) void {
    let i: i32 = 0;
    while (i < value.len) {
        driver_elf_eb(buf, value.data[i] as i64);
        i = i + 1;
    }
}

fn driver_elf_shdr(buf: *ArrayList[u8], name: i32, typ: i32,
                   flags: i64, offset: i64, size: i64,
                   link: i32, info: i32, alignment: i64,
                   entsize: i64) void {
    driver_elf_le(buf, name as i64, 4);
    driver_elf_le(buf, typ as i64, 4);
    driver_elf_le(buf, flags, 8);
    driver_elf_le(buf, 0, 8);
    driver_elf_le(buf, offset, 8);
    driver_elf_le(buf, size, 8);
    driver_elf_le(buf, link as i64, 4);
    driver_elf_le(buf, info as i64, 4);
    driver_elf_le(buf, alignment, 8);
    driver_elf_le(buf, entsize, 8);
}

fn driver_elf_sym(buf: *ArrayList[u8], name: i32, info: i32,
                  section: i32, value: i64, size: i64) void {
    driver_elf_le(buf, name as i64, 4);
    driver_elf_eb(buf, info as i64);
    driver_elf_eb(buf, 0);
    driver_elf_le(buf, section as i64, 2);
    driver_elf_le(buf, value, 8);
    driver_elf_le(buf, size, 8);
}

fn driver_elf_rela(buf: *ArrayList[u8], reloc: DriverElfReloc) void {
    driver_elf_le(buf, reloc.offset as i64, 8);
    // r_info = (symbol index << 32) | relocation type.
    driver_elf_le(buf, (reloc.symbol as i64) * 4294967296 + reloc.typ as i64, 8);
    driver_elf_le(buf, reloc.addend, 8);
}

fn driver_elf_name_offset(names: ArrayList[[]u8], wanted: []u8) i32 {
    let i: i32 = 0;
    while (i < names.len) {
        if (@strEq(names.data[i], wanted)) { return i; }
        i = i + 1;
    }
    return -1;
}

fn driver_elf_reloc_type_valid(machine: i32, typ: i32, data: i32) i32 {
    if (machine == 62) {
        // R_X86_64_64, R_X86_64_PC32, and R_X86_64_PLT32.
        if (data == 1 && typ == 1) { return 1; }
        if (data == 0 && (typ == 2 || typ == 4)) { return 1; }
    }
    if (machine == 183) {
        // R_AARCH64_ABS64 and R_AARCH64_CALL26.
        if (data == 1 && typ == 257) { return 1; }
        if (data == 0 && typ == 283) { return 1; }
    }
    return 0;
}

fn driver_elf_spec_valid(spec: DriverElfSpec) i32 {
    if (spec.machine != 62 && spec.machine != 183) { return 0; }
    if (spec.word_size != 8) { return 0; }
    if (spec.text.len <= 0 || spec.modinfo.len <= 0) { return 0; }
    let i: i32 = 0;
    while (i < spec.symbols.len) {
        let symbol: DriverElfSymbol = spec.symbols.data[i];
        if (symbol.name.len == 0 || symbol.defined == 0 ||
            symbol.section != 1 || symbol.offset < 0 || symbol.size < 0 ||
            symbol.offset > spec.text.len ||
            symbol.size > spec.text.len - symbol.offset) { return 0; }
        let j: i32 = i + 1;
        while (j < spec.symbols.len) {
            if (@strEq(symbol.name, spec.symbols.data[j].name)) { return 0; }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < spec.imports.len) {
        if (spec.imports.data[i].len == 0) { return 0; }
        let j: i32 = 0;
        while (j < spec.symbols.len) {
            if (@strEq(spec.imports.data[i], spec.symbols.data[j].name)) { return 0; }
            j = j + 1;
        }
        j = i + 1;
        while (j < spec.imports.len) {
            if (@strEq(spec.imports.data[i], spec.imports.data[j])) { return 0; }
            j = j + 1;
        }
        i = i + 1;
    }
    let symbol_count: i32 = 4 + spec.symbols.len + spec.imports.len;
    i = 0;
    while (i < spec.text_relocs.len) {
        let reloc: DriverElfReloc = spec.text_relocs.data[i];
        let width: i32 = 4;
        let data_reference: i32 = 0;
        if (reloc.symbol == 2) { width = 8; data_reference = 1; }
        if (reloc.offset < 0 || reloc.offset > spec.text.len - width ||
            (reloc.symbol != 2 && (reloc.symbol < 4 || reloc.symbol >= symbol_count)) ||
            (reloc.symbol == 2 && driver_elf_reloc_type_valid(spec.machine, reloc.typ, 1) == 0) ||
            driver_elf_reloc_type_valid(spec.machine, reloc.typ, data_reference) == 0) { return 0; }
        i = i + 1;
    }
    i = 0;
    while (i < spec.data_relocs.len) {
        let reloc: DriverElfReloc = spec.data_relocs.data[i];
        if (reloc.offset < 0 || reloc.offset > spec.data.len - 8 ||
            reloc.symbol < 4 || reloc.symbol >= symbol_count ||
            driver_elf_reloc_type_valid(spec.machine, reloc.typ, 1) == 0) { return 0; }
        i = i + 1;
    }
    // A module object must carry both relocation classes.  Empty sections are
    // legal for a particular source only when the compiler has an actual
    // relocation record in the other class; the kernel-module gate requires
    // both classes to be represented before accepting an artifact.
    if (spec.text_relocs.len == 0 || spec.data_relocs.len == 0) { return 0; }
    return 1;
}

// Emit ELF64 ET_REL for x86-64 or AArch64. The section and symbol ordering is
// fixed so two independent compiler runs produce byte-identical objects.
fn write_driver_elf64(path: []u8, spec: DriverElfSpec) i32 {
    if (driver_elf_spec_valid(spec) == 0) { return 1; }

    let buf: ArrayList[u8] = make[u8](spec.text.len + spec.data.len +
        spec.modinfo.len + spec.symbols.len * 64 + 4096);

    // ELF64 header: ET_REL, no program headers, thirteen section headers.
    driver_elf_eb(&buf, 127); driver_elf_eb(&buf, 69); driver_elf_eb(&buf, 76); driver_elf_eb(&buf, 70);
    driver_elf_eb(&buf, 2); driver_elf_eb(&buf, 1); driver_elf_eb(&buf, 1); driver_elf_eb(&buf, 0);
    let ident_pad: i32 = 0; while (ident_pad < 8) { driver_elf_eb(&buf, 0); ident_pad = ident_pad + 1; }
    driver_elf_le(&buf, 1, 2);                 // ET_REL
    driver_elf_le(&buf, spec.machine, 2);
    driver_elf_le(&buf, 1, 4);
    driver_elf_le(&buf, 0, 8); driver_elf_le(&buf, 0, 8);
    let shoff_pos: i32 = buf.len; driver_elf_le(&buf, 0, 8);
    driver_elf_le(&buf, 0, 4);
    driver_elf_le(&buf, 64, 2); driver_elf_le(&buf, 0, 2); driver_elf_le(&buf, 0, 2);
    driver_elf_le(&buf, 64, 2); driver_elf_le(&buf, 13, 2); driver_elf_le(&buf, 10, 2);

    driver_elf_align(&buf, 16);
    let text_off: i32 = buf.len; driver_elf_copy(&buf, spec.text);
    let text_size: i32 = buf.len - text_off;

    driver_elf_align(&buf, 8);
    let rela_text_off: i32 = buf.len;
    let ri: i32 = 0; while (ri < spec.text_relocs.len) { driver_elf_rela(&buf, spec.text_relocs.data[ri]); ri = ri + 1; }
    let rela_text_size: i32 = buf.len - rela_text_off;

    driver_elf_align(&buf, 8);
    let data_off: i32 = buf.len; driver_elf_copy(&buf, spec.data);
    let data_size: i32 = buf.len - data_off;

    driver_elf_align(&buf, 8);
    let rela_data_off: i32 = buf.len;
    ri = 0; while (ri < spec.data_relocs.len) { driver_elf_rela(&buf, spec.data_relocs.data[ri]); ri = ri + 1; }
    let rela_data_size: i32 = buf.len - rela_data_off;

    let bss_off: i32 = buf.len;
    driver_elf_align(&buf, 1);
    let modinfo_off: i32 = buf.len; driver_elf_copy(&buf, spec.modinfo);
    let modinfo_size: i32 = buf.len - modinfo_off;

    let debug_abbrev_off: i32 = buf.len; driver_elf_copy(&buf, spec.debug_abbrev);
    let debug_abbrev_size: i32 = buf.len - debug_abbrev_off;
    let debug_info_off: i32 = buf.len; driver_elf_copy(&buf, spec.debug_info);
    let debug_info_size: i32 = buf.len - debug_info_off;
    let debug_line_off: i32 = buf.len; driver_elf_copy(&buf, spec.debug_line);
    let debug_line_size: i32 = buf.len - debug_line_off;

    let section_names: ArrayList[[]u8] = make[[]u8](13);
    push[[]u8](&section_names, ""); push[[]u8](&section_names, ".text");
    push[[]u8](&section_names, ".rela.text"); push[[]u8](&section_names, ".data");
    push[[]u8](&section_names, ".rela.data"); push[[]u8](&section_names, ".bss");
    push[[]u8](&section_names, ".modinfo"); push[[]u8](&section_names, ".debug_abbrev");
    push[[]u8](&section_names, ".debug_info"); push[[]u8](&section_names, ".debug_line");
    push[[]u8](&section_names, ".shstrtab"); push[[]u8](&section_names, ".strtab");
    push[[]u8](&section_names, ".symtab");
    let shstr_off: i32 = buf.len; let shstr_name_offs: ArrayList[i32] = make[i32](13);
    let si: i32 = 0; while (si < section_names.len) { push[i32](&shstr_name_offs, buf.len - shstr_off); driver_elf_cstr(&buf, section_names.data[si]); si = si + 1; }
    let shstr_size: i32 = buf.len - shstr_off;

    let symbol_names: ArrayList[[]u8] = make[[]u8](spec.symbols.len + spec.imports.len + 1);
    push[[]u8](&symbol_names, "");
    si = 0; while (si < spec.symbols.len) { push[[]u8](&symbol_names, spec.symbols.data[si].name); si = si + 1; }
    si = 0; while (si < spec.imports.len) { push[[]u8](&symbol_names, spec.imports.data[si]); si = si + 1; }
    let str_off: i32 = buf.len; let symbol_name_offs: ArrayList[i32] = make[i32](symbol_names.len);
    si = 0; while (si < symbol_names.len) { push[i32](&symbol_name_offs, buf.len - str_off); driver_elf_cstr(&buf, symbol_names.data[si]); si = si + 1; }
    let str_size: i32 = buf.len - str_off;

    driver_elf_align(&buf, 8);
    let sym_off: i32 = buf.len;
    driver_elf_sym(&buf, 0, 0, 0, 0, 0);       // null
    driver_elf_sym(&buf, 0, 3, 1, 0, 0);       // .text section
    driver_elf_sym(&buf, 0, 3, 3, 0, 0);       // .data section
    driver_elf_sym(&buf, 0, 3, 6, 0, 0);       // .modinfo section
    si = 0;
    while (si < spec.symbols.len) {
        let symbol: DriverElfSymbol = spec.symbols.data[si];
        driver_elf_sym(&buf, symbol_name_offs.data[si + 1],
            16 + symbol.type_, symbol.section, symbol.offset as i64, symbol.size as i64);
        si = si + 1;
    }
    si = 0;
    while (si < spec.imports.len) {
        driver_elf_sym(&buf, symbol_name_offs.data[spec.symbols.len + si + 1],
            16 + 2, 0, 0, 0);
        si = si + 1;
    }
    let sym_size: i32 = buf.len - sym_off;

    driver_elf_align(&buf, 8);
    let shoff: i32 = buf.len;
    driver_elf_shdr(&buf, 0, 0, 0, 0, 0, 0, 0, 0, 0);
    driver_elf_shdr(&buf, shstr_name_offs.data[1], 1, 6, text_off, text_size, 0, 0, 16, 0);
    driver_elf_shdr(&buf, shstr_name_offs.data[2], 4, 0, rela_text_off, rela_text_size, 12, 1, 8, 24);
    driver_elf_shdr(&buf, shstr_name_offs.data[3], 1, 3, data_off, data_size, 0, 0, 8, 0);
    driver_elf_shdr(&buf, shstr_name_offs.data[4], 4, 0, rela_data_off, rela_data_size, 12, 3, 8, 24);
    driver_elf_shdr(&buf, shstr_name_offs.data[5], 8, 3, bss_off, 0, 0, 0, 8, 0);
    driver_elf_shdr(&buf, shstr_name_offs.data[6], 1, 2, modinfo_off, modinfo_size, 0, 0, 1, 0);
    driver_elf_shdr(&buf, shstr_name_offs.data[7], 1, 0, debug_abbrev_off, debug_abbrev_size, 0, 0, 1, 0);
    driver_elf_shdr(&buf, shstr_name_offs.data[8], 1, 0, debug_info_off, debug_info_size, 0, 0, 1, 0);
    driver_elf_shdr(&buf, shstr_name_offs.data[9], 1, 0, debug_line_off, debug_line_size, 0, 0, 1, 0);
    driver_elf_shdr(&buf, shstr_name_offs.data[10], 3, 0, shstr_off, shstr_size, 0, 0, 1, 0);
    driver_elf_shdr(&buf, shstr_name_offs.data[11], 3, 0, str_off, str_size, 0, 0, 1, 0);
    driver_elf_shdr(&buf, shstr_name_offs.data[12], 2, 0, sym_off, sym_size, 11, 4, 8, 24);

    let value: i64 = shoff as i64;
    let patch_i: i32 = 0;
    while (patch_i < 8) {
        let b: i64 = value & 255;
        set[u8](&buf, shoff_pos + patch_i, b as u8);
        value = (value - b) / 256;
        patch_i = patch_i + 1;
    }
    return _zag_write_file(path, buf.data[0..buf.len]);
}

fn driver_elf_shdr32(buf: *ArrayList[u8], name: i32, typ: i32,
                     flags: i32, offset: i32, size: i32,
                     link: i32, info: i32, alignment: i32,
                     entsize: i32) void {
    driver_elf_le(buf, name, 4); driver_elf_le(buf, typ, 4);
    driver_elf_le(buf, flags, 4); driver_elf_le(buf, 0, 4);
    driver_elf_le(buf, offset, 4); driver_elf_le(buf, size, 4);
    driver_elf_le(buf, link, 4); driver_elf_le(buf, info, 4);
    driver_elf_le(buf, alignment, 4); driver_elf_le(buf, entsize, 4);
}

fn driver_elf_sym32(buf: *ArrayList[u8], name: i32, value: i32,
                    size: i32, info: i32, section: i32) void {
    driver_elf_le(buf, name, 4); driver_elf_le(buf, value, 4);
    driver_elf_le(buf, size, 4); driver_elf_eb(buf, info); driver_elf_eb(buf, 0);
    driver_elf_le(buf, section, 2);
}

fn driver_elf_rel32(buf: *ArrayList[u8], reloc: DriverElfReloc) void {
    driver_elf_le(buf, reloc.offset, 4);
    driver_elf_le(buf, reloc.symbol * 256 + reloc.typ, 4);
}

fn driver_elf_spec32_valid(text: ArrayList[u8], data: ArrayList[u8],
                            modinfo: ArrayList[u8],
                            symbols: ArrayList[DriverElfSymbol],
                            imports: ArrayList[[]u8],
                            text_relocs: ArrayList[DriverElfReloc],
                            data_relocs: ArrayList[DriverElfReloc]) i32 {
    if (text.len <= 0 || data.len < 4 || modinfo.len <= 0) { return 0; }
    let i: i32 = 0;
    while (i < symbols.len) {
        let symbol: DriverElfSymbol = symbols.data[i];
        if (symbol.name.len == 0 || symbol.defined == 0 || symbol.section != 1 ||
            symbol.offset < 0 || symbol.size < 0 || symbol.offset > text.len ||
            symbol.size > text.len - symbol.offset) { return 0; }
        let j: i32 = i + 1;
        while (j < symbols.len) {
            if (@strEq(symbol.name, symbols.data[j].name)) { return 0; }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < imports.len) {
        if (imports.data[i].len == 0) { return 0; }
        let j: i32 = 0;
        while (j < symbols.len) { if (@strEq(imports.data[i], symbols.data[j].name)) { return 0; } j = j + 1; }
        j = i + 1; while (j < imports.len) { if (@strEq(imports.data[i], imports.data[j])) { return 0; } j = j + 1; }
        i = i + 1;
    }
    let symbol_count: i32 = 4 + symbols.len + imports.len;
    i = 0;
    while (i < text_relocs.len) {
        let reloc: DriverElfReloc = text_relocs.data[i];
        if (reloc.offset < 0 || reloc.offset > text.len - 4 || reloc.symbol < 4 ||
            reloc.symbol >= symbol_count || reloc.typ != 2) { return 0; }
        i = i + 1;
    }
    i = 0;
    while (i < data_relocs.len) {
        let reloc: DriverElfReloc = data_relocs.data[i];
        if (reloc.offset < 0 || reloc.offset > data.len - 4 || reloc.symbol < 4 ||
            reloc.symbol >= symbol_count || reloc.typ != 1) { return 0; }
        i = i + 1;
    }
    if (text_relocs.len == 0 || data_relocs.len == 0) { return 0; }
    return 1;
}

// ELF32 ET_REL for i686.  The section order mirrors write_driver_elf64 so the
// module support matrix has the same metadata and relocation contract on all
// three initial architectures; only field widths and R_386_* records differ.
fn write_driver_elf32(path: []u8, text: ArrayList[u8], data: ArrayList[u8],
                      modinfo: ArrayList[u8], symbols: ArrayList[DriverElfSymbol],
                      imports: ArrayList[[]u8], text_relocs: ArrayList[DriverElfReloc],
                      data_relocs: ArrayList[DriverElfReloc],
                      debug_abbrev: ArrayList[u8], debug_info: ArrayList[u8],
                      debug_line: ArrayList[u8]) i32 {
    if (driver_elf_spec32_valid(text, data, modinfo, symbols, imports,
                                text_relocs, data_relocs) == 0) { return 1; }
    let buf: ArrayList[u8] = make[u8](text.len + data.len + modinfo.len + 4096);

    // ELF32 header: ET_REL, EM_386, thirteen section headers.
    driver_elf_eb(&buf, 127); driver_elf_eb(&buf, 69); driver_elf_eb(&buf, 76); driver_elf_eb(&buf, 70);
    driver_elf_eb(&buf, 1); driver_elf_eb(&buf, 1); driver_elf_eb(&buf, 1); driver_elf_eb(&buf, 0);
    let ident_pad: i32 = 0; while (ident_pad < 8) { driver_elf_eb(&buf, 0); ident_pad = ident_pad + 1; }
    driver_elf_le(&buf, 1, 2); driver_elf_le(&buf, 3, 2); driver_elf_le(&buf, 1, 4);
    driver_elf_le(&buf, 0, 4); driver_elf_le(&buf, 0, 4);
    let shoff_pos: i32 = buf.len; driver_elf_le(&buf, 0, 4);
    driver_elf_le(&buf, 0, 4); driver_elf_le(&buf, 52, 2);
    driver_elf_le(&buf, 0, 2); driver_elf_le(&buf, 0, 2);
    driver_elf_le(&buf, 40, 2); driver_elf_le(&buf, 13, 2); driver_elf_le(&buf, 10, 2);

    driver_elf_align(&buf, 16); let text_off: i32 = buf.len; driver_elf_copy(&buf, text);
    let text_size: i32 = buf.len - text_off;
    driver_elf_align(&buf, 4); let rel_text_off: i32 = buf.len;
    let ri: i32 = 0; while (ri < text_relocs.len) { driver_elf_rel32(&buf, text_relocs.data[ri]); ri = ri + 1; }
    let rel_text_size: i32 = buf.len - rel_text_off;
    driver_elf_align(&buf, 4); let data_off: i32 = buf.len; driver_elf_copy(&buf, data);
    let data_size: i32 = buf.len - data_off;
    driver_elf_align(&buf, 4); let rel_data_off: i32 = buf.len;
    ri = 0; while (ri < data_relocs.len) { driver_elf_rel32(&buf, data_relocs.data[ri]); ri = ri + 1; }
    let rel_data_size: i32 = buf.len - rel_data_off;
    let bss_off: i32 = buf.len;
    let modinfo_off: i32 = buf.len; driver_elf_copy(&buf, modinfo);
    let modinfo_size: i32 = buf.len - modinfo_off;
    let debug_abbrev_off: i32 = buf.len; driver_elf_copy(&buf, debug_abbrev);
    let debug_abbrev_size: i32 = buf.len - debug_abbrev_off;
    let debug_info_off: i32 = buf.len; driver_elf_copy(&buf, debug_info);
    let debug_info_size: i32 = buf.len - debug_info_off;
    let debug_line_off: i32 = buf.len; driver_elf_copy(&buf, debug_line);
    let debug_line_size: i32 = buf.len - debug_line_off;

    let section_names: ArrayList[[]u8] = make[[]u8](13);
    push[[]u8](&section_names, ""); push[[]u8](&section_names, ".text");
    push[[]u8](&section_names, ".rel.text"); push[[]u8](&section_names, ".data");
    push[[]u8](&section_names, ".rel.data"); push[[]u8](&section_names, ".bss");
    push[[]u8](&section_names, ".modinfo"); push[[]u8](&section_names, ".debug_abbrev");
    push[[]u8](&section_names, ".debug_info"); push[[]u8](&section_names, ".debug_line");
    push[[]u8](&section_names, ".shstrtab"); push[[]u8](&section_names, ".strtab");
    push[[]u8](&section_names, ".symtab");
    let shstr_off: i32 = buf.len; let shstr_name_offs: ArrayList[i32] = make[i32](13);
    let si: i32 = 0; while (si < section_names.len) { push[i32](&shstr_name_offs, buf.len - shstr_off); driver_elf_cstr(&buf, section_names.data[si]); si = si + 1; }
    let shstr_size: i32 = buf.len - shstr_off;

    let symbol_names: ArrayList[[]u8] = make[[]u8](symbols.len + imports.len + 1);
    push[[]u8](&symbol_names, ""); si = 0;
    while (si < symbols.len) { push[[]u8](&symbol_names, symbols.data[si].name); si = si + 1; }
    si = 0; while (si < imports.len) { push[[]u8](&symbol_names, imports.data[si]); si = si + 1; }
    let str_off: i32 = buf.len; let symbol_name_offs: ArrayList[i32] = make[i32](symbol_names.len);
    si = 0; while (si < symbol_names.len) { push[i32](&symbol_name_offs, buf.len - str_off); driver_elf_cstr(&buf, symbol_names.data[si]); si = si + 1; }
    let str_size: i32 = buf.len - str_off;

    driver_elf_align(&buf, 4); let sym_off: i32 = buf.len;
    driver_elf_sym32(&buf, 0, 0, 0, 0, 0);
    driver_elf_sym32(&buf, 0, 0, 0, 3, 1);
    driver_elf_sym32(&buf, 0, 0, 0, 3, 3);
    driver_elf_sym32(&buf, 0, 0, 0, 3, 6);
    si = 0;
    while (si < symbols.len) {
        let symbol: DriverElfSymbol = symbols.data[si];
        driver_elf_sym32(&buf, symbol_name_offs.data[si + 1], symbol.offset,
            symbol.size, 16 + symbol.type_, symbol.section);
        si = si + 1;
    }
    si = 0;
    while (si < imports.len) {
        driver_elf_sym32(&buf, symbol_name_offs.data[symbols.len + si + 1], 0, 0, 18, 0);
        si = si + 1;
    }
    let sym_size: i32 = buf.len - sym_off;

    driver_elf_align(&buf, 4); let shoff: i32 = buf.len;
    driver_elf_shdr32(&buf, 0, 0, 0, 0, 0, 0, 0, 0, 0);
    driver_elf_shdr32(&buf, shstr_name_offs.data[1], 1, 6, text_off, text_size, 0, 0, 16, 0);
    driver_elf_shdr32(&buf, shstr_name_offs.data[2], 9, 0, rel_text_off, rel_text_size, 12, 1, 4, 8);
    driver_elf_shdr32(&buf, shstr_name_offs.data[3], 1, 3, data_off, data_size, 0, 0, 4, 0);
    driver_elf_shdr32(&buf, shstr_name_offs.data[4], 9, 0, rel_data_off, rel_data_size, 12, 3, 4, 8);
    driver_elf_shdr32(&buf, shstr_name_offs.data[5], 8, 3, bss_off, 0, 0, 0, 4, 0);
    driver_elf_shdr32(&buf, shstr_name_offs.data[6], 1, 2, modinfo_off, modinfo_size, 0, 0, 1, 0);
    driver_elf_shdr32(&buf, shstr_name_offs.data[7], 1, 0, debug_abbrev_off, debug_abbrev_size, 0, 0, 1, 0);
    driver_elf_shdr32(&buf, shstr_name_offs.data[8], 1, 0, debug_info_off, debug_info_size, 0, 0, 1, 0);
    driver_elf_shdr32(&buf, shstr_name_offs.data[9], 1, 0, debug_line_off, debug_line_size, 0, 0, 1, 0);
    driver_elf_shdr32(&buf, shstr_name_offs.data[10], 3, 0, shstr_off, shstr_size, 0, 0, 1, 0);
    driver_elf_shdr32(&buf, shstr_name_offs.data[11], 3, 0, str_off, str_size, 0, 0, 1, 0);
    driver_elf_shdr32(&buf, shstr_name_offs.data[12], 2, 0, sym_off, sym_size, 11, 4, 4, 16);
    let value: i64 = shoff as i64; let patch_i: i32 = 0;
    while (patch_i < 4) { let b: i64 = value & 255; set[u8](&buf, shoff_pos + patch_i, b as u8); value = (value - b) / 256; patch_i = patch_i + 1; }
    return _zag_write_file(path, buf.data[0..buf.len]);
}
