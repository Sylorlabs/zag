// selfhost/native/isa.zag — the SHARED CONTRACT for Zag's native x86-64 backend.
//
// This is the single source of truth that three modules agree on:
//   • native codegen  (ncodegen.zag) PRODUCES an ArrayList[Instr]
//   • the assembler   (x86.zag)      CONSUMES it → machine-code bytes
//   • the ELF writer  (elf.zag)      wraps those bytes into a runnable file
//
// A flat, encoder-friendly instruction. `kind` selects the form; the other
// fields are interpreted per-kind (see each K_* below). Authored centrally so
// nobody invents an incompatible representation.
//
// Register field values are the x86-64 HARDWARE encoding numbers:
//   rax=0 rcx=1 rdx=2 rbx=3 rsp=4 rbp=5 rsi=6 rdi=7  r8=8 r9=9 .. r15=15
// Registers r8..r15 (>=8) need the REX.B / REX.R extension bit — the assembler
// is responsible for emitting it. The System V AMD64 calling convention used by
// codegen: integer args in rdi,rsi,rdx,rcx,r8,r9; integer return in rax;
// callee-saved rbx,rbp,r12..r15; rsp 16-byte aligned at a `call`.
//
// Memory operands are base-register + signed displacement: [base + disp].
// Codegen uses rbp as the frame base for locals (base = R_RBP()). The assembler
// MUST still correctly encode rsp/r12 bases (SIB byte) and rbp/r13 bases
// (forced disp) for completeness.
//
// LANGUAGE SUBSET NOTE (self-hosted compiler): there is NO `<<`/`>>` (the lexer
// splits them) and `|` is the capture pipe, so the assembler builds bytes with
// arithmetic — disjoint bit-fields combine with `+`, a byte is split with `/`
// and `% 256`. `&` works for masking. No `break`/`continue` (use a flag-guarded
// while). Deref a pointer field as `p.*.field`.

@import("../../std/list.zag")
@import("../vector_contract.zag")   // VW_128/VW_256/VW_512 — the width ladder

struct Instr {
    kind: i32,   // one of the K_* kinds below
    dst:  i32,   // dest register 0..15 (or base reg for STORE; sole op for push/pop/idiv)
    src:  i32,   // source register 0..15 (or base reg for LOAD/LEA)
    imm:  i64,   // immediate (mov/add/sub/cmp imm forms); condition code for SETCC
    disp: i32,   // signed displacement for LOAD/STORE/LEA memory operands
    lbl:  i32,   // label id for LABEL / CALL / JMP / Jcc; NOLBL() otherwise
}

// sentinel "no label" value (the subset dislikes bare negative literals)
fn NOLBL() i32 { return 0 - 1; }

// Shared between the codegen and the linker: the fixed virtual address where the
// read-only DATA segment (string/constant blob) is mapped. Codegen references a
// constant at byte `off` in the blob as the absolute address DATA_VBASE()+off
// (via movabs), so addresses are known at codegen time — no relocation needed.
// Far from the code segment (0x400000) so they never overlap.
fn DATA_VBASE() i64 { return 67108864; }   // 0x4000000 (keeps clear of large text)

// ── instruction kinds (with their canonical x86-64 encodings, for the asm) ────
fn K_LABEL()   i32 { return 0; }   // position marker for label `lbl`; emits 0 bytes
fn K_MOV_IMM() i32 { return 1; }   // mov dst, imm : REX.W C7 /0 id if imm fits int32,
                                   //               else REX.W B8+rd io (movabs imm64)
fn K_MOV_RR()  i32 { return 2; }   // mov  dst, src : REX.W 89 /r  (src→dst)
fn K_ADD_RR()  i32 { return 3; }   // add  dst, src : REX.W 01 /r
fn K_SUB_RR()  i32 { return 4; }   // sub  dst, src : REX.W 29 /r
fn K_IMUL_RR() i32 { return 5; }   // imul dst, src : REX.W 0F AF /r
fn K_CMP_RR()  i32 { return 6; }   // cmp  dst, src : REX.W 39 /r
fn K_PUSH()    i32 { return 7; }   // push dst      : (REX.B?) 50+rd
fn K_POP()     i32 { return 8; }   // pop  dst      : (REX.B?) 58+rd
fn K_CALL()    i32 { return 9; }   // call lbl      : E8 rel32
fn K_JMP()     i32 { return 10; }  // jmp  lbl      : E9 rel32
fn K_JE()      i32 { return 11; }  // je   lbl      : 0F 84 rel32
fn K_JNE()     i32 { return 12; }  // jne  lbl      : 0F 85 rel32
fn K_JL()      i32 { return 13; }  // jl   lbl      : 0F 8C rel32 (signed)
fn K_JLE()     i32 { return 14; }  // jle  lbl      : 0F 8E rel32 (signed)
fn K_JG()      i32 { return 15; }  // jg   lbl      : 0F 8F rel32 (signed)
fn K_JGE()     i32 { return 16; }  // jge  lbl      : 0F 8D rel32 (signed)
fn K_RET()     i32 { return 17; }  // ret           : C3
fn K_SYSCALL() i32 { return 18; }  // syscall       : 0F 05
fn K_IDIV()    i32 { return 19; }  // cqo (REX.W 99) ; idiv src (REX.W F7 /7): rax=quot rdx=rem
fn K_AND_RR()  i32 { return 20; }  // and  dst, src : REX.W 21 /r
fn K_OR_RR()   i32 { return 21; }  // or   dst, src : REX.W 09 /r
fn K_XOR_RR()  i32 { return 22; }  // xor  dst, src : REX.W 31 /r
fn K_LOAD()    i32 { return 23; }  // mov dst, [src + disp]  : REX.W 8B /r
fn K_STORE()   i32 { return 24; }  // mov [dst + disp], src  : REX.W 89 /r
fn K_LEA()     i32 { return 25; }  // lea dst, [src + disp]  : REX.W 8D /r
fn K_ADD_RI()  i32 { return 26; }  // add dst, imm32 : REX.W 81 /0 id
fn K_SUB_RI()  i32 { return 27; }  // sub dst, imm32 : REX.W 81 /5 id
fn K_CMP_RI()  i32 { return 28; }  // cmp dst, imm32 : REX.W 81 /7 id
fn K_SETCC()   i32 { return 29; }  // dst = (cc in imm) ? 1 : 0 : setcc dl/al + movzx to 64
fn K_NEG()     i32 { return 30; }  // neg dst       : REX.W F7 /3
fn K_XCHG_MEM() i32 { return 89; } // xchg [dst + disp], src : REX.W 87 /r; implicitly locked on x86
fn K_XADD_MEM() i32 { return 90; } // lock xadd [dst + disp], src : F0 REX.W 0F C1 /r
fn K_CMPXCHG_MEM() i32 { return 91; } // lock cmpxchg [dst + disp], src : F0 REX.W 0F B1 /r; expected in RAX
fn K_BSWAP()    i32 { return 92; } // bswap dst : REX.W 0F C8+rd (x86-64 baseline)
fn K_BSR()      i32 { return 93; } // bsr dst,src : REX.W 0F BD /r (undefined only for zero)
fn K_PREFETCHT0() i32 { return 94; } // prefetcht0 [base] : 0F 18 /1 (advisory hint)
// Explicit MMIO-width moves.  These are intentionally separate from the
// normal 64-bit K_LOAD/K_STORE forms so the native lowering cannot silently
// widen a device register transaction.  Loads zero-extend into the 64-bit
// register stack representation; stores use only the low 16/32 bits.
fn K_LOAD16() i32 { return 95; } // movzx dst, word [src+disp] : 66 REX.W 0F B7 /r
fn K_STORE16() i32 { return 96; } // mov word [dst+disp], src16 : 66 REX 89 /r
fn K_LOAD32() i32 { return 97; } // mov dst32, dword [src+disp] : 8B /r (zero-extends)
fn K_STORE32() i32 { return 98; } // mov dword [dst+disp], src32 : 89 /r

// ── SSE scalar floating-point (f64/f32) ──────────────────────────────────────
// xmm registers live in their OWN 0..15 space (xmm8..15 need REX.R/REX.B, just
// like r8..15). The mandatory SSE prefix (F2/F3/66) is emitted BEFORE REX, then
// 0F, then the opcode, then ModRM. The native backend shuttles a double's 64-bit
// BIT PATTERN through ordinary integer registers / CPU-stack words (so the stack
// machine is unchanged) and only moves into an xmm via MOVQ for the actual op.
fn K_FMOVQ_GX() i32 { return 31; } // movq xmm[dst], gpr[src]  : 66 REX.W 0F 6E /r (gpr→xmm bits)
fn K_FMOVQ_XG() i32 { return 32; } // movq gpr[dst], xmm[src]  : 66 REX.W 0F 7E /r (xmm→gpr bits)
fn K_FADD()     i32 { return 33; } // addsd xmm[dst], xmm[src] : F2 0F 58 /r
fn K_FSUB()     i32 { return 34; } // subsd xmm[dst], xmm[src] : F2 0F 5C /r
fn K_FMUL()     i32 { return 35; } // mulsd xmm[dst], xmm[src] : F2 0F 59 /r
fn K_FDIV()     i32 { return 36; } // divsd xmm[dst], xmm[src] : F2 0F 5E /r
fn K_FUCOMI()   i32 { return 37; } // ucomisd xmm[dst], xmm[src]: 66 0F 2E /r (sets EFLAGS)
fn K_FSI2SD()   i32 { return 38; } // cvtsi2sd xmm[dst], gpr[src]: F2 REX.W 0F 2A /r (i64→f64)
fn K_FTSD2SI()  i32 { return 39; } // cvttsd2si gpr[dst], xmm[src]: F2 REX.W 0F 2C /r (f64→i64 trunc)
fn K_FSD2SS()   i32 { return 40; } // cvtsd2ss xmm[dst], xmm[src]: F2 0F 5A /r (f64→f32)
fn K_FSS2SD()   i32 { return 41; } // cvtss2sd xmm[dst], xmm[src]: F3 0F 5A /r (f32→f64)
fn K_FXORPS()   i32 { return 42; } // xorps xmm[dst], xmm[src] : 0F 57 /r (zero an xmm with d==s)
fn K_CALL_REG() i32 { return 43; }  // call reg : FF /2 (indirect call through register)
fn K_LEA_LBL()  i32 { return 44; }  // lea dst, [rip+lbl] : REX.W 8D /r [rip+rel32]
fn K_FSQRTSD()  i32 { return 45; }  // sqrtsd xmm[dst], xmm[src] : F2 0F 51 /r
fn K_X87_LOAD() i32 { return 46; }  // fldl [src+disp]  : DD /0 mod+rm+disp  (src=base reg, mem→ST(0))
fn K_X87_STORE()i32 { return 47; }  // fstpl [dst+disp] : DD /3 mod+rm+disp  (ST(0)→mem, dst=base reg)
fn K_X87_SIN()  i32 { return 48; }  // fsin  : D9 FE
fn K_X87_COS()  i32 { return 49; }  // fcos  : D9 FF
fn K_X87_SQRT() i32 { return 50; }  // fsqrt : D9 FA
fn K_SHL_CL()   i32 { return 51; }  // shl dst, cl : REX.W D3 /4
fn K_SAR_CL()   i32 { return 52; }  // sar dst, cl : REX.W D3 /7 (arithmetic)
fn K_REP_MOVSB() i32 { return 53; } // rep movsb : F3 A4  (rdi<-dst, rsi<-src, rcx<-count)
fn K_OUTB()   i32 { return 54; }  // out dx,al   : EE       (dl<-port, al<-val)
fn K_INB()    i32 { return 55; }  // in al,dx    : EC
fn K_OUTW()   i32 { return 56; }  // out dx,ax   : 66 EF
fn K_INW()    i32 { return 57; }  // in ax,dx    : 66 ED
fn K_OUTL()   i32 { return 58; }  // out dx,eax  : EF
fn K_INL()    i32 { return 59; }  // in eax,dx   : ED
fn K_RDMSR()  i32 { return 60; }  // rdmsr       : 0F 32   (ecx<-msr -> edx:eax)
fn K_WRMSR()  i32 { return 61; }  // wrmsr       : 0F 30   (ecx<-msr, edx:eax<-val)
fn K_RDCR0()  i32 { return 62; }  // mov rax,cr0 : 0F 20 C0
fn K_WRCR0()  i32 { return 63; }  // mov cr0,rax : 0F 22 C0
fn K_RDCR2()  i32 { return 64; }  // mov rax,cr2 : 0F 20 D0
fn K_RDCR3()  i32 { return 65; }  // mov rax,cr3 : 0F 20 D8
fn K_WRCR3()  i32 { return 66; }  // mov cr3,rax : 0F 22 D8
fn K_RDCR4()  i32 { return 67; }  // mov rax,cr4 : 0F 20 E0
fn K_WRCR4()  i32 { return 68; }  // mov cr4,rax : 0F 22 E0
fn K_LGDT()   i32 { return 69; }  // lgdt [rax]  : 0F 01 10
fn K_LIDT()   i32 { return 70; }  // lidt [rax]  : 0F 01 18
fn K_LTR()    i32 { return 71; }  // ltr ax      : 0F 00 D8
fn K_INVLPG() i32 { return 72; }  // invlpg [rax]: 0F 01 38
fn K_HLT()    i32 { return 73; }  // hlt         : F4
fn K_CLI()    i32 { return 74; }  // cli         : FA
fn K_STI()    i32 { return 75; }  // sti         : FB
fn K_PAUSE()  i32 { return 76; }  // pause       : F3 90
fn K_WBINVD() i32 { return 77; }  // wbinvd      : 0F 09
fn K_SHR_CL() i32 { return 78; }  // shr dst,cl  : REX.W D3 /5
fn K_LOAD8()  i32 { return 79; }  // movzx dst, byte [src+disp] : REX.W 0F B6 /r
fn K_STORE8() i32 { return 80; }  // mov byte [dst+disp], src8 : REX 88 /r
fn K_MFENCE() i32 { return 81; }  // full acquire/release fence : 0F AE F0
fn K_CPUID()  i32 { return 82; }  // cpuid : leaf EAX, subleaf ECX -> EAX/EBX/ECX/EDX
fn K_XGETBV() i32 { return 83; }  // xgetbv : ECX index -> EDX:EAX
fn K_POPCNT() i32 { return 84; }  // popcnt dst,src : F3 REX.W 0F B8 /r (optional)
fn K_ANDN()   i32 { return 85; }  // andn dst,src1,src2 : VEX.NDS.LZ.0F38.W1 F2 /r (BMI1)
// SSE2 unaligned packed 128-bit moves.  These are deliberately limited to the
// compiler-owned memcpy runtime: the language has no user-visible vector type
// yet, but bulk copies can safely use the x86-64 SSE2 baseline.
fn K_MOVDQU_LOAD()  i32 { return 86; } // movdqu xmm[dst], [gpr src + disp] : F3 0F 6F /r
fn K_MOVDQU_STORE() i32 { return 87; } // movdqu [gpr dst + disp], xmm[src] : F3 0F 7F /r
fn K_TZCNT() i32 { return 88; } // tzcnt dst,src : F3 REX.W 0F BC /r (BMI1)
// Baseline SSE2 packed signed/unsigned 32-bit lane addition.  This is exposed
// only through the bounded @simdAddI32x4 raw-pointer intrinsic; it is not a
// general vector register ABI or an invitation to select optional SIMD ISAs.
fn K_PADDD() i32 { return 99; } // paddd xmm[dst],xmm[src] : 66 0F FE /r
fn K_PSUBD() i32 { return 101; } // psubd xmm[dst],xmm[src] : 66 0F FA /r
fn K_PAND() i32 { return 102; } // pand xmm[dst],xmm[src] : 66 0F DB /r
fn K_POR()  i32 { return 103; } // por xmm[dst],xmm[src] : 66 0F EB /r
fn K_PXOR() i32 { return 104; } // pxor xmm[dst],xmm[src] : 66 0F EF /r
// AVX2 256-bit integer vector foundation. These instructions use YMM registers
// with VEX encoding. They are kept separate from SSE2 so runtime dispatch can
// choose a wider path without changing the baseline x86-64 output.
//
// WIDTH-PARAMETRIC: these seven kinds now carry the vector width class in
// `Instr.imm` bits 0-1 (see the width ladder below) and the encoder picks
// VEX.128 / VEX.256 / EVEX.512 from it.  The `i_v*` constructors below default
// the width class to VW_256(), so the pre-existing two-argument
// `i_vpaddd(dst, src)` call sites keep emitting exactly the 256-bit AVX2 form
// they emitted before.  `i_v*_w(...)` takes the width explicitly.
fn K_VMOVDQU_LOAD() i32 { return 105; } // vmovdqu vec, [base + disp] : F3 0F 6F /r
fn K_VMOVDQU_STORE() i32 { return 106; } // vmovdqu [base + disp], vec : F3 0F 7F /r
                                       // (dst = the vector register, src = the base GPR,
fn K_VPADDD() i32 { return 107; } // vpaddd vec,vec,vec : 66 0F FE /r
fn K_VPSUBD() i32 { return 108; } // vpsubd vec,vec,vec : 66 0F FA /r
fn K_VPAND() i32 { return 109; } // vpand  vec,vec,vec : 66 0F DB /r
fn K_VPOR() i32 { return 110; } // vpor   vec,vec,vec : 66 0F EB /r
fn K_VPXOR() i32 { return 111; } // vpxor  vec,vec,vec : 66 0F EF /r
// Object-only direct external call. `lbl` is a compiler-local import index;
// the x86 encoder emits E8 + zero rel32 and records its immediate location for
// an ELF R_X86_64_PLT32 relocation. It is never valid in an executable blob.
fn K_CALL_EXT() i32 { return 100; }

// ══════════════════════════════════════════════════════════════════════════════
// WIDTH-PARAMETRIC VECTOR OPS (VEX.128 / VEX.256 / EVEX.512)
// ══════════════════════════════════════════════════════════════════════════════
//
// WHY THE WIDTH CLASS LIVES IN `Instr.imm`
// ─────────────────────────────────────────
// A vector op is a LOGICAL op (`vector.add`) that a chosen target width must
// execute.  x86-64 spells the same logical op three ways — VEX.128, VEX.256
// and EVEX.512 — and the ONLY thing that differs between the three is the
// vector-length field (VEX `L`, EVEX `L'L`).  So the width is a *property of the
// machine instruction*, not of the operation, and the machine instruction needs
// exactly one small integer to say which of the three it is.  `Instr` has six
// fields and every one of them is already spoken for by the legacy scalar and
// SSE dialects:
//
//   dst  src      : register operands (an index operand fits in lbl)
//   disp          : memory displacement for LOAD/STORE/LEA
//   lbl           : label id for branches
//   imm           : immediate  (and the condition code for SETCC)
//
// `imm` is an i64 that the vector kinds never use for anything else, and it is
// already 0 for every kind that predates this scheme.  Making the width class
// `imm` bits 0-1 is therefore strictly compatible: a kind that used to mean
// "128-bit, hard-wired" keeps meaning 128-bit, and a kind that used to mean
// "256-bit, hard-wired" gets an explicit 1 from its constructor (see the
// `i_v*` constructors below, which keep `i_vpaddd(d, s)` = 256-bit).
//
// The width class IS the EVEX `L'L` field and the VEX `L` field:
//
//   imm bits 0-1   width class        bytes   VEX.L    EVEX L'L
//   -----------   ---------------    -----   -----    ---------
//        0         VW_128()             16      0        00
//        1         VW_256()             32      1        01
//        2         VW_512()             64      -        10
//
// `x86vec_wclass()` is the only place a width class is read out of `imm` and
// `x86vec_pack_imm()` the only place one is written, so a target backend (or a
// future 128-bit NEON path) can share the same `Instr` spelling.
//
// FIELD LAYOUT FOR THE VECTOR KINDS
// ──────────────────────────────────
// 3-operand (VEX.NDS / EVEX.NDS) packed ops — the non-destructive form the
// vectorizer wants, so the lowering never has to copy a live value:
//     dst = result register          src = src1 (VEX.vvvv / EVEX.vvvv)
//     lbl = src2 (ModRM.rm)          imm = width class
// `lbl` carries a register number here, not a label id.  That is safe because
// a vector op is never also a branch target, and it is the only field left
// after dst/src/imm/disp.
//
// SCALED-INDEX MEMORY FORMS (K_VMOVDQU_LOAD_IDX / K_VMOVDQU_STORE_IDX)
// ─────────────────────────────────────────────────────────────────────
// The auto-vectorizer needs `dst[i]` addressing without a separate scalar
// multiply, i.e. a real SIB form `[base + index*scale + disp32]`.  `imm` is
// already two fields wide, so scale is packed ABOVE the width class rather than
// stealing `disp` (which must stay the displacement):
//
//     imm bits 0-1  : width class (VW_128/VW_256/VW_512)
//     imm bits 2-3  : SIB scale exponent, 0/1/2/3 == byte scale 1/2/4/8
//     disp         : signed 32-bit displacement
//
// and the registers:
//     LOAD   dst = vector result          src = base GPR      lbl = index GPR
//     STORE  dst = vector SOURCE register src = base GPR      lbl = index GPR
//
// `scale` is therefore the *element stride of the logical vector type*
// (i8/i16/i32/i64/f32/f64 -> 1/2/4/8), decided by the lowering from the ZIR
// element type, and `lbl` is a hardware GPR number 0..15.  For STORE the
// vector register is in `dst` (not `src`) so that BOTH memory forms use the
// identical `[base=lbl? no: src] + [index=lbl]` spelling and the encoder needs
// only one SIB routine.  Use `x86vec_pack_imm(w, scale_log)` to build `imm` and
// `x86vec_wclass(imm)` / `x86vec_scale_log(imm)` to take it apart.
//
// LANE-INDEXED AND PREDICATE FORMS
// ─────────────────────────────────
//   K_VEXTRACT* : dst = GPR, src = vector, lbl = lane index,
//                 disp = scratch vector register (ONLY consulted when the lane
//                        lives in 128-bit chunk != 0; pass a negative value to
//                        be rejected).  The chunk select is a second
//                        instruction because no x86 instruction extracts lane
//                        5 of a ymm in one go.
//   K_VINSERT*  : dst = vector result, src = the vector read, lbl = the GPR
//                 scalar, disp = the lane index.  No scratch is needed: the
//                 result may alias the source.
//   K_VSHUF32   : dst = result (also the implicit src1 of the 2-operand
//                 VPSHUFD form), src = the vector read, imm bits 8-15 = imm8.
//   K_VCMPF     : imm bits 8-15 = the VCMPPS/PD imm8 predicate.
//   K_VCMPIK    : imm bits 8-15 = the VPCMP imm8 predicate, disp = 0 for
//                 signed/float (0F3A 1F) or 1 for unsigned (0F3A 1E).
//   K_VPCMPEQI / K_VPCMPGTI / K_VPCMPGTU : disp = element width in bytes
//                 (4 = dword lanes, 8 = qword lanes).
//
// REGISTER CLASS OF A COMPARISON RESULT
// ──────────────────────────────────────
// x86-64 has two kinds of lane mask and they are NOT interchangeable:
//   • a VECTOR mask — one all-ones/all-zeros element per lane, usable by AND /
//     XOR and therefore by K_VSELECT.  VEX.128/VEX.256 PCMPEQx / PCMPGTx /
//     VCMPPSx produce one.  The EVEX forms of those opcodes at 512 bits write
//     a k register instead, so K_VPCMPEQI / K_VPCMPGTI / K_VCMPF are VEX-only
//     and REJECT width 2.
//   • a K-REGISTER mask — k0..k7, one bit per lane.  Every EVEX compare writes
//     one, and there is NO single instruction that widens a k mask into a lane
//     mask, so a k mask must stay a k mask.  K_VPCMPNEI / K_VPCMPGTU /
//     K_VCMPIK therefore put the k register NUMBER in `dst` and are EVEX-only,
//     and K_VSELECTK consumes a k mask where K_VSELECT consumes a vector mask.
//
// ── integer elementwise (3-operand NDS) ───────────────────────────────────────
fn K_VPADDQ()  i32 { return 112; } // vpaddq  vec,vec,vec  : 66 0F.W1 D4
fn K_VPSUBQ()  i32 { return 113; } // vpsubq  vec,vec,vec  : 66 0F.W1 FB
fn K_VPMULLD() i32 { return 114; } // vpmulld vec,vec,vec  : 66 0F38.W0 40
fn K_VPMULLQ() i32 { return 115; } // vpmullq vec,vec,vec  : 66 0F38.W1 40  (EVEX.512 only: AVX512DQ)
fn K_VPSLLD()  i32 { return 116; } // vpslld  vec,vec,xmm/m128 : 66 0F.W0 F2  (count operand is 128-bit)
fn K_VPSLLQ()  i32 { return 117; } // vpsllq  vec,vec,xmm/m128 : 66 0F.W1 F3
fn K_VPSRLD()  i32 { return 118; } // vpsrld  vec,vec,xmm/m128 : 66 0F.W0 D2
fn K_VPSRLQ()  i32 { return 119; } // vpsrlq  vec,vec,xmm/m128 : 66 0F.W1 D3
// ── integer compare ───────────────────────────────────────────────────────────
fn K_VPCMPEQI() i32 { return 120; } // disp=4: 66 0F.W0 76 / disp=8: 66 0F38.W1 29  [VEX, vector mask]
fn K_VPCMPGTI() i32 { return 121; } // disp=4: 66 0F.W0 66 / disp=8: 66 0F38.W1 37  [VEX, vector mask]
fn K_VPCMPNEI() i32 { return 122; } // 66 0F3A.W0/1 1F /r ib, imm8=4 (NE)      [EVEX, k mask]
fn K_VPCMPGTU() i32 { return 123; } // 66 0F3A.W0/1 1E /r ib, imm8=7 (GT)      [EVEX, k mask]
fn K_VCMPIK()   i32 { return 124; } // 66 0F3A.W0/1 {1E unsigned|1F signed} /r ib,
                                   // pred in imm bits 8-15, elem bytes in disp, dst = k reg [EVEX, k mask]
// ── float elementwise (3-operand NDS) ────────────────────────────────────────
fn K_VADDPS()  i32 { return 125; } // vaddps  vec,vec,vec : 0F.W0 58
fn K_VADDPD()  i32 { return 126; } // vaddpd  vec,vec,vec : 66 0F.W1 58
fn K_VSUBPS()  i32 { return 127; } // vsubps  vec,vec,vec : 0F.W0 5C
fn K_VSUBPD()  i32 { return 128; } // vsubpd  vec,vec,vec : 66 0F.W1 5C
fn K_VMULPS()  i32 { return 129; } // vmulps  vec,vec,vec : 0F.W0 59
fn K_VMULPD()  i32 { return 130; } // vmulpd  vec,vec,vec : 66 0F.W1 59
fn K_VDIVPS()  i32 { return 131; } // vdivps  vec,vec,vec : 0F.W0 5E
fn K_VDIVPD()  i32 { return 132; } // vdivpd  vec,vec,vec : 66 0F.W1 5E
fn K_VSQRTPS() i32 { return 133; } // vsqrtps vec,vec    : 0F.W0 51  (2-operand: dst=vvvv, src=rm)
fn K_VSQRTPD() i32 { return 134; } // vsqrtpd vec,vec    : 66 0F.W1 51
fn K_VANDPS()  i32 { return 135; } // vandps  vec,vec,vec : 0F.W0 54
fn K_VANDPD()  i32 { return 136; } // vandpd  vec,vec,vec : 66 0F.W1 54
fn K_VANDNPS() i32 { return 137; } // vandnps vec,vec,vec : 0F.W0 55
fn K_VANDNPD() i32 { return 138; } // vandnps vec,vec,vec : 66 0F.W1 55
fn K_VORPS()   i32 { return 139; } // vorps   vec,vec,vec : 0F.W0 56
fn K_VORPD()   i32 { return 140; } // vorpd   vec,vec,vec : 66 0F.W1 56
fn K_VXORPS()  i32 { return 141; } // vxorps  vec,vec,vec : 0F.W0 57
fn K_VXORPD()  i32 { return 142; } // vxorpd  vec,vec,vec : 66 0F.W1 57
// ── float compare (VEX, vector mask; pred in imm bits 8-15) ───────────────────
fn K_VCMPF()   i32 { return 143; } // disp=4: 0F.W0 C2 /r ib / disp=8: 66 0F.W0 C2 /r ib
// ── lane movement ─────────────────────────────────────────────────────────────
fn K_VSPLAT32()    i32 { return 144; } // GPR -> all dword lanes: vpbroadcastd 66 0F38.W0 7C (GPR form, EVEX.512)
fn K_VSPLAT64()    i32 { return 145; } // GPR -> all qword lanes: vpbroadcastq 66 0F38.W1 7C (GPR form, EVEX.512)
fn K_VBROADCAST32() i32 { return 146; } // m32 -> all dword lanes : vbroadcastss 66 0F38.W0 18 /r
fn K_VBROADCAST64() i32 { return 147; } // m64 -> all qword lanes : vbroadcastsd 66 0F38.W0 19 /r
fn K_VEXTRACT32()  i32 { return 148; } // vec -> GPR dword : vpextrd 66 0F3A.W0 16 /r ib
fn K_VEXTRACT64()  i32 { return 149; } // vec -> GPR qword  : vpextrq 66 0F3A.W1 16 /r ib
fn K_VINSERT32()   i32 { return 150; } // vec, GPR, lane -> vec : vpinsrd 66 0F3A.W0 22 /r ib
fn K_VINSERT64()   i32 { return 151; } // vec, GPR, lane -> vec : vpinsrq 66 0F3A.W1 22 /r ib
fn K_VSHUF32()     i32 { return 152; } // vpshufd 66 0F.W0 70 /r ib (per-128-bit-lane, unary)
fn K_VSHUFB()      i32 { return 153; } // vpshufb 66 0F38.W0 00 /r (binary; src = control vector)
fn K_VZERO()       i32 { return 154; } // vpxor  vec,vec,vec : 66 0F.W0 EF /r
// ── select ────────────────────────────────────────────────────────────────────
fn K_VSELECT()  i32 { return 155; } // vector mask, 3-instruction expansion (see x86.zag)
fn K_VSELECTK() i32 { return 156; } // k mask, single masked vpxord 66 0F.W0 EF /r {k}, EVEX only
// ── scaled-index memory ───────────────────────────────────────────────────────
fn K_VMOVDQU_LOAD_IDX()  i32 { return 157; } // vec <- [base + index*scale + disp] : F3 0F 6F /r
fn K_VMOVDQU_STORE_IDX() i32 { return 158; } // [base + index*scale + disp] <- vec : F3 0F 7F /r
fn K_DIV()        i32 { return 159; } // xor edx,edx (31 D2) ; div src (REX.W F7 /6): rax=quot rdx=rem

// ── the width ladder accessors (the ONLY place imm is split) ─────────────────
fn x86vec_wclass(imm: i64) i32 { return (imm % 4) as i32; }
fn x86vec_scale_log(imm: i64) i32 { return ((imm / 4) % 4) as i32; }
fn x86vec_pack_imm(w: i32, scale_log: i32) i64 { return (w + scale_log * 4) as i64; }
// The imm8 sub-field of the shuffle / compare kinds (imm bits 8-15).
fn x86vec_imm8(imm: i64) i32 { return ((imm / 256) % 256) as i32; }
fn x86vec_pack_imm8(w: i32, imm8: i32) i64 { return (w + imm8 * 256) as i64; }
// Byte scale (1/2/4/8) for a SIB form, as a shift-free exponent.  Returns 0 when
// `bytes` is not one of the four encodable strides, so the caller can reject.
fn x86vec_scale_log_of(bytes: i32) i32 {
    if (bytes == 1) { return 0; }
    if (bytes == 2) { return 1; }
    if (bytes == 4) { return 2; }
    if (bytes == 8) { return 3; }
    return 0 - 1;
}
fn x86vec_wclass_valid(w: i32) i32 {
    if (w == VW_128()) { return 1; }
    if (w == VW_256()) { return 1; }
    if (w == VW_512()) { return 1; }
    return 0;
}

// condition codes for K_SETCC (imm field). 0..5 are SIGNED (integer compares);
// 6..9 are UNSIGNED (above/below) and are what float ucomisd compares need
// (ucomisd sets CF/ZF/PF as for an unsigned compare).
fn CC_E()  i32 { return 0; }
fn CC_NE() i32 { return 1; }
fn CC_L()  i32 { return 2; }
fn CC_LE() i32 { return 3; }
fn CC_G()  i32 { return 4; }
fn CC_GE() i32 { return 5; }
fn CC_B()  i32 { return 6; }   // below          (CF=1)            — float <
fn CC_BE() i32 { return 7; }   // below-or-equal (CF=1 or ZF=1)    — float <=
fn CC_A()  i32 { return 8; }   // above          (CF=0 and ZF=0)   — float >
fn CC_AE() i32 { return 9; }   // above-or-equal (CF=0)            — float >=

// ── named registers (System V arg/return regs) ───────────────────────────────
fn R_RAX() i32 { return 0; }
fn R_RCX() i32 { return 1; }
fn R_RDX() i32 { return 2; }
fn R_RBX() i32 { return 3; }
fn R_RSP() i32 { return 4; }
fn R_RBP() i32 { return 5; }
fn R_RSI() i32 { return 6; }
fn R_RDI() i32 { return 7; }
fn R_R8()  i32 { return 8; }
fn R_R9()  i32 { return 9; }
fn R_R10() i32 { return 10; }
fn R_R11() i32 { return 11; }
// Reserved compiler async-context register. Ordinary generated functions never
// allocate r12, so a Script async worker and its callees inherit the task handle
// without changing the source ABI. `_start` initializes it to null.
fn R_R12() i32 { return 12; }

// xmm scratch registers used by the float lowering (their own 0..15 space).
fn R_XMM0() i32 { return 0; }
fn R_XMM1() i32 { return 1; }
fn R_XMM2() i32 { return 2; }
fn R_XMM3() i32 { return 3; }

// YMM register namespace. AVX/AVX2 uses the same architectural register
// numbering as XMM, but the backend keeps a distinct namespace so vector
// allocation cannot accidentally mix scalar floating point temporaries with
// 256-bit integer vector temporaries.
// The top vector register is withheld from allocation and reserved as the
// cross-lane extraction scratch: reading lane N of a vector wider than 128 bits
// must park the high half somewhere, and that somewhere cannot be a register
// holding a live value.  regalloc's vector allocator honours this.
fn R_VSCRATCH() i32 { return 15; }

fn R_YMM0() i32 { return 0; }
fn R_YMM1() i32 { return 1; }
fn R_YMM2() i32 { return 2; }
fn R_YMM3() i32 { return 3; }
fn R_YMM4() i32 { return 4; }
fn R_YMM5() i32 { return 5; }
fn R_YMM6() i32 { return 6; }
fn R_YMM7() i32 { return 7; }
fn R_YMM8() i32 { return 8; }
fn R_YMM9() i32 { return 9; }
fn R_YMM10() i32 { return 10; }
fn R_YMM11() i32 { return 11; }
fn R_YMM12() i32 { return 12; }
fn R_YMM13() i32 { return 13; }
fn R_YMM14() i32 { return 14; }
fn R_YMM15() i32 { return 15; }

// ZMM register namespace (AVX-512, 512-bit / 64 bytes).
//
// Architecturally xmmN/ymmN/zmmN are the SAME sixteen registers and every one
// of their encoding fields (ModRM.reg, VEX.vvvv, ModRM.rm, SIB.base) holds the
// same 0..15 number.  The backend nevertheless keeps FOUR namespaces (XMM,
// YMM, ZMM) whose accessors all return the same 0..15 values, for the same
// reason the YMM namespace already exists above: a 128-bit temporary that is
// live across a 256- or 512-bit value must never be mistaken for one, and
// register-class checks in the lowering must be able to say "this is a 128-bit
// temp" without consulting the width of the instruction that produced it.  The
// namespaces are enforced by CONVENTION plus the width class in `Instr.imm`;
// they are not different hardware.
fn R_ZMM0() i32 { return 0; }
fn R_ZMM1() i32 { return 1; }
fn R_ZMM2() i32 { return 2; }
fn R_ZMM3() i32 { return 3; }
fn R_ZMM4() i32 { return 4; }
fn R_ZMM5() i32 { return 5; }
fn R_ZMM6() i32 { return 6; }
fn R_ZMM7() i32 { return 7; }
fn R_ZMM8() i32 { return 8; }
fn R_ZMM9() i32 { return 9; }
fn R_ZMM10() i32 { return 10; }
fn R_ZMM11() i32 { return 11; }
fn R_ZMM12() i32 { return 12; }
fn R_ZMM13() i32 { return 13; }
fn R_ZMM14() i32 { return 14; }
fn R_ZMM15() i32 { return 15; }

// ── virtual vector registers ──────────────────────────────────────────────────
// The machine layer needs a virtual register class for vectors exactly as it
// has one for GPRs: between the ZIR vector value and the physical xmm/ymm/zmm
// there must be a numbered class that liveness analysis, interference graphs
// and the eventual spill/reload path can talk about.  A virtual vector
// register lives at R_VBASE() + i, which is disjoint from every physical class.
//
// INVARIANT: **no physical GPR / XMM / YMM / ZMM number is ever >= 256**, so a
// register field taken from `Instr.dst` / `.src` / `.lbl` is unambiguously
// scalar (0..15), vector (0..15, class decided by the kind + width) or
// virtual vector (>= 256).  R_IS_VREG() is therefore a total, exact test and
// the encoder can never be handed a virtual number to put in a ModRM field.
fn R_VBASE() i32 { return 256; }
fn R_VREG(i: i32) i32 { return 256 + i; }
fn R_IS_VREG(r: i32) i32 { return ((r >= 256) && (r < 512)) as i32; }
fn R_VREG_IDX(r: i32) i32 {
    if (R_IS_VREG(r) == 0) { return 0 - 1; }
    return r - R_VBASE();
}
fn R_VREG_MAX() i32 { return 256; }   // virtual vector registers addressable
// Is `r` a physical (machine-encodable) register number?  Virtual vector
// registers have no encoding, so a target encoder must reject them.
fn R_IS_PHYS(r: i32) i32 { return ((r >= 0) && (r < R_VBASE())) as i32; }
// The mask-register namespace used by the EVEX compare / masked-select kinds.
// k0..k7 are encoded in a 3-bit ModRM.reg field and never extended, so their
// numbers are the plain 0..7 of that field — deliberately NOT >= 256 and
// deliberately distinct from the vector namespaces above.
fn R_K0() i32 { return 0; }
fn R_K1() i32 { return 1; }
fn R_K2() i32 { return 2; }
fn R_K3() i32 { return 3; }
fn R_K4() i32 { return 4; }
fn R_K5() i32 { return 5; }
fn R_K6() i32 { return 6; }
fn R_K7() i32 { return 7; }
fn R_KMASK_MAX() i32 { return 8; }

// System V integer argument register for argument index 0..5 (else returns -1).
fn arg_reg(i: i32) i32 {
    if (i == 0) { return 7; }   // rdi
    if (i == 1) { return 6; }   // rsi
    if (i == 2) { return 2; }   // rdx
    if (i == 3) { return 1; }   // rcx
    if (i == 4) { return 8; }   // r8
    if (i == 5) { return 9; }   // r9
    return 0 - 1;
}

// ── constructors (codegen calls these; the assembler matches on .kind) ───────
fn ins6(kind: i32, dst: i32, src: i32, imm: i64, disp: i32, lbl: i32) Instr {
    return Instr{ .kind = kind, .dst = dst, .src = src, .imm = imm, .disp = disp, .lbl = lbl };
}
fn i_label(id: i32)             Instr { return ins6(0,  0,   0,   0, 0, id); }
fn i_mov_imm(dst: i32, v: i64)  Instr { return ins6(1,  dst, 0,   v, 0, 0 - 1); }
fn i_mov_rr(dst: i32, src: i32) Instr { return ins6(2,  dst, src, 0, 0, 0 - 1); }
fn i_add(dst: i32, src: i32)    Instr { return ins6(3,  dst, src, 0, 0, 0 - 1); }
fn i_sub(dst: i32, src: i32)    Instr { return ins6(4,  dst, src, 0, 0, 0 - 1); }
fn i_imul(dst: i32, src: i32)   Instr { return ins6(5,  dst, src, 0, 0, 0 - 1); }
fn i_cmp(dst: i32, src: i32)    Instr { return ins6(6,  dst, src, 0, 0, 0 - 1); }
fn i_push(r: i32)               Instr { return ins6(7,  r,   0,   0, 0, 0 - 1); }
fn i_pop(r: i32)                Instr { return ins6(8,  r,   0,   0, 0, 0 - 1); }
fn i_call(id: i32)              Instr { return ins6(9,  0,   0,   0, 0, id); }
fn i_call_ext(id: i32)          Instr { return ins6(100,0,   0,   0, 0, id); }
fn i_jmp(id: i32)               Instr { return ins6(10, 0,   0,   0, 0, id); }
fn i_je(id: i32)                Instr { return ins6(11, 0,   0,   0, 0, id); }
fn i_jne(id: i32)               Instr { return ins6(12, 0,   0,   0, 0, id); }
fn i_jl(id: i32)                Instr { return ins6(13, 0,   0,   0, 0, id); }
fn i_jle(id: i32)               Instr { return ins6(14, 0,   0,   0, 0, id); }
fn i_jg(id: i32)                Instr { return ins6(15, 0,   0,   0, 0, id); }
fn i_jge(id: i32)               Instr { return ins6(16, 0,   0,   0, 0, id); }
fn i_ret()                      Instr { return ins6(17, 0,   0,   0, 0, 0 - 1); }
fn i_syscall()                  Instr { return ins6(18, 0,   0,   0, 0, 0 - 1); }
fn i_idiv(src: i32)             Instr { return ins6(19, 0,   src, 0, 0, 0 - 1); }
fn i_div(src: i32)              Instr { return ins6(159, 0,  src, 0, 0, 0 - 1); }   // xor edx,edx; div src
fn i_and(dst: i32, src: i32)    Instr { return ins6(20, dst, src, 0, 0, 0 - 1); }
fn i_or(dst: i32, src: i32)     Instr { return ins6(21, dst, src, 0, 0, 0 - 1); }
fn i_xor(dst: i32, src: i32)    Instr { return ins6(22, dst, src, 0, 0, 0 - 1); }
fn i_load(dst: i32, base: i32, disp: i32)  Instr { return ins6(23, dst,  base, 0, disp, 0 - 1); }
fn i_store(base: i32, disp: i32, src: i32) Instr { return ins6(24, base, src,  0, disp, 0 - 1); }
fn i_lea(dst: i32, base: i32, disp: i32)   Instr { return ins6(25, dst,  base, 0, disp, 0 - 1); }
fn i_load8(dst: i32, base: i32, disp: i32) Instr { return ins6(79, dst, base, 0, disp, 0 - 1); }
fn i_store8(base: i32, disp: i32, src: i32) Instr { return ins6(80, base, src, 0, disp, 0 - 1); }
fn i_mfence() Instr { return ins6(81, 0, 0, 0, 0, 0 - 1); }
fn i_cpuid() Instr { return ins6(82, 0, 0, 0, 0, 0 - 1); }
fn i_xgetbv() Instr { return ins6(83, 0, 0, 0, 0, 0 - 1); }
fn i_popcnt(dst:i32,src:i32)Instr{return ins6(84,dst,src,0,0,0-1);}
fn i_andn(dst:i32,src1:i32,src2:i32)Instr{return ins6(85,dst,src1,src2,0,0-1);}
fn i_movdqu_load(xmm:i32,base:i32,disp:i32)Instr{return ins6(86,xmm,base,0,disp,0-1);}
fn i_movdqu_store(base:i32,disp:i32,xmm:i32)Instr{return ins6(87,base,xmm,0,disp,0-1);}
fn i_vmovdqu_load(ymm:i32,base:i32,disp:i32)Instr{return ins6(105,ymm,base,VW_256() as i64,disp,0-1);}
fn i_vmovdqu_store(base:i32,disp:i32,ymm:i32)Instr{return ins6(106,ymm,base,VW_256() as i64,disp,0-1);}
fn i_vpaddd(dst:i32,src:i32)Instr{return ins6(107,dst,src,VW_256() as i64,0,0-1);}
fn i_vpsubd(dst:i32,src:i32)Instr{return ins6(108,dst,src,VW_256() as i64,0,0-1);}
fn i_vpand(dst:i32,src:i32)Instr{return ins6(109,dst,src,VW_256() as i64,0,0-1);}
fn i_vpor(dst:i32,src:i32)Instr{return ins6(110,dst,src,VW_256() as i64,0,0-1);}
fn i_vpxor(dst:i32,src:i32)Instr{return ins6(111,dst,src,VW_256() as i64,0,0-1);}
// Width-explicit forms of the same seven kinds.  The two-argument forms above
// stay at VW_256() so the pre-existing AVX2 call sites are unchanged.
fn i_vmovdqu_load_w(vec:i32,base:i32,disp:i32,w:i32)Instr{return ins6(105,vec,base,w as i64,disp,0-1);}
fn i_vmovdqu_store_w(base:i32,disp:i32,vec:i32,w:i32)Instr{return ins6(106,vec,base,w as i64,disp,0-1);}
fn i_vpaddd_w(dst:i32,src1:i32,src2:i32,w:i32)Instr{return ins6(107,dst,src1,w as i64,0,src2);}
fn i_vpsubd_w(dst:i32,src1:i32,src2:i32,w:i32)Instr{return ins6(108,dst,src1,w as i64,0,src2);}
fn i_vpand_w(dst:i32,src1:i32,src2:i32,w:i32)Instr{return ins6(109,dst,src1,w as i64,0,src2);}
fn i_vpor_w(dst:i32,src1:i32,src2:i32,w:i32)Instr{return ins6(110,dst,src1,w as i64,0,src2);}
fn i_vpxor_w(dst:i32,src1:i32,src2:i32,w:i32)Instr{return ins6(111,dst,src1,w as i64,0,src2);}
// 2-operand forms: `dst` is both the destination and src1, `lbl` is src2.
fn i_vpaddd2(dst:i32,src2:i32,w:i32)Instr{return ins6(107,dst,dst,w as i64,0,src2);}
fn i_vpxor2(dst:i32,src2:i32,w:i32)Instr{return ins6(111,dst,dst,w as i64,0,src2);}
fn i_vpand2(dst:i32,src2:i32,w:i32)Instr{return ins6(109,dst,dst,w as i64,0,src2);}
fn i_tzcnt(dst:i32,src:i32)Instr{return ins6(88,dst,src,0,0,0-1);}
fn i_paddd(dst:i32,src:i32)Instr{return ins6(99,dst,src,0,0,0-1);}
fn i_psubd(dst:i32,src:i32)Instr{return ins6(101,dst,src,0,0,0-1);}
fn i_pand(dst:i32,src:i32)Instr{return ins6(102,dst,src,0,0,0-1);}
fn i_por(dst:i32,src:i32)Instr{return ins6(103,dst,src,0,0,0-1);}
fn i_pxor(dst:i32,src:i32)Instr{return ins6(104,dst,src,0,0,0-1);}
fn i_xchg_mem(base:i32,value:i32)Instr{return ins6(89,base,value,0,0,0-1);}
fn i_xadd_mem(base:i32,value:i32)Instr{return ins6(90,base,value,0,0,0-1);}
fn i_cmpxchg_mem(base:i32,value:i32)Instr{return ins6(91,base,value,0,0,0-1);}
fn i_bswap(dst:i32)Instr{return ins6(92,dst,0,0,0,0-1);}
fn i_bsr(dst:i32,src:i32)Instr{return ins6(93,dst,src,0,0,0-1);}
fn i_prefetcht0(base:i32)Instr{return ins6(94,base,0,0,0,0-1);}
fn i_load16(dst: i32, base: i32, disp: i32) Instr { return ins6(95, dst, base, 0, disp, 0 - 1); }
fn i_store16(base: i32, disp: i32, src: i32) Instr { return ins6(96, base, src, 0, disp, 0 - 1); }
fn i_load32(dst: i32, base: i32, disp: i32) Instr { return ins6(97, dst, base, 0, disp, 0 - 1); }
fn i_store32(base: i32, disp: i32, src: i32) Instr { return ins6(98, base, src, 0, disp, 0 - 1); }
fn i_add_imm(dst: i32, v: i64)  Instr { return ins6(26, dst, 0,   v, 0, 0 - 1); }
fn i_sub_imm(dst: i32, v: i64)  Instr { return ins6(27, dst, 0,   v, 0, 0 - 1); }
fn i_cmp_imm(dst: i32, v: i64)  Instr { return ins6(28, dst, 0,   v, 0, 0 - 1); }
fn i_setcc(dst: i32, cc: i32)   Instr { return ins6(29, dst, 0,   cc as i64, 0, 0 - 1); }
fn i_neg(dst: i32)              Instr { return ins6(30, dst, 0,   0, 0, 0 - 1); }

// ── SSE constructors (dst/src are xmm OR gpr numbers per the K_* contract) ────
fn i_fmovq_gx(xmm: i32, gpr: i32) Instr { return ins6(31, xmm, gpr, 0, 0, 0 - 1); }  // xmm←gpr bits
fn i_fmovq_xg(gpr: i32, xmm: i32) Instr { return ins6(32, gpr, xmm, 0, 0, 0 - 1); }  // gpr←xmm bits
fn i_fadd(d: i32, s: i32)         Instr { return ins6(33, d,   s,   0, 0, 0 - 1); }
fn i_fsub(d: i32, s: i32)         Instr { return ins6(34, d,   s,   0, 0, 0 - 1); }
fn i_fmul(d: i32, s: i32)         Instr { return ins6(35, d,   s,   0, 0, 0 - 1); }
fn i_fdiv(d: i32, s: i32)         Instr { return ins6(36, d,   s,   0, 0, 0 - 1); }
fn i_fucomi(d: i32, s: i32)       Instr { return ins6(37, d,   s,   0, 0, 0 - 1); }
fn i_fsi2sd(xmm: i32, gpr: i32)   Instr { return ins6(38, xmm, gpr, 0, 0, 0 - 1); }  // xmm←(double)gpr
fn i_ftsd2si(gpr: i32, xmm: i32)  Instr { return ins6(39, gpr, xmm, 0, 0, 0 - 1); }  // gpr←(i64)xmm trunc
fn i_fsd2ss(d: i32, s: i32)       Instr { return ins6(40, d,   s,   0, 0, 0 - 1); }
fn i_fss2sd(d: i32, s: i32)       Instr { return ins6(41, d,   s,   0, 0, 0 - 1); }
fn i_fxorps(d: i32, s: i32)       Instr { return ins6(42, d,   s,   0, 0, 0 - 1); }
fn i_call_reg(r: i32) Instr { return ins6(43, r, 0, 0, 0, 0 - 1); }
fn i_lea_lbl(dst: i32, id: i32) Instr { return ins6(44, dst, 0, 0, 0, id); }
fn i_fsqrtsd(d: i32, s: i32) Instr { return ins6(45, d, s, 0, 0, 0 - 1); }
fn i_x87_load(base: i32, disp: i32)  Instr { return ins6(46, 0, base, 0, disp, 0 - 1); }
fn i_x87_store(base: i32, disp: i32) Instr { return ins6(47, base, 0, 0, disp, 0 - 1); }
fn i_x87_sin()  Instr { return ins6(48, 0, 0, 0, 0, 0 - 1); }
fn i_x87_cos()  Instr { return ins6(49, 0, 0, 0, 0, 0 - 1); }
fn i_x87_sqrt() Instr { return ins6(50, 0, 0, 0, 0, 0 - 1); }
fn i_shl_cl(dst: i32)   Instr { return ins6(51, dst, 0, 0, 0, 0 - 1); }
fn i_sar_cl(dst: i32)   Instr { return ins6(52, dst, 0, 0, 0, 0 - 1); }
fn i_rep_movsb()        Instr { return ins6(53, 0,   0, 0, 0, 0 - 1); }
fn i_outb()   Instr { return ins6(54, 0, 0, 0, 0, 0 - 1); }
fn i_inb()    Instr { return ins6(55, 0, 0, 0, 0, 0 - 1); }
fn i_outw()   Instr { return ins6(56, 0, 0, 0, 0, 0 - 1); }
fn i_inw()    Instr { return ins6(57, 0, 0, 0, 0, 0 - 1); }
fn i_outl()   Instr { return ins6(58, 0, 0, 0, 0, 0 - 1); }
fn i_inl()    Instr { return ins6(59, 0, 0, 0, 0, 0 - 1); }
fn i_rdmsr()  Instr { return ins6(60, 0, 0, 0, 0, 0 - 1); }
fn i_wrmsr()  Instr { return ins6(61, 0, 0, 0, 0, 0 - 1); }
fn i_rdcr0()  Instr { return ins6(62, 0, 0, 0, 0, 0 - 1); }
fn i_wrcr0()  Instr { return ins6(63, 0, 0, 0, 0, 0 - 1); }
fn i_rdcr2()  Instr { return ins6(64, 0, 0, 0, 0, 0 - 1); }
fn i_rdcr3()  Instr { return ins6(65, 0, 0, 0, 0, 0 - 1); }
fn i_wrcr3()  Instr { return ins6(66, 0, 0, 0, 0, 0 - 1); }
fn i_rdcr4()  Instr { return ins6(67, 0, 0, 0, 0, 0 - 1); }
fn i_wrcr4()  Instr { return ins6(68, 0, 0, 0, 0, 0 - 1); }
fn i_lgdt()   Instr { return ins6(69, 0, 0, 0, 0, 0 - 1); }
fn i_lidt()   Instr { return ins6(70, 0, 0, 0, 0, 0 - 1); }
fn i_ltr()    Instr { return ins6(71, 0, 0, 0, 0, 0 - 1); }
fn i_invlpg() Instr { return ins6(72, 0, 0, 0, 0, 0 - 1); }
fn i_hlt()    Instr { return ins6(73, 0, 0, 0, 0, 0 - 1); }
fn i_cli()    Instr { return ins6(74, 0, 0, 0, 0, 0 - 1); }
fn i_sti()    Instr { return ins6(75, 0, 0, 0, 0, 0 - 1); }
fn i_pause()  Instr { return ins6(76, 0, 0, 0, 0, 0 - 1); }
fn i_wbinvd() Instr { return ins6(77, 0, 0, 0, 0, 0 - 1); }
fn i_shr_cl(dst: i32) Instr { return ins6(78, dst, 0, 0, 0, 0 - 1); }

// ── width-parameteric vector constructors ─────────────────────────────────────
// 3-operand packed arithmetic: dst = result, src = src1 (vvvv), lbl = src2 (rm).
// `w` is a raw width class (VW_128()/VW_256()/VW_512()).
fn i_vpaddq (dst:i32, s1:i32, s2:i32, w:i32) Instr { return ins6(112,dst,s1,w as i64,0,s2); }
fn i_vpsubq (dst:i32, s1:i32, s2:i32, w:i32) Instr { return ins6(113,dst,s1,w as i64,0,s2); }
fn i_vpmulld(dst:i32, s1:i32, s2:i32, w:i32) Instr { return ins6(114,dst,s1,w as i64,0,s2); }
fn i_vpmullq(dst:i32, s1:i32, s2:i32, w:i32) Instr { return ins6(115,dst,s1,w as i64,0,s2); }
fn i_vpslld (dst:i32, s1:i32, cnt:i32, w:i32) Instr { return ins6(116,dst,s1,w as i64,0,cnt); }
fn i_vpsllq (dst:i32, s1:i32, cnt:i32, w:i32) Instr { return ins6(117,dst,s1,w as i64,0,cnt); }
fn i_vpsrld (dst:i32, s1:i32, cnt:i32, w:i32) Instr { return ins6(118,dst,s1,w as i64,0,cnt); }
fn i_vpsrlq (dst:i32, s1:i32, cnt:i32, w:i32) Instr { return ins6(119,dst,s1,w as i64,0,cnt); }
// Vector-mask compares (VEX only): `ew` is the element width in bytes (4|8).
fn i_vpcmpeqi(dst:i32, s1:i32, s2:i32, ew:i32, w:i32) Instr { return ins6(120,dst,s1,w as i64,ew,s2); }
fn i_vpcmpgti(dst:i32, s1:i32, s2:i32, ew:i32, w:i32) Instr { return ins6(121,dst,s1,w as i64,ew,s2); }
// k-mask compares (EVEX only): `k` is a k-register number 0..7 in dst.
fn i_vpcmpnei(k:i32, s1:i32, s2:i32, ew:i32, w:i32) Instr { return ins6(122,k,s1,w as i64,ew,s2); }
fn i_vpcmpgtu(k:i32, s1:i32, s2:i32, ew:i32, w:i32) Instr { return ins6(123,k,s1,w as i64,ew,s2); }
// VPCMPD/VPCMPQ/VPCMPUD/VPCMPUQ: `unsign` in disp (0 signed/float 0F3A 1F, 1 unsigned 0F3A 1E),
// predicate in `pred`, element width in bytes in `ew`.
fn i_vcmpik(k:i32, s1:i32, s2:i32, pred:i32, ew:i32, unsign:i32, w:i32) Instr {
    return ins6(124, k, s1, x86vec_pack_imm8(w, pred), ew + unsign * 256, s2);
}
fn i_vaddps(dst:i32, s1:i32, s2:i32, w:i32) Instr { return ins6(125,dst,s1,w as i64,0,s2); }
fn i_vaddpd(dst:i32, s1:i32, s2:i32, w:i32) Instr { return ins6(126,dst,s1,w as i64,0,s2); }
fn i_vsubps(dst:i32, s1:i32, s2:i32, w:i32) Instr { return ins6(127,dst,s1,w as i64,0,s2); }
fn i_vsubpd(dst:i32, s1:i32, s2:i32, w:i32) Instr { return ins6(128,dst,s1,w as i64,0,s2); }
fn i_vmulps(dst:i32, s1:i32, s2:i32, w:i32) Instr { return ins6(129,dst,s1,w as i64,0,s2); }
fn i_vmulpd(dst:i32, s1:i32, s2:i32, w:i32) Instr { return ins6(130,dst,s1,w as i64,0,s2); }
fn i_vdivps(dst:i32, s1:i32, s2:i32, w:i32) Instr { return ins6(131,dst,s1,w as i64,0,s2); }
fn i_vdivpd(dst:i32, s1:i32, s2:i32, w:i32) Instr { return ins6(132,dst,s1,w as i64,0,s2); }
fn i_vsqrtps(dst:i32, s:i32, w:i32) Instr { return ins6(133,dst,0,w as i64,0,s); }
fn i_vsqrtpd(dst:i32, s:i32, w:i32) Instr { return ins6(134,dst,0,w as i64,0,s); }
fn i_vandps (dst:i32, s1:i32, s2:i32, w:i32) Instr { return ins6(135,dst,s1,w as i64,0,s2); }
fn i_vandpd (dst:i32, s1:i32, s2:i32, w:i32) Instr { return ins6(136,dst,s1,w as i64,0,s2); }
fn i_vandnps(dst:i32, s1:i32, s2:i32, w:i32) Instr { return ins6(137,dst,s1,w as i64,0,s2); }
fn i_vandnpd(dst:i32, s1:i32, s2:i32, w:i32) Instr { return ins6(138,dst,s1,w as i64,0,s2); }
fn i_vorps  (dst:i32, s1:i32, s2:i32, w:i32) Instr { return ins6(139,dst,s1,w as i64,0,s2); }
fn i_vorpd  (dst:i32, s1:i32, s2:i32, w:i32) Instr { return ins6(140,dst,s1,w as i64,0,s2); }
fn i_vxorps (dst:i32, s1:i32, s2:i32, w:i32) Instr { return ins6(141,dst,s1,w as i64,0,s2); }
fn i_vxorpd (dst:i32, s1:i32, s2:i32, w:i32) Instr { return ins6(142,dst,s1,w as i64,0,s2); }
// VCMPPS/VCMPPD packed compare: predicate in `pred`, element width in `ew`.
fn i_vcmpf(dst:i32, s1:i32, s2:i32, pred:i32, ew:i32, w:i32) Instr {
    return ins6(143, dst, s1, x86vec_pack_imm8(w, pred), ew, s2);
}
// splat / broadcast: `gpr` is a GPR for splat, a base GPR for the memory form.
fn i_vsplat32   (vec:i32, gpr:i32, w:i32) Instr { return ins6(144,vec,gpr,w as i64,0,0-1); }
fn i_vsplat64   (vec:i32, gpr:i32, w:i32) Instr { return ins6(145,vec,gpr,w as i64,0,0-1); }
fn i_vbroadcast32(vec:i32, base:i32, disp:i32, w:i32) Instr { return ins6(146,vec,base,w as i64,disp,0-1); }
fn i_vbroadcast64(vec:i32, base:i32, disp:i32, w:i32) Instr { return ins6(147,vec,base,w as i64,disp,0-1); }
// lane moves: `lane` in lbl, optional scratch vector register in disp (<0 = none).
fn i_vextract32(gpr:i32, vec:i32, lane:i32, scratch:i32, w:i32) Instr { return ins6(148,gpr,vec,w as i64,scratch,lane); }
fn i_vextract64(gpr:i32, vec:i32, lane:i32, scratch:i32, w:i32) Instr { return ins6(149,gpr,vec,w as i64,scratch,lane); }
fn i_vinsert32 (vec:i32, src:i32, gpr:i32, lane:i32, w:i32) Instr { return ins6(150,vec,src,w as i64,lane,gpr); }
fn i_vinsert64 (vec:i32, src:i32, gpr:i32, lane:i32, w:i32) Instr { return ins6(151,vec,src,w as i64,lane,gpr); }
fn i_vshuf32   (dst:i32, src:i32, imm8:i32, w:i32) Instr { return ins6(152,dst,src,x86vec_pack_imm8(w,imm8),0,0-1); }
fn i_vshufb    (dst:i32, ctl:i32, data:i32, w:i32) Instr { return ins6(153,dst,ctl,w as i64,0,data); }
fn i_vzero     (vec:i32, w:i32) Instr { return ins6(154,vec,vec,w as i64,0,vec); }
// select: vector-mask 3-instruction form (mask in disp) and k-mask masked form.
fn i_vselect (dst:i32, a:i32, b:i32, mask:i32, w:i32) Instr { return ins6(155,dst,a,w as i64,mask,b); }
fn i_vselectk(dst:i32, a:i32, b:i32, k:i32, w:i32) Instr { return ins6(156,dst,a,w as i64,k,b); }
// scaled-index memory: `elem_bytes` is the lane stride (1/2/4/8).
fn i_vmovdqu_load_idx (vec:i32, base:i32, index:i32, elem_bytes:i32, disp:i32, w:i32) Instr {
    return ins6(157, vec, base, x86vec_pack_imm(w, x86vec_scale_log_of(elem_bytes)), disp, index);
}
fn i_vmovdqu_store_idx(vec:i32, base:i32, index:i32, elem_bytes:i32, disp:i32, w:i32) Instr {
    return ins6(158, vec, base, x86vec_pack_imm(w, x86vec_scale_log_of(elem_bytes)), disp, index);
}
