// Focused behavioral checks for the test-only reflexive integer cmpi fold.
@import("../zir.zag")
@import("zopt.zag")

fn rc_val(name: []u8, ty: []u8) ZVal { return ZVal{.name=name,.ty=ty}; }

fn rc_assert(yes: bool, why: []u8, failures: *i32) void {
    if (!yes) { _zag_eprintln(why); failures.* = failures.* + 1; }
}

fn rc_cmp(opname: []u8, pred: []u8, lhs: ZVal, rhs: ZVal) ZOp {
    let o: ZOp = mk_op(opname);
    push[ZVal](&o.results, rc_val("%out", "bool"));
    push[ZVal](&o.operands, lhs);
    push[ZVal](&o.operands, rhs);
    push[ZAttr](&o.attrs, ZAttr{.key="predicate",.val=pred});
    o.origin.line = 77;
    return o;
}

fn rc_module(cmp: ZOp, second_param: i32) ZModule {
    let blk: ZBlock = one_block();
    push[ZOp](&blk.ops, cmp);
    let ret: ZOp = mk_op("func.return");
    push[ZVal](&ret.operands, rc_val("%out", "bool"));
    push[ZOp](&blk.ops, ret);
    let params: ArrayList[ZVal] = make[ZVal](2);
    push[ZVal](&params, get[ZVal](cmp.operands, 0));
    if (second_param == 1) { push[ZVal](&params, get[ZVal](cmp.operands, 1)); }
    let m: ZModule = ZModule{.funcs=make[ZFunc](1)};
    push[ZFunc](&m.funcs, ZFunc{.name="cmp_self",.params=params,.ret="bool",.body=blk});
    return m;
}

fn rc_first(m: ZModule) ZOp {
    return get[ZOp](get[ZFunc](m.funcs, 0).body.ops, 0);
}

fn rc_case(pred: []u8, answer: []u8, ty: []u8, failures: *i32) void {
    let x: ZVal = rc_val("%x", ty);
    let m: ZModule = rc_module(rc_cmp("arith.cmpi", pred, x, x), 0);
    let folded: ZOp = rc_first(opt_fold(m));
    rc_assert(@strEq(folded.name,"arith.constant") &&
              @strEq(opt_attr_val(folded,"value"),answer) &&
              @strEq(get[ZVal](folded.results,0).ty,"bool") &&
              folded.origin.line == 77,
              "reflexive cmpi did not fold with source/result metadata",failures);
    let combined: ZModule = opt_all(m);
    let body: ZBlock = get[ZFunc](combined.funcs,0).body;
    rc_assert(len[ZOp](body.ops) == 2 &&
              @strEq(get[ZOp](body.ops,0).name,"arith.constant") &&
              @strEq(opt_attr_val(get[ZOp](body.ops,0),"value"),answer) &&
              get[ZOp](body.ops,0).origin.line == 77 &&
              @strEq(get[ZVal](get[ZOp](body.ops,1).operands,0).name,"%out"),
              "combined pipeline did not retain the folded return value",failures);
}

fn rc_kept(o: ZOp, second_param: i32, why: []u8, failures: *i32) void {
    let m: ZModule = rc_module(o, second_param);
    let direct: ZOp = rc_first(opt_fold(m));
    let combined: ZOp = rc_first(opt_all(m));
    rc_assert(@strEq(direct.name, o.name) &&
              @strEq(combined.name, o.name) &&
              combined.effects == o.effects && combined.origin.line == 77,
              why, failures);
}

fn rc_trap_kept(failures: *i32) void {
    let a: ZVal = rc_val("%a", "i64");
    let b: ZVal = rc_val("%b", "i64");
    let div: ZOp = mk_op("arith.divsi");
    push[ZVal](&div.results, rc_val("%x", "i64"));
    push[ZVal](&div.operands, a);
    push[ZVal](&div.operands, b);
    let x: ZVal = rc_val("%x", "i64");
    let cmp: ZOp = rc_cmp("arith.cmpi", "eq", x, x);
    let blk: ZBlock = one_block();
    push[ZOp](&blk.ops, div);
    push[ZOp](&blk.ops, cmp);
    let ret: ZOp = mk_op("func.return");
    push[ZVal](&ret.operands, rc_val("%out","bool"));
    push[ZOp](&blk.ops, ret);
    let params: ArrayList[ZVal] = make[ZVal](2);
    push[ZVal](&params, a); push[ZVal](&params, b);
    let m: ZModule = ZModule{.funcs=make[ZFunc](1)};
    push[ZFunc](&m.funcs, ZFunc{.name="keep_div_trap",.params=params,.ret="bool",.body=blk});
    let result: ZBlock = get[ZFunc](opt_all(m).funcs,0).body;
    rc_assert(len[ZOp](result.ops) == 3 &&
              @strEq(get[ZOp](result.ops,0).name,"arith.divsi") &&
              @strEq(get[ZOp](result.ops,1).name,"arith.constant"),
              "comparing a potentially trapping division with itself erased the division",failures);
}

fn main() i32 {
    let failures: i32 = 0;
    rc_case("eq","1","i8",&failures);
    rc_case("ne","0","i8",&failures);
    rc_case("slt","0","i8",&failures);
    rc_case("sgt","0","i8",&failures);
    rc_case("sle","1","i8",&failures);
    rc_case("sge","1","i8",&failures);
    rc_case("eq","1","i64",&failures);
    rc_case("ne","0","i64",&failures);
    rc_case("slt","0","i64",&failures);
    rc_case("sgt","0","i64",&failures);
    rc_case("sle","1","i64",&failures);
    rc_case("sge","1","i64",&failures);

    let x: ZVal = rc_val("%x", "i64");
    let y: ZVal = rc_val("%y", "i64");
    rc_kept(rc_cmp("arith.cmpi","eq",x,y),1,
            "distinct SSA operands folded",&failures);
    rc_kept(rc_cmp("arith.cmpf","eq",x,x),0,
            "floating comparison folded (NaN is not reflexive)",&failures);
    rc_kept(rc_cmp("arith.cmpi","unrecognized",x,x),0,
            "unknown comparison predicate folded",&failures);
    let effects: ZOp = rc_cmp("arith.cmpi","eq",x,x);
    effects.effects = 1;
    rc_kept(effects,0,"effect-bearing compare folded",&failures);
    let extras: ZOp = rc_cmp("arith.cmpi","eq",x,x);
    push[ZAttr](&extras.attrs,ZAttr{.key="unexpected",.val="metadata"});
    rc_kept(extras,0,"compare with unhandled attributes folded",&failures);
    rc_kept(rc_cmp("arith.cmpi","eq",x,rc_val("%x","i32")),0,
            "inconsistent operand types folded",&failures);
    let f: ZVal = rc_val("%f", "f64");
    rc_kept(rc_cmp("arith.cmpi","eq",f,f),0,
            "malformed floating operands of integer comparison folded",&failures);
    rc_trap_kept(&failures);
    if (failures != 0) { return 1; }
    _zag_println("zopt-reflexive-cmpi: pass (12 positive, 7 negative, 1 trap case)");
    return 0;
}
