// Source-level authority check for the standalone kernel ET_REL writer.
@import("driver_elf.zag")
@import("../../std/list.zag")

fn main() i32 {
    let text: ArrayList[u8] = make[u8](13);
    push[u8](&text, 232); push[u8](&text, 0); push[u8](&text, 0);
    push[u8](&text, 0); push[u8](&text, 0);
    i = 0; while (i < 8) { push[u8](&text, 0); i = i + 1; }
    let data: ArrayList[u8] = make[u8](8);
    let i: i32 = 0; while (i < 8) { push[u8](&data, 0); i = i + 1; }
    let modinfo: ArrayList[u8] = make[u8](64);
    driver_elf_cstr(&modinfo, "zag_kernel_series=6.1");
    driver_elf_cstr(&modinfo, "name=zag_driver_test");
    driver_elf_cstr(&modinfo, "license=GPL");
    driver_elf_cstr(&modinfo, "description=Pure-Zag Linux driver module");
    driver_elf_cstr(&modinfo, "zag_target=x86_64");
    let symbols: ArrayList[DriverElfSymbol] = make[DriverElfSymbol](1);
    push[DriverElfSymbol](&symbols, DriverElfSymbol{
        .name = "init_module", .offset = 0, .size = 5, .defined = 1,
        .section = 1, .bind = 1, .type_ = 2 });
    let imports: ArrayList[[]u8] = make[[]u8](1);
    push[[]u8](&imports, "kernel_probe");
    let text_relocs: ArrayList[DriverElfReloc] = make[DriverElfReloc](2);
    push[DriverElfReloc](&text_relocs, DriverElfReloc{
        .offset = 1, .symbol = 5, .typ = 4, .addend = -4 });
    push[DriverElfReloc](&text_relocs, DriverElfReloc{
        .offset = 5, .symbol = 2, .typ = 1, .addend = 8 });
    let data_relocs: ArrayList[DriverElfReloc] = make[DriverElfReloc](1);
    push[DriverElfReloc](&data_relocs, DriverElfReloc{
        .offset = 0, .symbol = 4, .typ = 1, .addend = 0 });
    let debug_abbrev: ArrayList[u8] = make[u8](1); push[u8](&debug_abbrev, 0);
    let debug_info: ArrayList[u8] = make[u8](1); push[u8](&debug_info, 0);
    let debug_line: ArrayList[u8] = make[u8](1); push[u8](&debug_line, 0);
    let spec: DriverElfSpec = DriverElfSpec{
        .machine = 62, .word_size = 8, .text = text, .data = data,
        .modinfo = modinfo, .symbols = symbols, .imports = imports,
        .text_relocs = text_relocs, .data_relocs = data_relocs,
        .debug_abbrev = debug_abbrev, .debug_info = debug_info,
        .debug_line = debug_line };
    let rc_x86: i32 = write_driver_elf64("/tmp/driver-elf-source-test-x86_64.o", spec);

    let arm_text: ArrayList[u8] = make[u8](16);
    push[u8](&arm_text, 0); push[u8](&arm_text, 0); push[u8](&arm_text, 0);
    push[u8](&arm_text, 0); i = 0; while (i < 12) { push[u8](&arm_text, 0); i = i + 1; }
    let arm_data: ArrayList[u8] = make[u8](8);
    i = 0; while (i < 8) { push[u8](&arm_data, 0); i = i + 1; }
    let arm_symbols: ArrayList[DriverElfSymbol] = make[DriverElfSymbol](1);
    push[DriverElfSymbol](&arm_symbols, DriverElfSymbol{.name="init_module",.offset=0,.size=5,.defined=1,.section=1,.bind=1,.type_=2});
    let arm_imports: ArrayList[[]u8] = make[[]u8](1); push[[]u8](&arm_imports, "kernel_probe");
    let arm_text_relocs: ArrayList[DriverElfReloc] = make[DriverElfReloc](2);
    push[DriverElfReloc](&arm_text_relocs, DriverElfReloc{.offset=0,.symbol=5,.typ=283,.addend=0});
    push[DriverElfReloc](&arm_text_relocs, DriverElfReloc{.offset=8,.symbol=2,.typ=257,.addend=8});
    let arm_data_relocs: ArrayList[DriverElfReloc] = make[DriverElfReloc](1);
    push[DriverElfReloc](&arm_data_relocs, DriverElfReloc{.offset=0,.symbol=4,.typ=257,.addend=0});
    let arm_modinfo: ArrayList[u8] = make[u8](64);
    driver_elf_cstr(&arm_modinfo, "zag_kernel_series=6.6"); driver_elf_cstr(&arm_modinfo, "name=zag_driver_test");
    driver_elf_cstr(&arm_modinfo, "license=GPL"); driver_elf_cstr(&arm_modinfo, "description=Pure-Zag Linux driver module"); driver_elf_cstr(&arm_modinfo, "zag_target=arm64");
    let arm_spec: DriverElfSpec = DriverElfSpec{.machine=183,.word_size=8,.text=arm_text,.data=arm_data,.modinfo=arm_modinfo,.symbols=arm_symbols,.imports=arm_imports,.text_relocs=arm_text_relocs,.data_relocs=arm_data_relocs,.debug_abbrev=debug_abbrev,.debug_info=debug_info,.debug_line=debug_line};
    let rc_arm: i32 = write_driver_elf64("/tmp/driver-elf-source-test-arm64.o", arm_spec);

    let i686_text: ArrayList[u8] = make[u8](5);
    push[u8](&i686_text, 232); push[u8](&i686_text, 0); push[u8](&i686_text, 0);
    push[u8](&i686_text, 0); push[u8](&i686_text, 0);
    let i686_data: ArrayList[u8] = make[u8](4);
    i = 0; while (i < 4) { push[u8](&i686_data, 0); i = i + 1; }
    let i686_symbols: ArrayList[DriverElfSymbol] = make[DriverElfSymbol](1);
    push[DriverElfSymbol](&i686_symbols, DriverElfSymbol{.name="init_module",.offset=0,.size=5,.defined=1,.section=1,.bind=1,.type_=2});
    let i686_imports: ArrayList[[]u8] = make[[]u8](1); push[[]u8](&i686_imports, "kernel_probe");
    let i686_text_relocs: ArrayList[DriverElfReloc] = make[DriverElfReloc](1);
    push[DriverElfReloc](&i686_text_relocs, DriverElfReloc{.offset=1,.symbol=5,.typ=2,.addend=0});
    let i686_data_relocs: ArrayList[DriverElfReloc] = make[DriverElfReloc](1);
    push[DriverElfReloc](&i686_data_relocs, DriverElfReloc{.offset=0,.symbol=4,.typ=1,.addend=0});
    let i686_modinfo: ArrayList[u8] = make[u8](64);
    driver_elf_cstr(&i686_modinfo, "zag_kernel_series=6.1"); driver_elf_cstr(&i686_modinfo, "name=zag_driver_test");
    driver_elf_cstr(&i686_modinfo, "license=GPL"); driver_elf_cstr(&i686_modinfo, "description=Pure-Zag Linux driver module"); driver_elf_cstr(&i686_modinfo, "zag_target=i686");
    let rc_i686: i32 = write_driver_elf32("/tmp/driver-elf-source-test-i686.o", i686_text, i686_data, i686_modinfo, i686_symbols, i686_imports, i686_text_relocs, i686_data_relocs, debug_abbrev, debug_info, debug_line);
    return rc_x86 + rc_arm + rc_i686;
}
