        push[AInstr](out, ai_pop(A_X12())); push[AInstr](out, ai_pop(A_X11())); push[AInstr](out, ai_pop(A_X10()));
        let wi: i32 = 0;
        let vector_words: i32 = words;
        if (vsa_type_final_bits(vsa_ty) != 64) {
            vector_words = vector_words - 1;
        }
        while (wi + 1 < vector_words) {
            push[AInstr](out, ai_vloadq(0, A_X10(), wi * 8));
            push[AInstr](out, ai_vloadq(1, A_X11(), wi * 8));
            push[AInstr](out, ai_vloadq(2, A_X12(), wi * 8));
            push[AInstr](out, ai_vloadq(3, A_X10(), wi * 8));
            push[AInstr](out, ai_vand(0, 1));
            push[AInstr](out, ai_vand(3, 2));
            push[AInstr](out, ai_vand(1, 2));
            push[AInstr](out, ai_vorr(0, 3));
            push[AInstr](out, ai_vorr(0, 1));
            push[AInstr](out, ai_vstoreq(A_X29(), result + wi * 8, 0));
            wi = wi + 2;
        }
        while (wi < words) {
            push[AInstr](out, ai_load(A_X0(), A_X10(), wi * 8));
            push[AInstr](out, ai_load(A_X1(), A_X11(), wi * 8));
            push[AInstr](out, ai_load(A_X2(), A_X12(), wi * 8));
            push[AInstr](out, ai_mov_rr(A_X9(), A_X0())); push[AInstr](out, ai_andr(A_X9(), A_X1()));
            push[AInstr](out, ai_mov_rr(A_X13(), A_X0())); push[AInstr](out, ai_andr(A_X13(), A_X2()));
            push[AInstr](out, ai_andr(A_X1(), A_X2())); push[AInstr](out, ai_or(A_X9(), A_X13())); push[AInstr](out, ai_or(A_X9(), A_X1()));
            if (wi + 1 == words) { ac_vsa_mask_last(out, vsa_ty, A_X9()); }
            push[AInstr](out, ai_store(A_X29(), result + wi * 8, A_X9()));
            wi = wi + 1;
        }
        ac_emit_lea(out, A_X0(), result); push[AInstr](out, ai_push(A_X0())); return;
    }
    if (@strEq(b, "atomicFence")) {
        if (nargs != 1) { ac_err(cg, "arm64: @atomicFence expects one literal order"); push[AInstr](out, ai_mov_imm(A_X0(), 0)); push[AInstr](out, ai_push(A_X0())); return; }
        let order:i64=-1;
        switch (get[*Node](c.args,0).*) { .ilit=>|x|{if(@strEq(x.text,"0")){order=0;}else if(@strEq(x.text,"1")){order=1;}else if(@strEq(x.text,"2")){order=2;}else if(@strEq(x.text,"3")){order=3;}else if(@strEq(x.text,"4")){order=4;}}else=>{} }
        if (order<0) { ac_err(cg, "arm64: @atomicFence order must be a literal 0..4"); push[AInstr](out, ai_mov_imm(A_X0(), 0)); push[AInstr](out, ai_push(A_X0())); return; }
        if (order!=0) { push[AInstr](out, ai_dmb()); }
        push[AInstr](out, ai_mov_imm(A_X0(), 0)); push[AInstr](out, ai_push(A_X0())); return;
    }
    if (@strEq(b, "memoryFence")) {
        if (nargs != 0) { ac_err(cg, "arm64: @memoryFence expects no arguments"); }
        push[AInstr](out, ai_dmb());
        push[AInstr](out, ai_mov_imm(A_X0(), 0));
        push[AInstr](out, ai_push(A_X0()));
        return;
    }
    if (@strEq(b, "sizeOf")) {
        let t: []u8 = "i32";
        if (len[[]u8](c.targs) > 0) { t = get[[]u8](c.targs, 0); }
        push[AInstr](out, ai_mov_imm(A_X0(), ac_type_size(cg, t) as i64));
        push[AInstr](out, ai_push(A_X0()));
        return;
    }
    if (@strEq(b, "alignOf")) {
        if (len[[]u8](c.targs) != 1 || nargs != 0) {
            ac_err(cg, "arm64: @alignOf expects one type argument and no values");
            push[AInstr](out, ai_mov_imm(A_X0(), 0)); push[AInstr](out, ai_push(A_X0())); return;
        }
        push[AInstr](out, ai_mov_imm(A_X0(), ac_type_alignment(cg, get[[]u8](c.targs, 0)) as i64));
        push[AInstr](out, ai_push(A_X0()));
        return;
    }
    if (@strEq(b, "offsetOf")) {
        if (len[[]u8](c.targs) != 1 || nargs != 1) {
            ac_err(cg, "arm64: @offsetOf expects one type argument and one field string");
            push[AInstr](out, ai_mov_imm(A_X0(), 0)); push[AInstr](out, ai_push(A_X0())); return;
        }
        let field: []u8 = "";
        switch (get[*Node](c.args, 0).*) {
            .slit => |s| { if (s.text.len >= 2) { field = s.text[1..s.text.len - 1]; } }
            else => { }
        }
        let off: i32 = ac_field_offset(cg, get[[]u8](c.targs, 0), field);
        if (off < 0) { ac_err(cg, "arm64: @offsetOf names an unknown field"); off = 0; }
        push[AInstr](out, ai_mov_imm(A_X0(), off as i64));
        push[AInstr](out, ai_push(A_X0()));
        return;
    }
    if (@strEq(b, "len") || @strEq(b, "strLen")) {
        if (nargs != 1) { ac_err(cg, "arm64: @len expects one argument"); push[AInstr](out, ai_mov_imm(A_X0(), 0)); push[AInstr](out, ai_push(A_X0())); return; }
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg);
        push[AInstr](out, ai_pop(A_X10()));
        push[AInstr](out, ai_load(A_X0(), A_X10(), 8));
        push[AInstr](out, ai_push(A_X0()));
        return;
    }
    if (@strEq(b, "strEq")) {
        if (nargs != 2) { ac_err(cg, "arm64: @strEq expects two arguments"); push[AInstr](out, ai_mov_imm(A_X0(), 0)); push[AInstr](out, ai_push(A_X0())); return; }
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg);
        ac_lower_expr(out, get[*Node](c.args, 1), env, syms, cg);
        push[AInstr](out, ai_pop(A_X1()));
        push[AInstr](out, ai_pop(A_X0()));
        cg.*.use_se = 1;
        push[AInstr](out, ai_call(cg.*.se_lbl));
        push[AInstr](out, ai_push(A_X0()));
        return;
    }
    if (@strEq(b, "intCast") || @strEq(b, "truncate") || @strEq(b, "floatCast")) {
        if (nargs != 1) { ac_err(cg, "arm64: cast builtin expects one argument"); push[AInstr](out, ai_mov_imm(A_X0(), 0)); push[AInstr](out, ai_push(A_X0())); return; }
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg);
        return;
    }
    if (@strEq(b, "intToFloat")) {
        if (nargs != 1) { ac_err(cg, "arm64: @intToFloat expects one argument"); push[AInstr](out, ai_mov_imm(A_X0(), 0)); push[AInstr](out, ai_push(A_X0())); return; }
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg); push[AInstr](out, ai_pop(A_X0()));
        push[AInstr](out, ai_scvtf(0, A_X0())); push[AInstr](out, ai_fmov_xd(A_X0(), 0)); push[AInstr](out, ai_push(A_X0()));
        return;
    }
    if (@strEq(b, "floatToInt")) {
        if (nargs != 1) { ac_err(cg, "arm64: @floatToInt expects one argument"); push[AInstr](out, ai_mov_imm(A_X0(), 0)); push[AInstr](out, ai_push(A_X0())); return; }
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg); push[AInstr](out, ai_pop(A_X0()));
        push[AInstr](out, ai_fmov_dx(0, A_X0())); push[AInstr](out, ai_fcvtzs(A_X0(), 0)); push[AInstr](out, ai_push(A_X0()));
        return;
    }
    // ── posit conversion builtins: @intToPosit/@floatToPosit/@positToFloat/@positToBits
    // Rewrite to znrt_* runtime call. Single scalar arg in x0, result in x0.
    let pbf: []u8 = cg_posit_builtin_fn(b);
    if (pbf.len > 0) {
        if (nargs != 1) { ac_err(cg, "arm64: posit conversion builtin expects one argument"); push[AInstr](out, ai_mov_imm(A_X0(), 0)); push[AInstr](out, ai_push(A_X0())); return; }
        let plbl: i32 = ac_find_fn(syms, pbf);
        if (plbl < 0) { ac_err(cg, "arm64: posit runtime not linked (missing znrt_ conversion)"); push[AInstr](out, ai_mov_imm(A_X0(), 0)); push[AInstr](out, ai_push(A_X0())); return; }
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg);
        push[AInstr](out, ai_pop(A_X0()));
        push[AInstr](out, ai_call(plbl));
        push[AInstr](out, ai_push(A_X0()));
        return;
    }
    // ── quire builtins: @quireZero/@quireFMA/@quireToPosit → runtime call (sret)
    let qbf: []u8 = cg_quire_builtin_fn(b);
    if (qbf.len > 0) {
        ac_lower_call(out, Call{ .callee = mk_ident(qbf), .args = c.args, .targs = make[[]u8](1) }, env, syms, cg);
        return;
    }
    ac_err(cg, _zag_str_concat("arm64: unsupported builtin: ", fname));
    push[AInstr](out, ai_mov_imm(A_X0(), 0));
    push[AInstr](out, ai_push(A_X0()));
}

// ── statements ───────────────────────────────────────────────────────────────

fn ac_cond_branch(out: *ArrayList[AInstr], cond: *Node, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg, lbl: i32) void {
    ac_lower_expr(out, cond, env, syms, cg);
    push[AInstr](out, ai_pop(A_X0()));
    if (ac_is_optional(ac_expr_type(cond, env, syms, cg)) == 1) {
        push[AInstr](out, ai_load(A_X0(), A_X0(), 0));   // test the has-flag
    }
    push[AInstr](out, ai_cmp_imm(A_X0(), 0));
    push[AInstr](out, ai_je(lbl));
}

// `if (opt) |cap|` / `while (opt) |cap|`: branch to `lbl` when has==0, else
// bind `cap` to the payload (scalar by value; aggregate by-ref).
fn ac_opt_cond_bind(out: *ArrayList[AInstr], cond: *Node, cap: []u8, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg, lbl: i32) void {
    let cty: []u8 = ac_expr_type(cond, env, syms, cg);
    if (ac_is_optional(cty) == 0) {
        ac_err(cg, "arm64: |capture| condition must be an optional");
        push[AInstr](out, ai_jmp(lbl));
        return;
    }
    let pty: []u8 = cty[1..];
    ac_lower_expr(out, cond, env, syms, cg);
    push[AInstr](out, ai_pop(A_X10()));
    push[AInstr](out, ai_load(A_X0(), A_X10(), 0));
    push[AInstr](out, ai_cmp_imm(A_X0(), 0));
    push[AInstr](out, ai_je(lbl));
    if (ac_is_aggregate(cg, pty) == 1) {
        let d1: i32 = ac_slot_alloc_br(env, cg, cap, pty, 1, 1);
        push[AInstr](out, ai_add_imm(A_X10(), 8));
        push[AInstr](out, ai_store(A_X29(), d1, A_X10()));
    } else {
        let d2: i32 = ac_slot_alloc_br(env, cg, cap, pty, 1, 0);
        push[AInstr](out, ai_load(A_X0(), A_X10(), 8));
        push[AInstr](out, ai_store(A_X29(), d2, A_X0()));
    }
}

fn ac_lower_stmt(out: *ArrayList[AInstr], n: *Node, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) void {
    switch (n.*) {
        .let_ => |l| {
            let ty: []u8 = "";
            if (l.has_dty == 1) { ty = l.dty; }
            else if (l.has_init == 1) { ty = ac_expr_type(l.expr, env, syms, cg); }
            if (cg_is_fn_type(cg_norm_type(ty)) == 1) { ty = "fat_fn"; }
            let w: i32 = ac_type_words(cg, ty);
            let disp: i32 = ac_slot_alloc_br(env, cg, l.name, ty, w, 0);
            if (l.has_init == 1) {
                if (ac_is_optional(ty) == 1 && ac_is_null_node(l.expr) == 1) {
                    push[AInstr](out, ai_mov_imm(A_X0(), 0));
                    push[AInstr](out, ai_store(A_X29(), disp, A_X0()));
                    return;
                }
                if (ac_is_optional(ty) == 1 && ac_is_optional(ac_expr_type(l.expr, env, syms, cg)) == 0) {
                    // wrap: ?T = value → {has=1, val}
                    let pty: []u8 = ty[1..];
                    push[AInstr](out, ai_mov_imm(A_X0(), 1));
                    push[AInstr](out, ai_store(A_X29(), disp, A_X0()));
                    ac_lower_expr(out, l.expr, env, syms, cg);
                    if (ac_is_aggregate(cg, pty) == 1) {
                        push[AInstr](out, ai_pop(A_X11()));
                        ac_emit_lea(out, A_X10(), disp + 8);
                        ac_emit_copy(out, ac_type_words(cg, pty));
                    } else {
                        push[AInstr](out, ai_pop(A_X0()));
                        push[AInstr](out, ai_store(A_X29(), disp + 8, A_X0()));
                    }
                    return;
                }
                // `let x: rns_3 = 42` constructs the three residues; it is not
                // a scalar bit-cast.  Materialize it through the aggregate
                // runtime constructor before copying into the local block.
                let init: *Node = l.expr;
                if (cg_is_rns_ty(ty) == 1 && ac_is_aggregate(cg, ac_expr_type(l.expr, env, syms, cg)) == 0) {
                    let ia: ArrayList[*Node] = make[*Node](1);
                    push[*Node](&ia, l.expr);
                    init = mk_call(mk_ident("znrt_rns_from_i64"), ia);
                }
                ac_lower_expr(out, init, env, syms, cg);
                if (ac_is_aggregate(cg, ty) == 1) {
                    push[AInstr](out, ai_pop(A_X11()));
                    ac_emit_lea(out, A_X10(), disp);
                    ac_emit_copy(out, w);
                } else {
                    push[AInstr](out, ai_pop(A_X0()));
                    push[AInstr](out, ai_store(A_X29(), disp, A_X0()));
                }
                switch (l.expr.*) {
                    .call => |task_call| {
                        switch (task_call.callee.*) {
                            .id => |task_fn| {
                                if (@strEq(task_fn.name, "@asyncSpawn")) {
                                    push[i32](&env.*.async_task_disps, disp);
                                }
                            }
                            else => { }
                        }
                    }
                    else => { }
                }
            }
        }
        .assign => |a| {
            // `_ = expr` discards: evaluate for side effects only
            switch (a.target.*) {
                .id => |tid| {
                    if (@strEq(tid.name, "_")) {
                        ac_lower_expr(out, a.expr, env, syms, cg);
                        push[AInstr](out, ai_pop(A_X0()));
                        return;
                    }
                }
                else => { }
            }
            let tty: []u8 = ac_expr_type(a.target, env, syms, cg);
            if (ac_is_optional(tty) == 1 && ac_is_null_node(a.expr) == 1) {
                ac_lower_addr(out, a.target, env, syms, cg);
                push[AInstr](out, ai_pop(A_X10()));
                push[AInstr](out, ai_mov_imm(A_X0(), 0));
                push[AInstr](out, ai_store(A_X10(), 0, A_X0()));
                return;
            }
            if (ac_is_optional(tty) == 1 && ac_is_optional(ac_expr_type(a.expr, env, syms, cg)) == 0) {
                let pty: []u8 = tty[1..];
                ac_lower_addr(out, a.target, env, syms, cg);
                ac_lower_expr(out, a.expr, env, syms, cg);
                if (ac_is_aggregate(cg, pty) == 1) {
                    push[AInstr](out, ai_pop(A_X11()));
                    push[AInstr](out, ai_pop(A_X10()));
                    push[AInstr](out, ai_mov_imm(A_X0(), 1));
                    push[AInstr](out, ai_store(A_X10(), 0, A_X0()));
                    push[AInstr](out, ai_add_imm(A_X10(), 8));
                    ac_emit_copy(out, ac_type_words(cg, pty));
                } else {
                    push[AInstr](out, ai_pop(A_X0()));
                    push[AInstr](out, ai_pop(A_X10()));
                    push[AInstr](out, ai_mov_imm(A_X9(), 1));
                    push[AInstr](out, ai_store(A_X10(), 0, A_X9()));
                    push[AInstr](out, ai_store(A_X10(), 8, A_X0()));
                }
                return;
            }
            let is_byte: i32 = 0;
            let layout_width: i32 = 0;
            switch (a.target.*) {
                .idx => |_ix| { if (ac_elem_is_byte(tty) == 1) { is_byte = 1; } }
                .fld => |ef| {
                    let ebt: []u8 = ac_expr_type(ef.base, env, syms, cg);
                    let esn: []u8 = ebt;
                    if (ebt.len > 1 && ebt[0] == '*') { esn = ebt[1..]; }
                    layout_width = ac_layout_field_width(cg, esn, ef.fname);
                }
                else => { }
            }
            ac_lower_addr(out, a.target, env, syms, cg);
            ac_lower_expr(out, a.expr, env, syms, cg);
            if (ac_is_aggregate(cg, tty) == 1) {
                push[AInstr](out, ai_pop(A_X11()));
                push[AInstr](out, ai_pop(A_X10()));
                ac_emit_copy(out, ac_type_words(cg, tty));
            } else {
                push[AInstr](out, ai_pop(A_X0()));
                push[AInstr](out, ai_pop(A_X10()));
                if (layout_width > 0) { ac_emit_store_layout(out, A_X10(), 0, layout_width, A_X0()); }
                else if (is_byte == 1) { push[AInstr](out, ai_storeb(A_X10(), 0, A_X0())); }
                else { push[AInstr](out, ai_store(A_X10(), 0, A_X0())); }
            }
        }
        .ret => |r| {
            if (r.has_expr == 1) {
                if (cg.*.sret_words > 0 && cg.*.ret_ty.len > 1 && cg.*.ret_ty[0] == '!') {
                    // !T error-union return: `return error.X` → {code, 0};
                    // `return val` → {0, val}. Scalar payloads only (as on x86).
                    let is_err_ret: i32 = 0;
                    switch (r.expr.*) {
                        .fld => |ef| {
                            switch (ef.base.*) {
                                .id => |eid2| { if (@strEq(eid2.name, "error") && ac_slot_find(env, eid2.name) == 0) { is_err_ret = 1; } }
                                else => { }
                            }
                        }
                        else => { }
                    }
                    ac_lower_expr(out, r.expr, env, syms, cg);
                    push[AInstr](out, ai_pop(A_X0()));
                    push[AInstr](out, ai_load(A_X10(), A_X29(), cg.*.sret_disp));
                    push[AInstr](out, ai_mov_imm(A_X9(), 0));
                    if (is_err_ret == 1) {
                        push[AInstr](out, ai_store(A_X10(), 0, A_X0()));
                        push[AInstr](out, ai_store(A_X10(), 8, A_X9()));
                    } else {
                        push[AInstr](out, ai_store(A_X10(), 8, A_X0()));
                        push[AInstr](out, ai_store(A_X10(), 0, A_X9()));
                    }
                    push[AInstr](out, ai_mov_rr(A_X0(), A_X10()));
                    push[AInstr](out, ai_mov_imm(A_X9(), is_err_ret as i64));
                    push[AInstr](out, ai_store(A_X29(), env.*.is_err_slot, A_X9()));
                    push[AInstr](out, ai_jmp(cg.*.pre_epilogue));
                    return;
                }
                if (cg.*.sret_words > 0 && ac_is_optional(cg.*.ret_ty) == 1 && ac_is_null_node(r.expr) == 1) {
                    push[AInstr](out, ai_load(A_X10(), A_X29(), cg.*.sret_disp));
                    push[AInstr](out, ai_mov_imm(A_X9(), 0));
                    push[AInstr](out, ai_store(A_X10(), 0, A_X9()));
                    push[AInstr](out, ai_mov_rr(A_X0(), A_X10()));
                    push[AInstr](out, ai_mov_imm(A_X9(), 0));
                    push[AInstr](out, ai_store(A_X29(), env.*.is_err_slot, A_X9()));
                    push[AInstr](out, ai_jmp(cg.*.pre_epilogue));
                    return;
                }
                if (cg.*.sret_words > 0 && ac_is_optional(cg.*.ret_ty) == 1 && ac_is_optional(ac_expr_type(r.expr, env, syms, cg)) == 0) {
                    // wrap: return v → {has=1, val=v}
                    let pty: []u8 = cg.*.ret_ty[1..];
                    ac_lower_expr(out, r.expr, env, syms, cg);
                    push[AInstr](out, ai_load(A_X10(), A_X29(), cg.*.sret_disp));
                    push[AInstr](out, ai_mov_imm(A_X9(), 1));
                    push[AInstr](out, ai_store(A_X10(), 0, A_X9()));
                    if (ac_is_aggregate(cg, pty) == 1) {
                        push[AInstr](out, ai_pop(A_X11()));
                        push[AInstr](out, ai_add_imm(A_X10(), 8));
                        ac_emit_copy(out, ac_type_words(cg, pty));
                        push[AInstr](out, ai_sub_imm(A_X10(), 8));
                    } else {
                        push[AInstr](out, ai_pop(A_X0()));
                        push[AInstr](out, ai_store(A_X10(), 8, A_X0()));
                    }
                    push[AInstr](out, ai_mov_rr(A_X0(), A_X10()));
                    push[AInstr](out, ai_mov_imm(A_X9(), 0));
                    push[AInstr](out, ai_store(A_X29(), env.*.is_err_slot, A_X9()));
                    push[AInstr](out, ai_jmp(cg.*.pre_epilogue));
                    return;
                }
                ac_lower_expr(out, r.expr, env, syms, cg);
                if (cg.*.sret_words > 0) {
                    push[AInstr](out, ai_pop(A_X11()));
                    push[AInstr](out, ai_load(A_X10(), A_X29(), cg.*.sret_disp));
                    ac_emit_copy(out, cg.*.sret_words);
                    push[AInstr](out, ai_mov_rr(A_X0(), A_X10()));
                } else {
                    push[AInstr](out, ai_pop(A_X0()));
                }
            } else {
                push[AInstr](out, ai_mov_imm(A_X0(), 0));
            }
            // Detect error return for errdefer: return error.X from a !T function.
            let non_sret_err: i32 = 0;
            if (r.has_expr == 1) {
                switch (r.expr.*) {
                    .fld => |ef| {
                        switch (ef.base.*) {
                            .id => |eid2| { if (@strEq(eid2.name, "error") && ac_slot_find(env, eid2.name) == 0) { non_sret_err = 1; } }
                            else => { }
                        }
                    }
                    else => { }
                }
            }
            push[AInstr](out, ai_mov_imm(A_X9(), non_sret_err as i64));
            push[AInstr](out, ai_store(A_X29(), env.*.is_err_slot, A_X9()));
            push[AInstr](out, ai_jmp(cg.*.pre_epilogue));
        }
        .if_ => |x| {
            let l_else: i32 = ac_fresh(cg);
            let l_end: i32 = ac_fresh(cg);
            if (x.has_cap == 1) {
                let m1: i32 = ac_scope_mark(env);
                ac_opt_cond_bind(out, x.cond, x.cap, env, syms, cg, l_else);
                ac_lower_block(out, x.then_body, env, syms, cg);
                ac_scope_end(env, m1);
            } else {
                ac_cond_branch(out, x.cond, env, syms, cg, l_else);
                let m2: i32 = ac_scope_mark(env);
                ac_lower_block(out, x.then_body, env, syms, cg);
                ac_scope_end(env, m2);
            }
            push[AInstr](out, ai_jmp(l_end));
            push[AInstr](out, ai_label(l_else));
            let m3: i32 = ac_scope_mark(env);
            ac_lower_block(out, x.els_body, env, syms, cg);
            ac_scope_end(env, m3);
            push[AInstr](out, ai_label(l_end));
        }
        .while_ => |w| {
            let l_top: i32 = ac_fresh(cg);
            let l_end: i32 = ac_fresh(cg);
            push[AInstr](out, ai_label(l_top));
            ac_loop_push(env,l_end,l_top);
            if (w.has_cap == 1) {
                let m4: i32 = ac_scope_mark(env);
                ac_opt_cond_bind(out, w.cond, w.cap, env, syms, cg, l_end);
                ac_lower_block(out, w.body, env, syms, cg);
                ac_scope_end(env, m4);
            } else {
                ac_cond_branch(out, w.cond, env, syms, cg, l_end);
                let m5: i32 = ac_scope_mark(env);
                ac_lower_block(out, w.body, env, syms, cg);
                ac_scope_end(env, m5);
            }
            ac_loop_pop(env);
            push[AInstr](out, ai_jmp(l_top));
            push[AInstr](out, ai_label(l_end));
        }
        .unsafe_ => |u| {
            let mu: i32 = ac_scope_mark(env);
            ac_lower_block(out, u.body, env, syms, cg);
            ac_scope_end(env, mu);
        }
        .break_ => |_b| {
            let target: i32 = ac_loop_top(env.*.break_lbls);
            if (target < 0) { ac_err(cg,"arm64: break outside loop"); }
            else { push[AInstr](out,ai_jmp(target)); }
        }
        .continue_ => |_c| {
            let target: i32 = ac_loop_top(env.*.continue_lbls);
            if (target < 0) { ac_err(cg,"arm64: continue outside loop"); }
            else { push[AInstr](out,ai_jmp(target)); }
        }
        .switch_ => |sw| {
            ac_lower_switch(out, sw, env, syms, cg);
        }
        .estmt => |e| {
            ac_lower_expr(out, e.expr, env, syms, cg);
            push[AInstr](out, ai_pop(A_X0()));
        }
        .defer_ => |d| {
            // Collect the deferred expression; it will be lowered at pre_epilogue.
            if (d.is_err == 0) {
                push[*Node](&env.*.defer_exprs, d.expr);
            } else {
                push[*Node](&env.*.errdefer_exprs, d.expr);
            }
        }
        else => { ac_err(cg, "arm64: unsupported statement"); }
    }
}

// switch on a scalar (enum value / integer) or a tagged union.
// Union arm captures bind: scalar payload by VALUE, aggregate payload as a
// pointer (use `cap.*.field`) — matching the x86 backend's semantics.
fn ac_lower_switch(out: *ArrayList[AInstr], sw: Switch, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) void {
    let sty: []u8 = ac_expr_type(sw.subject, env, syms, cg);
    let is_union: i32 = ac_is_union(cg, sty);
    if (ac_is_aggregate(cg, sty) == 1 && is_union == 0) {
        ac_err(cg, "arm64: switch subject must be a scalar, enum, or union");
        return;
    }
    let l_end: i32 = ac_fresh(cg);
    let l_els: i32 = ac_fresh(cg);
    let narms: i32 = len[SwitchArm](sw.arms);
    let arm_lbls: ArrayList[i32] = make[i32](narms + 1);
    let k: i32 = 0;
    while (k < narms) { push[i32](&arm_lbls, ac_fresh(cg)); k = k + 1; }

    let subj_d: i32 = 0;
    ac_lower_expr(out, sw.subject, env, syms, cg);
    if (is_union == 1) {
        // stash the union block address; dispatch on tag word
        subj_d = ac_slot_scratch(cg, 1);
        push[AInstr](out, ai_pop(A_X10()));
        push[AInstr](out, ai_store(A_X29(), subj_d, A_X10()));
        push[AInstr](out, ai_load(A_X0(), A_X10(), 0));
    } else {
        push[AInstr](out, ai_pop(A_X0()));
    }
    let i: i32 = 0;
    while (i < narms) {
        let arm: SwitchArm = get[SwitchArm](sw.arms, i);
        let t: i32 = 0;
        while (t < len[[]u8](arm.tags)) {
            let tag: []u8 = get[[]u8](arm.tags, t);
            let v: i32 = 0 - 1;
            if (is_union == 1) { v = ac_union_tag(cg, sty, tag); }
            else if (sty.len > 0) { v = ac_enum_member(cg, sty, tag); }
            if (v < 0 && ac_is_int_text(tag) == 1) { v = ac_parse_i64(tag) as i32; }
            if (v < 0) { ac_err(cg, _zag_str_concat("arm64: unknown switch tag: ", tag)); v = 0; }
            push[AInstr](out, ai_cmp_imm(A_X0(), v as i64));
            push[AInstr](out, ai_je(get[i32](arm_lbls, i)));
            t = t + 1;
        }
        i = i + 1;
    }
    push[AInstr](out, ai_jmp(l_els));
    i = 0;
    while (i < narms) {
        let arm2: SwitchArm = get[SwitchArm](sw.arms, i);
        push[AInstr](out, ai_label(get[i32](arm_lbls, i)));
        let m: i32 = ac_scope_mark(env);
        if (arm2.has_cap == 1) {
            if (is_union == 0) {
                ac_err(cg, "arm64: switch captures need a union subject");
            } else {
                let tag0: []u8 = get[[]u8](arm2.tags, 0);
                let pty: []u8 = ac_union_payload_type(cg, sty, tag0);
                push[AInstr](out, ai_load(A_X10(), A_X29(), subj_d));
                if (ac_is_aggregate(cg, pty) == 1) {
                    let dc1: i32 = ac_slot_alloc_br(env, cg, arm2.cap, _zag_str_concat("*", pty), 1, 0);
                    push[AInstr](out, ai_add_imm(A_X10(), 8));
                    push[AInstr](out, ai_store(A_X29(), dc1, A_X10()));
                } else {
                    let dc2: i32 = ac_slot_alloc_br(env, cg, arm2.cap, pty, 1, 0);
                    push[AInstr](out, ai_load(A_X0(), A_X10(), 8));
                    push[AInstr](out, ai_store(A_X29(), dc2, A_X0()));
                }
            }
        }
        ac_lower_block(out, arm2.body, env, syms, cg);
        ac_scope_end(env, m);
        push[AInstr](out, ai_jmp(l_end));
        i = i + 1;
    }
    push[AInstr](out, ai_label(l_els));
    if (sw.has_els == 1) {
        let me: i32 = ac_scope_mark(env);
        ac_lower_block(out, sw.els_body, env, syms, cg);
        ac_scope_end(env, me);
    }
    push[AInstr](out, ai_label(l_end));
}

// A switch-expression arm's value is its last (usually only) expression.
fn ac_lower_arm_value(out: *ArrayList[AInstr], body: ArrayList[*Node], env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) void {
    if (len[*Node](body) == 0) {
        push[AInstr](out, ai_mov_imm(A_X0(), 0));
        push[AInstr](out, ai_push(A_X0()));
        return;
    }
    // A block arm may perform ordinary statements before yielding its final
    // value, and its final node may be an explicit `return` that exits the
    // containing function (an early guard inside a switch-expression arm).
    // Lower the prefix as real statements; for a trailing return, lower it as a
    // statement and leave an unreachable dummy value so the branch stack shape
    // stays well-formed. Mirrors the x86 backend's cg_lower_arm_value.
    let i: i32 = 0;
    while (i + 1 < len[*Node](body)) {
        ac_lower_stmt(out, get[*Node](body, i), env, syms, cg);
        i = i + 1;
    }
    let last: *Node = get[*Node](body, len[*Node](body) - 1);
    switch (last.*) {
        .estmt => |e| { ac_lower_expr(out, e.expr, env, syms, cg); }
        .defer_ => |d| { push[*Node](&env.*.defer_exprs, d.expr); }
        .ret => |_r| {
            ac_lower_stmt(out, last, env, syms, cg);
            push[AInstr](out, ai_mov_imm(A_X0(), 0));
            push[AInstr](out, ai_push(A_X0()));
        }
        else => { ac_lower_expr(out, last, env, syms, cg); }
    }
}

// switch EXPRESSION: like ac_lower_switch but every arm yields a value into a
// result slot, which is left pushed (same contract as cg_lower_switch_expr).
fn ac_switch_arm_type(body: ArrayList[*Node], env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) []u8 {
    if (len[*Node](body) == 0) { return ""; }
    let last: *Node = get[*Node](body, len[*Node](body) - 1);
    switch (last.*) {
        .estmt => |e| { return ac_expr_type(e.expr, env, syms, cg); }
        .ret => |r| { if (r.has_expr == 1) { return ac_expr_type(r.expr, env, syms, cg); } return ""; }
        else => { return ac_expr_type(last, env, syms, cg); }
    }
    return "";
}

fn ac_switch_expr_type(sw: Switch, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) []u8 {
    let result: []u8 = "";
    let i: i32 = 0;
    while (i < len[SwitchArm](sw.arms)) {
        let arm_ty: []u8 = ac_switch_arm_type(get[SwitchArm](sw.arms, i).body, env, syms, cg);
        if (arm_ty.len > 0) {
            if (result.len == 0) { result = arm_ty; }
            else if (!@strEq(cg_norm_type(result), cg_norm_type(arm_ty))) { return ""; }
        }
        i = i + 1;
    }
    if (sw.has_els == 1) {
        let else_ty: []u8 = ac_switch_arm_type(sw.els_body, env, syms, cg);
        if (else_ty.len > 0) {
            if (result.len == 0) { result = else_ty; }
            else if (!@strEq(cg_norm_type(result), cg_norm_type(else_ty))) { return ""; }
        }
    }
    return result;
}

fn ac_store_switch_result(out: *ArrayList[AInstr], res: i32, words: i32, aggregate: i32) void {
    if (aggregate == 0) {
        push[AInstr](out, ai_pop(A_X0()));
        push[AInstr](out, ai_store(A_X29(), res, A_X0()));
        return;
    }
    push[AInstr](out, ai_pop(A_X10()));
    let word: i32 = 0;
    while (word < words) {
        push[AInstr](out, ai_load(A_X0(), A_X10(), word * 8));
        push[AInstr](out, ai_store(A_X29(), res + word * 8, A_X0()));
        word = word + 1;
    }
}

fn ac_lower_switch_expr(out: *ArrayList[AInstr], sw: Switch, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) void {
    let sty: []u8 = ac_expr_type(sw.subject, env, syms, cg);
    let is_union: i32 = ac_is_union(cg, sty);
    if (ac_is_aggregate(cg, sty) == 1 && is_union == 0) {
        ac_err(cg, "arm64: switch subject must be a scalar, enum, or union");
        push[AInstr](out, ai_mov_imm(A_X0(), 0));
        push[AInstr](out, ai_push(A_X0()));
        return;
    }
    let result_ty: []u8 = ac_switch_expr_type(sw, env, syms, cg);
    let aggregate: i32 = ac_is_aggregate(cg, result_ty);
    let result_words: i32 = 1;
    if (aggregate == 1) { result_words = ac_type_words(cg, result_ty); }
    let res: i32 = ac_slot_scratch(cg, result_words);
    let l_end: i32 = ac_fresh(cg);
    let l_els: i32 = ac_fresh(cg);
    let narms: i32 = len[SwitchArm](sw.arms);
    let arm_lbls: ArrayList[i32] = make[i32](narms + 1);
    let k: i32 = 0;
    while (k < narms) { push[i32](&arm_lbls, ac_fresh(cg)); k = k + 1; }

    let subj_d: i32 = 0;
    ac_lower_expr(out, sw.subject, env, syms, cg);
    if (is_union == 1) {
        subj_d = ac_slot_scratch(cg, 1);
        push[AInstr](out, ai_pop(A_X10()));
        push[AInstr](out, ai_store(A_X29(), subj_d, A_X10()));
        push[AInstr](out, ai_load(A_X0(), A_X10(), 0));
    } else {
        push[AInstr](out, ai_pop(A_X0()));
    }
    let i: i32 = 0;
    while (i < narms) {
        let arm: SwitchArm = get[SwitchArm](sw.arms, i);
        let t: i32 = 0;
        while (t < len[[]u8](arm.tags)) {
            let tag: []u8 = get[[]u8](arm.tags, t);
            let v: i32 = 0 - 1;
            if (is_union == 1) { v = ac_union_tag(cg, sty, tag); }
            else if (sty.len > 0) { v = ac_enum_member(cg, sty, tag); }
            if (v < 0 && ac_is_int_text(tag) == 1) { v = ac_parse_i64(tag) as i32; }
            if (v < 0) { ac_err(cg, _zag_str_concat("arm64: unknown switch tag: ", tag)); v = 0; }
            push[AInstr](out, ai_cmp_imm(A_X0(), v as i64));
            push[AInstr](out, ai_je(get[i32](arm_lbls, i)));
            t = t + 1;
        }
        i = i + 1;
    }
    push[AInstr](out, ai_jmp(l_els));
    i = 0;
    while (i < narms) {
        let arm2: SwitchArm = get[SwitchArm](sw.arms, i);
        push[AInstr](out, ai_label(get[i32](arm_lbls, i)));
        let m: i32 = ac_scope_mark(env);
        if (arm2.has_cap == 1) {
            if (is_union == 0) {
                ac_err(cg, "arm64: switch captures need a union subject");
            } else {
                let tag0: []u8 = get[[]u8](arm2.tags, 0);
                let pty: []u8 = ac_union_payload_type(cg, sty, tag0);
                push[AInstr](out, ai_load(A_X10(), A_X29(), subj_d));
                if (ac_is_aggregate(cg, pty) == 1) {
                    let dc1: i32 = ac_slot_alloc_br(env, cg, arm2.cap, _zag_str_concat("*", pty), 1, 0);
                    push[AInstr](out, ai_add_imm(A_X10(), 8));
                    push[AInstr](out, ai_store(A_X29(), dc1, A_X10()));
                } else {
                    let dc2: i32 = ac_slot_alloc_br(env, cg, arm2.cap, pty, 1, 0);
                    push[AInstr](out, ai_load(A_X0(), A_X10(), 8));
                    push[AInstr](out, ai_store(A_X29(), dc2, A_X0()));
                }
            }
        }
        ac_lower_arm_value(out, arm2.body, env, syms, cg);
        ac_scope_end(env, m);
        ac_store_switch_result(out, res, result_words, aggregate);
        push[AInstr](out, ai_jmp(l_end));
        i = i + 1;
    }
    push[AInstr](out, ai_label(l_els));
    if (sw.has_els == 1) {
        let me: i32 = ac_scope_mark(env);
        ac_lower_arm_value(out, sw.els_body, env, syms, cg);
        ac_scope_end(env, me);
        ac_store_switch_result(out, res, result_words, aggregate);
    } else {
        let word2: i32 = 0;
        while (word2 < result_words) {
            push[AInstr](out, ai_mov_imm(A_X0(), 0));
            push[AInstr](out, ai_store(A_X29(), res + word2 * 8, A_X0()));
            word2 = word2 + 1;
        }
    }
    push[AInstr](out, ai_label(l_end));
    if (aggregate == 1) { ac_emit_lea(out, A_X0(), res); }
    else { push[AInstr](out, ai_load(A_X0(), A_X29(), res)); }
    push[AInstr](out, ai_push(A_X0()));
}

fn ac_lower_block(out: *ArrayList[AInstr], body: ArrayList[*Node], env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) void {
    let i: i32 = 0;
    while (i < len[*Node](body)) {
        ac_lower_stmt(out, get[*Node](body, i), env, syms, cg);
        i = i + 1;
    }
}

// ── functions ────────────────────────────────────────────────────────────────

fn ac_lower_fn(out: *ArrayList[AInstr], f: FnDecl, lbl: i32, syms: ArrayList[AFnSym], cg: *ACg) void {
    let params: ArrayList[Param] = f.params;
    let ret: []u8 = f.ret;
    let body: ArrayList[*Node] = f.body;
    let cabi_export: i32 = ((cg.*.object_mode == 1 && cg_fn_has_annot(f, "@cabi_export") == 1) as i32);
    let darwin_cabi_export: i32 = ((cabi_export == 1 && cg.*.target_os == AC_OS_MACOS()) as i32);
    if (len[*Node](body) == 0) {
        ac_err(cg, "arm64: empty fn body in lower_fn");
        return;
    }

    let epi: i32 = ac_fresh(cg);
    let pre_epi: i32 = ac_fresh(cg);
    cg.*.epilogue = epi;
    cg.*.current_lbl = lbl;
    cg.*.pre_epilogue = pre_epi;
    cg.*.frame_words = 0;
    cg.*.sret_disp = 0;
    cg.*.sret_words = 0;
    cg.*.ret_ty = ret;

    let env: AEnv = ac_env_new();
    // Keep the binding-time displacement for each parameter. Body lowering can
    // legally introduce a same-named local; looking the parameter up again
    // after lowering would then find the shadow and store the incoming ABI
    // register into the wrong frame slot.
    let param_disps: ArrayList[i32] = make[i32](len[Param](params));
    let param_cabi_small_bases: ArrayList[i32] = make[i32](len[Param](params));
    let param_cabi_small_packed_bases: ArrayList[i32] = make[i32](len[Param](params));

    // capturing closure: hidden env ptr arrives FIRST (x0); user args shift by 1
    let is_clos: i32 = 0;
    if (cg_is_clos_name(f.name) == 1 && f.cap_names.len > 0) { is_clos = 1; }
    let shift: i32 = 0;
    let zenv_disp: i32 = 0;
    if (is_clos == 1) {
        shift = 1;
        zenv_disp = ac_slot_scratch(cg, 1);
    }

    // bind params: scalars inline, aggregates by-ref (caller passed a copy's address)
    let pi: i32 = 0;
    while (pi < len[Param](params)) {
        let p: Param = get[Param](params, pi);
        let pty: []u8 = p.pty;
        if (cg_is_fn_type(cg_norm_type(pty)) == 1) { pty = "fat_fn"; }
        let pdisp: i32 = 0;
        if (ac_is_aggregate(cg, pty) == 1) {
            pdisp = ac_slot_alloc_br(&env, cg, p.name, pty, 1, 1);
        } else {
            pdisp = ac_slot_alloc_br(&env, cg, p.name, pty, 1, 0);
        }
        push[i32](&param_disps, pdisp);
        let cabi_small_base: i32 = 0;
        if (darwin_cabi_export == 1 && ac_darwin_cabi_small_aggregate_ok(cg, pty) == 1) {
            cabi_small_base = ac_slot_scratch(cg, ac_type_words(cg, pty));
        }
        push[i32](&param_cabi_small_bases, cabi_small_base);
        let cabi_small_packed_base: i32 = 0;
        if (darwin_cabi_export == 1 && ac_darwin_cabi_small_adapter_ok(cg, pty) == 1) {
            cabi_small_packed_base = ac_slot_scratch(cg, ac_darwin_cabi_gpr_slots(cg, pty));
        }
        push[i32](&param_cabi_small_packed_bases, cabi_small_packed_base);
        pi = pi + 1;
    }
    let darwin_cabi_small_ret_base: i32 = 0;
    let darwin_cabi_small_ret_packed_base: i32 = 0;
    if (ac_is_aggregate(cg, ret) == 1) {
        cg.*.sret_words = ac_type_words(cg, ret);
        cg.*.sret_disp = ac_slot_scratch(cg, 1);
        if (darwin_cabi_export == 1 && ac_darwin_cabi_small_aggregate_ok(cg, ret) == 1) {
            darwin_cabi_small_ret_base = ac_slot_scratch(cg, cg.*.sret_words);
            if (ac_darwin_cabi_small_adapter_ok(cg, ret) == 1) {
                darwin_cabi_small_ret_packed_base = ac_slot_scratch(cg, ac_darwin_cabi_gpr_slots(cg, ret));
            }
        }
    }

    // Allocate the error-return flag slot for defer/errdefer.
    env.is_err_slot = ac_slot_scratch(cg, 1);

    // closure captures: bind each capture to a frame slot NOW (the prologue
    // loads them from the env block after the params are stored).
    let cap_disps: ArrayList[i32] = make[i32](4);
    if (is_clos == 1) {
        let cnames: ArrayList[[]u8] = split_args(f.cap_names);
        let ctypes: ArrayList[[]u8] = split_args(f.cap_types);
        let ci: i32 = 0;
        while (ci < len[[]u8](cnames)) {
            let cname: []u8 = get[[]u8](cnames, ci);
            let cty: []u8 = "";
            if (ci < len[[]u8](ctypes)) { cty = get[[]u8](ctypes, ci); }
            let real_cn: []u8 = cname;
            if (cname.len > 0 && cname[0] == '*') { real_cn = cname[1..]; }
            let cd: i32 = 0;
            if (cname.len > 0 && cname[0] == '*') {
                cd = ac_slot_alloc_br(&env, cg, real_cn, cty, 1, 0);
            } else if (cty.len > 0 && ac_is_aggregate(cg, cty) == 1) {
                if (cg.*.v2_edition == 1) {
                    ac_err(cg, "arm64: captured aggregate closures require a destruction protocol");
                }
                cd = ac_slot_alloc_br(&env, cg, cname, cty, 1, 1);
            } else {
                cd = ac_slot_alloc_br(&env, cg, cname, cty, 1, 0);
            }
            push[i32](&cap_disps, cd);
            ci = ci + 1;
        }
        free[[]u8](&cnames);
        free[[]u8](&ctypes);
    }

    // Lower the body into a scratch list first so cg.frame_words includes
    // every scratch slot (string literals etc.) before the frame is sized.
    let bodyins: ArrayList[AInstr] = make[AInstr](64);
    ac_lower_block(&bodyins, body, &env, syms, cg);

    // Lower defer/errdefer expressions into a scratch list too, so their
    // scratch slots (string literals, etc.) are counted in frame_words and
    // their expression-stack depth is included in the frame sizing.
    let deferins: ArrayList[AInstr] = make[AInstr](32);
    let di_pre: i32 = len[*Node](&env.defer_exprs) - 1;
    while (di_pre >= 0) {
        let dexpr: *Node = get[*Node](&env.defer_exprs, di_pre);
        ac_lower_expr(&deferins, dexpr, &env, syms, cg);
        push[AInstr](&deferins, ai_pop(A_X0()));
        di_pre = di_pre - 1;
    }
    let errdeferins: ArrayList[AInstr] = make[AInstr](32);
    if (len[*Node](&env.errdefer_exprs) > 0) {
        let ei_pre: i32 = len[*Node](&env.errdefer_exprs) - 1;
        while (ei_pre >= 0) {
            let eexpr: *Node = get[*Node](&env.errdefer_exprs, ei_pre);
            ac_lower_expr(&errdeferins, eexpr, &env, syms, cg);
            push[AInstr](&errdeferins, ai_pop(A_X0()));
            ei_pre = ei_pre - 1;
        }
    }

    // Frame: [SP .. SP+expr) expression stack, [X29-8*words .. X29) slots.
    // The expr region is sized from the MEASURED maximum push depth of the
    // lowered body (deep nested expressions exceed any fixed budget), with
    // AC_EXPR_WORDS as the floor and +8 words of headroom.  The defer and
    // errdefer scratch lists are included in the depth scan so the expression
    // stack never overflows during the pre-epilogue cleanup chain.
    let depth: i32 = 0;
    let maxdepth: i32 = 0;
    let sk: i32 = 0;
    while (sk < len[AInstr](bodyins)) {
        let ik: i32 = get[AInstr](bodyins, sk).kind;
        if (ik == AK_PUSH()) {
            depth = depth + 1;
            if (depth > maxdepth) { maxdepth = depth; }
        } else if (ik == AK_POP()) {
            depth = depth - 1;
        }
        sk = sk + 1;
    }
    // The pre-epilogue starts with one push (saving the return value), so
    // measure the defer/errdefer lists from depth=1.
    depth = 1;
    sk = 0;
    while (sk < len[AInstr](deferins)) {
        let ik: i32 = get[AInstr](deferins, sk).kind;
        if (ik == AK_PUSH()) {
            depth = depth + 1;
            if (depth > maxdepth) { maxdepth = depth; }
        } else if (ik == AK_POP()) {
            depth = depth - 1;
        }
        sk = sk + 1;
    }
    depth = 1;
    sk = 0;
    while (sk < len[AInstr](errdeferins)) {
        let ik: i32 = get[AInstr](errdeferins, sk).kind;
        if (ik == AK_PUSH()) {
            depth = depth + 1;
            if (depth > maxdepth) { maxdepth = depth; }
        } else if (ik == AK_POP()) {
            depth = depth - 1;
        }
        sk = sk + 1;
    }
    let expr_words: i32 = AC_EXPR_WORDS();
    if (maxdepth + 8 > expr_words) { expr_words = maxdepth + 8; }
    let frame: i32 = ac_align16(8 * cg.*.frame_words) + ac_align16(8 * expr_words);

    // Header saves x29/x30/x28 — x28 is the expression-stack pointer and
    // must survive calls (every fn repoints it at its own frame). Keep source
    // function entries distinguishable from internal control-flow labels: the
    // ordinary encoders treat this exactly like ai_label, while macOS --hot
    // alone uses it to establish page-granular replacement boundaries.
    push[AInstr](out, ai_fn_label(lbl));
    push[AInstr](out, ai_sub_imm(A_SP(), 32));
    push[AInstr](out, ai_store(A_SP(), 0, A_X29()));
    push[AInstr](out, ai_store(A_SP(), 8, A_X30()));
    push[AInstr](out, ai_store(A_SP(), 16, A_X28()));
    push[AInstr](out, ai_mov_rr(A_X29(), A_SP()));
    push[AInstr](out, ai_sub_imm(A_SP(), frame as i64));
    push[AInstr](out, ai_mov_rr(A_X28(), A_SP()));

    let pj: i32 = 0;
    while (pj < len[Param](params)) {
        let pdisp: i32 = get[i32](param_disps, pj);
        let param_ty: []u8 = get[Param](params, pj).pty;
        if (darwin_cabi_export == 1 && ac_darwin_cabi_small_aggregate_ok(cg, param_ty) == 1) {
            let base: i32 = get[i32](param_cabi_small_bases, pj);
            let packed_base: i32 = get[i32](param_cabi_small_packed_bases, pj);
            let receive_base: i32 = base;
            if (packed_base != 0) { receive_base = packed_base; }
            let words: i32 = ac_darwin_cabi_gpr_slots(cg, param_ty);
            let gp_index: i32 = ac_darwin_cabi_gpr_arg_index(cg, f.name, pj);
            if (ac_darwin_cabi_arg_on_stack(cg, f.name, pj) == 0) {
                let wi: i32 = 0;
                while (wi < words) {
                    push[AInstr](out, ai_store(A_X29(), receive_base + 8 * wi, a_arg_reg(gp_index + wi)));
                    wi = wi + 1;
                }
            } else {
                let offset: i32 = 32 + ac_darwin_cabi_stack_offset(cg, f.name, pj);
                if (packed_base != 0) {
                    ac_emit_darwin_cabi_stack_to_packed(out, offset, packed_base,
                        ac_darwin_cabi_aggregate_size(cg, param_ty));
                } else {
                    let wi: i32 = 0;
                    while (wi < words) {
                        push[AInstr](out, ai_load(A_X9(), A_X29(), offset + 8 * wi));
                        push[AInstr](out, ai_store(A_X29(), base + 8 * wi, A_X9()));
                        wi = wi + 1;
                    }
                }
            }
            if (packed_base != 0) {
                ac_emit_lea(out, A_X9(), packed_base);
                ac_emit_lea(out, A_X10(), base);
                ac_emit_darwin_cabi_unpack_small(out, cg, param_ty, A_X9(), A_X10());
            }
            ac_emit_lea(out, A_X9(), base);
            push[AInstr](out, ai_store(A_X29(), pdisp, A_X9()));
        } else if (darwin_cabi_export == 1 && ac_cabi_is_float(param_ty) == 1) {
            let fp_index: i32 = ac_darwin_cabi_fpr_arg_index(cg, f.name, pj);
            if (ac_cabi_is_f64(param_ty) == 1) {
                if (fp_index < 8) {
                    push[AInstr](out, ai_fmov_xd(A_X9(), fp_index));
                } else {
                    push[AInstr](out, ai_load(A_X9(), A_X29(), 32 + ac_darwin_cabi_stack_offset(cg, f.name, pj)));
                }
            } else {
                if (fp_index < 8) {
                    push[AInstr](out, ai_fcvt_ds(31, fp_index));
                    push[AInstr](out, ai_fmov_xd(A_X9(), 31));
                } else {
                    push[AInstr](out, ai_loadw(A_X9(), A_X29(), 32 + ac_darwin_cabi_stack_offset(cg, f.name, pj)));
                    push[AInstr](out, ai_fmov_sw(31, A_X9()));
                    push[AInstr](out, ai_fcvt_ds(31, 31));
                    push[AInstr](out, ai_fmov_xd(A_X9(), 31));
                }
            }
            push[AInstr](out, ai_store(A_X29(), pdisp, A_X9()));
        } else if (darwin_cabi_export == 1) {
            let gp_index: i32 = ac_darwin_cabi_gpr_arg_index(cg, f.name, pj);
            if (gp_index < 8) {
                let reg: i32 = a_arg_reg(gp_index);
                ac_emit_cabi_int_normalize(out, reg, param_ty);
                push[AInstr](out, ai_store(A_X29(), pdisp, reg));
            } else {
                let offset: i32 = 32 + ac_darwin_cabi_stack_offset(cg, f.name, pj);
                let width: i32 = ac_darwin_cabi_leaf_size(cg, param_ty);
                if (width == 1) { push[AInstr](out, ai_loadb(A_X9(), A_X29(), offset)); }
                else if (width == 2) { push[AInstr](out, ai_loadh(A_X9(), A_X29(), offset)); }
                else if (width == 4) { push[AInstr](out, ai_loadw(A_X9(), A_X29(), offset)); }
                else { push[AInstr](out, ai_load(A_X9(), A_X29(), offset)); }
                ac_emit_cabi_int_normalize(out, A_X9(), param_ty);
                push[AInstr](out, ai_store(A_X29(), pdisp, A_X9()));
            }
        } else {
            let reg: i32 = a_arg_reg(pj + shift);
            if (reg >= 0) {
                if (cabi_export == 1) { ac_emit_cabi_int_normalize(out, reg, param_ty); }
                push[AInstr](out, ai_store(A_X29(), pdisp, reg));
            } else {
                push[AInstr](out, ai_load(A_X9(), A_X29(), 32 + 8 * (pj + shift - 8)));
                if (cabi_export == 1) { ac_emit_cabi_int_normalize(out, A_X9(), param_ty); }
                push[AInstr](out, ai_store(A_X29(), pdisp, A_X9()));
            }
        }
        pj = pj + 1;
    }
    if (is_clos == 1) {
        push[AInstr](out, ai_store(A_X29(), zenv_disp, A_X0()));
        push[AInstr](out, ai_load(A_X10(), A_X29(), zenv_disp));
        let ck: i32 = 0;
        while (ck < len[i32](cap_disps)) {
            push[AInstr](out, ai_load(A_X9(), A_X10(), 8 * ck));
            push[AInstr](out, ai_store(A_X29(), get[i32](cap_disps, ck), A_X9()));
            ck = ck + 1;
        }
    }
    if (cg.*.sret_words > 0) {
        if (darwin_cabi_small_ret_base != 0) {
            ac_emit_lea(out, A_X9(), darwin_cabi_small_ret_base);
            push[AInstr](out, ai_store(A_X29(), cg.*.sret_disp, A_X9()));
        } else {
            push[AInstr](out, ai_store(A_X29(), cg.*.sret_disp, A_X8()));
        }
    }
    // Initialize the error-return flag to 0 (success) for defer/errdefer.
    push[AInstr](out, ai_mov_imm(A_X9(), 0));
    push[AInstr](out, ai_store(A_X29(), env.is_err_slot, A_X9()));
    // Async declarations are discovered while every control-flow arm is
    // lowered. Slots in arms that do not execute must remain null so function-
    // exit cleanup never interprets stale stack contents as task handles.
    if (len[i32](&env.async_task_disps) > 0) {
        push[AInstr](out, ai_mov_imm(A_X9(), 0));
        let ati_init: i32 = 0;
        while (ati_init < len[i32](&env.async_task_disps)) {
            push[AInstr](out, ai_store(A_X29(), get[i32](&env.async_task_disps, ati_init), A_X9()));
            ati_init = ati_init + 1;
        }
    }

    let bi: i32 = 0;
    while (bi < len[AInstr](bodyins)) {
        push[AInstr](out, get[AInstr](bodyins, bi));
        bi = bi + 1;
    }

    // Fall-through: success return → set is_err=0, jump to pre_epilogue cleanup.
    push[AInstr](out, ai_mov_imm(A_X9(), 0));
    push[AInstr](out, ai_store(A_X29(), env.is_err_slot, A_X9()));
    push[AInstr](out, ai_jmp(pre_epi));

    // ── pre_epilogue: defer/errdefer cleanup chain ──
    // All return paths jump here. X0 holds the return value (scalar) or sret
    // pointer (aggregate). Save it, run defers, conditionally run errdefers,
    // restore it, then fall through to the real epilogue.
    push[AInstr](out, ai_label(pre_epi));
    // Save return value on the expression stack.
    push[AInstr](out, ai_push(A_X0()));
    // Run all defer expressions (unconditional), LIFO order.
    let di_copy: i32 = 0;
    while (di_copy < len[AInstr](deferins)) {
        push[AInstr](out, get[AInstr](deferins, di_copy));
        di_copy = di_copy + 1;
    }
    // Run errdefer expressions only if is_err_slot != 0.
    if (len[*Node](&env.errdefer_exprs) > 0) {
        let skip_err: i32 = ac_fresh(cg);
        push[AInstr](out, ai_load(A_X9(), A_X29(), env.is_err_slot));
        push[AInstr](out, ai_cmp_imm(A_X9(), 0));
        push[AInstr](out, ai_je(skip_err));
        let ei_copy: i32 = 0;
        while (ei_copy < len[AInstr](errdeferins)) {
            push[AInstr](out, get[AInstr](errdeferins, ei_copy));
            ei_copy = ei_copy + 1;
        }
        push[AInstr](out, ai_label(skip_err));
    }
    if (len[i32](&env.async_task_disps) > 0) {
        let join_import: i32 = ac_find_extern(syms, "pthread_join");
        if (cg.*.target_os != AC_OS_MACOS() || join_import < 0) {
            ac_err(cg, "arm64: compiler-owned async cleanup requires pthread_join on macOS");
        } else {
            let ati: i32 = len[i32](&env.async_task_disps) - 1;
            while (ati >= 0) {
                let task_disp: i32 = get[i32](&env.async_task_disps, ati);
                let task_done: i32 = ac_fresh(cg);
                let joined: i32 = ac_fresh(cg);
                let unmapped: i32 = ac_fresh(cg);
                push[AInstr](out, ai_load(A_X10(), A_X29(), task_disp));
                push[AInstr](out, ai_cmp_imm(A_X10(), 0));
                push[AInstr](out, ai_je(task_done));
                push[AInstr](out, ai_mov_imm(A_X9(), 1));
                push[AInstr](out, ai_store(A_X10(), 24, A_X9()));
                push[AInstr](out, ai_load(A_X0(), A_X10(), 0));
                push[AInstr](out, ai_mov_imm(A_X1(), 0));
                push[AInstr](out, ai_extern_call(join_import));
                push[AInstr](out, ai_cmp_imm(A_X0(), 0));
                push[AInstr](out, ai_je(joined));
                ac_emit_panic(out, "zag runtime: pthread_join failed", joined, cg);
                push[AInstr](out, ai_load(A_X0(), A_X29(), task_disp));
                push[AInstr](out, ai_mov_imm(A_X1(), 4096));
                push[AInstr](out, ai_syscall(215));
                push[AInstr](out, ai_cmp_imm(A_X0(), 0));
                push[AInstr](out, ai_je(unmapped));
                ac_emit_panic(out, "zag runtime: thread handle unmap failed", unmapped, cg);
                push[AInstr](out, ai_mov_imm(A_X9(), 0));
                push[AInstr](out, ai_store(A_X29(), task_disp, A_X9()));
                push[AInstr](out, ai_label(task_done));
                ati = ati - 1;
            }
        }
    }
    // Restore return value.
    push[AInstr](out, ai_pop(A_X0()));

    push[AInstr](out, ai_label(epi));
    if (darwin_cabi_small_ret_base != 0) {
        let abi_ret_words: i32 = ac_darwin_cabi_gpr_slots(cg, ret);
        let return_base: i32 = darwin_cabi_small_ret_base;
        if (darwin_cabi_small_ret_packed_base != 0) {
            ac_emit_lea(out, A_X9(), darwin_cabi_small_ret_base);
            ac_emit_lea(out, A_X10(), darwin_cabi_small_ret_packed_base);
            ac_emit_darwin_cabi_pack_small(out, cg, ret, A_X9(), A_X10());
            return_base = darwin_cabi_small_ret_packed_base;
        }
        push[AInstr](out, ai_load(A_X9(), A_X29(), return_base));
        if (abi_ret_words > 1) {
            push[AInstr](out, ai_load(A_X10(), A_X29(), return_base + 8));
        }
    }
    push[AInstr](out, ai_mov_rr(A_SP(), A_X29()));
    push[AInstr](out, ai_load(A_X29(), A_SP(), 0));
    push[AInstr](out, ai_load(A_X30(), A_SP(), 8));
    push[AInstr](out, ai_load(A_X28(), A_SP(), 16));
    push[AInstr](out, ai_add_imm(A_SP(), 32));
    if (darwin_cabi_small_ret_base != 0) {
        let abi_ret_words: i32 = ac_darwin_cabi_gpr_slots(cg, ret);
        push[AInstr](out, ai_mov_rr(A_X0(), A_X9()));
        if (abi_ret_words > 1) { push[AInstr](out, ai_mov_rr(A_X1(), A_X10())); }
    } else if (darwin_cabi_export == 1 && ac_cabi_is_float(ret) == 1) {
        if (ac_cabi_is_f64(ret) == 1) {
            push[AInstr](out, ai_fmov_dx(0, A_X0()));
        } else {
            push[AInstr](out, ai_fmov_dx(31, A_X0()));
            push[AInstr](out, ai_fcvt_sd(0, 31));
        }
    } else if (cabi_export == 1) { ac_emit_cabi_int_normalize(out, A_X0(), ret); }
    push[AInstr](out, ai_ret());
    free[i32](&param_disps);
    free[i32](&param_cabi_small_bases);
    free[i32](&param_cabi_small_packed_bases);
    free[i32](&cap_disps);
    free[AInstr](&bodyins);
    free[AInstr](&deferins);
    free[AInstr](&errdeferins);
    ac_env_dispose(&env);
}

// __print_int(x0=n): decimal + write(1,buf,len)  syscall write=64
fn ac_emit_print_int(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    let l_pos: i32 = ac_fresh(cg);
    let l_loop: i32 = ac_fresh(cg);
    let l_zero: i32 = ac_fresh(cg);
    let l_after: i32 = ac_fresh(cg);
    let l_nosign: i32 = ac_fresh(cg);
    let l_wtop: i32 = ac_fresh(cg);
    let l_wdone: i32 = ac_fresh(cg);

    // Frame: [SP..SP+64) decimal buffer, [SP+64..) digit push area (≤21 words).
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_sub_imm(A_SP(), 32));
    push[AInstr](out, ai_store(A_SP(), 0, A_X29()));
    push[AInstr](out, ai_store(A_SP(), 8, A_X30()));
    push[AInstr](out, ai_store(A_SP(), 16, A_X28()));
    push[AInstr](out, ai_mov_rr(A_X29(), A_SP()));
    push[AInstr](out, ai_sub_imm(A_SP(), 256));
    push[AInstr](out, ai_mov_rr(A_X28(), A_SP()));
    push[AInstr](out, ai_add_imm(A_X28(), 64));

    push[AInstr](out, ai_mov_rr(A_X9(), A_X0()));
    push[AInstr](out, ai_mov_imm(A_X10(), 0));
    push[AInstr](out, ai_cmp_imm(A_X9(), 0));
    push[AInstr](out, ai_jge(l_pos));
    push[AInstr](out, ai_mov_imm(A_X10(), 1));
    push[AInstr](out, ai_label(l_pos));

    push[AInstr](out, ai_mov_imm(A_X11(), 0));
    push[AInstr](out, ai_cmp_imm(A_X9(), 0));
    push[AInstr](out, ai_je(l_zero));

    push[AInstr](out, ai_label(l_loop));
    push[AInstr](out, ai_cmp_imm(A_X9(), 0));
    push[AInstr](out, ai_je(l_after));
    push[AInstr](out, ai_mov_imm(A_X12(), 10));
    push[AInstr](out, ai_sdiv(A_X13(), A_X9(), A_X12()));
    push[AInstr](out, ai_mul(A_X14(), A_X13(), A_X12()));
    push[AInstr](out, ai_sub(A_X14(), A_X9()));
    push[AInstr](out, ai_mov_rr(A_X9(), A_X13()));
    push[AInstr](out, ai_cmp_imm(A_X14(), 0));
    let l_pdig: i32 = ac_fresh(cg);
    push[AInstr](out, ai_jge(l_pdig));
    push[AInstr](out, ai_neg(A_X14(), A_X14()));
    push[AInstr](out, ai_label(l_pdig));
    push[AInstr](out, ai_add_imm(A_X14(), 48));
    push[AInstr](out, ai_push(A_X14()));
    push[AInstr](out, ai_add_imm(A_X11(), 1));
    push[AInstr](out, ai_jmp(l_loop));

    push[AInstr](out, ai_label(l_zero));
    push[AInstr](out, ai_mov_imm(A_X14(), 48));
    push[AInstr](out, ai_push(A_X14()));
    push[AInstr](out, ai_mov_imm(A_X11(), 1));

    push[AInstr](out, ai_label(l_after));
    push[AInstr](out, ai_cmp_imm(A_X10(), 0));
    push[AInstr](out, ai_je(l_nosign));
    push[AInstr](out, ai_mov_imm(A_X14(), 45));
    push[AInstr](out, ai_push(A_X14()));
    push[AInstr](out, ai_add_imm(A_X11(), 1));
    push[AInstr](out, ai_label(l_nosign));

    push[AInstr](out, ai_mov_rr(A_X1(), A_SP()));
    push[AInstr](out, ai_mov_rr(A_X12(), A_X11()));
    push[AInstr](out, ai_label(l_wtop));
    push[AInstr](out, ai_cmp_imm(A_X12(), 0));
    push[AInstr](out, ai_je(l_wdone));
    push[AInstr](out, ai_pop(A_X13()));
    push[AInstr](out, ai_store(A_X1(), 0, A_X13()));
    push[AInstr](out, ai_add_imm(A_X1(), 1));
    push[AInstr](out, ai_sub_imm(A_X12(), 1));
    push[AInstr](out, ai_jmp(l_wtop));
    push[AInstr](out, ai_label(l_wdone));

    push[AInstr](out, ai_mov_imm(A_X0(), 1));
    push[AInstr](out, ai_mov_rr(A_X1(), A_SP()));
    push[AInstr](out, ai_mov_rr(A_X2(), A_X11()));
    push[AInstr](out, ai_syscall(64));

    push[AInstr](out, ai_mov_rr(A_SP(), A_X29()));
    push[AInstr](out, ai_load(A_X29(), A_SP(), 0));
    push[AInstr](out, ai_load(A_X30(), A_SP(), 8));
    push[AInstr](out, ai_load(A_X28(), A_SP(), 16));
    push[AInstr](out, ai_add_imm(A_SP(), 32));
    push[AInstr](out, ai_ret());
}

// __print_uint(x0=n): UNSIGNED decimal + write(1,buf,len) syscall write=64.
// Same skeleton as __print_int minus sign handling; udiv keeps bit-63-set
// values printing their exact unsigned magnitude (up to 20 digits).
fn ac_emit_print_uint(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    let l_loop: i32 = ac_fresh(cg);
    let l_zero: i32 = ac_fresh(cg);
    let l_after: i32 = ac_fresh(cg);
    let l_wtop: i32 = ac_fresh(cg);
    let l_wdone: i32 = ac_fresh(cg);

    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_sub_imm(A_SP(), 32));
    push[AInstr](out, ai_store(A_SP(), 0, A_X29()));
    push[AInstr](out, ai_store(A_SP(), 8, A_X30()));
    push[AInstr](out, ai_store(A_SP(), 16, A_X28()));
    push[AInstr](out, ai_mov_rr(A_X29(), A_SP()));
    push[AInstr](out, ai_sub_imm(A_SP(), 256));
    push[AInstr](out, ai_mov_rr(A_X28(), A_SP()));
    push[AInstr](out, ai_add_imm(A_X28(), 64));

    push[AInstr](out, ai_mov_rr(A_X9(), A_X0()));
    push[AInstr](out, ai_mov_imm(A_X11(), 0));
    push[AInstr](out, ai_cmp_imm(A_X9(), 0));
    push[AInstr](out, ai_je(l_zero));

    push[AInstr](out, ai_label(l_loop));
    push[AInstr](out, ai_cmp_imm(A_X9(), 0));
    push[AInstr](out, ai_je(l_after));
    push[AInstr](out, ai_mov_imm(A_X12(), 10));
    push[AInstr](out, ai_udiv(A_X13(), A_X9(), A_X12()));
    push[AInstr](out, ai_mul(A_X14(), A_X13(), A_X12()));
    push[AInstr](out, ai_sub(A_X14(), A_X9()));   // q*10 - n == -remainder
    push[AInstr](out, ai_neg(A_X14(), A_X14()));  // unsigned remainder is 0..9
    push[AInstr](out, ai_mov_rr(A_X9(), A_X13()));
    push[AInstr](out, ai_add_imm(A_X14(), 48));
    push[AInstr](out, ai_push(A_X14()));
    push[AInstr](out, ai_add_imm(A_X11(), 1));
    push[AInstr](out, ai_jmp(l_loop));

    push[AInstr](out, ai_label(l_zero));
    push[AInstr](out, ai_mov_imm(A_X14(), 48));
    push[AInstr](out, ai_push(A_X14()));
    push[AInstr](out, ai_mov_imm(A_X11(), 1));

    push[AInstr](out, ai_label(l_after));
    push[AInstr](out, ai_mov_rr(A_X1(), A_SP()));
    push[AInstr](out, ai_mov_rr(A_X12(), A_X11()));
    push[AInstr](out, ai_label(l_wtop));
    push[AInstr](out, ai_cmp_imm(A_X12(), 0));
    push[AInstr](out, ai_je(l_wdone));
    push[AInstr](out, ai_pop(A_X13()));
    push[AInstr](out, ai_store(A_X1(), 0, A_X13()));
    push[AInstr](out, ai_add_imm(A_X1(), 1));
    push[AInstr](out, ai_sub_imm(A_X12(), 1));
    push[AInstr](out, ai_jmp(l_wtop));
    push[AInstr](out, ai_label(l_wdone));

    push[AInstr](out, ai_mov_imm(A_X0(), 1));
    push[AInstr](out, ai_mov_rr(A_X1(), A_SP()));
    push[AInstr](out, ai_mov_rr(A_X2(), A_X11()));
    push[AInstr](out, ai_syscall(64));

    push[AInstr](out, ai_mov_rr(A_SP(), A_X29()));
    push[AInstr](out, ai_load(A_X29(), A_SP(), 0));
    push[AInstr](out, ai_load(A_X30(), A_SP(), 8));
    push[AInstr](out, ai_load(A_X28(), A_SP(), 16));
    push[AInstr](out, ai_add_imm(A_SP(), 32));
    push[AInstr](out, ai_ret());
}

// __print_str(x1=ptr, x2=len): write(1, ptr, len)
fn ac_emit_print_str(out: *ArrayList[AInstr], lbl: i32) void {
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_mov_imm(A_X0(), 1));
    push[AInstr](out, ai_syscall(64));
    push[AInstr](out, ai_ret());
}

// ARM64's ordinary heap mirrors the x86 physical policy: sixteen segregated
// size classes backed by bounded 1 MiB arenas, plus dedicated mappings above
// 512 KiB. Unchecked free recycles small blocks and munmaps large blocks;
// checked/sanitizer execution quarantines small addresses to preserve its
// pointer-lifetime contract. Exact request bytes remain in the in-band header
// for realloc and logical telemetry. Allocator metadata lives in writable data
// ── safety checks (edition-2027 --safety=checked / --sanitize=memory) ──────
// Print msg to stderr (fd=2) then exit(1). Mirrors cg_emit_panic but for AArch64.
fn ac_emit_panic(out: *ArrayList[AInstr], msg: []u8, lbl_past: i32, cg: *ACg) void {
    let off: i32 = len[u8](cg.*.data.*);
    let mi: i32 = 0;
    while (mi < msg.len) { push[u8](cg.*.data, msg[mi]); mi = mi + 1; }
    push[u8](cg.*.data, 10);   // '\n'
    let mlen: i32 = len[u8](cg.*.data.*) - off;
    // write(2, data+off, mlen). The target encoder maps the syscall identity
    // and emits a PIE-relative data address when producing Mach-O.
    push[AInstr](out, ai_mov_imm(A_X0(), 2));
    push[AInstr](out, ai_data_addr(A_X1(), off));
    push[AInstr](out, ai_mov_imm(A_X2(), mlen as i64));
    push[AInstr](out, ai_syscall(64));
    // exit(1) — AArch64 syscall 93
    push[AInstr](out, ai_mov_imm(A_X0(), 1));
    push[AInstr](out, ai_syscall(93));
    push[AInstr](out, ai_label(lbl_past));   // unreachable, but keeps structure
}

// ALLOC_ACCESS_REGISTRY constants (shared with x86 backend via ncodegen.zag)
fn ac_alloc_access_registry_offset() i32 { return 66560; }
fn ac_alloc_access_registry_cap() i32 { return 3072; }
// Darwin wait/wake runtime state follows the largest checked-access registry:
// init state @+0, pthread_mutex_t @+8 (64 bytes on LP64 Darwin), list head @+72.
fn ac_darwin_wait_state_offset() i32 { return 115712; }
fn ac_darwin_wait_state_size() i32 { return 80; }

// Match the x86 native allocator's bounded physical layout. The first two
// words are the current arena cursor/end, the next sixteen words are the
// segregated free-list heads, and the large-allocation table keeps freed
// mapping tombstones readable after munmap has made ptr-8 inaccessible.
fn ac_allocator_heads_offset() i32 { return 16; }
fn ac_large_alloc_registry_offset() i32 { return 33792; }
fn ac_large_alloc_registry_cap() i32 { return 2048; }
fn ac_allocator_max_small() i64 { return 524288; } // 16 << 15
fn ac_allocator_arena_size() i64 { return 1048576; }
fn ac_allocator_zero_header() i64 { return 9223372036854775807; }
fn ac_sanitize_redzone_size() i64 { return 16; }
fn ac_allocator_page_size(cg: *ACg) i64 {
    if (cg.*.target_os == AC_OS_MACOS()) { return 16384; }
    return 4096;
}

// Native logical-allocation telemetry. ELF uses the fixed BSS base shared
// with x86. Mach-O cannot address that low fixed mapping under __PAGEZERO, so
// it reserves the identical offsets in writable, PIE-relative __DATA.
fn ac_allocator_count_offset() i32 { return 144; }
fn ac_allocator_live_offset() i32 { return 152; }
fn ac_allocator_peak_offset() i32 { return 160; }

fn ac_emit_allocator_word_address(out: *ArrayList[AInstr], cg: *ACg,
                                  reg: i32, offset: i32) void {
    if (cg.*.target_os == AC_OS_MACOS()) {
        push[AInstr](out, ai_data_addr(reg, offset));
    } else {
        push[AInstr](out, ai_mov_imm(reg, BSS_VBASE() + (offset as i64)));
    }
}

// Register a dedicated mapping before it is returned. Input x0=user pointer,
// x1=exact payload size; both are preserved. A matching tombstone can be
// revived in unchecked execution when the kernel reuses the virtual address.
// Checked execution subsequently applies its stricter access-registry
// quarantine, which deliberately rejects pointer-address ABA reuse.
fn ac_emit_large_alloc_acquire(out: *ArrayList[AInstr], cg: *ACg) void {
    let loop: i32 = ac_fresh(cg);
    let next: i32 = ac_fresh(cg);
    let insert: i32 = ac_fresh(cg);
    let overlap: i32 = ac_fresh(cg);
    let after_overlap: i32 = ac_fresh(cg);
    let full: i32 = ac_fresh(cg);
    let after_full: i32 = ac_fresh(cg);
    let done: i32 = ac_fresh(cg);
    push[AInstr](out, ai_mov_imm(A_X8(), 0));
    push[AInstr](out, ai_label(loop));
    push[AInstr](out, ai_cmp_imm(A_X8(), ac_large_alloc_registry_cap()));
    push[AInstr](out, ai_jge(full));
    push[AInstr](out, ai_mov_rr(A_X10(), A_X8()));
    push[AInstr](out, ai_lsl_imm(A_X10(), A_X10(), 4));
    ac_emit_allocator_word_address(out, cg, A_X11(),
        ac_large_alloc_registry_offset());
    push[AInstr](out, ai_add(A_X10(), A_X11()));
    push[AInstr](out, ai_load(A_X12(), A_X10(), 0));
    push[AInstr](out, ai_cmp_imm(A_X12(), 0));
    push[AInstr](out, ai_je(insert));
    push[AInstr](out, ai_jl(next));
    push[AInstr](out, ai_cmp(A_X12(), A_X0()));
    push[AInstr](out, ai_je(overlap));
    push[AInstr](out, ai_jmp(next));
    push[AInstr](out, ai_label(next));
    // A negative pointer is a tombstone. Revive only the exact address; every
    // other tombstone remains available for deterministic repeated-free checks.
    push[AInstr](out, ai_cmp_imm(A_X12(), 0));
    let advance: i32 = ac_fresh(cg);
    push[AInstr](out, ai_jge(advance));
    push[AInstr](out, ai_neg(A_X13(), A_X12()));
    push[AInstr](out, ai_cmp(A_X13(), A_X0()));
    push[AInstr](out, ai_je(insert));
    push[AInstr](out, ai_label(advance));
    push[AInstr](out, ai_add_imm(A_X8(), 1));
    push[AInstr](out, ai_jmp(loop));
    push[AInstr](out, ai_label(insert));
    push[AInstr](out, ai_store(A_X10(), 0, A_X0()));
    push[AInstr](out, ai_store(A_X10(), 8, A_X1()));
    push[AInstr](out, ai_jmp(done));
    push[AInstr](out, ai_label(overlap));
    ac_emit_panic(out, "zag runtime: overlapping live large allocation",
        after_overlap, cg);
    push[AInstr](out, ai_jmp(done));
    push[AInstr](out, ai_label(full));
    ac_emit_panic(out, "zag runtime: large allocation registry exhausted",
        after_full, cg);
    push[AInstr](out, ai_label(done));
}

// Probe the dedicated-mapping registry without touching ptr-8. Input
// ptr_reg=pointer. Output x8=1 live, -1 freed, 0 absent; x9=size and x10=row
// for a matching entry. The source pointer is preserved.
fn ac_emit_large_alloc_probe(out: *ArrayList[AInstr], cg: *ACg,
                             ptr_reg: i32) void {
    let loop: i32 = ac_fresh(cg);
    let next: i32 = ac_fresh(cg);
    let live: i32 = ac_fresh(cg);
    let freed: i32 = ac_fresh(cg);
    let absent: i32 = ac_fresh(cg);
    let done: i32 = ac_fresh(cg);
    push[AInstr](out, ai_mov_imm(A_X8(), 0));
    push[AInstr](out, ai_label(loop));
    push[AInstr](out, ai_cmp_imm(A_X8(), ac_large_alloc_registry_cap()));
    push[AInstr](out, ai_jge(absent));
    push[AInstr](out, ai_mov_rr(A_X10(), A_X8()));
    push[AInstr](out, ai_lsl_imm(A_X10(), A_X10(), 4));
    ac_emit_allocator_word_address(out, cg, A_X11(),
        ac_large_alloc_registry_offset());
    push[AInstr](out, ai_add(A_X10(), A_X11()));
    push[AInstr](out, ai_load(A_X12(), A_X10(), 0));
    push[AInstr](out, ai_cmp_imm(A_X12(), 0));
    push[AInstr](out, ai_je(absent));
    push[AInstr](out, ai_jl(next));
    push[AInstr](out, ai_cmp(A_X12(), ptr_reg));
    push[AInstr](out, ai_je(live));
    push[AInstr](out, ai_jmp(next));
    push[AInstr](out, ai_label(next));
    push[AInstr](out, ai_cmp_imm(A_X12(), 0));
    let advance: i32 = ac_fresh(cg);
    push[AInstr](out, ai_jge(advance));
    push[AInstr](out, ai_neg(A_X13(), A_X12()));
    push[AInstr](out, ai_cmp(A_X13(), ptr_reg));
    push[AInstr](out, ai_je(freed));
    push[AInstr](out, ai_label(advance));
    push[AInstr](out, ai_add_imm(A_X8(), 1));
    push[AInstr](out, ai_jmp(loop));
    push[AInstr](out, ai_label(live));
    push[AInstr](out, ai_load(A_X9(), A_X10(), 8));
    push[AInstr](out, ai_mov_imm(A_X8(), 1));
    push[AInstr](out, ai_jmp(done));
    push[AInstr](out, ai_label(freed));
    push[AInstr](out, ai_load(A_X9(), A_X10(), 8));
    push[AInstr](out, ai_mov_imm(A_X8(), 0 - 1));
    push[AInstr](out, ai_jmp(done));
    push[AInstr](out, ai_label(absent));
    push[AInstr](out, ai_mov_imm(A_X8(), 0));
    push[AInstr](out, ai_mov_imm(A_X9(), 0));
    push[AInstr](out, ai_mov_imm(A_X10(), 0));
    push[AInstr](out, ai_label(done));
}

// A fresh small arena can cover several previously unmapped dedicated bases,
// including bases in its interior. Retired large pointers anywhere in that
// interval must not misclassify a later live small block as already freed.
// ptr_reg is the arena's first payload (base+8). Neutralize every tombstone in
// [ptr_reg, base+arena_size), preserving live entries and outside tombstones.
// Keep each cleared row nonzero so the registry's contiguous-prefix scan
// remains valid; address 1 cannot be mapped on either supported ARM64 host.
// Scratch is x8-x13. Preserve the refill's x0, x6, x7, and x14 values.
fn ac_emit_large_alloc_forget_small_alias(out: *ArrayList[AInstr], cg: *ACg,
                                           ptr_reg: i32) void {
    let loop: i32 = ac_fresh(cg);
    let next: i32 = ac_fresh(cg);
    let done: i32 = ac_fresh(cg);
    push[AInstr](out, ai_mov_rr(A_X9(), ptr_reg));
    push[AInstr](out, ai_add_imm(A_X9(), ac_allocator_arena_size() - 8));
    push[AInstr](out, ai_mov_imm(A_X8(), 0));
    push[AInstr](out, ai_label(loop));
    push[AInstr](out, ai_cmp_imm(A_X8(), ac_large_alloc_registry_cap()));
    push[AInstr](out, ai_jge(done));
    push[AInstr](out, ai_mov_rr(A_X10(), A_X8()));
    push[AInstr](out, ai_lsl_imm(A_X10(), A_X10(), 4));
    ac_emit_allocator_word_address(out, cg, A_X11(),
        ac_large_alloc_registry_offset());
    push[AInstr](out, ai_add(A_X10(), A_X11()));
    push[AInstr](out, ai_load(A_X12(), A_X10(), 0));
    push[AInstr](out, ai_cmp_imm(A_X12(), 0));
    push[AInstr](out, ai_je(done));
    push[AInstr](out, ai_jg(next));
    push[AInstr](out, ai_neg(A_X13(), A_X12()));
    push[AInstr](out, ai_cmp(A_X13(), ptr_reg));
    push[AInstr](out, ai_jl(next));
    push[AInstr](out, ai_cmp(A_X13(), A_X9()));
    push[AInstr](out, ai_jge(next));
    push[AInstr](out, ai_mov_imm(A_X12(), 0 - 1));
    push[AInstr](out, ai_store(A_X10(), 0, A_X12()));
    push[AInstr](out, ai_mov_imm(A_X12(), 0));
    push[AInstr](out, ai_store(A_X10(), 8, A_X12()));
    push[AInstr](out, ai_label(next));
    push[AInstr](out, ai_add_imm(A_X8(), 1));
    push[AInstr](out, ai_jmp(loop));
    push[AInstr](out, ai_label(done));
}

fn ac_emit_alloc_access_registry_address(out: *ArrayList[AInstr], cg: *ACg,
                                         reg: i32) void {
    if (cg.*.target_os == AC_OS_MACOS()) {
        push[AInstr](out, ai_data_addr(reg, ac_alloc_access_registry_offset()));
    } else {
        push[AInstr](out, ai_mov_imm(reg,
            BSS_VBASE() + (ac_alloc_access_registry_offset() as i64)));
    }
}

// Record one successful logical allocation of size_reg requested payload
// bytes. Physical class capacity and dedicated mapping length are intentionally
// excluded so the established ARM64 telemetry remains exact and stable.
fn ac_emit_allocator_acquire(out: *ArrayList[AInstr], cg: *ACg,
                             size_reg: i32) void {
    let no_peak: i32 = ac_fresh(cg);
    ac_emit_allocator_word_address(out, cg, A_X10(), ac_allocator_count_offset());
    push[AInstr](out, ai_load(A_X8(), A_X10(), 0));
    push[AInstr](out, ai_add_imm(A_X8(), 1));
    push[AInstr](out, ai_store(A_X10(), 0, A_X8()));
    ac_emit_allocator_word_address(out, cg, A_X10(), ac_allocator_live_offset());
    push[AInstr](out, ai_load(A_X8(), A_X10(), 0));
    push[AInstr](out, ai_add(A_X8(), size_reg));
    push[AInstr](out, ai_store(A_X10(), 0, A_X8()));
    ac_emit_allocator_word_address(out, cg, A_X10(), ac_allocator_peak_offset());
    push[AInstr](out, ai_load(A_X11(), A_X10(), 0));
    push[AInstr](out, ai_cmp(A_X8(), A_X11()));
    push[AInstr](out, ai_jle(no_peak));
    push[AInstr](out, ai_store(A_X10(), 0, A_X8()));
    push[AInstr](out, ai_label(no_peak));
}

fn ac_emit_allocator_release_size(out: *ArrayList[AInstr], cg: *ACg,
                                  size_reg: i32) void {
    ac_emit_allocator_word_address(out, cg, A_X10(), ac_allocator_live_offset());
    push[AInstr](out, ai_load(A_X8(), A_X10(), 0));
    push[AInstr](out, ai_sub(A_X8(), size_reg));
    push[AInstr](out, ai_store(A_X10(), 0, A_X8()));
}

// Memory-sanitizer small-block boundary. The checked-access registry retains
// the exact logical request, independently of the physical size class. Before
// a sanitizer allocation is quarantined, validate the 16-byte trailing canary
// and overwrite its logical payload with 0xA5. The foreign-write witness uses
// this path to prove that writes outside Zag's instrumented raw-access lowering
// cannot silently cross the allocation boundary.
//
// Input: x6=user pointer. The allocation must still be live in the checked
// registry. x6, x9, and x12 are preserved for ac_emit_allocator_release;
// x0-x2, x8, x10-x11, and x13 are scratch and are restored by that caller.
fn ac_emit_sanitize_small_release(out: *ArrayList[AInstr], cg: *ACg) void {
    if (cg.*.sanitize_memory == 0) { return; }
    let scan: i32 = ac_fresh(cg);
    let found: i32 = ac_fresh(cg);
    let validate_loop: i32 = ac_fresh(cg);
    let validate_ok: i32 = ac_fresh(cg);
    let poison_loop: i32 = ac_fresh(cg);
    let done: i32 = ac_fresh(cg);
    let missing: i32 = ac_fresh(cg);
    let after_missing: i32 = ac_fresh(cg);
    let corrupt: i32 = ac_fresh(cg);
    let after_corrupt: i32 = ac_fresh(cg);

    push[AInstr](out, ai_mov_imm(A_X8(), 0));
    push[AInstr](out, ai_label(scan));
    push[AInstr](out, ai_cmp_imm(A_X8(), ac_alloc_access_registry_cap()));
    push[AInstr](out, ai_jge(missing));
    push[AInstr](out, ai_mov_rr(A_X10(), A_X8()));
    push[AInstr](out, ai_lsl_imm(A_X10(), A_X10(), 4));
    ac_emit_alloc_access_registry_address(out, cg, A_X11());
    push[AInstr](out, ai_add(A_X10(), A_X11()));
    push[AInstr](out, ai_load(A_X11(), A_X10(), 0));
    push[AInstr](out, ai_cmp(A_X11(), A_X6()));
    push[AInstr](out, ai_je(found));
    push[AInstr](out, ai_add_imm(A_X8(), 1));
    push[AInstr](out, ai_jmp(scan));

    push[AInstr](out, ai_label(found));
    push[AInstr](out, ai_load(A_X13(), A_X10(), 8)); // exact requested length
    push[AInstr](out, ai_mov_rr(A_X0(), A_X6()));
    push[AInstr](out, ai_add(A_X0(), A_X13()));       // first red-zone byte
    push[AInstr](out, ai_mov_imm(A_X1(), 0));
    push[AInstr](out, ai_label(validate_loop));
    push[AInstr](out, ai_cmp_imm(A_X1(), ac_sanitize_redzone_size()));
    push[AInstr](out, ai_jge(validate_ok));
    push[AInstr](out, ai_loadb(A_X11(), A_X0(), 0));
    push[AInstr](out, ai_cmp_imm(A_X11(), 211));      // 0xD3
    push[AInstr](out, ai_jne(corrupt));
    push[AInstr](out, ai_add_imm(A_X0(), 1));
    push[AInstr](out, ai_add_imm(A_X1(), 1));
    push[AInstr](out, ai_jmp(validate_loop));

    push[AInstr](out, ai_label(validate_ok));
    push[AInstr](out, ai_mov_rr(A_X0(), A_X6()));
    push[AInstr](out, ai_mov_imm(A_X1(), 0));
    push[AInstr](out, ai_mov_imm(A_X11(), 165));      // 0xA5
    push[AInstr](out, ai_label(poison_loop));
    push[AInstr](out, ai_cmp(A_X1(), A_X13()));
    push[AInstr](out, ai_jge(done));
    push[AInstr](out, ai_storeb(A_X0(), 0, A_X11()));
    push[AInstr](out, ai_add_imm(A_X0(), 1));
    push[AInstr](out, ai_add_imm(A_X1(), 1));
    push[AInstr](out, ai_jmp(poison_loop));

    push[AInstr](out, ai_label(missing));
    ac_emit_panic(out, "zag sanitizer: small allocation provenance missing",
        after_missing, cg);
    push[AInstr](out, ai_jmp(done));
    push[AInstr](out, ai_label(corrupt));
    ac_emit_panic(out, "zag sanitizer: small allocation trailing red zone corrupted",
        after_corrupt, cg);
    push[AInstr](out, ai_label(done));
}

// Initialize the independent sanitizer canary after a small block has been
// selected or carved. Inputs x0=user pointer and x7=exact request are
// preserved; the selected class is guaranteed to contain request+16 bytes.
fn ac_emit_sanitize_redzone_init(out: *ArrayList[AInstr], cg: *ACg) void {
    if (cg.*.sanitize_memory == 0) { return; }
    let loop: i32 = ac_fresh(cg);
    let done: i32 = ac_fresh(cg);
    push[AInstr](out, ai_mov_rr(A_X8(), A_X0()));
    push[AInstr](out, ai_add(A_X8(), A_X7()));
    push[AInstr](out, ai_mov_imm(A_X9(), 0));
    push[AInstr](out, ai_mov_imm(A_X10(), 211));      // 0xD3
    push[AInstr](out, ai_label(loop));
    push[AInstr](out, ai_cmp_imm(A_X9(), ac_sanitize_redzone_size()));
    push[AInstr](out, ai_jge(done));
    push[AInstr](out, ai_storeb(A_X8(), 0, A_X10()));
    push[AInstr](out, ai_add_imm(A_X8(), 1));
    push[AInstr](out, ai_add_imm(A_X9(), 1));
    push[AInstr](out, ai_jmp(loop));
    push[AInstr](out, ai_label(done));
}

// Retire and physically reclaim one ordinary allocation. Small unchecked
// blocks join their exact size-class free list. Checked/sanitizer blocks keep
// the existing process-lifetime address quarantine. Dedicated mappings are
// validated through their bounded registry, unmapped, and then tombstoned.
// Preserve every register outside the old logical-free helper's x8-x10
// scratch contract. This helper is expanded inline in expression lowering, so
// treating its new allocator machinery like a normal function call would
// silently destroy live compiler values. ptr_reg is consequently restored too,
// allowing a following checked-access release to retire the same pointer.
fn ac_emit_allocator_release(out: *ArrayList[AInstr], cg: *ACg,
                             ptr_reg: i32) void {
    let done: i32 = ac_fresh(cg);
    let small: i32 = ac_fresh(cg);
    let small_live: i32 = ac_fresh(cg);
    let small_size: i32 = ac_fresh(cg);
    let small_class: i32 = ac_fresh(cg);
    let small_found: i32 = ac_fresh(cg);
    let large: i32 = ac_fresh(cg);
    let large_unmapped: i32 = ac_fresh(cg);
    let invalid: i32 = ac_fresh(cg);
    let after_invalid: i32 = ac_fresh(cg);
    let after_unmap: i32 = ac_fresh(cg);
    // x0-x2 carry syscall arguments, x6 is the stable source pointer,
    // x11-x13 are registry/class temporaries, and Darwin materializes syscall
    // numbers in x16. The 64-byte save area keeps SP 16-byte aligned.
    push[AInstr](out, ai_sub_imm(A_SP(), 64));
    push[AInstr](out, ai_store(A_SP(), 0, A_X0()));
    push[AInstr](out, ai_store(A_SP(), 8, A_X1()));
    push[AInstr](out, ai_store(A_SP(), 16, A_X2()));
    push[AInstr](out, ai_store(A_SP(), 24, A_X6()));
    push[AInstr](out, ai_store(A_SP(), 32, A_X11()));
    push[AInstr](out, ai_store(A_SP(), 40, A_X12()));
    push[AInstr](out, ai_store(A_SP(), 48, A_X13()));
    push[AInstr](out, ai_store(A_SP(), 56, A_X16()));
    push[AInstr](out, ai_cmp_imm(ptr_reg, 0));
    push[AInstr](out, ai_je(done));
    push[AInstr](out, ai_mov_rr(A_X6(), ptr_reg));
    ac_emit_large_alloc_probe(out, cg, A_X6());
    push[AInstr](out, ai_cmp_imm(A_X8(), 1));
    push[AInstr](out, ai_je(large));
    push[AInstr](out, ai_cmp_imm(A_X8(), 0));
    push[AInstr](out, ai_je(small));
    push[AInstr](out, ai_jmp(invalid));

    push[AInstr](out, ai_label(small));
    push[AInstr](out, ai_load(A_X8(), A_X6(), 0 - 8));
    push[AInstr](out, ai_cmp_imm(A_X8(), 0));
    push[AInstr](out, ai_jg(small_live));
    push[AInstr](out, ai_jmp(invalid));
    push[AInstr](out, ai_label(small_live));
    // The maximum positive word is the live encoding for an exact zero-byte
    // request; it remains class-16 storage but contributes zero live bytes.
    push[AInstr](out, ai_mov_rr(A_X12(), A_X8()));
    push[AInstr](out, ai_mov_rr(A_X9(), A_X8()));
    push[AInstr](out, ai_mov_imm(A_X13(), ac_allocator_zero_header()));
    push[AInstr](out, ai_cmp(A_X9(), A_X13()));
    push[AInstr](out, ai_jne(small_size));
    push[AInstr](out, ai_mov_imm(A_X9(), 0));
    push[AInstr](out, ai_label(small_size));
    push[AInstr](out, ai_cmp_imm(A_X9(), ac_allocator_max_small()));
    push[AInstr](out, ai_jg(invalid));
    ac_emit_sanitize_small_release(out, cg);
    ac_emit_allocator_release_size(out, cg, A_X9());
    push[AInstr](out, ai_neg(A_X12(), A_X12()));
    push[AInstr](out, ai_store(A_X6(), 0 - 8, A_X12()));
    if (cg.*.safety_checked == 1) {
        push[AInstr](out, ai_mov_rr(ptr_reg, A_X6()));
        push[AInstr](out, ai_jmp(done));
    }
    // Derive the class from the exact logical size. A zero-byte allocation
    // belongs to class 16; every other small request rounds to the next power
    // of two, exactly matching the allocation search.
    push[AInstr](out, ai_mov_imm(A_X1(), 16));
    push[AInstr](out, ai_mov_imm(A_X2(), 0));
    push[AInstr](out, ai_label(small_class));
    push[AInstr](out, ai_cmp(A_X1(), A_X9()));
    push[AInstr](out, ai_jge(small_found));
    push[AInstr](out, ai_add(A_X1(), A_X1()));
    push[AInstr](out, ai_add_imm(A_X2(), 1));
    push[AInstr](out, ai_jmp(small_class));
    push[AInstr](out, ai_label(small_found));
    push[AInstr](out, ai_lsl_imm(A_X2(), A_X2(), 3));
    ac_emit_allocator_word_address(out, cg, A_X10(),
        ac_allocator_heads_offset());
    push[AInstr](out, ai_add(A_X10(), A_X2()));
    push[AInstr](out, ai_load(A_X11(), A_X10(), 0));
    push[AInstr](out, ai_store(A_X6(), 0, A_X11()));
    push[AInstr](out, ai_store(A_X10(), 0, A_X6()));
    push[AInstr](out, ai_mov_rr(ptr_reg, A_X6()));
    push[AInstr](out, ai_jmp(done));

    push[AInstr](out, ai_label(large));
    // Probe returned exact payload size in x9 and row address in x10.
    push[AInstr](out, ai_mov_rr(A_X12(), A_X9()));
    push[AInstr](out, ai_mov_rr(A_X13(), A_X10()));
    if (cg.*.sanitize_memory == 1) {
        // Poison the exact logical payload before its dedicated mapping is
        // removed. This mirrors the x86-64 sanitizer's pre-unmap evidence
        // without writing into page-rounding slack or the guard page.
        let poison_loop: i32 = ac_fresh(cg);
        let poison_done: i32 = ac_fresh(cg);
        push[AInstr](out, ai_mov_rr(A_X0(), A_X6()));
        push[AInstr](out, ai_mov_imm(A_X1(), 0));
        push[AInstr](out, ai_mov_imm(A_X11(), 165)); // 0xA5
        push[AInstr](out, ai_label(poison_loop));
        push[AInstr](out, ai_cmp(A_X1(), A_X12()));
        push[AInstr](out, ai_jge(poison_done));
        push[AInstr](out, ai_storeb(A_X0(), 0, A_X11()));
        push[AInstr](out, ai_add_imm(A_X0(), 1));
        push[AInstr](out, ai_add_imm(A_X1(), 1));
        push[AInstr](out, ai_jmp(poison_loop));
        push[AInstr](out, ai_label(poison_done));
    }
    push[AInstr](out, ai_mov_rr(A_X0(), A_X6()));
    push[AInstr](out, ai_sub_imm(A_X0(), 8));
    push[AInstr](out, ai_mov_rr(A_X1(), A_X12()));
    push[AInstr](out, ai_add_imm(A_X1(), 8));
    if (cg.*.sanitize_memory == 1) {
        // Reconstruct round_up(header+payload,page)+guard_page exactly as the
        // allocation path did. Apple Silicon uses 16 KiB VM pages; Linux ARM
        // uses the backend's 4 KiB bounded native page contract.
        let page_size: i64 = ac_allocator_page_size(cg);
        push[AInstr](out, ai_add_imm(A_X1(), page_size - 1));
        push[AInstr](out, ai_mov_imm(A_X8(), 0 - page_size));
        push[AInstr](out, ai_andr(A_X1(), A_X8()));
        push[AInstr](out, ai_add_imm(A_X1(), page_size));
    }
    push[AInstr](out, ai_syscall(215));
    push[AInstr](out, ai_cmp_imm(A_X0(), 0));
    push[AInstr](out, ai_je(large_unmapped));
    ac_emit_panic(out, "zag runtime: large allocation unmap failed",
        after_unmap, cg);
    push[AInstr](out, ai_label(large_unmapped));
    push[AInstr](out, ai_neg(A_X11(), A_X6()));
    push[AInstr](out, ai_store(A_X13(), 0, A_X11()));
    ac_emit_allocator_release_size(out, cg, A_X12());
    push[AInstr](out, ai_mov_rr(ptr_reg, A_X6()));
    push[AInstr](out, ai_jmp(done));

    push[AInstr](out, ai_label(invalid));
    ac_emit_panic(out, "zag runtime: invalid or double free",
        after_invalid, cg);
    push[AInstr](out, ai_label(done));
    push[AInstr](out, ai_load(A_X0(), A_SP(), 0));
    push[AInstr](out, ai_load(A_X1(), A_SP(), 8));
    push[AInstr](out, ai_load(A_X2(), A_SP(), 16));
    push[AInstr](out, ai_load(A_X6(), A_SP(), 24));
    push[AInstr](out, ai_load(A_X11(), A_SP(), 32));
    push[AInstr](out, ai_load(A_X12(), A_SP(), 40));
    push[AInstr](out, ai_load(A_X13(), A_SP(), 48));
    push[AInstr](out, ai_load(A_X16(), A_SP(), 56));
    push[AInstr](out, ai_add_imm(A_SP(), 64));
}

// Probe the allocation access registry for [rax, rax+rsi).
// Input: x0=pointer, x1=access width. Output: x8=1 (valid), -1 (freed), -2 (OOB).
// Mirrors cg_emit_alloc_access_probe but uses AArch64 registers.
fn ac_emit_alloc_access_probe(out: *ArrayList[AInstr], cg: *ACg) void {
    let loop: i32 = ac_fresh(cg);
    let next: i32 = ac_fresh(cg);
    let nonzero: i32 = ac_fresh(cg);
    let have_base: i32 = ac_fresh(cg);
    let contains: i32 = ac_fresh(cg);
    let freed: i32 = ac_fresh(cg);
    let bounds: i32 = ac_fresh(cg);
    let valid: i32 = ac_fresh(cg);
    let done: i32 = ac_fresh(cg);
    push[AInstr](out, ai_mov_imm(A_X8(), 0));
    push[AInstr](out, ai_mov_imm(A_X9(), 0));
    push[AInstr](out, ai_label(loop));
    push[AInstr](out, ai_cmp_imm(A_X9(), ac_alloc_access_registry_cap()));
    push[AInstr](out, ai_jge(done));
    // x10 = &registry[rcx] = registry_base + rcx * 16
    push[AInstr](out, ai_mov_rr(A_X10(), A_X9()));
    push[AInstr](out, ai_lsl_imm(A_X10(), A_X10(), 4));  // *16
    ac_emit_alloc_access_registry_address(out, cg, A_X11());
    push[AInstr](out, ai_add(A_X10(), A_X11()));
    // x11 = registry[rcx].ptr
    push[AInstr](out, ai_load(A_X11(), A_X10(), 0));
    push[AInstr](out, ai_cmp_imm(A_X11(), 0));
    push[AInstr](out, ai_jne(nonzero));
    push[AInstr](out, ai_jmp(next));
    push[AInstr](out, ai_label(nonzero));
    // x12 = |x11| (abs value, handle freed tombstone)
    push[AInstr](out, ai_mov_rr(A_X12(), A_X11()));
    push[AInstr](out, ai_cmp_imm(A_X12(), 0));
    push[AInstr](out, ai_jge(have_base));
    push[AInstr](out, ai_neg(A_X12(), A_X12()));
    push[AInstr](out, ai_label(have_base));
    // Match the original root first so a far index cannot evade bounds
    // validation by leaving its allocation or landing in another live one.
    push[AInstr](out, ai_cmp(A_X7(), A_X12()));
    push[AInstr](out, ai_jl(next));
    // x13 = registry[rcx].size
    push[AInstr](out, ai_load(A_X13(), A_X10(), 8));
    // root offset = x7 - allocation base
    push[AInstr](out, ai_mov_rr(A_X8(), A_X7()));
    push[AInstr](out, ai_sub(A_X8(), A_X12()));
    // if offset >= size: skip
    push[AInstr](out, ai_cmp(A_X8(), A_X13()));
    push[AInstr](out, ai_jl(contains));
    push[AInstr](out, ai_jmp(next));
    push[AInstr](out, ai_label(contains));
    // Check if freed (x11 < 0)
    push[AInstr](out, ai_cmp_imm(A_X11(), 0));
    push[AInstr](out, ai_jl(freed));
    // Check bounds: size - width >= 0 AND offset + width <= size
    push[AInstr](out, ai_sub(A_X13(), A_X1()));
    push[AInstr](out, ai_cmp_imm(A_X13(), 0));
    push[AInstr](out, ai_jl(bounds));
    push[AInstr](out, ai_cmp(A_X0(), A_X12()));
    push[AInstr](out, ai_jl(bounds));
    push[AInstr](out, ai_mov_rr(A_X8(), A_X0()));
    push[AInstr](out, ai_sub(A_X8(), A_X12()));
    push[AInstr](out, ai_cmp(A_X8(), A_X13()));
    push[AInstr](out, ai_jle(valid));
    push[AInstr](out, ai_jmp(bounds));
    push[AInstr](out, ai_label(freed));
    push[AInstr](out, ai_mov_imm(A_X8(), 0 - 1));
    push[AInstr](out, ai_jmp(done));
    push[AInstr](out, ai_label(bounds));
    push[AInstr](out, ai_mov_imm(A_X8(), 0 - 2));
    push[AInstr](out, ai_jmp(done));
    push[AInstr](out, ai_label(valid));
    push[AInstr](out, ai_mov_imm(A_X8(), 1));
    push[AInstr](out, ai_jmp(done));
    push[AInstr](out, ai_label(next));
    push[AInstr](out, ai_add_imm(A_X9(), 1));
    push[AInstr](out, ai_jmp(loop));
    push[AInstr](out, ai_label(done));
}

// Checked raw pointer access: null, alignment, provenance/OOB.
// Input: x7=allocation root, x0=final pointer. Output: x0 unchanged.
fn ac_emit_checked_raw_access(out: *ArrayList[AInstr], cg: *ACg, align: i32, width: i32) void {
    if (cg.*.safety_checked == 0) { return; }
    let nonnull: i32 = ac_fresh(cg);
    let after_null: i32 = ac_fresh(cg);
    push[AInstr](out, ai_cmp_imm(A_X0(), 0));
    push[AInstr](out, ai_jne(nonnull));
    ac_emit_panic(out, "zag safety: null raw pointer access", after_null, cg);
    push[AInstr](out, ai_label(nonnull));
    if (align > 1) {
        let aligned: i32 = ac_fresh(cg);
        let after_align: i32 = ac_fresh(cg);
        push[AInstr](out, ai_mov_rr(A_X8(), A_X0()));
        push[AInstr](out, ai_and_imm(A_X8(), (align - 1) as i64));
        push[AInstr](out, ai_cmp_imm(A_X8(), 0));
        push[AInstr](out, ai_je(aligned));
        ac_emit_panic(out, "zag safety: misaligned raw pointer access", after_align, cg);
        push[AInstr](out, ai_label(aligned));
    }
    let access_ok: i32 = ac_fresh(cg);
    let after_freed: i32 = ac_fresh(cg);
    let after_bounds: i32 = ac_fresh(cg);
    push[AInstr](out, ai_mov_imm(A_X1(), width as i64));
    ac_emit_alloc_access_probe(out, cg);
    push[AInstr](out, ai_cmp_imm(A_X8(), 0 - 1));
    push[AInstr](out, ai_jne(access_ok));
    ac_emit_panic(out, "zag safety: use after free of allocator pointer", after_freed, cg);
    push[AInstr](out, ai_label(access_ok));
    push[AInstr](out, ai_cmp_imm(A_X8(), 0 - 2));
    let bounds_ok: i32 = ac_fresh(cg);
    push[AInstr](out, ai_jne(bounds_ok));
    ac_emit_panic(out, "zag safety: allocator pointer access out of bounds", after_bounds, cg);
    push[AInstr](out, ai_label(bounds_ok));
}

// Register a new allocation in the provenance registry.
// Input: x0=user pointer, x1=size. Does not clobber inputs.
fn ac_emit_alloc_access_acquire(out: *ArrayList[AInstr], cg: *ACg) void {
    let loop: i32 = ac_fresh(cg);
    let insert: i32 = ac_fresh(cg);
    let next: i32 = ac_fresh(cg);
    let reused: i32 = ac_fresh(cg);
    let after_reused: i32 = ac_fresh(cg);
    let full: i32 = ac_fresh(cg);
    let after_full: i32 = ac_fresh(cg);
    let done: i32 = ac_fresh(cg);
    push[AInstr](out, ai_mov_imm(A_X9(), 0));
    push[AInstr](out, ai_label(loop));
    push[AInstr](out, ai_cmp_imm(A_X9(), ac_alloc_access_registry_cap()));
    push[AInstr](out, ai_jge(full));
    // x10 = &registry[x9]
    push[AInstr](out, ai_mov_rr(A_X10(), A_X9()));
    push[AInstr](out, ai_lsl_imm(A_X10(), A_X10(), 4));
    ac_emit_alloc_access_registry_address(out, cg, A_X11());
    push[AInstr](out, ai_add(A_X10(), A_X11()));
    push[AInstr](out, ai_load(A_X8(), A_X10(), 0));
    push[AInstr](out, ai_cmp_imm(A_X8(), 0));
    push[AInstr](out, ai_je(insert));
    push[AInstr](out, ai_jg(next));
    // Freed tombstone — check for address reuse
    push[AInstr](out, ai_neg(A_X8(), A_X8()));
    push[AInstr](out, ai_cmp(A_X8(), A_X0()));
    push[AInstr](out, ai_jne(next));
    push[AInstr](out, ai_jmp(reused));
    push[AInstr](out, ai_label(insert));
    push[AInstr](out, ai_store(A_X10(), 0, A_X0()));
    push[AInstr](out, ai_store(A_X10(), 8, A_X1()));
    push[AInstr](out, ai_jmp(done));
    push[AInstr](out, ai_label(next));
    push[AInstr](out, ai_add_imm(A_X9(), 1));
    push[AInstr](out, ai_jmp(loop));
    push[AInstr](out, ai_label(reused));
    ac_emit_panic(out, "zag safety: allocator address reuse violates checked quarantine", after_reused, cg);
    push[AInstr](out, ai_jmp(done));
    push[AInstr](out, ai_label(full));
    ac_emit_panic(out, "zag runtime: checked allocation provenance registry exhausted", after_full, cg);
    push[AInstr](out, ai_label(done));
}

// Retire an allocation from the provenance registry.
// Input: x0=user pointer.
fn ac_emit_alloc_access_release(out: *ArrayList[AInstr], cg: *ACg) void {
    let loop: i32 = ac_fresh(cg);
    let next: i32 = ac_fresh(cg);
    let found: i32 = ac_fresh(cg);
    let done: i32 = ac_fresh(cg);
    push[AInstr](out, ai_mov_imm(A_X9(), 0));
    push[AInstr](out, ai_label(loop));
    push[AInstr](out, ai_cmp_imm(A_X9(), ac_alloc_access_registry_cap()));
    push[AInstr](out, ai_jge(done));
    push[AInstr](out, ai_mov_rr(A_X10(), A_X9()));
    push[AInstr](out, ai_lsl_imm(A_X10(), A_X10(), 4));
    ac_emit_alloc_access_registry_address(out, cg, A_X11());
    push[AInstr](out, ai_add(A_X10(), A_X11()));
    push[AInstr](out, ai_load(A_X8(), A_X10(), 0));
    push[AInstr](out, ai_cmp_imm(A_X8(), 0));
    push[AInstr](out, ai_je(next));
    push[AInstr](out, ai_jg(found));
    // Freed — skip
    push[AInstr](out, ai_jmp(next));
    push[AInstr](out, ai_label(found));
    push[AInstr](out, ai_cmp(A_X8(), A_X0()));
    push[AInstr](out, ai_jne(next));
    // Mark as freed (negate the pointer)
    push[AInstr](out, ai_neg(A_X8(), A_X8()));
    push[AInstr](out, ai_store(A_X10(), 0, A_X8()));
    push[AInstr](out, ai_jmp(done));
    push[AInstr](out, ai_label(next));
    push[AInstr](out, ai_add_imm(A_X9(), 1));
    push[AInstr](out, ai_jmp(loop));
    push[AInstr](out, ai_label(done));
}

// Exit-time leak detection: scan the registry for any live (positive) entries.
// Called from _start before exit(0). Only active under --sanitize=memory.
fn ac_emit_leak_check(out: *ArrayList[AInstr], cg: *ACg) void {
    if (cg.*.sanitize_memory == 0) { return; }
    let loop: i32 = ac_fresh(cg);
    let done: i32 = ac_fresh(cg);
    let leak: i32 = ac_fresh(cg);
    let after_leak: i32 = ac_fresh(cg);
    push[AInstr](out, ai_mov_imm(A_X9(), 0));
    push[AInstr](out, ai_label(loop));
    push[AInstr](out, ai_cmp_imm(A_X9(), ac_alloc_access_registry_cap()));
    push[AInstr](out, ai_jge(done));
    push[AInstr](out, ai_mov_rr(A_X10(), A_X9()));
    push[AInstr](out, ai_lsl_imm(A_X10(), A_X10(), 4));
    ac_emit_alloc_access_registry_address(out, cg, A_X11());
    push[AInstr](out, ai_add(A_X10(), A_X11()));
    push[AInstr](out, ai_load(A_X8(), A_X10(), 0));
    push[AInstr](out, ai_cmp_imm(A_X8(), 0));
    push[AInstr](out, ai_jg(leak));
    push[AInstr](out, ai_add_imm(A_X9(), 1));
    push[AInstr](out, ai_jmp(loop));
    push[AInstr](out, ai_label(leak));
    ac_emit_panic(out, "zag safety: memory leak detected at exit", after_leak, cg);
    push[AInstr](out, ai_label(done));
}

// Form base + index*stride for a raw-pointer index with overflow checks.
// Input: x0=base, x1=index. Output: x0=address.
fn ac_emit_raw_index_address(out: *ArrayList[AInstr], cg: *ACg, stride: i32) void {
    if (cg.*.safety_checked == 0) {
        if (stride != 1) {
            push[AInstr](out, ai_mov_imm(A_X9(), stride as i64));
            push[AInstr](out, ai_mul(A_X1(), A_X1(), A_X9()));
        }
        push[AInstr](out, ai_add(A_X0(), A_X1()));
        return;
    }
    let overflow: i32 = ac_fresh(cg);
    let after_overflow: i32 = ac_fresh(cg);
    let product_ok: i32 = ac_fresh(cg);
    let nonnegative: i32 = ac_fresh(cg);
    let add_ok: i32 = ac_fresh(cg);
    // Save original base and index
    push[AInstr](out, ai_mov_rr(A_X8(), A_X0()));   // x8 = base
    push[AInstr](out, ai_mov_rr(A_X9(), A_X1()));   // x9 = index
    if (stride != 1) {
        push[AInstr](out, ai_mov_imm(A_X10(), stride as i64));
        push[AInstr](out, ai_mul(A_X1(), A_X1(), A_X10()));
        // Check: (x1 / stride) == x9?
        push[AInstr](out, ai_sdiv(A_X0(), A_X1(), A_X10()));
        push[AInstr](out, ai_cmp(A_X0(), A_X9()));
        push[AInstr](out, ai_je(product_ok));
        push[AInstr](out, ai_jmp(overflow));
        push[AInstr](out, ai_label(product_ok));
    }
    // Restore base, check index sign
    push[AInstr](out, ai_mov_rr(A_X0(), A_X8()));
    push[AInstr](out, ai_cmp_imm(A_X1(), 0));
    push[AInstr](out, ai_jge(nonnegative));
    // Negative index: base + index should be < base
    push[AInstr](out, ai_add(A_X0(), A_X1()));
    push[AInstr](out, ai_cmp(A_X0(), A_X8()));
    push[AInstr](out, ai_jle(add_ok));
    push[AInstr](out, ai_jmp(overflow));
    push[AInstr](out, ai_label(nonnegative));
    // Non-negative index: base + index should be >= base
    push[AInstr](out, ai_add(A_X0(), A_X1()));
    push[AInstr](out, ai_cmp(A_X0(), A_X8()));
    push[AInstr](out, ai_jge(add_ok));
    push[AInstr](out, ai_label(overflow));
    ac_emit_panic(out, "zag safety: raw pointer index arithmetic overflow", after_overflow, cg);
    push[AInstr](out, ai_label(add_ok));
}

// __malloc(x0=requested bytes) -> x0=user pointer, x1=exact requested bytes.
// Small allocations use 16 power-of-two classes through 512 KiB and 1 MiB
// arenas. Unchecked frees recycle blocks; checked/sanitizer frees quarantine
// their addresses. Larger allocations use one dedicated mapping and are
// unmapped by ac_emit_allocator_release. The in-band header always stores the
// exact logical request (with a positive sentinel for zero), preserving ARM64
// realloc and telemetry behavior while the free-list index is recomputed.
fn ac_emit_alloc(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    let size_valid: i32 = ac_fresh(cg);
    let redzone_size_valid: i32 = ac_fresh(cg);
    let class_loop: i32 = ac_fresh(cg);
    let class_found: i32 = ac_fresh(cg);
    let class_pop: i32 = ac_fresh(cg);
    let class_carve: i32 = ac_fresh(cg);
    let class_have: i32 = ac_fresh(cg);
    let class_header: i32 = ac_fresh(cg);
    let popped_valid: i32 = ac_fresh(cg);
    let arena_mapped: i32 = ac_fresh(cg);
    let large: i32 = ac_fresh(cg);
    let large_size_valid: i32 = ac_fresh(cg);
    let large_round_valid: i32 = ac_fresh(cg);
    let large_total_valid: i32 = ac_fresh(cg);
    let large_mapped: i32 = ac_fresh(cg);
    let large_guarded: i32 = ac_fresh(cg);
    let after_invalid: i32 = ac_fresh(cg);
    let after_corrupt: i32 = ac_fresh(cg);
    let after_arena_fail: i32 = ac_fresh(cg);
    let after_large_size: i32 = ac_fresh(cg);
    let after_large_round: i32 = ac_fresh(cg);
    let after_large_total: i32 = ac_fresh(cg);
    let after_large_fail: i32 = ac_fresh(cg);
    let after_large_guard: i32 = ac_fresh(cg);
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_mov_rr(A_X7(), A_X0()));       // exact request
    push[AInstr](out, ai_cmp_imm(A_X7(), 0));
    push[AInstr](out, ai_jge(size_valid));
    ac_emit_panic(out, "zag runtime: invalid negative allocation size",
        after_invalid, cg);
    push[AInstr](out, ai_label(size_valid));

    // Find the first class >= request. Memory-sanitizer mode reserves an
    // independent 16-byte trailing canary, so its physical class target is
    // request+16 while the logical request/header remains unchanged. Zero
    // intentionally selects class 16 outside sanitizer mode.
    push[AInstr](out, ai_mov_rr(A_X14(), A_X7()));
    if (cg.*.sanitize_memory == 1) {
        push[AInstr](out, ai_add_imm(A_X14(), ac_sanitize_redzone_size()));
        push[AInstr](out, ai_cmp_imm(A_X14(), 0));
        push[AInstr](out, ai_jge(redzone_size_valid));
        ac_emit_panic(out, "zag sanitizer: allocation size exceeds red-zone limit",
            redzone_size_valid, cg);
    }
    push[AInstr](out, ai_mov_imm(A_X1(), 16));
    push[AInstr](out, ai_mov_imm(A_X2(), 0));
    push[AInstr](out, ai_label(class_loop));
    push[AInstr](out, ai_cmp(A_X1(), A_X14()));
    push[AInstr](out, ai_jge(class_found));
    push[AInstr](out, ai_add(A_X1(), A_X1()));
    push[AInstr](out, ai_add_imm(A_X2(), 1));
    push[AInstr](out, ai_cmp_imm(A_X2(), 16));
    push[AInstr](out, ai_jl(class_loop));
    push[AInstr](out, ai_jmp(large));

    push[AInstr](out, ai_label(class_found));
    // x8 = &heads[class]
    push[AInstr](out, ai_lsl_imm(A_X8(), A_X2(), 3));
    ac_emit_allocator_word_address(out, cg, A_X9(),
        ac_allocator_heads_offset());
    push[AInstr](out, ai_add(A_X8(), A_X9()));
    push[AInstr](out, ai_load(A_X0(), A_X8(), 0));
    push[AInstr](out, ai_cmp_imm(A_X0(), 0));
    push[AInstr](out, ai_jne(class_pop));
    push[AInstr](out, ai_jmp(class_carve));

    push[AInstr](out, ai_label(class_pop));
    // Pop the payload-linked head, verify its retired header, then publish the
    // new exact request in that same header.
    push[AInstr](out, ai_load(A_X9(), A_X0(), 0));
    push[AInstr](out, ai_store(A_X8(), 0, A_X9()));
    push[AInstr](out, ai_load(A_X10(), A_X0(), 0 - 8));
    push[AInstr](out, ai_cmp_imm(A_X10(), 0));
    push[AInstr](out, ai_jl(popped_valid));
    ac_emit_panic(out, "zag runtime: corrupt allocator free list",
        after_corrupt, cg);
    push[AInstr](out, ai_label(popped_valid));
    push[AInstr](out, ai_cmp_imm(A_X7(), 0));
    push[AInstr](out, ai_jne(class_header));
    push[AInstr](out, ai_mov_imm(A_X10(), ac_allocator_zero_header()));
    let class_header_ready: i32 = ac_fresh(cg);
    push[AInstr](out, ai_jmp(class_header_ready));
    push[AInstr](out, ai_label(class_header));
    push[AInstr](out, ai_mov_rr(A_X10(), A_X7()));
    push[AInstr](out, ai_label(class_header_ready));
    push[AInstr](out, ai_store(A_X0(), 0 - 8, A_X10()));
    ac_emit_sanitize_redzone_init(out, cg);
    ac_emit_allocator_acquire(out, cg, A_X7());
    push[AInstr](out, ai_mov_rr(A_X1(), A_X7()));
    push[AInstr](out, ai_ret());

    push[AInstr](out, ai_label(class_carve));
    // Carve [header|class payload] from the current 1 MiB arena.
    ac_emit_allocator_word_address(out, cg, A_X10(), 0);
    push[AInstr](out, ai_load(A_X11(), A_X10(), 0));
    push[AInstr](out, ai_load(A_X12(), A_X10(), 8));
    push[AInstr](out, ai_mov_rr(A_X13(), A_X11()));
    push[AInstr](out, ai_add(A_X13(), A_X1()));
    push[AInstr](out, ai_add_imm(A_X13(), 8));
    push[AInstr](out, ai_cmp(A_X13(), A_X12()));
    push[AInstr](out, ai_jle(class_have));
    // Refill with one bounded arena. Keep the exact request in x7 and arena
    // size in x14; Darwin may use x1 as a secondary syscall return register,
    // so the selected class is recomputed below rather than relying on args.
    push[AInstr](out, ai_mov_imm(A_X0(), 0));
    push[AInstr](out, ai_mov_imm(A_X14(), ac_allocator_arena_size()));
    push[AInstr](out, ai_mov_rr(A_X1(), A_X14()));
    push[AInstr](out, ai_mov_imm(A_X2(), 3));
    let mmap_flags: i32 = 34;
    if (cg.*.target_os == AC_OS_MACOS()) { mmap_flags = 4098; }
    push[AInstr](out, ai_mov_imm(A_X3(), mmap_flags as i64));
    push[AInstr](out, ai_mov_imm(A_X4(), 0 - 1));
    push[AInstr](out, ai_mov_imm(A_X5(), 0));
    push[AInstr](out, ai_syscall(222));
    push[AInstr](out, ai_cmp_imm(A_X0(), 0));
    push[AInstr](out, ai_jge(arena_mapped));
    ac_emit_panic(out, "zag runtime: allocator arena map failed",
        after_arena_fail, cg);
    push[AInstr](out, ai_label(arena_mapped));
    // The arena may cover several retired dedicated bases, including interior
    // pages. Clear all aliases before publishing any of its small allocations.
    push[AInstr](out, ai_mov_rr(A_X6(), A_X0()));
    push[AInstr](out, ai_add_imm(A_X6(), 8));
    ac_emit_large_alloc_forget_small_alias(out, cg, A_X6());
    push[AInstr](out, ai_mov_rr(A_X11(), A_X0()));
    push[AInstr](out, ai_mov_rr(A_X12(), A_X0()));
    push[AInstr](out, ai_add(A_X12(), A_X14()));
    ac_emit_allocator_word_address(out, cg, A_X10(), 0);
    push[AInstr](out, ai_store(A_X10(), 8, A_X12()));
    // mmap arguments clobbered x1/x2, so recompute the selected class.
    push[AInstr](out, ai_mov_imm(A_X1(), 16));
    push[AInstr](out, ai_mov_imm(A_X2(), 0));
    let refill_class: i32 = ac_fresh(cg);
    let refill_found: i32 = ac_fresh(cg);
    push[AInstr](out, ai_mov_rr(A_X8(), A_X7()));
    if (cg.*.sanitize_memory == 1) {
        push[AInstr](out, ai_add_imm(A_X8(), ac_sanitize_redzone_size()));
    }
    push[AInstr](out, ai_label(refill_class));
    push[AInstr](out, ai_cmp(A_X1(), A_X8()));
    push[AInstr](out, ai_jge(refill_found));
    push[AInstr](out, ai_add(A_X1(), A_X1()));
    push[AInstr](out, ai_add_imm(A_X2(), 1));
    push[AInstr](out, ai_jmp(refill_class));
    push[AInstr](out, ai_label(refill_found));
    push[AInstr](out, ai_mov_rr(A_X13(), A_X11()));
    push[AInstr](out, ai_add(A_X13(), A_X1()));
    push[AInstr](out, ai_add_imm(A_X13(), 8));
    push[AInstr](out, ai_label(class_have));
    push[AInstr](out, ai_store(A_X10(), 0, A_X13()));
    push[AInstr](out, ai_cmp_imm(A_X7(), 0));
    let carve_nonzero: i32 = ac_fresh(cg);
    let carve_header_ready: i32 = ac_fresh(cg);
    push[AInstr](out, ai_jne(carve_nonzero));
    push[AInstr](out, ai_mov_imm(A_X9(), ac_allocator_zero_header()));
    push[AInstr](out, ai_jmp(carve_header_ready));
    push[AInstr](out, ai_label(carve_nonzero));
    push[AInstr](out, ai_mov_rr(A_X9(), A_X7()));
    push[AInstr](out, ai_label(carve_header_ready));
    push[AInstr](out, ai_store(A_X11(), 0, A_X9()));
    push[AInstr](out, ai_mov_rr(A_X0(), A_X11()));
    push[AInstr](out, ai_add_imm(A_X0(), 8));
    ac_emit_sanitize_redzone_init(out, cg);
    ac_emit_allocator_acquire(out, cg, A_X7());
    push[AInstr](out, ai_mov_rr(A_X1(), A_X7()));
    push[AInstr](out, ai_ret());

    // Dedicated mapping for a request larger than the final small class.
    push[AInstr](out, ai_label(large));
    push[AInstr](out, ai_mov_rr(A_X1(), A_X7()));
    push[AInstr](out, ai_add_imm(A_X1(), 8));
    push[AInstr](out, ai_cmp_imm(A_X1(), 0));
    push[AInstr](out, ai_jg(large_size_valid));
    ac_emit_panic(out, "zag runtime: allocation size exceeds mapping limit",
        after_large_size, cg);
    push[AInstr](out, ai_label(large_size_valid));
    if (cg.*.sanitize_memory == 1) {
        // Dedicated sanitizer mappings reserve one inaccessible page after the
        // page-rounded header+payload region. Keep the registry's logical size
        // exact; only the physical mapping length changes.
        let page_size: i64 = ac_allocator_page_size(cg);
        push[AInstr](out, ai_add_imm(A_X1(), page_size - 1));
        push[AInstr](out, ai_cmp_imm(A_X1(), 0));
        push[AInstr](out, ai_jg(large_round_valid));
        ac_emit_panic(out, "zag sanitizer: large allocation size exceeds guarded mapping limit",
            after_large_round, cg);
        push[AInstr](out, ai_label(large_round_valid));
        push[AInstr](out, ai_mov_imm(A_X8(), 0 - page_size));
        push[AInstr](out, ai_andr(A_X1(), A_X8()));
        push[AInstr](out, ai_add_imm(A_X1(), page_size));
        push[AInstr](out, ai_cmp_imm(A_X1(), 0));
        push[AInstr](out, ai_jg(large_total_valid));
        ac_emit_panic(out, "zag sanitizer: large allocation size exceeds guarded mapping limit",
            after_large_total, cg);
        push[AInstr](out, ai_label(large_total_valid));
    }
    push[AInstr](out, ai_mov_imm(A_X0(), 0));
    push[AInstr](out, ai_mov_imm(A_X2(), 3));
    push[AInstr](out, ai_mov_imm(A_X3(), mmap_flags as i64));
    push[AInstr](out, ai_mov_imm(A_X4(), 0 - 1));
    push[AInstr](out, ai_mov_imm(A_X5(), 0));
    push[AInstr](out, ai_syscall(222));
    push[AInstr](out, ai_cmp_imm(A_X0(), 0));
    push[AInstr](out, ai_jge(large_mapped));
    ac_emit_panic(out, "zag runtime: allocation failed",
        after_large_fail, cg);
    push[AInstr](out, ai_label(large_mapped));
    if (cg.*.sanitize_memory == 1) {
        // Darwin may clobber x1 as a secondary syscall-return register, so do
        // not reuse mmap's length argument after svc. Recompute the accessible
        // page-rounded header+payload length from the exact request in x7,
        // then protect the following native page. Failure is fatal; sanitizer
        // mode never silently returns an unguarded dedicated allocation.
        let page_size: i64 = ac_allocator_page_size(cg);
        push[AInstr](out, ai_mov_rr(A_X6(), A_X0()));
        push[AInstr](out, ai_mov_rr(A_X1(), A_X7()));
        push[AInstr](out, ai_add_imm(A_X1(), 8));
        push[AInstr](out, ai_add_imm(A_X1(), page_size - 1));
        push[AInstr](out, ai_mov_imm(A_X8(), 0 - page_size));
        push[AInstr](out, ai_andr(A_X1(), A_X8()));
        push[AInstr](out, ai_add(A_X0(), A_X1()));
        push[AInstr](out, ai_mov_imm(A_X1(), page_size));
        push[AInstr](out, ai_mov_imm(A_X2(), 0)); // PROT_NONE
        push[AInstr](out, ai_syscall(226));
        push[AInstr](out, ai_cmp_imm(A_X0(), 0));
        push[AInstr](out, ai_je(large_guarded));
        ac_emit_panic(out, "zag sanitizer: large allocation guard-page setup failed",
            after_large_guard, cg);
        push[AInstr](out, ai_label(large_guarded));
        push[AInstr](out, ai_mov_rr(A_X0(), A_X6()));
    }
    push[AInstr](out, ai_store(A_X0(), 0, A_X7()));
    push[AInstr](out, ai_add_imm(A_X0(), 8));
    push[AInstr](out, ai_mov_rr(A_X1(), A_X7()));
    ac_emit_large_alloc_acquire(out, cg);
    ac_emit_allocator_acquire(out, cg, A_X7());
    push[AInstr](out, ai_mov_rr(A_X1(), A_X7()));
    push[AInstr](out, ai_ret());
}

// __streq(x0=&a, x1=&b): 1 if the two {ptr,len} slices are byte-equal.
fn ac_emit_streq(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    let l_loop: i32 = ac_fresh(cg);
    let l_eq: i32 = ac_fresh(cg);
    let l_ne: i32 = ac_fresh(cg);
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_load(A_X2(), A_X0(), 0));   // a.ptr
    push[AInstr](out, ai_load(A_X3(), A_X0(), 8));   // a.len
    push[AInstr](out, ai_load(A_X4(), A_X1(), 0));   // b.ptr
    push[AInstr](out, ai_load(A_X5(), A_X1(), 8));   // b.len
    push[AInstr](out, ai_cmp(A_X3(), A_X5()));
    push[AInstr](out, ai_jne(l_ne));
    push[AInstr](out, ai_mov_imm(A_X6(), 0));
    push[AInstr](out, ai_label(l_loop));
    push[AInstr](out, ai_cmp(A_X6(), A_X3()));
    push[AInstr](out, ai_jge(l_eq));
    push[AInstr](out, ai_loadb(A_X9(), A_X2(), 0));
    push[AInstr](out, ai_loadb(A_X10(), A_X4(), 0));
    push[AInstr](out, ai_cmp(A_X9(), A_X10()));
    push[AInstr](out, ai_jne(l_ne));
    push[AInstr](out, ai_add_imm(A_X2(), 1));
    push[AInstr](out, ai_add_imm(A_X4(), 1));
    push[AInstr](out, ai_add_imm(A_X6(), 1));
    push[AInstr](out, ai_jmp(l_loop));
    push[AInstr](out, ai_label(l_eq));
    push[AInstr](out, ai_mov_imm(A_X0(), 1));
    push[AInstr](out, ai_ret());
    push[AInstr](out, ai_label(l_ne));
    push[AInstr](out, ai_mov_imm(A_X0(), 0));
    push[AInstr](out, ai_ret());
}

// __realloc(x0=p, x1=n): validate the old allocation before creating a new
// one, copy min(old logical size,n), physically release old, and return new.
// Dedicated mappings are sized through their registry so stale pointers never
// dereference an already-unmapped header. realloc(NULL,n) is malloc(n).
fn ac_emit_realloc(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    let size_valid: i32 = ac_fresh(cg);
    let nonnull: i32 = ac_fresh(cg);
    let small: i32 = ac_fresh(cg);
    let small_live: i32 = ac_fresh(cg);
    let small_size: i32 = ac_fresh(cg);
    let have_old_size: i32 = ac_fresh(cg);
    let invalid: i32 = ac_fresh(cg);
    let after_negative: i32 = ac_fresh(cg);
    let after_invalid: i32 = ac_fresh(cg);
    let l_loop: i32 = ac_fresh(cg);
    let l_done: i32 = ac_fresh(cg);
    let l_min: i32 = ac_fresh(cg);
    let finish: i32 = ac_fresh(cg);
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_sub_imm(A_SP(), 48));
    push[AInstr](out, ai_store(A_SP(), 0, A_X30()));
    push[AInstr](out, ai_store(A_SP(), 8, A_X0()));    // p
    push[AInstr](out, ai_store(A_SP(), 16, A_X1()));   // n
    push[AInstr](out, ai_cmp_imm(A_X1(), 0));
    push[AInstr](out, ai_jge(size_valid));
    ac_emit_panic(out, "zag runtime: invalid negative realloc size",
        after_negative, cg);
    push[AInstr](out, ai_label(size_valid));
    push[AInstr](out, ai_cmp_imm(A_X0(), 0));
    push[AInstr](out, ai_jne(nonnull));
    push[AInstr](out, ai_load(A_X0(), A_SP(), 16));
    push[AInstr](out, ai_call(cg.*.al_lbl));
    push[AInstr](out, ai_jmp(finish));

    push[AInstr](out, ai_label(nonnull));
    ac_emit_large_alloc_probe(out, cg, A_X0());
    push[AInstr](out, ai_cmp_imm(A_X8(), 1));
    push[AInstr](out, ai_je(have_old_size));           // x9 = registry size
    push[AInstr](out, ai_cmp_imm(A_X8(), 0));
    push[AInstr](out, ai_je(small));
    push[AInstr](out, ai_jmp(invalid));
    push[AInstr](out, ai_label(small));
    push[AInstr](out, ai_load(A_X9(), A_X0(), 0 - 8));
    push[AInstr](out, ai_cmp_imm(A_X9(), 0));
    push[AInstr](out, ai_jg(small_live));
    push[AInstr](out, ai_jmp(invalid));
    push[AInstr](out, ai_label(small_live));
    push[AInstr](out, ai_mov_imm(A_X10(), ac_allocator_zero_header()));
    push[AInstr](out, ai_cmp(A_X9(), A_X10()));
    push[AInstr](out, ai_jne(small_size));
    push[AInstr](out, ai_mov_imm(A_X9(), 0));
    push[AInstr](out, ai_label(small_size));
    push[AInstr](out, ai_cmp_imm(A_X9(), ac_allocator_max_small()));
    push[AInstr](out, ai_jle(have_old_size));
    push[AInstr](out, ai_jmp(invalid));
    push[AInstr](out, ai_label(invalid));
    ac_emit_panic(out, "zag runtime: realloc of invalid or freed allocation",
        after_invalid, cg);

    push[AInstr](out, ai_label(have_old_size));
    push[AInstr](out, ai_store(A_SP(), 32, A_X9()));
    push[AInstr](out, ai_load(A_X0(), A_SP(), 16));
    push[AInstr](out, ai_call(cg.*.al_lbl));
    push[AInstr](out, ai_store(A_SP(), 24, A_X0()));
    push[AInstr](out, ai_load(A_X1(), A_SP(), 8));     // p
    push[AInstr](out, ai_load(A_X9(), A_SP(), 32));    // old exact size
    push[AInstr](out, ai_load(A_X2(), A_SP(), 16));    // n
    push[AInstr](out, ai_cmp(A_X9(), A_X2()));
    push[AInstr](out, ai_jle(l_min));
    push[AInstr](out, ai_mov_rr(A_X9(), A_X2()));
    push[AInstr](out, ai_label(l_min));
    push[AInstr](out, ai_mov_rr(A_X10(), A_X0()));     // dst
    push[AInstr](out, ai_label(l_loop));
    push[AInstr](out, ai_cmp_imm(A_X9(), 0));
    push[AInstr](out, ai_jle(l_done));
    push[AInstr](out, ai_loadb(A_X11(), A_X1(), 0));
    push[AInstr](out, ai_storeb(A_X10(), 0, A_X11()));
    push[AInstr](out, ai_add_imm(A_X1(), 1));
    push[AInstr](out, ai_add_imm(A_X10(), 1));
    push[AInstr](out, ai_sub_imm(A_X9(), 1));
    push[AInstr](out, ai_jmp(l_loop));
    push[AInstr](out, ai_label(l_done));
    // __malloc above acquired the new logical allocation. Release the old
    // allocation after its contents have been copied.
    push[AInstr](out, ai_load(A_X0(), A_SP(), 8));
    ac_emit_allocator_release(out, cg, A_X0());
    push[AInstr](out, ai_load(A_X0(), A_SP(), 24));
    push[AInstr](out, ai_label(finish));
    push[AInstr](out, ai_load(A_X30(), A_SP(), 0));
    push[AInstr](out, ai_add_imm(A_SP(), 48));
    push[AInstr](out, ai_ret());
}

// __i64_to_str(x0=n, x1=&{ptr,len} out-block): decimal into a fresh buffer.
fn ac_emit_i64s(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    let l_pos: i32 = ac_fresh(cg);
    let l_loop: i32 = ac_fresh(cg);
    let l_zero: i32 = ac_fresh(cg);
    let l_after: i32 = ac_fresh(cg);
    let l_nosign: i32 = ac_fresh(cg);
    let l_wtop: i32 = ac_fresh(cg);
    let l_wdone: i32 = ac_fresh(cg);
    let l_pdig: i32 = ac_fresh(cg);

    // Frame: [SP..SP+8)=n, [SP+8..16)=dest, [SP+16..24)=buf, digits from SP+64.
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_sub_imm(A_SP(), 32));
    push[AInstr](out, ai_store(A_SP(), 0, A_X29()));
    push[AInstr](out, ai_store(A_SP(), 8, A_X30()));
    push[AInstr](out, ai_store(A_SP(), 16, A_X28()));
    push[AInstr](out, ai_mov_rr(A_X29(), A_SP()));
    push[AInstr](out, ai_sub_imm(A_SP(), 256));
    push[AInstr](out, ai_mov_rr(A_X28(), A_SP()));
    push[AInstr](out, ai_add_imm(A_X28(), 64));

    push[AInstr](out, ai_store(A_SP(), 0, A_X0()));
    push[AInstr](out, ai_store(A_SP(), 8, A_X1()));
    push[AInstr](out, ai_mov_imm(A_X0(), 32));
    push[AInstr](out, ai_call(cg.*.al_lbl));
    push[AInstr](out, ai_store(A_SP(), 16, A_X0()));

    push[AInstr](out, ai_load(A_X9(), A_SP(), 0));
    push[AInstr](out, ai_mov_imm(A_X10(), 0));
    push[AInstr](out, ai_cmp_imm(A_X9(), 0));
    push[AInstr](out, ai_jge(l_pos));
    push[AInstr](out, ai_mov_imm(A_X10(), 1));
    push[AInstr](out, ai_label(l_pos));

    push[AInstr](out, ai_mov_imm(A_X11(), 0));
    push[AInstr](out, ai_cmp_imm(A_X9(), 0));
    push[AInstr](out, ai_je(l_zero));

    push[AInstr](out, ai_label(l_loop));
    push[AInstr](out, ai_cmp_imm(A_X9(), 0));
    push[AInstr](out, ai_je(l_after));
    push[AInstr](out, ai_mov_imm(A_X12(), 10));
    push[AInstr](out, ai_sdiv(A_X13(), A_X9(), A_X12()));
    push[AInstr](out, ai_mul(A_X14(), A_X13(), A_X12()));
    push[AInstr](out, ai_sub(A_X14(), A_X9()));
    push[AInstr](out, ai_mov_rr(A_X9(), A_X13()));
    push[AInstr](out, ai_cmp_imm(A_X14(), 0));
    push[AInstr](out, ai_jge(l_pdig));
    push[AInstr](out, ai_neg(A_X14(), A_X14()));
    push[AInstr](out, ai_label(l_pdig));
    push[AInstr](out, ai_add_imm(A_X14(), 48));
    push[AInstr](out, ai_push(A_X14()));
    push[AInstr](out, ai_add_imm(A_X11(), 1));
    push[AInstr](out, ai_jmp(l_loop));

    push[AInstr](out, ai_label(l_zero));
    push[AInstr](out, ai_mov_imm(A_X14(), 48));
    push[AInstr](out, ai_push(A_X14()));
    push[AInstr](out, ai_mov_imm(A_X11(), 1));

    push[AInstr](out, ai_label(l_after));
    push[AInstr](out, ai_cmp_imm(A_X10(), 0));
    push[AInstr](out, ai_je(l_nosign));
    push[AInstr](out, ai_mov_imm(A_X14(), 45));
    push[AInstr](out, ai_push(A_X14()));
    push[AInstr](out, ai_add_imm(A_X11(), 1));
    push[AInstr](out, ai_label(l_nosign));

    // pop digits (MSD first) into the malloc'd buffer as bytes
    push[AInstr](out, ai_load(A_X1(), A_SP(), 16));
    push[AInstr](out, ai_mov_rr(A_X12(), A_X11()));
    push[AInstr](out, ai_label(l_wtop));
    push[AInstr](out, ai_cmp_imm(A_X12(), 0));
    push[AInstr](out, ai_je(l_wdone));
    push[AInstr](out, ai_pop(A_X13()));
    push[AInstr](out, ai_storeb(A_X1(), 0, A_X13()));
    push[AInstr](out, ai_add_imm(A_X1(), 1));
    push[AInstr](out, ai_sub_imm(A_X12(), 1));
    push[AInstr](out, ai_jmp(l_wtop));
    push[AInstr](out, ai_label(l_wdone));

    push[AInstr](out, ai_load(A_X10(), A_SP(), 8));    // dest block
    push[AInstr](out, ai_load(A_X9(), A_SP(), 16));    // buffer ptr
    push[AInstr](out, ai_store(A_X10(), 0, A_X9()));
    push[AInstr](out, ai_store(A_X10(), 8, A_X11()));

    push[AInstr](out, ai_mov_rr(A_SP(), A_X29()));
    push[AInstr](out, ai_load(A_X29(), A_SP(), 0));
    push[AInstr](out, ai_load(A_X30(), A_SP(), 8));
    push[AInstr](out, ai_load(A_X28(), A_SP(), 16));
    push[AInstr](out, ai_add_imm(A_SP(), 32));
    push[AInstr](out, ai_ret());
}

// __u64_to_str(x0=v) -> x0=&{ptr,len}. This intentionally mirrors the current
// x86 RT_U2S body exactly, including its signed division/sign interpretation
// for values with bit 63 set. The buffer is sized to the emitted byte count;
// __make_slice adds the temporary descriptor retired by ac_finish_rt_slice.
fn ac_emit_u64s(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    let l_pos: i32 = ac_fresh(cg);
    let l_loop: i32 = ac_fresh(cg);
    let l_zero: i32 = ac_fresh(cg);
    let l_after: i32 = ac_fresh(cg);
    let l_nosign: i32 = ac_fresh(cg);
    let l_wtop: i32 = ac_fresh(cg);
    let l_wdone: i32 = ac_fresh(cg);
    let l_pdig: i32 = ac_fresh(cg);
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_sub_imm(A_SP(), 32));
    push[AInstr](out, ai_store(A_SP(), 0, A_X29()));
    push[AInstr](out, ai_store(A_SP(), 8, A_X30()));
    push[AInstr](out, ai_store(A_SP(), 16, A_X28()));
    push[AInstr](out, ai_mov_rr(A_X29(), A_SP()));
    push[AInstr](out, ai_sub_imm(A_SP(), 256));
    push[AInstr](out, ai_mov_rr(A_X28(), A_SP()));
    push[AInstr](out, ai_add_imm(A_X28(), 64));
    push[AInstr](out, ai_mov_rr(A_X9(), A_X0()));
    push[AInstr](out, ai_mov_imm(A_X10(), 0));
    push[AInstr](out, ai_cmp_imm(A_X9(), 0));
    push[AInstr](out, ai_jge(l_pos));
    push[AInstr](out, ai_mov_imm(A_X10(), 1));
    push[AInstr](out, ai_label(l_pos));
    push[AInstr](out, ai_mov_imm(A_X11(), 0));
    push[AInstr](out, ai_cmp_imm(A_X9(), 0));
    push[AInstr](out, ai_je(l_zero));
    push[AInstr](out, ai_label(l_loop));
    push[AInstr](out, ai_cmp_imm(A_X9(), 0));
    push[AInstr](out, ai_je(l_after));
    push[AInstr](out, ai_mov_imm(A_X12(), 10));
    push[AInstr](out, ai_sdiv(A_X13(), A_X9(), A_X12()));
    push[AInstr](out, ai_mul(A_X14(), A_X13(), A_X12()));
    push[AInstr](out, ai_sub(A_X14(), A_X9()));
    push[AInstr](out, ai_mov_rr(A_X9(), A_X13()));
    push[AInstr](out, ai_cmp_imm(A_X14(), 0));
    push[AInstr](out, ai_jge(l_pdig));
    push[AInstr](out, ai_neg(A_X14(), A_X14()));
    push[AInstr](out, ai_label(l_pdig));
    push[AInstr](out, ai_add_imm(A_X14(), 48));
    push[AInstr](out, ai_push(A_X14()));
    push[AInstr](out, ai_add_imm(A_X11(), 1));
    push[AInstr](out, ai_jmp(l_loop));
    push[AInstr](out, ai_label(l_zero));
    push[AInstr](out, ai_mov_imm(A_X14(), 48));
    push[AInstr](out, ai_push(A_X14()));
    push[AInstr](out, ai_mov_imm(A_X11(), 1));
    push[AInstr](out, ai_label(l_after));
    push[AInstr](out, ai_cmp_imm(A_X10(), 0));
    push[AInstr](out, ai_je(l_nosign));
    push[AInstr](out, ai_mov_imm(A_X14(), 45));
    push[AInstr](out, ai_push(A_X14()));
    push[AInstr](out, ai_add_imm(A_X11(), 1));
    push[AInstr](out, ai_label(l_nosign));
    push[AInstr](out, ai_store(A_SP(), 8, A_X11()));
    push[AInstr](out, ai_mov_rr(A_X0(), A_X11()));
    push[AInstr](out, ai_call(cg.*.al_lbl));
    push[AInstr](out, ai_store(A_SP(), 16, A_X0()));
    push[AInstr](out, ai_load(A_X11(), A_SP(), 8));
    push[AInstr](out, ai_mov_rr(A_X1(), A_X0()));
    push[AInstr](out, ai_mov_rr(A_X12(), A_X11()));
    push[AInstr](out, ai_label(l_wtop));
    push[AInstr](out, ai_cmp_imm(A_X12(), 0));
    push[AInstr](out, ai_je(l_wdone));
    push[AInstr](out, ai_pop(A_X13()));
    push[AInstr](out, ai_storeb(A_X1(), 0, A_X13()));
    push[AInstr](out, ai_add_imm(A_X1(), 1));
    push[AInstr](out, ai_sub_imm(A_X12(), 1));
    push[AInstr](out, ai_jmp(l_wtop));
    push[AInstr](out, ai_label(l_wdone));
    push[AInstr](out, ai_load(A_X0(), A_SP(), 16));
    push[AInstr](out, ai_load(A_X1(), A_SP(), 8));
    push[AInstr](out, ai_call(cg.*.ms_lbl));
    push[AInstr](out, ai_mov_rr(A_SP(), A_X29()));
    push[AInstr](out, ai_load(A_X29(), A_SP(), 0));
    push[AInstr](out, ai_load(A_X30(), A_SP(), 8));
    push[AInstr](out, ai_load(A_X28(), A_SP(), 16));
    push[AInstr](out, ai_add_imm(A_SP(), 32));
    push[AInstr](out, ai_ret());
}

// ── syscall-runtime routines for self-hosting (ports of the x86 cg_emit_rt_*
// family in ncodegen.zag; same contracts, AArch64 syscall numbers). All are
// reached via ai_call, use x9-x15 as scratch,
// keep x27 (argv base) intact, and save x30 across nested calls.
// AT_FDCWD = -100 on every *at syscall
// (arm64 has no plain open/access/chmod/fork).

// Append a NUL-terminated copy of `s` to the DATA blob; returns its offset.
fn ac_rt_push_cstr(cg: *ACg, s: []u8) i32 {
    let off: i32 = len[u8](cg.*.data.*);
    let i: i32 = 0;
    while (i < s.len) { push[u8](cg.*.data, s[i]); i = i + 1; }
    push[u8](cg.*.data, 0);
    return off;
}

// Copy x11 bytes from [x9] to [x10]. Clobbers x9, x10, x11, x12.
fn ac_rt_copy(out: *ArrayList[AInstr], cg: *ACg) void {
    let l_top: i32 = ac_fresh(cg);
    let l_end: i32 = ac_fresh(cg);
    push[AInstr](out, ai_label(l_top));
    push[AInstr](out, ai_cmp_imm(A_X11(), 0));
    push[AInstr](out, ai_jle(l_end));
    push[AInstr](out, ai_loadb(A_X12(), A_X9(), 0));
    push[AInstr](out, ai_storeb(A_X10(), 0, A_X12()));
    push[AInstr](out, ai_add_imm(A_X9(), 1));
    push[AInstr](out, ai_add_imm(A_X10(), 1));
    push[AInstr](out, ai_sub_imm(A_X11(), 1));
    push[AInstr](out, ai_jmp(l_top));
    push[AInstr](out, ai_label(l_end));
}

// __make_slice(x0=ptr, x1=len) -> x0 = &{ptr,len} (16-byte heap block).
fn ac_emit_make_slice(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_sub_imm(A_SP(), 32));
    push[AInstr](out, ai_store(A_SP(), 0, A_X30()));
    push[AInstr](out, ai_store(A_SP(), 8, A_X0()));
    push[AInstr](out, ai_store(A_SP(), 16, A_X1()));
    push[AInstr](out, ai_mov_imm(A_X0(), 16));
    push[AInstr](out, ai_call(cg.*.al_lbl));
    push[AInstr](out, ai_load(A_X9(), A_SP(), 8));
    push[AInstr](out, ai_store(A_X0(), 0, A_X9()));
    push[AInstr](out, ai_load(A_X9(), A_SP(), 16));
    push[AInstr](out, ai_store(A_X0(), 8, A_X9()));
    push[AInstr](out, ai_load(A_X30(), A_SP(), 0));
    push[AInstr](out, ai_add_imm(A_SP(), 32));
    push[AInstr](out, ai_ret());
}

// __pathbuf(x0=&slice) -> x0 = NUL-terminated heap copy of the bytes.
fn ac_emit_pathbuf(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_sub_imm(A_SP(), 48));
    push[AInstr](out, ai_store(A_SP(), 0, A_X30()));
    push[AInstr](out, ai_load(A_X9(), A_X0(), 0));
    push[AInstr](out, ai_store(A_SP(), 8, A_X9()));     // src.ptr
    push[AInstr](out, ai_load(A_X9(), A_X0(), 8));
    push[AInstr](out, ai_store(A_SP(), 16, A_X9()));    // src.len
    push[AInstr](out, ai_mov_rr(A_X0(), A_X9()));
    push[AInstr](out, ai_add_imm(A_X0(), 1));
    push[AInstr](out, ai_call(cg.*.al_lbl));
    push[AInstr](out, ai_store(A_SP(), 24, A_X0()));    // buf
    push[AInstr](out, ai_load(A_X9(), A_SP(), 8));
    push[AInstr](out, ai_mov_rr(A_X10(), A_X0()));
    push[AInstr](out, ai_load(A_X11(), A_SP(), 16));
    ac_rt_copy(out, cg);                                // x10 ends at buf+len
    push[AInstr](out, ai_mov_imm(A_X12(), 0));
    push[AInstr](out, ai_storeb(A_X10(), 0, A_X12()));  // NUL
    push[AInstr](out, ai_load(A_X0(), A_SP(), 24));
    push[AInstr](out, ai_load(A_X30(), A_SP(), 0));
    push[AInstr](out, ai_add_imm(A_SP(), 48));
    push[AInstr](out, ai_ret());
}

// __concat(x0=&a, x1=&b) -> x0 = &{buf, a.len+b.len}.
fn ac_emit_concat(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_sub_imm(A_SP(), 64));
    push[AInstr](out, ai_store(A_SP(), 0, A_X30()));
    push[AInstr](out, ai_load(A_X9(), A_X0(), 0));
    push[AInstr](out, ai_store(A_SP(), 8, A_X9()));     // a.ptr
    push[AInstr](out, ai_load(A_X9(), A_X0(), 8));
    push[AInstr](out, ai_store(A_SP(), 16, A_X9()));    // a.len
    push[AInstr](out, ai_load(A_X9(), A_X1(), 0));
    push[AInstr](out, ai_store(A_SP(), 24, A_X9()));    // b.ptr
    push[AInstr](out, ai_load(A_X9(), A_X1(), 8));
    push[AInstr](out, ai_store(A_SP(), 32, A_X9()));    // b.len
    push[AInstr](out, ai_load(A_X0(), A_SP(), 16));
    push[AInstr](out, ai_add(A_X0(), A_X9()));          // total = a.len+b.len
    push[AInstr](out, ai_call(cg.*.al_lbl));
    push[AInstr](out, ai_store(A_SP(), 40, A_X0()));    // buf
    push[AInstr](out, ai_load(A_X9(), A_SP(), 8));      // copy a → buf
    push[AInstr](out, ai_mov_rr(A_X10(), A_X0()));
    push[AInstr](out, ai_load(A_X11(), A_SP(), 16));
    ac_rt_copy(out, cg);
    push[AInstr](out, ai_load(A_X9(), A_SP(), 24));     // copy b → buf+a.len
    push[AInstr](out, ai_load(A_X10(), A_SP(), 40));
    push[AInstr](out, ai_load(A_X12(), A_SP(), 16));
    push[AInstr](out, ai_add(A_X10(), A_X12()));
    push[AInstr](out, ai_load(A_X11(), A_SP(), 32));
    ac_rt_copy(out, cg);
    push[AInstr](out, ai_load(A_X0(), A_SP(), 40));
    push[AInstr](out, ai_load(A_X1(), A_SP(), 16));
    push[AInstr](out, ai_load(A_X9(), A_SP(), 32));
    push[AInstr](out, ai_add(A_X1(), A_X9()));
    push[AInstr](out, ai_call(cg.*.ms_lbl));
    push[AInstr](out, ai_load(A_X30(), A_SP(), 0));
    push[AInstr](out, ai_add_imm(A_SP(), 64));
    push[AInstr](out, ai_ret());
}

// __arg(x0=i) -> x0 = &{argv[i], strlen}. Out-of-range -> &{0,0}.
// argv base: x27 = initial SP ([x27]=argc, [x27+8+8i]=argv[i] cstr).
fn ac_emit_argslice(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    let l_oob: i32 = ac_fresh(cg);
    let l_scan: i32 = ac_fresh(cg);
    let l_send: i32 = ac_fresh(cg);
    let l_ret: i32 = ac_fresh(cg);
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_sub_imm(A_SP(), 16));
    push[AInstr](out, ai_store(A_SP(), 0, A_X30()));
    push[AInstr](out, ai_cmp_imm(A_X0(), 0));
    push[AInstr](out, ai_jl(l_oob));
    push[AInstr](out, ai_load(A_X9(), A_X27(), 0));     // argc
    push[AInstr](out, ai_cmp(A_X0(), A_X9()));
    push[AInstr](out, ai_jge(l_oob));
    push[AInstr](out, ai_mov_imm(A_X10(), 8));
    push[AInstr](out, ai_mul(A_X11(), A_X0(), A_X10()));
    push[AInstr](out, ai_add(A_X11(), A_X27()));
    push[AInstr](out, ai_add_imm(A_X11(), 8));          // &argv[i]
    push[AInstr](out, ai_load(A_X11(), A_X11(), 0));    // cstr
    push[AInstr](out, ai_mov_imm(A_X12(), 0));          // len
    push[AInstr](out, ai_label(l_scan));
    push[AInstr](out, ai_mov_rr(A_X13(), A_X11()));
    push[AInstr](out, ai_add(A_X13(), A_X12()));
    push[AInstr](out, ai_loadb(A_X14(), A_X13(), 0));
    push[AInstr](out, ai_cmp_imm(A_X14(), 0));
    push[AInstr](out, ai_je(l_send));
    push[AInstr](out, ai_add_imm(A_X12(), 1));
    push[AInstr](out, ai_jmp(l_scan));
    push[AInstr](out, ai_label(l_send));
    push[AInstr](out, ai_mov_rr(A_X0(), A_X11()));
    push[AInstr](out, ai_mov_rr(A_X1(), A_X12()));
    push[AInstr](out, ai_call(cg.*.ms_lbl));
    push[AInstr](out, ai_jmp(l_ret));
    push[AInstr](out, ai_label(l_oob));
    push[AInstr](out, ai_mov_imm(A_X0(), 0));
    push[AInstr](out, ai_mov_imm(A_X1(), 0));
    push[AInstr](out, ai_call(cg.*.ms_lbl));
    push[AInstr](out, ai_label(l_ret));
    push[AInstr](out, ai_load(A_X30(), A_SP(), 0));
    push[AInstr](out, ai_add_imm(A_SP(), 16));
    push[AInstr](out, ai_ret());
}

// __read_file(x0=&path) -> x0 = &{buf,total}; open failure -> &{0,-1}.
fn ac_emit_read_file(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    let l_fail: i32 = ac_fresh(cg);
    let l_rtop: i32 = ac_fresh(cg);
    let l_haveroom: i32 = ac_fresh(cg);
    let l_rdone: i32 = ac_fresh(cg);
    let l_ret: i32 = ac_fresh(cg);
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_sub_imm(A_SP(), 48));
    push[AInstr](out, ai_store(A_SP(), 0, A_X30()));
    push[AInstr](out, ai_call(cg.*.pb_lbl));            // x0 = cstr
    push[AInstr](out, ai_store(A_SP(), 40, A_X0()));    // temporary path bridge
    push[AInstr](out, ai_mov_rr(A_X1(), A_X0()));
    let at_fdcwd: i32 = 0 - 100;
    if (cg.*.target_os == AC_OS_MACOS()) { at_fdcwd = 0 - 2; }
    push[AInstr](out, ai_mov_imm(A_X0(), at_fdcwd as i64));
    push[AInstr](out, ai_mov_imm(A_X2(), 0));           // O_RDONLY
    push[AInstr](out, ai_mov_imm(A_X3(), 0));
    push[AInstr](out, ai_syscall(56));                  // openat
    // Match the x86 runtime ownership contract: the NUL-terminated bridge is
    // consumed by openat and must be retired on both success and failure.
    push[AInstr](out, ai_store(A_SP(), 8, A_X0()));     // fd / -errno
    push[AInstr](out, ai_load(A_X0(), A_SP(), 40));
    ac_emit_allocator_release(out, cg, A_X0());
    push[AInstr](out, ai_load(A_X0(), A_SP(), 8));
    push[AInstr](out, ai_cmp_imm(A_X0(), 0));
    push[AInstr](out, ai_jl(l_fail));
    push[AInstr](out, ai_mov_imm(A_X0(), 65536));
    push[AInstr](out, ai_call(cg.*.al_lbl));
    push[AInstr](out, ai_store(A_SP(), 16, A_X0()));    // buf
    push[AInstr](out, ai_mov_imm(A_X9(), 65536));
    push[AInstr](out, ai_store(A_SP(), 24, A_X9()));    // cap
    push[AInstr](out, ai_mov_imm(A_X9(), 0));
    push[AInstr](out, ai_store(A_SP(), 32, A_X9()));    // total
    push[AInstr](out, ai_label(l_rtop));
    push[AInstr](out, ai_load(A_X9(), A_SP(), 24));
    push[AInstr](out, ai_load(A_X10(), A_SP(), 32));
    push[AInstr](out, ai_mov_rr(A_X11(), A_X9()));
    push[AInstr](out, ai_sub(A_X11(), A_X10()));        // room = cap-total
    push[AInstr](out, ai_cmp_imm(A_X11(), 0));
    push[AInstr](out, ai_jg(l_haveroom));
    push[AInstr](out, ai_load(A_X0(), A_SP(), 16));     // grow: realloc(buf, cap*2)
    push[AInstr](out, ai_load(A_X1(), A_SP(), 24));
    push[AInstr](out, ai_add(A_X1(), A_X1()));
    push[AInstr](out, ai_store(A_SP(), 24, A_X1()));
    push[AInstr](out, ai_call(cg.*.rl_lbl));
    push[AInstr](out, ai_store(A_SP(), 16, A_X0()));
    push[AInstr](out, ai_label(l_haveroom));
    push[AInstr](out, ai_load(A_X0(), A_SP(), 8));      // read(fd, buf+total, room)
    push[AInstr](out, ai_load(A_X1(), A_SP(), 16));
    push[AInstr](out, ai_load(A_X9(), A_SP(), 32));
    push[AInstr](out, ai_add(A_X1(), A_X9()));
    push[AInstr](out, ai_load(A_X2(), A_SP(), 24));
    push[AInstr](out, ai_sub(A_X2(), A_X9()));
    push[AInstr](out, ai_syscall(63));                  // read
    push[AInstr](out, ai_cmp_imm(A_X0(), 0));
    push[AInstr](out, ai_jle(l_rdone));
    push[AInstr](out, ai_load(A_X9(), A_SP(), 32));
    push[AInstr](out, ai_add(A_X9(), A_X0()));
    push[AInstr](out, ai_store(A_SP(), 32, A_X9()));
    push[AInstr](out, ai_jmp(l_rtop));
    push[AInstr](out, ai_label(l_rdone));
    push[AInstr](out, ai_load(A_X0(), A_SP(), 8));      // close(fd)
    push[AInstr](out, ai_syscall(57));
    push[AInstr](out, ai_load(A_X0(), A_SP(), 16));
    push[AInstr](out, ai_load(A_X1(), A_SP(), 32));
    push[AInstr](out, ai_call(cg.*.ms_lbl));
    push[AInstr](out, ai_jmp(l_ret));
    push[AInstr](out, ai_label(l_fail));
    push[AInstr](out, ai_mov_imm(A_X0(), 0));
    push[AInstr](out, ai_mov_imm(A_X1(), 0 - 1));
    push[AInstr](out, ai_call(cg.*.ms_lbl));
    push[AInstr](out, ai_label(l_ret));
    push[AInstr](out, ai_load(A_X30(), A_SP(), 0));
    push[AInstr](out, ai_add_imm(A_SP(), 48));
    push[AInstr](out, ai_ret());
}

// __write_file(x0=&path, x1=&content) -> x0 = 0/-1.
// mark_exec=1 also fchmodat(path, 0755) after a successful write (write_exec).
fn ac_emit_write_file(out: *ArrayList[AInstr], lbl: i32, mark_exec: i32, cg: *ACg) void {
    let l_fail: i32 = ac_fresh(cg);
    let l_ret: i32 = ac_fresh(cg);
    let at_fdcwd: i32 = 0 - 100;
    let create_flags: i32 = 577;
    if (cg.*.target_os == AC_OS_MACOS()) { at_fdcwd = 0 - 2; create_flags = 1537; }
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_sub_imm(A_SP(), 48));
    push[AInstr](out, ai_store(A_SP(), 0, A_X30()));
    push[AInstr](out, ai_store(A_SP(), 8, A_X1()));     // &content
    push[AInstr](out, ai_call(cg.*.pb_lbl));
    push[AInstr](out, ai_store(A_SP(), 16, A_X0()));    // cstr
    push[AInstr](out, ai_mov_rr(A_X1(), A_X0()));
    push[AInstr](out, ai_mov_imm(A_X0(), at_fdcwd as i64));
    push[AInstr](out, ai_mov_imm(A_X2(), create_flags as i64));
    push[AInstr](out, ai_mov_imm(A_X3(), 420));         // 0644
    push[AInstr](out, ai_syscall(56));                  // openat
    push[AInstr](out, ai_store(A_SP(), 24, A_X0()));    // fd / -errno
    push[AInstr](out, ai_cmp_imm(A_X0(), 0));
    push[AInstr](out, ai_jl(l_fail));
    push[AInstr](out, ai_load(A_X9(), A_SP(), 8));      // write(fd, ptr, len)
    push[AInstr](out, ai_load(A_X1(), A_X9(), 0));
    push[AInstr](out, ai_load(A_X2(), A_X9(), 8));
    push[AInstr](out, ai_syscall(64));
    push[AInstr](out, ai_load(A_X0(), A_SP(), 24));     // close(fd)
    push[AInstr](out, ai_syscall(57));
    if (mark_exec == 1) {
        push[AInstr](out, ai_mov_imm(A_X0(), at_fdcwd as i64));
        push[AInstr](out, ai_load(A_X1(), A_SP(), 16)); // cstr
        push[AInstr](out, ai_mov_imm(A_X2(), 493));     // 0755
        push[AInstr](out, ai_mov_imm(A_X3(), 0));
        push[AInstr](out, ai_syscall(53));              // fchmodat
    }
    push[AInstr](out, ai_mov_imm(A_X0(), 0));
    push[AInstr](out, ai_jmp(l_ret));
    push[AInstr](out, ai_label(l_fail));
    push[AInstr](out, ai_mov_imm(A_X0(), 0 - 1));
    push[AInstr](out, ai_label(l_ret));
    // The pathname is consumed synchronously by openat and, for write_exec,
    // fchmodat. Retire the bridge on both success and failure after its final
    // possible use while preserving the public return value.
    push[AInstr](out, ai_store(A_SP(), 32, A_X0()));
    push[AInstr](out, ai_load(A_X0(), A_SP(), 16));
    ac_emit_allocator_release(out, cg, A_X0());
    push[AInstr](out, ai_load(A_X0(), A_SP(), 32));
    push[AInstr](out, ai_load(A_X30(), A_SP(), 0));
    push[AInstr](out, ai_add_imm(A_SP(), 48));
    push[AInstr](out, ai_ret());
}

// __file_exists(x0=&path) -> x0 = 1/0 via faccessat(AT_FDCWD, path, F_OK).
fn ac_emit_file_exists(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    let l_no: i32 = ac_fresh(cg);
    let l_ret: i32 = ac_fresh(cg);
    let at_fdcwd: i32 = 0 - 100;
    if (cg.*.target_os == AC_OS_MACOS()) { at_fdcwd = 0 - 2; }
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_sub_imm(A_SP(), 32));
    push[AInstr](out, ai_store(A_SP(), 0, A_X30()));
    push[AInstr](out, ai_call(cg.*.pb_lbl));
    push[AInstr](out, ai_store(A_SP(), 8, A_X0()));     // cstr
    push[AInstr](out, ai_mov_rr(A_X1(), A_X0()));
    push[AInstr](out, ai_mov_imm(A_X0(), at_fdcwd as i64));
    push[AInstr](out, ai_mov_imm(A_X2(), 0));           // F_OK
    push[AInstr](out, ai_mov_imm(A_X3(), 0));
    push[AInstr](out, ai_syscall(48));                  // faccessat
    push[AInstr](out, ai_store(A_SP(), 16, A_X0()));    // rc
    push[AInstr](out, ai_load(A_X0(), A_SP(), 8));
    ac_emit_allocator_release(out, cg, A_X0());
    push[AInstr](out, ai_load(A_X0(), A_SP(), 16));
    push[AInstr](out, ai_cmp_imm(A_X0(), 0));
    push[AInstr](out, ai_jne(l_no));
    push[AInstr](out, ai_mov_imm(A_X0(), 1));
    push[AInstr](out, ai_jmp(l_ret));
    push[AInstr](out, ai_label(l_no));
    push[AInstr](out, ai_mov_imm(A_X0(), 0));
    push[AInstr](out, ai_label(l_ret));
    push[AInstr](out, ai_load(A_X30(), A_SP(), 0));
    push[AInstr](out, ai_add_imm(A_SP(), 32));
    push[AInstr](out, ai_ret());
}

// __exec_cmd(x0=&cmd) -> x0 = child exit status.
// clone(SIGCHLD) → child execve("/bin/sh", ["/bin/sh","-c",cmd,0], envp);
// parent wait4 → (status/256)&255. envp forwarded from x27 + 16 + 8*argc.
fn ac_emit_exec_cmd(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    let sh_off: i32 = ac_rt_push_cstr(cg, "/bin/sh");
    let dashc_off: i32 = ac_rt_push_cstr(cg, "-c");
    let l_child: i32 = ac_fresh(cg);
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_sub_imm(A_SP(), 80));
    push[AInstr](out, ai_store(A_SP(), 0, A_X30()));
    push[AInstr](out, ai_call(cg.*.pb_lbl));            // x0 = cmd cstr
    push[AInstr](out, ai_store(A_SP(), 8, A_X0()));
    // argv block: [sp+32]="/bin/sh" [sp+40]="-c" [sp+48]=cmd [sp+56]=NULL
    push[AInstr](out, ai_data_addr(A_X9(), sh_off));
    push[AInstr](out, ai_store(A_SP(), 32, A_X9()));
    push[AInstr](out, ai_data_addr(A_X9(), dashc_off));
    push[AInstr](out, ai_store(A_SP(), 40, A_X9()));
    push[AInstr](out, ai_load(A_X9(), A_SP(), 8));
    push[AInstr](out, ai_store(A_SP(), 48, A_X9()));
    push[AInstr](out, ai_mov_imm(A_X9(), 0));
    push[AInstr](out, ai_store(A_SP(), 56, A_X9()));
    push[AInstr](out, ai_mov_imm(A_X0(), 17));          // clone(SIGCHLD,0,0,0,0)
    push[AInstr](out, ai_mov_imm(A_X1(), 0));
    push[AInstr](out, ai_mov_imm(A_X2(), 0));
    push[AInstr](out, ai_mov_imm(A_X3(), 0));
    push[AInstr](out, ai_mov_imm(A_X4(), 0));
    push[AInstr](out, ai_syscall(220));
    push[AInstr](out, ai_cmp_imm(A_X0(), 0));
    push[AInstr](out, ai_je(l_child));
    // parent: wait4(pid, &status@sp+16, 0, 0)
    push[AInstr](out, ai_mov_rr(A_X1(), A_SP()));
    push[AInstr](out, ai_add_imm(A_X1(), 16));
    push[AInstr](out, ai_mov_imm(A_X2(), 0));
    push[AInstr](out, ai_mov_imm(A_X3(), 0));
    push[AInstr](out, ai_syscall(260));
    push[AInstr](out, ai_load(A_X9(), A_SP(), 16));
    push[AInstr](out, ai_mov_imm(A_X10(), 256));
    push[AInstr](out, ai_sdiv(A_X11(), A_X9(), A_X10()));
    push[AInstr](out, ai_and_imm(A_X11(), 255));        // WEXITSTATUS
    push[AInstr](out, ai_mov_rr(A_X0(), A_X11()));
    push[AInstr](out, ai_load(A_X30(), A_SP(), 0));
    push[AInstr](out, ai_add_imm(A_SP(), 80));
    push[AInstr](out, ai_ret());
    // child: execve("/bin/sh", argv, envp)
    push[AInstr](out, ai_label(l_child));
    push[AInstr](out, ai_data_addr(A_X0(), sh_off));
    push[AInstr](out, ai_mov_rr(A_X1(), A_SP()));
    push[AInstr](out, ai_add_imm(A_X1(), 32));
    push[AInstr](out, ai_load(A_X9(), A_X27(), 0));     // argc
    push[AInstr](out, ai_mov_imm(A_X10(), 8));
    push[AInstr](out, ai_mul(A_X11(), A_X9(), A_X10()));
    push[AInstr](out, ai_add(A_X11(), A_X27()));
    push[AInstr](out, ai_add_imm(A_X11(), 16));         // envp
    push[AInstr](out, ai_mov_rr(A_X2(), A_X11()));
    push[AInstr](out, ai_syscall(221));                 // execve
    push[AInstr](out, ai_mov_imm(A_X0(), 127));         // execve failed
    push[AInstr](out, ai_syscall(93));
}

// __strdup(x0=&s) -> x0=&{buf,len}. The data buffer and temporary descriptor
// follow the same two-allocation shape as the x86 native runtime; call-site
// lowering retires only the descriptor.
fn ac_emit_strdup(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_sub_imm(A_SP(), 48));
    push[AInstr](out, ai_store(A_SP(), 0, A_X30()));
    push[AInstr](out, ai_load(A_X9(), A_X0(), 0));
    push[AInstr](out, ai_store(A_SP(), 8, A_X9()));     // src.ptr
    push[AInstr](out, ai_load(A_X9(), A_X0(), 8));
    push[AInstr](out, ai_store(A_SP(), 16, A_X9()));    // src.len
    push[AInstr](out, ai_mov_rr(A_X0(), A_X9()));
    push[AInstr](out, ai_call(cg.*.al_lbl));
    push[AInstr](out, ai_store(A_SP(), 24, A_X0()));    // buf
    push[AInstr](out, ai_load(A_X9(), A_SP(), 8));
    push[AInstr](out, ai_mov_rr(A_X10(), A_X0()));
    push[AInstr](out, ai_load(A_X11(), A_SP(), 16));
    ac_rt_copy(out, cg);
    push[AInstr](out, ai_load(A_X0(), A_SP(), 24));
    push[AInstr](out, ai_load(A_X1(), A_SP(), 16));
    push[AInstr](out, ai_call(cg.*.ms_lbl));
    push[AInstr](out, ai_load(A_X30(), A_SP(), 0));
    push[AInstr](out, ai_add_imm(A_SP(), 48));
    push[AInstr](out, ai_ret());
}

// __strcmp_ord(x0=&a, x1=&b) -> first unsigned-byte difference, or the signed
// length difference after an equal prefix.
fn ac_emit_strcmp_ord(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    let l_amin: i32 = ac_fresh(cg);
    let l_top: i32 = ac_fresh(cg);
    let l_lengths: i32 = ac_fresh(cg);
    let l_diff: i32 = ac_fresh(cg);
    let l_ret: i32 = ac_fresh(cg);
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_load(A_X2(), A_X0(), 0));
    push[AInstr](out, ai_load(A_X3(), A_X0(), 8));
    push[AInstr](out, ai_load(A_X4(), A_X1(), 0));
    push[AInstr](out, ai_load(A_X5(), A_X1(), 8));
    push[AInstr](out, ai_mov_rr(A_X6(), A_X3()));
    push[AInstr](out, ai_cmp(A_X3(), A_X5()));
    push[AInstr](out, ai_jle(l_amin));
    push[AInstr](out, ai_mov_rr(A_X6(), A_X5()));
    push[AInstr](out, ai_label(l_amin));
    push[AInstr](out, ai_mov_imm(A_X7(), 0));
    push[AInstr](out, ai_label(l_top));
    push[AInstr](out, ai_cmp(A_X7(), A_X6()));
    push[AInstr](out, ai_jge(l_lengths));
    push[AInstr](out, ai_mov_rr(A_X10(), A_X2()));
    push[AInstr](out, ai_add(A_X10(), A_X7()));
    push[AInstr](out, ai_loadb(A_X9(), A_X10(), 0));
    push[AInstr](out, ai_mov_rr(A_X10(), A_X4()));
    push[AInstr](out, ai_add(A_X10(), A_X7()));
    push[AInstr](out, ai_loadb(A_X10(), A_X10(), 0));
    push[AInstr](out, ai_cmp(A_X9(), A_X10()));
    push[AInstr](out, ai_jne(l_diff));
    push[AInstr](out, ai_add_imm(A_X7(), 1));
    push[AInstr](out, ai_jmp(l_top));
    push[AInstr](out, ai_label(l_diff));
    push[AInstr](out, ai_mov_rr(A_X0(), A_X9()));
    push[AInstr](out, ai_sub(A_X0(), A_X10()));
    push[AInstr](out, ai_jmp(l_ret));
    push[AInstr](out, ai_label(l_lengths));
    push[AInstr](out, ai_mov_rr(A_X0(), A_X3()));
    push[AInstr](out, ai_sub(A_X0(), A_X5()));
    push[AInstr](out, ai_label(l_ret));
    push[AInstr](out, ai_ret());
}

// __str_index_of_byte(x0=&s, x1=b) -> index/-1. The search byte is truncated
// modulo 256, including for negative inputs, matching x86's `b & 0xff` rule.
fn ac_emit_idxbyte(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    let l_top: i32 = ac_fresh(cg);
    let l_found: i32 = ac_fresh(cg);
    let l_miss: i32 = ac_fresh(cg);
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_and_imm(A_X1(), 255));
    push[AInstr](out, ai_load(A_X2(), A_X0(), 0));
    push[AInstr](out, ai_load(A_X3(), A_X0(), 8));
    push[AInstr](out, ai_mov_imm(A_X4(), 0));
    push[AInstr](out, ai_label(l_top));
    push[AInstr](out, ai_cmp(A_X4(), A_X3()));
    push[AInstr](out, ai_jge(l_miss));
    push[AInstr](out, ai_mov_rr(A_X5(), A_X2()));
    push[AInstr](out, ai_add(A_X5(), A_X4()));
    push[AInstr](out, ai_loadb(A_X5(), A_X5(), 0));
    push[AInstr](out, ai_cmp(A_X5(), A_X1()));
    push[AInstr](out, ai_je(l_found));
    push[AInstr](out, ai_add_imm(A_X4(), 1));
    push[AInstr](out, ai_jmp(l_top));
    push[AInstr](out, ai_label(l_found));
    push[AInstr](out, ai_mov_rr(A_X0(), A_X4()));
    push[AInstr](out, ai_ret());
    push[AInstr](out, ai_label(l_miss));
    push[AInstr](out, ai_mov_imm(A_X0(), 0 - 1));
    push[AInstr](out, ai_ret());
}

// Forward-copy memcpy semantics. Overlap remains outside the public helper's
// contract; zero or negative counts perform no access and return dst.
fn ac_emit_memcpy(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    let l_top: i32 = ac_fresh(cg);
    let l_end: i32 = ac_fresh(cg);
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_mov_rr(A_X3(), A_X0()));      // preserved dst result
    push[AInstr](out, ai_mov_imm(A_X4(), 0));
    push[AInstr](out, ai_label(l_top));
    push[AInstr](out, ai_cmp(A_X4(), A_X2()));
    push[AInstr](out, ai_jge(l_end));
    push[AInstr](out, ai_mov_rr(A_X5(), A_X1()));
    push[AInstr](out, ai_add(A_X5(), A_X4()));
    push[AInstr](out, ai_loadb(A_X6(), A_X5(), 0));
    push[AInstr](out, ai_mov_rr(A_X7(), A_X0()));
    push[AInstr](out, ai_add(A_X7(), A_X4()));
    push[AInstr](out, ai_storeb(A_X7(), 0, A_X6()));
    push[AInstr](out, ai_add_imm(A_X4(), 1));
    push[AInstr](out, ai_jmp(l_top));
    push[AInstr](out, ai_label(l_end));
    push[AInstr](out, ai_mov_rr(A_X0(), A_X3()));
    push[AInstr](out, ai_ret());
}

// __memcmp(x0=a, x1=b, x2=n) -> first unsigned-byte difference or zero.
fn ac_emit_memcmp(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    let l_top: i32 = ac_fresh(cg);
    let l_diff: i32 = ac_fresh(cg);
    let l_equal: i32 = ac_fresh(cg);
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_mov_imm(A_X3(), 0));
    push[AInstr](out, ai_label(l_top));
    push[AInstr](out, ai_cmp(A_X3(), A_X2()));
    push[AInstr](out, ai_jge(l_equal));
    push[AInstr](out, ai_mov_rr(A_X4(), A_X0()));
    push[AInstr](out, ai_add(A_X4(), A_X3()));
    push[AInstr](out, ai_loadb(A_X4(), A_X4(), 0));
    push[AInstr](out, ai_mov_rr(A_X5(), A_X1()));
    push[AInstr](out, ai_add(A_X5(), A_X3()));
    push[AInstr](out, ai_loadb(A_X5(), A_X5(), 0));
    push[AInstr](out, ai_cmp(A_X4(), A_X5()));
    push[AInstr](out, ai_jne(l_diff));
    push[AInstr](out, ai_add_imm(A_X3(), 1));
    push[AInstr](out, ai_jmp(l_top));
    push[AInstr](out, ai_label(l_diff));
    push[AInstr](out, ai_mov_rr(A_X0(), A_X4()));
    push[AInstr](out, ai_sub(A_X0(), A_X5()));
    push[AInstr](out, ai_ret());
    push[AInstr](out, ai_label(l_equal));
    push[AInstr](out, ai_mov_imm(A_X0(), 0));
    push[AInstr](out, ai_ret());
}

// __getenv(x0=&name) -> x0=&{value,len}; unset -> &{0,0}. Values are borrowed
// views of the immutable startup environment, not checked allocations.
fn ac_emit_getenv(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    let l_env: i32 = ac_fresh(cg);
    let l_cmp: i32 = ac_fresh(cg);
    let l_check_eq: i32 = ac_fresh(cg);
    let l_next: i32 = ac_fresh(cg);
    let l_scan: i32 = ac_fresh(cg);
    let l_make: i32 = ac_fresh(cg);
    let l_miss: i32 = ac_fresh(cg);
    let l_ret: i32 = ac_fresh(cg);
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_sub_imm(A_SP(), 32));
    push[AInstr](out, ai_store(A_SP(), 0, A_X30()));
    push[AInstr](out, ai_load(A_X5(), A_X0(), 0));     // name.ptr
    push[AInstr](out, ai_load(A_X6(), A_X0(), 8));     // name.len
    push[AInstr](out, ai_load(A_X2(), A_X27(), 0));    // argc
    push[AInstr](out, ai_mov_imm(A_X7(), 8));
    push[AInstr](out, ai_mul(A_X2(), A_X2(), A_X7()));
    push[AInstr](out, ai_add(A_X2(), A_X27()));
    push[AInstr](out, ai_add_imm(A_X2(), 16));         // envp cursor
    push[AInstr](out, ai_label(l_env));
    push[AInstr](out, ai_load(A_X3(), A_X2(), 0));
    push[AInstr](out, ai_cmp_imm(A_X3(), 0));
    push[AInstr](out, ai_je(l_miss));
    push[AInstr](out, ai_mov_imm(A_X4(), 0));
    push[AInstr](out, ai_label(l_cmp));
    push[AInstr](out, ai_cmp(A_X4(), A_X6()));
    push[AInstr](out, ai_jge(l_check_eq));
    push[AInstr](out, ai_mov_rr(A_X9(), A_X3()));
    push[AInstr](out, ai_add(A_X9(), A_X4()));
    push[AInstr](out, ai_loadb(A_X9(), A_X9(), 0));
    push[AInstr](out, ai_mov_rr(A_X10(), A_X5()));
    push[AInstr](out, ai_add(A_X10(), A_X4()));
    push[AInstr](out, ai_loadb(A_X10(), A_X10(), 0));
    push[AInstr](out, ai_cmp(A_X9(), A_X10()));
    push[AInstr](out, ai_jne(l_next));
    push[AInstr](out, ai_add_imm(A_X4(), 1));
    push[AInstr](out, ai_jmp(l_cmp));
    push[AInstr](out, ai_label(l_check_eq));
    push[AInstr](out, ai_mov_rr(A_X9(), A_X3()));
    push[AInstr](out, ai_add(A_X9(), A_X6()));
    push[AInstr](out, ai_loadb(A_X9(), A_X9(), 0));
    push[AInstr](out, ai_cmp_imm(A_X9(), 61));
    push[AInstr](out, ai_jne(l_next));
    push[AInstr](out, ai_mov_rr(A_X0(), A_X3()));
    push[AInstr](out, ai_add(A_X0(), A_X6()));
    push[AInstr](out, ai_add_imm(A_X0(), 1));
    push[AInstr](out, ai_mov_imm(A_X1(), 0));
    push[AInstr](out, ai_label(l_scan));
    push[AInstr](out, ai_mov_rr(A_X9(), A_X0()));
    push[AInstr](out, ai_add(A_X9(), A_X1()));
    push[AInstr](out, ai_loadb(A_X9(), A_X9(), 0));
    push[AInstr](out, ai_cmp_imm(A_X9(), 0));
    push[AInstr](out, ai_je(l_make));
    push[AInstr](out, ai_add_imm(A_X1(), 1));
    push[AInstr](out, ai_jmp(l_scan));
    push[AInstr](out, ai_label(l_make));
    push[AInstr](out, ai_call(cg.*.ms_lbl));
    push[AInstr](out, ai_jmp(l_ret));
    push[AInstr](out, ai_label(l_next));
    push[AInstr](out, ai_add_imm(A_X2(), 8));
    push[AInstr](out, ai_jmp(l_env));
    push[AInstr](out, ai_label(l_miss));
    push[AInstr](out, ai_mov_imm(A_X0(), 0));
    push[AInstr](out, ai_mov_imm(A_X1(), 0));
    push[AInstr](out, ai_call(cg.*.ms_lbl));
    push[AInstr](out, ai_label(l_ret));
    push[AInstr](out, ai_load(A_X30(), A_SP(), 0));
    push[AInstr](out, ai_add_imm(A_SP(), 32));
    push[AInstr](out, ai_ret());
}

// __exec_capture(x0=&cmd) -> x0=&{buf,total}. Linux AArch64 uses pipe2/dup3;
// Darwin's translated pipe syscall returns descriptors in x0/x1 and its dup2
// trap has no flags argument. The remaining process ABI is expressed with the
// stable AArch64 syscall identities translated by the Mach-O encoder.
fn ac_emit_exec_capture(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    let sh_off: i32 = ac_rt_push_cstr(cg, "/bin/sh");
    let dashc_off: i32 = ac_rt_push_cstr(cg, "-c");
    let l_child: i32 = ac_fresh(cg);
    let l_rtop: i32 = ac_fresh(cg);
    let l_haveroom: i32 = ac_fresh(cg);
    let l_rdone: i32 = ac_fresh(cg);
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_sub_imm(A_SP(), 160));
    push[AInstr](out, ai_store(A_SP(), 0, A_X30()));
    push[AInstr](out, ai_call(cg.*.pb_lbl));
    push[AInstr](out, ai_store(A_SP(), 8, A_X0()));     // command cstr

    // argv[0..3] at SP+96, in ascending address order.
    push[AInstr](out, ai_data_addr(A_X9(), sh_off));
    push[AInstr](out, ai_store(A_SP(), 96, A_X9()));
    push[AInstr](out, ai_data_addr(A_X9(), dashc_off));
    push[AInstr](out, ai_store(A_SP(), 104, A_X9()));
    push[AInstr](out, ai_load(A_X9(), A_SP(), 8));
    push[AInstr](out, ai_store(A_SP(), 112, A_X9()));
    push[AInstr](out, ai_mov_imm(A_X9(), 0));
    push[AInstr](out, ai_store(A_SP(), 120, A_X9()));

    if (cg.*.target_os == AC_OS_MACOS()) {
        // XNU pipe() has no pointer argument and returns {readfd,writefd} in
        // x0/x1. AK_SYSCALL(59) translates to Darwin syscall 42.
        push[AInstr](out, ai_mov_imm(A_X0(), 0));
        push[AInstr](out, ai_mov_imm(A_X1(), 0));
        push[AInstr](out, ai_syscall(59));
        push[AInstr](out, ai_store(A_SP(), 16, A_X0()));
        push[AInstr](out, ai_store(A_SP(), 24, A_X1()));
    } else {
        // pipe2(int pair[2], 0); load each signed i32 independently.
        push[AInstr](out, ai_mov_rr(A_X0(), A_SP()));
        push[AInstr](out, ai_add_imm(A_X0(), 72));
        push[AInstr](out, ai_mov_imm(A_X1(), 0));
        push[AInstr](out, ai_syscall(59));
        push[AInstr](out, ai_loadw(A_X9(), A_SP(), 72));
        push[AInstr](out, ai_sxtw(A_X9(), A_X9()));
        push[AInstr](out, ai_store(A_SP(), 16, A_X9()));
        push[AInstr](out, ai_loadw(A_X9(), A_SP(), 76));
        push[AInstr](out, ai_sxtw(A_X9(), A_X9()));
        push[AInstr](out, ai_store(A_SP(), 24, A_X9()));
    }

    // fork-equivalent clone(SIGCHLD, 0, 0, 0, 0). The Darwin encoder
    // normalizes XNU's two-register fork result to parent pid / child zero.
    push[AInstr](out, ai_mov_imm(A_X0(), 17));
    push[AInstr](out, ai_mov_imm(A_X1(), 0));
    push[AInstr](out, ai_mov_imm(A_X2(), 0));
    push[AInstr](out, ai_mov_imm(A_X3(), 0));
    push[AInstr](out, ai_mov_imm(A_X4(), 0));
    push[AInstr](out, ai_syscall(220));
    push[AInstr](out, ai_cmp_imm(A_X0(), 0));
    push[AInstr](out, ai_je(l_child));

    // Parent: close the write end, then read until EOF into a doubling buffer.
    push[AInstr](out, ai_store(A_SP(), 56, A_X0()));    // pid
    push[AInstr](out, ai_load(A_X0(), A_SP(), 24));
    push[AInstr](out, ai_syscall(57));
    push[AInstr](out, ai_mov_imm(A_X0(), 65536));
    push[AInstr](out, ai_call(cg.*.al_lbl));
    push[AInstr](out, ai_store(A_SP(), 32, A_X0()));    // buf
    push[AInstr](out, ai_mov_imm(A_X9(), 65536));
    push[AInstr](out, ai_store(A_SP(), 40, A_X9()));    // cap
    push[AInstr](out, ai_mov_imm(A_X9(), 0));
    push[AInstr](out, ai_store(A_SP(), 48, A_X9()));    // total
    push[AInstr](out, ai_label(l_rtop));
    push[AInstr](out, ai_load(A_X9(), A_SP(), 40));
    push[AInstr](out, ai_load(A_X10(), A_SP(), 48));
    push[AInstr](out, ai_mov_rr(A_X11(), A_X9()));
    push[AInstr](out, ai_sub(A_X11(), A_X10()));
    push[AInstr](out, ai_cmp_imm(A_X11(), 0));
    push[AInstr](out, ai_jg(l_haveroom));
    push[AInstr](out, ai_load(A_X0(), A_SP(), 32));
    push[AInstr](out, ai_load(A_X1(), A_SP(), 40));
    push[AInstr](out, ai_add(A_X1(), A_X1()));
    push[AInstr](out, ai_store(A_SP(), 40, A_X1()));
    push[AInstr](out, ai_call(cg.*.rl_lbl));
    push[AInstr](out, ai_store(A_SP(), 32, A_X0()));
    push[AInstr](out, ai_label(l_haveroom));
    push[AInstr](out, ai_load(A_X0(), A_SP(), 16));
    push[AInstr](out, ai_load(A_X1(), A_SP(), 32));
    push[AInstr](out, ai_load(A_X9(), A_SP(), 48));
    push[AInstr](out, ai_add(A_X1(), A_X9()));
    push[AInstr](out, ai_load(A_X2(), A_SP(), 40));
    push[AInstr](out, ai_sub(A_X2(), A_X9()));
    push[AInstr](out, ai_syscall(63));
    push[AInstr](out, ai_cmp_imm(A_X0(), 0));
    push[AInstr](out, ai_jle(l_rdone));
    push[AInstr](out, ai_load(A_X9(), A_SP(), 48));
    push[AInstr](out, ai_add(A_X9(), A_X0()));
    push[AInstr](out, ai_store(A_SP(), 48, A_X9()));
    push[AInstr](out, ai_jmp(l_rtop));
    push[AInstr](out, ai_label(l_rdone));
    push[AInstr](out, ai_load(A_X0(), A_SP(), 16));
    push[AInstr](out, ai_syscall(57));
    push[AInstr](out, ai_load(A_X0(), A_SP(), 56));
    push[AInstr](out, ai_mov_rr(A_X1(), A_SP()));
    push[AInstr](out, ai_add_imm(A_X1(), 64));
    push[AInstr](out, ai_mov_imm(A_X2(), 0));
    push[AInstr](out, ai_mov_imm(A_X3(), 0));
    push[AInstr](out, ai_syscall(260));
    push[AInstr](out, ai_load(A_X0(), A_SP(), 8));
    ac_emit_allocator_release(out, cg, A_X0());
    push[AInstr](out, ai_load(A_X0(), A_SP(), 32));
    push[AInstr](out, ai_load(A_X1(), A_SP(), 48));
    push[AInstr](out, ai_call(cg.*.ms_lbl));
    push[AInstr](out, ai_load(A_X30(), A_SP(), 0));
    push[AInstr](out, ai_add_imm(A_SP(), 160));
    push[AInstr](out, ai_ret());

    // Child: stdout <- writefd, close the inherited pair, then exec the shell.
    push[AInstr](out, ai_label(l_child));
    push[AInstr](out, ai_load(A_X0(), A_SP(), 24));
    push[AInstr](out, ai_mov_imm(A_X1(), 1));
    if (cg.*.target_os == AC_OS_MACOS()) {
        push[AInstr](out, ai_syscall(23));              // Darwin dup2
    } else {
        push[AInstr](out, ai_mov_imm(A_X2(), 0));
        push[AInstr](out, ai_syscall(24));              // Linux dup3
    }
    push[AInstr](out, ai_load(A_X0(), A_SP(), 16));
    push[AInstr](out, ai_syscall(57));
    push[AInstr](out, ai_load(A_X0(), A_SP(), 24));
    push[AInstr](out, ai_syscall(57));
    push[AInstr](out, ai_data_addr(A_X0(), sh_off));
    push[AInstr](out, ai_mov_rr(A_X1(), A_SP()));
    push[AInstr](out, ai_add_imm(A_X1(), 96));
    push[AInstr](out, ai_load(A_X9(), A_X27(), 0));
    push[AInstr](out, ai_mov_imm(A_X10(), 8));
    push[AInstr](out, ai_mul(A_X2(), A_X9(), A_X10()));
    push[AInstr](out, ai_add(A_X2(), A_X27()));
    push[AInstr](out, ai_add_imm(A_X2(), 16));
    push[AInstr](out, ai_syscall(221));
    push[AInstr](out, ai_mov_imm(A_X0(), 127));
    push[AInstr](out, ai_syscall(93));
}

// __str_to_i64(x0=&s) -> x0. Optional leading '-'; non-digits skipped
// (lenient, mirrors the x86 routine byte-for-byte in behaviour).
fn ac_emit_str2i(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    let l_noneg: i32 = ac_fresh(cg);
    let l_top: i32 = ac_fresh(cg);
    let l_skip: i32 = ac_fresh(cg);
    let l_end: i32 = ac_fresh(cg);
    let l_pos: i32 = ac_fresh(cg);
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_load(A_X9(), A_X0(), 0));      // ptr
    push[AInstr](out, ai_load(A_X10(), A_X0(), 8));     // len
    push[AInstr](out, ai_mov_imm(A_X0(), 0));           // acc
    push[AInstr](out, ai_mov_imm(A_X11(), 0));          // i
    push[AInstr](out, ai_mov_imm(A_X12(), 0));          // neg flag
    push[AInstr](out, ai_cmp_imm(A_X10(), 0));
    push[AInstr](out, ai_jle(l_noneg));
    push[AInstr](out, ai_loadb(A_X13(), A_X9(), 0));
    push[AInstr](out, ai_cmp_imm(A_X13(), 45));         // '-'
    push[AInstr](out, ai_jne(l_noneg));
    push[AInstr](out, ai_mov_imm(A_X12(), 1));
    push[AInstr](out, ai_mov_imm(A_X11(), 1));
    push[AInstr](out, ai_label(l_noneg));
    push[AInstr](out, ai_label(l_top));
    push[AInstr](out, ai_cmp(A_X11(), A_X10()));
    push[AInstr](out, ai_jge(l_end));
    push[AInstr](out, ai_mov_rr(A_X13(), A_X9()));
    push[AInstr](out, ai_add(A_X13(), A_X11()));
    push[AInstr](out, ai_loadb(A_X14(), A_X13(), 0));
    push[AInstr](out, ai_sub_imm(A_X14(), 48));
    push[AInstr](out, ai_cmp_imm(A_X14(), 0));
    push[AInstr](out, ai_jl(l_skip));
    push[AInstr](out, ai_cmp_imm(A_X14(), 9));
    push[AInstr](out, ai_jg(l_skip));
    push[AInstr](out, ai_mov_imm(A_X13(), 10));
    push[AInstr](out, ai_mul(A_X15(), A_X0(), A_X13()));
    push[AInstr](out, ai_mov_rr(A_X0(), A_X15()));
    push[AInstr](out, ai_add(A_X0(), A_X14()));
    push[AInstr](out, ai_label(l_skip));
    push[AInstr](out, ai_add_imm(A_X11(), 1));
    push[AInstr](out, ai_jmp(l_top));
    push[AInstr](out, ai_label(l_end));
    push[AInstr](out, ai_cmp_imm(A_X12(), 0));
    push[AInstr](out, ai_je(l_pos));
    push[AInstr](out, ai_neg(A_X0(), A_X0()));
    push[AInstr](out, ai_label(l_pos));
    push[AInstr](out, ai_ret());
}

// append literal byte `c` at [x1], advancing x1. Clobbers x2 only.
fn apf_putc(out: *ArrayList[AInstr], c: i32) void {
    push[AInstr](out, ai_mov_imm(A_X2(), c as i64));
    push[AInstr](out, ai_storeb(A_X1(), 0, A_X2()));
    push[AInstr](out, ai_add_imm(A_X1(), 1));
}
// append the 0..9 digit slot at [x6] as ASCII at [x1]; advances x1 only.
fn apf_put_ds(out: *ArrayList[AInstr]) void {
    push[AInstr](out, ai_load(A_X2(), A_X6(), 0));
    push[AInstr](out, ai_add_imm(A_X2(), 48));
    push[AInstr](out, ai_storeb(A_X1(), 0, A_X2()));
    push[AInstr](out, ai_add_imm(A_X1(), 1));
}

// __print_f64(x0 = double bit pattern): %g with 6 significant digits + '\n'.
// Direct port of the x86 routine (cg_emit_print_f64) — same algorithm:
// normalise |V| into [1,10) tracking exp10; D = trunc(V*1e5 + 0.5); peel 6
// digits; FIXED for exp10 in [-4,5], else SCIENTIFIC d.ddddde±NN.
// Frame: [SP..SP+128) OUTBUF, ds[i] at SP+128+8i, expr stack from SP+192.
fn ac_emit_print_f64(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    let l_nosign: i32 = ac_fresh(cg);
    let l_nonzero: i32 = ac_fresh(cg);
    let l_finish: i32 = ac_fresh(cg);
    let l_nhi: i32 = ac_fresh(cg);
    let l_nhi_done: i32 = ac_fresh(cg);
    let l_nlo: i32 = ac_fresh(cg);
    let l_nlo_done: i32 = ac_fresh(cg);
    let l_dok: i32 = ac_fresh(cg);
    let l_last: i32 = ac_fresh(cg);
    let l_last_done: i32 = ac_fresh(cg);
    let l_sci: i32 = ac_fresh(cg);
    let l_fixed_neg: i32 = ac_fresh(cg);
    let l_fi_int: i32 = ac_fresh(cg);
    let l_fi_int_d: i32 = ac_fresh(cg);
    let l_fi_frac: i32 = ac_fresh(cg);
    let l_fixdone: i32 = ac_fresh(cg);
    let l_nz: i32 = ac_fresh(cg);
    let l_nz_done: i32 = ac_fresh(cg);
    let l_ndig: i32 = ac_fresh(cg);
    let l_scifrac: i32 = ac_fresh(cg);
    let l_sci_e: i32 = ac_fresh(cg);
    let l_sci_eneg: i32 = ac_fresh(cg);
    let l_sci_emit: i32 = ac_fresh(cg);
    let l_sci_ebig: i32 = ac_fresh(cg);
    let l_sci_peel: i32 = ac_fresh(cg);
    let l_sci_pop: i32 = ac_fresh(cg);

    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_sub_imm(A_SP(), 32));
    push[AInstr](out, ai_store(A_SP(), 0, A_X29()));
    push[AInstr](out, ai_store(A_SP(), 8, A_X30()));
    push[AInstr](out, ai_store(A_SP(), 16, A_X28()));
    push[AInstr](out, ai_mov_rr(A_X29(), A_SP()));
    push[AInstr](out, ai_sub_imm(A_SP(), 256));
    push[AInstr](out, ai_mov_rr(A_X28(), A_SP()));
    push[AInstr](out, ai_add_imm(A_X28(), 192));

    // write ptr x1 = OUTBUF (SP+0)
    push[AInstr](out, ai_mov_rr(A_X1(), A_SP()));

    // sign
    push[AInstr](out, ai_cmp_imm(A_X0(), 0));
    push[AInstr](out, ai_jge(l_nosign));
    apf_putc(out, 45);
    push[AInstr](out, ai_label(l_nosign));
    // abs bits: x2 = x0 & 0x7FFF...
    push[AInstr](out, ai_mov_rr(A_X2(), A_X0()));
    push[AInstr](out, ai_mov_imm(A_X9(), 9223372036854775807));
    push[AInstr](out, ai_andr(A_X2(), A_X9()));
    push[AInstr](out, ai_cmp_imm(A_X2(), 0));
    push[AInstr](out, ai_jne(l_nonzero));
    apf_putc(out, 48);
    push[AInstr](out, ai_jmp(l_finish));

    push[AInstr](out, ai_label(l_nonzero));
    push[AInstr](out, ai_fmov_dx(0, A_X2()));           // d0 = |V|
    push[AInstr](out, ai_mov_imm(A_X5(), 0));           // x5 = exp10
    push[AInstr](out, ai_mov_imm(A_X2(), 4621819117588971520));   // 10.0
    push[AInstr](out, ai_fmov_dx(1, A_X2()));
    // while V >= 10: V /= 10; exp10++
    push[AInstr](out, ai_label(l_nhi));
    push[AInstr](out, ai_fcmp(0, 1));
    push[AInstr](out, ai_jl(l_nhi_done));
    push[AInstr](out, ai_fdiv(0, 1));
    push[AInstr](out, ai_add_imm(A_X5(), 1));
    push[AInstr](out, ai_jmp(l_nhi));
    push[AInstr](out, ai_label(l_nhi_done));
    push[AInstr](out, ai_mov_imm(A_X2(), 4607182418800017408));   // 1.0
    push[AInstr](out, ai_fmov_dx(2, A_X2()));
    // while V < 1: V *= 10; exp10--
    push[AInstr](out, ai_label(l_nlo));
    push[AInstr](out, ai_fcmp(0, 2));
    push[AInstr](out, ai_jge(l_nlo_done));
    push[AInstr](out, ai_fmul(0, 1));
    push[AInstr](out, ai_sub_imm(A_X5(), 1));
    push[AInstr](out, ai_jmp(l_nlo));
    push[AInstr](out, ai_label(l_nlo_done));

    // D = trunc(V*1e5 + 0.5)
    push[AInstr](out, ai_mov_imm(A_X2(), 4681608360884174848));   // 1e5
    push[AInstr](out, ai_fmov_dx(3, A_X2()));
    push[AInstr](out, ai_fmul(0, 3));
    push[AInstr](out, ai_mov_imm(A_X2(), 4602678819172646912));   // 0.5
    push[AInstr](out, ai_fmov_dx(3, A_X2()));
    push[AInstr](out, ai_fadd(0, 3));
    push[AInstr](out, ai_fcvtzs(A_X2(), 0));            // x2 = D
    // carry fix
    push[AInstr](out, ai_cmp_imm(A_X2(), 1000000));
    push[AInstr](out, ai_jl(l_dok));
    push[AInstr](out, ai_mov_imm(A_X9(), 10));
    push[AInstr](out, ai_sdiv(A_X2(), A_X2(), A_X9()));
    push[AInstr](out, ai_add_imm(A_X5(), 1));
    push[AInstr](out, ai_label(l_dok));

    // peel 6 digits into ds[5..0] (SP+128+8i)
    push[AInstr](out, ai_mov_imm(A_X3(), 10));
    let dsl: i32 = 5;
    while (dsl >= 0) {
        push[AInstr](out, ai_sdiv(A_X4(), A_X2(), A_X3()));
        push[AInstr](out, ai_mul(A_X7(), A_X4(), A_X3()));
        push[AInstr](out, ai_sub(A_X2(), A_X7()));
        push[AInstr](out, ai_store(A_SP(), 128 + 8 * dsl, A_X2()));
        push[AInstr](out, ai_mov_rr(A_X2(), A_X4()));
        dsl = dsl - 1;
    }

    // last = highest i in 0..5 with ds[i] != 0
    push[AInstr](out, ai_mov_imm(A_X3(), 5));
    push[AInstr](out, ai_mov_rr(A_X6(), A_SP()));
    push[AInstr](out, ai_add_imm(A_X6(), 128 + 40));
    push[AInstr](out, ai_label(l_last));
    push[AInstr](out, ai_cmp_imm(A_X3(), 0));
    push[AInstr](out, ai_jle(l_last_done));
    push[AInstr](out, ai_load(A_X2(), A_X6(), 0));
    push[AInstr](out, ai_cmp_imm(A_X2(), 0));
    push[AInstr](out, ai_jne(l_last_done));
    push[AInstr](out, ai_sub_imm(A_X3(), 1));
    push[AInstr](out, ai_sub_imm(A_X6(), 8));
    push[AInstr](out, ai_jmp(l_last));
    push[AInstr](out, ai_label(l_last_done));
    push[AInstr](out, ai_mov_rr(A_X7(), A_X3()));       // x7 = last

    // scientific iff exp10 < -4 or exp10 >= 6
    push[AInstr](out, ai_cmp_imm(A_X5(), 0 - 4));
    push[AInstr](out, ai_jl(l_sci));
    push[AInstr](out, ai_cmp_imm(A_X5(), 6));
    push[AInstr](out, ai_jge(l_sci));
    // FIXED
    push[AInstr](out, ai_cmp_imm(A_X5(), 0));
    push[AInstr](out, ai_jl(l_fixed_neg));
    // integer part ds[0..exp10]
    push[AInstr](out, ai_mov_rr(A_X6(), A_SP()));
    push[AInstr](out, ai_add_imm(A_X6(), 128));
    push[AInstr](out, ai_mov_imm(A_X3(), 0));
    push[AInstr](out, ai_label(l_fi_int));
    push[AInstr](out, ai_cmp(A_X3(), A_X5()));
    push[AInstr](out, ai_jg(l_fi_int_d));
    apf_put_ds(out);
    push[AInstr](out, ai_add_imm(A_X6(), 8));
    push[AInstr](out, ai_add_imm(A_X3(), 1));
    push[AInstr](out, ai_jmp(l_fi_int));
    push[AInstr](out, ai_label(l_fi_int_d));
    // fraction ds[exp10+1..last] iff last > exp10
    push[AInstr](out, ai_cmp(A_X7(), A_X5()));
    push[AInstr](out, ai_jle(l_fixdone));
    apf_putc(out, 46);
    push[AInstr](out, ai_mov_rr(A_X3(), A_X5()));
    push[AInstr](out, ai_add_imm(A_X3(), 1));
    push[AInstr](out, ai_label(l_fi_frac));
    push[AInstr](out, ai_cmp(A_X3(), A_X7()));
    push[AInstr](out, ai_jg(l_fixdone));
    apf_put_ds(out);
    push[AInstr](out, ai_add_imm(A_X6(), 8));
    push[AInstr](out, ai_add_imm(A_X3(), 1));
    push[AInstr](out, ai_jmp(l_fi_frac));
    push[AInstr](out, ai_label(l_fixdone));
    push[AInstr](out, ai_jmp(l_finish));

    // FIXED, exp10 < 0: "0." + zeros + ds[0..last]
    push[AInstr](out, ai_label(l_fixed_neg));
    apf_putc(out, 48);
    apf_putc(out, 46);
    push[AInstr](out, ai_mov_imm(A_X3(), 0));
    push[AInstr](out, ai_sub(A_X3(), A_X5()));
    push[AInstr](out, ai_sub_imm(A_X3(), 1));
    push[AInstr](out, ai_label(l_nz));
    push[AInstr](out, ai_cmp_imm(A_X3(), 0));
    push[AInstr](out, ai_jle(l_nz_done));
    apf_putc(out, 48);
    push[AInstr](out, ai_sub_imm(A_X3(), 1));
    push[AInstr](out, ai_jmp(l_nz));
    push[AInstr](out, ai_label(l_nz_done));
    push[AInstr](out, ai_mov_rr(A_X6(), A_SP()));
    push[AInstr](out, ai_add_imm(A_X6(), 128));
    push[AInstr](out, ai_mov_imm(A_X3(), 0));
    push[AInstr](out, ai_label(l_ndig));
    push[AInstr](out, ai_cmp(A_X3(), A_X7()));
    push[AInstr](out, ai_jg(l_finish));
    apf_put_ds(out);
    push[AInstr](out, ai_add_imm(A_X6(), 8));
    push[AInstr](out, ai_add_imm(A_X3(), 1));
    push[AInstr](out, ai_jmp(l_ndig));

    // SCIENTIFIC
    push[AInstr](out, ai_label(l_sci));
    push[AInstr](out, ai_mov_rr(A_X6(), A_SP()));
    push[AInstr](out, ai_add_imm(A_X6(), 128));
    apf_put_ds(out);
    push[AInstr](out, ai_add_imm(A_X6(), 8));
    push[AInstr](out, ai_cmp_imm(A_X7(), 1));
    push[AInstr](out, ai_jl(l_sci_e));
    apf_putc(out, 46);
    push[AInstr](out, ai_mov_imm(A_X3(), 1));
    push[AInstr](out, ai_label(l_scifrac));
    push[AInstr](out, ai_cmp(A_X3(), A_X7()));
    push[AInstr](out, ai_jg(l_sci_e));
    apf_put_ds(out);
    push[AInstr](out, ai_add_imm(A_X6(), 8));
    push[AInstr](out, ai_add_imm(A_X3(), 1));
    push[AInstr](out, ai_jmp(l_scifrac));
    push[AInstr](out, ai_label(l_sci_e));
    apf_putc(out, 101);
    push[AInstr](out, ai_cmp_imm(A_X5(), 0));
    push[AInstr](out, ai_jl(l_sci_eneg));
    apf_putc(out, 43);
    push[AInstr](out, ai_mov_rr(A_X2(), A_X5()));
    push[AInstr](out, ai_jmp(l_sci_emit));
    push[AInstr](out, ai_label(l_sci_eneg));
    apf_putc(out, 45);
    push[AInstr](out, ai_mov_imm(A_X2(), 0));
    push[AInstr](out, ai_sub(A_X2(), A_X5()));
    push[AInstr](out, ai_label(l_sci_emit));
    push[AInstr](out, ai_cmp_imm(A_X2(), 10));
    push[AInstr](out, ai_jge(l_sci_ebig));
    // e in [0,9]: "0" + digit (apf_putc clobbers x2 — save in x4)
    push[AInstr](out, ai_mov_rr(A_X4(), A_X2()));
    apf_putc(out, 48);
    push[AInstr](out, ai_add_imm(A_X4(), 48));
    push[AInstr](out, ai_storeb(A_X1(), 0, A_X4()));
    push[AInstr](out, ai_add_imm(A_X1(), 1));
    push[AInstr](out, ai_jmp(l_finish));
    // e >= 10: peel digits onto the expression stack, pop MSB-first
    push[AInstr](out, ai_label(l_sci_ebig));
    push[AInstr](out, ai_mov_imm(A_X3(), 0));
    push[AInstr](out, ai_mov_imm(A_X9(), 10));
    push[AInstr](out, ai_label(l_sci_peel));
    push[AInstr](out, ai_cmp_imm(A_X2(), 0));
    push[AInstr](out, ai_je(l_sci_pop));
    push[AInstr](out, ai_sdiv(A_X4(), A_X2(), A_X9()));
    push[AInstr](out, ai_mul(A_X10(), A_X4(), A_X9()));
    push[AInstr](out, ai_sub(A_X2(), A_X10()));
    push[AInstr](out, ai_add_imm(A_X2(), 48));
    push[AInstr](out, ai_push(A_X2()));
    push[AInstr](out, ai_mov_rr(A_X2(), A_X4()));
    push[AInstr](out, ai_add_imm(A_X3(), 1));
    push[AInstr](out, ai_jmp(l_sci_peel));
    push[AInstr](out, ai_label(l_sci_pop));
    push[AInstr](out, ai_cmp_imm(A_X3(), 0));
    push[AInstr](out, ai_je(l_finish));
    push[AInstr](out, ai_pop(A_X2()));
    push[AInstr](out, ai_storeb(A_X1(), 0, A_X2()));
    push[AInstr](out, ai_add_imm(A_X1(), 1));
    push[AInstr](out, ai_sub_imm(A_X3(), 1));
    push[AInstr](out, ai_jmp(l_sci_pop));

    // FINISH: '\n', write(1, OUTBUF, len)
    push[AInstr](out, ai_label(l_finish));
    apf_putc(out, 10);
    push[AInstr](out, ai_mov_rr(A_X2(), A_X1()));
    push[AInstr](out, ai_mov_rr(A_X1(), A_SP()));
    push[AInstr](out, ai_sub(A_X2(), A_X1()));          // len
    push[AInstr](out, ai_mov_imm(A_X0(), 1));
    push[AInstr](out, ai_syscall(64));

    push[AInstr](out, ai_mov_rr(A_SP(), A_X29()));
    push[AInstr](out, ai_load(A_X29(), A_SP(), 0));
    push[AInstr](out, ai_load(A_X30(), A_SP(), 8));
    push[AInstr](out, ai_load(A_X28(), A_SP(), 16));
    push[AInstr](out, ai_add_imm(A_SP(), 32));
    push[AInstr](out, ai_ret());
}

fn aload_program_target_metadata(decls0: ArrayList[*Node], errout: *i32, dataout: *ArrayList[u8],
                        target_os: i32, v2_edition: i32, safety_checked: i32,
                        sanitize_memory: i32, object_mode: i32, dynamic_mode: i32,
                        metadata: *AObjectMetadata) ArrayList[AInstr] {
    let out: ArrayList[AInstr] = make[AInstr](128);
    let top_err: i32 = 0;
    let darwin_atomic_wait_used:i32=ac_decls_use_builtin(decls0,"@atomicWait32");
    let darwin_atomic_wake_used:i32=ac_decls_use_builtin(decls0,"@atomicWake32");

    // Reserve at least the first 168 bytes of the writable data segment. The
    // allocator cursor/end occupy 0/8; Mach-O stores logical allocator
    // telemetry at the x86-compatible BSS offsets 144/152/160 because low
    // fixed BSS addresses are inside __PAGEZERO. Mach-O allocator programs
    // also need the bounded dedicated-mapping registry through offset 66560;
    // checked Mach-O extends that image with its access-provenance registry.
    // ELF continues to use its fixed BSS words.
    // All start zero (cold arena/counters) from the file image. Reserving here — before
    // any string is interned — shifts every interned offset up uniformly,
    // and every reference already reads it back as A_DATA_VBASE() + off, so the
    // layout stays self-consistent. dataout is empty at entry for both callers.
    let reserve_bytes: i32 = 168;
    if (target_os == AC_OS_MACOS()) {
        reserve_bytes = ac_large_alloc_registry_offset() +
            ac_large_alloc_registry_cap() * 16;
    }
    if (target_os == AC_OS_MACOS() &&
        (safety_checked == 1 || sanitize_memory == 1)) {
        reserve_bytes = ac_alloc_access_registry_offset() +
            ac_alloc_access_registry_cap() * 16;
    }
    if (target_os == AC_OS_MACOS() &&
        (darwin_atomic_wait_used == 1 || darwin_atomic_wake_used == 1)) {
        let wait_end:i32=ac_darwin_wait_state_offset()+ac_darwin_wait_state_size();
        if(reserve_bytes<wait_end){reserve_bytes=wait_end;}
    }
    let grsv: i32 = 0;
    while (grsv < reserve_bytes) { push[u8](dataout, 0); grsv = grsv + 1; }

    // ── AUTO-INCLUDE the numeric runtimes (shared with x86 backend) ──────────
    // The posit/quire, sat/fixed, and RNS runtimes are pure portable Zag
    // (integer arithmetic only — no shifts, no bitwise ops, no inline asm).
    // They are prepended to the AST and compiled natively like any other
    // fn. Non-numeric programs skip this (no extra decls → byte-identical).
    let decls0rt: ArrayList[*Node] = decls0;
    if (cg_decls_use_posit(decls0) == 1) {
        let rtdecls: ArrayList[*Node] = parse_program_dir(cg_numeric_rt_src(), "");
        let merged: ArrayList[*Node] = make[*Node](len[*Node](rtdecls) + len[*Node](decls0rt) + 1);
        let ri: i32 = 0;
        while (ri < len[*Node](rtdecls)) { push[*Node](&merged, get[*Node](rtdecls, ri)); ri = ri + 1; }
        let ui: i32 = 0;
        while (ui < len[*Node](decls0rt)) { push[*Node](&merged, get[*Node](decls0rt, ui)); ui = ui + 1; }
        decls0rt = merged;
    }
    if (cg_decls_use_satfixed(decls0) == 1) {
        let rt2decls: ArrayList[*Node] = parse_program_dir(cg_numeric_rt2_src(), "");
        let merged2: ArrayList[*Node] = make[*Node](len[*Node](rt2decls) + len[*Node](decls0rt) + 1);
        let ri2: i32 = 0;
        while (ri2 < len[*Node](rt2decls)) { push[*Node](&merged2, get[*Node](rt2decls, ri2)); ri2 = ri2 + 1; }
        let ui2: i32 = 0;
        while (ui2 < len[*Node](decls0rt)) { push[*Node](&merged2, get[*Node](decls0rt, ui2)); ui2 = ui2 + 1; }
        decls0rt = merged2;
    }
    if (cg_decls_use_rns(decls0) == 1) {
        let rt3decls: ArrayList[*Node] = parse_program_dir(cg_numeric_rt3_src(), "");
        let merged3: ArrayList[*Node] = make[*Node](len[*Node](rt3decls) + len[*Node](decls0rt) + 1);
        let ri3: i32 = 0;
        while (ri3 < len[*Node](rt3decls)) { push[*Node](&merged3, get[*Node](rt3decls, ri3)); ri3 = ri3 + 1; }
        let ui3: i32 = 0;
        while (ui3 < len[*Node](decls0rt)) { push[*Node](&merged3, get[*Node](decls0rt, ui3)); ui3 = ui3 + 1; }
        decls0rt = merged3;
    }

    // Preserve compiler-owned intrinsic-use evidence before generic expansion.
    // The driver computes its Mach-O import list from this same source-shaped
    // tree; scanning only the expanded declaration set can lose the original
    // @threadSpawn/@threadJoin call nodes and make the emitted extern indices
    // disagree with the writer's dyld slots.
    let thread_spawn_used:i32 = (ac_decls_use_builtin(decls0rt,"@threadSpawn")==1||ac_decls_use_builtin(decls0rt,"@asyncSpawn")==1) as i32;
    let thread_join_used:i32 = (ac_decls_use_builtin(decls0rt,"@threadJoin")==1||
        ac_decls_use_builtin(decls0rt,"@asyncJoin")==1||ac_decls_use_builtin(decls0rt,"@asyncSpawn")==1) as i32;

    // Monomorphize using the x86 backend's target-independent AST passes:
    // infer generic targs, then expand every instantiation to a concrete
    // mangled decl. The ARM lowering only ever sees concrete names.
    cg_ginfer_pass(decls0rt);
    let decls: ArrayList[*Node] = cg_expand_generics(decls0rt);

    // Declare dynamic_names and globals early — the decl collection loop below
    // populates dynamic_names, and the ACg struct literal references both.
    let dynamic_names: ArrayList[[]u8] = make[[]u8](8);
    let globals: ArrayList[GlobalSym] = make[GlobalSym](8);

    let syms: ArrayList[AFnSym] = make[AFnSym](8);
    let next_id: i32 = 1;
    let di: i32 = 0;
    while (di < len[*Node](decls)) {
        switch (get[*Node](decls, di).*) {
            .fn_decl => |f| {
                if (len[[]u8](f.tparams) > 0) { }
                else if (f.is_extern == 1) {
                    if (ac_compiler_scalar_intrinsic(f.name) == 1) {
                        // Signature-only declaration for a compiler-owned
                        // intrinsic. Calls are intercepted by ac_lower_builtin;
                        // no Mach-O/ELF import symbol is created.
                    }
                    else if (target_os == AC_OS_MACOS()) {
                        // Runtime helpers lower directly; user externs become
                        // ordered Mach-O dyld imports.
                        if (cg_starts_with(f.name, "_zag_") == 0 && ac_find_fn(syms, f.name) < 0) {
                            push[AFnSym](&syms, AFnSym{ .name = f.name, .lbl = 0,
                                .nparams = len[Param](f.params), .ret = cg_norm_type(f.ret),
                                .extern_index = ac_extern_count(syms) });
                            if (metadata != null as *AObjectMetadata) {
                                push[[]u8](&metadata.*.imports, f.name);
                            }
                        }
                    } else if ((dynamic_mode == 1 || object_mode == 1) &&
                               cg_starts_with(f.name, "_zag_") == 0 &&
                               (v2_edition == 0 || cg_fn_has_annot(f, "@cabi") == 1)) {
                        let abi_ok: i32 = cg_dynamic_scalar_abi_type_ok(f.ret);
                        let ap: i32 = 0;
                        while (ap < len[Param](f.params)) {
                            if (cg_dynamic_scalar_abi_type_ok(get[Param](f.params, ap).pty) == 0) { abi_ok = 0; }
                            ap = ap + 1;
                        }
                        if (abi_ok == 0) {
                            _zag_eprintln("arm64: dynamic extern ABI supports scalar integers, bool, pointers, and void");
                            top_err = top_err + 1;
                        } else {
                            let already: i32 = 0;
                            let exi: i32 = 0;
                            while (exi < dynamic_names.len) {
                                if (@strEq(get[[]u8](dynamic_names, exi), f.name)) { already = 1; }
                                exi = exi + 1;
                            }
                            if (already == 0) {
                                push[[]u8](&dynamic_names, f.name);
                                push[AFnSym](&syms, AFnSym{ .name = f.name, .lbl = next_id,
                                    .nparams = len[Param](f.params), .ret = cg_norm_type(f.ret),
                                    .extern_index = 0 - 1 });
                                next_id = next_id + 1;
                            }
                        }
                    }
                }
                else if (len[*Node](f.body) == 0) { }
                else if (cg_starts_with(f.name, "__iface_") == 1) {
                    // Interface pseudo-declarations carry method metadata only.
                    // They consume no code label, matching the object-export
                    // label mirror shared with the x86 backend.
                }
                else {
                    let si: i32 = 0;
                    let found: i32 = 0;
                    while (si < len[AFnSym](syms)) {
                        if (@strEq(get[AFnSym](syms, si).name, f.name)) { found = 1; }
                        si = si + 1;
                    }
                    if (found == 0) {
                        push[AFnSym](&syms, AFnSym{ .name = f.name, .lbl = next_id, .nparams = len[Param](f.params), .ret = cg_norm_type(f.ret), .extern_index = 0 - 1 });
                        if (metadata != null as *AObjectMetadata && cg_fn_has_annot(f, "@cabi_export") == 1) {
                            push[AObjectExport](&metadata.*.exports, AObjectExport{.name=f.name,.label=next_id});
                        }
                        next_id = next_id + 1;
                    }
                }
            }
            .struct_ => |_s| { }
            .enum_ => |_e| { }
            .union_ => |_u| { }
            .let_ => |_l| { }   // v2 `global let` decls are collected by ac_collect_globals
            else => {
                _zag_eprintln("arm64: skipping unsupported top-level decl");
                top_err = top_err + 1;
            }
        }
        di = di + 1;
    }

    // Thread intrinsics own their Darwin runtime boundary. Keep these hidden
    // imports after source externs so the Mach-O stub order exactly matches
    // znc_macos_import_syms() and remains stable in cache/hot-layout identity.
    if (target_os == AC_OS_MACOS() && thread_spawn_used == 1 &&
        ac_find_extern(syms,"pthread_create") < 0) {
        let ex:i32=ac_extern_count(syms);
        push[AFnSym](&syms,AFnSym{.name="pthread_create",.lbl=0,.nparams=4,.ret="i32",.extern_index=ex});
        if(metadata!=null as *AObjectMetadata){push[[]u8](&metadata.*.imports,"pthread_create");}
    }
    if (target_os == AC_OS_MACOS() && thread_join_used == 1 &&
        ac_find_extern(syms,"pthread_join") < 0) {
        let ex:i32=ac_extern_count(syms);
        push[AFnSym](&syms,AFnSym{.name="pthread_join",.lbl=0,.nparams=2,.ret="i32",.extern_index=ex});
        if(metadata!=null as *AObjectMetadata){push[[]u8](&metadata.*.imports,"pthread_join");}
    }
    if (target_os == AC_OS_MACOS() &&
        (darwin_atomic_wait_used == 1 || darwin_atomic_wake_used == 1)) {
        let wait_names:ArrayList[[]u8]=make[[]u8](8);
        let wait_nparams:ArrayList[i32]=make[i32](8);
        push[[]u8](&wait_names,"pthread_mutex_init");push[i32](&wait_nparams,2);
        push[[]u8](&wait_names,"pthread_mutex_lock");push[i32](&wait_nparams,1);
        push[[]u8](&wait_names,"pthread_mutex_unlock");push[i32](&wait_nparams,1);
        push[[]u8](&wait_names,"pthread_cond_init");push[i32](&wait_nparams,2);
        push[[]u8](&wait_names,"pthread_cond_wait");push[i32](&wait_nparams,2);
        push[[]u8](&wait_names,"pthread_cond_signal");push[i32](&wait_nparams,1);
        push[[]u8](&wait_names,"pthread_cond_destroy");push[i32](&wait_nparams,1);
        let wi:i32=0;
        while(wi<wait_names.len){
            let nm:[]u8=wait_names.data[wi];
            if(ac_find_extern(syms,nm)<0){
                let ex:i32=ac_extern_count(syms);
                push[AFnSym](&syms,AFnSym{.name=nm,.lbl=0,.nparams=wait_nparams.data[wi],.ret="i32",.extern_index=ex});
                if(metadata!=null as *AObjectMetadata){push[[]u8](&metadata.*.imports,nm);}
            }
            wi=wi+1;
        }
    }

    let pi_lbl: i32 = next_id;
    let ps_lbl: i32 = next_id + 1;
    let al_lbl: i32 = next_id + 2;
    let se_lbl: i32 = next_id + 3;
    let rl_lbl: i32 = next_id + 4;
    let is_lbl: i32 = next_id + 5;
    let pf_lbl: i32 = next_id + 6;
    let dz_lbl: i32 = next_id + 7;
    let ms_lbl: i32 = next_id + 8;
    let pb_lbl: i32 = next_id + 9;
    let cc_lbl: i32 = next_id + 10;
    let ar_lbl: i32 = next_id + 11;
    let rf_lbl: i32 = next_id + 12;
    let wf_lbl: i32 = next_id + 13;
    let wx_lbl: i32 = next_id + 14;
    let fe_lbl: i32 = next_id + 15;
    let ex_lbl: i32 = next_id + 16;
    let s2_lbl: i32 = next_id + 17;
    let ec_lbl: i32 = next_id + 18;
    let du_lbl: i32 = next_id + 19;
    let so_lbl: i32 = next_id + 20;
    let ix_lbl: i32 = next_id + 21;
    let mc_lbl: i32 = next_id + 22;
    let mm_lbl: i32 = next_id + 23;
    let ge_lbl: i32 = next_id + 24;
    let u2_lbl: i32 = next_id + 25;
    let pu_lbl: i32 = next_id + 26;
    let cg: ACg = ACg{
        .next = next_id + 27,
        .err = top_err,
        .target_os = target_os,
        .data = dataout,
        .pi_lbl = pi_lbl,
        .ps_lbl = ps_lbl,
        .al_lbl = al_lbl,
        .se_lbl = se_lbl,
        .rl_lbl = rl_lbl,
        .is_lbl = is_lbl,
        .pf_lbl = pf_lbl,
        .dz_lbl = dz_lbl,
        .ms_lbl = ms_lbl,
        .pb_lbl = pb_lbl,
        .cc_lbl = cc_lbl,
        .ar_lbl = ar_lbl,
        .rf_lbl = rf_lbl,
        .wf_lbl = wf_lbl,
        .wx_lbl = wx_lbl,
        .fe_lbl = fe_lbl,
        .ex_lbl = ex_lbl,
        .ec_lbl = ec_lbl,
        .s2_lbl = s2_lbl,
        .du_lbl = du_lbl,
        .so_lbl = so_lbl,
        .ix_lbl = ix_lbl,
        .mc_lbl = mc_lbl,
        .mm_lbl = mm_lbl,
        .ge_lbl = ge_lbl,
        .u2_lbl = u2_lbl,
        .pu_lbl = pu_lbl,
        .use_pi = 0,
        .use_pu = 0,
        .use_ps = 0,
        .use_al = 0,
        .use_se = 0,
        .use_rl = 0,
        .use_is = 0,
        .use_pf = 0,
        .use_dz = 0,
        .use_ms = 0,
        .use_pb = 0,
        .use_cc = 0,
        .use_ar = 0,
        .use_rf = 0,
        .use_wf = 0,
        .use_wx = 0,
        .use_fe = 0,
        .use_ex = 0,
        .use_ec = 0,
        .use_s2 = 0,
        .use_du = 0,
        .use_so = 0,
        .use_ix = 0,
        .use_mc = 0,
        .use_mm = 0,
        .use_ge = 0,
        .use_u2 = 0,
        .frame_words = 0,
        .epilogue = 0,
        .current_lbl = 0,
        .pre_epilogue = 0,
        .sret_disp = 0,
        .sret_words = 0,
        .ret_ty = "",
        .nl_off = 0 - 1,
        .decls = decls,
        .v2_edition = v2_edition,
        .safety_checked = safety_checked,
        .sanitize_memory = sanitize_memory,
        .object_mode = object_mode,
        .dynamic_mode = dynamic_mode,
        .dynamic_names = &dynamic_names,
        .globals = &globals,
    };

    // Collect v2 edition global symbols (zero-initialized scalar cells in BSS)
    if (v2_edition == 1) {
        ac_collect_globals(decls, &cg, &globals);
    }

    // ET_REL output is a collection of callable definitions, not a process.
    // It neither requires a source-level main nor carries the executable
    // _start/exit sequence.  Executable and dynamic outputs retain the normal
    // entrypoint requirement and startup ABI.
    if (object_mode == 0) {
        let main_lbl: i32 = ac_find_fn(syms, "main");
        if (main_lbl < 0) {
            _zag_eprintln("arm64: no main function found");
            cg.err = cg.err + 1;
            errout.* = cg.err;
            push[AInstr](&out, ai_mov_imm(A_X0(), 0));
            push[AInstr](&out, ai_syscall(93));
            return out;
        }

        // _start: call main; exit(main_ret) via syscall 93.
        // x27 = initial SP ([x27]=argc, [x27+8+8i]=argv[i], envp after the argv
        // NULL) — x27 is never touched by prologues or routines, unlike x28 which
        // every function repurposes as its expression-stack base.
        if (target_os == AC_OS_MACOS()) {
            // LC_MAIN enters with x0=argc and x1=argv. argv[-1] is argc, so
            // x1-8 recreates the stack-vector base expected by the shared runtime.
            push[AInstr](&out, ai_mov_rr(A_X27(), A_X1()));
            push[AInstr](&out, ai_sub_imm(A_X27(), 8));
        } else {
            push[AInstr](&out, ai_mov_rr(A_X27(), A_SP()));
        }
        // x26 is reserved for the compiler-owned ZagScript async task context.
        // Ordinary program entry is outside a task, so cancelled() starts false.
        push[AInstr](&out, ai_mov_imm(A_X26(), 0));
        push[AInstr](&out, ai_call(main_lbl));
        // Exit-time leak detection (only under --sanitize=memory).
        ac_emit_leak_check(&out, &cg);
        push[AInstr](&out, ai_syscall(93));
    }

    di = 0;
    while (di < len[*Node](decls)) {
        switch (get[*Node](decls, di).*) {
            .fn_decl => |f| {
                if (f.is_extern == 0 && len[[]u8](f.tparams) == 0 && len[*Node](f.body) > 0 && cg_starts_with(f.name, "__iface_") == 0) {
                    let lbl: i32 = ac_find_fn(syms, f.name);
                    ac_lower_fn(&out, f, lbl, syms, &cg);
                }
            }
            else => { }
        }
        di = di + 1;
    }

    // dependency closure: slice-building routines pull in __make_slice, the
    // file/exec routines pull in __pathbuf, and everything that allocates
    // pulls in __malloc (checked in the alloc emit condition below).
    if (cg.use_cc == 1 || cg.use_ar == 1 || cg.use_rf == 1 || cg.use_du == 1 || cg.use_ge == 1 || cg.use_ec == 1 || cg.use_u2 == 1) { cg.use_ms = 1; }
    if (cg.use_rf == 1 || cg.use_wf == 1 || cg.use_wx == 1 || cg.use_fe == 1 || cg.use_ex == 1 || cg.use_ec == 1) { cg.use_pb = 1; }
    if (cg.use_rf == 1 || cg.use_ec == 1) { cg.use_rl = 1; }

    if (cg.use_pi == 1) { ac_emit_print_int(&out, cg.pi_lbl, &cg); }
    if (cg.use_pu == 1) { ac_emit_print_uint(&out, cg.pu_lbl, &cg); }
    if (cg.use_ps == 1) { ac_emit_print_str(&out, cg.ps_lbl); }
    if (cg.use_al == 1 || cg.use_rl == 1 || cg.use_is == 1 || cg.use_ms == 1 || cg.use_pb == 1 || cg.use_cc == 1) { ac_emit_alloc(&out, cg.al_lbl, &cg); }
    if (cg.use_se == 1) { ac_emit_streq(&out, cg.se_lbl, &cg); }
    if (cg.use_rl == 1) { ac_emit_realloc(&out, cg.rl_lbl, &cg); }
    if (cg.use_is == 1) { ac_emit_i64s(&out, cg.is_lbl, &cg); }
    if (cg.use_pf == 1) { ac_emit_print_f64(&out, cg.pf_lbl, &cg); }
    if (cg.use_dz == 1) { ac_emit_div0(&out, cg.dz_lbl, &cg); }
    if (cg.use_ms == 1) { ac_emit_make_slice(&out, cg.ms_lbl, &cg); }
    if (cg.use_pb == 1) { ac_emit_pathbuf(&out, cg.pb_lbl, &cg); }
    if (cg.use_cc == 1) { ac_emit_concat(&out, cg.cc_lbl, &cg); }
    if (cg.use_ar == 1) { ac_emit_argslice(&out, cg.ar_lbl, &cg); }
    if (cg.use_rf == 1) { ac_emit_read_file(&out, cg.rf_lbl, &cg); }
    if (cg.use_wf == 1) { ac_emit_write_file(&out, cg.wf_lbl, 0, &cg); }
    if (cg.use_wx == 1) { ac_emit_write_file(&out, cg.wx_lbl, 1, &cg); }
    if (cg.use_fe == 1) { ac_emit_file_exists(&out, cg.fe_lbl, &cg); }
    if (cg.use_ex == 1) { ac_emit_exec_cmd(&out, cg.ex_lbl, &cg); }
    if (cg.use_ec == 1) { ac_emit_exec_capture(&out, cg.ec_lbl, &cg); }
    if (cg.use_s2 == 1) { ac_emit_str2i(&out, cg.s2_lbl, &cg); }
    if (cg.use_du == 1) { ac_emit_strdup(&out, cg.du_lbl, &cg); }
    if (cg.use_so == 1) { ac_emit_strcmp_ord(&out, cg.so_lbl, &cg); }
    if (cg.use_ix == 1) { ac_emit_idxbyte(&out, cg.ix_lbl, &cg); }
    if (cg.use_mc == 1) { ac_emit_memcpy(&out, cg.mc_lbl, &cg); }
    if (cg.use_mm == 1) { ac_emit_memcmp(&out, cg.mm_lbl, &cg); }
    if (cg.use_ge == 1) { ac_emit_getenv(&out, cg.ge_lbl, &cg); }
    if (cg.use_u2 == 1) { ac_emit_u64s(&out, cg.u2_lbl, &cg); }

    errout.* = cg.err;
    return out;
}

fn aload_program_target(decls0: ArrayList[*Node], errout: *i32, dataout: *ArrayList[u8],
                        target_os: i32, v2_edition: i32, safety_checked: i32,
                        sanitize_memory: i32, object_mode: i32, dynamic_mode: i32) ArrayList[AInstr] {
    return aload_program_target_metadata(decls0, errout, dataout, target_os,
        v2_edition, safety_checked, sanitize_memory, object_mode, dynamic_mode,
        null as *AObjectMetadata);
}

fn aload_program(decls0: ArrayList[*Node], errout: *i32, dataout: *ArrayList[u8],
                 v2_edition: i32, safety_checked: i32, sanitize_memory: i32,
                 object_mode: i32, dynamic_mode: i32) ArrayList[AInstr] {
    return aload_program_target(decls0, errout, dataout, AC_OS_LINUX(),
                                v2_edition, safety_checked, sanitize_memory,
                                object_mode, dynamic_mode);
}

fn aload_program_default(decls0: ArrayList[*Node], errout: *i32, dataout: *ArrayList[u8]) ArrayList[AInstr] {
    return aload_program_target(decls0, errout, dataout, AC_OS_LINUX(),
                                0, 0, 0, 0, 0);
}

fn aload_program_macos(decls0: ArrayList[*Node], errout: *i32, dataout: *ArrayList[u8]) ArrayList[AInstr] {
    return aload_program_target(decls0, errout, dataout, AC_OS_MACOS(),
                                0, 0, 0, 0, 0);
}

fn aload_program_macos_mode(decls0: ArrayList[*Node], errout: *i32,
                            dataout: *ArrayList[u8], v2_edition: i32,
                            safety_checked: i32,
                            sanitize_memory: i32) ArrayList[AInstr] {
    return aload_program_target(decls0, errout, dataout, AC_OS_MACOS(),
                                v2_edition, safety_checked, sanitize_memory,
                                0, 0);
}

fn aload_program_macos_checked(decls0: ArrayList[*Node], errout: *i32, dataout: *ArrayList[u8]) ArrayList[AInstr] {
    return aload_program_target(decls0, errout, dataout, AC_OS_MACOS(),
                                0, 1, 0, 0, 0);
}
