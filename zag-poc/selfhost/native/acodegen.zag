                fcntl_flags = ac_nonnegative_i32_literal(get[*Node](c.args,3));
            }
            if (raw_num == 72 &&
                !((fcntl_command == 1 && fcntl_flags == 0) ||
                  (fcntl_command == 4 &&
                   (fcntl_flags == 2048 || fcntl_flags == 0)))) {
                push[AInstr](out,ai_mov_imm(A_X0(),0-78)); push[AInstr](out,ai_push(A_X0())); return 1;
            }
            let mai: i32 = 1;
            while (mai < 7) { ac_lower_expr(out,get[*Node](c.args,mai),env,syms,cg); mai = mai + 1; }
            push[AInstr](out,ai_pop(A_X5())); push[AInstr](out,ai_pop(A_X4())); push[AInstr](out,ai_pop(A_X3()));
            push[AInstr](out,ai_pop(A_X2())); push[AInstr](out,ai_pop(A_X1())); push[AInstr](out,ai_pop(A_X0()));
            if (fs_raw == 1) {
                ac_emit_darwin_fs_syscall(out, raw_num, cg);
                push[AInstr](out, ai_push(A_X0()));
                return 1;
            }
            if (net_raw == 1) {
                ac_emit_darwin_net_syscall(out, raw_num, cg);
                push[AInstr](out, ai_push(A_X0()));
                return 1;
            }
            // The source uses Linux O_NONBLOCK (2048) with F_SETFL. Darwin
            // uses bit 4; zero restores blocking mode on either platform.
            if (raw_num == 72 && fcntl_command == 4) {
                if (fcntl_flags == 2048) { push[AInstr](out,ai_mov_imm(A_X2(),4)); }
                else { push[AInstr](out,ai_mov_imm(A_X2(),0)); }
            }
            // XNU does not expose Linux nanosleep as this raw ABI.  select(2)
            // with no descriptor sets is the native timeout primitive.  The
            // portable source stores {seconds,nanoseconds}; timeval needs
            // {seconds,microseconds} in the same two-word storage.
            if (raw_num == 35) {
                push[AInstr](out,ai_load(A_X9(),A_X0(),8)); push[AInstr](out,ai_mov_rr(A_X6(),A_X9())); push[AInstr](out,ai_mov_imm(A_X10(),1000));
                push[AInstr](out,ai_sdiv(A_X9(),A_X9(),A_X10())); push[AInstr](out,ai_store(A_X0(),8,A_X9()));
                push[AInstr](out,ai_mov_rr(A_X4(),A_X0())); push[AInstr](out,ai_mov_imm(A_X0(),0));
                push[AInstr](out,ai_mov_imm(A_X1(),0)); push[AInstr](out,ai_mov_imm(A_X2(),0)); push[AInstr](out,ai_mov_imm(A_X3(),0));
            }
            // Darwin's kernel pipe syscall returns its two descriptors in
            // x0/x1, while Linux pipe2 writes packed i32 descriptors through
            // its first argument and returns zero. Preserve both parts of the
            // portable source contract.
            if (raw_num == 293) { push[AInstr](out,ai_mov_rr(A_X6(),A_X0())); }
            push[AInstr](out,ai_darwin_syscall(darwin_num));
            if (raw_num == 293) {
                let pipe_done:i32=ac_fresh(cg);
                push[AInstr](out,ai_cmp_imm(A_X0(),0)); push[AInstr](out,ai_jl(pipe_done));
                push[AInstr](out,ai_mov_imm(A_X9(),32)); push[AInstr](out,ai_shl(A_X1(),A_X9()));
                push[AInstr](out,ai_or(A_X0(),A_X1())); push[AInstr](out,ai_store(A_X6(),0,A_X0()));
                push[AInstr](out,ai_mov_imm(A_X0(),0));
                push[AInstr](out,ai_label(pipe_done));
            }
            // XNU fork returns {child_pid, 0} to the parent and
            // {parent_pid, 1} to the child.  The portable raw contract is the
            // usual {child_pid, 0} parent / {0} child result.
            if (raw_num == 57) {
                let fork_done:i32=ac_fresh(cg); let fork_parent:i32=ac_fresh(cg);
                push[AInstr](out,ai_cmp_imm(A_X0(),0)); push[AInstr](out,ai_jl(fork_done));
                push[AInstr](out,ai_cmp_imm(A_X1(),0)); push[AInstr](out,ai_je(fork_parent));
                push[AInstr](out,ai_mov_imm(A_X0(),0)); push[AInstr](out,ai_label(fork_parent));
                push[AInstr](out,ai_label(fork_done));
            }
            // select(2) updates timeval to the unslept remainder.  The
            // portable caller intentionally reuses its timespec on every
            // polling iteration, so restore its original nanoseconds.
            if (raw_num == 35) { push[AInstr](out,ai_store(A_X4(),8,A_X6())); }
            push[AInstr](out,ai_push(A_X0())); return 1;
        }
        let sai: i32 = 0;
        while (sai < 7) {
            ac_lower_expr(out, get[*Node](c.args, sai), env, syms, cg);
            sai = sai + 1;
        }
        push[AInstr](out, ai_pop(A_X5()));   // a6
        push[AInstr](out, ai_pop(A_X4()));   // a5
        push[AInstr](out, ai_pop(A_X3()));   // a4
        push[AInstr](out, ai_pop(A_X2()));   // a3
        push[AInstr](out, ai_pop(A_X1()));   // a2
        push[AInstr](out, ai_pop(A_X0()));   // a1
        push[AInstr](out, ai_pop(A_X8()));   // Linux x86-64 syscall number
        if (cg.*.target_os == AC_OS_MACOS()) {
            // Non-literal Linux syscall identities cannot be translated safely
            // to Darwin at compile time. Platform code must use the explicit
            // _zag_darwin_syscall boundary.
            push[AInstr](out, ai_mov_imm(A_X0(), 0 - 78));
        } else {
            ac_emit_syscall_xlate(out, cg);
            push[AInstr](out, ai_svc());
        }
        push[AInstr](out, ai_push(A_X0()));
        return 1;
    }
    // ── _zag_darwin_syscall(const_num, a1..a6) → x0 ────────────────────────
    // Native macOS adapters use fixed Darwin syscall identities. Keeping that
    // number immediate produces the same call sequence as the proven runtime
    // file-I/O lowering and avoids treating Darwin IDs as Linux identifiers.
    if (@strEq(fname, "_zag_darwin_syscall")) {
        if (nargs != 7) { ac_err(cg, "arm64: _zag_darwin_syscall expects 7 arguments"); push[AInstr](out, ai_mov_imm(A_X0(), 0 - 1)); push[AInstr](out, ai_push(A_X0())); return 1; }
        let num: i32 = ac_nonnegative_i32_literal(get[*Node](c.args,0));
        if (num < 0) { ac_err(cg, "arm64: _zag_darwin_syscall requires a non-negative integer literal number"); push[AInstr](out, ai_mov_imm(A_X0(), 0 - 1)); push[AInstr](out, ai_push(A_X0())); return 1; }
        let dai: i32 = 1;
        while (dai < 7) { ac_lower_expr(out, get[*Node](c.args,dai), env, syms, cg); dai = dai + 1; }
        push[AInstr](out, ai_pop(A_X5())); push[AInstr](out, ai_pop(A_X4())); push[AInstr](out, ai_pop(A_X3()));
        push[AInstr](out, ai_pop(A_X2())); push[AInstr](out, ai_pop(A_X1())); push[AInstr](out, ai_pop(A_X0()));
        push[AInstr](out, ai_darwin_syscall(num)); push[AInstr](out, ai_push(A_X0())); return 1;
    }
    // ── _zag_darwin_open(path, flags) → fd / -errno ─────────────────────────
    // This is a path-specific Darwin primitive, not a libc fallback. It shares
    // the fixed openat lowering used by the verified native file runtime:
    // construct a NUL-terminated path, then issue SYS_openat directly.
    if (@strEq(fname, "_zag_darwin_open")) {
        if (nargs != 2) { ac_err(cg, "arm64: _zag_darwin_open expects path and flags"); push[AInstr](out, ai_mov_imm(A_X0(),0-1)); push[AInstr](out,ai_push(A_X0())); return 1; }
        let flags: i64 = 0 - 1;
        switch (get[*Node](c.args,1).*) { .ilit => |lit| { if (ac_is_int_text(lit.text) == 1) { flags = ac_parse_i64(lit.text); } } else => { } }
        if (flags < 0) { ac_err(cg, "arm64: _zag_darwin_open requires a non-negative integer literal flags value"); push[AInstr](out,ai_mov_imm(A_X0(),0-1)); push[AInstr](out,ai_push(A_X0())); return 1; }
        ac_lower_expr(out,get[*Node](c.args,0),env,syms,cg);
        push[AInstr](out,ai_pop(A_X0()));
        // Native watch flags are compile-time ABI constants; load them only
        // after the helper returns.
        // __pathbuf allocates the NUL-terminated copy through __alloc.  Mark
        // both helpers live; otherwise a watcher-only program can call an
        // un-emitted allocator label and silently fall back from kqueue.
        cg.*.use_al=1; cg.*.use_pb=1; push[AInstr](out,ai_call(cg.*.pb_lbl));
        push[AInstr](out,ai_mov_rr(A_X1(),A_X0())); push[AInstr](out,ai_mov_imm(A_X0(),0-2));
        push[AInstr](out,ai_mov_imm(A_X2(),flags));
        push[AInstr](out,ai_mov_imm(A_X3(),0)); push[AInstr](out,ai_syscall(56));
        push[AInstr](out,ai_push(A_X0())); return 1;
    }
    // ── x86 CPU feature discovery intrinsics ─────────────────────────────────
    // CPUID/XGETBV do not exist on AArch64. Native x86 feature detection is
    // meaningless on a non-x86 host, so these fail closed to 0 (the generic
    // baseline). Arguments are still evaluated for stack balance and side
    // effects, then discarded.
    if (@strEq(fname, "_zag_x86_cpuid_eax") || @strEq(fname, "_zag_x86_cpuid_ebx") ||
        @strEq(fname, "_zag_x86_cpuid_ecx") || @strEq(fname, "_zag_x86_cpuid_edx") ||
        @strEq(fname, "_zag_x86_xgetbv")) {
        let xi: i32 = 0;
        while (xi < nargs) {
            ac_lower_expr(out, get[*Node](c.args, xi), env, syms, cg);
            push[AInstr](out, ai_pop(A_X0()));
            xi = xi + 1;
        }
        push[AInstr](out, ai_mov_imm(A_X0(), 0));
        push[AInstr](out, ai_push(A_X0()));
        return 1;
    }
    return 0;
}

// @-builtins (leading '@'): @sizeOf, @len/@strLen, @strEq, @intCast/@truncate.
fn ac_atomic_order_literal(n: *Node) i64 {
    switch (n.*) {
        .ilit => |x| {
            if (@strEq(x.text,"0")) { return 0; }
            if (@strEq(x.text,"1")) { return 1; }
            if (@strEq(x.text,"2")) { return 2; }
            if (@strEq(x.text,"3")) { return 3; }
            if (@strEq(x.text,"4")) { return 4; }
        }
        else => { }
    }
    return 0 - 1;
}

// Emit a baseline ARMv8 LL/SC RMW.  The address and operand are evaluated
// exactly once before the retry loop; every public RMW is acquire/release and
// seq_cst adds conservative full fences around the transaction.
fn ac_emit_atomic_rmw(out: *ArrayList[AInstr], c: Call, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg, op: i32, ordered: i32, order: i64) void {
    let ptr_slot: i32 = ac_slot_scratch(cg, 1);
    let val_slot: i32 = ac_slot_scratch(cg, 1);
    ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg);
    push[AInstr](out, ai_pop(A_X10()));
    ac_emit_checked_nonnull(out, A_X10(), cg); ac_emit_checked_alignment(out, A_X10(), 8, cg);
    push[AInstr](out, ai_store(A_X29(), ptr_slot, A_X10()));
    ac_lower_expr(out, get[*Node](c.args, 1), env, syms, cg);
    push[AInstr](out, ai_pop(A_X12()));
    if (op == 2) { push[AInstr](out, ai_neg(A_X12(), A_X12())); }
    push[AInstr](out, ai_store(A_X29(), val_slot, A_X12()));
    if (ordered == 1 && order == 4) { push[AInstr](out, ai_dmb()); }
    let retry: i32 = ac_fresh(cg);
    push[AInstr](out, ai_label(retry));
    push[AInstr](out, ai_load(A_X10(), A_X29(), ptr_slot));
    push[AInstr](out, ai_ldaxr(A_X11(), A_X10()));
    push[AInstr](out, ai_load(A_X12(), A_X29(), val_slot));
    if (op == 0) { push[AInstr](out, ai_mov_rr(A_X13(), A_X12())); }
    else {
        push[AInstr](out, ai_mov_rr(A_X13(), A_X11()));
        if (op == 1 || op == 2) { push[AInstr](out, ai_add(A_X13(), A_X12())); }
        else if (op == 3) { push[AInstr](out, ai_andr(A_X13(), A_X12())); }
        else if (op == 4) { push[AInstr](out, ai_or(A_X13(), A_X12())); }
        else { push[AInstr](out, ai_xor(A_X13(), A_X12())); }
    }
    push[AInstr](out, ai_stlxr(A_X14(), A_X13(), A_X10()));
    push[AInstr](out, ai_cmp_imm(A_X14(), 0)); push[AInstr](out, ai_jne(retry));
    if (ordered == 1 && order == 4) { push[AInstr](out, ai_dmb()); }
    push[AInstr](out, ai_push(A_X11()));
}

// Compare-exchange returns the observed old value.  A failed comparison never
// issues STXR; a failed reservation retries with a fresh exclusive load.
fn ac_emit_atomic_cas(out: *ArrayList[AInstr], c: Call, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg, ordered: i32, success: i64) void {
    let ptr_slot:i32=ac_slot_scratch(cg,1);let expected_slot:i32=ac_slot_scratch(cg,1);let desired_slot:i32=ac_slot_scratch(cg,1);
    ac_lower_expr(out,get[*Node](c.args,0),env,syms,cg);push[AInstr](out,ai_pop(A_X10()));ac_emit_checked_nonnull(out,A_X10(),cg);ac_emit_checked_alignment(out,A_X10(),8,cg);push[AInstr](out,ai_store(A_X29(),ptr_slot,A_X10()));
    ac_lower_expr(out,get[*Node](c.args,1),env,syms,cg);push[AInstr](out,ai_pop(A_X11()));push[AInstr](out,ai_store(A_X29(),expected_slot,A_X11()));
    ac_lower_expr(out,get[*Node](c.args,2),env,syms,cg);push[AInstr](out,ai_pop(A_X12()));push[AInstr](out,ai_store(A_X29(),desired_slot,A_X12()));
    if(ordered==1&&success==4){push[AInstr](out,ai_dmb());}let retry:i32=ac_fresh(cg);let done:i32=ac_fresh(cg);push[AInstr](out,ai_label(retry));push[AInstr](out,ai_load(A_X10(),A_X29(),ptr_slot));push[AInstr](out,ai_ldaxr(A_X11(),A_X10()));push[AInstr](out,ai_load(A_X12(),A_X29(),expected_slot));push[AInstr](out,ai_cmp(A_X11(),A_X12()));push[AInstr](out,ai_jne(done));push[AInstr](out,ai_load(A_X12(),A_X29(),desired_slot));push[AInstr](out,ai_stlxr(A_X13(),A_X12(),A_X10()));push[AInstr](out,ai_cmp_imm(A_X13(),0));push[AInstr](out,ai_jne(retry));push[AInstr](out,ai_label(done));if(ordered==1&&success==4){push[AInstr](out,ai_dmb());}push[AInstr](out,ai_push(A_X11()));
}

fn ac_darwin_wait_imports_ready(syms:ArrayList[AFnSym]) i32 {
    if(ac_find_extern(syms,"pthread_mutex_init")<0||ac_find_extern(syms,"pthread_mutex_lock")<0||
       ac_find_extern(syms,"pthread_mutex_unlock")<0||ac_find_extern(syms,"pthread_cond_init")<0||
       ac_find_extern(syms,"pthread_cond_wait")<0||ac_find_extern(syms,"pthread_cond_signal")<0||
       ac_find_extern(syms,"pthread_cond_destroy")<0){return 0;}
    return 1;
}

// Initialize the process-global Darwin wait/wake mutex exactly once.  The
// state word uses ARM64 acquire/release LL/SC so a racing first caller cannot
// observe a partially initialized pthread_mutex_t.  The wait list head starts
// zero in the Mach-O writable data image.
fn ac_emit_darwin_wait_runtime_init(out:*ArrayList[AInstr],syms:ArrayList[AFnSym],cg:*ACg) void {
    let retry:i32=ac_fresh(cg);let try_init:i32=ac_fresh(cg);let publish:i32=ac_fresh(cg);let ready:i32=ac_fresh(cg);
    push[AInstr](out,ai_label(retry));
    push[AInstr](out,ai_data_addr(A_X10(),ac_darwin_wait_state_offset()));
    push[AInstr](out,ai_ldar(A_X11(),A_X10()));push[AInstr](out,ai_cmp_imm(A_X11(),2));push[AInstr](out,ai_je(ready));
    push[AInstr](out,ai_cmp_imm(A_X11(),0));push[AInstr](out,ai_je(try_init));push[AInstr](out,ai_jmp(retry));
    push[AInstr](out,ai_label(try_init));
    push[AInstr](out,ai_data_addr(A_X10(),ac_darwin_wait_state_offset()));push[AInstr](out,ai_ldaxr(A_X11(),A_X10()));
    push[AInstr](out,ai_cmp_imm(A_X11(),0));push[AInstr](out,ai_jne(retry));push[AInstr](out,ai_mov_imm(A_X12(),1));
    push[AInstr](out,ai_stlxr(A_X13(),A_X12(),A_X10()));push[AInstr](out,ai_cmp_imm(A_X13(),0));push[AInstr](out,ai_jne(retry));
    push[AInstr](out,ai_data_addr(A_X0(),ac_darwin_wait_state_offset()+8));push[AInstr](out,ai_mov_imm(A_X1(),0));
    push[AInstr](out,ai_extern_call(ac_find_extern(syms,"pthread_mutex_init")));push[AInstr](out,ai_cmp_imm(A_X0(),0));push[AInstr](out,ai_je(publish));
    ac_emit_panic(out,"zag runtime: pthread wait mutex initialization failed",publish,cg);
    push[AInstr](out,ai_data_addr(A_X10(),ac_darwin_wait_state_offset()));push[AInstr](out,ai_mov_imm(A_X11(),2));push[AInstr](out,ai_stlr(A_X10(),A_X11()));
    push[AInstr](out,ai_label(ready));
}

fn ac_lower_darwin_atomic_wait32(out:*ArrayList[AInstr],c:Call,env:*AEnv,syms:ArrayList[AFnSym],cg:*ACg) void {
    let ptr_slot:i32=ac_slot_scratch(cg,1);let expected_slot:i32=ac_slot_scratch(cg,1);let node_slot:i32=ac_slot_scratch(cg,1);let result_slot:i32=ac_slot_scratch(cg,1);
    let locked:i32=ac_fresh(cg);let mismatch:i32=ac_fresh(cg);let alloc_failed:i32=ac_fresh(cg);let cond_ready:i32=ac_fresh(cg);
    let wait_loop:i32=ac_fresh(cg);let woke:i32=ac_fresh(cg);let wait_error:i32=ac_fresh(cg);let unlink:i32=ac_fresh(cg);
    let no_prev:i32=ac_fresh(cg);let prev_done:i32=ac_fresh(cg);let no_next:i32=ac_fresh(cg);let cleanup:i32=ac_fresh(cg);let unlock:i32=ac_fresh(cg);let done:i32=ac_fresh(cg);
    let lock_import:i32=ac_find_extern(syms,"pthread_mutex_lock");let unlock_import:i32=ac_find_extern(syms,"pthread_mutex_unlock");
    let cond_init_import:i32=ac_find_extern(syms,"pthread_cond_init");let cond_wait_import:i32=ac_find_extern(syms,"pthread_cond_wait");let cond_destroy_import:i32=ac_find_extern(syms,"pthread_cond_destroy");

    ac_lower_expr(out,get[*Node](c.args,0),env,syms,cg);push[AInstr](out,ai_pop(A_X10()));ac_emit_checked_nonnull(out,A_X10(),cg);ac_emit_checked_alignment(out,A_X10(),4,cg);push[AInstr](out,ai_store(A_X29(),ptr_slot,A_X10()));
    ac_lower_expr(out,get[*Node](c.args,1),env,syms,cg);push[AInstr](out,ai_pop(A_X11()));push[AInstr](out,ai_sxtw(A_X11(),A_X11()));push[AInstr](out,ai_store(A_X29(),expected_slot,A_X11()));
    push[AInstr](out,ai_mov_imm(A_X9(),0));push[AInstr](out,ai_store(A_X29(),node_slot,A_X9()));push[AInstr](out,ai_store(A_X29(),result_slot,A_X9()));
    ac_emit_darwin_wait_runtime_init(out,syms,cg);
    push[AInstr](out,ai_data_addr(A_X0(),ac_darwin_wait_state_offset()+8));push[AInstr](out,ai_extern_call(lock_import));
    push[AInstr](out,ai_cmp_imm(A_X0(),0));push[AInstr](out,ai_je(locked));push[AInstr](out,ai_neg(A_X0(),A_X0()));push[AInstr](out,ai_store(A_X29(),result_slot,A_X0()));push[AInstr](out,ai_jmp(done));
    push[AInstr](out,ai_label(locked));
    push[AInstr](out,ai_load(A_X10(),A_X29(),ptr_slot));push[AInstr](out,ai_loadw(A_X11(),A_X10(),0));push[AInstr](out,ai_sxtw(A_X11(),A_X11()));push[AInstr](out,ai_load(A_X12(),A_X29(),expected_slot));push[AInstr](out,ai_cmp(A_X11(),A_X12()));push[AInstr](out,ai_jne(mismatch));
    // One page per waiter keeps pthread_cond_t lifetime independent and makes
    // address-keyed wake counts exact even with spurious condition wakes.
    push[AInstr](out,ai_mov_imm(A_X0(),0));push[AInstr](out,ai_mov_imm(A_X1(),4096));push[AInstr](out,ai_mov_imm(A_X2(),3));push[AInstr](out,ai_mov_imm(A_X3(),4098));push[AInstr](out,ai_mov_imm(A_X4(),0-1));push[AInstr](out,ai_mov_imm(A_X5(),0));push[AInstr](out,ai_syscall(222));
    push[AInstr](out,ai_cmp_imm(A_X0(),0));push[AInstr](out,ai_jl(alloc_failed));push[AInstr](out,ai_store(A_X29(),node_slot,A_X0()));
    push[AInstr](out,ai_mov_imm(A_X9(),0));push[AInstr](out,ai_store(A_X0(),0,A_X9()));push[AInstr](out,ai_store(A_X0(),8,A_X9()));push[AInstr](out,ai_load(A_X10(),A_X29(),ptr_slot));push[AInstr](out,ai_store(A_X0(),16,A_X10()));push[AInstr](out,ai_store(A_X0(),24,A_X9()));
    push[AInstr](out,ai_add_imm(A_X0(),32));push[AInstr](out,ai_mov_imm(A_X1(),0));push[AInstr](out,ai_extern_call(cond_init_import));push[AInstr](out,ai_cmp_imm(A_X0(),0));push[AInstr](out,ai_je(cond_ready));
    push[AInstr](out,ai_neg(A_X0(),A_X0()));push[AInstr](out,ai_store(A_X29(),result_slot,A_X0()));push[AInstr](out,ai_jmp(cleanup));
    push[AInstr](out,ai_label(cond_ready));
    // Insert at list head while holding the global mutex.
    push[AInstr](out,ai_load(A_X10(),A_X29(),node_slot));push[AInstr](out,ai_data_addr(A_X11(),ac_darwin_wait_state_offset()+72));push[AInstr](out,ai_load(A_X12(),A_X11(),0));push[AInstr](out,ai_store(A_X10(),0,A_X12()));push[AInstr](out,ai_cmp_imm(A_X12(),0));let no_old_head:i32=ac_fresh(cg);push[AInstr](out,ai_je(no_old_head));push[AInstr](out,ai_store(A_X12(),8,A_X10()));push[AInstr](out,ai_label(no_old_head));push[AInstr](out,ai_store(A_X11(),0,A_X10()));
    push[AInstr](out,ai_label(wait_loop));push[AInstr](out,ai_load(A_X10(),A_X29(),node_slot));push[AInstr](out,ai_add_imm(A_X10(),32));push[AInstr](out,ai_data_addr(A_X1(),ac_darwin_wait_state_offset()+8));push[AInstr](out,ai_mov_rr(A_X0(),A_X10()));push[AInstr](out,ai_extern_call(cond_wait_import));
    push[AInstr](out,ai_cmp_imm(A_X0(),0));push[AInstr](out,ai_jne(wait_error));push[AInstr](out,ai_load(A_X10(),A_X29(),node_slot));push[AInstr](out,ai_load(A_X11(),A_X10(),24));push[AInstr](out,ai_cmp_imm(A_X11(),0));push[AInstr](out,ai_je(wait_loop));push[AInstr](out,ai_jmp(woke));
    push[AInstr](out,ai_label(wait_error));push[AInstr](out,ai_neg(A_X0(),A_X0()));push[AInstr](out,ai_store(A_X29(),result_slot,A_X0()));push[AInstr](out,ai_jmp(unlink));
    push[AInstr](out,ai_label(woke));push[AInstr](out,ai_mov_imm(A_X9(),0));push[AInstr](out,ai_store(A_X29(),result_slot,A_X9()));
    // Remove this waiter from the doubly linked list before destroying it.
    push[AInstr](out,ai_label(unlink));push[AInstr](out,ai_load(A_X10(),A_X29(),node_slot));push[AInstr](out,ai_load(A_X11(),A_X10(),8));push[AInstr](out,ai_load(A_X12(),A_X10(),0));push[AInstr](out,ai_cmp_imm(A_X11(),0));push[AInstr](out,ai_je(no_prev));push[AInstr](out,ai_store(A_X11(),0,A_X12()));push[AInstr](out,ai_jmp(prev_done));push[AInstr](out,ai_label(no_prev));push[AInstr](out,ai_data_addr(A_X13(),ac_darwin_wait_state_offset()+72));push[AInstr](out,ai_store(A_X13(),0,A_X12()));push[AInstr](out,ai_label(prev_done));push[AInstr](out,ai_cmp_imm(A_X12(),0));push[AInstr](out,ai_je(no_next));push[AInstr](out,ai_store(A_X12(),8,A_X11()));push[AInstr](out,ai_label(no_next));
    push[AInstr](out,ai_load(A_X0(),A_X29(),node_slot));push[AInstr](out,ai_add_imm(A_X0(),32));push[AInstr](out,ai_extern_call(cond_destroy_import));push[AInstr](out,ai_jmp(cleanup));
    push[AInstr](out,ai_label(mismatch));push[AInstr](out,ai_mov_imm(A_X9(),0-11));push[AInstr](out,ai_store(A_X29(),result_slot,A_X9()));push[AInstr](out,ai_jmp(unlock));
    push[AInstr](out,ai_label(alloc_failed));push[AInstr](out,ai_store(A_X29(),result_slot,A_X0()));push[AInstr](out,ai_jmp(unlock));
    push[AInstr](out,ai_label(cleanup));push[AInstr](out,ai_load(A_X10(),A_X29(),node_slot));push[AInstr](out,ai_cmp_imm(A_X10(),0));push[AInstr](out,ai_je(unlock));push[AInstr](out,ai_mov_rr(A_X0(),A_X10()));push[AInstr](out,ai_mov_imm(A_X1(),4096));push[AInstr](out,ai_syscall(215));
    push[AInstr](out,ai_label(unlock));push[AInstr](out,ai_data_addr(A_X0(),ac_darwin_wait_state_offset()+8));push[AInstr](out,ai_extern_call(unlock_import));
    push[AInstr](out,ai_label(done));push[AInstr](out,ai_load(A_X0(),A_X29(),result_slot));push[AInstr](out,ai_push(A_X0()));
}

fn ac_lower_darwin_atomic_wake32(out:*ArrayList[AInstr],c:Call,env:*AEnv,syms:ArrayList[AFnSym],cg:*ACg) void {
    let ptr_slot:i32=ac_slot_scratch(cg,1);let count_slot:i32=ac_slot_scratch(cg,1);let result_slot:i32=ac_slot_scratch(cg,1);let node_slot:i32=ac_slot_scratch(cg,1);
    let locked:i32=ac_fresh(cg);let count_ok:i32=ac_fresh(cg);let loop:i32=ac_fresh(cg);let next:i32=ac_fresh(cg);let signal_ok:i32=ac_fresh(cg);let unlock:i32=ac_fresh(cg);let done:i32=ac_fresh(cg);
    let lock_import:i32=ac_find_extern(syms,"pthread_mutex_lock");let unlock_import:i32=ac_find_extern(syms,"pthread_mutex_unlock");let signal_import:i32=ac_find_extern(syms,"pthread_cond_signal");
    ac_lower_expr(out,get[*Node](c.args,0),env,syms,cg);push[AInstr](out,ai_pop(A_X10()));ac_emit_checked_nonnull(out,A_X10(),cg);ac_emit_checked_alignment(out,A_X10(),4,cg);push[AInstr](out,ai_store(A_X29(),ptr_slot,A_X10()));
    ac_lower_expr(out,get[*Node](c.args,1),env,syms,cg);push[AInstr](out,ai_pop(A_X11()));push[AInstr](out,ai_sxtw(A_X11(),A_X11()));push[AInstr](out,ai_store(A_X29(),count_slot,A_X11()));push[AInstr](out,ai_mov_imm(A_X9(),0));push[AInstr](out,ai_store(A_X29(),result_slot,A_X9()));
    ac_emit_darwin_wait_runtime_init(out,syms,cg);push[AInstr](out,ai_data_addr(A_X0(),ac_darwin_wait_state_offset()+8));push[AInstr](out,ai_extern_call(lock_import));push[AInstr](out,ai_cmp_imm(A_X0(),0));push[AInstr](out,ai_je(locked));push[AInstr](out,ai_neg(A_X0(),A_X0()));push[AInstr](out,ai_store(A_X29(),result_slot,A_X0()));push[AInstr](out,ai_jmp(done));
    push[AInstr](out,ai_label(locked));push[AInstr](out,ai_load(A_X11(),A_X29(),count_slot));push[AInstr](out,ai_cmp_imm(A_X11(),0));push[AInstr](out,ai_jge(count_ok));push[AInstr](out,ai_mov_imm(A_X9(),0-22));push[AInstr](out,ai_store(A_X29(),result_slot,A_X9()));push[AInstr](out,ai_jmp(unlock));
    push[AInstr](out,ai_label(count_ok));push[AInstr](out,ai_cmp_imm(A_X11(),0));push[AInstr](out,ai_je(unlock));push[AInstr](out,ai_data_addr(A_X10(),ac_darwin_wait_state_offset()+72));push[AInstr](out,ai_load(A_X10(),A_X10(),0));push[AInstr](out,ai_store(A_X29(),node_slot,A_X10()));
    push[AInstr](out,ai_label(loop));push[AInstr](out,ai_load(A_X10(),A_X29(),node_slot));push[AInstr](out,ai_cmp_imm(A_X10(),0));push[AInstr](out,ai_je(unlock));push[AInstr](out,ai_load(A_X11(),A_X29(),result_slot));push[AInstr](out,ai_load(A_X12(),A_X29(),count_slot));push[AInstr](out,ai_cmp(A_X11(),A_X12()));push[AInstr](out,ai_jge(unlock));push[AInstr](out,ai_load(A_X13(),A_X10(),16));push[AInstr](out,ai_load(A_X14(),A_X29(),ptr_slot));push[AInstr](out,ai_cmp(A_X13(),A_X14()));push[AInstr](out,ai_jne(next));push[AInstr](out,ai_load(A_X13(),A_X10(),24));push[AInstr](out,ai_cmp_imm(A_X13(),0));push[AInstr](out,ai_jne(next));
    push[AInstr](out,ai_mov_imm(A_X13(),1));push[AInstr](out,ai_store(A_X10(),24,A_X13()));push[AInstr](out,ai_mov_rr(A_X0(),A_X10()));push[AInstr](out,ai_add_imm(A_X0(),32));push[AInstr](out,ai_extern_call(signal_import));push[AInstr](out,ai_cmp_imm(A_X0(),0));push[AInstr](out,ai_je(signal_ok));push[AInstr](out,ai_load(A_X10(),A_X29(),node_slot));push[AInstr](out,ai_mov_imm(A_X13(),0));push[AInstr](out,ai_store(A_X10(),24,A_X13()));push[AInstr](out,ai_neg(A_X0(),A_X0()));push[AInstr](out,ai_store(A_X29(),result_slot,A_X0()));push[AInstr](out,ai_jmp(unlock));
    push[AInstr](out,ai_label(signal_ok));push[AInstr](out,ai_load(A_X11(),A_X29(),result_slot));push[AInstr](out,ai_add_imm(A_X11(),1));push[AInstr](out,ai_store(A_X29(),result_slot,A_X11()));
    push[AInstr](out,ai_label(next));push[AInstr](out,ai_load(A_X10(),A_X29(),node_slot));push[AInstr](out,ai_load(A_X10(),A_X10(),0));push[AInstr](out,ai_store(A_X29(),node_slot,A_X10()));push[AInstr](out,ai_jmp(loop));
    push[AInstr](out,ai_label(unlock));push[AInstr](out,ai_data_addr(A_X0(),ac_darwin_wait_state_offset()+8));push[AInstr](out,ai_extern_call(unlock_import));push[AInstr](out,ai_label(done));push[AInstr](out,ai_load(A_X0(),A_X29(),result_slot));push[AInstr](out,ai_push(A_X0()));
}

fn ac_lower_at_builtin(out: *ArrayList[AInstr], fname: []u8, c: Call, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) void {
    let b: []u8 = fname[1..];
    let nargs: i32 = len[*Node](c.args);
    // Numeric builtins lower to ordinary pure-Zag runtime functions.  Keeping
    // this as a call means the normal AAPCS64 aggregate/sret machinery handles
    // quire and RNS-adjacent values too.
    let nfn: []u8 = cg_posit_builtin_fn(b);
    if (nfn.len == 0) { nfn = cg_quire_builtin_fn(b); }
    if (nfn.len > 0) {
        ac_lower_call(out, Call{ .callee = mk_ident(nfn), .args = c.args, .targs = make[[]u8](1) }, env, syms, cg);
        return;
    }
    if(@strEq(b,"atomicWait32")||@strEq(b,"atomicWake32")){
        if(cg.*.target_os!=AC_OS_MACOS()){
            ac_err(cg,"arm64: atomic wait/wake is not implemented for this target");push[AInstr](out,ai_mov_imm(A_X0(),0));push[AInstr](out,ai_push(A_X0()));return;
        }
        if(nargs!=2){ac_err(cg,"arm64: atomic wait/wake expects i32 pointer and i32 value");push[AInstr](out,ai_mov_imm(A_X0(),0));push[AInstr](out,ai_push(A_X0()));return;}
        let pty:[]u8=ac_expr_type(get[*Node](c.args,0),env,syms,cg);
        if(!@strEq(pty,"*const i32")&&!@strEq(pty,"*mut i32")&&!@strEq(pty,"*host i32")){ac_err(cg,"arm64: atomic wait/wake requires *const/*mut/*host i32");push[AInstr](out,ai_mov_imm(A_X0(),0));push[AInstr](out,ai_push(A_X0()));return;}
        if(ac_darwin_wait_imports_ready(syms)==0){ac_err(cg,"arm64: compiler-owned Darwin wait/wake imports are unavailable");push[AInstr](out,ai_mov_imm(A_X0(),0));push[AInstr](out,ai_push(A_X0()));return;}
        if(@strEq(b,"atomicWait32")){ac_lower_darwin_atomic_wait32(out,c,env,syms,cg);}else{ac_lower_darwin_atomic_wake32(out,c,env,syms,cg);}return;
    }
    if (@strEq(b,"threadSpawn") || @strEq(b,"asyncSpawn")) {
        if (cg.*.target_os != AC_OS_MACOS()) {
            ac_err(cg,"arm64: @threadSpawn is not implemented for this target");
            push[AInstr](out,ai_mov_imm(A_X0(),0));push[AInstr](out,ai_push(A_X0()));return;
        }
        if (nargs != 1 && nargs != 2) {
            ac_err(cg,"arm64: @threadSpawn expects a direct worker and optional i64 argument");
            push[AInstr](out,ai_mov_imm(A_X0(),0));push[AInstr](out,ai_push(A_X0()));return;
        }
        let with_i64:i32=(nargs==2) as i32;
        let worker:i32=ac_thread_worker_label(cg,syms,get[*Node](c.args,0),with_i64);
        let create_import:i32=ac_find_extern(syms,"pthread_create");
        if(worker<0){
            ac_err(cg,"arm64: validated thread worker label is unavailable during lowering");
            push[AInstr](out,ai_mov_imm(A_X0(),0));push[AInstr](out,ai_push(A_X0()));return;
        }
        if(create_import<0){
            ac_err(cg,"arm64: compiler-owned pthread_create import is unavailable during lowering");
            push[AInstr](out,ai_mov_imm(A_X0(),0));push[AInstr](out,ai_push(A_X0()));return;
        }

        // pthread's start callback is `void *(*)(void *)`; keep that ABI exact
        // with a compiler-owned trampoline rather than casting a Zag `fn() void`.
        // The handle carries pthread_t@0, the parent's hidden process context
        // (x27)@8, the optional scalar worker argument@16, and the compiler-
        // owned ZagScript cancellation flag@24.
        let trampoline:i32=ac_fresh(cg);let after_trampoline:i32=ac_fresh(cg);
        push[AInstr](out,ai_jmp(after_trampoline));
        push[AInstr](out,ai_label(trampoline));
        push[AInstr](out,ai_sub_imm(A_SP(),32));
        push[AInstr](out,ai_store(A_SP(),0,A_X30()));
        push[AInstr](out,ai_store(A_SP(),8,A_X27()));
        push[AInstr](out,ai_store(A_SP(),16,A_X26()));
        push[AInstr](out,ai_mov_rr(A_X9(),A_X0()));
        push[AInstr](out,ai_load(A_X27(),A_X9(),8));
        if(@strEq(b,"asyncSpawn")){push[AInstr](out,ai_mov_rr(A_X26(),A_X9()));}
        else{push[AInstr](out,ai_mov_imm(A_X26(),0));}
        if(with_i64==1){push[AInstr](out,ai_load(A_X0(),A_X9(),16));}
        push[AInstr](out,ai_call(worker));
        push[AInstr](out,ai_load(A_X26(),A_SP(),16));
        push[AInstr](out,ai_load(A_X27(),A_SP(),8));
        push[AInstr](out,ai_load(A_X30(),A_SP(),0));
        push[AInstr](out,ai_add_imm(A_SP(),32));
        push[AInstr](out,ai_mov_imm(A_X0(),0));
        push[AInstr](out,ai_ret());
        push[AInstr](out,ai_label(after_trampoline));

        let handle_slot:i32=ac_slot_scratch(cg,1);
        let failed:i32=ac_fresh(cg);let done:i32=ac_fresh(cg);
        push[AInstr](out,ai_mov_imm(A_X0(),0));push[AInstr](out,ai_mov_imm(A_X1(),4096));
        push[AInstr](out,ai_mov_imm(A_X2(),3));push[AInstr](out,ai_mov_imm(A_X3(),4098));
        push[AInstr](out,ai_mov_imm(A_X4(),0-1));push[AInstr](out,ai_mov_imm(A_X5(),0));
        push[AInstr](out,ai_syscall(222));
        push[AInstr](out,ai_cmp_imm(A_X0(),0));push[AInstr](out,ai_jl(failed));
        push[AInstr](out,ai_store(A_X29(),handle_slot,A_X0()));
        push[AInstr](out,ai_store(A_X0(),8,A_X27()));
        push[AInstr](out,ai_mov_imm(A_X9(),0));push[AInstr](out,ai_store(A_X0(),24,A_X9()));
        if(with_i64==1){
            ac_lower_expr(out,get[*Node](c.args,1),env,syms,cg);push[AInstr](out,ai_pop(A_X9()));
            push[AInstr](out,ai_load(A_X10(),A_X29(),handle_slot));push[AInstr](out,ai_store(A_X10(),16,A_X9()));
        }
        push[AInstr](out,ai_load(A_X0(),A_X29(),handle_slot));
        push[AInstr](out,ai_mov_imm(A_X1(),0));push[AInstr](out,ai_lea_lbl(A_X2(),trampoline));
        push[AInstr](out,ai_mov_rr(A_X3(),A_X0()));push[AInstr](out,ai_extern_call(create_import));
        push[AInstr](out,ai_cmp_imm(A_X0(),0));let created:i32=ac_fresh(cg);push[AInstr](out,ai_je(created));
        push[AInstr](out,ai_load(A_X0(),A_X29(),handle_slot));push[AInstr](out,ai_mov_imm(A_X1(),4096));push[AInstr](out,ai_syscall(215));
        push[AInstr](out,ai_jmp(failed));
        push[AInstr](out,ai_label(created));push[AInstr](out,ai_load(A_X0(),A_X29(),handle_slot));push[AInstr](out,ai_jmp(done));
        push[AInstr](out,ai_label(failed));push[AInstr](out,ai_mov_imm(A_X0(),0));
        push[AInstr](out,ai_label(done));push[AInstr](out,ai_push(A_X0()));return;
    }
    if (@strEq(b,"asyncCancelled")) {
        if(nargs!=0){ac_err(cg,"arm64: @asyncCancelled expects no arguments");}
        let none:i32=ac_fresh(cg);let cancel_done:i32=ac_fresh(cg);
        push[AInstr](out,ai_cmp_imm(A_X26(),0));push[AInstr](out,ai_je(none));
        push[AInstr](out,ai_load(A_X0(),A_X26(),24));push[AInstr](out,ai_jmp(cancel_done));
        push[AInstr](out,ai_label(none));push[AInstr](out,ai_mov_imm(A_X0(),0));
        push[AInstr](out,ai_label(cancel_done));push[AInstr](out,ai_push(A_X0()));return;
    }
    if (@strEq(b,"threadJoin") || @strEq(b,"asyncJoin")) {
        if (cg.*.target_os != AC_OS_MACOS()) {
            ac_err(cg,"arm64: @threadJoin is not implemented for this target");
            push[AInstr](out,ai_mov_imm(A_X0(),0));push[AInstr](out,ai_push(A_X0()));return;
        }
        if(nargs!=1){ac_err(cg,"arm64: @threadJoin expects one handle");push[AInstr](out,ai_mov_imm(A_X0(),0));push[AInstr](out,ai_push(A_X0()));return;}
        let join_import:i32=ac_find_extern(syms,"pthread_join");
        if(join_import<0){ac_err(cg,"arm64: compiler-owned pthread_join import is unavailable");push[AInstr](out,ai_mov_imm(A_X0(),0));push[AInstr](out,ai_push(A_X0()));return;}
        let handle_slot:i32=ac_slot_scratch(cg,1);let null_done:i32=ac_fresh(cg);let joined:i32=ac_fresh(cg);let unmapped:i32=ac_fresh(cg);
        ac_lower_expr(out,get[*Node](c.args,0),env,syms,cg);push[AInstr](out,ai_pop(A_X10()));
        push[AInstr](out,ai_cmp_imm(A_X10(),0));push[AInstr](out,ai_je(null_done));push[AInstr](out,ai_store(A_X29(),handle_slot,A_X10()));
        push[AInstr](out,ai_load(A_X0(),A_X10(),0));push[AInstr](out,ai_mov_imm(A_X1(),0));push[AInstr](out,ai_extern_call(join_import));
        push[AInstr](out,ai_cmp_imm(A_X0(),0));push[AInstr](out,ai_je(joined));
        ac_emit_panic(out,"zag runtime: pthread_join failed",joined,cg);
        push[AInstr](out,ai_load(A_X0(),A_X29(),handle_slot));push[AInstr](out,ai_mov_imm(A_X1(),4096));push[AInstr](out,ai_syscall(215));
        push[AInstr](out,ai_cmp_imm(A_X0(),0));push[AInstr](out,ai_je(unmapped));ac_emit_panic(out,"zag runtime: thread handle unmap failed",unmapped,cg);
        push[AInstr](out,ai_label(null_done));
        if(@strEq(b,"asyncJoin")){
            switch(get[*Node](c.args,0).*){
                .id=>|task_id|{
                    let task_disp:i32=ac_slot_find(env,task_id.name);
                    if(task_disp!=0){push[AInstr](out,ai_mov_imm(A_X9(),0));push[AInstr](out,ai_store(A_X29(),task_disp,A_X9()));}
                }
                else=>{}
            }
        }
        push[AInstr](out,ai_mov_imm(A_X0(),0));push[AInstr](out,ai_push(A_X0()));return;
    }

    // Edition-2027 volatile/MMIO transactions have the same bounded surface
    // as x86-64. AArch64 scalar loads/stores are emitted exactly once here;
    // they are deliberately non-atomic and imply no ordering fence. Checked
    // mode reuses the ordinary raw-pointer provenance/alignment probe.
    if (@strEq(b,"volatileLoad") || @strEq(b,"volatileLoad8") ||
        @strEq(b,"volatileLoad16") || @strEq(b,"volatileLoad32")) {
        if (nargs != 1) {
            ac_err(cg,"arm64: volatile load expects one raw MMIO pointer");
            push[AInstr](out,ai_mov_imm(A_X0(),0));push[AInstr](out,ai_push(A_X0()));return;
        }
        let pty:[]u8=ac_expr_type(get[*Node](c.args,0),env,syms,cg);
        let width:i32=8;let align:i32=8;let ptr_ok:i32=0;
        if (@strEq(b,"volatileLoad8")) {
            width=1;align=1;
            ptr_ok=(@strEq(pty,"*const u8")||@strEq(pty,"*mut u8")||@strEq(pty,"*host u8")) as i32;
        } else if (@strEq(b,"volatileLoad16")) {
            width=2;align=2;
            ptr_ok=(@strEq(pty,"*const u16")||@strEq(pty,"*mut u16")||@strEq(pty,"*host u16")) as i32;
        } else if (@strEq(b,"volatileLoad32")) {
            width=4;align=4;
            ptr_ok=(@strEq(pty,"*const u32")||@strEq(pty,"*mut u32")||@strEq(pty,"*host u32")) as i32;
        } else {
            ptr_ok=(@strEq(pty,"*const i64")||@strEq(pty,"*mut i64")||@strEq(pty,"*host i64")||
                    @strEq(pty,"*const u64")||@strEq(pty,"*mut u64")||@strEq(pty,"*host u64")||
                    @strEq(pty,"*const isize")||@strEq(pty,"*mut isize")||@strEq(pty,"*host isize")||
                    @strEq(pty,"*const usize")||@strEq(pty,"*mut usize")||@strEq(pty,"*host usize")) as i32;
        }
        if (ptr_ok==0) {
            ac_err(cg,"arm64: volatile load pointer has the wrong width or address space");
            push[AInstr](out,ai_mov_imm(A_X0(),0));push[AInstr](out,ai_push(A_X0()));return;
        }
        ac_lower_expr(out,get[*Node](c.args,0),env,syms,cg);push[AInstr](out,ai_pop(A_X0()));
        push[AInstr](out,ai_mov_rr(A_X7(),A_X0()));ac_emit_checked_raw_access(out,cg,align,width);
        if(width==1){push[AInstr](out,ai_loadb(A_X0(),A_X0(),0));}
        else if(width==2){push[AInstr](out,ai_loadh(A_X0(),A_X0(),0));}
        else if(width==4){push[AInstr](out,ai_loadw(A_X0(),A_X0(),0));}
        else{push[AInstr](out,ai_load(A_X0(),A_X0(),0));}
        push[AInstr](out,ai_push(A_X0()));return;
    }
    if (@strEq(b,"volatileStore") || @strEq(b,"volatileStore8") ||
        @strEq(b,"volatileStore16") || @strEq(b,"volatileStore32")) {
        if (nargs != 2) {
            ac_err(cg,"arm64: volatile store expects raw MMIO pointer and value");
            push[AInstr](out,ai_mov_imm(A_X0(),0));push[AInstr](out,ai_push(A_X0()));return;
        }
        let pty:[]u8=ac_expr_type(get[*Node](c.args,0),env,syms,cg);
