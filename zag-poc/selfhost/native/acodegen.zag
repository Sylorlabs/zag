// selfhost/native/acodegen.zag — AArch64 codegen (Phase-2 subset).
//
// Mirrors the x86 backend's data model (see ncodegen.zag):
//   • uniform 8-byte fields; aggregates evaluate to their block ADDRESS
//   • locals: INLINE (slot block, lea) or BY-REF (slot holds pointer)
//   • slices are {ptr@0, len@8}; []u8 data is byte-packed
//   • aggregate args are caller-copied, passed by address
//   • aggregate returns via hidden sret pointer in x8 (AAPCS64)
//   • heap = one mmap per allocation (syscall 222), no free
//
// Supports: i32/i64/u8 arithmetic, control flow, fn calls (≤8 args),
// structs, pointers (& / .* / new / delete), []u8 + word slices (len,
// index, subslice), enums (member consts, ==, switch without captures),
// print_int/print_i32/print_str/_zag_print/_zag_println.

@import("aisa.zag")
@import("../parse.zag")

fn ac_parse_i64(s: []u8) i64 {
    let i: i32 = 0;
    let neg: i32 = 0;
    if (s.len > 0) {
        if (s[0] == '-') { neg = 1; i = 1; }
        else if (s[0] == '+') { i = 1; }
    }
    // hex literal 0x… (base 16); keeps arm64 output identical to x86.
    if (i + 1 < s.len && s[i] == '0' && (s[i + 1] == 'x' || s[i + 1] == 'X')) {
        i = i + 2;
        let hacc: i64 = 0;
        while (i < s.len) {
            let hc: u8 = s[i];
            if (hc == '_') { i = i + 1; }
            else {
                let hv: i64 = 0 - 1;
                if (hc >= '0' && hc <= '9') { hv = (hc as i64) - 48; }
                else if (hc >= 'a' && hc <= 'f') { hv = (hc as i64) - 87; }
                else if (hc >= 'A' && hc <= 'F') { hv = (hc as i64) - 55; }
                if (hv >= 0) { hacc = hacc * 16 + hv; }
                i = i + 1;
            }
        }
        if (neg == 1) { return 0 - hacc; }
        return hacc;
    }
    let acc: i64 = 0;
    while (i < s.len) {
        let c: u8 = s[i];
        if (c == '_') { i = i + 1; }
        else if (c >= 48 && c <= 57) {
            acc = acc * 10 + (c as i64) - 48;
            i = i + 1;
        } else { i = i + 1; }
    }
    if (neg == 1) { return 0 - acc; }
    return acc;
}

fn ac_is_int_text(s: []u8) i32 {
    let i: i32 = 0;
    if (s.len > 0) {
        if (s[0] == '-' || s[0] == '+') { i = 1; }
    }
    if (i >= s.len) { return 0; }
    if (i + 1 < s.len && s[i] == '0' && (s[i + 1] == 'x' || s[i + 1] == 'X')) {
        let h: i32 = i + 2;
        if (h >= s.len) { return 0; }
        while (h < s.len) {
            let c: u8 = s[h];
            let ok: bool = (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F') || c == '_';
            if (!ok) { return 0; }
            h = h + 1;
        }
        return 1;
    }
    let digits: i32 = 0;
    while (i < s.len) {
        let c: u8 = s[i];
        if (c == '_') { i = i + 1; }
        else if (c >= 48 && c <= 57) { digits = digits + 1; i = i + 1; }
        else { return 0; }
    }
    if (digits == 0) { return 0; }
    return 1;
}

// 'x' / '\n' single-char literal → value, or -1 if not a char literal.
fn ac_char_lit_val(s: []u8) i64 {
    if (s.len < 3) { return 0 - 1; }
    if (s[0] != 39) { return 0 - 1; }
    if (s[1] == 92 && s.len >= 4) {
        let e: u8 = s[2];
        if (e == 'n') { return 10; }
        if (e == 't') { return 9; }
        if (e == 'r') { return 13; }
        if (e == '0') { return 0; }
        if (e == 92) { return 92; }
        if (e == 39) { return 39; }
        return e as i64;
    }
    return s[1] as i64;
}

fn ac_decode_str(text: []u8, out: *ArrayList[u8]) void {
    let n: i32 = text.len;
    let i: i32 = 0;
    let j: i32 = n;
    if (n >= 2) {
        if (text[0] == 34) { i = 1; }
        if (text[n - 1] == 34) { j = n - 1; }
    }
    while (i < j) {
        let c: u8 = text[i];
        if (c == 92 && i + 1 < j) {
            let e: u8 = text[i + 1];
            if (e == 'n') { push[u8](out, 10); }
            else if (e == 't') { push[u8](out, 9); }
            else if (e == 'r') { push[u8](out, 13); }
            else if (e == '0') { push[u8](out, 0); }
            else { push[u8](out, e); }
            i = i + 2;
        } else {
            push[u8](out, c);
            i = i + 1;
        }
    }
}

fn ac_decoded_len(text: []u8) i32 {
    let tmp: ArrayList[u8] = make[u8](text.len + 1);
    ac_decode_str(text, &tmp);
    return len[u8](tmp);
}

struct AFnSym { name: []u8, lbl: i32, nparams: i32, ret: []u8 }

fn AC_EXPR_WORDS() i32 { return 48; }

// Locals: INLINE aggregates own `words` contiguous slots; BY-REF locals own
// one word holding a pointer to a block elsewhere (aggregate params).
struct AEnv {
    names: ArrayList[[]u8],
    disps: ArrayList[i32],
    types: ArrayList[[]u8],
    byref: ArrayList[i32],
    break_lbls: ArrayList[i32],
    continue_lbls: ArrayList[i32],
}

struct ACg {
    next: i32,
    err: i32,
    data: *ArrayList[u8],
    pi_lbl: i32,
    ps_lbl: i32,
    al_lbl: i32,
    se_lbl: i32,
    rl_lbl: i32,
    is_lbl: i32,
    pf_lbl: i32,
    dz_lbl: i32,
    ms_lbl: i32,    // __make_slice(x0=ptr, x1=len) -> x0=&{ptr,len}
    pb_lbl: i32,    // __pathbuf(x0=&slice) -> x0=NUL-terminated cstr
    cc_lbl: i32,    // __concat(x0=&a, x1=&b) -> x0=&{ptr,len}
    ar_lbl: i32,    // __arg(x0=i) -> x0=&{ptr,len}
    rf_lbl: i32,    // __read_file(x0=&path) -> x0=&{ptr,len}
    wf_lbl: i32,    // __write_file(x0=&path, x1=&content) -> x0=0/-1
    wx_lbl: i32,    // __write_exec: write_file + chmod 0755
    fe_lbl: i32,    // __file_exists(x0=&path) -> x0=0/1
    ex_lbl: i32,    // __exec_cmd(x0=&cmd) -> x0=child exit status
    s2_lbl: i32,    // __str_to_i64(x0=&s) -> x0
    use_pi: i32,
    use_ps: i32,
    use_al: i32,
    use_se: i32,
    use_rl: i32,
    use_is: i32,
    use_pf: i32,
    use_dz: i32,
    use_ms: i32,
    use_pb: i32,
    use_cc: i32,
    use_ar: i32,
    use_rf: i32,
    use_wf: i32,
    use_wx: i32,
    use_fe: i32,
    use_ex: i32,
    use_s2: i32,
    frame_words: i32,
    epilogue: i32,
    sret_disp: i32,     // frame disp of the saved x8 sret pointer (0 = none)
    sret_words: i32,    // words of the aggregate being returned (0 = scalar)
    ret_ty: []u8,       // current fn's return type
    nl_off: i32,        // data offset of the interned "\n" (-1 = not yet)
    decls: ArrayList[*Node],
}

fn ac_fresh(cg: *ACg) i32 {
    let id: i32 = cg.*.next;
    cg.*.next = cg.*.next + 1;
    return id;
}

fn ac_err(cg: *ACg, msg: []u8) void {
    _zag_eprintln(msg);
    cg.*.err = cg.*.err + 1;
}

fn ac_align16(n: i32) i32 {
    let r: i32 = n % 16;
    if (r == 0) { return n; }
    return n + (16 - r);
}

fn ac_round8(n: i32) i32 {
    let r: i32 = n % 8;
    if (r == 0) { return n; }
    return n + (8 - r);
}

fn ac_env_new() AEnv {
    return AEnv{
        .names = make[[]u8](8),
        .disps = make[i32](8),
        .types = make[[]u8](8),
        .byref = make[i32](8),
        .break_lbls = make[i32](4),
        .continue_lbls = make[i32](4),
    };
}

fn ac_loop_push(env: *AEnv, break_lbl: i32, continue_lbl: i32) void {
    push[i32](&env.*.break_lbls, break_lbl);
    push[i32](&env.*.continue_lbls, continue_lbl);
}
fn ac_loop_pop(env: *AEnv) void {
    if (env.*.break_lbls.len > 0) { env.*.break_lbls.len = env.*.break_lbls.len - 1; }
    if (env.*.continue_lbls.len > 0) { env.*.continue_lbls.len = env.*.continue_lbls.len - 1; }
}
fn ac_loop_top(labels: ArrayList[i32]) i32 {
    if (labels.len == 0) { return 0 - 1; }
    return get[i32](labels,labels.len - 1);
}

// ── type registry ────────────────────────────────────────────────────────────

fn ac_find_struct(cg: *ACg, name: []u8, out: *StructDecl) i32 {
    let i: i32 = 0;
    while (i < len[*Node](cg.*.decls)) {
        switch (get[*Node](cg.*.decls, i).*) {
            .struct_ => |sd| {
                if (@strEq(sd.name, name)) { out.* = sd; return 1; }
            }
            else => { }
        }
        i = i + 1;
    }
    return 0;
}

fn ac_find_union(cg: *ACg, name: []u8, out: *UnionDecl) i32 {
    let i: i32 = 0;
    while (i < len[*Node](cg.*.decls)) {
        switch (get[*Node](cg.*.decls, i).*) {
            .union_ => |ud| {
                if (@strEq(ud.name, name)) { out.* = ud; return 1; }
            }
            else => { }
        }
        i = i + 1;
    }
    return 0;
}

// Index of member `m` in enum `ename`, or -1 (also -1 if no such enum).
fn ac_enum_member(cg: *ACg, ename: []u8, m: []u8) i32 {
    let i: i32 = 0;
    while (i < len[*Node](cg.*.decls)) {
        switch (get[*Node](cg.*.decls, i).*) {
            .enum_ => |ed| {
                if (@strEq(ed.name, ename)) {
                    let j: i32 = 0;
                    while (j < len[[]u8](ed.members)) {
                        if (@strEq(get[[]u8](ed.members, j), m)) { return j; }
                        j = j + 1;
                    }
                    return 0 - 1;
                }
            }
            else => { }
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn ac_is_enum(cg: *ACg, name: []u8) i32 {
    let i: i32 = 0;
    while (i < len[*Node](cg.*.decls)) {
        switch (get[*Node](cg.*.decls, i).*) {
            .enum_ => |ed| { if (@strEq(ed.name, name)) { return 1; } }
            else => { }
        }
        i = i + 1;
    }
    return 0;
}

fn ac_type_is_slice(ty: []u8) i32 {
    if (ty.len < 3) { return 0; }
    if (ty[0] == 91 && ty[1] == 93) { return 1; }   // "[]"
    return 0;
}

fn ac_slice_elem(ty: []u8) []u8 {
    if (ac_type_is_slice(ty) == 0) { return ""; }
    return ty[2..];
}

fn ac_elem_is_byte(ty: []u8) i32 {
    if (@strEq(ty, "u8")) { return 1; }
    if (@strEq(ty, "i8")) { return 1; }
    return 0;
}

fn ac_type_size(cg: *ACg, ty0: []u8) i32 {
    let ty: []u8 = cg_norm_type(ty0);
    if (ty.len == 0) { return 8; }
    if (ty[0] == '*') { return 8; }
    if (ac_type_is_slice(ty) == 1) { return 16; }
    if (@strEq(ty, "fat_fn")) { return 16; }        // {code_ptr, env_ptr}
    if (cg_is_fn_type(ty) == 1) { return 16; }
    if (ty[0] == '!') { return 16; }               // !T error union = {err_code, val}
    if (ty[0] == '?') { return 8 + ac_round8(ac_type_size(cg, ty[1..])); }
    let sd: StructDecl = StructDecl{ .name = "", .fields = make[Param](1), .tparams = make[[]u8](1), .is_pub = 0, .origin = "<root>" };
    if (ac_find_struct(cg, ty, &sd) == 1) {
        let total: i32 = 0;
        let i: i32 = 0;
        while (i < len[Param](sd.fields)) {
            total = total + ac_round8(ac_type_size(cg, get[Param](sd.fields, i).pty));
            i = i + 1;
        }
        if (total == 0) { return 8; }
        return total;
    }
    let ud: UnionDecl = UnionDecl{ .name = "", .fields = make[Param](1) };
    if (ac_find_union(cg, ty, &ud) == 1) {
        let maxp: i32 = 0;
        let j: i32 = 0;
        while (j < len[Param](ud.fields)) {
            let ps: i32 = ac_round8(ac_type_size(cg, get[Param](ud.fields, j).pty));
            if (ps > maxp) { maxp = ps; }
            j = j + 1;
        }
        if (maxp == 0) { maxp = 8; }
        return 8 + maxp;
    }
    // interface: M fn-ptr slots + 1 data-ptr slot
    let iM: i32 = iface_method_count(cg.*.decls, ty);
    if (iM > 0) { return (iM + 1) * 8; }
    return 8;
}

fn ac_type_words(cg: *ACg, ty: []u8) i32 {
    return ac_round8(ac_type_size(cg, ty)) / 8;
}

fn ac_elem_stride(cg: *ACg, ty: []u8) i32 {
    if (ac_elem_is_byte(ty) == 1) { return 1; }
    return ac_round8(ac_type_size(cg, ty));
}

fn ac_is_aggregate(cg: *ACg, ty0: []u8) i32 {
    let ty: []u8 = cg_norm_type(ty0);
    if (ty.len == 0) { return 0; }
    if (ty[0] == '*') { return 0; }
    if (ac_type_is_slice(ty) == 1) { return 1; }
    if (@strEq(ty, "fat_fn")) { return 1; }
    if (cg_is_fn_type(ty) == 1) { return 1; }
    if (ty[0] == '!') { return 1; }
    if (ty[0] == '?') { return 1; }
    let sd: StructDecl = StructDecl{ .name = "", .fields = make[Param](1), .tparams = make[[]u8](1), .is_pub = 0, .origin = "<root>" };
    if (ac_find_struct(cg, ty, &sd) == 1) { return 1; }
    let ud: UnionDecl = UnionDecl{ .name = "", .fields = make[Param](1) };
    if (ac_find_union(cg, ty, &ud) == 1) { return 1; }
    if (iface_method_count(cg.*.decls, ty) > 0) { return 1; }
    return 0;
}

// Tag index of union member `m` in union `uname`, or -1.
fn ac_union_tag(cg: *ACg, uname: []u8, m: []u8) i32 {
    let ud: UnionDecl = UnionDecl{ .name = "", .fields = make[Param](1) };
    if (ac_find_union(cg, uname, &ud) == 0) { return 0 - 1; }
    let i: i32 = 0;
    while (i < len[Param](ud.fields)) {
        if (@strEq(get[Param](ud.fields, i).name, m)) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn ac_union_payload_type(cg: *ACg, uname: []u8, m: []u8) []u8 {
    let ud: UnionDecl = UnionDecl{ .name = "", .fields = make[Param](1) };
    if (ac_find_union(cg, uname, &ud) == 0) { return ""; }
    let i: i32 = 0;
    while (i < len[Param](ud.fields)) {
        let p: Param = get[Param](ud.fields, i);
        if (@strEq(p.name, m)) { return p.pty; }
        i = i + 1;
    }
    return "";
}

fn ac_is_union(cg: *ACg, name: []u8) i32 {
    let ud: UnionDecl = UnionDecl{ .name = "", .fields = make[Param](1) };
    return ac_find_union(cg, name, &ud);
}

fn ac_is_float(ty: []u8) i32 {
    if (@strEq(ty, "f32") || @strEq(ty, "f64")) { return 1; }
    return 0;
}

fn ac_is_optional(ty: []u8) i32 {
    if (ty.len > 1 && ty[0] == '?') { return 1; }
    return 0;
}

fn ac_is_null_node(n: *Node) i32 {
    switch (n.*) {
        .id => |x| { if (@strEq(x.name, "null")) { return 1; } }
        else => { }
    }
    return 0;
}

// Byte offset of `fname` in struct `sname`, or -1.
fn ac_field_offset(cg: *ACg, sname0: []u8, fname: []u8) i32 {
    let sname: []u8 = cg_norm_type(sname0);
    let sd: StructDecl = StructDecl{ .name = "", .fields = make[Param](1), .tparams = make[[]u8](1), .is_pub = 0, .origin = "<root>" };
    if (ac_find_struct(cg, sname, &sd) == 0) { return 0 - 1; }
    let off: i32 = 0;
    let i: i32 = 0;
    while (i < len[Param](sd.fields)) {
        let p: Param = get[Param](sd.fields, i);
        if (@strEq(p.name, fname)) { return off; }
        off = off + ac_round8(ac_type_size(cg, p.pty));
        i = i + 1;
    }
    return 0 - 1;
}

fn ac_field_type(cg: *ACg, sname0: []u8, fname: []u8) []u8 {
    let sname: []u8 = cg_norm_type(sname0);
    let sd: StructDecl = StructDecl{ .name = "", .fields = make[Param](1), .tparams = make[[]u8](1), .is_pub = 0, .origin = "<root>" };
    if (ac_find_struct(cg, sname, &sd) == 0) { return ""; }
    let i: i32 = 0;
    while (i < len[Param](sd.fields)) {
        let p: Param = get[Param](sd.fields, i);
        if (@strEq(p.name, fname)) { return p.pty; }
        i = i + 1;
    }
    return "";
}

// ── slots ────────────────────────────────────────────────────────────────────

fn ac_slot_alloc_br(env: *AEnv, cg: *ACg, name: []u8, ty: []u8, words: i32, byref: i32) i32 {
    let first: i32 = cg.*.frame_words;
    let disp: i32 = 0 - (8 * (first + words));
    push[[]u8](&env.*.names, name);
    push[i32](&env.*.disps, disp);
    push[[]u8](&env.*.types, cg_norm_type(ty));
    push[i32](&env.*.byref, byref);
    cg.*.frame_words = cg.*.frame_words + words;
    return disp;
}

fn ac_slot_scratch(cg: *ACg, words: i32) i32 {
    let first: i32 = cg.*.frame_words;
    let d: i32 = 0 - (8 * (first + words));
    cg.*.frame_words = cg.*.frame_words + words;
    return d;
}

// Returns the (negative) frame displacement, or 0 when not found — slot
// displacements start at -8, so 0 is the only safe "miss" sentinel.
fn ac_slot_find(env: *AEnv, name: []u8) i32 {
    let i: i32 = len[[]u8](env.*.names) - 1;
    while (i >= 0) {
        if (@strEq(get[[]u8](env.*.names, i), name)) {
            return get[i32](env.*.disps, i);
        }
        i = i - 1;
    }
    return 0;
}

fn ac_slot_type(env: *AEnv, name: []u8) []u8 {
    let i: i32 = len[[]u8](env.*.names) - 1;
    while (i >= 0) {
        if (@strEq(get[[]u8](env.*.names, i), name)) {
            return get[[]u8](env.*.types, i);
        }
        i = i - 1;
    }
    return "";
}

fn ac_slot_byref(env: *AEnv, name: []u8) i32 {
    let i: i32 = len[[]u8](env.*.names) - 1;
    while (i >= 0) {
        if (@strEq(get[[]u8](env.*.names, i), name)) {
            return get[i32](env.*.byref, i);
        }
        i = i - 1;
    }
    return 0;
}

fn ac_scope_mark(env: *AEnv) i32 { return len[[]u8](env.*.names); }

fn ac_scope_end(env: *AEnv, mark: i32) void {
    while (len[[]u8](env.*.names) > mark) {
        let _n: []u8 = pop[[]u8](&env.*.names);
        let _d: i32 = pop[i32](&env.*.disps);
        let _t: []u8 = pop[[]u8](&env.*.types);
        let _b: i32 = pop[i32](&env.*.byref);
    }
}

fn ac_intern_str(cg: *ACg, text: []u8, add_nl: i32) i32 {
    let off: i32 = len[u8](cg.*.data.*);
    ac_decode_str(text, cg.*.data);
    if (add_nl == 1) { push[u8](cg.*.data, 10); }
    return off;
}

fn ac_intern_nl(cg: *ACg) i32 {
    if (cg.*.nl_off >= 0) { return cg.*.nl_off; }
    let off: i32 = len[u8](cg.*.data.*);
    push[u8](cg.*.data, 10);
    cg.*.nl_off = off;
    return off;
}

fn ac_find_fn(syms: ArrayList[AFnSym], name: []u8) i32 {
    let i: i32 = 0;
    while (i < len[AFnSym](syms)) {
        if (@strEq(get[AFnSym](syms, i).name, name)) { return get[AFnSym](syms, i).lbl; }
        i = i + 1;
    }
    return 0 - 1;
}

fn ac_find_fn_ret(syms: ArrayList[AFnSym], name: []u8) []u8 {
    let i: i32 = 0;
    while (i < len[AFnSym](syms)) {
        if (@strEq(get[AFnSym](syms, i).name, name)) { return get[AFnSym](syms, i).ret; }
        i = i + 1;
    }
    return "";
}

fn ac_fn_param_type(cg: *ACg, fname: []u8, idx: i32) []u8 {
    let di: i32 = 0;
    while (di < len[*Node](cg.*.decls)) {
        switch (get[*Node](cg.*.decls, di).*) {
            .fn_decl => |f| {
                if (@strEq(f.name, fname) && idx < len[Param](f.params)) {
                    return get[Param](f.params, idx).pty;
                }
            }
            else => { }
        }
        di = di + 1;
    }
    return "";
}

fn ac_iface_mret(cg: *ACg, iname: []u8, mname: []u8) []u8 {
    let M: i32 = iface_method_count(cg.*.decls, iname);
    let mi: i32 = 0;
    while (mi < M) {
        if (@strEq(iface_method_name(cg.*.decls, iname, mi), mname)) {
            return iface_method_ret(cg.*.decls, iname, mi);
        }
        mi = mi + 1;
    }
    return "";
}

// ── small emit helpers ───────────────────────────────────────────────────────

// dst = x29 + disp
fn ac_emit_lea(out: *ArrayList[AInstr], dst: i32, disp: i32) void {
    push[AInstr](out, ai_mov_rr(dst, A_X29()));
    if (disp < 0) { push[AInstr](out, ai_sub_imm(dst, (0 - disp) as i64)); }
    else if (disp > 0) { push[AInstr](out, ai_add_imm(dst, disp as i64)); }
}

// copy `words` 8-byte words from [x11] to [x10] (clobbers x9)
fn ac_emit_copy(out: *ArrayList[AInstr], words: i32) void {
    let k: i32 = 0;
    while (k < words) {
        push[AInstr](out, ai_load(A_X9(), A_X11(), 8 * k));
        push[AInstr](out, ai_store(A_X10(), 8 * k, A_X9()));
        k = k + 1;
    }
}

// branch over a __div0 call when the divisor (x1) is nonzero
fn ac_emit_div0_guard(out: *ArrayList[AInstr], cg: *ACg) void {
    let l_ok: i32 = ac_fresh(cg);
    push[AInstr](out, ai_cmp_imm(A_X1(), 0));
    push[AInstr](out, ai_jne(l_ok));
    cg.*.use_dz = 1;
    push[AInstr](out, ai_call(cg.*.dz_lbl));
    push[AInstr](out, ai_label(l_ok));
}

// __div0(): write(2, "panic: division by zero\n", 24); exit(134). Never returns.
fn ac_emit_div0(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    let off: i32 = ac_intern_str(cg, "panic: division by zero", 1);
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_mov_imm(A_X8(), 64));
    push[AInstr](out, ai_mov_imm(A_X0(), 2));
    push[AInstr](out, ai_mov_imm(A_X1(), A_DATA_VBASE() + (off as i64)));
    push[AInstr](out, ai_mov_imm(A_X2(), 24));
    push[AInstr](out, ai_svc());
    push[AInstr](out, ai_mov_imm(A_X8(), 93));
    push[AInstr](out, ai_mov_imm(A_X0(), 134));
    push[AInstr](out, ai_svc());
    push[AInstr](out, ai_ret());
}

// ── expression type inference (best-effort; "" = unknown scalar) ────────────

fn ac_expr_type(n: *Node, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) []u8 {
    switch (n.*) {
        .ilit => |x| {
            if (cg_is_float_text(x.text) == 1) { return "f64"; }
            return "i64";
        }
        .slit => |_x| { return "[]u8"; }
        .embed => |_x| { return "[]u8"; }
        .id => |x| {
            if (@strEq(x.name, "true") || @strEq(x.name, "false")) { return "bool"; }
            let sty: []u8 = ac_slot_type(env, x.name);
            if (sty.len == 0 && ac_slot_find(env, x.name) == 0) {
                if (cg_is_clos_name(x.name) == 1) { return "fat_fn"; }
                if (ac_find_fn(syms, x.name) >= 0) { return "fat_fn"; }
            }
            return sty;
        }
        .bin => |b| {
            if (@strEq(b.op, "==") || @strEq(b.op, "!=") || @strEq(b.op, "<") ||
                @strEq(b.op, ">") || @strEq(b.op, "<=") || @strEq(b.op, ">=") ||
                @strEq(b.op, "&&") || @strEq(b.op, "||")) { return "bool"; }
            let lt: []u8 = ac_expr_type(b.l, env, syms, cg);
            if (@strEq(b.op, "orelse")) {
                if (ac_is_optional(lt) == 1) { return lt[1..]; }
                return ac_expr_type(b.r, env, syms, cg);
            }
            if (lt.len > 0) { return lt; }
            return ac_expr_type(b.r, env, syms, cg);
        }
        .un => |u| {
            if (@strEq(u.op, "!")) { return "bool"; }
            if (@strEq(u.op, "&")) {
                return _zag_str_concat("*", ac_expr_type(u.e, env, syms, cg));
            }
            if (@strEq(u.op, "try")) {
                let ety: []u8 = ac_expr_type(u.e, env, syms, cg);
                if (ety.len > 1 && ety[0] == '!') { return ety[1..]; }
                return ety;
            }
            return ac_expr_type(u.e, env, syms, cg);
        }
        .call => |c| {
            switch (c.callee.*) {
                .fld => |mf| {
                    if (!@strEq(mf.fname, "*") && !@strEq(mf.fname, "?") && !@strEq(mf.fname, "has") && !@strEq(mf.fname, "val")) {
                        let rty0: []u8 = ac_expr_type(mf.base, env, syms, cg);
                        if (rty0.len > 1 && rty0[0] == '*') { rty0 = rty0[1..]; }
                        if (iface_method_count(cg.*.decls, rty0) > 0) {
                            return ac_iface_mret(cg, rty0, mf.fname);
                        }
                        if (rty0.len > 0) {
                            return ac_find_fn_ret(syms, _zag_str_concat(_zag_str_concat(rty0, "_"), mf.fname));
                        }
                    }
                    return "";
                }
                .id => |fnid| {
                    if (@strEq(fnid.name, "new")) {
                        if (len[*Node](c.args) == 1) {
                            return _zag_str_concat("*", ac_expr_type(get[*Node](c.args, 0), env, syms, cg));
                        }
                        return "*u8";
                    }
                    if (@strEq(fnid.name, "_zag_malloc") || @strEq(fnid.name, "_zag_realloc")) { return "*u8"; }
                    if (@strEq(fnid.name, "_zag_i64_to_str")) { return "[]u8"; }
                    if (@strEq(fnid.name, "_zag_strcmp")) { return "i32"; }
                    if (@strEq(fnid.name, "_zag_str_concat") || @strEq(fnid.name, "_zag_arg") || @strEq(fnid.name, "_zag_read_file")) { return "[]u8"; }
                    if (@strEq(fnid.name, "_zag_argc") || @strEq(fnid.name, "_zag_exec_cmd") || @strEq(fnid.name, "_zag_write_file") || @strEq(fnid.name, "_zag_write_exec") || @strEq(fnid.name, "_zag_file_exists")) { return "i32"; }
                    if (@strEq(fnid.name, "_zag_str_to_i64")) { return "i64"; }
                    if (@strEq(fnid.name, "_zag_slice_ptr")) { return "*i8"; }
                    if (@strEq(fnid.name, "_zag_raw_syscall") || @strEq(fnid.name, "_zag_x86_cpuid_eax") ||
                        @strEq(fnid.name, "_zag_x86_cpuid_ebx") || @strEq(fnid.name, "_zag_x86_cpuid_ecx") ||
                        @strEq(fnid.name, "_zag_x86_cpuid_edx") || @strEq(fnid.name, "_zag_x86_xgetbv")) { return "i64"; }
                    if (@strEq(fnid.name, "__catch") || @strEq(fnid.name, "__catchc")) {
                        let cty0: []u8 = ac_expr_type(get[*Node](c.args, 0), env, syms, cg);
                        if (cty0.len > 1 && cty0[0] == '!') { return cty0[1..]; }
                        return cty0;
                    }
                    if (fnid.name.len > 0 && fnid.name[0] == '@') { return ""; }
                    if (len[[]u8](c.targs) > 0) {
                        return ac_find_fn_ret(syms, cg_mangle_generic_norm(fnid.name, c.targs));
                    }
                    return ac_find_fn_ret(syms, fnid.name);
                }
                else => { return ""; }
            }
        }
        .fld => |f| {
            // enum member constant: Color.red ; error.X → i32 code
            switch (f.base.*) {
                .id => |bid| {
                    if (@strEq(bid.name, "error")) { return "i32"; }
                    if (ac_slot_find(env, bid.name) == 0 && ac_is_enum(cg, bid.name) == 1) {
                        return bid.name;
                    }
                }
                else => { }
            }
            let bt: []u8 = ac_expr_type(f.base, env, syms, cg);
            if (@strEq(f.fname, "*")) {
                if (bt.len > 1 && bt[0] == '*') { return bt[1..]; }
                return "";
            }
            if (ac_type_is_slice(bt) == 1 && @strEq(f.fname, "len")) { return "i64"; }
            if (ac_is_optional(bt) == 1) {
                if (@strEq(f.fname, "has")) { return "i32"; }
                if (@strEq(f.fname, "val") || @strEq(f.fname, "?")) { return bt[1..]; }
            }
            let sname: []u8 = bt;
            if (bt.len > 1 && bt[0] == '*') { sname = bt[1..]; }
            return ac_field_type(cg, sname, f.fname);
        }
        .idx => |ix| {
            let bt: []u8 = ac_expr_type(ix.base, env, syms, cg);
            if (ac_type_is_slice(bt) == 1) { return ac_slice_elem(bt); }
            if (bt.len > 1 && bt[0] == '*') { return bt[1..]; }
            return "";
        }
        .cast_ => |cst| { return cg_norm_type(cst.target); }
        .slit_ => |sl| { return cg_slit_sname(sl); }
        .slice_ => |sc| {
            let bt2: []u8 = ac_expr_type(sc.base, env, syms, cg);
            if (bt2.len > 1 && bt2[0] == '*') { return _zag_str_concat("[]", bt2[1..]); }
            return bt2;
        }
        .switch_ => |sw| { return ac_switch_expr_type(sw, env, syms, cg); }
        else => { return ""; }
    }
}

// Build a fat_fn {code_ptr, env_ptr} block for a fn used as a value and push
// its address. Closures (__clos_N) malloc an env holding the captures:
// scalars by value, aggregates as heap copies, '*name' captures by address.
fn ac_materialize_fat_fn(out: *ArrayList[AInstr], name: []u8, lbl: i32, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) void {
    let fb: i32 = ac_slot_scratch(cg, 2);
    push[AInstr](out, ai_lea_lbl(A_X0(), lbl));
    push[AInstr](out, ai_store(A_X29(), fb, A_X0()));
    let caps: []u8 = "";
    let di: i32 = 0;
    while (di < len[*Node](cg.*.decls)) {
        switch (get[*Node](cg.*.decls, di).*) {
            .fn_decl => |fd| { if (@strEq(fd.name, name)) { caps = fd.cap_names; } }
            else => { }
        }
        di = di + 1;
    }
    if (caps.len == 0) {
        push[AInstr](out, ai_mov_imm(A_X0(), 0));
        push[AInstr](out, ai_store(A_X29(), fb + 8, A_X0()));
        ac_emit_lea(out, A_X0(), fb);
        push[AInstr](out, ai_push(A_X0()));
        return;
    }
    // record capture types on the decl so the closure body can bind them
    let cnames0: ArrayList[[]u8] = split_args(caps);
    let tys: []u8 = "";
    let ti: i32 = 0;
    while (ti < len[[]u8](cnames0)) {
        let cn: []u8 = get[[]u8](cnames0, ti);
        if (ti > 0) { tys = _zag_str_concat(tys, ","); }
        if (cn.len > 0 && cn[0] == '*') {
            tys = _zag_str_concat(tys, _zag_str_concat("*", ac_slot_type(env, cn[1..])));
        } else {
            tys = _zag_str_concat(tys, ac_slot_type(env, cn));
        }
        ti = ti + 1;
    }
    let di2: i32 = 0;
    while (di2 < len[*Node](cg.*.decls)) {
        let dn: *Node = get[*Node](cg.*.decls, di2);
        switch (dn.*) {
            .fn_decl => |fd2| {
                if (@strEq(fd2.name, name) && fd2.cap_types.len == 0) {
                    dn.* = Node{ .fn_decl = FnDecl{
                        .name = fd2.name, .tparams = fd2.tparams,
                        .params = fd2.params, .ret = fd2.ret,
                        .annots = fd2.annots, .body = fd2.body,
                        .is_extern = fd2.is_extern, .ret_eff = fd2.ret_eff,
                        .caps = fd2.caps, .cap_names = fd2.cap_names,
                        .cap_types = tys, .line = fd2.line, .is_pub = fd2.is_pub } };
                }
            }
            else => { }
        }
        di2 = di2 + 1;
    }
    // env = __malloc(ncaps * 8); fill the capture slots
    let ncaps: i32 = cg_count_caps(caps);
    let env_save: i32 = ac_slot_scratch(cg, 1);
    push[AInstr](out, ai_mov_imm(A_X0(), (ncaps * 8) as i64));
    cg.*.use_al = 1;
    push[AInstr](out, ai_call(cg.*.al_lbl));
    push[AInstr](out, ai_store(A_X29(), env_save, A_X0()));
    let ci: i32 = 0;
    while (ci < len[[]u8](cnames0)) {
        let cname: []u8 = get[[]u8](cnames0, ci);
        let is_ptr_cap: i32 = 0;
        let real_cn: []u8 = cname;
        if (cname.len > 0 && cname[0] == '*') { is_ptr_cap = 1; real_cn = cname[1..]; }
        let cdisp: i32 = ac_slot_find(env, real_cn);
        if (cdisp != 0) {
            if (is_ptr_cap == 1) {
                ac_emit_lea(out, A_X0(), cdisp);
                push[AInstr](out, ai_load(A_X10(), A_X29(), env_save));
                push[AInstr](out, ai_store(A_X10(), 8 * ci, A_X0()));
            } else {
                let cty: []u8 = ac_slot_type(env, real_cn);
                if (ac_is_aggregate(cg, cty) == 1 && ac_slot_byref(env, real_cn) == 0) {
                    // heap-copy the inline aggregate; env slot holds the copy's addr
                    let nw: i32 = ac_type_words(cg, cty);
                    push[AInstr](out, ai_mov_imm(A_X0(), (nw * 8) as i64));
                    push[AInstr](out, ai_call(cg.*.al_lbl));
                    push[AInstr](out, ai_mov_rr(A_X10(), A_X0()));
                    ac_emit_lea(out, A_X11(), cdisp);
                    ac_emit_copy(out, nw);
                    push[AInstr](out, ai_load(A_X9(), A_X29(), env_save));
                    push[AInstr](out, ai_store(A_X9(), 8 * ci, A_X10()));
                } else {
                    push[AInstr](out, ai_load(A_X0(), A_X29(), cdisp));
                    push[AInstr](out, ai_load(A_X10(), A_X29(), env_save));
                    push[AInstr](out, ai_store(A_X10(), 8 * ci, A_X0()));
                }
            }
        } else {
            ac_err(cg, _zag_str_concat("arm64: capture of unknown variable: ", real_cn));
        }
        ci = ci + 1;
    }
    push[AInstr](out, ai_load(A_X0(), A_X29(), env_save));
    push[AInstr](out, ai_store(A_X29(), fb + 8, A_X0()));
    ac_emit_lea(out, A_X0(), fb);
    push[AInstr](out, ai_push(A_X0()));
}

// ── lvalue address ───────────────────────────────────────────────────────────
// Pushes the ADDRESS of the lvalue onto the expression stack.

fn ac_lower_addr(out: *ArrayList[AInstr], n: *Node, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) void {
    switch (n.*) {
        .id => |x| {
            let disp: i32 = ac_slot_find(env, x.name);
            if (disp == 0) {
                ac_err(cg, _zag_str_concat("arm64: address of unknown identifier: ", x.name));
                push[AInstr](out, ai_mov_imm(A_X0(), 0));
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            if (ac_slot_byref(env, x.name) == 1) {
                push[AInstr](out, ai_load(A_X0(), A_X29(), disp));
            } else {
                ac_emit_lea(out, A_X0(), disp);
            }
            push[AInstr](out, ai_push(A_X0()));
        }
        .fld => |f| {
            let bt: []u8 = ac_expr_type(f.base, env, syms, cg);
            if (@strEq(f.fname, "*")) {
                // address of p.* is the pointer value itself
                ac_lower_expr(out, f.base, env, syms, cg);
                return;
            }
            if (ac_type_is_slice(bt) == 1 && @strEq(f.fname, "len")) {
                ac_lower_expr(out, f.base, env, syms, cg);
                push[AInstr](out, ai_pop(A_X0()));
                push[AInstr](out, ai_add_imm(A_X0(), 8));
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            let sname: []u8 = bt;
            if (bt.len > 1 && bt[0] == '*') { sname = bt[1..]; }
            let off: i32 = ac_field_offset(cg, sname, f.fname);
            if (off < 0) {
                ac_err(cg, _zag_str_concat("arm64: unknown field: ", f.fname));
                push[AInstr](out, ai_mov_imm(A_X0(), 0));
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            ac_lower_expr(out, f.base, env, syms, cg);   // base address / ptr value
            push[AInstr](out, ai_pop(A_X0()));
            if (off > 0) { push[AInstr](out, ai_add_imm(A_X0(), off as i64)); }
            push[AInstr](out, ai_push(A_X0()));
        }
        .idx => |ix| {
            let bt: []u8 = ac_expr_type(ix.base, env, syms, cg);
            let elem: []u8 = "";
            let is_slice: i32 = 0;
            if (ac_type_is_slice(bt) == 1) { elem = ac_slice_elem(bt); is_slice = 1; }
            else if (bt.len > 1 && bt[0] == '*') { elem = bt[1..]; }
            else { ac_err(cg, "arm64: indexing a non-slice/pointer value"); }
            let stride: i32 = ac_elem_stride(cg, elem);
            ac_lower_expr(out, ix.base, env, syms, cg);
            if (is_slice == 1) {
                // slice block address → load data ptr
                push[AInstr](out, ai_pop(A_X0()));
                push[AInstr](out, ai_load(A_X0(), A_X0(), 0));
                push[AInstr](out, ai_push(A_X0()));
            }
            ac_lower_expr(out, ix.idx, env, syms, cg);
            push[AInstr](out, ai_pop(A_X1()));
            push[AInstr](out, ai_pop(A_X0()));
            if (stride != 1) {
                push[AInstr](out, ai_mov_imm(A_X9(), stride as i64));
                push[AInstr](out, ai_mul(A_X1(), A_X1(), A_X9()));
            }
            push[AInstr](out, ai_add(A_X0(), A_X1()));
            push[AInstr](out, ai_push(A_X0()));
        }
        else => {
            ac_err(cg, "arm64: unsupported lvalue");
            push[AInstr](out, ai_mov_imm(A_X0(), 0));
            push[AInstr](out, ai_push(A_X0()));
        }
    }
}

// ── expressions ──────────────────────────────────────────────────────────────

fn ac_lower_expr(out: *ArrayList[AInstr], n: *Node, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) void {
    switch (n.*) {
        .ilit => |x| {
            if (cg_is_float_text(x.text) == 1) {
                let fe: i32 = 0;
                let fbits: i64 = zf64_bits_core(x.text, &fe);
                if (fe == 1) { ac_err(cg, "arm64: float literal out of supported range"); }
                push[AInstr](out, ai_mov_imm(A_X0(), fbits));
                push[AInstr](out, ai_push(A_X0()));
            } else if (ac_is_int_text(x.text) == 1) {
                push[AInstr](out, ai_mov_imm(A_X0(), ac_parse_i64(x.text)));
                push[AInstr](out, ai_push(A_X0()));
            } else {
                let cv: i64 = ac_char_lit_val(x.text);
                if (cv >= 0) {
                    push[AInstr](out, ai_mov_imm(A_X0(), cv));
                    push[AInstr](out, ai_push(A_X0()));
                } else {
                    ac_err(cg, "arm64: unsupported numeric literal");
                    push[AInstr](out, ai_mov_imm(A_X0(), 0));
                    push[AInstr](out, ai_push(A_X0()));
                }
            }
        }
        .id => |x| {
            if (@strEq(x.name, "true")) {
                push[AInstr](out, ai_mov_imm(A_X0(), 1));
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            if (@strEq(x.name, "false") || @strEq(x.name, "null")) {
                push[AInstr](out, ai_mov_imm(A_X0(), 0));
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            let disp: i32 = ac_slot_find(env, x.name);
            if (disp == 0) {
                let flbl: i32 = ac_find_fn(syms, x.name);
                if (flbl >= 0) {
                    ac_materialize_fat_fn(out, x.name, flbl, env, syms, cg);
                    return;
                }
                ac_err(cg, _zag_str_concat("arm64: unknown identifier: ", x.name));
                push[AInstr](out, ai_mov_imm(A_X0(), 0));
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            let ty: []u8 = ac_slot_type(env, x.name);
            if (ac_is_aggregate(cg, ty) == 1) {
                if (ac_slot_byref(env, x.name) == 1) {
                    push[AInstr](out, ai_load(A_X0(), A_X29(), disp));
                } else {
                    ac_emit_lea(out, A_X0(), disp);
                }
                push[AInstr](out, ai_push(A_X0()));
            } else {
                push[AInstr](out, ai_load(A_X0(), A_X29(), disp));
                push[AInstr](out, ai_push(A_X0()));
            }
        }
        .un => |u| {
            if (@strEq(u.op, "-")) {
                ac_lower_expr(out, u.e, env, syms, cg);
                push[AInstr](out, ai_pop(A_X0()));
                if (ac_is_float(ac_expr_type(u.e, env, syms, cg)) == 1) {
                    // flip the IEEE sign bit: x ^ (1<<63)
                    push[AInstr](out, ai_mov_imm(A_X9(), (0 - 9223372036854775807) - 1));
                    push[AInstr](out, ai_xor(A_X0(), A_X9()));
                } else {
                    push[AInstr](out, ai_neg(A_X0(), A_X0()));
                }
                push[AInstr](out, ai_push(A_X0()));
            } else if (@strEq(u.op, "!")) {
                ac_lower_expr(out, u.e, env, syms, cg);
                push[AInstr](out, ai_pop(A_X0()));
                push[AInstr](out, ai_cmp_imm(A_X0(), 0));
                let l0: i32 = ac_fresh(cg);
                let l1: i32 = ac_fresh(cg);
                push[AInstr](out, ai_je(l0));
                push[AInstr](out, ai_mov_imm(A_X0(), 0));
                push[AInstr](out, ai_jmp(l1));
                push[AInstr](out, ai_label(l0));
                push[AInstr](out, ai_mov_imm(A_X0(), 1));
                push[AInstr](out, ai_label(l1));
                push[AInstr](out, ai_push(A_X0()));
            } else if (@strEq(u.op, "&")) {
                ac_lower_addr(out, u.e, env, syms, cg);
            } else if (@strEq(u.op, "try")) {
                // try expr — expr is !T {err@0,val@8}; err==0 → val, else propagate.
                let l_ok: i32 = ac_fresh(cg);
                ac_lower_expr(out, u.e, env, syms, cg);   // pushes &{err,val}
                push[AInstr](out, ai_pop(A_X10()));
                push[AInstr](out, ai_load(A_X0(), A_X10(), 0));
                push[AInstr](out, ai_cmp_imm(A_X0(), 0));
                push[AInstr](out, ai_je(l_ok));
                if (cg.*.ret_ty.len > 1 && cg.*.ret_ty[0] == '!') {
                    push[AInstr](out, ai_load(A_X11(), A_X29(), cg.*.sret_disp));
                    push[AInstr](out, ai_store(A_X11(), 0, A_X0()));
                    push[AInstr](out, ai_mov_imm(A_X9(), 0));
                    push[AInstr](out, ai_store(A_X11(), 8, A_X9()));
                    push[AInstr](out, ai_mov_rr(A_X0(), A_X11()));
                } else {
                    ac_err(cg, "arm64: try in a fn that does not return !T");
                }
                push[AInstr](out, ai_jmp(cg.*.epilogue));
                push[AInstr](out, ai_label(l_ok));
                push[AInstr](out, ai_load(A_X0(), A_X10(), 8));
                push[AInstr](out, ai_push(A_X0()));
            } else {
                ac_err(cg, "arm64: unsupported unary operator");
                push[AInstr](out, ai_mov_imm(A_X0(), 0));
                push[AInstr](out, ai_push(A_X0()));
            }
        }
        .bin => |b| {
            if (@strEq(b.op, "orelse")) {
                let lt: []u8 = ac_expr_type(b.l, env, syms, cg);
                if (ac_is_optional(lt) == 0) {
                    ac_err(cg, "arm64: orelse on non-optional value");
                    push[AInstr](out, ai_mov_imm(A_X0(), 0));
                    push[AInstr](out, ai_push(A_X0()));
                    return;
                }
                let pty: []u8 = lt[1..];
                if (ac_is_aggregate(cg, pty) == 1) {
                    ac_err(cg, "arm64: orelse on aggregate payloads not yet supported");
                    push[AInstr](out, ai_mov_imm(A_X0(), 0));
                    push[AInstr](out, ai_push(A_X0()));
                    return;
                }
                let l_none: i32 = ac_fresh(cg);
                let l_done: i32 = ac_fresh(cg);
                ac_lower_expr(out, b.l, env, syms, cg);
                push[AInstr](out, ai_pop(A_X10()));
                push[AInstr](out, ai_load(A_X0(), A_X10(), 0));
                push[AInstr](out, ai_cmp_imm(A_X0(), 0));
                push[AInstr](out, ai_je(l_none));
                push[AInstr](out, ai_load(A_X0(), A_X10(), 8));
                push[AInstr](out, ai_push(A_X0()));
                push[AInstr](out, ai_jmp(l_done));
                push[AInstr](out, ai_label(l_none));
                ac_lower_expr(out, b.r, env, syms, cg);
                push[AInstr](out, ai_label(l_done));
                return;
            }
            if (@strEq(b.op, "&&") || @strEq(b.op, "||")) {
                // short-circuit: the right operand must NOT be evaluated when
                // the left already decides the result (side effects!).
                let l_out: i32 = ac_fresh(cg);
                let l_done: i32 = ac_fresh(cg);
                ac_lower_expr(out, b.l, env, syms, cg);
                push[AInstr](out, ai_pop(A_X0()));
                push[AInstr](out, ai_cmp_imm(A_X0(), 0));
                if (@strEq(b.op, "&&")) { push[AInstr](out, ai_je(l_out)); }
                else { push[AInstr](out, ai_jne(l_out)); }
                ac_lower_expr(out, b.r, env, syms, cg);
                push[AInstr](out, ai_pop(A_X0()));
                push[AInstr](out, ai_cmp_imm(A_X0(), 0));
                if (@strEq(b.op, "&&")) { push[AInstr](out, ai_je(l_out)); }
                else { push[AInstr](out, ai_jne(l_out)); }
                if (@strEq(b.op, "&&")) { push[AInstr](out, ai_mov_imm(A_X0(), 1)); }
                else { push[AInstr](out, ai_mov_imm(A_X0(), 0)); }
                push[AInstr](out, ai_jmp(l_done));
                push[AInstr](out, ai_label(l_out));
                if (@strEq(b.op, "&&")) { push[AInstr](out, ai_mov_imm(A_X0(), 0)); }
                else { push[AInstr](out, ai_mov_imm(A_X0(), 1)); }
                push[AInstr](out, ai_label(l_done));
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            let flt: i32 = ac_is_float(ac_expr_type(b.l, env, syms, cg));
            let frt: i32 = ac_is_float(ac_expr_type(b.r, env, syms, cg));
            if (flt == 1 || frt == 1) {
                if (flt == 0 || frt == 0) {
                    ac_err(cg, "arm64: mixed int/float arithmetic — add an explicit `as f64` cast");
                }
                ac_lower_expr(out, b.l, env, syms, cg);
                ac_lower_expr(out, b.r, env, syms, cg);
                push[AInstr](out, ai_pop(A_X1()));
                push[AInstr](out, ai_pop(A_X0()));
                push[AInstr](out, ai_fmov_dx(0, A_X0()));
                push[AInstr](out, ai_fmov_dx(1, A_X1()));
                if (ac_cmp_cc(b.op) >= 0) {
                    push[AInstr](out, ai_fcmp(0, 1));
                    let fl0: i32 = ac_fresh(cg);
                    let fl1: i32 = ac_fresh(cg);
                    ac_push_jcc_false(out, b.op, fl0);
                    push[AInstr](out, ai_mov_imm(A_X0(), 1));
                    push[AInstr](out, ai_jmp(fl1));
                    push[AInstr](out, ai_label(fl0));
                    push[AInstr](out, ai_mov_imm(A_X0(), 0));
                    push[AInstr](out, ai_label(fl1));
                    push[AInstr](out, ai_push(A_X0()));
                    return;
                }
                if (@strEq(b.op, "+")) { push[AInstr](out, ai_fadd(0, 1)); }
                else if (@strEq(b.op, "-")) { push[AInstr](out, ai_fsub(0, 1)); }
                else if (@strEq(b.op, "*")) { push[AInstr](out, ai_fmul(0, 1)); }
                else if (@strEq(b.op, "/")) { push[AInstr](out, ai_fdiv(0, 1)); }
                else { ac_err(cg, "arm64: operator not supported on floats"); }
                push[AInstr](out, ai_fmov_xd(A_X0(), 0));
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            ac_lower_expr(out, b.l, env, syms, cg);
            ac_lower_expr(out, b.r, env, syms, cg);
            push[AInstr](out, ai_pop(A_X1()));
            push[AInstr](out, ai_pop(A_X0()));
            if (@strEq(b.op, "+")) {
                push[AInstr](out, ai_add(A_X0(), A_X1()));
            } else if (@strEq(b.op, "-")) {
                push[AInstr](out, ai_sub(A_X0(), A_X1()));
            } else if (@strEq(b.op, "*")) {
                push[AInstr](out, ai_mul(A_X0(), A_X0(), A_X1()));
            } else if (@strEq(b.op, "/")) {
                // DEFINED division: /0 panics (SDIV alone would silently give 0)
                ac_emit_div0_guard(out, cg);
                push[AInstr](out, ai_sdiv(A_X0(), A_X0(), A_X1()));
            } else if (@strEq(b.op, "%")) {
                ac_emit_div0_guard(out, cg);
                push[AInstr](out, ai_sdiv(A_X9(), A_X0(), A_X1()));
                push[AInstr](out, ai_mul(A_X9(), A_X9(), A_X1()));
                push[AInstr](out, ai_sub(A_X0(), A_X9()));
            } else if (@strEq(b.op, "&")) {
                push[AInstr](out, ai_andr(A_X0(), A_X1()));
            } else if (@strEq(b.op, "^")) {
                push[AInstr](out, ai_xor(A_X0(), A_X1()));
            } else if (@strEq(b.op, "|")) {
                push[AInstr](out, ai_or(A_X0(), A_X1()));
            } else if (@strEq(b.op, "<<")) {
                push[AInstr](out, ai_shl(A_X0(), A_X1()));
            } else if (@strEq(b.op, ">>")) {
                push[AInstr](out, ai_shr(A_X0(), A_X1()));
            } else if (ac_cmp_cc(b.op) >= 0) {
                push[AInstr](out, ai_cmp(A_X0(), A_X1()));
                let l0: i32 = ac_fresh(cg);
                let l1: i32 = ac_fresh(cg);
                ac_push_jcc_false(out, b.op, l0);
                push[AInstr](out, ai_mov_imm(A_X0(), 1));
                push[AInstr](out, ai_jmp(l1));
                push[AInstr](out, ai_label(l0));
                push[AInstr](out, ai_mov_imm(A_X0(), 0));
                push[AInstr](out, ai_label(l1));
            } else {
                ac_err(cg, "arm64: unsupported binary operator");
                push[AInstr](out, ai_mov_imm(A_X0(), 0));
            }
            if (ac_cmp_cc(b.op) < 0 && !@strEq(b.op, "&&") && !@strEq(b.op, "||")) {
                // normalize the result to its declared width (i32 wraps at 32
                // bits, u32 zero-extends) — same contract as the x86 backend.
                let rty: []u8 = cg_norm_type(ac_expr_type(b.l, env, syms, cg));
                if (@strEq(rty, "i32")) {
                    push[AInstr](out, ai_sxtw(A_X0(), A_X0()));
                } else if (@strEq(rty, "u32")) {
                    push[AInstr](out, ai_and_imm(A_X0(), 4294967295));
                }
            }
            push[AInstr](out, ai_push(A_X0()));
        }
        .call => |c| {
            ac_lower_call(out, c, env, syms, cg);
        }
        .slit => |sl| {
            let off: i32 = ac_intern_str(cg, sl.text, 0);
            let dlen: i32 = ac_decoded_len(sl.text);
            let base: i32 = ac_slot_scratch(cg, 2);
            push[AInstr](out, ai_mov_imm(A_X0(), A_DATA_VBASE() + (off as i64)));
            push[AInstr](out, ai_store(A_X29(), base + 0, A_X0()));
            push[AInstr](out, ai_mov_imm(A_X0(), dlen as i64));
            push[AInstr](out, ai_store(A_X29(), base + 8, A_X0()));
            ac_emit_lea(out, A_X0(), base);
            push[AInstr](out, ai_push(A_X0()));
        }
        .embed => |em| {
            let off:i32=len[u8](cg.*.data.*);
            let bi:i32=0;
            while(bi<em.data.len){push[u8](cg.*.data,em.data[bi]);bi=bi+1;}
            let base:i32=ac_slot_scratch(cg,2);
            push[AInstr](out,ai_mov_imm(A_X0(),A_DATA_VBASE()+(off as i64)));
            push[AInstr](out,ai_store(A_X29(),base+0,A_X0()));
            push[AInstr](out,ai_mov_imm(A_X0(),em.data.len as i64));
            push[AInstr](out,ai_store(A_X29(),base+8,A_X0()));
            ac_emit_lea(out,A_X0(),base);
            push[AInstr](out,ai_push(A_X0()));
        }
        .slit_ => |sl| {
            let lit_sname: []u8 = cg_slit_sname(sl);
            // union literal: Node{ .tag = payload } → {tag@0, payload@8}
            if (ac_is_union(cg, lit_sname) == 1) {
                let uw: i32 = ac_type_words(cg, lit_sname);
                let ubase: i32 = ac_slot_scratch(cg, uw);
                if (len[FieldInit](sl.fields) != 1) {
                    ac_err(cg, "arm64: union literal needs exactly one member");
                } else {
                    let ufi: FieldInit = get[FieldInit](sl.fields, 0);
                    let tagv: i32 = ac_union_tag(cg, lit_sname, ufi.name);
                    if (tagv < 0) { ac_err(cg, _zag_str_concat("arm64: unknown union member: ", ufi.name)); tagv = 0; }
                    push[AInstr](out, ai_mov_imm(A_X0(), tagv as i64));
                    push[AInstr](out, ai_store(A_X29(), ubase + 0, A_X0()));
                    let pty: []u8 = ac_union_payload_type(cg, lit_sname, ufi.name);
                    ac_lower_expr(out, ufi.val, env, syms, cg);
                    if (ac_is_aggregate(cg, pty) == 1) {
                        push[AInstr](out, ai_pop(A_X11()));
                        ac_emit_lea(out, A_X10(), ubase + 8);
                        ac_emit_copy(out, ac_type_words(cg, pty));
                    } else {
                        push[AInstr](out, ai_pop(A_X0()));
                        push[AInstr](out, ai_store(A_X29(), ubase + 8, A_X0()));
                    }
                }
                ac_emit_lea(out, A_X0(), ubase);
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            // struct literal → fill a scratch block, push its address
            let w: i32 = ac_type_words(cg, lit_sname);
            let base: i32 = ac_slot_scratch(cg, w);
            let i: i32 = 0;
            while (i < len[FieldInit](sl.fields)) {
                let fi: FieldInit = get[FieldInit](sl.fields, i);
                let off: i32 = ac_field_offset(cg, lit_sname, fi.name);
                if (off < 0) {
                    ac_err(cg, _zag_str_concat("arm64: unknown struct field: ", fi.name));
                } else {
                    let fty: []u8 = ac_field_type(cg, lit_sname, fi.name);
                    if (ac_is_optional(cg_norm_type(fty)) == 1 && ac_is_null_node(fi.val) == 1) {
                        // ?T field = null → {has=0}
                        push[AInstr](out, ai_mov_imm(A_X0(), 0));
                        push[AInstr](out, ai_store(A_X29(), base + off, A_X0()));
                    } else if (ac_is_optional(cg_norm_type(fty)) == 1 &&
                               ac_is_optional(ac_expr_type(fi.val, env, syms, cg)) == 0) {
                        // ?T field = value → wrap {has=1, val} (payload scalar or aggregate)
                        push[AInstr](out, ai_mov_imm(A_X0(), 1));
                        push[AInstr](out, ai_store(A_X29(), base + off, A_X0()));
                        let pty3: []u8 = cg_norm_type(fty)[1..];
                        ac_lower_expr(out, fi.val, env, syms, cg);
                        if (ac_is_aggregate(cg, pty3) == 1) {
                            push[AInstr](out, ai_pop(A_X11()));
                            ac_emit_lea(out, A_X10(), base + off + 8);
                            ac_emit_copy(out, ac_type_words(cg, pty3));
                        } else {
                            push[AInstr](out, ai_pop(A_X0()));
                            push[AInstr](out, ai_store(A_X29(), base + off + 8, A_X0()));
                        }
                    } else {
                        ac_lower_expr(out, fi.val, env, syms, cg);
                        if (ac_is_aggregate(cg, fty) == 1) {
                            push[AInstr](out, ai_pop(A_X11()));
                            ac_emit_lea(out, A_X10(), base + off);
                            ac_emit_copy(out, ac_type_words(cg, fty));
                        } else {
                            push[AInstr](out, ai_pop(A_X0()));
                            push[AInstr](out, ai_store(A_X29(), base + off, A_X0()));
                        }
                    }
                }
                i = i + 1;
            }
            ac_emit_lea(out, A_X0(), base);
            push[AInstr](out, ai_push(A_X0()));
        }
        .fld => |f| {
            // enum member constant / error.X code (index+1 in __zag_errors)
            switch (f.base.*) {
                .id => |bid| {
                    if (@strEq(bid.name, "error")) {
                        let ecv: i32 = ac_enum_member(cg, "__zag_errors", f.fname);
                        if (ecv < 0) { ac_err(cg, _zag_str_concat("arm64: unknown error: ", f.fname)); ecv = 0 - 1; }
                        push[AInstr](out, ai_mov_imm(A_X0(), (ecv + 1) as i64));
                        push[AInstr](out, ai_push(A_X0()));
                        return;
                    }
                    if (ac_slot_find(env, bid.name) == 0 && ac_is_enum(cg, bid.name) == 1) {
                        let mv: i32 = ac_enum_member(cg, bid.name, f.fname);
                        if (mv < 0) { ac_err(cg, _zag_str_concat("arm64: unknown enum member: ", f.fname)); mv = 0; }
                        push[AInstr](out, ai_mov_imm(A_X0(), mv as i64));
                        push[AInstr](out, ai_push(A_X0()));
                        return;
                    }
                }
                else => { }
            }
            let bt: []u8 = ac_expr_type(f.base, env, syms, cg);
            if (@strEq(f.fname, "*")) {
                let elem: []u8 = "";
                if (bt.len > 1 && bt[0] == '*') { elem = bt[1..]; }
                ac_lower_expr(out, f.base, env, syms, cg);   // pointer value
                if (ac_is_aggregate(cg, elem) == 1) { return; }  // address IS the value
                push[AInstr](out, ai_pop(A_X10()));
                push[AInstr](out, ai_load(A_X0(), A_X10(), 0));
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            if (ac_type_is_slice(bt) == 1 && @strEq(f.fname, "len")) {
                ac_lower_expr(out, f.base, env, syms, cg);
                push[AInstr](out, ai_pop(A_X10()));
                push[AInstr](out, ai_load(A_X0(), A_X10(), 8));
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            if (ac_is_optional(bt) == 1) {
                if (@strEq(f.fname, "has")) {
                    ac_lower_expr(out, f.base, env, syms, cg);
                    push[AInstr](out, ai_pop(A_X10()));
                    push[AInstr](out, ai_load(A_X0(), A_X10(), 0));
                    push[AInstr](out, ai_push(A_X0()));
                    return;
                }
                if (@strEq(f.fname, "val") || @strEq(f.fname, "?")) {
                    let pty2: []u8 = bt[1..];
                    ac_lower_expr(out, f.base, env, syms, cg);
                    push[AInstr](out, ai_pop(A_X10()));
                    if (ac_is_aggregate(cg, pty2) == 1) {
                        push[AInstr](out, ai_add_imm(A_X10(), 8));
                        push[AInstr](out, ai_push(A_X10()));
                    } else {
                        push[AInstr](out, ai_load(A_X0(), A_X10(), 8));
                        push[AInstr](out, ai_push(A_X0()));
                    }
                    return;
                }
            }
            let sname: []u8 = bt;
            if (bt.len > 1 && bt[0] == '*') { sname = bt[1..]; }
            let off: i32 = ac_field_offset(cg, sname, f.fname);
            if (off < 0) {
                ac_err(cg, _zag_str_concat("arm64: unknown field: ", f.fname));
                push[AInstr](out, ai_mov_imm(A_X0(), 0));
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            let fty: []u8 = ac_field_type(cg, sname, f.fname);
            ac_lower_expr(out, f.base, env, syms, cg);
            push[AInstr](out, ai_pop(A_X10()));
            if (ac_is_aggregate(cg, fty) == 1) {
                if (off > 0) { push[AInstr](out, ai_add_imm(A_X10(), off as i64)); }
                push[AInstr](out, ai_push(A_X10()));
            } else {
                push[AInstr](out, ai_load(A_X0(), A_X10(), off));
                push[AInstr](out, ai_push(A_X0()));
            }
        }
        .idx => |ix| {
            let bt: []u8 = ac_expr_type(ix.base, env, syms, cg);
            let elem: []u8 = "";
            if (ac_type_is_slice(bt) == 1) { elem = ac_slice_elem(bt); }
            else if (bt.len > 1 && bt[0] == '*') { elem = bt[1..]; }
            ac_lower_addr(out, n, env, syms, cg);
            push[AInstr](out, ai_pop(A_X10()));
            if (ac_is_aggregate(cg, elem) == 1) {
                push[AInstr](out, ai_push(A_X10()));
            } else if (ac_elem_is_byte(elem) == 1) {
                push[AInstr](out, ai_loadb(A_X0(), A_X10(), 0));
                push[AInstr](out, ai_push(A_X0()));
            } else {
                push[AInstr](out, ai_load(A_X0(), A_X10(), 0));
                push[AInstr](out, ai_push(A_X0()));
            }
        }
        .slice_ => |sc| {
            let bt: []u8 = ac_expr_type(sc.base, env, syms, cg);
            let is_ptr_base: i32 = 0;
            let elem: []u8 = "";
            if (ac_type_is_slice(bt) == 1) { elem = ac_slice_elem(bt); }
            else if (bt.len > 1 && bt[0] == '*') { elem = bt[1..]; is_ptr_base = 1; }
            else {
                ac_err(cg, "arm64: slicing a non-slice value");
                push[AInstr](out, ai_mov_imm(A_X0(), 0));
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            if (is_ptr_base == 1 && sc.has_hi == 0) {
                ac_err(cg, "arm64: p[lo..] on a raw pointer needs an upper bound");
                push[AInstr](out, ai_mov_imm(A_X0(), 0));
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            let stride: i32 = ac_elem_stride(cg, elem);
            ac_lower_expr(out, sc.base, env, syms, cg);
            ac_lower_expr(out, sc.lo, env, syms, cg);
            if (sc.has_hi == 1) { ac_lower_expr(out, sc.hi, env, syms, cg); }
            if (sc.has_hi == 1) { push[AInstr](out, ai_pop(A_X13())); }
            push[AInstr](out, ai_pop(A_X12()));
            push[AInstr](out, ai_pop(A_X10()));
            if (is_ptr_base == 1) {
                push[AInstr](out, ai_mov_rr(A_X0(), A_X10()));  // ptr value IS the data ptr
            } else {
                push[AInstr](out, ai_load(A_X0(), A_X10(), 0));    // data ptr
                push[AInstr](out, ai_load(A_X1(), A_X10(), 8));    // len
                if (sc.has_hi == 0) { push[AInstr](out, ai_mov_rr(A_X13(), A_X1())); }
            }
            // new ptr = ptr + lo*stride ; new len = hi - lo
            push[AInstr](out, ai_mov_imm(A_X9(), stride as i64));
            push[AInstr](out, ai_mul(A_X11(), A_X12(), A_X9()));
            push[AInstr](out, ai_add(A_X0(), A_X11()));
            push[AInstr](out, ai_sub(A_X13(), A_X12()));
            let base: i32 = ac_slot_scratch(cg, 2);
            push[AInstr](out, ai_store(A_X29(), base + 0, A_X0()));
            push[AInstr](out, ai_store(A_X29(), base + 8, A_X13()));
            ac_emit_lea(out, A_X0(), base);
            push[AInstr](out, ai_push(A_X0()));
        }
        .cast_ => |cst| {
            let csrc: []u8 = ac_expr_type(cst.expr, env, syms, cg);
            let sfl: i32 = ac_is_float(csrc);
            let tfl: i32 = ac_is_float(cg_norm_type(cst.target));
            if (sfl != tfl) {
                ac_lower_expr(out, cst.expr, env, syms, cg);
                push[AInstr](out, ai_pop(A_X0()));
                if (tfl == 1) {
                    push[AInstr](out, ai_scvtf(0, A_X0()));
                    push[AInstr](out, ai_fmov_xd(A_X0(), 0));
                } else {
                    push[AInstr](out, ai_fmov_dx(0, A_X0()));
                    push[AInstr](out, ai_fcvtzs(A_X0(), 0));
                    if (@strEq(cst.target, "i32")) { push[AInstr](out, ai_sxtw(A_X0(), A_X0())); }
                }
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            ac_lower_expr(out, cst.expr, env, syms, cg);
            if (sfl == 1 && tfl == 1) { return; }   // f32↔f64: both held as f64 bits
            if (@strEq(cst.target, "u8") || @strEq(cst.target, "i8")) {
                push[AInstr](out, ai_pop(A_X0()));
                push[AInstr](out, ai_and_imm(A_X0(), 255));
                push[AInstr](out, ai_push(A_X0()));
            } else if (@strEq(cst.target, "i32")) {
                push[AInstr](out, ai_pop(A_X0()));
                push[AInstr](out, ai_sxtw(A_X0(), A_X0()));
                push[AInstr](out, ai_push(A_X0()));
            } else if (@strEq(cst.target, "i64") || @strEq(cst.target, "u64") || @strEq(cst.target, "usize")) {
                // i32 → i64 reads the LOW DWORD sign-extended (i32 wraps at 32
                // bits under our 64-bit arithmetic — same contract as x86).
                let sty2: []u8 = ac_expr_type(cst.expr, env, syms, cg);
                if (@strEq(sty2, "i32") || @strEq(sty2, "u32")) {
                    push[AInstr](out, ai_pop(A_X0()));
                    push[AInstr](out, ai_sxtw(A_X0(), A_X0()));
                    push[AInstr](out, ai_push(A_X0()));
                }
            }
            // other pointers/scalars: value already 64-bit — no-op
        }
        .switch_ => |sw| {
            ac_lower_switch_expr(out, sw, env, syms, cg);
        }
        else => {
            ac_err(cg, _zag_str_concat("arm64: unsupported expression (node code ",
                _zag_str_concat(_zag_i64_to_str(node_code(n) as i64), ")")));
            push[AInstr](out, ai_mov_imm(A_X0(), 0));
            push[AInstr](out, ai_push(A_X0()));
        }
    }
}

fn ac_cmp_cc(op: []u8) i32 {
    if (@strEq(op, "==")) { return 0; }
    if (@strEq(op, "!=")) { return 1; }
    if (@strEq(op, "<"))  { return 2; }
    if (@strEq(op, "<=")) { return 3; }
    if (@strEq(op, ">"))  { return 4; }
    if (@strEq(op, ">=")) { return 5; }
    return 0 - 1;
}

// branch to `lbl` when the comparison `op` is FALSE (flags already set)
fn ac_push_jcc_false(out: *ArrayList[AInstr], op: []u8, lbl: i32) void {
    if (@strEq(op, "=="))      { push[AInstr](out, ai_jne(lbl)); }
    else if (@strEq(op, "!=")) { push[AInstr](out, ai_je(lbl)); }
    else if (@strEq(op, "<"))  { push[AInstr](out, ai_jge(lbl)); }
    else if (@strEq(op, "<=")) { push[AInstr](out, ai_jg(lbl)); }
    else if (@strEq(op, ">"))  { push[AInstr](out, ai_jle(lbl)); }
    else                       { push[AInstr](out, ai_jl(lbl)); }
}

// ── calls ────────────────────────────────────────────────────────────────────

// Coerce a concrete lvalue to interface `iname`: build the (M+1)-word fat
// block [fn0..fnM-1, data_ptr] in the frame; returns its displacement.
fn ac_iface_coerce(out: *ArrayList[AInstr], arg: *Node, concrete_ty: []u8, iname: []u8, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) i32 {
    let M: i32 = iface_method_count(cg.*.decls, iname);
    let fat: i32 = ac_slot_scratch(cg, M + 1);
    let mi: i32 = 0;
    while (mi < M) {
        let meth: []u8 = iface_method_name(cg.*.decls, iname, mi);
        let fn_name: []u8 = _zag_str_concat(_zag_str_concat(concrete_ty, "_"), meth);
        let fn_lbl: i32 = ac_find_fn(syms, fn_name);
        if (fn_lbl < 0) {
            ac_err(cg, _zag_str_concat("arm64: interface impl method not found: ", fn_name));
            push[AInstr](out, ai_mov_imm(A_X0(), 0));
        } else {
            push[AInstr](out, ai_lea_lbl(A_X0(), fn_lbl));
        }
        push[AInstr](out, ai_store(A_X29(), fat + mi * 8, A_X0()));
        mi = mi + 1;
    }
    ac_lower_addr(out, arg, env, syms, cg);
    push[AInstr](out, ai_pop(A_X0()));
    push[AInstr](out, ai_store(A_X29(), fat + M * 8, A_X0()));
    return fat;
}

// Interface method dispatch: recv is interface-typed; fat block holds the
// vtable. Calls fn[midx] with x0 = data ptr, x1.. = extra args.
fn ac_lower_iface_dispatch(out: *ArrayList[AInstr], recv: *Node, mname: []u8, extra_args: ArrayList[*Node], env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) void {
    let iname: []u8 = ac_expr_type(recv, env, syms, cg);
    if (iname.len > 1 && iname[0] == '*') { iname = iname[1..]; }
    let M: i32 = iface_method_count(cg.*.decls, iname);
    let midx: i32 = 0 - 1;
    let mi: i32 = 0;
    while (mi < M) {
        if (@strEq(iface_method_name(cg.*.decls, iname, mi), mname)) { midx = mi; }
        mi = mi + 1;
    }
    if (midx < 0) {
        ac_err(cg, _zag_str_concat("arm64: interface method not found: ", mname));
        push[AInstr](out, ai_mov_imm(A_X0(), 0));
        push[AInstr](out, ai_push(A_X0()));
        return;
    }
    ac_lower_expr(out, recv, env, syms, cg);          // fat block address
    push[AInstr](out, ai_pop(A_X10()));
    let fn_slot: i32 = ac_slot_scratch(cg, 1);
    let data_slot: i32 = ac_slot_scratch(cg, 1);
    push[AInstr](out, ai_load(A_X0(), A_X10(), midx * 8));
    push[AInstr](out, ai_store(A_X29(), fn_slot, A_X0()));
    push[AInstr](out, ai_load(A_X0(), A_X10(), M * 8));
    push[AInstr](out, ai_store(A_X29(), data_slot, A_X0()));
    let nex: i32 = len[*Node](extra_args);
    if (nex > 7) {
        ac_err(cg, "arm64: more than 7 args to an interface method");
        push[AInstr](out, ai_mov_imm(A_X0(), 0));
        push[AInstr](out, ai_push(A_X0()));
        return;
    }
    let arg_slots: ArrayList[i32] = make[i32](nex + 1);
    let ei: i32 = 0;
    while (ei < nex) {
        let asl: i32 = ac_slot_scratch(cg, 1);
        push[i32](&arg_slots, asl);
        ac_lower_expr(out, get[*Node](extra_args, ei), env, syms, cg);
        push[AInstr](out, ai_pop(A_X0()));
        push[AInstr](out, ai_store(A_X29(), asl, A_X0()));
        ei = ei + 1;
    }
    push[AInstr](out, ai_load(A_X0(), A_X29(), data_slot));
    let ei2: i32 = 0;
    while (ei2 < nex) {
        push[AInstr](out, ai_load(a_arg_reg(ei2 + 1), A_X29(), get[i32](arg_slots, ei2)));
        ei2 = ei2 + 1;
    }
    push[AInstr](out, ai_load(A_X10(), A_X29(), fn_slot));
    push[AInstr](out, ai_call_reg(A_X10()));
    push[AInstr](out, ai_push(A_X0()));
}

// Call through a fat_fn variable: runtime env check picks the ABI —
// env==0: x0=arg0, x1=arg1, ... ; env!=0: x0=env, x1=arg0, ...
fn ac_lower_indirect_call(out: *ArrayList[AInstr], fname: []u8, c: Call, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) void {
    let nargs: i32 = len[*Node](c.args);
    if (nargs > 7) {
        ac_err(cg, "arm64: more than 7 arguments to a fn-value call");
        push[AInstr](out, ai_mov_imm(A_X0(), 0));
        push[AInstr](out, ai_push(A_X0()));
        return;
    }
    let fdisp: i32 = ac_slot_find(env, fname);
    let is_byref: i32 = ac_slot_byref(env, fname);
    let code_slot: i32 = ac_slot_scratch(cg, 1);
    let env_slot: i32 = ac_slot_scratch(cg, 1);
    if (is_byref == 1) {
        push[AInstr](out, ai_load(A_X10(), A_X29(), fdisp));
        push[AInstr](out, ai_load(A_X0(), A_X10(), 0));
        push[AInstr](out, ai_load(A_X9(), A_X10(), 8));
    } else {
        push[AInstr](out, ai_load(A_X0(), A_X29(), fdisp));
        push[AInstr](out, ai_load(A_X9(), A_X29(), fdisp + 8));
    }
    push[AInstr](out, ai_store(A_X29(), code_slot, A_X0()));
    push[AInstr](out, ai_store(A_X29(), env_slot, A_X9()));
    // spill user args into scratch slots (aggregates: caller copy, pass addr)
    let aslot: ArrayList[i32] = make[i32](nargs + 1);
    let ui: i32 = 0;
    while (ui < nargs) {
        let a: *Node = get[*Node](c.args, ui);
        let aty: []u8 = ac_expr_type(a, env, syms, cg);
        let sl: i32 = ac_slot_scratch(cg, 1);
        push[i32](&aslot, sl);
        ac_lower_expr(out, a, env, syms, cg);
        if (ac_is_aggregate(cg, aty) == 1) {
            let w: i32 = ac_type_words(cg, aty);
            let cpy: i32 = ac_slot_scratch(cg, w);
            push[AInstr](out, ai_pop(A_X11()));
            ac_emit_lea(out, A_X10(), cpy);
            ac_emit_copy(out, w);
            ac_emit_lea(out, A_X0(), cpy);
        } else {
            push[AInstr](out, ai_pop(A_X0()));
        }
        push[AInstr](out, ai_store(A_X29(), sl, A_X0()));
        ui = ui + 1;
    }
    let l_env: i32 = ac_fresh(cg);
    let l_done: i32 = ac_fresh(cg);
    push[AInstr](out, ai_load(A_X9(), A_X29(), env_slot));
    push[AInstr](out, ai_cmp_imm(A_X9(), 0));
    push[AInstr](out, ai_jne(l_env));
    // standard ABI
    let si: i32 = 0;
    while (si < nargs) {
        push[AInstr](out, ai_load(a_arg_reg(si), A_X29(), get[i32](aslot, si)));
        si = si + 1;
    }
    push[AInstr](out, ai_load(A_X10(), A_X29(), code_slot));
    push[AInstr](out, ai_call_reg(A_X10()));
    push[AInstr](out, ai_jmp(l_done));
    // env-first ABI
    push[AInstr](out, ai_label(l_env));
    let ai2: i32 = 0;
    while (ai2 < nargs) {
        push[AInstr](out, ai_load(a_arg_reg(ai2 + 1), A_X29(), get[i32](aslot, ai2)));
        ai2 = ai2 + 1;
    }
    push[AInstr](out, ai_load(A_X0(), A_X29(), env_slot));
    push[AInstr](out, ai_load(A_X10(), A_X29(), code_slot));
    push[AInstr](out, ai_call_reg(A_X10()));
    push[AInstr](out, ai_label(l_done));
    push[AInstr](out, ai_push(A_X0()));
}

fn ac_lower_call(out: *ArrayList[AInstr], c: Call, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) void {
    switch (c.callee.*) {
        .fld => |mf| {
            // method call: recv.m(args) → iface dispatch or RecvType_m(recv, args)
            if (@strEq(mf.fname, "*") || @strEq(mf.fname, "?") || @strEq(mf.fname, "has") || @strEq(mf.fname, "val")) {
                ac_err(cg, "arm64: unsupported call form");
                push[AInstr](out, ai_mov_imm(A_X0(), 0));
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            let rty: []u8 = ac_expr_type(mf.base, env, syms, cg);
            if (rty.len > 1 && rty[0] == '*') { rty = rty[1..]; }
            if (iface_method_count(cg.*.decls, rty) > 0) {
                ac_lower_iface_dispatch(out, mf.base, mf.fname, c.args, env, syms, cg);
                return;
            }
            let mn: []u8 = _zag_str_concat(_zag_str_concat(rty, "_"), mf.fname);
            if (rty.len > 0 && ac_find_fn(syms, mn) >= 0) {
                let margs: ArrayList[*Node] = make[*Node](len[*Node](c.args) + 1);
                push[*Node](&margs, mf.base);
                let mk: i32 = 0;
                while (mk < len[*Node](c.args)) {
                    push[*Node](&margs, get[*Node](c.args, mk));
                    mk = mk + 1;
                }
                ac_lower_call(out, Call{ .callee = mk_ident(mn), .args = margs, .targs = make[[]u8](1) }, env, syms, cg);
                return;
            }
            ac_err(cg, _zag_str_concat("arm64: unknown method: ", mf.fname));
            push[AInstr](out, ai_mov_imm(A_X0(), 0));
            push[AInstr](out, ai_push(A_X0()));
            return;
        }
        .id => |fnid| {
            if (fnid.name.len > 0 && fnid.name[0] == '@') {
                ac_lower_at_builtin(out, fnid.name, c, env, syms, cg);
                return;
            }
            let cname: []u8 = fnid.name;
            if (len[[]u8](c.targs) > 0) { cname = cg_mangle_generic_norm(fnid.name, c.targs); }
            if (ac_lower_builtin(out, cname, c, env, syms, cg) == 1) { return; }
            if (ac_slot_find(env, cname) != 0 && @strEq(ac_slot_type(env, cname), "fat_fn")) {
                ac_lower_indirect_call(out, cname, c, env, syms, cg);
                return;
            }
            let lbl: i32 = ac_find_fn(syms, cname);
            if (lbl < 0) {
                ac_err(cg, _zag_str_concat("arm64: unknown function: ", cname));
                push[AInstr](out, ai_mov_imm(A_X0(), 0));
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            let nargs: i32 = len[*Node](c.args);
            let ai: i32 = 0;
            while (ai < nargs) {
                let a: *Node = get[*Node](c.args, ai);
                let aty: []u8 = ac_expr_type(a, env, syms, cg);
                let pt: []u8 = ac_fn_param_type(cg, cname, ai);
                if (ac_is_optional(cg_norm_type(pt)) == 1 &&
                    (ac_is_null_node(a) == 1 || ac_is_optional(aty) == 0)) {
                    // scalar/null → ?T param: build a wrapped {has, val} block
                    let ow: i32 = ac_type_words(cg, pt);
                    let ob: i32 = ac_slot_scratch(cg, ow);
                    if (ac_is_null_node(a) == 1) {
                        push[AInstr](out, ai_mov_imm(A_X0(), 0));
                        push[AInstr](out, ai_store(A_X29(), ob, A_X0()));
                    } else {
                        push[AInstr](out, ai_mov_imm(A_X0(), 1));
                        push[AInstr](out, ai_store(A_X29(), ob, A_X0()));
                        let opty: []u8 = cg_norm_type(pt)[1..];
                        ac_lower_expr(out, a, env, syms, cg);
                        if (ac_is_aggregate(cg, opty) == 1) {
                            push[AInstr](out, ai_pop(A_X11()));
                            ac_emit_lea(out, A_X10(), ob + 8);
                            ac_emit_copy(out, ac_type_words(cg, opty));
                        } else {
                            push[AInstr](out, ai_pop(A_X0()));
                            push[AInstr](out, ai_store(A_X29(), ob + 8, A_X0()));
                        }
                    }
                    ac_emit_lea(out, A_X0(), ob);
                    push[AInstr](out, ai_push(A_X0()));
                } else if (iface_method_count(cg.*.decls, pt) > 0 && iface_method_count(cg.*.decls, aty) == 0) {
                    // concrete value → interface param: build fat vtable block
                    let fat: i32 = ac_iface_coerce(out, a, aty, pt, env, syms, cg);
                    ac_emit_lea(out, A_X0(), fat);
                    push[AInstr](out, ai_push(A_X0()));
                } else {
                    ac_lower_expr(out, a, env, syms, cg);
                    if (ac_is_aggregate(cg, aty) == 1) {
                        // by-value semantics: copy to a fresh block, pass its address
                        let w: i32 = ac_type_words(cg, aty);
                        let base: i32 = ac_slot_scratch(cg, w);
                        push[AInstr](out, ai_pop(A_X11()));
                        ac_emit_lea(out, A_X10(), base);
                        ac_emit_copy(out, w);
                        ac_emit_lea(out, A_X0(), base);
                        push[AInstr](out, ai_push(A_X0()));
                    }
                }
                ai = ai + 1;
            }
            // args 9+ go on the CPU stack: the callee reads arg k (k>=8) at
            // [x29 + 32 + 8*(k-8)] (entry SP = its x29 + 32-byte save area).
            let nstk: i32 = 0;
            if (nargs > 8) { nstk = nargs - 8; }
            let stkbytes: i32 = ac_align16(8 * nstk);
            let aj: i32 = nargs - 1;
            if (nstk > 0) {
                push[AInstr](out, ai_sub_imm(A_SP(), stkbytes as i64));
                while (aj >= 8) {
                    push[AInstr](out, ai_pop(A_X9()));
                    push[AInstr](out, ai_store(A_SP(), 8 * (aj - 8), A_X9()));
                    aj = aj - 1;
                }
            }
            while (aj >= 0) {
                push[AInstr](out, ai_pop(a_arg_reg(aj)));
                aj = aj - 1;
            }
            let rty: []u8 = ac_find_fn_ret(syms, cname);
            if (ac_is_aggregate(cg, rty) == 1) {
                let rw: i32 = ac_type_words(cg, rty);
                let rbase: i32 = ac_slot_scratch(cg, rw);
                ac_emit_lea(out, A_X8(), rbase);
            }
            push[AInstr](out, ai_call(lbl));
            if (nstk > 0) { push[AInstr](out, ai_add_imm(A_SP(), stkbytes as i64)); }
            push[AInstr](out, ai_push(A_X0()));
        }
        else => {
            ac_err(cg, "arm64: unsupported call form");
            push[AInstr](out, ai_mov_imm(A_X0(), 0));
            push[AInstr](out, ai_push(A_X0()));
        }
    }
}

// no-newline family (x86 contract: print_int / _zag_print_i32 emit bare digits)
fn ac_is_print_int(name: []u8) i32 {
    if (@strEq(name, "print_int")) { return 1; }
    if (@strEq(name, "_zag_print_i32")) { return 1; }
    return 0;
}

// newline family (x86 contract: matches the C backend's printf("%d\n"))
fn ac_is_print_int_nl(name: []u8) i32 {
    if (@strEq(name, "print_i32") || @strEq(name, "print_u32")) { return 1; }
    if (@strEq(name, "print_i64") || @strEq(name, "print_u64")) { return 1; }
    if (@strEq(name, "_zag_print_i64") || @strEq(name, "_zag_print_u64")) { return 1; }
    return 0;
}

fn ac_is_print_str(name: []u8) i32 {
    if (@strEq(name, "print_str")) { return 1; }
    if (@strEq(name, "_zag_print")) { return 1; }
    return 0;
}

// Returns 1 if `fname` was handled as a builtin (result pushed).
fn ac_lower_builtin(out: *ArrayList[AInstr], fname: []u8, c: Call, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) i32 {
    let nargs: i32 = len[*Node](c.args);
    // Match x86: Script `println` accepts integer expressions without forcing
    // manual formatting before a script can grow into explicit native Zag.
    if (@strEq(fname, "_zag_println") && nargs == 1) {
        let script_arg: *Node = get[*Node](c.args, 0);
        let script_ty: []u8 = ac_expr_type(script_arg, env, syms, cg);
        if (ac_type_is_slice(script_ty) == 0) {
            ac_lower_expr(out, script_arg, env, syms, cg);
            push[AInstr](out, ai_pop(A_X0()));
            cg.*.use_pi = 1;
            push[AInstr](out, ai_call(cg.*.pi_lbl));
            let nl: i32 = ac_intern_nl(cg);
            push[AInstr](out, ai_mov_imm(A_X1(), A_DATA_VBASE() + (nl as i64)));
            push[AInstr](out, ai_mov_imm(A_X2(), 1));
            cg.*.use_ps = 1;
            push[AInstr](out, ai_call(cg.*.ps_lbl));
            push[AInstr](out, ai_mov_imm(A_X0(), 0));
            push[AInstr](out, ai_push(A_X0()));
            return 1;
        }
    }
    if (ac_is_print_int(fname) == 1 || ac_is_print_int_nl(fname) == 1) {
        if (nargs != 1) { ac_err(cg, "arm64: print_int expects one argument"); return 1; }
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg);
        push[AInstr](out, ai_pop(A_X0()));
        if (@strEq(fname, "print_i32") || @strEq(fname, "print_u32")) {
            push[AInstr](out, ai_sxtw(A_X0(), A_X0()));
        }
        cg.*.use_pi = 1;
        push[AInstr](out, ai_call(cg.*.pi_lbl));
        if (ac_is_print_int_nl(fname) == 1) {
            let nl: i32 = ac_intern_nl(cg);
            push[AInstr](out, ai_mov_imm(A_X1(), A_DATA_VBASE() + (nl as i64)));
            push[AInstr](out, ai_mov_imm(A_X2(), 1));
            cg.*.use_ps = 1;
            push[AInstr](out, ai_call(cg.*.ps_lbl));
        }
        push[AInstr](out, ai_mov_imm(A_X0(), 0));
        push[AInstr](out, ai_push(A_X0()));
        return 1;
    }
    if (ac_is_print_str(fname) == 1 || @strEq(fname, "_zag_println")) {
        if (nargs != 1) { ac_err(cg, "arm64: print_str expects one argument"); return 1; }
        let arg: *Node = get[*Node](c.args, 0);
        let aty: []u8 = ac_expr_type(arg, env, syms, cg);
        if (ac_type_is_slice(aty) == 0) {
            ac_err(cg, "arm64: print_str argument must be a []u8 slice");
            push[AInstr](out, ai_mov_imm(A_X0(), 0));
            push[AInstr](out, ai_push(A_X0()));
            return 1;
        }
        ac_lower_expr(out, arg, env, syms, cg);
        push[AInstr](out, ai_pop(A_X10()));
        push[AInstr](out, ai_load(A_X1(), A_X10(), 0));
        push[AInstr](out, ai_load(A_X2(), A_X10(), 8));
        cg.*.use_ps = 1;
        push[AInstr](out, ai_call(cg.*.ps_lbl));
        if (@strEq(fname, "_zag_println")) {
            let nl: i32 = ac_intern_nl(cg);
            push[AInstr](out, ai_mov_imm(A_X1(), A_DATA_VBASE() + (nl as i64)));
            push[AInstr](out, ai_mov_imm(A_X2(), 1));
            push[AInstr](out, ai_call(cg.*.ps_lbl));
        }
        push[AInstr](out, ai_mov_imm(A_X0(), 0));
        push[AInstr](out, ai_push(A_X0()));
        return 1;
    }
    if (@strEq(fname, "new")) {
        if (nargs != 1) { ac_err(cg, "arm64: new expects one argument"); return 1; }
        let a: *Node = get[*Node](c.args, 0);
        let aty: []u8 = ac_expr_type(a, env, syms, cg);
        let sz: i32 = ac_round8(ac_type_size(cg, aty));
        ac_lower_expr(out, a, env, syms, cg);
        push[AInstr](out, ai_mov_imm(A_X0(), sz as i64));
        cg.*.use_al = 1;
        push[AInstr](out, ai_call(cg.*.al_lbl));
        if (ac_is_aggregate(cg, aty) == 1) {
            push[AInstr](out, ai_mov_rr(A_X10(), A_X0()));
            push[AInstr](out, ai_pop(A_X11()));
            ac_emit_copy(out, sz / 8);
            push[AInstr](out, ai_push(A_X10()));
        } else {
            push[AInstr](out, ai_mov_rr(A_X10(), A_X0()));
            push[AInstr](out, ai_pop(A_X11()));
            push[AInstr](out, ai_store(A_X10(), 0, A_X11()));
            push[AInstr](out, ai_push(A_X10()));
        }
        return 1;
    }
    if (@strEq(fname, "delete") || @strEq(fname, "_zag_free")) {
        // mmap regions are not freed incrementally (same model as x86)
        if (nargs == 1) {
            ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg);
            push[AInstr](out, ai_pop(A_X0()));
        }
        push[AInstr](out, ai_mov_imm(A_X0(), 0));
        push[AInstr](out, ai_push(A_X0()));
        return 1;
    }
    if (@strEq(fname, "_zag_malloc")) {
        if (nargs != 1) { ac_err(cg, "arm64: _zag_malloc expects one argument"); return 1; }
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg);
        push[AInstr](out, ai_pop(A_X0()));
        cg.*.use_al = 1;
        push[AInstr](out, ai_call(cg.*.al_lbl));
        push[AInstr](out, ai_push(A_X0()));
        return 1;
    }
    if (@strEq(fname, "print_f64") || @strEq(fname, "print_f32") || @strEq(fname, "_zag_print_f64")) {
        if (nargs != 1) { ac_err(cg, "arm64: print_f64 expects one argument"); return 1; }
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg);
        push[AInstr](out, ai_pop(A_X0()));
        cg.*.use_pf = 1;
        push[AInstr](out, ai_call(cg.*.pf_lbl));
        push[AInstr](out, ai_mov_imm(A_X0(), 0));
        push[AInstr](out, ai_push(A_X0()));
        return 1;
    }
    if (@strEq(fname, "__catch")) {
        let l_ok: i32 = ac_fresh(cg);
        let l_done: i32 = ac_fresh(cg);
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg);   // &{err,val}
        push[AInstr](out, ai_pop(A_X10()));
        push[AInstr](out, ai_load(A_X0(), A_X10(), 0));
        push[AInstr](out, ai_cmp_imm(A_X0(), 0));
        push[AInstr](out, ai_je(l_ok));
        ac_lower_expr(out, get[*Node](c.args, 1), env, syms, cg);   // fallback
        push[AInstr](out, ai_jmp(l_done));
        push[AInstr](out, ai_label(l_ok));
        push[AInstr](out, ai_load(A_X0(), A_X10(), 8));
        push[AInstr](out, ai_push(A_X0()));
        push[AInstr](out, ai_label(l_done));
        return 1;
    }
    if (@strEq(fname, "__catchc")) {
        let l_ok: i32 = ac_fresh(cg);
        let l_done: i32 = ac_fresh(cg);
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg);
        push[AInstr](out, ai_pop(A_X10()));
        push[AInstr](out, ai_load(A_X0(), A_X10(), 0));
        push[AInstr](out, ai_cmp_imm(A_X0(), 0));
        push[AInstr](out, ai_je(l_ok));
        // bind |err| to the code, then evaluate the fallback
        switch (get[*Node](c.args, 1).*) {
            .id => |eid| {
                let ed: i32 = ac_slot_alloc_br(env, cg, eid.name, "i32", 1, 0);
                push[AInstr](out, ai_store(A_X29(), ed, A_X0()));
            }
            else => { ac_err(cg, "arm64: catch capture must be an identifier"); }
        }
        ac_lower_expr(out, get[*Node](c.args, 2), env, syms, cg);
        push[AInstr](out, ai_jmp(l_done));
        push[AInstr](out, ai_label(l_ok));
        push[AInstr](out, ai_load(A_X0(), A_X10(), 8));
        push[AInstr](out, ai_push(A_X0()));
        push[AInstr](out, ai_label(l_done));
        return 1;
    }
    if (@strEq(fname, "_zag_strcmp")) {
        if (nargs != 2) { ac_err(cg, "arm64: _zag_strcmp expects two arguments"); return 1; }
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg);
        ac_lower_expr(out, get[*Node](c.args, 1), env, syms, cg);
        push[AInstr](out, ai_pop(A_X1()));
        push[AInstr](out, ai_pop(A_X0()));
        cg.*.use_se = 1;
        push[AInstr](out, ai_call(cg.*.se_lbl));
        push[AInstr](out, ai_push(A_X0()));
        return 1;
    }
    if (@strEq(fname, "_zag_i64_to_str")) {
        if (nargs != 1) { ac_err(cg, "arm64: _zag_i64_to_str expects one argument"); return 1; }
        let dbase: i32 = ac_slot_scratch(cg, 2);
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg);
        push[AInstr](out, ai_pop(A_X0()));
        ac_emit_lea(out, A_X1(), dbase);
        cg.*.use_is = 1;
        push[AInstr](out, ai_call(cg.*.is_lbl));
        ac_emit_lea(out, A_X0(), dbase);
        push[AInstr](out, ai_push(A_X0()));
        return 1;
    }
    if (@strEq(fname, "_zag_realloc")) {
        if (nargs != 2) { ac_err(cg, "arm64: _zag_realloc expects two arguments"); return 1; }
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg);
        ac_lower_expr(out, get[*Node](c.args, 1), env, syms, cg);
        push[AInstr](out, ai_pop(A_X1()));
        push[AInstr](out, ai_pop(A_X0()));
        cg.*.use_rl = 1;
        push[AInstr](out, ai_call(cg.*.rl_lbl));
        push[AInstr](out, ai_push(A_X0()));
        return 1;
    }
    if (@strEq(fname, "_zag_exit")) {
        if (nargs != 1) { ac_err(cg, "arm64: _zag_exit expects one argument"); return 1; }
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg);
        push[AInstr](out, ai_pop(A_X0()));
        push[AInstr](out, ai_mov_imm(A_X8(), 93));      // exit
        push[AInstr](out, ai_svc());
        push[AInstr](out, ai_push(A_X0()));             // unreachable; keep stack model
        return 1;
    }
    if (@strEq(fname, "_zag_eprintln")) {
        if (nargs != 1) { ac_err(cg, "arm64: _zag_eprintln expects one argument"); return 1; }
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg);
        push[AInstr](out, ai_pop(A_X10()));
        push[AInstr](out, ai_load(A_X1(), A_X10(), 0));
        push[AInstr](out, ai_load(A_X2(), A_X10(), 8));
        push[AInstr](out, ai_mov_imm(A_X0(), 2));       // write(2, ptr, len)
        push[AInstr](out, ai_mov_imm(A_X8(), 64));
        push[AInstr](out, ai_svc());
        let nl: i32 = ac_intern_nl(cg);
        push[AInstr](out, ai_mov_imm(A_X1(), A_DATA_VBASE() + (nl as i64)));
        push[AInstr](out, ai_mov_imm(A_X2(), 1));
        push[AInstr](out, ai_mov_imm(A_X0(), 2));
        push[AInstr](out, ai_mov_imm(A_X8(), 64));
        push[AInstr](out, ai_svc());
        push[AInstr](out, ai_mov_imm(A_X0(), 0));
        push[AInstr](out, ai_push(A_X0()));
        return 1;
    }
    if (@strEq(fname, "_zag_flush")) {
        // unbuffered write(2) everywhere — nothing to flush
        let k: i32 = 0;
        while (k < nargs) { ac_lower_expr(out, get[*Node](c.args, k), env, syms, cg); push[AInstr](out, ai_pop(A_X0())); k = k + 1; }
        push[AInstr](out, ai_mov_imm(A_X0(), 0));
        push[AInstr](out, ai_push(A_X0()));
        return 1;
    }
    if (@strEq(fname, "_zag_argc")) {
        if (nargs != 0) { ac_err(cg, "arm64: _zag_argc expects no arguments"); return 1; }
        push[AInstr](out, ai_load(A_X0(), A_X27(), 0)); // [x27] = argc
        push[AInstr](out, ai_push(A_X0()));
        return 1;
    }
    if (@strEq(fname, "_zag_arg")) {
        if (nargs != 1) { ac_err(cg, "arm64: _zag_arg expects one argument"); return 1; }
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg);
        push[AInstr](out, ai_pop(A_X0()));
        cg.*.use_ar = 1;
        push[AInstr](out, ai_call(cg.*.ar_lbl));
        push[AInstr](out, ai_push(A_X0()));
        return 1;
    }
    if (@strEq(fname, "_zag_str_concat")) {
        if (nargs != 2) { ac_err(cg, "arm64: _zag_str_concat expects two arguments"); return 1; }
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg);
        ac_lower_expr(out, get[*Node](c.args, 1), env, syms, cg);
        push[AInstr](out, ai_pop(A_X1()));
        push[AInstr](out, ai_pop(A_X0()));
        cg.*.use_cc = 1;
        push[AInstr](out, ai_call(cg.*.cc_lbl));
        push[AInstr](out, ai_push(A_X0()));
        return 1;
    }
    if (@strEq(fname, "_zag_str_to_i64")) {
        if (nargs != 1) { ac_err(cg, "arm64: _zag_str_to_i64 expects one argument"); return 1; }
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg);
        push[AInstr](out, ai_pop(A_X0()));
        cg.*.use_s2 = 1;
        push[AInstr](out, ai_call(cg.*.s2_lbl));
        push[AInstr](out, ai_push(A_X0()));
        return 1;
    }
    if (@strEq(fname, "_zag_read_file")) {
        if (nargs != 1) { ac_err(cg, "arm64: _zag_read_file expects one argument"); return 1; }
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg);
        push[AInstr](out, ai_pop(A_X0()));
        cg.*.use_rf = 1;
        push[AInstr](out, ai_call(cg.*.rf_lbl));
        push[AInstr](out, ai_push(A_X0()));
        return 1;
    }
    if (@strEq(fname, "_zag_write_file") || @strEq(fname, "_zag_write_exec")) {
        if (nargs != 2) { ac_err(cg, "arm64: _zag_write_file expects two arguments"); return 1; }
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg);
        ac_lower_expr(out, get[*Node](c.args, 1), env, syms, cg);
        push[AInstr](out, ai_pop(A_X1()));
        push[AInstr](out, ai_pop(A_X0()));
        if (@strEq(fname, "_zag_write_exec")) {
            cg.*.use_wx = 1;
            push[AInstr](out, ai_call(cg.*.wx_lbl));
        } else {
            cg.*.use_wf = 1;
            push[AInstr](out, ai_call(cg.*.wf_lbl));
        }
        push[AInstr](out, ai_push(A_X0()));
        return 1;
    }
    if (@strEq(fname, "_zag_file_exists")) {
        if (nargs != 1) { ac_err(cg, "arm64: _zag_file_exists expects one argument"); return 1; }
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg);
        push[AInstr](out, ai_pop(A_X0()));
        cg.*.use_fe = 1;
        push[AInstr](out, ai_call(cg.*.fe_lbl));
        push[AInstr](out, ai_push(A_X0()));
        return 1;
    }
    if (@strEq(fname, "_zag_exec_cmd")) {
        if (nargs != 1) { ac_err(cg, "arm64: _zag_exec_cmd expects one argument"); return 1; }
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg);
        push[AInstr](out, ai_pop(A_X0()));
        cg.*.use_ex = 1;
        push[AInstr](out, ai_call(cg.*.ex_lbl));
        push[AInstr](out, ai_push(A_X0()));
        return 1;
    }
    // ── _zag_slice_ptr(&[]u8) → x0 = data pointer ────────────────────────────
    // A []u8 value is lowered as a pointer to its {ptr,len} block; return the
    // data pointer held at offset 0 (mirrors the x86 _zag_slice_ptr).
    if (@strEq(fname, "_zag_slice_ptr")) {
        if (nargs != 1) { ac_err(cg, "arm64: _zag_slice_ptr expects one []u8 argument"); push[AInstr](out, ai_mov_imm(A_X0(), 0)); push[AInstr](out, ai_push(A_X0())); return 1; }
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg);
        push[AInstr](out, ai_pop(A_X10()));
        push[AInstr](out, ai_load(A_X0(), A_X10(), 0));
        push[AInstr](out, ai_push(A_X0()));
        return 1;
    }
    // ── _zag_raw_syscall(num, a1..a6) → x0 ───────────────────────────────────
    // AArch64 Linux convention: number in x8, args a1..a6 in x0..x5, `svc #0`,
    // result in x0. Args are evaluated left-to-right onto the CPU stack, then
    // popped in reverse so nested calls inside arguments stay balanced. (The
    // syscall NUMBERS baked into the runtime escape hatch are Linux x86-64
    // numbers; the compile path only relies on graceful degradation of the two
    // sites it reaches — getcwd and a liveness kill-probe — both of which fall
    // back safely when the arm64 syscall of that number returns an error.)
    if (@strEq(fname, "_zag_raw_syscall")) {
        if (nargs != 7) { ac_err(cg, "arm64: _zag_raw_syscall expects 7 arguments (num, a1..a6)"); push[AInstr](out, ai_mov_imm(A_X0(), 0 - 1)); push[AInstr](out, ai_push(A_X0())); return 1; }
        let sai: i32 = 0;
        while (sai < 7) {
            ac_lower_expr(out, get[*Node](c.args, sai), env, syms, cg);
            sai = sai + 1;
        }
        push[AInstr](out, ai_pop(A_X5()));   // a6
        push[AInstr](out, ai_pop(A_X4()));   // a5
        push[AInstr](out, ai_pop(A_X3()));   // a4
        push[AInstr](out, ai_pop(A_X2()));   // a3
        push[AInstr](out, ai_pop(A_X1()));   // a2
        push[AInstr](out, ai_pop(A_X0()));   // a1
        push[AInstr](out, ai_pop(A_X8()));   // syscall number
        push[AInstr](out, ai_svc());
        push[AInstr](out, ai_push(A_X0()));
        return 1;
    }
    // ── x86 CPU feature discovery intrinsics ─────────────────────────────────
    // CPUID/XGETBV do not exist on AArch64. Native x86 feature detection is
    // meaningless on a non-x86 host, so these fail closed to 0 (the generic
    // baseline). Arguments are still evaluated for stack balance and side
    // effects, then discarded.
    if (@strEq(fname, "_zag_x86_cpuid_eax") || @strEq(fname, "_zag_x86_cpuid_ebx") ||
        @strEq(fname, "_zag_x86_cpuid_ecx") || @strEq(fname, "_zag_x86_cpuid_edx") ||
        @strEq(fname, "_zag_x86_xgetbv")) {
        let xi: i32 = 0;
        while (xi < nargs) {
            ac_lower_expr(out, get[*Node](c.args, xi), env, syms, cg);
            push[AInstr](out, ai_pop(A_X0()));
            xi = xi + 1;
        }
        push[AInstr](out, ai_mov_imm(A_X0(), 0));
        push[AInstr](out, ai_push(A_X0()));
        return 1;
    }
    return 0;
}

// @-builtins (leading '@'): @sizeOf, @len/@strLen, @strEq, @intCast/@truncate.
fn ac_lower_at_builtin(out: *ArrayList[AInstr], fname: []u8, c: Call, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) void {
    let b: []u8 = fname[1..];
    let nargs: i32 = len[*Node](c.args);
    if (@strEq(b, "atomicFence")) {
        if (nargs != 1) { ac_err(cg, "arm64: @atomicFence expects one literal order"); push[AInstr](out, ai_mov_imm(A_X0(), 0)); push[AInstr](out, ai_push(A_X0())); return; }
        let order:i64=-1;
        switch (get[*Node](c.args,0).*) { .ilit=>|x|{if(@strEq(x.text,"0")){order=0;}else if(@strEq(x.text,"1")){order=1;}else if(@strEq(x.text,"2")){order=2;}else if(@strEq(x.text,"3")){order=3;}else if(@strEq(x.text,"4")){order=4;}}else=>{} }
        if (order<0) { ac_err(cg, "arm64: @atomicFence order must be a literal 0..4"); push[AInstr](out, ai_mov_imm(A_X0(), 0)); push[AInstr](out, ai_push(A_X0())); return; }
        if (order!=0) { push[AInstr](out, ai_dmb()); }
        push[AInstr](out, ai_mov_imm(A_X0(), 0)); push[AInstr](out, ai_push(A_X0())); return;
    }
    if (@strEq(b, "memoryFence")) {
        if (nargs != 0) { ac_err(cg, "arm64: @memoryFence expects no arguments"); }
        push[AInstr](out, ai_dmb());
        push[AInstr](out, ai_mov_imm(A_X0(), 0));
        push[AInstr](out, ai_push(A_X0()));
        return;
    }
    if (@strEq(b, "sizeOf")) {
        let t: []u8 = "i32";
        if (len[[]u8](c.targs) > 0) { t = get[[]u8](c.targs, 0); }
        push[AInstr](out, ai_mov_imm(A_X0(), ac_type_size(cg, t) as i64));
        push[AInstr](out, ai_push(A_X0()));
        return;
    }
    if (@strEq(b, "len") || @strEq(b, "strLen")) {
        if (nargs != 1) { ac_err(cg, "arm64: @len expects one argument"); push[AInstr](out, ai_mov_imm(A_X0(), 0)); push[AInstr](out, ai_push(A_X0())); return; }
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg);
        push[AInstr](out, ai_pop(A_X10()));
        push[AInstr](out, ai_load(A_X0(), A_X10(), 8));
        push[AInstr](out, ai_push(A_X0()));
        return;
    }
    if (@strEq(b, "strEq")) {
        if (nargs != 2) { ac_err(cg, "arm64: @strEq expects two arguments"); push[AInstr](out, ai_mov_imm(A_X0(), 0)); push[AInstr](out, ai_push(A_X0())); return; }
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg);
        ac_lower_expr(out, get[*Node](c.args, 1), env, syms, cg);
        push[AInstr](out, ai_pop(A_X1()));
        push[AInstr](out, ai_pop(A_X0()));
        cg.*.use_se = 1;
        push[AInstr](out, ai_call(cg.*.se_lbl));
        push[AInstr](out, ai_push(A_X0()));
        return;
    }
    if (@strEq(b, "intCast") || @strEq(b, "truncate") || @strEq(b, "floatCast")) {
        if (nargs != 1) { ac_err(cg, "arm64: cast builtin expects one argument"); push[AInstr](out, ai_mov_imm(A_X0(), 0)); push[AInstr](out, ai_push(A_X0())); return; }
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg);
        return;
    }
    ac_err(cg, _zag_str_concat("arm64: unsupported builtin: ", fname));
    push[AInstr](out, ai_mov_imm(A_X0(), 0));
    push[AInstr](out, ai_push(A_X0()));
}

// ── statements ───────────────────────────────────────────────────────────────

fn ac_cond_branch(out: *ArrayList[AInstr], cond: *Node, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg, lbl: i32) void {
    ac_lower_expr(out, cond, env, syms, cg);
    push[AInstr](out, ai_pop(A_X0()));
    if (ac_is_optional(ac_expr_type(cond, env, syms, cg)) == 1) {
        push[AInstr](out, ai_load(A_X0(), A_X0(), 0));   // test the has-flag
    }
    push[AInstr](out, ai_cmp_imm(A_X0(), 0));
    push[AInstr](out, ai_je(lbl));
}

// `if (opt) |cap|` / `while (opt) |cap|`: branch to `lbl` when has==0, else
// bind `cap` to the payload (scalar by value; aggregate by-ref).
fn ac_opt_cond_bind(out: *ArrayList[AInstr], cond: *Node, cap: []u8, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg, lbl: i32) void {
    let cty: []u8 = ac_expr_type(cond, env, syms, cg);
    if (ac_is_optional(cty) == 0) {
        ac_err(cg, "arm64: |capture| condition must be an optional");
        push[AInstr](out, ai_jmp(lbl));
        return;
    }
    let pty: []u8 = cty[1..];
    ac_lower_expr(out, cond, env, syms, cg);
    push[AInstr](out, ai_pop(A_X10()));
    push[AInstr](out, ai_load(A_X0(), A_X10(), 0));
    push[AInstr](out, ai_cmp_imm(A_X0(), 0));
    push[AInstr](out, ai_je(lbl));
    if (ac_is_aggregate(cg, pty) == 1) {
        let d1: i32 = ac_slot_alloc_br(env, cg, cap, pty, 1, 1);
        push[AInstr](out, ai_add_imm(A_X10(), 8));
        push[AInstr](out, ai_store(A_X29(), d1, A_X10()));
    } else {
        let d2: i32 = ac_slot_alloc_br(env, cg, cap, pty, 1, 0);
        push[AInstr](out, ai_load(A_X0(), A_X10(), 8));
        push[AInstr](out, ai_store(A_X29(), d2, A_X0()));
    }
}

fn ac_lower_stmt(out: *ArrayList[AInstr], n: *Node, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) void {
    switch (n.*) {
        .let_ => |l| {
            let ty: []u8 = "";
            if (l.has_dty == 1) { ty = l.dty; }
            else if (l.has_init == 1) { ty = ac_expr_type(l.expr, env, syms, cg); }
            if (cg_is_fn_type(cg_norm_type(ty)) == 1) { ty = "fat_fn"; }
            let w: i32 = ac_type_words(cg, ty);
            let disp: i32 = ac_slot_alloc_br(env, cg, l.name, ty, w, 0);
            if (l.has_init == 1) {
                if (ac_is_optional(ty) == 1 && ac_is_null_node(l.expr) == 1) {
                    push[AInstr](out, ai_mov_imm(A_X0(), 0));
                    push[AInstr](out, ai_store(A_X29(), disp, A_X0()));
                    return;
                }
                if (ac_is_optional(ty) == 1 && ac_is_optional(ac_expr_type(l.expr, env, syms, cg)) == 0) {
                    // wrap: ?T = value → {has=1, val}
                    let pty: []u8 = ty[1..];
                    push[AInstr](out, ai_mov_imm(A_X0(), 1));
                    push[AInstr](out, ai_store(A_X29(), disp, A_X0()));
                    ac_lower_expr(out, l.expr, env, syms, cg);
                    if (ac_is_aggregate(cg, pty) == 1) {
                        push[AInstr](out, ai_pop(A_X11()));
                        ac_emit_lea(out, A_X10(), disp + 8);
                        ac_emit_copy(out, ac_type_words(cg, pty));
                    } else {
                        push[AInstr](out, ai_pop(A_X0()));
                        push[AInstr](out, ai_store(A_X29(), disp + 8, A_X0()));
                    }
                    return;
                }
                ac_lower_expr(out, l.expr, env, syms, cg);
                if (ac_is_aggregate(cg, ty) == 1) {
                    push[AInstr](out, ai_pop(A_X11()));
                    ac_emit_lea(out, A_X10(), disp);
                    ac_emit_copy(out, w);
                } else {
                    push[AInstr](out, ai_pop(A_X0()));
                    push[AInstr](out, ai_store(A_X29(), disp, A_X0()));
                }
            }
        }
        .assign => |a| {
            // `_ = expr` discards: evaluate for side effects only
            switch (a.target.*) {
                .id => |tid| {
                    if (@strEq(tid.name, "_")) {
                        ac_lower_expr(out, a.expr, env, syms, cg);
                        push[AInstr](out, ai_pop(A_X0()));
                        return;
                    }
                }
                else => { }
            }
            let tty: []u8 = ac_expr_type(a.target, env, syms, cg);
            if (ac_is_optional(tty) == 1 && ac_is_null_node(a.expr) == 1) {
                ac_lower_addr(out, a.target, env, syms, cg);
                push[AInstr](out, ai_pop(A_X10()));
                push[AInstr](out, ai_mov_imm(A_X0(), 0));
                push[AInstr](out, ai_store(A_X10(), 0, A_X0()));
                return;
            }
            if (ac_is_optional(tty) == 1 && ac_is_optional(ac_expr_type(a.expr, env, syms, cg)) == 0) {
                let pty: []u8 = tty[1..];
                ac_lower_addr(out, a.target, env, syms, cg);
                ac_lower_expr(out, a.expr, env, syms, cg);
                if (ac_is_aggregate(cg, pty) == 1) {
                    push[AInstr](out, ai_pop(A_X11()));
                    push[AInstr](out, ai_pop(A_X10()));
                    push[AInstr](out, ai_mov_imm(A_X0(), 1));
                    push[AInstr](out, ai_store(A_X10(), 0, A_X0()));
                    push[AInstr](out, ai_add_imm(A_X10(), 8));
                    ac_emit_copy(out, ac_type_words(cg, pty));
                } else {
                    push[AInstr](out, ai_pop(A_X0()));
                    push[AInstr](out, ai_pop(A_X10()));
                    push[AInstr](out, ai_mov_imm(A_X9(), 1));
                    push[AInstr](out, ai_store(A_X10(), 0, A_X9()));
                    push[AInstr](out, ai_store(A_X10(), 8, A_X0()));
                }
                return;
            }
            let is_byte: i32 = 0;
            switch (a.target.*) {
                .idx => |_ix| { if (ac_elem_is_byte(tty) == 1) { is_byte = 1; } }
                else => { }
            }
            ac_lower_addr(out, a.target, env, syms, cg);
            ac_lower_expr(out, a.expr, env, syms, cg);
            if (ac_is_aggregate(cg, tty) == 1) {
                push[AInstr](out, ai_pop(A_X11()));
                push[AInstr](out, ai_pop(A_X10()));
                ac_emit_copy(out, ac_type_words(cg, tty));
            } else {
                push[AInstr](out, ai_pop(A_X0()));
                push[AInstr](out, ai_pop(A_X10()));
                if (is_byte == 1) { push[AInstr](out, ai_storeb(A_X10(), 0, A_X0())); }
                else { push[AInstr](out, ai_store(A_X10(), 0, A_X0())); }
            }
        }
        .ret => |r| {
            if (r.has_expr == 1) {
                if (cg.*.sret_words > 0 && cg.*.ret_ty.len > 1 && cg.*.ret_ty[0] == '!') {
                    // !T error-union return: `return error.X` → {code, 0};
                    // `return val` → {0, val}. Scalar payloads only (as on x86).
                    let is_err_ret: i32 = 0;
                    switch (r.expr.*) {
                        .fld => |ef| {
                            switch (ef.base.*) {
                                .id => |eid2| { if (@strEq(eid2.name, "error")) { is_err_ret = 1; } }
                                else => { }
                            }
                        }
                        else => { }
                    }
                    ac_lower_expr(out, r.expr, env, syms, cg);
                    push[AInstr](out, ai_pop(A_X0()));
                    push[AInstr](out, ai_load(A_X10(), A_X29(), cg.*.sret_disp));
                    push[AInstr](out, ai_mov_imm(A_X9(), 0));
                    if (is_err_ret == 1) {
                        push[AInstr](out, ai_store(A_X10(), 0, A_X0()));
                        push[AInstr](out, ai_store(A_X10(), 8, A_X9()));
                    } else {
                        push[AInstr](out, ai_store(A_X10(), 8, A_X0()));
                        push[AInstr](out, ai_store(A_X10(), 0, A_X9()));
                    }
                    push[AInstr](out, ai_mov_rr(A_X0(), A_X10()));
                    push[AInstr](out, ai_jmp(cg.*.epilogue));
                    return;
                }
                if (cg.*.sret_words > 0 && ac_is_optional(cg.*.ret_ty) == 1 && ac_is_null_node(r.expr) == 1) {
                    push[AInstr](out, ai_load(A_X10(), A_X29(), cg.*.sret_disp));
                    push[AInstr](out, ai_mov_imm(A_X9(), 0));
                    push[AInstr](out, ai_store(A_X10(), 0, A_X9()));
                    push[AInstr](out, ai_mov_rr(A_X0(), A_X10()));
                    push[AInstr](out, ai_jmp(cg.*.epilogue));
                    return;
                }
                if (cg.*.sret_words > 0 && ac_is_optional(cg.*.ret_ty) == 1 && ac_is_optional(ac_expr_type(r.expr, env, syms, cg)) == 0) {
                    // wrap: return v → {has=1, val=v}
                    let pty: []u8 = cg.*.ret_ty[1..];
                    ac_lower_expr(out, r.expr, env, syms, cg);
                    push[AInstr](out, ai_load(A_X10(), A_X29(), cg.*.sret_disp));
                    push[AInstr](out, ai_mov_imm(A_X9(), 1));
                    push[AInstr](out, ai_store(A_X10(), 0, A_X9()));
                    if (ac_is_aggregate(cg, pty) == 1) {
                        push[AInstr](out, ai_pop(A_X11()));
                        push[AInstr](out, ai_add_imm(A_X10(), 8));
                        ac_emit_copy(out, ac_type_words(cg, pty));
                        push[AInstr](out, ai_sub_imm(A_X10(), 8));
                    } else {
                        push[AInstr](out, ai_pop(A_X0()));
                        push[AInstr](out, ai_store(A_X10(), 8, A_X0()));
                    }
                    push[AInstr](out, ai_mov_rr(A_X0(), A_X10()));
                    push[AInstr](out, ai_jmp(cg.*.epilogue));
                    return;
                }
                ac_lower_expr(out, r.expr, env, syms, cg);
                if (cg.*.sret_words > 0) {
                    push[AInstr](out, ai_pop(A_X11()));
                    push[AInstr](out, ai_load(A_X10(), A_X29(), cg.*.sret_disp));
                    ac_emit_copy(out, cg.*.sret_words);
                    push[AInstr](out, ai_mov_rr(A_X0(), A_X10()));
                } else {
                    push[AInstr](out, ai_pop(A_X0()));
                }
            } else {
                push[AInstr](out, ai_mov_imm(A_X0(), 0));
            }
            push[AInstr](out, ai_jmp(cg.*.epilogue));
        }
        .if_ => |x| {
            let l_else: i32 = ac_fresh(cg);
            let l_end: i32 = ac_fresh(cg);
            if (x.has_cap == 1) {
                let m1: i32 = ac_scope_mark(env);
                ac_opt_cond_bind(out, x.cond, x.cap, env, syms, cg, l_else);
                ac_lower_block(out, x.then_body, env, syms, cg);
                ac_scope_end(env, m1);
            } else {
                ac_cond_branch(out, x.cond, env, syms, cg, l_else);
                let m2: i32 = ac_scope_mark(env);
                ac_lower_block(out, x.then_body, env, syms, cg);
                ac_scope_end(env, m2);
            }
            push[AInstr](out, ai_jmp(l_end));
            push[AInstr](out, ai_label(l_else));
            let m3: i32 = ac_scope_mark(env);
            ac_lower_block(out, x.els_body, env, syms, cg);
            ac_scope_end(env, m3);
            push[AInstr](out, ai_label(l_end));
        }
        .while_ => |w| {
            let l_top: i32 = ac_fresh(cg);
            let l_end: i32 = ac_fresh(cg);
            push[AInstr](out, ai_label(l_top));
            ac_loop_push(env,l_end,l_top);
            if (w.has_cap == 1) {
                let m4: i32 = ac_scope_mark(env);
                ac_opt_cond_bind(out, w.cond, w.cap, env, syms, cg, l_end);
                ac_lower_block(out, w.body, env, syms, cg);
                ac_scope_end(env, m4);
            } else {
                ac_cond_branch(out, w.cond, env, syms, cg, l_end);
                let m5: i32 = ac_scope_mark(env);
                ac_lower_block(out, w.body, env, syms, cg);
                ac_scope_end(env, m5);
            }
            ac_loop_pop(env);
            push[AInstr](out, ai_jmp(l_top));
            push[AInstr](out, ai_label(l_end));
        }
        .unsafe_ => |u| {
            let mu: i32 = ac_scope_mark(env);
            ac_lower_block(out, u.body, env, syms, cg);
            ac_scope_end(env, mu);
        }
        .break_ => |_b| {
            let target: i32 = ac_loop_top(env.*.break_lbls);
            if (target < 0) { ac_err(cg,"arm64: break outside loop"); }
            else { push[AInstr](out,ai_jmp(target)); }
        }
        .continue_ => |_c| {
            let target: i32 = ac_loop_top(env.*.continue_lbls);
            if (target < 0) { ac_err(cg,"arm64: continue outside loop"); }
            else { push[AInstr](out,ai_jmp(target)); }
        }
        .switch_ => |sw| {
            ac_lower_switch(out, sw, env, syms, cg);
        }
        .estmt => |e| {
            ac_lower_expr(out, e.expr, env, syms, cg);
            push[AInstr](out, ai_pop(A_X0()));
        }
        else => { ac_err(cg, "arm64: unsupported statement"); }
    }
}

// switch on a scalar (enum value / integer) or a tagged union.
// Union arm captures bind: scalar payload by VALUE, aggregate payload as a
// pointer (use `cap.*.field`) — matching the x86 backend's semantics.
fn ac_lower_switch(out: *ArrayList[AInstr], sw: Switch, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) void {
    let sty: []u8 = ac_expr_type(sw.subject, env, syms, cg);
    let is_union: i32 = ac_is_union(cg, sty);
    if (ac_is_aggregate(cg, sty) == 1 && is_union == 0) {
        ac_err(cg, "arm64: switch subject must be a scalar, enum, or union");
        return;
    }
    let l_end: i32 = ac_fresh(cg);
    let l_els: i32 = ac_fresh(cg);
    let narms: i32 = len[SwitchArm](sw.arms);
    let arm_lbls: ArrayList[i32] = make[i32](narms + 1);
    let k: i32 = 0;
    while (k < narms) { push[i32](&arm_lbls, ac_fresh(cg)); k = k + 1; }

    let subj_d: i32 = 0;
    ac_lower_expr(out, sw.subject, env, syms, cg);
    if (is_union == 1) {
        // stash the union block address; dispatch on tag word
        subj_d = ac_slot_scratch(cg, 1);
        push[AInstr](out, ai_pop(A_X10()));
        push[AInstr](out, ai_store(A_X29(), subj_d, A_X10()));
        push[AInstr](out, ai_load(A_X0(), A_X10(), 0));
    } else {
        push[AInstr](out, ai_pop(A_X0()));
    }
    let i: i32 = 0;
    while (i < narms) {
        let arm: SwitchArm = get[SwitchArm](sw.arms, i);
        let t: i32 = 0;
        while (t < len[[]u8](arm.tags)) {
            let tag: []u8 = get[[]u8](arm.tags, t);
            let v: i32 = 0 - 1;
            if (is_union == 1) { v = ac_union_tag(cg, sty, tag); }
            else if (sty.len > 0) { v = ac_enum_member(cg, sty, tag); }
            if (v < 0 && ac_is_int_text(tag) == 1) { v = ac_parse_i64(tag) as i32; }
            if (v < 0) { ac_err(cg, _zag_str_concat("arm64: unknown switch tag: ", tag)); v = 0; }
            push[AInstr](out, ai_cmp_imm(A_X0(), v as i64));
            push[AInstr](out, ai_je(get[i32](arm_lbls, i)));
            t = t + 1;
        }
        i = i + 1;
    }
    push[AInstr](out, ai_jmp(l_els));
    i = 0;
    while (i < narms) {
        let arm2: SwitchArm = get[SwitchArm](sw.arms, i);
        push[AInstr](out, ai_label(get[i32](arm_lbls, i)));
        let m: i32 = ac_scope_mark(env);
        if (arm2.has_cap == 1) {
            if (is_union == 0) {
                ac_err(cg, "arm64: switch captures need a union subject");
            } else {
                let tag0: []u8 = get[[]u8](arm2.tags, 0);
                let pty: []u8 = ac_union_payload_type(cg, sty, tag0);
                push[AInstr](out, ai_load(A_X10(), A_X29(), subj_d));
                if (ac_type_is_slice(cg_norm_type(pty)) == 1) {
                    // slice payload binds DIRECTLY (use `cap` as the slice)
                    let dc0: i32 = ac_slot_alloc_br(env, cg, arm2.cap, pty, 1, 1);
                    push[AInstr](out, ai_add_imm(A_X10(), 8));
                    push[AInstr](out, ai_store(A_X29(), dc0, A_X10()));
                } else if (ac_is_aggregate(cg, pty) == 1) {
                    let dc1: i32 = ac_slot_alloc_br(env, cg, arm2.cap, _zag_str_concat("*", pty), 1, 0);
                    push[AInstr](out, ai_add_imm(A_X10(), 8));
                    push[AInstr](out, ai_store(A_X29(), dc1, A_X10()));
                } else {
                    let dc2: i32 = ac_slot_alloc_br(env, cg, arm2.cap, pty, 1, 0);
                    push[AInstr](out, ai_load(A_X0(), A_X10(), 8));
                    push[AInstr](out, ai_store(A_X29(), dc2, A_X0()));
                }
            }
        }
        ac_lower_block(out, arm2.body, env, syms, cg);
        ac_scope_end(env, m);
        push[AInstr](out, ai_jmp(l_end));
        i = i + 1;
    }
    push[AInstr](out, ai_label(l_els));
    if (sw.has_els == 1) {
        let me: i32 = ac_scope_mark(env);
        ac_lower_block(out, sw.els_body, env, syms, cg);
        ac_scope_end(env, me);
    }
    push[AInstr](out, ai_label(l_end));
}

// A switch-expression arm's value is its last (usually only) expression.
fn ac_lower_arm_value(out: *ArrayList[AInstr], body: ArrayList[*Node], env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) void {
    if (len[*Node](body) == 0) {
        push[AInstr](out, ai_mov_imm(A_X0(), 0));
        push[AInstr](out, ai_push(A_X0()));
        return;
    }
    // A block arm may perform ordinary statements before yielding its final
    // value, and its final node may be an explicit `return` that exits the
    // containing function (an early guard inside a switch-expression arm).
    // Lower the prefix as real statements; for a trailing return, lower it as a
    // statement and leave an unreachable dummy value so the branch stack shape
    // stays well-formed. Mirrors the x86 backend's cg_lower_arm_value.
    let i: i32 = 0;
    while (i + 1 < len[*Node](body)) {
        ac_lower_stmt(out, get[*Node](body, i), env, syms, cg);
        i = i + 1;
    }
    let last: *Node = get[*Node](body, len[*Node](body) - 1);
    switch (last.*) {
        .estmt => |e| { ac_lower_expr(out, e.expr, env, syms, cg); }
        .ret => |_r| {
            ac_lower_stmt(out, last, env, syms, cg);
            push[AInstr](out, ai_mov_imm(A_X0(), 0));
            push[AInstr](out, ai_push(A_X0()));
        }
        else => { ac_lower_expr(out, last, env, syms, cg); }
    }
}

// switch EXPRESSION: like ac_lower_switch but every arm yields a value into a
// result slot, which is left pushed (same contract as cg_lower_switch_expr).
fn ac_switch_arm_type(body: ArrayList[*Node], env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) []u8 {
    if (len[*Node](body) == 0) { return ""; }
    let last: *Node = get[*Node](body, len[*Node](body) - 1);
    switch (last.*) {
        .estmt => |e| { return ac_expr_type(e.expr, env, syms, cg); }
        .ret => |r| { if (r.has_expr == 1) { return ac_expr_type(r.expr, env, syms, cg); } return ""; }
        else => { return ac_expr_type(last, env, syms, cg); }
    }
    return "";
}

fn ac_switch_expr_type(sw: Switch, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) []u8 {
    let result: []u8 = "";
    let i: i32 = 0;
    while (i < len[SwitchArm](sw.arms)) {
        let arm_ty: []u8 = ac_switch_arm_type(get[SwitchArm](sw.arms, i).body, env, syms, cg);
        if (arm_ty.len > 0) {
            if (result.len == 0) { result = arm_ty; }
            else if (!@strEq(cg_norm_type(result), cg_norm_type(arm_ty))) { return ""; }
        }
        i = i + 1;
    }
    if (sw.has_els == 1) {
        let else_ty: []u8 = ac_switch_arm_type(sw.els_body, env, syms, cg);
        if (else_ty.len > 0) {
            if (result.len == 0) { result = else_ty; }
            else if (!@strEq(cg_norm_type(result), cg_norm_type(else_ty))) { return ""; }
        }
    }
    return result;
}

fn ac_store_switch_result(out: *ArrayList[AInstr], res: i32, words: i32, aggregate: i32) void {
    if (aggregate == 0) {
        push[AInstr](out, ai_pop(A_X0()));
        push[AInstr](out, ai_store(A_X29(), res, A_X0()));
        return;
    }
    push[AInstr](out, ai_pop(A_X10()));
    let word: i32 = 0;
    while (word < words) {
        push[AInstr](out, ai_load(A_X0(), A_X10(), word * 8));
        push[AInstr](out, ai_store(A_X29(), res + word * 8, A_X0()));
        word = word + 1;
    }
}

fn ac_lower_switch_expr(out: *ArrayList[AInstr], sw: Switch, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) void {
    let sty: []u8 = ac_expr_type(sw.subject, env, syms, cg);
    let is_union: i32 = ac_is_union(cg, sty);
    if (ac_is_aggregate(cg, sty) == 1 && is_union == 0) {
        ac_err(cg, "arm64: switch subject must be a scalar, enum, or union");
        push[AInstr](out, ai_mov_imm(A_X0(), 0));
        push[AInstr](out, ai_push(A_X0()));
        return;
    }
    let result_ty: []u8 = ac_switch_expr_type(sw, env, syms, cg);
    let aggregate: i32 = ac_is_aggregate(cg, result_ty);
    let result_words: i32 = 1;
    if (aggregate == 1) { result_words = ac_type_words(cg, result_ty); }
    let res: i32 = ac_slot_scratch(cg, result_words);
    let l_end: i32 = ac_fresh(cg);
    let l_els: i32 = ac_fresh(cg);
    let narms: i32 = len[SwitchArm](sw.arms);
    let arm_lbls: ArrayList[i32] = make[i32](narms + 1);
    let k: i32 = 0;
    while (k < narms) { push[i32](&arm_lbls, ac_fresh(cg)); k = k + 1; }

    let subj_d: i32 = 0;
    ac_lower_expr(out, sw.subject, env, syms, cg);
    if (is_union == 1) {
        subj_d = ac_slot_scratch(cg, 1);
        push[AInstr](out, ai_pop(A_X10()));
        push[AInstr](out, ai_store(A_X29(), subj_d, A_X10()));
        push[AInstr](out, ai_load(A_X0(), A_X10(), 0));
    } else {
        push[AInstr](out, ai_pop(A_X0()));
    }
    let i: i32 = 0;
    while (i < narms) {
        let arm: SwitchArm = get[SwitchArm](sw.arms, i);
        let t: i32 = 0;
        while (t < len[[]u8](arm.tags)) {
            let tag: []u8 = get[[]u8](arm.tags, t);
            let v: i32 = 0 - 1;
            if (is_union == 1) { v = ac_union_tag(cg, sty, tag); }
            else if (sty.len > 0) { v = ac_enum_member(cg, sty, tag); }
            if (v < 0 && ac_is_int_text(tag) == 1) { v = ac_parse_i64(tag) as i32; }
            if (v < 0) { ac_err(cg, _zag_str_concat("arm64: unknown switch tag: ", tag)); v = 0; }
            push[AInstr](out, ai_cmp_imm(A_X0(), v as i64));
            push[AInstr](out, ai_je(get[i32](arm_lbls, i)));
            t = t + 1;
        }
        i = i + 1;
    }
    push[AInstr](out, ai_jmp(l_els));
    i = 0;
    while (i < narms) {
        let arm2: SwitchArm = get[SwitchArm](sw.arms, i);
        push[AInstr](out, ai_label(get[i32](arm_lbls, i)));
        let m: i32 = ac_scope_mark(env);
        if (arm2.has_cap == 1) {
            if (is_union == 0) {
                ac_err(cg, "arm64: switch captures need a union subject");
            } else {
                let tag0: []u8 = get[[]u8](arm2.tags, 0);
                let pty: []u8 = ac_union_payload_type(cg, sty, tag0);
                push[AInstr](out, ai_load(A_X10(), A_X29(), subj_d));
                if (ac_type_is_slice(cg_norm_type(pty)) == 1) {
                    let dc0: i32 = ac_slot_alloc_br(env, cg, arm2.cap, pty, 1, 1);
                    push[AInstr](out, ai_add_imm(A_X10(), 8));
                    push[AInstr](out, ai_store(A_X29(), dc0, A_X10()));
                } else if (ac_is_aggregate(cg, pty) == 1) {
                    let dc1: i32 = ac_slot_alloc_br(env, cg, arm2.cap, _zag_str_concat("*", pty), 1, 0);
                    push[AInstr](out, ai_add_imm(A_X10(), 8));
                    push[AInstr](out, ai_store(A_X29(), dc1, A_X10()));
                } else {
                    let dc2: i32 = ac_slot_alloc_br(env, cg, arm2.cap, pty, 1, 0);
                    push[AInstr](out, ai_load(A_X0(), A_X10(), 8));
                    push[AInstr](out, ai_store(A_X29(), dc2, A_X0()));
                }
            }
        }
        ac_lower_arm_value(out, arm2.body, env, syms, cg);
        ac_scope_end(env, m);
        ac_store_switch_result(out, res, result_words, aggregate);
        push[AInstr](out, ai_jmp(l_end));
        i = i + 1;
    }
    push[AInstr](out, ai_label(l_els));
    if (sw.has_els == 1) {
        let me: i32 = ac_scope_mark(env);
        ac_lower_arm_value(out, sw.els_body, env, syms, cg);
        ac_scope_end(env, me);
        ac_store_switch_result(out, res, result_words, aggregate);
    } else {
        let word2: i32 = 0;
        while (word2 < result_words) {
            push[AInstr](out, ai_mov_imm(A_X0(), 0));
            push[AInstr](out, ai_store(A_X29(), res + word2 * 8, A_X0()));
            word2 = word2 + 1;
        }
    }
    push[AInstr](out, ai_label(l_end));
    if (aggregate == 1) { ac_emit_lea(out, A_X0(), res); }
    else { push[AInstr](out, ai_load(A_X0(), A_X29(), res)); }
    push[AInstr](out, ai_push(A_X0()));
}

fn ac_lower_block(out: *ArrayList[AInstr], body: ArrayList[*Node], env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) void {
    let i: i32 = 0;
    while (i < len[*Node](body)) {
        ac_lower_stmt(out, get[*Node](body, i), env, syms, cg);
        i = i + 1;
    }
}

// ── functions ────────────────────────────────────────────────────────────────

fn ac_lower_fn(out: *ArrayList[AInstr], f: FnDecl, lbl: i32, syms: ArrayList[AFnSym], cg: *ACg) void {
    let params: ArrayList[Param] = f.params;
    let ret: []u8 = f.ret;
    let body: ArrayList[*Node] = f.body;
    if (len[*Node](body) == 0) {
        ac_err(cg, "arm64: empty fn body in lower_fn");
        return;
    }

    let epi: i32 = ac_fresh(cg);
    cg.*.epilogue = epi;
    cg.*.frame_words = 0;
    cg.*.sret_disp = 0;
    cg.*.sret_words = 0;
    cg.*.ret_ty = ret;

    let env: AEnv = ac_env_new();

    // capturing closure: hidden env ptr arrives FIRST (x0); user args shift by 1
    let is_clos: i32 = 0;
    if (cg_is_clos_name(f.name) == 1 && f.cap_names.len > 0) { is_clos = 1; }
    let shift: i32 = 0;
    let zenv_disp: i32 = 0;
    if (is_clos == 1) {
        shift = 1;
        zenv_disp = ac_slot_scratch(cg, 1);
    }

    // bind params: scalars inline, aggregates by-ref (caller passed a copy's address)
    let pi: i32 = 0;
    while (pi < len[Param](params)) {
        let p: Param = get[Param](params, pi);
        let pty: []u8 = p.pty;
        if (cg_is_fn_type(cg_norm_type(pty)) == 1) { pty = "fat_fn"; }
        if (ac_is_aggregate(cg, pty) == 1) {
            let _d1: i32 = ac_slot_alloc_br(&env, cg, p.name, pty, 1, 1);
        } else {
            let _d2: i32 = ac_slot_alloc_br(&env, cg, p.name, pty, 1, 0);
        }
        pi = pi + 1;
    }
    if (ac_is_aggregate(cg, ret) == 1) {
        cg.*.sret_words = ac_type_words(cg, ret);
        cg.*.sret_disp = ac_slot_scratch(cg, 1);
    }

    // closure captures: bind each capture to a frame slot NOW (the prologue
    // loads them from the env block after the params are stored).
    let cap_disps: ArrayList[i32] = make[i32](4);
    if (is_clos == 1) {
        let cnames: ArrayList[[]u8] = split_args(f.cap_names);
        let ctypes: ArrayList[[]u8] = split_args(f.cap_types);
        let ci: i32 = 0;
        while (ci < len[[]u8](cnames)) {
            let cname: []u8 = get[[]u8](cnames, ci);
            let cty: []u8 = "";
            if (ci < len[[]u8](ctypes)) { cty = get[[]u8](ctypes, ci); }
            let real_cn: []u8 = cname;
            if (cname.len > 0 && cname[0] == '*') { real_cn = cname[1..]; }
            let cd: i32 = 0;
            if (cname.len > 0 && cname[0] == '*') {
                cd = ac_slot_alloc_br(&env, cg, real_cn, cty, 1, 0);
            } else if (cty.len > 0 && ac_is_aggregate(cg, cty) == 1) {
                cd = ac_slot_alloc_br(&env, cg, cname, cty, 1, 1);
            } else {
                cd = ac_slot_alloc_br(&env, cg, cname, cty, 1, 0);
            }
            push[i32](&cap_disps, cd);
            ci = ci + 1;
        }
    }

    // Lower the body into a scratch list first so cg.frame_words includes
    // every scratch slot (string literals etc.) before the frame is sized.
    let bodyins: ArrayList[AInstr] = make[AInstr](64);
    ac_lower_block(&bodyins, body, &env, syms, cg);

    // Frame: [SP .. SP+expr) expression stack, [X29-8*words .. X29) slots.
    // The expr region is sized from the MEASURED maximum push depth of the
    // lowered body (deep nested expressions exceed any fixed budget), with
    // AC_EXPR_WORDS as the floor and +8 words of headroom.
    let depth: i32 = 0;
    let maxdepth: i32 = 0;
    let sk: i32 = 0;
    while (sk < len[AInstr](bodyins)) {
        let ik: i32 = get[AInstr](bodyins, sk).kind;
        if (ik == AK_PUSH()) {
            depth = depth + 1;
            if (depth > maxdepth) { maxdepth = depth; }
        } else if (ik == AK_POP()) {
            depth = depth - 1;
        }
        sk = sk + 1;
    }
    let expr_words: i32 = AC_EXPR_WORDS();
    if (maxdepth + 8 > expr_words) { expr_words = maxdepth + 8; }
    let frame: i32 = ac_align16(8 * cg.*.frame_words) + ac_align16(8 * expr_words);

    // Header saves x29/x30/x28 — x28 is the expression-stack pointer and
    // must survive calls (every fn repoints it at its own frame).
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_sub_imm(A_SP(), 32));
    push[AInstr](out, ai_store(A_SP(), 0, A_X29()));
    push[AInstr](out, ai_store(A_SP(), 8, A_X30()));
    push[AInstr](out, ai_store(A_SP(), 16, A_X28()));
    push[AInstr](out, ai_mov_rr(A_X29(), A_SP()));
    push[AInstr](out, ai_sub_imm(A_SP(), frame as i64));
    push[AInstr](out, ai_mov_rr(A_X28(), A_SP()));

    let pj: i32 = 0;
    while (pj < len[Param](params)) {
        let pname: []u8 = get[Param](params, pj).name;
        let pdisp: i32 = ac_slot_find(&env, pname);
        let reg: i32 = a_arg_reg(pj + shift);
        if (reg >= 0) {
            push[AInstr](out, ai_store(A_X29(), pdisp, reg));
        } else {
            // 9th+ arg: caller stored it just above our save area
            push[AInstr](out, ai_load(A_X9(), A_X29(), 32 + 8 * (pj + shift - 8)));
            push[AInstr](out, ai_store(A_X29(), pdisp, A_X9()));
        }
        pj = pj + 1;
    }
    if (is_clos == 1) {
        push[AInstr](out, ai_store(A_X29(), zenv_disp, A_X0()));
        push[AInstr](out, ai_load(A_X10(), A_X29(), zenv_disp));
        let ck: i32 = 0;
        while (ck < len[i32](cap_disps)) {
            push[AInstr](out, ai_load(A_X9(), A_X10(), 8 * ck));
            push[AInstr](out, ai_store(A_X29(), get[i32](cap_disps, ck), A_X9()));
            ck = ck + 1;
        }
    }
    if (cg.*.sret_words > 0) {
        push[AInstr](out, ai_store(A_X29(), cg.*.sret_disp, A_X8()));
    }

    let bi: i32 = 0;
    while (bi < len[AInstr](bodyins)) {
        push[AInstr](out, get[AInstr](bodyins, bi));
        bi = bi + 1;
    }

    push[AInstr](out, ai_label(epi));
    push[AInstr](out, ai_mov_rr(A_SP(), A_X29()));
    push[AInstr](out, ai_load(A_X29(), A_SP(), 0));
    push[AInstr](out, ai_load(A_X30(), A_SP(), 8));
    push[AInstr](out, ai_load(A_X28(), A_SP(), 16));
    push[AInstr](out, ai_add_imm(A_SP(), 32));
    push[AInstr](out, ai_ret());
}

// __print_int(x0=n): decimal + write(1,buf,len)  syscall write=64
fn ac_emit_print_int(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    let l_pos: i32 = ac_fresh(cg);
    let l_loop: i32 = ac_fresh(cg);
    let l_zero: i32 = ac_fresh(cg);
    let l_after: i32 = ac_fresh(cg);
    let l_nosign: i32 = ac_fresh(cg);
    let l_wtop: i32 = ac_fresh(cg);
    let l_wdone: i32 = ac_fresh(cg);

    // Frame: [SP..SP+64) decimal buffer, [SP+64..) digit push area (≤21 words).
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_sub_imm(A_SP(), 32));
    push[AInstr](out, ai_store(A_SP(), 0, A_X29()));
    push[AInstr](out, ai_store(A_SP(), 8, A_X30()));
    push[AInstr](out, ai_store(A_SP(), 16, A_X28()));
    push[AInstr](out, ai_mov_rr(A_X29(), A_SP()));
    push[AInstr](out, ai_sub_imm(A_SP(), 256));
    push[AInstr](out, ai_mov_rr(A_X28(), A_SP()));
    push[AInstr](out, ai_add_imm(A_X28(), 64));

    push[AInstr](out, ai_mov_rr(A_X9(), A_X0()));
    push[AInstr](out, ai_mov_imm(A_X10(), 0));
    push[AInstr](out, ai_cmp_imm(A_X9(), 0));
    push[AInstr](out, ai_jge(l_pos));
    push[AInstr](out, ai_mov_imm(A_X10(), 1));
    push[AInstr](out, ai_label(l_pos));

    push[AInstr](out, ai_mov_imm(A_X11(), 0));
    push[AInstr](out, ai_cmp_imm(A_X9(), 0));
    push[AInstr](out, ai_je(l_zero));

    push[AInstr](out, ai_label(l_loop));
    push[AInstr](out, ai_cmp_imm(A_X9(), 0));
    push[AInstr](out, ai_je(l_after));
    push[AInstr](out, ai_mov_imm(A_X12(), 10));
    push[AInstr](out, ai_sdiv(A_X13(), A_X9(), A_X12()));
    push[AInstr](out, ai_mul(A_X14(), A_X13(), A_X12()));
    push[AInstr](out, ai_sub(A_X14(), A_X9()));
    push[AInstr](out, ai_mov_rr(A_X9(), A_X13()));
    push[AInstr](out, ai_cmp_imm(A_X14(), 0));
    let l_pdig: i32 = ac_fresh(cg);
    push[AInstr](out, ai_jge(l_pdig));
    push[AInstr](out, ai_neg(A_X14(), A_X14()));
    push[AInstr](out, ai_label(l_pdig));
    push[AInstr](out, ai_add_imm(A_X14(), 48));
    push[AInstr](out, ai_push(A_X14()));
    push[AInstr](out, ai_add_imm(A_X11(), 1));
    push[AInstr](out, ai_jmp(l_loop));

    push[AInstr](out, ai_label(l_zero));
    push[AInstr](out, ai_mov_imm(A_X14(), 48));
    push[AInstr](out, ai_push(A_X14()));
    push[AInstr](out, ai_mov_imm(A_X11(), 1));

    push[AInstr](out, ai_label(l_after));
    push[AInstr](out, ai_cmp_imm(A_X10(), 0));
    push[AInstr](out, ai_je(l_nosign));
    push[AInstr](out, ai_mov_imm(A_X14(), 45));
    push[AInstr](out, ai_push(A_X14()));
    push[AInstr](out, ai_add_imm(A_X11(), 1));
    push[AInstr](out, ai_label(l_nosign));

    push[AInstr](out, ai_mov_rr(A_X1(), A_SP()));
    push[AInstr](out, ai_mov_rr(A_X12(), A_X11()));
    push[AInstr](out, ai_label(l_wtop));
    push[AInstr](out, ai_cmp_imm(A_X12(), 0));
    push[AInstr](out, ai_je(l_wdone));
    push[AInstr](out, ai_pop(A_X13()));
    push[AInstr](out, ai_store(A_X1(), 0, A_X13()));
    push[AInstr](out, ai_add_imm(A_X1(), 1));
    push[AInstr](out, ai_sub_imm(A_X12(), 1));
    push[AInstr](out, ai_jmp(l_wtop));
    push[AInstr](out, ai_label(l_wdone));

    push[AInstr](out, ai_mov_imm(A_X8(), 64));
    push[AInstr](out, ai_mov_imm(A_X0(), 1));
    push[AInstr](out, ai_mov_rr(A_X1(), A_SP()));
    push[AInstr](out, ai_mov_rr(A_X2(), A_X11()));
    push[AInstr](out, ai_svc());

    push[AInstr](out, ai_mov_rr(A_SP(), A_X29()));
    push[AInstr](out, ai_load(A_X29(), A_SP(), 0));
    push[AInstr](out, ai_load(A_X30(), A_SP(), 8));
    push[AInstr](out, ai_load(A_X28(), A_SP(), 16));
    push[AInstr](out, ai_add_imm(A_SP(), 32));
    push[AInstr](out, ai_ret());
}

// __print_str(x1=ptr, x2=len): write(1, ptr, len)
fn ac_emit_print_str(out: *ArrayList[AInstr], lbl: i32) void {
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_mov_imm(A_X8(), 64));
    push[AInstr](out, ai_mov_imm(A_X0(), 1));
    push[AInstr](out, ai_svc());
    push[AInstr](out, ai_ret());
}

// __malloc(x0=n): arena/bump allocator. Hands out (n + 8-byte header, rounded
// to 16) bytes from a 64 MiB arena, mmapping a fresh arena only when the
// current one is exhausted; allocations larger than an arena get a dedicated
// mmap. Never frees (same lifetime model as x86), but packs many small objects
// into one mapping instead of one mmap each — the per-allocation page rounding
// (4 KiB minimum) is what made the arm64 self-compile exceed memory under
// qemu-user. Returns base+8 with n stored in the 8-byte header at [ret-8] so
// __realloc can recover the old size. Two i64 globals live in the writable data
// segment: g_cursor at A_DATA_VBASE()+0, g_end at A_DATA_VBASE()+8 (both start
// zero, so the first call takes the grow path). AArch64 Linux: mmap = 222;
// PROT_READ|PROT_WRITE = 3; MAP_PRIVATE|MAP_ANON = 34. The kernel preserves
// x1-x30 across svc, so x9..x15 stay live across the mmap.
fn ac_emit_alloc(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    let l_huge: i32 = ac_fresh(cg);
    let l_fits: i32 = ac_fresh(cg);
    push[AInstr](out, ai_label(lbl));
    // total = align16(n + 8). Do the &~15 (which clobbers x9) before x9 = n.
    push[AInstr](out, ai_mov_rr(A_X13(), A_X0()));
    push[AInstr](out, ai_add_imm(A_X13(), 23));         // n + header(8) + round(15)
    push[AInstr](out, ai_and_imm(A_X13(), 0 - 16));     // & ~15
    push[AInstr](out, ai_mov_rr(A_X9(), A_X0()));       // x9 = n (header value)
    push[AInstr](out, ai_mov_imm(A_X10(), A_DATA_VBASE()));
    push[AInstr](out, ai_load(A_X11(), A_X10(), 0));    // x11 = g_cursor
    push[AInstr](out, ai_load(A_X12(), A_X10(), 8));    // x12 = g_end
    push[AInstr](out, ai_mov_imm(A_X15(), 67108864));   // ARENA_SIZE = 64 MiB
    push[AInstr](out, ai_cmp(A_X13(), A_X15()));
    push[AInstr](out, ai_jg(l_huge));                   // total > arena → dedicated mmap
    push[AInstr](out, ai_mov_rr(A_X14(), A_X11()));
    push[AInstr](out, ai_add(A_X14(), A_X13()));        // x14 = cursor + total
    push[AInstr](out, ai_cmp(A_X14(), A_X12()));
    push[AInstr](out, ai_jle(l_fits));                  // fits in the current arena
    // grow: mmap a fresh 64 MiB arena
    push[AInstr](out, ai_mov_imm(A_X0(), 0));
    push[AInstr](out, ai_mov_rr(A_X1(), A_X15()));      // len = ARENA_SIZE
    push[AInstr](out, ai_mov_imm(A_X2(), 3));
    push[AInstr](out, ai_mov_imm(A_X3(), 34));
    push[AInstr](out, ai_mov_imm(A_X4(), 0 - 1));
    push[AInstr](out, ai_mov_imm(A_X5(), 0));
    push[AInstr](out, ai_mov_imm(A_X8(), 222));
    push[AInstr](out, ai_svc());                        // x0 = arena base
    push[AInstr](out, ai_mov_rr(A_X11(), A_X0()));      // cursor = base
    push[AInstr](out, ai_add(A_X0(), A_X15()));         // x0 = base + ARENA_SIZE
    push[AInstr](out, ai_store(A_X10(), 8, A_X0()));    // g_end = base + ARENA_SIZE
    push[AInstr](out, ai_mov_rr(A_X14(), A_X11()));
    push[AInstr](out, ai_add(A_X14(), A_X13()));        // x14 = cursor + total
    push[AInstr](out, ai_label(l_fits));
    push[AInstr](out, ai_store(A_X11(), 0, A_X9()));    // header = n
    push[AInstr](out, ai_store(A_X10(), 0, A_X14()));   // g_cursor = cursor + total
    push[AInstr](out, ai_mov_rr(A_X0(), A_X11()));
    push[AInstr](out, ai_add_imm(A_X0(), 8));           // return cursor + 8
    push[AInstr](out, ai_ret());
    // dedicated mmap for a single allocation larger than one arena
    push[AInstr](out, ai_label(l_huge));
    push[AInstr](out, ai_mov_imm(A_X0(), 0));
    push[AInstr](out, ai_mov_rr(A_X1(), A_X13()));      // len = total
    push[AInstr](out, ai_mov_imm(A_X2(), 3));
    push[AInstr](out, ai_mov_imm(A_X3(), 34));
    push[AInstr](out, ai_mov_imm(A_X4(), 0 - 1));
    push[AInstr](out, ai_mov_imm(A_X5(), 0));
    push[AInstr](out, ai_mov_imm(A_X8(), 222));
    push[AInstr](out, ai_svc());                        // x0 = base
    push[AInstr](out, ai_store(A_X0(), 0, A_X9()));     // header = n
    push[AInstr](out, ai_add_imm(A_X0(), 8));
    push[AInstr](out, ai_ret());
}

// __streq(x0=&a, x1=&b): 1 if the two {ptr,len} slices are byte-equal.
fn ac_emit_streq(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    let l_loop: i32 = ac_fresh(cg);
    let l_eq: i32 = ac_fresh(cg);
    let l_ne: i32 = ac_fresh(cg);
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_load(A_X2(), A_X0(), 0));   // a.ptr
    push[AInstr](out, ai_load(A_X3(), A_X0(), 8));   // a.len
    push[AInstr](out, ai_load(A_X4(), A_X1(), 0));   // b.ptr
    push[AInstr](out, ai_load(A_X5(), A_X1(), 8));   // b.len
    push[AInstr](out, ai_cmp(A_X3(), A_X5()));
    push[AInstr](out, ai_jne(l_ne));
    push[AInstr](out, ai_mov_imm(A_X6(), 0));
    push[AInstr](out, ai_label(l_loop));
    push[AInstr](out, ai_cmp(A_X6(), A_X3()));
    push[AInstr](out, ai_jge(l_eq));
    push[AInstr](out, ai_loadb(A_X9(), A_X2(), 0));
    push[AInstr](out, ai_loadb(A_X10(), A_X4(), 0));
    push[AInstr](out, ai_cmp(A_X9(), A_X10()));
    push[AInstr](out, ai_jne(l_ne));
    push[AInstr](out, ai_add_imm(A_X2(), 1));
    push[AInstr](out, ai_add_imm(A_X4(), 1));
    push[AInstr](out, ai_add_imm(A_X6(), 1));
    push[AInstr](out, ai_jmp(l_loop));
    push[AInstr](out, ai_label(l_eq));
    push[AInstr](out, ai_mov_imm(A_X0(), 1));
    push[AInstr](out, ai_ret());
    push[AInstr](out, ai_label(l_ne));
    push[AInstr](out, ai_mov_imm(A_X0(), 0));
    push[AInstr](out, ai_ret());
}

// __realloc(x0=p, x1=n): new = __malloc(n); copy min([p-8], n) bytes; return new.
fn ac_emit_realloc(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    let l_loop: i32 = ac_fresh(cg);
    let l_done: i32 = ac_fresh(cg);
    let l_min: i32 = ac_fresh(cg);
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_sub_imm(A_SP(), 48));
    push[AInstr](out, ai_store(A_SP(), 0, A_X30()));
    push[AInstr](out, ai_store(A_SP(), 8, A_X0()));    // p
    push[AInstr](out, ai_store(A_SP(), 16, A_X1()));   // n
    push[AInstr](out, ai_mov_rr(A_X0(), A_X1()));
    push[AInstr](out, ai_call(cg.*.al_lbl));           // x0 = new
    push[AInstr](out, ai_store(A_SP(), 24, A_X0()));
    push[AInstr](out, ai_load(A_X1(), A_SP(), 8));     // p
    push[AInstr](out, ai_load(A_X9(), A_X1(), 0 - 8)); // old size
    push[AInstr](out, ai_load(A_X2(), A_SP(), 16));    // n
    push[AInstr](out, ai_cmp(A_X9(), A_X2()));
    push[AInstr](out, ai_jle(l_min));
    push[AInstr](out, ai_mov_rr(A_X9(), A_X2()));
    push[AInstr](out, ai_label(l_min));
    push[AInstr](out, ai_mov_rr(A_X10(), A_X0()));     // dst
    push[AInstr](out, ai_label(l_loop));
    push[AInstr](out, ai_cmp_imm(A_X9(), 0));
    push[AInstr](out, ai_jle(l_done));
    push[AInstr](out, ai_loadb(A_X11(), A_X1(), 0));
    push[AInstr](out, ai_storeb(A_X10(), 0, A_X11()));
    push[AInstr](out, ai_add_imm(A_X1(), 1));
    push[AInstr](out, ai_add_imm(A_X10(), 1));
    push[AInstr](out, ai_sub_imm(A_X9(), 1));
    push[AInstr](out, ai_jmp(l_loop));
    push[AInstr](out, ai_label(l_done));
    push[AInstr](out, ai_load(A_X0(), A_SP(), 24));
    push[AInstr](out, ai_load(A_X30(), A_SP(), 0));
    push[AInstr](out, ai_add_imm(A_SP(), 48));
    push[AInstr](out, ai_ret());
}

// __i64_to_str(x0=n, x1=&{ptr,len} out-block): decimal into a fresh buffer.
fn ac_emit_i64s(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    let l_pos: i32 = ac_fresh(cg);
    let l_loop: i32 = ac_fresh(cg);
    let l_zero: i32 = ac_fresh(cg);
    let l_after: i32 = ac_fresh(cg);
    let l_nosign: i32 = ac_fresh(cg);
    let l_wtop: i32 = ac_fresh(cg);
    let l_wdone: i32 = ac_fresh(cg);
    let l_pdig: i32 = ac_fresh(cg);

    // Frame: [SP..SP+8)=n, [SP+8..16)=dest, [SP+16..24)=buf, digits from SP+64.
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_sub_imm(A_SP(), 32));
    push[AInstr](out, ai_store(A_SP(), 0, A_X29()));
    push[AInstr](out, ai_store(A_SP(), 8, A_X30()));
    push[AInstr](out, ai_store(A_SP(), 16, A_X28()));
    push[AInstr](out, ai_mov_rr(A_X29(), A_SP()));
    push[AInstr](out, ai_sub_imm(A_SP(), 256));
    push[AInstr](out, ai_mov_rr(A_X28(), A_SP()));
    push[AInstr](out, ai_add_imm(A_X28(), 64));

    push[AInstr](out, ai_store(A_SP(), 0, A_X0()));
    push[AInstr](out, ai_store(A_SP(), 8, A_X1()));
    push[AInstr](out, ai_mov_imm(A_X0(), 32));
    push[AInstr](out, ai_call(cg.*.al_lbl));
    push[AInstr](out, ai_store(A_SP(), 16, A_X0()));

    push[AInstr](out, ai_load(A_X9(), A_SP(), 0));
    push[AInstr](out, ai_mov_imm(A_X10(), 0));
    push[AInstr](out, ai_cmp_imm(A_X9(), 0));
    push[AInstr](out, ai_jge(l_pos));
    push[AInstr](out, ai_mov_imm(A_X10(), 1));
    push[AInstr](out, ai_label(l_pos));

    push[AInstr](out, ai_mov_imm(A_X11(), 0));
    push[AInstr](out, ai_cmp_imm(A_X9(), 0));
    push[AInstr](out, ai_je(l_zero));

    push[AInstr](out, ai_label(l_loop));
    push[AInstr](out, ai_cmp_imm(A_X9(), 0));
    push[AInstr](out, ai_je(l_after));
    push[AInstr](out, ai_mov_imm(A_X12(), 10));
    push[AInstr](out, ai_sdiv(A_X13(), A_X9(), A_X12()));
    push[AInstr](out, ai_mul(A_X14(), A_X13(), A_X12()));
    push[AInstr](out, ai_sub(A_X14(), A_X9()));
    push[AInstr](out, ai_mov_rr(A_X9(), A_X13()));
    push[AInstr](out, ai_cmp_imm(A_X14(), 0));
    push[AInstr](out, ai_jge(l_pdig));
    push[AInstr](out, ai_neg(A_X14(), A_X14()));
    push[AInstr](out, ai_label(l_pdig));
    push[AInstr](out, ai_add_imm(A_X14(), 48));
    push[AInstr](out, ai_push(A_X14()));
    push[AInstr](out, ai_add_imm(A_X11(), 1));
    push[AInstr](out, ai_jmp(l_loop));

    push[AInstr](out, ai_label(l_zero));
    push[AInstr](out, ai_mov_imm(A_X14(), 48));
    push[AInstr](out, ai_push(A_X14()));
    push[AInstr](out, ai_mov_imm(A_X11(), 1));

    push[AInstr](out, ai_label(l_after));
    push[AInstr](out, ai_cmp_imm(A_X10(), 0));
    push[AInstr](out, ai_je(l_nosign));
    push[AInstr](out, ai_mov_imm(A_X14(), 45));
    push[AInstr](out, ai_push(A_X14()));
    push[AInstr](out, ai_add_imm(A_X11(), 1));
    push[AInstr](out, ai_label(l_nosign));

    // pop digits (MSD first) into the malloc'd buffer as bytes
    push[AInstr](out, ai_load(A_X1(), A_SP(), 16));
    push[AInstr](out, ai_mov_rr(A_X12(), A_X11()));
    push[AInstr](out, ai_label(l_wtop));
    push[AInstr](out, ai_cmp_imm(A_X12(), 0));
    push[AInstr](out, ai_je(l_wdone));
    push[AInstr](out, ai_pop(A_X13()));
    push[AInstr](out, ai_storeb(A_X1(), 0, A_X13()));
    push[AInstr](out, ai_add_imm(A_X1(), 1));
    push[AInstr](out, ai_sub_imm(A_X12(), 1));
    push[AInstr](out, ai_jmp(l_wtop));
    push[AInstr](out, ai_label(l_wdone));

    push[AInstr](out, ai_load(A_X10(), A_SP(), 8));    // dest block
    push[AInstr](out, ai_load(A_X9(), A_SP(), 16));    // buffer ptr
    push[AInstr](out, ai_store(A_X10(), 0, A_X9()));
    push[AInstr](out, ai_store(A_X10(), 8, A_X11()));

    push[AInstr](out, ai_mov_rr(A_SP(), A_X29()));
    push[AInstr](out, ai_load(A_X29(), A_SP(), 0));
    push[AInstr](out, ai_load(A_X30(), A_SP(), 8));
    push[AInstr](out, ai_load(A_X28(), A_SP(), 16));
    push[AInstr](out, ai_add_imm(A_SP(), 32));
    push[AInstr](out, ai_ret());
}

// ── syscall-runtime routines for self-hosting (ports of the x86 cg_emit_rt_*
// family in ncodegen.zag; same contracts, AArch64 syscall numbers). All are
// reached via ai_call, use x9-x15 as scratch,
// keep x27 (argv base) intact, and save x30 across nested calls.
// AT_FDCWD = -100 on every *at syscall
// (arm64 has no plain open/access/chmod/fork).

// Append a NUL-terminated copy of `s` to the DATA blob; returns its offset.
fn ac_rt_push_cstr(cg: *ACg, s: []u8) i32 {
    let off: i32 = len[u8](cg.*.data.*);
    let i: i32 = 0;
    while (i < s.len) { push[u8](cg.*.data, s[i]); i = i + 1; }
    push[u8](cg.*.data, 0);
    return off;
}

// Copy x11 bytes from [x9] to [x10]. Clobbers x9, x10, x11, x12.
fn ac_rt_copy(out: *ArrayList[AInstr], cg: *ACg) void {
    let l_top: i32 = ac_fresh(cg);
    let l_end: i32 = ac_fresh(cg);
    push[AInstr](out, ai_label(l_top));
    push[AInstr](out, ai_cmp_imm(A_X11(), 0));
    push[AInstr](out, ai_jle(l_end));
    push[AInstr](out, ai_loadb(A_X12(), A_X9(), 0));
    push[AInstr](out, ai_storeb(A_X10(), 0, A_X12()));
    push[AInstr](out, ai_add_imm(A_X9(), 1));
    push[AInstr](out, ai_add_imm(A_X10(), 1));
    push[AInstr](out, ai_sub_imm(A_X11(), 1));
    push[AInstr](out, ai_jmp(l_top));
    push[AInstr](out, ai_label(l_end));
}

// __make_slice(x0=ptr, x1=len) -> x0 = &{ptr,len} (16-byte heap block).
fn ac_emit_make_slice(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_sub_imm(A_SP(), 32));
    push[AInstr](out, ai_store(A_SP(), 0, A_X30()));
    push[AInstr](out, ai_store(A_SP(), 8, A_X0()));
    push[AInstr](out, ai_store(A_SP(), 16, A_X1()));
    push[AInstr](out, ai_mov_imm(A_X0(), 16));
    push[AInstr](out, ai_call(cg.*.al_lbl));
    push[AInstr](out, ai_load(A_X9(), A_SP(), 8));
    push[AInstr](out, ai_store(A_X0(), 0, A_X9()));
    push[AInstr](out, ai_load(A_X9(), A_SP(), 16));
    push[AInstr](out, ai_store(A_X0(), 8, A_X9()));
    push[AInstr](out, ai_load(A_X30(), A_SP(), 0));
    push[AInstr](out, ai_add_imm(A_SP(), 32));
    push[AInstr](out, ai_ret());
}

// __pathbuf(x0=&slice) -> x0 = NUL-terminated heap copy of the bytes.
fn ac_emit_pathbuf(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_sub_imm(A_SP(), 48));
    push[AInstr](out, ai_store(A_SP(), 0, A_X30()));
    push[AInstr](out, ai_load(A_X9(), A_X0(), 0));
    push[AInstr](out, ai_store(A_SP(), 8, A_X9()));     // src.ptr
    push[AInstr](out, ai_load(A_X9(), A_X0(), 8));
    push[AInstr](out, ai_store(A_SP(), 16, A_X9()));    // src.len
    push[AInstr](out, ai_mov_rr(A_X0(), A_X9()));
    push[AInstr](out, ai_add_imm(A_X0(), 1));
    push[AInstr](out, ai_call(cg.*.al_lbl));
    push[AInstr](out, ai_store(A_SP(), 24, A_X0()));    // buf
    push[AInstr](out, ai_load(A_X9(), A_SP(), 8));
    push[AInstr](out, ai_mov_rr(A_X10(), A_X0()));
    push[AInstr](out, ai_load(A_X11(), A_SP(), 16));
    ac_rt_copy(out, cg);                                // x10 ends at buf+len
    push[AInstr](out, ai_mov_imm(A_X12(), 0));
    push[AInstr](out, ai_storeb(A_X10(), 0, A_X12()));  // NUL
    push[AInstr](out, ai_load(A_X0(), A_SP(), 24));
    push[AInstr](out, ai_load(A_X30(), A_SP(), 0));
    push[AInstr](out, ai_add_imm(A_SP(), 48));
    push[AInstr](out, ai_ret());
}

// __concat(x0=&a, x1=&b) -> x0 = &{buf, a.len+b.len}.
fn ac_emit_concat(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_sub_imm(A_SP(), 64));
    push[AInstr](out, ai_store(A_SP(), 0, A_X30()));
    push[AInstr](out, ai_load(A_X9(), A_X0(), 0));
    push[AInstr](out, ai_store(A_SP(), 8, A_X9()));     // a.ptr
    push[AInstr](out, ai_load(A_X9(), A_X0(), 8));
    push[AInstr](out, ai_store(A_SP(), 16, A_X9()));    // a.len
    push[AInstr](out, ai_load(A_X9(), A_X1(), 0));
    push[AInstr](out, ai_store(A_SP(), 24, A_X9()));    // b.ptr
    push[AInstr](out, ai_load(A_X9(), A_X1(), 8));
    push[AInstr](out, ai_store(A_SP(), 32, A_X9()));    // b.len
    push[AInstr](out, ai_load(A_X0(), A_SP(), 16));
    push[AInstr](out, ai_add(A_X0(), A_X9()));          // total = a.len+b.len
    push[AInstr](out, ai_call(cg.*.al_lbl));
    push[AInstr](out, ai_store(A_SP(), 40, A_X0()));    // buf
    push[AInstr](out, ai_load(A_X9(), A_SP(), 8));      // copy a → buf
    push[AInstr](out, ai_mov_rr(A_X10(), A_X0()));
    push[AInstr](out, ai_load(A_X11(), A_SP(), 16));
    ac_rt_copy(out, cg);
    push[AInstr](out, ai_load(A_X9(), A_SP(), 24));     // copy b → buf+a.len
    push[AInstr](out, ai_load(A_X10(), A_SP(), 40));
    push[AInstr](out, ai_load(A_X12(), A_SP(), 16));
    push[AInstr](out, ai_add(A_X10(), A_X12()));
    push[AInstr](out, ai_load(A_X11(), A_SP(), 32));
    ac_rt_copy(out, cg);
    push[AInstr](out, ai_load(A_X0(), A_SP(), 40));
    push[AInstr](out, ai_load(A_X1(), A_SP(), 16));
    push[AInstr](out, ai_load(A_X9(), A_SP(), 32));
    push[AInstr](out, ai_add(A_X1(), A_X9()));
    push[AInstr](out, ai_call(cg.*.ms_lbl));
    push[AInstr](out, ai_load(A_X30(), A_SP(), 0));
    push[AInstr](out, ai_add_imm(A_SP(), 64));
    push[AInstr](out, ai_ret());
}

// __arg(x0=i) -> x0 = &{argv[i], strlen}. Out-of-range -> &{0,0}.
// argv base: x27 = initial SP ([x27]=argc, [x27+8+8i]=argv[i] cstr).
fn ac_emit_argslice(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    let l_oob: i32 = ac_fresh(cg);
    let l_scan: i32 = ac_fresh(cg);
    let l_send: i32 = ac_fresh(cg);
    let l_ret: i32 = ac_fresh(cg);
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_sub_imm(A_SP(), 16));
    push[AInstr](out, ai_store(A_SP(), 0, A_X30()));
    push[AInstr](out, ai_cmp_imm(A_X0(), 0));
    push[AInstr](out, ai_jl(l_oob));
    push[AInstr](out, ai_load(A_X9(), A_X27(), 0));     // argc
    push[AInstr](out, ai_cmp(A_X0(), A_X9()));
    push[AInstr](out, ai_jge(l_oob));
    push[AInstr](out, ai_mov_imm(A_X10(), 8));
    push[AInstr](out, ai_mul(A_X11(), A_X0(), A_X10()));
    push[AInstr](out, ai_add(A_X11(), A_X27()));
    push[AInstr](out, ai_add_imm(A_X11(), 8));          // &argv[i]
    push[AInstr](out, ai_load(A_X11(), A_X11(), 0));    // cstr
    push[AInstr](out, ai_mov_imm(A_X12(), 0));          // len
    push[AInstr](out, ai_label(l_scan));
    push[AInstr](out, ai_mov_rr(A_X13(), A_X11()));
    push[AInstr](out, ai_add(A_X13(), A_X12()));
    push[AInstr](out, ai_loadb(A_X14(), A_X13(), 0));
    push[AInstr](out, ai_cmp_imm(A_X14(), 0));
    push[AInstr](out, ai_je(l_send));
    push[AInstr](out, ai_add_imm(A_X12(), 1));
    push[AInstr](out, ai_jmp(l_scan));
    push[AInstr](out, ai_label(l_send));
    push[AInstr](out, ai_mov_rr(A_X0(), A_X11()));
    push[AInstr](out, ai_mov_rr(A_X1(), A_X12()));
    push[AInstr](out, ai_call(cg.*.ms_lbl));
    push[AInstr](out, ai_jmp(l_ret));
    push[AInstr](out, ai_label(l_oob));
    push[AInstr](out, ai_mov_imm(A_X0(), 0));
    push[AInstr](out, ai_mov_imm(A_X1(), 0));
    push[AInstr](out, ai_call(cg.*.ms_lbl));
    push[AInstr](out, ai_label(l_ret));
    push[AInstr](out, ai_load(A_X30(), A_SP(), 0));
    push[AInstr](out, ai_add_imm(A_SP(), 16));
    push[AInstr](out, ai_ret());
}

// __read_file(x0=&path) -> x0 = &{buf,total}; open failure -> &{0,-1}.
fn ac_emit_read_file(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    let l_fail: i32 = ac_fresh(cg);
    let l_rtop: i32 = ac_fresh(cg);
    let l_haveroom: i32 = ac_fresh(cg);
    let l_rdone: i32 = ac_fresh(cg);
    let l_ret: i32 = ac_fresh(cg);
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_sub_imm(A_SP(), 48));
    push[AInstr](out, ai_store(A_SP(), 0, A_X30()));
    push[AInstr](out, ai_call(cg.*.pb_lbl));            // x0 = cstr
    push[AInstr](out, ai_mov_rr(A_X1(), A_X0()));
    push[AInstr](out, ai_mov_imm(A_X0(), 0 - 100));     // AT_FDCWD
    push[AInstr](out, ai_mov_imm(A_X2(), 0));           // O_RDONLY
    push[AInstr](out, ai_mov_imm(A_X3(), 0));
    push[AInstr](out, ai_mov_imm(A_X8(), 56));          // openat
    push[AInstr](out, ai_svc());
    push[AInstr](out, ai_cmp_imm(A_X0(), 0));
    push[AInstr](out, ai_jl(l_fail));
    push[AInstr](out, ai_store(A_SP(), 8, A_X0()));     // fd
    push[AInstr](out, ai_mov_imm(A_X0(), 65536));
    push[AInstr](out, ai_call(cg.*.al_lbl));
    push[AInstr](out, ai_store(A_SP(), 16, A_X0()));    // buf
    push[AInstr](out, ai_mov_imm(A_X9(), 65536));
    push[AInstr](out, ai_store(A_SP(), 24, A_X9()));    // cap
    push[AInstr](out, ai_mov_imm(A_X9(), 0));
    push[AInstr](out, ai_store(A_SP(), 32, A_X9()));    // total
    push[AInstr](out, ai_label(l_rtop));
    push[AInstr](out, ai_load(A_X9(), A_SP(), 24));
    push[AInstr](out, ai_load(A_X10(), A_SP(), 32));
    push[AInstr](out, ai_mov_rr(A_X11(), A_X9()));
    push[AInstr](out, ai_sub(A_X11(), A_X10()));        // room = cap-total
    push[AInstr](out, ai_cmp_imm(A_X11(), 0));
    push[AInstr](out, ai_jg(l_haveroom));
    push[AInstr](out, ai_load(A_X0(), A_SP(), 16));     // grow: realloc(buf, cap*2)
    push[AInstr](out, ai_load(A_X1(), A_SP(), 24));
    push[AInstr](out, ai_add(A_X1(), A_X1()));
    push[AInstr](out, ai_store(A_SP(), 24, A_X1()));
    push[AInstr](out, ai_call(cg.*.rl_lbl));
    push[AInstr](out, ai_store(A_SP(), 16, A_X0()));
    push[AInstr](out, ai_label(l_haveroom));
    push[AInstr](out, ai_load(A_X0(), A_SP(), 8));      // read(fd, buf+total, room)
    push[AInstr](out, ai_load(A_X1(), A_SP(), 16));
    push[AInstr](out, ai_load(A_X9(), A_SP(), 32));
    push[AInstr](out, ai_add(A_X1(), A_X9()));
    push[AInstr](out, ai_load(A_X2(), A_SP(), 24));
    push[AInstr](out, ai_sub(A_X2(), A_X9()));
    push[AInstr](out, ai_mov_imm(A_X8(), 63));          // read
    push[AInstr](out, ai_svc());
    push[AInstr](out, ai_cmp_imm(A_X0(), 0));
    push[AInstr](out, ai_jle(l_rdone));
    push[AInstr](out, ai_load(A_X9(), A_SP(), 32));
    push[AInstr](out, ai_add(A_X9(), A_X0()));
    push[AInstr](out, ai_store(A_SP(), 32, A_X9()));
    push[AInstr](out, ai_jmp(l_rtop));
    push[AInstr](out, ai_label(l_rdone));
    push[AInstr](out, ai_load(A_X0(), A_SP(), 8));      // close(fd)
    push[AInstr](out, ai_mov_imm(A_X8(), 57));
    push[AInstr](out, ai_svc());
    push[AInstr](out, ai_load(A_X0(), A_SP(), 16));
    push[AInstr](out, ai_load(A_X1(), A_SP(), 32));
    push[AInstr](out, ai_call(cg.*.ms_lbl));
    push[AInstr](out, ai_jmp(l_ret));
    push[AInstr](out, ai_label(l_fail));
    push[AInstr](out, ai_mov_imm(A_X0(), 0));
    push[AInstr](out, ai_mov_imm(A_X1(), 0 - 1));
    push[AInstr](out, ai_call(cg.*.ms_lbl));
    push[AInstr](out, ai_label(l_ret));
    push[AInstr](out, ai_load(A_X30(), A_SP(), 0));
    push[AInstr](out, ai_add_imm(A_SP(), 48));
    push[AInstr](out, ai_ret());
}

// __write_file(x0=&path, x1=&content) -> x0 = 0/-1.
// mark_exec=1 also fchmodat(path, 0755) after a successful write (write_exec).
fn ac_emit_write_file(out: *ArrayList[AInstr], lbl: i32, mark_exec: i32, cg: *ACg) void {
    let l_fail: i32 = ac_fresh(cg);
    let l_ret: i32 = ac_fresh(cg);
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_sub_imm(A_SP(), 48));
    push[AInstr](out, ai_store(A_SP(), 0, A_X30()));
    push[AInstr](out, ai_store(A_SP(), 8, A_X1()));     // &content
    push[AInstr](out, ai_call(cg.*.pb_lbl));
    push[AInstr](out, ai_store(A_SP(), 16, A_X0()));    // cstr
    push[AInstr](out, ai_mov_rr(A_X1(), A_X0()));
    push[AInstr](out, ai_mov_imm(A_X0(), 0 - 100));     // AT_FDCWD
    push[AInstr](out, ai_mov_imm(A_X2(), 577));         // O_WRONLY|O_CREAT|O_TRUNC
    push[AInstr](out, ai_mov_imm(A_X3(), 420));         // 0644
    push[AInstr](out, ai_mov_imm(A_X8(), 56));          // openat
    push[AInstr](out, ai_svc());
    push[AInstr](out, ai_cmp_imm(A_X0(), 0));
    push[AInstr](out, ai_jl(l_fail));
    push[AInstr](out, ai_store(A_SP(), 24, A_X0()));    // fd
    push[AInstr](out, ai_load(A_X9(), A_SP(), 8));      // write(fd, ptr, len)
    push[AInstr](out, ai_load(A_X1(), A_X9(), 0));
    push[AInstr](out, ai_load(A_X2(), A_X9(), 8));
    push[AInstr](out, ai_mov_imm(A_X8(), 64));
    push[AInstr](out, ai_svc());
    push[AInstr](out, ai_load(A_X0(), A_SP(), 24));     // close(fd)
    push[AInstr](out, ai_mov_imm(A_X8(), 57));
    push[AInstr](out, ai_svc());
    if (mark_exec == 1) {
        push[AInstr](out, ai_mov_imm(A_X0(), 0 - 100));
        push[AInstr](out, ai_load(A_X1(), A_SP(), 16)); // cstr
        push[AInstr](out, ai_mov_imm(A_X2(), 493));     // 0755
        push[AInstr](out, ai_mov_imm(A_X8(), 53));      // fchmodat
        push[AInstr](out, ai_svc());
    }
    push[AInstr](out, ai_mov_imm(A_X0(), 0));
    push[AInstr](out, ai_jmp(l_ret));
    push[AInstr](out, ai_label(l_fail));
    push[AInstr](out, ai_mov_imm(A_X0(), 0 - 1));
    push[AInstr](out, ai_label(l_ret));
    push[AInstr](out, ai_load(A_X30(), A_SP(), 0));
    push[AInstr](out, ai_add_imm(A_SP(), 48));
    push[AInstr](out, ai_ret());
}

// __file_exists(x0=&path) -> x0 = 1/0 via faccessat(AT_FDCWD, path, F_OK).
fn ac_emit_file_exists(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    let l_no: i32 = ac_fresh(cg);
    let l_ret: i32 = ac_fresh(cg);
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_sub_imm(A_SP(), 16));
    push[AInstr](out, ai_store(A_SP(), 0, A_X30()));
    push[AInstr](out, ai_call(cg.*.pb_lbl));
    push[AInstr](out, ai_mov_rr(A_X1(), A_X0()));
    push[AInstr](out, ai_mov_imm(A_X0(), 0 - 100));     // AT_FDCWD
    push[AInstr](out, ai_mov_imm(A_X2(), 0));           // F_OK
    push[AInstr](out, ai_mov_imm(A_X8(), 48));          // faccessat
    push[AInstr](out, ai_svc());
    push[AInstr](out, ai_cmp_imm(A_X0(), 0));
    push[AInstr](out, ai_jne(l_no));
    push[AInstr](out, ai_mov_imm(A_X0(), 1));
    push[AInstr](out, ai_jmp(l_ret));
    push[AInstr](out, ai_label(l_no));
    push[AInstr](out, ai_mov_imm(A_X0(), 0));
    push[AInstr](out, ai_label(l_ret));
    push[AInstr](out, ai_load(A_X30(), A_SP(), 0));
    push[AInstr](out, ai_add_imm(A_SP(), 16));
    push[AInstr](out, ai_ret());
}

// __exec_cmd(x0=&cmd) -> x0 = child exit status.
// clone(SIGCHLD) → child execve("/bin/sh", ["/bin/sh","-c",cmd,0], envp);
// parent wait4 → (status/256)&255. envp forwarded from x27 + 16 + 8*argc.
fn ac_emit_exec_cmd(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    let sh_off: i32 = ac_rt_push_cstr(cg, "/bin/sh");
    let dashc_off: i32 = ac_rt_push_cstr(cg, "-c");
    let l_child: i32 = ac_fresh(cg);
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_sub_imm(A_SP(), 80));
    push[AInstr](out, ai_store(A_SP(), 0, A_X30()));
    push[AInstr](out, ai_call(cg.*.pb_lbl));            // x0 = cmd cstr
    push[AInstr](out, ai_store(A_SP(), 8, A_X0()));
    // argv block: [sp+32]="/bin/sh" [sp+40]="-c" [sp+48]=cmd [sp+56]=NULL
    push[AInstr](out, ai_mov_imm(A_X9(), A_DATA_VBASE() + (sh_off as i64)));
    push[AInstr](out, ai_store(A_SP(), 32, A_X9()));
    push[AInstr](out, ai_mov_imm(A_X9(), A_DATA_VBASE() + (dashc_off as i64)));
    push[AInstr](out, ai_store(A_SP(), 40, A_X9()));
    push[AInstr](out, ai_load(A_X9(), A_SP(), 8));
    push[AInstr](out, ai_store(A_SP(), 48, A_X9()));
    push[AInstr](out, ai_mov_imm(A_X9(), 0));
    push[AInstr](out, ai_store(A_SP(), 56, A_X9()));
    push[AInstr](out, ai_mov_imm(A_X0(), 17));          // clone(SIGCHLD,0,0,0,0)
    push[AInstr](out, ai_mov_imm(A_X1(), 0));
    push[AInstr](out, ai_mov_imm(A_X2(), 0));
    push[AInstr](out, ai_mov_imm(A_X3(), 0));
    push[AInstr](out, ai_mov_imm(A_X4(), 0));
    push[AInstr](out, ai_mov_imm(A_X8(), 220));
    push[AInstr](out, ai_svc());
    push[AInstr](out, ai_cmp_imm(A_X0(), 0));
    push[AInstr](out, ai_je(l_child));
    // parent: wait4(pid, &status@sp+16, 0, 0)
    push[AInstr](out, ai_mov_rr(A_X1(), A_SP()));
    push[AInstr](out, ai_add_imm(A_X1(), 16));
    push[AInstr](out, ai_mov_imm(A_X2(), 0));
    push[AInstr](out, ai_mov_imm(A_X3(), 0));
    push[AInstr](out, ai_mov_imm(A_X8(), 260));
    push[AInstr](out, ai_svc());
    push[AInstr](out, ai_load(A_X9(), A_SP(), 16));
    push[AInstr](out, ai_mov_imm(A_X10(), 256));
    push[AInstr](out, ai_sdiv(A_X11(), A_X9(), A_X10()));
    push[AInstr](out, ai_and_imm(A_X11(), 255));        // WEXITSTATUS
    push[AInstr](out, ai_mov_rr(A_X0(), A_X11()));
    push[AInstr](out, ai_load(A_X30(), A_SP(), 0));
    push[AInstr](out, ai_add_imm(A_SP(), 80));
    push[AInstr](out, ai_ret());
    // child: execve("/bin/sh", argv, envp)
    push[AInstr](out, ai_label(l_child));
    push[AInstr](out, ai_mov_imm(A_X0(), A_DATA_VBASE() + (sh_off as i64)));
    push[AInstr](out, ai_mov_rr(A_X1(), A_SP()));
    push[AInstr](out, ai_add_imm(A_X1(), 32));
    push[AInstr](out, ai_load(A_X9(), A_X27(), 0));     // argc
    push[AInstr](out, ai_mov_imm(A_X10(), 8));
    push[AInstr](out, ai_mul(A_X11(), A_X9(), A_X10()));
    push[AInstr](out, ai_add(A_X11(), A_X27()));
    push[AInstr](out, ai_add_imm(A_X11(), 16));         // envp
    push[AInstr](out, ai_mov_rr(A_X2(), A_X11()));
    push[AInstr](out, ai_mov_imm(A_X8(), 221));         // execve
    push[AInstr](out, ai_svc());
    push[AInstr](out, ai_mov_imm(A_X0(), 127));         // execve failed
    push[AInstr](out, ai_mov_imm(A_X8(), 93));
    push[AInstr](out, ai_svc());
}

// __str_to_i64(x0=&s) -> x0. Optional leading '-'; non-digits skipped
// (lenient, mirrors the x86 routine byte-for-byte in behaviour).
fn ac_emit_str2i(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    let l_noneg: i32 = ac_fresh(cg);
    let l_top: i32 = ac_fresh(cg);
    let l_skip: i32 = ac_fresh(cg);
    let l_end: i32 = ac_fresh(cg);
    let l_pos: i32 = ac_fresh(cg);
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_load(A_X9(), A_X0(), 0));      // ptr
    push[AInstr](out, ai_load(A_X10(), A_X0(), 8));     // len
    push[AInstr](out, ai_mov_imm(A_X0(), 0));           // acc
    push[AInstr](out, ai_mov_imm(A_X11(), 0));          // i
    push[AInstr](out, ai_mov_imm(A_X12(), 0));          // neg flag
    push[AInstr](out, ai_cmp_imm(A_X10(), 0));
    push[AInstr](out, ai_jle(l_noneg));
    push[AInstr](out, ai_loadb(A_X13(), A_X9(), 0));
    push[AInstr](out, ai_cmp_imm(A_X13(), 45));         // '-'
    push[AInstr](out, ai_jne(l_noneg));
    push[AInstr](out, ai_mov_imm(A_X12(), 1));
    push[AInstr](out, ai_mov_imm(A_X11(), 1));
    push[AInstr](out, ai_label(l_noneg));
    push[AInstr](out, ai_label(l_top));
    push[AInstr](out, ai_cmp(A_X11(), A_X10()));
    push[AInstr](out, ai_jge(l_end));
    push[AInstr](out, ai_mov_rr(A_X13(), A_X9()));
    push[AInstr](out, ai_add(A_X13(), A_X11()));
    push[AInstr](out, ai_loadb(A_X14(), A_X13(), 0));
    push[AInstr](out, ai_sub_imm(A_X14(), 48));
    push[AInstr](out, ai_cmp_imm(A_X14(), 0));
    push[AInstr](out, ai_jl(l_skip));
    push[AInstr](out, ai_cmp_imm(A_X14(), 9));
    push[AInstr](out, ai_jg(l_skip));
    push[AInstr](out, ai_mov_imm(A_X13(), 10));
    push[AInstr](out, ai_mul(A_X15(), A_X0(), A_X13()));
    push[AInstr](out, ai_mov_rr(A_X0(), A_X15()));
    push[AInstr](out, ai_add(A_X0(), A_X14()));
    push[AInstr](out, ai_label(l_skip));
    push[AInstr](out, ai_add_imm(A_X11(), 1));
    push[AInstr](out, ai_jmp(l_top));
    push[AInstr](out, ai_label(l_end));
    push[AInstr](out, ai_cmp_imm(A_X12(), 0));
    push[AInstr](out, ai_je(l_pos));
    push[AInstr](out, ai_neg(A_X0(), A_X0()));
    push[AInstr](out, ai_label(l_pos));
    push[AInstr](out, ai_ret());
}

// append literal byte `c` at [x1], advancing x1. Clobbers x2 only.
fn apf_putc(out: *ArrayList[AInstr], c: i32) void {
    push[AInstr](out, ai_mov_imm(A_X2(), c as i64));
    push[AInstr](out, ai_storeb(A_X1(), 0, A_X2()));
    push[AInstr](out, ai_add_imm(A_X1(), 1));
}
// append the 0..9 digit slot at [x6] as ASCII at [x1]; advances x1 only.
fn apf_put_ds(out: *ArrayList[AInstr]) void {
    push[AInstr](out, ai_load(A_X2(), A_X6(), 0));
    push[AInstr](out, ai_add_imm(A_X2(), 48));
    push[AInstr](out, ai_storeb(A_X1(), 0, A_X2()));
    push[AInstr](out, ai_add_imm(A_X1(), 1));
}

// __print_f64(x0 = double bit pattern): %g with 6 significant digits + '\n'.
// Direct port of the x86 routine (cg_emit_print_f64) — same algorithm:
// normalise |V| into [1,10) tracking exp10; D = trunc(V*1e5 + 0.5); peel 6
// digits; FIXED for exp10 in [-4,5], else SCIENTIFIC d.ddddde±NN.
// Frame: [SP..SP+128) OUTBUF, ds[i] at SP+128+8i, expr stack from SP+192.
fn ac_emit_print_f64(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    let l_nosign: i32 = ac_fresh(cg);
    let l_nonzero: i32 = ac_fresh(cg);
    let l_finish: i32 = ac_fresh(cg);
    let l_nhi: i32 = ac_fresh(cg);
    let l_nhi_done: i32 = ac_fresh(cg);
    let l_nlo: i32 = ac_fresh(cg);
    let l_nlo_done: i32 = ac_fresh(cg);
    let l_dok: i32 = ac_fresh(cg);
    let l_last: i32 = ac_fresh(cg);
    let l_last_done: i32 = ac_fresh(cg);
    let l_sci: i32 = ac_fresh(cg);
    let l_fixed_neg: i32 = ac_fresh(cg);
    let l_fi_int: i32 = ac_fresh(cg);
    let l_fi_int_d: i32 = ac_fresh(cg);
    let l_fi_frac: i32 = ac_fresh(cg);
    let l_fixdone: i32 = ac_fresh(cg);
    let l_nz: i32 = ac_fresh(cg);
    let l_nz_done: i32 = ac_fresh(cg);
    let l_ndig: i32 = ac_fresh(cg);
    let l_scifrac: i32 = ac_fresh(cg);
    let l_sci_e: i32 = ac_fresh(cg);
    let l_sci_eneg: i32 = ac_fresh(cg);
    let l_sci_emit: i32 = ac_fresh(cg);
    let l_sci_ebig: i32 = ac_fresh(cg);
    let l_sci_peel: i32 = ac_fresh(cg);
    let l_sci_pop: i32 = ac_fresh(cg);

    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_sub_imm(A_SP(), 32));
    push[AInstr](out, ai_store(A_SP(), 0, A_X29()));
    push[AInstr](out, ai_store(A_SP(), 8, A_X30()));
    push[AInstr](out, ai_store(A_SP(), 16, A_X28()));
    push[AInstr](out, ai_mov_rr(A_X29(), A_SP()));
    push[AInstr](out, ai_sub_imm(A_SP(), 256));
    push[AInstr](out, ai_mov_rr(A_X28(), A_SP()));
    push[AInstr](out, ai_add_imm(A_X28(), 192));

    // write ptr x1 = OUTBUF (SP+0)
    push[AInstr](out, ai_mov_rr(A_X1(), A_SP()));

    // sign
    push[AInstr](out, ai_cmp_imm(A_X0(), 0));
    push[AInstr](out, ai_jge(l_nosign));
    apf_putc(out, 45);
    push[AInstr](out, ai_label(l_nosign));
    // abs bits: x2 = x0 & 0x7FFF...
    push[AInstr](out, ai_mov_rr(A_X2(), A_X0()));
    push[AInstr](out, ai_mov_imm(A_X9(), 9223372036854775807));
    push[AInstr](out, ai_andr(A_X2(), A_X9()));
    push[AInstr](out, ai_cmp_imm(A_X2(), 0));
    push[AInstr](out, ai_jne(l_nonzero));
    apf_putc(out, 48);
    push[AInstr](out, ai_jmp(l_finish));

    push[AInstr](out, ai_label(l_nonzero));
    push[AInstr](out, ai_fmov_dx(0, A_X2()));           // d0 = |V|
    push[AInstr](out, ai_mov_imm(A_X5(), 0));           // x5 = exp10
    push[AInstr](out, ai_mov_imm(A_X2(), 4621819117588971520));   // 10.0
    push[AInstr](out, ai_fmov_dx(1, A_X2()));
    // while V >= 10: V /= 10; exp10++
    push[AInstr](out, ai_label(l_nhi));
    push[AInstr](out, ai_fcmp(0, 1));
    push[AInstr](out, ai_jl(l_nhi_done));
    push[AInstr](out, ai_fdiv(0, 1));
    push[AInstr](out, ai_add_imm(A_X5(), 1));
    push[AInstr](out, ai_jmp(l_nhi));
    push[AInstr](out, ai_label(l_nhi_done));
    push[AInstr](out, ai_mov_imm(A_X2(), 4607182418800017408));   // 1.0
    push[AInstr](out, ai_fmov_dx(2, A_X2()));
    // while V < 1: V *= 10; exp10--
    push[AInstr](out, ai_label(l_nlo));
    push[AInstr](out, ai_fcmp(0, 2));
    push[AInstr](out, ai_jge(l_nlo_done));
    push[AInstr](out, ai_fmul(0, 1));
    push[AInstr](out, ai_sub_imm(A_X5(), 1));
    push[AInstr](out, ai_jmp(l_nlo));
    push[AInstr](out, ai_label(l_nlo_done));

    // D = trunc(V*1e5 + 0.5)
    push[AInstr](out, ai_mov_imm(A_X2(), 4681608360884174848));   // 1e5
    push[AInstr](out, ai_fmov_dx(3, A_X2()));
    push[AInstr](out, ai_fmul(0, 3));
    push[AInstr](out, ai_mov_imm(A_X2(), 4602678819172646912));   // 0.5
    push[AInstr](out, ai_fmov_dx(3, A_X2()));
    push[AInstr](out, ai_fadd(0, 3));
    push[AInstr](out, ai_fcvtzs(A_X2(), 0));            // x2 = D
    // carry fix
    push[AInstr](out, ai_cmp_imm(A_X2(), 1000000));
    push[AInstr](out, ai_jl(l_dok));
    push[AInstr](out, ai_mov_imm(A_X9(), 10));
    push[AInstr](out, ai_sdiv(A_X2(), A_X2(), A_X9()));
    push[AInstr](out, ai_add_imm(A_X5(), 1));
    push[AInstr](out, ai_label(l_dok));

    // peel 6 digits into ds[5..0] (SP+128+8i)
    push[AInstr](out, ai_mov_imm(A_X3(), 10));
    let dsl: i32 = 5;
    while (dsl >= 0) {
        push[AInstr](out, ai_sdiv(A_X4(), A_X2(), A_X3()));
        push[AInstr](out, ai_mul(A_X7(), A_X4(), A_X3()));
        push[AInstr](out, ai_sub(A_X2(), A_X7()));
        push[AInstr](out, ai_store(A_SP(), 128 + 8 * dsl, A_X2()));
        push[AInstr](out, ai_mov_rr(A_X2(), A_X4()));
        dsl = dsl - 1;
    }

    // last = highest i in 0..5 with ds[i] != 0
    push[AInstr](out, ai_mov_imm(A_X3(), 5));
    push[AInstr](out, ai_mov_rr(A_X6(), A_SP()));
    push[AInstr](out, ai_add_imm(A_X6(), 128 + 40));
    push[AInstr](out, ai_label(l_last));
    push[AInstr](out, ai_cmp_imm(A_X3(), 0));
    push[AInstr](out, ai_jle(l_last_done));
    push[AInstr](out, ai_load(A_X2(), A_X6(), 0));
    push[AInstr](out, ai_cmp_imm(A_X2(), 0));
    push[AInstr](out, ai_jne(l_last_done));
    push[AInstr](out, ai_sub_imm(A_X3(), 1));
    push[AInstr](out, ai_sub_imm(A_X6(), 8));
    push[AInstr](out, ai_jmp(l_last));
    push[AInstr](out, ai_label(l_last_done));
    push[AInstr](out, ai_mov_rr(A_X7(), A_X3()));       // x7 = last

    // scientific iff exp10 < -4 or exp10 >= 6
    push[AInstr](out, ai_cmp_imm(A_X5(), 0 - 4));
    push[AInstr](out, ai_jl(l_sci));
    push[AInstr](out, ai_cmp_imm(A_X5(), 6));
    push[AInstr](out, ai_jge(l_sci));
    // FIXED
    push[AInstr](out, ai_cmp_imm(A_X5(), 0));
    push[AInstr](out, ai_jl(l_fixed_neg));
    // integer part ds[0..exp10]
    push[AInstr](out, ai_mov_rr(A_X6(), A_SP()));
    push[AInstr](out, ai_add_imm(A_X6(), 128));
    push[AInstr](out, ai_mov_imm(A_X3(), 0));
    push[AInstr](out, ai_label(l_fi_int));
    push[AInstr](out, ai_cmp(A_X3(), A_X5()));
    push[AInstr](out, ai_jg(l_fi_int_d));
    apf_put_ds(out);
    push[AInstr](out, ai_add_imm(A_X6(), 8));
    push[AInstr](out, ai_add_imm(A_X3(), 1));
    push[AInstr](out, ai_jmp(l_fi_int));
    push[AInstr](out, ai_label(l_fi_int_d));
    // fraction ds[exp10+1..last] iff last > exp10
    push[AInstr](out, ai_cmp(A_X7(), A_X5()));
    push[AInstr](out, ai_jle(l_fixdone));
    apf_putc(out, 46);
    push[AInstr](out, ai_mov_rr(A_X3(), A_X5()));
    push[AInstr](out, ai_add_imm(A_X3(), 1));
    push[AInstr](out, ai_label(l_fi_frac));
    push[AInstr](out, ai_cmp(A_X3(), A_X7()));
    push[AInstr](out, ai_jg(l_fixdone));
    apf_put_ds(out);
    push[AInstr](out, ai_add_imm(A_X6(), 8));
    push[AInstr](out, ai_add_imm(A_X3(), 1));
    push[AInstr](out, ai_jmp(l_fi_frac));
    push[AInstr](out, ai_label(l_fixdone));
    push[AInstr](out, ai_jmp(l_finish));

    // FIXED, exp10 < 0: "0." + zeros + ds[0..last]
    push[AInstr](out, ai_label(l_fixed_neg));
    apf_putc(out, 48);
    apf_putc(out, 46);
    push[AInstr](out, ai_mov_imm(A_X3(), 0));
    push[AInstr](out, ai_sub(A_X3(), A_X5()));
    push[AInstr](out, ai_sub_imm(A_X3(), 1));
    push[AInstr](out, ai_label(l_nz));
    push[AInstr](out, ai_cmp_imm(A_X3(), 0));
    push[AInstr](out, ai_jle(l_nz_done));
    apf_putc(out, 48);
    push[AInstr](out, ai_sub_imm(A_X3(), 1));
    push[AInstr](out, ai_jmp(l_nz));
    push[AInstr](out, ai_label(l_nz_done));
    push[AInstr](out, ai_mov_rr(A_X6(), A_SP()));
    push[AInstr](out, ai_add_imm(A_X6(), 128));
    push[AInstr](out, ai_mov_imm(A_X3(), 0));
    push[AInstr](out, ai_label(l_ndig));
    push[AInstr](out, ai_cmp(A_X3(), A_X7()));
    push[AInstr](out, ai_jg(l_finish));
    apf_put_ds(out);
    push[AInstr](out, ai_add_imm(A_X6(), 8));
    push[AInstr](out, ai_add_imm(A_X3(), 1));
    push[AInstr](out, ai_jmp(l_ndig));

    // SCIENTIFIC
    push[AInstr](out, ai_label(l_sci));
    push[AInstr](out, ai_mov_rr(A_X6(), A_SP()));
    push[AInstr](out, ai_add_imm(A_X6(), 128));
    apf_put_ds(out);
    push[AInstr](out, ai_add_imm(A_X6(), 8));
    push[AInstr](out, ai_cmp_imm(A_X7(), 1));
    push[AInstr](out, ai_jl(l_sci_e));
    apf_putc(out, 46);
    push[AInstr](out, ai_mov_imm(A_X3(), 1));
    push[AInstr](out, ai_label(l_scifrac));
    push[AInstr](out, ai_cmp(A_X3(), A_X7()));
    push[AInstr](out, ai_jg(l_sci_e));
    apf_put_ds(out);
    push[AInstr](out, ai_add_imm(A_X6(), 8));
    push[AInstr](out, ai_add_imm(A_X3(), 1));
    push[AInstr](out, ai_jmp(l_scifrac));
    push[AInstr](out, ai_label(l_sci_e));
    apf_putc(out, 101);
    push[AInstr](out, ai_cmp_imm(A_X5(), 0));
    push[AInstr](out, ai_jl(l_sci_eneg));
    apf_putc(out, 43);
    push[AInstr](out, ai_mov_rr(A_X2(), A_X5()));
    push[AInstr](out, ai_jmp(l_sci_emit));
    push[AInstr](out, ai_label(l_sci_eneg));
    apf_putc(out, 45);
    push[AInstr](out, ai_mov_imm(A_X2(), 0));
    push[AInstr](out, ai_sub(A_X2(), A_X5()));
    push[AInstr](out, ai_label(l_sci_emit));
    push[AInstr](out, ai_cmp_imm(A_X2(), 10));
    push[AInstr](out, ai_jge(l_sci_ebig));
    // e in [0,9]: "0" + digit (apf_putc clobbers x2 — save in x4)
    push[AInstr](out, ai_mov_rr(A_X4(), A_X2()));
    apf_putc(out, 48);
    push[AInstr](out, ai_add_imm(A_X4(), 48));
    push[AInstr](out, ai_storeb(A_X1(), 0, A_X4()));
    push[AInstr](out, ai_add_imm(A_X1(), 1));
    push[AInstr](out, ai_jmp(l_finish));
    // e >= 10: peel digits onto the expression stack, pop MSB-first
    push[AInstr](out, ai_label(l_sci_ebig));
    push[AInstr](out, ai_mov_imm(A_X3(), 0));
    push[AInstr](out, ai_mov_imm(A_X9(), 10));
    push[AInstr](out, ai_label(l_sci_peel));
    push[AInstr](out, ai_cmp_imm(A_X2(), 0));
    push[AInstr](out, ai_je(l_sci_pop));
    push[AInstr](out, ai_sdiv(A_X4(), A_X2(), A_X9()));
    push[AInstr](out, ai_mul(A_X10(), A_X4(), A_X9()));
    push[AInstr](out, ai_sub(A_X2(), A_X10()));
    push[AInstr](out, ai_add_imm(A_X2(), 48));
    push[AInstr](out, ai_push(A_X2()));
    push[AInstr](out, ai_mov_rr(A_X2(), A_X4()));
    push[AInstr](out, ai_add_imm(A_X3(), 1));
    push[AInstr](out, ai_jmp(l_sci_peel));
    push[AInstr](out, ai_label(l_sci_pop));
    push[AInstr](out, ai_cmp_imm(A_X3(), 0));
    push[AInstr](out, ai_je(l_finish));
    push[AInstr](out, ai_pop(A_X2()));
    push[AInstr](out, ai_storeb(A_X1(), 0, A_X2()));
    push[AInstr](out, ai_add_imm(A_X1(), 1));
    push[AInstr](out, ai_sub_imm(A_X3(), 1));
    push[AInstr](out, ai_jmp(l_sci_pop));

    // FINISH: '\n', write(1, OUTBUF, len)
    push[AInstr](out, ai_label(l_finish));
    apf_putc(out, 10);
    push[AInstr](out, ai_mov_rr(A_X2(), A_X1()));
    push[AInstr](out, ai_mov_rr(A_X1(), A_SP()));
    push[AInstr](out, ai_sub(A_X2(), A_X1()));          // len
    push[AInstr](out, ai_mov_imm(A_X8(), 64));
    push[AInstr](out, ai_mov_imm(A_X0(), 1));
    push[AInstr](out, ai_svc());

    push[AInstr](out, ai_mov_rr(A_SP(), A_X29()));
    push[AInstr](out, ai_load(A_X29(), A_SP(), 0));
    push[AInstr](out, ai_load(A_X30(), A_SP(), 8));
    push[AInstr](out, ai_load(A_X28(), A_SP(), 16));
    push[AInstr](out, ai_add_imm(A_SP(), 32));
    push[AInstr](out, ai_ret());
}

fn aload_program(decls0: ArrayList[*Node], errout: *i32, dataout: *ArrayList[u8]) ArrayList[AInstr] {
    let out: ArrayList[AInstr] = make[AInstr](128);
    let top_err: i32 = 0;

    // Reserve the first 16 bytes of the (writable) data segment for the arena
    // allocator's two globals: g_cursor at ADVBASE+0 and g_end at ADVBASE+8.
    // Both start zero (cold arena) from the file image. Reserving here — before
    // any string is interned — shifts every interned offset up by 16 uniformly,
    // and every reference already reads it back as A_DATA_VBASE() + off, so the
    // layout stays self-consistent. dataout is empty at entry for both callers.
    let grsv: i32 = 0;
    while (grsv < 16) { push[u8](dataout, 0); grsv = grsv + 1; }

    // Monomorphize using the x86 backend's target-independent AST passes:
    // infer generic targs, then expand every instantiation to a concrete
    // mangled decl. The ARM lowering only ever sees concrete names.
    cg_ginfer_pass(decls0);
    let decls: ArrayList[*Node] = cg_expand_generics(decls0);

    let syms: ArrayList[AFnSym] = make[AFnSym](8);
    let next_id: i32 = 1;
    let di: i32 = 0;
    while (di < len[*Node](decls)) {
        switch (get[*Node](decls, di).*) {
            .fn_decl => |f| {
                if (len[[]u8](f.tparams) > 0) { }
                else if (f.is_extern == 1) { }
                else if (len[*Node](f.body) == 0) { }
                else {
                    let si: i32 = 0;
                    let found: i32 = 0;
                    while (si < len[AFnSym](syms)) {
                        if (@strEq(get[AFnSym](syms, si).name, f.name)) { found = 1; }
                        si = si + 1;
                    }
                    if (found == 0) {
                        push[AFnSym](&syms, AFnSym{ .name = f.name, .lbl = next_id, .nparams = len[Param](f.params), .ret = cg_norm_type(f.ret) });
                        next_id = next_id + 1;
                    }
                }
            }
            .struct_ => |_s| { }
            .enum_ => |_e| { }
            .union_ => |_u| { }
            else => {
                _zag_eprintln("arm64: skipping unsupported top-level decl");
                top_err = top_err + 1;
            }
        }
        di = di + 1;
    }

    let pi_lbl: i32 = next_id;
    let ps_lbl: i32 = next_id + 1;
    let al_lbl: i32 = next_id + 2;
    let se_lbl: i32 = next_id + 3;
    let rl_lbl: i32 = next_id + 4;
    let is_lbl: i32 = next_id + 5;
    let pf_lbl: i32 = next_id + 6;
    let dz_lbl: i32 = next_id + 7;
    let ms_lbl: i32 = next_id + 8;
    let pb_lbl: i32 = next_id + 9;
    let cc_lbl: i32 = next_id + 10;
    let ar_lbl: i32 = next_id + 11;
    let rf_lbl: i32 = next_id + 12;
    let wf_lbl: i32 = next_id + 13;
    let wx_lbl: i32 = next_id + 14;
    let fe_lbl: i32 = next_id + 15;
    let ex_lbl: i32 = next_id + 16;
    let s2_lbl: i32 = next_id + 17;
    let cg: ACg = ACg{
        .next = next_id + 18,
        .err = top_err,
        .data = dataout,
        .pi_lbl = pi_lbl,
        .ps_lbl = ps_lbl,
        .al_lbl = al_lbl,
        .se_lbl = se_lbl,
        .rl_lbl = rl_lbl,
        .is_lbl = is_lbl,
        .pf_lbl = pf_lbl,
        .dz_lbl = dz_lbl,
        .ms_lbl = ms_lbl,
        .pb_lbl = pb_lbl,
        .cc_lbl = cc_lbl,
        .ar_lbl = ar_lbl,
        .rf_lbl = rf_lbl,
        .wf_lbl = wf_lbl,
        .wx_lbl = wx_lbl,
        .fe_lbl = fe_lbl,
        .ex_lbl = ex_lbl,
        .s2_lbl = s2_lbl,
        .use_pi = 0,
        .use_ps = 0,
        .use_al = 0,
        .use_se = 0,
        .use_rl = 0,
        .use_is = 0,
        .use_pf = 0,
        .use_dz = 0,
        .use_ms = 0,
        .use_pb = 0,
        .use_cc = 0,
        .use_ar = 0,
        .use_rf = 0,
        .use_wf = 0,
        .use_wx = 0,
        .use_fe = 0,
        .use_ex = 0,
        .use_s2 = 0,
        .frame_words = 0,
        .epilogue = 0,
        .sret_disp = 0,
        .sret_words = 0,
        .ret_ty = "",
        .nl_off = 0 - 1,
        .decls = decls,
    };

    let main_lbl: i32 = ac_find_fn(syms, "main");
    if (main_lbl < 0) {
        _zag_eprintln("arm64: no main function found");
        cg.err = cg.err + 1;
        errout.* = cg.err;
        push[AInstr](&out, ai_mov_imm(A_X0(), 0));
        push[AInstr](&out, ai_mov_imm(A_X8(), 93));
        push[AInstr](&out, ai_svc());
        return out;
    }

    // _start: call main; exit(main_ret) via syscall 93.
    // x27 = initial SP ([x27]=argc, [x27+8+8i]=argv[i], envp after the argv
    // NULL) — x27 is never touched by prologues or routines, unlike x28 which
    // every function repurposes as its expression-stack base.
    push[AInstr](&out, ai_mov_rr(A_X27(), A_SP()));
    push[AInstr](&out, ai_call(main_lbl));
    push[AInstr](&out, ai_mov_imm(A_X8(), 93));
    push[AInstr](&out, ai_svc());

    di = 0;
    while (di < len[*Node](decls)) {
        switch (get[*Node](decls, di).*) {
            .fn_decl => |f| {
                if (f.is_extern == 0 && len[[]u8](f.tparams) == 0 && len[*Node](f.body) > 0) {
                    let lbl: i32 = ac_find_fn(syms, f.name);
                    ac_lower_fn(&out, f, lbl, syms, &cg);
                }
            }
            else => { }
        }
        di = di + 1;
    }

    // dependency closure: slice-building routines pull in __make_slice, the
    // file/exec routines pull in __pathbuf, and everything that allocates
    // pulls in __malloc (checked in the alloc emit condition below).
    if (cg.use_cc == 1 || cg.use_ar == 1 || cg.use_rf == 1) { cg.use_ms = 1; }
    if (cg.use_rf == 1 || cg.use_wf == 1 || cg.use_wx == 1 || cg.use_fe == 1 || cg.use_ex == 1) { cg.use_pb = 1; }
    if (cg.use_rf == 1) { cg.use_rl = 1; }

    if (cg.use_pi == 1) { ac_emit_print_int(&out, cg.pi_lbl, &cg); }
    if (cg.use_ps == 1) { ac_emit_print_str(&out, cg.ps_lbl); }
    if (cg.use_al == 1 || cg.use_rl == 1 || cg.use_is == 1 || cg.use_ms == 1 || cg.use_pb == 1 || cg.use_cc == 1) { ac_emit_alloc(&out, cg.al_lbl, &cg); }
    if (cg.use_se == 1) { ac_emit_streq(&out, cg.se_lbl, &cg); }
    if (cg.use_rl == 1) { ac_emit_realloc(&out, cg.rl_lbl, &cg); }
    if (cg.use_is == 1) { ac_emit_i64s(&out, cg.is_lbl, &cg); }
    if (cg.use_pf == 1) { ac_emit_print_f64(&out, cg.pf_lbl, &cg); }
    if (cg.use_dz == 1) { ac_emit_div0(&out, cg.dz_lbl, &cg); }
    if (cg.use_ms == 1) { ac_emit_make_slice(&out, cg.ms_lbl, &cg); }
    if (cg.use_pb == 1) { ac_emit_pathbuf(&out, cg.pb_lbl, &cg); }
    if (cg.use_cc == 1) { ac_emit_concat(&out, cg.cc_lbl, &cg); }
    if (cg.use_ar == 1) { ac_emit_argslice(&out, cg.ar_lbl, &cg); }
    if (cg.use_rf == 1) { ac_emit_read_file(&out, cg.rf_lbl, &cg); }
    if (cg.use_wf == 1) { ac_emit_write_file(&out, cg.wf_lbl, 0, &cg); }
    if (cg.use_wx == 1) { ac_emit_write_file(&out, cg.wx_lbl, 1, &cg); }
    if (cg.use_fe == 1) { ac_emit_file_exists(&out, cg.fe_lbl, &cg); }
    if (cg.use_ex == 1) { ac_emit_exec_cmd(&out, cg.ex_lbl, &cg); }
    if (cg.use_s2 == 1) { ac_emit_str2i(&out, cg.s2_lbl, &cg); }

    errout.* = cg.err;
    return out;
}
