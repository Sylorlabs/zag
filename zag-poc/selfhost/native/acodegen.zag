// selfhost/native/acodegen.zag — AArch64 codegen (Phase-2 subset).
//
// Mirrors the x86 backend's data model (see ncodegen.zag):
//   • uniform 8-byte fields; aggregates evaluate to their block ADDRESS
//   • locals: INLINE (slot block, lea) or BY-REF (slot holds pointer)
//   • slices are {ptr@0, len@8}; []u8 data is byte-packed
//   • aggregate args are caller-copied, passed by address
//   • aggregate returns via hidden sret pointer in x8 (AAPCS64)
//   • heap = size-class arenas plus dedicated mappings with real release
//
// Supports: i32/i64/u8 arithmetic, control flow, fn calls (≤8 args),
// structs, pointers (& / .* / new / delete), []u8 + word slices (len,
// index, subslice), enums (member consts, ==, switch without captures),
// print_int/print_i32/print_str/_zag_print/_zag_println.

@import("aisa.zag")
@import("process_wait_arm64.zag")
@import("../parse.zag")
@import("../vsa_type.zag")

fn ac_parse_i64(s: []u8) i64 {
    let i: i32 = 0;
    let neg: i32 = 0;
    if (s.len > 0) {
        if (s[0] == '-') { neg = 1; i = 1; }
        else if (s[0] == '+') { i = 1; }
    }
    // hex literal 0x… (base 16); keeps arm64 output identical to x86.
    if (i + 1 < s.len && s[i] == '0' && (s[i + 1] == 'x' || s[i + 1] == 'X')) {
        i = i + 2;
        let hacc: i64 = 0;
        while (i < s.len) {
            let hc: u8 = s[i];
            if (hc == '_') { i = i + 1; }
            else {
                let hv: i64 = 0 - 1;
                if (hc >= '0' && hc <= '9') { hv = (hc as i64) - 48; }
                else if (hc >= 'a' && hc <= 'f') { hv = (hc as i64) - 87; }
                else if (hc >= 'A' && hc <= 'F') { hv = (hc as i64) - 55; }
                if (hv >= 0) { hacc = hacc * 16 + hv; }
                i = i + 1;
            }
        }
        if (neg == 1) { return 0 - hacc; }
        return hacc;
    }
    let acc: i64 = 0;
    while (i < s.len) {
        let c: u8 = s[i];
        if (c == '_') { i = i + 1; }
        else if (c >= 48 && c <= 57) {
            acc = acc * 10 + (c as i64) - 48;
            i = i + 1;
        } else { i = i + 1; }
    }
    if (neg == 1) { return 0 - acc; }
    return acc;
}

fn ac_is_int_text(s: []u8) i32 {
    let i: i32 = 0;
    if (s.len > 0) {
        if (s[0] == '-' || s[0] == '+') { i = 1; }
    }
    if (i >= s.len) { return 0; }
    if (i + 1 < s.len && s[i] == '0' && (s[i + 1] == 'x' || s[i + 1] == 'X')) {
        let h: i32 = i + 2;
        if (h >= s.len) { return 0; }
        while (h < s.len) {
            let c: u8 = s[h];
            let ok: bool = (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F') || c == '_';
            if (!ok) { return 0; }
            h = h + 1;
        }
        return 1;
    }
    let digits: i32 = 0;
    while (i < s.len) {
        let c: u8 = s[i];
        if (c == '_') { i = i + 1; }
        else if (c >= 48 && c <= 57) { digits = digits + 1; i = i + 1; }
        else { return 0; }
    }
    if (digits == 0) { return 0; }
    return 1;
}

// Linux-numbered raw syscalls occur in a few portable runtime modules.  They
// are not the same namespace as the backend's normal AK_SYSCALL identifiers:
// for example Linux 57 is fork there but close in the AArch64 ABI table.
// Translate only the audited process/runtime subset when producing Mach-O.
fn ac_darwin_raw_linux_num(n: i32) i32 {
    if (n == 0) { return 3; }     // read
    if (n == 1) { return 4; }     // write
    if (n == 3) { return 6; }     // close
    if (n == 39) { return 20; }   // x86-64 getpid -> Darwin getpid
    if (n == 72) { return 92; }   // x86-64 fcntl -> Darwin fcntl
    if (n == 33) { return 90; }   // dup2
    if (n == 35) { return 93; }   // nanosleep -> select timeout
    if (n == 57) { return 2; }    // fork
    if (n == 59) { return 59; }   // execve
    if (n == 61) { return 7; }    // wait4
    if (n == 62) { return 37; }   // kill
    if (n == 10) { return 74; }   // mprotect
    if (n == 109) { return 82; }  // setpgid
    if (n == 293) { return 42; }  // pipe2 -> pipe
    return 0 - 1;
}

// Path mutation calls need argument and flag translation in addition to a
// syscall-number mapping. Keep them out of ac_darwin_raw_linux_num so they
// cannot accidentally bypass ac_emit_darwin_fs_syscall below.
fn ac_is_darwin_fs_raw_num(n: i32) i32 {
    if (n == 2 || n == 5 || n == 74) { return 1; }
    if (n == 82 || n == 83 || n == 84 || n == 87) { return 1; }
    if (n == 258 || n == 262 || n == 263 || n == 264) { return 1; }
    return 0;
}

// std:net_ipv4 carries Linux x86-64 socket identities and layouts at its raw
// boundary. Darwin admits only the exact IPv4 tuples implemented by the
// adapter below; every other socket family, option, flag, and shape remains
// ENOSYS rather than aliasing an unrelated XNU operation.
fn ac_is_darwin_net_raw_num(n: i32) i32 {
    if (n == 7 || n == 41 || n == 42 || n == 44 || n == 45) { return 1; }
    if (n == 49 || n == 50 || n == 51 || n == 54 || n == 55 || n == 288) {
        return 1;
    }
    return 0;
}

// Return a non-negative 31-bit literal or -1. Parsing into i64 before the
// range check prevents a large source value from wrapping into an audited
// syscall identity when narrowed to i32.
fn ac_nonnegative_i32_literal(n: *Node) i32 {
    let value: i64 = 0 - 1;
    switch (n.*) {
        .ilit => |lit| { if (ac_is_int_text(lit.text) == 1) { value = ac_parse_i64(lit.text); } }
        else => { }
    }
    if (value < 0 || value > 2147483647) { return 0 - 1; }
    return value as i32;
}

// 'x' / '\n' single-char literal → value, or -1 if not a char literal.
fn ac_char_lit_val(s: []u8) i64 {
    if (s.len < 3) { return 0 - 1; }
    if (s[0] != 39) { return 0 - 1; }
    if (s[1] == 92 && s.len >= 4) {
        let e: u8 = s[2];
        if (e == 'n') { return 10; }
        if (e == 't') { return 9; }
        if (e == 'r') { return 13; }
        if (e == '0') { return 0; }
        if (e == 92) { return 92; }
        if (e == 39) { return 39; }
        return e as i64;
    }
    return s[1] as i64;
}

fn ac_hex_digit(c: u8) i64 {
    if (c >= '0' && c <= '9') { return (c as i64) - 48; }
    if (c >= 'a' && c <= 'f') { return (c as i64) - 87; }
    if (c >= 'A' && c <= 'F') { return (c as i64) - 55; }
    return 0;
}

fn ac_decode_str(text: []u8, out: *ArrayList[u8]) void {
    let n: i32 = text.len;
    let i: i32 = 0;
    let j: i32 = n;
    if (n >= 2) {
        if (text[0] == 34) { i = 1; }
        if (text[n - 1] == 34) { j = n - 1; }
    }
    while (i < j) {
        let c: u8 = text[i];
        if (c == 92 && i + 1 < j) {
            let e: u8 = text[i + 1];
            if (e == 'n') { push[u8](out, 10); }
            else if (e == 't') { push[u8](out, 9); }
            else if (e == 'r') { push[u8](out, 13); }
            else if (e == '0') { push[u8](out, 0); }
            else if (e == 'x' && i + 3 < j) {
                let value: i64 = ac_hex_digit(text[i + 2]) * 16 +
                    ac_hex_digit(text[i + 3]);
                push[u8](out, value as u8);
                i = i + 2;
            }
            else { push[u8](out, e); }
            i = i + 2;
        } else {
            push[u8](out, c);
            i = i + 1;
        }
    }
}

fn ac_decoded_len(text: []u8) i32 {
    let tmp: ArrayList[u8] = make[u8](text.len + 1);
    ac_decode_str(text, &tmp);
    return len[u8](tmp);
}

struct AFnSym { name: []u8, lbl: i32, nparams: i32, ret: []u8, extern_index: i32 }

fn AC_EXPR_WORDS() i32 { return 48; }

// Locals: INLINE aggregates own `words` contiguous slots; BY-REF locals own
// one word holding a pointer to a block elsewhere (aggregate params).
struct AEnv {
    names: ArrayList[[]u8],
    disps: ArrayList[i32],
    types: ArrayList[[]u8],
    byref: ArrayList[i32],
    break_lbls: ArrayList[i32],
    continue_lbls: ArrayList[i32],
    defer_exprs: ArrayList[*Node],
    errdefer_exprs: ArrayList[*Node],
    async_task_disps: ArrayList[i32],
    is_err_slot: i32,
}

struct ACg {
    next: i32,
    err: i32,
    target_os: i32,    // 0 = Linux ELF, 1 = macOS Mach-O
    data: *ArrayList[u8],
    pi_lbl: i32,
    ps_lbl: i32,
    al_lbl: i32,
    se_lbl: i32,
    rl_lbl: i32,
    is_lbl: i32,
    pf_lbl: i32,
    dz_lbl: i32,
    ms_lbl: i32,    // __make_slice(x0=ptr, x1=len) -> x0=&{ptr,len}
    pb_lbl: i32,    // __pathbuf(x0=&slice) -> x0=NUL-terminated cstr
    cc_lbl: i32,    // __concat(x0=&a, x1=&b) -> x0=&{ptr,len}
    ar_lbl: i32,    // __arg(x0=i) -> x0=&{ptr,len}
    rf_lbl: i32,    // __read_file(x0=&path) -> x0=&{ptr,len}
    wf_lbl: i32,    // __write_file(x0=&path, x1=&content) -> x0=0/-1
    wx_lbl: i32,    // __write_exec: write_file + chmod 0755
    fe_lbl: i32,    // __file_exists(x0=&path) -> x0=0/1
    ex_lbl: i32,    // __exec_cmd(x0=&cmd) -> x0=child exit status
    ec_lbl: i32,    // __exec_capture(x0=&cmd) -> x0=&{ptr,len}
    s2_lbl: i32,    // __str_to_i64(x0=&s) -> x0
    du_lbl: i32,    // __strdup(x0=&s) -> x0=&{ptr,len}
    so_lbl: i32,    // __strcmp_ord(x0=&a, x1=&b) -> x0
    ix_lbl: i32,    // __str_index_of_byte(x0=&s, x1=byte) -> x0
    mc_lbl: i32,    // __memcpy(x0=dst, x1=src, x2=n) -> x0=dst
    mm_lbl: i32,    // __memcmp(x0=a, x1=b, x2=n) -> x0
    ge_lbl: i32,    // __getenv(x0=&name) -> x0=&{ptr,len}
    u2_lbl: i32,    // __u64_to_str(x0=v) -> x0=&{ptr,len}
    pu_lbl: i32,    // label of the __print_uint support routine (print_u64/print_u32)
    use_pi: i32,
    use_pu: i32,
    use_ps: i32,
    use_al: i32,
    use_se: i32,
    use_rl: i32,
    use_is: i32,
    use_pf: i32,
    use_dz: i32,
    use_ms: i32,
    use_pb: i32,
    use_cc: i32,
    use_ar: i32,
    use_rf: i32,
    use_wf: i32,
    use_wx: i32,
    use_fe: i32,
    use_ex: i32,
    use_ec: i32,
    use_s2: i32,
    use_du: i32,
    use_so: i32,
    use_ix: i32,
    use_mc: i32,
    use_mm: i32,
    use_ge: i32,
    use_u2: i32,
    frame_words: i32,
    epilogue: i32,
    current_lbl: i32, // function being lowered; native code-address anchor
    pre_epilogue: i32,
    sret_disp: i32,     // frame disp of the saved x8 sret pointer (0 = none)
    sret_words: i32,    // words of the aggregate being returned (0 = scalar)
    ret_ty: []u8,       // current fn's return type
    nl_off: i32,        // data offset of the interned "\n" (-1 = not yet)
    decls: ArrayList[*Node],
    v2_edition: i32,    // 1 when the project is edition 2027 (v2 ownership rules)
    safety_checked: i32, // emit edition-2027 raw-pointer null/alignment guards
    sanitize_memory: i32, // checked provenance plus exit-time leak failure
    object_mode: i32,   // ET_REL mode; direct foreign calls become relocations
    dynamic_mode: i32,  // explicit shared-library ABI mode (never implicit)
    dynamic_names: *ArrayList[[]u8], // GOT slots, in declaration order
    globals: *ArrayList[GlobalSym], // explicit zero-initialized v2 scalar globals
}

fn AC_OS_LINUX() i32 { return 0; }
fn AC_OS_MACOS() i32 { return 1; }

fn ac_fresh(cg: *ACg) i32 {
    let id: i32 = cg.*.next;
    cg.*.next = cg.*.next + 1;
    return id;
}

fn ac_err(cg: *ACg, msg: []u8) void {
    _zag_eprintln(msg);
    cg.*.err = cg.*.err + 1;
}

// ── v2 global symbol helpers (mirror cg_global_* but for ACg) ──────────────
fn ac_global_find(cg: *ACg, name: []u8) i32 {
    let i: i32 = 0;
    while (i < cg.*.globals.*.len) {
        if (@strEq(get[GlobalSym](cg.*.globals.*, i).name, name)) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn ac_global_addr(cg: *ACg, name: []u8) i64 {
    let i: i32 = ac_global_find(cg, name);
    if (i < 0) { return 0; }
    return get[GlobalSym](cg.*.globals.*, i).addr;
}

// ELF globals retain their fixed BSS addresses. Mach-O globals are offsets
// into the image's writable data segment and must follow its ASLR slide.
fn ac_emit_global_address(out: *ArrayList[AInstr], cg: *ACg, address: i64) void {
    if (cg.*.target_os == AC_OS_MACOS()) {
        push[AInstr](out, ai_data_addr(A_X0(), address as i32));
    } else {
        push[AInstr](out, ai_mov_imm(A_X0(), address));
    }
}

// ── dynamic/object mode helpers ────────────────────────────────────────────
fn ac_dynamic_got_vaddr() i64 { return 150994944; } // 0x9000000 (matches x86 GOT)

fn ac_dynamic_index(cg: *ACg, name: []u8) i32 {
    if (cg.*.dynamic_mode == 0 && cg.*.object_mode == 0) { return 0 - 1; }
    let i: i32 = 0;
    while (i < cg.*.dynamic_names.*.len) {
        if (@strEq(get[[]u8](cg.*.dynamic_names.*, i), name)) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// Collect v2 global symbols into the ACg globals list (mirrors cg_collect_globals
// but uses ACg's ac_is_aggregate / ac_err).
fn ac_collect_globals(decls: ArrayList[*Node], cg: *ACg, out: *ArrayList[GlobalSym]) void {
    let i: i32 = 0;
    while (i < decls.len) {
        switch (decls.data[i].*) {
            .let_ => |l| {
                if (l.is_global == 1) {
                    let ty: []u8 = cg_norm_type(l.dty);
                    if (l.has_dty == 0 || ty.len == 0 ||
                        ac_is_aggregate(cg, ty) == 1 || cg_is_fn_type(ty) == 1) {
                        ac_err(cg, "arm64: global storage currently supports only explicitly typed scalar values");
                    } else if (cg_global_zero_initializer(l) == 0) {
                        ac_err(cg, "arm64: global storage currently requires zero initialization");
                    } else if (out.*.len >= CG_GLOBAL_CAP()) {
                        ac_err(cg, "arm64: global storage capacity exhausted");
                    } else {
                        let gi: i32 = 0;
                        let duplicate: i32 = 0;
                        while (gi < out.*.len) {
                            if (@strEq(out.*.data[gi].name, l.name)) { duplicate = 1; }
                            gi = gi + 1;
                        }
                        if (duplicate == 1) { ac_err(cg, "arm64: duplicate global declaration"); }
                        else {
                            let address: i64 = CG_GLOBAL_BASE() + ((out.*.len as i64) * 8);
                            if (cg.*.target_os == AC_OS_MACOS()) {
                                // Reserve real zero-filled cells after all runtime
                                // registries and before literals are interned.
                                address = cg.*.data.*.len as i64;
                                let byte: i32 = 0;
                                while (byte < 8) {
                                    push[u8](cg.*.data, 0);
                                    byte = byte + 1;
                                }
                            }
                            push[GlobalSym](out, GlobalSym{ .name = l.name, .ty = ty, .addr = address });
                        }
                    }
                }
            }
            else => { }
        }
        i = i + 1;
    }
}

fn ac_align16(n: i32) i32 {
    let r: i32 = n % 16;
    if (r == 0) { return n; }
    return n + (16 - r);
}

fn ac_round8(n: i32) i32 {
    let r: i32 = n % 8;
    if (r == 0) { return n; }
    return n + (8 - r);
}

fn ac_align_up(n: i32, alignment: i32) i32 {
    if (alignment <= 1) { return n; }
    let r: i32 = n % alignment;
    if (r == 0) { return n; }
    return n + (alignment - r);
}

fn ac_env_new() AEnv {
    return AEnv{
        .names = make[[]u8](8),
        .disps = make[i32](8),
        .types = make[[]u8](8),
        .byref = make[i32](8),
        .break_lbls = make[i32](4),
        .continue_lbls = make[i32](4),
        .defer_exprs = make[*Node](4),
        .errdefer_exprs = make[*Node](4),
        .async_task_disps = make[i32](4),
        .is_err_slot = 0,
    };
}

fn ac_env_dispose(env: *AEnv) void {
    free[[]u8](&env.*.names);
    free[i32](&env.*.disps);
    free[[]u8](&env.*.types);
    free[i32](&env.*.byref);
    free[i32](&env.*.break_lbls);
    free[i32](&env.*.continue_lbls);
    free[*Node](&env.*.defer_exprs);
    free[*Node](&env.*.errdefer_exprs);
    free[i32](&env.*.async_task_disps);
}

fn ac_loop_push(env: *AEnv, break_lbl: i32, continue_lbl: i32) void {
    push[i32](&env.*.break_lbls, break_lbl);
    push[i32](&env.*.continue_lbls, continue_lbl);
}
fn ac_loop_pop(env: *AEnv) void {
    if (env.*.break_lbls.len > 0) { env.*.break_lbls.len = env.*.break_lbls.len - 1; }
    if (env.*.continue_lbls.len > 0) { env.*.continue_lbls.len = env.*.continue_lbls.len - 1; }
}
fn ac_loop_top(labels: ArrayList[i32]) i32 {
    if (labels.len == 0) { return 0 - 1; }
    return get[i32](labels,labels.len - 1);
}

// ── type registry ────────────────────────────────────────────────────────────

fn ac_find_struct(cg: *ACg, name: []u8, out: *StructDecl) i32 {
    let i: i32 = 0;
    while (i < len[*Node](cg.*.decls)) {
        switch (get[*Node](cg.*.decls, i).*) {
            .struct_ => |sd| {
                if (@strEq(sd.name, name)) { out.* = sd; return 1; }
            }
            else => { }
        }
        i = i + 1;
    }
    return 0;
}

fn ac_find_union(cg: *ACg, name: []u8, out: *UnionDecl) i32 {
    let i: i32 = 0;
    while (i < len[*Node](cg.*.decls)) {
        switch (get[*Node](cg.*.decls, i).*) {
            .union_ => |ud| {
                if (@strEq(ud.name, name)) { out.* = ud; return 1; }
            }
            else => { }
        }
        i = i + 1;
    }
    return 0;
}

// Index of member `m` in enum `ename`, or -1 (also -1 if no such enum).
fn ac_enum_member(cg: *ACg, ename: []u8, m: []u8) i32 {
    let i: i32 = 0;
    while (i < len[*Node](cg.*.decls)) {
        switch (get[*Node](cg.*.decls, i).*) {
            .enum_ => |ed| {
                if (@strEq(ed.name, ename)) {
                    let j: i32 = 0;
                    while (j < len[[]u8](ed.members)) {
                        if (@strEq(get[[]u8](ed.members, j), m)) { return j; }
                        j = j + 1;
                    }
                    return 0 - 1;
                }
            }
            else => { }
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn ac_is_enum(cg: *ACg, name: []u8) i32 {
    let i: i32 = 0;
    while (i < len[*Node](cg.*.decls)) {
        switch (get[*Node](cg.*.decls, i).*) {
            .enum_ => |ed| { if (@strEq(ed.name, name)) { return 1; } }
            else => { }
        }
        i = i + 1;
    }
    return 0;
}

fn ac_type_is_slice(ty: []u8) i32 {
    if (ty.len < 3) { return 0; }
    if (ty[0] == 91 && ty[1] == 93) { return 1; }   // "[]"
    return 0;
}

// Union aggregate captures bind by reference, so a []T payload is represented
// as *[]T inside its switch arm.  Consumers that read a slice value can accept
// either spelling: evaluating both yields the address of the {ptr,len} block.
fn ac_type_is_slice_or_ref(ty: []u8) i32 {
    if (ac_type_is_slice(ty) == 1) { return 1; }
    if (ty.len > 1 && ty[0] == '*' && ac_type_is_slice(ty[1..]) == 1) { return 1; }
    return 0;
}

fn ac_slice_elem(ty: []u8) []u8 {
    if (ac_type_is_slice(ty) == 0) { return ""; }
    return ty[2..];
}

fn ac_elem_is_byte(ty: []u8) i32 {
    if (@strEq(ty, "u8")) { return 1; }
    if (@strEq(ty, "i8")) { return 1; }
    return 0;
}

fn ac_type_size(cg: *ACg, ty0: []u8) i32 {
    let ty: []u8 = cg_norm_type(ty0);
    if (ty.len == 0) { return 8; }
    if (ty[0] == '*') { return 8; }
    if (vsa_type_valid(ty) == 1) { return vsa_type_words(ty) * 8; }
    if (ac_type_is_slice(ty) == 1) { return 16; }
    if (@strEq(ty, "fat_fn")) { return 16; }        // {code_ptr, env_ptr}
    if (cg_is_fn_type(ty) == 1) { return 16; }
    if (ty[0] == '!') { return 16; }               // !T error union = {err_code, val}
    if (ty[0] == '?') { return 8 + ac_round8(ac_type_size(cg, ty[1..])); }
    let sd: StructDecl = StructDecl{ .name = "", .fields = make[Param](1), .tparams = make[[]u8](1), .is_pub = 0, .origin = "<root>" };
    if (ac_find_struct(cg, ty, &sd) == 1) {
        if (sd.repr_c == 1) {
            let total_c: i32 = 0;
            let max_align: i32 = 1;
            let ci: i32 = 0;
            while (ci < sd.fields.len) {
                let cp: Param = sd.fields.data[ci];
                let ca: i32 = ac_c_leaf_alignment(cp.pty);
                if (ca > max_align) { max_align = ca; }
                total_c = ac_align_up(total_c, ca);
                total_c = total_c + ac_c_leaf_size(cp.pty);
                ci = ci + 1;
            }
            let explicit_c: i32 = ac_struct_explicit_align(sd);
            if (explicit_c > max_align) { max_align = explicit_c; }
            return ac_align_up(total_c, max_align);
        }
        if (ac_struct_layout_annot(sd, "@repr(packed)") == 1) {
            let packed_size: i32 = 0;
            let pi: i32 = 0;
            while (pi < sd.fields.len) {
                packed_size = packed_size + ac_c_leaf_size(get[Param](sd.fields, pi).pty);
                pi = pi + 1;
            }
            let pa: i32 = ac_struct_explicit_align(sd);
            if (pa > 1) { return ac_align_up(packed_size, pa); }
            return packed_size;
        }
        let total: i32 = 0;
        let i: i32 = 0;
        while (i < len[Param](sd.fields)) {
            total = total + ac_round8(ac_type_size(cg, get[Param](sd.fields, i).pty));
            i = i + 1;
        }
        if (total == 0) { return 8; }
        let explicit: i32 = ac_struct_explicit_align(sd);
        if (explicit > 1) { return ac_align_up(total, explicit); }
        return total;
    }
    let ud: UnionDecl = UnionDecl{ .name = "", .fields = make[Param](1) };
    if (ac_find_union(cg, ty, &ud) == 1) {
        let maxp: i32 = 0;
        let j: i32 = 0;
        while (j < len[Param](ud.fields)) {
            let ps: i32 = ac_round8(ac_type_size(cg, get[Param](ud.fields, j).pty));
            if (ps > maxp) { maxp = ps; }
            j = j + 1;
        }
        if (maxp == 0) { maxp = 8; }
        return 8 + maxp;
    }
    // interface: M fn-ptr slots + 1 data-ptr slot
    let iM: i32 = iface_method_count(cg.*.decls, ty);
    if (iM > 0) { return (iM + 1) * 8; }
    return 8;
}

fn ac_struct_layout_annot(sd: StructDecl, wanted: []u8) i32 {
    let i: i32 = 0;
    while (i < sd.annots.len) {
        if (@strEq(sd.annots.data[i], wanted)) { return 1; }
        i = i + 1;
    }
    return 0;
}
fn ac_struct_explicit_align(sd: StructDecl) i32 {
    let result: i32 = 0;
    let i: i32 = 0;
    while (i < sd.annots.len) {
        let a: []u8 = sd.annots.data[i];
        if (a.len >= 9 && a[0] == '@' && @strEq(a[0..7], "@align(") && a[a.len - 1] == ')') {
            result = _zag_str_to_i64(a[7..a.len - 1]) as i32;
        }
        i = i + 1;
    }
    return result;
}
fn ac_layout_scalar_size(ty: []u8) i32 {
    if (@strEq(ty, "bool") || @strEq(ty, "i8") || @strEq(ty, "u8")) { return 1; }
    if (@strEq(ty, "i16") || @strEq(ty, "u16")) { return 2; }
    if (@strEq(ty, "i32") || @strEq(ty, "u32") || @strEq(ty, "f32")) { return 4; }
    if (@strEq(ty, "i64") || @strEq(ty, "u64") || @strEq(ty, "isize") ||
        @strEq(ty, "usize") || @strEq(ty, "f64")) { return 8; }
    if (ty.len > 0 && ty[0] == '*') { return 8; }
    return 0;
}

// AArch64 Linux C leaves use their natural byte width. Keep this separate
// from the ordinary Zag word representation: @repr(C) aggregates are laid
// out in bytes, while normal compiler frames remain eight-byte slots.
fn ac_c_leaf_size(ty0: []u8) i32 {
    let ty: []u8 = cg_norm_type(ty0);
    if (ty.len > 0 && ty[0] == '*') { return 8; }
    if (@strEq(ty, "bool") || @strEq(ty, "i8") || @strEq(ty, "u8")) { return 1; }
    if (@strEq(ty, "i16") || @strEq(ty, "u16")) { return 2; }
    if (@strEq(ty, "i32") || @strEq(ty, "u32") || @strEq(ty, "f32")) { return 4; }
    if (@strEq(ty, "i64") || @strEq(ty, "u64") || @strEq(ty, "isize") ||
        @strEq(ty, "usize") || @strEq(ty, "f64")) { return 8; }
    return 0;
}

fn ac_c_leaf_alignment(ty: []u8) i32 { return ac_c_leaf_size(ty); }

fn ac_type_words(cg: *ACg, ty: []u8) i32 {
    return ac_round8(ac_type_size(cg, ty)) / 8;
}

fn ac_elem_stride(cg: *ACg, ty: []u8) i32 {
    if (ac_elem_is_byte(ty) == 1) { return 1; }
    return ac_round8(ac_type_size(cg, ty));
}

fn ac_type_width(cg: *ACg, ty: []u8) i32 {
    return ac_elem_stride(cg, ty);
}

fn ac_type_alignment(cg: *ACg, ty: []u8) i32 {
    let n: []u8 = cg_norm_type(ty);
    if (n.len == 0) { return 1; }
    if (n[0] == '*') { return 8; }
    if (vsa_type_valid(n) == 1) { return 8; }
    if (@strEq(n, "i64") || @strEq(n, "u64") || @strEq(n, "f64")) { return 8; }
    if (@strEq(n, "i32") || @strEq(n, "u32") || @strEq(n, "f32")) { return 4; }
    if (@strEq(n, "i16") || @strEq(n, "u16")) { return 2; }
    if (@strEq(n, "i8") || @strEq(n, "u8") || @strEq(n, "bool")) { return 1; }
    let sd: StructDecl = StructDecl{ .name = "", .fields = make[Param](1), .tparams = make[[]u8](1), .is_pub = 0, .origin = "<root>" };
    if (ac_find_struct(cg, n, &sd) == 1) {
        if (sd.repr_c == 1) {
            let ca: i32 = 1;
            let ci: i32 = 0;
            while (ci < sd.fields.len) {
                let fa: i32 = ac_c_leaf_alignment(get[Param](sd.fields, ci).pty);
                if (fa > ca) { ca = fa; }
                ci = ci + 1;
            }
            let explicit_c: i32 = ac_struct_explicit_align(sd);
            if (explicit_c > ca) { return explicit_c; }
            return ca;
        }
        if (ac_struct_layout_annot(sd, "@repr(packed)") == 1) {
            let packed: i32 = ac_struct_explicit_align(sd);
            if (packed > 1) { return packed; }
            return 1;
        }
        let explicit: i32 = ac_struct_explicit_align(sd);
        if (explicit > 8) { return explicit; }
        // Ordinary Zag aggregates use eight-byte word slots. Their byte size
        // is not their alignment: a three-word struct is 24 bytes wide but is
        // still eight-byte aligned. Returning its stride here also produced a
        // non-power-of-two mask in checked mode and rejected valid stack sret
        // storage used by std:range and std:utf8.
        return 8;
    }
    // Every remaining native value is represented in a word slot. Keep the
    // checked-alignment predicate power-of-two even if a late type spelling
    // was not found in the declaration table.
    return 8;
}

fn ac_is_aggregate(cg: *ACg, ty0: []u8) i32 {
    let ty: []u8 = cg_norm_type(ty0);
    if (ty.len == 0) { return 0; }
    if (ty[0] == '*') { return 0; }
    if (vsa_type_valid(ty) == 1) { return 1; }
    if (ac_type_is_slice(ty) == 1) { return 1; }
    if (@strEq(ty, "fat_fn")) { return 1; }
    if (cg_is_fn_type(ty) == 1) { return 1; }
    if (ty[0] == '!') { return 1; }
    if (ty[0] == '?') { return 1; }
    let sd: StructDecl = StructDecl{ .name = "", .fields = make[Param](1), .tparams = make[[]u8](1), .is_pub = 0, .origin = "<root>" };
    if (ac_find_struct(cg, ty, &sd) == 1) { return 1; }
    let ud: UnionDecl = UnionDecl{ .name = "", .fields = make[Param](1) };
    if (ac_find_union(cg, ty, &ud) == 1) { return 1; }
    if (iface_method_count(cg.*.decls, ty) > 0) { return 1; }
    return 0;
}

// Tag index of union member `m` in union `uname`, or -1.
fn ac_union_tag(cg: *ACg, uname: []u8, m: []u8) i32 {
    let ud: UnionDecl = UnionDecl{ .name = "", .fields = make[Param](1) };
    if (ac_find_union(cg, uname, &ud) == 0) { return 0 - 1; }
    let i: i32 = 0;
    while (i < len[Param](ud.fields)) {
        if (@strEq(get[Param](ud.fields, i).name, m)) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn ac_union_payload_type(cg: *ACg, uname: []u8, m: []u8) []u8 {
    let ud: UnionDecl = UnionDecl{ .name = "", .fields = make[Param](1) };
    if (ac_find_union(cg, uname, &ud) == 0) { return ""; }
    let i: i32 = 0;
    while (i < len[Param](ud.fields)) {
        let p: Param = get[Param](ud.fields, i);
        if (@strEq(p.name, m)) { return p.pty; }
        i = i + 1;
    }
    return "";
}

fn ac_is_union(cg: *ACg, name: []u8) i32 {
    let ud: UnionDecl = UnionDecl{ .name = "", .fields = make[Param](1) };
    return ac_find_union(cg, name, &ud);
}

fn ac_is_float(ty: []u8) i32 {
    if (@strEq(ty, "f32") || @strEq(ty, "f64")) { return 1; }
    return 0;
}

// Round-2 scalar-numeric recognition mirrors the x86 backend.  Keep this in
// the AArch64 lowering rather than treating the aliases as plain i64: sat
// values need the shared Zag runtime and unsigned arbitrary widths must mask
// each arithmetic result.
fn ac_is_satfixarb_ty(ty: []u8) i32 { return cg_is_satfixarb_ty(ty); }

fn ac_is_optional(ty: []u8) i32 {
    if (ty.len > 1 && ty[0] == '?') { return 1; }
    return 0;
}

fn ac_is_null_node(n: *Node) i32 {
    switch (n.*) {
        .id => |x| { if (@strEq(x.name, "null")) { return 1; } }
        else => { }
    }
    return 0;
}

// Byte offset of `fname` in struct `sname`, or -1.
fn ac_field_offset(cg: *ACg, sname0: []u8, fname: []u8) i32 {
    let sname: []u8 = cg_norm_type(sname0);
    let sd: StructDecl = StructDecl{ .name = "", .fields = make[Param](1), .tparams = make[[]u8](1), .is_pub = 0, .origin = "<root>" };
    if (ac_find_struct(cg, sname, &sd) == 0) { return 0 - 1; }
    let off: i32 = 0;
    let repr_c: i32 = sd.repr_c;
    let packed: i32 = ac_struct_layout_annot(sd, "@repr(packed)");
    let i: i32 = 0;
    while (i < len[Param](sd.fields)) {
        let p: Param = get[Param](sd.fields, i);
        if (repr_c == 1) {
            off = ac_align_up(off, ac_c_leaf_alignment(p.pty));
            if (@strEq(p.name, fname)) { return off; }
            off = off + ac_c_leaf_size(p.pty);
        } else if (packed == 1) {
            if (@strEq(p.name, fname)) { return off; }
            off = off + ac_c_leaf_size(p.pty);
        } else {
            if (@strEq(p.name, fname)) { return off; }
            off = off + ac_round8(ac_type_size(cg, p.pty));
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn ac_field_type(cg: *ACg, sname0: []u8, fname: []u8) []u8 {
    let sname: []u8 = cg_norm_type(sname0);
    let sd: StructDecl = StructDecl{ .name = "", .fields = make[Param](1), .tparams = make[[]u8](1), .is_pub = 0, .origin = "<root>" };
    if (ac_find_struct(cg, sname, &sd) == 0) { return ""; }
    let i: i32 = 0;
    while (i < len[Param](sd.fields)) {
        let p: Param = get[Param](sd.fields, i);
        if (@strEq(p.name, fname)) { return p.pty; }
        i = i + 1;
    }
    return "";
}

// Non-zero only for the byte-exact fields whose declaration controls the
// aggregate layout. Ordinary Zag fields continue to use one eight-byte word.
fn ac_layout_field_width(cg: *ACg, sname0: []u8, fname: []u8) i32 {
    let sname: []u8 = cg_norm_type(sname0);
    let sd: StructDecl = StructDecl{ .name = "", .fields = make[Param](1), .tparams = make[[]u8](1), .is_pub = 0, .origin = "<root>" };
    if (ac_find_struct(cg, sname, &sd) == 0) { return 0; }
    if (sd.repr_c == 0 && ac_struct_layout_annot(sd, "@repr(packed)") == 0) { return 0; }
    return ac_c_leaf_size(ac_field_type(cg, sname, fname));
}

fn ac_emit_load_layout(out: *ArrayList[AInstr], base: i32, off: i32, width: i32, ty0: []u8) void {
    let ty: []u8 = cg_norm_type(ty0);
    if (width == 1) { push[AInstr](out, ai_loadb(A_X0(), base, off)); }
    else if (width == 2) { push[AInstr](out, ai_loadh(A_X0(), base, off)); }
    else if (width == 4) { push[AInstr](out, ai_loadw(A_X0(), base, off)); }
    else { push[AInstr](out, ai_load(A_X0(), base, off)); }
    if (@strEq(ty, "i8")) { push[AInstr](out, ai_sxtb(A_X0(), A_X0())); }
    else if (@strEq(ty, "i16")) { push[AInstr](out, ai_sxth(A_X0(), A_X0())); }
    else if (@strEq(ty, "i32")) { push[AInstr](out, ai_sxtw(A_X0(), A_X0())); }
}

fn ac_emit_store_layout(out: *ArrayList[AInstr], base: i32, off: i32, width: i32, src: i32) void {
    if (width == 1) { push[AInstr](out, ai_storeb(base, off, src)); }
    else if (width == 2) { push[AInstr](out, ai_storeh(base, off, src)); }
    else if (width == 4) { push[AInstr](out, ai_storew(base, off, src)); }
    else { push[AInstr](out, ai_store(base, off, src)); }
}

// Zag keeps scalar integers in normalized 64-bit form internally, while the
// AAPCS64 C boundary only defines the declared low-width value. Normalize at
// both sides of a @cabi call so caller-owned upper bits cannot enter Zag and a
// narrow C result cannot be mistaken for an already extended Zag value.
fn ac_emit_cabi_int_normalize(out: *ArrayList[AInstr], reg: i32, ty0: []u8) void {
    let ty: []u8 = cg_norm_type(ty0);
    if (@strEq(ty, "bool")) { push[AInstr](out, ai_and_imm(reg, 1)); }
    else if (@strEq(ty, "i8")) { push[AInstr](out, ai_sxtb(reg, reg)); }
    else if (@strEq(ty, "u8")) { push[AInstr](out, ai_and_imm(reg, 255)); }
    else if (@strEq(ty, "i16")) { push[AInstr](out, ai_sxth(reg, reg)); }
    else if (@strEq(ty, "u16")) { push[AInstr](out, ai_and_imm(reg, 65535)); }
    else if (@strEq(ty, "i32")) { push[AInstr](out, ai_sxtw(reg, reg)); }
    else if (@strEq(ty, "u32")) { push[AInstr](out, ai_and_imm(reg, 4294967295)); }
}

// ── slots ────────────────────────────────────────────────────────────────────

fn ac_slot_alloc_br(env: *AEnv, cg: *ACg, name: []u8, ty: []u8, words: i32, byref: i32) i32 {
    let first: i32 = cg.*.frame_words;
    let disp: i32 = 0 - (8 * (first + words));
    push[[]u8](&env.*.names, name);
    push[i32](&env.*.disps, disp);
    push[[]u8](&env.*.types, cg_norm_type(ty));
    push[i32](&env.*.byref, byref);
    cg.*.frame_words = cg.*.frame_words + words;
    return disp;
}

fn ac_slot_scratch(cg: *ACg, words: i32) i32 {
    let first: i32 = cg.*.frame_words;
    let d: i32 = 0 - (8 * (first + words));
    cg.*.frame_words = cg.*.frame_words + words;
    return d;
}

// Returns the (negative) frame displacement, or 0 when not found — slot
// displacements start at -8, so 0 is the only safe "miss" sentinel.
fn ac_slot_find(env: *AEnv, name: []u8) i32 {
    let i: i32 = len[[]u8](env.*.names) - 1;
    while (i >= 0) {
        if (@strEq(get[[]u8](env.*.names, i), name)) {
            return get[i32](env.*.disps, i);
        }
        i = i - 1;
    }
    return 0;
}

fn ac_slot_type(env: *AEnv, name: []u8) []u8 {
    let i: i32 = len[[]u8](env.*.names) - 1;
    while (i >= 0) {
        if (@strEq(get[[]u8](env.*.names, i), name)) {
            return get[[]u8](env.*.types, i);
        }
        i = i - 1;
    }
    return "";
}

fn ac_slot_byref(env: *AEnv, name: []u8) i32 {
    let i: i32 = len[[]u8](env.*.names) - 1;
    while (i >= 0) {
        if (@strEq(get[[]u8](env.*.names, i), name)) {
            return get[i32](env.*.byref, i);
        }
        i = i - 1;
    }
    return 0;
}

fn ac_scope_mark(env: *AEnv) i32 { return len[[]u8](env.*.names); }

fn ac_scope_end(env: *AEnv, mark: i32) void {
    while (len[[]u8](env.*.names) > mark) {
        let _n: []u8 = pop[[]u8](&env.*.names);
        let _d: i32 = pop[i32](&env.*.disps);
        let _t: []u8 = pop[[]u8](&env.*.types);
        let _b: i32 = pop[i32](&env.*.byref);
    }
}

fn ac_intern_str(cg: *ACg, text: []u8, add_nl: i32) i32 {
    let off: i32 = len[u8](cg.*.data.*);
    ac_decode_str(text, cg.*.data);
    if (add_nl == 1) { push[u8](cg.*.data, 10); }
    return off;
}

fn ac_intern_nl(cg: *ACg) i32 {
    if (cg.*.nl_off >= 0) { return cg.*.nl_off; }
    let off: i32 = len[u8](cg.*.data.*);
    push[u8](cg.*.data, 10);
    cg.*.nl_off = off;
    return off;
}

fn ac_find_fn(syms: ArrayList[AFnSym], name: []u8) i32 {
    let i: i32 = 0;
    while (i < len[AFnSym](syms)) {
        if (@strEq(get[AFnSym](syms, i).name, name)) { return get[AFnSym](syms, i).lbl; }
        i = i + 1;
    }
    return 0 - 1;
}

// Resolve the exact thread worker shapes accepted by the shared typed pass.
// The Darwin pthread trampoline below is compiler-owned, so source never sees
// a platform-specific callback type or pthread declaration.
fn ac_thread_worker_label(cg: *ACg, syms: ArrayList[AFnSym], n: *Node,
                          with_i64: i32) i32 {
    let name: []u8 = "";
    switch (n.*) { .id => |x| { name = x.name; } else => { return 0 - 1; } }
    let label: i32 = ac_find_fn(syms, name);
    if (label < 0) { return 0 - 1; }
    let i: i32 = 0;
    while (i < len[*Node](cg.*.decls)) {
        switch (get[*Node](cg.*.decls, i).*) {
            .fn_decl => |f| {
                if (@strEq(f.name, name)) {
                    if (f.is_extern == 0 && len[[]u8](f.tparams) == 0 &&
                        len[Param](f.params) == with_i64 && @strEq(f.ret, "void") &&
                        f.caps == 0) {
                        if (with_i64 == 0 || @strEq(get[Param](f.params, 0).pty, "i64")) {
                            return label;
                        }
                    }
                    return 0 - 1;
                }
            }
            else => { }
        }
        i = i + 1;
    }
    return 0 - 1;
}

// Whole-program builtin-use scan used to keep compiler-owned Darwin runtime
// imports in exact lockstep with the call sites emitted by this backend.
fn ac_expr_uses_builtin(n: *Node, name: []u8) i32 {
    switch (n.*) {
        .call => |c| {
            switch (c.callee.*) {
                .id => |x| { if (@strEq(x.name, name)) { return 1; } }
                else => { if (ac_expr_uses_builtin(c.callee, name) == 1) { return 1; } }
            }
            let i: i32 = 0;
            while (i < len[*Node](c.args)) {
                if (ac_expr_uses_builtin(get[*Node](c.args, i), name) == 1) { return 1; }
                i = i + 1;
            }
        }
        .bin => |x| { if (ac_expr_uses_builtin(x.l,name)==1 || ac_expr_uses_builtin(x.r,name)==1) { return 1; } }
        .un => |x| { return ac_expr_uses_builtin(x.e,name); }
        .idx => |x| { if (ac_expr_uses_builtin(x.base,name)==1 || ac_expr_uses_builtin(x.idx,name)==1) { return 1; } }
        .fld => |x| { return ac_expr_uses_builtin(x.base,name); }
        .slit_ => |x| {
            let i:i32=0; while(i<x.fields.len){if(ac_expr_uses_builtin(x.fields.data[i].val,name)==1){return 1;}i=i+1;}
        }
        .cast_ => |x| { return ac_expr_uses_builtin(x.expr,name); }
        .slice_ => |x| {
            if(ac_expr_uses_builtin(x.base,name)==1||ac_expr_uses_builtin(x.lo,name)==1||
               (x.has_hi==1&&ac_expr_uses_builtin(x.hi,name)==1)){return 1;}
        }
        else => { }
    }
    return 0;
}

fn ac_body_uses_builtin(body:ArrayList[*Node],name:[]u8)i32{
    let i:i32=0;
    while(i<len[*Node](body)){
        switch(get[*Node](body,i).*){
            .let_=>|x|{if(x.has_init==1&&ac_expr_uses_builtin(x.expr,name)==1){return 1;}}
            .assign=>|x|{if(ac_expr_uses_builtin(x.target,name)==1||ac_expr_uses_builtin(x.expr,name)==1){return 1;}}
            .estmt=>|x|{if(ac_expr_uses_builtin(x.expr,name)==1){return 1;}}
            .ret=>|x|{if(x.has_expr==1&&ac_expr_uses_builtin(x.expr,name)==1){return 1;}}
            .if_=>|x|{if(ac_expr_uses_builtin(x.cond,name)==1||ac_body_uses_builtin(x.then_body,name)==1||
                (x.has_els==1&&ac_body_uses_builtin(x.els_body,name)==1)){return 1;}}
            .while_=>|x|{if(ac_expr_uses_builtin(x.cond,name)==1||ac_body_uses_builtin(x.body,name)==1){return 1;}}
            .unsafe_=>|x|{if(ac_body_uses_builtin(x.body,name)==1){return 1;}}
            .defer_=>|x|{if(ac_expr_uses_builtin(x.expr,name)==1){return 1;}}
            .switch_=>|x|{
                if(ac_expr_uses_builtin(x.subject,name)==1){return 1;}
                let a:i32=0;while(a<x.arms.len){if(ac_body_uses_builtin(x.arms.data[a].body,name)==1){return 1;}a=a+1;}
                if(x.has_els==1&&ac_body_uses_builtin(x.els_body,name)==1){return 1;}
            }
            else=>{}
        }
        i=i+1;
    }
    return 0;
}

fn ac_decls_use_builtin(decls:ArrayList[*Node],name:[]u8)i32{
    let i:i32=0;
    while(i<len[*Node](decls)){
        switch(get[*Node](decls,i).*){
            .fn_decl=>|f|{if(f.is_extern==0&&ac_body_uses_builtin(f.body,name)==1){return 1;}}
            .let_=>|x|{if(x.has_init==1&&ac_expr_uses_builtin(x.expr,name)==1){return 1;}}
            else=>{}
        }
        i=i+1;
    }
    return 0;
}

fn ac_find_extern(syms: ArrayList[AFnSym], name: []u8) i32 {
    let i: i32 = 0;
    while (i < len[AFnSym](syms)) {
        let s: AFnSym = get[AFnSym](syms, i);
        if (@strEq(s.name, name)) { return s.extern_index; }
        i = i + 1;
    }
    return 0 - 1;
}

fn ac_compiler_scalar_intrinsic(name: []u8) i32 {
    return (@strEq(name, "popcount") || @strEq(name, "byte_swap64") ||
            @strEq(name, "leading_zeros") || @strEq(name, "trailing_zeros") ||
            @strEq(name, "andn")) as i32;
}

fn ac_extern_count(syms: ArrayList[AFnSym]) i32 {
    let n: i32 = 0;
    let i: i32 = 0;
    while (i < len[AFnSym](syms)) {
        if (get[AFnSym](syms, i).extern_index >= 0) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

fn ac_find_fn_ret(syms: ArrayList[AFnSym], name: []u8) []u8 {
    let i: i32 = 0;
    while (i < len[AFnSym](syms)) {
        if (@strEq(get[AFnSym](syms, i).name, name)) { return get[AFnSym](syms, i).ret; }
        i = i + 1;
    }
    return "";
}

// Top-level `const` declarations are represented by the parser as annotated
// nullary functions. Imported references are rewritten after parsing, so they
// do not pass through the parser's usual implicit-call conversion. Recognize
// the annotation in the backend just as the x86 lowering does.
fn ac_is_desugared_const(cg: *ACg, name: []u8) i32 {
    let i: i32 = 0;
    while (i < len[*Node](cg.*.decls)) {
        switch (get[*Node](cg.*.decls, i).*) {
            .fn_decl => |f| {
                if (@strEq(f.name, name) && len[Param](f.params) == 0) {
                    let j: i32 = 0;
                    while (j < len[[]u8](f.annots)) {
                        if (@strEq(get[[]u8](f.annots, j), "_zag_desugared_const")) { return 1; }
                        j = j + 1;
                    }
                }
            }
            else => { }
        }
        i = i + 1;
    }
    return 0;
}

fn ac_fn_param_type(cg: *ACg, fname: []u8, idx: i32) []u8 {
    let di: i32 = 0;
    while (di < len[*Node](cg.*.decls)) {
        switch (get[*Node](cg.*.decls, di).*) {
            .fn_decl => |f| {
                if (@strEq(f.name, fname) && idx < len[Param](f.params)) {
                    return get[Param](f.params, idx).pty;
                }
            }
            else => { }
        }
        di = di + 1;
    }
    return "";
}

fn ac_fn_is_cabi_export(cg: *ACg, name: []u8) i32 {
    if (cg.*.object_mode == 0) { return 0; }
    let i: i32 = 0;
    while (i < cg.*.decls.len) {
        switch (cg.*.decls.data[i].*) {
            .fn_decl => |f| {
                if (@strEq(f.name, name)) { return cg_fn_has_annot(f, "@cabi_export"); }
            }
            else => { }
        }
        i = i + 1;
    }
    return 0;
}

fn ac_cabi_is_f64(ty0: []u8) i32 {
    return @strEq(cg_norm_type(ty0), "f64") as i32;
}
fn ac_cabi_is_f32(ty0: []u8) i32 {
    return @strEq(cg_norm_type(ty0), "f32") as i32;
}
fn ac_cabi_is_float(ty0: []u8) i32 {
    return (ac_cabi_is_f32(ty0) == 1 || ac_cabi_is_f64(ty0) == 1) as i32;
}

// True for the recursively nested ordinary-Zag shape whose layout is already
// byte-identical to C on Darwin: i64/u64/raw-pointer leaves only. Keep repr(C),
// packed/over-aligned, generic, and cyclic/deep declaration graphs fail-closed.
fn ac_darwin_cabi_word_shape_ok(cg: *ACg, ty0: []u8, depth: i32) i32 {
    let ty: []u8 = cg_norm_type(ty0);
    if (ty.len == 0 || depth > 8) { return 0; }
    if (ty[0] == '*' || @strEq(ty, "i64") || @strEq(ty, "u64")) { return 1; }
    let sd: StructDecl = StructDecl{ .name = "", .fields = make[Param](1), .tparams = make[[]u8](1), .is_pub = 0, .origin = "<root>" };
    if (ac_find_struct(cg, ty, &sd) == 0) { return 0; }
    if (sd.repr_c == 1 || sd.tparams.len > 0 || sd.fields.len == 0 ||
        ac_struct_layout_annot(sd, "@repr(packed)") == 1 || ac_struct_explicit_align(sd) > 8) { return 0; }
    let fi: i32 = 0;
    while (fi < sd.fields.len) {
        if (ac_darwin_cabi_word_shape_ok(cg, sd.fields.data[fi].pty, depth + 1) == 0) { return 0; }
        fi = fi + 1;
    }
    return 1;
}

// C byte size for the bounded flat ordinary-struct integer/pointer slice.
// Ordinary Zag gives every field an eight-byte internal slot, so narrow
// fields need an explicit boundary adapter even though the source struct is
// not @repr(C). A zero result means this shape is outside the slice.
fn ac_darwin_cabi_flat_integer_struct_size(cg: *ACg, ty0: []u8) i32 {
    let ty: []u8 = cg_norm_type(ty0);
    if (ty.len == 0 || ty[0] == '*') { return 0; }
    let sd: StructDecl = StructDecl{ .name = "", .fields = make[Param](1), .tparams = make[[]u8](1), .is_pub = 0, .origin = "<root>" };
    if (ac_find_struct(cg, ty, &sd) == 0 || sd.repr_c == 1 || sd.tparams.len > 0 || sd.fields.len == 0 ||
        ac_struct_layout_annot(sd, "@repr(packed)") == 1 || ac_struct_explicit_align(sd) > 8) { return 0; }
    let off: i32 = 0;
    let max_align: i32 = 1;
    let fi: i32 = 0;
    while (fi < sd.fields.len) {
        let fty: []u8 = sd.fields.data[fi].pty;
        if (cg_dynamic_scalar_abi_type_ok(fty) == 0 || @strEq(cg_norm_type(fty), "void")) { return 0; }
        let width: i32 = ac_c_leaf_size(fty);
        if (width <= 0 || width > 8) { return 0; }
        if (width > max_align) { max_align = width; }
        off = ac_align_up(off, width);
        off = off + width;
        fi = fi + 1;
    }
    return ac_align_up(off, max_align);
}

fn ac_darwin_cabi_flat_integer_struct_align(cg: *ACg, ty0: []u8) i32 {
    let ty: []u8 = cg_norm_type(ty0);
    if (ty.len == 0 || ty[0] == '*') { return 0; }
    let sd: StructDecl = StructDecl{ .name = "", .fields = make[Param](1), .tparams = make[[]u8](1), .is_pub = 0, .origin = "<root>" };
    if (ac_find_struct(cg, ty, &sd) == 0 || sd.repr_c == 1 || sd.tparams.len > 0 || sd.fields.len == 0 ||
        ac_struct_layout_annot(sd, "@repr(packed)") == 1 || ac_struct_explicit_align(sd) > 8) { return 0; }
    let max_align: i32 = 1;
    let fi: i32 = 0;
    while (fi < sd.fields.len) {
        let fty: []u8 = sd.fields.data[fi].pty;
        if (cg_dynamic_scalar_abi_type_ok(fty) == 0 || @strEq(cg_norm_type(fty), "void")) { return 0; }
        let width: i32 = ac_c_leaf_size(fty);
        if (width <= 0 || width > 8) { return 0; }
        if (width > max_align) { max_align = width; }
        fi = fi + 1;
    }
    return max_align;
}

fn ac_darwin_cabi_aggregate_size(cg: *ACg, ty0: []u8) i32 {
    let flat: i32 = ac_darwin_cabi_flat_integer_struct_size(cg, ty0);
    if (flat > 0) { return flat; }
    if (ac_darwin_cabi_word_shape_ok(cg, ty0, 0) == 1) { return ac_type_size(cg, ty0); }
    return 0;
}

fn ac_darwin_cabi_small_adapter_ok(cg: *ACg, ty0: []u8) i32 {
    let c_size: i32 = ac_darwin_cabi_flat_integer_struct_size(cg, ty0);
    if (c_size <= 0 || c_size > 16) { return 0; }
    return (ac_darwin_cabi_word_shape_ok(cg, ty0, 0) == 0) as i32;
}

fn ac_darwin_cabi_struct_ok(cg: *ACg, ty0: []u8) i32 {
    let ty: []u8 = cg_norm_type(ty0);
    if (ty.len == 0 || ty[0] == '*') { return 0; }
    let sd: StructDecl = StructDecl{ .name = "", .fields = make[Param](1), .tparams = make[[]u8](1), .is_pub = 0, .origin = "<root>" };
    if (ac_find_struct(cg, ty, &sd) == 0 || sd.repr_c == 1 || sd.tparams.len > 0 || sd.fields.len == 0 ||
        ac_struct_layout_annot(sd, "@repr(packed)") == 1 || ac_struct_explicit_align(sd) > 8) { return 0; }
    if (ac_darwin_cabi_word_shape_ok(cg, ty, 0) == 1) { return 1; }
    let c_size: i32 = ac_darwin_cabi_flat_integer_struct_size(cg, ty);
    return (c_size > 0 && c_size <= 16) as i32;
}

// AAPCS64 classifies values larger than 16 bytes indirectly. The existing
// caller-copy and x8 sret machinery exactly matches this transport.
fn ac_darwin_cabi_indirect_aggregate_ok(cg: *ACg, ty0: []u8) i32 {
    let ty: []u8 = cg_norm_type(ty0);
    return (ac_darwin_cabi_word_shape_ok(cg, ty, 0) == 1 && ac_type_size(cg, ty) > 16) as i32;
}

fn ac_darwin_cabi_small_aggregate_ok(cg: *ACg, ty0: []u8) i32 {
    let ty: []u8 = cg_norm_type(ty0);
    let size: i32 = ac_darwin_cabi_aggregate_size(cg, ty);
    return (ac_darwin_cabi_struct_ok(cg, ty) == 1 && size > 0 && size <= 16) as i32;
}

fn ac_darwin_cabi_aggregate_ok(cg: *ACg, ty0: []u8) i32 {
    return (ac_darwin_cabi_small_aggregate_ok(cg, ty0) == 1 ||
        ac_darwin_cabi_indirect_aggregate_ok(cg, ty0) == 1) as i32;
}

fn ac_darwin_cabi_gpr_slots(cg: *ACg, ty0: []u8) i32 {
    if (ac_cabi_is_float(ty0) == 1) { return 0; }
    if (ac_darwin_cabi_small_aggregate_ok(cg, ty0) == 1) {
        return ac_round8(ac_darwin_cabi_aggregate_size(cg, ty0)) / 8;
    }
    return 1;
}

// A C callback is one raw code pointer at the ABI boundary, not Zag's normal
// two-word {code, environment} function value. Darwin additionally admits the
// bounded f32/f64 leaf set, but those targets must use @cabi_export so their
// function entry/return path actually speaks the C FP-register ABI.
fn ac_cabi_callback_type_ok(ty0: []u8) i32 {
    if (ty0.len < 5 || ty0[0] != 'f' || ty0[1] != 'n' || ty0[2] != '(') { return 0; }
    let close: i32 = 0 - 1;
    let i: i32 = 3;
    while (i < ty0.len) {
        if (ty0[i] == ')') { close = i; i = ty0.len; }
        else { i = i + 1; }
    }
    if (close < 0 || close + 1 >= ty0.len) { return 0; }
    let params: []u8 = ty0[3..close];
    let start: i32 = 0;
    i = 0;
    while (i <= params.len) {
        if (i == params.len || params[i] == ',') {
            if (i > start) {
                let p: []u8 = cg_norm_type(params[start..i]);
                let fp: i32 = (@strEq(p, "f32") || @strEq(p, "f64")) as i32;
                if (cg_dynamic_scalar_abi_type_ok(p) == 0 && fp == 0) { return 0; }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    let ret: []u8 = cg_norm_type(ty0[close + 1..]);
    return (cg_dynamic_scalar_abi_type_ok(ret) == 1 || @strEq(ret, "f32") || @strEq(ret, "f64")) as i32;
}

fn ac_cabi_callback_has_float(ty0: []u8) i32 {
    if (ty0.len < 5 || ty0[0] != 'f' || ty0[1] != 'n' || ty0[2] != '(') { return 0; }
    let close: i32 = 0 - 1;
    let i: i32 = 3;
    while (i < ty0.len) {
        if (ty0[i] == ')') { close = i; i = ty0.len; }
        else { i = i + 1; }
    }
    if (close < 0 || close + 1 >= ty0.len) { return 0; }
    let params: []u8 = ty0[3..close];
    let start: i32 = 0;
    i = 0;
    while (i <= params.len) {
        if (i == params.len || params[i] == ',') {
            if (i > start) {
                let p: []u8 = cg_norm_type(params[start..i]);
                if (@strEq(p, "f32") || @strEq(p, "f64")) { return 1; }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    let ret: []u8 = cg_norm_type(ty0[close + 1..]);
    return (@strEq(ret, "f32") || @strEq(ret, "f64")) as i32;
}

fn ac_cabi_callback_matches(cg: *ACg, name: []u8, expected: []u8) i32 {
    let di: i32 = 0;
    while (di < cg.*.decls.len) {
        switch (cg.*.decls.data[di].*) {
            .fn_decl => |f| {
                if (@strEq(f.name, name) && f.is_extern == 0 &&
                    f.tparams.len == 0 && cg_is_clos_name(name) == 0) {
                    let got: []u8 = "fn(";
                    let pi: i32 = 0;
                    while (pi < f.params.len) {
                        if (pi > 0) { got = _zag_str_concat(got, ","); }
                        got = _zag_str_concat(got, f.params.data[pi].pty);
                        pi = pi + 1;
                    }
                    got = _zag_str_concat(_zag_str_concat(got, ")"), f.ret);
                    if (@strEq(got, expected)) { return 1; }
                }
            }
            else => { }
        }
        di = di + 1;
    }
    return 0;
}

fn ac_darwin_cabi_leaf_size(cg: *ACg, ty0: []u8) i32 {
    if (ac_cabi_callback_type_ok(ty0) == 1) { return 8; }
    if (ac_darwin_cabi_small_aggregate_ok(cg, ty0) == 1) { return ac_darwin_cabi_aggregate_size(cg, ty0); }
    if (ac_darwin_cabi_indirect_aggregate_ok(cg, ty0) == 1) { return 8; }
    return ac_c_leaf_size(ty0);
}

fn ac_darwin_cabi_leaf_align(cg: *ACg, ty0: []u8) i32 {
    if (ac_darwin_cabi_aggregate_ok(cg, ty0) == 1) {
        let flat_align: i32 = ac_darwin_cabi_flat_integer_struct_align(cg, ty0);
        if (flat_align > 0) { return flat_align; }
        return 8;
    }
    return ac_darwin_cabi_leaf_size(cg, ty0);
}

// Darwin AAPCS64 assigns integer/pointer arguments and scalar floating-point
// arguments from independent x0-x7 and v0-v7 banks. Zag carries both f32 and
// f64 internally as f64 bits. f64 crosses by bit transfer; f32 is explicitly
// converted between the internal double and the ABI's single precision value.
fn ac_darwin_cabi_gpr_arg_index(cg: *ACg, name: []u8, arg: i32) i32 {
    let count: i32 = 0;
    let i: i32 = 0;
    while (i < arg) {
        count = count + ac_darwin_cabi_gpr_slots(cg, ac_fn_param_type(cg, name, i));
        i = i + 1;
    }
    return count;
}

fn ac_darwin_cabi_fpr_arg_index(cg: *ACg, name: []u8, arg: i32) i32 {
    let count: i32 = 0;
    let i: i32 = 0;
    while (i < arg) {
        if (ac_cabi_is_float(ac_fn_param_type(cg, name, i)) == 1) { count = count + 1; }
        i = i + 1;
    }
    return count;
}

fn ac_darwin_cabi_arg_on_stack(cg: *ACg, name: []u8, arg: i32) i32 {
    if (ac_cabi_is_float(ac_fn_param_type(cg, name, arg)) == 1) {
        return (ac_darwin_cabi_fpr_arg_index(cg, name, arg) >= 8) as i32;
    }
    let gp: i32 = ac_darwin_cabi_gpr_arg_index(cg, name, arg);
    let slots: i32 = ac_darwin_cabi_gpr_slots(cg, ac_fn_param_type(cg, name, arg));
    return (gp >= 8 || gp + slots > 8) as i32;
}

// Apple packs fixed scalar arguments that overflow their register bank into
// naturally aligned byte-sized stack slots. Ordinary Zag and Linux calls
// retain their existing word-slot convention.
fn ac_darwin_cabi_stack_offset(cg: *ACg, name: []u8, arg: i32) i32 {
    let offset: i32 = 0;
    let i: i32 = 0;
    while (i <= arg) {
        if (ac_darwin_cabi_arg_on_stack(cg, name, i) == 1) {
            let width: i32 = ac_darwin_cabi_leaf_size(cg, ac_fn_param_type(cg, name, i));
            let align: i32 = ac_darwin_cabi_leaf_align(cg, ac_fn_param_type(cg, name, i));
            if (width == 0) {
                ac_err(cg, "arm64: unsupported Darwin C stack argument type");
                return 0;
            }
            offset = ((offset + align - 1) / align) * align;
            if (i == arg) { return offset; }
            offset = offset + width;
        }
        i = i + 1;
    }
    return offset;
}

fn ac_darwin_cabi_stack_bytes(cg: *ACg, name: []u8, nargs: i32) i32 {
    let size: i32 = 0;
    let i: i32 = 0;
    while (i < nargs) {
        if (ac_darwin_cabi_arg_on_stack(cg, name, i) == 1) {
            let width: i32 = ac_darwin_cabi_leaf_size(cg, ac_fn_param_type(cg, name, i));
            let align: i32 = ac_darwin_cabi_leaf_align(cg, ac_fn_param_type(cg, name, i));
            if (width == 0) {
                ac_err(cg, "arm64: unsupported Darwin C stack argument type");
                return 0;
            }
            size = ((size + align - 1) / align) * align;
            size = size + width;
        }
        i = i + 1;
    }
    return size;
}

// Convert a small flat ordinary Zag struct from the internal one-word-per-field
// representation into its naturally aligned Darwin C byte layout. src and dst
// must be distinct; x11 is scratch. Padding is zeroed for deterministic register
// and stack payloads even though C does not assign semantic value to it.
fn ac_emit_darwin_cabi_pack_small(out: *ArrayList[AInstr], cg: *ACg, ty0: []u8, src: i32, dst: i32) void {
    let ty: []u8 = cg_norm_type(ty0);
    let sd: StructDecl = StructDecl{ .name = "", .fields = make[Param](1), .tparams = make[[]u8](1), .is_pub = 0, .origin = "<root>" };
    if (ac_find_struct(cg, ty, &sd) == 0) { ac_err(cg, "arm64: missing Darwin C aggregate declaration"); return; }
    let c_size: i32 = ac_darwin_cabi_flat_integer_struct_size(cg, ty);
    let words: i32 = ac_round8(c_size) / 8;
    push[AInstr](out, ai_mov_imm(A_X11(), 0));
    let wi: i32 = 0;
    while (wi < words) {
        push[AInstr](out, ai_store(dst, 8 * wi, A_X11()));
        wi = wi + 1;
    }
    let c_off: i32 = 0;
    let fi: i32 = 0;
    while (fi < sd.fields.len) {
        let p: Param = sd.fields.data[fi];
        let width: i32 = ac_c_leaf_size(p.pty);
        c_off = ac_align_up(c_off, width);
        let internal_off: i32 = ac_field_offset(cg, ty, p.name);
        push[AInstr](out, ai_load(A_X11(), src, internal_off));
        ac_emit_store_layout(out, dst, c_off, width, A_X11());
        c_off = c_off + width;
        fi = fi + 1;
    }
}

// Reverse the adapter above. Narrow C fields are normalized into Zag's full
// 64-bit scalar slots so later ordinary field access observes the same values
// as a native Zag aggregate construction.
fn ac_emit_darwin_cabi_unpack_small(out: *ArrayList[AInstr], cg: *ACg, ty0: []u8, src: i32, dst: i32) void {
    let ty: []u8 = cg_norm_type(ty0);
    let sd: StructDecl = StructDecl{ .name = "", .fields = make[Param](1), .tparams = make[[]u8](1), .is_pub = 0, .origin = "<root>" };
    if (ac_find_struct(cg, ty, &sd) == 0) { ac_err(cg, "arm64: missing Darwin C aggregate declaration"); return; }
    // Narrow unsigned/bool normalization may materialize a mask in x9. Keep
    // the packed source address in x12 so a later field cannot accidentally
    // dereference that mask as a pointer.
    push[AInstr](out, ai_mov_rr(A_X12(), src));
    let c_off: i32 = 0;
    let fi: i32 = 0;
    while (fi < sd.fields.len) {
        let p: Param = sd.fields.data[fi];
        let width: i32 = ac_c_leaf_size(p.pty);
        c_off = ac_align_up(c_off, width);
        if (width == 1) { push[AInstr](out, ai_loadb(A_X11(), A_X12(), c_off)); }
        else if (width == 2) { push[AInstr](out, ai_loadh(A_X11(), A_X12(), c_off)); }
        else if (width == 4) { push[AInstr](out, ai_loadw(A_X11(), A_X12(), c_off)); }
        else { push[AInstr](out, ai_load(A_X11(), A_X12(), c_off)); }
        ac_emit_cabi_int_normalize(out, A_X11(), p.pty);
        push[AInstr](out, ai_store(dst, ac_field_offset(cg, ty, p.name), A_X11()));
        c_off = c_off + width;
        fi = fi + 1;
    }
}

// Copy exactly `size` bytes from a packed ABI payload to the outgoing Darwin
// stack. Exact-width stores matter for aggregates smaller than one machine word
// because the following fixed argument can begin immediately after that slot.
fn ac_emit_darwin_cabi_packed_to_stack(out: *ArrayList[AInstr], src: i32, stack_off: i32, size: i32) void {
    let off: i32 = 0;
    while (size - off >= 8) {
        push[AInstr](out, ai_load(A_X10(), src, off));
        push[AInstr](out, ai_store(A_SP(), stack_off + off, A_X10()));
        off = off + 8;
    }
    if (size - off >= 4) {
        push[AInstr](out, ai_loadw(A_X10(), src, off));
        push[AInstr](out, ai_storew(A_SP(), stack_off + off, A_X10()));
        off = off + 4;
    }
    if (size - off >= 2) {
        push[AInstr](out, ai_loadh(A_X10(), src, off));
        push[AInstr](out, ai_storeh(A_SP(), stack_off + off, A_X10()));
        off = off + 2;
    }
    if (size - off >= 1) {
        push[AInstr](out, ai_loadb(A_X10(), src, off));
        push[AInstr](out, ai_storeb(A_SP(), stack_off + off, A_X10()));
    }
}

// Reverse of the outgoing helper above. `caller_off` is relative to the
// callee's x29 after its 32-byte prologue header, while `dst_disp` is a frame
// displacement. Only the aggregate's bytes are copied; adjacent arguments are
// never folded into the adapter scratch.
fn ac_emit_darwin_cabi_stack_to_packed(out: *ArrayList[AInstr], caller_off: i32, dst_disp: i32, size: i32) void {
    let off: i32 = 0;
    while (size - off >= 8) {
        push[AInstr](out, ai_load(A_X10(), A_X29(), caller_off + off));
        push[AInstr](out, ai_store(A_X29(), dst_disp + off, A_X10()));
        off = off + 8;
    }
    if (size - off >= 4) {
        push[AInstr](out, ai_loadw(A_X10(), A_X29(), caller_off + off));
        push[AInstr](out, ai_storew(A_X29(), dst_disp + off, A_X10()));
        off = off + 4;
    }
    if (size - off >= 2) {
        push[AInstr](out, ai_loadh(A_X10(), A_X29(), caller_off + off));
        push[AInstr](out, ai_storeh(A_X29(), dst_disp + off, A_X10()));
        off = off + 2;
    }
    if (size - off >= 1) {
        push[AInstr](out, ai_loadb(A_X10(), A_X29(), caller_off + off));
        push[AInstr](out, ai_storeb(A_X29(), dst_disp + off, A_X10()));
    }
}

fn ac_iface_mret(cg: *ACg, iname: []u8, mname: []u8) []u8 {
    let M: i32 = iface_method_count(cg.*.decls, iname);
    let mi: i32 = 0;
    while (mi < M) {
        if (@strEq(iface_method_name(cg.*.decls, iname, mi), mname)) {
            return iface_method_ret(cg.*.decls, iname, mi);
        }
        mi = mi + 1;
    }
    return "";
}

// ── small emit helpers ───────────────────────────────────────────────────────

// dst = x29 + disp
fn ac_emit_lea(out: *ArrayList[AInstr], dst: i32, disp: i32) void {
    push[AInstr](out, ai_mov_rr(dst, A_X29()));
    if (disp < 0) { push[AInstr](out, ai_sub_imm(dst, (0 - disp) as i64)); }
    else if (disp > 0) { push[AInstr](out, ai_add_imm(dst, disp as i64)); }
}

// copy `words` 8-byte words from [x11] to [x10] (clobbers x9)
fn ac_emit_copy(out: *ArrayList[AInstr], words: i32) void {
    let k: i32 = 0;
    while (k < words) {
        push[AInstr](out, ai_load(A_X9(), A_X11(), 8 * k));
        push[AInstr](out, ai_store(A_X10(), 8 * k, A_X9()));
        k = k + 1;
    }
}

fn ac_vsa_mask_last(out: *ArrayList[AInstr], ty: []u8, reg: i32) void {
    if (vsa_type_final_bits(ty) != 64) {
        push[AInstr](out, ai_mov_imm(A_X15(), vsa_type_final_mask(ty)));
        push[AInstr](out, ai_andr(reg, A_X15()));
    }
}

// A VSA expression evaluates to the address of a packed immutable aggregate.
// Full 128-bit pairs use mandatory AArch64 Advanced SIMD; odd and masked tail
// words use the same scalar authority, keeping every dimension bit-identical.
fn ac_lower_vsa_bin(out: *ArrayList[AInstr], b: Bin, lty: []u8, rty: []u8,
                    env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) void {
    if (vsa_type_valid(lty) == 0 || !@strEq(lty, rty)) {
        ac_err(cg, "arm64: VSA operands require the same valid vsa_b<N> type");
        push[AInstr](out, ai_mov_imm(A_X0(), 0));
        push[AInstr](out, ai_push(A_X0()));
        return;
    }
    if (!@strEq(b.op, "^") && !@strEq(b.op, "&") && !@strEq(b.op, "|")) {
        ac_err(cg, "arm64: vsa_b<N> supports only ^, &, and | operators");
        push[AInstr](out, ai_mov_imm(A_X0(), 0));
        push[AInstr](out, ai_push(A_X0()));
        return;
    }
    let words: i32 = vsa_type_words(lty);
    let result: i32 = ac_slot_scratch(cg, words);
    ac_lower_expr(out, b.l, env, syms, cg);
    ac_lower_expr(out, b.r, env, syms, cg);
    push[AInstr](out, ai_pop(A_X11()));
    push[AInstr](out, ai_pop(A_X10()));
    let wi: i32 = 0;
    let vector_words: i32 = words;
    if (vsa_type_final_bits(lty) != 64) { vector_words = vector_words - 1; }
    while (wi + 1 < vector_words) {
        push[AInstr](out, ai_vloadq(0, A_X10(), wi * 8));
        push[AInstr](out, ai_vloadq(1, A_X11(), wi * 8));
        if (@strEq(b.op, "^")) { push[AInstr](out, ai_veor(0, 1)); }
        else if (@strEq(b.op, "&")) { push[AInstr](out, ai_vand(0, 1)); }
        else { push[AInstr](out, ai_vorr(0, 1)); }
        push[AInstr](out, ai_vstoreq(A_X29(), result + wi * 8, 0));
        wi = wi + 2;
    }
    while (wi < words) {
        push[AInstr](out, ai_load(A_X0(), A_X10(), wi * 8));
        push[AInstr](out, ai_load(A_X1(), A_X11(), wi * 8));
        if (@strEq(b.op, "^")) { push[AInstr](out, ai_xor(A_X0(), A_X1())); }
        else if (@strEq(b.op, "&")) { push[AInstr](out, ai_andr(A_X0(), A_X1())); }
        else { push[AInstr](out, ai_or(A_X0(), A_X1())); }
        if (wi + 1 == words) { ac_vsa_mask_last(out, lty, A_X0()); }
        push[AInstr](out, ai_store(A_X29(), result + wi * 8, A_X0()));
        wi = wi + 1;
    }
    ac_emit_lea(out, A_X0(), result);
    push[AInstr](out, ai_push(A_X0()));
}

// branch over a __div0 call when the divisor (x1) is nonzero
fn ac_emit_div0_guard(out: *ArrayList[AInstr], cg: *ACg) void {
    let l_ok: i32 = ac_fresh(cg);
    push[AInstr](out, ai_cmp_imm(A_X1(), 0));
    push[AInstr](out, ai_jne(l_ok));
    cg.*.use_dz = 1;
    push[AInstr](out, ai_call(cg.*.dz_lbl));
    push[AInstr](out, ai_label(l_ok));
}

// __div0(): write(2, "panic: division by zero\n", 24); exit(134). Never returns.
fn ac_emit_div0(out: *ArrayList[AInstr], lbl: i32, cg: *ACg) void {
    let off: i32 = ac_intern_str(cg, "panic: division by zero", 1);
    push[AInstr](out, ai_label(lbl));
    push[AInstr](out, ai_mov_imm(A_X0(), 2));
    push[AInstr](out, ai_data_addr(A_X1(), off));
    push[AInstr](out, ai_mov_imm(A_X2(), 24));
    push[AInstr](out, ai_syscall(64));
    push[AInstr](out, ai_mov_imm(A_X0(), 134));
    push[AInstr](out, ai_syscall(93));
    push[AInstr](out, ai_ret());
}

// Checked raw-pointer accesses must fail before a hardware fault.  This is the
// first ARM64 checked-mode primitive: later slices add alignment, allocation
// provenance, bounds, and freed-region checks ahead of this common trap.
fn ac_emit_checked_nonnull(out: *ArrayList[AInstr], ptr: i32, cg: *ACg) void {
    if (cg.*.safety_checked == 0) { return; }
    let l_ok: i32 = ac_fresh(cg);
    push[AInstr](out, ai_cmp_imm(ptr, 0));
    push[AInstr](out, ai_jne(l_ok));
    let off: i32 = ac_intern_str(cg, "zag safety: null raw pointer access", 1);
    push[AInstr](out, ai_mov_imm(A_X0(), 2));
    push[AInstr](out, ai_data_addr(A_X1(), off));
    push[AInstr](out, ai_mov_imm(A_X2(), 36));
    push[AInstr](out, ai_syscall(64));
    push[AInstr](out, ai_mov_imm(A_X0(), 134));
    push[AInstr](out, ai_syscall(93));
    push[AInstr](out, ai_label(l_ok));
}

fn ac_checked_alignment(ty: []u8) i32 {
    if (@strEq(ty, "i8") || @strEq(ty, "u8") || @strEq(ty, "bool")) { return 1; }
    if (@strEq(ty, "i16") || @strEq(ty, "u16")) { return 2; }
    if (@strEq(ty, "i32") || @strEq(ty, "u32") || @strEq(ty, "f32")) { return 4; }
    return 8;
}

fn ac_emit_checked_alignment(out: *ArrayList[AInstr], ptr: i32, align: i32, cg: *ACg) void {
    if (cg.*.safety_checked == 0 || align <= 1) { return; }
    let l_ok: i32 = ac_fresh(cg);
    // ai_and_imm materializes its mask through x9 (or x10 when x9 is the
    // destination). Atomic lowering keeps the live raw pointer in x10, so an
    // x9 destination would silently replace that pointer with the alignment
    // mask before the LL/SC access. Use x8 for the transient check; current
    // checked-pointer callers keep their live pointer in x0 or x10.
    push[AInstr](out, ai_mov_rr(A_X8(), ptr));
    push[AInstr](out, ai_and_imm(A_X8(), (align - 1) as i64));
    push[AInstr](out, ai_cmp_imm(A_X8(), 0));
    push[AInstr](out, ai_je(l_ok));
    let off: i32 = ac_intern_str(cg, "zag safety: misaligned raw pointer access", 1);
    push[AInstr](out, ai_mov_imm(A_X0(), 2));
    push[AInstr](out, ai_data_addr(A_X1(), off));
    push[AInstr](out, ai_mov_imm(A_X2(), 42));
    push[AInstr](out, ai_syscall(64));
    push[AInstr](out, ai_mov_imm(A_X0(), 134));
    push[AInstr](out, ai_syscall(93));
    push[AInstr](out, ai_label(l_ok));
}

// ── expression type inference (best-effort; "" = unknown scalar) ────────────

fn ac_expr_type(n: *Node, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) []u8 {
    switch (n.*) {
        .ilit => |x| {
            if (cg_is_float_text(x.text) == 1) { return "f64"; }
            return "i64";
        }
        .slit => |_x| { return "[]u8"; }
        .embed => |_x| { return "[]u8"; }
        .id => |x| {
            if (@strEq(x.name, "true") || @strEq(x.name, "false")) { return "bool"; }
            let sty: []u8 = ac_slot_type(env, x.name);
            if (sty.len == 0 && ac_slot_find(env, x.name) == 0) {
                let global_index: i32 = ac_global_find(cg, x.name);
                if (global_index >= 0) {
                    return get[GlobalSym](cg.*.globals.*, global_index).ty;
                }
                if (cg_is_clos_name(x.name) == 1) { return "fat_fn"; }
                if (ac_find_fn(syms, x.name) >= 0) {
                    if (ac_is_desugared_const(cg, x.name) == 1) {
                        return ac_find_fn_ret(syms, x.name);
                    }
                    return "fat_fn";
                }
            }
            return sty;
        }
        .bin => |b| {
            if (@strEq(b.op, "==") || @strEq(b.op, "!=") || @strEq(b.op, "<") ||
                @strEq(b.op, ">") || @strEq(b.op, "<=") || @strEq(b.op, ">=") ||
                @strEq(b.op, "&&") || @strEq(b.op, "||")) { return "bool"; }
            let lt: []u8 = ac_expr_type(b.l, env, syms, cg);
            if (@strEq(b.op, "orelse")) {
                if (ac_is_optional(lt) == 1) { return lt[1..]; }
                return ac_expr_type(b.r, env, syms, cg);
            }
            if (lt.len > 0) { return lt; }
            return ac_expr_type(b.r, env, syms, cg);
        }
        .un => |u| {
            if (@strEq(u.op, "!")) { return "bool"; }
            if (@strEq(u.op, "&")) {
                return _zag_str_concat("*", ac_expr_type(u.e, env, syms, cg));
            }
            if (@strEq(u.op, "try")) {
                let ety: []u8 = ac_expr_type(u.e, env, syms, cg);
                if (ety.len > 1 && ety[0] == '!') { return ety[1..]; }
                return ety;
            }
            return ac_expr_type(u.e, env, syms, cg);
        }
        .call => |c| {
            switch (c.callee.*) {
                .fld => |mf| {
                    if (!@strEq(mf.fname, "*") && !@strEq(mf.fname, "?") && !@strEq(mf.fname, "has") && !@strEq(mf.fname, "val")) {
                        let rty0: []u8 = ac_expr_type(mf.base, env, syms, cg);
                        if (rty0.len > 1 && rty0[0] == '*') { rty0 = rty0[1..]; }
                        if (iface_method_count(cg.*.decls, rty0) > 0) {
                            return ac_iface_mret(cg, rty0, mf.fname);
                        }
                        if (rty0.len > 0) {
                            return ac_find_fn_ret(syms, _zag_str_concat(_zag_str_concat(rty0, "_"), mf.fname));
                        }
                    }
                    return "";
                }
                .id => |fnid| {
                    if (@strEq(fnid.name, "new")) {
                        if (len[*Node](c.args) == 1) {
                            return _zag_str_concat("*", ac_expr_type(get[*Node](c.args, 0), env, syms, cg));
                        }
                        return "*u8";
                    }
                    if (@strEq(fnid.name, "_zag_script_new")) {
                        if (len[*Node](c.args) == 2) {
                            return _zag_str_concat("*", ac_expr_type(get[*Node](c.args, 1), env, syms, cg));
                        }
                        return "*u8";
                    }
                    if (@strEq(fnid.name, "_zag_malloc") || @strEq(fnid.name, "_zag_realloc")) { return "*u8"; }
                    if (@strEq(fnid.name, "_zag_i64_to_str") || @strEq(fnid.name, "_zag_u64_to_str")) { return "[]u8"; }
                    if (@strEq(fnid.name, "_zag_strcmp") || @strEq(fnid.name, "_zag_str_eq") || @strEq(fnid.name, "_zag_strlen") || @strEq(fnid.name, "_zag_str_len") || @strEq(fnid.name, "_zag_strcmp_ord") || @strEq(fnid.name, "_zag_str_index_of_byte") || @strEq(fnid.name, "_zag_memcmp")) { return "i32"; }
                    if (@strEq(fnid.name, "_zag_str_concat") || @strEq(fnid.name, "_zag_strdup") || @strEq(fnid.name, "_zag_arg") || @strEq(fnid.name, "_zag_getenv") || @strEq(fnid.name, "_zag_read_file") || @strEq(fnid.name, "_zag_current_executable_path") || @strEq(fnid.name, "_zag_script_env_get") || @strEq(fnid.name, "_zag_exec_capture") || @strEq(fnid.name, "_zag_process_result_output")) { return "[]u8"; }
                    if (@strEq(fnid.name, "_zag_argc") || @strEq(fnid.name, "_zag_exec_cmd") || @strEq(fnid.name, "_zag_write_file") || @strEq(fnid.name, "_zag_write_exec") || @strEq(fnid.name, "_zag_file_exists") || @strEq(fnid.name, "_zag_process_result_status") || @strEq(fnid.name, "_zag_process_result_state")) { return "i32"; }
                    if (@strEq(fnid.name, "_zag_read_fd") || @strEq(fnid.name, "_zag_clock_monotonic_ms") || @strEq(fnid.name, "_zag_script_alloc_used") || @strEq(fnid.name, "_zag_script_file_size") || @strEq(fnid.name, "_zag_script_read_file_into")) { return "i64"; }
                    if (@strEq(fnid.name, "_zag_malloc") || @strEq(fnid.name, "_zag_realloc") || @strEq(fnid.name, "_zag_script_context_init") || @strEq(fnid.name, "_zag_script_alloc") || @strEq(fnid.name, "_zag_process_result_abi_new") || @strEq(fnid.name, "_zag_script_process_result_abi_new")) { return "*opaque"; }
                    if (@strEq(fnid.name, "_zag_str_to_i64")) { return "i64"; }
                    if (@strEq(fnid.name, "_zag_slice_ptr")) { return "*i8"; }
                    if (@strEq(fnid.name, "_zag_raw_syscall") || @strEq(fnid.name, "_zag_darwin_syscall") || @strEq(fnid.name, "_zag_darwin_open") || @strEq(fnid.name, "_zag_darwin_fork") || @strEq(fnid.name, "_zag_process_envp") || @strEq(fnid.name, "_zag_code_anchor") || @strEq(fnid.name, "_zag_x86_cpuid_eax") ||
                        @strEq(fnid.name, "_zag_x86_cpuid_ebx") || @strEq(fnid.name, "_zag_x86_cpuid_ecx") ||
                        @strEq(fnid.name, "_zag_x86_cpuid_edx") || @strEq(fnid.name, "_zag_x86_xgetbv")) { return "i64"; }
                    if (@strEq(fnid.name, "__catch") || @strEq(fnid.name, "__catchc")) {
                        let cty0: []u8 = ac_expr_type(get[*Node](c.args, 0), env, syms, cg);
                        if (cty0.len > 1 && cty0[0] == '!') { return cty0[1..]; }
                        return cty0;
                    }
                    if (fnid.name.len > 0 && fnid.name[0] == '@') {
                    if (@strEq(fnid.name, "@intToFloat")) { return "f64"; }
                    if (@strEq(fnid.name, "@floatToInt")) { return "i32"; }
                    if (@strEq(fnid.name, "@threadSpawn") || @strEq(fnid.name, "@asyncSpawn")) { return "*opaque"; }
                    if (@strEq(fnid.name, "@threadJoin") || @strEq(fnid.name, "@asyncJoin")) { return "void"; }
                    if (@strEq(fnid.name, "@asyncCancelled")) { return "bool"; }
                    let ab: []u8 = fnid.name[1..];
                        let ar: []u8 = cg_posit_builtin_ret(ab);
                        if (ar.len > 0) { return ar; }
                        ar = cg_quire_builtin_ret(ab);
                        if (ar.len > 0) { return ar; }
                    }
                    if (@strEq(fnid.name, "@vsaZero") || @strEq(fnid.name, "@vsaFromWords") ||
                        @strEq(fnid.name, "@vsaMajority3")) {
                        if (len[[]u8](c.targs) == 1 && vsa_type_valid(get[[]u8](c.targs, 0)) == 1) {
                            return get[[]u8](c.targs, 0);
                        }
                        return "";
                    }
                    if (@strEq(fnid.name, "@vsaWord") || @strEq(fnid.name, "@vsaHamming") ||
                        @strEq(fnid.name, "@vsaDimension") || @strEq(fnid.name, "@vsaWordCount")) {
                        return "i64";
                    }
                    if (fnid.name.len > 0 && fnid.name[0] == '@') { return ""; }
                    if (len[[]u8](c.targs) > 0) {
                        return ac_find_fn_ret(syms, cg_mangle_generic_norm(fnid.name, c.targs));
                    }
                    return ac_find_fn_ret(syms, fnid.name);
                }
                else => { return ""; }
            }
        }
        .fld => |f| {
            // enum member constant: Color.red ; error.X → i32 code
            switch (f.base.*) {
                .id => |bid| {
                    if (@strEq(bid.name, "error") && ac_slot_find(env, bid.name) == 0) { return "i32"; }
                    if (ac_slot_find(env, bid.name) == 0 && ac_is_enum(cg, bid.name) == 1) {
                        return bid.name;
                    }
                }
                else => { }
            }
            let bt: []u8 = ac_expr_type(f.base, env, syms, cg);
            if (@strEq(f.fname, "*")) {
                if (bt.len > 1 && bt[0] == '*') { return bt[1..]; }
                return "";
            }
            if (@strEq(f.fname, "len") &&
                (ac_type_is_slice(bt) == 1 ||
                 (bt.len > 1 && bt[0] == '*' && ac_type_is_slice(bt[1..]) == 1))) {
                return "i64";
            }
            if (ac_is_optional(bt) == 1) {
                if (@strEq(f.fname, "has")) { return "i32"; }
                if (@strEq(f.fname, "val") || @strEq(f.fname, "?")) { return bt[1..]; }
            }
            let sname: []u8 = bt;
            if (bt.len > 1 && bt[0] == '*') { sname = bt[1..]; }
            return ac_field_type(cg, sname, f.fname);
        }
        .idx => |ix| {
            let bt: []u8 = ac_expr_type(ix.base, env, syms, cg);
            if (ac_type_is_slice(bt) == 1) { return ac_slice_elem(bt); }
            if (bt.len > 1 && bt[0] == '*') { return bt[1..]; }
            return "";
        }
        .cast_ => |cst| { return cg_norm_type(cst.target); }
        .slit_ => |sl| { return cg_slit_sname(sl); }
        .slice_ => |sc| {
            let bt2: []u8 = ac_expr_type(sc.base, env, syms, cg);
            if (bt2.len > 1 && bt2[0] == '*') { return _zag_str_concat("[]", bt2[1..]); }
            return bt2;
        }
        .switch_ => |sw| { return ac_switch_expr_type(sw, env, syms, cg); }
        else => { return ""; }
    }
}

// Build a fat_fn {code_ptr, env_ptr} block for a fn used as a value and push
// its address. Closures (__clos_N) malloc an env holding the captures:
// scalars by value, aggregates as heap copies, '*name' captures by address.
fn ac_materialize_fat_fn(out: *ArrayList[AInstr], name: []u8, lbl: i32, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) void {
    let fb: i32 = ac_slot_scratch(cg, 2);
    push[AInstr](out, ai_lea_lbl(A_X0(), lbl));
    push[AInstr](out, ai_store(A_X29(), fb, A_X0()));
    let caps: []u8 = "";
    let di: i32 = 0;
    while (di < len[*Node](cg.*.decls)) {
        switch (get[*Node](cg.*.decls, di).*) {
            .fn_decl => |fd| { if (@strEq(fd.name, name)) { caps = fd.cap_names; } }
            else => { }
        }
        di = di + 1;
    }
    if (caps.len == 0) {
        push[AInstr](out, ai_mov_imm(A_X0(), 0));
        push[AInstr](out, ai_store(A_X29(), fb + 8, A_X0()));
        ac_emit_lea(out, A_X0(), fb);
        push[AInstr](out, ai_push(A_X0()));
        return;
    }
    // record capture types on the decl so the closure body can bind them
    let cnames0: ArrayList[[]u8] = split_args(caps);
    let tys: []u8 = "";
    let ti: i32 = 0;
    while (ti < len[[]u8](cnames0)) {
        let cn: []u8 = get[[]u8](cnames0, ti);
        if (ti > 0) { tys = _zag_str_concat(tys, ","); }
        if (cn.len > 0 && cn[0] == '*') {
            tys = _zag_str_concat(tys, _zag_str_concat("*", ac_slot_type(env, cn[1..])));
        } else {
            tys = _zag_str_concat(tys, ac_slot_type(env, cn));
        }
        ti = ti + 1;
    }
    let di2: i32 = 0;
    while (di2 < len[*Node](cg.*.decls)) {
        let dn: *Node = get[*Node](cg.*.decls, di2);
        switch (dn.*) {
            .fn_decl => |fd2| {
                if (@strEq(fd2.name, name) && fd2.cap_types.len == 0) {
                    dn.* = Node{ .fn_decl = FnDecl{
                        .name = fd2.name, .tparams = fd2.tparams,
                        .params = fd2.params, .ret = fd2.ret,
                        .annots = fd2.annots, .body = fd2.body,
                        .is_extern = fd2.is_extern, .ret_eff = fd2.ret_eff,
                        .caps = fd2.caps, .cap_names = fd2.cap_names,
                        .cap_types = tys, .line = fd2.line, .is_pub = fd2.is_pub,
                        .origin = fd2.origin } };
                }
            }
            else => { }
        }
        di2 = di2 + 1;
    }
    // env = __malloc(ncaps * 8); fill the capture slots
    let ncaps: i32 = cg_count_caps(caps);
    let env_save: i32 = ac_slot_scratch(cg, 1);
    push[AInstr](out, ai_mov_imm(A_X0(), (ncaps * 8) as i64));
    cg.*.use_al = 1;
    push[AInstr](out, ai_call(cg.*.al_lbl));
    push[AInstr](out, ai_store(A_X29(), env_save, A_X0()));
    let ci: i32 = 0;
    while (ci < len[[]u8](cnames0)) {
        let cname: []u8 = get[[]u8](cnames0, ci);
        let is_ptr_cap: i32 = 0;
        let real_cn: []u8 = cname;
        if (cname.len > 0 && cname[0] == '*') { is_ptr_cap = 1; real_cn = cname[1..]; }
        let cdisp: i32 = ac_slot_find(env, real_cn);
        if (cdisp != 0) {
            if (is_ptr_cap == 1) {
                ac_emit_lea(out, A_X0(), cdisp);
                push[AInstr](out, ai_load(A_X10(), A_X29(), env_save));
                push[AInstr](out, ai_store(A_X10(), 8 * ci, A_X0()));
            } else {
                let cty: []u8 = ac_slot_type(env, real_cn);
                if (ac_is_aggregate(cg, cty) == 1 && ac_slot_byref(env, real_cn) == 0) {
                    // heap-copy the inline aggregate; env slot holds the copy's addr
                    let nw: i32 = ac_type_words(cg, cty);
                    push[AInstr](out, ai_mov_imm(A_X0(), (nw * 8) as i64));
                    push[AInstr](out, ai_call(cg.*.al_lbl));
                    push[AInstr](out, ai_mov_rr(A_X10(), A_X0()));
                    ac_emit_lea(out, A_X11(), cdisp);
                    ac_emit_copy(out, nw);
                    push[AInstr](out, ai_load(A_X9(), A_X29(), env_save));
                    push[AInstr](out, ai_store(A_X9(), 8 * ci, A_X10()));
                } else {
                    push[AInstr](out, ai_load(A_X0(), A_X29(), cdisp));
                    push[AInstr](out, ai_load(A_X10(), A_X29(), env_save));
                    push[AInstr](out, ai_store(A_X10(), 8 * ci, A_X0()));
                }
            }
        } else {
            ac_err(cg, _zag_str_concat("arm64: capture of unknown variable: ", real_cn));
        }
        ci = ci + 1;
    }
    push[AInstr](out, ai_load(A_X0(), A_X29(), env_save));
    push[AInstr](out, ai_store(A_X29(), fb + 8, A_X0()));
    ac_emit_lea(out, A_X0(), fb);
    push[AInstr](out, ai_push(A_X0()));
}

// ── lvalue address ───────────────────────────────────────────────────────────
// Pushes the ADDRESS of the lvalue onto the expression stack.

fn ac_lower_addr(out: *ArrayList[AInstr], n: *Node, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) void {
    switch (n.*) {
        .id => |x| {
            let gaddr: i64 = ac_global_addr(cg, x.name);
            if (gaddr != 0 && ac_slot_find(env, x.name) == 0) {
                ac_emit_global_address(out, cg, gaddr);
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            let disp: i32 = ac_slot_find(env, x.name);
            if (disp == 0) {
                ac_err(cg, _zag_str_concat("arm64: address of unknown identifier: ", x.name));
                push[AInstr](out, ai_mov_imm(A_X0(), 0));
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            if (ac_slot_byref(env, x.name) == 1) {
                push[AInstr](out, ai_load(A_X0(), A_X29(), disp));
            } else {
                ac_emit_lea(out, A_X0(), disp);
            }
            push[AInstr](out, ai_push(A_X0()));
        }
        .fld => |f| {
            let bt: []u8 = ac_expr_type(f.base, env, syms, cg);
            if (@strEq(f.fname, "*")) {
                // address of p.* is the pointer value itself
                ac_lower_expr(out, f.base, env, syms, cg);
                if (bt.len > 1 && bt[0] == '*') {
                    push[AInstr](out, ai_pop(A_X0()));
                    ac_emit_checked_nonnull(out, A_X0(), cg);
                    ac_emit_checked_alignment(out, A_X0(), ac_checked_alignment(bt[1..]), cg);
                    push[AInstr](out, ai_push(A_X0()));
                }
                return;
            }
            if (@strEq(f.fname, "len") &&
                (ac_type_is_slice(bt) == 1 ||
                 (bt.len > 1 && bt[0] == '*' && ac_type_is_slice(bt[1..]) == 1))) {
                ac_lower_expr(out, f.base, env, syms, cg);
                push[AInstr](out, ai_pop(A_X0()));
                push[AInstr](out, ai_add_imm(A_X0(), 8));
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            let sname: []u8 = bt;
            if (bt.len > 1 && bt[0] == '*') { sname = bt[1..]; }
            let off: i32 = ac_field_offset(cg, sname, f.fname);
            if (off < 0) {
                ac_err(cg, _zag_str_concat("arm64: unknown field: ", f.fname));
                push[AInstr](out, ai_mov_imm(A_X0(), 0));
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            ac_lower_expr(out, f.base, env, syms, cg);   // base address / ptr value
            push[AInstr](out, ai_pop(A_X0()));
            if (off > 0) { push[AInstr](out, ai_add_imm(A_X0(), off as i64)); }
            push[AInstr](out, ai_push(A_X0()));
        }
        .idx => |ix| {
            let bt: []u8 = ac_expr_type(ix.base, env, syms, cg);
            if (bt.len > 1 && bt[0] == '*') {
                let elem: []u8 = bt[1..];
                let stride: i32 = ac_elem_stride(cg, elem);
                ac_lower_expr(out, ix.base, env, syms, cg);
                ac_lower_expr(out, ix.idx, env, syms, cg);
                push[AInstr](out, ai_pop(A_X1()));
                push[AInstr](out, ai_pop(A_X0()));
                // Keep the allocation root separate from the final computed
                // address. Otherwise p[far] could evade the provenance lookup
                // merely because the result falls outside its allocation (or
                // accidentally lands in a different live allocation).
                push[AInstr](out, ai_mov_rr(A_X7(), A_X0()));
                ac_emit_raw_index_address(out, cg, stride);
                ac_emit_checked_raw_access(out, cg,
                    ac_type_alignment(cg, elem), stride);
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            if (ac_type_is_slice(bt) == 1) {
                let elem: []u8 = ac_slice_elem(bt);
                let stride: i32 = ac_elem_stride(cg, elem);
                ac_lower_expr(out, ix.base, env, syms, cg);
                push[AInstr](out, ai_pop(A_X8()));
                push[AInstr](out, ai_load(A_X2(), A_X8(), 8));
                push[AInstr](out, ai_load(A_X0(), A_X8(), 0));
                push[AInstr](out, ai_push(A_X0()));
                push[AInstr](out, ai_push(A_X2()));
                ac_lower_expr(out, ix.idx, env, syms, cg);
                push[AInstr](out, ai_pop(A_X1()));
                push[AInstr](out, ai_pop(A_X2()));
                let bad_index: i32 = ac_fresh(cg);
                let good_index: i32 = ac_fresh(cg);
                let after_bad_index: i32 = ac_fresh(cg);
                push[AInstr](out, ai_cmp_imm(A_X1(), 0));
                push[AInstr](out, ai_jl(bad_index));
                push[AInstr](out, ai_cmp(A_X1(), A_X2()));
                push[AInstr](out, ai_jge(bad_index));
                push[AInstr](out, ai_jmp(good_index));
                push[AInstr](out, ai_label(bad_index));
                ac_emit_panic(out, "panic: slice index out of bounds",
                    after_bad_index, cg);
                push[AInstr](out, ai_label(good_index));
                push[AInstr](out, ai_pop(A_X0()));
                ac_emit_raw_index_address(out, cg, stride);
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            ac_err(cg, "arm64: indexing a non-slice/pointer value");
            push[AInstr](out, ai_mov_imm(A_X0(), 0));
            push[AInstr](out, ai_push(A_X0()));
        }
        else => {
            ac_err(cg, "arm64: unsupported lvalue");
            push[AInstr](out, ai_mov_imm(A_X0(), 0));
            push[AInstr](out, ai_push(A_X0()));
        }
    }
}

// ── expressions ──────────────────────────────────────────────────────────────

// Is a binary operand pair UNSIGNED? A positive integer literal is comptime:
// it adopts the type of the slot/operand it flows into, so `1 < top` with
// `top: u64` is an unsigned comparison even though the literal itself reports
// i64. Only the literal-left case consults the right operand, so two
// signedness-declared variables keep the existing left-operand rule.
fn ac_bin_unsigned_int(l: *Node, r: *Node, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) i32 {
    if (cg_is_unsigned_int_type(ac_expr_type(l, env, syms, cg)) == 1) { return 1; }
    switch (l.*) {
        .ilit => |x| {
            // A magnitude above i64 max is only representable as u64.
            if (int_literal_exceeds_i64(x.text) == 1) { return 1; }
        }
        else => { }
    }
    switch (r.*) {
        .ilit => |x| { if (int_literal_exceeds_i64(x.text) == 1) { return 1; } }
        else => { }
    }
    if (cg_is_unsigned_int_type(ac_expr_type(r, env, syms, cg)) == 1) { return 1; }
    return 0;
}

fn ac_lower_expr(out: *ArrayList[AInstr], n: *Node, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) void {
    switch (n.*) {
        .ilit => |x| {
            if (cg_is_float_text(x.text) == 1) {
                let fe: i32 = 0;
                let fbits: i64 = zf64_bits_core(x.text, &fe);
                if (fe == 1) { ac_err(cg, "arm64: float literal out of supported range"); }
                push[AInstr](out, ai_mov_imm(A_X0(), fbits));
                push[AInstr](out, ai_push(A_X0()));
            } else if (ac_is_int_text(x.text) == 1) {
                push[AInstr](out, ai_mov_imm(A_X0(), ac_parse_i64(x.text)));
                push[AInstr](out, ai_push(A_X0()));
            } else {
                let cv: i64 = ac_char_lit_val(x.text);
                if (cv >= 0) {
                    push[AInstr](out, ai_mov_imm(A_X0(), cv));
                    push[AInstr](out, ai_push(A_X0()));
                } else {
                    ac_err(cg, "arm64: unsupported numeric literal");
                    push[AInstr](out, ai_mov_imm(A_X0(), 0));
                    push[AInstr](out, ai_push(A_X0()));
                }
            }
        }
        .id => |x| {
            if (@strEq(x.name, "true")) {
                push[AInstr](out, ai_mov_imm(A_X0(), 1));
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            if (@strEq(x.name, "false") || @strEq(x.name, "null")) {
                push[AInstr](out, ai_mov_imm(A_X0(), 0));
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            // v2 global scalar: fixed ELF BSS or PIE-relative Mach-O data.
            let gaddr: i64 = ac_global_addr(cg, x.name);
            if (gaddr != 0 && ac_slot_find(env, x.name) == 0) {
                ac_emit_global_address(out, cg, gaddr);
                push[AInstr](out, ai_load(A_X0(), A_X0(), 0));
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            let disp: i32 = ac_slot_find(env, x.name);
            if (disp == 0) {
                let flbl: i32 = ac_find_fn(syms, x.name);
                if (flbl >= 0) {
                    if (ac_is_desugared_const(cg, x.name) == 1) {
                        let const_args: ArrayList[*Node] = make[*Node](1);
                        let const_targs: ArrayList[[]u8] = make[[]u8](1);
                        ac_lower_call(out, Call{ .callee = mk_ident(x.name), .args = const_args, .targs = const_targs }, env, syms, cg);
                        free[*Node](&const_args);
                        free[[]u8](&const_targs);
                        return;
                    }
                    ac_materialize_fat_fn(out, x.name, flbl, env, syms, cg);
                    return;
                }
                ac_err(cg, _zag_str_concat("arm64: unknown identifier: ", x.name));
                push[AInstr](out, ai_mov_imm(A_X0(), 0));
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            let ty: []u8 = ac_slot_type(env, x.name);
            if (ac_is_aggregate(cg, ty) == 1) {
                if (ac_slot_byref(env, x.name) == 1) {
                    push[AInstr](out, ai_load(A_X0(), A_X29(), disp));
                } else {
                    ac_emit_lea(out, A_X0(), disp);
                }
                push[AInstr](out, ai_push(A_X0()));
            } else {
                push[AInstr](out, ai_load(A_X0(), A_X29(), disp));
                push[AInstr](out, ai_push(A_X0()));
            }
        }
        .un => |u| {
            if (@strEq(u.op, "-")) {
                ac_lower_expr(out, u.e, env, syms, cg);
                push[AInstr](out, ai_pop(A_X0()));
                if (ac_is_float(ac_expr_type(u.e, env, syms, cg)) == 1) {
                    // flip the IEEE sign bit: x ^ (1<<63)
                    push[AInstr](out, ai_mov_imm(A_X9(), (0 - 9223372036854775807) - 1));
                    push[AInstr](out, ai_xor(A_X0(), A_X9()));
                } else {
                    push[AInstr](out, ai_neg(A_X0(), A_X0()));
                }
                push[AInstr](out, ai_push(A_X0()));
            } else if (@strEq(u.op, "!")) {
                ac_lower_expr(out, u.e, env, syms, cg);
                push[AInstr](out, ai_pop(A_X0()));
                push[AInstr](out, ai_cmp_imm(A_X0(), 0));
                let l0: i32 = ac_fresh(cg);
                let l1: i32 = ac_fresh(cg);
                push[AInstr](out, ai_je(l0));
                push[AInstr](out, ai_mov_imm(A_X0(), 0));
                push[AInstr](out, ai_jmp(l1));
                push[AInstr](out, ai_label(l0));
                push[AInstr](out, ai_mov_imm(A_X0(), 1));
                push[AInstr](out, ai_label(l1));
                push[AInstr](out, ai_push(A_X0()));
            } else if (@strEq(u.op, "&")) {
                ac_lower_addr(out, u.e, env, syms, cg);
            } else if (@strEq(u.op, "try")) {
                // try expr — expr is !T {err@0,val@8}; err==0 → val, else propagate.
                let l_ok: i32 = ac_fresh(cg);
                ac_lower_expr(out, u.e, env, syms, cg);   // pushes &{err,val}
                push[AInstr](out, ai_pop(A_X10()));
                push[AInstr](out, ai_load(A_X0(), A_X10(), 0));
                push[AInstr](out, ai_cmp_imm(A_X0(), 0));
                push[AInstr](out, ai_je(l_ok));
                if (cg.*.ret_ty.len > 1 && cg.*.ret_ty[0] == '!') {
                    push[AInstr](out, ai_load(A_X11(), A_X29(), cg.*.sret_disp));
                    push[AInstr](out, ai_store(A_X11(), 0, A_X0()));
                    push[AInstr](out, ai_mov_imm(A_X9(), 0));
                    push[AInstr](out, ai_store(A_X11(), 8, A_X9()));
                    push[AInstr](out, ai_mov_rr(A_X0(), A_X11()));
                } else {
                    ac_err(cg, "arm64: try in a fn that does not return !T");
                }
                // try error propagation: set is_err=1 for errdefer, jump to cleanup.
                push[AInstr](out, ai_mov_imm(A_X9(), 1));
                push[AInstr](out, ai_store(A_X29(), env.*.is_err_slot, A_X9()));
                push[AInstr](out, ai_jmp(cg.*.pre_epilogue));
                push[AInstr](out, ai_label(l_ok));
                push[AInstr](out, ai_load(A_X0(), A_X10(), 8));
                push[AInstr](out, ai_push(A_X0()));
            } else {
                ac_err(cg, "arm64: unsupported unary operator");
                push[AInstr](out, ai_mov_imm(A_X0(), 0));
                push[AInstr](out, ai_push(A_X0()));
            }
        }
        .bin => |b| {
            if (@strEq(b.op, "orelse")) {
                let lt: []u8 = ac_expr_type(b.l, env, syms, cg);
                if (ac_is_optional(lt) == 0) {
                    ac_err(cg, "arm64: orelse on non-optional value");
                    push[AInstr](out, ai_mov_imm(A_X0(), 0));
                    push[AInstr](out, ai_push(A_X0()));
                    return;
                }
                let pty: []u8 = lt[1..];
                if (ac_is_aggregate(cg, pty) == 1) {
                    ac_err(cg, "arm64: orelse on aggregate payloads not yet supported");
                    push[AInstr](out, ai_mov_imm(A_X0(), 0));
                    push[AInstr](out, ai_push(A_X0()));
                    return;
                }
                let l_none: i32 = ac_fresh(cg);
                let l_done: i32 = ac_fresh(cg);
                ac_lower_expr(out, b.l, env, syms, cg);
                push[AInstr](out, ai_pop(A_X10()));
                push[AInstr](out, ai_load(A_X0(), A_X10(), 0));
                push[AInstr](out, ai_cmp_imm(A_X0(), 0));
                push[AInstr](out, ai_je(l_none));
                push[AInstr](out, ai_load(A_X0(), A_X10(), 8));
                push[AInstr](out, ai_push(A_X0()));
                push[AInstr](out, ai_jmp(l_done));
                push[AInstr](out, ai_label(l_none));
                ac_lower_expr(out, b.r, env, syms, cg);
                push[AInstr](out, ai_label(l_done));
                return;
            }
            if (@strEq(b.op, "&&") || @strEq(b.op, "||")) {
                // short-circuit: the right operand must NOT be evaluated when
                // the left already decides the result (side effects!).
                let l_out: i32 = ac_fresh(cg);
                let l_done: i32 = ac_fresh(cg);
                ac_lower_expr(out, b.l, env, syms, cg);
                push[AInstr](out, ai_pop(A_X0()));
                push[AInstr](out, ai_cmp_imm(A_X0(), 0));
                if (@strEq(b.op, "&&")) { push[AInstr](out, ai_je(l_out)); }
                else { push[AInstr](out, ai_jne(l_out)); }
                ac_lower_expr(out, b.r, env, syms, cg);
                push[AInstr](out, ai_pop(A_X0()));
                push[AInstr](out, ai_cmp_imm(A_X0(), 0));
                if (@strEq(b.op, "&&")) { push[AInstr](out, ai_je(l_out)); }
                else { push[AInstr](out, ai_jne(l_out)); }
                if (@strEq(b.op, "&&")) { push[AInstr](out, ai_mov_imm(A_X0(), 1)); }
                else { push[AInstr](out, ai_mov_imm(A_X0(), 0)); }
                push[AInstr](out, ai_jmp(l_done));
                push[AInstr](out, ai_label(l_out));
                if (@strEq(b.op, "&&")) { push[AInstr](out, ai_mov_imm(A_X0(), 0)); }
                else { push[AInstr](out, ai_mov_imm(A_X0(), 1)); }
                push[AInstr](out, ai_label(l_done));
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            let lty_vsa: []u8 = ac_expr_type(b.l, env, syms, cg);
            let rty_vsa: []u8 = ac_expr_type(b.r, env, syms, cg);
            if (vsa_type_valid(lty_vsa) == 1 || vsa_type_valid(rty_vsa) == 1) {
                ac_lower_vsa_bin(out, b, lty_vsa, rty_vsa, env, syms, cg);
                return;
            }
            let flt: i32 = ac_is_float(ac_expr_type(b.l, env, syms, cg));
            let frt: i32 = ac_is_float(ac_expr_type(b.r, env, syms, cg));
            if (flt == 1 || frt == 1) {
                if (flt == 0 || frt == 0) {
                    ac_err(cg, "arm64: mixed int/float arithmetic — add an explicit `as f64` cast");
                }
                ac_lower_expr(out, b.l, env, syms, cg);
                ac_lower_expr(out, b.r, env, syms, cg);
                push[AInstr](out, ai_pop(A_X1()));
                push[AInstr](out, ai_pop(A_X0()));
                push[AInstr](out, ai_fmov_dx(0, A_X0()));
                push[AInstr](out, ai_fmov_dx(1, A_X1()));
                if (ac_cmp_cc(b.op) >= 0) {
                    push[AInstr](out, ai_fcmp(0, 1));
                    let fl0: i32 = ac_fresh(cg);
                    let fl1: i32 = ac_fresh(cg);
                    ac_push_jcc_false(out, b.op, fl0);
                    push[AInstr](out, ai_mov_imm(A_X0(), 1));
                    push[AInstr](out, ai_jmp(fl1));
                    push[AInstr](out, ai_label(fl0));
                    push[AInstr](out, ai_mov_imm(A_X0(), 0));
                    push[AInstr](out, ai_label(fl1));
                    push[AInstr](out, ai_push(A_X0()));
                    return;
                }
                if (@strEq(b.op, "+")) { push[AInstr](out, ai_fadd(0, 1)); }
                else if (@strEq(b.op, "-")) { push[AInstr](out, ai_fsub(0, 1)); }
                else if (@strEq(b.op, "*")) { push[AInstr](out, ai_fmul(0, 1)); }
                else if (@strEq(b.op, "/")) { push[AInstr](out, ai_fdiv(0, 1)); }
                else { ac_err(cg, "arm64: operator not supported on floats"); }
                push[AInstr](out, ai_fmov_xd(A_X0(), 0));
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            // ── posit types: arithmetic via runtime calls ──────────────────────
            // Posit binary ops (+,-,*,/) call znrt_<ptype>_<op>(x0=a, x1=b) → x0.
            // Comparisons fall through to integer compare (bit-pattern ordering).
            let lty_p: []u8 = ac_expr_type(b.l, env, syms, cg);
            let rty_p: []u8 = ac_expr_type(b.r, env, syms, cg);
            let lp: i32 = cg_is_posit_ty(lty_p);
            let rp: i32 = cg_is_posit_ty(rty_p);
            if (lp == 1 || rp == 1) {
                if (lp != rp) {
                    ac_err(cg, "arm64: cannot mix posit and non-posit operands");
                    push[AInstr](out, ai_mov_imm(A_X0(), 0));
                    push[AInstr](out, ai_push(A_X0()));
                    return;
                }
                let pty: []u8 = lty_p;
                if (lp == 0) { pty = rty_p; }
                if (ac_cmp_cc(b.op) >= 0) {
                    // comparisons: use integer compare on bit patterns
                    ac_lower_expr(out, b.l, env, syms, cg);
                    ac_lower_expr(out, b.r, env, syms, cg);
                    push[AInstr](out, ai_pop(A_X1()));
                    push[AInstr](out, ai_pop(A_X0()));
                    push[AInstr](out, ai_cmp(A_X0(), A_X1()));
                    let l0: i32 = ac_fresh(cg);
                    let l1: i32 = ac_fresh(cg);
                    ac_push_jcc_false(out, b.op, l0);
                    push[AInstr](out, ai_mov_imm(A_X0(), 1));
                    push[AInstr](out, ai_jmp(l1));
                    push[AInstr](out, ai_label(l0));
                    push[AInstr](out, ai_mov_imm(A_X0(), 0));
                    push[AInstr](out, ai_label(l1));
                    push[AInstr](out, ai_push(A_X0()));
                    return;
                }
                let opfn: []u8 = cg_posit_op_fn(pty, b.op);
                if (opfn.len > 0) {
                    let opl: i32 = ac_find_fn(syms, opfn);
                    if (opl < 0) {
                        ac_err(cg, "arm64: posit runtime fn not found");
                        push[AInstr](out, ai_mov_imm(A_X0(), 0));
                        push[AInstr](out, ai_push(A_X0()));
                        return;
                    }
                    ac_lower_expr(out, b.l, env, syms, cg);
                    ac_lower_expr(out, b.r, env, syms, cg);
                    push[AInstr](out, ai_pop(A_X1()));
                    push[AInstr](out, ai_pop(A_X0()));
                    push[AInstr](out, ai_call(opl));
                    push[AInstr](out, ai_push(A_X0()));
                    return;
                }
                ac_err(cg, "arm64: unsupported posit operator");
                push[AInstr](out, ai_mov_imm(A_X0(), 0));
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            // ── RNS types: arithmetic via runtime calls (aggregate sret) ────────
            let lr: i32 = cg_is_rns_ty(lty_p);
            let rr: i32 = cg_is_rns_ty(rty_p);
            if (lr == 1 || rr == 1) {
                if (lr != rr) {
                    ac_err(cg, "arm64: cannot mix RNS and non-RNS operands");
                    push[AInstr](out, ai_mov_imm(A_X0(), 0));
                    push[AInstr](out, ai_push(A_X0()));
                    return;
                }
                let rfn: []u8 = cg_rns_op_fn(b.op);
                if (rfn.len > 0) {
                    let rargs: ArrayList[*Node] = make[*Node](2);
                    push[*Node](&rargs, b.l);
                    push[*Node](&rargs, b.r);
                    ac_lower_call(out, Call{ .callee = mk_ident(rfn), .args = rargs, .targs = make[[]u8](1) }, env, syms, cg);
                    return;
                }
                ac_err(cg, "arm64: unsupported RNS operator");
                push[AInstr](out, ai_mov_imm(A_X0(), 0));
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            // ── saturated arithmetic: via runtime calls ────────────────────────
            // Sat +,-,* call znrt_sat_<base>_<op>(x0=a, x1=b) → x0.
            let lsf: i32 = cg_is_satfixarb_ty(lty_p);
            let rsf: i32 = cg_is_satfixarb_ty(rty_p);
            if (lsf == 1 || rsf == 1) {
                let nty: []u8 = lty_p;
                if (lsf == 0) { nty = rty_p; }
                // Saturated arithmetic
                if (cg_is_sat_ty(nty) == 1) {
                    let opfn: []u8 = cg_sat_op_fn(nty, b.op);
                    if (opfn.len > 0) {
                        let opl: i32 = ac_find_fn(syms, opfn);
                        if (opl < 0) { ac_err(cg, "arm64: sat runtime fn not found"); }
                        ac_lower_expr(out, b.l, env, syms, cg);
                        ac_lower_expr(out, b.r, env, syms, cg);
                        push[AInstr](out, ai_pop(A_X1()));
                        push[AInstr](out, ai_pop(A_X0()));
                        push[AInstr](out, ai_call(opl));
                        push[AInstr](out, ai_push(A_X0()));
                        return;
                    }
                    // division/comparisons: fall through to native integer path
                }
                // Fixed-point: only * uses runtime; +,-,/,% are native integer
                if (cg_is_fixed_ty(nty) == 1) {
                    if (@strEq(b.op, "*")) {
                        let fl: i32 = ac_find_fn(syms, "znrt_fixed_mul");
                        let fbits: i64 = cg_fixed_frac_bits(nty);
                        if (fl < 0) { ac_err(cg, "arm64: fixed_mul runtime fn not found"); }
                        ac_lower_expr(out, b.l, env, syms, cg);
                        ac_lower_expr(out, b.r, env, syms, cg);
                        push[AInstr](out, ai_pop(A_X1()));
                        push[AInstr](out, ai_pop(A_X0()));
                        push[AInstr](out, ai_mov_imm(A_X2(), fbits));
                        push[AInstr](out, ai_call(fl));
                        push[AInstr](out, ai_push(A_X0()));
                        return;
                    }
                    // +,-,/,% : native int ops — fall through
                }
                // Arbitrary-width unsigned integers: inline masking
                if (cg_is_arb_int_ty(nty) == 1 && cg_arb_int_signed(nty) == 0) {
                    let is_mask_op: i32 = 0;
                    if (@strEq(b.op, "+") || @strEq(b.op, "-") || @strEq(b.op, "*")
                        || @strEq(b.op, "&") || @strEq(b.op, "^") || @strEq(b.op, "|")) { is_mask_op = 1; }
                    if (is_mask_op == 1) {
                        let nbits: i64 = cg_arb_int_bits(nty);
                        ac_lower_expr(out, b.l, env, syms, cg);
                        ac_lower_expr(out, b.r, env, syms, cg);
                        push[AInstr](out, ai_pop(A_X1()));
                        push[AInstr](out, ai_pop(A_X0()));
                        if (@strEq(b.op, "+")) { push[AInstr](out, ai_add(A_X0(), A_X1())); }
                        else if (@strEq(b.op, "-")) { push[AInstr](out, ai_sub(A_X0(), A_X1())); }
                        else if (@strEq(b.op, "*")) { push[AInstr](out, ai_mul(A_X0(), A_X0(), A_X1())); }
                        else if (@strEq(b.op, "&")) { push[AInstr](out, ai_andr(A_X0(), A_X1())); }
                        else if (@strEq(b.op, "^")) { push[AInstr](out, ai_xor(A_X0(), A_X1())); }
                        else if (@strEq(b.op, "|")) { push[AInstr](out, ai_or(A_X0(), A_X1())); }
                        // mask to the low N bits: x0 = x0 & (2^N - 1)
                        let mask: i64 = cg_arb_mask(nbits);
                        push[AInstr](out, ai_mov_imm(A_X9(), mask));
                        push[AInstr](out, ai_andr(A_X0(), A_X9()));
                        push[AInstr](out, ai_push(A_X0()));
                        return;
                    }
                    // /,%, comparisons: fall through to native integer path
                }
                // Signed arb-int: fall through to native integer path
            }
            ac_lower_expr(out, b.l, env, syms, cg);
            ac_lower_expr(out, b.r, env, syms, cg);
            push[AInstr](out, ai_pop(A_X1()));
            push[AInstr](out, ai_pop(A_X0()));
            if (@strEq(b.op, "+")) {
                push[AInstr](out, ai_add(A_X0(), A_X1()));
            } else if (@strEq(b.op, "-")) {
                push[AInstr](out, ai_sub(A_X0(), A_X1()));
            } else if (@strEq(b.op, "*")) {
                push[AInstr](out, ai_mul(A_X0(), A_X0(), A_X1()));
            } else if (@strEq(b.op, "/")) {
                // DEFINED division: /0 panics (SDIV alone would silently give 0)
                ac_emit_div0_guard(out, cg);
                if (ac_bin_unsigned_int(b.l, b.r, env, syms, cg) == 1) {
                    push[AInstr](out, ai_udiv(A_X0(), A_X0(), A_X1()));
                } else {
                    push[AInstr](out, ai_sdiv(A_X0(), A_X0(), A_X1()));
                }
            } else if (@strEq(b.op, "%")) {
                ac_emit_div0_guard(out, cg);
                if (ac_bin_unsigned_int(b.l, b.r, env, syms, cg) == 1) {
                    push[AInstr](out, ai_udiv(A_X9(), A_X0(), A_X1()));
                } else {
                    push[AInstr](out, ai_sdiv(A_X9(), A_X0(), A_X1()));
                }
                push[AInstr](out, ai_mul(A_X9(), A_X9(), A_X1()));
                push[AInstr](out, ai_sub(A_X0(), A_X9()));
            } else if (@strEq(b.op, "&")) {
                push[AInstr](out, ai_andr(A_X0(), A_X1()));
            } else if (@strEq(b.op, "^")) {
                push[AInstr](out, ai_xor(A_X0(), A_X1()));
            } else if (@strEq(b.op, "|")) {
                push[AInstr](out, ai_or(A_X0(), A_X1()));
            } else if (@strEq(b.op, "<<")) {
                push[AInstr](out, ai_shl(A_X0(), A_X1()));
            } else if (@strEq(b.op, ">>")) {
                if (cg_is_unsigned_int_type(ac_expr_type(b.l, env, syms, cg)) == 1) {
                    push[AInstr](out, ai_lshr(A_X0(), A_X1()));
                } else {
                    push[AInstr](out, ai_shr(A_X0(), A_X1()));
                }
            } else if (ac_cmp_cc(b.op) >= 0) {
                push[AInstr](out, ai_cmp(A_X0(), A_X1()));
                let l0: i32 = ac_fresh(cg);
                let l1: i32 = ac_fresh(cg);
                // Unsigned integer types compare with the carry-flag family so
                // values with bit 63 set order correctly; signed keeps LT/GT.
                if (ac_bin_unsigned_int(b.l, b.r, env, syms, cg) == 1) {
                    ac_push_jcc_false_u(out, b.op, l0);
                } else {
                    ac_push_jcc_false(out, b.op, l0);
                }
                push[AInstr](out, ai_mov_imm(A_X0(), 1));
                push[AInstr](out, ai_jmp(l1));
                push[AInstr](out, ai_label(l0));
                push[AInstr](out, ai_mov_imm(A_X0(), 0));
                push[AInstr](out, ai_label(l1));
            } else {
                ac_err(cg, "arm64: unsupported binary operator");
                push[AInstr](out, ai_mov_imm(A_X0(), 0));
            }
            if (ac_cmp_cc(b.op) < 0 && !@strEq(b.op, "&&") && !@strEq(b.op, "||")) {
                // normalize the result to its declared width (i32 wraps at 32
                // bits, u32 zero-extends) — same contract as the x86 backend.
                let rty: []u8 = cg_norm_type(ac_expr_type(b.l, env, syms, cg));
                if (@strEq(rty, "i32")) {
                    push[AInstr](out, ai_sxtw(A_X0(), A_X0()));
                } else if (@strEq(rty, "u32")) {
                    push[AInstr](out, ai_and_imm(A_X0(), 4294967295));
                }
            }
            push[AInstr](out, ai_push(A_X0()));
        }
        .call => |c| {
            ac_lower_call(out, c, env, syms, cg);
        }
        .slit => |sl| {
            let off: i32 = ac_intern_str(cg, sl.text, 0);
            let dlen: i32 = ac_decoded_len(sl.text);
            let base: i32 = ac_slot_scratch(cg, 2);
            push[AInstr](out, ai_data_addr(A_X0(), off));
            push[AInstr](out, ai_store(A_X29(), base + 0, A_X0()));
            push[AInstr](out, ai_mov_imm(A_X0(), dlen as i64));
            push[AInstr](out, ai_store(A_X29(), base + 8, A_X0()));
            ac_emit_lea(out, A_X0(), base);
            push[AInstr](out, ai_push(A_X0()));
        }
        .embed => |em| {
            let off:i32=len[u8](cg.*.data.*);
            let bi:i32=0;
            while(bi<em.data.len){push[u8](cg.*.data,em.data[bi]);bi=bi+1;}
            let base:i32=ac_slot_scratch(cg,2);
            push[AInstr](out,ai_data_addr(A_X0(),off));
            push[AInstr](out,ai_store(A_X29(),base+0,A_X0()));
            push[AInstr](out,ai_mov_imm(A_X0(),em.data.len as i64));
            push[AInstr](out,ai_store(A_X29(),base+8,A_X0()));
            ac_emit_lea(out,A_X0(),base);
            push[AInstr](out,ai_push(A_X0()));
        }
        .slit_ => |sl| {
            let lit_sname: []u8 = cg_slit_sname(sl);
            // union literal: Node{ .tag = payload } → {tag@0, payload@8}
            if (ac_is_union(cg, lit_sname) == 1) {
                let uw: i32 = ac_type_words(cg, lit_sname);
                let ubase: i32 = ac_slot_scratch(cg, uw);
                if (len[FieldInit](sl.fields) != 1) {
                    ac_err(cg, "arm64: union literal needs exactly one member");
                } else {
                    let ufi: FieldInit = get[FieldInit](sl.fields, 0);
                    let tagv: i32 = ac_union_tag(cg, lit_sname, ufi.name);
                    if (tagv < 0) { ac_err(cg, _zag_str_concat("arm64: unknown union member: ", ufi.name)); tagv = 0; }
                    push[AInstr](out, ai_mov_imm(A_X0(), tagv as i64));
                    push[AInstr](out, ai_store(A_X29(), ubase + 0, A_X0()));
                    let pty: []u8 = ac_union_payload_type(cg, lit_sname, ufi.name);
                    ac_lower_expr(out, ufi.val, env, syms, cg);
                    if (ac_is_aggregate(cg, pty) == 1) {
                        push[AInstr](out, ai_pop(A_X11()));
                        ac_emit_lea(out, A_X10(), ubase + 8);
                        ac_emit_copy(out, ac_type_words(cg, pty));
                    } else {
                        push[AInstr](out, ai_pop(A_X0()));
                        push[AInstr](out, ai_store(A_X29(), ubase + 8, A_X0()));
                    }
                }
                ac_emit_lea(out, A_X0(), ubase);
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            // struct literal → fill a scratch block, push its address
            let w: i32 = ac_type_words(cg, lit_sname);
            let base: i32 = ac_slot_scratch(cg, w);
            let i: i32 = 0;
            while (i < len[FieldInit](sl.fields)) {
                let fi: FieldInit = get[FieldInit](sl.fields, i);
                let off: i32 = ac_field_offset(cg, lit_sname, fi.name);
                if (off < 0) {
                    ac_err(cg, _zag_str_concat("arm64: unknown struct field: ", fi.name));
                } else {
                    let fty: []u8 = ac_field_type(cg, lit_sname, fi.name);
                    let layout_width: i32 = ac_layout_field_width(cg, lit_sname, fi.name);
                    if (ac_is_optional(cg_norm_type(fty)) == 1 && ac_is_null_node(fi.val) == 1) {
                        // ?T field = null → {has=0}
                        push[AInstr](out, ai_mov_imm(A_X0(), 0));
                        push[AInstr](out, ai_store(A_X29(), base + off, A_X0()));
                    } else if (ac_is_optional(cg_norm_type(fty)) == 1 &&
                               ac_is_optional(ac_expr_type(fi.val, env, syms, cg)) == 0) {
                        // ?T field = value → wrap {has=1, val} (payload scalar or aggregate)
                        push[AInstr](out, ai_mov_imm(A_X0(), 1));
                        push[AInstr](out, ai_store(A_X29(), base + off, A_X0()));
                        let pty3: []u8 = cg_norm_type(fty)[1..];
                        ac_lower_expr(out, fi.val, env, syms, cg);
                        if (ac_is_aggregate(cg, pty3) == 1) {
                            push[AInstr](out, ai_pop(A_X11()));
                            ac_emit_lea(out, A_X10(), base + off + 8);
                            ac_emit_copy(out, ac_type_words(cg, pty3));
                        } else {
                            push[AInstr](out, ai_pop(A_X0()));
                            push[AInstr](out, ai_store(A_X29(), base + off + 8, A_X0()));
                        }
                    } else {
                        ac_lower_expr(out, fi.val, env, syms, cg);
                        if (ac_is_aggregate(cg, fty) == 1) {
                            push[AInstr](out, ai_pop(A_X11()));
                            ac_emit_lea(out, A_X10(), base + off);
                            ac_emit_copy(out, ac_type_words(cg, fty));
                        } else {
                            push[AInstr](out, ai_pop(A_X0()));
                            if (layout_width > 0) { ac_emit_store_layout(out, A_X29(), base + off, layout_width, A_X0()); }
                            else { push[AInstr](out, ai_store(A_X29(), base + off, A_X0())); }
                        }
                    }
                }
                i = i + 1;
            }
            ac_emit_lea(out, A_X0(), base);
            push[AInstr](out, ai_push(A_X0()));
        }
        .fld => |f| {
            // enum member constant / error.X code (index+1 in __zag_errors)
            switch (f.base.*) {
                .id => |bid| {
                    if (@strEq(bid.name, "error") && ac_slot_find(env, bid.name) == 0) {
                        let ecv: i32 = ac_enum_member(cg, "__zag_errors", f.fname);
                        if (ecv < 0) { ac_err(cg, _zag_str_concat("arm64: unknown error: ", f.fname)); ecv = 0 - 1; }
                        push[AInstr](out, ai_mov_imm(A_X0(), (ecv + 1) as i64));
                        push[AInstr](out, ai_push(A_X0()));
                        return;
                    }
                    if (ac_slot_find(env, bid.name) == 0 && ac_is_enum(cg, bid.name) == 1) {
                        let mv: i32 = ac_enum_member(cg, bid.name, f.fname);
                        if (mv < 0) { ac_err(cg, _zag_str_concat("arm64: unknown enum member: ", f.fname)); mv = 0; }
                        push[AInstr](out, ai_mov_imm(A_X0(), mv as i64));
                        push[AInstr](out, ai_push(A_X0()));
                        return;
                    }
                }
                else => { }
            }
            let bt: []u8 = ac_expr_type(f.base, env, syms, cg);
            if (@strEq(f.fname, "*")) {
                let elem: []u8 = "";
                if (bt.len > 1 && bt[0] == '*') { elem = bt[1..]; }
                ac_lower_expr(out, f.base, env, syms, cg);   // pointer value
                push[AInstr](out, ai_pop(A_X0()));
                push[AInstr](out, ai_mov_rr(A_X7(), A_X0()));
                let width: i32 = ac_type_width(cg, elem);
                let align: i32 = ac_type_alignment(cg, elem);
                ac_emit_checked_raw_access(out, cg, align, width);
                if (ac_is_aggregate(cg, elem) == 1) {
                    // Aggregate values are represented by their address, but
                    // checked mode must still validate that address first.
                    push[AInstr](out, ai_push(A_X0()));
                    return;
                }
                push[AInstr](out, ai_load(A_X0(), A_X0(), 0));
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            if (@strEq(f.fname, "len") &&
                (ac_type_is_slice(bt) == 1 ||
                 (bt.len > 1 && bt[0] == '*' && ac_type_is_slice(bt[1..]) == 1))) {
                ac_lower_expr(out, f.base, env, syms, cg);
                push[AInstr](out, ai_pop(A_X10()));
                push[AInstr](out, ai_load(A_X0(), A_X10(), 8));
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            if (ac_is_optional(bt) == 1) {
                if (@strEq(f.fname, "has")) {
                    ac_lower_expr(out, f.base, env, syms, cg);
                    push[AInstr](out, ai_pop(A_X10()));
                    push[AInstr](out, ai_load(A_X0(), A_X10(), 0));
                    push[AInstr](out, ai_push(A_X0()));
                    return;
                }
                if (@strEq(f.fname, "val") || @strEq(f.fname, "?")) {
                    let pty2: []u8 = bt[1..];
                    ac_lower_expr(out, f.base, env, syms, cg);
                    push[AInstr](out, ai_pop(A_X10()));
                    if (ac_is_aggregate(cg, pty2) == 1) {
                        push[AInstr](out, ai_add_imm(A_X10(), 8));
                        push[AInstr](out, ai_push(A_X10()));
                    } else {
                        push[AInstr](out, ai_load(A_X0(), A_X10(), 8));
                        push[AInstr](out, ai_push(A_X0()));
                    }
                    return;
                }
            }
            let sname: []u8 = bt;
            if (bt.len > 1 && bt[0] == '*') { sname = bt[1..]; }
            let off: i32 = ac_field_offset(cg, sname, f.fname);
            if (off < 0) {
                ac_err(cg, _zag_str_concat("arm64: unknown field: ", f.fname));
                push[AInstr](out, ai_mov_imm(A_X0(), 0));
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            let fty: []u8 = ac_field_type(cg, sname, f.fname);
            let layout_width: i32 = ac_layout_field_width(cg, sname, f.fname);
            ac_lower_expr(out, f.base, env, syms, cg);
            push[AInstr](out, ai_pop(A_X10()));
            if (ac_is_aggregate(cg, fty) == 1) {
                if (off > 0) { push[AInstr](out, ai_add_imm(A_X10(), off as i64)); }
                push[AInstr](out, ai_push(A_X10()));
            } else {
                if (layout_width > 0) { ac_emit_load_layout(out, A_X10(), off, layout_width, fty); }
                else { push[AInstr](out, ai_load(A_X0(), A_X10(), off)); }
                push[AInstr](out, ai_push(A_X0()));
            }
        }
        .idx => |ix| {
            let bt: []u8 = ac_expr_type(ix.base, env, syms, cg);
            let elem: []u8 = "";
            if (ac_type_is_slice(bt) == 1) { elem = ac_slice_elem(bt); }
            else if (bt.len > 1 && bt[0] == '*') { elem = bt[1..]; }
            ac_lower_addr(out, n, env, syms, cg);
            push[AInstr](out, ai_pop(A_X10()));
            if (ac_is_aggregate(cg, elem) == 1) {
                push[AInstr](out, ai_push(A_X10()));
            } else if (ac_elem_is_byte(elem) == 1) {
                push[AInstr](out, ai_loadb(A_X0(), A_X10(), 0));
                push[AInstr](out, ai_push(A_X0()));
            } else {
                push[AInstr](out, ai_load(A_X0(), A_X10(), 0));
                push[AInstr](out, ai_push(A_X0()));
            }
        }
        .slice_ => |sc| {
            let bt: []u8 = ac_expr_type(sc.base, env, syms, cg);
            let is_ptr_base: i32 = 0;
            let elem: []u8 = "";
            if (ac_type_is_slice(bt) == 1) { elem = ac_slice_elem(bt); }
            else if (bt.len > 1 && bt[0] == '*') { elem = bt[1..]; is_ptr_base = 1; }
            else {
                ac_err(cg, "arm64: slicing a non-slice value");
                push[AInstr](out, ai_mov_imm(A_X0(), 0));
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            if (is_ptr_base == 1 && sc.has_hi == 0) {
                ac_err(cg, "arm64: p[lo..] on a raw pointer needs an upper bound");
                push[AInstr](out, ai_mov_imm(A_X0(), 0));
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            let stride: i32 = ac_elem_stride(cg, elem);
            ac_lower_expr(out, sc.base, env, syms, cg);
            ac_lower_expr(out, sc.lo, env, syms, cg);
            if (sc.has_hi == 1) { ac_lower_expr(out, sc.hi, env, syms, cg); }
            if (sc.has_hi == 1) { push[AInstr](out, ai_pop(A_X13())); }
            push[AInstr](out, ai_pop(A_X12()));
            push[AInstr](out, ai_pop(A_X10()));
            if (is_ptr_base == 1) {
                push[AInstr](out, ai_mov_rr(A_X0(), A_X10()));  // ptr value IS the data ptr
            } else {
                push[AInstr](out, ai_load(A_X0(), A_X10(), 0));    // data ptr
                push[AInstr](out, ai_load(A_X1(), A_X10(), 8));    // len
                if (sc.has_hi == 0) { push[AInstr](out, ai_mov_rr(A_X13(), A_X1())); }
            }
            // new ptr = ptr + lo*stride ; new len = hi - lo
            push[AInstr](out, ai_mov_imm(A_X9(), stride as i64));
            push[AInstr](out, ai_mul(A_X11(), A_X12(), A_X9()));
            push[AInstr](out, ai_add(A_X0(), A_X11()));
            push[AInstr](out, ai_sub(A_X13(), A_X12()));
            let base: i32 = ac_slot_scratch(cg, 2);
            push[AInstr](out, ai_store(A_X29(), base + 0, A_X0()));
            push[AInstr](out, ai_store(A_X29(), base + 8, A_X13()));
            ac_emit_lea(out, A_X0(), base);
            push[AInstr](out, ai_push(A_X0()));
        }
        .cast_ => |cst| {
            let csrc: []u8 = ac_expr_type(cst.expr, env, syms, cg);
            let sfl: i32 = ac_is_float(csrc);
            let tfl: i32 = ac_is_float(cg_norm_type(cst.target));
            if (sfl != tfl) {
                ac_lower_expr(out, cst.expr, env, syms, cg);
                push[AInstr](out, ai_pop(A_X0()));
                if (tfl == 1) {
                    push[AInstr](out, ai_scvtf(0, A_X0()));
                    push[AInstr](out, ai_fmov_xd(A_X0(), 0));
                } else {
                    push[AInstr](out, ai_fmov_dx(0, A_X0()));
                    push[AInstr](out, ai_fcvtzs(A_X0(), 0));
                    if (@strEq(cst.target, "i32")) { push[AInstr](out, ai_sxtw(A_X0(), A_X0())); }
                }
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            ac_lower_expr(out, cst.expr, env, syms, cg);
            if (sfl == 1 && tfl == 1) { return; }   // f32↔f64: both held as f64 bits
            // An explicit cast must normalize its result immediately, just
            // like a declared local, field, or call boundary. In particular,
            // i8/i16 require sign extension and u16 requires zero extension.
            if (@strEq(cst.target, "i8") || @strEq(cst.target, "u8") ||
                @strEq(cst.target, "i16") || @strEq(cst.target, "u16") ||
                @strEq(cst.target, "i32") || @strEq(cst.target, "u32")) {
                push[AInstr](out, ai_pop(A_X0()));
                ac_emit_cabi_int_normalize(out, A_X0(), cst.target);
                push[AInstr](out, ai_push(A_X0()));
            } else if (@strEq(cst.target, "i64") || @strEq(cst.target, "u64") || @strEq(cst.target, "usize")) {
                // i32 → i64 reads the LOW DWORD sign-extended (i32 wraps at 32
                // bits under our 64-bit arithmetic — same contract as x86).
                let sty2: []u8 = ac_expr_type(cst.expr, env, syms, cg);
                if (@strEq(sty2, "i32")) {
                    push[AInstr](out, ai_pop(A_X0()));
                    push[AInstr](out, ai_sxtw(A_X0(), A_X0()));
                    push[AInstr](out, ai_push(A_X0()));
                } else if (@strEq(sty2, "u32")) {
                    push[AInstr](out, ai_pop(A_X0()));
                    push[AInstr](out, ai_and_imm(A_X0(), 4294967295));
                    push[AInstr](out, ai_push(A_X0()));
                }
            }
            // other pointers/scalars: value already 64-bit — no-op
        }
        .switch_ => |sw| {
            ac_lower_switch_expr(out, sw, env, syms, cg);
        }
        else => {
            ac_err(cg, _zag_str_concat("arm64: unsupported expression (node code ",
                _zag_str_concat(_zag_i64_to_str(node_code(n) as i64), ")")));
            push[AInstr](out, ai_mov_imm(A_X0(), 0));
            push[AInstr](out, ai_push(A_X0()));
        }
    }
}

fn ac_cmp_cc(op: []u8) i32 {
    if (@strEq(op, "==")) { return 0; }
    if (@strEq(op, "!=")) { return 1; }
    if (@strEq(op, "<"))  { return 2; }
    if (@strEq(op, "<=")) { return 3; }
    if (@strEq(op, ">"))  { return 4; }
    if (@strEq(op, ">=")) { return 5; }
    return 0 - 1;
}

// branch to `lbl` when the comparison `op` is FALSE (flags already set)
fn ac_push_jcc_false(out: *ArrayList[AInstr], op: []u8, lbl: i32) void {
    if (@strEq(op, "=="))      { push[AInstr](out, ai_jne(lbl)); }
    else if (@strEq(op, "!=")) { push[AInstr](out, ai_je(lbl)); }
    else if (@strEq(op, "<"))  { push[AInstr](out, ai_jge(lbl)); }
    else if (@strEq(op, "<=")) { push[AInstr](out, ai_jg(lbl)); }
    else if (@strEq(op, ">"))  { push[AInstr](out, ai_jle(lbl)); }
    else                       { push[AInstr](out, ai_jl(lbl)); }
}

// UNSIGNED twin of ac_push_jcc_false for u8/u16/u32/u64/usize operands: the
// carry-flag condition family orders values with bit 63 set correctly.
fn ac_push_jcc_false_u(out: *ArrayList[AInstr], op: []u8, lbl: i32) void {
    if (@strEq(op, "=="))      { push[AInstr](out, ai_jne(lbl)); }
    else if (@strEq(op, "!=")) { push[AInstr](out, ai_je(lbl)); }
    else if (@strEq(op, "<"))  { push[AInstr](out, ai_jhs(lbl)); }
    else if (@strEq(op, "<=")) { push[AInstr](out, ai_jhi(lbl)); }
    else if (@strEq(op, ">"))  { push[AInstr](out, ai_jls(lbl)); }
    else                       { push[AInstr](out, ai_jlo(lbl)); }
}

// ── calls ────────────────────────────────────────────────────────────────────

// Coerce a concrete lvalue to interface `iname`: build the (M+1)-word fat
// block [fn0..fnM-1, data_ptr] in the frame; returns its displacement.
fn ac_iface_coerce(out: *ArrayList[AInstr], arg: *Node, concrete_ty: []u8, iname: []u8, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) i32 {
    let M: i32 = iface_method_count(cg.*.decls, iname);
    let fat: i32 = ac_slot_scratch(cg, M + 1);
    let mi: i32 = 0;
    while (mi < M) {
        let meth: []u8 = iface_method_name(cg.*.decls, iname, mi);
        let fn_name: []u8 = _zag_str_concat(_zag_str_concat(concrete_ty, "_"), meth);
        let fn_lbl: i32 = ac_find_fn(syms, fn_name);
        if (fn_lbl < 0) {
            ac_err(cg, _zag_str_concat("arm64: interface impl method not found: ", fn_name));
            push[AInstr](out, ai_mov_imm(A_X0(), 0));
        } else {
            push[AInstr](out, ai_lea_lbl(A_X0(), fn_lbl));
        }
        push[AInstr](out, ai_store(A_X29(), fat + mi * 8, A_X0()));
        mi = mi + 1;
    }
    ac_lower_addr(out, arg, env, syms, cg);
    push[AInstr](out, ai_pop(A_X0()));
    push[AInstr](out, ai_store(A_X29(), fat + M * 8, A_X0()));
    return fat;
}

// Interface method dispatch: recv is interface-typed; fat block holds the
// vtable. Calls fn[midx] with x0 = data ptr, x1.. = extra args.
fn ac_lower_iface_dispatch(out: *ArrayList[AInstr], recv: *Node, mname: []u8, extra_args: ArrayList[*Node], env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) void {
    let iname: []u8 = ac_expr_type(recv, env, syms, cg);
    if (iname.len > 1 && iname[0] == '*') { iname = iname[1..]; }
    let M: i32 = iface_method_count(cg.*.decls, iname);
    let midx: i32 = 0 - 1;
    let mi: i32 = 0;
    while (mi < M) {
        if (@strEq(iface_method_name(cg.*.decls, iname, mi), mname)) { midx = mi; }
        mi = mi + 1;
    }
    if (midx < 0) {
        ac_err(cg, _zag_str_concat("arm64: interface method not found: ", mname));
        push[AInstr](out, ai_mov_imm(A_X0(), 0));
        push[AInstr](out, ai_push(A_X0()));
        return;
    }
    ac_lower_expr(out, recv, env, syms, cg);          // fat block address
    push[AInstr](out, ai_pop(A_X10()));
    let fn_slot: i32 = ac_slot_scratch(cg, 1);
    let data_slot: i32 = ac_slot_scratch(cg, 1);
    push[AInstr](out, ai_load(A_X0(), A_X10(), midx * 8));
    push[AInstr](out, ai_store(A_X29(), fn_slot, A_X0()));
    push[AInstr](out, ai_load(A_X0(), A_X10(), M * 8));
    push[AInstr](out, ai_store(A_X29(), data_slot, A_X0()));
    let nex: i32 = len[*Node](extra_args);
    if (nex > 7) {
        ac_err(cg, "arm64: more than 7 args to an interface method");
        push[AInstr](out, ai_mov_imm(A_X0(), 0));
        push[AInstr](out, ai_push(A_X0()));
        return;
    }
    let arg_slots: ArrayList[i32] = make[i32](nex + 1);
    let ei: i32 = 0;
    while (ei < nex) {
        let asl: i32 = ac_slot_scratch(cg, 1);
        push[i32](&arg_slots, asl);
        ac_lower_expr(out, get[*Node](extra_args, ei), env, syms, cg);
        push[AInstr](out, ai_pop(A_X0()));
        push[AInstr](out, ai_store(A_X29(), asl, A_X0()));
        ei = ei + 1;
    }
    push[AInstr](out, ai_load(A_X0(), A_X29(), data_slot));
    let ei2: i32 = 0;
    while (ei2 < nex) {
        push[AInstr](out, ai_load(a_arg_reg(ei2 + 1), A_X29(), get[i32](arg_slots, ei2)));
        ei2 = ei2 + 1;
    }
    push[AInstr](out, ai_load(A_X10(), A_X29(), fn_slot));
    push[AInstr](out, ai_call_reg(A_X10()));
    push[AInstr](out, ai_push(A_X0()));
}

// Call through a saved {code, env} pair. Runtime env selection picks the ABI:
// env==0: x0=arg0, x1=arg1, ... ; env!=0: x0=env, x1=arg0, ...
fn ac_lower_indirect_slots(out: *ArrayList[AInstr], code_slot: i32, env_slot: i32, c: Call, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) void {
    let nargs: i32 = len[*Node](c.args);
    if (nargs > 7) {
        ac_err(cg, "arm64: more than 7 arguments to a fn-value call");
        push[AInstr](out, ai_mov_imm(A_X0(), 0));
        push[AInstr](out, ai_push(A_X0()));
        return;
    }
    // spill user args into scratch slots (aggregates: caller copy, pass addr)
    let aslot: ArrayList[i32] = make[i32](nargs + 1);
    let ui: i32 = 0;
    while (ui < nargs) {
        let a: *Node = get[*Node](c.args, ui);
        let aty: []u8 = ac_expr_type(a, env, syms, cg);
        let sl: i32 = ac_slot_scratch(cg, 1);
        push[i32](&aslot, sl);
        ac_lower_expr(out, a, env, syms, cg);
        if (ac_is_aggregate(cg, aty) == 1) {
            let w: i32 = ac_type_words(cg, aty);
            let cpy: i32 = ac_slot_scratch(cg, w);
            push[AInstr](out, ai_pop(A_X11()));
            ac_emit_lea(out, A_X10(), cpy);
            ac_emit_copy(out, w);
            ac_emit_lea(out, A_X0(), cpy);
        } else {
            push[AInstr](out, ai_pop(A_X0()));
        }
        push[AInstr](out, ai_store(A_X29(), sl, A_X0()));
        ui = ui + 1;
    }
    let l_env: i32 = ac_fresh(cg);
    let l_done: i32 = ac_fresh(cg);
    push[AInstr](out, ai_load(A_X9(), A_X29(), env_slot));
    push[AInstr](out, ai_cmp_imm(A_X9(), 0));
    push[AInstr](out, ai_jne(l_env));
    // standard ABI
    let si: i32 = 0;
    while (si < nargs) {
        push[AInstr](out, ai_load(a_arg_reg(si), A_X29(), get[i32](aslot, si)));
        si = si + 1;
    }
    push[AInstr](out, ai_load(A_X10(), A_X29(), code_slot));
    push[AInstr](out, ai_call_reg(A_X10()));
    push[AInstr](out, ai_jmp(l_done));
    // env-first ABI
    push[AInstr](out, ai_label(l_env));
    let ai2: i32 = 0;
    while (ai2 < nargs) {
        push[AInstr](out, ai_load(a_arg_reg(ai2 + 1), A_X29(), get[i32](aslot, ai2)));
        ai2 = ai2 + 1;
    }
    push[AInstr](out, ai_load(A_X0(), A_X29(), env_slot));
    push[AInstr](out, ai_load(A_X10(), A_X29(), code_slot));
    push[AInstr](out, ai_call_reg(A_X10()));
    push[AInstr](out, ai_label(l_done));
    push[AInstr](out, ai_push(A_X0()));
}

// Call through a fat_fn local by first saving its code/environment words in
// scratch slots. Keeping the dispatch above slot-based also lets struct fields
// use exactly the same standard-vs-closure ABI path.
fn ac_lower_indirect_call(out: *ArrayList[AInstr], fname: []u8, c: Call, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) void {
    let fdisp: i32 = ac_slot_find(env, fname);
    let is_byref: i32 = ac_slot_byref(env, fname);
    let code_slot: i32 = ac_slot_scratch(cg, 1);
    let env_slot: i32 = ac_slot_scratch(cg, 1);
    if (is_byref == 1) {
        push[AInstr](out, ai_load(A_X10(), A_X29(), fdisp));
        push[AInstr](out, ai_load(A_X0(), A_X10(), 0));
        push[AInstr](out, ai_load(A_X9(), A_X10(), 8));
    } else {
        push[AInstr](out, ai_load(A_X0(), A_X29(), fdisp));
        push[AInstr](out, ai_load(A_X9(), A_X29(), fdisp + 8));
    }
    push[AInstr](out, ai_store(A_X29(), code_slot, A_X0()));
    push[AInstr](out, ai_store(A_X29(), env_slot, A_X9()));
    ac_lower_indirect_slots(out, code_slot, env_slot, c, env, syms, cg);
}

// ── x86-64 → AArch64 syscall translation ──────────────────────────────────
// Zag source code uses Linux x86-64 syscall numbers everywhere.  AArch64 Linux
// uses the asm-generic syscall table, which has different numbers and lacks
// open/mkdir/unlink/rmdir/rename/dup2/fork (replaced by *at variants).  This
// function emits a compare-and-remap sequence that translates the x86-64
// number in x8 to the correct ARM64 number, rearranging x0..x5 where needed,
// before the svc instruction. Unknown numbers fail closed with -ENOSYS.
//
// AT_FDCWD = -100 (the "relative to cwd" dirfd used by all *at syscalls).
// AT_REMOVEDIR = 512 (flag for unlinkat to remove a directory).
// SIGCHLD = 17 (clone flags for fork-equivalent behaviour).
//
// Linux also exposes architecture-specific open-flag values. In particular,
// x86-64 assigns DIRECT/LARGEFILE/DIRECTORY/NOFOLLOW to bits 14..17 while
// AArch64 assigns DIRECTORY/NOFOLLOW/DIRECT/LARGEFILE to those same bits.
// Rotate those four bits by two positions and preserve every common flag.
fn ac_emit_open_flags_xlate(out: *ArrayList[AInstr]) void {
    // ai_and_imm materializes its mask through x9, so x9 cannot retain the
    // original flags across this sequence. x13 is outside the syscall
    // argument set and remains untouched by every operation below.
    push[AInstr](out, ai_mov_rr(A_X13(), A_X2()));
    push[AInstr](out, ai_mov_rr(A_X10(), A_X13()));
    push[AInstr](out, ai_and_imm(A_X10(), 49152));       // x86 bits 14..15
    push[AInstr](out, ai_lsl_imm(A_X10(), A_X10(), 2));
    push[AInstr](out, ai_mov_rr(A_X11(), A_X13()));
    push[AInstr](out, ai_and_imm(A_X11(), 196608));      // x86 bits 16..17
    push[AInstr](out, ai_mov_imm(A_X12(), 2));
    push[AInstr](out, ai_shr(A_X11(), A_X12()));
    push[AInstr](out, ai_mov_rr(A_X2(), A_X13()));
    push[AInstr](out, ai_and_imm(A_X2(), 0 - 245761));   // clear bits 14..17
    push[AInstr](out, ai_or(A_X2(), A_X10()));
    push[AInstr](out, ai_or(A_X2(), A_X11()));
}

fn ac_emit_syscall_xlate(out: *ArrayList[AInstr], cg: *ACg) void {
    // 33 indexed simple remaps plus nine named remaps and seven
    // argument-rearrangement cases.
    let n_remaps: i32 = 40;
    let l_svc: i32 = ac_fresh(cg);
    let l_clock_gettime: i32 = ac_fresh(cg);
    let l_openat: i32 = ac_fresh(cg);
    let l_getrandom: i32 = ac_fresh(cg);
    let l_lseek: i32 = ac_fresh(cg);
    let l_fcntl: i32 = ac_fresh(cg);
    let l_flock: i32 = ac_fresh(cg);
    let l_ftruncate: i32 = ac_fresh(cg);
    let l_fstatfs: i32 = ac_fresh(cg);
    let l_unlinkat: i32 = ac_fresh(cg);
    let l_renameat: i32 = ac_fresh(cg);
    let rl: ArrayList[i32] = make[i32](n_remaps);
    let ri: i32 = 0;
    while (ri < n_remaps) {
        rl.data[ri] = ac_fresh(cg);
        ri = ri + 1;
    }

    // ── compare chain ──
    push[AInstr](out, ai_cmp_imm(A_X8(), 0));   push[AInstr](out, ai_je(rl.data[0]));   // read
    push[AInstr](out, ai_cmp_imm(A_X8(), 1));   push[AInstr](out, ai_je(rl.data[1]));   // write
    push[AInstr](out, ai_cmp_imm(A_X8(), 3));   push[AInstr](out, ai_je(rl.data[2]));   // close
    push[AInstr](out, ai_cmp_imm(A_X8(), 5));   push[AInstr](out, ai_je(rl.data[3]));   // fstat
    push[AInstr](out, ai_cmp_imm(A_X8(), 9));   push[AInstr](out, ai_je(rl.data[4]));   // mmap
    push[AInstr](out, ai_cmp_imm(A_X8(), 10));  push[AInstr](out, ai_je(rl.data[5]));   // mprotect
    push[AInstr](out, ai_cmp_imm(A_X8(), 11));  push[AInstr](out, ai_je(rl.data[6]));   // munmap
    push[AInstr](out, ai_cmp_imm(A_X8(), 13));  push[AInstr](out, ai_je(rl.data[7]));   // rt_sigaction
    push[AInstr](out, ai_cmp_imm(A_X8(), 14));  push[AInstr](out, ai_je(rl.data[8]));   // rt_sigprocmask
    push[AInstr](out, ai_cmp_imm(A_X8(), 24));  push[AInstr](out, ai_je(rl.data[9]));   // sched_yield
    push[AInstr](out, ai_cmp_imm(A_X8(), 35));  push[AInstr](out, ai_je(rl.data[10]));  // nanosleep
    push[AInstr](out, ai_cmp_imm(A_X8(), 39));  push[AInstr](out, ai_je(rl.data[11]));  // getpid
    push[AInstr](out, ai_cmp_imm(A_X8(), 41));  push[AInstr](out, ai_je(rl.data[12]));  // socket
    push[AInstr](out, ai_cmp_imm(A_X8(), 42));  push[AInstr](out, ai_je(rl.data[13]));  // connect
    push[AInstr](out, ai_cmp_imm(A_X8(), 43));  push[AInstr](out, ai_je(rl.data[14]));  // accept
    push[AInstr](out, ai_cmp_imm(A_X8(), 44));  push[AInstr](out, ai_je(rl.data[15]));  // sendto
    push[AInstr](out, ai_cmp_imm(A_X8(), 45));  push[AInstr](out, ai_je(rl.data[16]));  // recvfrom
    push[AInstr](out, ai_cmp_imm(A_X8(), 49));  push[AInstr](out, ai_je(rl.data[17]));  // bind
    push[AInstr](out, ai_cmp_imm(A_X8(), 50));  push[AInstr](out, ai_je(rl.data[18]));  // listen
    push[AInstr](out, ai_cmp_imm(A_X8(), 54));  push[AInstr](out, ai_je(rl.data[19]));  // setsockopt
    push[AInstr](out, ai_cmp_imm(A_X8(), 56));  push[AInstr](out, ai_je(rl.data[20]));  // clone
    push[AInstr](out, ai_cmp_imm(A_X8(), 59));  push[AInstr](out, ai_je(rl.data[21]));  // execve
    push[AInstr](out, ai_cmp_imm(A_X8(), 60));  push[AInstr](out, ai_je(rl.data[22]));  // exit
    push[AInstr](out, ai_cmp_imm(A_X8(), 61));  push[AInstr](out, ai_je(rl.data[23]));  // wait4
    push[AInstr](out, ai_cmp_imm(A_X8(), 62));  push[AInstr](out, ai_je(rl.data[24]));  // kill
    push[AInstr](out, ai_cmp_imm(A_X8(), 74));  push[AInstr](out, ai_je(rl.data[25]));  // fsync
    push[AInstr](out, ai_cmp_imm(A_X8(), 79));  push[AInstr](out, ai_je(rl.data[26]));  // getcwd
    push[AInstr](out, ai_cmp_imm(A_X8(), 109)); push[AInstr](out, ai_je(rl.data[27]));  // setpgid
    push[AInstr](out, ai_cmp_imm(A_X8(), 141)); push[AInstr](out, ai_je(rl.data[28]));  // setpriority
    push[AInstr](out, ai_cmp_imm(A_X8(), 160)); push[AInstr](out, ai_je(rl.data[29]));  // setrlimit
    push[AInstr](out, ai_cmp_imm(A_X8(), 202)); push[AInstr](out, ai_je(rl.data[30]));  // futex
    push[AInstr](out, ai_cmp_imm(A_X8(), 217)); push[AInstr](out, ai_je(rl.data[31]));  // getdents64
    push[AInstr](out, ai_cmp_imm(A_X8(), 293)); push[AInstr](out, ai_je(rl.data[32]));  // pipe2
    push[AInstr](out, ai_cmp_imm(A_X8(), 228)); push[AInstr](out, ai_je(l_clock_gettime)); // clock_gettime
    push[AInstr](out, ai_cmp_imm(A_X8(), 257)); push[AInstr](out, ai_je(l_openat));        // openat
    push[AInstr](out, ai_cmp_imm(A_X8(), 318)); push[AInstr](out, ai_je(l_getrandom));     // getrandom
    push[AInstr](out, ai_cmp_imm(A_X8(), 8));   push[AInstr](out, ai_je(l_lseek));         // lseek
    push[AInstr](out, ai_cmp_imm(A_X8(), 72));  push[AInstr](out, ai_je(l_fcntl));         // fcntl
    push[AInstr](out, ai_cmp_imm(A_X8(), 73));  push[AInstr](out, ai_je(l_flock));         // flock
    push[AInstr](out, ai_cmp_imm(A_X8(), 77));  push[AInstr](out, ai_je(l_ftruncate));     // ftruncate
    push[AInstr](out, ai_cmp_imm(A_X8(), 138)); push[AInstr](out, ai_je(l_fstatfs));       // fstatfs
    push[AInstr](out, ai_cmp_imm(A_X8(), 263)); push[AInstr](out, ai_je(l_unlinkat));      // unlinkat
    push[AInstr](out, ai_cmp_imm(A_X8(), 264)); push[AInstr](out, ai_je(l_renameat));      // renameat
    push[AInstr](out, ai_cmp_imm(A_X8(), 2));   push[AInstr](out, ai_je(rl.data[33]));  // open → openat
    push[AInstr](out, ai_cmp_imm(A_X8(), 33));  push[AInstr](out, ai_je(rl.data[34]));  // dup2 → dup3
    push[AInstr](out, ai_cmp_imm(A_X8(), 57));  push[AInstr](out, ai_je(rl.data[35]));  // fork → clone
    push[AInstr](out, ai_cmp_imm(A_X8(), 82));  push[AInstr](out, ai_je(rl.data[36]));  // rename → renameat
    push[AInstr](out, ai_cmp_imm(A_X8(), 83));  push[AInstr](out, ai_je(rl.data[37]));  // mkdir → mkdirat
    push[AInstr](out, ai_cmp_imm(A_X8(), 84));  push[AInstr](out, ai_je(rl.data[38]));  // rmdir → unlinkat(AT_REMOVEDIR)
    push[AInstr](out, ai_cmp_imm(A_X8(), 87));  push[AInstr](out, ai_je(rl.data[39]));  // unlink → unlinkat(0)
    // An x86 syscall number that is not explicitly audited above must never be
    // interpreted as an unrelated AArch64 syscall. Use an impossible number so
    // the kernel returns -ENOSYS without performing an operation.
    push[AInstr](out, ai_mov_imm(A_X8(), 2147483647));
    push[AInstr](out, ai_jmp(l_svc));

    // ── simple remap labels (just change x8) ──
    push[AInstr](out, ai_label(rl.data[0]));  push[AInstr](out, ai_mov_imm(A_X8(), 63));  push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(rl.data[1]));  push[AInstr](out, ai_mov_imm(A_X8(), 64));  push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(rl.data[2]));  push[AInstr](out, ai_mov_imm(A_X8(), 57));  push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(rl.data[3]));  push[AInstr](out, ai_mov_imm(A_X8(), 80));  push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(rl.data[4]));  push[AInstr](out, ai_mov_imm(A_X8(), 222)); push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(rl.data[5]));  push[AInstr](out, ai_mov_imm(A_X8(), 226)); push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(rl.data[6]));  push[AInstr](out, ai_mov_imm(A_X8(), 215)); push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(rl.data[7]));  push[AInstr](out, ai_mov_imm(A_X8(), 134)); push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(rl.data[8]));  push[AInstr](out, ai_mov_imm(A_X8(), 135)); push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(rl.data[9]));  push[AInstr](out, ai_mov_imm(A_X8(), 124)); push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(rl.data[10])); push[AInstr](out, ai_mov_imm(A_X8(), 101)); push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(rl.data[11])); push[AInstr](out, ai_mov_imm(A_X8(), 172)); push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(rl.data[12])); push[AInstr](out, ai_mov_imm(A_X8(), 198)); push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(rl.data[13])); push[AInstr](out, ai_mov_imm(A_X8(), 203)); push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(rl.data[14])); push[AInstr](out, ai_mov_imm(A_X8(), 202)); push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(rl.data[15])); push[AInstr](out, ai_mov_imm(A_X8(), 206)); push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(rl.data[16])); push[AInstr](out, ai_mov_imm(A_X8(), 207)); push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(rl.data[17])); push[AInstr](out, ai_mov_imm(A_X8(), 200)); push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(rl.data[18])); push[AInstr](out, ai_mov_imm(A_X8(), 201)); push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(rl.data[19])); push[AInstr](out, ai_mov_imm(A_X8(), 208)); push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(rl.data[20])); push[AInstr](out, ai_mov_imm(A_X8(), 220)); push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(rl.data[21])); push[AInstr](out, ai_mov_imm(A_X8(), 221)); push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(rl.data[22])); push[AInstr](out, ai_mov_imm(A_X8(), 93));  push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(rl.data[23])); push[AInstr](out, ai_mov_imm(A_X8(), 260)); push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(rl.data[24])); push[AInstr](out, ai_mov_imm(A_X8(), 129)); push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(rl.data[25])); push[AInstr](out, ai_mov_imm(A_X8(), 82));  push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(rl.data[26])); push[AInstr](out, ai_mov_imm(A_X8(), 17));  push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(rl.data[27])); push[AInstr](out, ai_mov_imm(A_X8(), 154)); push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(rl.data[28])); push[AInstr](out, ai_mov_imm(A_X8(), 140)); push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(rl.data[29])); push[AInstr](out, ai_mov_imm(A_X8(), 164)); push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(rl.data[30])); push[AInstr](out, ai_mov_imm(A_X8(), 98));  push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(rl.data[31])); push[AInstr](out, ai_mov_imm(A_X8(), 61));  push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(rl.data[32])); push[AInstr](out, ai_mov_imm(A_X8(), 59));  push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(l_clock_gettime)); push[AInstr](out, ai_mov_imm(A_X8(), 113)); push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(l_openat));
    ac_emit_open_flags_xlate(out);
    push[AInstr](out, ai_mov_imm(A_X8(), 56)); push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(l_getrandom)); push[AInstr](out, ai_mov_imm(A_X8(), 278)); push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(l_lseek)); push[AInstr](out, ai_mov_imm(A_X8(), 62)); push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(l_fcntl)); push[AInstr](out, ai_mov_imm(A_X8(), 25)); push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(l_flock)); push[AInstr](out, ai_mov_imm(A_X8(), 32)); push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(l_ftruncate)); push[AInstr](out, ai_mov_imm(A_X8(), 46)); push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(l_fstatfs)); push[AInstr](out, ai_mov_imm(A_X8(), 44)); push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(l_unlinkat)); push[AInstr](out, ai_mov_imm(A_X8(), 35)); push[AInstr](out, ai_jmp(l_svc));
    push[AInstr](out, ai_label(l_renameat)); push[AInstr](out, ai_mov_imm(A_X8(), 38)); push[AInstr](out, ai_jmp(l_svc));

    // ── arg-rearrangement labels ──
    // open(path, flags, mode) → openat(AT_FDCWD, path, flags, mode)
    push[AInstr](out, ai_label(rl.data[33]));
    push[AInstr](out, ai_mov_rr(A_X9(), A_X0()));
    push[AInstr](out, ai_mov_imm(A_X0(), 0 - 100));
    push[AInstr](out, ai_mov_rr(A_X3(), A_X2()));
    push[AInstr](out, ai_mov_rr(A_X2(), A_X1()));
    push[AInstr](out, ai_mov_rr(A_X1(), A_X9()));
    ac_emit_open_flags_xlate(out);
    push[AInstr](out, ai_mov_imm(A_X8(), 56));
    push[AInstr](out, ai_jmp(l_svc));
    // dup2(oldfd, newfd) → dup3(oldfd, newfd, 0)
    push[AInstr](out, ai_label(rl.data[34]));
    push[AInstr](out, ai_mov_imm(A_X2(), 0));
    push[AInstr](out, ai_mov_imm(A_X8(), 24));
    push[AInstr](out, ai_jmp(l_svc));
    // fork() → clone(SIGCHLD, 0, 0, 0, 0)
    push[AInstr](out, ai_label(rl.data[35]));
    push[AInstr](out, ai_mov_imm(A_X0(), 17));
    push[AInstr](out, ai_mov_imm(A_X1(), 0));
    push[AInstr](out, ai_mov_imm(A_X8(), 220));
    push[AInstr](out, ai_jmp(l_svc));
    // rename(old, new) → renameat(AT_FDCWD, old, AT_FDCWD, new)
    push[AInstr](out, ai_label(rl.data[36]));
    push[AInstr](out, ai_mov_rr(A_X9(), A_X0()));
    push[AInstr](out, ai_mov_rr(A_X3(), A_X1()));
    push[AInstr](out, ai_mov_imm(A_X2(), 0 - 100));
    push[AInstr](out, ai_mov_rr(A_X1(), A_X9()));
    push[AInstr](out, ai_mov_imm(A_X0(), 0 - 100));
    push[AInstr](out, ai_mov_imm(A_X8(), 38));
    push[AInstr](out, ai_jmp(l_svc));
    // mkdir(path, mode) → mkdirat(AT_FDCWD, path, mode)
    push[AInstr](out, ai_label(rl.data[37]));
    push[AInstr](out, ai_mov_rr(A_X9(), A_X0()));
    push[AInstr](out, ai_mov_rr(A_X2(), A_X1()));
    push[AInstr](out, ai_mov_imm(A_X0(), 0 - 100));
    push[AInstr](out, ai_mov_rr(A_X1(), A_X9()));
    push[AInstr](out, ai_mov_imm(A_X8(), 34));
    push[AInstr](out, ai_jmp(l_svc));
    // rmdir(path) → unlinkat(AT_FDCWD, path, AT_REMOVEDIR)
    push[AInstr](out, ai_label(rl.data[38]));
    push[AInstr](out, ai_mov_rr(A_X9(), A_X0()));
    push[AInstr](out, ai_mov_imm(A_X0(), 0 - 100));
    push[AInstr](out, ai_mov_rr(A_X1(), A_X9()));
    push[AInstr](out, ai_mov_imm(A_X2(), 512));
    push[AInstr](out, ai_mov_imm(A_X8(), 35));
    push[AInstr](out, ai_jmp(l_svc));
    // unlink(path) → unlinkat(AT_FDCWD, path, 0)
    push[AInstr](out, ai_label(rl.data[39]));
    push[AInstr](out, ai_mov_rr(A_X9(), A_X0()));
    push[AInstr](out, ai_mov_imm(A_X0(), 0 - 100));
    push[AInstr](out, ai_mov_rr(A_X1(), A_X9()));
    push[AInstr](out, ai_mov_imm(A_X2(), 0));
    push[AInstr](out, ai_mov_imm(A_X8(), 35));
    push[AInstr](out, ai_jmp(l_svc));

    push[AInstr](out, ai_label(l_svc));
}

// Convert a Linux dirfd carried in `reg` to Darwin's namespace. Linux uses
// AT_FDCWD=-100 while Darwin uses -2. Any other negative Linux descriptor must
// fail before the Darwin trap: passing -2 through would otherwise widen an
// invalid Linux descriptor into Darwin's current-directory capability.
fn ac_emit_darwin_dirfd_xlate(out: *ArrayList[AInstr], reg: i32,
                              invalid: i32, cg: *ACg) void {
    let replace: i32 = ac_fresh(cg);
    let done: i32 = ac_fresh(cg);
    push[AInstr](out, ai_cmp_imm(reg, 0 - 100));
    push[AInstr](out, ai_je(replace));
    push[AInstr](out, ai_cmp_imm(reg, 0));
    push[AInstr](out, ai_jge(done));
    push[AInstr](out, ai_jmp(invalid));
    push[AInstr](out, ai_label(replace));
    push[AInstr](out, ai_mov_imm(reg, 0 - 2));
    push[AInstr](out, ai_label(done));
}

// Inputs are the six already-lowered x0..x5 arguments from a Linux x86-64 raw
// syscall literal. Legacy rename/mkdir/rmdir/unlink are first rewritten to the
// Linux AArch64 *at shapes (38/34/35), then normalized to XNU's dirfd/flag ABI.
// Unsupported unlinkat flags fail closed without touching the pathname.
fn ac_emit_darwin_fs_syscall(out: *ArrayList[AInstr], raw_num: i32,
                             cg: *ACg) i32 {
    // Foreground-cache descriptor operations. The source retains Linux x86-64
    // syscall and flag identities; admit its three no-follow open shapes plus
    // the linker's bounded symlink-following read. Unknown tuples fail before
    // an XNU trap, so cache parity does not create a general raw-file escape.
    if (raw_num == 2) {
        let open_dir: i32 = ac_fresh(cg);
        let open_read: i32 = ac_fresh(cg);
        let open_read_follow: i32 = ac_fresh(cg);
        let open_write: i32 = ac_fresh(cg);
        let open_write_mode: i32 = ac_fresh(cg);
        let open_call: i32 = ac_fresh(cg);
        let invalid_open: i32 = ac_fresh(cg);
        let open_done: i32 = ac_fresh(cg);
        push[AInstr](out, ai_cmp_imm(A_X0(), 0)); push[AInstr](out, ai_je(invalid_open));
        push[AInstr](out, ai_cmp_imm(A_X3(), 0)); push[AInstr](out, ai_jne(invalid_open));
        push[AInstr](out, ai_cmp_imm(A_X4(), 0)); push[AInstr](out, ai_jne(invalid_open));
        push[AInstr](out, ai_cmp_imm(A_X5(), 0)); push[AInstr](out, ai_jne(invalid_open));
        push[AInstr](out, ai_cmp_imm(A_X1(), 720896)); push[AInstr](out, ai_je(open_dir));
        push[AInstr](out, ai_cmp_imm(A_X1(), 657408)); push[AInstr](out, ai_je(open_read));
        push[AInstr](out, ai_cmp_imm(A_X1(), 526336)); push[AInstr](out, ai_je(open_read_follow));
        push[AInstr](out, ai_cmp_imm(A_X1(), 655553)); push[AInstr](out, ai_je(open_write));
        push[AInstr](out, ai_jmp(invalid_open));
        // Linux O_CLOEXEC|O_DIRECTORY|O_NOFOLLOW -> Darwin equivalents.
        push[AInstr](out, ai_label(open_dir));
        push[AInstr](out, ai_cmp_imm(A_X2(), 0)); push[AInstr](out, ai_jne(invalid_open));
        push[AInstr](out, ai_mov_imm(A_X1(), 17826048)); push[AInstr](out, ai_jmp(open_call));
        // Linux O_CLOEXEC|O_NOFOLLOW|O_NONBLOCK -> Darwin equivalents.
        push[AInstr](out, ai_label(open_read));
        push[AInstr](out, ai_cmp_imm(A_X2(), 0)); push[AInstr](out, ai_jne(invalid_open));
        push[AInstr](out, ai_mov_imm(A_X1(), 16777476)); push[AInstr](out, ai_jmp(open_call));
        // Linux O_CLOEXEC|O_NONBLOCK: library files commonly use versioned
        // symlinks. The same opened descriptor is fstat-checked and bounded.
        push[AInstr](out, ai_label(open_read_follow));
        push[AInstr](out, ai_cmp_imm(A_X2(), 0)); push[AInstr](out, ai_jne(invalid_open));
        push[AInstr](out, ai_mov_imm(A_X1(), 16777220)); push[AInstr](out, ai_jmp(open_call));
        // Linux O_CLOEXEC|O_NOFOLLOW|O_CREAT|O_EXCL|O_WRONLY -> Darwin.
        push[AInstr](out, ai_label(open_write));
        // Private evidence files are 0600; newly created native artifacts are
        // 0755. Both retain exclusive/no-follow creation. No truncate or broad
        // arbitrary-mode raw open tuple is admitted by this extension.
        push[AInstr](out, ai_cmp_imm(A_X2(), 384)); push[AInstr](out, ai_je(open_write_mode));
        push[AInstr](out, ai_cmp_imm(A_X2(), 493)); push[AInstr](out, ai_jne(invalid_open));
        push[AInstr](out, ai_label(open_write_mode));
        push[AInstr](out, ai_mov_imm(A_X1(), 16780033));
        push[AInstr](out, ai_label(open_call));
        push[AInstr](out, ai_darwin_syscall(5)); push[AInstr](out, ai_jmp(open_done));
        push[AInstr](out, ai_label(invalid_open));
        push[AInstr](out, ai_mov_imm(A_X0(), 0 - 78));
        push[AInstr](out, ai_label(open_done));
        return 1;
    }
    if (raw_num == 5) {
        let invalid_fstat: i32 = ac_fresh(cg);
        let fstat_done: i32 = ac_fresh(cg);
        push[AInstr](out, ai_cmp_imm(A_X1(), 0)); push[AInstr](out, ai_je(invalid_fstat));
        push[AInstr](out, ai_cmp_imm(A_X2(), 0)); push[AInstr](out, ai_jne(invalid_fstat));
        push[AInstr](out, ai_cmp_imm(A_X3(), 0)); push[AInstr](out, ai_jne(invalid_fstat));
        push[AInstr](out, ai_cmp_imm(A_X4(), 0)); push[AInstr](out, ai_jne(invalid_fstat));
        push[AInstr](out, ai_cmp_imm(A_X5(), 0)); push[AInstr](out, ai_jne(invalid_fstat));
        // Darwin's public 64-bit fstat entry uses syscall 339. Syscall 189 is
        // the legacy structure ABI and would make modern st_mode/st_size
        // offsets decode unrelated bytes even though the trap succeeds.
        push[AInstr](out, ai_darwin_syscall(339)); push[AInstr](out, ai_jmp(fstat_done));
        push[AInstr](out, ai_label(invalid_fstat));
        push[AInstr](out, ai_mov_imm(A_X0(), 0 - 78));
        push[AInstr](out, ai_label(fstat_done));
        return 1;
    }
    if (raw_num == 74) {
        let invalid_fsync: i32 = ac_fresh(cg);
        let fsync_done: i32 = ac_fresh(cg);
        push[AInstr](out, ai_cmp_imm(A_X1(), 0)); push[AInstr](out, ai_jne(invalid_fsync));
        push[AInstr](out, ai_cmp_imm(A_X2(), 0)); push[AInstr](out, ai_jne(invalid_fsync));
        push[AInstr](out, ai_cmp_imm(A_X3(), 0)); push[AInstr](out, ai_jne(invalid_fsync));
        push[AInstr](out, ai_cmp_imm(A_X4(), 0)); push[AInstr](out, ai_jne(invalid_fsync));
        push[AInstr](out, ai_cmp_imm(A_X5(), 0)); push[AInstr](out, ai_jne(invalid_fsync));
        // Linux x86-64 raw 74 is fsync (not fdatasync); XNU fsync is 95.
        push[AInstr](out, ai_darwin_syscall(95)); push[AInstr](out, ai_jmp(fsync_done));
        push[AInstr](out, ai_label(invalid_fsync));
        push[AInstr](out, ai_mov_imm(A_X0(), 0 - 78));
        push[AInstr](out, ai_label(fsync_done));
        return 1;
    }
    if (raw_num == 262) {
        // Linux newfstatat(AT_FDCWD,path,stat,AT_SYMLINK_NOFOLLOW) is used by
        // the daemon's shared no-follow path/currentness checks. Translate the
        // exact audited tuple to Darwin fstatat64 and project only the fields
        // consumed by the Linux-shaped caller back into its expected offsets.
        let invalid_fd: i32 = ac_fresh(cg);
        let invalid_shape: i32 = ac_fresh(cg);
        let stat_done: i32 = ac_fresh(cg);
        push[AInstr](out, ai_cmp_imm(A_X1(), 0)); push[AInstr](out, ai_je(invalid_shape));
        push[AInstr](out, ai_cmp_imm(A_X2(), 0)); push[AInstr](out, ai_je(invalid_shape));
        push[AInstr](out, ai_cmp_imm(A_X3(), 256)); push[AInstr](out, ai_jne(invalid_shape));
        push[AInstr](out, ai_cmp_imm(A_X4(), 0)); push[AInstr](out, ai_jne(invalid_shape));
        push[AInstr](out, ai_cmp_imm(A_X5(), 0)); push[AInstr](out, ai_jne(invalid_shape));
        push[AInstr](out, ai_mov_rr(A_X6(), A_X2()));
        ac_emit_darwin_dirfd_xlate(out, A_X0(), invalid_fd, cg);
        push[AInstr](out, ai_mov_imm(A_X3(), 32));
        push[AInstr](out, ai_darwin_syscall(470));
        push[AInstr](out, ai_cmp_imm(A_X0(), 0)); push[AInstr](out, ai_jl(stat_done));
        push[AInstr](out, ai_loadh(A_X9(), A_X6(), 4));
        push[AInstr](out, ai_storew(A_X6(), 24, A_X9()));
        push[AInstr](out, ai_load(A_X9(), A_X6(), 96));
        push[AInstr](out, ai_store(A_X6(), 48, A_X9()));
        push[AInstr](out, ai_jmp(stat_done));
        push[AInstr](out, ai_label(invalid_fd));
        push[AInstr](out, ai_mov_imm(A_X0(), 0 - 9));
        push[AInstr](out, ai_jmp(stat_done));
        push[AInstr](out, ai_label(invalid_shape));
        push[AInstr](out, ai_mov_imm(A_X0(), 0 - 78));
        push[AInstr](out, ai_label(stat_done));
        return 1;
    }
    let op: i32 = 0;
    if (raw_num == 82) {
        // rename(old,new) -> renameat(AT_FDCWD,old,AT_FDCWD,new)
        push[AInstr](out, ai_mov_rr(A_X9(), A_X0()));
        push[AInstr](out, ai_mov_rr(A_X3(), A_X1()));
        push[AInstr](out, ai_mov_imm(A_X0(), 0 - 100));
        push[AInstr](out, ai_mov_rr(A_X1(), A_X9()));
        push[AInstr](out, ai_mov_imm(A_X2(), 0 - 100));
        op = 38;
    } else if (raw_num == 83) {
        // mkdir(path,mode) -> mkdirat(AT_FDCWD,path,mode)
        push[AInstr](out, ai_mov_rr(A_X9(), A_X0()));
        push[AInstr](out, ai_mov_rr(A_X2(), A_X1()));
        push[AInstr](out, ai_mov_imm(A_X0(), 0 - 100));
        push[AInstr](out, ai_mov_rr(A_X1(), A_X9()));
        op = 34;
    } else if (raw_num == 84) {
        // rmdir(path) -> unlinkat(AT_FDCWD,path,AT_REMOVEDIR)
        push[AInstr](out, ai_mov_rr(A_X1(), A_X0()));
        push[AInstr](out, ai_mov_imm(A_X0(), 0 - 100));
        push[AInstr](out, ai_mov_imm(A_X2(), 512));
        op = 35;
    } else if (raw_num == 87) {
        // unlink(path) -> unlinkat(AT_FDCWD,path,0)
        push[AInstr](out, ai_mov_rr(A_X1(), A_X0()));
        push[AInstr](out, ai_mov_imm(A_X0(), 0 - 100));
        push[AInstr](out, ai_mov_imm(A_X2(), 0));
        op = 35;
    } else if (raw_num == 258) { op = 34; }
    else if (raw_num == 263) { op = 35; }
    else if (raw_num == 264) { op = 38; }
    else { return 0; }

    let invalid_fd: i32 = ac_fresh(cg);
    let invalid_flags: i32 = ac_fresh(cg);
    let call_unlink: i32 = ac_fresh(cg);
    let removedir: i32 = ac_fresh(cg);
    let done: i32 = ac_fresh(cg);
    ac_emit_darwin_dirfd_xlate(out, A_X0(), invalid_fd, cg);
    if (op == 38) {
        ac_emit_darwin_dirfd_xlate(out, A_X2(), invalid_fd, cg);
        push[AInstr](out, ai_syscall(38));
        push[AInstr](out, ai_jmp(done));
    } else if (op == 34) {
        push[AInstr](out, ai_syscall(34));
        push[AInstr](out, ai_jmp(done));
    } else {
        // Linux unlinkat accepts only 0 and AT_REMOVEDIR=0x200. XNU uses
        // AT_REMOVEDIR=0x80; every other bit pattern is rejected before I/O.
        push[AInstr](out, ai_cmp_imm(A_X2(), 0));
        push[AInstr](out, ai_je(call_unlink));
        push[AInstr](out, ai_cmp_imm(A_X2(), 512));
        push[AInstr](out, ai_je(removedir));
        push[AInstr](out, ai_jmp(invalid_flags));
        push[AInstr](out, ai_label(removedir));
        push[AInstr](out, ai_mov_imm(A_X2(), 128));
        push[AInstr](out, ai_label(call_unlink));
        push[AInstr](out, ai_syscall(35));
        push[AInstr](out, ai_jmp(done));
    }
    push[AInstr](out, ai_label(invalid_fd));
    push[AInstr](out, ai_mov_imm(A_X0(), 0 - 9));       // EBADF
    push[AInstr](out, ai_jmp(done));
    push[AInstr](out, ai_label(invalid_flags));
    push[AInstr](out, ai_mov_imm(A_X0(), 0 - 22));      // EINVAL
    push[AInstr](out, ai_label(done));
    return 1;
}

// Convert the common connection-completion errno values exposed through
// Darwin connect(2)/SO_ERROR into their Linux values. The public networking
// adapter depends on EINPROGRESS being stable; the other mapped outcomes keep
// its timeout/refusal/routing results identical across the two native hosts.
// Other kernel errors remain target-native and are documented as such.
fn ac_emit_darwin_net_errno_to_linux(out: *ArrayList[AInstr], reg: i32,
                                     cg: *ACg) void {
    let in_progress: i32 = ac_fresh(cg);
    let already: i32 = ac_fresh(cg);
    let net_unreachable: i32 = ac_fresh(cg);
    let timed_out: i32 = ac_fresh(cg);
    let refused: i32 = ac_fresh(cg);
    let host_unreachable: i32 = ac_fresh(cg);
    let done: i32 = ac_fresh(cg);
    push[AInstr](out, ai_cmp_imm(reg, 36)); push[AInstr](out, ai_je(in_progress));
    push[AInstr](out, ai_cmp_imm(reg, 37)); push[AInstr](out, ai_je(already));
    push[AInstr](out, ai_cmp_imm(reg, 51)); push[AInstr](out, ai_je(net_unreachable));
    push[AInstr](out, ai_cmp_imm(reg, 60)); push[AInstr](out, ai_je(timed_out));
    push[AInstr](out, ai_cmp_imm(reg, 61)); push[AInstr](out, ai_je(refused));
    push[AInstr](out, ai_cmp_imm(reg, 65)); push[AInstr](out, ai_je(host_unreachable));
    push[AInstr](out, ai_jmp(done));
    push[AInstr](out, ai_label(in_progress));
    push[AInstr](out, ai_mov_imm(reg, 115)); push[AInstr](out, ai_jmp(done));
    push[AInstr](out, ai_label(already));
    push[AInstr](out, ai_mov_imm(reg, 114)); push[AInstr](out, ai_jmp(done));
    push[AInstr](out, ai_label(net_unreachable));
    push[AInstr](out, ai_mov_imm(reg, 101)); push[AInstr](out, ai_jmp(done));
    push[AInstr](out, ai_label(timed_out));
    push[AInstr](out, ai_mov_imm(reg, 110)); push[AInstr](out, ai_jmp(done));
    push[AInstr](out, ai_label(refused));
    push[AInstr](out, ai_mov_imm(reg, 111)); push[AInstr](out, ai_jmp(done));
    push[AInstr](out, ai_label(host_unreachable));
    push[AInstr](out, ai_mov_imm(reg, 113));
    push[AInstr](out, ai_label(done));
}

// XNU has no SOCK_CLOEXEC or accept4 flag ABI. Mark a successfully-created
// descriptor with fcntl(F_SETFD, FD_CLOEXEC), close it on marking failure, and
// preserve either the descriptor or the original normalized error in x0.
fn ac_emit_darwin_net_cloexec(out: *ArrayList[AInstr], cg: *ACg) void {
    let mark_failed: i32 = ac_fresh(cg);
    let done: i32 = ac_fresh(cg);
    push[AInstr](out, ai_cmp_imm(A_X0(), 0)); push[AInstr](out, ai_jl(done));
    push[AInstr](out, ai_mov_rr(A_X6(), A_X0()));
    push[AInstr](out, ai_mov_imm(A_X1(), 2));      // F_SETFD
    push[AInstr](out, ai_mov_imm(A_X2(), 1));      // FD_CLOEXEC
    push[AInstr](out, ai_darwin_syscall(92));      // fcntl
    push[AInstr](out, ai_cmp_imm(A_X0(), 0)); push[AInstr](out, ai_jl(mark_failed));
    push[AInstr](out, ai_mov_rr(A_X0(), A_X6())); push[AInstr](out, ai_jmp(done));
    push[AInstr](out, ai_label(mark_failed));
    push[AInstr](out, ai_mov_rr(A_X7(), A_X0()));
    push[AInstr](out, ai_mov_rr(A_X0(), A_X6())); push[AInstr](out, ai_darwin_syscall(6));
    push[AInstr](out, ai_mov_rr(A_X0(), A_X7()));
    push[AInstr](out, ai_label(done));
}

// Validate one Linux sockaddr_in and rewrite only its two-byte prefix in
// place: Linux {family:u16=2} is 0x0002, Darwin {len:u8=16,family:u8=2} is
// 0x0210. Port and address bytes occupy identical offsets.
fn ac_emit_darwin_net_sockaddr_in(out: *ArrayList[AInstr], pointer: i32,
                                  invalid: i32) void {
    push[AInstr](out, ai_cmp_imm(pointer, 0)); push[AInstr](out, ai_je(invalid));
    push[AInstr](out, ai_loadh(A_X9(), pointer, 0));
    push[AInstr](out, ai_cmp_imm(A_X9(), 2)); push[AInstr](out, ai_jne(invalid));
    push[AInstr](out, ai_mov_imm(A_X9(), 528));
    push[AInstr](out, ai_storeh(pointer, 0, A_X9()));
}

// Inputs are the six already-lowered x0..x5 arguments from one Linux-shaped
// std:net_ipv4 raw call. Each operation validates its complete audited tuple,
// translates XNU layout/options/flags, and leaves a Linux-shaped result in x0.
fn ac_emit_darwin_net_syscall(out: *ArrayList[AInstr], raw_num: i32,
                              cg: *ACg) i32 {
    let invalid: i32 = ac_fresh(cg);
    let done: i32 = ac_fresh(cg);

    if (raw_num == 7) {
        // poll(&one_pollfd, 1, 1..60000): pollfd layout and event bits are
        // shared, but only the synchronous POLLIN/POLLOUT profile is admitted.
        let poll_in: i32 = ac_fresh(cg);
        let poll_call: i32 = ac_fresh(cg);
        push[AInstr](out, ai_cmp_imm(A_X0(), 0)); push[AInstr](out, ai_je(invalid));
        push[AInstr](out, ai_cmp_imm(A_X1(), 1)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_cmp_imm(A_X2(), 1)); push[AInstr](out, ai_jl(invalid));
        push[AInstr](out, ai_cmp_imm(A_X2(), 60000)); push[AInstr](out, ai_jg(invalid));
        push[AInstr](out, ai_cmp_imm(A_X3(), 0)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_cmp_imm(A_X4(), 0)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_cmp_imm(A_X5(), 0)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_loadh(A_X9(), A_X0(), 4));
        push[AInstr](out, ai_cmp_imm(A_X9(), 1)); push[AInstr](out, ai_je(poll_in));
        push[AInstr](out, ai_cmp_imm(A_X9(), 4)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_label(poll_in));
        push[AInstr](out, ai_loadh(A_X9(), A_X0(), 6));
        push[AInstr](out, ai_cmp_imm(A_X9(), 0)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_label(poll_call));
        push[AInstr](out, ai_darwin_syscall(230)); push[AInstr](out, ai_jmp(done));
    } else if (raw_num == 41) {
        // socket(AF_INET, SOCK_STREAM|SOCK_CLOEXEC or
        // SOCK_DGRAM|SOCK_CLOEXEC, 0).
        let stream: i32 = ac_fresh(cg);
        let datagram: i32 = ac_fresh(cg);
        let call_socket: i32 = ac_fresh(cg);
        push[AInstr](out, ai_cmp_imm(A_X0(), 2)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_cmp_imm(A_X2(), 0)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_cmp_imm(A_X3(), 0)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_cmp_imm(A_X4(), 0)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_cmp_imm(A_X5(), 0)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_cmp_imm(A_X1(), 524289)); push[AInstr](out, ai_je(stream));
        push[AInstr](out, ai_cmp_imm(A_X1(), 524290)); push[AInstr](out, ai_je(datagram));
        push[AInstr](out, ai_jmp(invalid));
        push[AInstr](out, ai_label(stream));
        push[AInstr](out, ai_mov_imm(A_X1(), 1)); push[AInstr](out, ai_jmp(call_socket));
        push[AInstr](out, ai_label(datagram));
        push[AInstr](out, ai_mov_imm(A_X1(), 2));
        push[AInstr](out, ai_label(call_socket));
        push[AInstr](out, ai_darwin_syscall(97));
        ac_emit_darwin_net_cloexec(out, cg);
        push[AInstr](out, ai_jmp(done));
    } else if (raw_num == 42 || raw_num == 49) {
        // connect/bind(fd, Linux sockaddr_in, 16). Restore the caller's input
        // bytes after XNU consumes the temporary Darwin prefix.
        push[AInstr](out, ai_cmp_imm(A_X2(), 16)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_cmp_imm(A_X3(), 0)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_cmp_imm(A_X4(), 0)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_cmp_imm(A_X5(), 0)); push[AInstr](out, ai_jne(invalid));
        ac_emit_darwin_net_sockaddr_in(out, A_X1(), invalid);
        push[AInstr](out, ai_mov_rr(A_X6(), A_X1()));
        if (raw_num == 42) { push[AInstr](out, ai_darwin_syscall(98)); }
        else { push[AInstr](out, ai_darwin_syscall(104)); }
        push[AInstr](out, ai_mov_imm(A_X9(), 2)); push[AInstr](out, ai_storeh(A_X6(), 0, A_X9()));
        if (raw_num == 42) {
            let connect_ok: i32 = ac_fresh(cg);
            push[AInstr](out, ai_cmp_imm(A_X0(), 0)); push[AInstr](out, ai_jge(connect_ok));
            push[AInstr](out, ai_neg(A_X0(), A_X0()));
            ac_emit_darwin_net_errno_to_linux(out, A_X0(), cg);
            push[AInstr](out, ai_neg(A_X0(), A_X0()));
            push[AInstr](out, ai_label(connect_ok));
        }
        push[AInstr](out, ai_jmp(done));
    } else if (raw_num == 50) {
        // listen(fd, 1..128).
        push[AInstr](out, ai_cmp_imm(A_X1(), 1)); push[AInstr](out, ai_jl(invalid));
        push[AInstr](out, ai_cmp_imm(A_X1(), 128)); push[AInstr](out, ai_jg(invalid));
        push[AInstr](out, ai_cmp_imm(A_X2(), 0)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_cmp_imm(A_X3(), 0)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_cmp_imm(A_X4(), 0)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_cmp_imm(A_X5(), 0)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_darwin_syscall(106)); push[AInstr](out, ai_jmp(done));
    } else if (raw_num == 51) {
        // getsockname(fd, &Linux sockaddr_in, &u32_len=16).
        let normalized: i32 = ac_fresh(cg);
        push[AInstr](out, ai_cmp_imm(A_X1(), 0)); push[AInstr](out, ai_je(invalid));
        push[AInstr](out, ai_cmp_imm(A_X2(), 0)); push[AInstr](out, ai_je(invalid));
        push[AInstr](out, ai_cmp_imm(A_X3(), 0)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_cmp_imm(A_X4(), 0)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_cmp_imm(A_X5(), 0)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_loadw(A_X9(), A_X2(), 0));
        push[AInstr](out, ai_cmp_imm(A_X9(), 16)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_mov_rr(A_X6(), A_X1()));
        push[AInstr](out, ai_darwin_syscall(32));
        push[AInstr](out, ai_cmp_imm(A_X0(), 0)); push[AInstr](out, ai_jl(normalized));
        push[AInstr](out, ai_loadh(A_X9(), A_X6(), 0));
        push[AInstr](out, ai_cmp_imm(A_X9(), 528)); push[AInstr](out, ai_jne(normalized));
        push[AInstr](out, ai_mov_imm(A_X9(), 2)); push[AInstr](out, ai_storeh(A_X6(), 0, A_X9()));
        push[AInstr](out, ai_label(normalized)); push[AInstr](out, ai_jmp(done));
    } else if (raw_num == 54) {
        // setsockopt SOL_SOCKET: REUSEADDR or the two timeval options.
        let reuse: i32 = ac_fresh(cg);
        let receive_timeout: i32 = ac_fresh(cg);
        let send_timeout: i32 = ac_fresh(cg);
        let call_option: i32 = ac_fresh(cg);
        push[AInstr](out, ai_cmp_imm(A_X1(), 1)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_cmp_imm(A_X3(), 0)); push[AInstr](out, ai_je(invalid));
        push[AInstr](out, ai_cmp_imm(A_X5(), 0)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_cmp_imm(A_X2(), 2)); push[AInstr](out, ai_je(reuse));
        push[AInstr](out, ai_cmp_imm(A_X2(), 20)); push[AInstr](out, ai_je(receive_timeout));
        push[AInstr](out, ai_cmp_imm(A_X2(), 21)); push[AInstr](out, ai_je(send_timeout));
        push[AInstr](out, ai_jmp(invalid));
        push[AInstr](out, ai_label(reuse));
        push[AInstr](out, ai_cmp_imm(A_X4(), 4)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_mov_imm(A_X2(), 4)); push[AInstr](out, ai_jmp(call_option));
        push[AInstr](out, ai_label(receive_timeout));
        push[AInstr](out, ai_cmp_imm(A_X4(), 16)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_mov_imm(A_X2(), 4102)); push[AInstr](out, ai_jmp(call_option));
        push[AInstr](out, ai_label(send_timeout));
        push[AInstr](out, ai_cmp_imm(A_X4(), 16)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_mov_imm(A_X2(), 4101));
        push[AInstr](out, ai_label(call_option));
        push[AInstr](out, ai_mov_imm(A_X1(), 65535));
        push[AInstr](out, ai_darwin_syscall(105)); push[AInstr](out, ai_jmp(done));
    } else if (raw_num == 55) {
        // getsockopt(fd, SOL_SOCKET, SO_ERROR, &i32, &u32_len=4).
        let option_done: i32 = ac_fresh(cg);
        push[AInstr](out, ai_cmp_imm(A_X1(), 1)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_cmp_imm(A_X2(), 4)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_cmp_imm(A_X3(), 0)); push[AInstr](out, ai_je(invalid));
        push[AInstr](out, ai_cmp_imm(A_X4(), 0)); push[AInstr](out, ai_je(invalid));
        push[AInstr](out, ai_cmp_imm(A_X5(), 0)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_loadw(A_X9(), A_X4(), 0));
        push[AInstr](out, ai_cmp_imm(A_X9(), 4)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_mov_rr(A_X6(), A_X3()));
        push[AInstr](out, ai_mov_imm(A_X1(), 65535));
        push[AInstr](out, ai_mov_imm(A_X2(), 4103));
        push[AInstr](out, ai_darwin_syscall(118));
        push[AInstr](out, ai_cmp_imm(A_X0(), 0)); push[AInstr](out, ai_jl(option_done));
        push[AInstr](out, ai_loadw(A_X9(), A_X6(), 0));
        ac_emit_darwin_net_errno_to_linux(out, A_X9(), cg);
        push[AInstr](out, ai_storew(A_X6(), 0, A_X9()));
        push[AInstr](out, ai_label(option_done)); push[AInstr](out, ai_jmp(done));
    } else if (raw_num == 288) {
        // accept4(fd,NULL,NULL,SOCK_CLOEXEC) -> accept + F_SETFD.
        push[AInstr](out, ai_cmp_imm(A_X1(), 0)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_cmp_imm(A_X2(), 0)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_cmp_imm(A_X3(), 524288)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_cmp_imm(A_X4(), 0)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_cmp_imm(A_X5(), 0)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_darwin_syscall(30));
        ac_emit_darwin_net_cloexec(out, cg);
        push[AInstr](out, ai_jmp(done));
    } else if (raw_num == 44) {
        // sendto(..., Linux MSG_NOSIGNAL, optional Linux sockaddr_in).
        let connected: i32 = ac_fresh(cg);
        let send_call: i32 = ac_fresh(cg);
        let restore: i32 = ac_fresh(cg);
        push[AInstr](out, ai_cmp_imm(A_X2(), 0)); push[AInstr](out, ai_jl(invalid));
        push[AInstr](out, ai_cmp_imm(A_X2(), 1048576)); push[AInstr](out, ai_jg(invalid));
        push[AInstr](out, ai_cmp_imm(A_X3(), 16384)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_mov_imm(A_X3(), 524288));
        push[AInstr](out, ai_cmp_imm(A_X4(), 0)); push[AInstr](out, ai_je(connected));
        push[AInstr](out, ai_cmp_imm(A_X5(), 16)); push[AInstr](out, ai_jne(invalid));
        ac_emit_darwin_net_sockaddr_in(out, A_X4(), invalid);
        push[AInstr](out, ai_mov_rr(A_X6(), A_X4()));
        push[AInstr](out, ai_jmp(send_call));
        push[AInstr](out, ai_label(connected));
        push[AInstr](out, ai_cmp_imm(A_X5(), 0)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_mov_imm(A_X6(), 0));
        push[AInstr](out, ai_label(send_call));
        push[AInstr](out, ai_darwin_syscall(133));
        push[AInstr](out, ai_cmp_imm(A_X6(), 0)); push[AInstr](out, ai_je(restore));
        push[AInstr](out, ai_mov_imm(A_X9(), 2)); push[AInstr](out, ai_storeh(A_X6(), 0, A_X9()));
        push[AInstr](out, ai_label(restore)); push[AInstr](out, ai_jmp(done));
    } else if (raw_num == 45) {
        // TCP recvfrom has no source address. UDP MSG_TRUNC is emulated with
        // recvmsg because XNU recvfrom returns only the copied byte count.
        let tcp: i32 = ac_fresh(cg);
        let udp: i32 = ac_fresh(cg);
        let recv_cleanup: i32 = ac_fresh(cg);
        let address_done: i32 = ac_fresh(cg);
        let no_truncation: i32 = ac_fresh(cg);
        push[AInstr](out, ai_cmp_imm(A_X2(), 0)); push[AInstr](out, ai_jl(invalid));
        push[AInstr](out, ai_cmp_imm(A_X2(), 1048576)); push[AInstr](out, ai_jg(invalid));
        push[AInstr](out, ai_cmp_imm(A_X3(), 0)); push[AInstr](out, ai_je(tcp));
        push[AInstr](out, ai_cmp_imm(A_X3(), 32)); push[AInstr](out, ai_je(udp));
        push[AInstr](out, ai_jmp(invalid));
        push[AInstr](out, ai_label(tcp));
        push[AInstr](out, ai_cmp_imm(A_X4(), 0)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_cmp_imm(A_X5(), 0)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_darwin_syscall(29)); push[AInstr](out, ai_jmp(done));
        push[AInstr](out, ai_label(udp));
        push[AInstr](out, ai_cmp_imm(A_X2(), 65507)); push[AInstr](out, ai_jg(invalid));
        push[AInstr](out, ai_cmp_imm(A_X4(), 0)); push[AInstr](out, ai_je(invalid));
        push[AInstr](out, ai_cmp_imm(A_X5(), 0)); push[AInstr](out, ai_je(invalid));
        push[AInstr](out, ai_loadw(A_X9(), A_X5(), 0));
        push[AInstr](out, ai_cmp_imm(A_X9(), 16)); push[AInstr](out, ai_jne(invalid));
        push[AInstr](out, ai_mov_rr(A_X6(), A_X5()));
        push[AInstr](out, ai_mov_rr(A_X7(), A_X4()));
        // 64-byte aligned local: iovec at +0, Darwin msghdr at +16.
        // msghdr = {name@0, namelen@8, iov@16, iovlen@24,
        //           control@32, controllen@40, flags@44}.
        push[AInstr](out, ai_sub_imm(A_SP(), 64));
        push[AInstr](out, ai_store(A_SP(), 0, A_X1()));
        push[AInstr](out, ai_store(A_SP(), 8, A_X2()));
        push[AInstr](out, ai_store(A_SP(), 16, A_X4()));
        push[AInstr](out, ai_mov_imm(A_X9(), 0)); push[AInstr](out, ai_store(A_SP(), 24, A_X9()));
        push[AInstr](out, ai_mov_imm(A_X9(), 16)); push[AInstr](out, ai_storew(A_SP(), 24, A_X9()));
        push[AInstr](out, ai_mov_rr(A_X9(), A_SP())); push[AInstr](out, ai_store(A_SP(), 32, A_X9()));
        push[AInstr](out, ai_mov_imm(A_X9(), 0)); push[AInstr](out, ai_store(A_SP(), 40, A_X9()));
        push[AInstr](out, ai_mov_imm(A_X9(), 1)); push[AInstr](out, ai_storew(A_SP(), 40, A_X9()));
        push[AInstr](out, ai_mov_imm(A_X9(), 0)); push[AInstr](out, ai_store(A_SP(), 48, A_X9()));
        push[AInstr](out, ai_store(A_SP(), 56, A_X9()));
        push[AInstr](out, ai_mov_rr(A_X1(), A_SP())); push[AInstr](out, ai_add_imm(A_X1(), 16));
        push[AInstr](out, ai_mov_imm(A_X2(), 0));
        push[AInstr](out, ai_darwin_syscall(27));
        push[AInstr](out, ai_cmp_imm(A_X0(), 0)); push[AInstr](out, ai_jl(recv_cleanup));
        push[AInstr](out, ai_loadw(A_X9(), A_SP(), 24));
        push[AInstr](out, ai_storew(A_X6(), 0, A_X9()));
        push[AInstr](out, ai_cmp_imm(A_X9(), 16)); push[AInstr](out, ai_jl(address_done));
        push[AInstr](out, ai_loadh(A_X9(), A_X7(), 0));
        push[AInstr](out, ai_cmp_imm(A_X9(), 528)); push[AInstr](out, ai_jne(address_done));
        push[AInstr](out, ai_mov_imm(A_X9(), 2)); push[AInstr](out, ai_storeh(A_X7(), 0, A_X9()));
        push[AInstr](out, ai_label(address_done));
        push[AInstr](out, ai_loadw(A_X9(), A_SP(), 60));
        push[AInstr](out, ai_and_imm(A_X9(), 16));
        push[AInstr](out, ai_cmp_imm(A_X9(), 0)); push[AInstr](out, ai_je(no_truncation));
        // The guarded iovec length is <=65507, so +1 is an overflow-safe
        // Linux-compatible witness that the complete datagram exceeded it.
        push[AInstr](out, ai_load(A_X0(), A_SP(), 8)); push[AInstr](out, ai_add_imm(A_X0(), 1));
        push[AInstr](out, ai_label(no_truncation));
        push[AInstr](out, ai_label(recv_cleanup));
        push[AInstr](out, ai_add_imm(A_SP(), 64)); push[AInstr](out, ai_jmp(done));
    } else {
        return 0;
    }

    push[AInstr](out, ai_label(invalid));
    push[AInstr](out, ai_mov_imm(A_X0(), 0 - 78));      // ENOSYS
    push[AInstr](out, ai_label(done));
    return 1;
}

// Inline the compiler-owned Script allocator. Inputs are x0=context and
// x1=requested bytes; output is x0=pointer/null. Policy 1 uses the one bounded
// mapping in context[64..80]. Policy 2 mmaps individually-linked blocks so
// shutdown can deterministically reclaim them on both Linux and Darwin.
fn ac_emit_script_alloc_inline(out: *ArrayList[AInstr], cg: *ACg) void {
    let heap_budget: i32 = ac_fresh(cg);
    let arena_allocate: i32 = ac_fresh(cg);
    let account: i32 = ac_fresh(cg);
    let failed: i32 = ac_fresh(cg);
    let done: i32 = ac_fresh(cg);
    push[AInstr](out, ai_mov_rr(A_X12(), A_X0()));
    push[AInstr](out, ai_mov_rr(A_X7(), A_X1()));
    push[AInstr](out, ai_cmp_imm(A_X7(), 0)); push[AInstr](out, ai_jl(failed));
    push[AInstr](out, ai_load(A_X2(), A_X12(), 0));
    push[AInstr](out, ai_load(A_X4(), A_X12(), 8));
    push[AInstr](out, ai_sub(A_X2(), A_X4()));
    push[AInstr](out, ai_mov_rr(A_X6(), A_X7()));
    push[AInstr](out, ai_load(A_X3(), A_X12(), 48));
    push[AInstr](out, ai_and_imm(A_X3(), 255));
    push[AInstr](out, ai_cmp_imm(A_X3(), 2)); push[AInstr](out, ai_je(heap_budget));
    push[AInstr](out, ai_cmp(A_X7(), A_X2())); push[AInstr](out, ai_jg(failed));
    push[AInstr](out, ai_jmp(arena_allocate));

    push[AInstr](out, ai_label(heap_budget));
    push[AInstr](out, ai_cmp_imm(A_X2(), 16)); push[AInstr](out, ai_jl(failed));
    push[AInstr](out, ai_sub_imm(A_X2(), 16));
    push[AInstr](out, ai_cmp(A_X7(), A_X2())); push[AInstr](out, ai_jg(failed));
    push[AInstr](out, ai_add_imm(A_X6(), 16));
    // mmap(NULL, charged_bytes, PROT_RW, MAP_PRIVATE|ANON, -1, 0)
    push[AInstr](out, ai_mov_imm(A_X0(), 0)); push[AInstr](out, ai_mov_rr(A_X1(), A_X6()));
    push[AInstr](out, ai_mov_imm(A_X2(), 3));
    let heap_mmap_flags: i32 = 34; if (cg.*.target_os == AC_OS_MACOS()) { heap_mmap_flags = 4098; }
    push[AInstr](out, ai_mov_imm(A_X3(), heap_mmap_flags as i64));
    push[AInstr](out, ai_mov_imm(A_X4(), 0 - 1)); push[AInstr](out, ai_mov_imm(A_X5(), 0));
    push[AInstr](out, ai_syscall(222));
    push[AInstr](out, ai_cmp_imm(A_X0(), 0)); push[AInstr](out, ai_jl(failed));
    push[AInstr](out, ai_mov_rr(A_X11(), A_X0()));
    push[AInstr](out, ai_load(A_X2(), A_X12(), 104)); push[AInstr](out, ai_store(A_X11(), 0, A_X2()));
    push[AInstr](out, ai_store(A_X11(), 8, A_X6())); push[AInstr](out, ai_store(A_X12(), 104, A_X11()));
    push[AInstr](out, ai_add_imm(A_X11(), 16)); push[AInstr](out, ai_jmp(account));

    push[AInstr](out, ai_label(arena_allocate));
    push[AInstr](out, ai_load(A_X11(), A_X12(), 64));
    push[AInstr](out, ai_load(A_X5(), A_X12(), 72));
    push[AInstr](out, ai_add(A_X11(), A_X5()));
    push[AInstr](out, ai_add(A_X5(), A_X7())); push[AInstr](out, ai_store(A_X12(), 72, A_X5()));

    push[AInstr](out, ai_label(account));
    push[AInstr](out, ai_load(A_X4(), A_X12(), 8)); push[AInstr](out, ai_add(A_X4(), A_X6())); push[AInstr](out, ai_store(A_X12(), 8, A_X4()));
    push[AInstr](out, ai_load(A_X4(), A_X12(), 88)); push[AInstr](out, ai_add_imm(A_X4(), 1)); push[AInstr](out, ai_store(A_X12(), 88, A_X4()));
    push[AInstr](out, ai_mov_rr(A_X0(), A_X11())); push[AInstr](out, ai_jmp(done));

    push[AInstr](out, ai_label(failed));
    push[AInstr](out, ai_load(A_X4(), A_X12(), 96)); push[AInstr](out, ai_add_imm(A_X4(), 1)); push[AInstr](out, ai_store(A_X12(), 96, A_X4()));
    push[AInstr](out, ai_mov_imm(A_X0(), 0));
    push[AInstr](out, ai_label(done));
}

fn ac_lower_call(out: *ArrayList[AInstr], c: Call, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) void {
    switch (c.callee.*) {
        .fld => |mf| {
            // method call: recv.m(args) → iface dispatch or RecvType_m(recv, args)
            if (@strEq(mf.fname, "*") || @strEq(mf.fname, "?") || @strEq(mf.fname, "has") || @strEq(mf.fname, "val")) {
                ac_err(cg, "arm64: unsupported call form");
                push[AInstr](out, ai_mov_imm(A_X0(), 0));
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            let rty: []u8 = ac_expr_type(mf.base, env, syms, cg);
            if (rty.len > 1 && rty[0] == '*') { rty = rty[1..]; }
            if (iface_method_count(cg.*.decls, rty) > 0) {
                ac_lower_iface_dispatch(out, mf.base, mf.fname, c.args, env, syms, cg);
                return;
            }
            let mn: []u8 = _zag_str_concat(_zag_str_concat(rty, "_"), mf.fname);
            if (rty.len > 0 && ac_find_fn(syms, mn) >= 0) {
                let margs: ArrayList[*Node] = make[*Node](len[*Node](c.args) + 1);
                push[*Node](&margs, mf.base);
                let mk: i32 = 0;
                while (mk < len[*Node](c.args)) {
                    push[*Node](&margs, get[*Node](c.args, mk));
                    mk = mk + 1;
                }
                ac_lower_call(out, Call{ .callee = mk_ident(mn), .args = margs, .targs = make[[]u8](1) }, env, syms, cg);
                return;
            }
            // fn-typed struct field: value.callback(args). Field expressions
            // yield the address of their inline {code, env} block; save both
            // words before evaluating args, then share the local fn-value ABI.
            let fty: []u8 = ac_field_type(cg, rty, mf.fname);
            if (@strEq(fty, "fat_fn") || cg_is_fn_type(fty) == 1) {
                ac_lower_expr(out, c.callee, env, syms, cg);
                push[AInstr](out, ai_pop(A_X10()));
                let code_slot: i32 = ac_slot_scratch(cg, 1);
                let env_slot: i32 = ac_slot_scratch(cg, 1);
                push[AInstr](out, ai_load(A_X0(), A_X10(), 0));
                push[AInstr](out, ai_load(A_X9(), A_X10(), 8));
                push[AInstr](out, ai_store(A_X29(), code_slot, A_X0()));
                push[AInstr](out, ai_store(A_X29(), env_slot, A_X9()));
                ac_lower_indirect_slots(out, code_slot, env_slot, c, env, syms, cg);
                return;
            }
            ac_err(cg, _zag_str_concat("arm64: unknown method: ", mf.fname));
            push[AInstr](out, ai_mov_imm(A_X0(), 0));
            push[AInstr](out, ai_push(A_X0()));
            return;
        }
        .id => |fnid| {
            if (fnid.name.len > 0 && fnid.name[0] == '@') {
                ac_lower_at_builtin(out, fnid.name, c, env, syms, cg);
                return;
            }
            let cname: []u8 = fnid.name;
            if (len[[]u8](c.targs) > 0) {
                cname = cg_mangle_generic_norm(fnid.name, c.targs);
            } else {
                // If callee is a known generic fn and targs is STILL empty, type
                // inference failed — emit loud error rather than silently calling
                // the wrong symbol.
                let gcheck: FnDecl = FnDecl{ .name = "", .tparams = make[[]u8](1), .params = make[Param](1), .ret = "", .annots = make[[]u8](1), .body = make[*Node](1), .is_extern = 0, .ret_eff = "", .caps = 0, .cap_names = "", .cap_types = "", .line = 0, .is_pub = 0, .origin = "" };
                if (cg_find_generic_fn(cg.*.decls, cname, &gcheck) == 1) {
                    ac_err(cg, "arm64: could not infer type arguments for generic call (provide them explicitly as foo[T](...))");
                }
            }
            if (ac_lower_builtin(out, cname, c, env, syms, cg) == 1) { return; }
            if (ac_slot_find(env, cname) != 0 && @strEq(ac_slot_type(env, cname), "fat_fn")) {
                ac_lower_indirect_call(out, cname, c, env, syms, cg);
                return;
            }
            let lbl: i32 = ac_find_fn(syms, cname);
            if (lbl < 0) {
                ac_err(cg, _zag_str_concat("arm64: unknown function: ", cname));
                push[AInstr](out, ai_mov_imm(A_X0(), 0));
                push[AInstr](out, ai_push(A_X0()));
                return;
            }
            let nargs: i32 = len[*Node](c.args);
            let call_extern_index: i32 = ac_find_extern(syms, cname);
            let call_dynamic_index: i32 = ac_dynamic_index(cg, cname);
            let cabi_call: i32 = ((call_extern_index >= 0 || call_dynamic_index >= 0 ||
                ac_fn_is_cabi_export(cg, cname) == 1) as i32);
            let darwin_cabi: i32 = (cabi_call == 1 && cg.*.target_os == AC_OS_MACOS()) as i32;
            let ai: i32 = 0;
            while (ai < nargs) {
                let a: *Node = get[*Node](c.args, ai);
                let aty: []u8 = ac_expr_type(a, env, syms, cg);
                let pt: []u8 = ac_fn_param_type(cg, cname, ai);
                if (darwin_cabi == 1 && ac_cabi_callback_type_ok(pt) == 1) {
                    // A direct named function may cross into C as its raw code
                    // address. Aliases and capturing closures retain Zag's fat
                    // function representation and therefore fail closed here.
                    let cb_name: []u8 = "";
                    switch (a.*) { .id => |x| { cb_name = x.name; } else => { } }
                    if (cb_name.len == 0 || ac_cabi_callback_matches(cg, cb_name, pt) == 0) {
                        ac_err(cg, "arm64: C callback requires a direct captureless function with an exact supported signature");
                        push[AInstr](out, ai_mov_imm(A_X0(), 0));
                    } else if (ac_cabi_callback_has_float(pt) == 1 && ac_fn_is_cabi_export(cg, cb_name) == 0) {
                        ac_err(cg, "arm64: floating-point C callback requires a direct pub @cabi_export function");
                        push[AInstr](out, ai_mov_imm(A_X0(), 0));
                    } else {
                        let cb_lbl: i32 = ac_find_fn(syms, cb_name);
                        if (cb_lbl < 0) {
                            ac_err(cg, "arm64: C callback function has no native label");
                            push[AInstr](out, ai_mov_imm(A_X0(), 0));
                        } else { push[AInstr](out, ai_lea_lbl(A_X0(), cb_lbl)); }
                    }
                    push[AInstr](out, ai_push(A_X0()));
                } else if (ac_is_optional(cg_norm_type(pt)) == 1 &&
                    (ac_is_null_node(a) == 1 || ac_is_optional(aty) == 0)) {
                    // scalar/null → ?T param: build a wrapped {has, val} block
                    let ow: i32 = ac_type_words(cg, pt);
                    let ob: i32 = ac_slot_scratch(cg, ow);
                    if (ac_is_null_node(a) == 1) {
                        push[AInstr](out, ai_mov_imm(A_X0(), 0));
                        push[AInstr](out, ai_store(A_X29(), ob, A_X0()));
                    } else {
                        push[AInstr](out, ai_mov_imm(A_X0(), 1));
                        push[AInstr](out, ai_store(A_X29(), ob, A_X0()));
                        let opty: []u8 = cg_norm_type(pt)[1..];
                        ac_lower_expr(out, a, env, syms, cg);
                        if (ac_is_aggregate(cg, opty) == 1) {
                            push[AInstr](out, ai_pop(A_X11()));
                            ac_emit_lea(out, A_X10(), ob + 8);
                            ac_emit_copy(out, ac_type_words(cg, opty));
                        } else {
                            push[AInstr](out, ai_pop(A_X0()));
                            push[AInstr](out, ai_store(A_X29(), ob + 8, A_X0()));
                        }
                    }
                    ac_emit_lea(out, A_X0(), ob);
                    push[AInstr](out, ai_push(A_X0()));
                } else if (iface_method_count(cg.*.decls, pt) > 0 && iface_method_count(cg.*.decls, aty) == 0) {
                    // concrete value → interface param: build fat vtable block
                    let fat: i32 = ac_iface_coerce(out, a, aty, pt, env, syms, cg);
                    ac_emit_lea(out, A_X0(), fat);
                    push[AInstr](out, ai_push(A_X0()));
                } else {
                    ac_lower_expr(out, a, env, syms, cg);
                    if (ac_is_aggregate(cg, aty) == 1) {
                        // by-value semantics: copy to a fresh block, pass its address
                        let w: i32 = ac_type_words(cg, aty);
                        let base: i32 = ac_slot_scratch(cg, w);
                        push[AInstr](out, ai_pop(A_X11()));
                        ac_emit_lea(out, A_X10(), base);
                        ac_emit_copy(out, w);
                        ac_emit_lea(out, A_X0(), base);
                        push[AInstr](out, ai_push(A_X0()));
                    }
                }
                ai = ai + 1;
            }
            // Fixed Darwin C calls use independent GPR and FPR banks. The
            // non-Darwin path retains Zag/Linux's positional x0-x7 convention.
            let nstk: i32 = 0;
            if (nargs > 8) { nstk = nargs - 8; }
            let stkbytes: i32 = ac_align16(8 * nstk);
            if (darwin_cabi == 1) {
                stkbytes = ac_align16(ac_darwin_cabi_stack_bytes(cg, cname, nargs));
                if (stkbytes > 0) { push[AInstr](out, ai_sub_imm(A_SP(), stkbytes as i64)); }
                let aj: i32 = nargs - 1;
                while (aj >= 0) {
                    let aty: []u8 = ac_fn_param_type(cg, cname, aj);
                    push[AInstr](out, ai_pop(A_X9()));
                    if (ac_cabi_is_float(aty) == 1) {
                        let fp_index: i32 = ac_darwin_cabi_fpr_arg_index(cg, cname, aj);
                        if (ac_cabi_is_f64(aty) == 1) {
                            if (fp_index < 8) { push[AInstr](out, ai_fmov_dx(fp_index, A_X9())); }
                            else { ac_emit_store_layout(out, A_SP(), ac_darwin_cabi_stack_offset(cg, cname, aj), 8, A_X9()); }
                        } else {
                            // Internal f32 is an f64 bit-pattern. Convert in a
                            // high scratch V register so reverse argument staging
                            // cannot destroy any already-populated v0-v7 value.
                            push[AInstr](out, ai_fmov_dx(31, A_X9()));
                            if (fp_index < 8) {
                                push[AInstr](out, ai_fcvt_sd(fp_index, 31));
                            } else {
                                push[AInstr](out, ai_fcvt_sd(31, 31));
                                push[AInstr](out, ai_fmov_ws(A_X9(), 31));
                                ac_emit_store_layout(out, A_SP(), ac_darwin_cabi_stack_offset(cg, cname, aj), 4, A_X9());
                            }
                        }
                    } else if (ac_darwin_cabi_small_aggregate_ok(cg, aty) == 1) {
                        // Internal aggregate values are addresses of caller-owned
                        // copies. Darwin small INTEGER-class aggregates instead
                        // cross as one/two payload words in X registers, or as
                        // the complete value on the stack if all words do not fit.
                        let words: i32 = ac_darwin_cabi_gpr_slots(cg, aty);
                        let adapted: i32 = ac_darwin_cabi_small_adapter_ok(cg, aty);
                        if (adapted == 1) {
                            let packed: i32 = ac_slot_scratch(cg, words);
                            ac_emit_lea(out, A_X10(), packed);
                            ac_emit_darwin_cabi_pack_small(out, cg, aty, A_X9(), A_X10());
                            ac_emit_lea(out, A_X9(), packed);
                        }
                        let gp_index: i32 = ac_darwin_cabi_gpr_arg_index(cg, cname, aj);
                        if (ac_darwin_cabi_arg_on_stack(cg, cname, aj) == 0) {
                            let wi: i32 = 0;
                            while (wi < words) {
                                push[AInstr](out, ai_load(A_X10(), A_X9(), 8 * wi));
                                push[AInstr](out, ai_mov_rr(a_arg_reg(gp_index + wi), A_X10()));
                                wi = wi + 1;
                            }
                        } else {
                            let offset: i32 = ac_darwin_cabi_stack_offset(cg, cname, aj);
                            if (adapted == 1) {
                                ac_emit_darwin_cabi_packed_to_stack(out, A_X9(), offset,
                                    ac_darwin_cabi_aggregate_size(cg, aty));
                            } else {
                                let wi: i32 = 0;
                                while (wi < words) {
                                    push[AInstr](out, ai_load(A_X10(), A_X9(), 8 * wi));
                                    push[AInstr](out, ai_store(A_SP(), offset + 8 * wi, A_X10()));
                                    wi = wi + 1;
                                }
                            }
                        }
                    } else {
                        ac_emit_cabi_int_normalize(out, A_X9(), aty);
                        let gp_index: i32 = ac_darwin_cabi_gpr_arg_index(cg, cname, aj);
                        if (ac_darwin_cabi_arg_on_stack(cg, cname, aj) == 0) { push[AInstr](out, ai_mov_rr(a_arg_reg(gp_index), A_X9())); }
                        else {
                            ac_emit_store_layout(out, A_SP(), ac_darwin_cabi_stack_offset(cg, cname, aj),
                                ac_darwin_cabi_leaf_size(cg, aty), A_X9());
                        }
                    }
                    aj = aj - 1;
                }
            } else {
                let aj: i32 = nargs - 1;
                if (nstk > 0) {
                    push[AInstr](out, ai_sub_imm(A_SP(), stkbytes as i64));
                    while (aj >= 8) {
                        push[AInstr](out, ai_pop(A_X9()));
                        if (cabi_call == 1) { ac_emit_cabi_int_normalize(out, A_X9(), ac_fn_param_type(cg, cname, aj)); }
                        push[AInstr](out, ai_store(A_SP(), 8 * (aj - 8), A_X9()));
                        aj = aj - 1;
                    }
                }
                while (aj >= 0) {
                    let arg_reg: i32 = a_arg_reg(aj);
                    push[AInstr](out, ai_pop(arg_reg));
                    if (cabi_call == 1) { ac_emit_cabi_int_normalize(out, arg_reg, ac_fn_param_type(cg, cname, aj)); }
                    aj = aj - 1;
                }
            }
            let rty: []u8 = ac_find_fn_ret(syms, cname);
            let darwin_indirect_ret_base: i32 = 0;
            let darwin_small_ret_base: i32 = 0;
            let darwin_small_ret_packed_base: i32 = 0;
            if (ac_is_aggregate(cg, rty) == 1) {
                let rw: i32 = ac_type_words(cg, rty);
                let rbase: i32 = ac_slot_scratch(cg, rw);
                if (darwin_cabi == 1 && ac_darwin_cabi_small_aggregate_ok(cg, rty) == 1) {
                    darwin_small_ret_base = rbase;
                    if (ac_darwin_cabi_small_adapter_ok(cg, rty) == 1) {
                        darwin_small_ret_packed_base = ac_slot_scratch(cg, ac_darwin_cabi_gpr_slots(cg, rty));
                    }
                } else {
                    ac_emit_lea(out, A_X8(), rbase);
                }
                if (darwin_cabi == 1 && ac_darwin_cabi_indirect_aggregate_ok(cg, rty) == 1) {
                    darwin_indirect_ret_base = rbase;
                }
            }
            if (cg.*.target_os == AC_OS_MACOS() && call_extern_index >= 0) {
                push[AInstr](out, ai_extern_call(call_extern_index));
            } else {
                // Dynamic/object mode: extern calls go through GOT or relocations.
                if (call_dynamic_index >= 0) {
                    if (cg.*.object_mode == 1) {
                        push[AInstr](out, ai_call_ext(call_dynamic_index));
                    } else {
                        // GOT indirect call: load slot from GOT, blr x0
                        push[AInstr](out, ai_mov_imm(A_X0(), ac_dynamic_got_vaddr() + ((call_dynamic_index as i64) * 8)));
                        push[AInstr](out, ai_load(A_X0(), A_X0(), 0));
                        push[AInstr](out, ai_call_reg(A_X0()));
                    }
                } else {
                    push[AInstr](out, ai_call(lbl));
                }
            }
            if (stkbytes > 0) { push[AInstr](out, ai_add_imm(A_SP(), stkbytes as i64)); }
            if (darwin_small_ret_base != 0) {
                let abi_words: i32 = ac_darwin_cabi_gpr_slots(cg, rty);
                let receive_base: i32 = darwin_small_ret_base;
                if (darwin_small_ret_packed_base != 0) { receive_base = darwin_small_ret_packed_base; }
                push[AInstr](out, ai_store(A_X29(), receive_base, A_X0()));
                if (abi_words > 1) {
                    push[AInstr](out, ai_store(A_X29(), receive_base + 8, A_X1()));
                }
                if (darwin_small_ret_packed_base != 0) {
                    ac_emit_lea(out, A_X9(), darwin_small_ret_packed_base);
                    ac_emit_lea(out, A_X10(), darwin_small_ret_base);
                    ac_emit_darwin_cabi_unpack_small(out, cg, rty, A_X9(), A_X10());
                }
                ac_emit_lea(out, A_X0(), darwin_small_ret_base);
            } else if (darwin_indirect_ret_base != 0) {
                // AAPCS64 does not promise the indirect-result address back in
                // x0.  Publish our caller-owned destination explicitly for
                // Zag's internal aggregate-value representation.
                ac_emit_lea(out, A_X0(), darwin_indirect_ret_base);
            } else if (darwin_cabi == 1 && ac_cabi_is_float(rty) == 1) {
                if (ac_cabi_is_f64(rty) == 1) {
                    push[AInstr](out, ai_fmov_xd(A_X0(), 0));
                } else {
                    push[AInstr](out, ai_fcvt_ds(31, 0));
                    push[AInstr](out, ai_fmov_xd(A_X0(), 31));
                }
            } else if (cabi_call == 1) { ac_emit_cabi_int_normalize(out, A_X0(), rty); }
            push[AInstr](out, ai_push(A_X0()));
        }
        else => {
            ac_err(cg, "arm64: unsupported call form");
            push[AInstr](out, ai_mov_imm(A_X0(), 0));
            push[AInstr](out, ai_push(A_X0()));
        }
    }
}

// no-newline family (x86 contract: print_int / _zag_print_i32 emit bare digits)
fn ac_is_print_int(name: []u8) i32 {
    if (@strEq(name, "print_int")) { return 1; }
    if (@strEq(name, "_zag_print_i32")) { return 1; }
    return 0;
}

// newline family (x86 contract: matches the C backend's printf("%d\n"))
fn ac_is_print_int_nl(name: []u8) i32 {
    if (@strEq(name, "print_i32") || @strEq(name, "print_u32")) { return 1; }
    if (@strEq(name, "print_i64") || @strEq(name, "print_u64")) { return 1; }
    if (@strEq(name, "_zag_print_i64") || @strEq(name, "_zag_print_u64")) { return 1; }
    return 0;
}

fn ac_is_print_str(name: []u8) i32 {
    if (@strEq(name, "print_str")) { return 1; }
    if (@strEq(name, "_zag_print")) { return 1; }
    return 0;
}

// Runtime slice helpers return a temporary heap {ptr,len} descriptor because
// they cannot participate in the ordinary source-function sret ABI. Mirror the
// x86 lowering: copy that descriptor into caller-owned frame scratch, retire
// only the descriptor, and leave its data pointer under the public operation's
// stated ownership contract. The descriptor allocation is deliberately not
// enrolled in checked raw-pointer provenance; that contract remains limited to
// the allocation entry points already audited by the safety backend.
fn ac_finish_rt_slice(out: *ArrayList[AInstr], result: i32, cg: *ACg) void {
    push[AInstr](out, ai_mov_rr(A_X15(), A_X0()));
    push[AInstr](out, ai_load(A_X9(), A_X15(), 0));
    push[AInstr](out, ai_store(A_X29(), result, A_X9()));
    push[AInstr](out, ai_load(A_X9(), A_X15(), 8));
    push[AInstr](out, ai_store(A_X29(), result + 8, A_X9()));
    ac_emit_allocator_release(out, cg, A_X15());
    ac_emit_lea(out, A_X0(), result);
    push[AInstr](out, ai_push(A_X0()));
}

// Returns 1 if `fname` was handled as a builtin (result pushed).
fn ac_lower_builtin(out: *ArrayList[AInstr], fname: []u8, c: Call, env: *AEnv, syms: ArrayList[AFnSym], cg: *ACg) i32 {
    let nargs: i32 = len[*Node](c.args);
    // Cross-target scalar CPU-control intrinsics.  These spellings predate the
    // @builtin namespace on x86-64, so intercept their direct calls here before
    // ordinary extern/function lookup.  AArch64 supplies baseline instructions
    // for every operation; popcount uses mandatory Advanced SIMD and therefore
    // needs no optional CPU-feature dispatch on Apple Silicon.
    if (@strEq(fname, "popcount")) {
        if (nargs != 1) { ac_err(cg, "arm64: popcount expects one argument"); push[AInstr](out, ai_mov_imm(A_X0(), 0)); push[AInstr](out, ai_push(A_X0())); return 1; }
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg); push[AInstr](out, ai_pop(A_X0()));
        push[AInstr](out, ai_fmov_dx(0, A_X0()));
        push[AInstr](out, ai_vcnt(0, 0));
        push[AInstr](out, ai_vaddv_b(0, 0));
        push[AInstr](out, ai_vumov_b(A_X0(), 0));
        push[AInstr](out, ai_push(A_X0())); return 1;
    }
    if (@strEq(fname, "byte_swap64")) {
        if (nargs != 1) { ac_err(cg, "arm64: byte_swap64 expects one i64 argument"); push[AInstr](out, ai_mov_imm(A_X0(), 0)); push[AInstr](out, ai_push(A_X0())); return 1; }
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg); push[AInstr](out, ai_pop(A_X0()));
        push[AInstr](out, ai_rev64(A_X0(), A_X0())); push[AInstr](out, ai_push(A_X0())); return 1;
    }
    if (@strEq(fname, "leading_zeros")) {
        if (nargs != 1) { ac_err(cg, "arm64: leading_zeros expects one i64 argument"); push[AInstr](out, ai_mov_imm(A_X0(), 0)); push[AInstr](out, ai_push(A_X0())); return 1; }
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg); push[AInstr](out, ai_pop(A_X0()));
        // AArch64 CLZ is defined for zero and returns 64, exactly matching the
        // public Zag contract without an explicit zero branch.
        push[AInstr](out, ai_clz64(A_X0(), A_X0())); push[AInstr](out, ai_push(A_X0())); return 1;
    }
    if (@strEq(fname, "trailing_zeros")) {
        if (nargs != 1) { ac_err(cg, "arm64: trailing_zeros expects one i64 argument"); push[AInstr](out, ai_mov_imm(A_X0(), 0)); push[AInstr](out, ai_push(A_X0())); return 1; }
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg); push[AInstr](out, ai_pop(A_X0()));
        // RBIT+CLZ is the architectural AArch64 count-trailing-zeros idiom and
        // preserves the x86 public zero result of 64.
        push[AInstr](out, ai_rbit64(A_X0(), A_X0())); push[AInstr](out, ai_clz64(A_X0(), A_X0())); push[AInstr](out, ai_push(A_X0())); return 1;
    }
    if (@strEq(fname, "andn")) {
        if (nargs != 2) { ac_err(cg, "arm64: andn expects two arguments"); push[AInstr](out, ai_mov_imm(A_X0(), 0)); push[AInstr](out, ai_push(A_X0())); return 1; }
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg);
        ac_lower_expr(out, get[*Node](c.args, 1), env, syms, cg);
        push[AInstr](out, ai_pop(A_X1())); push[AInstr](out, ai_pop(A_X0()));
        // x86 ANDN(a,b) = (~a)&b; AArch64 BIC(lhs,rhs) = lhs&~rhs.
        push[AInstr](out, ai_bic64(A_X0(), A_X1(), A_X0())); push[AInstr](out, ai_push(A_X0())); return 1;
    }
    // Canonical macOS cwd without trusting ambient PWD. This private call has
    // an ordinary source implementation so an older seed can bootstrap it;
    // current Darwin output replaces that body with descriptor-based kernel
    // discovery. F_GETPATH is the supported XNU interface for this purpose.
    if (@strEq(fname, "_zag_host_cwd") && cg.*.target_os == AC_OS_MACOS()) {
        if (nargs != 0) {
            ac_err(cg, "arm64: _zag_host_cwd expects no arguments");
            push[AInstr](out, ai_mov_imm(A_X0(), 0));
            push[AInstr](out, ai_push(A_X0()));
            return 1;
        }
        if (cg.*.object_mode == 1) {
            ac_err(cg, "arm64: _zag_host_cwd is executable-runtime-only and is unavailable in object mode");
            push[AInstr](out, ai_mov_imm(A_X0(), 0));
            push[AInstr](out, ai_push(A_X0()));
            return 1;
        }
        let result: i32 = ac_slot_scratch(cg, 2);
        let buffer_slot: i32 = ac_slot_scratch(cg, 1);
        let fd_slot: i32 = ac_slot_scratch(cg, 1);
        let scan: i32 = ac_fresh(cg);
        let found: i32 = ac_fresh(cg);
        let failed: i32 = ac_fresh(cg);
        let done: i32 = ac_fresh(cg);
        let dot: i32 = ac_rt_push_cstr(cg, ".");

        // PATH_MAX is 1024 on Darwin; a 4096-byte owned result leaves ample
        // room while preserving the normal Zag string-free contract.
        push[AInstr](out, ai_mov_imm(A_X0(), 4096));
        cg.*.use_al = 1;
        push[AInstr](out, ai_call(cg.*.al_lbl));
        push[AInstr](out, ai_store(A_X29(), buffer_slot, A_X0()));

        // open(".", O_RDONLY, 0)
        push[AInstr](out, ai_data_addr(A_X0(), dot));
        push[AInstr](out, ai_mov_imm(A_X1(), 0));
        push[AInstr](out, ai_mov_imm(A_X2(), 0));
        push[AInstr](out, ai_darwin_syscall(5));
        push[AInstr](out, ai_cmp_imm(A_X0(), 0));
        push[AInstr](out, ai_jl(failed));
        push[AInstr](out, ai_store(A_X29(), fd_slot, A_X0()));

        // fcntl(fd, F_GETPATH, buffer), then close the descriptor regardless
        // of whether path discovery succeeded.
        push[AInstr](out, ai_mov_imm(A_X1(), 50));
        push[AInstr](out, ai_load(A_X2(), A_X29(), buffer_slot));
        push[AInstr](out, ai_darwin_syscall(92));
        push[AInstr](out, ai_mov_rr(A_X7(), A_X0()));
        push[AInstr](out, ai_load(A_X0(), A_X29(), fd_slot));
        push[AInstr](out, ai_darwin_syscall(6));
        push[AInstr](out, ai_cmp_imm(A_X7(), 0));
        push[AInstr](out, ai_jl(failed));

        // Derive the slice length from the kernel-written C string, refusing
        // an unterminated or empty response rather than exposing stale bytes.
        // Keep the cursor out of x9: ai_cmp_imm uses x9 as its established
        // materialization scratch when 4096 is not directly encodable.
        push[AInstr](out, ai_load(A_X12(), A_X29(), buffer_slot));
        push[AInstr](out, ai_mov_imm(A_X10(), 0));
        push[AInstr](out, ai_label(scan));
        push[AInstr](out, ai_cmp_imm(A_X10(), 4096));
        push[AInstr](out, ai_jge(failed));
        push[AInstr](out, ai_loadb(A_X11(), A_X12(), 0));
        push[AInstr](out, ai_cmp_imm(A_X11(), 0));
        push[AInstr](out, ai_je(found));
        push[AInstr](out, ai_add_imm(A_X12(), 1));
        push[AInstr](out, ai_add_imm(A_X10(), 1));
        push[AInstr](out, ai_jmp(scan));
        push[AInstr](out, ai_label(found));
        push[AInstr](out, ai_cmp_imm(A_X10(), 0));
        push[AInstr](out, ai_je(failed));
        push[AInstr](out, ai_load(A_X0(), A_X29(), buffer_slot));
        push[AInstr](out, ai_store(A_X29(), result, A_X0()));
        push[AInstr](out, ai_store(A_X29(), result + 8, A_X10()));
        ac_emit_lea(out, A_X0(), result);
        push[AInstr](out, ai_push(A_X0()));
        push[AInstr](out, ai_jmp(done));

        push[AInstr](out, ai_label(failed));
        push[AInstr](out, ai_load(A_X0(), A_X29(), buffer_slot));
        ac_emit_allocator_release(out, cg, A_X0());
        push[AInstr](out, ai_mov_imm(A_X0(), 0));
        push[AInstr](out, ai_store(A_X29(), result, A_X0()));
        push[AInstr](out, ai_store(A_X29(), result + 8, A_X0()));
        ac_emit_lea(out, A_X0(), result);
        push[AInstr](out, ai_push(A_X0()));
        push[AInstr](out, ai_label(done));
        return 1;
    }
    // Canonical path of the exact running Mach-O image. The ordinary source
    // body is an argv[0] bootstrap bridge for older seeds; current Darwin
    // output replaces it with proc_pidpath's kernel-backed vnode identity so
    // PATH launches and symlinked compiler names bind to the executable that
    // is actually running.
    if (@strEq(fname, "_zag_current_executable_path") &&
        cg.*.target_os == AC_OS_MACOS()) {
        if (nargs != 0) {
            ac_err(cg, "arm64: _zag_current_executable_path expects no arguments");
            push[AInstr](out, ai_mov_imm(A_X0(), 0));
            push[AInstr](out, ai_push(A_X0()));
            return 1;
        }
        if (cg.*.object_mode == 1) {
            ac_err(cg, "arm64: _zag_current_executable_path is executable-runtime-only and is unavailable in object mode");
            push[AInstr](out, ai_mov_imm(A_X0(), 0));
            push[AInstr](out, ai_push(A_X0()));
            return 1;
        }
        let result: i32 = ac_slot_scratch(cg, 2);
        let buffer_slot: i32 = ac_slot_scratch(cg, 1);
        let scan: i32 = ac_fresh(cg);
        let found: i32 = ac_fresh(cg);
        let failed: i32 = ac_fresh(cg);
        let done: i32 = ac_fresh(cg);

        // proc_pidpath accepts 1024..16384 bytes. Four PATH_MAX units are
        // sufficient for the API's documented maximum and remain bounded.
        push[AInstr](out, ai_mov_imm(A_X0(), 4096));
        cg.*.use_al = 1;
        push[AInstr](out, ai_call(cg.*.al_lbl));
        push[AInstr](out, ai_store(A_X29(), buffer_slot, A_X0()));

        // proc_info(PROC_INFO_CALL_PIDINFO=2, getpid(),
        // PROC_PIDPATHINFO=11, 0, buffer, 4096).
        push[AInstr](out, ai_darwin_syscall(20));
        push[AInstr](out, ai_cmp_imm(A_X0(), 0));
        push[AInstr](out, ai_jle(failed));
        push[AInstr](out, ai_mov_rr(A_X1(), A_X0()));
        push[AInstr](out, ai_mov_imm(A_X0(), 2));
        push[AInstr](out, ai_mov_imm(A_X2(), 11));
        push[AInstr](out, ai_mov_imm(A_X3(), 0));
        push[AInstr](out, ai_load(A_X4(), A_X29(), buffer_slot));
        push[AInstr](out, ai_mov_imm(A_X5(), 4096));
        push[AInstr](out, ai_darwin_syscall(336));
        push[AInstr](out, ai_cmp_imm(A_X0(), 0));
        push[AInstr](out, ai_jl(failed));

        // The kernel writes a C string. Derive the owned slice length and
        // reject empty or unterminated responses rather than trusting an ABI
        // return count whose meaning is flavor-specific.
        push[AInstr](out, ai_load(A_X12(), A_X29(), buffer_slot));
        push[AInstr](out, ai_mov_imm(A_X10(), 0));
        push[AInstr](out, ai_label(scan));
        push[AInstr](out, ai_cmp_imm(A_X10(), 4096));
        push[AInstr](out, ai_jge(failed));
        push[AInstr](out, ai_loadb(A_X11(), A_X12(), 0));
        push[AInstr](out, ai_cmp_imm(A_X11(), 0));
        push[AInstr](out, ai_je(found));
        push[AInstr](out, ai_add_imm(A_X12(), 1));
        push[AInstr](out, ai_add_imm(A_X10(), 1));
        push[AInstr](out, ai_jmp(scan));
        push[AInstr](out, ai_label(found));
        push[AInstr](out, ai_cmp_imm(A_X10(), 0));
        push[AInstr](out, ai_je(failed));
        push[AInstr](out, ai_load(A_X0(), A_X29(), buffer_slot));
        push[AInstr](out, ai_store(A_X29(), result, A_X0()));
        push[AInstr](out, ai_store(A_X29(), result + 8, A_X10()));
        ac_emit_lea(out, A_X0(), result);
        push[AInstr](out, ai_push(A_X0()));
        push[AInstr](out, ai_jmp(done));

        push[AInstr](out, ai_label(failed));
        push[AInstr](out, ai_load(A_X0(), A_X29(), buffer_slot));
        ac_emit_allocator_release(out, cg, A_X0());
        push[AInstr](out, ai_mov_imm(A_X0(), 0));
        push[AInstr](out, ai_store(A_X29(), result, A_X0()));
        push[AInstr](out, ai_store(A_X29(), result + 8, A_X0()));
        ac_emit_lea(out, A_X0(), result);
        push[AInstr](out, ai_push(A_X0()));
        push[AInstr](out, ai_label(done));
        return 1;
    }
    // Match x86: Script `println` accepts integer expressions without forcing
    // manual formatting before a script can grow into explicit native Zag.
    if (@strEq(fname, "_zag_println") && nargs == 1) {
        let script_arg: *Node = get[*Node](c.args, 0);
        let script_ty: []u8 = ac_expr_type(script_arg, env, syms, cg);
        if (ac_type_is_slice_or_ref(script_ty) == 0) {
            ac_lower_expr(out, script_arg, env, syms, cg);
            push[AInstr](out, ai_pop(A_X0()));
            // Unsigned script integers print via the unsigned decimal routine
            // so values ≥ 2^63 (u64) / 2^31 (u32) are not shown negative.
            if (cg_is_unsigned_int_type(script_ty) == 1) {
                cg.*.use_pu = 1;
                push[AInstr](out, ai_call(cg.*.pu_lbl));
            } else {
                cg.*.use_pi = 1;
                push[AInstr](out, ai_call(cg.*.pi_lbl));
            }
            let nl: i32 = ac_intern_nl(cg);
            push[AInstr](out, ai_data_addr(A_X1(), nl));
            push[AInstr](out, ai_mov_imm(A_X2(), 1));
            cg.*.use_ps = 1;
            push[AInstr](out, ai_call(cg.*.ps_lbl));
            push[AInstr](out, ai_mov_imm(A_X0(), 0));
            push[AInstr](out, ai_push(A_X0()));
            return 1;
        }
    }
    if (ac_is_print_int(fname) == 1 || ac_is_print_int_nl(fname) == 1) {
        if (nargs != 1) { ac_err(cg, "arm64: print_int expects one argument"); return 1; }
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg);
        push[AInstr](out, ai_pop(A_X0()));
        if (@strEq(fname, "print_i32")) {
            push[AInstr](out, ai_sxtw(A_X0(), A_X0()));
        } else if (@strEq(fname, "print_u32")) {
            push[AInstr](out, ai_and_imm(A_X0(), 4294967295));
        }
        // Unsigned decimal prints (u32/u64) use the UNSIGNED routine; the
        // signed one would print bit-63-set (or ≥2^31) values negative.
        if (@strEq(fname, "print_u32") || @strEq(fname, "print_u64") ||
            @strEq(fname, "_zag_print_u64")) {
            cg.*.use_pu = 1;
            push[AInstr](out, ai_call(cg.*.pu_lbl));
        } else {
            cg.*.use_pi = 1;
            push[AInstr](out, ai_call(cg.*.pi_lbl));
        }
        if (ac_is_print_int_nl(fname) == 1) {
            let nl: i32 = ac_intern_nl(cg);
            push[AInstr](out, ai_data_addr(A_X1(), nl));
            push[AInstr](out, ai_mov_imm(A_X2(), 1));
            cg.*.use_ps = 1;
            push[AInstr](out, ai_call(cg.*.ps_lbl));
        }
        push[AInstr](out, ai_mov_imm(A_X0(), 0));
        push[AInstr](out, ai_push(A_X0()));
        return 1;
    }
    if (ac_is_print_str(fname) == 1 || @strEq(fname, "_zag_println")) {
        if (nargs != 1) { ac_err(cg, "arm64: print_str expects one argument"); return 1; }
        let arg: *Node = get[*Node](c.args, 0);
        let aty: []u8 = ac_expr_type(arg, env, syms, cg);
        if (ac_type_is_slice_or_ref(aty) == 0) {
            ac_err(cg, "arm64: print_str argument must be a []u8 slice");
            push[AInstr](out, ai_mov_imm(A_X0(), 0));
            push[AInstr](out, ai_push(A_X0()));
            return 1;
        }
        ac_lower_expr(out, arg, env, syms, cg);
        push[AInstr](out, ai_pop(A_X10()));
        push[AInstr](out, ai_load(A_X1(), A_X10(), 0));
        push[AInstr](out, ai_load(A_X2(), A_X10(), 8));
        cg.*.use_ps = 1;
        push[AInstr](out, ai_call(cg.*.ps_lbl));
        if (@strEq(fname, "_zag_println")) {
            let nl: i32 = ac_intern_nl(cg);
            push[AInstr](out, ai_data_addr(A_X1(), nl));
            push[AInstr](out, ai_mov_imm(A_X2(), 1));
            push[AInstr](out, ai_call(cg.*.ps_lbl));
        }
        push[AInstr](out, ai_mov_imm(A_X0(), 0));
        push[AInstr](out, ai_push(A_X0()));
        return 1;
    }
    // Allocation-free observers. Keep the established native counter offsets
    // in sync with x86; ac_emit_allocator_word_address selects fixed ELF BSS
    // or the equivalent writable Mach-O data word.
    if (@strEq(fname, "_zag_allocator_allocation_count") ||
        @strEq(fname, "_zag_allocator_live_bytes") ||
        @strEq(fname, "_zag_allocator_peak_live_bytes")) {
        if (nargs != 0) {
            ac_err(cg, "arm64: allocator witness expects no arguments");
            push[AInstr](out, ai_mov_imm(A_X0(), 0));
            push[AInstr](out, ai_push(A_X0()));
            return 1;
        }
        let counter_offset: i32 = ac_allocator_count_offset();
        if (@strEq(fname, "_zag_allocator_live_bytes")) {
            counter_offset = ac_allocator_live_offset();
        }
        if (@strEq(fname, "_zag_allocator_peak_live_bytes")) {
            counter_offset = ac_allocator_peak_offset();
        }
        ac_emit_allocator_word_address(out, cg, A_X10(), counter_offset);
        push[AInstr](out, ai_load(A_X0(), A_X10(), 0));
        push[AInstr](out, ai_push(A_X0()));
        return 1;
    }
    if (@strEq(fname, "new")) {
        if (nargs != 1) { ac_err(cg, "arm64: new expects one argument"); return 1; }
        let a: *Node = get[*Node](c.args, 0);
        let aty: []u8 = ac_expr_type(a, env, syms, cg);
        let sz: i32 = ac_round8(ac_type_size(cg, aty));
        ac_lower_expr(out, a, env, syms, cg);
        push[AInstr](out, ai_mov_imm(A_X0(), sz as i64));
        cg.*.use_al = 1;
        push[AInstr](out, ai_call(cg.*.al_lbl));
        if (ac_is_aggregate(cg, aty) == 1) {
            push[AInstr](out, ai_mov_rr(A_X10(), A_X0()));
            push[AInstr](out, ai_pop(A_X11()));
            ac_emit_copy(out, sz / 8);
            push[AInstr](out, ai_push(A_X10()));
        } else {
            push[AInstr](out, ai_mov_rr(A_X10(), A_X0()));
            push[AInstr](out, ai_pop(A_X11()));
            push[AInstr](out, ai_store(A_X10(), 0, A_X11()));
            push[AInstr](out, ai_push(A_X10()));
        }
        return 1;
    }
    // Root Script new(T{...}) allocates the payload from its hidden bounded
    // ScriptContext. Allocate before materializing fields so an exhausted
    // budget returns null without evaluating initializer expressions, matching
    // x86 and keeping imported strict `new` on the ordinary allocator above.
    if (@strEq(fname, "_zag_script_new")) {
        if (nargs != 2) {
            ac_err(cg, "arm64: internal Script new expects context and one struct literal");
            push[AInstr](out, ai_mov_imm(A_X0(), 0)); push[AInstr](out, ai_push(A_X0())); return 1;
        }
        let value: *Node = get[*Node](c.args, 1);
        let value_type: []u8 = ac_expr_type(value, env, syms, cg);
        if (ac_is_aggregate(cg, value_type) == 0) {
            ac_err(cg, "arm64: Script new argument must be a struct literal");
            push[AInstr](out, ai_mov_imm(A_X0(), 0)); push[AInstr](out, ai_push(A_X0())); return 1;
        }
        let size: i32 = ac_round8(ac_type_size(cg, value_type));
        let result_slot: i32 = ac_slot_scratch(cg, 1);
        let null_result: i32 = ac_fresh(cg);
        let done: i32 = ac_fresh(cg);
        ac_lower_expr(out, get[*Node](c.args, 0), env, syms, cg);
        push[AInstr](out, ai_pop(A_X0()));
        push[AInstr](out, ai_mov_imm(A_X1(), size as i64));
        ac_emit_script_alloc_inline(out, cg);
        push[AInstr](out, ai_store(A_X29(), result_slot, A_X0()));
        push[AInstr](out, ai_cmp_imm(A_X0(), 0)); push[AInstr](out, ai_je(null_result));
        ac_lower_expr(out, value, env, syms, cg);
        push[AInstr](out, ai_pop(A_X11()));
        push[AInstr](out, ai_load(A_X10(), A_X29(), result_slot));
        ac_emit_copy(out, size / 8);
        push[AInstr](out, ai_load(A_X0(), A_X29(), result_slot));
        push[AInstr](out, ai_jmp(done));
        push[AInstr](out, ai_label(null_result));
        push[AInstr](out, ai_mov_imm(A_X0(), 0));
        push[AInstr](out, ai_label(done));
        push[AInstr](out, ai_push(A_X0()));
        return 1;
