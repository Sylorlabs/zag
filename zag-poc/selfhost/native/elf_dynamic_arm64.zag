// selfhost/native/elf_dynamic_arm64.zag — minimal ELF64 AArch64 dynamic executable writer.
//
// Mirrors elf_dynamic.zag but for AArch64: different EM machine, interpreter
// path, page size (64K), and relocation type (R_AARCH64_GLOB_DAT = 1025).

@import("elf_arm64.zag")

fn ADYN_GOT_VADDR() i64 { return 150994944; } // 0x9000000 (matches x86 GOT)
fn ADYN_HDRS() i64 { return 512; }            // ELF header + 8 program headers
fn ADYN_INTERP_LEN() i64 { return 26; }       // "/lib/ld-linux-aarch64.so.1\0"

fn adyn_align(v: i64, a: i64) i64 {
    return v + ((a - (v % a)) % a);
}

fn adyn_append(buf: *ArrayList[u8], src: ArrayList[u8]) void {
    let i: i32 = 0;
    while (i < src.len) { aelf_eb(buf, get[u8](src, i) as i32); i = i + 1; }
}

fn adyn_append_slice(buf: *ArrayList[u8], src: []u8) void {
    let i: i32 = 0;
    while (i < src.len) { aelf_eb(buf, src[i] as i32); i = i + 1; }
}

fn adyn_pad_to(buf: *ArrayList[u8], off: i64) void {
    while ((buf.*.len as i64) < off) { aelf_eb(buf, 0); }
}

fn adyn_entry(buf: *ArrayList[u8], tag: i64, value: i64) void {
    aelf_emit_le(buf, tag, 8);
    aelf_emit_le(buf, value, 8);
}

fn adyn_phdr(buf: *ArrayList[u8], ptype: i64, flags: i64, off: i64,
             vaddr: i64, filesz: i64, memsz: i64, align: i64) void {
    aelf_emit_le(buf, ptype, 4);
    aelf_emit_le(buf, flags, 4);
    aelf_emit_le(buf, off, 8);
    aelf_emit_le(buf, vaddr, 8);
    aelf_emit_le(buf, vaddr, 8);
    aelf_emit_le(buf, filesz, 8);
    aelf_emit_le(buf, memsz, 8);
    aelf_emit_le(buf, align, 8);
}

// R_AARCH64_GLOB_DAT = 1025
fn write_elf_dynamic_arm64(path: []u8, text: ArrayList[u8], entry_off: i32,
                           app_data: ArrayList[u8], extern_syms: ArrayList[[]u8],
                           needed: ArrayList[[]u8]) i32 {
    let interp: []u8 = "/lib/ld-linux-aarch64.so.1";
    let interp_off: i64 = ADYN_HDRS();
    let code_off: i64 = ADYN_HDRS() + ADYN_INTERP_LEN();
    let code_filesz: i64 = code_off + (text.len as i64);
    let entry: i64 = AVBASE() + code_off + (entry_off as i64);

    // Dynamic string table: NUL, DT_NEEDED names, then undefined symbol names.
    let dynstr: ArrayList[u8] = make[u8](128);
    aelf_eb(&dynstr, 0);
    let needed_offs: ArrayList[i32] = make[i32](needed.len + 1);
    let ni: i32 = 0;
    while (ni < needed.len) {
        push[i32](&needed_offs, dynstr.len);
        adyn_append_slice(&dynstr, get[[]u8](needed, ni));
        aelf_eb(&dynstr, 0);
        ni = ni + 1;
    }
    let sym_offs: ArrayList[i32] = make[i32](extern_syms.len + 1);
    let si: i32 = 0;
    while (si < extern_syms.len) {
        push[i32](&sym_offs, dynstr.len);
        adyn_append_slice(&dynstr, get[[]u8](extern_syms, si));
        aelf_eb(&dynstr, 0);
        si = si + 1;
    }

    // ELF64 dynsym: mandatory null entry followed by undefined GLOBAL FUNCs.
    let dynsym: ArrayList[u8] = make[u8](24 * (extern_syms.len + 1));
    let z: i32 = 0;
    while (z < 24) { aelf_eb(&dynsym, 0); z = z + 1; }
    si = 0;
    while (si < extern_syms.len) {
        aelf_emit_le(&dynsym, get[i32](sym_offs, si) as i64, 4); // st_name
        aelf_eb(&dynsym, 18);                                    // GLOBAL FUNC
        aelf_eb(&dynsym, 0);                                     // st_other
        aelf_emit_le(&dynsym, 0, 2);                             // SHN_UNDEF
        aelf_emit_le(&dynsym, 0, 8);                             // st_value
        aelf_emit_le(&dynsym, 0, 8);                             // st_size
        si = si + 1;
    }

    // One GOT relocation per symbol. r_info = sym_index<<32 + GLOB_DAT(1025).
    let rela: ArrayList[u8] = make[u8](24 * extern_syms.len);
    si = 0;
    while (si < extern_syms.len) {
        aelf_emit_le(&rela, ADYN_GOT_VADDR() + ((si as i64) * 8), 8);
        aelf_emit_le(&rela, (((si + 1) as i64) * 4294967296) + 1025, 8);
        aelf_emit_le(&rela, 0, 8);
        si = si + 1;
    }

    let data_file_off: i64 = adyn_align(code_filesz, APAGE());
    let dynstr_rel: i64 = adyn_align(app_data.len as i64, 8);
    let dynsym_rel: i64 = adyn_align(dynstr_rel + (dynstr.len as i64), 8);
    let rela_rel: i64 = adyn_align(dynsym_rel + (dynsym.len as i64), 8);
    let dynamic_rel: i64 = adyn_align(rela_rel + (rela.len as i64), 8);

    // Dynamic entries.
    let dynamic: ArrayList[u8] = make[u8](256);
    ni = 0;
    while (ni < needed.len) {
        adyn_entry(&dynamic, 1, get[i32](needed_offs, ni) as i64); // DT_NEEDED
        ni = ni + 1;
    }
    adyn_entry(&dynamic, 5, ADVBASE() + dynstr_rel);               // DT_STRTAB
    adyn_entry(&dynamic, 10, dynstr.len as i64);                   // DT_STRSZ
    adyn_entry(&dynamic, 6, ADVBASE() + dynsym_rel);               // DT_SYMTAB
    adyn_entry(&dynamic, 11, 24);                                  // DT_SYMENT
    adyn_entry(&dynamic, 7, ADVBASE() + rela_rel);                 // DT_RELA
    adyn_entry(&dynamic, 8, rela.len as i64);                      // DT_RELASZ
    adyn_entry(&dynamic, 9, 24);                                   // DT_RELAENT
    adyn_entry(&dynamic, 24, 0);                                   // DT_BIND_NOW
    adyn_entry(&dynamic, 0, 0);                                    // DT_NULL

    let data_filesz: i64 = dynamic_rel + (dynamic.len as i64);
    let got_file_off: i64 = adyn_align(data_file_off + data_filesz, APAGE());
    let got_filesz: i64 = (extern_syms.len as i64) * 8;
    let buf: ArrayList[u8] = make[u8]((got_file_off + got_filesz) as i32);

    // ELF64 header.
    aelf_eb(&buf, 127); aelf_eb(&buf, 69); aelf_eb(&buf, 76); aelf_eb(&buf, 70);
    aelf_eb(&buf, 2); aelf_eb(&buf, 1); aelf_eb(&buf, 1); aelf_eb(&buf, 0);
    let ei: i32 = 0;
    while (ei < 8) { aelf_eb(&buf, 0); ei = ei + 1; }
    aelf_emit_le(&buf, 2, 2);       // e_type = ET_EXEC
    aelf_emit_le(&buf, 183, 2);     // e_machine = EM_AARCH64
    aelf_emit_le(&buf, 1, 4);       // e_version
    aelf_emit_le(&buf, entry, 8);   // e_entry
    aelf_emit_le(&buf, 64, 8);      // e_phoff
    aelf_emit_le(&buf, 0, 8);       // e_shoff
    aelf_emit_le(&buf, 0, 4);       // e_flags
    aelf_emit_le(&buf, 64, 2);      // e_ehsize
    aelf_emit_le(&buf, 56, 2);      // e_phentsize
    aelf_emit_le(&buf, 8, 2);       // e_phnum = 8
    aelf_emit_le(&buf, 0, 2);       // e_shentsize
    aelf_emit_le(&buf, 0, 2);       // e_shnum
    aelf_emit_le(&buf, 0, 2);       // e_shstrndx

    // Eight program headers: PHDR, INTERP, code, data, BSS, GOT, DYNAMIC, stack.
    adyn_phdr(&buf, 6, 4, 64, AVBASE() + 64, 448, 448, 8);
    adyn_phdr(&buf, 3, 4, interp_off, AVBASE() + interp_off, ADYN_INTERP_LEN(), ADYN_INTERP_LEN(), 1);
    adyn_phdr(&buf, 1, 5, 0, AVBASE(), code_filesz, code_filesz, APAGE());
    adyn_phdr(&buf, 1, 4, data_file_off, ADVBASE(), data_filesz, data_filesz, APAGE());
    adyn_phdr(&buf, 1, 6, 0, ABSS_VBASE(), 0, ABSS_MEMSZ(), APAGE());
    adyn_phdr(&buf, 1, 6, got_file_off, ADYN_GOT_VADDR(), got_filesz, got_filesz, APAGE());
    adyn_phdr(&buf, 2, 4, data_file_off + dynamic_rel, ADVBASE() + dynamic_rel,
              dynamic.len as i64, dynamic.len as i64, 8);
    adyn_phdr(&buf, 1685382481, 6, 0, 0, 0, 0, 16); // PT_GNU_STACK

    adyn_append_slice(&buf, interp); aelf_eb(&buf, 0);
    adyn_append(&buf, text);
    adyn_pad_to(&buf, data_file_off);
    adyn_append(&buf, app_data);
    adyn_pad_to(&buf, data_file_off + dynstr_rel); adyn_append(&buf, dynstr);
    adyn_pad_to(&buf, data_file_off + dynsym_rel); adyn_append(&buf, dynsym);
    adyn_pad_to(&buf, data_file_off + rela_rel); adyn_append(&buf, rela);
    adyn_pad_to(&buf, data_file_off + dynamic_rel); adyn_append(&buf, dynamic);
    adyn_pad_to(&buf, got_file_off + got_filesz);
    return _zag_write_exec(path, buf.data[0..buf.len]);
}
