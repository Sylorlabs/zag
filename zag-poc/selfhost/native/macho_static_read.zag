// Native static-link input reader for bounded ARM64 Mach-O objects/archives.
// Format authority: Apple SDK mach-o/{loader,nlist,arm64/reloc}.h and ar.h.
@import("macho_dependency.zag")
@import("macho_object.zag")

struct MsSection {
    name: []u8, kind: i32, address: i64, size: i32, offset: i32,
    alignment: i32, zero: i32, relocations: i32, count: i32
}
struct MsSymbol {
    name: []u8, section: i32, value: i64, external: i32, hidden: i32,
    weak_ref: i32, weak_def: i32, common_size: i64, common_align: i32
}
struct MsReloc {
    section: i32, offset: i32, target: i32, external: i32,
    kind: i32, width: i32, addend: i64, subtract: i32
}
struct MsRange { offset: i32, size: i32 }
struct MsObject {
    image: []u8, sections: ArrayList[MsSection], symbols: ArrayList[MsSymbol],
    relocations: ArrayList[MsReloc], valid: i32, error: []u8
}
struct MsArchiveMember { name: []u8, bytes: []u8 }
struct MsArchive { members: ArrayList[MsArchiveMember], valid: i32, error: []u8 }

fn ms_signed(bytes: []u8, at: i32, width: i32) i64 {
    let value: i64 = bytes[at+width-1] as i64;
    if (value >= 128) { value = value-256; }
    let i: i32 = width-1;
    while (i > 0) { i = i-1; value = value*256+(bytes[at+i] as i64); }
    return value;
}
fn ms_pow2(power: i32) i64 {
    let result: i64 = 1; let i: i32 = 0;
    while (i < power) { result = result*2; i = i+1; }
    return result;
}
fn ms_name16(bytes: []u8, at: i32) []u8 {
    let end: i32 = at; while (end < at+16 && bytes[end] != 0) { end = end+1; }
    return bytes[at..end];
}
fn ms_range(ranges: *ArrayList[MsRange], bytes: []u8, at: i64, size: i64) i32 {
    if (mdep_range(bytes,at,size) == 0) { return 0; }
    if (size == 0) { return 1; }
    let i: i32 = 0;
    while (i < ranges.*.len) {
        let old: MsRange = ranges.*.data[i];
        if (at < (old.offset as i64)+(old.size as i64) && (old.offset as i64) < at+size) { return 0; }
        i = i+1;
    }
    push[MsRange](ranges,MsRange{.offset=at as i32,.size=size as i32}); return 1;
}
fn ms_object_empty(bytes: []u8) MsObject {
    return MsObject{.image=bytes,.sections=make[MsSection](4),.symbols=make[MsSymbol](16),
        .relocations=make[MsReloc](16),.valid=0,.error="invalid Mach-O object"};
}
fn ms_object_release(object: *MsObject) void {
    free[MsSection](&object.*.sections); free[MsSymbol](&object.*.symbols);
    free[MsReloc](&object.*.relocations);
}

fn ms_read_object_inner(bytes: []u8, object: *MsObject, ranges: *ArrayList[MsRange]) i32 {
    if (bytes.len < 32 || bytes.len > 67108864 || mdep_uint(bytes,0,4,0) != 0xfeedfacf ||
        mdep_uint(bytes,4,4,0) != 0x100000c || (mdep_uint(bytes,8,4,0) & 0xffffff) > 1 ||
        mdep_uint(bytes,12,4,0) != 1) { return 0; }
    let commands: i64 = mdep_uint(bytes,16,4,0); let command_bytes: i64 = mdep_uint(bytes,20,4,0);
    if (commands > 256 || ms_range(ranges,bytes,0,32+command_bytes) == 0) { return 0; }
    let at: i32 = 32; let command: i32 = 0; let symbol_at: i64 = -1;
    let symbol_count: i64 = 0; let strings_at: i64 = 0; let strings_size: i64 = 0;
    let platform: i32 = 0; let segment_count: i32 = 0;
    while ((command as i64) < commands) {
        object.*.error = "unsupported or malformed object load command";
        if ((at as i64) > 32+command_bytes-8) { return 0; }
        let kind: i64 = mdep_uint(bytes,at,4,0); let size: i64 = mdep_uint(bytes,at+4,4,0);
        if (size < 8 || size%8 != 0 || size > 32+command_bytes-(at as i64)) { return 0; }
        if (kind == 0x19) {
            if (size < 72 || segment_count != 0) { return 0; } segment_count = 1;
            let count: i64 = mdep_uint(bytes,at+64,4,0);
            let vmstart: i64 = mdep_uint(bytes,at+24,8,0); let vmsize: i64 = mdep_uint(bytes,at+32,8,0);
            let fileoff: i64 = mdep_uint(bytes,at+40,8,0); let filesize: i64 = mdep_uint(bytes,at+48,8,0);
            if (count > 255 || size != 72+count*80 || vmstart < 0 || vmsize < 0 ||
                vmstart > 2147483647-vmsize || mdep_range(bytes,fileoff,filesize) == 0) { return 0; }
            let section: i32 = 0;
            while ((section as i64) < count) {
                object.*.error = "unsupported or malformed object section";
                let sat: i32 = at+72+section*80;
                let name: []u8 = ms_name16(bytes,sat); let segment: []u8 = ms_name16(bytes,sat+16);
                let address: i64 = mdep_uint(bytes,sat+32,8,0); let ssize: i64 = mdep_uint(bytes,sat+40,8,0);
                let offset: i64 = mdep_uint(bytes,sat+48,4,0); let align: i64 = mdep_uint(bytes,sat+52,4,0);
                let roff: i64 = mdep_uint(bytes,sat+56,4,0); let rcount: i64 = mdep_uint(bytes,sat+60,4,0);
                let flags: i64 = mdep_uint(bytes,sat+64,4,0); let type: i64 = flags & 255;
                let skind: i32 = 2; let zero: i32 = 0;
                if ((flags & 0x2000000) != 0) { skind = 0; }
                else if (@strEq(name,"__text") && @strEq(segment,"__TEXT") && type == 0) { skind = 1; }
                else if (type != 0 && type != 1 && type != 2 && type != 3 && type != 4 && type != 14) { return 0; }
                if (skind != 0 && ((flags & 0x80000400) != 0) && skind != 1) { return 0; }
                if (skind != 0 && (@strEq(name,"__compact_unwind") || @strEq(name,"__eh_frame"))) {
                    object.*.error = "object unwind metadata is not yet supported"; return 0;
                }
                if (type == 1) { zero = 1; }
                if (ssize < 0 || ssize > 67108864 || address < vmstart || address > vmstart+vmsize-ssize ||
                    align > 14 || (skind == 1 && align > 4) || rcount > 1048576) { return 0; }
                if (address%ms_pow2(align as i32) != 0 || (skind == 1 && ssize%4 != 0)) { return 0; }
                if (zero == 0) {
                    if (offset < fileoff || ssize > fileoff+filesize-offset ||
                        ms_range(ranges,bytes,offset,ssize) == 0) { return 0; }
                } else if (rcount != 0) { return 0; }
                if (ms_range(ranges,bytes,roff,rcount*8) == 0) { return 0; }
                let prior: i32 = 0;
                while (prior < object.*.sections.len) {
                    let other: MsSection = object.*.sections.data[prior];
                    if (skind != 0 && other.kind != 0 && ssize > 0 && other.size > 0 &&
                        address < other.address+(other.size as i64) && other.address < address+ssize) { return 0; }
                    prior = prior+1;
                }
                push[MsSection](&object.*.sections,MsSection{.name=name,.kind=skind,.address=address,
                    .size=ssize as i32,.offset=offset as i32,.alignment=align as i32,.zero=zero,
                    .relocations=roff as i32,.count=rcount as i32});
                section = section+1;
            }
        } else if (kind == 2) {
            if (size != 24 || symbol_at >= 0) { return 0; }
            symbol_at = mdep_uint(bytes,at+8,4,0); symbol_count = mdep_uint(bytes,at+12,4,0);
            strings_at = mdep_uint(bytes,at+16,4,0); strings_size = mdep_uint(bytes,at+20,4,0);
            if (symbol_count > 1048576 || ms_range(ranges,bytes,symbol_at,symbol_count*16) == 0 ||
                ms_range(ranges,bytes,strings_at,strings_size) == 0) { return 0; }
        } else if (kind == 0x32) {
            if (size < 24 || platform != 0 || mdep_uint(bytes,at+8,4,0) != 1 ||
                size != 24+mdep_uint(bytes,at+20,4,0)*8) { return 0; }
            platform = 1;
        } else if (kind == 0x24) {
            if (size != 16 || platform != 0) { return 0; } platform = 1;
        } else if (kind == 0xb) {
            if (size != 80) { return 0; }
            let field: i32 = at+32;
            while (field < at+80) { if (mdep_uint(bytes,field,4,0) != 0) { return 0; } field = field+4; }
        } else if (kind == 0x1b) { if (size != 24) { return 0; } }
        else if (kind == 0x29 || kind == 0x2e) {
            if (size != 16 || ms_range(ranges,bytes,mdep_uint(bytes,at+8,4,0),mdep_uint(bytes,at+12,4,0)) == 0) { return 0; }
        } else { return 0; }
        at = at+(size as i32); command = command+1;
    }
    if ((at as i64) != 32+command_bytes || platform != 1 || segment_count != 1 || symbol_at < 0) { return 0; }
    object.*.error = "unsupported or malformed object symbol";
    let symbol: i32 = 0;
    while ((symbol as i64) < symbol_count) {
        at = (symbol_at as i32)+symbol*16;
        let str: i64 = mdep_uint(bytes,at,4,0); let type: i32 = bytes[at+4] as i32;
        let section: i32 = bytes[at+5] as i32; let desc: i64 = mdep_uint(bytes,at+6,2,0);
        let value: i64 = mdep_uint(bytes,at+8,8,0); let name: []u8 = "";
        let weak_ref: i32 = ((desc & 0x40) != 0) as i32;
        let weak_def: i32 = ((desc & 0x80) != 0) as i32;
        let common_size: i64 = 0; let common_align: i32 = 0;
        if (str >= strings_size) { return 0; }
        let end: i32 = mdep_end_string(bytes,(strings_at+str) as i32,(strings_at+strings_size) as i32);
        if (end < 0) { return 0; } name = bytes[(strings_at+str) as i32..end];
        if ((type & 0xe0) != 0) { section = -1; }
        else {
            if (name.len == 0 || name.len > 65535) { return 0; }
            if ((type & 0xe) == 0) {
                if ((type & 1) == 0 || section != 0 || weak_def == 1) { return 0; }
                if (value > 0) {
                    common_size = value;
                    let exponent: i32 = ((desc/256) & 15) as i32;
                    if (exponent > 14) { return 0; }
                    if (exponent > 0) { common_align = ms_pow2(exponent) as i32; }
                    else {
                        common_align = 1;
                        while ((common_align as i64) < common_size && common_align < 16) { common_align=common_align*2; }
                    }
                }
            } else if ((type & 0xe) == 0xe) {
                if ((desc & 0x0300) != 0 || weak_ref == 1) { return 0; }
                if (section < 1 || section > object.*.sections.len) { return 0; }
                let target: MsSection = object.*.sections.data[section-1];
                if (value < target.address || value > target.address+(target.size as i64)) { return 0; }
                value = value-target.address;
                if (target.kind == 0) { section = -1; }
            } else { return 0; }
        }
        push[MsSymbol](&object.*.symbols,MsSymbol{.name=name,.section=section,.value=value,
            .external=type & 1,.hidden=(type & 16)/16,.weak_ref=weak_ref,.weak_def=weak_def,
            .common_size=common_size,.common_align=common_align});
        symbol = symbol+1;
    }
    object.*.error = "unsupported or malformed object relocation";
    let section: i32 = 0;
    while (section < object.*.sections.len) {
        let sec: MsSection = object.*.sections.data[section]; let r: i32 = 0;
        while (sec.kind != 0 && r < sec.count) {
            at = sec.relocations+r*8; let address: i64 = mdep_uint(bytes,at,4,0);
            let bits: i64 = mdep_uint(bytes,at+4,4,0); let kind: i32 = (bits/268435456) as i32;
            let extra: i64 = 0; let subtract: i32 = -1;
            if (kind == 10 || kind == 1) {
                if (kind == 10) {
                    if (((bits/16777216) & 15) != 4) { return 0; }
                    extra = bits & 0xffffff; if (extra >= 0x800000) { extra = extra-0x1000000; }
                } else {
                    if (((bits/16777216) & 9) != 8) { return 0; }
                    subtract = (bits & 0xffffff) as i32;
                    if (subtract >= object.*.symbols.len || object.*.symbols.data[subtract].section < 0) { return 0; }
                }
                r = r+1; at = sec.relocations+r*8;
                if (r >= sec.count || mdep_uint(bytes,at,4,0) != address) { return 0; }
                let next: i64 = mdep_uint(bytes,at+4,4,0); let next_kind: i32 = (next/268435456) as i32;
                if (kind == 10 && next_kind != 2 && next_kind != 3 && next_kind != 4) { return 0; }
                if (kind == 1 && (next_kind != 0 || ((bits/33554432) & 3) != ((next/33554432) & 3))) { return 0; }
                bits = next; kind = next_kind;
            }
            let width: i32 = ms_pow2(((bits/33554432) & 3) as i32) as i32;
            let relative: i32 = ((bits/16777216) & 1) as i32;
            let external: i32 = ((bits/134217728) & 1) as i32;
            let target: i32 = (bits & 0xffffff) as i32;
            if (address > ((sec.size-width) as i64) || address < 0 || address%(width as i64) != 0 || sec.zero == 1) { return 0; }
            if (kind != 0 && kind != 2 && kind != 3 && kind != 4 && kind != 5 && kind != 6 &&
                kind != 7 && kind != 8 && kind != 9) { return 0; }
            if (kind == 0 && (relative != 0 || (width != 8 && subtract < 0))) { return 0; }
            if ((kind == 2 || kind == 3 || kind == 5 || kind == 8) &&
                (relative != 1 || width != 4 || sec.kind != 1)) { return 0; }
            if ((kind == 4 || kind == 6 || kind == 9) &&
                (relative != 0 || width != 4 || sec.kind != 1)) { return 0; }
            if (kind == 7 && !((relative == 1 && width == 4) || (relative == 0 && width == 8))) { return 0; }
            if ((kind == 8 || kind == 9) && external != 1) { return 0; }
            if (external == 1) {
                if (target >= object.*.symbols.len || object.*.symbols.data[target].section < 0) { return 0; }
            } else {
                if (target < 1 || target > object.*.sections.len || object.*.sections.data[target-1].kind == 0) { return 0; }
                if (kind != 0) { return 0; }
            }
            if (kind == 0) { extra = ms_signed(bytes,sec.offset+(address as i32),width); }
            push[MsReloc](&object.*.relocations,MsReloc{.section=section,.offset=address as i32,.target=target,
                .external=external,.kind=kind,.width=width,.addend=extra,.subtract=subtract});
            r = r+1;
        }
        section = section+1;
    }
    object.*.error = ""; return 1;
}
fn ms_read_object(input: []u8) MsObject {
    let bytes: []u8 = mdep_arm64_slice(input); let object: MsObject = ms_object_empty(bytes);
    let ranges: ArrayList[MsRange] = make[MsRange](16);
    object.valid = ms_read_object_inner(bytes,&object,&ranges);
    free[MsRange](&ranges); return object;
}

fn ms_decimal(bytes: []u8, begin: i32, end: i32) i64 {
    let value: i64 = 0; let digits: i32 = 0; let padding: i32 = 0;
    while (begin < end) {
        let ch: u8 = bytes[begin];
        if (ch == 32) { padding = 1; }
        else {
            if (padding == 1 || ch < '0' || ch > '9' || value > 214748364) { return -1; }
            value = value*10+(ch as i64)-48; digits = digits+1;
        }
        begin = begin+1;
    }
    if (digits == 0 || value > 2147483647) { return -1; } return value;
}
fn ms_archive_inner(bytes: []u8, result: *MsArchive) i32 {
    if (bytes.len < 8 || bytes.len > 67108864 || !@strEq(bytes[0..8],"!<arch>\n")) { return 0; }
    let at: i32 = 8; let names: []u8 = "";
    while (at < bytes.len) {
        result.*.error = "malformed archive member header";
        if (mdep_range(bytes,at as i64,60) == 0 || bytes[at+58] != 96 || bytes[at+59] != 10) { return 0; }
        let size: i64 = ms_decimal(bytes,at+48,at+58);
        if (ms_range_dummy(bytes,(at as i64)+60,size) == 0) { return 0; }
        let end: i32 = at+16; while (end > at && bytes[end-1] == 32) { end = end-1; }
        let name: []u8 = bytes[at..end]; let body: i32 = at+60; let body_end: i32 = body+(size as i32);
        if (name.len >= 3 && @strEq(name[0..3],"#1/")) {
            let length: i64 = ms_decimal(name,3,name.len);
            if (length <= 0 || length > size) { return 0; }
            let name_end: i32 = body+(length as i32);
            end = body; while (end < name_end && bytes[end] != 0) { end = end+1; }
            name = bytes[body..end]; body = name_end;
        } else if (name.len > 1 && name[0] == '/' && name[1] >= '0' && name[1] <= '9') {
            let start: i64 = ms_decimal(name,1,name.len);
            if (start < 0 || start >= (names.len as i64)) { return 0; }
            end = start as i32;
            while (end < names.len && names[end] != 10 && names[end] != 0) { end = end+1; }
            if (end == names.len) { return 0; }
            let finish: i32 = end; if (finish > (start as i32) && names[finish-1] == '/') { finish = finish-1; }
            name = names[start as i32..finish];
        } else if (name.len > 1 && name[name.len-1] == '/' && !@strEq(name,"//") && !@strEq(name,"/SYM64/")) {
            name = name[0..name.len-1];
        }
        if (name.len == 0) { return 0; }
        if (@strEq(name,"//")) {
            if (names.len > 0) { return 0; } names = bytes[body..body_end];
        } else if (@strEq(name,"/") || @strEq(name,"/SYM64/") || @strEq(name,"__.SYMDEF") ||
            @strEq(name,"__.SYMDEF SORTED") || @strEq(name,"__.SYMDEF_64") || @strEq(name,"__.SYMDEF_64 SORTED")) {
        } else {
            if (result.*.members.len >= 65536) { return 0; }
            push[MsArchiveMember](&result.*.members,MsArchiveMember{.name=name,.bytes=bytes[body..body_end]});
        }
        at = body_end;
        if (size%2 != 0) { if (at >= bytes.len || bytes[at] != 10) { return 0; } at = at+1; }
    }
    result.*.error = ""; return 1;
}
fn ms_range_dummy(bytes: []u8, at: i64, size: i64) i32 { return mdep_range(bytes,at,size); }
fn ms_read_archive(input: []u8) MsArchive {
    let result: MsArchive = MsArchive{.members=make[MsArchiveMember](8),.valid=0,.error="invalid native archive"};
    let bytes: []u8 = input; if (input.len >= 32) { bytes = mdep_arm64_slice(input); }
    result.valid = ms_archive_inner(bytes,&result); return result;
}
