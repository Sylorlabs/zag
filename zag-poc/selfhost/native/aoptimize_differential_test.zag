// Bounded semantic differential for the AArch64 expression-stack optimizer.
// Runs actual aoptimize() output against its input on a small register-machine
// model. Memory aliasing is covered separately by rejection tests and SMT.
@import("aisa.zag")
@import("aarch64.zag")
@import("aoptimize.zag")

fn adi(k: i32, d: i32, s: i32, imm: i64) AInstr {
    return AInstr{ .kind = k, .dst = d, .src = s, .imm = imm, .disp = 0, .lbl = 0 };
}

// NZCV for this bounded domain: operands are nonnegative except for the
// immediate -2, and subtraction never overflows. For -2 the unsigned carry
// flag is clear even though the signed lhs is greater than the rhs.
fn ad_cmp(regs: *ArrayList[i64], a: i64, b: i64) void {
    let flags: i64 = 0;
    if (a < b) { flags = flags + 8; }
    if (a == b) { flags = flags + 4; }
    if (b >= 0 && a >= b) { flags = flags + 2; }
    set[i64](regs, 32, flags);
}

fn ad_exec(prog: ArrayList[AInstr], seed: i32) ArrayList[i64] {
    let regs: ArrayList[i64] = make[i64](33);
    let stack: ArrayList[i64] = make[i64](8);
    let r: i32 = 0;
    while (r < 33) {
        push[i64](&regs, (seed * 17 + r * 3 + 13) as i64);
        r = r + 1;
    }
    set[i64](&regs, A_X28(), 4096);
    set[i64](&regs, 32, 0);
    let i: i32 = 0;
    while (i < len[AInstr](prog)) {
        let ins: AInstr = get[AInstr](prog, i);
        let k: i32 = ins.kind;
        let d: i32 = ins.dst;
        let s: i32 = ins.src;
        if (k == AK_MOV_IMM()) {
            set[i64](&regs, d, ins.imm);
        } else { if (k == AK_MOV_RR()) {
            set[i64](&regs, d, get[i64](regs, s));
        } else { if (k == AK_ADD_RR()) {
            set[i64](&regs, d, get[i64](regs, d) + get[i64](regs, s));
        } else { if (k == AK_SUB_RR()) {
            set[i64](&regs, d, get[i64](regs, d) - get[i64](regs, s));
        } else { if (k == AK_ADD_IMM()) {
            set[i64](&regs, d, get[i64](regs, d) + ins.imm);
        } else { if (k == AK_SUB_IMM()) {
            set[i64](&regs, d, get[i64](regs, d) - ins.imm);
        } else { if (k == AK_CMP_RR()) {
            ad_cmp(&regs, get[i64](regs, d), get[i64](regs, s));
        } else { if (k == AK_CMP_IMM()) {
            let lhs: i64 = get[i64](regs, d);
            if (ins.imm < 0 || ins.imm > 4095) {
                let scratch: i32 = A_X9();
                if (d == A_X9()) { scratch = A_X10(); }
                set[i64](&regs, scratch, ins.imm);
            }
            ad_cmp(&regs, lhs, ins.imm);
        } else { if (k == AK_PUSH()) {
            push[i64](&stack, get[i64](regs, d));
            set[i64](&regs, A_X28(), get[i64](regs, A_X28()) + 8);
        } else { if (k == AK_POP()) {
            set[i64](&regs, A_X28(), get[i64](regs, A_X28()) - 8);
            set[i64](&regs, d, pop[i64](&stack));
        } else {
            // Never silently compare a partial model if the pass emits a new
            // instruction kind; the sentinel differs from ordinary test data.
            set[i64](&regs, 32, -99999);
        } } } } } } } } } }
        i = i + 1;
    }
    if (len[i64](stack) != 0) { set[i64](&regs, 32, -88888); }
    free[i64](&stack);
    return regs;
}

fn main() i32 {
    let failures: i32 = 0;
    let cases: i32 = 0;
    let shape: i32 = 0;
    while (shape < 12) {
        let p: ArrayList[AInstr] = make[AInstr](10);
        if (shape == 8) { push[AInstr](&p, adi(AK_MOV_RR(), A_X0(), A_X7(), 0)); }
        let src: i32 = A_X0();
        if (shape == 5) { src = A_X10(); }
        if (shape == 6) { src = A_X9(); }
        push[AInstr](&p, adi(AK_PUSH(), src, 0, 0));
        if (shape == 0) {
            // Seed 0 has x3=22: exercise Z as well as C across other seeds.
            push[AInstr](&p, adi(AK_CMP_IMM(), A_X3(), 0, 22));
        } else { if (shape == 1) {
            push[AInstr](&p, adi(AK_MOV_RR(), A_X6(), A_X7(), 0));
            push[AInstr](&p, adi(AK_ADD_RR(), A_X6(), A_X8(), 0));
            push[AInstr](&p, adi(AK_CMP_RR(), A_X6(), A_X5(), 0));
        } else { if (shape == 2 || shape == 6) {
            push[AInstr](&p, adi(AK_CMP_IMM(), A_X3(), 0, 8192));
            push[AInstr](&p, adi(AK_MOV_RR(), A_X6(), A_X7(), 0));
        } else { if (shape == 3) {
            push[AInstr](&p, adi(AK_ADD_RR(), A_X0(), A_X3(), 0));
            push[AInstr](&p, adi(AK_CMP_RR(), A_X2(), A_X4(), 0));
        } else { if (shape == 4) {
            push[AInstr](&p, adi(AK_MOV_IMM(), A_X0(), 0, 11));
            push[AInstr](&p, adi(AK_CMP_IMM(), A_X3(), 0, 1));
        } else { if (shape == 5) {
            push[AInstr](&p, adi(AK_CMP_IMM(), A_X9(), 0, 8192));
        } else { if (shape == 7) {
            push[AInstr](&p, adi(AK_CMP_IMM(), A_X3(), 0, 1));
            push[AInstr](&p, adi(AK_MOV_RR(), A_X6(), A_X7(), 0));
            push[AInstr](&p, adi(AK_CMP_RR(), A_X3(), A_X5(), 0));
        } else { if (shape == 8) {
            push[AInstr](&p, adi(AK_MOV_IMM(), A_X0(), 0, 3));
            push[AInstr](&p, adi(AK_CMP_RR(), A_X3(), A_X5(), 0));
        } else { if (shape == 9) {
            push[AInstr](&p, adi(AK_PUSH(), A_X3(), 0, 0));
            push[AInstr](&p, adi(AK_POP(), A_X4(), 0, 0));
        } else { if (shape == 10) {
            push[AInstr](&p, adi(AK_MOV_IMM(), A_X9(), 0, 555));
            push[AInstr](&p, adi(AK_CMP_IMM(), A_X9(), 0, 8192));
        } else {
            push[AInstr](&p, adi(AK_CMP_IMM(), A_X3(), 0, -2));
        } } } } } } } } } }
        let dest: i32 = A_X2();
        if (shape == 7) { dest = A_X0(); }
        push[AInstr](&p, adi(AK_POP(), dest, 0, 0));
        let o: ArrayList[AInstr] = aoptimize(p);
        // Guard against a vacuous differential: the selected register-only
        // gaps MUST eliminate stack transfers, while source clobbers and
        // nested transfers MUST keep an outer stack pair.
        let remaining_pushes: i32 = 0;
        let remaining_pops: i32 = 0;
        let op_idx: i32 = 0;
        while (op_idx < len[AInstr](o)) {
            let op: AInstr = get[AInstr](o, op_idx);
            if (op.kind == AK_PUSH()) { remaining_pushes = remaining_pushes + 1; }
            if (op.kind == AK_POP()) { remaining_pops = remaining_pops + 1; }
            op_idx = op_idx + 1;
        }
        let eliminates: i32 = 0;
        if (shape == 0 || shape == 1 || shape == 2 || shape == 7 ||
            shape == 10 || shape == 11) { eliminates = 1; }
        let retains: i32 = 0;
        if (shape == 3 || shape == 4 || shape == 5 || shape == 6 || shape == 9) {
            retains = 1;
        }
        if ((eliminates == 1 && (remaining_pushes != 0 || remaining_pops != 0)) ||
            (retains == 1 && (remaining_pushes == 0 || remaining_pops == 0))) {
            failures = failures + 1;
            _zag_print("aopt differential unexpected rewrite shape=");
            _zag_print(_zag_i64_to_str(shape as i64));
            _zag_print("\n");
        }
        let seed: i32 = 0;
        while (seed < 64) {
            let before: ArrayList[i64] = ad_exec(p, seed);
            let after: ArrayList[i64] = ad_exec(o, seed);
            let reg: i32 = 0;
            while (reg < 33) {
                if (get[i64](before, reg) != get[i64](after, reg)) {
                    failures = failures + 1;
                    _zag_print("aopt differential mismatch shape=");
                    _zag_print(_zag_i64_to_str(shape as i64));
                    _zag_print(" seed=");
                    _zag_print(_zag_i64_to_str(seed as i64));
                    _zag_print(" reg=");
                    _zag_print(_zag_i64_to_str(reg as i64));
                    _zag_print("\n");
                }
                reg = reg + 1;
            }
            free[i64](&before);
            free[i64](&after);
            cases = cases + 1;
            seed = seed + 1;
        }
        free[AInstr](&p);
        free[AInstr](&o);
        shape = shape + 1;
    }
    _zag_print("aopt differential: cases=");
    _zag_print(_zag_i64_to_str(cases as i64));
    _zag_print(" failures=");
    _zag_print(_zag_i64_to_str(failures as i64));
    _zag_print("\n");
    if (failures != 0) { return 1; }
    return 0;
}
