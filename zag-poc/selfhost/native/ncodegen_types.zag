// selfhost/native/ncodegen_types.zag — TYPE UTILITIES for the native codegen.
// Pure predicate and normalization helpers with NO dependencies on the Cg struct
// or other codegen functions. Extracted from ncodegen.zag for modularity.
//
// Contains: type predicates (float/posit/sat/fixed/arb/rns/quire/numeric),
// literal text classifiers (hex/int/float), string helpers (prefix/digits/uint),
// generic type-arg mangling, type substitution, and canonical type normalization.

@import("isa.zag")
@import("../parse.zag")   // AST (Node/Param/Bin/Call/FnDecl/...) + ArrayList + @strEq + is_generic_app + index_of + split_args

// True when s (past an optional sign) begins with a 0x / 0X hex prefix.
fn cg_is_hex_text(s: []u8) i32 {
    let i: i32 = 0;
    if (s.len > 0 && (s[0] == '-' || s[0] == '+')) { i = 1; }
    if (i + 1 < s.len && s[i] == '0' && (s[i + 1] == 'x' || s[i + 1] == 'X')) { return 1; }
    return 0;
}

// True only for a plain decimal integer literal (optional sign, digits, '_').
// Floats ("1.5"), hex, etc. -> 0, so codegen rejects them loudly instead of
// silently truncating (cg_parse_i64 would drop the '.' and mis-read the digits).
fn cg_is_int_text(s: []u8) i32 {
    let i: i32 = 0;
    if (s.len > 0) {
        if (s[0] == '-') { i = 1; }
        else if (s[0] == '+') { i = 1; }
    }
    if (i >= s.len) { return 0; }
    // hex literal: 0x followed by at least one hex digit / '_'
    if (i + 1 < s.len && s[i] == '0' && (s[i + 1] == 'x' || s[i + 1] == 'X')) {
        let h: i32 = i + 2;
        if (h >= s.len) { return 0; }
        while (h < s.len) {
            let c: u8 = s[h];
            let ok: bool = (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F') || c == '_';
            if (!ok) { return 0; }
            h = h + 1;
        }
        return 1;
    }
    while (i < s.len) {
        let c: u8 = s[i];
        if (c == '_') { i = i + 1; }
        else {
            if (c < 48) { return 0; }
            if (c > 57) { return 0; }
            i = i + 1;
        }
    }
    return 1;
}

// True iff `t` names a float type (f64 or f32 — treated identically internally).
fn cg_is_float_ty(t: []u8) i32 {
    if (@strEq(t, "f64")) { return 1; }
    if (@strEq(t, "f32")) { return 1; }
    return 0;
}

// ── posit type recognition (heterogeneous numeric system, native backend) ─────
// A posit VALUE is its bit pattern carried in a 64-bit scalar slot (like every
// other scalar); the bit WIDTH (p8→8 … p64→64) only matters inside the Zag posit
// runtime (selfhost/native/numeric_rt.zag), which znc compiles to native code.
// We recognize the type NAME so binary ops / builtins lower to runtime CALLS.
fn cg_is_posit_ty(t: []u8) i32 {
    if (@strEq(t, "p8"))  { return 1; }
    if (@strEq(t, "p16")) { return 1; }
    if (@strEq(t, "p32")) { return 1; }
    if (@strEq(t, "p64")) { return 1; }
    return 0;
}

// t starts with prefix p?
fn cg_str_prefix(t: []u8, p: []u8) i32 {
    if (t.len < p.len) { return 0; }
    let i: i32 = 0;
    while (i < p.len) {
        if (t[i] != p[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}
// every byte in t[lo..hi) is an ASCII digit (and the range is non-empty)?
fn cg_all_digits(t: []u8, lo: i32, hi: i32) i32 {
    if (lo >= hi) { return 0; }
    let i: i32 = lo;
    while (i < hi) {
        let c: i32 = t[i] as i32;
        if (c < 48) { return 0; }
        if (c > 57) { return 0; }
        i = i + 1;
    }
    return 1;
}
// decimal value of t[lo..hi) (assumes digits; 0 on empty).
fn cg_parse_uint(t: []u8, lo: i32, hi: i32) i64 {
    let v: i64 = 0;
    let i: i32 = lo;
    while (i < hi) {
        v = v * 10 + ((t[i] as i64) - 48);
        i = i + 1;
    }
    return v;
}

// Saturating sat_i8/16/32/64 | sat_u8/16/32/64.
fn cg_is_sat_ty(t: []u8) i32 {
    if (cg_str_prefix(t, "sat_") == 0) { return 0; }
    let b: []u8 = t[4..];
    if (@strEq(b, "i8") || @strEq(b, "i16") || @strEq(b, "i32") || @strEq(b, "i64")) { return 1; }
    if (@strEq(b, "u8") || @strEq(b, "u16") || @strEq(b, "u32") || @strEq(b, "u64")) { return 1; }
    return 0;
}

// Fixed-point fixed_<I>_<F>, I and F runs of digits.
fn cg_is_fixed_ty(t: []u8) i32 {
    if (cg_str_prefix(t, "fixed_") == 0) { return 0; }
    let us: i32 = 6;
    while (us < t.len) {
        if ((t[us] as i32) == 95) {                 // '_'
            if (cg_all_digits(t, 6, us) == 0) { return 0; }
            if (cg_all_digits(t, us + 1, t.len) == 0) { return 0; }
            return 1;
        }
        us = us + 1;
    }
    return 0;
}

// Arbitrary-width uN/iN, 1<=N<=127, EXCLUDING the standard widths 8/16/32/64.
fn cg_is_arb_int_ty(t: []u8) i32 {
    if (t.len < 2) { return 0; }
    let c0: i32 = t[0] as i32;
    if (c0 != 117 && c0 != 105) { return 0; }       // 'u' / 'i'
    if (cg_all_digits(t, 1, t.len) == 0) { return 0; }
    let n: i64 = cg_parse_uint(t, 1, t.len);
    if (n < 1) { return 0; }
    if (n > 127) { return 0; }
    if (n == 8 || n == 16 || n == 32 || n == 64) { return 0; }
    return 1;
}

// Any heterogeneous numeric SCALAR that needs special op lowering (NOT posit —
// that has its own path). sat / fixed / arb-width.
fn cg_is_satfixarb_ty(t: []u8) i32 {
    if (cg_is_sat_ty(t) == 1) { return 1; }
    if (cg_is_fixed_ty(t) == 1) { return 1; }
    if (cg_is_arb_int_ty(t) == 1) { return 1; }
    return 0;
}

// ── ROUND 3: RNS (rns_3) and the 512-bit quire — both AGGREGATES ─────────────
// We accept either the user-facing name (rns_3 / quire) OR the normalized struct
// name (ZnrtRns / ZnrtQuire), so the checks work before and after cg_norm_type.
fn cg_is_rns_ty(t: []u8) i32 {
    if (@strEq(t, "rns_3")) { return 1; }
    if (@strEq(t, "ZnrtRns")) { return 1; }
    return 0;
}
fn cg_is_quire_ty(t: []u8) i32 {
    if (@strEq(t, "quire")) { return 1; }
    if (@strEq(t, "ZnrtQuire")) { return 1; }
    return 0;
}

// True iff `t` (after one optional leading '*') is a sat/fixed/arb-width or posit
// SCALAR — i.e. any value the round-1/round-2 numeric runtime understands.
fn cg_ty_is_numeric(t: []u8) i32 {
    let s: []u8 = t;
    if (s.len > 1) { if (s[0] == '*') { s = s[1..]; } }
    if (cg_is_posit_ty(s) == 1) { return 1; }
    if (cg_is_satfixarb_ty(s) == 1) { return 1; }
    return 0;
}

// True iff `s` is decimal FLOAT text: digits with exactly the float shape — at
// least one '.' OR an exponent marker, only digits / '.' / 'e' / 'E' / sign /
// '_'. Rejects hex ("0xff") and garbage so they are caught loudly (NOT parsed as
// a bogus float). A plain integer ("42") returns 0 (handled by the int path).
fn cg_is_float_text(s: []u8) i32 {
    let i: i32 = 0;
    if (s.len > 0) {
        if (s[0] == '-') { i = 1; }
        else if (s[0] == '+') { i = 1; }
    }
    if (i >= s.len) { return 0; }
    let dots: i32 = 0;
    let exps: i32 = 0;
    let digits: i32 = 0;
    while (i < s.len) {
        let c: u8 = s[i];
        if (c == '_') { i = i + 1; }
        else if (c == '.') { dots = dots + 1; i = i + 1; }
        else if (c == 'e' || c == 'E') {
            exps = exps + 1;
            i = i + 1;
            if (i < s.len) { if (s[i] == '-' || s[i] == '+') { i = i + 1; } }
        }
        else if (c >= 48 && c <= 57) { digits = digits + 1; i = i + 1; }
        else { return 0; }    // any other char → not a clean float
    }
    if (digits == 0) { return 0; }
    if (dots > 1) { return 0; }
    if (exps > 1) { return 0; }
    if (dots == 0 && exps == 0) { return 0; }   // an integer, not a float
    return 1;
}

// Sanitize one type arg into an identifier fragment (* → p, [] → _, drop ]).
fn cg_mangle_targ(t: []u8) []u8 {
    let buf: ArrayList[u8] = make[u8](8);
    let i: i32 = 0;
    while (i < t.len) {
        let c: i32 = t[i] as i32;
        if (c == '*') { push[u8](&buf, 'p'); }
        else if (c == '[') { push[u8](&buf, '_'); }
        else if (c == ']') { }
        else if (c == ',') { push[u8](&buf, '_'); }
        else { push[u8](&buf, t[i]); }
        i = i + 1;
    }
    return buf.data[0..buf.len];
}

// name + "_" + each sanitized targ, e.g. ("id", ["i32"]) → "id_i32".
fn cg_mangle_generic(name: []u8, targs: ArrayList[[]u8]) []u8 {
    let s: []u8 = name;
    let i: i32 = 0;
    while (i < len[[]u8](targs)) {
        s = _zag_str_concat(s, "_");
        s = _zag_str_concat(s, cg_mangle_targ(get[[]u8](targs, i)));
        i = i + 1;
    }
    return s;
}

// Normalize each type-arg (recursively for nested generic apps like
// ArrayList[i32]) then mangle. Keeps instance names and call-site symbols
// aligned when compound types are used as generic arguments.
fn cg_norm_targs(targs: ArrayList[[]u8]) ArrayList[[]u8] {
    let out: ArrayList[[]u8] = make[[]u8](len[[]u8](targs) + 1);
    let i: i32 = 0;
    while (i < len[[]u8](targs)) {
        push[[]u8](&out, cg_norm_type(get[[]u8](targs, i)));
        i = i + 1;
    }
    return out;
}
fn cg_mangle_generic_norm(name: []u8, targs: ArrayList[[]u8]) []u8 {
    return cg_mangle_generic(name, cg_norm_targs(targs));
}

// Substitute generic type-params (names) with concrete args (vals) in a type
// string, honouring *, ?, !, [] prefixes and generic applications Base[args].
fn cg_subst_type(t: []u8, names: ArrayList[[]u8], vals: ArrayList[[]u8]) []u8 {
    let i: i32 = 0;
    while (i < len[[]u8](names)) {
        if (@strEq(t, get[[]u8](names, i))) { return get[[]u8](vals, i); }
        i = i + 1;
    }
    if (t.len > 1) {
        if (t[0] == '*') { return _zag_str_concat("*", cg_subst_type(t[1..], names, vals)); }
        if (t[0] == '?') { return _zag_str_concat("?", cg_subst_type(t[1..], names, vals)); }
        if (t[0] == '!') { return _zag_str_concat("!", cg_subst_type(t[1..], names, vals)); }
    }
    if (t.len > 2) {
        if (t[0] == '[' && t[1] == ']') { return _zag_str_concat("[]", cg_subst_type(t[2..], names, vals)); }
    }
    if (is_generic_app(t)) {
        let lb: i32 = index_of(t, '[');
        let base: []u8 = t[0..lb];
        let arglist: ArrayList[[]u8] = split_args(t[lb + 1..t.len - 1]);
        let s: []u8 = _zag_str_concat(base, "[");
        let k: i32 = 0;
        while (k < len[[]u8](arglist)) {
            if (k > 0) { s = _zag_str_concat(s, ","); }
            s = _zag_str_concat(s, cg_subst_type(get[[]u8](arglist, k), names, vals));
            k = k + 1;
        }
        return _zag_str_concat(s, "]");
    }
    return t;
}

// CANONICALIZE a type string for the native backend: a generic application
// Base[args] → its mangled concrete name Base_args (recursively normalising the
// args), and a `*Base[args]` → `*Base_args`, etc. After expansion every concrete
// struct instance is registered under this mangled name, so normalizing here lets
// the layout / type-tracking machinery key on it uniformly. Plain types (i32,
// "P", "[]u8", "*T") pass through unchanged.
fn cg_norm_type(t: []u8) []u8 {
    if (t.len > 1) {
        if (t[0] == '*') { return _zag_str_concat("*", cg_norm_type(t[1..])); }
    }
    // ROUND 3 numeric AGGREGATES: the user-facing `rns_3` / `quire` names map to
    // the runtime structs ZnrtRns / ZnrtQuire (declared in numeric_rt.zag). After
    // this rewrite the existing by-value struct machinery sizes/passes/field-
    // accesses them with NO special cases.
    if (@strEq(t, "rns_3")) { return "ZnrtRns"; }
    if (@strEq(t, "quire")) { return "ZnrtQuire"; }
    if (@strEq(t, "bool")) { return "i32"; }
    if (is_generic_app(t)) {
        let lb: i32 = index_of(t, '[');
        let base: []u8 = t[0..lb];
        let arglist: ArrayList[[]u8] = split_args(t[lb + 1..t.len - 1]);
        // normalise each arg too (nested generic args), then mangle.
        let norm: ArrayList[[]u8] = make[[]u8](2);
        let k: i32 = 0;
        while (k < len[[]u8](arglist)) {
            push[[]u8](&norm, cg_norm_type(get[[]u8](arglist, k)));
            k = k + 1;
        }
        return cg_mangle_generic(base, norm);
    }
    return t;
}

// Substitute a list of type-args (targs) using type-params (tp) → type-args (ta).
fn cg_subst_targs(targs: ArrayList[[]u8], tp: ArrayList[[]u8], ta: ArrayList[[]u8]) ArrayList[[]u8] {
    let out: ArrayList[[]u8] = make[[]u8](2);
    let i: i32 = 0;
    while (i < len[[]u8](targs)) {
        push[[]u8](&out, cg_subst_type(get[[]u8](targs, i), tp, ta));
        i = i + 1;
    }
    return out;
}
