// Focused behavioral checks for the two test-only ZIR folders. This module
// deliberately does not make zopt eligible for production lowering.
@import("../zir.zag")
@import("zopt.zag")

fn sd_expect(yes: bool, why: []u8, fails: *i32) void {
    if (!yes) { _zag_eprintln(why); fails.* = fails.* + 1; }
}

fn sd_value(name: []u8) ZVal { return ZVal{.name=name,.ty="i64"}; }

fn sd_const(name: []u8, text: []u8) ZOp {
    let o: ZOp = mk_op("arith.constant");
    push[ZVal](&o.results, sd_value(name));
    push[ZAttr](&o.attrs, ZAttr{.key="value",.val=text});
    return o;
}

fn sd_case(opname: []u8, numerator: []u8, denominator: []u8) ZModule {
    let blk: ZBlock = one_block();
    push[ZOp](&blk.ops, sd_const("%n", numerator));
    push[ZOp](&blk.ops, sd_const("%d", denominator));
    let div: ZOp = mk_op(opname);
    push[ZVal](&div.results, sd_value("%out"));
    push[ZVal](&div.operands, sd_value("%n"));
    push[ZVal](&div.operands, sd_value("%d"));
    push[ZOp](&blk.ops, div);
    let ret: ZOp = mk_op("func.return");
    push[ZVal](&ret.operands, sd_value("%out"));
    push[ZOp](&blk.ops, ret);
    let module: ZModule = ZModule{.funcs=make[ZFunc](1)};
    push[ZFunc](&module.funcs, ZFunc{.name="constant_divmod",.params=make[ZVal](1),.ret="i64",.body=blk});
    return module;
}

fn sd_result(m: ZModule) ZOp {
    let f: ZFunc = get[ZFunc](m.funcs, 0);
    return get[ZOp](f.body.ops, 2);
}

// Keep the dividend unknown so the simplifier, rather than the constant
// folder, must establish these algebraic identities.
fn sd_variable_case(opname: []u8, denominator: []u8) ZModule {
    let blk: ZBlock = one_block();
    push[ZOp](&blk.ops, sd_const("%d", denominator));
    let op: ZOp = mk_op(opname);
    push[ZVal](&op.results, sd_value("%out"));
    push[ZVal](&op.operands, sd_value("%x"));
    push[ZVal](&op.operands, sd_value("%d"));
    push[ZOp](&blk.ops, op);
    let ret: ZOp = mk_op("func.return");
    push[ZVal](&ret.operands, sd_value("%out"));
    push[ZOp](&blk.ops, ret);
    let module: ZModule = ZModule{.funcs=make[ZFunc](1)};
    let params: ArrayList[ZVal] = make[ZVal](1);
    push[ZVal](&params, sd_value("%x"));
    push[ZFunc](&module.funcs, ZFunc{.name="variable_divmod",.params=params,.ret="i64",.body=blk});
    return module;
}

fn sd_assert_simplify(opname: []u8, denominator: []u8, expected_constant: i32,
                      fails: *i32) void {
    let result: ZModule = opt_simplify(sd_variable_case(opname, denominator));
    let f: ZFunc = get[ZFunc](result.funcs, 0);
    let rewritten: ZOp = get[ZOp](f.body.ops, 1);
    if (expected_constant == 1) {
        sd_expect(@strEq(rewritten.name,"arith.constant") &&
                  @strEq(opt_attr_val(rewritten,"value"),"0"),
                  "x % +/-1 did not simplify to a zero constant",fails);
    } else {
        sd_expect(@strEq(rewritten.name,opname),
                  "potentially trapping variable division was simplified",fails);
    }
}

fn sd_assert_fold(m: ZModule, op: []u8, folded: i32, answer: []u8, fails: *i32) void {
    let old: ZOp = sd_result(m);
    let a: ZOp = sd_result(fold_module(m));
    let b: ZOp = sd_result(opt_fold(m));
    if (folded == 1) {
        sd_expect(@strEq(a.name,"arith.constant") && @strEq(opt_attr_val(a,"value"),answer),
                  "zir fold_module produced incorrect signed constant",fails);
        sd_expect(@strEq(b.name,"arith.constant") && @strEq(opt_attr_val(b,"value"),answer),
                  "zopt opt_fold produced incorrect signed constant",fails);
    } else {
        sd_expect(@strEq(a.name,op) && @strEq(old.name,op),
                  "zir fold_module removed a potentially trapping division",fails);
        sd_expect(@strEq(b.name,op),
                  "zopt opt_fold removed a potentially trapping division",fails);
    }
}


// A dead SSA result does not make a trapping divide/remainder removable.
fn sd_dead_case(opname: []u8, numerator: []u8, denominator: []u8) ZModule {
    let m: ZModule = sd_case(opname, numerator, denominator);
    let f: ZFunc = get[ZFunc](m.funcs, 0);
    let fixed: ZBlock = one_block();
    let i: i32 = 0;
    while (i < 3) {
        push[ZOp](&fixed.ops, get[ZOp](f.body.ops, i));
        i = i + 1;
    }
    push[ZOp](&fixed.ops, sd_const("%answer", "7"));
    let ret: ZOp = mk_op("func.return");
    push[ZVal](&ret.operands, sd_value("%answer"));
    push[ZOp](&fixed.ops, ret);
    let out: ZModule = ZModule{.funcs=make[ZFunc](1)};
    push[ZFunc](&out.funcs, ZFunc{.name=f.name,.params=f.params,.ret=f.ret,.body=fixed});
    return out;
}

fn sd_has_op(m: ZModule, opname: []u8) bool {
    let f: ZFunc = get[ZFunc](m.funcs, 0);
    let i: i32 = 0;
    while (i < len[ZOp](f.body.ops)) {
        if (@strEq(get[ZOp](f.body.ops, i).name, opname)) { return true; }
        i = i + 1;
    }
    return false;
}

fn sd_assert_dead_trap(opname: []u8, numerator: []u8, denominator: []u8,
                       fails: *i32) void {
    let m: ZModule = sd_dead_case(opname, numerator, denominator);
    sd_expect(sd_has_op(opt_dce(m), opname),
              "DCE removed dead trapping integer operation", fails);
    sd_expect(sd_has_op(opt_all(m), opname),
              "opt_all removed dead trapping integer operation", fails);
}

fn main() i32 {
    let failures: i32 = 0;
    let min: i64 = (0 - 9223372036854775807) - 1;
    let ok: i32 = 0;
    let q: i64 = opt_eval_int("arith.divsi", min, -1, &ok);
    sd_expect(ok == 0 && q == 0,"zopt must refuse signed division overflow",&failures);
    q = apply_int_op("arith.divsi",min,-1,&ok);
    sd_expect(ok == 0 && q == 0,"zir must refuse signed division overflow",&failures);
    q = opt_eval_int("arith.remsi",min,-1,&ok);
    sd_expect(ok == 1 && q == 0,"MIN % -1 remains defined",&failures);
    q = apply_int_op("arith.remsi",min,-1,&ok);
    sd_expect(ok == 1 && q == 0,"zir MIN % -1 remains defined",&failures);

    sd_assert_fold(sd_case("arith.divsi","-9223372036854775808","-1"),
                   "arith.divsi",0,"",&failures);
    sd_assert_fold(sd_case("arith.divsi","8","0"),"arith.divsi",0,"",&failures);
    sd_assert_fold(sd_case("arith.remsi","8","0"),"arith.remsi",0,"",&failures);
    sd_assert_fold(sd_case("arith.remsi","-9223372036854775808","-1"),
                   "arith.remsi",1,"0",&failures);
    sd_assert_fold(sd_case("arith.divsi","-7","3"),"arith.divsi",1,"-2",&failures);
    sd_assert_fold(sd_case("arith.remsi","-7","3"),"arith.remsi",1,"-1",&failures);
    sd_assert_simplify("arith.remsi","1",1,&failures);
    sd_assert_simplify("arith.remsi","-1",1,&failures);
    sd_assert_simplify("arith.remsi","0",0,&failures);
    sd_assert_simplify("arith.divsi","-1",0,&failures);
    sd_assert_simplify("arith.divsi","0",0,&failures);
    sd_assert_dead_trap("arith.divsi", "8", "0", &failures);
    sd_assert_dead_trap("arith.remsi", "8", "0", &failures);
    sd_assert_dead_trap("arith.divsi", "-9223372036854775808", "-1", &failures);
    if (failures != 0) { return 1; }
    _zag_println("zopt-signed-divmod: pass");
    return 0;
}
