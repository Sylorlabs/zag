// Experimental optimizer: rewrites must retain side effects and region metadata.
@import("../zir.zag")
@import("zopt.zag")

fn ec_val(name: []u8) ZVal { return ZVal{ .name=name, .ty="i64" }; }
fn ec_const(name: []u8, value: []u8) ZOp {
    let op: ZOp = mk_op("arith.constant");
    push[ZVal](&op.results, ec_val(name));
    push[ZAttr](&op.attrs, ZAttr{ .key="value", .val=value });
    return op;
}
fn ec_add(name: []u8, lhs: []u8, rhs: []u8) ZOp {
    let op: ZOp = mk_op("arith.addi");
    push[ZVal](&op.results, ec_val(name));
    push[ZVal](&op.operands, ec_val(lhs));
    push[ZVal](&op.operands, ec_val(rhs));
    return op;
}
fn ec_module(body: ZBlock) ZModule {
    let m: ZModule = ZModule{ .funcs=make[ZFunc](1) };
    push[ZFunc](&m.funcs, ZFunc{ .name="effect_contract", .params=make[ZVal](1),
                                  .ret="void", .body=body });
    return m;
}
fn ec_check(ok: bool, msg: []u8, failed: *i32) void {
    if (!ok) { _zag_eprintln(msg); failed.* = failed.* + 1; }
}
fn ec_nested() ZModule {
    let child: ZBlock = one_block();
    push[ZOp](&child.ops, ec_add("%child", "%a", "%b"));
    let reg: ZRegion = ZRegion{ .blocks=make[ZBlock](1) };
    push[ZBlock](&reg.blocks, child);
    let parent: ZOp = mk_op("scf.if");
    parent.effects=7;
    parent.reads="global";
    parent.writes="global";
    parent.origin.line=123;
    push[ZRegion](&parent.regions, reg);
    let root: ZBlock = one_block();
    push[ZOp](&root.ops, parent);
    return ec_module(root);
}
fn ec_metadata(m: ZModule, label: []u8, failed: *i32) void {
    let op: ZOp = get[ZOp](get[ZFunc](m.funcs, 0).body.ops, 0);
    ec_check(@strEq(op.name, "scf.if") && op.effects == 7 &&
             @strEq(op.reads, "global") && @strEq(op.writes, "global") &&
             op.origin.line == 123 && len[ZRegion](op.regions) == 1,
             label, failed);
}
fn main() i32 {
    let failed: i32 = 0;
    let root: ZBlock = one_block();
    push[ZOp](&root.ops, ec_const("%x", "2"));
    push[ZOp](&root.ops, ec_const("%zero", "0"));
    let effected: ZOp = ec_add("%effected", "%x", "%zero");
    effected.effects=9;
    effected.reads="state";
    effected.writes="state";
    effected.origin.line=77;
    push[ZOp](&root.ops, effected);
    push[ZOp](&root.ops, ec_add("%pure", "%x", "%zero"));
    let m: ZModule = ec_module(root);

    let folded: ZBlock = get[ZFunc](opt_fold(m).funcs, 0).body;
    let keep: ZOp = get[ZOp](folded.ops, 2);
    ec_check(@strEq(keep.name, "arith.addi") && keep.effects == 9 &&
             @strEq(keep.reads, "state") && keep.origin.line == 77,
             "fold removed effectful add", &failed);
    ec_check(@strEq(get[ZOp](folded.ops, 3).name, "arith.constant"),
             "fold did not optimize pure constant add", &failed);

    let simplified: ZBlock = get[ZFunc](opt_simplify(m).funcs, 0).body;
    ec_check(len[ZOp](simplified.ops) == 3 &&
             @strEq(get[ZOp](simplified.ops, 2).name, "arith.addi") &&
             get[ZOp](simplified.ops, 2).effects == 9,
             "simplify discarded effectful add or retained pure x+0", &failed);

    let dead: ZBlock = get[ZFunc](opt_dce(m).funcs, 0).body;
    ec_check(len[ZOp](dead.ops) == 3 &&
             @strEq(get[ZOp](dead.ops, 2).name, "arith.addi") &&
             get[ZOp](dead.ops, 2).effects == 9,
             "DCE removed effectful dead add", &failed);

    let cse_root: ZBlock = one_block();
    push[ZOp](&cse_root.ops, ec_add("%first", "%a", "%b"));
    let cse_effected: ZOp = ec_add("%second", "%a", "%b");
    cse_effected.effects=9;
    cse_effected.reads="state";
    cse_effected.writes="state";
    push[ZOp](&cse_root.ops, cse_effected);
    push[ZOp](&cse_root.ops, ec_add("%third", "%a", "%b"));
    let cse: ZBlock = get[ZFunc](opt_cse(ec_module(cse_root)).funcs, 0).body;
    ec_check(len[ZOp](cse.ops) == 2 &&
             @strEq(get[ZOp](cse.ops, 1).name, "arith.addi") &&
             get[ZOp](cse.ops, 1).effects == 9,
             "CSE removed effectful duplicate or retained pure duplicate", &failed);

    ec_metadata(opt_simplify(ec_nested()), "simplify discarded region metadata", &failed);
    ec_metadata(opt_dce(ec_nested()), "DCE discarded region metadata", &failed);
    ec_metadata(opt_cse(ec_nested()), "CSE discarded region metadata", &failed);
    if (failed != 0) { return 1; }
    _zag_println("zopt-effect-contract: pass (fold, simplify, DCE, CSE, region metadata)");
    return 0;
}
