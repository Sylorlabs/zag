// Execution witness for the independent verified-ZIR x86 scalar backend.
// Exact declared-i32 fixtures, typed integer unary-negation fixtures, and
// bounded explicitly typed-i64 constant/call/context fixtures run through
// direct structured ZIR lowering.
// Only unresolved inferred calls, contextual coercions, and policy-sensitive
// forms stay on the checked AST oracle.
@import("ncodegen.zag")
@import("regalloc.zag")
@import("optimize.zag")
@import("peephole.zag")
@import("x86.zag")
@import("elf.zag")
@import("../zir.zag")
@import("../sema.zag")
@import("../../std/map.zag") as map

fn zir_witness_path(dir:[]u8,name:[]u8)[]u8{
    return _zag_str_concat(dir,_zag_str_concat("/",name));
}

fn zir_mark_single_fn_capture(decls:ArrayList[*Node],caps:i32,cap_names:[]u8)i32{
    if(decls.len!=1){return 0;}
    let n:*Node=decls.data[0];
    switch(n.*){
        .fn_decl=>|f|{
            n.*=Node{.fn_decl=FnDecl{
                .name=f.name,.tparams=f.tparams,.params=f.params,.ret=f.ret,
                .annots=f.annots,.body=f.body,.is_extern=f.is_extern,
                .ret_eff=f.ret_eff,.caps=caps,.cap_names=cap_names,
                .cap_types=f.cap_types,.line=f.line,.is_pub=f.is_pub,.origin=f.origin,
                .import_qualified=f.import_qualified}};
            return 1;
        }
        else=>{return 0;}
    }
}

fn zir_emit_bridge_pair(out_dir:[]u8,name:[]u8,source:[]u8)i32{
    let unit:CompilationUnit=parse_compilation_unit_dir(source,".");
    let eff:map.StringMap[i32]=analyze(unit.decls);
    let authority:ZirAuthority=zir_prepare_production_with_origins(unit.decls,eff,unit.origins);
    if(authority.transform_count!=0||authority.coverage_complete!=0||
       authority.coverage_errors==0||
       !@strEq(authority.transform_status,"verified_raw_ast_bridge_incomplete")){
        _zag_eprintln(_zag_str_concat("AST-bridge fixture overstated typed ZIR coverage: ",name));return 1;}
    let prod_err:i32=0;let prod_data:ArrayList[u8]=make[u8](1);let prod_route:i32=0-1;
    let prod_raw:ArrayList[Instr]=lower_zir_program_mode_cpu_with_route(authority,&prod_err,
        &prod_data,0,0,0,0,0,0,0,&prod_route);
    if(prod_err!=0||prod_route!=0){
        _zag_eprintln(_zag_str_concat("fixture escaped required AST bridge: ",name));return 1;}
    let prod_alloc:ArrayList[Instr]=regalloc(prod_raw);let prod_opt:ArrayList[Instr]=optimize(prod_alloc);
    let prod_final:ArrayList[Instr]=peephole(prod_opt);let prod_code:ArrayList[u8]=encode(prod_final);
    if(write_elf_exec(zir_witness_path(out_dir,_zag_str_concat("production-wide-",name)),
        prod_code,0)!=0){return 1;}

    let ast_err:i32=0;let ast_data:ArrayList[u8]=make[u8](1);
    let ast_raw:ArrayList[Instr]=lower_program_mode_cpu(unit.decls,&ast_err,&ast_data,
        0,0,0,0,0,0,0);
    if(ast_err!=0){_zag_eprintln(_zag_str_concat("fixture AST oracle failed: ",name));return 1;}
    let ast_alloc:ArrayList[Instr]=regalloc(ast_raw);let ast_opt:ArrayList[Instr]=optimize(ast_alloc);
    let ast_final:ArrayList[Instr]=peephole(ast_opt);let ast_code:ArrayList[u8]=encode(ast_final);
    return write_elf_exec(zir_witness_path(out_dir,_zag_str_concat("ast-wide-",name)),ast_code,0);
}

fn zir_emit_contextual_pair(out_dir:[]u8,name:[]u8,source:[]u8)i32{
    let unit:CompilationUnit=parse_compilation_unit_dir(source,".");
    let eff:map.StringMap[i32]=analyze(unit.decls);
    let authority:ZirAuthority=zir_prepare_production_with_origins(unit.decls,eff,unit.origins);
    if(authority.transform_count!=0||authority.coverage_complete!=1||
       authority.coverage_errors!=0||
       !@strEq(authority.transform_status,"verified_no_transform")||
       zir_native_subset_supported(authority)!=0){
        _zag_eprintln(_zag_str_concat("contextual fixture overstated direct ZIR eligibility: ",name));return 1;}
    let prod_err:i32=0;let prod_data:ArrayList[u8]=make[u8](1);let prod_route:i32=0-1;
    let prod_raw:ArrayList[Instr]=lower_zir_program_mode_cpu_with_route(authority,&prod_err,
        &prod_data,0,0,0,0,0,0,0,&prod_route);
    if(prod_err!=0||prod_route!=0){
        _zag_eprintln(_zag_str_concat("contextual fixture escaped required AST bridge: ",name));return 1;}
    let prod_alloc:ArrayList[Instr]=regalloc(prod_raw);let prod_opt:ArrayList[Instr]=optimize(prod_alloc);
    let prod_final:ArrayList[Instr]=peephole(prod_opt);let prod_code:ArrayList[u8]=encode(prod_final);
    if(write_elf_exec(zir_witness_path(out_dir,_zag_str_concat("production-wide-",name)),
        prod_code,0)!=0){return 1;}

    let ast_err:i32=0;let ast_data:ArrayList[u8]=make[u8](1);
    let ast_raw:ArrayList[Instr]=lower_program_mode_cpu(unit.decls,&ast_err,&ast_data,
        0,0,0,0,0,0,0);
    if(ast_err!=0){_zag_eprintln(_zag_str_concat("contextual AST oracle failed: ",name));return 1;}
    let ast_alloc:ArrayList[Instr]=regalloc(ast_raw);let ast_opt:ArrayList[Instr]=optimize(ast_alloc);
    let ast_final:ArrayList[Instr]=peephole(ast_opt);let ast_code:ArrayList[u8]=encode(ast_final);
    return write_elf_exec(zir_witness_path(out_dir,_zag_str_concat("ast-wide-",name)),ast_code,0);
}

fn zir_emit_direct_pair(out_dir:[]u8,name:[]u8,source:[]u8)i32{
    let unit:CompilationUnit=parse_compilation_unit_dir(source,".");
    let eff:map.StringMap[i32]=analyze(unit.decls);
    let authority:ZirAuthority=zir_prepare_production_with_origins(unit.decls,eff,unit.origins);
    if(authority.transform_count!=0||authority.coverage_complete!=1||
       authority.coverage_errors!=0||
       !@strEq(authority.transform_status,"verified_no_transform")){
        _zag_eprintln(_zag_str_concat("direct fixture did not retain complete raw ZIR: ",name));return 1;}
    let prod_err:i32=0;let prod_data:ArrayList[u8]=make[u8](1);let prod_route:i32=0-1;
    let prod_raw:ArrayList[Instr]=lower_zir_program_mode_cpu_with_route(authority,&prod_err,
        &prod_data,0,0,0,0,0,0,0,&prod_route);
    if(prod_err!=0||prod_route!=1){
        _zag_eprintln(_zag_str_concat("direct fixture escaped ZIR lowering: ",name));return 1;}
    let prod_alloc:ArrayList[Instr]=regalloc(prod_raw);let prod_opt:ArrayList[Instr]=optimize(prod_alloc);
    let prod_final:ArrayList[Instr]=peephole(prod_opt);let prod_code:ArrayList[u8]=encode(prod_final);
    let production_prefix:[]u8="production-direct-";
    let oracle_prefix:[]u8="ast-direct-";
    if(name.len>=4&&@strEq(name[0..4],"i64-")){production_prefix="production-wide-";oracle_prefix="ast-wide-";}
    if(write_elf_exec(zir_witness_path(out_dir,_zag_str_concat(production_prefix,name)),
        prod_code,0)!=0){return 1;}

    let ast_err:i32=0;let ast_data:ArrayList[u8]=make[u8](1);
    let ast_raw:ArrayList[Instr]=lower_program_mode_cpu(unit.decls,&ast_err,&ast_data,
        0,0,0,0,0,0,0);
    if(ast_err!=0){_zag_eprintln(_zag_str_concat("direct fixture AST oracle failed: ",name));return 1;}
    let ast_alloc:ArrayList[Instr]=regalloc(ast_raw);let ast_opt:ArrayList[Instr]=optimize(ast_alloc);
    let ast_final:ArrayList[Instr]=peephole(ast_opt);let ast_code:ArrayList[u8]=encode(ast_final);
    return write_elf_exec(zir_witness_path(out_dir,_zag_str_concat(oracle_prefix,name)),ast_code,0);
}

// Negative import fixtures must remain on the checked AST bridge. This helper
// deliberately does not emit or execute an artifact: malformed/private or
// ABI-incomplete imports are expected to be rejected before direct selection.
fn zir_expect_import_bridge(name:[]u8,source:[]u8)i32{
    let unit:CompilationUnit=parse_compilation_unit_dir(source,".");
    let eff:map.StringMap[i32]=analyze(unit.decls);
    let authority:ZirAuthority=zir_prepare_production_with_origins(
        unit.decls,eff,unit.origins);
    let err:i32=0;let data:ArrayList[u8]=make[u8](1);let route:i32=0-1;
    let _raw:ArrayList[Instr]=lower_zir_program_mode_cpu_with_route(authority,
        &err,&data,0,0,0,0,0,0,0,&route);
    if(route!=0||zir_native_subset_supported(authority)!=0){
        _zag_eprintln(_zag_str_concat("import fixture escaped AST bridge: ",name));return 1;
    }
    return 0;
}

// A child binding that is referenced after its region, or from a sibling,
// must make the producer incomplete and keep the checked AST route in charge.
fn zir_expect_scope_bridge(name:[]u8,source:[]u8)i32{
    let unit:CompilationUnit=parse_compilation_unit_dir(source,".");
    let eff:map.StringMap[i32]=analyze(unit.decls);
    let authority:ZirAuthority=zir_prepare_production_with_origins(
        unit.decls,eff,unit.origins);
    let err:i32=0;let data:ArrayList[u8]=make[u8](1);let route:i32=0-1;
    let _raw:ArrayList[Instr]=lower_zir_program_mode_cpu_with_route(authority,
        &err,&data,0,0,0,0,0,0,0,&route);
    // The checked AST bridge may itself reject the invalid lexical reference;
    // either outcome is safe so long as direct ZIR selection is impossible.
    if(authority.coverage_complete!=0||authority.coverage_errors==0||
       zir_native_subset_supported(authority)!=0||route!=0){
        _zag_eprintln(_zag_str_concat("scope leak escaped AST bridge: ",name));return 1;
    }
    return 0;
}

fn zir_expect_subset_bridge(name:[]u8,source:[]u8)i32{
    let unit:CompilationUnit=parse_compilation_unit_dir(source,".");
    let eff:map.StringMap[i32]=analyze(unit.decls);
    let authority:ZirAuthority=zir_prepare_production_with_origins(
        unit.decls,eff,unit.origins);
    let err:i32=0;let data:ArrayList[u8]=make[u8](1);let route:i32=0-1;
    let _raw:ArrayList[Instr]=lower_zir_program_mode_cpu_with_route(authority,
        &err,&data,0,0,0,0,0,0,0,&route);
    // The checked AST bridge may reject an edition/effect-domain fixture; the
    // safety property here is that direct ZIR selection stays disabled.
    if(zir_native_subset_supported(authority)!=0||route!=0){
        _zag_eprintln(_zag_str_concat("unsupported nested value escaped direct route: ",name));return 1;
    }
    return 0;
}

// A structurally well-formed module is not enough for direct native lowering:
// the independent typed/effect/ownership contract report is part of the
// admission authority. This fixture flips only the cached contract bit and
// proves both the predicate and route selector fail closed.
fn zir_expect_invalid_contract()i32{
    let unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i32 { return 42; }\n", ".");
    let eff:map.StringMap[i32]=analyze(unit.decls);
    let authority:ZirAuthority=zir_prepare_production_with_origins(
        unit.decls,eff,unit.origins);
    authority.contract_valid=0;
    if(zir_native_subset_supported(authority)!=0){
        _zag_eprintln("invalid typed-IR contract reached direct native admission");return 1;
    }
    let err:i32=0;let data:ArrayList[u8]=make[u8](1);let route:i32=0-1;
    let _raw:ArrayList[Instr]=lower_zir_program_mode_cpu_with_route(
        authority,&err,&data,0,0,0,0,0,0,0,&route);
    if(err!=0||route!=0){
        _zag_eprintln("invalid typed-IR contract selected the direct route");return 1;
    }
    return 0;
}

// Truncated/forged operation records must be rejected before the native
// whitelist reads operand/result slot zero. This is a module-local safety
// check and intentionally exercises the same helper used by the mutation
// corpus rather than relying on a process crash as evidence.
fn zir_expect_truncated_operation_rejected()i32{
    let unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i32 { let value:i32=40+2; return value; }\n", ".");
    let eff:map.StringMap[i32]=analyze(unit.decls);
    let authority:ZirAuthority=zir_prepare_production_with_origins(
        unit.decls,eff,unit.origins);
    let bad:ZModule=zir_clone_module(authority.module);
    let bad_operand:ZModule=zir_clone_module(authority.module);
    let found:i32=0;let i:i32=0;
    while(i<bad.funcs.data[0].body.ops.len){
        if(@strEq(bad.funcs.data[0].body.ops.data[i].name,"arith.addi")){
            bad.funcs.data[0].body.ops.data[i].results.len=0;
            // A forged capacity below the retained live length is equally
            // unsafe: native admission must reject it before slot access.
            bad_operand.funcs.data[0].body.ops.data[i].operands.cap=0;
            found=1;
        }
        i=i+1;
    }
    if(found!=1||zir_native_module_subset_supported(bad)!=0||
       zir_native_module_subset_supported(bad_operand)!=0){
        _zag_eprintln("truncated ZIR operation escaped native admission");return 1;
    }
    return 0;
}

fn main()i32{
    if(_zag_argc()!=2){_zag_eprintln("zir native backend test requires an output directory");return 2;}
    let out_dir:[]u8=_zag_arg(1);
    if(zir_native_i32_text("0")!=1||zir_native_i32_text("2147483647")!=1||
       zir_native_i32_text("-2147483648")!=1||zir_native_i32_text("2147483648")!=0||
       zir_native_i32_text("-2147483649")!=0||zir_native_i32_text("+1")!=0||
       zir_native_i32_text("01")!=0||zir_native_i32_text("-0")!=0||
       zir_native_i32_text("1x")!=0||zir_native_scalar_ty("i64")!=1||
       zir_native_i64_text("0")!=1||zir_native_i64_text("9223372036854775807")!=1||
       zir_native_i64_text("9223372036854775808")!=0||
       zir_native_i64_text("-9223372036854775808")!=0||
       zir_native_i64_text("01")!=0){
        _zag_eprintln("direct ZIR scalar type/literal domain is not fail-closed");return 1;}
    if(zir_expect_invalid_contract()!=0){return 1;}
    if(zir_expect_truncated_operation_rejected()!=0){return 1;}
    let caps_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i32 { return 42; }\n",".");
    let names_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i32 { return 42; }\n",".");
    if(zir_native_ast_subset(caps_unit.decls)!=1||
       zir_mark_single_fn_capture(caps_unit.decls,1,"")!=1||
       zir_native_ast_subset(caps_unit.decls)!=0||
       zir_mark_single_fn_capture(names_unit.decls,0,"captured")!=1||
       zir_native_ast_subset(names_unit.decls)!=0){
        _zag_eprintln("direct ZIR closure metadata was not rejected");return 1;}
    // Async workers retain a source-level i64 body result while ZIR records
    // the affine TaskI64 ABI metadata.  Native admission still rejects the
    // task operation and leaves the AST bridge in charge of the proven
    // TaskI64 lowering.
    let async_unit:CompilationUnit=parse_compilation_unit_dir(
        "async fn worker(x:i64) i64 { return x+1; } fn main() i32 { return 42; }\n", ".");
    let async_eff:map.StringMap[i32]=analyze(async_unit.decls);
    let async_ir:ZirAuthority=zir_prepare_production_with_origins(
        async_unit.decls,async_eff,async_unit.origins);
    let async_route:i32=0-1;let async_err:i32=0;
    let async_data:ArrayList[u8]=make[u8](1);
    let _async_raw:ArrayList[Instr]=lower_zir_program_mode_cpu_with_route(async_ir,
        &async_err,&async_data,0,0,0,0,0,0,0,&async_route);
    if(async_ir.coverage_complete!=1||async_ir.coverage_errors!=0||
       zir_native_ast_subset(async_unit.decls)!=0||
       zir_native_subset_supported(async_ir)!=0||async_err!=0||async_route!=0){
        _zag_eprintln("async TaskI64 ABI escaped the fail-closed ZIR boundary");return 1;}
    let unit:CompilationUnit=parse_compilation_unit_dir(
        "fn choose(x:i32) i32 { if (x<0) { return 7; } else { return x+2; } }\nfn main() i32 { let neg:i32=choose(-1); if (neg!=7) { return 1; } let base:i32=40; return choose(base); }\n",".");
    let eff:map.StringMap[i32]=analyze(unit.decls);
    let ir:ZirAuthority=zir_prepare_production_with_origins(unit.decls,eff,unit.origins);
    let err:i32=0;let data:ArrayList[u8]=make[u8](1);let route:i32=0;
    let raw:ArrayList[Instr]=lower_zir_program_mode_cpu_with_route(ir,&err,&data,
        0,0,0,0,0,0,0,&route);
    if(err!=0||route!=1){_zag_eprintln("zir native scalar route was not selected");return 1;}
    let allocated:ArrayList[Instr]=regalloc(raw);let optimized:ArrayList[Instr]=optimize(allocated);
    let final:ArrayList[Instr]=peephole(optimized);let code:ArrayList[u8]=encode(final);
    if(write_elf_exec(zir_witness_path(out_dir,"native-scalar"),code,0)!=0){return 1;}

    // Explicit i64 arithmetic/comparison is admitted when ZIR carries the
    // same declared type through every operand, including typed call inputs.
    // Untyped locals and unresolved or policy-sensitive contextual conversions
    // remain on the AST bridge.
    let i64_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn wide() i64 { return 7; } fn main() i64 { return wide(); }\n", ".");
    let i64_eff:map.StringMap[i32]=analyze(i64_unit.decls);
    let i64_ir:ZirAuthority=zir_prepare_production_with_origins(
        i64_unit.decls,i64_eff,i64_unit.origins);
    let i64_err:i32=0;let i64_data:ArrayList[u8]=make[u8](1);let i64_route:i32=0-1;
    let i64_raw:ArrayList[Instr]=lower_zir_program_mode_cpu_with_route(i64_ir,
        &i64_err,&i64_data,0,0,0,0,0,0,0,&i64_route);
    if(i64_err!=0||i64_route!=1||zir_native_subset_supported(i64_ir)!=1){
        _zag_eprintln("explicit i64 constant/call direct route was not selected");return 1;}
    let i64_alloc:ArrayList[Instr]=regalloc(i64_raw);let i64_opt:ArrayList[Instr]=optimize(i64_alloc);
    let i64_final:ArrayList[Instr]=peephole(i64_opt);let i64_code:ArrayList[u8]=encode(i64_final);
    if(write_elf_exec(zir_witness_path(out_dir,"native-i64-constant"),i64_code,0)!=0){return 1;}

    // A declaration-proven i64 return can also seed an inferred local. Keep
    // this separate from the explicit i64-call fixture above: only the
    // source-local, nullary, or canonical one-argument captureless declaration
    // is admitted, while a mismatched parameter declaration remains on the
    // AST bridge.
    let inferred_i64_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn wide() i64 { return 41; } fn main() i64 { let answer=wide(); return answer+1; }\n", ".");
    let inferred_i64_eff:map.StringMap[i32]=analyze(inferred_i64_unit.decls);
    let inferred_i64_ir:ZirAuthority=zir_prepare_production_with_origins(
        inferred_i64_unit.decls,inferred_i64_eff,inferred_i64_unit.origins);
    let inferred_i64_err:i32=0;let inferred_i64_data:ArrayList[u8]=make[u8](1);let inferred_i64_route:i32=0-1;
    let inferred_i64_raw:ArrayList[Instr]=lower_zir_program_mode_cpu_with_route(
        inferred_i64_ir,&inferred_i64_err,&inferred_i64_data,0,0,0,0,0,0,0,&inferred_i64_route);
    if(inferred_i64_err!=0||inferred_i64_route!=1||
       zir_native_subset_supported(inferred_i64_ir)!=1){
        _zag_eprintln("inferred i64 nullary call did not select direct ZIR lowering");return 1;}
    let inferred_i64_alloc:ArrayList[Instr]=regalloc(inferred_i64_raw);
    let inferred_i64_opt:ArrayList[Instr]=optimize(inferred_i64_alloc);
    let inferred_i64_final:ArrayList[Instr]=peephole(inferred_i64_opt);
    let inferred_i64_code:ArrayList[u8]=encode(inferred_i64_final);
    if(write_elf_exec(zir_witness_path(out_dir,"native-inferred-i64-call"),
        inferred_i64_code,0)!=0){return 1;}
    let inferred_i64_one_arg_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn wide(x:i64) i64 { return x; } fn main() i64 { let answer=wide(41); return answer+1; }\n", ".");
    let inferred_i64_one_arg_eff:map.StringMap[i32]=analyze(inferred_i64_one_arg_unit.decls);
    let inferred_i64_one_arg_ir:ZirAuthority=zir_prepare_production_with_origins(
        inferred_i64_one_arg_unit.decls,inferred_i64_one_arg_eff,inferred_i64_one_arg_unit.origins);
    let inferred_i64_one_arg_err:i32=0;let inferred_i64_one_arg_data:ArrayList[u8]=make[u8](1);let inferred_i64_one_arg_route:i32=0-1;
    let inferred_i64_one_arg_raw:ArrayList[Instr]=lower_zir_program_mode_cpu_with_route(
        inferred_i64_one_arg_ir,&inferred_i64_one_arg_err,&inferred_i64_one_arg_data,0,0,0,0,0,0,0,&inferred_i64_one_arg_route);
    if(inferred_i64_one_arg_err!=0||inferred_i64_one_arg_route!=1||
       zir_native_subset_supported(inferred_i64_one_arg_ir)!=1){
        _zag_eprintln("inferred i64 one-argument call did not select direct ZIR lowering");return 1;}
    let inferred_i64_one_arg_alloc:ArrayList[Instr]=regalloc(inferred_i64_one_arg_raw);
    let inferred_i64_one_arg_opt:ArrayList[Instr]=optimize(inferred_i64_one_arg_alloc);
    let inferred_i64_one_arg_final:ArrayList[Instr]=peephole(inferred_i64_one_arg_opt);
    let inferred_i64_one_arg_code:ArrayList[u8]=encode(inferred_i64_one_arg_final);
    if(write_elf_exec(zir_witness_path(out_dir,"native-inferred-i64-one-arg"),
        inferred_i64_one_arg_code,0)!=0){return 1;}
    // A plain immutable function value may name an exact source-local,
    // captureless declaration. The direct route resolves the binding to the
    // declaration target, while imported/qualified and mismatched signatures
    // remain on the checked AST bridge.
    if(zir_emit_direct_pair(out_dir,"i64-named-function-value",
        "fn wide(x:i64) i64 { return x; } fn main() i64 { let f:fn(i64) i64=wide; return f(41)+1; }\n")!=0){return 1;}
    let named_fn_bad_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn wide(x:i64) i64 { return x; } fn main() i64 { let f:fn(i32) i64=wide; return f(41)+1; }\n", ".");
    let named_fn_bad_eff:map.StringMap[i32]=analyze(named_fn_bad_unit.decls);
    let named_fn_bad_ir:ZirAuthority=zir_prepare_production_with_origins(
        named_fn_bad_unit.decls,named_fn_bad_eff,named_fn_bad_unit.origins);
    let named_fn_bad_err:i32=0;let named_fn_bad_data:ArrayList[u8]=make[u8](1);let named_fn_bad_route:i32=0-1;
    let _named_fn_bad_raw:ArrayList[Instr]=lower_zir_program_mode_cpu_with_route(
        named_fn_bad_ir,&named_fn_bad_err,&named_fn_bad_data,0,0,0,0,0,0,0,&named_fn_bad_route);
