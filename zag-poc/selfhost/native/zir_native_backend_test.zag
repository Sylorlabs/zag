    if(zir_expect_import_bridge("unqualified-explicit-import",
        "@import(\"tests/zir_import_scalar.zag\")\nfn main() i32 { let answer:i32=add_i32(40,2); return answer; }\n")!=0){return 1;}
    if(zir_expect_import_bridge("unqualified-source-dunder-import",
        "@import(\"tests/zir_import_scalar.zag\")\nfn main() i32 { let answer=fake__qualified(40,2); return answer; }\n")!=0){return 1;}
    if(zir_expect_import_bridge("unqualified-explicit-source-dunder-import",
        "@import(\"tests/zir_import_scalar.zag\")\nfn main() i32 { let answer:i32=fake__qualified(40,2); return answer; }\n")!=0){return 1;}
    if(zir_expect_import_bridge("hidden-private-spelling",
        "@import(\"tests/zir_import_scalar.zag\") as scalar\nfn main() i32 { let answer:i32=scalar__private__private_i32(40,2); return answer; }\n")!=0){return 1;}
    if(zir_expect_import_bridge("private-qualified-import",
        "@import(\"tests/zir_import_scalar.zag\") as scalar\nfn main() i32 { let answer=scalar.private_i32(40,2); return answer; }\n")!=0){return 1;}
    if(zir_expect_import_bridge("mismatched-qualified-import",
        "@import(\"tests/zir_import_scalar.zag\") as scalar\nfn main() i32 { let answer=scalar.wrong_i32_param(40,2); return answer; }\n")!=0){return 1;}
    if(zir_expect_import_bridge("generic-qualified-import",
        "@import(\"tests/zir_import_scalar_bad.zag\") as scalar\nfn main() i32 { let answer=scalar.identity(40); return answer; }\n")!=0){return 1;}
    if(zir_expect_import_bridge("extern-qualified-import",
        "@import(\"tests/zir_import_scalar_bad.zag\") as scalar\nfn main() i32 { let answer=scalar.imported_extern(40,2); return answer; }\n")!=0){return 1;}
    if(zir_expect_import_bridge("async-qualified-import",
        "@import(\"tests/zir_import_scalar_bad.zag\") as scalar\nfn main() i64 { let answer=scalar.imported_async(41); return answer; }\n")!=0){return 1;}
    if(zir_expect_import_bridge("explicit-generic-qualified-import",
        "@import(\"tests/zir_import_scalar_bad.zag\") as scalar\nfn main() i32 { let answer:i32=scalar.identity(40); return answer; }\n")!=0){return 1;}
    if(zir_expect_import_bridge("explicit-extern-qualified-import",
        "@import(\"tests/zir_import_scalar_bad.zag\") as scalar\nfn main() i32 { let answer:i32=scalar.imported_extern(40,2); return answer; }\n")!=0){return 1;}
    if(zir_expect_import_bridge("explicit-async-qualified-import",
        "@import(\"tests/zir_import_scalar_bad.zag\") as scalar\nfn main() i64 { let answer:i64=scalar.imported_async(41); return answer; }\n")!=0){return 1;}
    // `print_i32` is a compiler-owned intrinsic, so both provenance predicates
    // intentionally admit its source call.  It remains bridge-only here: sema
    // marks printing as I/O (effect bit 4), and the bounded direct ZIR backend
    // accepts only effect-free/panic scalar functions and has no intrinsic
    // emission op.  Keep both facts asserted so a future direct intrinsic
    // implementation must change the route expectation deliberately.
    let print_policy_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i32 { print_i32(42); return 0; }\n", ".");
    if(zir_fn_call_provenance_allowed(print_policy_unit.decls,"print_i32","<root>")!=1||
       zir_native_ast_call_provenance_allowed(print_policy_unit.decls,"print_i32","<root>")!=1){
        _zag_eprintln("print_i32 intrinsic provenance admission was lost");return 1;}
    if(zir_expect_import_bridge("print-i32-compiler-bridge",
        "fn main() i32 { print_i32(42); return 0; }\n")!=0){return 1;}
    let inferred_i64_arg_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn wide(x:i32) i64 { return 41; } fn main() i64 { let answer=wide(41); return answer+1; }\n", ".");
    let inferred_i64_arg_eff:map.StringMap[i32]=analyze(inferred_i64_arg_unit.decls);
    let inferred_i64_arg_ir:ZirAuthority=zir_prepare_production_with_origins(
        inferred_i64_arg_unit.decls,inferred_i64_arg_eff,inferred_i64_arg_unit.origins);
    let inferred_i64_arg_err:i32=0;let inferred_i64_arg_data:ArrayList[u8]=make[u8](1);let inferred_i64_arg_route:i32=0-1;
    let _inferred_i64_arg_raw:ArrayList[Instr]=lower_zir_program_mode_cpu_with_route(
        inferred_i64_arg_ir,&inferred_i64_arg_err,&inferred_i64_arg_data,0,0,0,0,0,0,0,&inferred_i64_arg_route);
    if(inferred_i64_arg_ir.coverage_complete!=0||inferred_i64_arg_ir.coverage_errors==0||
       zir_native_subset_supported(inferred_i64_arg_ir)!=0||inferred_i64_arg_err!=0||
       inferred_i64_arg_route!=0){
        _zag_eprintln("inferred i64 argument call escaped the fail-closed boundary");return 1;}

    let loop_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i32 { let x:i32=0; let sum:i32=0; while (x<10) { x=x+1; if (x==2) { continue; } if (x==5) { break; } sum=sum+x; } switch (sum) { 7, 8 => { return 10; } else => { return 1; } } }\n",".");
    let loop_eff:map.StringMap[i32]=analyze(loop_unit.decls);
    let loop_ir:ZirAuthority=zir_prepare_production_with_origins(loop_unit.decls,loop_eff,loop_unit.origins);
    let loop_err:i32=0;let loop_data:ArrayList[u8]=make[u8](1);let loop_route:i32=0-1;
    let fallback:ArrayList[Instr]=lower_zir_program_mode_cpu_with_route(loop_ir,&loop_err,&loop_data,
        0,0,0,0,0,0,0,&loop_route);
    if(loop_err!=0||loop_route!=1||fallback.len==0){
        _zag_eprintln("zir native mutable loop route was not selected");return 1;}
    let loop_allocated:ArrayList[Instr]=regalloc(fallback);
    let loop_optimized:ArrayList[Instr]=optimize(loop_allocated);
    let loop_final:ArrayList[Instr]=peephole(loop_optimized);let loop_code:ArrayList[u8]=encode(loop_final);
    if(write_elf_exec(zir_witness_path(out_dir,"native-loop"),loop_code,0)!=0){return 1;}

    // The public production entry stays raw. The bounded source/policy seam may
    // select one candidate, while the direct backend must reject the older
    // structural-only test authority. Raw, bound, and AST oracle artifacts all
    // agree in this exact declared-i32 wrapping domain.
    let overflow_source:[]u8="fn main() i32 { let x:i32=2147483647+1; if (x<0) { return 42; } else { return 1; } }\n";
    let overflow_unit:CompilationUnit=parse_compilation_unit_dir(overflow_source,".");
    let overflow_eff:map.StringMap[i32]=analyze(overflow_unit.decls);
    let overflow_raw_module:ZModule=build_module(
        overflow_unit.decls,overflow_eff,overflow_unit.origins);
    let overflow_baseline:ZirAuthority=zir_select_foreground_transform(
        overflow_raw_module,overflow_unit.decls,zir_no_transform_proposal(overflow_raw_module));
    let overflow_ir:ZirAuthority=zir_prepare_production_with_origins(
        overflow_unit.decls,overflow_eff,overflow_unit.origins);
    let overflow_structural_candidate:ZirAuthority=zir_select_foreground_transform(
        overflow_raw_module,overflow_unit.decls,
        zir_propose_const_i32_add(overflow_raw_module));
    let overflow_source_policy_candidate:ZirAuthority=
        zir_prepare_const_i32_add_source_policy_with_origins(overflow_unit.decls,
            overflow_eff,overflow_unit.origins,zir_transform_policy_const_i32_add_default());
    let mutated_source_policy_candidate:ZirAuthority=overflow_source_policy_candidate;
    mutated_source_policy_candidate.certificate.safety_checked=1;
    if(overflow_baseline.transform_count!=0||
       !@strEq(overflow_baseline.transform_status,"verified_no_transform")||
       overflow_ir.transform_count!=0||
       !@strEq(overflow_ir.transform_status,"verified_no_transform")||
       overflow_structural_candidate.transform_count!=1||
       !@strEq(overflow_structural_candidate.transform_status,"test_only_structural_transform")||
       zir_native_subset_supported(overflow_structural_candidate)!=0||
       overflow_source_policy_candidate.transform_count!=1||
       !@strEq(overflow_source_policy_candidate.transform_status,
