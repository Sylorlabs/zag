// Execution witness for the independent verified-ZIR x86 scalar backend.
// Exact declared-i32 fixtures run through direct structured ZIR lowering;
// contextual i64 is represented in raw ZIR but stays on the checked AST oracle.
@import("ncodegen.zag")
@import("regalloc.zag")
@import("optimize.zag")
@import("peephole.zag")
@import("x86.zag")
@import("elf.zag")
@import("../zir.zag")
@import("../sema.zag")
@import("../../std/map.zag") as map

fn zir_witness_path(dir:[]u8,name:[]u8)[]u8{
    return _zag_str_concat(dir,_zag_str_concat("/",name));
}

fn zir_mark_single_fn_capture(decls:ArrayList[*Node],caps:i32,cap_names:[]u8)i32{
    if(decls.len!=1){return 0;}
    let n:*Node=decls.data[0];
    switch(n.*){
        .fn_decl=>|f|{
            n.*=Node{.fn_decl=FnDecl{
                .name=f.name,.tparams=f.tparams,.params=f.params,.ret=f.ret,
                .annots=f.annots,.body=f.body,.is_extern=f.is_extern,
                .ret_eff=f.ret_eff,.caps=caps,.cap_names=cap_names,
                .cap_types=f.cap_types,.line=f.line,.is_pub=f.is_pub,.origin=f.origin}};
            return 1;
        }
        else=>{return 0;}
    }
}

fn zir_emit_bridge_pair(out_dir:[]u8,name:[]u8,source:[]u8)i32{
    let unit:CompilationUnit=parse_compilation_unit_dir(source,".");
    let eff:map.StringMap[i32]=analyze(unit.decls);
    let authority:ZirAuthority=zir_prepare_production_with_origins(unit.decls,eff,unit.origins);
    if(authority.transform_count!=0||authority.coverage_complete!=0||
       authority.coverage_errors==0||
       !@strEq(authority.transform_status,"verified_raw_ast_bridge_incomplete")){
        _zag_eprintln(_zag_str_concat("AST-bridge fixture overstated typed ZIR coverage: ",name));return 1;}
    let prod_err:i32=0;let prod_data:ArrayList[u8]=make[u8](1);let prod_route:i32=0-1;
    let prod_raw:ArrayList[Instr]=lower_zir_program_mode_cpu_with_route(authority,&prod_err,
        &prod_data,0,0,0,0,0,0,0,&prod_route);
    if(prod_err!=0||prod_route!=0){
        _zag_eprintln(_zag_str_concat("fixture escaped required AST bridge: ",name));return 1;}
    let prod_alloc:ArrayList[Instr]=regalloc(prod_raw);let prod_opt:ArrayList[Instr]=optimize(prod_alloc);
    let prod_final:ArrayList[Instr]=peephole(prod_opt);let prod_code:ArrayList[u8]=encode(prod_final);
    if(write_elf_exec(zir_witness_path(out_dir,_zag_str_concat("production-wide-",name)),
        prod_code,0)!=0){return 1;}

    let ast_err:i32=0;let ast_data:ArrayList[u8]=make[u8](1);
    let ast_raw:ArrayList[Instr]=lower_program_mode_cpu(unit.decls,&ast_err,&ast_data,
        0,0,0,0,0,0,0);
    if(ast_err!=0){_zag_eprintln(_zag_str_concat("fixture AST oracle failed: ",name));return 1;}
    let ast_alloc:ArrayList[Instr]=regalloc(ast_raw);let ast_opt:ArrayList[Instr]=optimize(ast_alloc);
    let ast_final:ArrayList[Instr]=peephole(ast_opt);let ast_code:ArrayList[u8]=encode(ast_final);
    return write_elf_exec(zir_witness_path(out_dir,_zag_str_concat("ast-wide-",name)),ast_code,0);
}

fn zir_emit_contextual_pair(out_dir:[]u8,name:[]u8,source:[]u8)i32{
    let unit:CompilationUnit=parse_compilation_unit_dir(source,".");
    let eff:map.StringMap[i32]=analyze(unit.decls);
    let authority:ZirAuthority=zir_prepare_production_with_origins(unit.decls,eff,unit.origins);
    if(authority.transform_count!=0||authority.coverage_complete!=1||
       authority.coverage_errors!=0||
       !@strEq(authority.transform_status,"verified_no_transform")||
       zir_native_subset_supported(authority)!=0){
        _zag_eprintln(_zag_str_concat("contextual fixture overstated direct ZIR eligibility: ",name));return 1;}
    let prod_err:i32=0;let prod_data:ArrayList[u8]=make[u8](1);let prod_route:i32=0-1;
    let prod_raw:ArrayList[Instr]=lower_zir_program_mode_cpu_with_route(authority,&prod_err,
        &prod_data,0,0,0,0,0,0,0,&prod_route);
    if(prod_err!=0||prod_route!=0){
        _zag_eprintln(_zag_str_concat("contextual fixture escaped required AST bridge: ",name));return 1;}
    let prod_alloc:ArrayList[Instr]=regalloc(prod_raw);let prod_opt:ArrayList[Instr]=optimize(prod_alloc);
    let prod_final:ArrayList[Instr]=peephole(prod_opt);let prod_code:ArrayList[u8]=encode(prod_final);
    if(write_elf_exec(zir_witness_path(out_dir,_zag_str_concat("production-wide-",name)),
        prod_code,0)!=0){return 1;}

    let ast_err:i32=0;let ast_data:ArrayList[u8]=make[u8](1);
    let ast_raw:ArrayList[Instr]=lower_program_mode_cpu(unit.decls,&ast_err,&ast_data,
        0,0,0,0,0,0,0);
    if(ast_err!=0){_zag_eprintln(_zag_str_concat("contextual AST oracle failed: ",name));return 1;}
    let ast_alloc:ArrayList[Instr]=regalloc(ast_raw);let ast_opt:ArrayList[Instr]=optimize(ast_alloc);
    let ast_final:ArrayList[Instr]=peephole(ast_opt);let ast_code:ArrayList[u8]=encode(ast_final);
    return write_elf_exec(zir_witness_path(out_dir,_zag_str_concat("ast-wide-",name)),ast_code,0);
}

fn zir_emit_direct_pair(out_dir:[]u8,name:[]u8,source:[]u8)i32{
    let unit:CompilationUnit=parse_compilation_unit_dir(source,".");
    let eff:map.StringMap[i32]=analyze(unit.decls);
    let authority:ZirAuthority=zir_prepare_production_with_origins(unit.decls,eff,unit.origins);
    if(authority.transform_count!=0||authority.coverage_complete!=1||
       authority.coverage_errors!=0||
       !@strEq(authority.transform_status,"verified_no_transform")){
        _zag_eprintln(_zag_str_concat("direct fixture did not retain complete raw ZIR: ",name));return 1;}
    let prod_err:i32=0;let prod_data:ArrayList[u8]=make[u8](1);let prod_route:i32=0-1;
    let prod_raw:ArrayList[Instr]=lower_zir_program_mode_cpu_with_route(authority,&prod_err,
        &prod_data,0,0,0,0,0,0,0,&prod_route);
    if(prod_err!=0||prod_route!=1){
        _zag_eprintln(_zag_str_concat("direct fixture escaped ZIR lowering: ",name));return 1;}
    let prod_alloc:ArrayList[Instr]=regalloc(prod_raw);let prod_opt:ArrayList[Instr]=optimize(prod_alloc);
    let prod_final:ArrayList[Instr]=peephole(prod_opt);let prod_code:ArrayList[u8]=encode(prod_final);
    if(write_elf_exec(zir_witness_path(out_dir,_zag_str_concat("production-direct-",name)),
        prod_code,0)!=0){return 1;}

    let ast_err:i32=0;let ast_data:ArrayList[u8]=make[u8](1);
    let ast_raw:ArrayList[Instr]=lower_program_mode_cpu(unit.decls,&ast_err,&ast_data,
        0,0,0,0,0,0,0);
    if(ast_err!=0){_zag_eprintln(_zag_str_concat("direct fixture AST oracle failed: ",name));return 1;}
    let ast_alloc:ArrayList[Instr]=regalloc(ast_raw);let ast_opt:ArrayList[Instr]=optimize(ast_alloc);
    let ast_final:ArrayList[Instr]=peephole(ast_opt);let ast_code:ArrayList[u8]=encode(ast_final);
    return write_elf_exec(zir_witness_path(out_dir,_zag_str_concat("ast-direct-",name)),ast_code,0);
}

fn main()i32{
    if(_zag_argc()!=2){_zag_eprintln("zir native backend test requires an output directory");return 2;}
    let out_dir:[]u8=_zag_arg(1);
    if(zir_native_i32_text("0")!=1||zir_native_i32_text("2147483647")!=1||
       zir_native_i32_text("-2147483648")!=1||zir_native_i32_text("2147483648")!=0||
       zir_native_i32_text("-2147483649")!=0||zir_native_i32_text("+1")!=0||
       zir_native_i32_text("01")!=0||zir_native_i32_text("-0")!=0||
       zir_native_i32_text("1x")!=0||zir_native_scalar_ty("i64")!=0){
        _zag_eprintln("direct ZIR i32 type/literal domain is not fail-closed");return 1;}
    let caps_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i32 { return 42; }\n",".");
    let names_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i32 { return 42; }\n",".");
    if(zir_native_ast_subset(caps_unit.decls)!=1||
       zir_mark_single_fn_capture(caps_unit.decls,1,"")!=1||
       zir_native_ast_subset(caps_unit.decls)!=0||
       zir_mark_single_fn_capture(names_unit.decls,0,"captured")!=1||
       zir_native_ast_subset(names_unit.decls)!=0){
        _zag_eprintln("direct ZIR closure metadata was not rejected");return 1;}
    let unit:CompilationUnit=parse_compilation_unit_dir(
        "fn choose(x:i32) i32 { if (x<0) { return 7; } else { return x+2; } }\nfn main() i32 { let neg:i32=choose(-1); if (neg!=7) { return 1; } let base:i32=40; return choose(base); }\n",".");
    let eff:map.StringMap[i32]=analyze(unit.decls);
    let ir:ZirAuthority=zir_prepare_production_with_origins(unit.decls,eff,unit.origins);
    let err:i32=0;let data:ArrayList[u8]=make[u8](1);let route:i32=0;
    let raw:ArrayList[Instr]=lower_zir_program_mode_cpu_with_route(ir,&err,&data,
        0,0,0,0,0,0,0,&route);
    if(err!=0||route!=1){_zag_eprintln("zir native scalar route was not selected");return 1;}
    let allocated:ArrayList[Instr]=regalloc(raw);let optimized:ArrayList[Instr]=optimize(allocated);
    let final:ArrayList[Instr]=peephole(optimized);let code:ArrayList[u8]=encode(final);
    if(write_elf_exec(zir_witness_path(out_dir,"native-scalar"),code,0)!=0){return 1;}

    let loop_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i32 { let x:i32=0; let sum:i32=0; while (x<10) { x=x+1; if (x==2) { continue; } if (x==5) { break; } sum=sum+x; } switch (sum) { 7, 8 => { return 10; } else => { return 1; } } }\n",".");
    let loop_eff:map.StringMap[i32]=analyze(loop_unit.decls);
    let loop_ir:ZirAuthority=zir_prepare_production_with_origins(loop_unit.decls,loop_eff,loop_unit.origins);
    let loop_err:i32=0;let loop_data:ArrayList[u8]=make[u8](1);let loop_route:i32=0-1;
    let fallback:ArrayList[Instr]=lower_zir_program_mode_cpu_with_route(loop_ir,&loop_err,&loop_data,
        0,0,0,0,0,0,0,&loop_route);
    if(loop_err!=0||loop_route!=1||fallback.len==0){
        _zag_eprintln("zir native mutable loop route was not selected");return 1;}
    let loop_allocated:ArrayList[Instr]=regalloc(fallback);
    let loop_optimized:ArrayList[Instr]=optimize(loop_allocated);
    let loop_final:ArrayList[Instr]=peephole(loop_optimized);let loop_code:ArrayList[u8]=encode(loop_final);
    if(write_elf_exec(zir_witness_path(out_dir,"native-loop"),loop_code,0)!=0){return 1;}

    // The public production entry stays raw. The bounded source/policy seam may
    // select one candidate, while the direct backend must reject the older
    // structural-only test authority. Raw, bound, and AST oracle artifacts all
    // agree in this exact declared-i32 wrapping domain.
    let overflow_source:[]u8="fn main() i32 { let x:i32=2147483647+1; if (x<0) { return 42; } else { return 1; } }\n";
    let overflow_unit:CompilationUnit=parse_compilation_unit_dir(overflow_source,".");
    let overflow_eff:map.StringMap[i32]=analyze(overflow_unit.decls);
    let overflow_raw_module:ZModule=build_module(
        overflow_unit.decls,overflow_eff,overflow_unit.origins);
    let overflow_baseline:ZirAuthority=zir_select_foreground_transform(
        overflow_raw_module,overflow_unit.decls,zir_no_transform_proposal(overflow_raw_module));
    let overflow_ir:ZirAuthority=zir_prepare_production_with_origins(
        overflow_unit.decls,overflow_eff,overflow_unit.origins);
    let overflow_structural_candidate:ZirAuthority=zir_select_foreground_transform(
        overflow_raw_module,overflow_unit.decls,
        zir_propose_const_i32_add(overflow_raw_module));
    let overflow_source_policy_candidate:ZirAuthority=
        zir_prepare_const_i32_add_source_policy_with_origins(overflow_unit.decls,
            overflow_eff,overflow_unit.origins,zir_transform_policy_const_i32_add_default());
    let mutated_source_policy_candidate:ZirAuthority=overflow_source_policy_candidate;
    mutated_source_policy_candidate.certificate.safety_checked=1;
    if(overflow_baseline.transform_count!=0||
       !@strEq(overflow_baseline.transform_status,"verified_no_transform")||
       overflow_ir.transform_count!=0||
       !@strEq(overflow_ir.transform_status,"verified_no_transform")||
       overflow_structural_candidate.transform_count!=1||
       !@strEq(overflow_structural_candidate.transform_status,"test_only_structural_transform")||
       zir_native_subset_supported(overflow_structural_candidate)!=0||
       overflow_source_policy_candidate.transform_count!=1||
       !@strEq(overflow_source_policy_candidate.transform_status,
            "foreground_source_policy_checked")||
       zir_native_subset_supported(overflow_source_policy_candidate)!=1||
       zir_native_subset_supported(mutated_source_policy_candidate)!=0){
        _zag_eprintln("raw/source-policy/structural i32 add selection boundary failed");return 1;}

    let baseline_err:i32=0;let baseline_data:ArrayList[u8]=make[u8](1);
    let baseline_route:i32=0;
    let baseline_raw:ArrayList[Instr]=lower_zir_program_mode_cpu_with_route(
        overflow_baseline,&baseline_err,&baseline_data,0,0,0,0,0,0,0,&baseline_route);
    if(baseline_err!=0||baseline_route!=1){
        _zag_eprintln("raw i32 overflow fallback did not select direct ZIR lowering");return 1;}
    let baseline_allocated:ArrayList[Instr]=regalloc(baseline_raw);
    let baseline_optimized:ArrayList[Instr]=optimize(baseline_allocated);
    let baseline_final:ArrayList[Instr]=peephole(baseline_optimized);
    let baseline_code:ArrayList[u8]=encode(baseline_final);
    if(write_elf_exec(zir_witness_path(out_dir,"raw-overflow"),baseline_code,0)!=0){return 1;}

    let overflow_err:i32=0;let overflow_data:ArrayList[u8]=make[u8](1);
    let overflow_route:i32=0;
    let overflow_raw:ArrayList[Instr]=lower_zir_program_mode_cpu_with_route(
        overflow_ir,&overflow_err,&overflow_data,0,0,0,0,0,0,0,&overflow_route);
    if(overflow_err!=0||overflow_route!=1){
        _zag_eprintln("i32 overflow comparison did not select direct ZIR lowering");return 1;}
    let overflow_allocated:ArrayList[Instr]=regalloc(overflow_raw);
    let overflow_optimized:ArrayList[Instr]=optimize(overflow_allocated);
    let overflow_final:ArrayList[Instr]=peephole(overflow_optimized);
    let overflow_code:ArrayList[u8]=encode(overflow_final);
    if(write_elf_exec(zir_witness_path(out_dir,"production-overflow"),overflow_code,0)!=0){return 1;}

    let candidate_err:i32=0;let candidate_data:ArrayList[u8]=make[u8](1);
    let candidate_route:i32=0;
    let candidate_raw:ArrayList[Instr]=lower_zir_program_mode_cpu_with_route(
        overflow_source_policy_candidate,&candidate_err,&candidate_data,0,0,0,0,0,0,0,&candidate_route);
    if(candidate_err!=0||candidate_route!=1){
        _zag_eprintln("source-policy checked candidate did not select direct ZIR lowering");return 1;}
    let candidate_alloc:ArrayList[Instr]=regalloc(candidate_raw);
    let candidate_opt:ArrayList[Instr]=optimize(candidate_alloc);
    let candidate_final:ArrayList[Instr]=peephole(candidate_opt);
    let candidate_code:ArrayList[u8]=encode(candidate_final);
    if(write_elf_exec(zir_witness_path(out_dir,"source-policy-candidate-overflow"),candidate_code,0)!=0){return 1;}

    let oracle_err:i32=0;let oracle_data:ArrayList[u8]=make[u8](1);
    let oracle_raw:ArrayList[Instr]=lower_program_mode_cpu(overflow_unit.decls,
        &oracle_err,&oracle_data,0,0,0,0,0,0,0);
    if(oracle_err!=0){_zag_eprintln("i32 overflow AST oracle lowering failed");return 1;}
    let oracle_allocated:ArrayList[Instr]=regalloc(oracle_raw);
    let oracle_optimized:ArrayList[Instr]=optimize(oracle_allocated);
    let oracle_final:ArrayList[Instr]=peephole(oracle_optimized);
    let oracle_code:ArrayList[u8]=encode(oracle_final);
    if(write_elf_exec(zir_witness_path(out_dir,"ast-overflow"),oracle_code,0)!=0){return 1;}

    if(zir_emit_contextual_pair(out_dir,"i64-let",
        "fn main() i32 { let wide:i64=2147483647+1; if (wide>0) { return 42; } return 1; }\n")!=0){return 1;}
    if(zir_emit_contextual_pair(out_dir,"i64-return",
        "fn wide() i64 { return 2147483647+1; } fn main() i32 { if (wide()>0) { return 42; } return 1; }\n")!=0){return 1;}
    if(zir_emit_contextual_pair(out_dir,"i64-param",
        "fn accept(x:i64) i32 { if (x==2147483648) { return 42; } return 1; } fn main() i32 { return accept(2147483647+1); }\n")!=0){return 1;}
    if(zir_emit_contextual_pair(out_dir,"i64-mutable",
        "fn main() i32 { let wide:i64=0; wide=2147483647+1; if (wide>0) { return 42; } return 1; }\n")!=0){return 1;}
    if(zir_emit_bridge_pair(out_dir,"untyped-let",
        "fn main() i32 { let answer=40+2; return answer; }\n")!=0){return 1;}
    if(zir_emit_direct_pair(out_dir,"source-order-shadow",
        "fn bump(x:i32) i32 { let x:i32=x+1; x=x+1; return x; } fn main() i32 { return bump(40); }\n")!=0){return 1;}
    let early_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i32 { if (x==0) { return 42; } let x:i32=1; x=2; return x; }\n",".");
    let early_eff:map.StringMap[i32]=analyze(early_unit.decls);
    let early_ir:ZirAuthority=zir_prepare_production_with_origins(
        early_unit.decls,early_eff,early_unit.origins);
    if(early_ir.coverage_complete!=0||early_ir.coverage_errors==0||
       !@strEq(early_ir.transform_status,"verified_raw_ast_bridge_incomplete")||
       zir_native_subset_supported(early_ir)!=0){
        _zag_eprintln("read-before-declaration escaped fail-closed ZIR coverage");return 1;}

    let div_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn wrap(x:i32) i32 { return x+1; } fn quotient(a:i32,b:i32) i32 { return a/b; } fn remainder(a:i32,b:i32) i32 { return a%b; } fn main() i32 { let max:i32=2147483647; let wrapped:i32=wrap(max); if (wrapped>=0) { return 1; } let q:i32=quotient(20,3); let r:i32=remainder(20,3); let edge:i32=quotient(wrapped,-1); if (edge!=wrapped) { return 2; } let edge_r:i32=remainder(wrapped,-1); if (edge_r!=0) { return 3; } return q*10+r; }\n",".");
    let div_eff:map.StringMap[i32]=analyze(div_unit.decls);
    let div_ir:ZirAuthority=zir_prepare_production_with_origins(div_unit.decls,div_eff,div_unit.origins);
    let div_err:i32=0;let div_data:ArrayList[u8]=make[u8](1);let div_route:i32=0;
    let div_raw:ArrayList[Instr]=lower_zir_program_mode_cpu_with_route(div_ir,&div_err,&div_data,
        0,0,0,0,0,0,0,&div_route);
    if(div_err!=0){_zag_eprintln("defined ZIR division lowering reported an error");return 1;}
    if(div_route!=1){_zag_eprintln("defined ZIR division direct route was not selected");return 1;}
    if(div_data.len!=24){_zag_eprintln("defined ZIR division panic data was not interned exactly once");return 1;}
    let div_allocated:ArrayList[Instr]=regalloc(div_raw);let div_optimized:ArrayList[Instr]=optimize(div_allocated);
    let div_final:ArrayList[Instr]=peephole(div_optimized);let div_code:ArrayList[u8]=encode(div_final);
    if(write_elf_exec_data(zir_witness_path(out_dir,"native-div"),div_code,0,div_data)!=0){return 1;}

    let zero_unit:CompilationUnit=parse_compilation_unit_dir("fn main() i32 { return 1/0; }\n",".");
    let zero_eff:map.StringMap[i32]=analyze(zero_unit.decls);
    let zero_ir:ZirAuthority=zir_prepare_production_with_origins(zero_unit.decls,zero_eff,zero_unit.origins);
    let zero_err:i32=0;let zero_data:ArrayList[u8]=make[u8](1);let zero_route:i32=0;
    let zero_raw:ArrayList[Instr]=lower_zir_program_mode_cpu_with_route(zero_ir,&zero_err,&zero_data,
        0,0,0,0,0,0,0,&zero_route);
    if(zero_err!=0){_zag_eprintln("divide-by-zero ZIR lowering reported an error");return 1;}
    if(zero_route!=1){_zag_eprintln("divide-by-zero ZIR direct route was not selected");return 1;}
    if(zero_data.len!=24){_zag_eprintln("divide-by-zero ZIR panic data was not interned exactly once");return 1;}
    let zero_allocated:ArrayList[Instr]=regalloc(zero_raw);let zero_optimized:ArrayList[Instr]=optimize(zero_allocated);
    let zero_final:ArrayList[Instr]=peephole(zero_optimized);let zero_code:ArrayList[u8]=encode(zero_final);
    if(write_elf_exec_data(zir_witness_path(out_dir,"native-divzero"),zero_code,0,zero_data)!=0){return 1;}
    let void_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn bump(x:i32) i32 { return x+1; } fn touch(x:i32) void { return; } fn main() i32 { let value:i32=bump(20); value=bump(value); touch(0); bump(1); if (value!=22) { return 9; } return 44; }\n",".");
    let void_eff:map.StringMap[i32]=analyze(void_unit.decls);
    let void_ir:ZirAuthority=zir_prepare_production_with_origins(void_unit.decls,void_eff,void_unit.origins);
    let void_err:i32=0;let void_data:ArrayList[u8]=make[u8](1);let void_route:i32=0;
    let void_raw:ArrayList[Instr]=lower_zir_program_mode_cpu_with_route(void_ir,&void_err,&void_data,
        0,0,0,0,0,0,0,&void_route);
    if(void_err!=0){_zag_eprintln("void-return/direct expression statement route reported an error");return 1;}
    if(void_route!=1){_zag_eprintln("void-return expression-statement direct route was not selected");return 1;}
    let void_allocated:ArrayList[Instr]=regalloc(void_raw);let void_optimized:ArrayList[Instr]=optimize(void_allocated);
    let void_final:ArrayList[Instr]=peephole(void_optimized);let void_code:ArrayList[u8]=encode(void_final);
    if(write_elf_exec(zir_witness_path(out_dir,"native-void"),void_code,0)!=0){return 1;}
    let numeric_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i32 { return (200 as sat_i8) as i32; }\n",".");
    let numeric_eff:map.StringMap[i32]=analyze(numeric_unit.decls);
    let numeric_ir:ZirAuthority=zir_prepare_production_with_origins(
        numeric_unit.decls,numeric_eff,numeric_unit.origins);
    if(zir_native_subset_supported(numeric_ir)!=0){
        _zag_eprintln("specialized numeric syntax escaped the checked fallback");return 1;
    }
    _zag_println("zir native backend route=if,mutable-loop,break,continue,switch,source-order-shadow,raw-production-and-source-policy-i32-add,defined-div-rem,void-return,estmt fallback=numeric,i64-contexts,untyped-let,read-before-declaration");return 0;
}
