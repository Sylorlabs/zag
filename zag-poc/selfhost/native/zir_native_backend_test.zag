       zir_native_subset_supported(overflow_source_policy_candidate)!=1||
       zir_native_subset_supported(mutated_source_policy_candidate)!=0){
        _zag_eprintln("raw/source-policy/structural i32 add selection boundary failed");return 1;}

    let baseline_err:i32=0;let baseline_data:ArrayList[u8]=make[u8](1);
    let baseline_route:i32=0;
    let baseline_raw:ArrayList[Instr]=lower_zir_program_mode_cpu_with_route(
        overflow_baseline,&baseline_err,&baseline_data,0,0,0,0,0,0,0,&baseline_route);
    if(baseline_err!=0||baseline_route!=1){
        _zag_eprintln("raw i32 overflow fallback did not select direct ZIR lowering");return 1;}
    let baseline_allocated:ArrayList[Instr]=regalloc(baseline_raw);
    let baseline_optimized:ArrayList[Instr]=optimize(baseline_allocated);
    let baseline_final:ArrayList[Instr]=peephole(baseline_optimized);
    let baseline_code:ArrayList[u8]=encode(baseline_final);
    if(write_elf_exec(zir_witness_path(out_dir,"raw-overflow"),baseline_code,0)!=0){return 1;}

    let overflow_err:i32=0;let overflow_data:ArrayList[u8]=make[u8](1);
    let overflow_route:i32=0;
    let overflow_raw:ArrayList[Instr]=lower_zir_program_mode_cpu_with_route(
        overflow_ir,&overflow_err,&overflow_data,0,0,0,0,0,0,0,&overflow_route);
    if(overflow_err!=0||overflow_route!=1){
        _zag_eprintln("i32 overflow comparison did not select direct ZIR lowering");return 1;}
    let overflow_allocated:ArrayList[Instr]=regalloc(overflow_raw);
    let overflow_optimized:ArrayList[Instr]=optimize(overflow_allocated);
    let overflow_final:ArrayList[Instr]=peephole(overflow_optimized);
    let overflow_code:ArrayList[u8]=encode(overflow_final);
    if(write_elf_exec(zir_witness_path(out_dir,"production-overflow"),overflow_code,0)!=0){return 1;}

    let candidate_err:i32=0;let candidate_data:ArrayList[u8]=make[u8](1);
    let candidate_route:i32=0;
    let candidate_raw:ArrayList[Instr]=lower_zir_program_mode_cpu_with_route(
        overflow_source_policy_candidate,&candidate_err,&candidate_data,0,0,0,0,0,0,0,&candidate_route);
    if(candidate_err!=0||candidate_route!=1){
        _zag_eprintln("source-policy checked candidate did not select direct ZIR lowering");return 1;}
    let candidate_alloc:ArrayList[Instr]=regalloc(candidate_raw);
    let candidate_opt:ArrayList[Instr]=optimize(candidate_alloc);
    let candidate_final:ArrayList[Instr]=peephole(candidate_opt);
    let candidate_code:ArrayList[u8]=encode(candidate_final);
    if(write_elf_exec(zir_witness_path(out_dir,"source-policy-candidate-overflow"),candidate_code,0)!=0){return 1;}

    // The bool predicate handoff is likewise opt-in and source/policy bound:
    // exact `true == false` becomes one bool constant, while the enclosing
    // if and native route remain unchanged and executable.
    let bool_source:[]u8="fn main() i32 { let flag:bool=true == false; if (flag) { return 1; } return 42; }\n";
    let bool_unit:CompilationUnit=parse_compilation_unit_dir(bool_source,".");
    let bool_eff:map.StringMap[i32]=analyze(bool_unit.decls);
    let bool_candidate:ZirAuthority=zir_prepare_const_bool_cmp_source_policy_with_origins(
        bool_unit.decls,bool_eff,bool_unit.origins,zir_transform_policy_const_bool_cmp_default());
    if(bool_candidate.transform_count!=1||
       !@strEq(bool_candidate.transform_status,"foreground_bool_source_policy_checked")||
       bool_candidate.certificate.result_value!=0||zir_native_subset_supported(bool_candidate)!=1){
        _zag_eprintln("source-policy checked bool predicate did not select direct ZIR lowering");return 1;}
    let bool_err:i32=0;let bool_data:ArrayList[u8]=make[u8](1);let bool_route:i32=0;
    let bool_raw:ArrayList[Instr]=lower_zir_program_mode_cpu_with_route(
        bool_candidate,&bool_err,&bool_data,0,0,0,0,0,0,0,&bool_route);
    if(bool_err!=0||bool_route!=1){_zag_eprintln("bool predicate candidate route failed");return 1;}
    let bool_alloc:ArrayList[Instr]=regalloc(bool_raw);let bool_opt:ArrayList[Instr]=optimize(bool_alloc);
    let bool_final:ArrayList[Instr]=peephole(bool_opt);let bool_code:ArrayList[u8]=encode(bool_final);
    if(write_elf_exec(zir_witness_path(out_dir,"source-policy-bool-candidate"),bool_code,0)!=0){return 1;}

    let oracle_err:i32=0;let oracle_data:ArrayList[u8]=make[u8](1);
    let oracle_raw:ArrayList[Instr]=lower_program_mode_cpu(overflow_unit.decls,
        &oracle_err,&oracle_data,0,0,0,0,0,0,0);
    if(oracle_err!=0){_zag_eprintln("i32 overflow AST oracle lowering failed");return 1;}
    let oracle_allocated:ArrayList[Instr]=regalloc(oracle_raw);
    let oracle_optimized:ArrayList[Instr]=optimize(oracle_allocated);
    let oracle_final:ArrayList[Instr]=peephole(oracle_optimized);
    let oracle_code:ArrayList[u8]=encode(oracle_final);
    if(write_elf_exec(zir_witness_path(out_dir,"ast-overflow"),oracle_code,0)!=0){return 1;}

    if(zir_emit_direct_pair(out_dir,"i64-let",
        "fn main() i32 { let wide:i64=2147483647+1; if (wide>0) { return 42; } return 1; }\n")!=0){return 1;}
    if(zir_emit_direct_pair(out_dir,"i64-return",
        "fn wide() i64 { return 2147483647+1; } fn main() i32 { if (wide()>0) { return 42; } return 1; }\n")!=0){return 1;}
    if(zir_emit_direct_pair(out_dir,"i64-param",
        "fn accept(x:i64) i32 { if (x==2147483648) { return 42; } return 1; } fn main() i32 { return accept(2147483647+1); }\n")!=0){return 1;}
    if(zir_emit_direct_pair(out_dir,"i64-mutable",
        "fn main() i32 { let wide:i64=0; wide=2147483647+1; if (wide>0) { return 42; } return 1; }\n")!=0){return 1;}
    if(zir_emit_direct_pair(out_dir,"i64-div",
        "fn quotient(a:i64,b:i64) i64 { return a/b; } fn remainder(a:i64,b:i64) i64 { return a%b; } fn main() i32 { let q:i64=quotient(20,3); let r:i64=remainder(20,3); if (q==6) { if (r==2) { return 42; } } return 1; }\n")!=0){return 1;}
    // The direct arithmetic route also handles defined i32 signed division
    // and remainder. Exercise both operations through production ZIR and the
    // AST oracle, then reject a forged mixed-width operand before emission.
    let i32_div_source:[]u8=
        "fn quotient(a:i32,b:i32) i32 { return a/b; } fn remainder(a:i32,b:i32) i32 { return a%b; } fn main() i32 { let q:i32=quotient(20,3); let r:i32=remainder(20,3); if (q==6) { if (r==2) { return 42; } } return 1; }\n";
    if(zir_emit_direct_pair(out_dir,"i32-div-rem",i32_div_source)!=0){return 1;}
    let i32_div_bad_unit:CompilationUnit=parse_compilation_unit_dir(i32_div_source,".");
    let i32_div_bad_eff:map.StringMap[i32]=analyze(i32_div_bad_unit.decls);
    let i32_div_bad_ir:ZirAuthority=zir_prepare_production_with_origins(
        i32_div_bad_unit.decls,i32_div_bad_eff,i32_div_bad_unit.origins);
    let i32_div_bad:ZModule=zir_clone_module(i32_div_bad_ir.module);
    let i32_div_bad_mutated:i32=0;let idi:i32=0;
    while(idi<i32_div_bad.funcs.data[0].body.ops.len){
        let dop:ZOp=i32_div_bad.funcs.data[0].body.ops.data[idi];
        if(@strEq(dop.name,"arith.divsi")||@strEq(dop.name,"arith.remsi")){
            i32_div_bad.funcs.data[0].body.ops.data[idi].operands.data[1].ty="i64";
            i32_div_bad_mutated=1;
        }idi=idi+1;
    }
    if(i32_div_bad_mutated!=1||zir_native_module_subset_supported(i32_div_bad)!=0){
        _zag_eprintln("native signed division admission accepted mismatched widths");return 1;
    }
    // f32/f64 values use the same canonical double-bit representation as the
    // mature AST backend.  This bounded witness exercises direct ZIR constant,
    // add/multiply/divide, cmpf, and an internal f64 parameter/return call; the
    // public process entry remains an integer-returning main.
    if(zir_emit_direct_pair(out_dir,"f64-arithmetic",
        "fn twice(x:f64) f64 { return x*2.0; } fn main() i32 { let a:f64=1.5; let b:f64=2.25; let sum:f64=a+b; let scaled:f64=twice(sum); let quotient:f64=scaled/1.5; if (scaled==7.5) { if (quotient==5.0) { return 42; } } return 1; }\n")!=0){return 1;}
    // Native float slots use IEEE-double bits for both source float types, so
    // do not claim general f32 rounding here. This finite fixture uses values
    // and results exactly representable in f32, making the direct result safe
    // to compare with the checked AST oracle. Forged widths remain rejected.
    let f32_arithmetic_source:[]u8=
        "fn twice(x:f32) f32 { return x*2.0; } fn main() i32 { let a:f32=1.5; let b:f32=2.25; let sum:f32=a+b; let scaled:f32=twice(sum); let quotient:f32=scaled/1.5; if (scaled==7.5) { if (quotient==5.0) { return 42; } } return 1; }\n";
    if(zir_emit_direct_pair(out_dir,"f32-arithmetic",f32_arithmetic_source)!=0){return 1;}
    if(zir_emit_direct_pair(out_dir,"f64-negf",
        "fn negate(x:f64) f64 { return -x; } fn main() i32 { let x:f64=41.5; let y:f64=negate(x); if (y==-41.5) { return 42; } return 1; }\n")!=0){return 1;}
    if(zir_emit_direct_pair(out_dir,"f32-negf",
        "fn negate(x:f32) f32 { return -x; } fn main() i32 { let x:f32=41.5; let y:f32=negate(x); if (y==-41.5) { return 42; } return 1; }\n")!=0){return 1;}
    let f32_arithmetic_unit:CompilationUnit=parse_compilation_unit_dir(f32_arithmetic_source,".");
    let f32_arithmetic_eff:map.StringMap[i32]=analyze(f32_arithmetic_unit.decls);
    let f32_arithmetic_ir:ZirAuthority=zir_prepare_production_with_origins(
        f32_arithmetic_unit.decls,f32_arithmetic_eff,f32_arithmetic_unit.origins);
    let f32_arithmetic_bad:ZModule=zir_clone_module(f32_arithmetic_ir.module);
    let f32_arithmetic_bad_mutated:i32=0;let fai:i32=0;
    while(fai<f32_arithmetic_bad.funcs.data[0].body.ops.len){
        let op:ZOp=f32_arithmetic_bad.funcs.data[0].body.ops.data[fai];
        if(@strEq(op.name,"arith.addf")||@strEq(op.name,"arith.subf")||
           @strEq(op.name,"arith.mulf")||@strEq(op.name,"arith.divf")){
            f32_arithmetic_bad.funcs.data[0].body.ops.data[fai].operands.data[1].ty="f64";
            f32_arithmetic_bad_mutated=1;
        }fai=fai+1;
    }
    if(f32_arithmetic_bad_mutated!=1||zir_native_module_subset_supported(f32_arithmetic_bad)!=0){
        _zag_eprintln("native f32 arithmetic admission accepted mismatched float widths");return 1;
    }
    let negf_source:[]u8="fn negate(x:f64) f64 { return -x; } fn main() i32 { return negate(1.0) as i32; }\n";
    let negf_unit:CompilationUnit=parse_compilation_unit_dir(negf_source,".");
    let negf_eff:map.StringMap[i32]=analyze(negf_unit.decls);
    let negf_ir:ZirAuthority=zir_prepare_production_with_origins(negf_unit.decls,negf_eff,negf_unit.origins);
    let negf_bad:ZirAuthority=negf_ir;let nfi:i32=0;let negf_mutated:i32=0;
    while(nfi<negf_bad.module.funcs.data[0].body.ops.len){
        let no:ZOp=negf_bad.module.funcs.data[0].body.ops.data[nfi];
        if(@strEq(no.name,"arith.negf")){negf_bad.module.funcs.data[0].body.ops.data[nfi].results.data[0].ty="f32";negf_mutated=1;}
        nfi=nfi+1;
    }
    if(negf_mutated!=1||zir_native_subset_supported(negf_bad)!=0){
        _zag_eprintln("native negf admission accepted mismatched float result width");return 1;
    }
    if(zir_emit_direct_pair(out_dir,"untyped-let",
        "fn main() i32 { let answer=40+2; return answer; }\n")!=0){return 1;}
    if(zir_emit_direct_pair(out_dir,"untyped-nullary-call",
        "fn value() i32 { return 40; } fn main() i32 { let answer=value(); return answer+2; }\n")!=0){return 1;}
    if(zir_emit_direct_pair(out_dir,"untyped-call",
        "fn value(x:i32) i32 { return x; } fn main() i32 { let answer=value(40); return answer+2; }\n")!=0){return 1;}
    if(zir_emit_direct_pair(out_dir,"source-order-shadow",
        "fn bump(x:i32) i32 { let x:i32=x+1; x=x+1; return x; } fn main() i32 { return bump(40); }\n")!=0){return 1;}
    // Region-local immutable scalar lets use the same direct route as their
    // AST oracle.  The cases intentionally cover each child-region shape and
    // outer shadow restoration; mutable state remains only in the enclosing
    // body where its existing alloca proof applies.
    if(zir_emit_direct_pair(out_dir,"if-branch-local",
        "fn main() i32 { let base:i32=40; if (base==40) { let local:i32=2; if (local==2) { return base+local; } } return 1; }\n")!=0){return 1;}
    // Explicit scalar casts are already represented as `zag.cast` in ZIR;
    // keep one child-region witness so this direct route does not silently
    // regress when nested immutable/function bindings are expanded.
    if(zir_emit_direct_pair(out_dir,"nested-scalar-cast",
        "fn main() i32 { if (true) { let wide:i64=(40 as i64); let narrow:i32=(wide as i32); return narrow+2; } return 1; }\n")!=0){return 1;}
    if(zir_emit_direct_pair(out_dir,"while-body-local",
        "fn main() i32 { let i:i32=0; let total:i32=0; while (i<2) { let step:i32=21; total=total+step; i=i+1; } return total; }\n")!=0){return 1;}
    if(zir_emit_direct_pair(out_dir,"switch-arm-local",
        "fn main() i32 { let tag:i32=2; switch (tag) { 2 => { let arm:i32=40; return arm+2; } else => { let fallback:i32=1; return fallback; } } return 0; }\n")!=0){return 1;}
    // `unsafe` is an edition-2027 effect domain and is intentionally outside
    // the regular direct-ZIR subset. Its lexical builder path is exercised,
    // but native admission remains on the checked route until unsafe
    // effects/capabilities are represented in the production ABI.
    if(zir_expect_subset_bridge("unsafe-local",
        "fn main() i32 { unsafe { let local:i32=40; return local+2; } return 1; }\n")!=0){return 1;}
    if(zir_emit_direct_pair(out_dir,"shadow-restoration",
        "fn main() i32 { let value:i32=40; if (true) { let value:i32=1; if (value!=1) { return 1; } } return value+2; }\n")!=0){return 1;}
    if(zir_emit_direct_pair(out_dir,"bool-logic",
        "fn main() i32 { let a:bool=!false; let b:bool=a&&true; if (b||false) { return 42; } return 1; }\n")!=0){return 1;}
    if(zir_expect_scope_bridge("if-use-after-branch",
        "fn main() i32 { if (true) { let branch:i32=42; } return branch; }\n")!=0){return 1;}
    if(zir_expect_scope_bridge("if-sibling-leak",
        "fn main() i32 { if (true) { let branch:i32=41; } else { return branch+1; } return 1; }\n")!=0){return 1;}
    if(zir_expect_scope_bridge("while-use-after-body",
        "fn main() i32 { while (false) { let branch:i32=42; } return branch; }\n")!=0){return 1;}
    if(zir_expect_scope_bridge("switch-use-after-arm",
        "fn main() i32 { switch (1) { 1 => { let arm:i32=42; } else => { return 1; } } return arm; }\n")!=0){return 1;}
    if(zir_expect_subset_bridge("nested-aggregate",
        "struct Pair { left:i32, right:i32 } fn main() i32 { if (true) { let pair:Pair=Pair{ .left=40, .right=2 }; return pair.left+pair.right; } return 1; }\n")!=0){return 1;}
    if(zir_emit_direct_pair(out_dir,"nested-function-value",
        "fn value() i32 { return 42; } fn main() i32 { if (true) { let f:fn() i32=value; return f(); } return 1; }\n")!=0){return 1;}
    if(zir_expect_subset_bridge("nested-captured-function-value",
        "fn main() i32 { let base:i32=40; if (true) { let f:fn() i32=fn[base]() i32 { return base+2; }; return f(); } return 1; }\n")!=0){return 1;}
    if(zir_expect_subset_bridge("nested-generic-call",
        "fn identity[T](value:T) T { return value; } fn main() i32 { if (true) { let answer:i32=identity[i32](42); return answer; } return 1; }\n")!=0){return 1;}
    if(zir_expect_subset_bridge("nested-async-call",
        "async fn worker(x:i64) i64 { return x+1; } fn main() i32 { if (true) { let handle:*opaque=worker(41); return 42; } return 1; }\n")!=0){return 1;}
    if(zir_expect_subset_bridge("nested-resource-value",
        "@import(\"std:list\") @resource struct Frame { bytes: @owned(free) ArrayList[u8] } fn make_frame() Frame { return Frame{ .bytes=make[u8](1) }; } fn main() i32 { if (true) { let frame:Frame=make_frame(); return 42; } return 1; }\n")!=0){return 1;}
    if(zir_expect_subset_bridge("nested-noncanonical-cast",
        "fn main() i32 { if (true) { let value:i32=(200 as sat_i8) as i32; return value; } return 1; }\n")!=0){return 1;}
    let early_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i32 { if (x==0) { return 42; } let x:i32=1; x=2; return x; }\n",".");
    let early_eff:map.StringMap[i32]=analyze(early_unit.decls);
    let early_ir:ZirAuthority=zir_prepare_production_with_origins(
        early_unit.decls,early_eff,early_unit.origins);
    if(early_ir.coverage_complete!=0||early_ir.coverage_errors==0||
       !@strEq(early_ir.transform_status,"verified_raw_ast_bridge_incomplete")||
       zir_native_subset_supported(early_ir)!=0){
        _zag_eprintln("read-before-declaration escaped fail-closed ZIR coverage");return 1;}

    let div_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn wrap(x:i32) i32 { return x+1; } fn quotient(a:i32,b:i32) i32 { return a/b; } fn remainder(a:i32,b:i32) i32 { return a%b; } fn main() i32 { let max:i32=2147483647; let wrapped:i32=wrap(max); if (wrapped>=0) { return 1; } let q:i32=quotient(20,3); let r:i32=remainder(20,3); let edge:i32=quotient(wrapped,-1); if (edge!=wrapped) { return 2; } let edge_r:i32=remainder(wrapped,-1); if (edge_r!=0) { return 3; } return q*10+r; }\n",".");
    let div_eff:map.StringMap[i32]=analyze(div_unit.decls);
    let div_ir:ZirAuthority=zir_prepare_production_with_origins(div_unit.decls,div_eff,div_unit.origins);
    let div_err:i32=0;let div_data:ArrayList[u8]=make[u8](1);let div_route:i32=0;
    let div_raw:ArrayList[Instr]=lower_zir_program_mode_cpu_with_route(div_ir,&div_err,&div_data,
        0,0,0,0,0,0,0,&div_route);
    if(div_err!=0){_zag_eprintln("defined ZIR division lowering reported an error");return 1;}
    if(div_route!=1){_zag_eprintln("defined ZIR division direct route was not selected");return 1;}
    if(div_data.len!=24){_zag_eprintln("defined ZIR division panic data was not interned exactly once");return 1;}
    let div_allocated:ArrayList[Instr]=regalloc(div_raw);let div_optimized:ArrayList[Instr]=optimize(div_allocated);
    let div_final:ArrayList[Instr]=peephole(div_optimized);let div_code:ArrayList[u8]=encode(div_final);
    if(write_elf_exec_data(zir_witness_path(out_dir,"native-div"),div_code,0,div_data)!=0){return 1;}
    // Emit the mature AST oracle for the same defined division/remainder
    // boundary, including MIN_INT/-1 behavior, so native results are checked
    // against an independent lowering rather than only a hand-built ZIR path.
    let div_oracle_err:i32=0;let div_oracle_data:ArrayList[u8]=make[u8](1);
    let div_oracle_raw:ArrayList[Instr]=lower_program_mode_cpu(div_unit.decls,&div_oracle_err,
        &div_oracle_data,0,0,0,0,0,0,0);
    if(div_oracle_err!=0){_zag_eprintln("defined division AST oracle lowering reported an error");return 1;}
    let div_oracle_allocated:ArrayList[Instr]=regalloc(div_oracle_raw);
    let div_oracle_optimized:ArrayList[Instr]=optimize(div_oracle_allocated);
    let div_oracle_final:ArrayList[Instr]=peephole(div_oracle_optimized);
    let div_oracle_code:ArrayList[u8]=encode(div_oracle_final);
    if(write_elf_exec_data(zir_witness_path(out_dir,"ast-div"),div_oracle_code,0,div_oracle_data)!=0){return 1;}

    let zero_unit:CompilationUnit=parse_compilation_unit_dir("fn main() i32 { return 1/0; }\n",".");
    let zero_eff:map.StringMap[i32]=analyze(zero_unit.decls);
    let zero_ir:ZirAuthority=zir_prepare_production_with_origins(zero_unit.decls,zero_eff,zero_unit.origins);
    let zero_err:i32=0;let zero_data:ArrayList[u8]=make[u8](1);let zero_route:i32=0;
    let zero_raw:ArrayList[Instr]=lower_zir_program_mode_cpu_with_route(zero_ir,&zero_err,&zero_data,
        0,0,0,0,0,0,0,&zero_route);
    if(zero_err!=0){_zag_eprintln("divide-by-zero ZIR lowering reported an error");return 1;}
    if(zero_route!=1){_zag_eprintln("divide-by-zero ZIR direct route was not selected");return 1;}
    if(zero_data.len!=24){_zag_eprintln("divide-by-zero ZIR panic data was not interned exactly once");return 1;}
    let zero_allocated:ArrayList[Instr]=regalloc(zero_raw);let zero_optimized:ArrayList[Instr]=optimize(zero_allocated);
    let zero_final:ArrayList[Instr]=peephole(zero_optimized);let zero_code:ArrayList[u8]=encode(zero_final);
    if(write_elf_exec_data(zir_witness_path(out_dir,"native-divzero"),zero_code,0,zero_data)!=0){return 1;}
    let void_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn bump(x:i32) i32 { return x+1; } fn touch(x:i32) void { return; } fn main() i32 { let value:i32=bump(20); value=bump(value); touch(0); bump(1); if (value!=22) { return 9; } return 44; }\n",".");
    let void_eff:map.StringMap[i32]=analyze(void_unit.decls);
    let void_ir:ZirAuthority=zir_prepare_production_with_origins(void_unit.decls,void_eff,void_unit.origins);
    let void_err:i32=0;let void_data:ArrayList[u8]=make[u8](1);let void_route:i32=0;
    let void_raw:ArrayList[Instr]=lower_zir_program_mode_cpu_with_route(void_ir,&void_err,&void_data,
        0,0,0,0,0,0,0,&void_route);
    if(void_err!=0){_zag_eprintln("void-return/direct expression statement route reported an error");return 1;}
    if(void_route!=1){_zag_eprintln("void-return expression-statement direct route was not selected");return 1;}
    let void_allocated:ArrayList[Instr]=regalloc(void_raw);let void_optimized:ArrayList[Instr]=optimize(void_allocated);
    let void_final:ArrayList[Instr]=peephole(void_optimized);let void_code:ArrayList[u8]=encode(void_final);
    if(write_elf_exec(zir_witness_path(out_dir,"native-void"),void_code,0)!=0){return 1;}
    let numeric_unit:CompilationUnit=parse_compilation_unit_dir(
        "fn main() i32 { return (200 as sat_i8) as i32; }\n",".");
    let numeric_eff:map.StringMap[i32]=analyze(numeric_unit.decls);
    let numeric_ir:ZirAuthority=zir_prepare_production_with_origins(
        numeric_unit.decls,numeric_eff,numeric_unit.origins);
    if(zir_native_subset_supported(numeric_ir)!=0){
        _zag_eprintln("specialized numeric syntax escaped the checked fallback");return 1;
    }
    _zag_println("zir native backend route=if,mutable-loop,break,continue,switch,i64-arithmetic-constant-call,source-order-shadow,inferred-i32-literal,inferred-i32-nullary-call,inferred-i32-three-arg-call,inferred-i32-four-arg-call,inferred-i32-five-arg-call,inferred-i32-six-arg-call,inferred-i32-seven-arg-stack-call,inferred-i64-three-arg-call,inferred-i64-four-arg-call,inferred-i64-five-arg-call,inferred-i64-six-arg-call,inferred-i64-seven-arg-stack-call,typed-i32-negsi,typed-i64-negsi,typed-i32-xori,typed-i64-xori,typed-i32-andsi,typed-i64-andsi,typed-i32-orsi,typed-i64-orsi,typed-i32-shli,typed-i64-shrsi,typed-i32-cmpi-eq,typed-i64-cmpi-ge,typed-i64-cmpi-all,typed-f64-cmpf-all,typed-f32-cmpf-all,typed-i32-div-rem,invalid-shift-count-rejected,unsupported-cmpi-width-rejected,mismatched-cmpi-width-rejected,mismatched-cmpf-width-rejected,mismatched-f32-cmpf-width-rejected,mismatched-div-width-rejected,qualified-imported-i32-i64-calls,named-captureless-function-value,f64-arithmetic,raw-production-and-source-policy-i32-add,defined-div-rem,defined-div-rem-ast-differential,void-return,estmt fallback=numeric,unqualified-or-incomplete-imported-calls,inferred-eight-arg-call");return 0;
}
