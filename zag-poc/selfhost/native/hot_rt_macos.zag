// Native macOS/Apple-Silicon live-reload runtime.
//
// This is deliberately separate from hot_rt.zag: it uses Mach-O PIE image
// discovery, Darwin mprotect/nanosleep syscalls, 16 KiB ARM64 pages, and the
// documented libSystem instruction-cache invalidation API. No ELF address,
// Linux syscall number, or emulation path is shared with this implementation.

extern fn _zag_darwin_syscall(num:i64,a1:i64,a2:i64,a3:i64,a4:i64,a5:i64,a6:i64)i64
extern fn _zag_code_anchor() i64
extern fn _zag_slice_ptr(s:[]u8)*i8
extern fn _zag_read_file(path:[]u8)[]u8
extern fn _zag_write_file(path:[]u8,content:[]u8)i32
extern fn _zag_file_exists(path:[]u8)i32
extern fn sys_icache_invalidate(start:*i8,len:i64) void

fn HM_PAGE()i64{return 16384;}
fn HM_CODE_OFF()i64{return 4096;}
fn HM_PATCH()[]u8{return ".zag_hotpatch";}
fn HM_STOP()[]u8{return ".zag_hotstop";}

struct HMTimespec { sec:i64, nsec:i64 }

// Scan backwards from an ADR-derived executable address to the mapped Mach-O
// header. `feedfacf` is little-endian as cf fa ed fe in memory.  The loader
// slide is therefore discovered from the live process, not guessed.
fn hm_image_base()i64{
    let p:i64=_zag_code_anchor();
    p=p-(p%HM_PAGE());
    while(p>=HM_PAGE()){
        let b:*u8=p as *u8;
        if(b[0]==207 as u8&&b[1]==250 as u8&&b[2]==237 as u8&&b[3]==254 as u8){return p;}
        p=p-HM_PAGE();
    }
    return 0;
}

fn hm_sleep(ms:i64)void{
    let ts:HMTimespec=HMTimespec{.sec=ms/1000,.nsec=(ms%1000)*1000000};
    let _rc:i64=_zag_darwin_syscall(240,(&ts) as i64,0,0,0,0,0);
}

fn hm_apply(code:[]u8)i32{
    let n:i32=code.len;
    let image:i64=hm_image_base();
    if(image==0||n<=0){return 0;}
    // The encoder pads hot __text through a VM boundary. Its 4 KiB header-page
    // suffix is intentionally immutable; every following patch unit is one
    // complete, destination-aligned Apple-Silicon page.
    if((HM_CODE_OFF()+(n as i64))%HM_PAGE()!=0){return 0;}
    let first:i32=(HM_PAGE()-HM_CODE_OFF()) as i32;
    if(n<first){return 0;}
    let text:*i8=(image+HM_CODE_OFF()) as *i8;
    let src:*i8=_zag_slice_ptr(code);
    let patcher:i64=_zag_code_anchor();
    let patcher_page:i64=patcher-(patcher%HM_PAGE());
    let text_end:i64=image+HM_CODE_OFF()+(n as i64);
    // A hot encoder must have placed this source-function entry exactly at a
    // page boundary within the complete-page region. Fail closed on a regular
    // or otherwise incompatible image before changing any protection.
    if(patcher!=patcher_page||patcher_page<image+HM_PAGE()||patcher_page>=text_end){return 0;}

    // The patch does not contain the Mach-O header prefix, so page zero can be
    // verified but never partially replaced.
    let i:i32=0;
    while(i<first){if(text[i]!=src[i]){return 0;}i=i+1;}

    // Preflight every full page before the first mutation. In particular, a
    // patch that changes hm_apply's currently executing page is rejected as a
    // whole instead of partially applying earlier pages first.
    let off:i32=first;
    while(off<n){
        if(off+(HM_PAGE() as i32)>n){return 0;}
        let page_addr:i64=image+HM_CODE_OFF()+(off as i64);
        if(page_addr%HM_PAGE()!=0){return 0;}
        let dst:*i8=page_addr as *i8;
        let different:i32=0;
        let j:i32=0;
        while(j<HM_PAGE() as i32){if(dst[j]!=src[off+j]){different=1;}j=j+1;}
        if(different==1&&page_addr==patcher_page){return 0;}
        off=off+(HM_PAGE() as i32);
    }

    // Darwin SYS_mprotect is 74. Changed nonexecuting pages transition RX->RW,
    // receive exactly 16 KiB, return to RX, and only then have their I-cache
    // invalidated. No page is simultaneously writable and executable.
    off=first;
    while(off<n){
        let page_addr:i64=image+HM_CODE_OFF()+(off as i64);
        let dst:*i8=page_addr as *i8;
        let different:i32=0;
        let j:i32=0;
        while(j<HM_PAGE() as i32){if(dst[j]!=src[off+j]){different=1;}j=j+1;}
        if(different==1){
            if(_zag_darwin_syscall(74,page_addr,HM_PAGE(),3,0,0,0)!=0){return 0;}
            j=0;
            while(j<HM_PAGE() as i32){dst[j]=src[off+j];j=j+1;}
            if(_zag_darwin_syscall(74,page_addr,HM_PAGE(),5,0,0,0)!=0){return 0;}
            sys_icache_invalidate(dst,HM_PAGE());
        }
        off=off+(HM_PAGE() as i32);
    }
    return 1;
}

fn zag_hot_poll()i32{
    if(_zag_file_exists(HM_PATCH())==0){return 0;}
    let patch:[]u8=_zag_read_file(HM_PATCH());
    if(patch.len<=0){return 0;}
    let ok:i32=hm_apply(patch);
    // Preserve a failed patch for diagnosis/retry. Consuming bytes after an
    // mprotect or cache-synchronization failure makes the runtime look as if a
    // live replacement succeeded when the old text is still executing.
    if(ok==1){let _consumed:i32=_zag_write_file(HM_PATCH(),"");}
    return ok;
}

fn zag_hot_should_continue()bool{return _zag_file_exists(HM_STOP())==0;}
fn zag_hot_wait()void{let _applied:i32=zag_hot_poll();hm_sleep(200);}
