// Direct syscall implementation of the portable process wait ABI.
@import("aisa.zag")

// Input x0=fd (-1 means no descriptor), x1=milliseconds [0,60000].
// Output x0: 1=readable/HUP/error event, 0=timeout or EINTR, negative=error.
// The caller rechecks its monotonic deadline after EVERY return, including EINTR.
fn process_emit_wait_arm64(out: *ArrayList[AInstr], darwin: i32,
        retry: i32, invalid: i32, bad_fd: i32, done: i32) void {
    push[AInstr](out, ai_sub_imm(A_SP(), 32));
    push[AInstr](out, ai_cmp_imm(A_X0(), -1)); push[AInstr](out, ai_jl(invalid));
    push[AInstr](out, ai_cmp_imm(A_X0(), 2147483647)); push[AInstr](out, ai_jg(invalid));
    push[AInstr](out, ai_cmp_imm(A_X1(), 0)); push[AInstr](out, ai_jl(invalid));
    push[AInstr](out, ai_cmp_imm(A_X1(), 60000)); push[AInstr](out, ai_jg(invalid));
    // pollfd is exactly {i32 fd, i16 events, i16 revents} on both kernels.
    push[AInstr](out, ai_storew(A_SP(), 0, A_X0()));
    push[AInstr](out, ai_mov_imm(A_X9(), 1)); push[AInstr](out, ai_storeh(A_SP(), 4, A_X9()));
    push[AInstr](out, ai_mov_imm(A_X9(), 0)); push[AInstr](out, ai_storeh(A_SP(), 6, A_X9()));
    if (darwin == 1) {
        push[AInstr](out, ai_mov_rr(A_X2(), A_X1())); // poll timeout in ms
        push[AInstr](out, ai_mov_rr(A_X0(), A_SP()));
        push[AInstr](out, ai_mov_imm(A_X1(), 1));     // nfds
        push[AInstr](out, ai_darwin_syscall(230));   // explicit XNU namespace
    } else {
        // AArch64 Linux has ppoll, not poll. Supply a finite timespec and no
        // signal-mask change; ai_syscall uses the asm-generic ARM namespace.
        push[AInstr](out, ai_mov_imm(A_X9(), 1000));
        push[AInstr](out, ai_sdiv(A_X10(), A_X1(), A_X9()));
        push[AInstr](out, ai_store(A_SP(), 8, A_X10()));
        push[AInstr](out, ai_mul(A_X10(), A_X10(), A_X9()));
        push[AInstr](out, ai_sub(A_X1(), A_X10()));
        push[AInstr](out, ai_mov_imm(A_X9(), 1000000));
        push[AInstr](out, ai_mul(A_X1(), A_X1(), A_X9()));
        push[AInstr](out, ai_store(A_SP(), 16, A_X1()));
        push[AInstr](out, ai_mov_rr(A_X0(), A_SP()));
        push[AInstr](out, ai_mov_imm(A_X1(), 1));
        push[AInstr](out, ai_mov_rr(A_X2(), A_SP())); push[AInstr](out, ai_add_imm(A_X2(), 8));
        push[AInstr](out, ai_mov_imm(A_X3(), 0));
        push[AInstr](out, ai_mov_imm(A_X4(), 8));
        push[AInstr](out, ai_syscall(73));
    }
    push[AInstr](out, ai_cmp_imm(A_X0(), -4)); push[AInstr](out, ai_je(retry));
    push[AInstr](out, ai_cmp_imm(A_X0(), 0)); push[AInstr](out, ai_jle(done));
    push[AInstr](out, ai_loadh(A_X9(), A_SP(), 6));
    push[AInstr](out, ai_and_imm(A_X9(), 32)); // POLLNVAL is a failure, not readiness
    push[AInstr](out, ai_cmp_imm(A_X9(), 0)); push[AInstr](out, ai_jne(bad_fd));
    push[AInstr](out, ai_mov_imm(A_X0(), 1)); push[AInstr](out, ai_jmp(done));
    push[AInstr](out, ai_label(retry)); push[AInstr](out, ai_mov_imm(A_X0(), 0)); push[AInstr](out, ai_jmp(done));
    push[AInstr](out, ai_label(invalid)); push[AInstr](out, ai_mov_imm(A_X0(), -22)); push[AInstr](out, ai_jmp(done));
    push[AInstr](out, ai_label(bad_fd)); push[AInstr](out, ai_mov_imm(A_X0(), -9));
    push[AInstr](out, ai_label(done)); push[AInstr](out, ai_add_imm(A_SP(), 32));
}
