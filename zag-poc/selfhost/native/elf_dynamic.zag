// selfhost/native/elf_dynamic.zag — minimal ELF64 dynamic executable writer.
//
// This is the narrow system-ABI bridge used by Zag-native applications that
// need an installed shared library (for example libvulkan.so.1).  Zag still
// emits the executable itself: no cc/as/ld wrapper is involved.  The system
// ELF interpreter resolves explicitly declared scalar/pointer extern symbols
// into a bounded GOT at DYN_GOT_VADDR().

@import("elf.zag")

fn DYN_GOT_VADDR() i64 { return 150994944; } // 0x9000000
fn DYN_HDRS() i64 { return 512; }            // ELF header + 8 program headers
fn DYN_INTERP_LEN() i64 { return 28; }

fn dyn_align(v: i64, a: i64) i64 {
    return v + ((a - (v % a)) % a);
}

fn dyn_append(buf: *ArrayList[u8], src: ArrayList[u8]) void {
    let i: i32 = 0;
    while (i < src.len) { elf_eb(buf, get[u8](src, i) as i32); i = i + 1; }
}

fn dyn_append_slice(buf: *ArrayList[u8], src: []u8) void {
    let i: i32 = 0;
    while (i < src.len) { elf_eb(buf, src[i] as i32); i = i + 1; }
}

fn dyn_pad_to(buf: *ArrayList[u8], off: i64) void {
    while ((buf.*.len as i64) < off) { elf_eb(buf, 0); }
}

fn dyn_entry(buf: *ArrayList[u8], tag: i64, value: i64) void {
    elf_emit_le(buf, tag, 8);
    elf_emit_le(buf, value, 8);
}

fn dyn_phdr(buf: *ArrayList[u8], ptype: i64, flags: i64, off: i64,
            vaddr: i64, filesz: i64, memsz: i64, align: i64) void {
    elf_emit_le(buf, ptype, 4);
    elf_emit_le(buf, flags, 4);
    elf_emit_le(buf, off, 8);
    elf_emit_le(buf, vaddr, 8);
    elf_emit_le(buf, vaddr, 8);
    elf_emit_le(buf, filesz, 8);
    elf_emit_le(buf, memsz, 8);
    elf_emit_le(buf, align, 8);
}

// Emit an ET_EXEC with PT_INTERP and only the dynamic metadata needed for
// DT_NEEDED plus R_X86_64_GLOB_DAT relocations. `extern_syms` order is the GOT
// slot contract shared with ncodegen.zag.
fn write_elf_dynamic(path: []u8, text: ArrayList[u8], entry_off: i32,
                     app_data: ArrayList[u8], extern_syms: ArrayList[[]u8],
                     needed: ArrayList[[]u8]) i32 {
    let interp: []u8 = "/lib64/ld-linux-x86-64.so.2";
    let interp_off: i64 = DYN_HDRS();
    let code_off: i64 = DYN_HDRS() + DYN_INTERP_LEN();
    let code_filesz: i64 = code_off + (text.len as i64);
    let entry: i64 = VBASE() + code_off + (entry_off as i64);

    // Dynamic string table: NUL, DT_NEEDED names, then undefined symbol names.
    let dynstr: ArrayList[u8] = make[u8](128);
    elf_eb(&dynstr, 0);
    let needed_offs: ArrayList[i32] = make[i32](needed.len + 1);
    let ni: i32 = 0;
    while (ni < needed.len) {
        push[i32](&needed_offs, dynstr.len);
        dyn_append_slice(&dynstr, get[[]u8](needed, ni));
        elf_eb(&dynstr, 0);
        ni = ni + 1;
    }
    let sym_offs: ArrayList[i32] = make[i32](extern_syms.len + 1);
    let si: i32 = 0;
    while (si < extern_syms.len) {
        push[i32](&sym_offs, dynstr.len);
        dyn_append_slice(&dynstr, get[[]u8](extern_syms, si));
        elf_eb(&dynstr, 0);
        si = si + 1;
    }

    // ELF64 dynsym: mandatory null entry followed by undefined GLOBAL FUNCs.
    let dynsym: ArrayList[u8] = make[u8](24 * (extern_syms.len + 1));
    let z: i32 = 0;
    while (z < 24) { elf_eb(&dynsym, 0); z = z + 1; }
    si = 0;
    while (si < extern_syms.len) {
        elf_emit_le(&dynsym, get[i32](sym_offs, si) as i64, 4); // st_name
        elf_eb(&dynsym, 18);                                   // GLOBAL FUNC
        elf_eb(&dynsym, 0);                                    // st_other
        elf_emit_le(&dynsym, 0, 2);                            // SHN_UNDEF
        elf_emit_le(&dynsym, 0, 8);                            // st_value
        elf_emit_le(&dynsym, 0, 8);                            // st_size
        si = si + 1;
    }

    // One GOT relocation per symbol. r_info = sym_index<<32 + GLOB_DAT(6).
    let rela: ArrayList[u8] = make[u8](24 * extern_syms.len);
    si = 0;
    while (si < extern_syms.len) {
        elf_emit_le(&rela, DYN_GOT_VADDR() + ((si as i64) * 8), 8);
        elf_emit_le(&rela, (((si + 1) as i64) * 4294967296) + 6, 8);
        elf_emit_le(&rela, 0, 8);
        si = si + 1;
    }

    let data_file_off: i64 = dyn_align(code_filesz, PAGE());
    let dynstr_rel: i64 = dyn_align(app_data.len as i64, 8);
    let dynsym_rel: i64 = dyn_align(dynstr_rel + (dynstr.len as i64), 8);
    let rela_rel: i64 = dyn_align(dynsym_rel + (dynsym.len as i64), 8);
    let dynamic_rel: i64 = dyn_align(rela_rel + (rela.len as i64), 8);

    // Dynamic entries are built only after their virtual addresses are known.
    let dynamic: ArrayList[u8] = make[u8](256);
    ni = 0;
    while (ni < needed.len) {
        dyn_entry(&dynamic, 1, get[i32](needed_offs, ni) as i64); // DT_NEEDED
        ni = ni + 1;
    }
    dyn_entry(&dynamic, 5, DVBASE() + dynstr_rel);                // DT_STRTAB
    dyn_entry(&dynamic, 10, dynstr.len as i64);                   // DT_STRSZ
    dyn_entry(&dynamic, 6, DVBASE() + dynsym_rel);                // DT_SYMTAB
    dyn_entry(&dynamic, 11, 24);                                  // DT_SYMENT
    dyn_entry(&dynamic, 7, DVBASE() + rela_rel);                  // DT_RELA
    dyn_entry(&dynamic, 8, rela.len as i64);                      // DT_RELASZ
    dyn_entry(&dynamic, 9, 24);                                   // DT_RELAENT
    dyn_entry(&dynamic, 24, 0);                                   // DT_BIND_NOW
    dyn_entry(&dynamic, 0, 0);                                    // DT_NULL

    let data_filesz: i64 = dynamic_rel + (dynamic.len as i64);
    let got_file_off: i64 = dyn_align(data_file_off + data_filesz, PAGE());
    let got_filesz: i64 = (extern_syms.len as i64) * 8;
    let buf: ArrayList[u8] = make[u8]((got_file_off + got_filesz) as i32);

    // ELF64 header.
    elf_eb(&buf, 127); elf_eb(&buf, 69); elf_eb(&buf, 76); elf_eb(&buf, 70);
    elf_eb(&buf, 2); elf_eb(&buf, 1); elf_eb(&buf, 1); elf_eb(&buf, 0);
    let ei: i32 = 0;
    while (ei < 8) { elf_eb(&buf, 0); ei = ei + 1; }
    elf_emit_le(&buf, 2, 2); elf_emit_le(&buf, 62, 2); elf_emit_le(&buf, 1, 4);
    elf_emit_le(&buf, entry, 8); elf_emit_le(&buf, 64, 8); elf_emit_le(&buf, 0, 8);
    elf_emit_le(&buf, 0, 4); elf_emit_le(&buf, 64, 2); elf_emit_le(&buf, 56, 2);
    elf_emit_le(&buf, 8, 2); elf_emit_le(&buf, 0, 2); elf_emit_le(&buf, 0, 2);
    elf_emit_le(&buf, 0, 2);

    // Eight program headers: PHDR, INTERP, code, data, BSS, GOT, DYNAMIC, stack.
    dyn_phdr(&buf, 6, 4, 64, VBASE() + 64, 448, 448, 8);
    dyn_phdr(&buf, 3, 4, interp_off, VBASE() + interp_off, DYN_INTERP_LEN(), DYN_INTERP_LEN(), 1);
    dyn_phdr(&buf, 1, 5, 0, VBASE(), code_filesz, code_filesz, PAGE());
    dyn_phdr(&buf, 1, 4, data_file_off, DVBASE(), data_filesz, data_filesz, PAGE());
    dyn_phdr(&buf, 1, 6, 0, BSS_VADDR(), 0, BSS_MEMSZ(), PAGE());
    dyn_phdr(&buf, 1, 6, got_file_off, DYN_GOT_VADDR(), got_filesz, got_filesz, PAGE());
    dyn_phdr(&buf, 2, 4, data_file_off + dynamic_rel, DVBASE() + dynamic_rel,
             dynamic.len as i64, dynamic.len as i64, 8);
    dyn_phdr(&buf, 1685382481, 6, 0, 0, 0, 0, 16); // PT_GNU_STACK

    dyn_append_slice(&buf, interp); elf_eb(&buf, 0);
    dyn_append(&buf, text);
    dyn_pad_to(&buf, data_file_off);
    dyn_append(&buf, app_data);
    dyn_pad_to(&buf, data_file_off + dynstr_rel); dyn_append(&buf, dynstr);
    dyn_pad_to(&buf, data_file_off + dynsym_rel); dyn_append(&buf, dynsym);
    dyn_pad_to(&buf, data_file_off + rela_rel); dyn_append(&buf, rela);
    dyn_pad_to(&buf, data_file_off + dynamic_rel); dyn_append(&buf, dynamic);
    dyn_pad_to(&buf, got_file_off + got_filesz);
    return _zag_write_exec(path, buf.data[0..buf.len]);
}
