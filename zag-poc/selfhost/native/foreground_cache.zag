// Correctness-independent foreground machine-code cache.
//
// The current backend emits a single position-dependent main code blob, so the
// smallest safely reusable unit is that whole blob. A foreground build still
// performs authoritative parse/type/effect checks. Code generation is skipped
// only after the complete key and payload checksums match. Thus deletion,
// corruption, daemon absence, or stale metadata is only a miss.
@import("../zagd.zag")
@import("../ast.zag")
@import("../lex.zag")

extern fn _zag_raw_syscall(num:i64,a1:i64,a2:i64,a3:i64,a4:i64,a5:i64,a6:i64)i64
extern fn _zag_slice_ptr(s:[]u8)*i8

struct ForegroundCacheKey {
    compiler: ZagdHash,
    compiler_version: ZagdHash,
    project_root: ZagdHash,
    source_label: ZagdHash,
    content: ZagdHash,
    dependencies: ZagdHash,
    semantic_graph: ZagdHash,
    target: ZagdHash,
    abi: ZagdHash,
    policy: ZagdHash,
}
struct ForegroundCacheResult { code:ArrayList[u8], data:ArrayList[u8], hit:i32, stored:i32 }
struct ForegroundBoundedRead { bytes:ArrayList[u8], ok:i32 }

fn fc_fields(h:ZagdHash)[]u8{return _zag_str_concat(_zag_i64_to_str(h.first),_zag_str_concat(",",_zag_str_concat(_zag_i64_to_str(h.second),_zag_str_concat(",",_zag_i64_to_str(h.bytes)))));}
fn fc_key_equal(a:ForegroundCacheKey,b:ForegroundCacheKey)i32{return zagd_hash_equal(a.compiler,b.compiler)*zagd_hash_equal(a.compiler_version,b.compiler_version)*zagd_hash_equal(a.project_root,b.project_root)*zagd_hash_equal(a.source_label,b.source_label)*zagd_hash_equal(a.content,b.content)*zagd_hash_equal(a.dependencies,b.dependencies)*zagd_hash_equal(a.semantic_graph,b.semantic_graph)*zagd_hash_equal(a.target,b.target)*zagd_hash_equal(a.abi,b.abi)*zagd_hash_equal(a.policy,b.policy);}
fn fc_hash_decimal(seed:ZagdHash,value:i64)ZagdHash{let h:ZagdHash=seed;let n:i64=value;if(n<0){h=zagd_hash_extend(h,"-");n=0-n;}if(n==0){return zagd_hash_extend(h,"0");}let divisor:i64=1;while(n/divisor>=10){divisor=divisor*10;}let digits:[]u8="0123456789";while(divisor>0){let digit:i32=((n/divisor)%10) as i32;h=zagd_hash_extend(h,digits[digit..digit+1]);divisor=divisor/10;}return h;}
// Tokens are the authoritative non-semantic-edit boundary. Whitespace and
// comments never reach lowering, while token kind and value preserve every
// parsed spelling (including strings and numeric literals).
fn fc_token_identity(src:[]u8)ZagdHash{let h:ZagdHash=zagd_content_hash("zag-token-identity-v2");let toks:ArrayList[Token]=lex(src);let i:i32=0;while(i<toks.len){let t:Token=toks.data[i];if(t.kind!=Tk.Eof){h=fc_hash_decimal(h,tk_code(t.kind));h=zagd_hash_extend(h,":");h=zagd_hash_extend(h,t.val);h=zagd_hash_extend(h,"\n");}i=i+1;}free[Token](&toks);return h;}
fn fc_dependency_identity(modules:ArrayList[ResolvedModule])ZagdHash{let h:ZagdHash=zagd_content_hash("foreground-dependencies-v2");let i:i32=0;while(i<modules.len){h=zagd_hash_extend(h,modules.data[i].path);h=zagd_hash_extend(h,"\n");h=zagd_hash_extend(h,fc_fields(fc_token_identity(modules.data[i].source)));h=zagd_hash_extend(h,"\n");i=i+1;}return h;}
fn fc_key_identity(compiler_identity:ZagdHash,compiler_version:[]u8,project_root:[]u8,source_label:[]u8,root_source:[]u8,modules:ArrayList[ResolvedModule],semantic_graph:ZagdHash,target_text:[]u8,abi_text:[]u8,policy_text:[]u8)ForegroundCacheKey{return ForegroundCacheKey{.compiler=compiler_identity,.compiler_version=zagd_content_hash(compiler_version),.project_root=zagd_content_hash(project_root),.source_label=zagd_content_hash(source_label),.content=fc_token_identity(root_source),.dependencies=fc_dependency_identity(modules),.semantic_graph=semantic_graph,.target=zagd_content_hash(target_text),.abi=zagd_content_hash(abi_text),.policy=zagd_content_hash(policy_text)};}
fn fc_key(compiler_bytes:[]u8,compiler_version:[]u8,project_root:[]u8,source_label:[]u8,root_source:[]u8,modules:ArrayList[ResolvedModule],semantic_graph:ZagdHash,target_text:[]u8,abi_text:[]u8,policy_text:[]u8)ForegroundCacheKey{return fc_key_identity(zagd_content_hash(compiler_bytes),compiler_version,project_root,source_label,root_source,modules,semantic_graph,target_text,abi_text,policy_text);}

fn fc_value(text:[]u8,key:[]u8)[]u8{let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>key.len&&@strEq(line[0..key.len],key)&&line[key.len]=='='){return line[key.len+1..];}start=i+1;}i=i+1;}return "";}
fn fc_value_count(text:[]u8,key:[]u8)i32{let count:i32=0;let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>key.len&&@strEq(line[0..key.len],key)&&line[key.len]=='='){count=count+1;}start=i+1;}i=i+1;}return count;}
fn fc_line_count(text:[]u8)i32{if(text.len==0||text[text.len-1]!='\n'){return 0;}let count:i32=0;let i:i32=0;while(i<text.len){if(text[i]=='\n'){count=count+1;}i=i+1;}return count;}
fn fc_bounded_uint(text:[]u8,max:i64)i64{if(text.len==0){return 0-1;}let value:i64=0;let i:i32=0;while(i<text.len){if(text[i]<'0'||text[i]>'9'){return 0-1;}let digit:i64=(text[i] as i64)-48;if(value>(max-digit)/10){return 0-1;}value=value*10+digit;i=i+1;}return value;}
fn fc_contains_final_checksum(text:[]u8)i32{let marker:[]u8="record_checksum=";let i:i32=0;while(i+marker.len<=text.len){if((i==0||text[i-1]=='\n')&&@strEq(text[i..i+marker.len],marker)){let got:[]u8=text[i+marker.len..];if(got.len==0||got[got.len-1]!='\n'){return 0;}let expected:ZagdHash=zagd_content_hash(text[0..i]);return @strEq(got[0..got.len-1],fc_fields(expected)) as i32;}i=i+1;}return 0;}
fn fc_record(key:ForegroundCacheKey,code:[]u8,data:[]u8)[]u8{let body:[]u8="format=zag-foreground-machine-cache-v4\ncomplete=true\n";body=_zag_str_concat(body,_zag_str_concat("compiler=",_zag_str_concat(fc_fields(key.compiler),"\n")));body=_zag_str_concat(body,_zag_str_concat("compiler_version=",_zag_str_concat(fc_fields(key.compiler_version),"\n")));body=_zag_str_concat(body,_zag_str_concat("project_root=",_zag_str_concat(fc_fields(key.project_root),"\n")));body=_zag_str_concat(body,_zag_str_concat("source_label=",_zag_str_concat(fc_fields(key.source_label),"\n")));body=_zag_str_concat(body,_zag_str_concat("content=",_zag_str_concat(fc_fields(key.content),"\n")));body=_zag_str_concat(body,_zag_str_concat("dependencies=",_zag_str_concat(fc_fields(key.dependencies),"\n")));body=_zag_str_concat(body,_zag_str_concat("semantic_graph=",_zag_str_concat(fc_fields(key.semantic_graph),"\n")));body=_zag_str_concat(body,_zag_str_concat("target=",_zag_str_concat(fc_fields(key.target),"\n")));body=_zag_str_concat(body,_zag_str_concat("abi=",_zag_str_concat(fc_fields(key.abi),"\n")));body=_zag_str_concat(body,_zag_str_concat("policy=",_zag_str_concat(fc_fields(key.policy),"\n")));body=_zag_str_concat(body,_zag_str_concat("code_length=",_zag_str_concat(_zag_i64_to_str(code.len),"\n")));body=_zag_str_concat(body,_zag_str_concat("data_length=",_zag_str_concat(_zag_i64_to_str(data.len),"\n")));body=_zag_str_concat(body,_zag_str_concat("code=",_zag_str_concat(fc_fields(zagd_content_hash(code)),"\n")));body=_zag_str_concat(body,_zag_str_concat("data=",_zag_str_concat(fc_fields(zagd_content_hash(data)),"\n")));return _zag_str_concat(body,_zag_str_concat("record_checksum=",_zag_str_concat(fc_fields(zagd_content_hash(body)),"\n")));}
fn fc_record_accept(text:[]u8,key:ForegroundCacheKey,code:[]u8,data:[]u8)i32{
    let names:ArrayList[[]u8]=make[[]u8](17);push[[]u8](&names,"format");push[[]u8](&names,"complete");push[[]u8](&names,"compiler");push[[]u8](&names,"compiler_version");push[[]u8](&names,"project_root");push[[]u8](&names,"source_label");push[[]u8](&names,"content");push[[]u8](&names,"dependencies");push[[]u8](&names,"semantic_graph");push[[]u8](&names,"target");push[[]u8](&names,"abi");push[[]u8](&names,"policy");push[[]u8](&names,"code_length");push[[]u8](&names,"data_length");push[[]u8](&names,"code");push[[]u8](&names,"data");push[[]u8](&names,"record_checksum");
    if(fc_line_count(text)!=17){free[[]u8](&names);return 0;}let i:i32=0;while(i<names.len){if(fc_value_count(text,names.data[i])!=1){free[[]u8](&names);return 0;}i=i+1;}free[[]u8](&names);
    if(!@strEq(fc_value(text,"format"),"zag-foreground-machine-cache-v4")||!@strEq(fc_value(text,"complete"),"true")||fc_contains_final_checksum(text)==0){return 0;}
    if(!@strEq(fc_value(text,"compiler"),fc_fields(key.compiler))||!@strEq(fc_value(text,"compiler_version"),fc_fields(key.compiler_version))||!@strEq(fc_value(text,"project_root"),fc_fields(key.project_root))||!@strEq(fc_value(text,"source_label"),fc_fields(key.source_label))||!@strEq(fc_value(text,"content"),fc_fields(key.content))||!@strEq(fc_value(text,"dependencies"),fc_fields(key.dependencies))||!@strEq(fc_value(text,"semantic_graph"),fc_fields(key.semantic_graph))||!@strEq(fc_value(text,"target"),fc_fields(key.target))||!@strEq(fc_value(text,"abi"),fc_fields(key.abi))||!@strEq(fc_value(text,"policy"),fc_fields(key.policy))){return 0;}
    if(fc_bounded_uint(fc_value(text,"code_length"),268435456)!=(code.len as i64)||fc_bounded_uint(fc_value(text,"data_length"),268435456)!=(data.len as i64)){return 0;}
    return (@strEq(fc_value(text,"code"),fc_fields(zagd_content_hash(code)))&&@strEq(fc_value(text,"data"),fc_fields(zagd_content_hash(data)))) as i32;
}

fn fc_cstring(s:[]u8)ArrayList[u8]{let out:ArrayList[u8]=make[u8](s.len+1);let i:i32=0;while(i<s.len){push[u8](&out,s[i]);i=i+1;}push[u8](&out,0 as u8);return out;}
fn fc_mkdir(path:[]u8)i32{let p:ArrayList[u8]=fc_cstring(path);let rc:i64=_zag_raw_syscall(83,_zag_slice_ptr(p.data[0..p.len]) as i64,493,0,0,0,0);free[u8](&p);return (rc==0||rc==(0-17)) as i32;}
fn fc_rename(from:[]u8,to:[]u8)i32{let a:ArrayList[u8]=fc_cstring(from);let b:ArrayList[u8]=fc_cstring(to);let rc:i64=_zag_raw_syscall(82,_zag_slice_ptr(a.data[0..a.len]) as i64,_zag_slice_ptr(b.data[0..b.len]) as i64,0,0,0,0);free[u8](&a);free[u8](&b);return (rc==0) as i32;}
fn fc_unlink(path:[]u8)i32{let p:ArrayList[u8]=fc_cstring(path);let rc:i64=_zag_raw_syscall(87,_zag_slice_ptr(p.data[0..p.len]) as i64,0,0,0,0,0);free[u8](&p);return (rc==0||rc==(0-2)) as i32;}
fn fc_u32_at(s:[]u8,at:i32)i64{if(at<0||at+4>s.len){return 0-1;}let value:i64=0;let mul:i64=1;let i:i32=0;while(i<4){value=value+(s[at+i] as i64)*mul;mul=mul*256;i=i+1;}return value;}
fn fc_nonnegative_i64_at(s:[]u8,at:i32)i64{if(at<0||at+8>s.len||s[at+7]>=128){return 0-1;}let value:i64=0;let mul:i64=1;let i:i32=0;while(i<8){value=value+(s[at+i] as i64)*mul;mul=mul*256;i=i+1;}return value;}
fn fc_payload_limit(configured:i64)i64{let hard:i64=268435456;if(configured<=0){return 0;}if(configured<hard){return configured;}return hard;}
fn fc_real_dir(path:[]u8)i32{let p:ArrayList[u8]=fc_cstring(path);let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(p.data[0..p.len]) as i64,720896,0,0,0,0);free[u8](&p);if(fd<0){return 0;}let stat:ArrayList[u8]=make[u8](144);stat.len=144;let rc:i64=_zag_raw_syscall(5,fd,_zag_slice_ptr(stat.data[0..stat.len]) as i64,0,0,0,0);let mode:i64=fc_u32_at(stat.data[0..stat.len],24);free[u8](&stat);let _close:i64=_zag_raw_syscall(3,fd,0,0,0,0,0);return (rc==0&&(mode&61440)==16384) as i32;}
fn fc_prepare_dirs(root:[]u8,base:[]u8,dir:[]u8)i32{if(root.len==0||fc_real_dir(root)==0){return 0;}if(fc_mkdir(base)==0||fc_real_dir(base)==0){return 0;}if(fc_mkdir(dir)==0||fc_real_dir(dir)==0){return 0;}return 1;}
fn fc_temp_path(path:[]u8)[]u8{return _zag_str_concat(path,_zag_str_concat(".tmp.",_zag_i64_to_str(_zag_raw_syscall(39,0,0,0,0,0,0))));}
fn fc_write_new(path:[]u8,bytes:[]u8)i32{
    let _old:i32=fc_unlink(path);let p:ArrayList[u8]=fc_cstring(path);let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(p.data[0..p.len]) as i64,655553,384,0,0,0);free[u8](&p);if(fd<0){return 0;}
    let off:i32=0;let ok:i32=1;while(off<bytes.len){let rc:i64=_zag_raw_syscall(1,fd,_zag_slice_ptr(bytes[off..bytes.len]) as i64,bytes.len-off,0,0,0);if(rc==(0-4)){continue;}if(rc<=0){ok=0;break;}off=off+(rc as i32);}if(ok==1&&_zag_raw_syscall(74,fd,0,0,0,0,0)!=0){ok=0;}let _close:i64=_zag_raw_syscall(3,fd,0,0,0,0,0);if(ok==0){let _remove:i32=fc_unlink(path);}return ok;
}
fn fc_publish_file(final:[]u8,bytes:[]u8)i32{let temp:[]u8=fc_temp_path(final);if(fc_write_new(temp,bytes)==0){return 0;}if(fc_rename(temp,final)==0){let _remove:i32=fc_unlink(temp);return 0;}return 1;}

// Open once with O_NOFOLLOW, verify a regular file and its size using fstat,
// then read from that same descriptor. This prevents both oversized sparse
// cache entries and stat/read replacement races from forcing an unbounded
// allocation before cache validation.
fn fc_read_bounded(path:[]u8,limit:i64)ForegroundBoundedRead{
    let bad:ForegroundBoundedRead=ForegroundBoundedRead{.bytes=make[u8](1),.ok=0};if(limit<0){return bad;}
    let cpath:ArrayList[u8]=fc_cstring(path);let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(cpath.data[0..cpath.len]) as i64,657408,0,0,0,0);free[u8](&cpath);if(fd<0){return bad;}
    let stat:ArrayList[u8]=make[u8](144);stat.len=144;let frc:i64=_zag_raw_syscall(5,fd,_zag_slice_ptr(stat.data[0..stat.len]) as i64,0,0,0,0);let size:i64=fc_nonnegative_i64_at(stat.data[0..stat.len],48);let mode:i64=fc_u32_at(stat.data[0..stat.len],24);free[u8](&stat);
    if(frc!=0||size<0||size>limit||size>2147483646||(mode&61440)!=32768){let _close_bad:i64=_zag_raw_syscall(3,fd,0,0,0,0,0);return bad;}
    let out:ArrayList[u8]=make[u8]((size as i32)+1);out.len=size as i32;let off:i32=0;let ok:i32=1;while(off<out.len){let rc:i64=_zag_raw_syscall(0,fd,_zag_slice_ptr(out.data[off..out.len]) as i64,out.len-off,0,0,0);if(rc==(0-4)){continue;}if(rc<=0){ok=0;break;}off=off+(rc as i32);}
    let after:ArrayList[u8]=make[u8](144);after.len=144;let arc:i64=_zag_raw_syscall(5,fd,_zag_slice_ptr(after.data[0..after.len]) as i64,0,0,0,0);let after_size:i64=fc_nonnegative_i64_at(after.data[0..after.len],48);free[u8](&after);if(arc!=0||after_size!=size){ok=0;}let _close:i64=_zag_raw_syscall(3,fd,0,0,0,0,0);
    if(ok==0){free[u8](&out);return bad;}free[u8](&bad.bytes);return ForegroundBoundedRead{.bytes=out,.ok=1};
}

fn foreground_cache_load(root:[]u8,key:ForegroundCacheKey,max_cache_bytes:i64)ForegroundCacheResult{
    let miss:ForegroundCacheResult=ForegroundCacheResult{.code=make[u8](1),.data=make[u8](1),.hit=0,.stored=0};
    let limit:i64=fc_payload_limit(max_cache_bytes);if(root.len==0||limit<1){return miss;}
    let base:[]u8=_zag_str_concat(root,"/.zag-cache");let dir:[]u8=_zag_str_concat(base,"/foreground");if(fc_prepare_dirs(root,base,dir)==0){return miss;}
    let record_path:[]u8=_zag_str_concat(dir,"/machine.record");let code_path:[]u8=_zag_str_concat(dir,"/machine.code");let data_path:[]u8=_zag_str_concat(dir,"/machine.data");let record_limit:i64=1048576;if(limit<record_limit){record_limit=limit;}let record:ForegroundBoundedRead=fc_read_bounded(record_path,record_limit);if(record.ok==0){free[u8](&record.bytes);return miss;}let remaining_code:i64=limit-(record.bytes.len as i64);let cached:ForegroundBoundedRead=fc_read_bounded(code_path,remaining_code);if(cached.ok==0||cached.bytes.len<=0){free[u8](&record.bytes);free[u8](&cached.bytes);return miss;}let remaining_data:i64=remaining_code-(cached.bytes.len as i64);let cached_data:ForegroundBoundedRead=fc_read_bounded(data_path,remaining_data);if(cached_data.ok==0){free[u8](&record.bytes);free[u8](&cached.bytes);free[u8](&cached_data.bytes);return miss;}
    if(fc_record_accept(record.bytes.data[0..record.bytes.len],key,cached.bytes.data[0..cached.bytes.len],cached_data.bytes.data[0..cached_data.bytes.len])==1){free[u8](&record.bytes);free[u8](&miss.code);free[u8](&miss.data);return ForegroundCacheResult{.code=cached.bytes,.data=cached_data.bytes,.hit=1,.stored=0};}
    free[u8](&record.bytes);free[u8](&cached.bytes);free[u8](&cached_data.bytes);
    return miss;
}
fn foreground_cache_store(root:[]u8,key:ForegroundCacheKey,code:ArrayList[u8],data:ArrayList[u8],max_cache_bytes:i64)i32{
    let limit:i64=fc_payload_limit(max_cache_bytes);if(root.len==0||code.len<=0||limit<1){return 0;}let encoded:[]u8=fc_record(key,code.data[0..code.len],data.data[0..data.len]);if(encoded.len>1048576||(encoded.len as i64)+(code.len as i64)+(data.len as i64)>limit){return 0;}let base:[]u8=_zag_str_concat(root,"/.zag-cache");let dir:[]u8=_zag_str_concat(base,"/foreground");if(fc_prepare_dirs(root,base,dir)==0){return 0;}let record_path:[]u8=_zag_str_concat(dir,"/machine.record");let code_path:[]u8=_zag_str_concat(dir,"/machine.code");let data_path:[]u8=_zag_str_concat(dir,"/machine.data");
    // Payload first, authoritative metadata last. A crash or concurrent writer
    // can only leave a mismatched checksum, which the next build rejects.
    // Per-process O_EXCL/O_NOFOLLOW temporaries prevent concurrent publishers
    // or preplaced symlinks from sharing/truncating a staging inode.
    if(fc_publish_file(code_path,code.data[0..code.len])==0){return 0;}if(fc_publish_file(data_path,data.data[0..data.len])==0){return 0;}if(fc_publish_file(record_path,encoded)==0){return 0;}return 1;
}
