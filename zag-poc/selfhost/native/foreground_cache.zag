// Correctness-independent foreground machine-code cache.
//
// The current backend emits a single position-dependent main code blob, so the
// smallest safely reusable unit is that whole blob.  A foreground build still
// performs authoritative parse/sema/codegen. Cached bytes are substituted only
// after their complete key and payload match the freshly generated result.
// Thus deletion, corruption, daemon absence, or stale metadata is only a miss.
@import("../zagd.zag")
@import("../ast.zag")

extern fn _zag_raw_syscall(num:i64,a1:i64,a2:i64,a3:i64,a4:i64,a5:i64,a6:i64)i64
extern fn _zag_slice_ptr(s:[]u8)*i8

struct ForegroundCacheKey {
    compiler: ZagdHash,
    content: ZagdHash,
    dependencies: ZagdHash,
    target: ZagdHash,
    abi: ZagdHash,
}
struct ForegroundCacheResult { code:ArrayList[u8], data:ArrayList[u8], hit:i32, stored:i32 }

fn fc_fields(h:ZagdHash)[]u8{return _zag_str_concat(_zag_i64_to_str(h.first),_zag_str_concat(",",_zag_str_concat(_zag_i64_to_str(h.second),_zag_str_concat(",",_zag_i64_to_str(h.bytes)))));}
fn fc_key_equal(a:ForegroundCacheKey,b:ForegroundCacheKey)i32{return zagd_hash_equal(a.compiler,b.compiler)*zagd_hash_equal(a.content,b.content)*zagd_hash_equal(a.dependencies,b.dependencies)*zagd_hash_equal(a.target,b.target)*zagd_hash_equal(a.abi,b.abi);}
fn fc_dependency_identity(modules:ArrayList[ResolvedModule])ZagdHash{let h:ZagdHash=zagd_content_hash("foreground-dependencies-v1");let i:i32=0;while(i<modules.len){h=zagd_hash_extend(h,modules.data[i].path);h=zagd_hash_extend(h,"\n");h=zagd_hash_extend(h,modules.data[i].source);h=zagd_hash_extend(h,"\n");i=i+1;}return h;}
fn fc_key(compiler_bytes:[]u8,root_source:[]u8,modules:ArrayList[ResolvedModule],target_text:[]u8,abi_text:[]u8)ForegroundCacheKey{return ForegroundCacheKey{.compiler=zagd_content_hash(compiler_bytes),.content=zagd_content_hash(root_source),.dependencies=fc_dependency_identity(modules),.target=zagd_content_hash(target_text),.abi=zagd_content_hash(abi_text)};}

fn fc_value(text:[]u8,key:[]u8)[]u8{let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>key.len&&@strEq(line[0..key.len],key)&&line[key.len]=='='){return line[key.len+1..];}start=i+1;}i=i+1;}return "";}
fn fc_contains_final_checksum(text:[]u8)i32{let marker:[]u8="record_checksum=";let i:i32=0;while(i+marker.len<=text.len){if((i==0||text[i-1]=='\n')&&@strEq(text[i..i+marker.len],marker)){let got:[]u8=text[i+marker.len..];if(got.len==0||got[got.len-1]!='\n'){return 0;}let expected:ZagdHash=zagd_content_hash(text[0..i]);return @strEq(got[0..got.len-1],fc_fields(expected)) as i32;}i=i+1;}return 0;}
fn fc_record(key:ForegroundCacheKey,code:[]u8,data:[]u8)[]u8{let body:[]u8="format=zag-foreground-machine-cache-v1\ncomplete=true\n";body=_zag_str_concat(body,_zag_str_concat("compiler=",_zag_str_concat(fc_fields(key.compiler),"\n")));body=_zag_str_concat(body,_zag_str_concat("content=",_zag_str_concat(fc_fields(key.content),"\n")));body=_zag_str_concat(body,_zag_str_concat("dependencies=",_zag_str_concat(fc_fields(key.dependencies),"\n")));body=_zag_str_concat(body,_zag_str_concat("target=",_zag_str_concat(fc_fields(key.target),"\n")));body=_zag_str_concat(body,_zag_str_concat("abi=",_zag_str_concat(fc_fields(key.abi),"\n")));body=_zag_str_concat(body,_zag_str_concat("code=",_zag_str_concat(fc_fields(zagd_content_hash(code)),"\n")));body=_zag_str_concat(body,_zag_str_concat("data=",_zag_str_concat(fc_fields(zagd_content_hash(data)),"\n")));return _zag_str_concat(body,_zag_str_concat("record_checksum=",_zag_str_concat(fc_fields(zagd_content_hash(body)),"\n")));}
fn fc_record_accept(text:[]u8,key:ForegroundCacheKey,code:[]u8,data:[]u8)i32{if(!@strEq(fc_value(text,"format"),"zag-foreground-machine-cache-v1")||!@strEq(fc_value(text,"complete"),"true")||fc_contains_final_checksum(text)==0){return 0;}if(!@strEq(fc_value(text,"compiler"),fc_fields(key.compiler))||!@strEq(fc_value(text,"content"),fc_fields(key.content))||!@strEq(fc_value(text,"dependencies"),fc_fields(key.dependencies))||!@strEq(fc_value(text,"target"),fc_fields(key.target))||!@strEq(fc_value(text,"abi"),fc_fields(key.abi))){return 0;}return (@strEq(fc_value(text,"code"),fc_fields(zagd_content_hash(code)))&&@strEq(fc_value(text,"data"),fc_fields(zagd_content_hash(data)))) as i32;}

fn fc_cstring(s:[]u8)ArrayList[u8]{let out:ArrayList[u8]=make[u8](s.len+1);let i:i32=0;while(i<s.len){push[u8](&out,s[i]);i=i+1;}push[u8](&out,0 as u8);return out;}
fn fc_mkdir(path:[]u8)i32{let p:ArrayList[u8]=fc_cstring(path);let rc:i64=_zag_raw_syscall(83,_zag_slice_ptr(p.data[0..p.len]) as i64,493,0,0,0,0);free[u8](&p);return (rc==0||rc==(0-17)) as i32;}
fn fc_rename(from:[]u8,to:[]u8)i32{let a:ArrayList[u8]=fc_cstring(from);let b:ArrayList[u8]=fc_cstring(to);let rc:i64=_zag_raw_syscall(82,_zag_slice_ptr(a.data[0..a.len]) as i64,_zag_slice_ptr(b.data[0..b.len]) as i64,0,0,0,0);free[u8](&a);free[u8](&b);return (rc==0) as i32;}
fn fc_copy(data:[]u8)ArrayList[u8]{let out:ArrayList[u8]=make[u8](data.len+1);let i:i32=0;while(i<data.len){push[u8](&out,data[i]);i=i+1;}return out;}

fn foreground_cache_load(root:[]u8,key:ForegroundCacheKey)ForegroundCacheResult{
    let miss:ForegroundCacheResult=ForegroundCacheResult{.code=make[u8](1),.data=make[u8](1),.hit=0,.stored=0};
    if(root.len==0){return miss;}
    let base:[]u8=_zag_str_concat(root,"/.zag-cache");let dir:[]u8=_zag_str_concat(base,"/foreground");if(fc_mkdir(base)==0||fc_mkdir(dir)==0){return miss;}
    let record_path:[]u8=_zag_str_concat(dir,"/machine.record");let code_path:[]u8=_zag_str_concat(dir,"/machine.code");let data_path:[]u8=_zag_str_concat(dir,"/machine.data");let record:[]u8=_zag_read_file(record_path);let cached:[]u8=_zag_read_file(code_path);let cached_data:[]u8=_zag_read_file(data_path);
    if(record.len>=0&&cached.len>0&&cached_data.len>=0&&fc_record_accept(record,key,cached,cached_data)==1){free[u8](&miss.code);free[u8](&miss.data);return ForegroundCacheResult{.code=fc_copy(cached),.data=fc_copy(cached_data),.hit=1,.stored=0};}
    return miss;
}
fn foreground_cache_store(root:[]u8,key:ForegroundCacheKey,code:ArrayList[u8],data:ArrayList[u8])i32{
    if(root.len==0||code.len<=0){return 0;}let base:[]u8=_zag_str_concat(root,"/.zag-cache");let dir:[]u8=_zag_str_concat(base,"/foreground");if(fc_mkdir(base)==0||fc_mkdir(dir)==0){return 0;}let record_path:[]u8=_zag_str_concat(dir,"/machine.record");let code_path:[]u8=_zag_str_concat(dir,"/machine.code");let data_path:[]u8=_zag_str_concat(dir,"/machine.data");
    // Payload first, authoritative metadata last. A crash or concurrent writer
    // can only leave a mismatched checksum, which the next build rejects.
    let code_tmp:[]u8=_zag_str_concat(code_path,".tmp");let data_tmp:[]u8=_zag_str_concat(data_path,".tmp");let record_tmp:[]u8=_zag_str_concat(record_path,".tmp");if(_zag_write_file(code_tmp,code.data[0..code.len])!=0||fc_rename(code_tmp,code_path)==0){return 0;}if(_zag_write_file(data_tmp,data.data[0..data.len])!=0||fc_rename(data_tmp,data_path)==0){return 0;}let encoded:[]u8=fc_record(key,code.data[0..code.len],data.data[0..data.len]);if(_zag_write_file(record_tmp,encoded)!=0||fc_rename(record_tmp,record_path)==0){return 0;}return 1;
}
