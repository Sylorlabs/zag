// selfhost/native/ncodegen_generics.zag — GENERIC INSTANTIATION (monomorphization)
// for the native codegen. Extracted from ncodegen.zag for modularity.
//
// We expand the program BEFORE lowering: every distinct generic instantiation
// becomes a concrete, mangled decl appended to the decl list. A generic
// function `foo[T](..)` → a concrete `foo_T(..)` with its body cloned and every
// `T` substituted; a generic struct `Base[args]` → a concrete struct `Base_args`
// with substituted field types. The existing struct-layout / fn-symbol / type-
// tracking machinery then works unchanged: it only ever sees mangled, concrete
// names. Call sites and struct literals carrying type-args are resolved to their
// mangled names at lowering time (cg_call_mangled / cg_slit_sname).
//
// We mirror codegen.zag's logic exactly: subst_type, mangle, clone_*, and a
// fixpoint instance collection (a specialized body may instantiate more).

@import("isa.zag")
@import("../parse.zag")   // AST (Node/Param/Bin/Call/FnDecl/...) + ArrayList + @strEq + is_generic_app + index_of + split_args
@import("ncodegen_types.zag")   // cg_subst_type, cg_subst_targs, cg_mangle_generic_norm, cg_norm_type

// ── clone an AST subtree with type-param substitution (tp→ta) ────────────────
// Identical in spirit to codegen.zag's clone_*; we additionally clone switch
// statements (the native backend lowers them directly). Generic CALLS and struct
// LITERALS keep their (substituted) targs so the call/lit resolves to the right
// concrete mangled name after substitution.
fn cg_clone_call(c: Call, tp: ArrayList[[]u8], ta: ArrayList[[]u8]) *Node {
    let args: ArrayList[*Node] = make[*Node](4);
    let i: i32 = 0;
    while (i < len[*Node](c.args)) {
        push[*Node](&args, cg_clone_expr(get[*Node](c.args, i), tp, ta));
        i = i + 1;
    }
    if (len[[]u8](c.targs) > 0) {
        return mk_gcall(cg_clone_expr(c.callee, tp, ta), args, cg_subst_targs(c.targs, tp, ta));
    }
    return mk_call(cg_clone_expr(c.callee, tp, ta), args);
}

fn cg_clone_slit(s: StructLit, tp: ArrayList[[]u8], ta: ArrayList[[]u8]) *Node {
    let flds: ArrayList[FieldInit] = make[FieldInit](4);
    let i: i32 = 0;
    while (i < len[FieldInit](s.fields)) {
        let f: FieldInit = get[FieldInit](s.fields, i);
        push[FieldInit](&flds, FieldInit{ .name = f.name, .val = cg_clone_expr(f.val, tp, ta) });
        i = i + 1;
    }
    return new(Node{ .slit_ = StructLit{ .sname = s.sname, .fields = flds, .targs = cg_subst_targs(s.targs, tp, ta) } });
}

fn cg_clone_expr(n: *Node, tp: ArrayList[[]u8], ta: ArrayList[[]u8]) *Node {
    return switch (n.*) {
        .ilit   => |x| mk_int(x.text),
        .slit   => |x| mk_str(x.text),
        .id     => |x| mk_ident(x.name),
        .bin    => |b| mk_bin(b.op, cg_clone_expr(b.l, tp, ta), cg_clone_expr(b.r, tp, ta)),
        .un     => |u| mk_un(u.op, cg_clone_expr(u.e, tp, ta)),
        .call   => |c| cg_clone_call(c, tp, ta),
        .fld    => |f| mk_field(cg_clone_expr(f.base, tp, ta), f.fname),
        .idx    => |x| mk_index(cg_clone_expr(x.base, tp, ta), cg_clone_expr(x.idx, tp, ta)),
        .slit_  => |s| cg_clone_slit(s, tp, ta),
        .cast_  => |c| mk_cast(cg_clone_expr(c.expr, tp, ta), cg_subst_type(c.target, tp, ta)),
        .slice_ => |s| mk_slice(cg_clone_expr(s.base, tp, ta), cg_clone_expr(s.lo, tp, ta), cg_clone_expr(s.hi, tp, ta), s.has_hi),
        else    => n,
    };
}

fn cg_clone_block(body: ArrayList[*Node], tp: ArrayList[[]u8], ta: ArrayList[[]u8]) ArrayList[*Node] {
    let out: ArrayList[*Node] = make[*Node](8);
    let i: i32 = 0;
    while (i < len[*Node](body)) {
        push[*Node](&out, cg_clone_stmt(get[*Node](body, i), tp, ta));
        i = i + 1;
    }
    return out;
}

fn cg_clone_arm(a: SwitchArm, tp: ArrayList[[]u8], ta: ArrayList[[]u8]) SwitchArm {
    return SwitchArm{ .tags = a.tags, .cap = a.cap, .has_cap = a.has_cap, .body = cg_clone_block(a.body, tp, ta) };
}

fn cg_clone_stmt(n: *Node, tp: ArrayList[[]u8], ta: ArrayList[[]u8]) *Node {
    return switch (n.*) {
        .let_    => |l| mk_let(l.name, cg_subst_type(l.dty, tp, ta), l.has_dty, l.has_init, cg_clone_expr(l.expr, tp, ta)),
        .ret     => |r| mk_ret(r.has_expr, cg_clone_expr(r.expr, tp, ta)),
        .if_     => |x| new(Node{ .if_ = If{ .cond = cg_clone_expr(x.cond, tp, ta), .then_body = cg_clone_block(x.then_body, tp, ta), .els_body = cg_clone_block(x.els_body, tp, ta), .has_els = x.has_els, .cap = x.cap, .has_cap = x.has_cap } }),
        .while_  => |w| new(Node{ .while_ = While{ .cond = cg_clone_expr(w.cond, tp, ta), .body = cg_clone_block(w.body, tp, ta), .cap = w.cap, .has_cap = w.has_cap } }),
        .unsafe_ => |u| mk_unsafe(cg_clone_block(u.body, tp, ta)),
        .break_  => |_b| mk_break(),
        .continue_ => |_c| mk_continue(),
        .assign  => |a| mk_assign(cg_clone_expr(a.target, tp, ta), cg_clone_expr(a.expr, tp, ta)),
        .estmt   => |e| mk_estmt(cg_clone_expr(e.expr, tp, ta)),
        .switch_ => |sw| cg_clone_switch(sw, tp, ta),
        else     => n,
    };
}

fn cg_clone_switch(sw: Switch, tp: ArrayList[[]u8], ta: ArrayList[[]u8]) *Node {
    let arms: ArrayList[SwitchArm] = make[SwitchArm](4);
    let i: i32 = 0;
    while (i < len[SwitchArm](sw.arms)) {
        push[SwitchArm](&arms, cg_clone_arm(get[SwitchArm](sw.arms, i), tp, ta));
        i = i + 1;
    }
    return mk_switch(cg_clone_expr(sw.subject, tp, ta), arms, cg_clone_block(sw.els_body, tp, ta), sw.has_els);
}

// callee name of a call node ("" if not a plain ident).
fn cg_callee_name(n: *Node) []u8 {
    return switch (n.*) {
        .id  => |d| d.name,
        .fld => |f| f.fname,
        else => "",
    };
}

fn cg_starts_with(s: []u8, p: []u8) i32 {
    if (s.len < p.len) { return 0; }
    let i: i32 = 0;
    while (i < p.len) {
        if (s[i] != p[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn cg_is_fn_type(ty: []u8) i32 {
    if (ty.len < 3) { return 0; }
    if (ty[0] == 'f' && ty[1] == 'n' && ty[2] == '(') { return 1; }
    return 0;
}

fn cg_is_clos_name(name: []u8) i32 {
    return cg_starts_with(name, "__clos_");
}

fn cg_count_caps(caps: []u8) i32 {
    if (caps.len == 0) { return 0; }
    let n: i32 = 1;
    let i: i32 = 0;
    while (i < caps.len) { if (caps[i] == ',') { n = n + 1; } i = i + 1; }
    return n;
}

// Returns 1 if `name` appears as a token in the comma-separated `cap_names`.
fn cg_cap_has(cap_names: []u8, name: []u8) i32 {
    let s: i32 = 0;
    while (s <= cap_names.len) {
        let e: i32 = s;
        while (e < cap_names.len && cap_names[e] != ',') { e = e + 1; }
        let tok: []u8 = cap_names[s..e];
        if (@strEq(tok, name)) { return 1; }
        s = e + 1;
    }
    return 0;
}

// ── instance collection (fixpoint) ───────────────────────────────────────────
// EXP holds the growing expanded decl list (originals + mangled instances) and a
// `seen` set of mangled instance names so we never duplicate one. `gnames` lists
// the names of mangled generic-fn instances we created (so their cloned bodies
// can be walked for further instantiation at the fixpoint).
struct Exp {
    decls:  ArrayList[*Node],   // original + appended instance decls
    seen:   ArrayList[[]u8],    // mangled names already emitted (fns AND structs)
}

fn cg_exp_seen(e: *Exp, m: []u8) i32 {
    let i: i32 = 0;
    while (i < len[[]u8](e.*.seen)) {
        if (@strEq(get[[]u8](e.*.seen, i), m)) { return 1; }
        i = i + 1;
    }
    return 0;
}

// Find the generic struct/fn template decl by (original) name; returns the *Node
// or a null sentinel via the has-flag pattern.
fn cg_find_generic_fn(decls: ArrayList[*Node], name: []u8, out: *FnDecl) i32 {
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                if (len[[]u8](f.tparams) > 0 && @strEq(f.name, name)) { out.* = f; return 1; }
            }
            else => { }
        }
        i = i + 1;
    }
    return 0;
}

fn cg_find_generic_struct(decls: ArrayList[*Node], name: []u8, out: *StructDecl) i32 {
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .struct_ => |s| {
                if (len[[]u8](s.tparams) > 0 && @strEq(s.name, name)) { out.* = s; return 1; }
            }
            else => { }
        }
        i = i + 1;
    }
    return 0;
}

// ── generic type-argument INFERENCE ─────────────────────────────────────────
// For calls like `unbox(bi)` where `unbox` is generic `fn unbox[T](b: Box[T]) T`
// and `bi: Box[i32]`, infer T=i32 from the argument types and fill c.targs.
// This must run BEFORE cg_expand_generics so the mono pass sees explicit targs.

// Unify param type `pty` against arg type `aty`, returning the binding for
// type-param `tp` (or "" if undetermined here). Mirrors codegen.zag unify_bind.
fn cg_unify_bind(pty: []u8, aty: []u8, tp: []u8) []u8 {
    if (aty.len == 0) { return ""; }
    if (@strEq(pty, tp)) { return aty; }
    if (pty.len > 2 && pty[0] == '[' && pty[1] == ']' && aty.len > 2 && aty[0] == '[' && aty[1] == ']') {
        return cg_unify_bind(pty[2..], aty[2..], tp);
    }
    if (pty.len > 1 && pty[0] == '*' && aty.len > 1 && aty[0] == '*') {
        return cg_unify_bind(pty[1..], aty[1..], tp);
    }
    if (is_generic_app(pty) && is_generic_app(aty)) {
        let pl: i32 = index_of(pty, '[');
        let al: i32 = index_of(aty, '[');
        let pargs: ArrayList[[]u8] = split_args(pty[pl + 1..pty.len - 1]);
        let aargs: ArrayList[[]u8] = split_args(aty[al + 1..aty.len - 1]);
        let k: i32 = 0;
        while (k < len[[]u8](pargs) && k < len[[]u8](aargs)) {
            let b: []u8 = cg_unify_bind(get[[]u8](pargs, k), get[[]u8](aargs, k), tp);
            if (b.len > 0) { return b; }
            k = k + 1;
        }
    }
    return "";
}

// Element type T from ArrayList[T] (handles nested T with internal brackets).
fn cg_arraylist_elem(ty: []u8) []u8 {
    if (cg_starts_with(ty, "ArrayList[") == 0 || ty.len <= 11) { return ""; }
    if (ty[ty.len - 1] != ']') { return ""; }
    return ty[10..ty.len - 1];
}

// Return type of a generic call once targs are known (substitutes template ret).
fn cg_ginfer_call_retty(c: Call, cn: []u8, decls: ArrayList[*Node]) []u8 {
    if (cn.len == 0 || len[[]u8](c.targs) == 0) { return ""; }
    let gf: FnDecl = FnDecl{ .name = "", .tparams = make[[]u8](1), .params = make[Param](1), .ret = "", .annots = make[[]u8](1), .body = make[*Node](1), .is_extern = 0, .ret_eff = "", .caps = 0, .cap_names = "", .cap_types = "", .line = 0, .is_pub = 0 };
    if (cg_find_generic_fn(decls, cn, &gf) == 1) {
        return cg_subst_type(gf.ret, gf.tparams, c.targs);
    }
    return "";
}

fn cg_ginfer_expr_retty(n: *Node, decls: ArrayList[*Node]) []u8 {
    return switch (n.*) {
        .call => |c| cg_ginfer_call_retty(c, cg_callee_name(c.callee), decls),
        else => "",
    };
}

// Get the declared type of an expression node from a local let-type map `lenv`.
// Returns "" for expressions we can't determine cheaply.
fn cg_ginfer_argty(n: *Node, lenv: ArrayList[Param], decls: ArrayList[*Node]) []u8 {
    switch (n.*) {
        .id => |x| {
            let i: i32 = 0;
            while (i < len[Param](lenv)) {
                if (@strEq(get[Param](lenv, i).name, x.name)) { return get[Param](lenv, i).pty; }
                i = i + 1;
            }
            return "";
        }
        .call => |c| { return cg_ginfer_call_retty(c, cg_callee_name(c.callee), decls); }
        .slit_ => |s| {
            if (len[[]u8](s.targs) > 0) { return cg_mangle_generic_norm(s.sname, s.targs); }
            return s.sname;
        }
        .ilit => |_x| { return "i32"; }
        else => { return ""; }
    }
}

// Walk an expression, filling in targs for generic calls with empty targs.
fn cg_ginfer_expr(n: *Node, lenv: ArrayList[Param], decls: ArrayList[*Node]) void {
    switch (n.*) {
        .call => |c| {
            let i2: i32 = 0;
            while (i2 < len[*Node](c.args)) { cg_ginfer_expr(get[*Node](c.args, i2), lenv, decls); i2 = i2 + 1; }
            if (len[[]u8](c.targs) == 0) {
                let cn: []u8 = cg_callee_name(c.callee);
                if (cn.len > 0) {
                    // The built-in push/set/get/len inference below is ONLY valid when
                    // `cn` names an actual generic function (std container ops). Otherwise
                    // a user's concrete `fn set(self:*F,a,b,c)` would be hijacked and
                    // rewritten to a nonexistent `set_T` ("call to unknown function").
                    // Gate on genericity so user names are never stolen.
                    let gfck: FnDecl = FnDecl{ .name = "", .tparams = make[[]u8](1), .params = make[Param](1), .ret = "", .annots = make[[]u8](1), .body = make[*Node](1), .is_extern = 0, .ret_eff = "", .caps = 0, .cap_names = "", .cap_types = "", .line = 0, .is_pub = 0 };
                    let is_gen: i32 = cg_find_generic_fn(decls, cn, &gfck);
                    // ── built-in generic inference ──────────────────────────
                    // push(&xs, val) → T = type of val (args[1])
                    if (is_gen == 1 && @strEq(cn, "push") && len[*Node](c.args) >= 2) {
                        let ety: []u8 = cg_ginfer_argty(get[*Node](c.args, 1), lenv, decls);
                        if (ety.len == 0) {
                            let aty0: []u8 = cg_ginfer_argty(get[*Node](c.args, 0), lenv, decls);
                            if (aty0.len > 1 && aty0[0] == '*') { ety = cg_arraylist_elem(aty0[1..]); }
                        }
                        if (ety.len > 0) {
                            let targs2: ArrayList[[]u8] = make[[]u8](2);
                            push[[]u8](&targs2, ety);
                            n.* = Node{ .call = Call{ .callee = c.callee, .args = c.args, .targs = targs2 } };
                        }
                    }
                    // set(&xs, i, val) → T = type of val (args[2])
                    else if (is_gen == 1 && @strEq(cn, "set") && len[*Node](c.args) >= 3) {
                        let ety_s: []u8 = cg_ginfer_argty(get[*Node](c.args, 2), lenv, decls);
                        if (ety_s.len == 0) {
                            let aty0s: []u8 = cg_ginfer_argty(get[*Node](c.args, 0), lenv, decls);
                            if (aty0s.len > 1 && aty0s[0] == '*') { ety_s = cg_arraylist_elem(aty0s[1..]); }
                        }
                        if (ety_s.len > 0) {
                            let targs_s: ArrayList[[]u8] = make[[]u8](2);
                            push[[]u8](&targs_s, ety_s);
                            n.* = Node{ .call = Call{ .callee = c.callee, .args = c.args, .targs = targs_s } };
                        }
                    }
                    // get(xs, i) / len(xs) → T = element type of ArrayList[T] (args[0])
                    else if (is_gen == 1 && (@strEq(cn, "get") || @strEq(cn, "len")) && len[*Node](c.args) >= 1) {
                        let aty2: []u8 = cg_ginfer_argty(get[*Node](c.args, 0), lenv, decls);
                        let ety2: []u8 = cg_arraylist_elem(aty2);
                        if (ety2.len > 0) {
                            let targs3: ArrayList[[]u8] = make[[]u8](2);
                            push[[]u8](&targs3, ety2);
                            n.* = Node{ .call = Call{ .callee = c.callee, .args = c.args, .targs = targs3 } };
                        }
                    }
                    // user-defined generic fn inference
                    else {
                    let gf: FnDecl = FnDecl{ .name = "", .tparams = make[[]u8](1), .params = make[Param](1), .ret = "", .annots = make[[]u8](1), .body = make[*Node](1), .is_extern = 0, .ret_eff = "", .caps = 0, .cap_names = "", .cap_types = "", .line = 0, .is_pub = 0 };
                    if (cg_find_generic_fn(decls, cn, &gf) == 1) {
                        let targs: ArrayList[[]u8] = make[[]u8](len[[]u8](gf.tparams) + 1);
                        let ok: i32 = 1;
                        let ti: i32 = 0;
                        while (ti < len[[]u8](gf.tparams)) {
                            let tp: []u8 = get[[]u8](gf.tparams, ti);
                            let bound: []u8 = "";
                            let pi: i32 = 0;
                            while (pi < len[Param](gf.params) && pi < len[*Node](c.args)) {
                                let aty: []u8 = cg_ginfer_argty(get[*Node](c.args, pi), lenv, decls);
                                if (aty.len > 0) {
                                    let b: []u8 = cg_unify_bind(get[Param](gf.params, pi).pty, aty, tp);
                                    if (b.len > 0) { bound = b; pi = len[Param](gf.params); } else { pi = pi + 1; }
                                } else { pi = pi + 1; }
                            }
                            if (bound.len == 0) { ok = 0; }
                            push[[]u8](&targs, bound);
                            ti = ti + 1;
                        }
                        if (ok == 1) {
                            n.* = Node{ .call = Call{ .callee = c.callee, .args = c.args, .targs = targs } };
                        }
                    }
                    }
                }
            }
        }
        .bin   => |b| { cg_ginfer_expr(b.l, lenv, decls); cg_ginfer_expr(b.r, lenv, decls); }
        .un    => |u| { cg_ginfer_expr(u.e, lenv, decls); }
        .fld   => |f| { cg_ginfer_expr(f.base, lenv, decls); }
        .idx   => |x| { cg_ginfer_expr(x.base, lenv, decls); cg_ginfer_expr(x.idx, lenv, decls); }
        .cast_ => |c| { cg_ginfer_expr(c.expr, lenv, decls); }
        .slice_=> |s| { cg_ginfer_expr(s.base, lenv, decls); cg_ginfer_expr(s.lo, lenv, decls); cg_ginfer_expr(s.hi, lenv, decls); }
        .slit_ => |s| { let i2: i32 = 0; while (i2 < len[FieldInit](s.fields)) { cg_ginfer_expr(get[FieldInit](s.fields, i2).val, lenv, decls); i2 = i2 + 1; } }
        else => { }
    }
}

// Try to fill targs on a generic call using the expected return type `hint`.
// Called after cg_ginfer_expr when a let binding has a declared type and the
// call's targs are still empty (param-based inference didn't resolve all params).
fn cg_ginfer_expr_hint(n: *Node, lenv: ArrayList[Param], decls: ArrayList[*Node], hint: []u8) void {
    if (hint.len == 0) { return; }
    switch (n.*) {
        .call => |c| {
            if (len[[]u8](c.targs) > 0) { return; }
            let cn: []u8 = cg_callee_name(c.callee);
            if (cn.len > 0) {
                // ── built-in: make(cap) → T from hint ArrayList[T] ────────
                if (@strEq(cn, "make") && cg_starts_with(hint, "ArrayList[") == 1 && hint.len > 11) {
                    let ety_h: []u8 = cg_arraylist_elem(hint);
                    let targs_h: ArrayList[[]u8] = make[[]u8](2);
                    push[[]u8](&targs_h, ety_h);
                    n.* = Node{ .call = Call{ .callee = c.callee, .args = c.args, .targs = targs_h } };
                } else {
                let gf: FnDecl = FnDecl{ .name = "", .tparams = make[[]u8](1), .params = make[Param](1), .ret = "", .annots = make[[]u8](1), .body = make[*Node](1), .is_extern = 0, .ret_eff = "", .caps = 0, .cap_names = "", .cap_types = "", .line = 0, .is_pub = 0 };
                if (cg_find_generic_fn(decls, cn, &gf) == 1) {
                    let targs: ArrayList[[]u8] = make[[]u8](len[[]u8](gf.tparams) + 1);
                    let ok: i32 = 1;
                    let ti: i32 = 0;
                    while (ti < len[[]u8](gf.tparams)) {
                        let tp: []u8 = get[[]u8](gf.tparams, ti);
                        let bound: []u8 = cg_unify_bind(gf.ret, hint, tp);
                        if (bound.len == 0) { ok = 0; }
                        push[[]u8](&targs, bound);
                        ti = ti + 1;
                    }
                    if (ok == 1) {
                        n.* = Node{ .call = Call{ .callee = c.callee, .args = c.args, .targs = targs } };
                    }
                }
                }
            }
        }
        else => { }
    }
}

fn cg_ginfer_stmt(n: *Node, lenv: *ArrayList[Param], decls: ArrayList[*Node]) void {
    switch (n.*) {
        .let_ => |l| {
            cg_ginfer_expr(l.expr, lenv.*, decls);
            if (l.has_dty == 1) { cg_ginfer_expr_hint(l.expr, lenv.*, decls, l.dty); }
            let pty: []u8 = l.dty;
            if (l.has_dty == 0) {
                let inferred: []u8 = cg_ginfer_expr_retty(l.expr, decls);
                if (inferred.len > 0) { pty = inferred; }
            }
            push[Param](lenv, Param{ .name = l.name, .pty = pty, .eff = "", .contract = "", .calign = 0 });
        }
        .ret     => |r| { if (r.has_expr == 1) { cg_ginfer_expr(r.expr, lenv.*, decls); } }
        .assign  => |a| { cg_ginfer_expr(a.expr, lenv.*, decls); }
        .estmt   => |s| { cg_ginfer_expr(s.expr, lenv.*, decls); }
        .if_     => |x| {
            cg_ginfer_expr(x.cond, lenv.*, decls);
            let ai: i32 = 0; while (ai < len[*Node](x.then_body)) { cg_ginfer_stmt(get[*Node](x.then_body, ai), lenv, decls); ai = ai + 1; }
            if (x.has_els == 1) { let bi: i32 = 0; while (bi < len[*Node](x.els_body)) { cg_ginfer_stmt(get[*Node](x.els_body, bi), lenv, decls); bi = bi + 1; } }
        }
        .while_  => |w| {
            cg_ginfer_expr(w.cond, lenv.*, decls);
            let wi: i32 = 0; while (wi < len[*Node](w.body)) { cg_ginfer_stmt(get[*Node](w.body, wi), lenv, decls); wi = wi + 1; }
        }
        .unsafe_ => |u| {
            let ui: i32 = 0;
            while (ui < len[*Node](u.body)) { cg_ginfer_stmt(get[*Node](u.body, ui), lenv, decls); ui = ui + 1; }
        }
        else => { }
    }
}

// Run type-arg inference on all non-generic fn bodies before monomorphization.
fn cg_ginfer_pass(decls: ArrayList[*Node]) void {
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                if (len[[]u8](f.tparams) == 0 && f.is_extern == 0) {
                    let lenv: ArrayList[Param] = make[Param](8);
                    let pi: i32 = 0;
                    while (pi < len[Param](f.params)) {
                        push[Param](&lenv, get[Param](f.params, pi));
                        pi = pi + 1;
                    }
                    let bi: i32 = 0;
                    while (bi < len[*Node](f.body)) { cg_ginfer_stmt(get[*Node](f.body, bi), &lenv, decls); bi = bi + 1; }
                }
            }
            else => { }
        }
        i = i + 1;
    }
}

// Register the generic STRUCT instance Base[targs] (and, transitively, any
// generic struct types its substituted fields reference) as concrete mangled
// StructDecls appended to e.decls. Dependencies are recorded first.
fn cg_inst_struct(e: *Exp, base: []u8, targs: ArrayList[[]u8], orig: ArrayList[*Node]) void {
    if (len[[]u8](targs) == 0) { return; }
    // Register nested generic struct deps from compound type-args first
    // (e.g. ArrayList[ArrayList[i32]] needs ArrayList_i32 before ArrayList_ArrayList_i32).
    let ti: i32 = 0;
    while (ti < len[[]u8](targs)) {
        cg_inst_type(e, get[[]u8](targs, ti), orig);
        ti = ti + 1;
    }
    let mangled: []u8 = cg_mangle_generic_norm(base, targs);
    if (cg_exp_seen(e, mangled) == 1) { return; }
    let sd: StructDecl = StructDecl{ .name = "", .fields = make[Param](1), .tparams = make[[]u8](1), .origin = "<root>" };
    if (cg_find_generic_struct(orig, base, &sd) == 0) { return; }
    // mark seen up front (struct fields can be self-referential through a pointer)
    push[[]u8](&e.*.seen, mangled);
    // substitute field types, recording nested generic struct deps first.
    let newfields: ArrayList[Param] = make[Param](len[Param](sd.fields) + 1);
    let fi: i32 = 0;
    while (fi < len[Param](sd.fields)) {
        let p: Param = get[Param](sd.fields, fi);
        let st: []u8 = cg_subst_type(p.pty, sd.tparams, targs);
        cg_inst_type(e, st, orig);
        push[Param](&newfields, Param{ .name = p.name, .pty = cg_norm_type(st),
            .eff = p.eff, .contract = p.contract, .calign = p.calign });
        fi = fi + 1;
    }
    push[*Node](&e.*.decls, new(Node{ .struct_ = StructDecl{ .name = mangled, .fields = newfields,
        .tparams = make[[]u8](1), .annots = sd.annots, .origin = "<root>" } }));
}

// Record a generic struct instantiation implied by a type string (e.g.
// "*ArrayList[i32]" → ArrayList[i32]). Strips *, ?, !, [] prefixes.
fn cg_inst_type(e: *Exp, t: []u8, orig: ArrayList[*Node]) void {
    let u: []u8 = t;
    let go: i32 = 1;
    while (go == 1) {
        if (u.len > 1 && (u[0] == '*' || u[0] == '?' || u[0] == '!')) { u = u[1..]; }
        else if (u.len > 2 && u[0] == '[' && u[1] == ']') { u = u[2..]; }
        else { go = 0; }
    }
    if (is_generic_app(u) == false) { return; }
    let lb: i32 = index_of(u, '[');
    let base: []u8 = u[0..lb];
    let arglist: ArrayList[[]u8] = split_args(u[lb + 1..u.len - 1]);
    cg_inst_struct(e, base, arglist, orig);
}

// Walk an expression, registering generic struct instances (struct lits, casts).
fn cg_inst_sinst_expr(e: *Exp, n: *Node, orig: ArrayList[*Node]) void {
    switch (n.*) {
        .slit_ => |s| {
            cg_inst_struct(e, s.sname, s.targs, orig);
            let i: i32 = 0;
            while (i < len[FieldInit](s.fields)) { cg_inst_sinst_expr(e, get[FieldInit](s.fields, i).val, orig); i = i + 1; }
        }
        .call  => |c| { let i: i32 = 0; while (i < len[*Node](c.args)) { cg_inst_sinst_expr(e, get[*Node](c.args, i), orig); i = i + 1; } }
        .bin   => |b| { cg_inst_sinst_expr(e, b.l, orig); cg_inst_sinst_expr(e, b.r, orig); }
        .un    => |u| { cg_inst_sinst_expr(e, u.e, orig); }
        .fld   => |f| { cg_inst_sinst_expr(e, f.base, orig); }
        .idx   => |x| { cg_inst_sinst_expr(e, x.base, orig); cg_inst_sinst_expr(e, x.idx, orig); }
        .cast_ => |c| { cg_inst_type(e, c.target, orig); cg_inst_sinst_expr(e, c.expr, orig); }
        .slice_=> |s| { cg_inst_sinst_expr(e, s.base, orig); cg_inst_sinst_expr(e, s.lo, orig); cg_inst_sinst_expr(e, s.hi, orig); }
        else => { }
    }
}

// Walk an expression, registering generic FN instances (foo[T](..) calls).
fn cg_inst_fn_expr(e: *Exp, n: *Node, orig: ArrayList[*Node]) void {
    switch (n.*) {
        .call => |c| {
            let i: i32 = 0;
            while (i < len[*Node](c.args)) { cg_inst_fn_expr(e, get[*Node](c.args, i), orig); i = i + 1; }
            if (len[[]u8](c.targs) > 0) {
                let cn: []u8 = cg_callee_name(c.callee);
                // Register nested struct instances implied by compound type-args
                // (e.g. make[ArrayList[i32]] needs ArrayList_i32 before its body).
                let ti: i32 = 0;
                while (ti < len[[]u8](c.targs)) {
                    cg_inst_type(e, get[[]u8](c.targs, ti), orig);
                    ti = ti + 1;
                }
                let mangled: []u8 = cg_mangle_generic_norm(cn, c.targs);
                if (cg_exp_seen(e, mangled) == 0) {
                    let f: FnDecl = FnDecl{ .name = "", .tparams = make[[]u8](1), .params = make[Param](1), .ret = "", .annots = make[[]u8](1), .body = make[*Node](1), .is_extern = 0, .ret_eff = "", .caps = 0, .cap_names = "", .cap_types = "", .line = 0, .is_pub = 0 };
                    if (cg_find_generic_fn(orig, cn, &f) == 1) {
                        push[[]u8](&e.*.seen, mangled);
                        // clone body with tp→targs; build concrete params/ret.
                        let cb: ArrayList[*Node] = cg_clone_block(f.body, f.tparams, c.targs);
                        let nps: ArrayList[Param] = make[Param](len[Param](f.params) + 1);
                        let pi: i32 = 0;
                        while (pi < len[Param](f.params)) {
                            let p: Param = get[Param](f.params, pi);
                            // A generic function signature can be the ONLY place
                            // that mentions a generic struct instance. Register
                            // the substituted type before normalizing it to its
                            // mangled concrete name; once normalized,
                            // cg_inst_type cannot recover the type arguments.
                            // Without this, a qualified get[T](ArrayList[T])
                            // specialization had no ArrayList_T layout, so
                            // xs.data typed as unknown and data[i] was rejected.
                            let pty: []u8 = cg_subst_type(p.pty, f.tparams, c.targs);
                            cg_inst_type(e, pty, orig);
                            push[Param](&nps, Param{ .name = p.name, .pty = cg_norm_type(pty),
                                .eff = p.eff, .contract = p.contract, .calign = p.calign });
                            pi = pi + 1;
                        }
                        let rty: []u8 = cg_subst_type(f.ret, f.tparams, c.targs);
                        cg_inst_type(e, rty, orig);
                        let nret: []u8 = cg_norm_type(rty);
                        push[*Node](&e.*.decls, new(Node{ .fn_decl = FnDecl{
                            .name = mangled, .tparams = make[[]u8](1), .params = nps,
                            .ret = nret, .annots = f.annots, .body = cb, .is_extern = 0,
                            .ret_eff = f.ret_eff, .caps = 0, .cap_names = "", .cap_types = "",
                            .line = f.line, .is_pub = 0, .origin = f.origin } }));
                    }
                }
            }
        }
        .bin   => |b| { cg_inst_fn_expr(e, b.l, orig); cg_inst_fn_expr(e, b.r, orig); }
        .un    => |u| { cg_inst_fn_expr(e, u.e, orig); }
        .fld   => |f| { cg_inst_fn_expr(e, f.base, orig); }
        .idx   => |x| { cg_inst_fn_expr(e, x.base, orig); cg_inst_fn_expr(e, x.idx, orig); }
        .cast_ => |c| { cg_inst_fn_expr(e, c.expr, orig); }
        .slice_=> |s| { cg_inst_fn_expr(e, s.base, orig); cg_inst_fn_expr(e, s.lo, orig); cg_inst_fn_expr(e, s.hi, orig); }
        .slit_ => |s| { let i: i32 = 0; while (i < len[FieldInit](s.fields)) { cg_inst_fn_expr(e, get[FieldInit](s.fields, i).val, orig); i = i + 1; } }
        else => { }
    }
}

// Walk a statement for BOTH fn and struct instances.
fn cg_inst_stmt(e: *Exp, n: *Node, orig: ArrayList[*Node]) void {
    switch (n.*) {
        .let_    => |l| { cg_inst_type(e, l.dty, orig); cg_inst_fn_expr(e, l.expr, orig); cg_inst_sinst_expr(e, l.expr, orig); }
        .ret     => |r| { if (r.has_expr == 1) { cg_inst_fn_expr(e, r.expr, orig); cg_inst_sinst_expr(e, r.expr, orig); } }
        .if_     => |x| { cg_inst_fn_expr(e, x.cond, orig); cg_inst_sinst_expr(e, x.cond, orig); cg_inst_body(e, x.then_body, orig); if (x.has_els == 1) { cg_inst_body(e, x.els_body, orig); } }
        .while_  => |w| { cg_inst_fn_expr(e, w.cond, orig); cg_inst_sinst_expr(e, w.cond, orig); cg_inst_body(e, w.body, orig); }
        .unsafe_ => |u| { cg_inst_body(e, u.body, orig); }
        .assign  => |a| { cg_inst_fn_expr(e, a.target, orig); cg_inst_fn_expr(e, a.expr, orig); cg_inst_sinst_expr(e, a.target, orig); cg_inst_sinst_expr(e, a.expr, orig); }
        .estmt   => |s| { cg_inst_fn_expr(e, s.expr, orig); cg_inst_sinst_expr(e, s.expr, orig); }
        .switch_ => |sw| {
            cg_inst_fn_expr(e, sw.subject, orig); cg_inst_sinst_expr(e, sw.subject, orig);
            let ai: i32 = 0;
            while (ai < len[SwitchArm](sw.arms)) { cg_inst_body(e, get[SwitchArm](sw.arms, ai).body, orig); ai = ai + 1; }
            if (sw.has_els == 1) { cg_inst_body(e, sw.els_body, orig); }
        }
        else => { }
    }
}

fn cg_inst_body(e: *Exp, body: ArrayList[*Node], orig: ArrayList[*Node]) void {
    let i: i32 = 0;
    while (i < len[*Node](body)) { cg_inst_stmt(e, get[*Node](body, i), orig); i = i + 1; }
}

// EXPAND the program: append a concrete mangled decl for every generic
// instantiation, to a fixpoint (a specialized body can instantiate more). The
// `orig` list (the unexpanded templates) is the search space for templates; new
// instance decls are appended to `e.decls` and ALSO walked (so transitive
// instances are discovered). Returns the expanded decl list.
fn cg_expand_generics(decls: ArrayList[*Node]) ArrayList[*Node] {
    let e: Exp = Exp{ .decls = make[*Node](len[*Node](decls) + 8), .seen = make[[]u8](8) };
    // seed with the originals.
    let i: i32 = 0;
    while (i < len[*Node](decls)) { push[*Node](&e.decls, get[*Node](decls, i)); i = i + 1; }
    // walk every NON-generic fn body for instances; also struct/fn signatures.
    let di: i32 = 0;
    while (di < len[*Node](decls)) {
        switch (get[*Node](decls, di).*) {
            .fn_decl => |f| {
                if (len[[]u8](f.tparams) == 0 && f.is_extern == 0) {
                    cg_inst_body(&e, f.body, decls);
                    let pj: i32 = 0;
                    while (pj < len[Param](f.params)) { cg_inst_type(&e, get[Param](f.params, pj).pty, decls); pj = pj + 1; }
                    cg_inst_type(&e, f.ret, decls);
                }
            }
            .struct_ => |s| {
                // A NON-generic struct whose FIELD is a generic-struct application
                // (e.g. `params: ArrayList[i32]`) must register that instance so the
                // field's true size (not the scalar default) is known when this
                // struct's layout is computed. Generic templates (tparams > 0) emit
                // no layout themselves — their concrete instances do.
                if (len[[]u8](s.tparams) == 0) {
                    let fj: i32 = 0;
                    while (fj < len[Param](s.fields)) { cg_inst_type(&e, get[Param](s.fields, fj).pty, decls); fj = fj + 1; }
                }
            }
            .union_ => |u| {
                // Likewise a non-generic union whose variant PAYLOAD is a generic
                // struct application (or contains one) registers that instance.
                let uj: i32 = 0;
                while (uj < len[Param](u.fields)) { cg_inst_type(&e, get[Param](u.fields, uj).pty, decls); uj = uj + 1; }
            }
            else => { }
        }
        di = di + 1;
    }
    // FIXPOINT: walk each appended instance fn body (cloned, concrete) for more
    // instances. New decls land at the end of e.decls; iterate until the cursor
    // catches the (growing) length. Instance struct decls have empty bodies, so
    // only fn_decl instances add work.
    let fp: i32 = len[*Node](decls);
    while (fp < len[*Node](e.decls)) {
        switch (get[*Node](e.decls, fp).*) {
            .fn_decl => |f2| {
                if (f2.is_extern == 0) {
                    cg_inst_body(&e, f2.body, decls);
                    let pj2: i32 = 0;
                    while (pj2 < len[Param](f2.params)) { cg_inst_type(&e, get[Param](f2.params, pj2).pty, decls); pj2 = pj2 + 1; }
                    cg_inst_type(&e, f2.ret, decls);
                }
            }
            .struct_ => |s2| {
                // a concrete instance struct's field types may reference further
                // generic struct instances; ensure those are registered.
                let sj: i32 = 0;
                while (sj < len[Param](s2.fields)) { cg_inst_type(&e, get[Param](s2.fields, sj).pty, decls); sj = sj + 1; }
            }
            else => { }
        }
        fp = fp + 1;
    }
    // e.decls is returned to the caller; e.seen is only a temporary fixpoint
    // index and its backing array is dead once expansion is complete.
    free[[]u8](&e.seen);
    return e.decls;
}

// The concrete struct name a struct LITERAL denotes: generic → mangled, else the
// plain name. (StructLit.targs is empty for a non-generic literal.)
fn cg_slit_sname(s: StructLit) []u8 {
    if (len[[]u8](s.targs) > 0) { return cg_mangle_generic_norm(s.sname, s.targs); }
    return s.sname;
}
