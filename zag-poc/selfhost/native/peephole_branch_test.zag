// Structural and executable proof for peephole R6:
//     jmp/jcc L ; L:  ->  L:
// A branch to its immediately following target cannot change control flow.

@import("isa.zag")
@import("x86.zag")
@import("elf.zag")
@import("peephole.zag")

fn bt_check(ok: i32, label: []u8, fails: *i32) void {
    if (ok == 1) {
        _zag_print("  ok  ");
        _zag_println(label);
    } else {
        _zag_print("  XX  ");
        _zag_println(label);
        fails.* = fails.* + 1;
    }
}

fn bt_adjacent_case(branch: Instr, label: []u8, fails: *i32) void {
    let p: ArrayList[Instr] = make[Instr](3);
    push[Instr](&p, branch);
    push[Instr](&p, i_label(branch.lbl));
    let out: ArrayList[Instr] = peephole(p);
    bt_check((out.len == 1 && get[Instr](out, 0).kind == K_LABEL() &&
        get[Instr](out, 0).lbl == branch.lbl) as i32, label, fails);
}

fn bt_run_case(root: []u8, tag: []u8, p: ArrayList[Instr], expected: i32,
               minimum_saved: i32, fails: *i32) void {
    let original: ArrayList[u8] = encode(p);
    let optimized_ir: ArrayList[Instr] = peephole(p);
    let optimized: ArrayList[u8] = encode(optimized_ir);
    let base: []u8 = _zag_str_concat(_zag_str_concat(root, "/"), tag);
    let original_path: []u8 = _zag_str_concat(base, "_original");
    let optimized_path: []u8 = _zag_str_concat(base, "_optimized");
    let w1: i32 = write_elf_exec(original_path, original, 0);
    let w2: i32 = write_elf_exec(optimized_path, optimized, 0);
    let r1: i32 = _zag_exec_cmd(original_path);
    let r2: i32 = _zag_exec_cmd(optimized_path);
    bt_check((w1 == 0 && w2 == 0) as i32, _zag_str_concat(tag, " writes"), fails);
    bt_check((r1 == expected && r2 == r1) as i32,
        _zag_str_concat(tag, " differential exit"), fails);
    bt_check((original.len - optimized.len >= minimum_saved) as i32,
        _zag_str_concat(tag, " shrinks"), fails);
}

fn bt_exit_after_branch(branch: Instr, code: i32) ArrayList[Instr] {
    let p: ArrayList[Instr] = make[Instr](9);
    push[Instr](&p, i_mov_imm(R_RAX(), 0));
    push[Instr](&p, i_cmp_imm(R_RAX(), 0));
    push[Instr](&p, branch);
    push[Instr](&p, i_label(branch.lbl));
    push[Instr](&p, i_mov_imm(R_RDI(), code as i64));
    push[Instr](&p, i_mov_imm(R_RAX(), 60));
    push[Instr](&p, i_syscall());
    return p;
}

fn main() i32 {
    let fails: i32 = 0;
    let output_root: []u8 = "/tmp";
    if (_zag_argc() > 1) { output_root = _zag_arg(1); }

    bt_adjacent_case(i_jmp(10), "adjacent jmp removed", &fails);
    bt_adjacent_case(i_je(11), "adjacent je removed", &fails);
    bt_adjacent_case(i_jne(12), "adjacent jne removed", &fails);
    bt_adjacent_case(i_jl(13), "adjacent jl removed", &fails);
    bt_adjacent_case(i_jle(14), "adjacent jle removed", &fails);
    bt_adjacent_case(i_jg(15), "adjacent jg removed", &fails);
    bt_adjacent_case(i_jge(16), "adjacent jge removed", &fails);

    // Mismatched label and call-to-next-label are semantic negatives.
    let mismatch: ArrayList[Instr] = make[Instr](4);
    push[Instr](&mismatch, i_jmp(20));
    push[Instr](&mismatch, i_label(21));
    let mismatch_out: ArrayList[Instr] = peephole(mismatch);
    bt_check((mismatch_out.len == 2 && get[Instr](mismatch_out, 0).kind == K_JMP()) as i32,
        "mismatched target retained", &fails);

    let call_next: ArrayList[Instr] = make[Instr](4);
    push[Instr](&call_next, i_call(22));
    push[Instr](&call_next, i_label(22));
    let call_out: ArrayList[Instr] = peephole(call_next);
    bt_check((call_out.len == 2 && get[Instr](call_out, 0).kind == K_CALL()) as i32,
        "call side effect retained", &fails);

    bt_run_case(output_root, "jmp", bt_exit_after_branch(i_jmp(30), 42), 42, 5, &fails);
    bt_run_case(output_root, "je", bt_exit_after_branch(i_je(31), 43), 43, 6, &fails);
    bt_run_case(output_root, "jne", bt_exit_after_branch(i_jne(32), 44), 44, 6, &fails);

    _zag_print("peephole-branch fail=");
    _zag_println(_zag_i64_to_str(fails as i64));
    return fails;
}
