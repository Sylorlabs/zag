// Source-level AArch64 backend harness.  The foreground compiler builds this
// small x86-64 runner; the runner then invokes the checked-in ARM64 parser,
// generic expansion, lowering, encoder, and ELF writer from this worktree.
@import("acodegen.zag")
@import("aarch64.zag")
@import("elf_arm64.zag")
@import("ncodegen.zag") // shared GlobalSym and ELF object record vocabulary
@import("elf.zag")
@import("../parse.zag")
@import("../../std/rt.zag")

fn main() i32 {
    if (_zag_argc() != 3) {
        _zag_eprintln("usage: acodegen_source_test <input.zag> <output>");
        return 2;
    }
    let src: []u8 = _zag_read_file(_zag_arg(1));
    if (src.len < 0) { return 3; }
    let decls: ArrayList[*Node] = parse_program(src);
    let data: ArrayList[u8] = make[u8](16);
    let nerr: i32 = 0;
    let prog: ArrayList[AInstr] = aload_program(
        decls, &nerr, &data, 1, 1, 0, 0, 0);
    if (nerr != 0 || prog.len == 0) { return 4; }
    let code: ArrayList[u8] = aencode(prog);
    if (write_elf_arm64_data(_zag_arg(2), code, 0, data) != 0) { return 5; }
    return 0;
}
