    else if(op==I32IROp.wide_ge){high_cc=0x9d;low_cc=0x93;}
    else if(op==I32IROp.wide_ult){high_cc=0x92;low_cc=0x92;}
    else if(op==I32IROp.wide_ule){high_cc=0x96;low_cc=0x96;}
    else if(op==I32IROp.wide_ugt){high_cc=0x97;low_cc=0x97;}
