    i386_b(out,0xd1);i386_b(out,0x54);i386_b(out,0x24);i386_b(out,40);
    i386_b(out,0xd1);i386_b(out,0x64);i386_b(out,0x24);i386_b(out,0);
    i386_b(out,0xd1);i386_b(out,0x54);i386_b(out,0x24);i386_b(out,4);
    i386_b(out,0xd1);i386_b(out,0x64);i386_b(out,0x24);i386_b(out,8);
