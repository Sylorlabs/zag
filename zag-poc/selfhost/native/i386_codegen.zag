        i386_b(out,0x0f);i386_b(out,0x84);let quotient_positive:i32=out.*.len;i386_i32(out,0);
        i386_b(out,0xf7);i386_b(out,0x1c);i386_b(out,0x24);
        i386_b(out,0x83);i386_b(out,0x54);i386_b(out,0x24);i386_b(out,4);i386_b(out,0);
        i386_b(out,0xf7);i386_b(out,0x5c);i386_b(out,0x24);i386_b(out,4);
        i386_patch32(out,quotient_positive,out.*.len-(quotient_positive+4));
        i386_b(out,0x83);i386_b(out,0x7c);i386_b(out,0x24);i386_b(out,24);i386_b(out,0);
        i386_b(out,0x0f);i386_b(out,0x84);let remainder_positive:i32=out.*.len;i386_i32(out,0);
        i386_b(out,0xf7);i386_b(out,0x5c);i386_b(out,0x24);i386_b(out,8);
        i386_b(out,0x83);i386_b(out,0x54);i386_b(out,0x24);i386_b(out,12);i386_b(out,0);
        i386_b(out,0xf7);i386_b(out,0x5c);i386_b(out,0x24);i386_b(out,12);
