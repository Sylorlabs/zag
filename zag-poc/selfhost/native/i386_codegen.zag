    i386_b(out,0xc7);i386_b(out,0x44);i386_b(out,0x24);i386_b(out,16);i386_i32(out,64);
    i386_b(out,0xc7);i386_b(out,0x44);i386_b(out,0x24);i386_b(out,20);i386_i32(out,0);
