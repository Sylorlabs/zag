    // Consume right.low/right.high/left.low, leaving left.high at [esp].
    i386_b(out,0x59);i386_b(out,0x5a);i386_b(out,0x58);
    if(op==I32IROp.wide_eq||op==I32IROp.wide_ne){
        i386_b(out,0x31);i386_b(out,0xc8);                 // xor eax,ecx
        i386_b(out,0x33);i386_b(out,0x14);i386_b(out,0x24); // xor edx,[esp]
