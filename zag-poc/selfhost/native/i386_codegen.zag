// Validated 32-bit integer lowering shared by the isolated Linux/i386 target.
// This deliberately consumes the normal Zag AST. Unsupported types and nodes
// fail before an ELF is written; the source text is never pattern matched.
@import("../parse.zag")

enum I32IROp { enter, const_, load, store, addr, deref, store_ind, add, sub, eq, ne, lt, le, gt, ge, label, jz, jmp, call, ret }
struct I32IR { op: I32IROp, value: i64 }
struct I386Local { name: []u8, slot: i32, ty: []u8 }
struct I386Fn { name: []u8, label: i32, params: i32 }
struct I386Lower { ir: ArrayList[I32IR], locals: ArrayList[I386Local], funcs: ArrayList[I386Fn], failed: i32, next_label: i32, break_label: i32, continue_label: i32 }
struct I386Patch { pos: i32, label: i32 }

fn i386_fail(c: *I386Lower, msg: []u8) void {
    if (c.*.failed == 0) { _zag_eprintln(_zag_str_concat("znc i686: unsupported construct: ", msg)); }
    c.*.failed = 1;
}
fn i386_local(c: *I386Lower, name: []u8) i32 {
    let i:i32=0;
    while(i<c.*.locals.len) {
        if(@strEq(c.*.locals.data[i].name,name)) { return c.*.locals.data[i].slot; }
        i=i+1;
    }
    return -1000000;
}
fn i386_emit_ir(c: *I386Lower, op: I32IROp, value: i64) void {
    push[I32IR](&c.*.ir,I32IR{.op=op,.value=value});
}
fn i386_new_label(c: *I386Lower) i32 { let n:i32=c.*.next_label;c.*.next_label=n+1;return n; }
fn i386_fn(c:*I386Lower,name:[]u8) i32 { let i:i32=0;while(i<c.*.funcs.len){if(@strEq(c.*.funcs.data[i].name,name)){return i;}i=i+1;}return -1; }
fn i386_word_ty(ty:[]u8) i32 { if(@strEq(ty,"i32")||@strEq(ty,"usize")||@strEq(ty,"*i32")||@strEq(ty,"*usize")){return 1;}return 0; }
fn i386_expr(c: *I386Lower, n: *Node) void {
    switch(n.*) {
        .ilit => |x| { i386_emit_ir(c,I32IROp.const_,_zag_str_to_i64(x.text)); }
        .id => |x| {
            let slot:i32=i386_local(c,x.name);
            if(slot==-1000000) { i386_fail(c,_zag_str_concat("unknown or uninitialized i32 local `",_zag_str_concat(x.name,"`"))); }
            else { i386_emit_ir(c,I32IROp.load,slot as i64); }
        }
        .bin => |x| {
            if(!@strEq(x.op,"+") && !@strEq(x.op,"-") && !@strEq(x.op,"==") && !@strEq(x.op,"!=") &&
               !@strEq(x.op,"<") && !@strEq(x.op,"<=") && !@strEq(x.op,">") && !@strEq(x.op,">=")) { i386_fail(c,"integer expression requires arithmetic or comparison"); }
            else {
                i386_expr(c,x.l); i386_expr(c,x.r);
                if(@strEq(x.op,"+")) { i386_emit_ir(c,I32IROp.add,0); }
                else if(@strEq(x.op,"-")) { i386_emit_ir(c,I32IROp.sub,0); }
                else if(@strEq(x.op,"==")) { i386_emit_ir(c,I32IROp.eq,0); }
                else if(@strEq(x.op,"!=")) { i386_emit_ir(c,I32IROp.ne,0); }
                else if(@strEq(x.op,"<")) { i386_emit_ir(c,I32IROp.lt,0); }
                else if(@strEq(x.op,"<=")) { i386_emit_ir(c,I32IROp.le,0); }
                else if(@strEq(x.op,">")) { i386_emit_ir(c,I32IROp.gt,0); }
                else { i386_emit_ir(c,I32IROp.ge,0); }
            }
        }
        .un => |x| {
            if(@strEq(x.op,"-")) { i386_emit_ir(c,I32IROp.const_,0); i386_expr(c,x.e); i386_emit_ir(c,I32IROp.sub,0); }
            else if(@strEq(x.op,"&")) { let slot:i32=-1000000;switch(x.e.*){.id=>|id|{slot=i386_local(c,id.name);}else=>{}}if(slot<0){i386_fail(c,"address-of requires a stack local");}else{i386_emit_ir(c,I32IROp.addr,slot);} }
            else { i386_fail(c,"unsupported unary expression"); }
        }
        .fld => |x| { if(@strEq(x.fname,"*")){i386_expr(c,x.base);i386_emit_ir(c,I32IROp.deref,0);}else{i386_fail(c,"struct fields are not implemented for i686 yet");} }
        .call => |x| {
            let name:[]u8="";switch(x.callee.*){.id=>|id|{name=id.name;}else=>{}}
            let fi:i32=i386_fn(c,name);
            if(fi<0){i386_fail(c,"call target must be a known non-generic i32 function");return;}
            if(x.args.len!=c.*.funcs.data[fi].params){i386_fail(c,"call argument count does not match function signature");return;}
            let ai:i32=x.args.len-1;while(ai>=0){i386_expr(c,x.args.data[ai]);ai=ai-1;}
            // label in high bits, argument count in low 16 bits.
            i386_emit_ir(c,I32IROp.call,((c.*.funcs.data[fi].label as i64)*65536)+(x.args.len as i64));
        }
        else => { i386_fail(c,"expression is outside the i32 backend"); }
    }
}
fn i386_stmt(c: *I386Lower, n: *Node) void {
    switch(n.*) {
        .let_ => |x| {
            if(x.has_init==0) { i386_fail(c,"uninitialized locals are rejected"); return; }
            if(x.has_dty==1 && i386_word_ty(x.dty)==0) { i386_fail(c,"local type is not a supported 32-bit scalar"); return; }
            if(i386_local(c,x.name)!=-1000000) { i386_fail(c,"duplicate local name"); return; }
            i386_expr(c,x.expr);
            let slot:i32=c.*.locals.len;
            let ty:[]u8="i32";if(x.has_dty==1){ty=x.dty;}
            push[I386Local](&c.*.locals,I386Local{.name=x.name,.slot=slot,.ty=ty});
            i386_emit_ir(c,I32IROp.store,slot as i64);
        }
        .assign => |x| {
            let slot:i32=-1000000;
            switch(x.target.*) {
                .id => |id| { slot=i386_local(c,id.name); }
                .fld => |f| { if(@strEq(f.fname,"*")){i386_expr(c,f.base);i386_expr(c,x.expr);i386_emit_ir(c,I32IROp.store_ind,0);return;} }
                else => { }
            }
            if(slot==-1000000) { i386_fail(c,"assignment target must be a local or pointer dereference"); return; }
            i386_expr(c,x.expr); i386_emit_ir(c,I32IROp.store,slot as i64);
        }
        .ret => |x| {
            if(x.has_expr==0) { i386_fail(c,"i32 return requires a value"); }
            else { i386_expr(c,x.expr); i386_emit_ir(c,I32IROp.ret,0); }
        }
        .if_ => |x| {
            if(x.has_cap==1) { i386_fail(c,"if captures are not supported"); return; }
            let els:i32=i386_new_label(c);let done:i32=i386_new_label(c);
            i386_expr(c,x.cond);i386_emit_ir(c,I32IROp.jz,els);
            let i:i32=0;while(i<x.then_body.len){i386_stmt(c,x.then_body.data[i]);i=i+1;}
            i386_emit_ir(c,I32IROp.jmp,done);i386_emit_ir(c,I32IROp.label,els);
            let j:i32=0;while(j<x.els_body.len){i386_stmt(c,x.els_body.data[j]);j=j+1;}
            i386_emit_ir(c,I32IROp.label,done);
        }
        .while_ => |x| {
            if(x.has_cap==1) { i386_fail(c,"while captures are not supported"); return; }
            let start:i32=i386_new_label(c);let done:i32=i386_new_label(c);
            let old_break:i32=c.*.break_label;let old_continue:i32=c.*.continue_label;
            c.*.break_label=done;c.*.continue_label=start;
            i386_emit_ir(c,I32IROp.label,start);i386_expr(c,x.cond);i386_emit_ir(c,I32IROp.jz,done);
            let i:i32=0;while(i<x.body.len){i386_stmt(c,x.body.data[i]);i=i+1;}
            i386_emit_ir(c,I32IROp.jmp,start);i386_emit_ir(c,I32IROp.label,done);
            c.*.break_label=old_break;c.*.continue_label=old_continue;
        }
        .break_ => |_x| { if(c.*.break_label<0){i386_fail(c,"break outside loop");}else{i386_emit_ir(c,I32IROp.jmp,c.*.break_label);} }
        .continue_ => |_x| { if(c.*.continue_label<0){i386_fail(c,"continue outside loop");}else{i386_emit_ir(c,I32IROp.jmp,c.*.continue_label);} }
        else => { i386_fail(c,"statement is outside the current i32 IR"); }
    }
}

fn lower_i386_i32_program(decls: ArrayList[*Node], out: *I386Lower) i32 {
    let found:i32=0;
    // Declare every callable symbol first so forward calls are deterministic.
    let i:i32=0;
    while(i<decls.len) {
        switch(decls.data[i].*) {
            .fn_decl => |f| {
                if(i386_fn(out,f.name)>=0){i386_fail(out,"duplicate function");}
                if(f.tparams.len!=0 || !@strEq(f.ret,"i32") || f.is_extern==1){i386_fail(out,"functions must be non-generic, defined, and return i32");}
                let pi:i32=0;while(pi<f.params.len){if(i386_word_ty(f.params.data[pi].pty)==0){i386_fail(out,"function parameter is not a supported 32-bit scalar");}pi=pi+1;}
                push[I386Fn](&out.*.funcs,I386Fn{.name=f.name,.label=i386_new_label(out),.params=f.params.len});
                if(@strEq(f.name,"main")){if(found==1){i386_fail(out,"duplicate main");}found=1;if(f.params.len!=0){i386_fail(out,"main must not take parameters");}}
            }
            else => { i386_fail(out,"only an i32 main declaration is supported"); }
        }
        i=i+1;
    }
    if(found==0) { i386_fail(out,"missing `fn main() i32`"); }
    // Main is emitted first because ELF _start enters the first function.
    let pass:i32=0;while(pass<2){let di:i32=0;while(di<decls.len){switch(decls.data[di].*){.fn_decl=>|f|{
        if((pass==0&&@strEq(f.name,"main"))||(pass==1&&!@strEq(f.name,"main"))){
            out.*.locals=make[I386Local](8);out.*.break_label=-1;out.*.continue_label=-1;
            let pi:i32=0;while(pi<f.params.len){push[I386Local](&out.*.locals,I386Local{.name=f.params.data[pi].name,.slot=-1-pi,.ty=f.params.data[pi].pty});pi=pi+1;}
            i386_emit_ir(out,I32IROp.label,out.*.funcs.data[i386_fn(out,f.name)].label);
            let enter_at:i32=out.*.ir.len;i386_emit_ir(out,I32IROp.enter,0);
            let before:i32=out.*.ir.len;let j:i32=0;while(j<f.body.len){i386_stmt(out,f.body.data[j]);j=j+1;}
            let has_ret:i32=0;let ri:i32=before;while(ri<out.*.ir.len){if(out.*.ir.data[ri].op==I32IROp.ret){has_ret=1;}ri=ri+1;}
            if(has_ret==0){i386_fail(out,_zag_str_concat("function lacks return: ",f.name));}
            let local_count:i32=out.*.locals.len-f.params.len;set[I32IR](&out.*.ir,enter_at,I32IR{.op=I32IROp.enter,.value=local_count});
        }}else=>{}}di=di+1;}pass=pass+1;}
    return out.*.failed;
}

fn i386_b(out:*ArrayList[u8],b:i64) void { push[u8](out,(b&255) as u8); }
fn i386_i32(out:*ArrayList[u8],v0:i64) void { let v:i64=v0; let i:i32=0; while(i<4){let b:i64=v&255;i386_b(out,b);v=(v-b)/256;i=i+1;} }
fn i386_patch32(out:*ArrayList[u8],pos:i32,v0:i64) void { let v:i64=v0;let i:i32=0;while(i<4){let b:i64=v&255;set[u8](out,pos+i,b as u8);v=(v-b)/256;i=i+1;} }
fn encode_i386_i32(c:*I386Lower) ArrayList[u8] {
    let out:ArrayList[u8]=make[u8](128);
    let labels:ArrayList[i32]=make[i32](c.*.next_label+1);let li:i32=0;while(li<c.*.next_label){push[i32](&labels,-1);li=li+1;}
    let patches:ArrayList[I386Patch]=make[I386Patch](16);
    let i:i32=0;
    while(i<c.*.ir.len) {
        let x:I32IR=c.*.ir.data[i];
        switch(x.op) {
            .enter => { i386_b(&out,0x55);i386_b(&out,0x89);i386_b(&out,0xe5);if(x.value>0){i386_b(&out,0x81);i386_b(&out,0xec);i386_i32(&out,x.value*4);} }
            .const_ => { i386_b(&out,0xb8);i386_i32(&out,x.value);i386_b(&out,0x50); }
            .load => { i386_b(&out,0x8b);i386_b(&out,0x85);if(x.value<0){i386_i32(&out,8+((0-x.value-1)*4));}else{i386_i32(&out,0-((x.value+1)*4));}i386_b(&out,0x50); }
            .store => { i386_b(&out,0x58);i386_b(&out,0x89);i386_b(&out,0x85);i386_i32(&out,0-((x.value+1)*4)); }
            .addr => { i386_b(&out,0x8d);i386_b(&out,0x85);i386_i32(&out,0-((x.value+1)*4));i386_b(&out,0x50); }
            .deref => { i386_b(&out,0x58);i386_b(&out,0x8b);i386_b(&out,0x00);i386_b(&out,0x50); }
            .store_ind => { i386_b(&out,0x58);i386_b(&out,0x59);i386_b(&out,0x89);i386_b(&out,0x01); }
            .add => { i386_b(&out,0x59);i386_b(&out,0x58);i386_b(&out,0x01);i386_b(&out,0xc8);i386_b(&out,0x50); }
            .sub => { i386_b(&out,0x59);i386_b(&out,0x58);i386_b(&out,0x29);i386_b(&out,0xc8);i386_b(&out,0x50); }
            .eq => { i386_b(&out,0x59);i386_b(&out,0x58);i386_b(&out,0x39);i386_b(&out,0xc8);i386_b(&out,0x0f);i386_b(&out,0x94);i386_b(&out,0xc0);i386_b(&out,0x0f);i386_b(&out,0xb6);i386_b(&out,0xc0);i386_b(&out,0x50); }
            .ne => { i386_b(&out,0x59);i386_b(&out,0x58);i386_b(&out,0x39);i386_b(&out,0xc8);i386_b(&out,0x0f);i386_b(&out,0x95);i386_b(&out,0xc0);i386_b(&out,0x0f);i386_b(&out,0xb6);i386_b(&out,0xc0);i386_b(&out,0x50); }
            .lt => { i386_b(&out,0x59);i386_b(&out,0x58);i386_b(&out,0x39);i386_b(&out,0xc8);i386_b(&out,0x0f);i386_b(&out,0x9c);i386_b(&out,0xc0);i386_b(&out,0x0f);i386_b(&out,0xb6);i386_b(&out,0xc0);i386_b(&out,0x50); }
            .le => { i386_b(&out,0x59);i386_b(&out,0x58);i386_b(&out,0x39);i386_b(&out,0xc8);i386_b(&out,0x0f);i386_b(&out,0x9e);i386_b(&out,0xc0);i386_b(&out,0x0f);i386_b(&out,0xb6);i386_b(&out,0xc0);i386_b(&out,0x50); }
            .gt => { i386_b(&out,0x59);i386_b(&out,0x58);i386_b(&out,0x39);i386_b(&out,0xc8);i386_b(&out,0x0f);i386_b(&out,0x9f);i386_b(&out,0xc0);i386_b(&out,0x0f);i386_b(&out,0xb6);i386_b(&out,0xc0);i386_b(&out,0x50); }
            .ge => { i386_b(&out,0x59);i386_b(&out,0x58);i386_b(&out,0x39);i386_b(&out,0xc8);i386_b(&out,0x0f);i386_b(&out,0x9d);i386_b(&out,0xc0);i386_b(&out,0x0f);i386_b(&out,0xb6);i386_b(&out,0xc0);i386_b(&out,0x50); }
            .label => { set[i32](&labels,x.value as i32,out.len); }
            .jz => { i386_b(&out,0x58);i386_b(&out,0x85);i386_b(&out,0xc0);i386_b(&out,0x0f);i386_b(&out,0x84);push[I386Patch](&patches,I386Patch{.pos=out.len,.label=x.value as i32});i386_i32(&out,0); }
            .jmp => { i386_b(&out,0xe9);push[I386Patch](&patches,I386Patch{.pos=out.len,.label=x.value as i32});i386_i32(&out,0); }
            .call => { let label:i32=(x.value/65536) as i32;let nargs:i32=(x.value&65535) as i32;i386_b(&out,0xe8);push[I386Patch](&patches,I386Patch{.pos=out.len,.label=label});i386_i32(&out,0);if(nargs>0){i386_b(&out,0x81);i386_b(&out,0xc4);i386_i32(&out,nargs*4);}i386_b(&out,0x50); }
            .ret => { i386_b(&out,0x58);i386_b(&out,0xc9);i386_b(&out,0xc3); }
        }
        i=i+1;
    }
    let p:i32=0;while(p<patches.len){let q:I386Patch=patches.data[p];i386_patch32(&out,q.pos,(labels.data[q.label]-(q.pos+4)) as i64);p=p+1;}
    return out;
}
