    i386_b(out,0x3b);i386_b(out,0x4c);i386_b(out,0x24);i386_b(out,32);
    i386_b(out,0x0f);i386_b(out,0x87);let high_subtract:i32=out.*.len;i386_i32(out,0);
    i386_b(out,0x0f);i386_b(out,0x82);let high_no_subtract:i32=out.*.len;i386_i32(out,0);
    i386_b(out,0x8b);i386_b(out,0x4c);i386_b(out,0x24);i386_b(out,8);
    i386_b(out,0x3b);i386_b(out,0x4c);i386_b(out,0x24);i386_b(out,28);
    i386_b(out,0x0f);i386_b(out,0x82);let low_no_subtract:i32=out.*.len;i386_i32(out,0);
    let subtract:i32=out.*.len;
    i386_patch32(out,carry_subtract,subtract-(carry_subtract+4));
    i386_patch32(out,high_subtract,subtract-(high_subtract+4));
