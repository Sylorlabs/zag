        i386_b(out,0x0f);i386_b(out,0x84);let divisor_positive:i32=out.*.len;i386_i32(out,0);
        i386_b(out,0xf7);i386_b(out,0x5c);i386_b(out,0x24);i386_b(out,28);
        i386_b(out,0x83);i386_b(out,0x54);i386_b(out,0x24);i386_b(out,32);i386_b(out,0);
        i386_b(out,0xf7);i386_b(out,0x5c);i386_b(out,0x24);i386_b(out,32);
        i386_patch32(out,divisor_positive,out.*.len-(divisor_positive+4));
        // Convert a negative dividend to its unsigned magnitude.
        i386_b(out,0xf7);i386_b(out,0x44);i386_b(out,0x24);i386_b(out,40);i386_i32(out,2147483648);
        i386_b(out,0x0f);i386_b(out,0x84);let dividend_positive:i32=out.*.len;i386_i32(out,0);
        i386_b(out,0xf7);i386_b(out,0x5c);i386_b(out,0x24);i386_b(out,36);
        i386_b(out,0x83);i386_b(out,0x54);i386_b(out,0x24);i386_b(out,40);i386_b(out,0);
        i386_b(out,0xf7);i386_b(out,0x5c);i386_b(out,0x24);i386_b(out,40);
