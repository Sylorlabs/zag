            .ugt => { i386_b(&out,0x59);i386_b(&out,0x58);i386_b(&out,0x39);i386_b(&out,0xc8);i386_b(&out,0x0f);i386_b(&out,0x97);i386_b(&out,0xc0);i386_b(&out,0x0f);i386_b(&out,0xb6);i386_b(&out,0xc0);i386_b(&out,0x50); }
            .uge => { i386_b(&out,0x59);i386_b(&out,0x58);i386_b(&out,0x39);i386_b(&out,0xc8);i386_b(&out,0x0f);i386_b(&out,0x93);i386_b(&out,0xc0);i386_b(&out,0x0f);i386_b(&out,0xb6);i386_b(&out,0xc0);i386_b(&out,0x50); }
            .label => { set[i32](&labels,x.value as i32,out.len); }
            .jz => { i386_b(&out,0x58);i386_b(&out,0x85);i386_b(&out,0xc0);i386_b(&out,0x0f);i386_b(&out,0x84);push[I386Patch](&patches,I386Patch{.pos=out.len,.label=x.value as i32});i386_i32(&out,0); }
            .jmp => { i386_b(&out,0xe9);push[I386Patch](&patches,I386Patch{.pos=out.len,.label=x.value as i32});i386_i32(&out,0); }
            .call => { let label:i32=(x.value/65536) as i32;let nargs:i32=(x.value&65535) as i32;i386_b(&out,0xe8);i386_call_disp(c,&out,&patches,label);if(nargs>0){i386_b(&out,0x81);i386_b(&out,0xc4);i386_i32(&out,nargs*4);}i386_b(&out,0x50); }
            .call_void => { let label:i32=(x.value/65536) as i32;let nargs:i32=(x.value&65535) as i32;i386_b(&out,0xe8);i386_call_disp(c,&out,&patches,label);if(nargs>0){i386_b(&out,0x81);i386_b(&out,0xc4);i386_i32(&out,nargs*4);} }
            .call_pair => { let label:i32=(x.value/65536) as i32;let nargs:i32=(x.value&65535) as i32;i386_b(&out,0xe8);i386_call_disp(c,&out,&patches,label);if(nargs>0){i386_b(&out,0x81);i386_b(&out,0xc4);i386_i32(&out,nargs*4);}i386_b(&out,0x52);i386_b(&out,0x50); }
            .call_sret => { let label:i32=(x.value/65536) as i32;let nargs:i32=(x.value&65535) as i32;i386_b(&out,0xe8);i386_call_disp(c,&out,&patches,label);if(nargs>0){i386_b(&out,0x81);i386_b(&out,0xc4);i386_i32(&out,nargs*4);} }
            .fcall => { let label:i32=(x.value/65536) as i32;let nargs:i32=(x.value&65535) as i32;i386_b(&out,0xe8);i386_call_disp(c,&out,&patches,label);if(nargs>0){i386_b(&out,0x81);i386_b(&out,0xc4);i386_i32(&out,nargs*4);}i386_b(&out,0x83);i386_b(&out,0xec);i386_b(&out,8);i386_b(&out,0xdd);i386_b(&out,0x1c);i386_b(&out,0x24); }
            .f32call => { let label:i32=(x.value/65536) as i32;let nargs:i32=(x.value&65535) as i32;i386_b(&out,0xe8);i386_call_disp(c,&out,&patches,label);if(nargs>0){i386_b(&out,0x81);i386_b(&out,0xc4);i386_i32(&out,nargs*4);}i386_b(&out,0x83);i386_b(&out,0xec);i386_b(&out,4);i386_b(&out,0xd9);i386_b(&out,0x1c);i386_b(&out,0x24); }
            .call_err => { let label:i32=(x.value/65536) as i32;let nargs:i32=(x.value&65535) as i32;i386_b(&out,0xe8);i386_call_disp(c,&out,&patches,label);if(nargs>0){i386_b(&out,0x81);i386_b(&out,0xc4);i386_i32(&out,nargs*4);}i386_b(&out,0x52);i386_b(&out,0x50); }
            .err_jnz => { i386_b(&out,0x58);i386_b(&out,0x5a);i386_b(&out,0x85);i386_b(&out,0xd2);i386_b(&out,0x0f);i386_b(&out,0x85);push[I386Patch](&patches,I386Patch{.pos=out.len,.label=x.value as i32});i386_i32(&out,0);i386_b(&out,0x50); }
            .try_ => { i386_b(&out,0x58);i386_b(&out,0x5a);i386_b(&out,0x85);i386_b(&out,0xd2);i386_b(&out,0x74);i386_b(&out,4);i386_b(&out,0x31);i386_b(&out,0xc0);i386_b(&out,0xc9);i386_b(&out,0xc3);i386_b(&out,0x50); }
            // Linux i386 write(2): eax=4, ebx=fd, ecx=buf, edx=count.
            // EBX is restored before the syscall result is placed on the IR stack.
            .write => { i386_b(&out,0x5a);i386_b(&out,0x59);i386_b(&out,0x58);i386_b(&out,0x53);i386_b(&out,0x89);i386_b(&out,0xc3);i386_b(&out,0xb8);i386_i32(&out,4);i386_b(&out,0xcd);i386_b(&out,0x80);i386_b(&out,0x5b);i386_b(&out,0x50); }
            .write_slice => { i386_b(&out,0x59);i386_b(&out,0x5a);i386_b(&out,0x53);i386_b(&out,0xbb);i386_i32(&out,1);i386_b(&out,0xb8);i386_i32(&out,4);i386_b(&out,0xcd);i386_b(&out,0x80);i386_b(&out,0x5b);i386_b(&out,0x50); }
            // Signed decimal plus newline in a 16-byte stack buffer. The
            // routine preserves EBX/ESI/EDI and leaves write(2)'s result pushed.
            .print_i32 => {
                i386_b(&out,0x58);i386_b(&out,0x53);i386_b(&out,0x56);i386_b(&out,0x57);i386_b(&out,0x83);i386_b(&out,0xec);i386_b(&out,16);
                i386_b(&out,0x8d);i386_b(&out,0x7c);i386_b(&out,0x24);i386_b(&out,15);i386_b(&out,0xc6);i386_b(&out,0x07);i386_b(&out,10);i386_b(&out,0x4f);
                i386_b(&out,0x31);i386_b(&out,0xf6);i386_b(&out,0x85);i386_b(&out,0xc0);i386_b(&out,0x7d);i386_b(&out,7);
                i386_b(&out,0xf7);i386_b(&out,0xd8);i386_b(&out,0xbe);i386_i32(&out,1);
                i386_b(&out,0x31);i386_b(&out,0xd2);i386_b(&out,0xb9);i386_i32(&out,10);i386_b(&out,0xf7);i386_b(&out,0xf1);
                i386_b(&out,0x80);i386_b(&out,0xc2);i386_b(&out,48);i386_b(&out,0x88);i386_b(&out,0x17);i386_b(&out,0x4f);i386_b(&out,0x85);i386_b(&out,0xc0);i386_b(&out,0x75);i386_b(&out,0xed);
                i386_b(&out,0x85);i386_b(&out,0xf6);i386_b(&out,0x74);i386_b(&out,4);i386_b(&out,0xc6);i386_b(&out,0x07);i386_b(&out,45);i386_b(&out,0x4f);i386_b(&out,0x47);
                i386_b(&out,0x8d);i386_b(&out,0x54);i386_b(&out,0x24);i386_b(&out,16);i386_b(&out,0x29);i386_b(&out,0xfa);i386_b(&out,0x89);i386_b(&out,0xf9);
                i386_b(&out,0xbb);i386_i32(&out,1);i386_b(&out,0xb8);i386_i32(&out,4);i386_b(&out,0xcd);i386_b(&out,0x80);
                i386_b(&out,0x83);i386_b(&out,0xc4);i386_b(&out,16);i386_b(&out,0x5f);i386_b(&out,0x5e);i386_b(&out,0x5b);i386_b(&out,0x50);
            }
            .ret => { i386_b(&out,0x58);i386_b(&out,0xc9);i386_b(&out,0xc3); }
            .ret_void => { i386_b(&out,0xc9);i386_b(&out,0xc3); }
            .ret_pair => { i386_b(&out,0x58);i386_b(&out,0x5a);i386_b(&out,0xc9);i386_b(&out,0xc3); }
            .ret_sret => { i386_b(&out,0x8b);i386_b(&out,0x45);i386_b(&out,8);i386_b(&out,0xc9);i386_b(&out,0xc2);i386_b(&out,4);i386_b(&out,0); }
            .fret => { i386_b(&out,0xdd);i386_b(&out,0x04);i386_b(&out,0x24);i386_b(&out,0x83);i386_b(&out,0xc4);i386_b(&out,8);i386_b(&out,0xc9);i386_b(&out,0xc3); }
            .f32ret => { i386_b(&out,0xd9);i386_b(&out,0x04);i386_b(&out,0x24);i386_b(&out,0x83);i386_b(&out,0xc4);i386_b(&out,4);i386_b(&out,0xc9);i386_b(&out,0xc3); }
            .ret_ok => { i386_b(&out,0x58);i386_b(&out,0x31);i386_b(&out,0xd2);i386_b(&out,0xc9);i386_b(&out,0xc3); }
            .ret_err => { i386_b(&out,0xba);i386_i32(&out,x.value);i386_b(&out,0x31);i386_b(&out,0xc0);i386_b(&out,0xc9);i386_b(&out,0xc3); }
        }
        i=i+1;
    }
    let p:i32=0;while(p<patches.len){let q:I386Patch=patches.data[p];i386_patch32(&out,q.pos,(labels.data[q.label]-(q.pos+4)) as i64);p=p+1;}
    let fi:i32=0;while(fi<c.*.funcs.len){if(c.*.funcs.data[fi].defined==1){c.*.funcs.data[fi].offset=labels.data[c.*.funcs.data[fi].label];}fi=fi+1;}
    return out;
}

fn i386_object_code(c:*I386Lower,text:ArrayList[u8]) I686ObjectCode {
    let symbols:ArrayList[I686CodeSymbol]=make[I686CodeSymbol](c.*.funcs.len+1);let has_main:i32=0;let i:i32=0;
    while(i<c.*.funcs.len){let f:I386Fn=c.*.funcs.data[i];if(f.defined==0||f.exported==1){let size:i32=0;if(f.defined==1){let end:i32=text.len;let j:i32=0;while(j<c.*.funcs.len){let q:I386Fn=c.*.funcs.data[j];if(q.defined==1&&q.offset>f.offset&&q.offset<end){end=q.offset;}j=j+1;}size=end-f.offset;}push[I686CodeSymbol](&symbols,I686CodeSymbol{.name=f.name,.offset=f.offset,.size=size,.defined=f.defined});}if(f.defined==1&&@strEq(f.name,"main")){has_main=1;}i=i+1;}
    return I686ObjectCode{.text=text,.symbols=symbols,.relocs=c.*.object_relocs,.has_main=has_main};
}
