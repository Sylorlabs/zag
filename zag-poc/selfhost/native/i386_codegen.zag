// EAX is a 32-bit base address and ECX is a usize element index. Scale without
// truncation and reject both multiplication overflow and address wrap.
fn i386_checked_index_address(out:*ArrayList[u8],stride:i32)void{
    if(stride!=1){i386_b(out,0x69);i386_b(out,0xc9);i386_i32(out,stride);i386_guard_cc(out,0x81,"panic: i686 index address overflow\n");}
