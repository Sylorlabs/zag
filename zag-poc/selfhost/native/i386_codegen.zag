// Validated 32-bit integer lowering shared by the isolated Linux/i386 target.
// This deliberately consumes the normal Zag AST. Unsupported types and nodes
// fail before an ELF is written; the source text is never pattern matched.
@import("../parse.zag")

enum I32IROp { enter, const_, str_const, f32_const, f64_const, load, pair_load, f32_load, f64_load, store, pair_store, f32_store, f64_store, addr, deref, store_ind, add, sub, f32add, f32sub, f32mul, f32div, fadd, fsub, fmul, fdiv, eq, ne, lt, le, gt, ge, f32eq, f32ne, f32lt, f32le, f32gt, f32ge, feq, fne, flt, fle, fgt, fge, label, jz, jmp, call, call_pair, call_sret, f32call, fcall, call_err, err_jnz, try_, write, write_slice, print_i32, ret, ret_pair, ret_sret, f32ret, fret, ret_ok, ret_err }
struct I32IR { op: I32IROp, value: i64 }
struct I386Local { name: []u8, slot: i32, ty: []u8 }
struct I386Fn { name: []u8, label: i32, params: i32, param_words: i32, param_types: ArrayList[[]u8], ret_ty: []u8, returns_error: i32 }
struct I386Lower { ir: ArrayList[I32IR], locals: ArrayList[I386Local], funcs: ArrayList[I386Fn], structs: ArrayList[StructDecl], strings:ArrayList[[]u8], failed: i32, next_label: i32, next_slot: i32, break_label: i32, continue_label: i32, current_error_fn: i32, expected_ty: []u8, current_ret_ty: []u8, sret_target: i32 }
struct I386Patch { pos: i32, label: i32 }

fn i386_fail(c: *I386Lower, msg: []u8) void {
    if (c.*.failed == 0) { _zag_eprintln(_zag_str_concat("znc i686: unsupported construct: ", msg)); }
    c.*.failed = 1;
}
fn i386_local(c: *I386Lower, name: []u8) i32 {
    let i:i32=0;
    while(i<c.*.locals.len) {
        if(@strEq(c.*.locals.data[i].name,name)) { return c.*.locals.data[i].slot; }
        i=i+1;
    }
    return -1000000;
}
fn i386_emit_ir(c: *I386Lower, op: I32IROp, value: i64) void {
    push[I32IR](&c.*.ir,I32IR{.op=op,.value=value});
}
fn i386_new_label(c: *I386Lower) i32 { let n:i32=c.*.next_label;c.*.next_label=n+1;return n; }
fn i386_fn(c:*I386Lower,name:[]u8) i32 { let i:i32=0;while(i<c.*.funcs.len){if(@strEq(c.*.funcs.data[i].name,name)){return i;}i=i+1;}return -1; }
fn i386_word_ty(ty:[]u8) i32 { if(@strEq(ty,"i32")||@strEq(ty,"usize")||@strEq(ty,"*i32")||@strEq(ty,"*usize")){return 1;}return 0; }
fn i386_float_ty(ty:[]u8) i32 { if(@strEq(ty,"f64")){return 1;}if(@strEq(ty,"f32")){return 2;}return 0; }
fn i386_slice_ty(ty:[]u8)i32{if(@strEq(ty,"[]u8")||@strEq(ty,"String")){return 1;}return 0;}
fn i386_ty_words(ty:[]u8) i32 { if(@strEq(ty,"f64")||i386_slice_ty(ty)==1){return 2;}return 1; }
fn i386_expr_ty(c:*I386Lower,n:*Node) []u8 {
    switch(n.*) {
        .ilit=>|x|{let i:i32=0;while(i<x.text.len){if(x.text[i]=='.'||x.text[i]=='e'||x.text[i]=='E'){if(@strEq(c.*.expected_ty,"f32")){return "f32";}return "f64";}i=i+1;}return "i32";}
        .slit=>|_x|{return "[]u8";}
        .id=>|x|{let li:i32=i386_local_index(c,x.name);if(li>=0){return c.*.locals.data[li].ty;}return "";}
        .bin=>|x|{let lt:[]u8=i386_expr_ty(c,x.l);let rt:[]u8=i386_expr_ty(c,x.r);if(i386_float_ty(lt)>0||i386_float_ty(rt)>0){if(@strEq(x.op,"==")||@strEq(x.op,"!=")||@strEq(x.op,"<")||@strEq(x.op,"<=")||@strEq(x.op,">")||@strEq(x.op,">=")){return "i32";}if(i386_float_ty(lt)>0){return lt;}return rt;}return "i32";}
        .un=>|x|{return i386_expr_ty(c,x.e);}
        .call=>|x|{let name:[]u8="";switch(x.callee.*){.id=>|id|{name=id.name;}else=>{}}let fi:i32=i386_fn(c,name);if(fi>=0){return c.*.funcs.data[fi].ret_ty;}return "i32";}
        else=>{return "i32";}
    }
}
fn i386_struct(c:*I386Lower,name:[]u8) i32 { let i:i32=0;while(i<c.*.structs.len){if(@strEq(c.*.structs.data[i].name,name)){return i;}i=i+1;}return -1; }
fn i386_local_index(c:*I386Lower,name:[]u8) i32 { let i:i32=0;while(i<c.*.locals.len){if(@strEq(c.*.locals.data[i].name,name)){return i;}i=i+1;}return -1; }
fn i386_field(c:*I386Lower,ty:[]u8,name:[]u8) i32 { let si:i32=i386_struct(c,ty);if(si<0){return -1;}let i:i32=0;while(i<c.*.structs.data[si].fields.len){if(@strEq(c.*.structs.data[si].fields.data[i].name,name)){return i;}i=i+1;}return -1; }
fn i386_param_words(c:*I386Lower,ty:[]u8) i32 { let si:i32=i386_struct(c,ty);if(si>=0){return c.*.structs.data[si].fields.len;}return i386_ty_words(ty); }
fn i386_field_slot(l:I386Local,field:i32) i32 { return l.slot-field; }
fn i386_error_code(name:[]u8) i64 { let h:i64=1;let i:i32=0;while(i<name.len){h=((h*33)+(name[i] as i64))&2147483647;i=i+1;}if(h==0){return 1;}return h; }
fn i386_expr(c: *I386Lower, n: *Node) void {
    switch(n.*) {
        .ilit => |x| { let ft:i32=i386_float_ty(i386_expr_ty(c,n));if(ft>0){let ef:i32=0;let bits:i64=zf64_bits_core(x.text,&ef);if(ef!=0){i386_fail(c,"invalid float literal");}else if(ft==2){i386_emit_ir(c,I32IROp.f32_const,w_f64_to_f32_bits(bits));}else{i386_emit_ir(c,I32IROp.f64_const,bits);}}else{i386_emit_ir(c,I32IROp.const_,_zag_str_to_i64(x.text));} }
        .slit => |x| { if(x.text.len<2){i386_fail(c,"invalid byte-string literal");return;}let qi:i32=1;while(qi<x.text.len-1){if(x.text[qi]=='\\'){i386_fail(c,"escaped byte-string literals are not implemented for i686");return;}qi=qi+1;}let si:i32=c.*.strings.len;push[[]u8](&c.*.strings,x.text[1..x.text.len-1]);i386_emit_ir(c,I32IROp.str_const,si); }
        .id => |x| {
            let slot:i32=i386_local(c,x.name);
            if(slot==-1000000) { i386_fail(c,_zag_str_concat("unknown or uninitialized i32 local `",_zag_str_concat(x.name,"`"))); }
            else { let li:i32=i386_local_index(c,x.name);let ft:i32=0;if(li>=0){ft=i386_float_ty(c.*.locals.data[li].ty);if(i386_slice_ty(c.*.locals.data[li].ty)==1){i386_emit_ir(c,I32IROp.pair_load,slot);return;}}if(ft==1){i386_emit_ir(c,I32IROp.f64_load,slot as i64);}else if(ft==2){i386_emit_ir(c,I32IROp.f32_load,slot);}else{i386_emit_ir(c,I32IROp.load,slot as i64);} }
        }
        .bin => |x| {
            if(!@strEq(x.op,"+") && !@strEq(x.op,"-") && !@strEq(x.op,"*") && !@strEq(x.op,"/") && !@strEq(x.op,"==") && !@strEq(x.op,"!=") &&
               !@strEq(x.op,"<") && !@strEq(x.op,"<=") && !@strEq(x.op,">") && !@strEq(x.op,">=")) { i386_fail(c,"integer expression requires arithmetic or comparison"); }
            else {
                let ft:i32=i386_float_ty(i386_expr_ty(c,x.l));let rft:i32=i386_float_ty(i386_expr_ty(c,x.r));if(ft!=rft){let rlit:i32=0;switch(x.r.*){.ilit=>|_q|{rlit=1;}else=>{}}if(ft==2&&rlit==1){c.*.expected_ty="f32";rft=2;}else{i386_fail(c,_zag_str_concat("mixed-width arithmetic requires an explicit cast: ",_zag_str_concat(x.op,_zag_str_concat(" left=",_zag_str_concat(_zag_i64_to_str(ft),_zag_str_concat(" right=",_zag_i64_to_str(rft)))))));return;}}
                i386_expr(c,x.l); i386_expr(c,x.r);
                if(ft>0){let base:i32=0;if(ft==2){base=1;}if(@strEq(x.op,"+")){if(base==1){i386_emit_ir(c,I32IROp.f32add,0);}else{i386_emit_ir(c,I32IROp.fadd,0);}}else if(@strEq(x.op,"-")){if(base==1){i386_emit_ir(c,I32IROp.f32sub,0);}else{i386_emit_ir(c,I32IROp.fsub,0);}}else if(@strEq(x.op,"*")){if(base==1){i386_emit_ir(c,I32IROp.f32mul,0);}else{i386_emit_ir(c,I32IROp.fmul,0);}}else if(@strEq(x.op,"/")){if(base==1){i386_emit_ir(c,I32IROp.f32div,0);}else{i386_emit_ir(c,I32IROp.fdiv,0);}}else if(@strEq(x.op,"==")){if(base==1){i386_emit_ir(c,I32IROp.f32eq,0);}else{i386_emit_ir(c,I32IROp.feq,0);}}else if(@strEq(x.op,"!=")){if(base==1){i386_emit_ir(c,I32IROp.f32ne,0);}else{i386_emit_ir(c,I32IROp.fne,0);}}else if(@strEq(x.op,"<")){if(base==1){i386_emit_ir(c,I32IROp.f32lt,0);}else{i386_emit_ir(c,I32IROp.flt,0);}}else if(@strEq(x.op,"<=")){if(base==1){i386_emit_ir(c,I32IROp.f32le,0);}else{i386_emit_ir(c,I32IROp.fle,0);}}else if(@strEq(x.op,">")){if(base==1){i386_emit_ir(c,I32IROp.f32gt,0);}else{i386_emit_ir(c,I32IROp.fgt,0);}}else{if(base==1){i386_emit_ir(c,I32IROp.f32ge,0);}else{i386_emit_ir(c,I32IROp.fge,0);}}return;}
                if(@strEq(x.op,"+")) { i386_emit_ir(c,I32IROp.add,0); }
                else if(@strEq(x.op,"-")) { i386_emit_ir(c,I32IROp.sub,0); }
                else if(@strEq(x.op,"*")||@strEq(x.op,"/")){i386_fail(c,"integer multiply/divide remain outside the i686 subset");}
                else if(@strEq(x.op,"==")) { i386_emit_ir(c,I32IROp.eq,0); }
                else if(@strEq(x.op,"!=")) { i386_emit_ir(c,I32IROp.ne,0); }
                else if(@strEq(x.op,"<")) { i386_emit_ir(c,I32IROp.lt,0); }
                else if(@strEq(x.op,"<=")) { i386_emit_ir(c,I32IROp.le,0); }
                else if(@strEq(x.op,">")) { i386_emit_ir(c,I32IROp.gt,0); }
                else { i386_emit_ir(c,I32IROp.ge,0); }
            }
        }
        .un => |x| {
            if(@strEq(x.op,"-")) { if(i386_float_ty(i386_expr_ty(c,x.e))==1){i386_fail(c,"unary f64 negation is not implemented");}else{i386_emit_ir(c,I32IROp.const_,0);i386_expr(c,x.e);i386_emit_ir(c,I32IROp.sub,0);} }
            else if(@strEq(x.op,"&")) { let slot:i32=-1000000;switch(x.e.*){.id=>|id|{slot=i386_local(c,id.name);}else=>{}}if(slot<0){i386_fail(c,"address-of requires a stack local");}else{i386_emit_ir(c,I32IROp.addr,slot);} }
            else if(@strEq(x.op,"try")) { if(c.*.current_error_fn==0){i386_fail(c,"try requires an !i32 function");}else{i386_expr(c,x.e);i386_emit_ir(c,I32IROp.try_,0);} }
            else { i386_fail(c,"unsupported unary expression"); }
        }
        .fld => |x| {
            let is_error:i32=0;switch(x.base.*){.id=>|id|{if(@strEq(id.name,"error")){is_error=1;}}else=>{}}
            if(is_error==1){i386_emit_ir(c,I32IROp.const_,i386_error_code(x.fname));}
            else if(@strEq(x.fname,"*")){i386_expr(c,x.base);i386_emit_ir(c,I32IROp.deref,0);}
            else { let li:i32=-1;switch(x.base.*){.id=>|id|{li=i386_local_index(c,id.name);}else=>{}}if(li<0){i386_fail(c,"field base must be a local struct or byte slice");return;}if(i386_slice_ty(c.*.locals.data[li].ty)==1){if(@strEq(x.fname,"len")){i386_emit_ir(c,I32IROp.load,c.*.locals.data[li].slot-1);}else{i386_fail(c,"byte slices expose only .len in the i686 subset");}return;}let fi:i32=i386_field(c,c.*.locals.data[li].ty,x.fname);if(fi<0){i386_fail(c,"unknown or unsupported struct field");}else{i386_emit_ir(c,I32IROp.load,i386_field_slot(c.*.locals.data[li],fi) as i64);} }
        }
        .call => |x| {
            let name:[]u8="";switch(x.callee.*){.id=>|id|{name=id.name;}else=>{}}
            if(@strEq(name,"__catch")){
                if(x.args.len!=2){i386_fail(c,"catch requires an error union and fallback");return;}
                let err:i32=i386_new_label(c);let done:i32=i386_new_label(c);i386_expr(c,x.args.data[0]);i386_emit_ir(c,I32IROp.err_jnz,err);i386_emit_ir(c,I32IROp.jmp,done);i386_emit_ir(c,I32IROp.label,err);i386_expr(c,x.args.data[1]);i386_emit_ir(c,I32IROp.label,done);return;
            }
            if(@strEq(name,"__catchc")){i386_fail(c,"catch capture is outside the current i686 error subset");return;}
            if(@strEq(name,"_zag_write")){
                if(x.args.len!=3){i386_fail(c,"_zag_write requires fd, pointer, and byte count");return;}
                let wi:i32=0;while(wi<3){i386_expr(c,x.args.data[wi]);wi=wi+1;}
                i386_emit_ir(c,I32IROp.write,0);return;
            }
            if(@strEq(name,"_zag_println_i32")){
                if(x.args.len!=1){i386_fail(c,"_zag_println_i32 requires one i32");return;}
                i386_expr(c,x.args.data[0]);i386_emit_ir(c,I32IROp.print_i32,0);return;
            }
            if(@strEq(name,"_zag_print")){if(x.args.len!=1){i386_fail(c,"_zag_print requires one byte slice");return;}i386_expr(c,x.args.data[0]);i386_emit_ir(c,I32IROp.write_slice,0);return;}
            let fi:i32=i386_fn(c,name);
            if(fi<0){i386_fail(c,"call target must be a known non-generic i32 function");return;}
            if(x.args.len!=c.*.funcs.data[fi].params){i386_fail(c,"call argument count does not match function signature");return;}
            let ai:i32=x.args.len-1;while(ai>=0){let pty:[]u8=c.*.funcs.data[fi].param_types.data[ai];let si:i32=i386_struct(c,pty);if(si>=0){let li:i32=-1;switch(x.args.data[ai].*){.id=>|id|{li=i386_local_index(c,id.name);}else=>{}}if(li<0||!@strEq(c.*.locals.data[li].ty,pty)){i386_fail(c,"by-value struct argument must be a matching local");return;}let fw:i32=c.*.structs.data[si].fields.len-1;while(fw>=0){i386_emit_ir(c,I32IROp.load,i386_field_slot(c.*.locals.data[li],fw));fw=fw-1;}}else{let old:[]u8=c.*.expected_ty;c.*.expected_ty=pty;i386_expr(c,x.args.data[ai]);c.*.expected_ty=old;}ai=ai-1;}
            if(i386_struct(c,c.*.funcs.data[fi].ret_ty)>=0){if(c.*.sret_target<0){i386_fail(c,"aggregate return requires a typed struct destination");return;}i386_emit_ir(c,I32IROp.addr,c.*.sret_target);i386_emit_ir(c,I32IROp.call_sret,((c.*.funcs.data[fi].label as i64)*65536)+(c.*.funcs.data[fi].param_words as i64));return;}
            // label in high bits, argument count in low 16 bits.
            let cop:I32IROp=I32IROp.call;if(c.*.funcs.data[fi].returns_error==1){cop=I32IROp.call_err;}else if(i386_slice_ty(c.*.funcs.data[fi].ret_ty)==1){cop=I32IROp.call_pair;}else if(i386_float_ty(c.*.funcs.data[fi].ret_ty)==1){cop=I32IROp.fcall;}else if(i386_float_ty(c.*.funcs.data[fi].ret_ty)==2){cop=I32IROp.f32call;}
            i386_emit_ir(c,cop,((c.*.funcs.data[fi].label as i64)*65536)+(c.*.funcs.data[fi].param_words as i64));
        }
        else => { i386_fail(c,"expression is outside the i32 backend"); }
    }
}
fn i386_stmt(c: *I386Lower, n: *Node) void {
    switch(n.*) {
        .let_ => |x| {
            if(x.has_init==0) { i386_fail(c,"uninitialized locals are rejected"); return; }
            if(x.has_dty==1 && i386_word_ty(x.dty)==0 && i386_float_ty(x.dty)==0 && i386_slice_ty(x.dty)==0 && i386_struct(c,x.dty)<0) { i386_fail(c,"local type is not a supported i386 scalar, byte slice, or struct"); return; }
            if(i386_local(c,x.name)!=-1000000) { i386_fail(c,"duplicate local name"); return; }
            if(x.has_dty==1 && i386_struct(c,x.dty)>=0) {
                let lit_ok:i32=0;let lit:StructLit=StructLit{.sname="",.fields=make[FieldInit](1),.targs=make[[]u8](1)};
                switch(x.expr.*){.slit_=>|s|{lit=s;lit_ok=1;}else=>{}}
                let si:i32=i386_struct(c,x.dty);let base:i32=c.*.next_slot+c.*.structs.data[si].fields.len-1;let field:i32=0;
                c.*.next_slot=c.*.next_slot+c.*.structs.data[si].fields.len;push[I386Local](&c.*.locals,I386Local{.name=x.name,.slot=base,.ty=x.dty});
                if(lit_ok==0){let old_target:i32=c.*.sret_target;c.*.sret_target=base;i386_expr(c,x.expr);c.*.sret_target=old_target;return;}
                if(!@strEq(lit.sname,x.dty)){i386_fail(c,"struct local requires a matching struct literal or aggregate-return call");return;}
                while(field<c.*.structs.data[si].fields.len){
                    if(i386_word_ty(c.*.structs.data[si].fields.data[field].pty)==0){i386_fail(c,"struct fields must be supported 32-bit scalars");return;}
                    let found:i32=-1;let k:i32=0;while(k<lit.fields.len){if(@strEq(lit.fields.data[k].name,c.*.structs.data[si].fields.data[field].name)){found=k;}k=k+1;}
                    if(found<0){i386_fail(c,"struct literal is missing a field");return;}i386_expr(c,lit.fields.data[found].val);i386_emit_ir(c,I32IROp.store,base-field);field=field+1;
                }
                return;
            }
            let old_expected:[]u8=c.*.expected_ty;if(x.has_dty==1){c.*.expected_ty=x.dty;}i386_expr(c,x.expr);c.*.expected_ty=old_expected;
            let slot:i32=c.*.next_slot;let ty:[]u8="i32";if(x.has_dty==1){ty=x.dty;}c.*.next_slot=slot+i386_ty_words(ty);
            push[I386Local](&c.*.locals,I386Local{.name=x.name,.slot=slot,.ty=ty});
            if(i386_slice_ty(ty)==1){c.*.locals.data[c.*.locals.len-1].slot=slot+1;i386_emit_ir(c,I32IROp.pair_store,slot+1);}else if(i386_float_ty(ty)==1){i386_emit_ir(c,I32IROp.f64_store,slot as i64);}else if(i386_float_ty(ty)==2){i386_emit_ir(c,I32IROp.f32_store,slot);}else{i386_emit_ir(c,I32IROp.store,slot as i64);}
        }
        .assign => |x| {
            let slot:i32=-1000000;
            let target_ty:[]u8="";
            switch(x.target.*) {
                .id => |id| { slot=i386_local(c,id.name);let li:i32=i386_local_index(c,id.name);if(li>=0){target_ty=c.*.locals.data[li].ty;} }
                .fld => |f| {
                    if(@strEq(f.fname,"*")){i386_expr(c,f.base);i386_expr(c,x.expr);i386_emit_ir(c,I32IROp.store_ind,0);return;}
                    let li:i32=-1;switch(f.base.*){.id=>|id|{li=i386_local_index(c,id.name);}else=>{}}
                    if(li>=0){let fi:i32=i386_field(c,c.*.locals.data[li].ty,f.fname);if(fi>=0){i386_expr(c,x.expr);i386_emit_ir(c,I32IROp.store,i386_field_slot(c.*.locals.data[li],fi));return;}}
                }
                else => { }
            }
            if(slot==-1000000) { i386_fail(c,"assignment target must be a local or pointer dereference"); return; }
            let old_expected:[]u8=c.*.expected_ty;c.*.expected_ty=target_ty;i386_expr(c,x.expr);c.*.expected_ty=old_expected;if(i386_float_ty(target_ty)==1){i386_emit_ir(c,I32IROp.f64_store,slot);}else if(i386_float_ty(target_ty)==2){i386_emit_ir(c,I32IROp.f32_store,slot);}else{i386_emit_ir(c,I32IROp.store,slot as i64);}
        }
        .ret => |x| {
            if(x.has_expr==0) { i386_fail(c,"i32 return requires a value"); }
            else {
                let rsi:i32=i386_struct(c,c.*.current_ret_ty);if(rsi>=0){let li:i32=-1;switch(x.expr.*){.id=>|id|{li=i386_local_index(c,id.name);}else=>{}}if(li<0||!@strEq(c.*.locals.data[li].ty,c.*.current_ret_ty)){i386_fail(c,"aggregate return must name a matching local struct");return;}let rf:i32=0;while(rf<c.*.structs.data[rsi].fields.len){i386_emit_ir(c,I32IROp.load,-1);if(rf>0){i386_emit_ir(c,I32IROp.const_,rf*4);i386_emit_ir(c,I32IROp.add,0);}i386_emit_ir(c,I32IROp.load,i386_field_slot(c.*.locals.data[li],rf));i386_emit_ir(c,I32IROp.store_ind,0);rf=rf+1;}i386_emit_ir(c,I32IROp.ret_sret,0);return;}
                if(i386_slice_ty(c.*.current_ret_ty)==1){i386_expr(c,x.expr);i386_emit_ir(c,I32IROp.ret_pair,0);return;}
                let ename:[]u8="";switch(x.expr.*){.fld=>|f|{switch(f.base.*){.id=>|id|{if(@strEq(id.name,"error")){ename=f.fname;}}else=>{}}}else=>{}}
                if(ename.len>0){if(c.*.current_error_fn==0){i386_fail(c,"error return requires !i32");}else{i386_emit_ir(c,I32IROp.ret_err,i386_error_code(ename));}}
                else { let rt:i32=i386_float_ty(i386_expr_ty(c,x.expr));i386_expr(c,x.expr);if(c.*.current_error_fn==1){i386_emit_ir(c,I32IROp.ret_ok,0);}else if(rt==1){i386_emit_ir(c,I32IROp.fret,0);}else if(rt==2){i386_emit_ir(c,I32IROp.f32ret,0);}else{i386_emit_ir(c,I32IROp.ret,0);} }
            }
        }
        .if_ => |x| {
            if(x.has_cap==1) { i386_fail(c,"if captures are not supported"); return; }
            let els:i32=i386_new_label(c);let done:i32=i386_new_label(c);
            i386_expr(c,x.cond);i386_emit_ir(c,I32IROp.jz,els);
            let i:i32=0;while(i<x.then_body.len){i386_stmt(c,x.then_body.data[i]);i=i+1;}
            i386_emit_ir(c,I32IROp.jmp,done);i386_emit_ir(c,I32IROp.label,els);
            let j:i32=0;while(j<x.els_body.len){i386_stmt(c,x.els_body.data[j]);j=j+1;}
            i386_emit_ir(c,I32IROp.label,done);
        }
        .while_ => |x| {
            if(x.has_cap==1) { i386_fail(c,"while captures are not supported"); return; }
            let start:i32=i386_new_label(c);let done:i32=i386_new_label(c);
            let old_break:i32=c.*.break_label;let old_continue:i32=c.*.continue_label;
            c.*.break_label=done;c.*.continue_label=start;
            i386_emit_ir(c,I32IROp.label,start);i386_expr(c,x.cond);i386_emit_ir(c,I32IROp.jz,done);
            let i:i32=0;while(i<x.body.len){i386_stmt(c,x.body.data[i]);i=i+1;}
            i386_emit_ir(c,I32IROp.jmp,start);i386_emit_ir(c,I32IROp.label,done);
            c.*.break_label=old_break;c.*.continue_label=old_continue;
        }
        .break_ => |_x| { if(c.*.break_label<0){i386_fail(c,"break outside loop");}else{i386_emit_ir(c,I32IROp.jmp,c.*.break_label);} }
        .continue_ => |_x| { if(c.*.continue_label<0){i386_fail(c,"continue outside loop");}else{i386_emit_ir(c,I32IROp.jmp,c.*.continue_label);} }
        else => { i386_fail(c,"statement is outside the current i32 IR"); }
    }
}

fn lower_i386_i32_program(decls: ArrayList[*Node], out: *I386Lower) i32 {
    let found:i32=0;
    // Declare every callable symbol first so forward calls are deterministic.
    let i:i32=0;
    while(i<decls.len) {
        switch(decls.data[i].*) {
            .struct_ => |s| { if(s.tparams.len!=0){i386_fail(out,"generic structs are not supported");}else{push[StructDecl](&out.*.structs,s);} }
            .enum_ => |_e| { }
            .fn_decl => |f| {
                if(i386_fn(out,f.name)>=0){i386_fail(out,"duplicate function");}
                let rsi:i32=i386_struct(out,f.ret);if(f.tparams.len!=0 || (!@strEq(f.ret,"i32")&&!@strEq(f.ret,"!i32")&&!@strEq(f.ret,"f64")&&!@strEq(f.ret,"f32")&&i386_slice_ty(f.ret)==0&&rsi<0) || f.is_extern==1){i386_fail(out,"functions must be non-generic, defined, and return a supported i386 scalar, byte slice, or basic struct");}
                if(rsi>=0){let rsf:i32=0;while(rsf<out.*.structs.data[rsi].fields.len){if(i386_word_ty(out.*.structs.data[rsi].fields.data[rsf].pty)==0){i386_fail(out,"aggregate returns require 32-bit scalar fields");}rsf=rsf+1;}}
                let pi:i32=0;let pwords:i32=0;while(pi<f.params.len){let psi:i32=i386_struct(out,f.params.data[pi].pty);if(i386_word_ty(f.params.data[pi].pty)==0&&i386_float_ty(f.params.data[pi].pty)==0&&i386_slice_ty(f.params.data[pi].pty)==0&&psi<0){i386_fail(out,"function parameter is not a supported i386 scalar, byte slice, or struct");}if(psi>=0){let sf:i32=0;while(sf<out.*.structs.data[psi].fields.len){if(i386_word_ty(out.*.structs.data[psi].fields.data[sf].pty)==0){i386_fail(out,"by-value struct parameters require 32-bit scalar fields");}sf=sf+1;}}pwords=pwords+i386_param_words(out,f.params.data[pi].pty);pi=pi+1;}
                let returns_error:i32=0;if(@strEq(f.ret,"!i32")){returns_error=1;}
                let ptypes:ArrayList[[]u8]=make[[]u8](f.params.len);let pti:i32=0;while(pti<f.params.len){push[[]u8](&ptypes,f.params.data[pti].pty);pti=pti+1;}
                push[I386Fn](&out.*.funcs,I386Fn{.name=f.name,.label=i386_new_label(out),.params=f.params.len,.param_words=pwords,.param_types=ptypes,.ret_ty=f.ret,.returns_error=returns_error});
                if(@strEq(f.name,"main")){if(found==1){i386_fail(out,"duplicate main");}found=1;if(f.params.len!=0||!@strEq(f.ret,"i32")){i386_fail(out,"main must be fn main() i32");}}
            }
            else => { i386_fail(out,"only functions and basic structs are supported"); }
        }
        i=i+1;
    }
    if(found==0) { i386_fail(out,"missing `fn main() i32`"); }
    // Main is emitted first because ELF _start enters the first function.
    let pass:i32=0;while(pass<2){let di:i32=0;while(di<decls.len){switch(decls.data[di].*){.fn_decl=>|f|{
        if((pass==0&&@strEq(f.name,"main"))||(pass==1&&!@strEq(f.name,"main"))){
            out.*.locals=make[I386Local](8);out.*.next_slot=0;out.*.break_label=-1;out.*.continue_label=-1;out.*.current_error_fn=0;out.*.current_ret_ty=f.ret;out.*.sret_target=-1;if(@strEq(f.ret,"!i32")){out.*.current_error_fn=1;}
            out.*.expected_ty=f.ret;
            let pi:i32=0;let poff:i32=0;if(i386_struct(out,f.ret)>=0){poff=1;}while(pi<f.params.len){push[I386Local](&out.*.locals,I386Local{.name=f.params.data[pi].name,.slot=-1-poff,.ty=f.params.data[pi].pty});poff=poff+i386_param_words(out,f.params.data[pi].pty);pi=pi+1;}
            i386_emit_ir(out,I32IROp.label,out.*.funcs.data[i386_fn(out,f.name)].label);
            let enter_at:i32=out.*.ir.len;i386_emit_ir(out,I32IROp.enter,0);
            let before:i32=out.*.ir.len;let j:i32=0;while(j<f.body.len){i386_stmt(out,f.body.data[j]);j=j+1;}
            let has_ret:i32=0;let ri:i32=before;while(ri<out.*.ir.len){if(out.*.ir.data[ri].op==I32IROp.ret||out.*.ir.data[ri].op==I32IROp.ret_pair||out.*.ir.data[ri].op==I32IROp.ret_sret||out.*.ir.data[ri].op==I32IROp.fret||out.*.ir.data[ri].op==I32IROp.f32ret||out.*.ir.data[ri].op==I32IROp.ret_ok||out.*.ir.data[ri].op==I32IROp.ret_err){has_ret=1;}ri=ri+1;}
            if(has_ret==0){i386_fail(out,_zag_str_concat("function lacks return: ",f.name));}
            set[I32IR](&out.*.ir,enter_at,I32IR{.op=I32IROp.enter,.value=out.*.next_slot});
        }}else=>{}}di=di+1;}pass=pass+1;}
    return out.*.failed;
}

fn i386_b(out:*ArrayList[u8],b:i64) void { push[u8](out,(b&255) as u8); }
fn i386_i32(out:*ArrayList[u8],v0:i64) void { let v:i64=v0; let i:i32=0; while(i<4){let b:i64=v&255;i386_b(out,b);v=(v-b)/256;i=i+1;} }
fn i386_patch32(out:*ArrayList[u8],pos:i32,v0:i64) void { let v:i64=v0;let i:i32=0;while(i<4){let b:i64=v&255;set[u8](out,pos+i,b as u8);v=(v-b)/256;i=i+1;} }
fn encode_i386_i32(c:*I386Lower) ArrayList[u8] {
    let out:ArrayList[u8]=make[u8](128);
    let labels:ArrayList[i32]=make[i32](c.*.next_label+1);let li:i32=0;while(li<c.*.next_label){push[i32](&labels,-1);li=li+1;}
    let patches:ArrayList[I386Patch]=make[I386Patch](16);
    let i:i32=0;
    while(i<c.*.ir.len) {
        let x:I32IR=c.*.ir.data[i];
        switch(x.op) {
            .enter => { i386_b(&out,0x55);i386_b(&out,0x89);i386_b(&out,0xe5);if(x.value>0){i386_b(&out,0x81);i386_b(&out,0xec);i386_i32(&out,x.value*4);} }
            .const_ => { i386_b(&out,0xb8);i386_i32(&out,x.value);i386_b(&out,0x50); }
            .str_const => { let s:[]u8=c.*.strings.data[x.value as i32];i386_b(&out,0x68);i386_i32(&out,s.len);i386_b(&out,0xe8);i386_i32(&out,s.len);let si:i32=0;while(si<s.len){i386_b(&out,s[si]);si=si+1;} }
            .f32_const => { i386_b(&out,0xb8);i386_i32(&out,x.value);i386_b(&out,0x50); }
            .f64_const => { i386_b(&out,0xb8);i386_i32(&out,(x.value/4294967296)&4294967295);i386_b(&out,0x50);i386_b(&out,0xb8);i386_i32(&out,x.value&4294967295);i386_b(&out,0x50); }
            .load => { i386_b(&out,0x8b);i386_b(&out,0x85);if(x.value<0){i386_i32(&out,8+((0-x.value-1)*4));}else{i386_i32(&out,0-((x.value+1)*4));}i386_b(&out,0x50); }
            .pair_load => { let po:i64=0-((x.value+1)*4);let lo:i64=0-((x.value)*4);if(x.value<0){po=8+((0-x.value-1)*4);lo=po+4;}i386_b(&out,0xff);i386_b(&out,0xb5);i386_i32(&out,lo);i386_b(&out,0xff);i386_b(&out,0xb5);i386_i32(&out,po); }
            .f32_load => { i386_b(&out,0x8b);i386_b(&out,0x85);if(x.value<0){i386_i32(&out,8+((0-x.value-1)*4));}else{i386_i32(&out,0-((x.value+1)*4));}i386_b(&out,0x50); }
            .f64_load => { let off:i64=0-((x.value+1)*4);let high:i64=off-4;if(x.value<0){off=8+((0-x.value-1)*4);high=off+4;}i386_b(&out,0xff);i386_b(&out,0xb5);i386_i32(&out,high);i386_b(&out,0xff);i386_b(&out,0xb5);i386_i32(&out,off); }
            .store => { i386_b(&out,0x58);i386_b(&out,0x89);i386_b(&out,0x85);i386_i32(&out,0-((x.value+1)*4)); }
            .pair_store => { i386_b(&out,0x58);i386_b(&out,0x89);i386_b(&out,0x85);i386_i32(&out,0-((x.value+1)*4));i386_b(&out,0x58);i386_b(&out,0x89);i386_b(&out,0x85);i386_i32(&out,0-((x.value)*4)); }
            .f32_store => { i386_b(&out,0x58);i386_b(&out,0x89);i386_b(&out,0x85);i386_i32(&out,0-((x.value+1)*4)); }
            .f64_store => { i386_b(&out,0x58);i386_b(&out,0x89);i386_b(&out,0x85);i386_i32(&out,0-((x.value+1)*4));i386_b(&out,0x58);i386_b(&out,0x89);i386_b(&out,0x85);i386_i32(&out,0-((x.value+2)*4)); }
            .addr => { i386_b(&out,0x8d);i386_b(&out,0x85);i386_i32(&out,0-((x.value+1)*4));i386_b(&out,0x50); }
            .deref => { i386_b(&out,0x58);i386_b(&out,0x8b);i386_b(&out,0x00);i386_b(&out,0x50); }
            .store_ind => { i386_b(&out,0x58);i386_b(&out,0x59);i386_b(&out,0x89);i386_b(&out,0x01); }
            .add => { i386_b(&out,0x59);i386_b(&out,0x58);i386_b(&out,0x01);i386_b(&out,0xc8);i386_b(&out,0x50); }
            .sub => { i386_b(&out,0x59);i386_b(&out,0x58);i386_b(&out,0x29);i386_b(&out,0xc8);i386_b(&out,0x50); }
            .fadd,.fsub,.fmul,.fdiv => { i386_b(&out,0xdd);i386_b(&out,0x44);i386_b(&out,0x24);i386_b(&out,8);if(x.op==I32IROp.fadd){i386_b(&out,0xdc);i386_b(&out,0x04);i386_b(&out,0x24);}else if(x.op==I32IROp.fsub){i386_b(&out,0xdc);i386_b(&out,0x24);i386_b(&out,0x24);}else if(x.op==I32IROp.fmul){i386_b(&out,0xdc);i386_b(&out,0x0c);i386_b(&out,0x24);}else{i386_b(&out,0xdc);i386_b(&out,0x34);i386_b(&out,0x24);}i386_b(&out,0x83);i386_b(&out,0xc4);i386_b(&out,16);i386_b(&out,0x83);i386_b(&out,0xec);i386_b(&out,8);i386_b(&out,0xdd);i386_b(&out,0x1c);i386_b(&out,0x24); }
            .f32add,.f32sub,.f32mul,.f32div => { i386_b(&out,0xd9);i386_b(&out,0x44);i386_b(&out,0x24);i386_b(&out,4);if(x.op==I32IROp.f32add){i386_b(&out,0xd8);i386_b(&out,0x04);i386_b(&out,0x24);}else if(x.op==I32IROp.f32sub){i386_b(&out,0xd8);i386_b(&out,0x24);i386_b(&out,0x24);}else if(x.op==I32IROp.f32mul){i386_b(&out,0xd8);i386_b(&out,0x0c);i386_b(&out,0x24);}else{i386_b(&out,0xd8);i386_b(&out,0x34);i386_b(&out,0x24);}i386_b(&out,0x83);i386_b(&out,0xc4);i386_b(&out,8);i386_b(&out,0x83);i386_b(&out,0xec);i386_b(&out,4);i386_b(&out,0xd9);i386_b(&out,0x1c);i386_b(&out,0x24); }
            .feq,.fne,.flt,.fle,.fgt,.fge => { i386_b(&out,0xdd);i386_b(&out,0x04);i386_b(&out,0x24);i386_b(&out,0xdd);i386_b(&out,0x44);i386_b(&out,0x24);i386_b(&out,8);i386_b(&out,0xda);i386_b(&out,0xe9);i386_b(&out,0xdf);i386_b(&out,0xe0);i386_b(&out,0x83);i386_b(&out,0xc4);i386_b(&out,16);i386_b(&out,0x9e);i386_b(&out,0x0f);if(x.op==I32IROp.fne){i386_b(&out,0x9a);}else{i386_b(&out,0x9b);}i386_b(&out,0xc2);i386_b(&out,0x0f);if(x.op==I32IROp.feq){i386_b(&out,0x94);}else if(x.op==I32IROp.fne){i386_b(&out,0x95);}else if(x.op==I32IROp.flt){i386_b(&out,0x92);}else if(x.op==I32IROp.fle){i386_b(&out,0x96);}else if(x.op==I32IROp.fgt){i386_b(&out,0x97);}else{i386_b(&out,0x93);}i386_b(&out,0xc0);if(x.op==I32IROp.fne){i386_b(&out,0x08);}else{i386_b(&out,0x20);}i386_b(&out,0xd0);i386_b(&out,0x0f);i386_b(&out,0xb6);i386_b(&out,0xc0);i386_b(&out,0x50); }
            .f32eq,.f32ne,.f32lt,.f32le,.f32gt,.f32ge => { i386_b(&out,0xd9);i386_b(&out,0x04);i386_b(&out,0x24);i386_b(&out,0xd9);i386_b(&out,0x44);i386_b(&out,0x24);i386_b(&out,4);i386_b(&out,0xda);i386_b(&out,0xe9);i386_b(&out,0xdf);i386_b(&out,0xe0);i386_b(&out,0x83);i386_b(&out,0xc4);i386_b(&out,8);i386_b(&out,0x9e);i386_b(&out,0x0f);if(x.op==I32IROp.f32ne){i386_b(&out,0x9a);}else{i386_b(&out,0x9b);}i386_b(&out,0xc2);i386_b(&out,0x0f);if(x.op==I32IROp.f32eq){i386_b(&out,0x94);}else if(x.op==I32IROp.f32ne){i386_b(&out,0x95);}else if(x.op==I32IROp.f32lt){i386_b(&out,0x92);}else if(x.op==I32IROp.f32le){i386_b(&out,0x96);}else if(x.op==I32IROp.f32gt){i386_b(&out,0x97);}else{i386_b(&out,0x93);}i386_b(&out,0xc0);if(x.op==I32IROp.f32ne){i386_b(&out,0x08);}else{i386_b(&out,0x20);}i386_b(&out,0xd0);i386_b(&out,0x0f);i386_b(&out,0xb6);i386_b(&out,0xc0);i386_b(&out,0x50); }
            .eq => { i386_b(&out,0x59);i386_b(&out,0x58);i386_b(&out,0x39);i386_b(&out,0xc8);i386_b(&out,0x0f);i386_b(&out,0x94);i386_b(&out,0xc0);i386_b(&out,0x0f);i386_b(&out,0xb6);i386_b(&out,0xc0);i386_b(&out,0x50); }
            .ne => { i386_b(&out,0x59);i386_b(&out,0x58);i386_b(&out,0x39);i386_b(&out,0xc8);i386_b(&out,0x0f);i386_b(&out,0x95);i386_b(&out,0xc0);i386_b(&out,0x0f);i386_b(&out,0xb6);i386_b(&out,0xc0);i386_b(&out,0x50); }
            .lt => { i386_b(&out,0x59);i386_b(&out,0x58);i386_b(&out,0x39);i386_b(&out,0xc8);i386_b(&out,0x0f);i386_b(&out,0x9c);i386_b(&out,0xc0);i386_b(&out,0x0f);i386_b(&out,0xb6);i386_b(&out,0xc0);i386_b(&out,0x50); }
            .le => { i386_b(&out,0x59);i386_b(&out,0x58);i386_b(&out,0x39);i386_b(&out,0xc8);i386_b(&out,0x0f);i386_b(&out,0x9e);i386_b(&out,0xc0);i386_b(&out,0x0f);i386_b(&out,0xb6);i386_b(&out,0xc0);i386_b(&out,0x50); }
            .gt => { i386_b(&out,0x59);i386_b(&out,0x58);i386_b(&out,0x39);i386_b(&out,0xc8);i386_b(&out,0x0f);i386_b(&out,0x9f);i386_b(&out,0xc0);i386_b(&out,0x0f);i386_b(&out,0xb6);i386_b(&out,0xc0);i386_b(&out,0x50); }
            .ge => { i386_b(&out,0x59);i386_b(&out,0x58);i386_b(&out,0x39);i386_b(&out,0xc8);i386_b(&out,0x0f);i386_b(&out,0x9d);i386_b(&out,0xc0);i386_b(&out,0x0f);i386_b(&out,0xb6);i386_b(&out,0xc0);i386_b(&out,0x50); }
            .label => { set[i32](&labels,x.value as i32,out.len); }
            .jz => { i386_b(&out,0x58);i386_b(&out,0x85);i386_b(&out,0xc0);i386_b(&out,0x0f);i386_b(&out,0x84);push[I386Patch](&patches,I386Patch{.pos=out.len,.label=x.value as i32});i386_i32(&out,0); }
            .jmp => { i386_b(&out,0xe9);push[I386Patch](&patches,I386Patch{.pos=out.len,.label=x.value as i32});i386_i32(&out,0); }
            .call => { let label:i32=(x.value/65536) as i32;let nargs:i32=(x.value&65535) as i32;i386_b(&out,0xe8);push[I386Patch](&patches,I386Patch{.pos=out.len,.label=label});i386_i32(&out,0);if(nargs>0){i386_b(&out,0x81);i386_b(&out,0xc4);i386_i32(&out,nargs*4);}i386_b(&out,0x50); }
            .call_pair => { let label:i32=(x.value/65536) as i32;let nargs:i32=(x.value&65535) as i32;i386_b(&out,0xe8);push[I386Patch](&patches,I386Patch{.pos=out.len,.label=label});i386_i32(&out,0);if(nargs>0){i386_b(&out,0x81);i386_b(&out,0xc4);i386_i32(&out,nargs*4);}i386_b(&out,0x52);i386_b(&out,0x50); }
            .call_sret => { let label:i32=(x.value/65536) as i32;let nargs:i32=(x.value&65535) as i32;i386_b(&out,0xe8);push[I386Patch](&patches,I386Patch{.pos=out.len,.label=label});i386_i32(&out,0);if(nargs>0){i386_b(&out,0x81);i386_b(&out,0xc4);i386_i32(&out,nargs*4);} }
            .fcall => { let label:i32=(x.value/65536) as i32;let nargs:i32=(x.value&65535) as i32;i386_b(&out,0xe8);push[I386Patch](&patches,I386Patch{.pos=out.len,.label=label});i386_i32(&out,0);if(nargs>0){i386_b(&out,0x81);i386_b(&out,0xc4);i386_i32(&out,nargs*4);}i386_b(&out,0x83);i386_b(&out,0xec);i386_b(&out,8);i386_b(&out,0xdd);i386_b(&out,0x1c);i386_b(&out,0x24); }
            .f32call => { let label:i32=(x.value/65536) as i32;let nargs:i32=(x.value&65535) as i32;i386_b(&out,0xe8);push[I386Patch](&patches,I386Patch{.pos=out.len,.label=label});i386_i32(&out,0);if(nargs>0){i386_b(&out,0x81);i386_b(&out,0xc4);i386_i32(&out,nargs*4);}i386_b(&out,0x83);i386_b(&out,0xec);i386_b(&out,4);i386_b(&out,0xd9);i386_b(&out,0x1c);i386_b(&out,0x24); }
            .call_err => { let label:i32=(x.value/65536) as i32;let nargs:i32=(x.value&65535) as i32;i386_b(&out,0xe8);push[I386Patch](&patches,I386Patch{.pos=out.len,.label=label});i386_i32(&out,0);if(nargs>0){i386_b(&out,0x81);i386_b(&out,0xc4);i386_i32(&out,nargs*4);}i386_b(&out,0x52);i386_b(&out,0x50); }
            .err_jnz => { i386_b(&out,0x58);i386_b(&out,0x5a);i386_b(&out,0x85);i386_b(&out,0xd2);i386_b(&out,0x0f);i386_b(&out,0x85);push[I386Patch](&patches,I386Patch{.pos=out.len,.label=x.value as i32});i386_i32(&out,0);i386_b(&out,0x50); }
            .try_ => { i386_b(&out,0x58);i386_b(&out,0x5a);i386_b(&out,0x85);i386_b(&out,0xd2);i386_b(&out,0x74);i386_b(&out,4);i386_b(&out,0x31);i386_b(&out,0xc0);i386_b(&out,0xc9);i386_b(&out,0xc3);i386_b(&out,0x50); }
            // Linux i386 write(2): eax=4, ebx=fd, ecx=buf, edx=count.
            // EBX is restored before the syscall result is placed on the IR stack.
            .write => { i386_b(&out,0x5a);i386_b(&out,0x59);i386_b(&out,0x58);i386_b(&out,0x53);i386_b(&out,0x89);i386_b(&out,0xc3);i386_b(&out,0xb8);i386_i32(&out,4);i386_b(&out,0xcd);i386_b(&out,0x80);i386_b(&out,0x5b);i386_b(&out,0x50); }
            .write_slice => { i386_b(&out,0x59);i386_b(&out,0x5a);i386_b(&out,0x53);i386_b(&out,0xbb);i386_i32(&out,1);i386_b(&out,0xb8);i386_i32(&out,4);i386_b(&out,0xcd);i386_b(&out,0x80);i386_b(&out,0x5b);i386_b(&out,0x50); }
            // Signed decimal plus newline in a 16-byte stack buffer. The
            // routine preserves EBX/ESI/EDI and leaves write(2)'s result pushed.
            .print_i32 => {
                i386_b(&out,0x58);i386_b(&out,0x53);i386_b(&out,0x56);i386_b(&out,0x57);i386_b(&out,0x83);i386_b(&out,0xec);i386_b(&out,16);
                i386_b(&out,0x8d);i386_b(&out,0x7c);i386_b(&out,0x24);i386_b(&out,15);i386_b(&out,0xc6);i386_b(&out,0x07);i386_b(&out,10);i386_b(&out,0x4f);
                i386_b(&out,0x31);i386_b(&out,0xf6);i386_b(&out,0x85);i386_b(&out,0xc0);i386_b(&out,0x7d);i386_b(&out,7);
                i386_b(&out,0xf7);i386_b(&out,0xd8);i386_b(&out,0xbe);i386_i32(&out,1);
                i386_b(&out,0x31);i386_b(&out,0xd2);i386_b(&out,0xb9);i386_i32(&out,10);i386_b(&out,0xf7);i386_b(&out,0xf1);
                i386_b(&out,0x80);i386_b(&out,0xc2);i386_b(&out,48);i386_b(&out,0x88);i386_b(&out,0x17);i386_b(&out,0x4f);i386_b(&out,0x85);i386_b(&out,0xc0);i386_b(&out,0x75);i386_b(&out,0xed);
                i386_b(&out,0x85);i386_b(&out,0xf6);i386_b(&out,0x74);i386_b(&out,4);i386_b(&out,0xc6);i386_b(&out,0x07);i386_b(&out,45);i386_b(&out,0x4f);i386_b(&out,0x47);
                i386_b(&out,0x8d);i386_b(&out,0x54);i386_b(&out,0x24);i386_b(&out,16);i386_b(&out,0x29);i386_b(&out,0xfa);i386_b(&out,0x89);i386_b(&out,0xf9);
                i386_b(&out,0xbb);i386_i32(&out,1);i386_b(&out,0xb8);i386_i32(&out,4);i386_b(&out,0xcd);i386_b(&out,0x80);
                i386_b(&out,0x83);i386_b(&out,0xc4);i386_b(&out,16);i386_b(&out,0x5f);i386_b(&out,0x5e);i386_b(&out,0x5b);i386_b(&out,0x50);
            }
            .ret => { i386_b(&out,0x58);i386_b(&out,0xc9);i386_b(&out,0xc3); }
            .ret_pair => { i386_b(&out,0x58);i386_b(&out,0x5a);i386_b(&out,0xc9);i386_b(&out,0xc3); }
            .ret_sret => { i386_b(&out,0x8b);i386_b(&out,0x45);i386_b(&out,8);i386_b(&out,0xc9);i386_b(&out,0xc2);i386_b(&out,4);i386_b(&out,0); }
            .fret => { i386_b(&out,0xdd);i386_b(&out,0x04);i386_b(&out,0x24);i386_b(&out,0x83);i386_b(&out,0xc4);i386_b(&out,8);i386_b(&out,0xc9);i386_b(&out,0xc3); }
            .f32ret => { i386_b(&out,0xd9);i386_b(&out,0x04);i386_b(&out,0x24);i386_b(&out,0x83);i386_b(&out,0xc4);i386_b(&out,4);i386_b(&out,0xc9);i386_b(&out,0xc3); }
            .ret_ok => { i386_b(&out,0x58);i386_b(&out,0x31);i386_b(&out,0xd2);i386_b(&out,0xc9);i386_b(&out,0xc3); }
            .ret_err => { i386_b(&out,0xba);i386_i32(&out,x.value);i386_b(&out,0x31);i386_b(&out,0xc0);i386_b(&out,0xc9);i386_b(&out,0xc3); }
        }
        i=i+1;
    }
    let p:i32=0;while(p<patches.len){let q:I386Patch=patches.data[p];i386_patch32(&out,q.pos,(labels.data[q.label]-(q.pos+4)) as i64);p=p+1;}
    return out;
}
