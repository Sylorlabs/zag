// Validated 32-bit integer lowering shared by the isolated Linux/i386 target.
// This deliberately consumes the normal Zag AST. Unsupported types and nodes
// fail before an ELF is written; the source text is never pattern matched.
@import("../parse.zag")
@import("elf_i686.zag")
@import("ncodegen_types.zag") // canonical generic type/call names shared by native lowering

enum I32IROp { enter, const_, str_const, f32_const, f64_const, load, pair_load, wide_load, f32_load, f64_load, store, pair_store, wide_store, f32_store, f64_store, normalize, widen_signed, widen_unsigned, truncate_wide, wide_bool, addr, deref, store_ind, ptr_index, ptr_store_index, slice_index, malloc, free_, discard, add, sub, mul, and_, or_, xor_, div_, mod_, udiv_, umod_, wide_add, wide_sub, wide_mul, wide_div, wide_mod, wide_udiv, wide_umod, wide_and, wide_or, wide_xor, wide_shl, wide_shr, wide_sar, wide_neg, wide_eq, wide_ne, wide_lt, wide_le, wide_gt, wide_ge, wide_ult, wide_ule, wide_ugt, wide_uge, f32add, f32sub, f32mul, f32div, fadd, fsub, fmul, fdiv, eq, ne, lt, le, gt, ge, ult, ule, ugt, uge, f32eq, f32ne, f32lt, f32le, f32gt, f32ge, feq, fne, flt, fle, fgt, fge, label, jz, jmp, call, call_void, call_pair, call_sret, f32call, fcall, call_err, err_jnz, try_, write, write_slice, print_i32, ret, ret_void, ret_pair, ret_sret, f32ret, fret, ret_ok, ret_err }
struct I32IR { op: I32IROp, value: i64 }
struct I386Local { name: []u8, slot: i32, ty: []u8 }
struct I386Fn { name: []u8, label: i32, params: i32, param_words: i32, param_types: ArrayList[[]u8], ret_ty: []u8, returns_error: i32, defined:i32, exported:i32, offset:i32 }
struct I386Lower { ir: ArrayList[I32IR], locals: ArrayList[I386Local], funcs: ArrayList[I386Fn], structs: ArrayList[StructDecl], strings:ArrayList[[]u8], object_relocs:ArrayList[I686CodeReloc], failed: i32, next_label: i32, next_slot: i32, break_label: i32, continue_label: i32, current_error_fn: i32, expected_ty: []u8, current_ret_ty: []u8, current_fn_name: []u8, sret_target: i32, object_mode:i32 }
struct I386Patch { pos: i32, label: i32 }
struct I386ValueRef { local: i32, word_offset: i32, ty: []u8, valid: i32 }
struct I386WideLiteral { lo: i64, hi: i64, valid: i32 }
struct I386PointerField { struct_index: i32, field_index: i32, valid: i32 }

// i386 has only three caller-clobbered general registers available to this
// backend (EAX, ECX, EDX).  The lowering therefore deliberately uses a
// stack-spill discipline for every expression temporary and reserves EBP for
// the frame.  Keep the compiler-owned frame bounded before byte emission: a
// malformed/generated source file must not turn an i32 multiplication into an
// arbitrary frame-size wrap.  This is a backend resource limit, not a claim
// that all i386 programs have a general register allocator.
fn I386_MAX_FRAME_WORDS() i32 { return 262144; } // 1 MiB of local spill slots
fn I386_MAX_CALL_WORDS() i32 { return 16384; }  // 64 KiB of pushed arguments

fn i386_fail(c: *I386Lower, msg: []u8) void {
    if (c.*.failed == 0) { _zag_eprintln(_zag_str_concat("znc i686: unsupported construct in ",_zag_str_concat(c.*.current_fn_name,_zag_str_concat(": ",msg)))); }
    c.*.failed = 1;
}
fn i386_local(c: *I386Lower, name: []u8) i32 {
    let i:i32=0;
    while(i<c.*.locals.len) {
        if(@strEq(c.*.locals.data[i].name,name)) { return c.*.locals.data[i].slot; }
        i=i+1;
    }
    return -1000000;
}
fn i386_emit_ir(c: *I386Lower, op: I32IROp, value: i64) void {
    push[I32IR](&c.*.ir,I32IR{.op=op,.value=value});
}
fn i386_new_label(c: *I386Lower) i32 { let n:i32=c.*.next_label;c.*.next_label=n+1;return n; }
fn i386_fn(c:*I386Lower,name:[]u8) i32 { let i:i32=0;while(i<c.*.funcs.len){if(@strEq(c.*.funcs.data[i].name,name)){return i;}i=i+1;}return -1; }
// The i686 backend receives the same post-generic-expansion AST as the normal
// native backends.  Generic call sites retain their source targs, while the
// concrete declaration is mangled (for example foo[u16] -> foo_u16).  Keep
// that normalization at the target boundary instead of silently accepting an
// unknown call as i32.
fn i386_call_name(name:[]u8,targs:ArrayList[[]u8])[]u8{
    if(targs.len>0){return cg_mangle_generic_norm(name,targs);}
    return name;
}
fn i386_type_match(a:[]u8,b:[]u8)i32{
    if(a.len==0||b.len==0){return 0;}
    return @strEq(cg_norm_type(a),cg_norm_type(b)) as i32;
}
// Every source pointer is one 32-bit SysV i386 word.  The old milestone
// admitted only raw scalar-element spellings, which made an opaque driver
// handle pointer fail at the ABI boundary even though the pointer itself is
// target-independent.  Keep element/index operations separately checked by
// i386_elem_size; accepting the pointer here does not authorize dereferencing
// an unsupported pointee.
fn i386_pointer_ty(ty:[]u8)i32{return (ty.len>=2&&ty[0]=='*') as i32;}
fn i386_pointer_elem(ty:[]u8)[]u8{if(i386_pointer_ty(ty)==1){return ty[1..];}return "";}
fn i386_slice_ty(ty:[]u8)i32{if(@strEq(ty,"String")){return 1;}if(ty.len<3||ty[0]!='['||ty[1]!=']'){return 0;}let elem:[]u8=ty[2..];return (@strEq(elem,"u8")||@strEq(elem,"i32")||@strEq(elem,"usize")) as i32;}
fn i386_slice_elem(ty:[]u8)[]u8{if(@strEq(ty,"String")){return "u8";}if(i386_slice_ty(ty)==1){return ty[2..];}return "";}
fn i386_elem_size(ty:[]u8)i32{if(@strEq(ty,"u8")){return 1;}if(@strEq(ty,"i32")||@strEq(ty,"usize")){return 4;}return 0;}
fn i386_narrow_scalar_ty(ty:[]u8)i32{return (@strEq(ty,"i8")||@strEq(ty,"u8")||@strEq(ty,"i16")||@strEq(ty,"u16")||@strEq(ty,"bool")) as i32;}
fn i386_word_ty(ty:[]u8) i32 { if(@strEq(ty,"i32")||@strEq(ty,"u32")||@strEq(ty,"usize")||i386_narrow_scalar_ty(ty)==1||i386_pointer_ty(ty)==1){return 1;}return 0; }
fn i386_wide_integer_ty(ty:[]u8)i32{return (@strEq(ty,"i64")||@strEq(ty,"u64")) as i32;}
fn i386_integer_ty(ty:[]u8)i32{return (@strEq(ty,"i32")||@strEq(ty,"u32")||@strEq(ty,"usize")||@strEq(ty,"i8")||@strEq(ty,"u8")||@strEq(ty,"i16")||@strEq(ty,"u16")||i386_wide_integer_ty(ty)==1) as i32;}
fn i386_unsigned_ty(ty:[]u8)i32{return (@strEq(ty,"u32")||@strEq(ty,"usize")||@strEq(ty,"u8")||@strEq(ty,"u16")||@strEq(ty,"u64")) as i32;}
fn i386_signed_narrow_ty(ty:[]u8)i32{return (@strEq(ty,"i8")||@strEq(ty,"i16")) as i32;}
fn i386_signed_integer_ty(ty:[]u8)i32{return (@strEq(ty,"i8")||@strEq(ty,"i16")||@strEq(ty,"i32")||@strEq(ty,"i64")) as i32;}
// Narrow values occupy one four-byte cdecl argument/local word, but their
// observable value is normalized at every ABI and storage boundary.  The code
// is consumed by I32IROp.normalize:
//   1=i8 sign-extend, 2=u8 zero-extend, 3=i16 sign-extend,
//   4=u16 zero-extend, 5=bool canonicalize to zero or one.
fn i386_narrow_code(ty:[]u8)i32{if(@strEq(ty,"i8")){return 1;}if(@strEq(ty,"u8")){return 2;}if(@strEq(ty,"i16")){return 3;}if(@strEq(ty,"u16")){return 4;}if(@strEq(ty,"bool")){return 5;}return 0;}
fn i386_emit_normalize(c:*I386Lower,ty:[]u8)void{let code:i32=i386_narrow_code(ty);if(code!=0){i386_emit_ir(c,I32IROp.normalize,code);}}
fn i386_float_ty(ty:[]u8) i32 { if(@strEq(ty,"f64")){return 1;}if(@strEq(ty,"f32")){return 2;}return 0; }
fn i386_ty_words(ty:[]u8) i32 { if(@strEq(ty,"f64")||i386_slice_ty(ty)==1||i386_wide_integer_ty(ty)==1){return 2;}return 1; }
fn i386_error_payload_ty(ty:[]u8)[]u8{if(@strEq(ty,"!i32")){return "i32";}return "";}
fn i386_hex_literal_text(text:[]u8)i32{return (text.len>1&&text[0]=='0'&&(text[1]=='x'||text[1]=='X')) as i32;}
fn i386_int_literal(n:*Node)i32{switch(n.*){.ilit=>|x|{if(i386_hex_literal_text(x.text)==1){return 1;}let i:i32=0;while(i<x.text.len){if(x.text[i]=='.'||x.text[i]=='e'||x.text[i]=='E'){return 0;}i=i+1;}return 1;}else=>{}}return 0;}
fn i386_number_literal(n:*Node)i32{switch(n.*){.ilit=>|_x|{return 1;}else=>{}}return 0;}
fn i386_negative_int_literal(n:*Node)i32{switch(n.*){.un=>|x|{return (@strEq(x.op,"-")&&i386_int_literal(x.e)==1) as i32;}else=>{}}return 0;}
fn i386_null_literal(n:*Node)i32{switch(n.*){.id=>|x|{return @strEq(x.name,"null") as i32;}else=>{}}return 0;}
fn i386_expr_ty(c:*I386Lower,n:*Node) []u8 {
    switch(n.*) {
        .ilit=>|x|{let i:i32=0;if(i386_hex_literal_text(x.text)==0){while(i<x.text.len){if(x.text[i]=='.'||x.text[i]=='e'||x.text[i]=='E'){if(@strEq(c.*.expected_ty,"f32")){return "f32";}return "f64";}i=i+1;}}if(i386_integer_ty(c.*.expected_ty)==1){return c.*.expected_ty;}return "i32";}
        .slit=>|_x|{return "[]u8";}
        .id=>|x|{if(@strEq(x.name,"true")||@strEq(x.name,"false")){return "bool";}if(@strEq(x.name,"null")){if(i386_pointer_ty(c.*.expected_ty)==1){return c.*.expected_ty;}return "*i32";}let li:i32=i386_local_index(c,x.name);if(li>=0){return c.*.locals.data[li].ty;}return "";}
        .bin=>|x|{let lt:[]u8=i386_expr_ty(c,x.l);let rt:[]u8=i386_expr_ty(c,x.r);if(i386_int_literal(x.l)==1&&i386_integer_ty(rt)==1){lt=rt;}if(i386_int_literal(x.r)==1&&i386_integer_ty(lt)==1){rt=lt;}if(i386_negative_int_literal(x.l)==1&&i386_signed_integer_ty(rt)==1){lt=rt;}if(i386_negative_int_literal(x.r)==1&&i386_signed_integer_ty(lt)==1){rt=lt;}if(@strEq(x.op,"==")||@strEq(x.op,"!=")||@strEq(x.op,"<")||@strEq(x.op,"<=")||@strEq(x.op,">")||@strEq(x.op,">=")){return "bool";}if(@strEq(x.op,"<<")||@strEq(x.op,">>")){return lt;}if(i386_pointer_ty(lt)==1){return lt;}if(i386_float_ty(lt)>0){return lt;}if(i386_float_ty(rt)>0){return rt;}if(@strEq(lt,rt)&&(i386_narrow_scalar_ty(lt)==1||i386_wide_integer_ty(lt)==1)){return lt;}if(@strEq(lt,"usize")||@strEq(rt,"usize")){return "usize";}return "i32";}
        .un=>|x|{if(@strEq(x.op,"&")){let et:[]u8=i386_expr_ty(c,x.e);if(et.len>0){return _zag_str_concat("*",et);}}if(@strEq(x.op,"try")){return i386_error_payload_ty(i386_expr_ty(c,x.e));}return i386_expr_ty(c,x.e);}
        .fld=>|x|{if(@strEq(x.fname,"*")){return i386_pointer_elem(i386_expr_ty(c,x.base));}let pointer_field:I386PointerField=i386_pointer_field(c,n);if(pointer_field.valid==1){return c.*.structs.data[pointer_field.struct_index].fields.data[pointer_field.field_index].pty;}let bt:[]u8=i386_expr_ty(c,x.base);if(i386_slice_ty(bt)==1&&@strEq(x.fname,"len")){return "usize";}let ref:I386ValueRef=i386_value_ref(c,n);if(ref.valid==1){return ref.ty;}return "";}
        .idx=>|x|{let bt:[]u8=i386_expr_ty(c,x.base);if(i386_slice_ty(bt)==1){return i386_slice_elem(bt);}return i386_pointer_elem(bt);}
        .slice_=>|x|{let bt:[]u8=i386_expr_ty(c,x.base);if(i386_slice_ty(bt)==1){return bt;}let elem:[]u8=i386_pointer_elem(bt);if(elem.len>0){return _zag_str_concat("[]",elem);}return "";}
        .cast_=>|x|{return x.target;}
        .call=>|x|{let source_name:[]u8="";switch(x.callee.*){.id=>|id|{source_name=id.name;}else=>{}}if(@strEq(source_name,"@sizeOf")||@strEq(source_name,"@alignOf")||@strEq(source_name,"@offsetOf")){return "i64";}if(@strEq(source_name,"__catch")&&x.args.len>0){return i386_error_payload_ty(i386_expr_ty(c,x.args.data[0]));}if(@strEq(source_name,"_zag_malloc")){if(i386_pointer_ty(c.*.expected_ty)==1){return c.*.expected_ty;}return "*i32";}if(@strEq(source_name,"_zag_free")||@strEq(source_name,"_zag_write")||@strEq(source_name,"_zag_print")||@strEq(source_name,"_zag_println_i32")){return "i32";}let name:[]u8=i386_call_name(source_name,x.targs);let fi:i32=i386_fn(c,name);if(fi>=0){return c.*.funcs.data[fi].ret_ty;}return "i32";}
        else=>{return "i32";}
    }
}
// Generic driver handles are layout-erased at the i686 ABI boundary: the
// element type is checked by the typed front end and does not change the
// token/metadata prefix used by the common accessors.  Resolve
// `MmioRegister[u32]` back to the compiler-owned declaration while preserving
// the original type string for source-level generic checks.
fn i386_type_base(name:[]u8)[]u8{
    let i:i32=0;
    while(i<name.len){if(name[i]=='['){return name[0..i];}i=i+1;}
    return name;
}
fn i386_struct(c:*I386Lower,name:[]u8) i32 { let base:[]u8=i386_type_base(name);let i:i32=0;while(i<c.*.structs.len){if(@strEq(c.*.structs.data[i].name,name)||@strEq(c.*.structs.data[i].name,base)){return i;}i=i+1;}return -1; }
fn i386_local_index(c:*I386Lower,name:[]u8) i32 { let i:i32=0;while(i<c.*.locals.len){if(@strEq(c.*.locals.data[i].name,name)){return i;}i=i+1;}return -1; }
fn i386_field(c:*I386Lower,ty:[]u8,name:[]u8) i32 { let si:i32=i386_struct(c,ty);if(si<0){return -1;}let i:i32=0;while(i<c.*.structs.data[si].fields.len){if(@strEq(c.*.structs.data[si].fields.data[i].name,name)){return i;}i=i+1;}return -1; }
fn i386_struct_field_supported(c:*I386Lower,ty:[]u8)i32{return (i386_word_ty(ty)==1||i386_wide_integer_ty(ty)==1||i386_float_ty(ty)>0||i386_struct(c,ty)>=0) as i32;}
fn i386_struct_field_words_depth(c:*I386Lower,si:i32,field:i32,depth:i32)i32{
    let ty:[]u8=c.*.structs.data[si].fields.data[field].pty;
    if(i386_word_ty(ty)==1||i386_wide_integer_ty(ty)==1||i386_float_ty(ty)>0){return i386_ty_words(ty);}
    let child:i32=i386_struct(c,ty);if(child>=0){return i386_struct_words_depth(c,child,depth+1);}
    return -1;
}
fn i386_struct_words_depth(c:*I386Lower,si:i32,depth:i32)i32{
    // Any acyclic path contains at most one instance of every declaration.
    // Exceeding that bound proves a direct or mutual by-value cycle.
    if(si<0||depth>c.*.structs.len||c.*.structs.data[si].fields.len==0){return -1;}
    let words:i32=0;let i:i32=0;
    while(i<c.*.structs.data[si].fields.len){let n:i32=i386_struct_field_words_depth(c,si,i,depth);if(n<0||words>I386_MAX_FRAME_WORDS()-n){return -1;}words=words+n;i=i+1;}
    return words;
}
fn i386_struct_field_words(c:*I386Lower,si:i32,field:i32)i32{
    if(si<0){return -1;}
    let ty:[]u8=c.*.structs.data[si].fields.data[field].pty;
    if(i386_struct_field_supported(c,ty)==0){return -1;}
    let child:i32=i386_struct(c,ty);if(child>=0){return i386_struct_words_depth(c,child,1);}
    return i386_ty_words(ty);
}
fn i386_struct_field_word_offset(c:*I386Lower,si:i32,field:i32)i32{
    let words:i32=0;let i:i32=0;
    while(i<field){let n:i32=i386_struct_field_words(c,si,i);if(n<0||words>I386_MAX_FRAME_WORDS()-n){return -1;}words=words+n;i=i+1;}
    return words;
}
fn i386_struct_words(c:*I386Lower,si:i32)i32{
    return i386_struct_words_depth(c,si,0);
}
fn i386_param_words(c:*I386Lower,ty:[]u8) i32 { let si:i32=i386_struct(c,ty);if(si>=0){return i386_struct_words(c,si);}return i386_ty_words(ty); }

// Target layout authority for the i686 backend.  i386 SysV gives pointers and
// 32-bit leaves four-byte alignment; 64-bit integers/f64 occupy eight bytes
// but retain four-byte alignment.  This is intentionally independent of the
// host compiler's 64-bit ABI and matches the sequential aggregate lowering
// above for the fields admitted by the typed front end.
fn i386_align_up(n:i32,a:i32)i32{if(a<=1){return n;}let r:i32=n%a;if(r==0){return n;}return n+(a-r);}
fn i386_c_leaf_size(ty:[]u8)i32{
    if(i386_pointer_ty(ty)==1||@strEq(ty,"isize")||@strEq(ty,"usize")){return 4;}
    if(@strEq(ty,"bool")||@strEq(ty,"i8")||@strEq(ty,"u8")){return 1;}
    if(@strEq(ty,"i16")||@strEq(ty,"u16")){return 2;}
    if(@strEq(ty,"i32")||@strEq(ty,"u32")||@strEq(ty,"f32")){return 4;}
    if(@strEq(ty,"i64")||@strEq(ty,"u64")||@strEq(ty,"f64")){return 8;}
    return 0;
}
fn i386_c_leaf_alignment(ty:[]u8)i32{
    if(i386_pointer_ty(ty)==1||@strEq(ty,"isize")||@strEq(ty,"usize")||
       @strEq(ty,"i64")||@strEq(ty,"u64")||@strEq(ty,"f64")){return 4;}
    return i386_c_leaf_size(ty);
}
fn i386_struct_annot(sd:StructDecl,wanted:[]u8)i32{let i:i32=0;while(i<sd.annots.len){if(@strEq(sd.annots.data[i],wanted)){return 1;}i=i+1;}return 0;}
fn i386_struct_explicit_align(sd:StructDecl)i32{let a:i32=0;let i:i32=0;while(i<sd.annots.len){let x:[]u8=sd.annots.data[i];if(x.len>=9&&@strEq(x[0..7],"@align(")&&x[x.len-1]==')'){a=_zag_str_to_i64(x[7..x.len-1]) as i32;}i=i+1;}return a;}
fn i386_layout_struct_size(c:*I386Lower,si:i32)i32{
    if(si<0){return 0;}
    let sd:StructDecl=c.*.structs.data[si];
    let packed:i32=i386_struct_annot(sd,"@repr(packed)");let repr_c:i32=sd.repr_c;
    let off:i32=0;let max_align:i32=1;let i:i32=0;
    while(i<sd.fields.len){
        let p:Param=sd.fields.data[i];let fs:i32=i386_c_leaf_size(p.pty);
        let fa:i32=i386_c_leaf_alignment(p.pty);
        if(fs==0){let child:i32=i386_struct(c,p.pty);if(child>=0){fs=i386_layout_struct_size(c,child);}else{fs=i386_struct_field_words(c,si,i)*4;}}
        if(fa>max_align){max_align=fa;}
        if(repr_c==1){off=i386_align_up(off,fa);}
        off=off+fs;i=i+1;
    }
    let explicit:i32=i386_struct_explicit_align(sd);if(explicit>max_align){max_align=explicit;}
    if(repr_c==1){return i386_align_up(off,max_align);}
    // Ordinary i686 frame aggregates use four-byte word slots. Packed
    // declarations admitted by typed.zag contain only 32-bit-or-wider leaves,
    // so their sequential size is identical to this word count.
    if(explicit>1){return i386_align_up(i386_struct_words(c,si)*4,explicit);}
    return i386_struct_words(c,si)*4;
}
fn i386_layout_struct_align(c:*I386Lower,si:i32)i32{
    if(si<0){return 0;}
    let sd:StructDecl=c.*.structs.data[si];let a:i32=1;let i:i32=0;
    let packed:i32=i386_struct_annot(sd,"@repr(packed)");
    if(packed==1){let explicit_p:i32=i386_struct_explicit_align(sd);if(explicit_p>0){return explicit_p;}return 1;}
    if(sd.repr_c==0){return 4;}
    while(i<sd.fields.len){let fa:i32=i386_c_leaf_alignment(sd.fields.data[i].pty);if(fa>a){a=fa;}i=i+1;}
    return a;
}
fn i386_layout_size(c:*I386Lower,ty:[]u8)i32{
    let scalar:i32=i386_c_leaf_size(ty);if(scalar>0){return scalar;}
    let si:i32=i386_struct(c,ty);if(si>=0){return i386_layout_struct_size(c,si);}
    if(i386_slice_ty(ty)==1){return 8;}
    return 0;
}
fn i386_layout_align(c:*I386Lower,ty:[]u8)i32{
    let scalar:i32=i386_c_leaf_alignment(ty);if(scalar>0){return scalar;}
    let si:i32=i386_struct(c,ty);if(si>=0){return i386_layout_struct_align(c,si);}
    if(i386_slice_ty(ty)==1){return 4;}
    return 0;
}
fn i386_layout_offset(c:*I386Lower,ty:[]u8,field:[]u8)i32{
    let si:i32=i386_struct(c,ty);if(si<0){return -1;}
    let sd:StructDecl=c.*.structs.data[si];let off:i32=0;let i:i32=0;let packed:i32=i386_struct_annot(sd,"@repr(packed)");
    while(i<sd.fields.len){let p:Param=sd.fields.data[i];let fa:i32=i386_c_leaf_alignment(p.pty);let fs:i32=i386_c_leaf_size(p.pty);
        if(@strEq(p.name,field)){return off;}
        if(sd.repr_c==1){off=i386_align_up(off,fa);off=off+fs;}
        else if(packed==1){off=off+fs;}
        else{off=off+i386_struct_field_words(c,si,i)*4;}
        i=i+1;
    }
    return -1;
}
fn i386_emit_layout_i64(c:*I386Lower,value:i32)void{i386_emit_wide_words(c,0,value as i64);}
fn i386_value_ref(c:*I386Lower,n:*Node)I386ValueRef{
    switch(n.*){
        .id=>|id|{let li:i32=i386_local_index(c,id.name);if(li>=0){return I386ValueRef{.local=li,.word_offset=0,.ty=c.*.locals.data[li].ty,.valid=1};}}
        .fld=>|f|{
            if(@strEq(f.fname,"*")){return I386ValueRef{.local=-1,.word_offset=0,.ty="",.valid=0};}
            let base:I386ValueRef=i386_value_ref(c,f.base);if(base.valid==1){let si:i32=i386_struct(c,base.ty);let fi:i32=i386_field(c,base.ty,f.fname);if(si>=0&&fi>=0){let off:i32=i386_struct_field_word_offset(c,si,fi);if(off>=0){return I386ValueRef{.local=base.local,.word_offset=base.word_offset+off,.ty=c.*.structs.data[si].fields.data[fi].pty,.valid=1};}}}
        }
        else=>{}
    }
    return I386ValueRef{.local=-1,.word_offset=0,.ty="",.valid=0};
}

// Resolve the common `ptr.*.field` form without pretending the pointee is a
// by-value local.  Driver accessors use exactly this shape for opaque handle
// metadata (identity, adapter, and lifecycle tokens).  The address itself is
// still lowered as an ordinary checked i386 pointer; only the field offset is
// interpreted from the compiler-owned sequential struct layout.
fn i386_pointer_field(c:*I386Lower,n:*Node)I386PointerField{
    switch(n.*){
        .fld=>|f|{
            switch(f.base.*){
                .fld=>|d|{
                    if(@strEq(d.fname,"*")==1){
                        let pointer_ty:[]u8=i386_expr_ty(c,d.base);
                        if(i386_pointer_ty(pointer_ty)==1){
                            let si:i32=i386_struct(c,i386_pointer_elem(pointer_ty));
                            if(si>=0){
                                let fi:i32=i386_field(c,i386_pointer_elem(pointer_ty),f.fname);
                                if(fi>=0){return I386PointerField{.struct_index=si,.field_index=fi,.valid=1};}
                            }
                        }
                    }
                }
                else=>{}
            }
        }
        else=>{}
    }
    return I386PointerField{.struct_index=-1,.field_index=-1,.valid=0};
}
fn i386_pointer_field_base(n:*Node)*Node{
    switch(n.*){
        .fld=>|f|{
            switch(f.base.*){
                .fld=>|d=>{if(@strEq(d.fname,"*")==1){return d.base;}}
                else=>{}
            }
        }
        else=>{}
    }
    return n;
}
fn i386_emit_pointer_field_load(c:*I386Lower,base:*Node,pointer_ty:[]u8,field_ty:[]u8,byte_offset:i32)void{
    // Wide values use the same high-word/low-word stack order as
    // I32IROp.wide_load.  Read the high address first, then the low address,
    // so the final stack value is [high, low].
    let word:i32=i386_ty_words(field_ty)-1;
    while(word>=0){
        i386_expr_expected(c,base,pointer_ty);
        let offset:i32=byte_offset+word*4;
        if(offset>0){i386_emit_ir(c,I32IROp.const_,offset);i386_emit_ir(c,I32IROp.add,0);}
        i386_emit_ir(c,I32IROp.deref,0);
        word=word-1;
    }
    i386_emit_normalize(c,field_ty);
}
fn i386_emit_pointer_field_store(c:*I386Lower,base:*Node,pointer_ty:[]u8,field_ty:[]u8,byte_offset:i32,value:*Node)void{
    let words:i32=i386_ty_words(field_ty);
    if(words<1||i386_struct(c,field_ty)>=0){i386_fail(c,"pointer field store requires a supported scalar field");return;}
    if(c.*.next_slot>I386_MAX_FRAME_WORDS()-words){i386_fail(c,"pointer field store temporary exceeds the bounded i386 frame");return;}
    let temp:i32=c.*.next_slot;c.*.next_slot=c.*.next_slot+words;
    i386_expr_expected(c,value,field_ty);
    if(i386_wide_integer_ty(field_ty)==1){i386_emit_ir(c,I32IROp.wide_store,temp);}
    else if(i386_float_ty(field_ty)==1){i386_emit_ir(c,I32IROp.f64_store,temp);}
    else if(i386_float_ty(field_ty)==2){i386_emit_ir(c,I32IROp.f32_store,temp);}
    else{i386_emit_normalize(c,field_ty);i386_emit_ir(c,I32IROp.store,temp);}
    // Store each word from the temporary independently. This keeps the
    // address/value stack order explicit and supports i64/u64/f64 without
    // introducing an untyped pointer swap primitive.
    let word:i32=words-1;
    while(word>=0){
        i386_expr_expected(c,base,pointer_ty);
        let offset:i32=byte_offset+word*4;
        if(offset>0){i386_emit_ir(c,I32IROp.const_,offset);i386_emit_ir(c,I32IROp.add,0);}
        i386_emit_ir(c,I32IROp.load,temp+word);
        i386_emit_ir(c,I32IROp.store_ind,0);
        word=word-1;
    }
}
// SysV i386 aligns every supported sequential aggregate field to four bytes.
// Scalar/f32 leaves occupy one word; i64/u64/f64 occupy two adjacent
// little-endian words; acyclic nested structs recursively inline that layout.
// Narrow leaves retain their declared value semantics at every boundary.
fn i386_emit_value_load(c:*I386Lower,ty:[]u8,slot:i32)void{
    let ft:i32=i386_float_ty(ty);
    if(ft==1||i386_wide_integer_ty(ty)==1){i386_emit_ir(c,I32IROp.load,slot-1);i386_emit_ir(c,I32IROp.load,slot);}
    else if(ft==2){i386_emit_ir(c,I32IROp.f32_load,slot);}
    else{i386_emit_ir(c,I32IROp.load,slot);i386_emit_normalize(c,ty);}
}
fn i386_emit_value_store(c:*I386Lower,ty:[]u8,slot:i32)void{
    let ft:i32=i386_float_ty(ty);
    if(ft==1||i386_wide_integer_ty(ty)==1){i386_emit_ir(c,I32IROp.store,slot);i386_emit_ir(c,I32IROp.store,slot-1);}
    else if(ft==2){i386_emit_ir(c,I32IROp.f32_store,slot);}
    else{i386_emit_normalize(c,ty);i386_emit_ir(c,I32IROp.store,slot);}
}
fn i386_emit_struct_copy(c:*I386Lower,dest_base:i32,source_base:i32,si:i32,depth:i32)void{
    if(depth>c.*.structs.len){i386_fail(c,"recursive by-value struct layout is unsupported");return;}
    let field:i32=0;while(field<c.*.structs.data[si].fields.len){
        let off:i32=i386_struct_field_word_offset(c,si,field);let ty:[]u8=c.*.structs.data[si].fields.data[field].pty;let child:i32=i386_struct(c,ty);
        if(off<0){i386_fail(c,"struct layout overflow or recursive by-value field");return;}
        if(child>=0){i386_emit_struct_copy(c,dest_base-off,source_base-off,child,depth+1);}
        else{i386_emit_value_load(c,ty,source_base-off);i386_emit_value_store(c,ty,dest_base-off);}
        field=field+1;
    }
}
fn i386_emit_struct_argument(c:*I386Lower,source_base:i32,si:i32,depth:i32)void{
    if(depth>c.*.structs.len){i386_fail(c,"recursive by-value struct layout is unsupported");return;}
    let field:i32=c.*.structs.data[si].fields.len-1;while(field>=0){
        let off:i32=i386_struct_field_word_offset(c,si,field);let ty:[]u8=c.*.structs.data[si].fields.data[field].pty;let child:i32=i386_struct(c,ty);
        if(off<0){i386_fail(c,"struct layout overflow or recursive by-value field");return;}
        if(child>=0){i386_emit_struct_argument(c,source_base-off,child,depth+1);}
        else{i386_emit_value_load(c,ty,source_base-off);}
        field=field-1;
    }
}
fn i386_emit_sret_address(c:*I386Lower,word_off:i32)void{
    i386_emit_ir(c,I32IROp.load,-1);
    if(word_off>0){i386_emit_ir(c,I32IROp.const_,word_off*4);i386_emit_ir(c,I32IROp.add,0);}
}
fn i386_emit_struct_sret(c:*I386Lower,source_base:i32,si:i32,dest_word_off:i32,depth:i32)void{
    if(depth>c.*.structs.len){i386_fail(c,"recursive by-value struct layout is unsupported");return;}
    let field:i32=0;while(field<c.*.structs.data[si].fields.len){
        let off:i32=i386_struct_field_word_offset(c,si,field);let ty:[]u8=c.*.structs.data[si].fields.data[field].pty;let child:i32=i386_struct(c,ty);
        if(off<0){i386_fail(c,"aggregate returns require checked non-recursive sequential fields");return;}
        if(child>=0){i386_emit_struct_sret(c,source_base-off,child,dest_word_off+off,depth+1);}
        else if(i386_float_ty(ty)==1||i386_wide_integer_ty(ty)==1){let rw:i32=0;while(rw<2){i386_emit_sret_address(c,dest_word_off+off+rw);i386_emit_ir(c,I32IROp.load,source_base-off-rw);i386_emit_ir(c,I32IROp.store_ind,0);rw=rw+1;}}
        else{i386_emit_sret_address(c,dest_word_off+off);i386_emit_value_load(c,ty,source_base-off);i386_emit_ir(c,I32IROp.store_ind,0);}
        field=field+1;
    }
}
fn i386_error_code(name:[]u8) i64 { let h:i64=1;let i:i32=0;while(i<name.len){h=((h*33)+(name[i] as i64))&2147483647;i=i+1;}if(h==0){return 1;}return h; }
fn i386_add_string(c:*I386Lower,s:[]u8)i32{if(c.*.strings.len>=c.*.strings.cap){let grown:ArrayList[[]u8]=make[[]u8](c.*.strings.cap*2);let i:i32=0;while(i<c.*.strings.len){grown.data[i]=c.*.strings.data[i];i=i+1;}grown.len=c.*.strings.len;c.*.strings=grown;}let at:i32=c.*.strings.len;c.*.strings.data[at]=s;c.*.strings.len=at+1;return at;}
// Prove that every path through the currently supported structured control-flow
// subset reaches a return.  A loop is deliberately not treated as terminal:
// proving that it cannot exit requires a stronger termination/constant analysis.
// Sequential statements after a terminal statement are unreachable, so the
// first statement that is terminal proves the complete body terminal.
fn i386_body_always_returns(body:ArrayList[*Node]) i32 {
    let i:i32=0;
    while(i<body.len) {
        switch(body.data[i].*) {
            .ret => |_r| { return 1; }
            .if_ => |x| {
                if(x.has_els==1 && i386_body_always_returns(x.then_body)==1 &&
                   i386_body_always_returns(x.els_body)==1) { return 1; }
            }
            .unsafe_ => |x| {
                if(i386_body_always_returns(x.body)==1) { return 1; }
            }
            .defer_ => |d| { }
            .switch_ => |x| {
                if(x.has_els==1) {
                    let all:i32=i386_body_always_returns(x.els_body);
                    let ai:i32=0;
                    while(ai<x.arms.len) {
                        if(i386_body_always_returns(x.arms.data[ai].body)==0){all=0;}
                        ai=ai+1;
                    }
                    if(all==1){return 1;}
                }
            }
            else => { }
        }
        i=i+1;
    }
    return 0;
}
fn i386_value_types_match(expected:[]u8,actual:[]u8)i32{
    if(expected.len==0||actual.len==0){return 0;}
    // Generic handles may still carry their source spelling at an expression
    // boundary (`*DmaBuffer[u8]`) while the expanded callee signature uses the
    // target ABI spelling (`*DmaBuffer_u8`).  Compare through the same canonical
    // type normalizer used for struct lookup; never accept an unrelated type.
    return i386_type_match(expected,actual);
}
fn i386_uncontextual_ty(c:*I386Lower,n:*Node)[]u8{let old:[]u8=c.*.expected_ty;c.*.expected_ty="";let ty:[]u8=i386_expr_ty(c,n);c.*.expected_ty=old;return ty;}
fn i386_effective_ty(c:*I386Lower,n:*Node,expected:[]u8)[]u8{
    let actual:[]u8=i386_uncontextual_ty(c,n);
    if(i386_int_literal(n)==1&&i386_integer_ty(expected)==1){return expected;}
    if(i386_negative_int_literal(n)==1&&i386_signed_integer_ty(expected)==1){return expected;}
    if(i386_negative_int_literal(n)==1&&i386_unsigned_ty(expected)==1){return expected;}
    if(i386_integer_ty(expected)==1){
        switch(n.*){
            .bin=>|x|{
                let comparison:i32=(@strEq(x.op,"==")||@strEq(x.op,"!=")||@strEq(x.op,"<")||@strEq(x.op,"<=")||@strEq(x.op,">")||@strEq(x.op,">=")) as i32;
                if(comparison==0){
                    let left:[]u8=i386_effective_ty(c,x.l,expected);
                    if(@strEq(x.op,"<<")||@strEq(x.op,">>")){
                        let right:[]u8=i386_uncontextual_ty(c,x.r);
                        if(i386_int_literal(x.r)==1){right="i32";}
                        if(@strEq(left,expected)&&i386_integer_ty(right)==1&&i386_wide_integer_ty(right)==0){return expected;}
                    }else{
                        let right:[]u8=i386_effective_ty(c,x.r,expected);
                        if(@strEq(left,expected)&&@strEq(right,expected)){return expected;}
                    }
                }
            }
            else=>{}
        }
    }
    if(i386_number_literal(n)==1&&i386_float_ty(expected)>0){return expected;}
    if(i386_null_literal(n)==1&&i386_pointer_ty(expected)==1){return expected;}
    if(i386_pointer_ty(expected)==1){switch(n.*){.call=>|call|{let name:[]u8="";switch(call.callee.*){.id=>|id|{name=id.name;}else=>{}}if(@strEq(name,"_zag_malloc")){return expected;}}else=>{}}}
    return actual;
}
fn i386_cast_allowed(source:[]u8,target:[]u8)i32{
    if(@strEq(source,target)){return 1;}
    if(i386_integer_ty(source)==1&&i386_integer_ty(target)==1){return 1;}
    if((@strEq(source,"bool")&&i386_integer_ty(target)==1)||(i386_integer_ty(source)==1&&@strEq(target,"bool"))){return 1;}
    if(i386_pointer_ty(source)==1&&i386_pointer_ty(target)==1){return 1;}
    return 0;
}
fn i386_expr_expected(c:*I386Lower,n:*Node,expected:[]u8)void{
    let old:[]u8=c.*.expected_ty;c.*.expected_ty=expected;i386_expr(c,n);c.*.expected_ty=old;
}
// Parse an unsigned decimal or hexadecimal literal as two base-2^32 limbs.
// Each intermediate is bounded below 2^36, so the self-host compiler's signed
// i64 arithmetic cannot overflow while accepting the complete u64 range.
fn i386_parse_wide_literal(text:[]u8)I386WideLiteral{
    let out:I386WideLiteral=I386WideLiteral{.lo=0,.hi=0,.valid=0};
    let i:i32=0;let base:i64=10;
    if(text.len>1&&text[0]=='0'&&(text[1]=='x'||text[1]=='X')){base=16;i=2;}
    let digits:i32=0;
    while(i<text.len){
        let ch:u8=text[i];
        if(ch=='_'){i=i+1;}
        else{
            let digit:i64=-1;
            if(ch>='0'&&ch<='9'){digit=(ch as i64)-48;}
            else if(base==16&&ch>='a'&&ch<='f'){digit=(ch as i64)-87;}
            else if(base==16&&ch>='A'&&ch<='F'){digit=(ch as i64)-55;}
            if(digit<0||digit>=base){return out;}
            let scaled_lo:i64=out.lo*base+digit;
            let carry:i64=scaled_lo/4294967296;
            out.lo=scaled_lo-(carry*4294967296);
            let scaled_hi:i64=out.hi*base+carry;
            if(scaled_hi>4294967295){return out;}
            out.hi=scaled_hi;digits=digits+1;i=i+1;
        }
    }
    if(digits>0){out.valid=1;}
    return out;
}
fn i386_emit_wide_words(c:*I386Lower,hi:i64,lo:i64)void{
    i386_emit_ir(c,I32IROp.const_,hi);i386_emit_ir(c,I32IROp.const_,lo);
}
fn i386_emit_int_literal(c:*I386Lower,text:[]u8)void{
    if(i386_wide_integer_ty(c.*.expected_ty)==1){
        let wide:I386WideLiteral=i386_parse_wide_literal(text);
        if(wide.valid==0){i386_fail(c,"64-bit integer literal exceeds the unsigned i686 target range");return;}
        if(@strEq(c.*.expected_ty,"i64")&&wide.hi>2147483647){i386_fail(c,"i64 literal exceeds the signed 64-bit target range");return;}
        i386_emit_wide_words(c,wide.hi,wide.lo);
        return;
    }
    let value:i64=_zag_str_to_i64(text);
    if(value<0){i386_fail(c,"invalid integer literal for the i686 target");return;}
    if(@strEq(c.*.expected_ty,"usize")){
        if(value>4294967295){i386_fail(c,"usize literal exceeds the 32-bit target range");return;}
    }else if(@strEq(c.*.expected_ty,"i8")){
        if(value>127){i386_fail(c,"i8 literal exceeds the signed 8-bit target range; use an explicit cast for wrapping conversion");return;}
    }else if(@strEq(c.*.expected_ty,"u8")){
        if(value>255){i386_fail(c,"u8 literal exceeds the unsigned 8-bit target range; use an explicit cast for wrapping conversion");return;}
    }else if(@strEq(c.*.expected_ty,"i16")){
        if(value>32767){i386_fail(c,"i16 literal exceeds the signed 16-bit target range; use an explicit cast for wrapping conversion");return;}
    }else if(@strEq(c.*.expected_ty,"u16")){
        if(value>65535){i386_fail(c,"u16 literal exceeds the unsigned 16-bit target range; use an explicit cast for wrapping conversion");return;}
    }else if(value>2147483647){
        i386_fail(c,"i32 literal exceeds the signed 32-bit target range; use an explicit `as usize` conversion for an unsigned value");
        return;
    }
    i386_emit_ir(c,I32IROp.const_,value);
}
fn i386_expr(c: *I386Lower, n: *Node) void {
    switch(n.*) {
        .ilit => |x| { let ft:i32=i386_float_ty(i386_expr_ty(c,n));if(ft>0){let ef:i32=0;let bits:i64=zf64_bits_core(x.text,&ef);if(ef!=0){i386_fail(c,"invalid float literal");}else if(ft==2){i386_emit_ir(c,I32IROp.f32_const,w_f64_to_f32_bits(bits));}else{i386_emit_ir(c,I32IROp.f64_const,bits);}}else{i386_emit_int_literal(c,x.text);} }
        .slit => |x| { if(x.text.len<2){i386_fail(c,"invalid byte-string literal");return;}let decoded:ArrayList[u8]=make[u8](x.text.len);let qi:i32=1;while(qi<x.text.len-1){let ch:u8=x.text[qi];if(ch=='\\'){qi=qi+1;if(qi>=x.text.len-1){i386_fail(c,"unterminated byte-string escape");return;}let esc:u8=x.text[qi];if(esc=='n'){ch='\n';}else if(esc=='r'){ch='\r';}else if(esc=='t'){ch='\t';}else if(esc=='0'){ch=0;}else if(esc=='\\'){ch='\\';}else if(esc=='"'){ch='"';}else{i386_fail(c,"unsupported byte-string escape");return;}}decoded.data[decoded.len]=ch;decoded.len=decoded.len+1;qi=qi+1;}let si:i32=i386_add_string(c,decoded.data[0..decoded.len]);i386_emit_ir(c,I32IROp.str_const,si); }
        .id => |x| {
            if(@strEq(x.name,"true")){i386_emit_ir(c,I32IROp.const_,1);return;}
            if(@strEq(x.name,"false")){i386_emit_ir(c,I32IROp.const_,0);return;}
            if(@strEq(x.name,"null")){i386_emit_ir(c,I32IROp.const_,0);return;}
            let slot:i32=i386_local(c,x.name);
            if(slot==-1000000) { i386_fail(c,_zag_str_concat("unknown or uninitialized i32 local `",_zag_str_concat(x.name,"`"))); }
            else { let li:i32=i386_local_index(c,x.name);let ft:i32=0;let lty:[]u8="";if(li>=0){lty=c.*.locals.data[li].ty;if(i386_struct(c,lty)>=0){i386_fail(c,"aggregate value requires a matching struct destination, field access, argument, or return");return;}ft=i386_float_ty(lty);if(i386_slice_ty(lty)==1){i386_emit_ir(c,I32IROp.pair_load,slot);return;}}if(i386_wide_integer_ty(lty)==1){i386_emit_ir(c,I32IROp.wide_load,slot);}else if(ft==1){i386_emit_ir(c,I32IROp.f64_load,slot as i64);}else if(ft==2){i386_emit_ir(c,I32IROp.f32_load,slot);}else{i386_emit_ir(c,I32IROp.load,slot as i64);i386_emit_normalize(c,lty);} }
        }
        .bin => |x| {
            // Lower short-circuit boolean operators with labels instead of
            // treating them as bitwise arithmetic.  Driver validation code
            // relies on the RHS not running after a failed/invalid LHS.
            if(@strEq(x.op,"&&")||@strEq(x.op,"||")){
                let rhs:i32=i386_new_label(c);let done:i32=i386_new_label(c);
                i386_expr_expected(c,x.l,"bool");
                if(@strEq(x.op,"&&")){i386_emit_ir(c,I32IROp.jz,rhs);i386_expr_expected(c,x.r,"bool");i386_emit_ir(c,I32IROp.jmp,done);i386_emit_ir(c,I32IROp.label,rhs);i386_emit_ir(c,I32IROp.const_,0);}
                else{i386_emit_ir(c,I32IROp.jz,rhs);i386_emit_ir(c,I32IROp.const_,1);i386_emit_ir(c,I32IROp.jmp,done);i386_emit_ir(c,I32IROp.label,rhs);i386_expr_expected(c,x.r,"bool");}
                i386_emit_ir(c,I32IROp.label,done);return;
            }
            if(!@strEq(x.op,"+") && !@strEq(x.op,"-") && !@strEq(x.op,"*") && !@strEq(x.op,"/") && !@strEq(x.op,"%") && !@strEq(x.op,"&") && !@strEq(x.op,"|") &&
               !@strEq(x.op,"^") && !@strEq(x.op,"<<") && !@strEq(x.op,">>") && !@strEq(x.op,"==") && !@strEq(x.op,"!=") && !@strEq(x.op,"<") &&
               !@strEq(x.op,"<=") && !@strEq(x.op,">") && !@strEq(x.op,">=")) { i386_fail(c,"integer expression requires arithmetic, bitwise, shift, or comparison"); }
            else {
                let lt:[]u8=i386_expr_ty(c,x.l);let rt:[]u8=i386_expr_ty(c,x.r);
                let shift:i32=(@strEq(x.op,"<<")||@strEq(x.op,">>")) as i32;
                if(shift==1){
                    rt=i386_uncontextual_ty(c,x.r);if(i386_int_literal(x.r)==1){rt="i32";}
