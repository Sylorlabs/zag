    i386_b(out,0x0f);i386_b(out,0xaf);i386_b(out,0x4c);i386_b(out,0x24);i386_b(out,4);
    i386_b(out,0x01);i386_b(out,0xca);
    i386_b(out,0x8b);i386_b(out,0x4c);i386_b(out,0x24);i386_b(out,12);
    i386_b(out,0x0f);i386_b(out,0xaf);i386_b(out,0x0c);i386_b(out,0x24);
    i386_b(out,0x01);i386_b(out,0xca);
    i386_b(out,0x89);i386_b(out,0x44);i386_b(out,0x24);i386_b(out,8);
    i386_b(out,0x89);i386_b(out,0x54);i386_b(out,0x24);i386_b(out,12);
    i386_b(out,0x83);i386_b(out,0xc4);i386_b(out,8);
