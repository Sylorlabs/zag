    i386_b(out,0xbb);i386_i32(out,2);         // ebx = stderr
    i386_b(out,0xb8);i386_i32(out,4);         // eax = SYS_write
    i386_b(out,0xcd);i386_b(out,0x80);
    i386_b(out,0xbb);i386_i32(out,134);       // ebx = failure status
    i386_b(out,0xb8);i386_i32(out,1);         // eax = SYS_exit
