    i386_b(out,0x29);i386_b(out,0x4c);i386_b(out,0x24);i386_b(out,8);
    i386_b(out,0x8b);i386_b(out,0x4c);i386_b(out,0x24);i386_b(out,32);
    i386_b(out,0x19);i386_b(out,0x4c);i386_b(out,0x24);i386_b(out,12);
    i386_b(out,0x83);i386_b(out,0x0c);i386_b(out,0x24);i386_b(out,1);
    let no_subtract:i32=out.*.len;
    i386_patch32(out,high_no_subtract,no_subtract-(high_no_subtract+4));
    i386_patch32(out,low_no_subtract,no_subtract-(low_no_subtract+4));
