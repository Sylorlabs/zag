            }
            // label in high bits, argument count in low 16 bits.
            let cop:I32IROp=I32IROp.call;if(@strEq(c.*.funcs.data[fi].ret_ty,"void")){cop=I32IROp.call_void;}else if(c.*.funcs.data[fi].returns_error==1){cop=I32IROp.call_err;}else if(i386_slice_ty(c.*.funcs.data[fi].ret_ty)==1||i386_wide_integer_ty(c.*.funcs.data[fi].ret_ty)==1){cop=I32IROp.call_pair;}else if(i386_float_ty(c.*.funcs.data[fi].ret_ty)==1){cop=I32IROp.fcall;}else if(i386_float_ty(c.*.funcs.data[fi].ret_ty)==2){cop=I32IROp.f32call;}
            i386_emit_ir(c,cop,((c.*.funcs.data[fi].label as i64)*65536)+(c.*.funcs.data[fi].param_words as i64));
            i386_emit_normalize(c,c.*.funcs.data[fi].ret_ty);
        }
        else => { i386_fail(c,"expression is outside the i32 backend"); }
    }
}
fn i386_store_struct_expr(c:*I386Lower,n:*Node,ty:[]u8,base:i32)void{
    let si:i32=i386_struct(c,ty);
    if(si<0||i386_struct_words(c,si)<1){i386_fail(c,"struct local requires a checked non-recursive matching struct literal, local, or aggregate-return call");return;}
    let source:I386ValueRef=i386_value_ref(c,n);
    if(source.valid==1){
        if(i386_type_match(source.ty,ty)==0){i386_fail(c,"struct local requires a matching struct literal or aggregate-return call");return;}
        i386_emit_struct_copy(c,base,c.*.locals.data[source.local].slot-source.word_offset,si,0);
        return;
    }
    switch(n.*){
        .slit_=>|lit|{
            let lit_ty:[]u8=lit.sname;if(lit.targs.len>0){lit_ty=cg_mangle_generic_norm(lit.sname,lit.targs);}if(i386_type_match(lit_ty,ty)==0){i386_fail(c,"struct local requires a matching struct literal or aggregate-return call");return;}
            let field:i32=0;
            while(field<c.*.structs.data[si].fields.len){
                if(i386_struct_field_supported(c,c.*.structs.data[si].fields.data[field].pty)==0){i386_fail(c,"struct fields must be supported sequential scalars or acyclic structs");return;}
                let found:i32=-1;let k:i32=0;while(k<lit.fields.len){if(@strEq(lit.fields.data[k].name,c.*.structs.data[si].fields.data[field].name)){found=k;}k=k+1;}
                if(found<0){i386_fail(c,"struct literal is missing a field");return;}
                let fty:[]u8=c.*.structs.data[si].fields.data[field].pty;let off:i32=i386_struct_field_word_offset(c,si,field);
                if(i386_struct(c,fty)>=0){i386_store_struct_expr(c,lit.fields.data[found].val,fty,base-off);}
                else{let aty:[]u8=i386_effective_ty(c,lit.fields.data[found].val,fty);if(i386_value_types_match(fty,aty)==0){i386_fail(c,"struct field initializer requires an explicit cast");return;}i386_expr_expected(c,lit.fields.data[found].val,fty);i386_emit_value_store(c,fty,base-off);}
                field=field+1;
            }
        }
        .call=>|_call|{
            let actual:[]u8=i386_expr_ty(c,n);
            if(i386_type_match(actual,ty)==0){
                i386_fail(c,_zag_str_concat("struct local requires a matching struct literal or aggregate-return call (expected=",
                    _zag_str_concat(ty,_zag_str_concat(" actual=",_zag_str_concat(actual,")")))));
                return;
            }
            let old_target:i32=c.*.sret_target;c.*.sret_target=base;i386_expr(c,n);c.*.sret_target=old_target;
        }
        else=>{i386_fail(c,"struct local requires a matching struct literal or aggregate-return call");}
    }
}
fn i386_stmt(c: *I386Lower, n: *Node) void {
    switch(n.*) {
        .let_ => |x| {
            if(x.has_init==0) { i386_fail(c,"uninitialized locals are rejected"); return; }
            if(x.has_dty==1 && i386_word_ty(x.dty)==0 && i386_wide_integer_ty(x.dty)==0 && i386_float_ty(x.dty)==0 && i386_slice_ty(x.dty)==0 && i386_struct(c,x.dty)<0) { i386_fail(c,"local type is not a supported i386 scalar, byte slice, or struct"); return; }
            if(i386_local(c,x.name)!=-1000000) { i386_fail(c,"duplicate local name"); return; }
            if(x.has_dty==1 && i386_struct(c,x.dty)>=0) {
                let si:i32=i386_struct(c,x.dty);let words:i32=i386_struct_words(c,si);if(words<1){i386_fail(c,"struct fields must be supported 32-bit scalars or f32/f64 in an acyclic sequential layout");return;}if(c.*.next_slot>I386_MAX_FRAME_WORDS()-words){i386_fail(c,"i386 local spill frame exceeds the bounded 1 MiB limit");return;}let base:i32=c.*.next_slot+words-1;let field:i32=0;
                c.*.next_slot=c.*.next_slot+words;push[I386Local](&c.*.locals,I386Local{.name=x.name,.slot=base,.ty=x.dty});
                while(field<c.*.structs.data[si].fields.len){
                    if(i386_struct_field_supported(c,c.*.structs.data[si].fields.data[field].pty)==0){i386_fail(c,"struct fields must be supported sequential scalars or acyclic structs");return;}field=field+1;
                }
                i386_store_struct_expr(c,x.expr,x.dty,base);
                return;
            }
            let ty:[]u8=i386_uncontextual_ty(c,x.expr);if(x.has_dty==1){ty=x.dty;}let actual:[]u8=i386_effective_ty(c,x.expr,ty);if(i386_value_types_match(ty,actual)==0){i386_fail(c,_zag_str_concat("local initializer requires an explicit cast from ",_zag_str_concat(actual,_zag_str_concat(" to ",ty))));return;}i386_expr_expected(c,x.expr,ty);
            let slot:i32=c.*.next_slot;c.*.next_slot=slot+i386_ty_words(ty);
            push[I386Local](&c.*.locals,I386Local{.name=x.name,.slot=slot,.ty=ty});
            if(i386_slice_ty(ty)==1){c.*.locals.data[c.*.locals.len-1].slot=slot+1;i386_emit_ir(c,I32IROp.pair_store,slot+1);}else if(i386_wide_integer_ty(ty)==1){i386_emit_ir(c,I32IROp.wide_store,slot);}else if(i386_float_ty(ty)==1){i386_emit_ir(c,I32IROp.f64_store,slot as i64);}else if(i386_float_ty(ty)==2){i386_emit_ir(c,I32IROp.f32_store,slot);}else{i386_emit_normalize(c,ty);i386_emit_ir(c,I32IROp.store,slot as i64);}
        }
        .assign => |x| {
            let slot:i32=-1000000;
            let target_ty:[]u8="";
            switch(x.target.*) {
                .id => |id| { slot=i386_local(c,id.name);let li:i32=i386_local_index(c,id.name);if(li>=0){target_ty=c.*.locals.data[li].ty;} }
                .fld => |f| {
                    if(@strEq(f.fname,"*")){let pty:[]u8=i386_expr_ty(c,f.base);let elem:[]u8=i386_pointer_elem(pty);let aty:[]u8=i386_effective_ty(c,x.expr,elem);if(elem.len==0||i386_value_types_match(elem,aty)==0){i386_fail(c,"pointer store requires an explicitly matching 32-bit value");return;}i386_expr_expected(c,f.base,pty);i386_expr_expected(c,x.expr,elem);i386_emit_ir(c,I32IROp.store_ind,0);return;}
                    let pointer_field:I386PointerField=i386_pointer_field(c,x.target);
                    if(pointer_field.valid==1){
                        let pointer_node:*Node=i386_pointer_field_base(x.target);
                        let pointer_ty:[]u8=i386_expr_ty(c,pointer_node);
                        let field_ty:[]u8=c.*.structs.data[pointer_field.struct_index].fields.data[pointer_field.field_index].pty;
                        let offset:i32=i386_struct_field_word_offset(c,pointer_field.struct_index,pointer_field.field_index);
                        let actual:[]u8=i386_effective_ty(c,x.expr,field_ty);
                        if(offset<0){i386_fail(c,"pointer field offset is outside the bounded i386 layout");return;}
                        if(i386_value_types_match(field_ty,actual)==0){i386_fail(c,_zag_str_concat("pointer field assignment requires an explicitly matching value: field=",_zag_str_concat(field_ty,_zag_str_concat(" value=",actual))));return;}
                        i386_emit_pointer_field_store(c,pointer_node,pointer_ty,field_ty,offset*4,x.expr);
                        return;
                    }
                    let ref:I386ValueRef=i386_value_ref(c,x.target);if(ref.valid==1){if(c.*.locals.data[ref.local].slot<0){i386_fail(c,"aggregate mutation through a by-value parameter is unsupported");return;}let dest:i32=c.*.locals.data[ref.local].slot-ref.word_offset;if(i386_struct(c,ref.ty)>=0){i386_store_struct_expr(c,x.expr,ref.ty,dest);return;}let aty:[]u8=i386_effective_ty(c,x.expr,ref.ty);if(i386_value_types_match(ref.ty,aty)==0){i386_fail(c,"struct field assignment requires an explicit cast");return;}i386_expr_expected(c,x.expr,ref.ty);i386_emit_value_store(c,ref.ty,dest);return;}
                }
                .idx => |ix| {
                    let bt:[]u8=i386_expr_ty(c,ix.base);if(i386_pointer_ty(bt)==0){i386_fail(c,"slice mutation is not implemented in the i686 subset");return;}
                    let elem:[]u8=i386_pointer_elem(bt);if(!@strEq(elem,"i32")&&!@strEq(elem,"usize")){i386_fail(c,"pointer index stores support only i32 and usize elements");return;}
                    let it:[]u8=i386_expr_ty(c,ix.idx);if(i386_int_literal(ix.idx)==1){it="usize";}if(!@strEq(it,"usize")){i386_fail(c,"raw pointer index must be usize on i686");return;}
                    let aty:[]u8=i386_effective_ty(c,x.expr,elem);if(i386_value_types_match(elem,aty)==0){i386_fail(c,"pointer index store requires an explicit value cast");return;}
                    i386_expr_expected(c,ix.base,bt);i386_expr_expected(c,ix.idx,"usize");i386_expr_expected(c,x.expr,elem);i386_emit_ir(c,I32IROp.ptr_store_index,i386_elem_size(elem));return;
                }
                else => { }
            }
            if(slot==-1000000) { i386_fail(c,"assignment target must be a local or pointer dereference"); return; }
            let target_si:i32=i386_struct(c,target_ty);if(target_si>=0){if(slot<0){i386_fail(c,"aggregate mutation through a by-value parameter is unsupported");return;}i386_store_struct_expr(c,x.expr,target_ty,slot);return;}
            let aty:[]u8=i386_effective_ty(c,x.expr,target_ty);if(i386_value_types_match(target_ty,aty)==0){i386_fail(c,"assignment requires an explicit cast");return;}i386_expr_expected(c,x.expr,target_ty);if(i386_wide_integer_ty(target_ty)==1){i386_emit_ir(c,I32IROp.wide_store,slot);}else if(i386_float_ty(target_ty)==1){i386_emit_ir(c,I32IROp.f64_store,slot);}else if(i386_float_ty(target_ty)==2){i386_emit_ir(c,I32IROp.f32_store,slot);}else{i386_emit_normalize(c,target_ty);i386_emit_ir(c,I32IROp.store,slot as i64);}
        }
        .ret => |x| {
            if(x.has_expr==0) { if(@strEq(c.*.current_ret_ty,"void")){i386_emit_ir(c,I32IROp.ret_void,0);}else{i386_fail(c,"non-void i386 function requires a return value");} }
            else {
                let rsi:i32=i386_struct(c,c.*.current_ret_ty);if(rsi>=0){let source:I386ValueRef=i386_value_ref(c,x.expr);if(source.valid==1&&@strEq(source.ty,c.*.current_ret_ty)){i386_emit_struct_sret(c,c.*.locals.data[source.local].slot-source.word_offset,rsi,0,0);i386_emit_ir(c,I32IROp.ret_sret,0);return;}let words:i32=i386_struct_words(c,rsi);if(words<1||c.*.next_slot>I386_MAX_FRAME_WORDS()-words){i386_fail(c,"aggregate return temporary exceeds the bounded i386 frame");return;}let temp:i32=c.*.next_slot+words-1;c.*.next_slot=c.*.next_slot+words;i386_store_struct_expr(c,x.expr,c.*.current_ret_ty,temp);if(c.*.failed!=0){return;}i386_emit_struct_sret(c,temp,rsi,0,0);i386_emit_ir(c,I32IROp.ret_sret,0);return;}
                if(i386_slice_ty(c.*.current_ret_ty)==1||i386_wide_integer_ty(c.*.current_ret_ty)==1){let aty:[]u8=i386_effective_ty(c,x.expr,c.*.current_ret_ty);if(i386_value_types_match(c.*.current_ret_ty,aty)==0){i386_fail(c,"two-word return requires an explicitly matching type");return;}i386_expr_expected(c,x.expr,c.*.current_ret_ty);i386_emit_ir(c,I32IROp.ret_pair,0);return;}
                let ename:[]u8="";switch(x.expr.*){.fld=>|f|{switch(f.base.*){.id=>|id|{if(@strEq(id.name,"error")){ename=f.fname;}}else=>{}}}else=>{}}
                if(ename.len>0){if(c.*.current_error_fn==0){i386_fail(c,"error return requires !i32");}else{i386_emit_ir(c,I32IROp.ret_err,i386_error_code(ename));}}
                else { let expected:[]u8=c.*.current_ret_ty;if(c.*.current_error_fn==1){expected="i32";}let actual:[]u8=i386_effective_ty(c,x.expr,expected);let rt:i32=i386_float_ty(expected);i386_expr_expected(c,x.expr,expected);if(c.*.failed!=0){return;}if(i386_value_types_match(expected,actual)==0){i386_fail(c,_zag_str_concat("return requires an explicit cast from ",_zag_str_concat(actual,_zag_str_concat(" to ",expected))));return;}if(c.*.current_error_fn==1){i386_emit_ir(c,I32IROp.ret_ok,0);}else if(rt==1){i386_emit_ir(c,I32IROp.fret,0);}else if(rt==2){i386_emit_ir(c,I32IROp.f32ret,0);}else{i386_emit_normalize(c,expected);i386_emit_ir(c,I32IROp.ret,0);} }
            }
        }
        .if_ => |x| {
            if(x.has_cap==1) { i386_fail(c,"if captures are not supported"); return; }
            let els:i32=i386_new_label(c);let done:i32=i386_new_label(c);
            i386_expr(c,x.cond);i386_emit_ir(c,I32IROp.jz,els);
            let i:i32=0;while(i<x.then_body.len){i386_stmt(c,x.then_body.data[i]);i=i+1;}
            i386_emit_ir(c,I32IROp.jmp,done);i386_emit_ir(c,I32IROp.label,els);
            let j:i32=0;while(j<x.els_body.len){i386_stmt(c,x.els_body.data[j]);j=j+1;}
            i386_emit_ir(c,I32IROp.label,done);
        }
        .while_ => |x| {
            if(x.has_cap==1) { i386_fail(c,"while captures are not supported"); return; }
            let start:i32=i386_new_label(c);let done:i32=i386_new_label(c);
            let old_break:i32=c.*.break_label;let old_continue:i32=c.*.continue_label;
            c.*.break_label=done;c.*.continue_label=start;
            i386_emit_ir(c,I32IROp.label,start);i386_expr(c,x.cond);i386_emit_ir(c,I32IROp.jz,done);
            let i:i32=0;while(i<x.body.len){i386_stmt(c,x.body.data[i]);i=i+1;}
            i386_emit_ir(c,I32IROp.jmp,start);i386_emit_ir(c,I32IROp.label,done);
            c.*.break_label=old_break;c.*.continue_label=old_continue;
        }
        .break_ => |_x| { if(c.*.break_label<0){i386_fail(c,"break outside loop");}else{i386_emit_ir(c,I32IROp.jmp,c.*.break_label);} }
        .continue_ => |_x| { if(c.*.continue_label<0){i386_fail(c,"continue outside loop");}else{i386_emit_ir(c,I32IROp.jmp,c.*.continue_label);} }
        .estmt => |x| {
            let et:[]u8=i386_uncontextual_ty(c,x.expr);
            let si:i32=i386_struct(c,et);
            if(si>=0){
                let words:i32=i386_struct_words(c,si);
                if(words<1||c.*.next_slot>I386_MAX_FRAME_WORDS()-words){
                    i386_fail(c,"discarded aggregate result exceeds the bounded i386 frame");
                }else{
                    let temp:i32=c.*.next_slot+words-1;c.*.next_slot=c.*.next_slot+words;
                    let old_target:i32=c.*.sret_target;c.*.sret_target=temp;
                    i386_expr(c,x.expr);c.*.sret_target=old_target;
                }
            }else{
                i386_expr(c,x.expr);if(!@strEq(et,"void")){i386_emit_ir(c,I32IROp.discard,0);}
            }
        }
        .unsafe_ => |x| { let i:i32=0;while(i<x.body.len){i386_stmt(c,x.body.data[i]);i=i+1;} }
        else => { i386_fail(c,_zag_str_concat("statement is outside the current i32 IR for return type ",c.*.current_ret_ty)); }
    }
}

fn lower_i386_i32_program(decls: ArrayList[*Node], out: *I386Lower) i32 {
    let found:i32=0;
    // Declare every callable symbol first so forward calls are deterministic.
    let i:i32=0;
    while(i<decls.len) {
        switch(decls.data[i].*) {
            .struct_ => |s| { push[StructDecl](&out.*.structs,s); }
            .enum_ => |_e| { }
            .fn_decl => |f| { if(f.tparams.len==0){
                if(i386_fn(out,f.name)>=0){i386_fail(out,"duplicate function");}
                let rsi:i32=i386_struct(out,f.ret);if(f.tparams.len!=0 || (!@strEq(f.ret,"void")&&i386_word_ty(f.ret)==0&&i386_wide_integer_ty(f.ret)==0&&!@strEq(f.ret,"!i32")&&!@strEq(f.ret,"f64")&&!@strEq(f.ret,"f32")&&i386_slice_ty(f.ret)==0&&rsi<0)){i386_fail(out,"functions must be non-generic and return a supported i386 scalar, slice, void, or basic struct");}
                if(f.is_extern==1&&out.*.object_mode==0){i386_fail(out,"external functions require --emit-obj or --emit-static");}
                if(f.is_extern==0 && !@strEq(f.ret,"void") && i386_body_always_returns(f.body)==0){i386_fail(out,_zag_str_concat("function can reach its end without returning: ",f.name));}
                if(rsi>=0&&i386_struct_words(out,rsi)<1){i386_fail(out,_zag_str_concat("aggregate returns require 32-bit scalar fields or implemented f32/f64 layout in an acyclic sequential struct: ",f.name));}
                let pi:i32=0;let pwords:i32=0;while(pi<f.params.len){let psi:i32=i386_struct(out,f.params.data[pi].pty);if(i386_word_ty(f.params.data[pi].pty)==0&&i386_wide_integer_ty(f.params.data[pi].pty)==0&&i386_float_ty(f.params.data[pi].pty)==0&&i386_slice_ty(f.params.data[pi].pty)==0&&psi<0){i386_fail(out,"function parameter is not a supported i386 scalar, byte slice, or struct");}if(psi>=0&&i386_struct_words(out,psi)<1){i386_fail(out,"by-value struct parameters require 32-bit scalar, i64/u64, or implemented f32/f64 layout in an acyclic sequential struct");}let words:i32=i386_param_words(out,f.params.data[pi].pty);if(words<0||pwords>I386_MAX_CALL_WORDS()-words){i386_fail(out,"i386 call argument area exceeds the bounded 64 KiB stack-spill limit");}else{pwords=pwords+words;}pi=pi+1;}
                let returns_error:i32=0;if(@strEq(f.ret,"!i32")){returns_error=1;}
                let ptypes:ArrayList[[]u8]=make[[]u8](f.params.len);let pti:i32=0;while(pti<f.params.len){push[[]u8](&ptypes,f.params.data[pti].pty);pti=pti+1;}
                let exported:i32=f.is_pub;if(@strEq(f.name,"main")){exported=1;}
                push[I386Fn](&out.*.funcs,I386Fn{.name=f.name,.label=i386_new_label(out),.params=f.params.len,.param_words=pwords,.param_types=ptypes,.ret_ty=f.ret,.returns_error=returns_error,.defined=(f.is_extern==0) as i32,.exported=exported,.offset=-1});
                if(@strEq(f.name,"main")){if(f.is_extern==1){i386_fail(out,"main cannot be external");}else{if(found==1){i386_fail(out,"duplicate main");}found=1;if(f.params.len!=0||!@strEq(f.ret,"i32")){i386_fail(out,"main must be fn main() i32");}}}
            } }
            else => { i386_fail(out,"only functions and basic structs are supported"); }
        }
        i=i+1;
    }
    if(found==0&&out.*.object_mode==0) { i386_fail(out,"missing `fn main() i32`"); }
    // Main is emitted first because ELF _start enters the first function.
    let pass:i32=0;while(pass<2){let di:i32=0;while(di<decls.len){switch(decls.data[di].*){.fn_decl=>|f|{
        if(f.tparams.len==0&&f.is_extern==0&&((pass==0&&@strEq(f.name,"main"))||(pass==1&&!@strEq(f.name,"main")))){
            out.*.locals=make[I386Local](8);out.*.next_slot=0;out.*.break_label=-1;out.*.continue_label=-1;out.*.current_error_fn=0;out.*.current_ret_ty=f.ret;out.*.current_fn_name=f.name;out.*.sret_target=-1;if(@strEq(f.ret,"!i32")){out.*.current_error_fn=1;}
            out.*.expected_ty=f.ret;
            let pi:i32=0;let poff:i32=0;if(i386_struct(out,f.ret)>=0){poff=1;}while(pi<f.params.len){push[I386Local](&out.*.locals,I386Local{.name=f.params.data[pi].name,.slot=-1-poff,.ty=f.params.data[pi].pty});poff=poff+i386_param_words(out,f.params.data[pi].pty);pi=pi+1;}
            i386_emit_ir(out,I32IROp.label,out.*.funcs.data[i386_fn(out,f.name)].label);
            let enter_at:i32=out.*.ir.len;i386_emit_ir(out,I32IROp.enter,0);
            let before:i32=out.*.ir.len;let j:i32=0;while(j<f.body.len){i386_stmt(out,f.body.data[j]);j=j+1;}
            let has_ret:i32=0;let ri:i32=before;while(ri<out.*.ir.len){if(out.*.ir.data[ri].op==I32IROp.ret||out.*.ir.data[ri].op==I32IROp.ret_pair||out.*.ir.data[ri].op==I32IROp.ret_sret||out.*.ir.data[ri].op==I32IROp.fret||out.*.ir.data[ri].op==I32IROp.f32ret||out.*.ir.data[ri].op==I32IROp.ret_ok||out.*.ir.data[ri].op==I32IROp.ret_err){has_ret=1;}ri=ri+1;}
            if(has_ret==0){if(@strEq(f.ret,"void")){i386_emit_ir(out,I32IROp.ret_void,0);}else{i386_fail(out,_zag_str_concat("function lacks return: ",f.name));}}
            if(out.*.next_slot<0||out.*.next_slot>I386_MAX_FRAME_WORDS()){i386_fail(out,"i386 local spill frame exceeds the bounded 1 MiB limit");}
            set[I32IR](&out.*.ir,enter_at,I32IR{.op=I32IROp.enter,.value=out.*.next_slot});
        }}else=>{}}di=di+1;}pass=pass+1;}
    return out.*.failed;
}

fn i386_b(out:*ArrayList[u8],b:i64) void { push[u8](out,(b&255) as u8); }
fn i386_i32(out:*ArrayList[u8],v0:i64) void { let v:i64=v0; let i:i32=0; while(i<4){let b:i64=v&255;i386_b(out,b);v=(v-b)/256;i=i+1;} }
fn i386_patch32(out:*ArrayList[u8],pos:i32,v0:i64) void { let v:i64=v0;let i:i32=0;while(i<4){let b:i64=v&255;set[u8](out,pos+i,b as u8);v=(v-b)/256;i=i+1;} }
fn i386_fn_label(c:*I386Lower,label:i32)i32{let i:i32=0;while(i<c.*.funcs.len){if(c.*.funcs.data[i].label==label){return i;}i=i+1;}return -1;}
