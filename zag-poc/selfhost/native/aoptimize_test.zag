// selfhost/native/aoptimize_test.zag — verifies the AArch64 optimizer.
//
// This pass only earns its place if it is provably behaviour-preserving, so the
// tests are weighted towards NEGATIVE cases: instructions that must survive
// untouched. A rewrite that deletes too much is the failure mode that produces
// wrong answers with no crash and no diagnostic.
//
// The regression case at the top is not hypothetical. `aopt_dce_liveness`
// originally treated `add x0, x1` (`add xd, xd, xm`, so dst is BOTH destination
// and first source) as if it had no source register. The source then looked
// dead, a rematerialized `mov x1, C` in front of it was deleted, and the add
// read an unwritten x1. `b = b + 5000` evaluated to `b`. It type-checked, it
// assembled, and it ran.

@import("aisa.zag")
@import("aarch64.zag")
@import("aoptimize.zag")

fn ao_show(tag: []u8, fails: *i32) void {
    _zag_print("FAIL aoptimize: ");
    _zag_print(tag);
    _zag_print("\n");
    fails.* = fails.* + 1;
}

// Assert the optimized program has exactly `want_len` instructions and that
// instruction `i` has the given kind (a negative `want_kind` skips the check).
fn ao_shape(tag: []u8, prog: ArrayList[AInstr], want_len: i32,
            i: i32, want_kind: i32, fails: *i32) void {
    let out: ArrayList[AInstr] = aoptimize(prog);
    if (len[AInstr](out) != want_len) {
        ao_show(tag, fails);
        _zag_print("  length ");
        ao_show_num(len[AInstr](out), want_len, tag, fails);
        return;
    }
    if (want_kind >= 0) {
        let got: i32 = get[AInstr](out, i).kind;
        if (got != want_kind) {
            ao_show(tag, fails);
            _zag_print("  instr ");
            ao_show_num(i, i, tag, fails);
            _zag_print(" kind ");
            ao_show_num(got, want_kind, tag, fails);
        }
    }
}

fn ao_show_num(got: i32, want: i32, tag: []u8, fails: *i32) void {
    _zag_print("got ");
    ao_show_i(got);
    _zag_print(" want ");
    ao_show_i(want);
    _zag_print("\n");
}

fn ao_show_i(v: i32) void {
    if (v == 0) { _zag_print("0"); return; }
    if (v < 0) { _zag_print("-"); v = 0 - v; }
    let started: i32 = 0;
    let div: i32 = 1000000000;
    while (div > 0) {
        let digit: i32 = (v / div) % 10;
        if (digit != 0 || started == 1 || div == 1) {
            _zag_print(_zag_i64_to_str(digit as i64));
            started = 1;
        }
        div = div / 10;
    }
}

// `make` allocates but does not zero, so a negative assertion against it would
// read garbage. Every live-set in these tests starts zeroed.
fn ao_live() ArrayList[i32] {
    let l: ArrayList[i32] = make[i32](32);
    let z: i32 = 0;
    while (z < 32) { set[i32](&l, z, 0); z = z + 1; }
    return l;
}

fn ai(k: i32, d: i32, s: i32, imm: i64) AInstr {
    return AInstr{ .kind = k, .dst = d, .src = s, .imm = imm, .disp = 0, .lbl = 0 };
}

fn prog1(a: AInstr) ArrayList[AInstr] {
    let p: ArrayList[AInstr] = make[AInstr](8);
    push[AInstr](&p, a);
    return p;
}

fn main() i32 {
    let fails: i32 = 0;

    // ── REGRESSION: the source of a two-address op must stay live ───────────
    // mov x0,5000 ; push x0 ; pop x1 ; pop x0 ; add x0,x1 ; push ; pop
    // The pop of x1 becomes `mov x1,5000`. That mov must survive, because
    // `add x0,x1` reads x1. Deleting it is the miscompile described above.
    let r: ArrayList[AInstr] = make[AInstr](8);
    push[AInstr](&r, ai(AK_MOV_IMM(), A_X0(), 0, 5000));
    push[AInstr](&r, ai(AK_PUSH(), A_X0(), 0, 0));
    push[AInstr](&r, ai(AK_POP(), A_X1(), 0, 0));
    push[AInstr](&r, ai(AK_POP(), A_X0(), 0, 0));
    push[AInstr](&r, ai(AK_ADD_RR(), A_X0(), A_X1(), 0));
    push[AInstr](&r, ai(AK_PUSH(), A_X0(), 0, 0));
    push[AInstr](&r, ai(AK_POP(), A_X2(), 0, 0));
    let ro: ArrayList[AInstr] = aoptimize(r);
    // Later optimizations can shorten the run further, so assert that the
    // two-address add still reads x1 and that x1 was defined BEFORE that add.
    // A length assertion would reject a valid elimination of stack traffic.
    let add_seen: i32 = 0;
    let x1_defined: i32 = 0;
    let i: i32 = 0;
    while (i < len[AInstr](ro)) {
        let ins: AInstr = get[AInstr](ro, i);
        if (ins.kind == AK_ADD_RR()) {
            add_seen = 1;
            if (ins.src != A_X1()) { ao_show("add keeps x1 as its source", &fails); }
            if (x1_defined == 0) { ao_show("add source must be defined before use", &fails); }
        }
        if ((ins.kind == AK_MOV_IMM() || ins.kind == AK_MOV_RR()) && ins.dst == A_X1()) {
            x1_defined = 1;
        }
        i = i + 1;
    }
    if (add_seen == 0) { ao_show("add survived the pass", &fails); }
    if (x1_defined == 0) {
        ao_show("x1 is still defined before the add that reads it", &fails);
    }

    // ── POSITIVE: constant push/pop elimination ────────────────────────────
    // mov x0,7 ; push x0 ; pop x1  ->  mov x0,7 ; mov x1,7
    let p1: ArrayList[AInstr] = make[AInstr](8);
    push[AInstr](&p1, ai(AK_MOV_IMM(), A_X0(), 0, 7));
    push[AInstr](&p1, ai(AK_PUSH(), A_X0(), 0, 0));
    push[AInstr](&p1, ai(AK_POP(), A_X1(), 0, 0));
    let o1: ArrayList[AInstr] = aoptimize(p1);
    if (len[AInstr](o1) != 2) { ao_show("constant push/pop pair eliminated", &fails); }
    if (get[AInstr](o1, 1).kind != AK_MOV_IMM()) {
        ao_show("pop of a constant becomes mov-imm", &fails);
    }
    if (get[AInstr](o1, 1).imm != 7) { ao_show("rematerialized constant is correct", &fails); }
    if (get[AInstr](o1, 1).dst != A_X1()) { ao_show("rematerialized into the popped register", &fails); }

    // ── POSITIVE: constant folding ─────────────────────────────────────────
    // mov x0,5 ; mov x1,7 ; add x0,x1  ->  mov x0,12
    // The trailing push keeps x0 live. Without a consumer the fold correctly
    // yields a dead `mov x0,12` and DCE then removes it, so asserting a length of
    // 1 here would be asserting that DCE does NOT run.
    let p2: ArrayList[AInstr] = make[AInstr](8);
    push[AInstr](&p2, ai(AK_MOV_IMM(), A_X0(), 0, 5));
    push[AInstr](&p2, ai(AK_MOV_IMM(), A_X1(), 0, 7));
    push[AInstr](&p2, ai(AK_ADD_RR(), A_X0(), A_X1(), 0));
    push[AInstr](&p2, ai(AK_PUSH(), A_X0(), 0, 0));
    let o2: ArrayList[AInstr] = aoptimize(p2);
    // Assert the fold, not an exact length: DCE's live-out at end-of-program is
    // conservatively "every register", so the now-dead `mov x1,7` is retained.
    // What must be true is that no ADD_RR survives and the value 12 is present.
    let add2: i32 = 0;
    let saw12: i32 = 0;
    let j2: i32 = 0;
    while (j2 < len[AInstr](o2)) {
        if (get[AInstr](o2, j2).kind == AK_ADD_RR()) { add2 = 1; }
        if (get[AInstr](o2, j2).kind == AK_MOV_IMM() && get[AInstr](o2, j2).imm == 12) { saw12 = 1; }
        j2 = j2 + 1;
    }
    if (add2 == 1) { ao_show("the constant add was folded away", &fails); }
    if (saw12 == 0) { ao_show("folded value is 5+7=12", &fails); }
    if (len[AInstr](o2) >= len[AInstr](p2)) {
        ao_show("folding must not grow the program", &fails);
    }

    // ── POSITIVE: an unknown adjacent push/pop becomes a register copy ─────
    // load x0,[x1] ; push x0 ; pop x2 -> load x0,[x1] ; mov x2,x0
    let p3: ArrayList[AInstr] = make[AInstr](8);
    push[AInstr](&p3, ai(AK_LOAD(), A_X0(), A_X1(), 0));
    push[AInstr](&p3, ai(AK_PUSH(), A_X0(), 0, 0));
    push[AInstr](&p3, ai(AK_POP(), A_X2(), 0, 0));
    let o3: ArrayList[AInstr] = aoptimize(p3);
    if (len[AInstr](o3) != 2) { ao_show("adjacent unknown-value pair folded", &fails); }
    if (len[AInstr](o3) == 2) {
        let copy: AInstr = get[AInstr](o3, 1);
        if (copy.kind != AK_MOV_RR() || copy.dst != A_X2() || copy.src != A_X0()) {
            ao_show("adjacent unknown value copied to exact destination", &fails);
        }
    }

    // ── NEGATIVE: unknown values across an instruction remain on stack ────
    let p3gap: ArrayList[AInstr] = make[AInstr](8);
    push[AInstr](&p3gap, ai(AK_LOAD(), A_X0(), A_X1(), 0));
    push[AInstr](&p3gap, ai(AK_PUSH(), A_X0(), 0, 0));
    push[AInstr](&p3gap, ai(AK_CMP_IMM(), A_X3(), 0, 1));
    push[AInstr](&p3gap, ai(AK_POP(), A_X2(), 0, 0));
    let o3gap: ArrayList[AInstr] = aoptimize(p3gap);
    if (len[AInstr](o3gap) != 4 || get[AInstr](o3gap, 1).kind != AK_PUSH() ||
        get[AInstr](o3gap, 3).kind != AK_POP()) {
        ao_show("unknown value across a gap remains stacked", &fails);
    }

    // ── NEGATIVE: reserved-register pairs remain unchanged ────────────────
    let p3reserved: ArrayList[AInstr] = make[AInstr](4);
    push[AInstr](&p3reserved, ai(AK_PUSH(), A_X28(), 0, 0));
    push[AInstr](&p3reserved, ai(AK_POP(), A_X2(), 0, 0));
    let o3reserved: ArrayList[AInstr] = aoptimize(p3reserved);
    if (len[AInstr](o3reserved) != 2 || get[AInstr](o3reserved, 0).kind != AK_PUSH() ||
        get[AInstr](o3reserved, 1).kind != AK_POP()) {
        ao_show("reserved source push/pop remains unchanged", &fails);
    }

    // ── NEGATIVE: a breaker between push and pop ───────────────────────────
    // mov x0,7 ; push x0 ; jmp L ; pop x1 ; L: ret
    let p4: ArrayList[AInstr] = make[AInstr](8);
    push[AInstr](&p4, ai(AK_MOV_IMM(), A_X0(), 0, 7));
    push[AInstr](&p4, ai(AK_PUSH(), A_X0(), 0, 0));
    push[AInstr](&p4, ai(AK_JMP(), 0, 0, 0));
    push[AInstr](&p4, ai(AK_LABEL(), 0, 0, 0));
    push[AInstr](&p4, ai(AK_POP(), A_X1(), 0, 0));
    push[AInstr](&p4, ai(AK_RET(), 0, 0, 0));
    let o4: ArrayList[AInstr] = aoptimize(p4);
    if (len[AInstr](o4) != 6) { ao_show("push/pop across a breaker both survive", &fails); }
    if (get[AInstr](o4, 1).kind != AK_PUSH()) { ao_show("push before a jmp survives", &fails); }
    if (get[AInstr](o4, 4).kind != AK_POP()) { ao_show("pop after a jmp survives", &fails); }

    // ── NEGATIVE: constants must not leak across a label ───────────────────
    // mov x0,7 ; L: push x0 ; cmp x3,#0 ; pop x1 -> push/pop stay,
    // because the constant is forgotten at the label and the pair is not adjacent.
    let p5: ArrayList[AInstr] = make[AInstr](8);
    push[AInstr](&p5, ai(AK_MOV_IMM(), A_X0(), 0, 7));
    push[AInstr](&p5, ai(AK_LABEL(), 0, 0, 0));
    push[AInstr](&p5, ai(AK_PUSH(), A_X0(), 0, 0));
    push[AInstr](&p5, ai(AK_CMP_IMM(), A_X3(), 0, 0));
    push[AInstr](&p5, ai(AK_POP(), A_X1(), 0, 0));
    push[AInstr](&p5, ai(AK_RET(), 0, 0, 0));
    let o5: ArrayList[AInstr] = aoptimize(p5);
    if (len[AInstr](o5) != 6) { ao_show("a label ends the run", &fails); }
    if (get[AInstr](o5, 2).kind != AK_PUSH()) { ao_show("push after a label is not rematerialized", &fails); }

    // ── NEGATIVE: side-effecting instructions are never removed ────────────
    let p6: ArrayList[AInstr] = make[AInstr](8);
    push[AInstr](&p6, ai(AK_MOV_IMM(), A_X0(), 0, 3));
    push[AInstr](&p6, ai(AK_STORE(), A_X1(), A_X0(), 0));
    push[AInstr](&p6, ai(AK_SVC(), 0, 0, 0));
    push[AInstr](&p6, ai(AK_RET(), 0, 0, 0));
    let o6: ArrayList[AInstr] = aoptimize(p6);
    if (get[AInstr](o6, 1).kind != AK_STORE()) { ao_show("store survives", &fails); }
    if (get[AInstr](o6, 2).kind != AK_SVC()) { ao_show("svc survives", &fails); }
    let store_found: i32 = 0;
    let svc_found: i32 = 0;
    let k: i32 = 0;
    while (k < len[AInstr](o6)) {
        if (get[AInstr](o6, k).kind == AK_STORE()) { store_found = 1; }
        if (get[AInstr](o6, k).kind == AK_SVC()) { svc_found = 1; }
        k = k + 1;
    }
    if (store_found == 0) { ao_show("a store is never deleted", &fails); }
    if (svc_found == 0) { ao_show("a syscall is never deleted", &fails); }

    // ── NEGATIVE: x28 is the expression stack pointer, never a value ───────
    let p7: ArrayList[AInstr] = make[AInstr](8);
    push[AInstr](&p7, ai(AK_MOV_IMM(), A_X0(), 0, 4));
    push[AInstr](&p7, ai(AK_PUSH(), A_X28(), 0, 0));
    push[AInstr](&p7, ai(AK_POP(), A_X1(), 0, 0));
    let o7: ArrayList[AInstr] = aoptimize(p7);
    if (get[AInstr](o7, 1).kind != AK_PUSH()) { ao_show("x28 is never rematerialized", &fails); }

    // ── ROBUSTNESS: empty and all-breaker programs ─────────────────────────
    let empty: ArrayList[AInstr] = make[AInstr](1);
    let oe: ArrayList[AInstr] = aoptimize(empty);
    if (len[AInstr](oe) != 0) { ao_show("empty program stays empty", &fails); }

    let p8: ArrayList[AInstr] = make[AInstr](8);
    push[AInstr](&p8, ai(AK_MOV_IMM(), A_X0(), 0, 9));
    push[AInstr](&p8, ai(AK_RET(), 0, 0, 0));
    let o8: ArrayList[AInstr] = aoptimize(p8);
    if (len[AInstr](o8) != 2) { ao_show("a lone mov before ret is not removed", &fails); }

    // ── ROBUSTNESS: an unbalanced push must not crash or rewrite ───────────
    let p9: ArrayList[AInstr] = make[AInstr](8);
    push[AInstr](&p9, ai(AK_MOV_IMM(), A_X0(), 0, 7));
    push[AInstr](&p9, ai(AK_PUSH(), A_X0(), 0, 0));
    push[AInstr](&p9, ai(AK_RET(), 0, 0, 0));
    let o9: ArrayList[AInstr] = aoptimize(p9);
    if (len[AInstr](o9) != 3) { ao_show("an unmatched push is kept", &fails); }

    let p10: ArrayList[AInstr] = make[AInstr](8);
    push[AInstr](&p10, ai(AK_POP(), A_X0(), 0, 0));
    push[AInstr](&p10, ai(AK_RET(), 0, 0, 0));
    let o10: ArrayList[AInstr] = aoptimize(p10);
    if (len[AInstr](o10) != 2) { ao_show("an unmatched pop is kept", &fails); }

    // ── REGRESSION (direct): a two-address op marks its SOURCE live ─────────
    // Asserted on the liveness predicate itself rather than through a whole
    // program, because a short run does not always give DCE room to fire — the
    // bug was real but only observable once enough code follows the add. The
    // encoding is `add xd, xd, xm` (aarch64.zag:1089), so BOTH operands are read.
    let rr_kinds: ArrayList[i32] = make[i32](16);
    push[i32](&rr_kinds, AK_ADD_RR());
    push[i32](&rr_kinds, AK_SUB_RR());
    push[i32](&rr_kinds, AK_XOR_RR());
    push[i32](&rr_kinds, AK_OR_RR());
    push[i32](&rr_kinds, AK_ANDR_RR());
    push[i32](&rr_kinds, AK_SHL_RR());
    push[i32](&rr_kinds, AK_SHR_RR());
    push[i32](&rr_kinds, AK_LSHR_RR());
    let n: i32 = 0;
    while (n < len[i32](rr_kinds)) {
        let live: ArrayList[i32] = ao_live();
        let kk: i32 = get[i32](rr_kinds, n);
        aopt_dce_liveness(&live, ai(kk, A_X0(), A_X1(), 0));
        if (get[i32](live, A_X1()) != 1) {
            ao_show("two-address op must mark its source register live", &fails);
        }
        if (get[i32](live, A_X0()) != 1) {
            ao_show("two-address op must mark its destination live", &fails);
        }
        n = n + 1;
    }

    // The immediate forms encode `add xd, xd, #imm` and read dst ONLY. Marking a
    // source live here would be the mirror-image error: it would keep dead
    // definitions alive and silently undo the optimization everywhere.
    let imm_kinds: ArrayList[i32] = make[i32](8);
    push[i32](&imm_kinds, AK_ADD_IMM());
    push[i32](&imm_kinds, AK_SUB_IMM());
    let m: i32 = 0;
    while (m < len[i32](imm_kinds)) {
        let live2: ArrayList[i32] = ao_live();
        let kk2: i32 = get[i32](imm_kinds, m);
        aopt_dce_liveness(&live2, ai(kk2, A_X0(), A_X1(), 0));
        if (get[i32](live2, A_X0()) != 1) { ao_show("add-imm marks dst live", &fails); }
        if (get[i32](live2, A_X1()) != 0) { ao_show("add-imm must NOT mark a source live", &fails); }
        m = m + 1;
    }

    // A plain mov must mark only its source, never its destination.
    let live3: ArrayList[i32] = ao_live();
    aopt_dce_liveness(&live3, ai(AK_MOV_RR(), A_X0(), A_X1(), 0));
    if (get[i32](live3, A_X1()) != 1) { ao_show("mov marks its source live", &fails); }
    if (get[i32](live3, A_X0()) != 0) { ao_show("mov does not mark its destination live", &fails); }

    // ── unsigned branch kinds: constructor ↔ kind ↔ condition-code mapping ──
    // Regression: ai_jhs and ai_jls were emitted with each other's kind codes,
    // so every unsigned `<` and `>` in arm64-compiled code branched on the
    // wrong condition. It type-checked, assembled, and ran. A compiler built
    // with the swap then failed its own toolchain-identity preflight at
    // startup, because the manifest walk is full of `i < len` loops.
    let kjlo: i32 = ai_jlo(9).kind;
    let kjhs: i32 = ai_jhs(9).kind;
    let kjhi: i32 = ai_jhi(9).kind;
    let kjls: i32 = ai_jls(9).kind;
    if (kjlo != AK_JLO()) { ao_show("jlo constructor kind", &fails); }
    if (kjhs != AK_JHS()) { ao_show("jhs constructor kind", &fails); }
    if (kjhi != AK_JHI()) { ao_show("jhi constructor kind", &fails); }
    if (kjls != AK_JLS()) { ao_show("jls constructor kind", &fails); }
    // Hardware B.cond encoding: HS/CS=2, LO/CC=3, HI=8, LS=9.
    if (ACC_HS() != 2) { ao_show("ACC_HS encoding", &fails); }
    if (ACC_LO() != 3) { ao_show("ACC_LO encoding", &fails); }
    if (ACC_HI() != 8) { ao_show("ACC_HI encoding", &fails); }
    if (ACC_LS() != 9) { ao_show("ACC_LS encoding", &fails); }
    if (bcond_cc(AK_JLO()) != ACC_LO()) { ao_show("JLO maps to LO", &fails); }
    if (bcond_cc(AK_JHS()) != ACC_HS()) { ao_show("JHS maps to HS", &fails); }
    if (bcond_cc(AK_JHI()) != ACC_HI()) { ao_show("JHI maps to HI", &fails); }
    if (bcond_cc(AK_JLS()) != ACC_LS()) { ao_show("JLS maps to LS", &fails); }
    // Every jump kind must reach the encoder's jcc dispatch and the optimizer's
    // breaker/jcc predicates, or a branch is silently misclassified.
    if (a_is_jcc(AK_JLO()) != 1 || a_is_jcc(AK_JHS()) != 1 ||
        a_is_jcc(AK_JHI()) != 1 || a_is_jcc(AK_JLS()) != 1) {
        ao_show("unsigned jumps are jcc", &fails);
    }
    if (aopt_is_jcc(AK_JLO()) != 1 || aopt_is_jcc(AK_JHS()) != 1 ||
        aopt_is_jcc(AK_JHI()) != 1 || aopt_is_jcc(AK_JLS()) != 1) {
        ao_show("optimizer sees unsigned jumps as jcc", &fails);
    }
    if (aopt_is_breaker(AK_JLO()) != 1 || aopt_is_breaker(AK_JHS()) != 1 ||
        aopt_is_breaker(AK_JHI()) != 1 || aopt_is_breaker(AK_JLS()) != 1) {
        ao_show("optimizer treats unsigned jumps as breakers", &fails);
    }
    // UDIV carries its divisor in `imm`, the same three-source shape as SDIV.
    let ud: AInstr = ai_udiv(A_X0(), A_X1(), A_X2());
    if (ud.kind != AK_UDIV()) { ao_show("udiv constructor kind", &fails); }
    if (aopt_third_reg(ud) != A_X2()) { ao_show("udiv divisor in imm", &fails); }
    if (aopt_reads_reg(ud, A_X2()) != 1) { ao_show("udiv reads its divisor", &fails); }
    if (aopt_reads_reg(ud, A_X1()) != 1) { ao_show("udiv reads its dividend", &fails); }
    if (aopt_writes_reg(ud, A_X0()) != 1) { ao_show("udiv writes its quotient", &fails); }

    _zag_print("aoptimize: checks run, fails=");
    ao_show_i(fails);
    _zag_print("\n");
    if (fails > 0) {
        _zag_print("aoptimize: FAIL\n");
        return 1;
    }
    _zag_print("aoptimize: pass\n");
    return 0;
}