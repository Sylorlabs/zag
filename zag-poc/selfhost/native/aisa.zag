// selfhost/native/aisa.zag — shared contract for Zag's AArch64 backends.
//
//   acodegen.zag  PRODUCES  ArrayList[AInstr]
//   aarch64.zag   CONSUMES  → machine-code bytes
//   elf_arm64.zag wraps those bytes into a runnable ELF64 AArch64 executable.
//   macho_arm64.zag wraps them into a PIE arm64 Mach-O executable.

@import("../../std/list.zag")
@import("../vector_contract.zag")   // VW_128/VW_256/VW_512, ZT_NEON — the width ladder

struct AInstr {
    kind: i32,
    dst:  i32,   // dest register 0..30 (31 = SP in memory ops)
    src:  i32,   // source register
    imm:  i64,   // immediate or condition code for B.cond; for vector kinds a
                  // packed vector operand descriptor (see av_desc below)
    disp: i32,   // signed displacement for LDR/STR; for the three-source vector
                  // kinds (AK_VBSL/AK_VBIT) the third source VECTOR register,
                  // and for the lane-indexed kinds (AK_VDUP_LANE/AK_VEXTRACT/
                  // AK_VINSERT) the lane index
    lbl:  i32,   // label id
}

// Metadata exported from the exact lowering pass, after generic/runtime
// expansion. Object writers must not reconstruct labels from the input AST.
struct AObjectExport { name: []u8, label: i32 }
struct AObjectMetadata {
    imports: ArrayList[[]u8],
    exports: ArrayList[AObjectExport]
}

fn ANOLBL() i32 { return 0 - 1; }

fn A_DATA_VBASE() i64 { return 67108864; }   // 0x4000000 (keeps clear of large text)

// instruction kinds
fn AK_LABEL()   i32 { return 0; }
fn AK_MOV_IMM() i32 { return 1; }   // mov 64-bit immediate into dst (movz/movk)
fn AK_MOV_RR()  i32 { return 2; }   // orr dst, xzr, src
fn AK_ADD_RR()  i32 { return 3; }
fn AK_SUB_RR()  i32 { return 4; }
fn AK_MUL_RR()  i32 { return 5; }   // madd dst, src1, src2, xzr
fn AK_SDIV()    i32 { return 6; }
fn AK_UDIV()    i32 { return 113; }  // udiv dst,a,b (unsigned quotient)
fn AK_UMULH()   i32 { return 118; }  // high 64 bits of unsigned 64x64 product
fn AK_JLO()     i32 { return 114; }  // b.lo  (unsigned <,  CC)
fn AK_JHS()     i32 { return 115; }  // b.hs  (unsigned >=, CS)
fn AK_JHI()     i32 { return 116; }  // b.hi  (unsigned >)
fn AK_JLS()     i32 { return 117; }  // b.ls  (unsigned <=)
fn AK_CMP_RR()  i32 { return 7; }
fn AK_CMP_IMM() i32 { return 8; }
fn AK_PUSH()    i32 { return 9; }   // push dst onto expression stack
fn AK_POP()     i32 { return 10; }  // pop expression stack into dst
fn AK_LOAD()    i32 { return 11; } // ldr dst, [src + disp]
fn AK_STORE()   i32 { return 12; } // str src2, [dst + disp]  (dst=base, src=value)
fn AK_ADD_IMM() i32 { return 13; }
fn AK_SUB_IMM() i32 { return 14; }
fn AK_NEG()     i32 { return 15; }
fn AK_AND_IMM() i32 { return 16; } // and dst, dst, #imm (for i32 mask)
fn AK_CALL()    i32 { return 17; }
fn AK_JMP()     i32 { return 18; }
fn AK_JE()      i32 { return 19; }
fn AK_JNE()     i32 { return 20; }
fn AK_JL()      i32 { return 21; }
fn AK_JLE()     i32 { return 22; }
fn AK_JG()      i32 { return 23; }
fn AK_JGE()     i32 { return 24; }
fn AK_RET()     i32 { return 25; }
fn AK_SVC()     i32 { return 26; }
fn AK_LEA_LBL() i32 { return 27; } // adr dst, label (PC-relative)
fn AK_SXTW()    i32 { return 28; } // sign-extend w(src) into x(dst)
fn AK_LOADB()   i32 { return 29; } // ldrb dst, [src + disp] (zero-extend byte)
fn AK_STOREB()  i32 { return 30; } // strb src, [dst + disp] (dst=base, src=value)
fn AK_XOR_RR()  i32 { return 31; } // eor dst, dst, src
fn AK_OR_RR()   i32 { return 32; } // orr dst, dst, src
fn AK_ANDR_RR() i32 { return 33; } // and dst, dst, src
fn AK_SHL_RR()  i32 { return 34; } // lslv dst, dst, src
fn AK_SHR_RR()  i32 { return 35; } // asrv dst, dst, src (arithmetic)
fn AK_FMOV_DX() i32 { return 36; } // fmov d(dst), x(src)
fn AK_FMOV_XD() i32 { return 37; } // fmov x(dst), d(src)
fn AK_FADD()    i32 { return 38; } // fadd d(dst), d(dst), d(src)
fn AK_FSUB()    i32 { return 39; }
fn AK_FMUL()    i32 { return 40; }
fn AK_FDIV()    i32 { return 41; }
fn AK_FCMP()    i32 { return 42; } // fcmp d(dst), d(src)
fn AK_SCVTF()   i32 { return 43; } // scvtf d(dst), x(src)
fn AK_FCVTZS()  i32 { return 44; } // fcvtzs x(dst), d(src)
fn AK_CALL_REG() i32 { return 45; } // blr dst
fn AK_DMB() i32 { return 46; }      // dmb ish full acquire/release fence
fn AK_CALL_EXT() i32 { return 47; } // bl with relocation (object mode)
fn AK_LSL_IMM() i32 { return 48; }  // lsl dst, src, #imm
fn AK_VLOADQ() i32 { return 49; }    // ldr q(dst), [x(src) + disp]
fn AK_VSTOREQ() i32 { return 50; }   // str q(src), [x(dst) + disp]
fn AK_VEOR() i32 { return 51; }      // eor v(dst).16b, v(dst).16b, v(src).16b
fn AK_VAND() i32 { return 52; }      // and v(dst).16b, v(dst).16b, v(src).16b
fn AK_VORR() i32 { return 53; }      // orr v(dst).16b, v(dst).16b, v(src).16b
fn AK_VCNT() i32 { return 54; }      // cnt v(dst).16b, v(src).16b
fn AK_VADDV_B() i32 { return 55; }   // addv b(dst), v(src).16b
fn AK_VUMOV_B() i32 { return 56; }   // umov w(dst), v(src).b[0]
fn AK_LOADH()   i32 { return 57; }   // ldrh w(dst), [src + disp]
fn AK_STOREH()  i32 { return 58; }   // strh w(src), [dst + disp]
fn AK_LOADW()   i32 { return 59; }   // ldr w(dst), [src + disp]
fn AK_STOREW()  i32 { return 60; }   // str w(src), [dst + disp]
fn AK_SXTB()    i32 { return 61; }   // sign-extend byte into x(dst)
fn AK_SXTH()    i32 { return 62; }   // sign-extend halfword into x(dst)
fn AK_DATA_ADDR() i32 { return 63; } // dst = address of target data blob + imm
fn AK_SYSCALL() i32 { return 64; }   // target syscall identified by Linux arm64 number in imm
fn AK_SYSCALL_REG() i32 { return 65; } // target raw syscall number held in src
// Call an imported Mach-O symbol through the per-image dyld pointer/stub table.
// `imm` is the import-table index. ELF backends deliberately do not lower it.
fn AK_EXTERN_CALL() i32 { return 66; }
// Darwin syscall number carried directly in imm. This is distinct from the
// target-neutral Linux-number AK_SYSCALL and from dynamic AK_SYSCALL_REG.
fn AK_DARWIN_SYSCALL() i32 { return 67; }
// ARMv8 baseline exclusive/acquire-release operations used by the native
// AtomicI64 lowering. Keeping LL/SC here avoids assuming LSE on every ARM64
// Darwin deployment.
fn AK_LDAR() i32 { return 68; }       // dst = ldar [src]
fn AK_STLR() i32 { return 69; }       // stlr src, [dst]
fn AK_LDAXR() i32 { return 70; }      // dst = ldaxr [src]
fn AK_STLXR() i32 { return 71; }      // dst=status, src=value, imm=base register
fn AK_MRS_CNTVCT() i32 { return 72; } // dst = ARM virtual monotonic counter
fn AK_MRS_CNTFRQ() i32 { return 73; } // dst = architectural counter frequency
// A source-function entry is semantically a label in every ordinary encoder.
// The macOS --hot encoder recognizes the distinct kind so it can isolate each
// replaceable function on an Apple-Silicon VM page without aligning internal
// branch labels or perturbing non-hot output.
fn AK_FN_LABEL() i32 { return 74; }
// Scalar single/double conversion and bit-transfer primitives used at the
// bounded C ABI boundary. Zag still carries f32 internally as f64 bits.
fn AK_FMOV_SW() i32 { return 75; } // fmov s(dst), w(src)
fn AK_FMOV_WS() i32 { return 76; } // fmov w(dst), s(src)
fn AK_FCVT_SD() i32 { return 77; } // fcvt s(dst), d(src)
fn AK_FCVT_DS() i32 { return 78; } // fcvt d(dst), s(src)
// Baseline Advanced SIMD operations used by the bounded i32x4 machine-control
// surface.  Apple Silicon guarantees Advanced SIMD, so these need no optional
// target-feature dispatch on arm64-macos.
fn AK_VADD_I32() i32 { return 79; } // add v(dst).4s, v(dst).4s, v(src).4s
fn AK_VSUB_I32() i32 { return 80; } // sub v(dst).4s, v(dst).4s, v(src).4s
fn AK_PREFETCH() i32 { return 81; }  // prfm pldl1keep, [x(src)]
fn AK_REV64() i32 { return 82; }     // rev x(dst), x(src)
fn AK_CLZ64() i32 { return 83; }     // clz x(dst), x(src)
fn AK_RBIT64() i32 { return 84; }    // rbit x(dst), x(src)
fn AK_BIC64() i32 { return 85; }     // bic x(dst), x(lhs), x(rhs)
fn AK_LSHR_RR() i32 { return 86; }   // lsrv dst, dst, src (logical)

// ── Advanced SIMD: the width-parameteric vector kinds ────────────────────────
// The pre-vector backend wrote `.4S` into the mnemonic of every NEON kind, which
// pinned the ISA contract to one lane count of one element width even though the
// ZIR vector IR (selfhost/vector_contract.zag) is target-independent. From here
// the arrangement is DERIVED, never spelled: a vector kind carries a packed
// operand descriptor in `AInstr.imm` holding the width class from the shared
// ladder plus the element width, and the encoder turns that pair into the A64
// `Q`/`size` field. Consequences that matter to a lowering:
//
//   * the same machine kind serves vector<i32,4>, vector<i64,2> and (once a
//     wider split exists) a 256/512-bit form — only the descriptor changes;
//   * a combination this backend cannot encode (a width class above 128 bits,
//     an element width A64 has no `size` code for) is rejected by the encoder
//     and counted, never guessed at.
// Numbers 90.. are the vector surface; 87..89 are deliberately left free so an
// unrelated scalar kind can be added without renumbering the vector ABI.
fn AK_VMUL() i32 { return 90; }      // mul v.T,vn.T,vm.T        (8B/16B/32-bit lanes)
fn AK_VSHL() i32 { return 91; }      // ushl v.T,vn.T,vm.T       (shift count in vm)
fn AK_VSHR_S() i32 { return 92; }    // sshr v.T,vn.T,#imm       (arithmetic, signed)
fn AK_VSHR_U() i32 { return 93; }    // ushr v.T,vn.T,#imm       (logical, unsigned)
fn AK_VFADD() i32 { return 94; }     // fadd v.T,vn.T,vm.T       (32/64-bit float)
fn AK_VFSUB() i32 { return 95; }     // fsub
fn AK_VFMUL() i32 { return 96; }     // fmul
fn AK_VFDIV() i32 { return 97; }     // fdiv
fn AK_VCMGT() i32 { return 98; }     // cmgt -> all-ones / all-zeros lane mask
fn AK_VCMEQ() i32 { return 99; }     // cmeq -> lane mask
fn AK_VCMGE() i32 { return 100; }    // cmge -> lane mask
fn AK_VFCMGT() i32 { return 101; }   // fcmgt -> lane mask
fn AK_VFCMEQ() i32 { return 102; }   // fcmeq -> lane mask
fn AK_VBSL() i32 { return 103; }     // bsl: dst=(src&dst)|(disp&~dst) — vector.select
fn AK_VBIT() i32 { return 104; }     // bit: dst=dst|(src&disp)
fn AK_VDUP_GPR() i32 { return 105; } // dup v.T, Rn   (splat a GPR into every lane)
fn AK_VDUP_LANE() i32 { return 106; }// dup v.T, vn.T[lane] (broadcast one element)
fn AK_VEXTRACT() i32 { return 107; } // umov Wd|Xd, vn.T[lane]
fn AK_VINSERT() i32 { return 108; }   // ins vn.T[lane], Rs
fn AK_VZERO() i32 { return 109; }    // movi v.T, #0
fn AK_VONES() i32 { return 110; }    // mvn v.16b, v.16b  (src must be a zero vector)
fn AK_VLOAD1() i32 { return 111; }   // ld1 {v.T}, [xn], xm  (element-scaled index)
fn AK_VSTORE1() i32 { return 112; }  // st1 {v.T}, [xn], xm  (element-scaled index)

// A VECTOR kind is any kind in the range above, plus the pre-existing NEON kinds
// 49..56 and 79..80 that this file already carried.  The predicate is a range
// test on purpose: adding a vector kind must not also mean editing a list.
fn AK_VEC_FIRST() i32 { return 49; }
fn AK_VEC_LAST() i32 { return 112; }
fn a_is_veclike(kind: i32) i32 {
    if (kind < AK_VEC_FIRST()) { return 0; }
    if (kind > AK_VEC_LAST()) { return 0; }
    // 57..78 and 81..89 are scalar (AK_LOADH .. AK_FCVT_DS, AK_PREFETCH ..
    // AK_LSHR_RR and the deliberately free 87..89); the vector surface is
    // 49..56, 79..80 and 90..112.
    if (kind >= 57 && kind <= 78) { return 0; }
    if (kind >= 81 && kind <= 89) { return 0; }
    return 1;
}

// ── the vector operand descriptor (AInstr.imm for every vector kind) ─────────
// One descriptor, every vector kind, so the ISA layer stays width-parameteric:
//
//   bits  0..1   width class          VW_128 / VW_256 / VW_512
//   bits  2..5   element width bytes  1, 2, 4 or 8; 0 means "not specified"
//   bits  8..15  small unsigned immediate — the LSL amount of a scaled-index
//                memory operand, or the shift count of AK_VSHR_S/AK_VSHR_U
//   bits 16..20  index register for a scaled-index memory operand, stored
//                biased by one so that an all-zero descriptor means "no index"
//
// A zero descriptor therefore means "128-bit, element width unspecified, shift 0,
// no index" — which is exactly what the pre-vector constructors passed, so every
// historical `ai_v*` call site keeps its byte-for-byte encoding.
fn av_desc(w: i32, e: i32) i64 {
    return (w as i64) + ((e as i64) * 4);
}
fn av_desc_mem(w: i32, e: i32, shift: i32, index: i32) i64 {
    let d: i64 = av_desc(w, e);
    let sh: i64 = (shift as i64) * 256;
    if (index < 0) { return d + sh; }
    return d + sh + (((index + 1) as i64) * 65536);
}
fn av_w(d: i64) i32 { return (d % 4) as i32; }
fn av_elem(d: i64) i32 { return ((d / 4) % 16) as i32; }
fn av_imm8(d: i64) i32 { return ((d / 256) % 256) as i32; }
// Index register named by the descriptor, or -1 when it names none.  -1 (not 31)
// is the in-band "absent" marker so that the zero descriptor is unambiguous.
fn av_index(d: i64) i32 {
    let f: i64 = (d / 65536) % 32;
    if (f == 0) { return 0 - 1; }
    return (f as i32) - 1;
}
// Is `e` an element width A64 has a `size` code for?  Only 1/2/4/8-byte lanes
// exist; 0 means the caller did not say, which each emitter resolves from the
// kind's own default rather than rejecting.
fn av_elem_ok(e: i32) i32 {
    if (e == 1 || e == 2 || e == 4 || e == 8) { return 1; }
    return 0;
}

// AArch64 condition codes for B.cond (imm field)
fn ACC_EQ() i32 { return 0; }
fn ACC_NE() i32 { return 1; }
fn ACC_LT() i32 { return 11; }
fn ACC_LE() i32 { return 13; }
fn ACC_GT() i32 { return 12; }
fn ACC_GE() i32 { return 10; }
// Unsigned (carry-flag) condition codes for u8/u16/u32/u64/usize comparisons.
fn ACC_HS() i32 { return 2; }   // unsigned >= (CS)
fn ACC_LO() i32 { return 3; }   // unsigned <  (CC)
fn ACC_HI() i32 { return 8; }   // unsigned >
fn ACC_LS() i32 { return 9; }   // unsigned <=

// AArch64 registers (AAPCS64)
fn A_X0()  i32 { return 0; }
fn A_X1()  i32 { return 1; }
fn A_X2()  i32 { return 2; }
fn A_X3()  i32 { return 3; }
fn A_X4()  i32 { return 4; }
fn A_X5()  i32 { return 5; }
fn A_X6()  i32 { return 6; }
fn A_X7()  i32 { return 7; }
fn A_X8()  i32 { return 8; }   // syscall number
fn A_X9()  i32 { return 9; }
fn A_X10() i32 { return 10; }
fn A_X11() i32 { return 11; }
fn A_X12() i32 { return 12; }
fn A_X13() i32 { return 13; }
fn A_X14() i32 { return 14; }
fn A_X15() i32 { return 15; }
fn A_X16() i32 { return 16; }
fn A_X17() i32 { return 17; }
fn A_X18() i32 { return 18; }
fn A_X19() i32 { return 19; }
fn A_X20() i32 { return 20; }
fn A_X21() i32 { return 21; }
fn A_X22() i32 { return 22; }
fn A_X23() i32 { return 23; }
fn A_X24() i32 { return 24; }
fn A_X25() i32 { return 25; }
fn A_X26() i32 { return 26; }
fn A_X27() i32 { return 27; }
fn A_X28() i32 { return 28; }
fn A_X29() i32 { return 29; }  // frame pointer
fn A_X30() i32 { return 30; }  // link register
fn A_SP()  i32 { return 31; }  // stack pointer (in memory operands)

// ── virtual vector registers ─────────────────────────────────────────────────
// AArch64 has ONE register file: the integer and vector register numbers are the
// same 0..31 space, `v0` IS `x0`.  That is why this file reuses the physical
// numbers above for vector kinds instead of inventing a disjoint vector
// namespace, and it is why the virtual pool below starts at 256 rather than at
// 32: the bound it must clear is the GPR file, not a vector file.
//
// Between a ZIR vector value and a physical `v` register there must still be a
// numbered class that liveness analysis, an interference graph and a future
// spill/reload path can talk about, exactly as x86 has one for xmm/ymm/zmm.
// A virtual vector register lives at A_VBASE() + i.
//
// INVARIANT: **no physical AArch64 register number is ever >= 256** (the whole
// architectural file is 0..31), so a register field read out of `AInstr.dst` /
// `.src` / `.disp` is unambiguously scalar (0..30, 31 = SP/XZR by context),
// physical vector (0..31) or virtual vector (>= 256).  A_IS_VREG() is therefore a
// total, exact test, and the encoder can never be handed a virtual number to
// place in a 5-bit register field — it must reject it instead.
//
// DELIBERATE ASYMMETRY WITH x86: the virtual pool here is bounded by the 32
// architectural Q registers (A_VREG_MAX() == 32) where x86's is bounded by 16
// xmm registers.  A64 has twice the vector register file, so the same allocator
// can hand out twice as many virtual vectors before it must split — but the
// *API* is deliberately identical so vregalloc.zag stays target-independent.
// A_IS_VREG() keeps x86's `r < 512` window for the same reason: it is the test
// the allocator calls, and widening or narrowing it per target would put that
// knowledge back into the allocator.
fn A_VBASE() i32 { return 256; }
fn A_VREG(i: i32) i32 { return 256 + i; }
fn A_IS_VREG(r: i32) i32 { return ((r >= 256) && (r < 512)) as i32; }
fn A_VREG_IDX(r: i32) i32 {
    if (A_IS_VREG(r) == 0) { return 0 - 1; }
    return r - A_VBASE();
}
fn A_VREG_MAX() i32 { return 32; }  // v0..v31, the whole architectural Q file
// Is `r` a physical (machine-encodable) register number?  Virtual vector
// registers have no encoding, so a target encoder must reject them.
fn A_IS_PHYS(r: i32) i32 { return ((r >= 0) && (r < A_VBASE())) as i32; }

fn a_arg_reg(i: i32) i32 {
    if (i == 0) { return 0; }
    if (i == 1) { return 1; }
    if (i == 2) { return 2; }
    if (i == 3) { return 3; }
    if (i == 4) { return 4; }
    if (i == 5) { return 5; }
    if (i == 6) { return 6; }
    if (i == 7) { return 7; }
    return 0 - 1;
}

fn ains6(kind: i32, dst: i32, src: i32, imm: i64, disp: i32, lbl: i32) AInstr {
    return AInstr{ .kind = kind, .dst = dst, .src = src, .imm = imm, .disp = disp, .lbl = lbl };
}
fn ai_label(id: i32)              AInstr { return ains6(0,  0,   0,   0, 0, id); }
fn ai_fn_label(id: i32)           AInstr { return ains6(74, 0,   0,   0, 0, id); }
fn ai_mov_imm(dst: i32, v: i64)   AInstr { return ains6(1,  dst, 0,   v, 0, 0 - 1); }
fn ai_mov_rr(dst: i32, src: i32)  AInstr { return ains6(2,  dst, src, 0, 0, 0 - 1); }
fn ai_add(dst: i32, src: i32)     AInstr { return ains6(3,  dst, src, 0, 0, 0 - 1); }
fn ai_sub(dst: i32, src: i32)     AInstr { return ains6(4,  dst, src, 0, 0, 0 - 1); }
fn ai_mul(dst: i32, a: i32, b: i32) AInstr { return ains6(5, dst, a, b as i64, 0, 0 - 1); }
fn ai_sdiv(dst: i32, a: i32, b: i32) AInstr { return ains6(6, dst, a, b as i64, 0, 0 - 1); }
fn ai_udiv(dst: i32, a: i32, b: i32) AInstr { return ains6(113, dst, a, b as i64, 0, 0 - 1); }
fn ai_umulh(dst: i32, a: i32, b: i32) AInstr { return ains6(118, dst, a, b as i64, 0, 0 - 1); }
fn ai_jlo(id: i32)                 AInstr { return ains6(114, 0,   0,   0, 0, id); }   // b.lo  (unsigned <)
fn ai_jhs(id: i32)                 AInstr { return ains6(115, 0,   0,   0, 0, id); }   // b.hs  (unsigned >=)
fn ai_jhi(id: i32)                 AInstr { return ains6(116, 0,   0,   0, 0, id); }   // b.hi  (unsigned >)
fn ai_jls(id: i32)                 AInstr { return ains6(117, 0,   0,   0, 0, id); }   // b.ls  (unsigned <=)
fn ai_cmp(dst: i32, src: i32)     AInstr { return ains6(7,  dst, src, 0, 0, 0 - 1); }
fn ai_cmp_imm(dst: i32, v: i64)   AInstr { return ains6(8,  dst, 0,   v, 0, 0 - 1); }
fn ai_push(r: i32)                AInstr { return ains6(9,  r,   0,   0, 0, 0 - 1); }
fn ai_pop(r: i32)                 AInstr { return ains6(10, r,   0,   0, 0, 0 - 1); }
fn ai_load(dst: i32, base: i32, disp: i32)   AInstr { return ains6(11, dst, base, 0, disp, 0 - 1); }
fn ai_store(base: i32, disp: i32, src: i32)  AInstr { return ains6(12, base, src, 0, disp, 0 - 1); }
fn ai_add_imm(dst: i32, v: i64)   AInstr { return ains6(13, dst, 0,   v, 0, 0 - 1); }
fn ai_sub_imm(dst: i32, v: i64)   AInstr { return ains6(14, dst, 0,   v, 0, 0 - 1); }
fn ai_neg(dst: i32, src: i32)     AInstr { return ains6(15, dst, src, 0, 0, 0 - 1); }
fn ai_and_imm(dst: i32, v: i64)   AInstr { return ains6(16, dst, 0,   v, 0, 0 - 1); }
fn ai_call(id: i32)               AInstr { return ains6(17, 0,   0,   0, 0, id); }
fn ai_jmp(id: i32)                AInstr { return ains6(18, 0,   0,   0, 0, id); }
fn ai_je(id: i32)                 AInstr { return ains6(19, 0,   0,   0, 0, id); }
fn ai_jne(id: i32)                AInstr { return ains6(20, 0,   0,   0, 0, id); }
fn ai_jl(id: i32)                 AInstr { return ains6(21, 0,   0,   0, 0, id); }
fn ai_jle(id: i32)                AInstr { return ains6(22, 0,   0,   0, 0, id); }
fn ai_jg(id: i32)                 AInstr { return ains6(23, 0,   0,   0, 0, id); }
fn ai_jge(id: i32)                AInstr { return ains6(24, 0,   0,   0, 0, id); }
fn ai_ret()                       AInstr { return ains6(25, 0,   0,   0, 0, 0 - 1); }
fn ai_svc()                       AInstr { return ains6(26, 0,   0,   0, 0, 0 - 1); }
fn ai_lea_lbl(dst: i32, id: i32)  AInstr { return ains6(27, dst, 0,   0, 0, id); }
fn ai_sxtw(dst: i32, src: i32)    AInstr { return ains6(28, dst, src, 0, 0, 0 - 1); }
fn ai_loadb(dst: i32, base: i32, disp: i32)  AInstr { return ains6(29, dst, base, 0, disp, 0 - 1); }
fn ai_storeb(base: i32, disp: i32, src: i32) AInstr { return ains6(30, base, src, 0, disp, 0 - 1); }
fn ai_xor(dst: i32, src: i32)     AInstr { return ains6(31, dst, src, 0, 0, 0 - 1); }
fn ai_or(dst: i32, src: i32)      AInstr { return ains6(32, dst, src, 0, 0, 0 - 1); }
fn ai_andr(dst: i32, src: i32)    AInstr { return ains6(33, dst, src, 0, 0, 0 - 1); }
fn ai_shl(dst: i32, src: i32)     AInstr { return ains6(34, dst, src, 0, 0, 0 - 1); }
fn ai_shr(dst: i32, src: i32)     AInstr { return ains6(35, dst, src, 0, 0, 0 - 1); }
fn ai_lshr(dst: i32, src: i32)    AInstr { return ains6(86, dst, src, 0, 0, 0 - 1); }
fn ai_fmov_dx(dst: i32, src: i32) AInstr { return ains6(36, dst, src, 0, 0, 0 - 1); }
fn ai_fmov_xd(dst: i32, src: i32) AInstr { return ains6(37, dst, src, 0, 0, 0 - 1); }
fn ai_fadd(dst: i32, src: i32)    AInstr { return ains6(38, dst, src, 0, 0, 0 - 1); }
fn ai_fsub(dst: i32, src: i32)    AInstr { return ains6(39, dst, src, 0, 0, 0 - 1); }
fn ai_fmul(dst: i32, src: i32)    AInstr { return ains6(40, dst, src, 0, 0, 0 - 1); }
fn ai_fdiv(dst: i32, src: i32)    AInstr { return ains6(41, dst, src, 0, 0, 0 - 1); }
fn ai_fcmp(dst: i32, src: i32)    AInstr { return ains6(42, dst, src, 0, 0, 0 - 1); }
fn ai_scvtf(dst: i32, src: i32)   AInstr { return ains6(43, dst, src, 0, 0, 0 - 1); }
fn ai_fcvtzs(dst: i32, src: i32)  AInstr { return ains6(44, dst, src, 0, 0, 0 - 1); }
fn ai_call_reg(r: i32)            AInstr { return ains6(45, r,   0,   0, 0, 0 - 1); }
fn ai_dmb()                        AInstr { return ains6(46, 0,   0,   0, 0, 0 - 1); }
fn ai_call_ext(import_idx: i32)   AInstr { return ains6(47, 0,   0,   0, 0, import_idx); }
fn ai_lsl_imm(dst: i32, src: i32, shift: i32) AInstr { return ains6(48, dst, src, shift as i64, 0, 0 - 1); }
// kinds 49..56 (AK_VLOADQ..AK_VUMOV_B) have width-parameteric constructors in the
// vector section at the end of this file.
fn ai_loadh(dst: i32, base: i32, disp: i32) AInstr { return ains6(57, dst, base, 0, disp, 0 - 1); }
fn ai_storeh(base: i32, disp: i32, src: i32) AInstr { return ains6(58, base, src, 0, disp, 0 - 1); }
fn ai_loadw(dst: i32, base: i32, disp: i32) AInstr { return ains6(59, dst, base, 0, disp, 0 - 1); }
fn ai_storew(base: i32, disp: i32, src: i32) AInstr { return ains6(60, base, src, 0, disp, 0 - 1); }
fn ai_sxtb(dst: i32, src: i32) AInstr { return ains6(61, dst, src, 0, 0, 0 - 1); }
fn ai_sxth(dst: i32, src: i32) AInstr { return ains6(62, dst, src, 0, 0, 0 - 1); }
fn ai_data_addr(dst: i32, off: i32) AInstr { return ains6(63, dst, 0, off as i64, 0, 0 - 1); }
fn ai_syscall(num: i32)             AInstr { return ains6(64, 0,   0, num as i64, 0, 0 - 1); }
fn ai_syscall_reg(src: i32)         AInstr { return ains6(65, 0, src, 0, 0, 0 - 1); }
fn ai_extern_call(index: i32)       AInstr { return ains6(66, 0, 0, index as i64, 0, 0 - 1); }
fn ai_darwin_syscall(num: i32)      AInstr { return ains6(67, 0, 0, num as i64, 0, 0 - 1); }
fn ai_ldar(dst: i32, base: i32)     AInstr { return ains6(68, dst, base, 0, 0, 0 - 1); }
fn ai_stlr(base: i32, value: i32)   AInstr { return ains6(69, base, value, 0, 0, 0 - 1); }
fn ai_ldaxr(dst: i32, base: i32)    AInstr { return ains6(70, dst, base, 0, 0, 0 - 1); }
fn ai_stlxr(status: i32, value: i32, base: i32) AInstr { return ains6(71, status, value, base as i64, 0, 0 - 1); }
fn ai_mrs_cntvct(dst: i32)          AInstr { return ains6(72, dst, 0, 0, 0, 0 - 1); }
fn ai_mrs_cntfrq(dst: i32)          AInstr { return ains6(73, dst, 0, 0, 0, 0 - 1); }
fn ai_fmov_sw(dst: i32, src: i32)   AInstr { return ains6(75, dst, src, 0, 0, 0 - 1); }
fn ai_fmov_ws(dst: i32, src: i32)   AInstr { return ains6(76, dst, src, 0, 0, 0 - 1); }
fn ai_fcvt_sd(dst: i32, src: i32)   AInstr { return ains6(77, dst, src, 0, 0, 0 - 1); }
fn ai_fcvt_ds(dst: i32, src: i32)   AInstr { return ains6(78, dst, src, 0, 0, 0 - 1); }
// kinds 79..80 (AK_VADD_I32/AK_VSUB_I32) have width-parameteric constructors in
// the vector section at the end of this file.
fn ai_prefetch(src: i32)             AInstr { return ains6(81, 0, src, 0, 0, 0 - 1); }
fn ai_rev64(dst: i32, src: i32)      AInstr { return ains6(82, dst, src, 0, 0, 0 - 1); }
fn ai_clz64(dst: i32, src: i32)      AInstr { return ains6(83, dst, src, 0, 0, 0 - 1); }
fn ai_rbit64(dst: i32, src: i32)     AInstr { return ains6(84, dst, src, 0, 0, 0 - 1); }
fn ai_bic64(dst: i32, lhs: i32, rhs: i32) AInstr { return ains6(85, dst, lhs, rhs as i64, 0, 0 - 1); }

// ── vector operand constructors ──────────────────────────────────────────────
// Two-address elementwise forms: `dst` is both the accumulator and the first
// source, `src` the second.  The `w`/`e` pair is the width class and element
// width in bytes that the encoder turns into the A64 arrangement.
fn ai_vadd(dst: i32, src: i32, w: i32, e: i32) AInstr { return ains6(79, dst, src, av_desc(w, e), 0, 0 - 1); }
fn ai_vsub(dst: i32, src: i32, w: i32, e: i32) AInstr { return ains6(80, dst, src, av_desc(w, e), 0, 0 - 1); }
// The historical two-argument forms keep their exact bytes: 32-bit lanes at
// VW_128() is `.4s`, and the logical kinds are arrangement-free in A64 so the
// honest element width for them is the whole 16-byte vector.
fn ai_vadd_i32(dst: i32, src: i32)  AInstr { return ains6(79, dst, src, av_desc(VW_128(), 4), 0, 0 - 1); }
fn ai_vsub_i32(dst: i32, src: i32)  AInstr { return ains6(80, dst, src, av_desc(VW_128(), 4), 0, 0 - 1); }
fn ai_vand_w(dst: i32, src: i32, w: i32, e: i32) AInstr { return ains6(52, dst, src, av_desc(w, e), 0, 0 - 1); }
fn ai_vorr_w(dst: i32, src: i32, w: i32, e: i32) AInstr { return ains6(53, dst, src, av_desc(w, e), 0, 0 - 1); }
fn ai_veor_w(dst: i32, src: i32, w: i32, e: i32) AInstr { return ains6(51, dst, src, av_desc(w, e), 0, 0 - 1); }
fn ai_vand(dst: i32, src: i32) AInstr { return ains6(52, dst, src, av_desc(VW_128(), 1), 0, 0 - 1); }
fn ai_vorr(dst: i32, src: i32) AInstr { return ains6(53, dst, src, av_desc(VW_128(), 1), 0, 0 - 1); }
fn ai_veor(dst: i32, src: i32) AInstr { return ains6(51, dst, src, av_desc(VW_128(), 1), 0, 0 - 1); }
fn ai_vcnt(dst: i32, src: i32) AInstr { return ains6(54, dst, src, 0, 0, 0 - 1); }
fn ai_vaddv_b(dst: i32, src: i32) AInstr { return ains6(55, dst, src, 0, 0, 0 - 1); }
fn ai_vumov_b(dst: i32, src: i32) AInstr { return ains6(56, dst, src, 0, 0, 0 - 1); }

// Width-parameteric memory forms.  `base` is an X register (A_SP() is allowed
// only when there is no index register, because the A64 register-offset forms
// have no SP base).  `disp` is a byte displacement added to the effective
// address.  The index/shift pair lives in the descriptor:
//   * LDR/STR Qt register offset, `[xn, xm, lsl #s]` — A64 defines only s = 0
//     and s = 4 for a 128-bit access, so this form serves whole-vector strides;
//   * LD1/ST1 `{v.T}, [xn], xm` — here the hardware scales the index by the
//     element width itself, which is the form an auto-vectorized `a[i]` wants,
//     and it WRITES the scaled index back into the base register.
fn ai_vloadq(dst: i32, base: i32, disp: i32) AInstr { return ains6(49, dst, base, 0, disp, 0 - 1); }
fn ai_vstoreq(base: i32, disp: i32, src: i32) AInstr { return ains6(50, base, src, 0, disp, 0 - 1); }
fn ai_vloadq_idx(dst: i32, base: i32, index: i32, shift: i32, e: i32, disp: i32) AInstr {
    return ains6(49, dst, base, av_desc_mem(VW_128(), e, shift, index), disp, 0 - 1);
}
fn ai_vstoreq_idx(base: i32, index: i32, shift: i32, e: i32, src: i32, disp: i32) AInstr {
    return ains6(50, base, src, av_desc_mem(VW_128(), e, shift, index), disp, 0 - 1);
}
fn ai_vload1(dst: i32, base: i32, index: i32, e: i32) AInstr {
    return ains6(111, dst, base, av_desc_mem(VW_128(), e, 0, index), 0, 0 - 1);
}
fn ai_vstore1(base: i32, index: i32, e: i32, src: i32) AInstr {
    return ains6(112, base, src, av_desc_mem(VW_128(), e, 0, index), 0, 0 - 1);
}

// The new width-parameteric vector kinds.  `w` is the width class, `e` the
// element width in bytes; both default to what A64 encodes for the operation
// when a caller passes 0 for the element width.
fn ai_vmul(dst: i32, src: i32, w: i32, e: i32) AInstr { return ains6(90, dst, src, av_desc(w, e), 0, 0 - 1); }
// `vector.shl`: USHL takes the shift amount from the low bits of each lane of the
// third operand.  For a non-negative count USHL and SSHL are identical, and
// USHL is the right one because the IR's shift amount is an unsigned magnitude —
// SSHL would reinterpret a negative splat as a right shift.
fn ai_vshl(dst: i32, src: i32, w: i32, e: i32) AInstr { return ains6(91, dst, src, av_desc(w, e), 0, 0 - 1); }
// `vector.shr` has no by-register form in A64 (only USHL/SSHL do), so the shift
// count is an immediate: SSHR for signed lanes (arithmetic), USHR for unsigned.
fn ai_vshr_s(dst: i32, src: i32, w: i32, e: i32, shift: i32) AInstr {
    return ains6(92, dst, src, av_desc_mem(w, e, shift, 0 - 1), 0, 0 - 1);
}
fn ai_vshr_u(dst: i32, src: i32, w: i32, e: i32, shift: i32) AInstr {
    return ains6(93, dst, src, av_desc_mem(w, e, shift, 0 - 1), 0, 0 - 1);
}
fn ai_vfadd(dst: i32, src: i32, w: i32, e: i32) AInstr { return ains6(94, dst, src, av_desc(w, e), 0, 0 - 1); }
fn ai_vfsub(dst: i32, src: i32, w: i32, e: i32) AInstr { return ains6(95, dst, src, av_desc(w, e), 0, 0 - 1); }
fn ai_vfmul(dst: i32, src: i32, w: i32, e: i32) AInstr { return ains6(96, dst, src, av_desc(w, e), 0, 0 - 1); }
fn ai_vfdiv(dst: i32, src: i32, w: i32, e: i32) AInstr { return ains6(97, dst, src, av_desc(w, e), 0, 0 - 1); }
// Compares write an all-ones/all-zeros lane mask, which is what the IR's
// `vector<i1,lanes>` result lowers to and what AK_VBSL consumes.
fn ai_vcmgt(dst: i32, src: i32, w: i32, e: i32) AInstr { return ains6(98, dst, src, av_desc(w, e), 0, 0 - 1); }
fn ai_vcmeq(dst: i32, src: i32, w: i32, e: i32) AInstr { return ains6(99, dst, src, av_desc(w, e), 0, 0 - 1); }
fn ai_vcmge(dst: i32, src: i32, w: i32, e: i32) AInstr { return ains6(100, dst, src, av_desc(w, e), 0, 0 - 1); }
fn ai_vfcmgt(dst: i32, src: i32, w: i32, e: i32) AInstr { return ains6(101, dst, src, av_desc(w, e), 0, 0 - 1); }
fn ai_vfcmeq(dst: i32, src: i32, w: i32, e: i32) AInstr { return ains6(102, dst, src, av_desc(w, e), 0, 0 - 1); }
// Three-source forms: `mask` is both the first source and the destination, `ifn`
// supplies the lanes selected where the mask is all ones, `iff` the lanes
// selected where it is all zeros.  A64 has no masked-select instruction, so BSL
// (bitwise select if true / bitwise insert if false) is the idiom.
fn ai_vbsl(mask: i32, ifn: i32, iff: i32) AInstr { return ains6(103, mask, ifn, av_desc(VW_128(), 1), iff, 0 - 1); }
fn ai_vbit(acc: i32, val: i32, mask: i32) AInstr { return ains6(104, acc, val, av_desc(VW_128(), 1), mask, 0 - 1); }
// `vector.splat`: a 64-bit element width names a 64-bit GPR source, any narrower
// width names the low 32 bits of a W register.
fn ai_vdup_gpr(dst: i32, gpr: i32, w: i32, e: i32) AInstr { return ains6(105, dst, gpr, av_desc(w, e), 0, 0 - 1); }
fn ai_vdup_lane(dst: i32, src: i32, w: i32, e: i32, lane: i32) AInstr {
    return ains6(106, dst, src, av_desc(w, e), lane, 0 - 1);
}
// `vector.extract`: umov for 32-bit and narrower lanes, mov for 64-bit.
fn ai_vextract(gpr: i32, src: i32, w: i32, e: i32, lane: i32) AInstr {
    return ains6(107, gpr, src, av_desc(w, e), lane, 0 - 1);
}
// `vector.insert`
fn ai_vinsert(dst: i32, lane: i32, gpr: i32, w: i32, e: i32) AInstr {
    return ains6(108, dst, gpr, av_desc(w, e), lane, 0 - 1);
}
fn ai_vzero(dst: i32, w: i32, e: i32) AInstr { return ains6(109, dst, 0, av_desc(w, e), 0, 0 - 1); }
// All ones has no single A64 immediate for the 32-bit and narrower arrangements,
// so it is MVN of a zero vector: the lowering must have produced the zero
// vector first (AK_VZERO), which is the standard NEON idiom.
fn ai_vones(dst: i32, src: i32, w: i32, e: i32) AInstr { return ains6(110, dst, src, av_desc(w, e), 0, 0 - 1); }
