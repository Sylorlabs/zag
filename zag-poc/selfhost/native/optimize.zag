// selfhost/native/optimize.zag — a correctness-preserving LOCAL OPTIMIZER for
// Zag's from-scratch native x86-64 backend. It removes the remaining overhead of
// the STACK MACHINE that ncodegen.zag emits: expression temporaries shuttled
// through the CPU stack (push/pop), immediates loaded into a register and then
// used register-form, and constant sub-expressions left unfolded.
//
// It runs on the flat ArrayList[Instr] (see isa.zag) AFTER regalloc and BEFORE
// peephole/encode (znc.zag wires it: regalloc → optimize → peephole → encode).
// An optimization that changes behavior is a CATASTROPHIC bug, so EVERY rewrite
// here is required to be observationally equivalent (same architectural state at
// every point control can be observed) and each carries a soundness argument.
//
// ── THE STRAIGHT-LINE RUN (the unit of analysis) ─────────────────────────────
// A "run" is a maximal sequence of instructions containing NO control-flow and
// NO call: it is broken by K_LABEL, K_CALL, K_JMP, the conditional jumps, K_RET
// and K_SYSCALL ("breakers"). Like peephole, we NEVER reason across a breaker.
// Within a run, control enters only at the top and leaves only at the bottom, so
// rewrites that preserve the run's exit state (registers + memory + the CPU
// stack pointer + any live flags) are safe. Across a breaker we reset ALL
// analysis state (constants forgotten, model stack emptied) — the conservative,
// provably-safe choice.
//
// ── OPT 1 · CONSTANT-STACK ELIMINATION + FOLDING (the big one) ────────────────
// The stack machine evaluates `a OP b` as: <push a> ; <push b> ; pop rcx ;
// pop rax ; OP rax,rcx ; push rax. Constants therefore flow THROUGH the CPU
// stack. We model the stack symbolically per run: a `push r` whose register r
// holds a KNOWN CONSTANT and whose matching `pop` lies in the SAME run (over a
// gap that touches rsp only via balanced push/pop) is DELETED, and its matching
// pop is replaced by `mov reg, const` (the constant is rematerialized — it needs
// no register and no scratch slot). This is exactly equivalent: the original
// pushed the constant to [rsp-8] and the pop read it back; rematerializing the
// same constant at the pop yields the identical register value, the push/pop
// were balanced so rsp is unchanged across the pair, and nothing in the gap
// observes the transient slot or rsp (we verify the gap is rsp-clean). A push
// whose value is NOT a known constant, or whose pop is in another run, is KEPT
// verbatim — we never juggle a live unknown value through a scratch register
// (that needs liveness we don't have here), so correctness never depends on it.
//
// Once constants are rematerialized at their pops, a register-tracking forward
// pass FOLDS `OP rax,rcx` with both operands constant into `mov rax, <folded>`
// (wrapping i64, matching x86), and an `OP rax,rcx` with only the SOURCE
// constant into the immediate form (add/sub → add_imm/sub_imm; cmp → cmp_imm) —
// removing the dependency on the source register. Folding a flag-setting op into
// a mov is only done when the op's output FLAGS ARE DEAD (no consumer before
// they are overwritten or the run ends into a non-conditional breaker); the
// flag-live case (a cmp feeding a branch/setcc) is left untouched.
//
// ── OPT 2 · DEAD pure-register-write ELIMINATION (cleanup) ───────────────────
// Folding/immediate-selection leaves behind register writes (the rematerialized
// `mov rcx, c`, the now-unread operand loads) that are dead. A backward,
// run-scoped liveness pass removes a `mov_imm`/`mov_rr` whose destination is
// provably dead (overwritten later in the run before any read). Live-OUT of a
// run is assumed to be ALL registers (conservative — we can only remove a write
// killed WITHIN its run), and any instruction we don't model as a pure register
// write is treated as reading every register (so we never remove a value it
// might consume). Only flag-free, memory-free pure writes (mov_imm/mov_rr) are
// ever removed, so flags and memory are never disturbed.
//
// ── SOUNDNESS OF THE STACK MODEL (why the LIFO matching is exact) ─────────────
// A pre-scan pairs each `push` with its matching `pop` using a run-scoped index
// stack (push → record index; pop → pop the index, recording the pair; cleared
// at each breaker). The forward pass maintains a model stack in LOCKSTEP (a push
// → one model entry; a pop → consume one entry iff non-empty; cleared at each
// breaker), so its depth equals the pre-scan's at every point and the entry a
// pop consumes is exactly the push the pre-scan paired. We only DELETE a push
// when the pre-scan paired it inside the run, so every CONST model entry is
// consumed by its pop before the run ends — never stranded across a breaker
// (where the real CPU stack must be intact). Kept (unknown) pushes stay real on
// the stack and are popped, in later runs, as ordinary "external" pops.
//
// LANGUAGE SUBSET: stmts end ';'. No `<<`/`>>`, no `|`/`||`/`^` (we fold only
// +,-,* — never bitwise, so the operators we need are exactly +,-,*,&,%,/, and
// comparisons). No break/continue (flag-guarded while / single-step loops).
// Deref a pointer field as `p.*.field`. switch only for unions — here plain if.

@import("isa.zag")

// ── run-breaker / classification helpers ─────────────────────────────────────

// A "breaker" ends a straight-line run: any control transfer or call, plus the
// position-marker label (control can ARRIVE at a label).
fn opt_is_breaker(k: i32) i32 {
    if (k == K_LABEL())   { return 1; }
    if (k == K_CALL())    { return 1; }
    if (k == K_JMP())     { return 1; }
    if (k == K_JE())      { return 1; }
    if (k == K_JNE())     { return 1; }
    if (k == K_JL())      { return 1; }
    if (k == K_JLE())     { return 1; }
    if (k == K_JG())      { return 1; }
    if (k == K_JGE())     { return 1; }
    if (k == K_RET())     { return 1; }
    if (k == K_SYSCALL()) { return 1; }
    return 0;
}

// A conditional jump READS the flags set by the run it terminates, so when a run
// ends in one its trailing flags are LIVE-OUT (we must not fold the cmp away).
fn opt_is_jcc(k: i32) i32 {
    if (k == K_JE())  { return 1; }
    if (k == K_JNE()) { return 1; }
    if (k == K_JL())  { return 1; }
    if (k == K_JLE()) { return 1; }
    if (k == K_JG())  { return 1; }
    if (k == K_JGE()) { return 1; }
    return 0;
}

// Does this instruction DEFINE the EFLAGS used by setcc/Jcc? (mov/lea/load/
// store/push/pop/mov_imm do NOT.)
fn opt_writes_flags(k: i32) i32 {
    if (k == K_ADD_RR())  { return 1; }
    if (k == K_SUB_RR())  { return 1; }
    if (k == K_IMUL_RR()) { return 1; }
    if (k == K_CMP_RR())  { return 1; }
    if (k == K_AND_RR())  { return 1; }
    if (k == K_OR_RR())   { return 1; }
    if (k == K_XOR_RR())  { return 1; }
    if (k == K_ADD_RI())  { return 1; }
    if (k == K_SUB_RI())  { return 1; }
    if (k == K_CMP_RI())  { return 1; }
    if (k == K_NEG())     { return 1; }
    if (k == K_IDIV())    { return 1; }
    if (k == K_FUCOMI())  { return 1; }
    return 0;
}

// Does this instruction READ the flags? Within a run only K_SETCC does (the Jcc
// readers are breakers, handled via the run's live-out).
fn opt_reads_flags(k: i32) i32 {
    if (k == K_SETCC()) { return 1; }
    return 0;
}

// int32 range test — the immediate forms (add_imm/sub_imm/cmp_imm encode a
// sign-extended imm32, so the constant must fit a signed 32-bit field).
fn opt_fits32(v: i64) i32 {
    let lo: i64 = 0 - 2147483648;
    let hi: i64 = 2147483647;
    if (v < lo) { return 0; }
    if (v > hi) { return 0; }
    return 1;
}

// Wrapping i64 fold for the three foldable binary ops (host +,-,* compile to the
// same x86-64 add/sub/imul, so wrapping matches the hardware exactly).
fn opt_fold(k: i32, a: i64, b: i64) i64 {
    if (k == K_ADD_RR())  { return a + b; }
    if (k == K_SUB_RR())  { return a - b; }
    if (k == K_IMUL_RR()) { return a * b; }
    return 0;
}

// ── 16-entry register-state arrays (indexed by hardware register number) ─────
fn opt_mk16i32() ArrayList[i32] {
    let a: ArrayList[i32] = make[i32](16);
    let i: i32 = 0;
    while (i < 16) { push[i32](&a, 0); i = i + 1; }
    return a;
}
fn opt_mk16i64() ArrayList[i64] {
    let a: ArrayList[i64] = make[i64](16);
    let i: i32 = 0;
    while (i < 16) { push[i64](&a, 0); i = i + 1; }
    return a;
}
fn opt_reset16(known: *ArrayList[i32]) void {
    let i: i32 = 0;
    while (i < 16) { set[i32](known, i, 0); i = i + 1; }
}

// Reset pass-local stacks in place. Replacing these lists at every breaker used
// to retain one allocation per label/call in large input programs.
fn opt_clear_i32(xs: *ArrayList[i32]) void { xs.*.len = 0; }
fn opt_clear_i64(xs: *ArrayList[i64]) void { xs.*.len = 0; }

// ── gap rsp-cleanliness ──────────────────────────────────────────────────────
// A const push at index `p` with matching pop at index `q` (p < q, same run) is
// only deletable if NOTHING in the open gap (p,q) touches rsp except balanced
// push/pop. Deleting the pair leaves rsp 8 higher across the gap; the ONLY
// instructions sensitive to the absolute rsp are push/pop (modeled consistently
// — every kept pair shifts by the same 8 and stays balanced) and any rsp-operand
// instruction. ncodegen never emits an rsp-relative load/store/lea in a body and
// only writes rsp via push/pop (and `add rsp,N` to reclaim call args, which sits
// in a post-call run, never inside an expression gap), so this nearly always
// holds; when it does not we simply keep the push. We reject the gap if any
// non-push/pop instruction names rsp (reg 4) in dst or src (covers mov rsp,
// add/sub rsp, and rsp-base load/store/lea since the base lives in dst/src), or
// if a breaker somehow appears (it never should inside a matched in-run pair).
fn opt_gap_clean(prog: ArrayList[Instr], p: i32, q: i32) i32 {
    let i: i32 = p + 1;
    while (i < q) {
        let ins: Instr = get[Instr](prog, i);
        let k: i32 = ins.kind;
        if (opt_is_breaker(k) == 1) { return 0; }
        if (k != K_PUSH() && k != K_POP()) {
            if (ins.dst == R_RSP()) { return 0; }
            if (ins.src == R_RSP()) { return 0; }
        }
        i = i + 1;
    }
    return 1;
}

// ── PRE-SCAN: pair pushes↔pops (run-scoped LIFO), record matched + pop index ──
// matched[i]==1  ⟺  prog[i] is a push whose matching pop is in the same run.
// pop_of[i]      =  that pop's index (or -1).
fn opt_prescan_matched(prog: ArrayList[Instr], n: i32, matched: *ArrayList[i32], pop_of: *ArrayList[i32]) void {
    let stk: ArrayList[i32] = make[i32](16);   // indices of open pushes
    let i: i32 = 0;
    while (i < n) {
        let k: i32 = get[Instr](prog, i).kind;
        if (opt_is_breaker(k) == 1) {
            opt_clear_i32(&stk);                // reuse storage at run boundary
        } else {
            if (k == K_PUSH()) {
                push[i32](&stk, i);
            } else {
                if (k == K_POP()) {
                    if (len[i32](stk) > 0) {
                        let j: i32 = pop[i32](&stk);
                        set[i32](matched, j, 1);
                        set[i32](pop_of, j, i);
                    }
                }
            }
        }
        i = i + 1;
    }
    free[i32](&stk);
}

// ── PRE-SCAN: backward flag liveness → flags_dead[i] for flag-writers ─────────
// flags_dead[i]==1  ⟺  the EFLAGS that instruction i defines are never read
// before being overwritten or the run ending into a non-conditional breaker.
// We sweep the whole program backward; at each breaker we set the live-out of
// the run that PRECEDES it (1 iff that breaker is a conditional jump).
fn opt_prescan_flags(prog: ArrayList[Instr], n: i32, flags_dead: *ArrayList[i32]) void {
    let live: i32 = 0;                          // flags live AFTER current position
    let i: i32 = n - 1;
    while (i >= 0) {
        let k: i32 = get[Instr](prog, i).kind;
        if (opt_is_breaker(k) == 1) {
            // This breaker determines the flag live-out of the preceding run.
            if (opt_is_jcc(k) == 1) { live = 1; } else { live = 0; }
        } else {
            let w: i32 = opt_writes_flags(k);
            let r: i32 = opt_reads_flags(k);
            if (w == 1) {
                if (live == 0) { set[i32](flags_dead, i, 1); }
            }
            // live-in of i (= live-out of i-1): a reader makes flags live; a pure
            // writer kills upward liveness; anything else leaves it unchanged.
            if (r == 1) { live = 1; }
            else { if (w == 1) { live = 0; } }
        }
        i = i - 1;
    }
}

// ── invalidate the constant-knowledge an OPAQUE instruction destroys ─────────
// For instructions the forward pass does not interpret, we forget the constant
// value of every GPR they may write. Kinds whose GPR write-set we know exactly
// invalidate just those; SSE ops that write only an xmm (separate register file)
// invalidate nothing; any kind we do not recognize invalidates ALL registers
// (the safe default — we never keep a stale constant).
fn opt_invalidate(known: *ArrayList[i32], ins: Instr) void {
    let k: i32 = ins.kind;
    if (k == K_LOAD())     { set[i32](known, ins.dst, 0); return; }
    if (k == K_LEA())      { set[i32](known, ins.dst, 0); return; }
    if (k == K_NEG())      { set[i32](known, ins.dst, 0); return; }
    if (k == K_SETCC())    { set[i32](known, ins.dst, 0); return; }
    if (k == K_STORE())    { return; }                 // writes memory only
    if (k == K_IDIV())     { set[i32](known, R_RAX(), 0); set[i32](known, R_RDX(), 0); return; }
    if (k == K_FMOVQ_XG()) { set[i32](known, ins.dst, 0); return; }   // gpr ← xmm bits
    if (k == K_FTSD2SI())  { set[i32](known, ins.dst, 0); return; }   // gpr ← (i64)xmm
    if (k == K_FMOVQ_GX()) { return; }                 // xmm ← gpr (no gpr write)
    if (k == K_FADD())     { return; }
    if (k == K_FSUB())     { return; }
    if (k == K_FMUL())     { return; }
    if (k == K_FDIV())     { return; }
    if (k == K_FUCOMI())   { return; }
    if (k == K_FSI2SD())   { return; }                 // xmm ← gpr
    if (k == K_FSD2SS())   { return; }
    if (k == K_FSS2SD())   { return; }
    if (k == K_FXORPS())   { return; }
    // Unknown kind: forget everything (safe default).
    opt_reset16(known);
}

// ── does instruction `ins` READ register r? (GPR read-set, conservative) ─────
// Used only to GATE immediate-form selection (a decision that is semantics-
// neutral either way), so an over-approximation merely makes us miss an
// optimization — never miscompile. Unknown kinds are treated as reading r.
fn opt_reads_reg(ins: Instr, r: i32) i32 {
    let k: i32 = ins.kind;
    let d: i32 = ins.dst;
    let s: i32 = ins.src;
    if (k == K_MOV_RR())  { if (s == r) { return 1; } return 0; }
    if (k == K_ADD_RR() || k == K_SUB_RR() || k == K_IMUL_RR() ||
        k == K_AND_RR() || k == K_OR_RR()  || k == K_XOR_RR() || k == K_CMP_RR()) {
        if (d == r) { return 1; } if (s == r) { return 1; } return 0;
    }
    if (k == K_ADD_RI() || k == K_SUB_RI() || k == K_CMP_RI() || k == K_NEG()) {
        if (d == r) { return 1; } return 0;
    }
    if (k == K_PUSH())  { if (d == r) { return 1; } return 0; }
    if (k == K_STORE()) { if (d == r) { return 1; } if (s == r) { return 1; } return 0; }
    if (k == K_LOAD())  { if (s == r) { return 1; } return 0; }
    if (k == K_LEA())   { if (s == r) { return 1; } return 0; }
    // SIB forms: LOAD_SIB dst,[src+lbl*s] reads base+index; STORE_SIB
    // [dst+lbl*s],src reads base+index+val; ADD_SIB dst,[src+lbl*s] reads all.
    if (k == K_LOAD_SIB())  { if (s == r) { return 1; } if (ins.lbl == r) { return 1; } return 0; }
    if (k == K_STORE_SIB()) { if (d == r) { return 1; } if (s == r) { return 1; } if (ins.lbl == r) { return 1; } return 0; }
    if (k == K_ADD_SIB())   { if (d == r) { return 1; } if (s == r) { return 1; } if (ins.lbl == r) { return 1; } return 0; }
    if (k == K_IDIV())  { if (r == R_RAX()) { return 1; } if (r == R_RDX()) { return 1; } if (s == r) { return 1; } return 0; }
    if (k == K_FMOVQ_GX()) { if (s == r) { return 1; } return 0; }
    if (k == K_FSI2SD())   { if (s == r) { return 1; } return 0; }
    if (k == K_MOV_IMM())  { return 0; }
    if (k == K_POP())      { return 0; }
    if (k == K_SETCC())    { return 0; }
    if (k == K_FMOVQ_XG()) { return 0; }
    if (k == K_FTSD2SI())  { return 0; }
    if (k == K_FADD())   { return 0; }
    if (k == K_FSUB())   { return 0; }
    if (k == K_FMUL())   { return 0; }
    if (k == K_FDIV())   { return 0; }
    if (k == K_FUCOMI()) { return 0; }
    if (k == K_FSD2SS()) { return 0; }
    if (k == K_FSS2SD()) { return 0; }
    if (k == K_FXORPS()) { return 0; }
    // control flow and labels read no GPR (jcc reads EFLAGS only)
    if (k == K_LABEL() || k == K_JMP() || k == K_JE() || k == K_JNE() ||
        k == K_JL() || k == K_JLE() || k == K_JG() || k == K_JGE()) {
        return 0;
    }
    return 1;   // unknown → assume it reads r (gate stays off — safe)
}

// ── does instruction `ins` OVERWRITE register r without reading it first? ─────
// (Used only for the immediate-form gate.) A clean kill makes r's prior value
// (the constant we would have loaded) dead — so the load becomes removable.
fn opt_writes_reg(ins: Instr, r: i32) i32 {
    let k: i32 = ins.kind;
    let d: i32 = ins.dst;
    if (k == K_MOV_IMM() || k == K_MOV_RR() || k == K_POP() ||
        k == K_LOAD()    || k == K_LEA()    || k == K_SETCC() ||
        k == K_FMOVQ_XG()|| k == K_FTSD2SI()) {
        if (d == r) { return 1; } return 0;
    }
    if (k == K_IDIV()) { if (r == R_RAX()) { return 1; } if (r == R_RDX()) { return 1; } return 0; }
    if (k == K_LOAD_SIB() || k == K_ADD_SIB()) { if (d == r) { return 1; } return 0; }
    return 0;
}

// ── could instruction `ins` WRITE register R? (CONSERVATIVE over-approx) ──────
// Used to prove a copy source survives a push→pop gap unchanged: if this ever
// answers 1 for any instruction in the gap, we DO NOT remat (we keep the push).
// Unknown kinds and breakers answer 1 (assume they clobber R) — safe.
fn opt_reg_written(ins: Instr, R: i32) i32 {
    let k: i32 = ins.kind;
    if (k == K_MOV_IMM() || k == K_MOV_RR() || k == K_ADD_RR() || k == K_SUB_RR() ||
        k == K_IMUL_RR() || k == K_AND_RR() || k == K_OR_RR()  || k == K_XOR_RR() ||
        k == K_ADD_RI()  || k == K_SUB_RI() || k == K_POP()    || k == K_LOAD()   ||
        k == K_LEA()     || k == K_NEG()    || k == K_SETCC()  || k == K_FMOVQ_XG()||
        k == K_FTSD2SI()) {
        if (ins.dst == R) { return 1; } return 0;
    }
    if (k == K_IDIV()) { if (R == R_RAX()) { return 1; } if (R == R_RDX()) { return 1; } return 0; }
    // pure flag/memory/xmm writers (cmp, cmp_ri, push, store, ucomisd, fadd…) and
    // gpr→xmm moves write no GPR.
    if (k == K_CMP_RR() || k == K_CMP_RI() || k == K_PUSH() || k == K_STORE() ||
        k == K_FUCOMI() || k == K_FMOVQ_GX() || k == K_FSI2SD() || k == K_FADD() ||
        k == K_FSUB()   || k == K_FMUL()   || k == K_FDIV()   || k == K_FSD2SS() ||
        k == K_FSS2SD() || k == K_FXORPS()) {
        return 0;
    }
    return 1;   // breaker / unknown → assume it writes R (safe: blocks the remat)
}

// Is register R possibly written anywhere in the OPEN gap (p, q)?
fn opt_reg_written_in(prog: ArrayList[Instr], p: i32, q: i32, R: i32) i32 {
    let i: i32 = p + 1;
    while (i < q) {
        if (opt_reg_written(get[Instr](prog, i), R) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

// ── will the source register's constant-load be REMOVABLE after immediate form?
// We only convert `op dst, src` (src a known const) to its immediate form when
// the freed `src` register is OVERWRITTEN before any read AND before the run's
// next breaker — i.e. the constant load that fed it is dead and the run-scoped
// DCE will delete it. Otherwise the immediate form would strand a now-dead (and,
// near a call/branch, un-removable) `mov src, c`, GROWING the code; in that case
// we keep the register form (where that same load is still used) — no regression.
fn opt_src_killed_in_run(prog: ArrayList[Instr], op: i32, src: i32, n: i32) i32 {
    let i: i32 = op + 1;
    let res: i32 = 0;
    let going: i32 = 1;
    while (going == 1 && i < n) {
        let ins: Instr = get[Instr](prog, i);
        if (opt_is_breaker(ins.kind) == 1) { going = 0; }
        else {
            if (opt_reads_reg(ins, src) == 1) { going = 0; }                    // still needed
            else { if (opt_writes_reg(ins, src) == 1) { res = 1; going = 0; } } // killed → removable
        }
        i = i + 1;
    }
    return res;
}

// ── THE FORWARD PASS: stack elimination + constant folding + immediate form ──
fn opt_fold_pass(prog: ArrayList[Instr]) ArrayList[Instr] {
    let n: i32 = len[Instr](prog);
    let out: ArrayList[Instr] = make[Instr](n + 16);

    // pre-computed analyses
    let matched: ArrayList[i32] = make[i32](n + 1);
    let pop_of:  ArrayList[i32] = make[i32](n + 1);
    let flagsd:  ArrayList[i32] = make[i32](n + 1);
    let z: i32 = 0;
    while (z < n) { push[i32](&matched, 0); push[i32](&pop_of, 0 - 1); push[i32](&flagsd, 0); z = z + 1; }
    opt_prescan_matched(prog, n, &matched, &pop_of);
    opt_prescan_flags(prog, n, &flagsd);

    // forward register/stack state
    let known: ArrayList[i32] = opt_mk16i32();   // 1 ⟺ cval[r] is a known const
    let cval:  ArrayList[i64] = opt_mk16i64();   // the known constant
    let ms_tag: ArrayList[i32] = make[i32](16);  // model stack: 1=CONST, 0=KEEP
    let ms_val: ArrayList[i64] = make[i64](16);

    let i: i32 = 0;
    while (i < n) {
        let ins: Instr = get[Instr](prog, i);
        let k: i32 = ins.kind;

        if (opt_is_breaker(k) == 1) {
            // Cross a run boundary: emit verbatim, forget all constants, empty
            // the model stack (any leftover entries are KEEP pushes whose real
            // value still sits on the CPU stack for a later run to pop).
            push[Instr](&out, ins);
            opt_reset16(&known);
            opt_clear_i32(&ms_tag);
            opt_clear_i64(&ms_val);

        } else { if (k == K_PUSH()) {
            let r: i32 = ins.dst;
            let done: i32 = 0;
            // (1) CONSTANT rematerialization: r holds a known constant and its pop
            //     is in-run over an rsp-clean gap → delete, remat the pop as mov_imm.
            if (done == 0 && get[i32](matched, i) == 1 && get[i32](known, r) == 1) {
                if (opt_gap_clean(prog, i, get[i32](pop_of, i)) == 1) {
                    push[i32](&ms_tag, 1);
                    push[i64](&ms_val, get[i64](cval, r));
                    done = 1;
                }
            }
            // (2) REGISTER-COPY rematerialization: the push is fed by an adjacent
            //     `mov r, R` and R survives the whole (rsp-clean) gap unwritten →
            //     delete, remat the pop as `mov rY, R` (and the feeding mov dies in
            //     DCE). Equivalent: the pushed value was exactly R's value, R is
            //     unchanged at the pop, so reloading rY from R reproduces it.
            if (done == 0 && get[i32](matched, i) == 1 && i > 0) {
                let prev: Instr = get[Instr](prog, i - 1);
                if (prev.kind == K_MOV_RR() && prev.dst == r && prev.src != R_RSP()) {
                    let q: i32 = get[i32](pop_of, i);
                    if (opt_gap_clean(prog, i, q) == 1 && opt_reg_written_in(prog, i, q, prev.src) == 0) {
                        push[i32](&ms_tag, 2);
                        push[i64](&ms_val, prev.src as i64);
                        done = 1;
                    }
                }
            }
            // (3) LIVE-VALUE rematerialization: r is provably UNWRITTEN across the
            //     whole (rsp-clean) in-run gap, so at the matching pop r still
            //     holds exactly the pushed value → delete the push and remat the
            //     pop as `mov rY, r` (nothing at all when rY==r). The transient
            //     stack slot is unobservable (gap is rsp-clean), so this is the
            //     same read a load would produce — with no memory round-trip.
            if (done == 0 && get[i32](matched, i) == 1 && r != R_RSP()) {
                let q3: i32 = get[i32](pop_of, i);
                if (opt_gap_clean(prog, i, q3) == 1 && opt_reg_written_in(prog, i, q3, r) == 0) {
                    push[i32](&ms_tag, 3);
                    push[i64](&ms_val, r as i64);
                    done = 1;
                }
            }
            // (4) KEEP: emit the real push, record a placeholder model entry.
            if (done == 0) {
                push[i32](&ms_tag, 0);
                push[i64](&ms_val, 0);
                push[Instr](&out, ins);
            }

        } else { if (k == K_POP()) {
            let r: i32 = ins.dst;
            if (len[i32](ms_tag) > 0) {
                let tag: i32 = pop[i32](&ms_tag);
                let v:   i64 = pop[i64](&ms_val);
                if (tag == 1) {
                    // matching push was a deleted constant — rematerialize it.
                    push[Instr](&out, i_mov_imm(r, v));
                    set[i32](&known, r, 1);
                    set[i64](&cval, r, v);
                } else { if (tag == 2) {
                    // matching push was a deleted register copy — reload from R.
                    push[Instr](&out, i_mov_rr(r, v as i32));
                    set[i32](&known, r, 0);
                } else { if (tag == 3) {
                    // matching push was a deleted live value — re-copy from the
                    // still-live register (a `pop r; ...` into the same register
                    // collapses to nothing).
                    if (v as i32 != r) { push[Instr](&out, i_mov_rr(r, v as i32)); }
                    set[i32](&known, r, 0);
                } else {
                    push[Instr](&out, ins);
                    set[i32](&known, r, 0);
                } } }
            } else {
                // external pop (matches a push from before this run) — keep it.
                push[Instr](&out, ins);
                set[i32](&known, r, 0);
            }

        } else { if (k == K_ADD_RR() || k == K_SUB_RR() || k == K_IMUL_RR()) {
            let d: i32 = ins.dst;
            let s: i32 = ins.src;
            let dk: i32 = get[i32](known, d);
            let sk: i32 = get[i32](known, s);
            if (dk == 1 && sk == 1 && get[i32](flagsd, i) == 1) {
                // both operands constant, output flags dead → fold to a mov.
                let fv: i64 = opt_fold(k, get[i64](cval, d), get[i64](cval, s));
                push[Instr](&out, i_mov_imm(d, fv));
                set[i32](&known, d, 1);
                set[i64](&cval, d, fv);
            } else { if (sk == 1 && (k == K_ADD_RR() || k == K_SUB_RR()) && opt_fits32(get[i64](cval, s)) == 1 && opt_src_killed_in_run(prog, i, s, n) == 1) {
                // source constant AND its load is dead afterwards → immediate form
                // (drops the source-register dependency; the load is DCE'd). Gated
                // so it never strands a non-removable mov (no byte regression).
                if (k == K_ADD_RR()) { push[Instr](&out, i_add_imm(d, get[i64](cval, s))); }
                else                 { push[Instr](&out, i_sub_imm(d, get[i64](cval, s))); }
                set[i32](&known, d, 0);
            } else {
                push[Instr](&out, ins);
                set[i32](&known, d, 0);
            } }

        } else { if (k == K_AND_RR() || k == K_OR_RR() || k == K_XOR_RR()) {
            // not folded (we avoid bitwise folds); just track the dst as unknown.
            push[Instr](&out, ins);
            set[i32](&known, ins.dst, 0);

        } else { if (k == K_CMP_RR()) {
            let d2: i32 = ins.dst;
            let s2: i32 = ins.src;
            if (get[i32](known, s2) == 1 && opt_fits32(get[i64](cval, s2)) == 1 && opt_src_killed_in_run(prog, i, s2, n) == 1) {
                // immediate compare — identical flags, frees the source register;
                // gated so the freed source's load is provably removable.
                push[Instr](&out, i_cmp_imm(d2, get[i64](cval, s2)));
            } else {
                push[Instr](&out, ins);
            }
            // cmp writes no register; constant state unchanged.

        } else { if (k == K_MOV_IMM()) {
            push[Instr](&out, ins);
            set[i32](&known, ins.dst, 1);
            set[i64](&cval, ins.dst, ins.imm);

        } else { if (k == K_MOV_RR()) {
            // emit verbatim, but PROPAGATE the source's known-ness so downstream
            // folds can fire (the mov itself becomes dead and is dropped by DCE).
            push[Instr](&out, ins);
            if (get[i32](known, ins.src) == 1) {
                set[i32](&known, ins.dst, 1);
                set[i64](&cval, ins.dst, get[i64](cval, ins.src));
            } else {
                set[i32](&known, ins.dst, 0);
            }

        } else { if (k == K_ADD_RI() || k == K_SUB_RI()) {
            let d3: i32 = ins.dst;
            if (get[i32](known, d3) == 1 && get[i32](flagsd, i) == 1) {
                let nv: i64 = get[i64](cval, d3);
                if (k == K_ADD_RI()) { nv = nv + ins.imm; } else { nv = nv - ins.imm; }
                push[Instr](&out, i_mov_imm(d3, nv));
                set[i32](&known, d3, 1);
                set[i64](&cval, d3, nv);
            } else {
                push[Instr](&out, ins);
                set[i32](&known, d3, 0);
            }

        } else {
            // OPAQUE (load/store/lea/idiv/setcc/neg/SSE/...): emit verbatim and
            // forget the constants it may clobber.
            push[Instr](&out, ins);
            opt_invalidate(&known, ins);
        } } } } } } } } }

        i = i + 1;
    }

    free[i32](&matched);
    free[i32](&pop_of);
    free[i32](&flagsd);
    free[i32](&known);
    free[i64](&cval);
    free[i32](&ms_tag);
    free[i64](&ms_val);
    return out;
}

// ── BACKWARD DCE: drop dead pure-register writes (run-scoped) ─────────────────
// Removes a `mov_imm`/`mov_rr` whose destination register is dead — overwritten
// later in the run before any read. Live-out of a run is ALL registers
// (conservative). Any instruction not modeled as a pure register write is
// treated as reading all registers (so nothing it might consume is removed). We
// only ever remove flag-free, memory-free moves, so flags and memory are intact.
fn opt_dce(prog: ArrayList[Instr]) ArrayList[Instr] {
    let n: i32 = len[Instr](prog);
    let keep: ArrayList[i32] = make[i32](n + 1);
    let live: ArrayList[i32] = opt_mk16i32();
    let z: i32 = 0;
    while (z < n) { push[i32](&keep, 1); z = z + 1; }

    // assume every register live at end of program
    let r0: i32 = 0;
    while (r0 < 16) { set[i32](&live, r0, 1); r0 = r0 + 1; }

    let i: i32 = n - 1;
    while (i >= 0) {
        let ins: Instr = get[Instr](prog, i);
        let k: i32 = ins.kind;

        if (opt_is_breaker(k) == 1) {
            // run boundary → conservative live-out (all registers live)
            let rr: i32 = 0;
            while (rr < 16) { set[i32](&live, rr, 1); rr = rr + 1; }
        } else { if (k == K_MOV_IMM() || k == K_MOV_RR() || k == K_SETCC()) {
            let d: i32 = ins.dst;
            if (get[i32](live, d) == 0) {
                set[i32](&keep, i, 0);             // dead pure write → remove
                // (a setcc reads only flags — never a GPR — so a dead one is
                //  always removable; after cc-fusion the materialized boolean
                //  is usually dead and this drops the leftover setcc.)
            } else {
                // kept: kill dst, then mark source(s) read
                set[i32](&live, d, 0);
                if (k == K_MOV_RR()) { set[i32](&live, ins.src, 1); }
            }
        } else {
            // any other kept instruction: apply its GPR read/write liveness
            opt_dce_liveness(&live, ins);
        } }

        i = i - 1;
    }

    let out: ArrayList[Instr] = make[Instr](n + 1);
    let j: i32 = 0;
    while (j < n) {
        if (get[i32](keep, j) == 1) { push[Instr](&out, get[Instr](prog, j)); }
        j = j + 1;
    }
    free[i32](&keep);
    free[i32](&live);
    return out;
}

// Update register liveness for a KEPT, non-mov instruction (write-set killed
// first, then read-set made live; reg both read & written stays live). Unknown
// kinds are treated as reading every register (safe over-approximation).
fn opt_dce_liveness(live: *ArrayList[i32], ins: Instr) void {
    let k: i32 = ins.kind;
    let d: i32 = ins.dst;
    let s: i32 = ins.src;
    if (k == K_ADD_RR() || k == K_SUB_RR() || k == K_IMUL_RR() ||
        k == K_AND_RR() || k == K_OR_RR()  || k == K_XOR_RR()) {
        set[i32](live, d, 0); set[i32](live, d, 1); set[i32](live, s, 1); return;
    }
    if (k == K_CMP_RR())  { set[i32](live, d, 1); set[i32](live, s, 1); return; }
    if (k == K_ADD_RI() || k == K_SUB_RI()) { set[i32](live, d, 1); return; }   // reads+writes d
    if (k == K_CMP_RI())  { set[i32](live, d, 1); return; }
    if (k == K_PUSH())    { set[i32](live, d, 1); return; }                     // reads d
    if (k == K_POP())     { set[i32](live, d, 0); return; }                     // writes d
    if (k == K_LOAD())    { set[i32](live, d, 0); set[i32](live, s, 1); return; }
    if (k == K_STORE())   { set[i32](live, d, 1); set[i32](live, s, 1); return; }
    if (k == K_LEA())     { set[i32](live, d, 0); set[i32](live, s, 1); return; }
    if (k == K_NEG())     { set[i32](live, d, 1); return; }                     // reads+writes d
    if (k == K_SETCC())   { set[i32](live, d, 0); return; }                     // writes d (reads flags)
    if (k == K_IDIV())    { set[i32](live, R_RAX(), 1); set[i32](live, R_RDX(), 1); set[i32](live, s, 1); return; }
    if (k == K_FMOVQ_GX()) { set[i32](live, s, 1); return; }                    // reads gpr src
    if (k == K_FMOVQ_XG()) { set[i32](live, d, 0); return; }                    // writes gpr dst
    if (k == K_FSI2SD())  { set[i32](live, s, 1); return; }                     // reads gpr src
    if (k == K_FTSD2SI()) { set[i32](live, d, 0); return; }                     // writes gpr dst
    if (k == K_FADD())   { return; }
    if (k == K_FSUB())   { return; }
    if (k == K_FMUL())   { return; }
    if (k == K_FDIV())   { return; }
    if (k == K_FUCOMI()) { return; }
    if (k == K_FSD2SS()) { return; }
    if (k == K_FSS2SD()) { return; }
    if (k == K_FXORPS()) { return; }
    // Unknown kind: assume it reads every register (keep everything live).
    let r: i32 = 0;
    while (r < 16) { set[i32](live, r, 1); r = r + 1; }
}

// ── OPT 3 · setcc/cmp0/Jcc FUSION ────────────────────────────────────────────
// ncodegen materializes every comparison as a boolean register: `cmp a,b ;
// setcc r ; <uses optional> ; cmp r,0 ; je/jne L`. The cmp0+Jcc re-decode the
// boolean the setcc already computed from the ORIGINAL cmp's flags. When (a)
// the Jcc's flag-writer is exactly `cmp r,0`, (b) walking back over
// flag-preserving instructions finds `setcc r`, (c) r is unwritten between the
// setcc and the cmp0, and (d) no other flag-writer sits between the setcc and
// the Jcc, then the Jcc can test the original flags directly: JE jumps when
// the boolean was 0 → jump on the INVERTED cc; JNE jumps on the cc itself.
// The `cmp r,0` is deleted; the setcc is KEPT (any live boolean stays exact).
fn opt_cc_inv(cc: i32) i32 {
    if (cc == CC_E())  { return CC_NE(); }
    if (cc == CC_NE()) { return CC_E(); }
    if (cc == CC_L())  { return CC_GE(); }
    if (cc == CC_LE()) { return CC_G(); }
    if (cc == CC_G())  { return CC_LE(); }
    if (cc == CC_GE()) { return CC_L(); }
    return 0 - 1;
}
fn opt_jcc_for_cc(cc: i32) i32 {
    if (cc == CC_E())  { return K_JE(); }
    if (cc == CC_NE()) { return K_JNE(); }
    if (cc == CC_L())  { return K_JL(); }
    if (cc == CC_LE()) { return K_JLE(); }
    if (cc == CC_G())  { return K_JG(); }
    if (cc == CC_GE()) { return K_JGE(); }
    return 0 - 1;   // unsigned/float ccs (B/BE/A/AE) have no Jcc kind — skip
}
fn opt_fuse_cc(prog: ArrayList[Instr]) ArrayList[Instr] {
    let n: i32 = len[Instr](prog);
    let drop: ArrayList[i32] = make[i32](n + 1);
    let fuse: ArrayList[i32] = make[i32](n + 1);
    let z: i32 = 0;
    while (z < n) { push[i32](&drop, 0); push[i32](&fuse, 0 - 1); z = z + 1; }

    let i: i32 = 0;
    while (i < n) {
        let k: i32 = get[Instr](prog, i).kind;
        if (k == K_JE() || k == K_JNE()) {
            // (a) walk back over flag-preserving instrs to this jump's flag-writer
            let jcmp: i32 = 0 - 1;
            let j: i32 = i - 1;
            while (j >= 0 && jcmp < 0) {
                let kj: i32 = get[Instr](prog, j).kind;
                if (opt_is_breaker(kj) == 1) { j = 0 - 1; }
                else { if (opt_writes_flags(kj) == 1) { jcmp = j; }
                else { j = j - 1; } }
            }
            if (jcmp >= 0) {
                let jc: Instr = get[Instr](prog, jcmp);
                if (jc.kind == K_CMP_RI() && jc.imm == 0) {
                    let r: i32 = jc.dst;
                    // (b) walk back for `setcc r` before any flag-writer/breaker
                    let scc: i32 = 0 - 1;
                    let s: i32 = jcmp - 1;
                    while (s >= 0 && scc < 0) {
                        let si: Instr = get[Instr](prog, s);
                        if (opt_is_breaker(si.kind) == 1) { s = 0 - 1; }
                        else { if (opt_writes_flags(si.kind) == 1) { s = 0 - 1; }
                        else { if (si.kind == K_SETCC() && si.dst == r) { scc = s; }
                        else { s = s - 1; } } }
                    }
                    if (scc >= 0) {
                        // (c) r unwritten in the open gap (scc, jcmp)
                        let ok: i32 = 1;
                        let t: i32 = scc + 1;
                        while (ok == 1 && t < jcmp) {
                            if (opt_reg_written(get[Instr](prog, t), r) == 1) { ok = 0; }
                            t = t + 1;
                        }
                        if (ok == 1) {
                            let cc: i32 = get[Instr](prog, scc).imm as i32;
                            if (k == K_JE()) { cc = opt_cc_inv(cc); }
                            let nk: i32 = opt_jcc_for_cc(cc);
                            if (nk >= 0) {
                                set[i32](&drop, jcmp, 1);
                                set[i32](&fuse, i, nk);
                                // Also drop the setcc itself when its value reg
                                // is dead everywhere after (the fused jump was
                                // its only consumer). Scan forward: a read
                                // blocks, an overwrite ends the search as dead.
                                let dead: i32 = 1;
                                let sc: i32 = scc + 1;
                                while (sc < n && dead == 1) {
                                    if (sc == jcmp) { sc = sc + 1; }
                                    else { if (sc == i) { sc = sc + 1; }
                                    else {
                                        let si2: Instr = get[Instr](prog, sc);
                                        if (opt_reads_reg(si2, r) == 1) { dead = 0; }
                                        else { if (opt_writes_reg(si2, r) == 1) { sc = n; }
                                        else { sc = sc + 1; } }
                                    } }
                                }
                                if (dead == 1) { set[i32](&drop, scc, 1); }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }

    let out: ArrayList[Instr] = make[Instr](n + 1);
    let m: i32 = 0;
    while (m < n) {
        if (get[i32](drop, m) == 0) {
            let ins: Instr = get[Instr](prog, m);
            let fk: i32 = get[i32](fuse, m);
            if (fk >= 0) { ins.kind = fk; }
            push[Instr](&out, ins);
        }
        m = m + 1;
    }
    free[i32](&drop);
    free[i32](&fuse);
    return out;
}

// ── frameless-function elision ────────────────────────────────────────────────
// After promotion, many functions reference NO rbp-relative slot at all: every
// local lives in a register. Such a function's entire frame machinery —
// `push rbp; mov rbp,rsp; sub rsp,N` and the matching `mov rsp,rbp; pop rbp`
// in EVERY epilogue — is dead weight on the call path (which is where the cost
// hurts most: recursion pays it per call). A region between two `push rbp`
// prologues that contains no rbp operand other than the 5 frame instructions
// is frameless: drop all of them. Labels never sit on those instructions (the
// epilogue jump target is the register-restore block, which stays).
fn opt_frameless(prog: ArrayList[Instr]) ArrayList[Instr] {
    let n: i32 = len[Instr](prog);
    let drop: ArrayList[i32] = make[i32](n + 1);
    let z: i32 = 0;
    while (z < n) { push[i32](&drop, 0); z = z + 1; }
    let p: i32 = 0;
    while (p < n) {
        let isPro: i32 = 0;
        if (p + 2 < n) {
            let i0: Instr = get[Instr](prog, p);
            let i1: Instr = get[Instr](prog, p + 1);
            let i2: Instr = get[Instr](prog, p + 2);
            if (i0.kind == K_PUSH() && i0.dst == R_RBP() &&
                i1.kind == K_MOV_RR() && i1.dst == R_RBP() && i1.src == R_RSP() &&
                i2.kind == K_SUB_RI() && i2.dst == R_RSP()) { isPro = 1; }
        }
        if (isPro == 1) {
            // region = (p+3, next `push rbp` or end)
            let e: i32 = p + 3;
            let fnd: i32 = 0;
            while (e < n && fnd == 0) {
                let ie: Instr = get[Instr](prog, e);
                if (ie.kind == K_PUSH() && ie.dst == R_RBP()) { fnd = 1; }
                else { e = e + 1; }
            }
            let eend: i32 = e;
            // clean iff the only rbp operands in the region are the epilogue's
            let clean: i32 = 1;
            let q: i32 = p + 3;
            while (q < eend && clean == 1) {
                let iq: Instr = get[Instr](prog, q);
                let isEpi: i32 = 0;
                if (iq.kind == K_MOV_RR() && iq.dst == R_RSP() && iq.src == R_RBP()) { isEpi = 1; }
                if (iq.kind == K_POP() && iq.dst == R_RBP()) { isEpi = 1; }
                if (isEpi == 0 && (iq.dst == R_RBP() || iq.src == R_RBP())) { clean = 0; }
                q = q + 1;
            }
            if (clean == 1) {
                set[i32](&drop, p, 1); set[i32](&drop, p + 1, 1); set[i32](&drop, p + 2, 1);
                let q2: i32 = p + 3;
                while (q2 < eend) {
                    let iq2: Instr = get[Instr](prog, q2);
                    if (iq2.kind == K_MOV_RR() && iq2.dst == R_RSP() && iq2.src == R_RBP()) { set[i32](&drop, q2, 1); }
                    if (iq2.kind == K_POP() && iq2.dst == R_RBP()) { set[i32](&drop, q2, 1); }
                    q2 = q2 + 1;
                }
            }
            p = eend;
        } else { p = p + 1; }
    }
    let out: ArrayList[Instr] = make[Instr](n);
    let i: i32 = 0;
    while (i < n) {
        if (get[i32](drop, i) == 0) { push[Instr](&out, get[Instr](prog, i)); }
        i = i + 1;
    }
    free[i32](&drop);
    return out;
}

// ── scaled-index + memory-operand peephole ───────────────────────────────────
// The stack-machine emitter computes p[i] as `mov $k,t1; imul i,t1; add b,i;
// [load|store] b,0` and `acc + p[i]` as load then a 4-mov ALU shuffle. Fold the
// first into one SIB-addressed instruction (the scale byte does the multiply
// for free) and the second into a single `add acc,[b+i*8]`:
//
//   mov_imm t1,k | imul rI,t1 | add rB,rI | load rT,rB,0   → load_sib rT,rB,rI,log2k
//   … same head …           | store rB,0,rV               → store_sib rB,rI,log2k,0,rV
//   load_sib t,b,i,s,d | mov c,t | mov a,d | add a,c | mov d,a → add_sib d,b,i,s,d
// reg provably unused for the next `lim` instrs (read => live, write => dead).
fn opt_dead_soon(prog: ArrayList[Instr], r: i32, from: i32, lim: i32) i32 {
    let n: i32 = len[Instr](prog);
    let sc: i32 = from;
    let end: i32 = from + lim;
    if (end > n) { end = n; }
    let dead: i32 = 1;
    let hitw: i32 = 0;
    while (sc < end && dead == 1) {
        let ins: Instr = get[Instr](prog, sc);
        if (ins.kind == K_CALL() || ins.kind == K_CALL_REG() ||
            ins.kind == K_CALL_EXT()) {
            // SysV args rdi,rsi,rdx,rcx,r8,r9 are read by the callee — but
            // ONLY if this call site actually set them up. This codegen emits
            // arg setup as explicit pops/movs into the arg registers in the
            // instructions just before the call, so scan back: if r was
            // written since the last control-flow boundary, the callee reads
            // it (live); otherwise its pre-call value is incidental and the
            // call is a plain kill (caller-saved regs are clobbered). rax and
            // r10/r11 are never args → always kills. Callee-saved pass through.
            // K_CALL_REG reads dst as the call target, so it is never a kill.
            if (ins.kind == K_CALL_REG() && ins.dst == r) { dead = 0; sc = end; }
            else { if (r == R_RDI() || r == R_RSI() || r == R_RDX() || r == R_RCX() ||
                r == R_R8()  || r == R_R9()) {
                let bk: i32 = sc - 1;
                let stop: i32 = sc - 24;
                if (stop < 0) { stop = 0 - 1; }
                let setup: i32 = 0;
                while (bk > stop && setup == 0) {
                    let pins: Instr = get[Instr](prog, bk);
                    let pk: i32 = pins.kind;
                    if (opt_writes_reg(pins, r) == 1) { setup = 1; }
                    else { if (pk == K_CALL() || pk == K_CALL_REG() ||
                        pk == K_CALL_EXT() || pk == K_LABEL() ||
                        pk == K_JMP() || pk == K_JE() || pk == K_JNE() ||
                        pk == K_JL() || pk == K_JLE() || pk == K_JG() ||
                        pk == K_JGE()) { bk = stop; }
                    else { bk = bk - 1; } }
                }
                if (setup == 1) { dead = 0; sc = end; }
                else { hitw = 1; sc = end; }
            }
            else { if (r == R_RAX() || r == R_R10() || r == R_R11()) {
                hitw = 1; sc = end;
            } else { sc = sc + 1; } }
        } }
        else { if (opt_reads_reg(ins, r) == 1) { dead = 0; }
        else { if (opt_writes_reg(ins, r) == 1) { hitw = 1; sc = end; }
        else { sc = sc + 1; } } }
    }
    if (dead == 0) { return 0; }
    if (hitw == 1) { return 1; }
    if (end == n) { return 1; } // reaches end of program without a read
    return 0;                    // window exhausted: cannot prove death
}

fn opt_sib(prog: ArrayList[Instr]) ArrayList[Instr] {
    let n: i32 = len[Instr](prog);
    let drop: ArrayList[i32] = make[i32](n + 1);
    let ins: ArrayList[Instr] = make[Instr](n + 1);
    let z: i32 = 0;
    while (z < n) { push[i32](&drop, 0); push[Instr](&ins, get[Instr](prog, z)); z = z + 1; }

    let i: i32 = 0;
    while (i + 3 < n) {
        let a: Instr = get[Instr](prog, i);
        let b: Instr = get[Instr](prog, i + 1);
        let c: Instr = get[Instr](prog, i + 2);
        let d: Instr = get[Instr](prog, i + 3);
        let ispw: i32 = 0;
        if (a.imm == 2) { ispw = 1; }
        if (a.imm == 4) { ispw = 1; }
        if (a.imm == 8) { ispw = 1; }
        if (a.kind == K_MOV_IMM() &&
            b.kind == K_IMUL_RR() && b.src == a.dst &&
            c.kind == K_ADD_RR() && c.src == b.dst &&
            a.dst != b.dst && b.dst != c.dst && a.dst != c.dst &&
            ispw == 1) {
            // temps whose old value is consumed later bail the fold; a temp
            // the mem op itself overwrites (d.dst aliases it) is dead by
            // definition — later reads see the loaded value, which is correct.
            let ded: i32 = 1;
            if (a.dst != d.dst && opt_dead_soon(prog, a.dst, i + 4, 64) == 0) { ded = 0; }
            if (b.dst != d.dst && opt_dead_soon(prog, b.dst, i + 4, 64) == 0) { ded = 0; }
            if (c.dst != d.dst && opt_dead_soon(prog, c.dst, i + 4, 64) == 0) { ded = 0; }
            if (ded == 0) { i = i + 1; }
            if (ded == 1) {
            let sl: i32 = a.imm as i32;
            if (sl == 2) { sl = 1; } else { if (sl == 4) { sl = 2; } else { sl = 3; } }
            if (d.kind == K_LOAD() && d.src == c.dst && d.disp == 0 &&
                b.dst != R_RSP()) {
                set[Instr](&ins, i, i_load_sib(d.dst, c.dst, b.dst, sl, 0));
                set[i32](&drop, i + 1, 1); set[i32](&drop, i + 2, 1); set[i32](&drop, i + 3, 1);
                i = i + 4;
            } else { if (d.kind == K_STORE() && d.dst == c.dst && d.disp == 0 &&
                b.dst != R_RSP() &&
                d.src != a.dst && d.src != b.dst && d.src != c.dst) {
                set[Instr](&ins, i, i_store_sib(c.dst, b.dst, sl, 0, d.src));
                set[i32](&drop, i + 1, 1); set[i32](&drop, i + 2, 1); set[i32](&drop, i + 3, 1);
                i = i + 4;
            } else { if (d.kind == K_PUSH() && d.dst == c.dst) {
                // add rB,rI; push rB; <mid>; pop rX; store rX,0,v
                //   → store_sib rB0,rI,sl,0,v
                // where rB0 is the register that produced rB's PRE-add value
                // (found by looking back ≤4 instrs for `mov rB,rB0`). rB is
                // free to be clobbered in the middle — that is what the push
                // was for — but its producer rB0 must survive to store time.
                let st: i32 = 0 - 1;
                let lim: i32 = i + 12;
                if (lim > n) { lim = n; }
                let midok: i32 = 1;
                let cwrot: i32 = 0;
                let j: i32 = i + 4;
                while (j < lim && midok == 1 && st < 0) {
                    let mj: Instr = get[Instr](prog, j);
                    if (mj.kind == K_POP() && j + 1 < lim &&
                        get[Instr](prog, j + 1).kind == K_STORE() &&
                        get[Instr](prog, j + 1).dst == mj.dst &&
                        get[Instr](prog, j + 1).disp == 0) {
                        st = j + 1;
                        j = lim;
                    }
                    else { if (mj.kind == K_LABEL()) { midok = 0; }
                    else { if (opt_reads_reg(mj, a.dst) == 1) { midok = 0; }
                    else { if (opt_writes_reg(mj, a.dst) == 1) { midok = 0; }
                    else { if (opt_reads_reg(mj, b.dst) == 1) { midok = 0; }
                    else { if (opt_writes_reg(mj, b.dst) == 1) { midok = 0; }
                    else { if (opt_reads_reg(mj, c.dst) == 1) { midok = 0; }
                    else {
                        if (opt_writes_reg(mj, c.dst) == 1) { cwrot = 1; }
                        j = j + 1;
                    } } } } } } }
                }
                let rB0: i32 = 0 - 1;
                if (st >= 0 && midok == 1) {
                    j = i - 1;
                    let lo: i32 = i - 4;
                    if (lo < 0) { lo = 0; }
                    while (j >= lo && rB0 < 0) {
                        let pj: Instr = get[Instr](prog, j);
                        if (pj.kind == K_MOV_RR() && pj.dst == c.dst) { rB0 = pj.src; }
                        else { if (opt_writes_reg(pj, c.dst) == 1) { j = 0 - 1; }
                        else { j = j - 1; } }
                    }
                    if (rB0 == a.dst || rB0 == b.dst || rB0 == c.dst ||
                        rB0 == R_RSP() || rB0 < 0) { rB0 = 0 - 1; }
                    // rB0 must not be rewritten between its load and the store
                    if (rB0 >= 0) {
                        j = i - 1;
                        while (j >= lo && get[Instr](prog, j).src != rB0) {
                            let pj2: Instr = get[Instr](prog, j);
                            if (opt_writes_reg(pj2, rB0) == 1) { rB0 = 0 - 1; j = lo; }
                            else { j = j - 1; }
                        }
                        j = i + 4;
                        while (rB0 >= 0 && j < st) {
                            if (opt_writes_reg(get[Instr](prog, j), rB0) == 1) { rB0 = 0 - 1; }
                            else { j = j + 1; }
                        }
                    }
                }
                if (st >= 0 && midok == 1 && rB0 >= 0) {
                    let sv: Instr = get[Instr](prog, st);
                    if (sv.src != a.dst && sv.src != b.dst && sv.src != rB0 &&
                        (sv.src != c.dst || cwrot == 1) &&
                        b.dst != R_RSP() &&
                        opt_dead_soon(prog, a.dst, st + 1, 64) == 1 &&
                        opt_dead_soon(prog, b.dst, st + 1, 64) == 1 &&
                        opt_dead_soon(prog, c.dst, st + 1, 64) == 1) {
                        // keep the middle instrs (they compute the value);
                        // drop mov_imm, imul, add, push, pop and splice the
                        // SIB store into the store's own position.
                        set[i32](&drop, i, 1); set[i32](&drop, i + 1, 1);
                        set[i32](&drop, i + 2, 1); set[i32](&drop, i + 3, 1);
                        set[i32](&drop, st - 1, 1);
                        set[Instr](&ins, st, i_store_sib(rB0, b.dst, sl, 0, sv.src));
                        i = st + 1;
                    } else { i = i + 1; }
                } else { i = i + 1; }
            } else { i = i + 1; } } } }
        } else { i = i + 1; }
    }

    // materialize the fused stream
    let out: ArrayList[Instr] = make[Instr](n + 1);
    let m: i32 = 0;
    while (m < n) {
        if (get[i32](drop, m) == 0) { push[Instr](&out, get[Instr](ins, m)); }
        m = m + 1;
    }
    free[i32](&drop);
    free[Instr](&ins);
    return out;
}

// register-rename folding: scalar promotion leaves chains of `mov` staging
// copies around memory ops (load [rax+rcx*8] where rax/rcx are just copies of
// the promoted arr/i registers). This pass retargets SIB operands to the
// original registers, removes trivially dead moves, and folds the
// `mov k,t ; mov acc,v ; add t,v ; mov v,acc` idiom into `add acc,k`.
fn opt_cs(r: i32) i32 {
    // caller-saved scratch: rax rcx rdx rsi rdi r8 r9 r10 r11
    if (r == 0 || r == 1 || r == 2 || r == 6 || r == 7 || r == 8 ||
        r == 9 || r == 10 || r == 11) { return 1; }
    return 0;
}
fn opt_is_cf(k: i32) i32 {
    // control-flow boundary: labels, jumps, branches, returns
    if (k == K_LABEL() || k == K_JMP() || k == K_RET() || k == K_JE() ||
        k == K_JNE() || k == K_JL() || k == K_JLE() || k == K_JG() ||
        k == K_JGE()) { return 1; }
    return 0;
}
// Block-scoped deadness: like opt_dead_soon but refuses to conclude anything
// across a control-flow boundary. The linear scan in opt_dead_soon is fine for
// the narrow fold windows it was written for, but a mov dropped on its verdict
// can be a live value on another path (a `mov x,rax` before `jmp epilogue`
// looks dead because unreachable code past the jmp rewrites rax — it is the
// return value). Here only a kill/read inside the SAME basic block counts.
fn opt_dead_soon_blk(prog: ArrayList[Instr], r: i32, from: i32, lim: i32) i32 {
    let n: i32 = len[Instr](prog);
    let sc: i32 = from;
    let end: i32 = from + lim;
    if (end > n) { end = n; }
    let dead: i32 = 1;
    let hitw: i32 = 0;
    while (sc < end && dead == 1) {
        let ins: Instr = get[Instr](prog, sc);
        if (opt_is_cf(ins.kind) == 1) { dead = 0; sc = end; }
        else { if (ins.kind == K_CALL() || ins.kind == K_CALL_REG() ||
            ins.kind == K_CALL_EXT()) {
            if (ins.kind == K_CALL_REG() && ins.dst == r) { dead = 0; sc = end; }
            else { if (r == R_RDI() || r == R_RSI() || r == R_RDX() || r == R_RCX() ||
                r == R_R8()  || r == R_R9()) {
                // same-block backward scan for the arg setup (see opt_dead_soon)
                let bk: i32 = sc - 1;
                let stop: i32 = sc - 24;
                if (stop < 0) { stop = 0 - 1; }
                let setup: i32 = 0;
                while (bk > stop && setup == 0) {
                    let pins: Instr = get[Instr](prog, bk);
                    let pk: i32 = pins.kind;
                    if (opt_writes_reg(pins, r) == 1) { setup = 1; }
                    else { if (opt_is_cf(pk) == 1 || pk == K_CALL() ||
                        pk == K_CALL_REG() || pk == K_CALL_EXT()) { bk = stop; }
                    else { bk = bk - 1; } }
                }
                if (setup == 1) { dead = 0; sc = end; }
                else { hitw = 1; sc = end; }
            }
            else { if (r == R_RAX() || r == R_R10() || r == R_R11()) {
                hitw = 1; sc = end;
            } else { sc = sc + 1; } }
        } }
        else { if (opt_reads_reg(ins, r) == 1) { dead = 0; }
        else { if (opt_writes_reg(ins, r) == 1) { hitw = 1; sc = end; }
        else { sc = sc + 1; } } } }
    }
    if (dead == 0) { return 0; }
    if (hitw == 1) { return 1; }
    return 0;   // boundary or window reached without a kill: cannot prove
}
fn opt_is_sib(k: i32) i32 {
    if (k == K_LOAD_SIB() || k == K_STORE_SIB() || k == K_ADD_SIB()) { return 1; }
    return 0;
}
fn opt_rename(prog: ArrayList[Instr]) ArrayList[Instr] {
    let out: ArrayList[Instr] = make[Instr](len[Instr](prog) + 1);
    let n: i32 = len[Instr](prog);
    let p: i32 = 0;
    while (p < n) {
        let a: Instr = get[Instr](prog, p);
        let adv: i32 = 1;
        let emit: i32 = 0;
        if (a.kind == K_MOV_RR()) {
            if (a.dst == a.src) { emit = 0 - 1; }
            else { if (opt_cs(a.dst) == 1 &&
                opt_dead_soon_blk(prog, a.dst, p + 1, 64) == 1) {
                // dead move into a caller-saved scratch (callee-saved regs can
                // carry values past a call, so they are never dropped here;
                // the proof must complete inside this basic block)
                emit = 0 - 1;
            } else {
                if (p + 2 < n) {
                    let b: Instr = get[Instr](prog, p + 1);
                    // scan forward to the first SIB, tolerating up to two gap
                    // instrs that are themselves MOV_RR and touch nothing we
                    // retarget (dead arg-setup copies like `mov rax,rdi` sit
                    // between the staging movs and the SIB in emitted code)
                    let ci: i32 = p + 2;
                    let glen: i32 = 0;
                    let cdone: i32 = 0;
                    while (cdone == 0 && ci < n && glen <= 2 &&
                           b.kind == K_MOV_RR()) {
                        let t: Instr = get[Instr](prog, ci);
                        if (opt_is_sib(t.kind) == 1) { cdone = 1; }
                        else { if (t.kind == K_MOV_RR()) { glen = glen + 1; ci = ci + 1; }
                        else { cdone = 0 - 1; } }
                    }
                    if (cdone == 1) {
                        let c: Instr = get[Instr](prog, ci);
                        // every gap instr must not write any reg we retarget
                        let gok: i32 = 1;
                        let g: i32 = p + 2;
                        while (g < ci && gok == 1) {
                            let gi: Instr = get[Instr](prog, g);
                            if (opt_writes_reg(gi, a.dst) == 1 ||
                                opt_writes_reg(gi, b.dst) == 1 ||
                                opt_writes_reg(gi, a.src) == 1 ||
                                opt_writes_reg(gi, b.src) == 1) { gok = 0; }
                            else { g = g + 1; }
                        }
                        // a staging reg the SIB result overwrites is dead by
                        // definition; otherwise it must die in this block
                        let aok: i32 = 0;
                        if (a.dst == c.dst && c.kind != K_STORE_SIB()) { aok = 1; }
                        else { if (opt_dead_soon_blk(prog, a.dst, ci + 1, 64) == 1) { aok = 1; } }
                        let bok: i32 = 0;
                        if (b.dst == c.dst && c.kind != K_STORE_SIB()) { bok = 1; }
                        else { if (opt_dead_soon_blk(prog, b.dst, ci + 1, 64) == 1) { bok = 1; } }
                        // retargeted operands (index slot can never be rsp)
                        let cs2: i32 = c.src;
                        let cl2: i32 = c.lbl;
                        let hit: i32 = 0;
                        if (c.src == a.dst) { cs2 = a.src; hit = 1; }
                        if (c.src == b.dst) { cs2 = b.src; hit = 1; }
                        if (c.lbl == a.dst && a.src != R_RSP()) { cl2 = a.src; hit = 1; }
                        if (c.lbl == b.dst && b.src != R_RSP()) { cl2 = b.src; hit = 1; }
                        if (c.kind == K_STORE_SIB()) {
                            // store dst slot is the base, not a result
                            let cd2: i32 = c.dst;
                            if (c.dst == a.dst && a.src != R_RSP() &&
                                a.src != cs2 && a.src != cl2) { cd2 = a.src; hit = 1; }
                            if (c.dst == b.dst && b.src != R_RSP() &&
                                b.src != cs2 && b.src != cl2) { cd2 = b.src; hit = 1; }
                            if (hit == 1 && gok == 1 && aok == 1 && bok == 1 &&
                                b.src != a.dst && a.src != b.dst) {
                                let g2: i32 = p + 2;
                                while (g2 < ci) {
                                    let gi2: Instr = get[Instr](prog, g2);
                                    let gs: i32 = gi2.src;
                                    if (gs == a.dst) { gs = a.src; }
                                    if (gs == b.dst) { gs = b.src; }
                                    push[Instr](&out, ins6(gi2.kind, gi2.dst, gs, gi2.imm, gi2.disp, gi2.lbl));
                                    g2 = g2 + 1;
                                }
                                push[Instr](&out, ins6(c.kind, cd2, cs2, c.imm, c.disp, cl2));
                                adv = (ci - p) + 1; emit = 1;
                            }
                        }
                        else { if (hit == 1 && gok == 1 && aok == 1 && bok == 1 &&
                            b.src != a.dst && a.src != b.dst) {
                            let g2: i32 = p + 2;
                            while (g2 < ci) {
                                let gi2: Instr = get[Instr](prog, g2);
                                let gs: i32 = gi2.src;
                                if (gs == a.dst) { gs = a.src; }
                                if (gs == b.dst) { gs = b.src; }
                                push[Instr](&out, ins6(gi2.kind, gi2.dst, gs, gi2.imm, gi2.disp, gi2.lbl));
                                g2 = g2 + 1;
                            }
                            push[Instr](&out, ins6(c.kind, c.dst, cs2, c.imm, c.disp, cl2));
                            adv = (ci - p) + 1; emit = 1;
                        } }
                    }
                }
                if (emit == 0 && p + 1 < n) {
                    let b: Instr = get[Instr](prog, p + 1);
                    // same overwrite exemption: a.dst == result of LOAD/ADD_SIB
                    if (opt_is_sib(b.kind) == 1 &&
                        ((a.dst == b.dst && b.kind != K_STORE_SIB()) ||
                         opt_dead_soon_blk(prog, a.dst, p + 2, 64) == 1)) {
                        // single copy staging one SIB operand
                        let bs: i32 = b.src;
                        let bl: i32 = b.lbl;
                        let bd: i32 = b.dst;
                        let hit: i32 = 0;
                        if (bs == a.dst && bl != a.dst &&
                            a.src != R_RSP()) { bs = a.src; hit = 1; }
                        if (bl == a.dst && b.src != a.dst &&
                            a.src != R_RSP()) { bl = a.src; hit = 1; }
                        if (b.kind == K_STORE_SIB() && bd == a.dst &&
                            a.src != R_RSP() && a.src != bs && a.src != bl) { bd = a.src; hit = 1; }
                        if (hit == 1) {
                            push[Instr](&out, ins6(b.kind, bd, bs, b.imm, b.disp, bl));
                            adv = 2; emit = 1;
                        }
                    }
                }
            } }
        }
        else {
            if (a.kind == K_MOV_IMM() && p + 3 < n) {
                let b: Instr = get[Instr](prog, p + 1);
                let c: Instr = get[Instr](prog, p + 2);
                let d: Instr = get[Instr](prog, p + 3);
                if (b.kind == K_MOV_RR() && b.dst != b.src &&
                    c.kind == K_ADD_RR() && c.dst == b.dst && c.src == a.dst &&
                    d.kind == K_MOV_RR() && d.dst == b.src && d.src == b.dst &&
                    a.dst != b.src && a.dst != b.dst &&
                    a.imm > -2147483648 && a.imm < 2147483648 &&
                    opt_dead_soon_blk(prog, a.dst, p + 4, 64) == 1 &&
                    opt_dead_soon_blk(prog, b.dst, p + 4, 64) == 1) {
                    // mov $k,t ; mov acc,v ; add t,v ; mov v,acc → add acc,$k
                    // (add imm is a sign-extended i32 — wider constants bail)
                    push[Instr](&out, i_add_imm(b.src, a.imm));
                    adv = 4; emit = 1;
                }
            }
        }
        if (emit == 0) { push[Instr](&out, a); }
        if (emit < 0) { adv = 1; }
        p = p + adv;
    }
    return out;
}

// accumulate fold: runs after opt_rename so substituted SIB operands feed it.
fn opt_sib_accum(prog: ArrayList[Instr]) ArrayList[Instr] {
    let out: ArrayList[Instr] = prog;
    let n2: i32 = len[Instr](out);
    let out2: ArrayList[Instr] = make[Instr](n2 + 1);
    let p: i32 = 0;
    while (p < n2) {
        let a: Instr = get[Instr](out, p);
        if (a.kind == K_LOAD_SIB() && p + 4 < n2) {
            let b: Instr = get[Instr](out, p + 1);
            let c: Instr = get[Instr](out, p + 2);
            let d: Instr = get[Instr](out, p + 3);
            let e: Instr = get[Instr](out, p + 4);
            if (b.kind == K_MOV_RR() && b.src == a.dst &&
                c.kind == K_POP() &&
                d.kind == K_ADD_RR() && d.dst == c.dst && d.src == b.dst) {
                if (a.src != c.dst && a.lbl != c.dst &&
                    a.lbl != R_RSP() && a.src != a.dst) {
                    // load_sib t; mov u,t; pop acc; add acc,u
                    //   →  pop acc; add acc, [base + idx*scale + disp]
                    push[Instr](&out2, c);
                    push[Instr](&out2, i_add_sib(c.dst, a.src, a.lbl, a.imm as i32, a.disp));
                } else { if (b.dst != a.src && b.dst != c.dst &&
                    b.dst != R_RSP()) {
                    // the pop clobbers the base or index: keep the memory read
                    // but retarget it into the copy's dst (the index/base is
                    // read by the SIB byte before the pop runs) —
                    //   load_sib u,[base+idx*s]; pop acc; add acc,u
                    push[Instr](&out2, i_load_sib(b.dst, a.src, a.lbl, a.imm as i32, a.disp));
                    push[Instr](&out2, c);
                    push[Instr](&out2, i_add(c.dst, b.dst));
                } else {
                    push[Instr](&out2, a); push[Instr](&out2, b);
                    push[Instr](&out2, c); push[Instr](&out2, d);
                } }
                p = p + 4;
            } else { if (b.kind == K_MOV_RR() && b.src == a.dst &&
                c.kind == K_MOV_RR() &&
                d.kind == K_ADD_RR() && d.dst == c.dst && d.src == b.dst &&
                e.kind == K_MOV_RR() && e.dst == c.src && e.src == c.dst &&
                b.dst != a.src && b.dst != a.lbl && c.dst != a.src &&
                c.dst != a.lbl &&
                a.lbl != R_RSP() && a.src != a.dst) {
                push[Instr](&out2, i_add_sib(c.src, a.src, a.lbl, a.imm as i32, a.disp));
                p = p + 5;
            } else { push[Instr](&out2, a); p = p + 1; } }
        } else { push[Instr](&out2, a); p = p + 1; }
    }
    return out2;
}

// ── public entry: fold, cc fusion, DCE, frame elision, SIB peephole ──────────
fn optimize(prog: ArrayList[Instr]) ArrayList[Instr] {
    let folded: ArrayList[Instr] = opt_fold_pass(prog);
    let fused:  ArrayList[Instr] = opt_fuse_cc(folded);
    free[Instr](&folded);
    let cleaned: ArrayList[Instr] = opt_dce(fused);
    free[Instr](&fused);
    let slim: ArrayList[Instr] = opt_frameless(cleaned);
    free[Instr](&cleaned);
    let sib: ArrayList[Instr] = opt_sib(slim);
    free[Instr](&slim);
    let ren: ArrayList[Instr] = opt_rename(sib);
    free[Instr](&sib);
    // second sweep: dropped dead movs can restore mov;mov;SIB adjacency the
    // first sweep's window could not see
    let ren2: ArrayList[Instr] = opt_rename(ren);
    free[Instr](&ren);
    let acc: ArrayList[Instr] = opt_sib_accum(ren2);
    free[Instr](&ren2);
    return acc;
}
