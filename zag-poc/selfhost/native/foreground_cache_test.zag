@import("foreground_cache.zag")

fn check(ok:i32,name:[]u8,fail:*i32)void{if(ok==0){_zag_print("FAIL foreground cache: ");_zag_println(name);fail.*=fail.*+1;}}
fn fct_checksum_mark(text:[]u8)i32{let marker:[]u8="record_checksum=";let i:i32=0;while(i+marker.len<=text.len){if((i==0||text[i-1]=='\n')&&@strEq(text[i..i+marker.len],marker)){return i;}i=i+1;}return 0-1;}
fn fct_sign(body:[]u8)[]u8{return _zag_str_concat(body,_zag_str_concat("record_checksum=",_zag_str_concat(fc_fields(zagd_content_hash(body)),"\n")));}
fn fct_replace(text:[]u8,needle:[]u8,replacement:[]u8)[]u8{let i:i32=0;while(i+needle.len<=text.len){if(@strEq(text[i..i+needle.len],needle)){return _zag_str_concat(text[0..i],_zag_str_concat(replacement,text[i+needle.len..]));}i=i+1;}return text;}
fn main()i32{
    let fail:i32=0;let modules:ArrayList[ResolvedModule]=make[ResolvedModule](2);push[ResolvedModule](&modules,ResolvedModule{.path="<root>",.source="fn main() i32 { return 7; }"});push[ResolvedModule](&modules,ResolvedModule{.path="dep.zag",.source="fn value() i32 { return 7; }"});
    let resources:ArrayList[ResolvedResource]=make[ResolvedResource](1);push[ResolvedResource](&resources,ResolvedResource{.path="assets/palette.bin",.data="blue"});
    let code:ArrayList[u8]=make[u8](4);push[u8](&code,1);push[u8](&code,2);push[u8](&code,3);let data:ArrayList[u8]=make[u8](1);push[u8](&data,9);
    let graph:ZagdHash=zagd_content_hash("semantic-graph-a");let key:ForegroundCacheKey=fc_key("compiler-a","1.0.0","/project-a","main.zag","root",modules,resources,graph,"generic-sse2","sysv-v1","strict-policy");let record:[]u8=fc_record(key,code.data[0..code.len],data.data[0..data.len]);
    check(fc_record_accept(record,key,code.data[0..code.len],data.data[0..data.len]),"valid hit",&fail);
    check(fc_key_equal(key,key),"key equality",&fail);
    let identity_key:ForegroundCacheKey=fc_key_identity(zagd_content_hash("compiler-a"),"1.0.0","/project-a","main.zag","root",modules,resources,graph,"generic-sse2","sysv-v1","strict-policy");check(fc_key_equal(key,identity_key),"prehashed compiler identity equality",&fail);
    let stale_label:ForegroundCacheKey=fc_key("compiler-a","1.0.0","/project-a","other.zag","root",modules,resources,graph,"generic-sse2","sysv-v1","strict-policy");check(1-fc_record_accept(record,stale_label,code.data[0..code.len],data.data[0..data.len]),"stale source label miss",&fail);
    let stale_compiler:ForegroundCacheKey=fc_key("compiler-b","1.0.0","/project-a","main.zag","root",modules,resources,graph,"generic-sse2","sysv-v1","strict-policy");check(1-fc_record_accept(record,stale_compiler,code.data[0..code.len],data.data[0..data.len]),"stale compiler image miss",&fail);
    let stale_version:ForegroundCacheKey=fc_key("compiler-a","1.0.1","/project-a","main.zag","root",modules,resources,graph,"generic-sse2","sysv-v1","strict-policy");check(1-fc_record_accept(record,stale_version,code.data[0..code.len],data.data[0..data.len]),"stale compiler version miss",&fail);
    let stale_project:ForegroundCacheKey=fc_key("compiler-a","1.0.0","/project-b","main.zag","root",modules,resources,graph,"generic-sse2","sysv-v1","strict-policy");check(1-fc_record_accept(record,stale_project,code.data[0..code.len],data.data[0..data.len]),"project path substitution miss",&fail);
    let stale_graph:ForegroundCacheKey=fc_key("compiler-a","1.0.0","/project-a","main.zag","root",modules,resources,zagd_content_hash("semantic-graph-b"),"generic-sse2","sysv-v1","strict-policy");check(1-fc_record_accept(record,stale_graph,code.data[0..code.len],data.data[0..data.len]),"stale semantic graph miss",&fail);
    let stale_target:ForegroundCacheKey=fc_key("compiler-a","1.0.0","/project-a","main.zag","root",modules,resources,graph,"native-bmi1","sysv-v1","strict-policy");check(1-fc_record_accept(record,stale_target,code.data[0..code.len],data.data[0..data.len]),"stale target/features miss",&fail);
    let stale_abi:ForegroundCacheKey=fc_key("compiler-a","1.0.0","/project-a","main.zag","root",modules,resources,graph,"generic-sse2","sysv-v2","strict-policy");check(1-fc_record_accept(record,stale_abi,code.data[0..code.len],data.data[0..data.len]),"stale ABI miss",&fail);
    let stale_policy:ForegroundCacheKey=fc_key("compiler-a","1.0.0","/project-a","main.zag","root",modules,resources,graph,"generic-sse2","sysv-v1","script-policy");check(1-fc_record_accept(record,stale_policy,code.data[0..code.len],data.data[0..data.len]),"stale profile/Script policy miss",&fail);
    check(fc_key_equal(key,stale_policy)==0,"policy key inequality",&fail);
    modules.data[1].source="fn value() i32 { return 8; }";let stale_dep:ForegroundCacheKey=fc_key("compiler-a","1.0.0","/project-a","main.zag","root",modules,resources,graph,"generic-sse2","sysv-v1","strict-policy");check(1-fc_record_accept(record,stale_dep,code.data[0..code.len],data.data[0..data.len]),"stale dependency miss",&fail);modules.data[1].source="fn value() i32 { return 7; }";
    resources.data[0].data="cyan";let stale_resource:ForegroundCacheKey=fc_key("compiler-a","1.0.0","/project-a","main.zag","root",modules,resources,graph,"generic-sse2","sysv-v1","strict-policy");check(1-fc_record_accept(record,stale_resource,code.data[0..code.len],data.data[0..data.len]),"stale embedded resource miss",&fail);resources.data[0].data="blue";
    let corrupt:ArrayList[u8]=make[u8](4);push[u8](&corrupt,1);push[u8](&corrupt,2);push[u8](&corrupt,4);check(1-fc_record_accept(record,key,corrupt.data[0..corrupt.len],data.data[0..data.len]),"corrupt payload miss",&fail);check(1-fc_record_accept(_zag_str_concat(record,"x"),key,code.data[0..code.len],data.data[0..data.len]),"corrupt record miss",&fail);
    check(1-fc_record_accept(record[0..record.len-1],key,code.data[0..code.len],data.data[0..data.len]),"truncated record miss",&fail);
    let mark:i32=fct_checksum_mark(record);let duplicate_body:[]u8=_zag_str_concat(record[0..mark],_zag_str_concat("compiler=",_zag_str_concat(fc_fields(key.compiler),"\n")));let duplicate:[]u8=fct_sign(duplicate_body);check(1-fc_record_accept(duplicate,key,code.data[0..code.len],data.data[0..data.len]),"duplicate checksum-valid field miss",&fail);
    let wrong_len_body:[]u8=fct_replace(record[0..mark],"code_length=3\n","code_length=4\n");let wrong_len:[]u8=fct_sign(wrong_len_body);check(1-fc_record_accept(wrong_len,key,code.data[0..code.len],data.data[0..data.len]),"checksum-valid length mismatch",&fail);
    let old_record:[]u8=fct_replace(record,"zag-foreground-machine-cache-v4","zag-foreground-machine-cache-v3");check(1-fc_record_accept(old_record,key,code.data[0..code.len],data.data[0..data.len]),"old schema miss",&fail);
    check(zagd_hash_equal(fc_token_identity("fn main()i32{return 7;}"),fc_token_identity("// comment\nfn main ( ) i32 { return 7 ; }"))==1,"comment identity changed",&fail);
    check(zagd_hash_equal(fc_token_identity("fn main()i32{return 7;}"),fc_token_identity("fn main()i32{return 8;}"))==0,"semantic token edit unchanged",&fail);
    check(fc_payload_limit(0)==0&&fc_payload_limit(1024)==1024&&fc_payload_limit(536870912)==268435456,"payload limit bounds",&fail);
    // Exercise token identity over a compiler-sized source. Its Token list
    // crosses the 512 KiB allocator boundary repeatedly, while the per-token
    // integer formatting churns small arenas that can reuse those unmapped
    // addresses. This is the regression for large-map tombstone/small-arena
    // ABA reuse: the hash and final Token-list free must both remain valid.
    let large_source:[]u8=_zag_read_file("selfhost/native/ncodegen.zag");check(large_source.len>524288,"large token-identity fixture",&fail);let large_identity:ZagdHash=fc_token_identity(large_source);check(large_identity.bytes>0,"large token identity",&fail);_zag_free(_zag_slice_ptr(large_source));
    if(fail==0){_zag_println("foreground cache validation: PASS");}return fail;
}
