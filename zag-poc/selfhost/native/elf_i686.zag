// Minimal, deliberately isolated ELF32/i386 milestone writer.
// It emits only Linux process exit for a compiler-validated literal main.
@import("../../std/list.zag")

fn I686_VBASE() i64 { return 134512640; } // 0x08048000
fn I686_HDRS() i64 { return 84; }         // ELF32 ehdr 52 + phdr 32

fn i686_eb(buf: *ArrayList[u8], b: i64) void { push[u8](buf, (b & 255) as u8); }
fn i686_le(buf: *ArrayList[u8], value: i64, count: i32) void {
    let v: i64 = value;
    let i: i32 = 0;
    while (i < count) { i686_eb(buf, v); v = v / 256; i = i + 1; }
}

fn write_i686_literal_exit(path: []u8, status: i64) i32 {
    let text_len: i64 = 12; // mov ebx,imm32; mov eax,1; int 0x80
    let size: i64 = I686_HDRS() + text_len;
    let buf: ArrayList[u8] = make[u8](size as i32);
    i686_eb(&buf,127); i686_eb(&buf,69); i686_eb(&buf,76); i686_eb(&buf,70);
    i686_eb(&buf,1); i686_eb(&buf,1); i686_eb(&buf,1); i686_eb(&buf,0);
    let pad:i32=0; while(pad<8){i686_eb(&buf,0);pad=pad+1;}
    i686_le(&buf,2,2); i686_le(&buf,3,2); i686_le(&buf,1,4);
    i686_le(&buf,I686_VBASE()+I686_HDRS(),4); i686_le(&buf,52,4);
    i686_le(&buf,0,4); i686_le(&buf,0,4); i686_le(&buf,52,2);
    i686_le(&buf,32,2); i686_le(&buf,1,2); i686_le(&buf,0,2);
    i686_le(&buf,0,2); i686_le(&buf,0,2);
    i686_le(&buf,1,4); i686_le(&buf,0,4); i686_le(&buf,I686_VBASE(),4);
    i686_le(&buf,I686_VBASE(),4); i686_le(&buf,size,4); i686_le(&buf,size,4);
    i686_le(&buf,5,4); i686_le(&buf,4096,4);
    i686_eb(&buf,187); i686_le(&buf,status,4); // mov ebx,status
    i686_eb(&buf,184); i686_le(&buf,1,4);      // mov eax,SYS_exit
    i686_eb(&buf,205); i686_eb(&buf,128);      // int 0x80
    return _zag_write_exec(path, buf.data[0..buf.len]);
}

fn write_i686_text(path: []u8, body: ArrayList[u8]) i32 {
    // _start calls main, then converts its i32 return to Linux SYS_exit.
    let startup_len:i64=14;
    let text_len:i64=startup_len+body.len;
    let size:i64=I686_HDRS()+text_len;
    let buf:ArrayList[u8]=make[u8](size as i32);
    i686_eb(&buf,127);i686_eb(&buf,69);i686_eb(&buf,76);i686_eb(&buf,70);
    i686_eb(&buf,1);i686_eb(&buf,1);i686_eb(&buf,1);i686_eb(&buf,0);
    let pad:i32=0;while(pad<8){i686_eb(&buf,0);pad=pad+1;}
    i686_le(&buf,2,2);i686_le(&buf,3,2);i686_le(&buf,1,4);
    i686_le(&buf,I686_VBASE()+I686_HDRS(),4);i686_le(&buf,52,4);
    i686_le(&buf,0,4);i686_le(&buf,0,4);i686_le(&buf,52,2);
    i686_le(&buf,32,2);i686_le(&buf,1,2);i686_le(&buf,0,2);i686_le(&buf,0,2);i686_le(&buf,0,2);
    i686_le(&buf,1,4);i686_le(&buf,0,4);i686_le(&buf,I686_VBASE(),4);i686_le(&buf,I686_VBASE(),4);
    i686_le(&buf,size,4);i686_le(&buf,size,4);i686_le(&buf,5,4);i686_le(&buf,4096,4);
    i686_eb(&buf,0xe8);i686_le(&buf,9,4); // call main after the exit sequence
    i686_eb(&buf,0x89);i686_eb(&buf,0xc3); // mov ebx,eax
    i686_eb(&buf,0xb8);i686_le(&buf,1,4);i686_eb(&buf,0xcd);i686_eb(&buf,0x80);
    let i:i32=0;while(i<body.len){i686_eb(&buf,body.data[i]);i=i+1;}
    return _zag_write_exec(path,buf.data[0..buf.len]);
}
