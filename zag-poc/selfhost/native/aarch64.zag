// selfhost/native/aarch64.zag — AArch64 instruction encoder for Zag's arm64 backend.
//
// Opcodes are packed byte-by-byte (Zag i32 literals overflow above 2^31).

@import("aisa.zag")

fn a_eb(buf: *ArrayList[u8], b: i32) void {
    push[u8](buf, (b % 256) as u8);
}

fn emit_pack(buf: *ArrayList[u8], b0: i32, b1: i32, b2: i32, b3: i32) void {
    a_eb(buf, b0);
    a_eb(buf, b1);
    a_eb(buf, b2);
    a_eb(buf, b3);
}

fn a_lo3(v: i32) i32 { return v % 256; }

fn emit_movz(buf: *ArrayList[u8], rd: i32, imm16: i32, hw: i32) void {
    // MOVZ Xd, #imm16, LSL #(hw*16) = 0xD2800000 | hw<<21 | imm16<<5 | rd
    let low: i32 = imm16 * 32 + rd;
    let b2: i32 = a_lo3(128 + hw * 32 + low / 65536);
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), b2, 210);
}

fn emit_movk(buf: *ArrayList[u8], rd: i32, imm16: i32, hw: i32) void {
    // MOVK Xd, #imm16, LSL #(hw*16) = 0xF2800000 | hw<<21 | imm16<<5 | rd
    let low: i32 = imm16 * 32 + rd;
    let b2: i32 = a_lo3(128 + hw * 32 + low / 65536);
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), b2, 242);
}

fn emit_mov_imm64(buf: *ArrayList[u8], rd: i32, v: i64) void {
    let x: i64 = v;
    let hw: i32 = 0;
    while (hw < 4) {
        let chunk: i64 = x & 65535;
        let imm16: i32 = chunk as i32;
        if (hw == 0) { emit_movz(buf, rd, imm16, hw); }
        else {
            if (imm16 != 0) { emit_movk(buf, rd, imm16, hw); }
        }
        x = (x - chunk) / 65536;
        hw = hw + 1;
    }
}

fn emit_rr(buf: *ArrayList[u8], b3: i32, rd: i32, rn: i32, rm: i32) void {
    let t: i32 = rm * 256;
    let low: i32 = t * 256 + rn * 32 + rd;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(low / 65536), b3);
}

fn emit_imm12(buf: *ArrayList[u8], b3: i32, rd: i32, rn: i32, imm12: i32) void {
    let low: i32 = imm12 * 1024 + rn * 32 + rd;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(low / 65536), b3);
}

fn emit_add_rr(buf: *ArrayList[u8], rd: i32, rn: i32, rm: i32) void { emit_rr(buf, 139, rd, rn, rm); }
fn emit_sub_rr(buf: *ArrayList[u8], rd: i32, rn: i32, rm: i32) void { emit_rr(buf, 203, rd, rn, rm); }
// ADD/SUB immediate. Values > 4095 use the LSL-#12 shifted form for the high
// chunk (bit 22 → +64 in byte2) followed by the low 12 bits — two instructions.
fn emit_imm12_sh(buf: *ArrayList[u8], b3: i32, rd: i32, rn: i32, imm12: i32) void {
    let low: i32 = imm12 * 1024 + rn * 32 + rd;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(64 + low / 65536), b3);
}
fn emit_addsub_imm(buf: *ArrayList[u8], b3: i32, rd: i32, rn: i32, v: i32) void {
    if (v <= 4095) { emit_imm12(buf, b3, rd, rn, v); return; }
    let hi: i32 = v / 4096;
    let lo: i32 = v % 4096;
    emit_imm12_sh(buf, b3, rd, rn, hi);
    if (lo > 0) { emit_imm12(buf, b3, rd, rd, lo); }
}
fn emit_add_imm(buf: *ArrayList[u8], rd: i32, rn: i32, imm12: i32) void { emit_addsub_imm(buf, 145, rd, rn, imm12); }
fn emit_sub_imm(buf: *ArrayList[u8], rd: i32, rn: i32, imm12: i32) void { emit_addsub_imm(buf, 209, rd, rn, imm12); }
fn emit_mul(buf: *ArrayList[u8], rd: i32, rn: i32, rm: i32) void {
    // MADD Xd, Xn, Xm, XZR
    let low: i32 = rd + rn * 32 + 31 * 1024 + rm * 65536;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(low / 65536), 155);
}
fn emit_umulh(buf: *ArrayList[u8], rd: i32, rn: i32, rm: i32) void {
    // UMULH Xd, Xn, Xm = 0x9BC07C00 | Rm<<16 | Rn<<5 | Rd.
    let low: i32 = rd + rn * 32 + 31744;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(192 + rm + low / 65536), 155);
}
fn emit_sdiv(buf: *ArrayList[u8], rd: i32, rn: i32, rm: i32) void {
    // SDIV Xd, Xn, Xm = 0x9AC00C00 | rm<<16 | rn<<5 | rd
    let low: i32 = rd + rn * 32 + 3072;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(192 + rm), 154);
}
fn emit_udiv(buf: *ArrayList[u8], rd: i32, rn: i32, rm: i32) void {
    // UDIV Xd, Xn, Xm = 0x9AC00800 | rm<<16 | rn<<5 | rd.  SDIV is
    // 0x9AC00C00 (opcode field 000011); UDIV is 000010, i.e. 1024 LOWER.
    // Adding 0x4000 here would encode CRC32X (0x9AC04C00) instead.
    let low: i32 = rd + rn * 32 + 2048;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(192 + rm), 154);
}
fn emit_cmp_rr(buf: *ArrayList[u8], rn: i32, rm: i32) void {
    let t: i32 = rm * 256;
    let low: i32 = t * 256 + rn * 32 + 31;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(low / 65536), 235);
}
fn emit_cmp_imm(buf: *ArrayList[u8], rn: i32, imm12: i32) void { emit_imm12(buf, 241, 31, rn, imm12); }
fn emit_orr(buf: *ArrayList[u8], rd: i32, rm: i32) void {
    // ORR Xd, XZR, Xm
    emit_rr(buf, 170, rd, 31, rm);
}
fn emit_neg(buf: *ArrayList[u8], rd: i32, rm: i32) void {
    // SUB Xd, XZR, Xm
    emit_rr(buf, 203, rd, 31, rm);
}
fn emit_and_rr(buf: *ArrayList[u8], rd: i32, rn: i32, rm: i32) void { emit_rr(buf, 138, rd, rn, rm); }
fn emit_eor_rr(buf: *ArrayList[u8], rd: i32, rn: i32, rm: i32) void { emit_rr(buf, 202, rd, rn, rm); }
fn emit_orr_rr(buf: *ArrayList[u8], rd: i32, rn: i32, rm: i32) void { emit_rr(buf, 170, rd, rn, rm); }
fn emit_lslv(buf: *ArrayList[u8], rd: i32, rn: i32, rm: i32) void {
    // LSLV Xd, Xn, Xm = 0x9AC02000 | rm<<16 | rn<<5 | rd
    let low: i32 = rd + rn * 32 + 8192;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(192 + rm), 154);
}
fn emit_asrv(buf: *ArrayList[u8], rd: i32, rn: i32, rm: i32) void {
    // ASRV Xd, Xn, Xm = 0x9AC02800 | rm<<16 | rn<<5 | rd
    let low: i32 = rd + rn * 32 + 10240;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(192 + rm), 154);
}
fn emit_lsrv(buf: *ArrayList[u8], rd: i32, rn: i32, rm: i32) void {
    // LSRV Xd, Xn, Xm = 0x9AC02400 | rm<<16 | rn<<5 | rd
    let low: i32 = rd + rn * 32 + 9216;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(192 + rm), 154);
}

// ARMv8.0 acquire/release and exclusive 64-bit operations.  These are used
// instead of ARMv8.1 LSE so the generated Mach-O runs on the complete arm64
// baseline supported by macOS.
fn emit_ldar(buf: *ArrayList[u8], rt: i32, rn: i32) void {
    emit_pack(buf, rt + (rn % 8) * 32, 252 + rn / 8, 223, 200);
}
fn emit_stlr(buf: *ArrayList[u8], rt: i32, rn: i32) void {
    emit_pack(buf, rt + (rn % 8) * 32, 252 + rn / 8, 159, 200);
}
fn emit_ldaxr(buf: *ArrayList[u8], rt: i32, rn: i32) void {
    emit_pack(buf, rt + (rn % 8) * 32, 252 + rn / 8, 95, 200);
}
fn emit_stlxr(buf: *ArrayList[u8], rs: i32, rt: i32, rn: i32) void {
    emit_pack(buf, rt + (rn % 8) * 32, 252 + rn / 8, rs, 200);
}

fn emit_ldr_uoff(buf: *ArrayList[u8], rd: i32, rn: i32, off: i32) void {
    // LDR Xt, [Xn, #imm12*8] = 0xF9400000 | imm12<<10 | rn<<5 | rt
    let imm12: i32 = off / 8;
    let low: i32 = imm12 * 1024 + rn * 32 + rd;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(64 + low / 65536), 249);
}

fn emit_str_uoff(buf: *ArrayList[u8], rt: i32, rn: i32, off: i32) void {
    // STR Xt, [Xn, #imm12*8] = 0xF9000000 | imm12<<10 | rn<<5 | rt
    let imm12: i32 = off / 8;
    let low: i32 = imm12 * 1024 + rn * 32 + rt;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(low / 65536), 249);
}

// Build base+disp without silently truncating a displacement that does not fit
// either the unsigned-scaled or signed-unscaled memory encoding. X16/X17 are
// the backend's reserved intra-procedure scratch registers, but an encoder
// input may itself name either register. Loads can use their destination as the
// temporary address; stores select a scratch that does not destroy the value.
fn emit_adjust_address(buf: *ArrayList[u8], reg: i32, delta: i64) void {
    let remaining: i64 = delta;
    let add: i32 = 1;
    if (remaining < 0) { remaining = 0 - remaining; add = 0; }
    // One ADD/SUB immediate can encode 4095<<12 plus 4095. Looping also makes
    // the fallback correct for the complete signed i32 displacement domain.
    while (remaining > 0) {
        let chunk: i64 = remaining;
        if (chunk > 16777215) { chunk = 16777215; }
        if (add == 1) { emit_add_imm(buf, reg, reg, chunk as i32); }
        else { emit_sub_imm(buf, reg, reg, chunk as i32); }
        remaining = remaining - chunk;
    }
}

fn emit_materialize_address(buf: *ArrayList[u8], addr: i32, base: i32, off: i32) void {
    if (addr != base) { emit_add_imm(buf, addr, base, 0); }
    emit_adjust_address(buf, addr, off as i64);
}

fn a_load_address_register(dst: i32, base: i32) i32 {
    // The loaded value may replace its own address temporary. If dst==base,
    // retain the base until the final load by using the other reserved IP reg.
    if (dst != base && dst != A_SP()) { return dst; }
    if (base != A_X16()) { return A_X16(); }
    return A_X17();
}

fn a_store_address_register(base: i32, value: i32) i32 {
    if (base != A_X16() && value != A_X16()) { return A_X16(); }
    if (base != A_X17() && value != A_X17()) { return A_X17(); }
    // Both reserved registers are operands. They must be distinct here (if
    // base==value, the other candidate above was free), so adjust the base in
    // place and restore it immediately after the store.
    return base;
}

fn emit_ldr_soff(buf: *ArrayList[u8], rd: i32, rn: i32, off: i32) void {
    // LDUR Xt, [Xn, #simm9] = 0xF8400000 | (simm9&511)<<12 | rn<<5 | rt (byte offset)
    if (off >= 0 && (off % 8) == 0 && off <= 32760) {
        emit_ldr_uoff(buf, rd, rn, off);
        return;
    }
    if (off < 0 - 256 || off > 255) {
        let addr: i32 = a_load_address_register(rd, rn);
        emit_materialize_address(buf, addr, rn, off);
        emit_ldr_uoff(buf, rd, addr, 0);
        return;
    }
    let simm: i32 = off;
    if (simm < 0) { simm = simm + 512; }
    let low: i32 = simm * 4096 + rn * 32 + rd;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(64 + low / 65536), 248);
}

fn emit_str_soff(buf: *ArrayList[u8], rt: i32, rn: i32, off: i32) void {
    // STUR Xt, [Xn, #simm9] = 0xF8000000 | (simm9&511)<<12 | rn<<5 | rt (byte offset)
    if (off >= 0 && (off % 8) == 0 && off <= 32760) {
        emit_str_uoff(buf, rt, rn, off);
        return;
    }
    if (off < 0 - 256 || off > 255) {
        let addr: i32 = a_store_address_register(rn, rt);
        emit_materialize_address(buf, addr, rn, off);
        emit_str_uoff(buf, rt, addr, 0);
        if (addr == rn) { emit_adjust_address(buf, addr, 0 - (off as i64)); }
        return;
    }
    let simm: i32 = off;
    if (simm < 0) { simm = simm + 512; }
    let low: i32 = simm * 4096 + rn * 32 + rt;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(low / 65536), 248);
}

fn emit_ldrq_uoff(buf: *ArrayList[u8], vt: i32, rn: i32, off: i32) void {
    // LDR Qt, [Xn, #imm12*16] = 0x3DC00000 | imm12<<10 | rn<<5 | vt
    let imm12: i32 = off / 16;
    let low: i32 = imm12 * 1024 + rn * 32 + vt;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256),
        a_lo3(192 + low / 65536), 61);
}

fn emit_strq_uoff(buf: *ArrayList[u8], vt: i32, rn: i32, off: i32) void {
    // STR Qt, [Xn, #imm12*16] = 0x3D800000 | imm12<<10 | rn<<5 | vt
    let imm12: i32 = off / 16;
    let low: i32 = imm12 * 1024 + rn * 32 + vt;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256),
        a_lo3(128 + low / 65536), 61);
}

// LDR/STR Qt with a register index, `[Xn, Xm, LSL #s]`:
//   00 111 V 00 opc 1 Rm(20:16) option(15:13) S(12) 10 Rn(9:5) Rt(4:0)
// with size = 00 selecting the 128-bit access, option = 011 selecting an
// unscaled X-register index, opc = 00 for LDR and 10 for STR, and S = 0/1 giving
// LSL #0 / LSL #4.
//
// A64 spends the whole `size` field on "this is a 128-bit access", which leaves
// only two architecturally defined index scales for it: the access size itself
// (0) and a whole vector (4).  An i32 element stride is LSL #2 and has NO
// encoding in this form.  Rather than emit a wrong instruction the emitter
// rejects it (returns 1, emits nothing) and the lowering must use LD1/ST1 below,
// whose element-scaled index is what an auto-vectorized `a[i]` actually needs.
fn emit_ldrq_index(buf: *ArrayList[u8], store: i32, vt: i32,
                   rn: i32, rm: i32, amount: i32) i32 {
    if (rn == A_SP()) { return 1; }        // the register-offset form has no SP base
    if (rm < 0 || rm > 30) { return 1; }   // 31 is XZR, never a legal index
    if (vt < 0 || vt > 31) { return 1; }   // also rejects a virtual vector number
    let sb: i32 = 0;
    if (amount != 0) { sb = 4096; }
    let low: i32 = 3 * 8192 + sb + 2 * 1024 + rn * 32 + vt;
    let b2: i32 = 0;
    if (store == 1) { b2 = 160 + rm; } else { b2 = 224 + rm; }
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(b2), 60);
    return 0;
}

// LD1/ST1 of one vector register, post-indexed by a register:
//   0 Q 0 01110 0 1 L 000000 1 Rm(20:16) 110 L(14:13) S(12) Rn(9:5) Rt(4:0)
// L = log2(element bytes) is the SCALE, not a selector: the hardware multiplies
// the index by it, so `ld1 {v0.4s},[x1],x2` means address x1 with the index
// multiplied by four.  There is no separate LSL field and no displacement, and
// S = 1 makes this post-indexed — the base register is WRITTEN BACK with the
// scaled index.  opc splits the two directions: bits 23:21 = 110 for LD1 and
// 100 for ST1, and an index of 31 would mean "no index" (bits 23:21 = 010).
fn emit_ld1_st1(buf: *ArrayList[u8], store: i32, e: i32,
                 vt: i32, rn: i32, rm: i32) i32 {
    if (av_elem_ok(e) == 0) { return 1; }
    if (vt < 0 || vt > 31) { return 1; }   // also rejects a virtual vector number
    if (rn < 0 || rn > 31) { return 1; }
    let l: i32 = 0;
    if (e == 2) { l = 1; }
    else if (e == 4) { l = 2; }
    else if (e == 8) { l = 3; }
    let low: i32 = (112 + l * 4) * 256 + rn * 32 + vt;
    let b2: i32 = 0;
    if (rm == 31) { b2 = 64; }             // no index: bits 23:21 = 010
    else if (store == 1) { b2 = 128 + rm; }
    else { b2 = 192 + rm; }
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(b2), 76);
    return 0;
}

// ADD Xd, Xn, Xm, LSL #amount — the address materialization a scaled index needs
// when a displacement must be folded in as well.  0x8B000000 | amount<<10 |
// Rm<<16 | Rn<<5 | Rd, with `shift` = 00 meaning LSL.  Rn must be a general
// register: in this encoding 31 reads as XZR, not SP.
fn emit_add_lsl(buf: *ArrayList[u8], rd: i32, rn: i32, rm: i32, amount: i32) void {
    let low: i32 = rd + rn * 32 + amount * 1024 + rm * 65536;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(rm), 139);
}

fn emit_ldrq(buf: *ArrayList[u8], vt: i32, rn: i32, off: i32) void {
    if (off >= 0 && (off % 16) == 0 && off <= 65520) {
        emit_ldrq_uoff(buf, vt, rn, off);
        return;
    }
    emit_add_imm(buf, A_X17(), rn, 0);
    emit_mov_imm64(buf, A_X16(), off as i64);
    emit_add_rr(buf, A_X17(), A_X17(), A_X16());
    emit_ldrq_uoff(buf, vt, A_X17(), 0);
}

fn emit_strq(buf: *ArrayList[u8], vt: i32, rn: i32, off: i32) void {
    if (off >= 0 && (off % 16) == 0 && off <= 65520) {
        emit_strq_uoff(buf, vt, rn, off);
        return;
    }
    emit_add_imm(buf, A_X17(), rn, 0);
    emit_mov_imm64(buf, A_X16(), off as i64);
    emit_add_rr(buf, A_X17(), A_X17(), A_X16());
    emit_strq_uoff(buf, vt, A_X17(), 0);
}

// LDR/STR Qt with the descriptor's optional index register.  Three shapes, in
// order of preference:
//   1. index present, no displacement, base is a GPR -> one register-offset
//      instruction, `[Xn, Xm, LSL #0 or #4]` (see emit_ldrq_index);
//   2. index present with a displacement, or an SP base (which the
//      register-offset form forbids) -> materialize base+index<<#s into X17 and
//      fall back to the ordinary displacement path.  X16/X17 are the backend's
//      reserved intra-procedure scratch registers;
//   3. no index -> the historical displacement-only encoding, byte for byte.
// An index scale A64 has no 128-bit encoding for is rejected outright: this
// returns 1 having emitted nothing, and the caller records the error.
fn emit_ldrq_disp_index(buf: *ArrayList[u8], store: i32, vt: i32, rn: i32,
                        rm: i32, amount: i32, off: i32) i32 {
    if (rm < 0) { return 0 - 1; }               // caller uses the plain path
    if (amount != 0 && amount != 4) { return 1; }
    if (off == 0 && rn != A_SP()) {
        return emit_ldrq_index(buf, store, vt, rn, rm, amount);
    }
    // Materializing needs a scratch base plus a scratch temporary, and the index
    // has to survive that arithmetic, so it may not be one of them.
    if (rm == A_X16() || rm == A_X17()) { return 1; }
    if (rn == A_SP()) {
        // ADD (shifted register) reads Rn as XZR when it is 31, never as SP, so
        // an SP base is copied into a general register first.
        emit_add_imm(buf, A_X16(), A_SP(), 0);
        emit_add_lsl(buf, A_X17(), A_X16(), rm, amount);
    } else {
        emit_add_lsl(buf, A_X17(), rn, rm, amount);
    }
    if (store == 1) { emit_strq(buf, vt, A_X17(), off); }
    else { emit_ldrq(buf, vt, A_X17(), off); }
    return 0;
}

// ── Advanced SIMD: derived arrangements ──────────────────────────────────────
// A64 never spells a vector width in a mnemonic: one `Q` bit and a two-bit field
// select the arrangement, and the same opcode byte serves `.16b`, `.8h`, `.4s`
// and `.2d`.  So the encoder DERIVES that field from the two facts the vector
// contract already fixes — the width class (VW_128/VW_256/VW_512) and the element
// width — instead of hardcoding `.4S` the way the pre-vector backend did.  The
// payoff is that the ISA layer stops being special-cased to four lanes of i32:
// one emitter now serves every arrangement A64 actually has, and a request the
// backend cannot execute (a width class above 128 bits, an element width with no
// `size` code) comes back as a recorded error instead of silently wrong bytes.
fn a_arrangement(w: i32, e: i32) i32 {
    // Advanced SIMD is architecturally mandatory on AArch64, so there is no
    // runtime feature gate here; the only limit is that this backend implements
    // the 128-bit Q form.  `zvec_wclass_lanes(VW_128())` being 4 is exactly that
    // statement: 4 lanes of 32-bit-equivalent width. Note those are UNITS, not
    // elements -- under Zag's 8-byte stride a `*i32` vector of 2 elements already
    // fills a Q register, and a `*i16` vector of 4 does too.  256/512-bit Advanced
    // SIMD is SVE and is out of scope, so those width classes fail closed here.
    if (w != VW_128()) { return 0 - 1; }
    if (e == 1) { return 0; }   // 16B
    if (e == 2) { return 1; }   // 8H
    if (e == 4) { return 2; }   // 4S
    if (e == 8) { return 3; }   // 2D
    return 0 - 1;
}

// The A64 FP three-same group does not use bits 23:22 as a plain lane size: for
// FADD/FMUL/FDIV/FCMEQ/FCMGE the field is `elem_bytes/4` (0 = 4S, 1 = 2D) while
// the negate-form opcodes FSUB and FCMGT also set bit 23, i.e. `elem_bytes/2`
// (2 = 4S, 3 = 2D).  Both halves were read straight out of the assembler; see the
// byte-for-byte table in tests/zz_armvec_probe's successor test.
fn a_fp_size_field(e: i32, negate_form: i32) i32 {
    if (e == 4) {
        if (negate_form == 1) { return 2; }
        return 0;
    }
    if (e == 8) {
        if (negate_form == 1) { return 3; }
        return 1;
    }
    return 0 - 1;
}

// The shared "Advanced SIMD three same / three different" core:
//   Q(30) U(29) 01110(28:24) sfield(23:22) 1(21) Vm(20:16) op(15:10) Rn(9:5) Vd(4:0)
// `b3` supplies 0x4E (Q=1,U=0) or 0x6E (Q=1,U=1); `op` is the raw six-bit
// bits-15:10 field.  Every arrangement-sensitive vector kind funnels through here,
// which is what makes AK_VADD_I32 and AK_VADD the same machine operation at
// different lane widths.
fn emit_vthree(buf: *ArrayList[u8], b3: i32, sfield: i32, op: i32,
                vd: i32, vn: i32, vm: i32) void {
    let low: i32 = op * 1024 + vn * 32 + vd;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(sfield * 64 + 32 + vm), b3);
}

// Shared guard for every vector kind: the width class must be executable here,
// the element width must be one A64 has a `size` code for (a zero element width
// means the caller did not say, and `def` supplies the kind's own default), and
// the three register operands must be real Q registers.  Returns 0 when the
// combination is encodable and 1 when it is not — the caller then emits nothing
// and records the kind as an error rather than producing a partial encoding.
fn av_check(w: i32, e: i32, def: i32, vd: i32, vn: i32, vm: i32) i32 {
    let elem: i32 = e;
    if (elem == 0) { elem = def; }
    if (av_elem_ok(elem) == 0) { return 1; }
    if (a_arrangement(w, elem) < 0) { return 1; }
    if (vd < 0 || vd > 31) { return 1; }
    if (vn < 0 || vn > 31) { return 1; }
    if (vm < 0 || vm > 31) { return 1; }
    return 0;
}

fn emit_vector_logic(buf: *ArrayList[u8], high: i32, middle: i32,
                     vd: i32, vn: i32, vm: i32) void {
    let low: i32 = 7168 + vn * 32 + vd;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), middle + vm, high);
}

// ── the width-parameteric elementwise kinds ─────────────────────────────────
// Every emitter here takes the descriptor's width class and element width and
// emits the matching arrangement.  `op` and `b3` are the as-assembled opcode
// fields; the arrangement is `a_arrangement`.
//
//   AK_VADD_I32 / AK_VSUB_I32   add/sub  op=100001 U=0/1     all of 16B/8H/4S/2D
//   AK_VMUL                     mul      op=100111 U=0      16B/8H/4S only
//   AK_VSHL                     ushl     op=010001 U=1      all four
//   AK_VCMGT/CMEQ/CMGE          cmgt/cmeq/cmge             all four
//   AK_VFADD/FSUB/FMUL/FDIV     f*       all four           4S/2D only
//   AK_VFCMGT/FCMEQ             fcmgt/fcmeq                4S/2D only
fn emit_vaddsub(buf: *ArrayList[u8], u_bit: i32, w: i32, e: i32,
                 vd: i32, vn: i32, vm: i32) i32 {
    let elem: i32 = e;
    if (elem == 0) { elem = 4; }
    if (av_check(w, elem, 4, vd, vn, vm) != 0) { return 1; }
    let s: i32 = a_arrangement(w, elem);
    let b3: i32 = 78;
    if (u_bit == 1) { b3 = 110; }
    emit_vthree(buf, b3, s, 33, vd, vn, vm);
    return 0;
}

// A64 has no `mul v.2d`: 64-bit integer multiply needs SMULL/UMULL plus a pair
// add, which is out of scope here, so the emitter refuses it instead of
// substituting a 32-bit multiply.  16B/8H/4S all encode.
fn emit_vmul(buf: *ArrayList[u8], w: i32, e: i32,
              vd: i32, vn: i32, vm: i32) i32 {
    let elem: i32 = e;
    if (elem == 0) { elem = 4; }
    if (av_check(w, elem, 4, vd, vn, vm) != 0) { return 1; }
    if (elem == 8) { return 1; }
    emit_vthree(buf, 78, a_arrangement(w, elem), 39, vd, vn, vm);
    return 0;
}

// USHL shifts each lane left by the amount in the low bits of the matching lane
// of Vm.  `vector.shl` carries an unsigned magnitude, so USHL is the correct
// choice: SSHL would read a negative splat as a request to shift right.
fn emit_vshl(buf: *ArrayList[u8], w: i32, e: i32,
             vd: i32, vn: i32, vm: i32) i32 {
    let elem: i32 = e;
    if (elem == 0) { elem = 4; }
    if (av_check(w, elem, 4, vd, vn, vm) != 0) { return 1; }
    emit_vthree(buf, 110, a_arrangement(w, elem), 17, vd, vn, vm);
    return 0;
}

// A64 FP elementwise.  `negate_form` selects the FSUB/FCMGT `size` bias.
fn emit_vfp(buf: *ArrayList[u8], b3: i32, op: i32, negate_form: i32, w: i32, e: i32,
            vd: i32, vn: i32, vm: i32) i32 {
    let elem: i32 = e;
    if (elem == 0) { elem = 4; }
    if (av_check(w, elem, 4, vd, vn, vm) != 0) { return 1; }
    if (elem == 1 || elem == 2) { return 1; }   // no half/single-byte FP in A64 NEON
    let s: i32 = a_fp_size_field(elem, negate_form);
    emit_vthree(buf, b3, s, op, vd, vn, vm);
    return 0;
}

// Integer and float compares.  Each writes an all-ones / all-zeros lane mask,
// which is the machine form of the IR's `vector<i1,lanes>` and the operand AK_VBSL
// expects.  A float compare derives its bits 23:22 from a_fp_size_field, so
// FCMGT (the negate form) and FCMEQ do not share a field value.
fn emit_vcmp(buf: *ArrayList[u8], b3: i32, op: i32, fp: i32, negate_form: i32,
             w: i32, e: i32, vd: i32, vn: i32, vm: i32) i32 {
    let elem: i32 = e;
    if (elem == 0) { elem = 4; }
    if (av_check(w, elem, 4, vd, vn, vm) != 0) { return 1; }
    let s: i32 = a_arrangement(w, elem);
    if (fp == 1) {
        s = a_fp_size_field(elem, negate_form);
    }
    if (s < 0) { return 1; }   // A64 has no half/single-byte float compare
    emit_vthree(buf, b3, s, op, vd, vn, vm);
    return 0;
}

// "Advanced SIMD shift by immediate":
//   0 Q U 01111 0 immh:immb(22:16) op(15:10) Rn(9:5) Rd(4:0)
// The seven-bit shift field carries `elem_bits + amount` for the left shift and
// `2*elem_bits - amount` for the two right shifts — the assembler-derived layout,
// not a guessed one.  op = 010101 for SHL and 000001 for USHR/SSHR, and U
// separates the logical right shift from the arithmetic one.
//
// A64 has no by-register right shift, so `vector.shr` must reach the lowering as
// a splat constant in the descriptor; a dynamic per-lane count has no encoding.
fn emit_vshift_imm(buf: *ArrayList[u8], u_bit: i32, op: i32, right: i32,
                    w: i32, e: i32, amount: i32, vd: i32, vn: i32) i32 {
    let elem: i32 = e;
    if (elem == 0) { elem = 4; }
    if (av_check(w, elem, 4, vd, vn, 0) != 0) { return 1; }
    if (elem != 4 && elem != 8) { return 1; }
    let bits: i32 = elem * 8;
    if (amount < 0) { return 1; }
    if (right == 1) {
        // A64 encodes the right shifts as 1..elem_bits; #0 is not a legal ushr.
        if (amount < 1 || amount > bits) { return 1; }
    } else {
        if (amount > bits - 1) { return 1; }
    }
    let field: i32 = 0;
    if (right == 1) { field = 2 * bits - amount; } else { field = bits + amount; }
    if (field < 0 || field > 127) { return 1; }
    let b3: i32 = 79;
    if (u_bit == 1) { b3 = 111; }
    let low: i32 = op * 1024 + vn * 32 + vd;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(field), b3);
    return 0;
}

// DUP (general) — splat a GPR into every lane.
//   0 Q 0 01110 000 0010000 1 imm5(20:16) 000011 Rn(9:5) Rd(4:0)
// imm5 is the destination size in bytes, so bits 15:8 are the constant 0x0C and
// bits 20:16 are the element width; a 64-bit element width names a 64-bit source
// register, anything narrower names the low 32 bits.
fn emit_vdup_gpr(buf: *ArrayList[u8], w: i32, e: i32,
                  vd: i32, rn: i32) i32 {
    let elem: i32 = e;
    if (elem == 0) { elem = 4; }
    if (av_check(w, elem, 4, vd, rn, 0) != 0) { return 1; }
    if (rn < 0 || rn > 31) { return 1; }
    emit_pack(buf, rn * 32 + vd, 12, a_lo3(elem), 78);
    return 0;
}

// DUP (element) — broadcast one lane of Vn across Vd.
//   0 Q 0 01110 000 imm5(20:16) 000001 Rn(9:5) Rd(4:0)
// imm5 = elem_bytes * (2*lane + 1) in bits 20:16, with bits 15:8 holding 0x04.
// `vector.broadcast` is this; `vector.splat` from a constant is DUP (general).
fn emit_vdup_lane(buf: *ArrayList[u8], w: i32, e: i32, lane: i32,
                   vd: i32, vn: i32) i32 {
    let elem: i32 = e;
    if (elem == 0) { elem = 4; }
    if (av_check(w, elem, 4, vd, vn, 0) != 0) { return 1; }
    let lanes: i32 = zvec_wclass_bytes(w) / elem;
    if (lane < 0 || lane >= lanes) { return 1; }
    emit_pack(buf, vn * 32 + vd, 4, a_lo3(elem * (2 * lane + 1)), 78);
    return 0;
}

// UMOV / MOV (from SIMD) — `vector.extract`.
//   0 Q opc 01110 000 imm5(20:16) 000111 Rn(9:5) Rd(4:0)
// Same imm5 shape as DUP (element); bits 15:8 are the constant 0x3C and the Q bit
// says whether the destination is a 64-bit (X) or 32-bit (W) GPR.
fn emit_vextract(buf: *ArrayList[u8], w: i32, e: i32, lane: i32,
                  rd: i32, vn: i32) i32 {
    let elem: i32 = e;
    if (elem == 0) { elem = 4; }
    if (av_check(w, elem, 4, vn, 0, 0) != 0) { return 1; }
    let lanes: i32 = zvec_wclass_bytes(w) / elem;
    if (lane < 0 || lane >= lanes) { return 1; }
    if (rd < 0 || rd > 31) { return 1; }
    let b3: i32 = 14;
    if (elem == 8) { b3 = 78; }
    emit_pack(buf, vn * 32 + rd, 60, a_lo3(elem * (2 * lane + 1)), b3);
    return 0;
}

// INS (element) — `vector.insert`.
//   0 Q 0 01110 000 imm5(20:16) 001100 Rn(9:5) Rd(4:0)
// imm5 as above; bits 15:8 are the constant 0x1C.  Rn is the GPR source and Rd
// the vector destination.
fn emit_vinsert(buf: *ArrayList[u8], w: i32, e: i32, lane: i32,
                 rd: i32, rn: i32) i32 {
    let elem: i32 = e;
    if (elem == 0) { elem = 4; }
    if (av_check(w, elem, 4, rd, 0, 0) != 0) { return 1; }
    let lanes: i32 = zvec_wclass_bytes(w) / elem;
    if (lane < 0 || lane >= lanes) { return 1; }
    if (rn < 0 || rn > 31) { return 1; }
    emit_pack(buf, rn * 32 + rd, 28, a_lo3(elem * (2 * lane + 1)), 78);
    return 0;
}

// MOVI Vd.<T>, #0 — the zero constant of a given arrangement.  The two families
// differ in more than spelling: 2D has no 8-bit immediate form, so it uses the
// shifted 16-bit encoding, which is what sets bit 29 in the top byte.
fn emit_vzero(buf: *ArrayList[u8], w: i32, e: i32, vd: i32) i32 {
    let elem: i32 = e;
    if (elem == 0) { elem = 4; }
    if (av_check(w, elem, 4, vd, 0, 0) != 0) { return 1; }
    let b3: i32 = 79;
    let b1: i32 = 4;
    if (elem == 1) { b1 = 228; }
    else if (elem == 2) { b1 = 132; }
    else if (elem == 4) { b1 = 4; }
    else { b3 = 111; b1 = 228; }
    emit_pack(buf, vd, b1, 0, b3);
    return 0;
}

// MVN Vd.16B, Vn.16B — the all-ones constant.  A64 has no all-ones immediate for
// the 32-bit and narrower arrangements, so the canonical form is the bitwise NOT
// of a zero vector, and the lowering is expected to have produced one (see
// ai_vones).  op = 010110, U = 1, and bits 23:22 = 00 select the 16B form: the
// bitwise group has no per-lane arrangement at all, which is exactly why
// AK_VAND/ORR/EOR derive their encoding from the width class alone.
fn emit_vones(buf: *ArrayList[u8], w: i32, e: i32, vd: i32, vn: i32) i32 {
    if (av_check(w, 1, 1, vd, vn, 0) != 0) { return 1; }
    emit_vthree(buf, 110, 0, 22, vd, vn, 0);
    return 0;
}

// BSL / BIT — the three-source bitwise-select and bitwise-insert forms, the A64
// idiom behind `vector.select`.  A64 has no masked-select instruction: BSL
// computes dst = (Vn & dst) | (Vm & ~dst) from the mask already in dst, so the
// lowering must place the compare result in the destination register.  BIT
// computes dst |= Vn & Vm.  Both are op = 000111 with the `size` field used as a
// sub-opcode: 01 for BSL, 10 for BIT, over the arrangement-free 16B form.
fn emit_vbsl(buf: *ArrayList[u8], bit_form: i32, w: i32,
              vd: i32, vn: i32, vm: i32) i32 {
    if (av_check(w, 1, 1, vd, vn, vm) != 0) { return 1; }
    let s: i32 = 1;
    if (bit_form == 1) { s = 2; }
    emit_vthree(buf, 110, s, 7, vd, vn, vm);
    return 0;
}

fn emit_prefetch_l1_keep(buf: *ArrayList[u8], rn: i32) void {
    // PRFM PLDL1KEEP,[Xn] = 0xF9800000 | Rn<<5.
    let low: i32 = rn * 32;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), 128, 249);
}

fn emit_data1_64(buf: *ArrayList[u8], op16: i32, rd: i32, rn: i32) void {
    // REV/CLZ/RBIT share the data-processing (1 source) encoding family:
    // 0xDAC00000 | opcode-in-low16 | Rn<<5 | Rd.
    let low: i32 = op16 + rn * 32 + rd;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), 192, 218);
}

fn emit_bic64(buf: *ArrayList[u8], rd: i32, rn: i32, rm: i32) void {
    // BIC Xd,Xn,Xm = 0x8A200000 | Rm<<16 | Rn<<5 | Rd.
    let low: i32 = rn * 32 + rd;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), 32 + rm, 138);
}

fn emit_vcnt(buf: *ArrayList[u8], vd: i32, vn: i32) void {
    let low: i32 = 22528 + vn * 32 + vd;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), 32, 78);
}

fn emit_vaddv_b(buf: *ArrayList[u8], vd: i32, vn: i32) void {
    let low: i32 = 47104 + vn * 32 + vd;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), 49, 78);
}

fn emit_vumov_b(buf: *ArrayList[u8], rd: i32, vn: i32) void {
    let low: i32 = 15360 + vn * 32 + rd;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), 1, 14);
}

fn emit_b(buf: *ArrayList[u8], imm26: i32) void {
    let low: i32 = imm26 & 67108863;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(low / 65536), 20 + low / 16777216);
}

fn emit_bl(buf: *ArrayList[u8], imm26: i32) void {
    let low: i32 = imm26 & 67108863;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(low / 65536), 148 + low / 16777216);
}

// FP data-processing (double precision). rd/rn/rm are D-register numbers.
fn emit_fp2(buf: *ArrayList[u8], op10: i32, rd: i32, rn: i32, rm: i32) void {
    // 0x1E600800-style: 0001 1110 011 rm  opcode(4)«12» 10 rn rd
    let low: i32 = rd + rn * 32 + op10 * 2048 + rm * 65536;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(96 + rm), 30);
}
fn emit_fadd(buf: *ArrayList[u8], rd: i32, rn: i32, rm: i32) void {
    // FADD Dd,Dn,Dm = 0x1E602800 | rm<<16 | rn<<5 | rd
    let low: i32 = rd + rn * 32 + 10240;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(96 + rm), 30);
}
fn emit_fsub(buf: *ArrayList[u8], rd: i32, rn: i32, rm: i32) void {
    // FSUB = 0x1E603800
    let low: i32 = rd + rn * 32 + 14336;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(96 + rm), 30);
}
fn emit_fmul(buf: *ArrayList[u8], rd: i32, rn: i32, rm: i32) void {
    // FMUL = 0x1E600800
    let low: i32 = rd + rn * 32 + 2048;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(96 + rm), 30);
}
fn emit_fdiv(buf: *ArrayList[u8], rd: i32, rn: i32, rm: i32) void {
    // FDIV = 0x1E601800
    let low: i32 = rd + rn * 32 + 6144;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(96 + rm), 30);
}
fn emit_fcmp(buf: *ArrayList[u8], rn: i32, rm: i32) void {
    // FCMP Dn,Dm = 0x1E602000 | rm<<16 | rn<<5
    let low: i32 = rn * 32 + 8192;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(96 + rm), 30);
}
fn emit_fmov_dx(buf: *ArrayList[u8], rd: i32, rn: i32) void {
    // FMOV Dd, Xn = 0x9E670000 | rn<<5 | rd
    let low: i32 = rd + rn * 32;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), 103, 158);
}
fn emit_fmov_xd(buf: *ArrayList[u8], rd: i32, rn: i32) void {
    // FMOV Xd, Dn = 0x9E660000 | rn<<5 | rd
    let low: i32 = rd + rn * 32;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), 102, 158);
}
fn emit_fmov_sw(buf: *ArrayList[u8], rd: i32, rn: i32) void {
    // FMOV Sd, Wn = 0x1E270000 | rn<<5 | rd
    let low: i32 = rd + rn * 32;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), 39, 30);
}
fn emit_fmov_ws(buf: *ArrayList[u8], rd: i32, rn: i32) void {
    // FMOV Wd, Sn = 0x1E260000 | rn<<5 | rd
    let low: i32 = rd + rn * 32;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), 38, 30);
}
fn emit_fcvt_sd(buf: *ArrayList[u8], rd: i32, rn: i32) void {
    // FCVT Sd, Dn = 0x1E624000 | rn<<5 | rd
    let low: i32 = 16384 + rd + rn * 32;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), 98, 30);
}
fn emit_fcvt_ds(buf: *ArrayList[u8], rd: i32, rn: i32) void {
    // FCVT Dd, Sn = 0x1E22C000 | rn<<5 | rd
    let low: i32 = 49152 + rd + rn * 32;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), 34, 30);
}
fn emit_scvtf(buf: *ArrayList[u8], rd: i32, rn: i32) void {
    // SCVTF Dd, Xn = 0x9E620000 | rn<<5 | rd
    let low: i32 = rd + rn * 32;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), 98, 158);
}
fn emit_fcvtzs(buf: *ArrayList[u8], rd: i32, rn: i32) void {
    // FCVTZS Xd, Dn = 0x9E780000 | rn<<5 | rd
    let low: i32 = rd + rn * 32;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), 120, 158);
}

fn emit_mrs_cntvct(buf: *ArrayList[u8], rd: i32) void {
    // MRS Xd, CNTVCT_EL0 = 0xD53BE040 | rd.
    emit_pack(buf, 64 + rd, 224, 59, 213);
}

fn emit_mrs_cntfrq(buf: *ArrayList[u8], rd: i32) void {
    // MRS Xd, CNTFRQ_EL0 = 0xD53BE000 | rd.
    emit_pack(buf, rd, 224, 59, 213);
}

// Position-independent address of a byte in the Mach-O data segment.
// ADRP carries the signed page delta; ADD supplies the low twelve bits.
fn emit_adrp_add(buf: *ArrayList[u8], rd: i32, pc: i64, target: i64) void {
    let pc_page: i64 = pc - (pc % 4096);
    let target_page: i64 = target - (target % 4096);
    let pages: i64 = (target_page - pc_page) / 4096;
    let enc: i64 = pages;
    if (enc < 0) { enc = enc + 2097152; }
    let immlo: i64 = enc % 4;
    let immhi: i64 = (enc / 4) % 524288;
    let word: i64 = 2415919104 + immlo * 536870912 + immhi * 32 + (rd as i64);
    emit_pack(buf, (word % 256) as i32, ((word / 256) % 256) as i32,
              ((word / 65536) % 256) as i32, ((word / 16777216) % 256) as i32);
    emit_add_imm(buf, rd, rd, (target % 4096) as i32);
}

// Linux arm64 numbers are the stable target-neutral identifiers carried by
// AK_SYSCALL. Translate them at the final Darwin encoding boundary.
fn a_darwin_sysno(linux_num: i32) i32 {
    if (linux_num == 93) { return 1; }    // exit
    if (linux_num == 63) { return 3; }    // read
    if (linux_num == 64) { return 4; }    // write
    if (linux_num == 57) { return 6; }    // close
    if (linux_num == 80) { return 339; }  // fstat -> fstat64
    if (linux_num == 59) { return 42; }   // pipe2 -> pipe
    if (linux_num == 23) { return 90; }   // dup2
    if (linux_num == 34) { return 475; }  // mkdirat
    if (linux_num == 35) { return 472; }  // unlinkat (flags normalized by lowering)
    if (linux_num == 38) { return 465; }  // renameat
    if (linux_num == 56) { return 463; }  // openat
    if (linux_num == 53) { return 467; }  // fchmodat
    if (linux_num == 48) { return 466; }  // faccessat
    if (linux_num == 220) { return 2; }   // clone(SIGCHLD) profile -> fork
    if (linux_num == 260) { return 7; }   // wait4
    if (linux_num == 221) { return 59; }  // execve
    if (linux_num == 222) { return 197; } // mmap
    if (linux_num == 226) { return 74; }  // mprotect
    if (linux_num == 215) { return 73; }  // munmap
    if (linux_num == 169) { return 116; } // gettimeofday
    return 0 - 1;
}

fn emit_darwin_syscall(buf: *ArrayList[u8], linux_num: i32) void {
    let darwin_num: i32 = a_darwin_sysno(linux_num);
    if (darwin_num < 0) {
        emit_mov_imm64(buf, A_X0(), 0 - 78); // ENOSYS, normalized to -errno
        return;
    }
    if (linux_num == 169) {
        // XNU's raw gettimeofday entry accepts a third optional mach-time
        // pointer. The portable Linux-shaped call has only tv/tz arguments,
        // so never let a prior syscall's x2 value become that pointer.
        emit_mov_imm64(buf, A_X2(), 0);
    }
    emit_mov_imm64(buf, A_X16(), darwin_num as i64);
    emit_pack(buf, 1, 16, 0, 212);           // svc #0x80
    if (linux_num == 220) {
        // XNU fork returns parent {x0=child_pid,x1=0} and child
        // {x0=child_pid,x1=1}. Normalize that pair to the portable contract
        // expected by shared lowering: child x0=0, parent x0=child_pid.
        emit_bcond(buf, 3, 3);               // b.cc success
        emit_neg(buf, A_X0(), A_X0());       // error: +errno -> -errno
        emit_b(buf, 4);                      // skip success normalization
        emit_cmp_imm(buf, A_X1(), 0);
        emit_bcond(buf, 0, 2);               // parent keeps child pid
        emit_mov_imm64(buf, A_X0(), 0);      // child returns zero
        return;
    }
    emit_bcond(buf, 3, 2);                   // b.cc +8: success skips neg
    emit_neg(buf, A_X0(), A_X0());           // Darwin error: +errno -> -errno
}

fn emit_darwin_raw_syscall(buf: *ArrayList[u8], darwin_num: i32) void {
    emit_mov_imm64(buf, A_X16(), darwin_num as i64);
    emit_pack(buf, 1, 16, 0, 212);           // svc #0x80
    emit_bcond(buf, 3, 2);                   // success skips errno normalize
    emit_neg(buf, A_X0(), A_X0());
}

fn emit_sxtw(buf: *ArrayList[u8], rd: i32, rn: i32) void {
    // SXTW Xd, Wn = SBFM Xd, Xn, #0, #31 = 0x93407C00 | rn<<5 | rd
    let low: i32 = 31744 + rn * 32 + rd;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), 64, 147);
}

fn emit_sxtb(buf: *ArrayList[u8], rd: i32, rn: i32) void {
    // SXTB Xd, Wn = SBFM Xd, Xn, #0, #7 = 0x93401C00
    let low: i32 = 7168 + rn * 32 + rd;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), 64, 147);
}

fn emit_sxth(buf: *ArrayList[u8], rd: i32, rn: i32) void {
    // SXTH Xd, Wn = SBFM Xd, Xn, #0, #15 = 0x93403C00
    let low: i32 = 15360 + rn * 32 + rd;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), 64, 147);
}

fn emit_ldrb_uoff(buf: *ArrayList[u8], rt: i32, rn: i32, off: i32) void {
    // LDRB Wt, [Xn, #imm12] = 0x39400000 | imm12<<10 | rn<<5 | rt (byte offset)
    let low: i32 = off * 1024 + rn * 32 + rt;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(64 + low / 65536), 57);
}

fn emit_strb_uoff(buf: *ArrayList[u8], rt: i32, rn: i32, off: i32) void {
    // STRB Wt, [Xn, #imm12] = 0x39000000 | imm12<<10 | rn<<5 | rt
    let low: i32 = off * 1024 + rn * 32 + rt;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(low / 65536), 57);
}

fn emit_ldrb_soff(buf: *ArrayList[u8], rt: i32, rn: i32, off: i32) void {
    // LDURB Wt, [Xn, #simm9] = 0x38400000 | (simm9&511)<<12 | rn<<5 | rt
    if (off >= 0 && off <= 4095) { emit_ldrb_uoff(buf, rt, rn, off); return; }
    if (off < 0 - 256 || off > 255) {
        let addr: i32 = a_load_address_register(rt, rn);
        emit_materialize_address(buf, addr, rn, off);
        emit_ldrb_uoff(buf, rt, addr, 0);
        return;
    }
    let simm: i32 = off;
    if (simm < 0) { simm = simm + 512; }
    let low: i32 = simm * 4096 + rn * 32 + rt;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(64 + low / 65536), 56);
}

fn emit_strb_soff(buf: *ArrayList[u8], rt: i32, rn: i32, off: i32) void {
    // STURB Wt, [Xn, #simm9] = 0x38000000 | (simm9&511)<<12 | rn<<5 | rt
    if (off >= 0 && off <= 4095) { emit_strb_uoff(buf, rt, rn, off); return; }
    if (off < 0 - 256 || off > 255) {
        let addr: i32 = a_store_address_register(rn, rt);
        emit_materialize_address(buf, addr, rn, off);
        emit_strb_uoff(buf, rt, addr, 0);
        if (addr == rn) { emit_adjust_address(buf, addr, 0 - (off as i64)); }
        return;
    }
    let simm: i32 = off;
    if (simm < 0) { simm = simm + 512; }
    let low: i32 = simm * 4096 + rn * 32 + rt;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(low / 65536), 56);
}

fn emit_ldrh_uoff(buf: *ArrayList[u8], rt: i32, rn: i32, off: i32) void {
    // LDRH Wt, [Xn, #imm12*2] = 0x79400000
    let low: i32 = (off / 2) * 1024 + rn * 32 + rt;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(64 + low / 65536), 121);
}

fn emit_strh_uoff(buf: *ArrayList[u8], rt: i32, rn: i32, off: i32) void {
    // STRH Wt, [Xn, #imm12*2] = 0x79000000
    let low: i32 = (off / 2) * 1024 + rn * 32 + rt;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(low / 65536), 121);
}

fn emit_ldrh_soff(buf: *ArrayList[u8], rt: i32, rn: i32, off: i32) void {
    // LDURH Wt, [Xn, #simm9] = 0x78400000
    if (off >= 0 && (off % 2) == 0 && off <= 8190) { emit_ldrh_uoff(buf, rt, rn, off); return; }
    if (off < 0 - 256 || off > 255) {
        let addr: i32 = a_load_address_register(rt, rn);
        emit_materialize_address(buf, addr, rn, off);
        emit_ldrh_uoff(buf, rt, addr, 0);
        return;
    }
    let simm: i32 = off;
    if (simm < 0) { simm = simm + 512; }
    let low: i32 = simm * 4096 + rn * 32 + rt;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(64 + low / 65536), 120);
}

fn emit_strh_soff(buf: *ArrayList[u8], rt: i32, rn: i32, off: i32) void {
    // STURH Wt, [Xn, #simm9] = 0x78000000
    if (off >= 0 && (off % 2) == 0 && off <= 8190) { emit_strh_uoff(buf, rt, rn, off); return; }
    if (off < 0 - 256 || off > 255) {
        let addr: i32 = a_store_address_register(rn, rt);
        emit_materialize_address(buf, addr, rn, off);
        emit_strh_uoff(buf, rt, addr, 0);
        if (addr == rn) { emit_adjust_address(buf, addr, 0 - (off as i64)); }
        return;
    }
    let simm: i32 = off;
    if (simm < 0) { simm = simm + 512; }
    let low: i32 = simm * 4096 + rn * 32 + rt;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(low / 65536), 120);
}

fn emit_ldrw_uoff(buf: *ArrayList[u8], rt: i32, rn: i32, off: i32) void {
    // LDR Wt, [Xn, #imm12*4] = 0xB9400000
    let low: i32 = (off / 4) * 1024 + rn * 32 + rt;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(64 + low / 65536), 185);
}

fn emit_strw_uoff(buf: *ArrayList[u8], rt: i32, rn: i32, off: i32) void {
    // STR Wt, [Xn, #imm12*4] = 0xB9000000
    let low: i32 = (off / 4) * 1024 + rn * 32 + rt;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(low / 65536), 185);
}

fn emit_ldrw_soff(buf: *ArrayList[u8], rt: i32, rn: i32, off: i32) void {
    // LDUR Wt, [Xn, #simm9] = 0xB8400000
    if (off >= 0 && (off % 4) == 0 && off <= 16380) { emit_ldrw_uoff(buf, rt, rn, off); return; }
    if (off < 0 - 256 || off > 255) {
        let addr: i32 = a_load_address_register(rt, rn);
        emit_materialize_address(buf, addr, rn, off);
        emit_ldrw_uoff(buf, rt, addr, 0);
        return;
    }
    let simm: i32 = off;
    if (simm < 0) { simm = simm + 512; }
    let low: i32 = simm * 4096 + rn * 32 + rt;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(64 + low / 65536), 184);
}

fn emit_strw_soff(buf: *ArrayList[u8], rt: i32, rn: i32, off: i32) void {
    // STUR Wt, [Xn, #simm9] = 0xB8000000
    if (off >= 0 && (off % 4) == 0 && off <= 16380) { emit_strw_uoff(buf, rt, rn, off); return; }
    if (off < 0 - 256 || off > 255) {
        let addr: i32 = a_store_address_register(rn, rt);
        emit_materialize_address(buf, addr, rn, off);
        emit_strw_uoff(buf, rt, addr, 0);
        if (addr == rn) { emit_adjust_address(buf, addr, 0 - (off as i64)); }
        return;
    }
    let simm: i32 = off;
    if (simm < 0) { simm = simm + 512; }
    let low: i32 = simm * 4096 + rn * 32 + rt;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(low / 65536), 184);
}

fn emit_bcond(buf: *ArrayList[u8], cond: i32, imm19: i32) void {
    let low: i32 = ((imm19 & 524287) * 32) + cond;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(low / 65536), 84);
}

fn bcond_cc(kind: i32) i32 {
    if (kind == AK_JE())  { return ACC_EQ(); }
    if (kind == AK_JNE()) { return ACC_NE(); }
    if (kind == AK_JL())  { return ACC_LT(); }
    if (kind == AK_JLE()) { return ACC_LE(); }
    if (kind == AK_JG())  { return ACC_GT(); }
    if (kind == AK_JLO()) { return ACC_LO(); }
    if (kind == AK_JLS()) { return ACC_LS(); }
    if (kind == AK_JHI()) { return ACC_HI(); }
    if (kind == AK_JHS()) { return ACC_HS(); }
    return ACC_GE();
}

fn a_is_jcc(kind: i32) i32 {
    if (kind == AK_JE())  { return 1; }
    if (kind == AK_JNE()) { return 1; }
    if (kind == AK_JL())  { return 1; }
    if (kind == AK_JLE()) { return 1; }
    if (kind == AK_JG())  { return 1; }
    if (kind == AK_JGE()) { return 1; }
    if (kind == AK_JLO()) { return 1; }
    if (kind == AK_JLS()) { return 1; }
    if (kind == AK_JHI()) { return 1; }
    if (kind == AK_JHS()) { return 1; }
    return 0;
}

fn a_is_label_kind(kind: i32) i32 {
    if (kind == AK_LABEL() || kind == AK_FN_LABEL()) { return 1; }
    return 0;
}

fn emit_driver_data_literal(buf: *ArrayList[u8], rd: i32) void {
    // LDR Xt, #+8; B #+12; .quad relocated .data address. The branch skips
    // the inline literal so the pool cannot become executable fall-through.
    let low: i32 = 64 + rd; // imm19=2 (eight bytes), Rt=rd
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(low / 65536), 88);
    emit_b(buf, 3);
    let i: i32 = 0;
    while (i < 8) { a_eb(buf, 0); i = i + 1; }
}

// Every entry point comes in two flavours.  The historical one has the signature
// the rest of the compiler calls and discards the error list; the `_counted` one
// hands the caller a list that receives the kind number of every instruction the
// encoder refused to encode.  A vector kind with no valid A64 encoding emits
// NOTHING and is recorded here — never a partial or plausible-looking word.
fn a_encode_one_mode_err(buf: *ArrayList[u8], ins: AInstr, labels: ArrayList[i32],
                         base_off: i32, driver_mode: i32,
                         errors: *ArrayList[i32]) void {
    let k: i32 = ins.kind;
    if (a_is_label_kind(k) == 1) {
        // Linux kernels with CONFIG_ARM64_BTI_KERNEL call module entrypoints
        // through an indirect function pointer.  Emit a valid BTI landing pad
        // for every driver-mode label; this covers exported entries and keeps
        // all direct branch targets equally safe without a source-level ABI
        // special case.  The pass-1 size calculation sees the same word.
        if (driver_mode == 1) { emit_pack(buf, 95, 36, 3, 213); }
        return;
    }

    if (k == AK_MOV_IMM()) {
        emit_mov_imm64(buf, ins.dst, ins.imm);
        return;
    }
    if (k == AK_DATA_ADDR()) {
        // Keep compiler-owned data addresses distinct from integer literals.
        // Driver ET_REL output needs a relocation; executable ELF retains its
        // fixed virtual address contract. Mach-O intercepts this instruction
        // in a_encode_one_macos and emits ADRP+ADD for PIE.
        if (driver_mode == 1) { emit_driver_data_literal(buf, ins.dst); }
        else { emit_mov_imm64(buf, ins.dst, A_DATA_VBASE() + ins.imm); }
        return;
    }
    if (k == AK_MOV_RR()) {
        // Register 31 is XZR in ORR but SP in ADD — use ADD for SP copies.
        if (ins.src == A_SP()) { emit_add_imm(buf, ins.dst, A_SP(), 0); return; }
        if (ins.dst == A_SP()) { emit_add_imm(buf, A_SP(), ins.src, 0); return; }
        emit_orr(buf, ins.dst, ins.src);
        return;
    }
    if (k == AK_ADD_RR()) { emit_add_rr(buf, ins.dst, ins.dst, ins.src); return; }
    if (k == AK_SUB_RR()) { emit_sub_rr(buf, ins.dst, ins.dst, ins.src); return; }
    if (k == AK_MUL_RR()) { emit_mul(buf, ins.dst, ins.src, ins.imm as i32); return; }
    if (k == AK_SDIV()) { emit_sdiv(buf, ins.dst, ins.src, ins.imm as i32); return; }
    if (k == AK_UDIV()) { emit_udiv(buf, ins.dst, ins.src, ins.imm as i32); return; }
    if (k == AK_UMULH()) { emit_umulh(buf, ins.dst, ins.src, ins.imm as i32); return; }
    if (k == AK_CMP_RR()) { emit_cmp_rr(buf, ins.dst, ins.src); return; }
    if (k == AK_CMP_IMM()) {
        let v: i64 = ins.imm;
        if (v >= 0 && v <= 4095) { emit_cmp_imm(buf, ins.dst, v as i32); }
        else {
            // X9 is the usual scratch register, but it is also a legal compare
            // operand. Avoid turning cmp x9, #large into cmp x9, x9.
            let scratch: i32 = A_X9();
            if (ins.dst == A_X9()) { scratch = A_X10(); }
            emit_mov_imm64(buf, scratch, v);
            emit_cmp_rr(buf, ins.dst, scratch);
        }
        return;
    }
    if (k == AK_ADD_IMM()) { emit_add_imm(buf, ins.dst, ins.dst, ins.imm as i32); return; }
    if (k == AK_SUB_IMM()) { emit_sub_imm(buf, ins.dst, ins.dst, ins.imm as i32); return; }
    if (k == AK_NEG()) { emit_neg(buf, ins.dst, ins.src); return; }
    if (k == AK_SXTW()) { emit_sxtw(buf, ins.dst, ins.src); return; }
    if (k == AK_AND_IMM()) {
        // Narrow-ABI and runtime normalization legitimately target X9. Keep
        // the materialized mask in a distinct register in that case.
        let scratch2: i32 = A_X9();
        if (ins.dst == A_X9()) { scratch2 = A_X10(); }
        emit_mov_imm64(buf, scratch2, ins.imm);
        emit_and_rr(buf, ins.dst, ins.dst, scratch2);
        return;
    }
    // Expression stack grows upward from X28 within the reserved frame area.
    if (k == AK_PUSH()) {
        emit_str_uoff(buf, ins.dst, A_X28(), 0);
        emit_add_imm(buf, A_X28(), A_X28(), 8);
        return;
    }
    if (k == AK_POP()) {
        emit_sub_imm(buf, A_X28(), A_X28(), 8);
        emit_ldr_uoff(buf, ins.dst, A_X28(), 0);
        return;
    }
    if (k == AK_LOAD()) {
        let d: i32 = ins.disp;
        if (d >= 0 && (d % 8) == 0 && d <= 32760) { emit_ldr_uoff(buf, ins.dst, ins.src, d); }
        else { emit_ldr_soff(buf, ins.dst, ins.src, d); }
        return;
    }
    if (k == AK_STORE()) {
        let d: i32 = ins.disp;
        if (d >= 0 && (d % 8) == 0 && d <= 32760) { emit_str_uoff(buf, ins.src, ins.dst, d); }
        else { emit_str_soff(buf, ins.src, ins.dst, d); }
        return;
    }
    if (k == AK_LOADB()) { emit_ldrb_soff(buf, ins.dst, ins.src, ins.disp); return; }
    if (k == AK_STOREB()) { emit_strb_soff(buf, ins.src, ins.dst, ins.disp); return; }
    if (k == AK_LOADH()) { emit_ldrh_soff(buf, ins.dst, ins.src, ins.disp); return; }
    if (k == AK_STOREH()) { emit_strh_soff(buf, ins.src, ins.dst, ins.disp); return; }
    if (k == AK_LOADW()) { emit_ldrw_soff(buf, ins.dst, ins.src, ins.disp); return; }
    if (k == AK_STOREW()) { emit_strw_soff(buf, ins.src, ins.dst, ins.disp); return; }
    if (k == AK_SXTB()) { emit_sxtb(buf, ins.dst, ins.src); return; }
    if (k == AK_SXTH()) { emit_sxth(buf, ins.dst, ins.src); return; }
    if (k == AK_XOR_RR()) { emit_eor_rr(buf, ins.dst, ins.dst, ins.src); return; }
    if (k == AK_OR_RR()) { emit_orr_rr(buf, ins.dst, ins.dst, ins.src); return; }
    if (k == AK_ANDR_RR()) { emit_and_rr(buf, ins.dst, ins.dst, ins.src); return; }
    if (k == AK_SHL_RR()) { emit_lslv(buf, ins.dst, ins.dst, ins.src); return; }
    if (k == AK_SHR_RR()) { emit_asrv(buf, ins.dst, ins.dst, ins.src); return; }
    if (k == AK_LSHR_RR()) { emit_lsrv(buf, ins.dst, ins.dst, ins.src); return; }
    if (k == AK_FMOV_DX()) { emit_fmov_dx(buf, ins.dst, ins.src); return; }
    if (k == AK_FMOV_XD()) { emit_fmov_xd(buf, ins.dst, ins.src); return; }
    if (k == AK_FMOV_SW()) { emit_fmov_sw(buf, ins.dst, ins.src); return; }
    if (k == AK_FMOV_WS()) { emit_fmov_ws(buf, ins.dst, ins.src); return; }
    if (k == AK_FCVT_SD()) { emit_fcvt_sd(buf, ins.dst, ins.src); return; }
    if (k == AK_FCVT_DS()) { emit_fcvt_ds(buf, ins.dst, ins.src); return; }
    if (k == AK_FADD()) { emit_fadd(buf, ins.dst, ins.dst, ins.src); return; }
    if (k == AK_FSUB()) { emit_fsub(buf, ins.dst, ins.dst, ins.src); return; }
    if (k == AK_FMUL()) { emit_fmul(buf, ins.dst, ins.dst, ins.src); return; }
    if (k == AK_FDIV()) { emit_fdiv(buf, ins.dst, ins.dst, ins.src); return; }
    if (k == AK_FCMP()) { emit_fcmp(buf, ins.dst, ins.src); return; }
    if (k == AK_SCVTF()) { emit_scvtf(buf, ins.dst, ins.src); return; }
    if (k == AK_FCVTZS()) { emit_fcvtzs(buf, ins.dst, ins.src); return; }
    if (k == AK_CALL()) {
        let tgt: i32 = get[i32](labels, ins.lbl);
        let rel: i32 = (tgt - base_off) / 4;
        emit_bl(buf, rel);
        return;
    }
    if (k == AK_JMP()) {
        let tgt: i32 = get[i32](labels, ins.lbl);
        let rel: i32 = (tgt - base_off) / 4;
        emit_b(buf, rel);
        return;
    }
    if (a_is_jcc(k) == 1) {
        let tgt: i32 = get[i32](labels, ins.lbl);
        let rel: i32 = (tgt - base_off) / 4;
        emit_bcond(buf, bcond_cc(k), rel);
        return;
    }
    if (k == AK_RET()) { emit_pack(buf, 192, 3, 95, 214); return; }
    if (k == AK_SVC()) { emit_pack(buf, 1, 0, 0, 212); return; }
    if (k == AK_DMB()) { emit_pack(buf, 191, 59, 3, 213); return; } // DMB ISH
    if (k == AK_LDAR()) { emit_ldar(buf, ins.dst, ins.src); return; }
    if (k == AK_STLR()) { emit_stlr(buf, ins.src, ins.dst); return; }
    if (k == AK_LDAXR()) { emit_ldaxr(buf, ins.dst, ins.src); return; }
    if (k == AK_STLXR()) { emit_stlxr(buf, ins.dst, ins.src, ins.imm as i32); return; }
    if (k == AK_MRS_CNTVCT()) { emit_mrs_cntvct(buf, ins.dst); return; }
    if (k == AK_MRS_CNTFRQ()) { emit_mrs_cntfrq(buf, ins.dst); return; }
    if (k == AK_SYSCALL()) {
        emit_mov_imm64(buf, A_X8(), ins.imm);
        emit_pack(buf, 1, 0, 0, 212);         // svc #0
        return;
    }
    if (k == AK_SYSCALL_REG()) {
        emit_orr(buf, A_X8(), ins.src);
        emit_pack(buf, 1, 0, 0, 212);
        return;
    }
    if (k == AK_LEA_LBL()) {
        // ADR Xd, label = 0x10000000 | immlo<<29 | immhi<<5 | rd (rel in BYTES)
        let tgt: i32 = get[i32](labels, ins.lbl);
        let rel: i32 = tgt - base_off;
        let immlo: i32 = rel & 3;
        let immhi: i32 = (rel - immlo) / 4;
        if (immhi < 0) { immhi = immhi + 524288; }         // 19-bit two's complement
        let low: i32 = (immhi % 524288) * 32 + ins.dst;
        emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(low / 65536), 16 + immlo * 32);
        return;
    }
    if (k == AK_CALL_REG()) {
        // BLR Xn = 0xD63F0000 | rn<<5
        let low2: i32 = ins.dst * 32;
        emit_pack(buf, a_lo3(low2), a_lo3(low2 / 256), 63, 214);
        return;
    }
    if (k == AK_CALL_EXT()) {
        // BL with zero immediate — the linker patches this via R_AARCH64_CALL26.
        emit_bl(buf, 0);
        return;
    }
    if (k == AK_LSL_IMM()) {
        // LSL Xd, Xn, #shift = UBFM Xd, Xn, #(-shift MOD 64), #(63-shift)
        // Encoding: sf=1, opc=10, 100110, N=1, immr, imms, Rn, Rd
        // Byte 3 = 0xD3, Byte 2 = 0x40 | immr, Byte 1 = (imms<<2)|(Rn>>3),
        // Byte 0 = ((Rn&7)<<5)|Rd
        let shift: i32 = ins.imm as i32;
        let immr: i32 = (0 - shift) & 63;
        let imms: i32 = 63 - shift;
        let b0: i32 = ((ins.dst & 31)) | ((ins.src & 7) << 5);
        let b1: i32 = ((ins.src >> 3) & 7) | ((imms & 63) << 2);
        let b2: i32 = 64 | (immr & 63);
        emit_pack(buf, a_lo3(b0), a_lo3(b1), a_lo3(b2), 211);
        return;
    }
    if (k == AK_VLOADQ()) {
        let r: i32 = emit_ldrq_disp_index(buf, 0, ins.dst, ins.src,
            av_index(ins.imm), av_imm8(ins.imm), ins.disp);
        if (r == 1) { push[i32](errors, k); }
        if (r == 0 - 1) { emit_ldrq(buf, ins.dst, ins.src, ins.disp); }
        return;
    }
    if (k == AK_VSTOREQ()) {
        let r: i32 = emit_ldrq_disp_index(buf, 1, ins.src, ins.dst,
            av_index(ins.imm), av_imm8(ins.imm), ins.disp);
        if (r == 1) { push[i32](errors, k); }
        if (r == 0 - 1) { emit_strq(buf, ins.src, ins.dst, ins.disp); }
        return;
    }
    // The bitwise group has no per-lane arrangement in A64 (bits 23:22 are a
    // sub-opcode over the fixed 16B form), so the arrangement is derived from the
    // width class alone and the descriptor's element width is carried only so the
    // lowering can reason about lane counts.  The four sub-opcodes keep their
    // historical bytes at VW_128().
    if (k == AK_VEOR() || k == AK_VAND() || k == AK_VORR()) {
        if (av_w(ins.imm) != VW_128()) { push[i32](errors, k); return; }
        if (k == AK_VEOR()) { emit_vector_logic(buf, 110, 32, ins.dst, ins.dst, ins.src); return; }
        if (k == AK_VAND()) { emit_vector_logic(buf, 78, 32, ins.dst, ins.dst, ins.src); return; }
        emit_vector_logic(buf, 78, 160, ins.dst, ins.dst, ins.src);
        return;
    }
    if (k == AK_VADD_I32()) {
        if (emit_vaddsub(buf, 0, av_w(ins.imm), av_elem(ins.imm), ins.dst, ins.dst, ins.src) != 0) {
            push[i32](errors, k);
        }
        return;
    }
    if (k == AK_VSUB_I32()) {
        if (emit_vaddsub(buf, 1, av_w(ins.imm), av_elem(ins.imm), ins.dst, ins.dst, ins.src) != 0) {
            push[i32](errors, k);
        }
        return;
    }
    if (k == AK_VCNT()) { emit_vcnt(buf, ins.dst, ins.src); return; }
    if (k == AK_VADDV_B()) { emit_vaddv_b(buf, ins.dst, ins.src); return; }
    if (k == AK_VUMOV_B()) { emit_vumov_b(buf, ins.dst, ins.src); return; }
    // ── the width-parameteric vector surface ──────────────────────────────────
    if (k == AK_VMUL()) {
        if (emit_vmul(buf, av_w(ins.imm), av_elem(ins.imm), ins.dst, ins.dst, ins.src) != 0) {
            push[i32](errors, k);
        }
        return;
    }
    if (k == AK_VSHL()) {
        if (emit_vshl(buf, av_w(ins.imm), av_elem(ins.imm), ins.dst, ins.dst, ins.src) != 0) {
            push[i32](errors, k);
        }
        return;
    }
    if (k == AK_VSHR_S()) {
        if (emit_vshift_imm(buf, 0, 1, 1, av_w(ins.imm), av_elem(ins.imm),
                            av_imm8(ins.imm), ins.dst, ins.dst) != 0) {
            push[i32](errors, k);
        }
        return;
    }
    if (k == AK_VSHR_U()) {
        if (emit_vshift_imm(buf, 1, 1, 1, av_w(ins.imm), av_elem(ins.imm),
                            av_imm8(ins.imm), ins.dst, ins.dst) != 0) {
            push[i32](errors, k);
        }
        return;
    }
    if (k == AK_VFADD()) {
        if (emit_vfp(buf, 78, 53, 0, av_w(ins.imm), av_elem(ins.imm), ins.dst, ins.dst, ins.src) != 0) {
            push[i32](errors, k);
        }
        return;
    }
    if (k == AK_VFSUB()) {
        if (emit_vfp(buf, 78, 53, 1, av_w(ins.imm), av_elem(ins.imm), ins.dst, ins.dst, ins.src) != 0) {
            push[i32](errors, k);
        }
        return;
    }
    if (k == AK_VFMUL()) {
        if (emit_vfp(buf, 110, 55, 0, av_w(ins.imm), av_elem(ins.imm), ins.dst, ins.dst, ins.src) != 0) {
            push[i32](errors, k);
        }
        return;
    }
    if (k == AK_VFDIV()) {
        if (emit_vfp(buf, 110, 63, 0, av_w(ins.imm), av_elem(ins.imm), ins.dst, ins.dst, ins.src) != 0) {
            push[i32](errors, k);
        }
        return;
    }
    if (k == AK_VCMGT()) {
        if (emit_vcmp(buf, 78, 13, 0, 0, av_w(ins.imm), av_elem(ins.imm), ins.dst, ins.dst, ins.src) != 0) {
            push[i32](errors, k);
        }
        return;
    }
    if (k == AK_VCMEQ()) {
        if (emit_vcmp(buf, 110, 35, 0, 0, av_w(ins.imm), av_elem(ins.imm), ins.dst, ins.dst, ins.src) != 0) {
            push[i32](errors, k);
        }
        return;
    }
    if (k == AK_VCMGE()) {
        if (emit_vcmp(buf, 78, 15, 0, 0, av_w(ins.imm), av_elem(ins.imm), ins.dst, ins.dst, ins.src) != 0) {
            push[i32](errors, k);
        }
        return;
    }
    if (k == AK_VFCMGT()) {
        if (emit_vcmp(buf, 110, 57, 1, 1, av_w(ins.imm), av_elem(ins.imm), ins.dst, ins.dst, ins.src) != 0) {
            push[i32](errors, k);
        }
        return;
    }
    if (k == AK_VFCMEQ()) {
        if (emit_vcmp(buf, 78, 57, 1, 0, av_w(ins.imm), av_elem(ins.imm), ins.dst, ins.dst, ins.src) != 0) {
            push[i32](errors, k);
        }
        return;
    }
    if (k == AK_VBSL()) {
        if (emit_vbsl(buf, 0, av_w(ins.imm), ins.dst, ins.src, ins.disp) != 0) {
            push[i32](errors, k);
        }
        return;
    }
    if (k == AK_VBIT()) {
        if (emit_vbsl(buf, 1, av_w(ins.imm), ins.dst, ins.src, ins.disp) != 0) {
            push[i32](errors, k);
        }
        return;
    }
    if (k == AK_VDUP_GPR()) {
        if (emit_vdup_gpr(buf, av_w(ins.imm), av_elem(ins.imm), ins.dst, ins.src) != 0) {
            push[i32](errors, k);
        }
        return;
    }
    if (k == AK_VDUP_LANE()) {
        if (emit_vdup_lane(buf, av_w(ins.imm), av_elem(ins.imm), ins.disp,
                           ins.dst, ins.src) != 0) { push[i32](errors, k); }
        return;
    }
    if (k == AK_VEXTRACT()) {
        if (emit_vextract(buf, av_w(ins.imm), av_elem(ins.imm), ins.disp,
                          ins.dst, ins.src) != 0) { push[i32](errors, k); }
        return;
    }
    if (k == AK_VINSERT()) {
        if (emit_vinsert(buf, av_w(ins.imm), av_elem(ins.imm), ins.disp,
                         ins.dst, ins.src) != 0) { push[i32](errors, k); }
        return;
    }
    if (k == AK_VZERO()) {
        if (emit_vzero(buf, av_w(ins.imm), av_elem(ins.imm), ins.dst) != 0) {
            push[i32](errors, k);
        }
        return;
    }
    if (k == AK_VONES()) {
        if (emit_vones(buf, av_w(ins.imm), av_elem(ins.imm), ins.dst, ins.src) != 0) {
            push[i32](errors, k);
        }
        return;
    }
    if (k == AK_VLOAD1()) {
        if (av_w(ins.imm) != VW_128()) { push[i32](errors, k); return; }
        if (emit_ld1_st1(buf, 0, av_elem(ins.imm), ins.dst, ins.src,
                         av_index(ins.imm)) != 0) { push[i32](errors, k); }
        return;
    }
    if (k == AK_VSTORE1()) {
        if (av_w(ins.imm) != VW_128()) { push[i32](errors, k); return; }
        if (emit_ld1_st1(buf, 1, av_elem(ins.imm), ins.src, ins.dst,
                         av_index(ins.imm)) != 0) { push[i32](errors, k); }
        return;
    }
    if (k == AK_PREFETCH()) { emit_prefetch_l1_keep(buf, ins.src); return; }
    if (k == AK_REV64()) { emit_data1_64(buf, 3072, ins.dst, ins.src); return; }
    if (k == AK_CLZ64()) { emit_data1_64(buf, 4096, ins.dst, ins.src); return; }
    if (k == AK_RBIT64()) { emit_data1_64(buf, 0, ins.dst, ins.src); return; }
    if (k == AK_BIC64()) { emit_bic64(buf, ins.dst, ins.src, ins.imm as i32); return; }
    // Safety net: a vector kind that reached the end of the dispatch has no
    // implementation.  Record it so a lowering that invents one is caught rather
    // than silently producing a hole in the instruction stream.
    if (a_is_veclike(k) == 1) { push[i32](errors, k); }
}

fn a_encode_one_mode(buf: *ArrayList[u8], ins: AInstr, labels: ArrayList[i32],
                     base_off: i32, driver_mode: i32) void {
    let discard: ArrayList[i32] = make[i32](1);
    a_encode_one_mode_err(buf, ins, labels, base_off, driver_mode, &discard);
    free[i32](&discard);
}

fn a_encode_one(buf: *ArrayList[u8], ins: AInstr, labels: ArrayList[i32], base_off: i32) void {
    a_encode_one_mode(buf, ins, labels, base_off, 0);
}

fn a_encode_one_macos(buf: *ArrayList[u8], ins: AInstr, labels: ArrayList[i32],
                      base_off: i32, code_vmaddr: i64, data_vmaddr: i64,
                      extern_stub_off: i32) void {
    let discard: ArrayList[i32] = make[i32](1);
    a_encode_one_macos_err(buf, ins, labels, base_off, code_vmaddr, data_vmaddr,
                           extern_stub_off, &discard);
    free[i32](&discard);
}

fn a_encode_one_macos_err(buf: *ArrayList[u8], ins: AInstr, labels: ArrayList[i32],
                          base_off: i32, code_vmaddr: i64, data_vmaddr: i64,
                          extern_stub_off: i32, errors: *ArrayList[i32]) void {
    if (ins.kind == AK_DATA_ADDR()) {
        emit_adrp_add(buf, ins.dst, code_vmaddr + (base_off as i64), data_vmaddr + ins.imm);
        return;
    }
    if (ins.kind == AK_SYSCALL()) {
        emit_darwin_syscall(buf, ins.imm as i32);
        return;
    }
    if (ins.kind == AK_DARWIN_SYSCALL()) {
        emit_darwin_raw_syscall(buf, ins.imm as i32);
        return;
    }
    if (ins.kind == AK_SYSCALL_REG()) {
        // Darwin platform adapters carry Darwin syscall numbers explicitly.
        // Keep this dynamic form separate from AK_SYSCALL (whose stable
        // identifiers are Linux AArch64 numbers translated above): it lets
        // the macOS-only runtime use kqueue, vnode watches, and lifecycle
        // syscalls without making a lossy guess about Linux-only call sites.
        emit_orr(buf, A_X16(), ins.src);
        emit_pack(buf, 1, 16, 0, 212);       // svc #0x80
        emit_bcond(buf, 3, 2);               // success skips errno normalize
        emit_neg(buf, A_X0(), A_X0());       // Darwin error: +errno -> -errno
        return;
    }
    if (ins.kind == AK_SVC()) {
        // Legacy callers without an explicit syscall instruction fail closed.
        emit_mov_imm64(buf, A_X0(), 0 - 78);
        return;
    }
    if (ins.kind == AK_EXTERN_CALL()) {
        // Each import trampoline is ADRP+ADD, LDR, BR: four ARM64
        // instructions, hence 16 bytes.  Keeping this in lockstep with the
        // emitter below is essential once a program imports more than one
        // native symbol.
        let target: i32 = extern_stub_off + (ins.imm as i32) * 16;
        emit_bl(buf, (target - base_off) / 4);
        return;
    }
    a_encode_one(buf, ins, labels, base_off);
}

fn aencode_counted(prog: ArrayList[AInstr], errors: *ArrayList[i32]) ArrayList[u8] {
    let n: i32 = prog.len;
    let maxlbl: i32 = 0;
    let i: i32 = 0;
    while (i < n) {
        let ins: AInstr = get[AInstr](prog, i);
        if (ins.lbl > maxlbl) { maxlbl = ins.lbl; }
        i = i + 1;
    }
    let nlbl: i32 = maxlbl + 1;
    let labels: ArrayList[i32] = make[i32](nlbl + 1);
    let j: i32 = 0;
    while (j < nlbl) { push[i32](&labels, 0); j = j + 1; }

    // Pass 1 only measures, so a kind it refuses must not be counted twice: the
    // caller's list describes the instructions that were actually emitted.
    let measuring: ArrayList[i32] = make[i32](1);
    let scratch: ArrayList[u8] = make[u8](64);
    i = 0;
    while (i < n) {
        let ins1: AInstr = get[AInstr](prog, i);
        let here: i32 = scratch.len;
        if (a_is_label_kind(ins1.kind) == 1) { set[i32](&labels, ins1.lbl, here); }
        a_encode_one_mode_err(&scratch, ins1, labels, here, 0, &measuring);
        i = i + 1;
    }
    free[i32](&measuring);

    let out: ArrayList[u8] = make[u8](scratch.len + 8);
    i = 0;
    while (i < n) {
        let ins2: AInstr = get[AInstr](prog, i);
        let off: i32 = out.len;
        a_encode_one_mode_err(&out, ins2, labels, off, 0, errors);
        i = i + 1;
    }
    return out;
}

fn aencode(prog: ArrayList[AInstr]) ArrayList[u8] {
    let discard: ArrayList[i32] = make[i32](1);
    let out: ArrayList[u8] = aencode_counted(prog, &discard);
    free[i32](&discard);
    return out;
}

// Apple Silicon maps executable pages at 16 KiB granularity. Hot images align
// only explicit source-function entry markers; ordinary/internal labels remain
// compact, and the non-hot wrapper below emits exactly the historical bytes.
fn a_hot_pad_to_vm_page(buf: *ArrayList[u8], code_vmaddr: i64) void {
    while (((code_vmaddr + (buf.*.len as i64)) % 16384) != 0) {
        // Architectural NOP (0xd503201f). Padding is executable so a function
        // that ever falls through its terminal sequence remains deterministic.
        emit_pack(buf, 31, 32, 3, 213);
    }
}

fn aencode_macos_mode_counted(prog: ArrayList[AInstr], code_vmaddr: i64, data_vmaddr: i64,
                              extern_data_off: i32, extern_count: i32,
                              hot_page_layout: i32, errors: *ArrayList[i32]) ArrayList[u8] {
    let n: i32 = prog.len;
    let maxlbl: i32 = 0;
    let i: i32 = 0;
    while (i < n) {
        let ins: AInstr = get[AInstr](prog, i);
        if (ins.lbl > maxlbl) { maxlbl = ins.lbl; }
        i = i + 1;
    }
    let labels: ArrayList[i32] = make[i32](maxlbl + 2);
    let j: i32 = 0;
    while (j < maxlbl + 1) { push[i32](&labels, 0); j = j + 1; }

    let measuring: ArrayList[i32] = make[i32](1);
    let scratch: ArrayList[u8] = make[u8](64);
    i = 0;
    while (i < n) {
        let ins1: AInstr = get[AInstr](prog, i);
        if (hot_page_layout == 1 && ins1.kind == AK_FN_LABEL()) {
            a_hot_pad_to_vm_page(&scratch, code_vmaddr);
        }
        let here: i32 = scratch.len;
        if (a_is_label_kind(ins1.kind) == 1) { set[i32](&labels, ins1.lbl, here); }
        a_encode_one_macos_err(&scratch, ins1, labels, here, code_vmaddr, data_vmaddr, 0, &measuring);
        i = i + 1;
    }
    free[i32](&measuring);

    let stub_off: i32 = scratch.len;
    let out: ArrayList[u8] = make[u8](scratch.len + extern_count * 16 + 8);
    i = 0;
    while (i < n) {
        let ins2: AInstr = get[AInstr](prog, i);
        if (hot_page_layout == 1 && ins2.kind == AK_FN_LABEL()) {
            a_hot_pad_to_vm_page(&out, code_vmaddr);
        }
        let off: i32 = out.len;
        a_encode_one_macos_err(&out, ins2, labels, off, code_vmaddr, data_vmaddr, stub_off, errors);
        i = i + 1;
    }
    i = 0;
    while (i < extern_count) {
        let ptr: i64 = data_vmaddr + (extern_data_off as i64) + (i as i64) * 8;
        emit_adrp_add(&out, A_X16(), code_vmaddr + (out.len as i64), ptr);
        emit_ldr_uoff(&out, A_X16(), A_X16(), 0);
        // BR X16: preserve LR established at the original call site.
        emit_pack(&out, 0, 2, 31, 214);
        i = i + 1;
    }
    // The first Mach-O page contains its 4 KiB header prefix. Ending at the
    // next VM boundary makes every subsequently replaceable patch span a set
    // of complete, aligned 16 KiB destination pages.
    if (hot_page_layout == 1) { a_hot_pad_to_vm_page(&out, code_vmaddr); }
    return out;
}

fn aencode_macos_mode(prog: ArrayList[AInstr], code_vmaddr: i64, data_vmaddr: i64,
                      extern_data_off: i32, extern_count: i32,
                      hot_page_layout: i32) ArrayList[u8] {
    let discard: ArrayList[i32] = make[i32](1);
    let out: ArrayList[u8] = aencode_macos_mode_counted(prog, code_vmaddr, data_vmaddr,
                                extern_data_off, extern_count, hot_page_layout, &discard);
    free[i32](&discard);
    return out;
}

fn aencode_macos(prog: ArrayList[AInstr], code_vmaddr: i64, data_vmaddr: i64,
                 extern_data_off: i32, extern_count: i32) ArrayList[u8] {
    return aencode_macos_mode(prog, code_vmaddr, data_vmaddr,
                              extern_data_off, extern_count, 0);
}

// ── object mode: encode with label offsets and relocation tracking ──────────
// kind=0 is a declared foreign call; kind=1 is a compiler-owned .data
// address held in an inline 64-bit literal.
struct AObjectReloc { offset: i32, import: i32, kind: i32, data_offset: i32 }
struct AEncoded { text: ArrayList[u8], labels: ArrayList[i32], relocs: ArrayList[AObjectReloc] }

fn aencode_with_labels_mode_counted(prog: ArrayList[AInstr], driver_mode: i32,
                                    errors: *ArrayList[i32]) AEncoded {
    let n: i32 = prog.len;
    let maxlbl: i32 = 0;
    let i: i32 = 0;
    while (i < n) {
        let ins: AInstr = get[AInstr](prog, i);
        if (ins.lbl > maxlbl) { maxlbl = ins.lbl; }
        i = i + 1;
    }
    let nlbl: i32 = maxlbl + 1;
    let labels: ArrayList[i32] = make[i32](nlbl + 1);
    let j: i32 = 0;
    while (j < nlbl) { push[i32](&labels, 0); j = j + 1; }

    // Pass 1: measure offsets to resolve labels.  Refused kinds are counted
    // from the emitting pass only, so one instruction yields one entry.
    let measuring: ArrayList[i32] = make[i32](1);
    let scratch: ArrayList[u8] = make[u8](64);
    i = 0;
    while (i < n) {
        let ins1: AInstr = get[AInstr](prog, i);
        let here: i32 = scratch.len;
        if (a_is_label_kind(ins1.kind) == 1) { set[i32](&labels, ins1.lbl, here); }
        a_encode_one_mode_err(&scratch, ins1, labels, here, driver_mode, &measuring);
        i = i + 1;
    }
    free[i32](&measuring);

    // Pass 2: emit final bytes and record AK_CALL_EXT relocations.
    let out: ArrayList[u8] = make[u8](scratch.len + 8);
    let relocs: ArrayList[AObjectReloc] = make[AObjectReloc](8);
    i = 0;
    while (i < n) {
        let ins2: AInstr = get[AInstr](prog, i);
        let off: i32 = out.len;
        if (ins2.kind == AK_CALL_EXT()) {
            push[AObjectReloc](&relocs, AObjectReloc{ .offset = off, .import = ins2.lbl, .kind = 0, .data_offset = 0 });
        } else if (driver_mode == 1 && ins2.kind == AK_DATA_ADDR()) {
            // The literal follows the 4-byte LDR and 4-byte branch.
            push[AObjectReloc](&relocs, AObjectReloc{ .offset = off + 8, .import = -1, .kind = 1, .data_offset = ins2.imm as i32 });
        }
        a_encode_one_mode_err(&out, ins2, labels, off, driver_mode, errors);
        i = i + 1;
    }
    return AEncoded{ .text = out, .labels = labels, .relocs = relocs };
}

fn aencode_with_labels_mode(prog: ArrayList[AInstr], driver_mode: i32) AEncoded {
    let discard: ArrayList[i32] = make[i32](1);
    let out: AEncoded = aencode_with_labels_mode_counted(prog, driver_mode, &discard);
    free[i32](&discard);
    return out;
}

fn aencode_with_labels(prog: ArrayList[AInstr]) AEncoded {
    return aencode_with_labels_mode(prog, 0);
}
