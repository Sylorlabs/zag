// selfhost/native/aarch64.zag — AArch64 instruction encoder for Zag's arm64 backend.
//
// Opcodes are packed byte-by-byte (Zag i32 literals overflow above 2^31).

@import("aisa.zag")

fn a_eb(buf: *ArrayList[u8], b: i32) void {
    push[u8](buf, (b % 256) as u8);
}

fn emit_pack(buf: *ArrayList[u8], b0: i32, b1: i32, b2: i32, b3: i32) void {
    a_eb(buf, b0);
    a_eb(buf, b1);
    a_eb(buf, b2);
    a_eb(buf, b3);
}

fn a_lo3(v: i32) i32 { return v % 256; }

fn emit_movz(buf: *ArrayList[u8], rd: i32, imm16: i32, hw: i32) void {
    // MOVZ Xd, #imm16, LSL #(hw*16) = 0xD2800000 | hw<<21 | imm16<<5 | rd
    let low: i32 = imm16 * 32 + rd;
    let b2: i32 = a_lo3(128 + hw * 32 + low / 65536);
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), b2, 210);
}

fn emit_movk(buf: *ArrayList[u8], rd: i32, imm16: i32, hw: i32) void {
    // MOVK Xd, #imm16, LSL #(hw*16) = 0xF2800000 | hw<<21 | imm16<<5 | rd
    let low: i32 = imm16 * 32 + rd;
    let b2: i32 = a_lo3(128 + hw * 32 + low / 65536);
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), b2, 242);
}

fn emit_mov_imm64(buf: *ArrayList[u8], rd: i32, v: i64) void {
    let x: i64 = v;
    let hw: i32 = 0;
    while (hw < 4) {
        let chunk: i64 = x & 65535;
        let imm16: i32 = chunk as i32;
        if (hw == 0) { emit_movz(buf, rd, imm16, hw); }
        else {
            if (imm16 != 0) { emit_movk(buf, rd, imm16, hw); }
        }
        x = (x - chunk) / 65536;
        hw = hw + 1;
    }
}

fn emit_rr(buf: *ArrayList[u8], b3: i32, rd: i32, rn: i32, rm: i32) void {
    let t: i32 = rm * 256;
    let low: i32 = t * 256 + rn * 32 + rd;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(low / 65536), b3);
}

fn emit_imm12(buf: *ArrayList[u8], b3: i32, rd: i32, rn: i32, imm12: i32) void {
    let low: i32 = imm12 * 1024 + rn * 32 + rd;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(low / 65536), b3);
}

fn emit_add_rr(buf: *ArrayList[u8], rd: i32, rn: i32, rm: i32) void { emit_rr(buf, 139, rd, rn, rm); }
fn emit_sub_rr(buf: *ArrayList[u8], rd: i32, rn: i32, rm: i32) void { emit_rr(buf, 203, rd, rn, rm); }
fn emit_add_imm(buf: *ArrayList[u8], rd: i32, rn: i32, imm12: i32) void { emit_imm12(buf, 145, rd, rn, imm12); }
fn emit_sub_imm(buf: *ArrayList[u8], rd: i32, rn: i32, imm12: i32) void { emit_imm12(buf, 209, rd, rn, imm12); }
fn emit_mul(buf: *ArrayList[u8], rd: i32, rn: i32, rm: i32) void {
    // MADD Xd, Xn, Xm, XZR
    let low: i32 = rd + rn * 32 + 31 * 1024 + rm * 65536;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(low / 65536), 155);
}
fn emit_sdiv(buf: *ArrayList[u8], rd: i32, rn: i32, rm: i32) void {
    // SDIV Xd, Xn, Xm = 0x9AC00C00 | rm<<16 | rn<<5 | rd
    let low: i32 = rd + rn * 32 + 3072;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(192 + rm), 154);
}
fn emit_cmp_rr(buf: *ArrayList[u8], rn: i32, rm: i32) void {
    let t: i32 = rm * 256;
    let low: i32 = t * 256 + rn * 32 + 31;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(low / 65536), 235);
}
fn emit_cmp_imm(buf: *ArrayList[u8], rn: i32, imm12: i32) void { emit_imm12(buf, 241, 31, rn, imm12); }
fn emit_orr(buf: *ArrayList[u8], rd: i32, rm: i32) void {
    // ORR Xd, XZR, Xm
    emit_rr(buf, 170, rd, 31, rm);
}
fn emit_neg(buf: *ArrayList[u8], rd: i32, rm: i32) void {
    // SUB Xd, XZR, Xm
    emit_rr(buf, 203, rd, 31, rm);
}
fn emit_and_rr(buf: *ArrayList[u8], rd: i32, rn: i32, rm: i32) void { emit_rr(buf, 138, rd, rn, rm); }
fn emit_eor_rr(buf: *ArrayList[u8], rd: i32, rn: i32, rm: i32) void { emit_rr(buf, 202, rd, rn, rm); }
fn emit_orr_rr(buf: *ArrayList[u8], rd: i32, rn: i32, rm: i32) void { emit_rr(buf, 170, rd, rn, rm); }
fn emit_lslv(buf: *ArrayList[u8], rd: i32, rn: i32, rm: i32) void {
    // LSLV Xd, Xn, Xm = 0x9AC02000 | rm<<16 | rn<<5 | rd
    let low: i32 = rd + rn * 32 + 8192;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(192 + rm), 154);
}
fn emit_asrv(buf: *ArrayList[u8], rd: i32, rn: i32, rm: i32) void {
    // ASRV Xd, Xn, Xm = 0x9AC02800 | rm<<16 | rn<<5 | rd
    let low: i32 = rd + rn * 32 + 10240;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(192 + rm), 154);
}

fn emit_ldr_uoff(buf: *ArrayList[u8], rd: i32, rn: i32, off: i32) void {
    // LDR Xt, [Xn, #imm12*8] = 0xF9400000 | imm12<<10 | rn<<5 | rt
    let imm12: i32 = off / 8;
    let low: i32 = imm12 * 1024 + rn * 32 + rd;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(64 + low / 65536), 249);
}

fn emit_str_uoff(buf: *ArrayList[u8], rt: i32, rn: i32, off: i32) void {
    // STR Xt, [Xn, #imm12*8] = 0xF9000000 | imm12<<10 | rn<<5 | rt
    let imm12: i32 = off / 8;
    let low: i32 = imm12 * 1024 + rn * 32 + rt;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(low / 65536), 249);
}

fn emit_ldr_soff(buf: *ArrayList[u8], rd: i32, rn: i32, off: i32) void {
    // LDUR Xt, [Xn, #simm9] = 0xF8400000 | (simm9&511)<<12 | rn<<5 | rt (byte offset)
    if (off < 0 - 256 || off > 255) {
        emit_add_imm(buf, 17, rn, 0);
        emit_mov_imm64(buf, 16, off as i64);
        emit_add_rr(buf, 17, 17, 16);
        emit_ldr_uoff(buf, rd, 17, 0);
        return;
    }
    let simm: i32 = off;
    if (simm < 0) { simm = simm + 512; }
    let low: i32 = simm * 4096 + rn * 32 + rd;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(64 + low / 65536), 248);
}

fn emit_str_soff(buf: *ArrayList[u8], rt: i32, rn: i32, off: i32) void {
    // STUR Xt, [Xn, #simm9] = 0xF8000000 | (simm9&511)<<12 | rn<<5 | rt (byte offset)
    if (off < 0 - 256 || off > 255) {
        emit_add_imm(buf, 17, rn, 0);
        emit_mov_imm64(buf, 16, off as i64);
        emit_add_rr(buf, 17, 17, 16);
        emit_str_uoff(buf, rt, 17, 0);
        return;
    }
    let simm: i32 = off;
    if (simm < 0) { simm = simm + 512; }
    let low: i32 = simm * 4096 + rn * 32 + rt;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(low / 65536), 248);
}

fn emit_b(buf: *ArrayList[u8], imm26: i32) void {
    let low: i32 = imm26 & 67108863;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(low / 65536), 20 + low / 16777216);
}

fn emit_bl(buf: *ArrayList[u8], imm26: i32) void {
    let low: i32 = imm26 & 67108863;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(low / 65536), 148 + low / 16777216);
}

// FP data-processing (double precision). rd/rn/rm are D-register numbers.
fn emit_fp2(buf: *ArrayList[u8], op10: i32, rd: i32, rn: i32, rm: i32) void {
    // 0x1E600800-style: 0001 1110 011 rm  opcode(4)«12» 10 rn rd
    let low: i32 = rd + rn * 32 + op10 * 2048 + rm * 65536;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(96 + rm), 30);
}
fn emit_fadd(buf: *ArrayList[u8], rd: i32, rn: i32, rm: i32) void {
    // FADD Dd,Dn,Dm = 0x1E602800 | rm<<16 | rn<<5 | rd
    let low: i32 = rd + rn * 32 + 10240;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(96 + rm), 30);
}
fn emit_fsub(buf: *ArrayList[u8], rd: i32, rn: i32, rm: i32) void {
    // FSUB = 0x1E603800
    let low: i32 = rd + rn * 32 + 14336;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(96 + rm), 30);
}
fn emit_fmul(buf: *ArrayList[u8], rd: i32, rn: i32, rm: i32) void {
    // FMUL = 0x1E600800
    let low: i32 = rd + rn * 32 + 2048;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(96 + rm), 30);
}
fn emit_fdiv(buf: *ArrayList[u8], rd: i32, rn: i32, rm: i32) void {
    // FDIV = 0x1E601800
    let low: i32 = rd + rn * 32 + 6144;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(96 + rm), 30);
}
fn emit_fcmp(buf: *ArrayList[u8], rn: i32, rm: i32) void {
    // FCMP Dn,Dm = 0x1E602000 | rm<<16 | rn<<5
    let low: i32 = rn * 32 + 8192;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(96 + rm), 30);
}
fn emit_fmov_dx(buf: *ArrayList[u8], rd: i32, rn: i32) void {
    // FMOV Dd, Xn = 0x9E670000 | rn<<5 | rd
    let low: i32 = rd + rn * 32;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), 103, 158);
}
fn emit_fmov_xd(buf: *ArrayList[u8], rd: i32, rn: i32) void {
    // FMOV Xd, Dn = 0x9E660000 | rn<<5 | rd
    let low: i32 = rd + rn * 32;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), 102, 158);
}
fn emit_scvtf(buf: *ArrayList[u8], rd: i32, rn: i32) void {
    // SCVTF Dd, Xn = 0x9E620000 | rn<<5 | rd
    let low: i32 = rd + rn * 32;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), 98, 158);
}
fn emit_fcvtzs(buf: *ArrayList[u8], rd: i32, rn: i32) void {
    // FCVTZS Xd, Dn = 0x9E780000 | rn<<5 | rd
    let low: i32 = rd + rn * 32;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), 120, 158);
}

fn emit_sxtw(buf: *ArrayList[u8], rd: i32, rn: i32) void {
    // SXTW Xd, Wn = SBFM Xd, Xn, #0, #31 = 0x93407C00 | rn<<5 | rd
    let low: i32 = 31744 + rn * 32 + rd;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), 64, 147);
}

fn emit_ldrb_uoff(buf: *ArrayList[u8], rt: i32, rn: i32, off: i32) void {
    // LDRB Wt, [Xn, #imm12] = 0x39400000 | imm12<<10 | rn<<5 | rt (byte offset)
    let low: i32 = off * 1024 + rn * 32 + rt;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(64 + low / 65536), 57);
}

fn emit_strb_uoff(buf: *ArrayList[u8], rt: i32, rn: i32, off: i32) void {
    // STRB Wt, [Xn, #imm12] = 0x39000000 | imm12<<10 | rn<<5 | rt
    let low: i32 = off * 1024 + rn * 32 + rt;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(low / 65536), 57);
}

fn emit_ldrb_soff(buf: *ArrayList[u8], rt: i32, rn: i32, off: i32) void {
    // LDURB Wt, [Xn, #simm9] = 0x38400000 | (simm9&511)<<12 | rn<<5 | rt
    if (off >= 0 && off <= 4095) { emit_ldrb_uoff(buf, rt, rn, off); return; }
    if (off < 0 - 256) {
        emit_add_imm(buf, 17, rn, 0);
        emit_mov_imm64(buf, 16, off as i64);
        emit_add_rr(buf, 17, 17, 16);
        emit_ldrb_uoff(buf, rt, 17, 0);
        return;
    }
    let simm: i32 = off;
    if (simm < 0) { simm = simm + 512; }
    let low: i32 = simm * 4096 + rn * 32 + rt;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(64 + low / 65536), 56);
}

fn emit_strb_soff(buf: *ArrayList[u8], rt: i32, rn: i32, off: i32) void {
    // STURB Wt, [Xn, #simm9] = 0x38000000 | (simm9&511)<<12 | rn<<5 | rt
    if (off >= 0 && off <= 4095) { emit_strb_uoff(buf, rt, rn, off); return; }
    if (off < 0 - 256) {
        emit_add_imm(buf, 17, rn, 0);
        emit_mov_imm64(buf, 16, off as i64);
        emit_add_rr(buf, 17, 17, 16);
        emit_strb_uoff(buf, rt, 17, 0);
        return;
    }
    let simm: i32 = off;
    if (simm < 0) { simm = simm + 512; }
    let low: i32 = simm * 4096 + rn * 32 + rt;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(low / 65536), 56);
}

fn emit_bcond(buf: *ArrayList[u8], cond: i32, imm19: i32) void {
    let low: i32 = ((imm19 & 524287) * 32) + cond;
    emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(low / 65536), 84);
}

fn bcond_cc(kind: i32) i32 {
    if (kind == AK_JE())  { return ACC_EQ(); }
    if (kind == AK_JNE()) { return ACC_NE(); }
    if (kind == AK_JL())  { return ACC_LT(); }
    if (kind == AK_JLE()) { return ACC_LE(); }
    if (kind == AK_JG())  { return ACC_GT(); }
    return ACC_GE();
}

fn a_is_jcc(kind: i32) i32 {
    if (kind == AK_JE())  { return 1; }
    if (kind == AK_JNE()) { return 1; }
    if (kind == AK_JL())  { return 1; }
    if (kind == AK_JLE()) { return 1; }
    if (kind == AK_JG())  { return 1; }
    if (kind == AK_JGE()) { return 1; }
    return 0;
}

fn a_encode_one(buf: *ArrayList[u8], ins: AInstr, labels: ArrayList[i32], base_off: i32) void {
    let k: i32 = ins.kind;
    if (k == AK_LABEL()) { return; }

    if (k == AK_MOV_IMM()) { emit_mov_imm64(buf, ins.dst, ins.imm); return; }
    if (k == AK_MOV_RR()) {
        // Register 31 is XZR in ORR but SP in ADD — use ADD for SP copies.
        if (ins.src == A_SP()) { emit_add_imm(buf, ins.dst, A_SP(), 0); return; }
        if (ins.dst == A_SP()) { emit_add_imm(buf, A_SP(), ins.src, 0); return; }
        emit_orr(buf, ins.dst, ins.src);
        return;
    }
    if (k == AK_ADD_RR()) { emit_add_rr(buf, ins.dst, ins.dst, ins.src); return; }
    if (k == AK_SUB_RR()) { emit_sub_rr(buf, ins.dst, ins.dst, ins.src); return; }
    if (k == AK_MUL_RR()) { emit_mul(buf, ins.dst, ins.src, ins.imm as i32); return; }
    if (k == AK_SDIV()) { emit_sdiv(buf, ins.dst, ins.src, ins.imm as i32); return; }
    if (k == AK_CMP_RR()) { emit_cmp_rr(buf, ins.dst, ins.src); return; }
    if (k == AK_CMP_IMM()) {
        let v: i64 = ins.imm;
        if (v >= 0 && v <= 4095) { emit_cmp_imm(buf, ins.dst, v as i32); }
        else {
            emit_mov_imm64(buf, A_X9(), v);
            emit_cmp_rr(buf, ins.dst, A_X9());
        }
        return;
    }
    if (k == AK_ADD_IMM()) { emit_add_imm(buf, ins.dst, ins.dst, ins.imm as i32); return; }
    if (k == AK_SUB_IMM()) { emit_sub_imm(buf, ins.dst, ins.dst, ins.imm as i32); return; }
    if (k == AK_NEG()) { emit_neg(buf, ins.dst, ins.src); return; }
    if (k == AK_SXTW()) { emit_sxtw(buf, ins.dst, ins.src); return; }
    if (k == AK_AND_IMM()) {
        emit_mov_imm64(buf, A_X9(), ins.imm);
        emit_and_rr(buf, ins.dst, ins.dst, A_X9());
        return;
    }
    // Expression stack grows upward from X28 within the reserved frame area.
    if (k == AK_PUSH()) {
        emit_str_uoff(buf, ins.dst, A_X28(), 0);
        emit_add_imm(buf, A_X28(), A_X28(), 8);
        return;
    }
    if (k == AK_POP()) {
        emit_sub_imm(buf, A_X28(), A_X28(), 8);
        emit_ldr_uoff(buf, ins.dst, A_X28(), 0);
        return;
    }
    if (k == AK_LOAD()) {
        let d: i32 = ins.disp;
        if (d >= 0 && (d % 8) == 0 && d <= 32760) { emit_ldr_uoff(buf, ins.dst, ins.src, d); }
        else { emit_ldr_soff(buf, ins.dst, ins.src, d); }
        return;
    }
    if (k == AK_STORE()) {
        let d: i32 = ins.disp;
        if (d >= 0 && (d % 8) == 0 && d <= 32760) { emit_str_uoff(buf, ins.src, ins.dst, d); }
        else { emit_str_soff(buf, ins.src, ins.dst, d); }
        return;
    }
    if (k == AK_LOADB()) { emit_ldrb_soff(buf, ins.dst, ins.src, ins.disp); return; }
    if (k == AK_STOREB()) { emit_strb_soff(buf, ins.src, ins.dst, ins.disp); return; }
    if (k == AK_XOR_RR()) { emit_eor_rr(buf, ins.dst, ins.dst, ins.src); return; }
    if (k == AK_OR_RR()) { emit_orr_rr(buf, ins.dst, ins.dst, ins.src); return; }
    if (k == AK_ANDR_RR()) { emit_and_rr(buf, ins.dst, ins.dst, ins.src); return; }
    if (k == AK_SHL_RR()) { emit_lslv(buf, ins.dst, ins.dst, ins.src); return; }
    if (k == AK_SHR_RR()) { emit_asrv(buf, ins.dst, ins.dst, ins.src); return; }
    if (k == AK_FMOV_DX()) { emit_fmov_dx(buf, ins.dst, ins.src); return; }
    if (k == AK_FMOV_XD()) { emit_fmov_xd(buf, ins.dst, ins.src); return; }
    if (k == AK_FADD()) { emit_fadd(buf, ins.dst, ins.dst, ins.src); return; }
    if (k == AK_FSUB()) { emit_fsub(buf, ins.dst, ins.dst, ins.src); return; }
    if (k == AK_FMUL()) { emit_fmul(buf, ins.dst, ins.dst, ins.src); return; }
    if (k == AK_FDIV()) { emit_fdiv(buf, ins.dst, ins.dst, ins.src); return; }
    if (k == AK_FCMP()) { emit_fcmp(buf, ins.dst, ins.src); return; }
    if (k == AK_SCVTF()) { emit_scvtf(buf, ins.dst, ins.src); return; }
    if (k == AK_FCVTZS()) { emit_fcvtzs(buf, ins.dst, ins.src); return; }
    if (k == AK_CALL()) {
        let tgt: i32 = get[i32](labels, ins.lbl);
        let rel: i32 = (tgt - base_off) / 4;
        emit_bl(buf, rel);
        return;
    }
    if (k == AK_JMP()) {
        let tgt: i32 = get[i32](labels, ins.lbl);
        let rel: i32 = (tgt - base_off) / 4;
        emit_b(buf, rel);
        return;
    }
    if (a_is_jcc(k) == 1) {
        let tgt: i32 = get[i32](labels, ins.lbl);
        let rel: i32 = (tgt - base_off) / 4;
        emit_bcond(buf, bcond_cc(k), rel);
        return;
    }
    if (k == AK_RET()) { emit_pack(buf, 192, 3, 95, 214); return; }
    if (k == AK_SVC()) { emit_pack(buf, 1, 0, 0, 212); return; }
    if (k == AK_LEA_LBL()) {
        let tgt: i32 = get[i32](labels, ins.lbl);
        let rel: i32 = tgt - base_off;
        let immhi: i32 = (rel / 4) / 8192;
        let immlo: i32 = ((rel / 4) % 4) * 64;
        let imm21: i32 = ((immhi % 1048576) * 4) + (immlo / 64);
        let low: i32 = imm21 * 32 + ins.dst;
        emit_pack(buf, a_lo3(low), a_lo3(low / 256), a_lo3(low / 65536), 16);
        return;
    }
}

fn aencode(prog: ArrayList[AInstr]) ArrayList[u8] {
    let n: i32 = prog.len;
    let maxlbl: i32 = 0;
    let i: i32 = 0;
    while (i < n) {
        let ins: AInstr = get[AInstr](prog, i);
        if (ins.lbl > maxlbl) { maxlbl = ins.lbl; }
        i = i + 1;
    }
    let nlbl: i32 = maxlbl + 1;
    let labels: ArrayList[i32] = make[i32](nlbl + 1);
    let j: i32 = 0;
    while (j < nlbl) { push[i32](&labels, 0); j = j + 1; }

    let scratch: ArrayList[u8] = make[u8](64);
    i = 0;
    while (i < n) {
        let ins1: AInstr = get[AInstr](prog, i);
        let here: i32 = scratch.len;
        if (ins1.kind == AK_LABEL()) { set[i32](&labels, ins1.lbl, here); }
        a_encode_one(&scratch, ins1, labels, here);
        i = i + 1;
    }

    let out: ArrayList[u8] = make[u8](scratch.len + 8);
    i = 0;
    while (i < n) {
        let ins2: AInstr = get[AInstr](prog, i);
        let off: i32 = out.len;
        a_encode_one(&out, ins2, labels, off);
        i = i + 1;
    }
    return out;
}