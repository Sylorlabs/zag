// Minimal source-level AArch64 ELF-writer witness. The x86-64 foreground
// compiler builds this runner; the runner emits a freestanding AArch64 program
// that exits with status 42 through Linux syscall 93.

@import("elf.zag")
@import("elf_arm64.zag")

fn main() i32 {
    if (_zag_argc() != 2) { return 2; }
    let text: ArrayList[u8] = make[u8](16);
    // movz x0,#42 ; movz x8,#93 ; svc #0 (little-endian AArch64 words).
    push[u8](&text, 64);  push[u8](&text, 5);  push[u8](&text, 128); push[u8](&text, 210);
    push[u8](&text, 168); push[u8](&text, 11); push[u8](&text, 128); push[u8](&text, 210);
    push[u8](&text, 1);   push[u8](&text, 0);  push[u8](&text, 0);   push[u8](&text, 212);
    let data: ArrayList[u8] = make[u8](1);
    return write_elf_arm64_data(_zag_arg(1), text, 0, data);
}
