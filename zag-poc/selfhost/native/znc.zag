        return 0;
    }
    if (kind == 3) {
        return (@strEq(name, "_zag_print") || @strEq(name, "_zag_read_fd")) as i32;
    }
    if (kind == 7) {
        return ((znc_script_owner_ends(owner, "script_path_join") == 1) && @strEq(name, "_zag_exit")) as i32;
    }
    if (kind == 8) {
        if (@strEq(name, "_zag_exit")) {
            return ((((((znc_script_owner_ends(owner, "script_json_normalize") == 1) || (znc_script_owner_ends(owner, "script_json_bool_array") == 1)) || (znc_script_owner_ends(owner, "script_json_int_array_encode") == 1)) || (znc_script_owner_ends(owner, "script_json_bool_array_encode") == 1)) || (znc_script_owner_ends(owner, "script_json_float_array_encode") == 1)) || (znc_script_owner_ends(owner, "script_json_string_map_encode") == 1)) as i32;
        }
        if (((((((znc_script_owner_ends(owner, "script_json_int_array_encode") == 1) || (znc_script_owner_ends(owner, "script_json_string_array_encode") == 1)) || (znc_script_owner_ends(owner, "script_json_float_array_encode") == 1)) || (znc_script_owner_ends(owner, "script_json_string_map_encode") == 1)) || (znc_script_owner_ends(owner, "script_json_string_map_descriptor_valid") == 1)) || (znc_script_owner_ends(owner, "script_csv_rows_encode") == 1)) && ((@strEq(name, "_zag_i64_to_str") || @strEq(name, "_zag_slice_ptr")) || @strEq(name, "_zag_free"))) {
            return 1;
