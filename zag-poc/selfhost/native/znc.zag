                            }
                        }
                        rdi = rdi + 1;
                    }
                }
            }
            else => {
            }
        }
        cdi = cdi + 1;
    }
    if ((captured_closure.len > 0) && (root_try == 1)) {
        _zag_eprintln("znc explicit: scalar captured-closure expansion requires a non-error root return");
        return bad;
    }
    let process_prelude: i32 = (znc_harden_root_has_call(unit.decls, "process_run_bounded_script") || znc_harden_root_has_call(unit.decls, "process_run_argv_bounded_script")) as i32;
    let process_edition_ok: i32 = 1;
    let reserved_conflict: i32 = contains_text(src, "__zag_hardened_");
    let bound_body: []u8 = "";
    if (captured_closure.len > 0) {
        bound_body = znc_harden_render_captured_body(unit.decls, captured_closure, captured_binding);
    } else {
        bound_body = znc_harden_render_bound_body(unit.decls);
    }
    let supported: i32 = ((((bound_body.len > 0) && (late_declaration == 0)) && (reserved_conflict == 0)) && (process_edition_ok == 1)) as i32;
    let candidate: []u8 = "";
    let header_start: i32 = 0;
    let header_end: i32 = 0;
    let body_derived_start: i32 = 0;
    let wrapper_start: i32 = 0;
    let imports: []u8 = "";
    if (unresolved_prelude == 1) {
        imports = znc_harden_prelude_imports(unit.decls);
    }
    let rendered: []u8 = bound_body;
    if (supported == 1) {
        let header: []u8 = znc_harden_explicit_header(config, resolution, root_try);
        header_start = ((marker.start + declarations.len) + imports.len) + late_fn_declarations.len;
        header_end = header_start + header.len;
        body_derived_start = header_end;
        wrapper_start = body_derived_start + rendered.len;
        candidate = _zag_str_concat(src[0..marker.start], imports);
        candidate = _zag_str_concat(candidate, declarations);
        candidate = _zag_str_concat(candidate, late_fn_declarations);
        candidate = _zag_str_concat(candidate, header);
        candidate = _zag_str_concat(candidate, rendered);
        candidate = _zag_str_concat(candidate, znc_harden_wrapper(root_try));
    }
    let candidate_valid: i32 = supported;
    if ((candidate_valid == 1) && (znc_check_src_mode(path, candidate, 1) != 0)) {
        candidate_valid = 0;
    }
    return ZHardenPrepared{ .valid = 1, .source_snapshot = source_snapshot, .active = active, .normalized = normalized, .unit = unit, .config = config, .input = input, .resolution = resolution, .marker = marker, .body_start = body_start, .declarations_len = declarations.len, .header_start = header_start, .header_end = header_end, .body_derived_start = body_derived_start, .wrapper_start = wrapper_start, .active_prefix = active.len - source_snapshot.len, .candidate = candidate, .supported = supported, .candidate_valid = candidate_valid, .bound_body = bound_body, .unresolved_prelude = unresolved_prelude, .root_try = root_try, .late_declaration = late_declaration, .late_fn_declarations = late_fn_declarations, .reserved_conflict = reserved_conflict };
}

fn znc_write_new_staging(path: []u8, text: []u8) i32 {
    let cpath: ArrayList[u8] = fc_cstring(path);
    let fd: i64 = _zag_raw_syscall(2, _zag_slice_ptr(cpath.data[0..cpath.len]) as i64, 655553, 384, 0, 0, 0);
    free[u8](&cpath);
    if (fd < 0) {
        return 0;
    }
    let off: i32 = 0;
    let ok: i32 = 1;
    while (off < text.len) {
        let wrote: i64 = _zag_raw_syscall(1, fd, _zag_slice_ptr(text[off..text.len]) as i64, text.len - off, 0, 0, 0);
        if (wrote == (0 - 4)) {
            continue;
        }
        if (wrote <= 0) {
            ok = 0;
            break;
        }
        off = off + wrote as i32;
    }
    if ((ok == 1) && (_zag_raw_syscall(74, fd, 0, 0, 0, 0, 0) != 0)) {
        ok = 0;
    }
    let _close: i64 = _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    if (ok == 0) {
        let _remove: i32 = fc_unlink(path);
    }
    return ok;
}

fn znc_publish_staged_new_file(temp: []u8, output: []u8) i32 {
    let from: ArrayList[u8] = fc_cstring(temp);
    let to: ArrayList[u8] = fc_cstring(output);
    let renamed: i64 = _zag_raw_syscall(316, 0 - 100, _zag_slice_ptr(from.data[0..from.len]) as i64, 0 - 100, _zag_slice_ptr(to.data[0..to.len]) as i64, 1, 0);
    free[u8](&from);
    free[u8](&to);
    if (renamed != 0) {
        let _remove: i32 = fc_unlink(temp);
        return 0;
    }
    return 1;
}

fn znc_publish_new_file(output: []u8, text: []u8) i32 {
    let temp: []u8 = fc_temp_path(output);
    if ((znc_path_absent_nofollow(temp) == 0) || (znc_write_new_staging(temp, text) == 0)) {
        return 0;
    }
    return znc_publish_staged_new_file(temp, output);
}

fn znc_explain_capture(path: []u8, output: []u8) i32 {
    if (((path.len == 0) || (output.len == 0)) || @strEq(path, output)) {
        return 1;
    }
    if (znc_path_absent_nofollow(output) == 0) {
        _zag_eprintln("znc expand: explained output already exists or is not safe");
        return 1;
    }
    let temp: []u8 = fc_temp_path(output);
    if (znc_path_absent_nofollow(temp) == 0) {
        _zag_eprintln("znc expand: explained staging path is not safe");
        return 1;
    }
    let ctemp: ArrayList[u8] = fc_cstring(temp);
    let fd: i64 = _zag_raw_syscall(2, _zag_slice_ptr(ctemp.data[0..ctemp.len]) as i64, 655553, 384, 0, 0, 0);
    free[u8](&ctemp);
    if (fd < 0) {
        _zag_eprintln("znc expand: failed to create explained staging output");
        return 1;
    }
    let saved: i64 = _zag_raw_syscall(32, 1, 0, 0, 0, 0, 0);
    if (saved < 0) {
        let _close: i64 = _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
        let _remove: i32 = fc_unlink(temp);
        return 1;
    }
    let redirected: i64 = _zag_raw_syscall(33, fd, 1, 0, 0, 0, 0);
    if (redirected < 0) {
        let _close_saved: i64 = _zag_raw_syscall(3, saved, 0, 0, 0, 0, 0);
        let _close: i64 = _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
        let _remove: i32 = fc_unlink(temp);
        return 1;
    }
    let rc: i32 = znc_explain(path);
    let restored: i64 = _zag_raw_syscall(33, saved, 1, 0, 0, 0, 0);
    let _close_saved: i64 = _zag_raw_syscall(3, saved, 0, 0, 0, 0, 0);
    let synced: i64 = _zag_raw_syscall(74, fd, 0, 0, 0, 0, 0);
    let _close: i64 = _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    if (((rc != 0) || (restored < 0)) || (synced != 0)) {
        let _remove: i32 = fc_unlink(temp);
        return rc;
    }
    if (znc_publish_staged_new_file(temp, output) == 0) {
        _zag_eprintln("znc expand: failed to publish explained output without replacing an existing entry");
        return 1;
    }
    _zag_println(_zag_str_concat("znc expand: wrote ", output));
    return 0;
}

fn znc_harden_atomic_output(output: []u8, text: []u8) i32 {
    return znc_publish_new_file(output, text);
}

fn znc_harden_unsupported_items(prelude: i32, root_try: i32, late: i32, reserved: i32, invalid: i32) []u8 {
    let out: []u8 = "[";
    let first: i32 = 1;
    if (prelude == 1) {
        out = _zag_str_concat(out, "{\"kind\":\"script_prelude\",\"basis\":\"proven\",\"reason\":\"compiler-bound prelude materialization failed strict validation\"}");
        first = 0;
    }
    if (root_try == 1) {
        if (first == 0) {
            out = _zag_str_concat(out, ",");
        }
        out = _zag_str_concat(out, "{\"kind\":\"error_boundary\",\"basis\":\"proven\",\"reason\":\"root try propagation needs an explicit strict error model\"}");
        first = 0;
    }
    if (late == 1) {
        if (first == 0) {
            out = _zag_str_concat(out, ",");
        }
        out = _zag_str_concat(out, "{\"kind\":\"declaration_order\",\"basis\":\"proven\",\"reason\":\"declaration follows executable top-level statement\"}");
        first = 0;
    }
    if (reserved == 1) {
        if (first == 0) {
            out = _zag_str_concat(out, ",");
        }
        out = _zag_str_concat(out, "{\"kind\":\"private_name_collision\",\"basis\":\"proven\",\"reason\":\"source uses reserved hardened wrapper prefix\"}");
        first = 0;
    }
    if (invalid == 1) {
        if (first == 0) {
            out = _zag_str_concat(out, ",");
        }
        out = _zag_str_concat(out, "{\"kind\":\"candidate_validation\",\"basis\":\"proven\",\"reason\":\"generated strict candidate failed compiler validation\"}");
    }
    return _zag_str_concat(out, "]");
}

fn znc_harden_text_unsupported(prelude: i32, root_try: i32, late: i32, reserved: i32, invalid: i32) void {
    if (prelude == 1) {
        _zag_println("unsupported: script_prelude [proven] compiler-bound prelude materialization failed strict validation");
    }
    if (root_try == 1) {
        _zag_println("unsupported: error_boundary [proven] root try propagation needs an explicit strict error model");
    }
    if (late == 1) {
        _zag_println("unsupported: declaration_order [proven] declaration follows executable top-level statement");
    }
    if (reserved == 1) {
        _zag_println("unsupported: private_name_collision [proven] source uses reserved hardened wrapper prefix");
    }
    if (invalid == 1) {
        _zag_println("unsupported: candidate_validation [proven] generated strict candidate failed compiler validation");
    }
}

fn znc_harden_legacy_apply_refused() i32 {
    if (has_flag("--apply") == 0) {
        return 0;
    }
    _zag_eprintln("znc harden: --apply is no longer supported; compact source is never replaced by harden; use `znc promote <source> --to explicit --output <path> --test-command <command>` for provenance-backed human-owned source");
    return 1;
}

fn znc_harden(path: []u8) i32 {
    if (znc_harden_legacy_apply_refused() == 1) {
        return 2;
    }
    if (path.len == 0) {
        _zag_eprintln("znc harden: no source file");
        return 1;
    }
    if (foreground_transform_requested() == 1) {
        _zag_eprintln("znc harden: --foreground-transform is not an expansion option");
        return 1;
    }
    if (znc_invalid_project_config(znc_project_root(dir_of(path)), "promotion") == 1) {
        return 1;
    }
    let source_read: ForegroundBoundedRead = fc_read_bounded(path, zdl_max_source_bytes());
    if (source_read.ok == 0) {
        free[u8](&source_read.bytes);
        _zag_eprintln("znc harden: source is missing, unsafe, or exceeds the portable source bound");
        return 1;
    }
    defer free[u8](&source_read.bytes);
    let source_snapshot: []u8 = source_read.bytes.data[0..source_read.bytes.len];
    let prepared: ZHardenPrepared = znc_harden_prepare(path, source_snapshot);
    if (prepared.valid == 0) {
        return 1;
    }
    let config: PlannerConfig = prepared.config;
    let harden_input: PlannerChoices = prepared.input;
    let harden_resolution: PlannerResolution = prepared.resolution;
    let unresolved_prelude: i32 = prepared.unresolved_prelude;
    let root_try: i32 = prepared.root_try;
    let late_declaration: i32 = prepared.late_declaration;
    let reserved_conflict: i32 = prepared.reserved_conflict;
    let supported: i32 = prepared.supported;
    let candidate: []u8 = prepared.candidate;
    let output: []u8 = flag_value("--output");
    let report_format: []u8 = flag_value("--format");
    if (((report_format.len > 0) && (znc_format_text(report_format) == 0)) && (znc_format_json(report_format) == 0)) {
        _zag_eprintln("znc harden: --format must be text or json");
        return 1;
    }
    if ((output.len > 0) && @strEq(output, path)) {
        _zag_eprintln("znc harden: --output must not name the source file");
        return 1;
    }
    if ((output.len > 0) && (znc_path_absent_nofollow(output) == 0)) {
        _zag_eprintln("znc harden: output already exists or is not safe");
        return 1;
    }
    let candidate_valid: i32 = prepared.candidate_valid;
    if ((output.len > 0) && (candidate_valid == 1)) {
        if (znc_harden_snapshot_current(path, prepared) == 0) {
            _zag_eprintln("znc harden: source graph changed after snapshot; refusing output publication");
            return 1;
        }
        if (znc_harden_atomic_output(output, candidate) == 0) {
            _zag_eprintln("znc harden: failed to atomically write candidate");
            return 1;
        }
        if (znc_format_json(report_format) == 0) {
            _zag_println(_zag_str_concat("harden candidate written: ", output));
        }
    } else if (((output.len == 0) && (candidate_valid == 1)) && (znc_format_json(report_format) == 0)) {
        _zag_print(candidate);
    }
    if (znc_format_json(report_format) == 1) {
        let rendered: []u8 = "";
        if ((output.len == 0) && (candidate_valid == 1)) {
            rendered = znc_json_escape(candidate);
        }
        let status: []u8 = "unsupported";
        if (candidate_valid == 1) {
            status = "preview";
        }
        let unsupported_prelude: i32 = ((unresolved_prelude == 1) && (candidate_valid == 0)) as i32;
        let unsupported: []u8 = znc_harden_unsupported_items(unsupported_prelude, ((root_try == 1) && (candidate_valid == 0)) as i32, late_declaration, reserved_conflict, ((supported == 1) && (candidate_valid == 0)) as i32);
        _zag_print("{\"schema_version\":2,\"status\":\"");
        _zag_print(status);
        _zag_print("\",\"candidate_compilable\":");
        _zag_print(znc_json_bool(candidate_valid));
        _zag_print(",\"candidate_checked\":");
        _zag_print(znc_json_bool(candidate_valid));
        _zag_print(",\"source_modified\":false,\"allocator_policy\":{\"value\":\"");
        _zag_print(znc_json_escape(harden_resolution.choices.allocator));
        _zag_print("\",\"id\":");
        _zag_print(_zag_i64_to_str(znc_script_allocator_policy_id(harden_resolution.choices.allocator) as i64));
        _zag_print(",\"basis\":\"");
        if (harden_input.allocator_explicit == 1) {
            _zag_print("explicit");
        } else {
            _zag_print("derived");
        }
        _zag_print("\",\"reclamation\":\"");
        _zag_print(znc_json_escape(znc_script_allocator_reclamation(harden_resolution.choices.allocator)));
        _zag_print("\"},\"output\":\"");
        _zag_print(znc_json_escape(output));
        _zag_print("\",\"candidate\":\"");
        _zag_print(rendered);
        _zag_print("\",\"assumptions\":[\"top-level source order is preserved inside explicit body\",\"Script memory and capability policy constants are explicit\",\"");
        if (root_try == 1) {
            _zag_print("propagated root errors use an explicit catch/report boundary");
        } else {
            _zag_print("no propagated root error operation is present");
        }
        _zag_print("\"],\"parity_tests\":[\"stdout stderr and exit parity\",\"nonzero status parity\",\"filesystem/process capability denial\",\"allocation-limit behavior\"],\"unsupported\":");
        _zag_print(unsupported);
        _zag_println("}");
        return 0;
    }
    if (candidate_valid == 0) {
        _zag_println("harden status: unsupported; no strict candidate was written");
        let unsupported_prelude: i32 = ((unresolved_prelude == 1) && (candidate_valid == 0)) as i32;
        znc_harden_text_unsupported(unsupported_prelude, root_try, late_declaration, reserved_conflict, ((supported == 1) && (candidate_valid == 0)) as i32);
    } else {
        _zag_println("harden status: preview; explicit strict-Zag candidate passed compiler validation");
        _zag_println("harden report: conservative explicit context/allocator/capability expansion");
        if (root_try == 1) {
            _zag_println("assumptions: top-level source order and status return are preserved; propagated root errors use an explicit catch/report boundary");
        } else {
            _zag_println("assumptions: top-level source order and status return are preserved; no propagated root error operation is present");
        }
        _zag_print("explicit policy: allocator=");
        _zag_print(harden_resolution.choices.allocator);
        _zag_print(" id=");
        _zag_print(_zag_i64_to_str(znc_script_allocator_policy_id(harden_resolution.choices.allocator) as i64));
        _zag_print("; ");
        _zag_print(znc_script_allocator_reclamation(harden_resolution.choices.allocator));
        _zag_println("; script memory and filesystem/process capability constants; context init/shutdown around root body");
        if (root_try == 1) {
            _zag_println("error boundary: propagated root errors are caught, reported, and converted to status 1 [proven]");
        } else {
            _zag_println("error boundary: explicit status boundary is identity because no root try propagation was present [proven]");
        }
        _zag_println("tests required: stdout/stderr and exit parity; nonzero status parity; filesystem/process capability denial; allocation-limit behavior");
    }
    return 0;
}

struct ZLedgerDerivedMap {
    items: ArrayList[ZdlDerivedSegmentEvidence],
    valid: i32,
}

fn znc_ledger_runtime_enabled() i32 {
    return 1;
}

fn znc_derivation_ledger_v2(path: []u8, prepared: ZHardenPrepared, test_command: []u8) []u8 {
    if (((prepared.valid == 0) || (prepared.candidate_valid == 0)) || (test_command.len == 0)) {
        return "";
    }
    let image: []u8 = _zag_read_file("/proc/self/exe");
    if (image.len <= 0) {
        return "";
    }
    let semantic_decls: ArrayList[*Node] = prepared.unit.decls;
    lo_operators(semantic_decls);
    let semantic_effects: map__StringMap[i32] = analyze(semantic_decls);
    let semantic_root: []u8 = znc_project_root(dir_of(path));
    let semantic_module: []u8 = znc_project_relative(semantic_root, path);
    let semantic_manifest: []u8 = smp_bounded_manifest(semantic_root, semantic_module, prepared.active, prepared.unit, semantic_effects);
    let semantic_view: SemanticManifestView = semantic_manifest_decode(semantic_manifest);
    if (((semantic_view.valid == 0) || (semantic_view.graph_complete == 0)) || (semantic_manifest.len == 0)) {
        if (semantic_manifest.len > 0) {
            _zag_str_free(semantic_manifest);
        }
        return "";
    }
    let compact_hash: ZagdHash = zagd_content_hash(prepared.source_snapshot);
    let derived_hash: ZagdHash = zagd_content_hash(prepared.candidate);
    let modules: ArrayList[ZdlModuleEvidence] = make[ZdlModuleEvidence](prepared.unit.modules.len);
    let imports: ArrayList[ZdlImportEvidence] = make[ZdlImportEvidence](prepared.unit.imports.len);
    let resources: ArrayList[ZdlResourceEvidence] = make[ZdlResourceEvidence](prepared.unit.resources.len);
    let origins: ArrayList[ZdlAstOriginEvidence] = make[ZdlAstOriginEvidence](prepared.unit.origins.len);
    let segments: ArrayList[ZdlDerivedSegmentEvidence] = make[ZdlDerivedSegmentEvidence](1);
    let choices: ArrayList[ZdlChoiceEvidence] = make[ZdlChoiceEvidence](10);
    let transforms: ArrayList[ZdlTransformEvidence] = make[ZdlTransformEvidence](3);
    let compilers: ArrayList[ZdlCompilerEvidence] = make[ZdlCompilerEvidence](1);
    let verifiers: ArrayList[ZdlVerifierEvidence] = make[ZdlVerifierEvidence](1);
    let i: i32 = 0;
    while (i < prepared.unit.modules.len) {
        let m: ResolvedModule = prepared.unit.modules.data[i];
        push[ZdlModuleEvidence](&modules, ZdlModuleEvidence{ .path = m.path, .source = m.source });
        i = i + 1;
    }
    i = 0;
    while (i < prepared.unit.imports.len) {
        let x: ResolvedImport = prepared.unit.imports.data[i];
        push[ZdlImportEvidence](&imports, ZdlImportEvidence{ .importer = x.importer, .imported = x.imported });
        i = i + 1;
    }
    if (prepared.unresolved_prelude == 1) {
        push[ZdlImportEvidence](&imports, ZdlImportEvidence{ .importer = "<root>", .imported = "compiler-bound-prelude-imports-v1" });
    }
    i = 0;
    while (i < prepared.unit.resources.len) {
        let x: ResolvedResource = prepared.unit.resources.data[i];
        push[ZdlResourceEvidence](&resources, ZdlResourceEvidence{ .path = x.path, .data = x.data });
        i = i + 1;
    }
    i = 0;
    while (i < prepared.unit.origins.len) {
        let x: NodeOrigin = prepared.unit.origins.data[i];
        push[ZdlAstOriginEvidence](&origins, ZdlAstOriginEvidence{ .module = x.module, .stable_id = x.stable_id, .node_kind = node_code(x.node), .line = x.line, .col = x.col, .byte_start = x.byte_start, .byte_end = x.byte_end, .exact = x.exact });
        i = i + 1;
    }
    if (prepared.unresolved_prelude == 1) {
        let split: i32 = prepared.candidate.len / 2;
        if ((prepared.header_start > 0) && (prepared.header_start < prepared.candidate.len)) {
            split = prepared.header_start;
        }
        push[ZdlDerivedSegmentEvidence](&segments, ZdlDerivedSegmentEvidence{ .derived_start = 0, .derived_end = split, .module = "<root>", .source = compact_hash, .source_start = 0, .source_end = prepared.source_snapshot.len, .origin_id = 0, .origin_domain = "compiler-bound-prelude-v1", .exact = 0, .generated = 1, .basis = "compiler-bound-prelude-imports-v1" });
        push[ZdlDerivedSegmentEvidence](&segments, ZdlDerivedSegmentEvidence{ .derived_start = split, .derived_end = prepared.candidate.len, .module = "<root>", .source = compact_hash, .source_start = 0, .source_end = prepared.source_snapshot.len, .origin_id = 0, .origin_domain = "compact-root-envelope-v1", .exact = 0, .generated = 1, .basis = "prepared-candidate-v1" });
    } else {
        push[ZdlDerivedSegmentEvidence](&segments, ZdlDerivedSegmentEvidence{ .derived_start = 0, .derived_end = prepared.candidate.len, .module = "<root>", .source = compact_hash, .source_start = 0, .source_end = prepared.source_snapshot.len, .origin_id = 0, .origin_domain = "compact-root-envelope-v1", .exact = 0, .generated = 1, .basis = "prepared-candidate-v1" });
    }
    let c: PlannerChoices = prepared.resolution.choices;
    let cfg: PlannerConfig = prepared.config;
    let memory_text: []u8 = _zag_i64_to_str(cfg.script_memory_bytes);
    let capability_text: []u8 = _zag_i64_to_str(znc_script_capability_bits(cfg));
    let execution_text: []u8 = _zag_i64_to_str(znc_script_execution_policy(prepared.resolution));
    let automatic_text: []u8 = _zag_i64_to_str(prepared.resolution.automatic_count);
    let unresolved_text: []u8 = _zag_i64_to_str(prepared.resolution.unresolved_count);
    push[ZdlChoiceEvidence](&choices, ZdlChoiceEvidence{ .name = "allocator", .value = c.allocator, .basis = "cli-explicit-or-project-config-v1" });
    push[ZdlChoiceEvidence](&choices, ZdlChoiceEvidence{ .name = "device", .value = c.device, .basis = "cli-explicit-or-project-config-v1" });
    push[ZdlChoiceEvidence](&choices, ZdlChoiceEvidence{ .name = "layout", .value = c.layout, .basis = "cli-explicit-or-project-config-v1" });
    push[ZdlChoiceEvidence](&choices, ZdlChoiceEvidence{ .name = "cpu", .value = c.cpu, .basis = "cli-explicit-or-project-config-v1" });
    push[ZdlChoiceEvidence](&choices, ZdlChoiceEvidence{ .name = "script_memory_bytes", .value = memory_text, .basis = "project-config-v1" });
    push[ZdlChoiceEvidence](&choices, ZdlChoiceEvidence{ .name = "capability_bits", .value = capability_text, .basis = "resolved-policy-v1" });
    push[ZdlChoiceEvidence](&choices, ZdlChoiceEvidence{ .name = "execution_policy", .value = execution_text, .basis = "resolved-policy-v1" });
    push[ZdlChoiceEvidence](&choices, ZdlChoiceEvidence{ .name = "automatic_count", .value = automatic_text, .basis = "planner-resolution-v1" });
    push[ZdlChoiceEvidence](&choices, ZdlChoiceEvidence{ .name = "unresolved_count", .value = unresolved_text, .basis = "planner-resolution-v1" });
    push[ZdlChoiceEvidence](&choices, ZdlChoiceEvidence{ .name = "provenance", .value = prepared.resolution.provenance, .basis = "planner-resolution-v1" });
    push[ZdlTransformEvidence](&transforms, ZdlTransformEvidence{ .name = "script-profile-activation-v1", .input = compact_hash, .output = compact_hash, .inverse = "embedded-compact-snapshot-v1", .proof = "same-prepared-snapshot-v1" });
    push[ZdlTransformEvidence](&transforms, ZdlTransformEvidence{ .name = "script-syntax-normalization-v1", .input = compact_hash, .output = zagd_content_hash(prepared.normalized.source), .inverse = "embedded-compact-snapshot-v1", .proof = "normalized-origin-envelope-v1" });
    push[ZdlTransformEvidence](&transforms, ZdlTransformEvidence{ .name = "explicit-policy-materialization-v1", .input = zagd_content_hash(prepared.normalized.source), .output = derived_hash, .inverse = "embedded-compact-snapshot-v1", .proof = "strict-compiler-check-plus-user-command-v1" });
    let generation: []u8 = zag_version();
    let image_binding: []u8 = zdl_hash_text(zagd_content_hash(image));
    push[ZdlCompilerEvidence](&compilers, ZdlCompilerEvidence{ .generation = generation, .image = image_binding });
    push[ZdlVerifierEvidence](&verifiers, ZdlVerifierEvidence{ .generation = generation, .image = image_binding, .independent = 0 });
    let evidence: ZdlPreparedEvidence = ZdlPreparedEvidence{ .compact_path = path, .compact = prepared.source_snapshot, .derived = prepared.candidate, .semantic_manifest = semantic_manifest, .semantic_graph = semantic_view.graph_identity, .semantic_graph_complete = semantic_view.graph_complete, .compiler_checked = 1, .parity_command = test_command, .parity_exit_zero = 1, .modules = modules, .imports = imports, .resources = resources, .ast_origins = origins, .derived_segments = segments, .choices = choices, .transforms = transforms, .compilers = compilers, .verifiers = verifiers };
    let record: []u8 = zdl_encode_v2(evidence);
    free[ZdlModuleEvidence](&modules);
    free[ZdlImportEvidence](&imports);
    free[ZdlResourceEvidence](&resources);
    free[ZdlAstOriginEvidence](&origins);
    free[ZdlDerivedSegmentEvidence](&segments);
    free[ZdlChoiceEvidence](&choices);
    free[ZdlTransformEvidence](&transforms);
    free[ZdlCompilerEvidence](&compilers);
    free[ZdlVerifierEvidence](&verifiers);
    _zag_free(_zag_slice_ptr(memory_text));
    _zag_free(_zag_slice_ptr(capability_text));
    _zag_free(_zag_slice_ptr(execution_text));
    _zag_free(_zag_slice_ptr(automatic_text));
    _zag_free(_zag_slice_ptr(unresolved_text));
    _zag_free(_zag_slice_ptr(image_binding));
    _zag_free(_zag_slice_ptr(image));
    _zag_str_free(semantic_manifest);
    return record;
}

fn znc_free_ledger_view(view: *ZdlLedgerView) void {
    if (view.*.valid == 0) {
        return;
    }
    _zag_free(_zag_slice_ptr(view.*.compact));
    _zag_free(_zag_slice_ptr(view.*.derived));
    _zag_free(_zag_slice_ptr(view.*.compact_path));
}

fn znc_harden_snapshot_current(path: []u8, prepared: ZHardenPrepared) i32 {
    let root: ForegroundBoundedRead = fc_read_bounded(path, prepared.source_snapshot.len as i64);
    if (root.ok == 0) {
        free[u8](&root.bytes);
        return 0;
    }
    let current: []u8 = root.bytes.data[0..root.bytes.len];
    let valid: i32 = @strEq(current, prepared.source_snapshot) as i32;
    if ((valid == 1) && !@strEq(znc_activate_script_source(path, current, 0), prepared.active)) {
        valid = 0;
    }
    free[u8](&root.bytes);
    if (valid == 0) {
        return 0;
    }
    let i: i32 = 0;
    while (i < prepared.unit.modules.len) {
        let module: ResolvedModule = prepared.unit.modules.data[i];
        if (@strEq(module.path, "<root>")) {
            if (!@strEq(module.source, prepared.active)) {
                return 0;
            }
        } else {
            let read: ForegroundBoundedRead = fc_read_bounded(module.path, module.source.len as i64);
            if (read.ok == 0) {
                free[u8](&read.bytes);
                return 0;
            }
            let same: i32 = @strEq(read.bytes.data[0..read.bytes.len], module.source) as i32;
            free[u8](&read.bytes);
            if (same == 0) {
                return 0;
            }
        }
        i = i + 1;
    }
    i = 0;
    while (i < prepared.unit.resources.len) {
        let resource: ResolvedResource = prepared.unit.resources.data[i];
        let read: ForegroundBoundedRead = fc_read_bounded(resource.path, resource.data.len as i64);
        if (read.ok == 0) {
            free[u8](&read.bytes);
            return 0;
        }
        let same: i32 = @strEq(read.bytes.data[0..read.bytes.len], resource.data) as i32;
        free[u8](&read.bytes);
        if (same == 0) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

fn znc_bounded_file_equal(path: []u8, expected: []u8) i32 {
    let read: ForegroundBoundedRead = fc_read_bounded(path, expected.len as i64);
    if (read.ok == 0) {
        free[u8](&read.bytes);
        return 0;
    }
    let same: i32 = @strEq(read.bytes.data[0..read.bytes.len], expected) as i32;
    free[u8](&read.bytes);
    return same;
}

fn znc_path_absent_nofollow(path: []u8) i32 {
    let cpath: ArrayList[u8] = fc_cstring(path);
    let stat: ArrayList[u8] = make[u8](144);
    stat.len = 144;
    let rc: i64 = _zag_raw_syscall(262, 0 - 100, _zag_slice_ptr(cpath.data[0..cpath.len]) as i64, _zag_slice_ptr(stat.data[0..stat.len]) as i64, 256, 0, 0);
    free[u8](&cpath);
    free[u8](&stat);
    return (rc == (0 - 2)) as i32;
}

fn znc_hex_digit(v: i32) u8 {
    if (v < 10) {
        return (48 as i32 + v) as u8;
    }
    return ((97 as i32 + v) - 10) as u8;
}

fn znc_hex_encode(bytes: []u8) []u8 {
    let out: ArrayList[u8] = make[u8]((bytes.len * 2) + 1);
    let i: i32 = 0;
    while (i < bytes.len) {
        push[u8](&out, znc_hex_digit(bytes[i] as i32 / 16));
        push[u8](&out, znc_hex_digit(bytes[i] as i32 % 16));
        i = i + 1;
    }
    return out.data[0..out.len];
}

