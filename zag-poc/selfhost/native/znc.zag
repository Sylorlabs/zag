        return (((((((((((((((((@strEq(name, "csv__csv_parse_bounded") || @strEq(name, "csv__csv_default_max_bytes")) || @strEq(name, "csv__csv_default_max_rows")) || @strEq(name, "csv__csv_default_max_cells")) || @strEq(name, "csv__csv_default_max_field_bytes")) || @strEq(name, "csv__csv_encode_bounded")) || @strEq(name, "csv__csv_default_max_output_bytes")) || @strEq(name, "csv__csv_encode_result_free")) || @strEq(name, "csv__csv_free")) || @strEq(name, "csv_parse_bounded")) || @strEq(name, "csv_default_max_bytes")) || @strEq(name, "csv_default_max_rows")) || @strEq(name, "csv_default_max_cells")) || @strEq(name, "csv_default_max_field_bytes")) || @strEq(name, "csv_encode_bounded")) || @strEq(name, "csv_default_max_output_bytes")) || @strEq(name, "csv_encode_result_free")) || @strEq(name, "csv_free")) as i32;
    }
    if (kind == 6) {
