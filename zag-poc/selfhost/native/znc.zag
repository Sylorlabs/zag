fn znc_decls_have_cabi(decls: ArrayList[*Node]) i32 {
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                let ai: i32 = 0;
                while (ai < len[[]u8](f.annots)) {
                    if (@strEq(get[[]u8](f.annots, ai), "@cabi")) {
                        return 1;
                    }
                    ai = ai + 1;
                }
            }
            else => {
            }
        }
        i = i + 1;
    }
    return 0;
}

fn znc_reject_v2_cabi_non_native(path: []u8) i32 {
    if (@strEq(v2_project_edition(path), "2027") == 0) {
        return 0;
    }
    let src: []u8 = _zag_read_file(path);
    if (src.len < 0) {
        return 0;
    }
    let unit: CompilationUnit = parse_compilation_unit_dir(src, dir_of(path));
    if (znc_decls_have_cabi(unit.decls) == 1) {
        if (((arm64_target() == 1) && (((has_flag("--emit-obj") == 1) || (has_flag("--dynamic") == 1)) || (znc_driver_module_mode() == 1))) || ((i686_target() == 1) && (znc_driver_module_mode() == 1))) {
            return 0;
        }
        _zag_eprintln("znc: v2 @cabi imports are currently supported only for native x86-64 --dynamic output or arm64 --emit-obj/--dynamic");
        _zag_eprintln("note: no v2 C ABI object, archive, WASM, ARM64, or GPU artifact was emitted");
        return 1;
    }
    return 0;
}

fn build_i686_minimal(path: []u8) i32 {
    let src: []u8 = _zag_read_file(path);
    if (src.len < 0) {
        _zag_eprintln("znc i686: cannot read source");
        return 1;
    }
    let driver_mode: i32 = znc_driver_module_mode();
    if (driver_mode == 1) {
        if (has_flag("--link-i686") == 1) {
            _zag_eprintln("znc i686: --emit-driver-module cannot be combined with --link-i686");
            return 1;
        }
        if (znc_driver_kernel_series() == 0) {
            _zag_eprintln("znc: --emit-driver-module requires --driver-kernel 6.1 or 6.6");
            return 1;
        }
        let requested_target: []u8 = flag_value("--target");
        if (((@strEq(requested_target, "i686") == 0) && (@strEq(requested_target, "x86") == 0)) && (@strEq(requested_target, "linux-i686") == 0)) {
            _zag_eprintln("znc: i686 driver module requires --target i686");
            return 1;
        }
    }
    if (has_flag("--link-i686") == 1) {
        let linked: []u8 = out_flag();
        if (linked.len == 0) {
            linked = default_out(path);
        }
        let inputs: ArrayList[[]u8] = make[[]u8](4);
        push[[]u8](&inputs, src);
        let ai: i32 = 2;
        while (ai < _zag_argc()) {
            let a: []u8 = _zag_arg(ai);
            if (@strEq(a, "-o") || @strEq(a, "--target")) {
                ai = ai + 2;
            } else if ((a.len > 0) && (a[0] == 45)) {
                ai = ai + 1;
            } else {
                let extra: []u8 = _zag_read_file(a);
                if (extra.len < 0) {
                    _zag_eprintln(_zag_str_concat("znc i686: cannot read link input: ", a));
                    return 1;
                }
                push[[]u8](&inputs, extra);
                ai = ai + 1;
            }
        }
        if (write_i686_linked_objects(linked, inputs) != 0) {
            return 1;
        }
        _zag_println(_zag_str_concat("znc: linked ELF32/i386 executable ", linked));
        return 0;
    }
    if (znc_validate_compilation_source(path, src) != 0) {
        return 1;
    }
    let unit: CompilationUnit = parse_compilation_unit_dir(src, dir_of(path));
    if (unit.profile == ModuleProfile.script) {
        _zag_eprintln("znc i686: unsupported construct: Zag Script runtime is not implemented");
        return 1;
    }
    let decls: ArrayList[*Node] = unit.decls;
    lo_operators(decls);
    let aerrs: i32 = znc_check_arity(decls);
    if (aerrs > 0) {
        _zag_println("znc: arity check FAILED");
        return 1;
    }
    let derrs: i32 = znc_check_dups(decls);
    if (derrs > 0) {
        _zag_println("znc: duplicate-definition check FAILED");
        return 1;
    }
    if (typed_check_program(decls, path) > 0) {
        return 1;
    }
    let eff: map__StringMap[i32] = analyze(decls);
    let viols: i32 = report_violations(decls, eff, src, path);
    if (viols > 0) {
        _zag_println("znc: capability check FAILED");
        return 1;
    }
    cg_ginfer_pass(decls);
    decls = cg_expand_generics(decls);
    let object_mode: i32 = (((has_flag("--emit-obj") == 1) || (has_flag("--emit-static") == 1)) || (driver_mode == 1)) as i32;
    let lower: I386Lower = I386Lower{ .ir = make[I32IR](32), .locals = make[I386Local](8), .funcs = make[I386Fn](8), .structs = make[StructDecl](4), .strings = make[[]u8](4), .object_relocs = make[I686CodeReloc](4), .failed = 0, .next_label = 0, .next_slot = 0, .break_label = -1, .continue_label = -1, .current_error_fn = 0, .expected_ty = "", .current_ret_ty = "", .current_fn_name = "", .sret_target = -1, .object_mode = object_mode };
    if (lower_i386_i32_program(decls, &lower) != 0) {
        return 1;
    }
    let text: ArrayList[u8] = encode_i386_i32(&lower);
    let out: []u8 = out_flag();
    if (out.len == 0) {
        out = default_out(path);
    }
    if (object_mode == 1) {
        let code: I686ObjectCode = i386_object_code(&lower, text);
        if (driver_mode == 1) {
            if (znc_driver_entries_ok(decls, path) == 0) {
                return 1;
            }
            if (code.relocs.len == 0) {
                _zag_eprintln("znc: driver module requires at least one explicit kernel @cabi import relocation");
                return 1;
            }
            let exports: ArrayList[ZncObjectExport] = znc_x86_object_exports(decls);
            if (exports.len < 2) {
                _zag_eprintln("znc: driver module requires both init_module and cleanup_module exports");
                return 1;
            }
            let symbols: ArrayList[DriverElfSymbol] = znc_driver_i686_symbols(exports, code, text.len);
            if (symbols.len != exports.len) {
                _zag_eprintln("znc: driver module export symbols were not encoded for i686");
                return 1;
            }
            let imports: ArrayList[[]u8] = znc_driver_i686_imports(code);
            let text_relocs: ArrayList[DriverElfReloc] = znc_driver_i686_text_relocs(code, exports, imports);
            if (text_relocs.len == 0) {
                _zag_eprintln("znc: driver module i686 relocation set is unsupported");
                return 1;
            }
            let module_data: ArrayList[u8] = znc_driver_data_anchor32();
            let data_relocs: ArrayList[DriverElfReloc] = make[DriverElfReloc](1);
            let init_index: i32 = znc_driver_export_index(exports, "init_module");
            if (init_index < 0) {
                _zag_eprintln("znc: driver module init_module export disappeared before i686 object emission");
                return 1;
            }
            push[DriverElfReloc](&data_relocs, DriverElfReloc{ .offset = 0, .symbol = 4 + init_index, .typ = 1, .addend = 0 });
            let debug: DwarfSections = znc_driver_debug(path, decls);
            let spec_target: []u8 = "i686";
            if (write_driver_elf32(out, text, module_data, znc_driver_modinfo(znc_driver_kernel_series(), spec_target), symbols, imports, text_relocs, data_relocs, debug.abbrev, debug.info, debug.line_) != 0) {
                _zag_eprintln("znc: failed to write deterministic i686 Zag driver ET_REL");
                return 1;
            }
            _zag_println(_zag_str_concat("znc: wrote i686 Zag Linux driver ET_REL ", out));
            return 0;
        }
        if (has_flag("--emit-obj") == 1) {
            if (write_i686_object_code(out, code) != 0) {
                _zag_eprintln("znc i686: failed to write ELF32 object");
                return 1;
            }
            _zag_println(_zag_str_concat("znc: wrote ELF32/i386 object ", out));
            return 0;
        }
        if (write_i686_archive_code(out, code) != 0) {
            _zag_eprintln("znc i686: failed to write static archive");
            return 1;
        }
        _zag_println(_zag_str_concat("znc: wrote ELF32/i386 archive ", out));
        return 0;
    }
    if (write_i686_text(out, text) != 0) {
        _zag_eprintln("znc i686: failed to write ELF32 executable");
        return 1;
    }
    _zag_println(_zag_str_concat("znc: wrote ELF32/i386 i32 binary ", out));
    return 0;
}

fn stem_of(path: []u8) []u8 {
    let slash: i32 = 0 - 1;
    let i: i32 = 0;
    while (i < path.len) {
        if (path[i] == 47) {
            slash = i;
        }
        i = i + 1;
    }
    let base: []u8 = path;
    if (slash >= 0) {
        base = path[slash + 1..];
    }
    let dot: i32 = 0 - 1;
    let j: i32 = 0;
    while (j < base.len) {
        if (base[j] == 46) {
            dot = j;
        }
        j = j + 1;
    }
    if (dot > 0) {
        return base[0..dot];
    }
    return base;
}

fn znc_arity_exempt(nm: []u8) i32 {
    if (nm.len == 0) {
        return 1;
    }
    if (nm[0] == 64) {
        return 1;
    }
    if (cg_starts_with(nm, "_zag_") == 1) {
        return 1;
    }
    if (cg_starts_with(nm, "__") == 1) {
        return 1;
    }
    if (@strEq(nm, "new") || @strEq(nm, "delete")) {
        return 1;
    }
    if ((@strEq(nm, "print_int") || @strEq(nm, "print_i32")) || @strEq(nm, "print_str")) {
        return 1;
    }
    if (((@strEq(nm, "print_f64") || @strEq(nm, "print_f32")) || @strEq(nm, "print_u64")) || @strEq(nm, "print_i64")) {
        return 1;
    }
    if (@strEq(nm, "zalloc") || @strEq(nm, "zfree")) {
        return 1;
    }
    if ((@strEq(nm, "sinf") || @strEq(nm, "cosf")) || @strEq(nm, "sqrtf")) {
        return 1;
    }
    if ((@strEq(nm, "sin") || @strEq(nm, "cos")) || @strEq(nm, "sqrt")) {
        return 1;
    }
    return 0;
}

fn znc_arity_in(names: ArrayList[[]u8], nm: []u8) i32 {
    let i: i32 = 0;
    while (i < len[[]u8](names)) {
        if (@strEq(get[[]u8](names, i), nm)) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn znc_arity_locals(body: ArrayList[*Node], outn: *ArrayList[[]u8]) void {
    let i: i32 = 0;
    while (i < len[*Node](body)) {
        switch (get[*Node](body, i).*) {
            .let_ => |l| {
                push[[]u8](outn, l.name);
            }
            .if_ => |x| {
                if (x.has_cap == 1) {
                    push[[]u8](outn, x.cap);
                }
                znc_arity_locals(x.then_body, outn);
                znc_arity_locals(x.els_body, outn);
            }
            .while_ => |w| {
                if (w.has_cap == 1) {
                    push[[]u8](outn, w.cap);
                }
                znc_arity_locals(w.body, outn);
            }
            .unsafe_ => |u| {
                znc_arity_locals(u.body, outn);
            }
            .switch_ => |sw| {
                let ai: i32 = 0;
                while (ai < len[SwitchArm](sw.arms)) {
                    let arm: SwitchArm = get[SwitchArm](sw.arms, ai);
                    if (arm.has_cap == 1) {
                        push[[]u8](outn, arm.cap);
                    }
                    znc_arity_locals(arm.body, outn);
                    ai = ai + 1;
                }
                if (sw.has_els == 1) {
                    znc_arity_locals(sw.els_body, outn);
                }
            }
            else => {
            }
        }
        i = i + 1;
    }
}

fn znc_arity_find(decls: ArrayList[*Node], nm: []u8) i32 {
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                if (@strEq(f.name, nm) && (f.is_extern == 0)) {
                    return len[Param](f.params);
                }
            }
            else => {
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn znc_arity_expr(n: *Node, fname: []u8, locals: ArrayList[[]u8], decls: ArrayList[*Node], errs: *i32) void {
    switch (n.*) {
        .call => |c| {
            switch (c.callee.*) {
                .id => |fnid| {
                    if ((znc_arity_exempt(fnid.name) == 0) && (znc_arity_in(locals, fnid.name) == 0)) {
                        let want: i32 = znc_arity_find(decls, fnid.name);
                        if ((want >= 0) && (want != len[*Node](c.args))) {
                            _zag_eprintln(_zag_str_concat("znc: error: call to '", _zag_str_concat(fnid.name, _zag_str_concat("' passes ", _zag_str_concat(_zag_i64_to_str(len[*Node](c.args) as i64), _zag_str_concat(" argument(s), expected ", _zag_str_concat(_zag_i64_to_str(want as i64), _zag_str_concat(" (in fn '", _zag_str_concat(fname, "')")))))))));
                            errs.* = errs.* + 1;
                        }
                    }
                }
                .fld => |mf| {
                    znc_arity_expr(mf.base, fname, locals, decls, errs);
                }
                else => {
                }
            }
            let i: i32 = 0;
            while (i < len[*Node](c.args)) {
                znc_arity_expr(get[*Node](c.args, i), fname, locals, decls, errs);
                i = i + 1;
            }
        }
        .bin => |b| {
            znc_arity_expr(b.l, fname, locals, decls, errs);
            znc_arity_expr(b.r, fname, locals, decls, errs);
        }
        .un => |u| {
            znc_arity_expr(u.e, fname, locals, decls, errs);
        }
        .idx => |ix| {
            znc_arity_expr(ix.base, fname, locals, decls, errs);
            znc_arity_expr(ix.idx, fname, locals, decls, errs);
        }
        .fld => |f| {
            znc_arity_expr(f.base, fname, locals, decls, errs);
        }
        .cast_ => |cst| {
            znc_arity_expr(cst.expr, fname, locals, decls, errs);
        }
        .slit_ => |sl| {
            let i2: i32 = 0;
            while (i2 < len[FieldInit](sl.fields)) {
                znc_arity_expr(get[FieldInit](sl.fields, i2).val, fname, locals, decls, errs);
                i2 = i2 + 1;
            }
        }
        .slice_ => |sc| {
            znc_arity_expr(sc.base, fname, locals, decls, errs);
            znc_arity_expr(sc.lo, fname, locals, decls, errs);
            if (sc.has_hi == 1) {
                znc_arity_expr(sc.hi, fname, locals, decls, errs);
            }
        }
        else => {
        }
    }
}

fn znc_arity_block(body: ArrayList[*Node], fname: []u8, locals: ArrayList[[]u8], decls: ArrayList[*Node], errs: *i32) void {
    let i: i32 = 0;
    while (i < len[*Node](body)) {
        switch (get[*Node](body, i).*) {
            .let_ => |l| {
                if (l.has_init == 1) {
                    znc_arity_expr(l.expr, fname, locals, decls, errs);
                }
            }
            .assign => |a| {
                znc_arity_expr(a.target, fname, locals, decls, errs);
                znc_arity_expr(a.expr, fname, locals, decls, errs);
            }
            .ret => |r| {
                if (r.has_expr == 1) {
                    znc_arity_expr(r.expr, fname, locals, decls, errs);
                }
            }
            .if_ => |x| {
                znc_arity_expr(x.cond, fname, locals, decls, errs);
                znc_arity_block(x.then_body, fname, locals, decls, errs);
                znc_arity_block(x.els_body, fname, locals, decls, errs);
            }
            .while_ => |w| {
                znc_arity_expr(w.cond, fname, locals, decls, errs);
                znc_arity_block(w.body, fname, locals, decls, errs);
            }
            .unsafe_ => |u| {
                znc_arity_block(u.body, fname, locals, decls, errs);
            }
            .defer_ => |d| {
                znc_arity_expr(d.expr, fname, locals, decls, errs);
            }
            .switch_ => |sw| {
                znc_arity_expr(sw.subject, fname, locals, decls, errs);
                let ai: i32 = 0;
                while (ai < len[SwitchArm](sw.arms)) {
                    znc_arity_block(get[SwitchArm](sw.arms, ai).body, fname, locals, decls, errs);
                    ai = ai + 1;
                }
                if (sw.has_els == 1) {
                    znc_arity_block(sw.els_body, fname, locals, decls, errs);
                }
            }
            .estmt => |e| {
                znc_arity_expr(e.expr, fname, locals, decls, errs);
            }
            else => {
            }
        }
        i = i + 1;
    }
}

fn znc_check_arity(decls: ArrayList[*Node]) i32 {
    let errs: i32 = 0;
    let di: i32 = 0;
    while (di < len[*Node](decls)) {
        switch (get[*Node](decls, di).*) {
            .fn_decl => |f| {
                if (((f.is_extern == 0) && (len[*Node](f.body) > 0)) && (cg_starts_with(f.name, "__iface_") == 0)) {
                    let locals: ArrayList[[]u8] = make[[]u8](8);
                    let pi: i32 = 0;
                    while (pi < len[Param](f.params)) {
                        push[[]u8](&locals, get[Param](f.params, pi).name);
                        pi = pi + 1;
                    }
                    if (f.cap_names.len > 0) {
                        let cns: ArrayList[[]u8] = split_args(f.cap_names);
                        let ci: i32 = 0;
                        while (ci < len[[]u8](cns)) {
                            let cn: []u8 = get[[]u8](cns, ci);
                            if ((cn.len > 0) && (cn[0] == 42)) {
                                push[[]u8](&locals, cn[1..]);
                            } else {
                                push[[]u8](&locals, cn);
                            }
                            ci = ci + 1;
                        }
                    }
                    znc_arity_locals(f.body, &locals);
                    znc_arity_block(f.body, f.name, locals, decls, &errs);
                }
            }
            else => {
            }
        }
        di = di + 1;
    }
    return errs;
}

fn znc_dup_report(kind: []u8, nm: []u8) void {
    _zag_eprintln(_zag_str_concat("znc: error: duplicate ", _zag_str_concat(kind, _zag_str_concat(" definition '", _zag_str_concat(nm, "'")))));
}

fn znc_check_dups(decls: ArrayList[*Node]) i32 {
    let fn_names: ArrayList[[]u8] = make[[]u8](64);
    let fn_kind: ArrayList[i32] = make[i32](64);
    let ty_names: ArrayList[[]u8] = make[[]u8](64);
    let errs: i32 = 0;
    let di: i32 = 0;
    while (di < len[*Node](decls)) {
        switch (get[*Node](decls, di).*) {
            .fn_decl => |f| {
                let kind: i32 = 2;
                if (f.is_extern == 1) {
                    kind = 0;
                } else if (len[*Node](f.body) == 0) {
                    kind = 1;
                }
                let j: i32 = 0;
                let hit: i32 = 0 - 1;
                while (j < len[[]u8](fn_names)) {
                    if (@strEq(get[[]u8](fn_names, j), f.name)) {
                        hit = j;
                    }
                    j = j + 1;
                }
                if (hit >= 0) {
                    let prev: i32 = get[i32](fn_kind, hit);
                    let bad: i32 = 0;
                    if ((prev == 0) && (kind != 0)) {
                        bad = 1;
                    }
                    if ((prev != 0) && (kind == 0)) {
                        bad = 1;
                    }
                    if ((prev == 2) && (kind == 2)) {
                        bad = 1;
                    }
                    if (bad == 1) {
                        znc_dup_report("fn", f.name);
                        errs = errs + 1;
                    } else if (kind > prev) {
                        set[i32](&fn_kind, hit, kind);
                    }
                } else {
                    push[[]u8](&fn_names, f.name);
                    push[i32](&fn_kind, kind);
                }
            }
            .struct_ => |s| {
                if (znc_arity_in(ty_names, s.name) == 1) {
                    znc_dup_report("type", s.name);
                    errs = errs + 1;
                } else {
                    push[[]u8](&ty_names, s.name);
                }
            }
            .enum_ => |e| {
                if (znc_arity_in(ty_names, e.name) == 1) {
                    znc_dup_report("type", e.name);
                    errs = errs + 1;
                } else {
                    push[[]u8](&ty_names, e.name);
                }
            }
            .union_ => |u| {
                if (znc_arity_in(ty_names, u.name) == 1) {
                    znc_dup_report("type", u.name);
                    errs = errs + 1;
                } else {
                    push[[]u8](&ty_names, u.name);
                }
            }
            else => {
            }
        }
        di = di + 1;
    }
    return errs;
}

fn znc_count_text(text: []u8, needle: []u8) i32 {
    if (needle.len == 0) {
        return 0;
    }
    let count: i32 = 0;
    let i: i32 = 0;
    while ((i + needle.len) <= text.len) {
        if (@strEq(text[i..i + needle.len], needle)) {
            count = count + 1;
            i = i + needle.len;
        } else {
            i = i + 1;
        }
    }
    return count;
}

fn znc_generated_explicit_source(src: []u8) i32 {
    if ((((contains_text(src, "// Generated by znc harden. These declarations make the former Script runtime policy explicit.") == 0) || (contains_text(src, "fn __zag_hardened_status_boundary(status:i32) i32") == 0)) || (contains_text(src, "fn main() i32") == 0)) || (contains_text(src, "_zag_script_context_init") == 0)) {
        return 0;
    }
    let plain_body: i32 = contains_text(src, "fn __zag_hardened_script_body(__zag_script_context:*opaque) i32");
    let error_body: i32 = (contains_text(src, "fn __zag_hardened_script_body(__zag_script_context:*opaque) !i32") && contains_text(src, "catch |__zag_hardened_error_code| __zag_hardened_uncaught")) as i32;
    if ((plain_body == 0) && (error_body == 0)) {
        return 0;
    }
    return (znc_count_text(src, "*opaque") == 4) as i32;
}

fn znc_validate_compilation_source(path: []u8, src: []u8) i32 {
    return v2_validate_source_mode(path, src, znc_generated_explicit_source(src));
}

fn znc_check_src_mode(path: []u8, src: []u8, generated_explicit: i32) i32 {
    if (v2_validate_source_mode(path, src, generated_explicit) != 0) {
        return 1;
    }
    let unit: CompilationUnit = parse_compilation_unit_dir(src, dir_of(path));
    if (znc_validate_script_defaults(path, unit) != 0) {
        return 1;
    }
    if (znc_configure_script_unit(&unit, path) != 0) {
        return 1;
    }
    if (znc_validate_script_capabilities(path, unit) != 0) {
        return 1;
    }
    let decls: ArrayList[*Node] = unit.decls;
    lo_operators(decls);
    let aerrs: i32 = znc_check_arity(decls);
    if (aerrs > 0) {
        _zag_println("znc: arity check FAILED");
        return 1;
    }
    let derrs: i32 = znc_check_dups(decls);
    if (derrs > 0) {
        _zag_println("znc: duplicate-definition check FAILED");
        return 1;
    }
    if (typed_check_program(decls, path) > 0) {
        return 1;
    }
    let eff: map__StringMap[i32] = analyze(decls);
    let viols: i32 = report_violations(decls, eff, src, path);
    if (viols > 0) {
        _zag_println("znc: capability check FAILED");
        return 1;
    }
    if (run_analyzer(decls, path) != 0) {
        return 1;
    }
    let published: i32 = znc_publish_semantics(path, src, unit, decls, eff);
    znc_maybe_regular_advisory(path, unit, published);
    return 0;
}

fn znc_check_src(path: []u8, src: []u8) i32 {
    return znc_check_src_mode(path, src, znc_generated_explicit_source(src));
}

fn build_gpu(path: []u8, target: []u8) i32 {
    let src: []u8 = _zag_read_file(path);
    if (src.len < 0) {
        _zag_print("znc: cannot read ");
        _zag_println(path);
        return 1;
    }
    if (znc_check_src(path, src) != 0) {
        return 1;
    }
    let mbuf: ArrayList[u8] = emit_mlir_dir(src, dir_of(path), target);
    let mpath: []u8 = _zag_str_concat(stem_of(path), ".mlir");
    if (_zag_write_file(mpath, mbuf.data[0..mbuf.len]) != 0) {
        _zag_println("znc: failed to write MLIR");
        return 1;
    }
    _zag_print("znc: [gpu-");
    _zag_print(target);
    _zag_print("] wrote MLIR ");
    _zag_println(mpath);
    return 0;
}

fn build_gfx1010(path: []u8) i32 {
    let src: []u8 = _zag_read_file(path);
    if (src.len < 0) {
        _zag_print("znc: cannot read ");
        _zag_println(path);
        return 1;
    }
    if (znc_check_src(path, src) != 0) {
        return 1;
    }
    let errors: i32 = 0;
    let bundle: ArrayList[u8] = emit_gfx1010_bundle(src, dir_of(path), &errors);
    if (errors != 0) {
        return 1;
    }
    let out: []u8 = out_flag();
    if (out.len == 0) {
        out = _zag_str_concat(stem_of(path), ".zgk");
    }
    if (_zag_write_file(out, bundle.data[0..bundle.len]) != 0) {
        _zag_println("znc: failed to write gfx1010 kernel bundle");
        return 1;
    }
    _zag_print("znc: [amdgpu-gfx1010] wrote validated kernel bundle ");
    _zag_println(out);
    return 0;
}

fn build_compat(path: []u8, target: []u8) i32 {
    let src: []u8 = _zag_read_file(path);
    if (src.len < 0) {
        _zag_print("znc: cannot read ");
        _zag_println(path);
        return 1;
    }
    if (znc_check_src(path, src) != 0) {
        return 1;
    }
    let errors: i32 = 0;
    let bin: ArrayList[u8] = make[u8](0);
    if (compat_target_uses_spirv(target)) {
        bin = emit_spirv_dir(src, dir_of(path), &errors);
    } else if (compat_target_uses_spirv_opencl(target)) {
        bin = emit_spirv_opencl_dir(src, dir_of(path), &errors);
    } else if (compat_target_uses_msl(target)) {
        bin = emit_msl_dir(src, dir_of(path), &errors);
    } else if (compat_target_uses_glsl(target)) {
        bin = emit_glsl_dir(src, dir_of(path), &errors);
    } else if (compat_target_uses_ptx(target)) {
        bin = emit_ptx_dir(src, dir_of(path), &errors);
    } else {
        _zag_eprintln(_zag_str_concat("znc: compat target not yet implemented: ", target));
        return 1;
    }
    if (errors != 0) {
        return 1;
    }
    let out: []u8 = out_flag();
    if (out.len == 0) {
        if (@strEq(target, "vulkan-compat")) {
            out = _zag_str_concat(stem_of(path), ".spv");
        } else if (@strEq(target, "opencl-compat")) {
            out = _zag_str_concat(stem_of(path), ".spv");
        } else if (@strEq(target, "metal-compat")) {
            out = _zag_str_concat(stem_of(path), ".metal");
        } else if (@strEq(target, "opengl-compat")) {
            out = _zag_str_concat(stem_of(path), ".glsl");
        } else if (@strEq(target, "cuda-compat")) {
            out = _zag_str_concat(stem_of(path), ".ptx");
        } else {
            out = _zag_str_concat(stem_of(path), ".compat");
        }
    }
    if (_zag_write_file(out, bin.data[0..bin.len]) != 0) {
        _zag_println("znc: failed to write compat kernel");
        return 1;
    }
    _zag_print("znc: [");
    _zag_print(target);
    _zag_print("] wrote ");
    if (compat_target_uses_spirv(target)) {
        _zag_print("SPIR-V binary ");
    } else if (compat_target_uses_spirv_opencl(target)) {
        _zag_print("SPIR-V binary (OpenCL) ");
    } else if (compat_target_uses_msl(target)) {
        _zag_print("Metal source ");
    } else if (compat_target_uses_glsl(target)) {
        _zag_print("GLSL source ");
    } else if (compat_target_uses_ptx(target)) {
        _zag_print("PTX source ");
    } else {
        _zag_print("compat output ");
    }
    _zag_println(out);
    return 0;
}

fn build_arm64(path: []u8) i32 {
    let src: []u8 = _zag_read_file(path);
    if (src.len < 0) {
        _zag_print("znc: cannot read ");
        _zag_println(path);
        return 1;
    }
    if (znc_check_src(path, src) != 0) {
        return 1;
    }
    let decls: ArrayList[*Node] = parse_program_dir(src, dir_of(path));
    lo_operators(decls);
    let link_libs: ArrayList[[]u8] = make[[]u8](4);
    let code_decls: ArrayList[*Node] = znc_collect_links(decls, &link_libs);
    let nerr: i32 = 0;
    let data: ArrayList[u8] = make[u8](16);
    let v2_edition: i32 = @strEq(v2_project_edition(path), "2027") as i32;
    let sanitize_memory: i32 = has_flag("--sanitize=memory");
    let safety_checked: i32 = has_flag("--safety=checked") | sanitize_memory;
    let arm_driver_mode: i32 = znc_driver_module_mode();
    let arm_object_mode: i32 = ((has_flag("--emit-obj") == 1) || (arm_driver_mode == 1)) as i32;
    let arm_dynamic_mode: i32 = has_flag("--dynamic");
    if ((arm_object_mode == 1) && (v2_edition == 0)) {
        _zag_eprintln("znc: native arm64 object and driver-module output require edition-2027 @cabi_export declarations");
        return 1;
    }
    if (arm_driver_mode == 1) {
        if (znc_driver_kernel_series() == 0) {
            _zag_eprintln("znc: --emit-driver-module requires --driver-kernel 6.1 or 6.6");
            return 1;
        }
        if ((@strEq(flag_value("--target"), "arm64") == 0) && (@strEq(flag_value("--target"), "aarch64") == 0)) {
            _zag_eprintln("znc: arm64 driver module requires --target arm64");
            return 1;
        }
        if (znc_driver_entries_ok(code_decls, path) == 0) {
            return 1;
        }
    }
    if ((arm_dynamic_mode == 1) && (v2_edition == 0)) {
        _zag_eprintln("znc: native arm64 --dynamic is implemented only for edition-2027 @cabi imports");
        return 1;
    }
    let needed_libs: ArrayList[[]u8] = znc_needed_libs();
    if ((arm_dynamic_mode == 0) && (needed_libs.len > 0)) {
        _zag_eprintln("znc: --needed requires explicit --dynamic mode");
        return 1;
    }
    if ((arm_dynamic_mode == 1) && (needed_libs.len == 0)) {
        _zag_eprintln("znc: --dynamic requires at least one --needed SONAME");
        return 1;
    }
    if ((arm_dynamic_mode == 1) && (link_libs.len > 0)) {
        _zag_eprintln("znc: dynamic and static archive linking cannot be mixed yet");
        return 1;
    }
    let prog: ArrayList[AInstr] = aload_program(code_decls, &nerr, &data, v2_edition, safety_checked, sanitize_memory, arm_object_mode, arm_dynamic_mode);
    if (nerr > 0) {
        _zag_println("znc: build aborted — unsupported constructs (see messages above)");
        return 1;
    }
    let out: []u8 = out_flag();
    if (out.len == 0) {
        out = default_out(path);
    }
    if (arm_driver_mode == 1) {
        if (((arm_dynamic_mode == 1) || (needed_libs.len > 0)) || (link_libs.len > 0)) {
            _zag_eprintln("znc: driver module output does not support dynamic linking or archives");
            return 1;
        }
        let exports: ArrayList[ZncObjectExport] = znc_x86_object_exports(code_decls);
        if (exports.len < 2) {
            _zag_eprintln("znc: driver module requires both init_module and cleanup_module exports");
            return 1;
        }
        let encoded: AEncoded = aencode_with_labels_mode(prog, 1);
        if (encoded.relocs.len == 0) {
            _zag_eprintln("znc: driver module requires at least one explicit kernel @cabi import relocation");
            return 1;
        }
        let symbols: ArrayList[DriverElfSymbol] = znc_driver_mod_symbols(exports, encoded.labels, encoded.text.len);
        if (symbols.len != exports.len) {
            _zag_eprintln("znc: driver module export labels were not encoded");
            return 1;
        }
        let imports: ArrayList[[]u8] = znc_dynamic_extern_syms(code_decls, v2_edition);
        let text_relocs: ArrayList[DriverElfReloc] = make[DriverElfReloc](encoded.relocs.len);
        let ri: i32 = 0;
        while (ri < encoded.relocs.len) {
            let reloc: AObjectReloc = encoded.relocs.data[ri];
            if (reloc.kind == 1) {
                if ((reloc.data_offset < 0) || (reloc.data_offset >= data.len)) {
                    _zag_eprintln("znc: driver module data relocation is outside the compiler-owned data section");
                    return 1;
                }
                push[DriverElfReloc](&text_relocs, DriverElfReloc{ .offset = reloc.offset, .symbol = 2, .typ = 257, .addend = 8 + reloc.data_offset as i64 });
            } else {
                if ((reloc.import < 0) || (reloc.import >= imports.len)) {
                    _zag_eprintln("znc: driver module external relocation is not a declared kernel import");
                    return 1;
                }
                push[DriverElfReloc](&text_relocs, DriverElfReloc{ .offset = reloc.offset, .symbol = (4 + exports.len) + reloc.import, .typ = 283, .addend = 0 });
            }
            ri = ri + 1;
        }
        let module_data: ArrayList[u8] = znc_driver_module_data(znc_driver_data_anchor(), data);
        let data_relocs: ArrayList[DriverElfReloc] = make[DriverElfReloc](1);
        let init_index: i32 = znc_driver_export_index(exports, "init_module");
        if (init_index < 0) {
            _zag_eprintln("znc: driver module init_module export disappeared before object emission");
            return 1;
        }
        push[DriverElfReloc](&data_relocs, DriverElfReloc{ .offset = 0, .symbol = 4 + init_index, .typ = 257, .addend = 0 });
        let debug: DwarfSections = znc_driver_debug(path, code_decls);
        let spec: DriverElfSpec = DriverElfSpec{ .machine = 183, .word_size = 8, .text = encoded.text, .data = module_data, .modinfo = znc_driver_modinfo(znc_driver_kernel_series(), "arm64"), .symbols = symbols, .imports = imports, .text_relocs = text_relocs, .data_relocs = data_relocs, .debug_abbrev = debug.abbrev, .debug_info = debug.info, .debug_line = debug.line_ };
        if (write_driver_elf64(out, spec) != 0) {
            _zag_eprintln("znc: failed to write deterministic arm64 Zag driver ET_REL");
            return 1;
        }
        _zag_println(_zag_str_concat("znc: wrote arm64 Zag Linux driver ET_REL ", out));
        return 0;
    }
    if (arm_object_mode == 1) {
        let exports: ArrayList[ZncObjectExport] = znc_x86_object_exports(code_decls);
        if (exports.len == 0) {
            _zag_eprintln("znc: arm64 --emit-obj requires at least one pub fn annotated @cabi_export");
            return 1;
        }
        if (znc_object_externs_ok(code_decls) == 0) {
            _zag_eprintln("znc: arm64 --emit-obj requires all extern declarations to be @cabi");
            return 1;
        }
        let encoded: AEncoded = aencode_with_labels(prog);
        let syms: ArrayList[Elf64ObjectSymbol] = make[Elf64ObjectSymbol](exports.len);
        let ei: i32 = 0;
        while (ei < exports.len) {
            let e: ZncObjectExport = get[ZncObjectExport](exports, ei);
            if ((e.label < 0) || (e.label >= encoded.labels.len)) {
                _zag_eprintln("znc: internal error: @cabi_export label was not encoded");
                return 1;
            }
            push[Elf64ObjectSymbol](&syms, Elf64ObjectSymbol{ .name = e.name, .offset = get[i32](encoded.labels, e.label), .size = 0 });
            ei = ei + 1;
        }
        let externs: ArrayList[[]u8] = znc_dynamic_extern_syms(code_decls, v2_edition);
        if (encoded.relocs.len == 0) {
            if (write_elf_arm64_object_reloc(out, encoded.text, syms, make[Elf64ObjectImport](1), make[Elf64ObjectReloc](1)) != 0) {
                _zag_eprintln("znc: failed to write arm64 ELF object");
                return 1;
            }
            _zag_println(_zag_str_concat("znc: wrote ELF64/arm64 relocation-free C ABI object ", out));
            return 0;
        }
        let imports: ArrayList[Elf64ObjectImport] = make[Elf64ObjectImport](externs.len);
        let xi: i32 = 0;
        while (xi < externs.len) {
            push[Elf64ObjectImport](&imports, Elf64ObjectImport{ .name = get[[]u8](externs, xi) });
            xi = xi + 1;
        }
        let relocs: ArrayList[Elf64ObjectReloc] = make[Elf64ObjectReloc](encoded.relocs.len);
        let ri: i32 = 0;
        while (ri < encoded.relocs.len) {
            let r: AObjectReloc = get[AObjectReloc](encoded.relocs, ri);
            if ((r.import < 0) || (r.import >= imports.len)) {
                _zag_eprintln("znc: internal error: external-call relocation import was not declared");
                return 1;
            }
            push[Elf64ObjectReloc](&relocs, Elf64ObjectReloc{ .offset = r.offset, .import_index = r.import, .typ = 283, .addend = 0 });
            ri = ri + 1;
        }
        if (write_elf_arm64_object_reloc(out, encoded.text, syms, imports, relocs) != 0) {
            _zag_eprintln("znc: failed to write arm64 ELF relocation object");
            return 1;
        }
        _zag_println(_zag_str_concat("znc: wrote ELF64/arm64 C ABI object with direct call relocations ", out));
        return 0;
    }
    if (arm_dynamic_mode == 1) {
        let dynamic_syms: ArrayList[[]u8] = znc_dynamic_extern_syms(code_decls, v2_edition);
        if (dynamic_syms.len == 0) {
            _zag_eprintln("znc: --dynamic program declares no non-runtime extern symbols");
            return 1;
        }
        let code: ArrayList[u8] = aencode(prog);
        let drc: i32 = write_elf_dynamic_arm64(out, code, 0, data, dynamic_syms, needed_libs);
        if (drc != 0) {
            _zag_eprintln("znc: failed to write dynamic arm64 executable");
            return 1;
        }
        _zag_print("znc: [arm64] wrote dynamic native binary ");
        _zag_print(out);
        _zag_print(" (");
        _zag_print(_zag_i64_to_str(dynamic_syms.len as i64));
        _zag_println(" explicit system ABI symbol(s), 0 external tools)");
        return 0;
    }
    let code: ArrayList[u8] = aencode(prog);
    let rc: i32 = write_elf_arm64_data(out, code, 0, data);
    if (rc != 0) {
        _zag_println("znc: failed to write executable");
        return 1;
    }
    _zag_print("znc: [arm64] wrote native binary ");
    _zag_print(out);
    _zag_print(" (");
    _zag_print(_zag_i64_to_str(code.len as i64));
    _zag_print(" bytes text, ");
    _zag_print(_zag_i64_to_str(data.len as i64));
    _zag_println(" bytes data, 0 external tools)");
    if (has_flag("--run") == 1) {
        let runcmd: []u8 = _zag_str_concat("qemu-aarch64-static ", out);
        let ec: i32 = _zag_exec_cmd(runcmd);
        _zag_print("znc: qemu exited ");
        _zag_println(_zag_i64_to_str(ec as i64));
    }
    return 0;
}

fn build_wasm(path: []u8) i32 {
    let src: []u8 = _zag_read_file(path);
    if (src.len < 0) {
        _zag_print("znc: cannot read ");
        _zag_println(path);
        return 1;
    }
    if (znc_check_src(path, src) != 0) {
        return 1;
    }
    let wbuf: ArrayList[u8] = emit_wasm_dir(src, dir_of(path));
    let out: []u8 = out_flag();
    if (out.len == 0) {
        out = _zag_str_concat(stem_of(path), ".wasm");
    }
    if (_zag_write_file(out, wbuf.data[0..wbuf.len]) != 0) {
        _zag_println("znc: failed to write WASM");
        return 1;
    }
    _zag_print("znc: [wasm] wrote WASM ");
    _zag_println(out);
    if (has_flag("--run") == 1) {
        _zag_eprintln("E0800: WASM execution requires a pure-Zag runtime, which is not implemented");
        _zag_eprintln("note: the .wasm artifact was emitted, but no external runtime was invoked");
        return 1;
    }
    return 0;
}

fn analysis_enabled() i32 {
    if (has_flag("--no-analyze") == 1) {
        return 0;
    }
    return 1;
}

fn analysis_pedantic() i32 {
    return has_flag("--analyze-pedantic");
}

fn run_analyzer(decls: ArrayList[*Node], path: []u8) i32 {
    if (analysis_enabled() == 0) {
        return 0;
    }
    let issues: i32 = run_analysis(decls, path, analysis_pedantic());
    if (issues > 0) {
        let n: []u8 = _zag_i64_to_str(issues as i64);
        if (has_flag("--analyze-strict") == 1) {
            _zag_eprintln(_zag_str_concat("znc: analyzer found ", _zag_str_concat(n, " issue(s) — build FAILED (--analyze-strict)")));
            return 1;
        }
        _zag_eprintln(_zag_str_concat("znc: analyzer found ", _zag_str_concat(n, " issue(s) (warnings above; use --analyze-strict to fail the build, --no-analyze to silence)")));
    }
    return 0;
}

fn has_flag(name: []u8) i32 {
    let i: i32 = 0;
    while (i < _zag_argc()) {
        if (@strEq(_zag_arg(i), name)) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn src_arg() []u8 {
    let i: i32 = 1;
    while (i < _zag_argc()) {
        let a: []u8 = _zag_arg(i);
        if ((((((((((@strEq(a, "-o") || @strEq(a, "-l")) || @strEq(a, "-L")) || @strEq(a, "--cpu")) || @strEq(a, "--target")) || @strEq(a, "--needed")) || @strEq(a, "--driver-kernel")) || @strEq(a, "--format")) || @strEq(a, "--output")) || @strEq(a, "--analyze-str-consumer")) || @strEq(a, "--foreground-transform")) {
            i = i + 2;
            continue;
        }
        if (a.len > 0) {
            if ((((((a[0] != 45) && (@strEq(a, "build") == 0)) && (@strEq(a, "script") == 0)) && (@strEq(a, "explain") == 0)) && (@strEq(a, "harden") == 0)) && (@strEq(a, "check") == 0)) {
                return a;
            }
        }
        i = i + 1;
    }
    return "";
}

fn source_starts_script(src: []u8) i32 {
    let i: i32 = 0;
    let scanning: i32 = 1;
    while ((scanning == 1) && (i < src.len)) {
        while ((i < src.len) && ((((src[i] == 32) || (src[i] == 10)) || (src[i] == 13)) || (src[i] == 9))) {
            i = i + 1;
        }
        if ((((i + 1) < src.len) && (src[i] == 47)) && (src[i + 1] == 47)) {
            i = i + 2;
            while ((i < src.len) && (src[i] != 10)) {
                i = i + 1;
            }
        } else if ((((i + 1) < src.len) && (src[i] == 47)) && (src[i + 1] == 42)) {
            i = i + 2;
            while (((i + 1) < src.len) && !(src[i] == 42) && (src[i + 1] == 47)) {
                i = i + 1;
            }
            if ((i + 1) < src.len) {
                i = i + 2;
            }
        } else {
            scanning = 0;
        }
    }
    if ((i + 6) >= src.len) {
        return 0;
    }
    if (((((((src[i] == 115) && (src[i + 1] == 99)) && (src[i + 2] == 114)) && (src[i + 3] == 105)) && (src[i + 4] == 112)) && (src[i + 5] == 116)) && (src[i + 6] == 59)) {
        return 1;
    }
    return 0;
}

fn source_path_is_zs(path: []u8) i32 {
    if (path.len < 3) {
        return 0;
    }
    return @strEq(path[path.len - 3..path.len], ".zs") as i32;
}

fn contains_text(text: []u8, needle: []u8) i32 {
    if (needle.len == 0) {
        return 1;
    }
    let i: i32 = 0;
    while ((i + needle.len) <= text.len) {
        if (@strEq(text[i..i + needle.len], needle)) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn znc_activate_script_source(path: []u8, src: []u8, force: i32) []u8 {
    if (((force == 1) || (source_path_is_zs(path) == 1)) && (source_starts_script(src) == 0)) {
        return _zag_str_concat("script;\n", src);
    }
    return src;
}

fn flag_value(name: []u8) []u8 {
    let i: i32 = 1;
    while (i < _zag_argc()) {
        if (@strEq(_zag_arg(i), name) && ((i + 1) < _zag_argc())) {
            return _zag_arg(i + 1);
        }
        i = i + 1;
    }
    return "";
}

fn foreground_transform_value() []u8 {
    let paired: []u8 = flag_value("--foreground-transform");
    if (paired.len > 0) {
        return paired;
    }
    let i: i32 = 1;
    while (i < _zag_argc()) {
        let arg: []u8 = _zag_arg(i);
        if (v2_starts_with(arg, "--foreground-transform=") == 1) {
            return arg[23..];
        }
        i = i + 1;
    }
    return "";
}

fn foreground_transform_requested() i32 {
    let value: []u8 = foreground_transform_value();
    return (((@strEq(value, "const-i32-add-v1") || @strEq(value, "const-i64-add-v1")) || @strEq(value, "const-i32-neg-v1")) || @strEq(value, "const-bool-cmp-v1")) as i32;
}

fn foreground_transform_is_neg() i32 {
    return @strEq(foreground_transform_value(), "const-i32-neg-v1") as i32;
}

fn foreground_transform_is_i64() i32 {
    return @strEq(foreground_transform_value(), "const-i64-add-v1") as i32;
}

fn foreground_transform_is_bool() i32 {
    return @strEq(foreground_transform_value(), "const-bool-cmp-v1") as i32;
}

fn foreground_transform_policy(path: []u8, safety_checked: i32, sanitize_memory: i32) ZirTransformPolicy {
    let arithmetic: []u8 = zir_transform_arithmetic_i32_wrap();
    if (foreground_transform_is_bool() == 1) {
        arithmetic = zir_transform_arithmetic_bool_predicate();
    } else if (foreground_transform_is_i64() == 1) {
        arithmetic = zir_transform_arithmetic_i64_defined();
    }
    return ZirTransformPolicy{ .target = zir_transform_target_linux_x86_64(), .edition = v2_project_edition(path), .arithmetic = arithmetic, .safety_checked = safety_checked, .sanitize_memory = sanitize_memory, .automatic_selection = 1 };
}

fn znc_automatic_transform_requested(unit: CompilationUnit, path: []u8) i32 {
    if (foreground_transform_requested() == 1) {
        return 0;
    }
    let cfg: PlannerConfig = znc_project_config(znc_project_root(dir_of(path)), 0);
    if (cfg.valid == 0) {
        return 0;
    }
    if (unit.profile == ModuleProfile.script) {
        return @strEq(cfg.script_optimization, "automatic") as i32;
    }
    return @strEq(cfg.regular_optimization, "automatic") as i32;
}

fn znc_daemon_transform_proposal_present(path: []u8) i32 {
    if (has_flag("--no-zagd") == 1) {
        return 0;
    }
    let root: []u8 = znc_project_root(dir_of(path));
    return _zag_file_exists(_zag_str_concat(root, "/.zag-cache/zagd/transform-proposal.record"));
}

fn znc_daemon_transform_proposal_matches(path: []u8, unit: CompilationUnit, authority: ZirAuthority) i32 {
    let root: []u8 = znc_project_root(dir_of(path));
    let record: []u8 = _zag_read_file(_zag_str_concat(root, "/.zag-cache/zagd/transform-proposal.record"));
    let semantic_text: []u8 = _zag_read_file(_zag_str_concat(root, "/.zag-cache/zagd/semantic.record"));
    let current_raw: []u8 = _zag_read_file(path);
    let current_source: []u8 = current_raw;
    let current_activated: i32 = 0;
    if (((current_raw.len >= 0) && (source_path_is_zs(path) == 1)) && (source_starts_script(current_raw) == 0)) {
        current_source = _zag_str_concat("script;\n", current_raw);
        current_activated = 1;
    }
    let image: []u8 = _zag_read_file("/proc/self/exe");
    let profile: X86CpuProfile = parse_x86_cpu_profile(znc_effective_cpu(path, (unit.profile == ModuleProfile.script) as i32));
    let manifest: SemanticManifestView = semantic_manifest_decode(semantic_text);
    let ok: i32 = 0;
    let current_hash: ZagdHash = zagd_hash_empty();
    if (current_raw.len >= 0) {
        current_hash = zagd_content_hash(current_source);
    }
    if ((((((((((record.len > 0) && (semantic_text.len > 0)) && (current_raw.len >= 0)) && (image.len > 0)) && (profile.valid == 1)) && (manifest.valid == 1)) && (manifest.graph_complete == 1)) && (znc_manifest_modules_current(root, semantic_text) == 1)) && (zagd_hash_equal(manifest.source, current_hash) == 1)) && (authority.transform_count == 1)) {
        let compiler_identity: ZagdHash = zagd_content_hash(image);
        let semantic_identity: ZagdHash = zagd_profile_semantic_identity(semantic_text, zag_version(), profile.cache_key);
        let target_identity: ZagdHash = zagd_content_hash(profile.cache_key);
        let checked: ZagdTransformProposalCheck = ztp_validate(record, manifest.source, semantic_identity, target_identity, zag_version(), compiler_identity);
        let c: ZirTransformCertificate = authority.certificate;
        if (((((((checked.valid == 1) && @strEq(c.rule, "const-i32-add-v1")) && (c.function_origin.stable_id == checked.proposal.function_origin)) && (c.op_origin.stable_id == checked.proposal.operation_origin)) && (c.lhs_value == checked.proposal.lhs as i64)) && (c.rhs_value == checked.proposal.rhs as i64)) && (c.result_value == checked.proposal.result as i64)) {
            ok = 1;
        }
    }
    if (record.len >= 0) {
        _zag_free(_zag_slice_ptr(record));
    }
    if (semantic_text.len >= 0) {
        _zag_free(_zag_slice_ptr(semantic_text));
    }
    if (current_activated == 1) {
        _zag_free(_zag_slice_ptr(current_source));
    }
    if (current_raw.len >= 0) {
        _zag_free(_zag_slice_ptr(current_raw));
    }
    if (image.len >= 0) {
        _zag_free(_zag_slice_ptr(image));
    }
    return ok;
}

fn cpu_flag_value() []u8 {
    let paired: []u8 = flag_value("--cpu");
    if (paired.len > 0) {
        return paired;
    }
    let i: i32 = 1;
    while (i < _zag_argc()) {
        let a: []u8 = _zag_arg(i);
        if (((((((a.len > 6) && (a[0] == 45)) && (a[1] == 45)) && (a[2] == 99)) && (a[3] == 112)) && (a[4] == 117)) && (a[5] == 61)) {
            return a[6..];
        }
        i = i + 1;
    }
    return "generic";
}

fn cpu_flag_explicit() i32 {
    if (flag_value("--cpu").len > 0) {
        return 1;
    }
    let i: i32 = 1;
    while (i < _zag_argc()) {
        let a: []u8 = _zag_arg(i);
        if ((a.len > 6) && starts_with(a, "--cpu=")) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn znc_script_explicit_choices() PlannerChoices {
    let input: PlannerChoices = planner_empty_choices();
    let allocator: []u8 = flag_value("--script-allocator");
    let device: []u8 = flag_value("--device");
    let layout: []u8 = flag_value("--layout");
    if (allocator.len > 0) {
        input.allocator = allocator;
        input.allocator_explicit = 1;
    }
    if (device.len > 0) {
        input.device = device;
        input.device_explicit = 1;
    }
    if (layout.len > 0) {
        input.layout = layout;
        input.layout_explicit = 1;
    }
    if (cpu_flag_explicit() == 1) {
        input.cpu = cpu_flag_value();
        input.cpu_explicit = 1;
    }
    return input;
}

fn znc_effective_cpu(path: []u8, script_profile: i32) []u8 {
    if ((cpu_flag_explicit() == 1) || (script_profile == 0)) {
        return cpu_flag_value();
    }
    return znc_project_config(znc_project_root(dir_of(path)), 0).default_cpu;
}

fn validate_x86_cpu_flag() i32 {
    let p: X86CpuProfile = parse_x86_cpu_profile(cpu_flag_value());
    if (p.valid == 0) {
        _zag_eprintln(_zag_str_concat("znc: ", p.diagnostic));
        return 1;
    }
    return 0;
}

fn validate_x86_target_flag() i32 {
    let target: []u8 = flag_value("--target");
    let i: i32 = 1;
    let inline_target: []u8 = "";
    while (i < _zag_argc()) {
        let a: []u8 = _zag_arg(i);
        if (starts_with(a, "--target=") == 1) {
            inline_target = a[9..];
        }
        i = i + 1;
    }
    let selected: []u8 = target;
    if (inline_target.len > 0) {
        selected = inline_target;
    }
    if ((((selected.len == 0) || @strEq(selected, "x86_64")) || @strEq(selected, "x86-64")) || @strEq(selected, "linux-x86_64")) {
        return 0;
    }
    if ((@strEq(selected, "i686") || @strEq(selected, "x86")) || @strEq(selected, "linux-i686")) {
        return 0;
    }
    _zag_eprintln(_zag_str_concat("znc: unsupported target: ", selected));
    return 1;
}

fn out_flag() []u8 {
    let i: i32 = 1;
    while (i < _zag_argc()) {
        if (@strEq(_zag_arg(i), "-o")) {
            if ((i + 1) < _zag_argc()) {
                return _zag_arg(i + 1);
            }
        }
        i = i + 1;
    }
    return "";
}

fn default_out(path: []u8) []u8 {
    let dot: i32 = 0 - 1;
    let i: i32 = 0;
    while (i < path.len) {
        if (path[i] == 46) {
            dot = i;
        }
        i = i + 1;
    }
    if (dot > 0) {
        return path[0..dot];
    }
    return _zag_str_concat(path, ".out");
}

fn znc_fmt(fpath: []u8, in_place: i32) i32 {
    if (fpath.len == 0) {
        _zag_println("znc fmt: no source file");
        return 1;
    }
    let src: []u8 = _zag_read_file(fpath);
    if (src.len < 0) {
        _zag_print("znc fmt: cannot read ");
        _zag_println(fpath);
        return 1;
    }
    let format_src: []u8 = script_syntax_normalize(znc_activate_script_source(fpath, src, 0));
    if ((source_path_is_zs(fpath) == 1) || (@strEq(format_src, src) == 0)) {
        if (in_place == 1) {
            let wrc: i32 = _zag_write_file(fpath, format_src);
            if (wrc != 0) {
                _zag_println("znc fmt: write failed");
                return 1;
            }
            _zag_print("znc fmt: normalized ");
            _zag_println(fpath);
        } else {
            _zag_print(format_src);
        }
        return 0;
    }
    let formatted: ArrayList[u8] = fmt_program(format_src);
    if (in_place == 1) {
        let wrc: i32 = _zag_write_file(fpath, formatted.data[0..formatted.len]);
        if (wrc != 0) {
            _zag_println("znc fmt: write failed");
            return 1;
        }
        _zag_print("znc fmt: formatted ");
        _zag_println(fpath);
    } else {
        _zag_print(formatted.data[0..formatted.len]);
    }
    return 0;
}

fn znc_emit_total_cex(decls: ArrayList[*Node], eff: map__StringMap[i32]) void {
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                if (((f.is_extern == 0) && (has_annot(f.annots, "@total") == 1)) && (fn_total_safe(f, eff) == 0)) {
                    let tout: SmtOutcome = smt_prove_fn(f);
                    if ((tout.rc == 1) && (tout.cex.len > 0)) {
                        _zag_println(tout.cex);
                    }
                }
            }
            else => {
            }
        }
        i = i + 1;
    }
}

fn znc_script_alloc_call(name: []u8) i32 {
    if (((((((((((((((((((((((((((((((((((((((((((@strEq(name, "_zag_script_alloc") || @strEq(name, "_zag_script_new")) || @strEq(name, "script_input")) || @strEq(name, "script_read_file")) || @strEq(name, "script_string_concat")) || @strEq(name, "script_string_builder_new")) || @strEq(name, "script_string_i64")) || @strEq(name, "script_string_bool")) || @strEq(name, "script_string_f64")) || @strEq(name, "process_run_bounded_script")) || @strEq(name, "process_run_argv_bounded_script")) || @strEq(name, "script_args")) || @strEq(name, "script_path_join")) || @strEq(name, "script_path_basename")) || @strEq(name, "script_path_dirname")) || @strEq(name, "script_path_extension")) || @strEq(name, "script_list_new")) || @strEq(name, "script_list1")) || @strEq(name, "script_list2")) || @strEq(name, "script_list3")) || @strEq(name, "script_list4")) || @strEq(name, "script_list_get")) || @strEq(name, "script_list_pop")) || @strEq(name, "script_list_clear")) || @strEq(name, "script_json_normalize")) || @strEq(name, "script_json_int_array")) || @strEq(name, "script_json_bool_array")) || @strEq(name, "script_json_float_array")) || @strEq(name, "script_json_string_array")) || @strEq(name, "script_json_int_array_encode")) || @strEq(name, "script_json_bool_array_encode")) || @strEq(name, "script_json_float_array_encode")) || @strEq(name, "script_json_string_array_encode")) || @strEq(name, "script_json_string_map")) || @strEq(name, "script_json_string_map_encode")) || @strEq(name, "script_csv_normalize")) || @strEq(name, "script_csv_first_column")) || @strEq(name, "script_csv_rows")) || @strEq(name, "script_csv_rows_encode")) || @strEq(name, "script_range_i64")) || @strEq(name, "script_set_new")) || @strEq(name, "script_set_text_new")) || @strEq(name, "script_map_new")) || @strEq(name, "script_map_text_new")) {
        return 1;
    }
    return 0;
}

struct ZScriptLifeSummary {
    name: []u8,
    returns_script: i32,
    escapes_script: i32,
    param_count: i32,
    return_mask: i64,
    escape_mask: i64,
}

fn znc_script_summary(sums: ArrayList[ZScriptLifeSummary], name: []u8) ZScriptLifeSummary {
    let i: i32 = 0;
    while (i < sums.len) {
        if (@strEq(sums.data[i].name, name)) {
            return sums.data[i];
        }
        i = i + 1;
    }
    return ZScriptLifeSummary{ .name = "", .returns_script = 0, .escapes_script = 1, .param_count = 0, .return_mask = 0, .escape_mask = 0 };
}

fn znc_script_param_bit(index: i32) i64 {
    if ((index < 0) || (index > 62)) {
        return 0;
    }
    let bit: i64 = 1;
    let i: i32 = 0;
    while (i < index) {
        bit = bit * 2;
        i = i + 1;
    }
    return bit;
}

fn znc_script_summary_has_bit(mask: i64, index: i32) i32 {
    let bit: i64 = znc_script_param_bit(index);
    return ((bit != 0) && ((mask & bit) != 0)) as i32;
}

fn znc_script_call_returns_script(decls: ArrayList[*Node], sums: ArrayList[ZScriptLifeSummary], name: []u8) i32 {
    if (znc_script_alloc_call(name) == 1) {
        return 1;
    }
    if (@strEq(name, "make") || @strEq(name, "new")) {
        return 0;
    }
    if ((znc_script_std_fn(decls, name, "std:json") == 1) || (znc_script_std_fn(decls, name, "std:csv") == 1)) {
        return 0;
    }
    if (znc_script_known_fn(decls, name) == 0) {
        return 1;
    }
    return znc_script_summary(sums, name).returns_script;
}

fn znc_script_known_fn(decls: ArrayList[*Node], name: []u8) i32 {
    let i: i32 = 0;
    while (i < decls.len) {
        switch (decls.data[i].*) {
            .fn_decl => |f| {
                if (@strEq(f.name, name) && (f.is_extern == 0)) {
                    return 1;
                }
            }
            else => {
            }
        }
        i = i + 1;
    }
    return 0;
}

fn znc_script_any_decl(decls: ArrayList[*Node], name: []u8) i32 {
    let i: i32 = 0;
    while (i < decls.len) {
        switch (decls.data[i].*) {
            .fn_decl => |f| {
                if (@strEq(f.name, name)) {
                    return 1;
                }
            }
            else => {
            }
        }
        i = i + 1;
    }
    return 0;
}

fn znc_script_fn_origin(decls: ArrayList[*Node], name: []u8, origin: []u8) i32 {
    let i: i32 = 0;
    while (i < decls.len) {
        switch (decls.data[i].*) {
            .fn_decl => |f| {
                if (((f.is_extern == 0) && @strEq(f.name, name)) && @strEq(f.origin, origin)) {
                    return 1;
                }
            }
            else => {
            }
        }
        i = i + 1;
    }
    return 0;
}

fn znc_script_std_fn(decls: ArrayList[*Node], name: []u8, module: []u8) i32 {
    let expected: []u8 = canon_path(resolve_import_path(module, "."));
    return znc_script_fn_origin(decls, name, expected);
}

fn znc_script_std_safe_consumer(decls: ArrayList[*Node], name: []u8) i32 {
    if ((((((@strEq(name, "process_result_status") || @strEq(name, "process_result_state")) || @strEq(name, "process_result_output")) || @strEq(name, "process_result_new")) || @strEq(name, "process_run_bounded")) || @strEq(name, "process_run_bounded_script")) || @strEq(name, "process_run_argv_bounded_script")) {
        return znc_script_std_fn(decls, name, "std:process");
    }
    if (((((@strEq(name, "string_builder_from_buffer") || @strEq(name, "script_string_builder_new")) || @strEq(name, "string_builder_append")) || @strEq(name, "string_builder_len")) || @strEq(name, "string_builder_failed")) || @strEq(name, "string_builder_output")) {
        return znc_script_std_fn(decls, name, "std:script_string_builder");
    }
    if (((((((((((((@strEq(name, "script_list_new") || @strEq(name, "script_list1")) || @strEq(name, "script_list2")) || @strEq(name, "script_list3")) || @strEq(name, "script_list4")) || @strEq(name, "script_list_append")) || @strEq(name, "script_list_len")) || @strEq(name, "script_list_get")) || @strEq(name, "script_list_set")) || @strEq(name, "script_list_pop")) || @strEq(name, "script_list_clear")) || @strEq(name, "script_list_failed")) || @strEq(name, "script_list_descriptor_valid")) || @strEq(name, "script_args")) {
        return znc_script_std_fn(decls, name, "std:script_list");
    }
    if (((((((@strEq(name, "script_map_new") || @strEq(name, "script_map_put")) || @strEq(name, "script_map_get")) || @strEq(name, "script_map_has")) || @strEq(name, "script_map_len")) || @strEq(name, "script_map_failed")) || @strEq(name, "script_map_del")) || @strEq(name, "script_map_clear")) {
        return znc_script_std_fn(decls, name, "std:script_map");
    }
    if (((((((@strEq(name, "script_map_text_new") || @strEq(name, "script_map_text_put")) || @strEq(name, "script_map_text_get")) || @strEq(name, "script_map_text_has")) || @strEq(name, "script_map_text_len")) || @strEq(name, "script_map_text_failed")) || @strEq(name, "script_map_text_del")) || @strEq(name, "script_map_text_clear")) {
        return znc_script_std_fn(decls, name, "std:script_map");
    }
    if (((((((((((((@strEq(name, "script_set_new") || @strEq(name, "script_set_add")) || @strEq(name, "script_set_has")) || @strEq(name, "script_set_len")) || @strEq(name, "script_set_failed")) || @strEq(name, "script_set_del")) || @strEq(name, "script_set_clear")) || @strEq(name, "script_set_text_new")) || @strEq(name, "script_set_text_add")) || @strEq(name, "script_set_text_has")) || @strEq(name, "script_set_text_len")) || @strEq(name, "script_set_text_failed")) || @strEq(name, "script_set_text_del")) || @strEq(name, "script_set_text_clear")) {
        return znc_script_std_fn(decls, name, "std:script_set");
    }
    if (@strEq(name, "script_range_i64") || @strEq(name, "script_range_failed")) {
        return znc_script_std_fn(decls, name, "std:script_range");
    }
    if (@strEq(name, "script_read_file")) {
        return znc_script_std_fn(decls, name, "std:script_io");
    }
    if (@strEq(name, "script_input")) {
        return znc_script_std_fn(decls, name, "std:script_input");
    }
    if (((@strEq(name, "script_string_concat") || @strEq(name, "script_string_i64")) || @strEq(name, "script_string_bool")) || @strEq(name, "script_string_f64")) {
        return znc_script_std_fn(decls, name, "std:script_string");
    }
    if (((@strEq(name, "script_path_join") || @strEq(name, "script_path_basename")) || @strEq(name, "script_path_dirname")) || @strEq(name, "script_path_extension")) {
        return znc_script_std_fn(decls, name, "std:script_path");
    }
    if ((((((((((@strEq(name, "script_json_normalize") || @strEq(name, "script_json_int_array")) || @strEq(name, "script_json_bool_array")) || @strEq(name, "script_json_float_array")) || @strEq(name, "script_json_string_array")) || @strEq(name, "script_json_int_array_encode")) || @strEq(name, "script_json_bool_array_encode")) || @strEq(name, "script_json_float_array_encode")) || @strEq(name, "script_json_string_array_encode")) || @strEq(name, "script_json_string_map")) || @strEq(name, "script_json_string_map_encode")) {
        return znc_script_std_fn(decls, name, "std:script_json");
    }
    if (((@strEq(name, "script_csv_normalize") || @strEq(name, "script_csv_first_column")) || @strEq(name, "script_csv_rows")) || @strEq(name, "script_csv_rows_encode")) {
        return znc_script_std_fn(decls, name, "std:script_csv");
    }
    return 0;
}

fn znc_script_runtime_safe_consumer(decls: ArrayList[*Node], name: []u8) i32 {
    if (@strEq(name, "@strEq")) {
        return 1;
    }
    if ((@strEq(name, "print") || @strEq(name, "println")) || @strEq(name, "write_file")) {
        return (znc_script_any_decl(decls, name) == 0) as i32;
    }
    if ((@strEq(name, "_zag_print") || @strEq(name, "_zag_println")) || @strEq(name, "_zag_eprintln")) {
        return 1;
    }
    if (((@strEq(name, "_zag_write_file") || @strEq(name, "_zag_script_alloc")) || @strEq(name, "_zag_script_new")) || @strEq(name, "_zag_script_alloc_used")) {
        return (znc_script_any_decl(decls, name) == 0) as i32;
    }
    if (@strEq(name, "@taskReady")) {
        return 1;
    }
    return 0;
}

fn znc_script_safe_consumer(decls: ArrayList[*Node], name: []u8) i32 {
    if (znc_script_runtime_safe_consumer(decls, name) == 1) {
        return 1;
    }
    return znc_script_std_safe_consumer(decls, name);
}

fn znc_script_call_param_may_hold_address(decls: ArrayList[*Node], name: []u8, index: i32) i32 {
    let found: i32 = 0;
    let pty: []u8 = "";
    let i: i32 = 0;
    while (i < decls.len) {
        switch (decls.data[i].*) {
            .fn_decl => |f| {
                if ((@strEq(f.name, name) && (index >= 0)) && (index < f.params.len)) {
                    let candidate: []u8 = f.params.data[index].pty;
                    if ((found == 1) && !@strEq(pty, candidate)) {
                        return 1;
                    }
                    found = 1;
                    pty = candidate;
                }
            }
            else => {
            }
        }
        i = i + 1;
    }
    if (found == 0) {
        return 1;
    }
    return znc_script_type_may_hold_address(pty);
}

fn znc_script_foreign_free(name: []u8) i32 {
    return (@strEq(name, "delete") || @strEq(name, "_zag_free")) as i32;
}

fn znc_script_env_has(env: ArrayList[ZTBind], name: []u8) i32 {
    let i: i32 = 0;
    while (i < env.len) {
        if (@strEq(env.data[i].name, name)) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn znc_script_env_tainted(env: ArrayList[ZTBind], name: []u8) i32 {
    let i: i32 = 0;
    while (i < env.len) {
        if (@strEq(env.data[i].name, name) && @strEq(env.data[i].ty, "script-lifetime")) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn znc_script_env_mark(env: *ArrayList[ZTBind], name: []u8) void {
    let i: i32 = 0;
    while (i < env.*.len) {
        if (@strEq(env.*.data[i].name, name)) {
            env.*.data[i].ty = "script-lifetime";
            return;
        }
        i = i + 1;
    }
    push[ZTBind](env, ZTBind{ .name = name, .ty = "script-lifetime" });
}

fn znc_script_closure_capture_tainted(name: []u8, env: ArrayList[ZTBind], decls: ArrayList[*Node]) i32 {
    let i: i32 = 0;
    while (i < decls.len) {
        switch (decls.data[i].*) {
            .fn_decl => |f| {
                if (((f.is_extern == 0) && (f.caps > 0)) && @strEq(f.name, name)) {
                    let caps: ArrayList[[]u8] = split_args(f.cap_names);
                    let ci: i32 = 0;
                    while (ci < caps.len) {
                        let cap: []u8 = caps.data[ci];
                        if ((cap.len > 0) && (cap[0] == 42)) {
                            cap = cap[1..cap.len];
                        }
                        if (znc_script_env_tainted(env, cap) == 1) {
                            return 1;
                        }
                        ci = ci + 1;
                    }
                }
            }
            else => {
            }
        }
        i = i + 1;
    }
    return 0;
}

fn znc_script_type_may_hold_address(ty: []u8) i32 {
    if (ty.len == 0) {
        return 1;
    }
    if (((((((((((@strEq(ty, "bool") || @strEq(ty, "void")) || @strEq(ty, "i8")) || @strEq(ty, "i16")) || @strEq(ty, "i32")) || @strEq(ty, "i64")) || @strEq(ty, "u8")) || @strEq(ty, "u16")) || @strEq(ty, "u32")) || @strEq(ty, "u64")) || @strEq(ty, "f32")) || @strEq(ty, "f64")) {
        return 0;
    }
    return 1;
}

fn znc_script_expr_is_call(n: *Node) i32 {
    switch (n.*) {
        .call => {
            return 1;
        }
        else => {
            return 0;
        }
    }
}

fn znc_script_arm_value_tainted(body: ArrayList[*Node], env: ArrayList[ZTBind], sums: ArrayList[ZScriptLifeSummary]) i32 {
    if (body.len == 0) {
        return 0;
    }
    let last: *Node = body.data[body.len - 1];
    switch (last.*) {
        .estmt => |x| {
            return znc_script_tainted(x.expr, env, sums);
        }
        .ret => |x| {
            if (x.has_expr == 1) {
                return znc_script_tainted(x.expr, env, sums);
            }
        }
        else => {
        }
    }
    return 0;
}

fn znc_script_tainted_v2(n: *Node, env: ArrayList[ZTBind], sums: ArrayList[ZScriptLifeSummary]) i32 {
    switch (n.*) {
        .id => |x| {
            return znc_script_env_tainted(env, x.name);
        }
        .call => |x| {
            let name: []u8 = callee_name(x.callee);
            if (znc_script_alloc_call(name) == 1) {
                return 1;
            }
            let s: ZScriptLifeSummary = znc_script_summary(sums, name);
            let j: i32 = 0;
            while (j < x.args.len) {
                if ((znc_script_summary_has_bit(s.return_mask, j) == 1) && (znc_script_tainted_v2(x.args.data[j], env, sums) == 1)) {
                    return 1;
                }
                j = j + 1;
            }
        }
        .bin => |x| {
            return znc_script_tainted_v2(x.l, env, sums) | znc_script_tainted_v2(x.r, env, sums);
        }
        .un => |x| {
            return znc_script_tainted_v2(x.e, env, sums);
        }
        .fld => |x| {
            return znc_script_tainted_v2(x.base, env, sums);
        }
        .idx => |x| {
            return znc_script_tainted_v2(x.base, env, sums);
        }
        .cast_ => |x| {
            return znc_script_tainted_v2(x.expr, env, sums);
        }
        .slice_ => |x| {
            return znc_script_tainted_v2(x.base, env, sums);
        }
        .slit_ => |x| {
            let i: i32 = 0;
            while (i < len[FieldInit](x.fields)) {
                if (znc_script_tainted_v2(get[FieldInit](x.fields, i).val, env, sums) == 1) {
                    return 1;
                }
                i = i + 1;
            }
        }
        .switch_ => |x| {
            let i: i32 = 0;
            while (i < len[SwitchArm](x.arms)) {
                if (znc_script_arm_value_tainted(x.arms.data[i].body, env, sums) == 1) {
                    return 1;
                }
                i = i + 1;
            }
            if (x.has_els == 1) {
                return znc_script_arm_value_tainted(x.els_body, env, sums);
            }
        }
        else => {
        }
    }
    return 0;
}

fn znc_script_call_escape_v2(n: *Node, env: ArrayList[ZTBind], decls: ArrayList[*Node], sums: ArrayList[ZScriptLifeSummary], report: i32) i32 {
    let failures: i32 = 0;
    switch (n.*) {
        .call => |c| {
            let name: []u8 = callee_name(c.callee);
            let safe: i32 = znc_script_safe_consumer(decls, name);
            let known: i32 = znc_script_known_fn(decls, name);
            let summary: ZScriptLifeSummary = znc_script_summary(sums, name);
            let j: i32 = 0;
            while (j < c.args.len) {
                let tainted: i32 = znc_script_tainted_v2(c.args.data[j], env, sums);
                let parameter_address: i32 = znc_script_call_param_may_hold_address(decls, name, j);
                if ((tainted == 1) && (parameter_address == 1)) {
                    if (znc_script_foreign_free(name) == 1) {
                        if (report == 1) {
                            _zag_eprintln("znc script lifetime: foreign free cannot deallocate a Script-context value");
                        }
                        failures = failures + 1;
                    } else {
                        let escapes: i32 = ((safe == 0) && ((known == 0) || (znc_script_summary_has_bit(summary.escape_mask, j) == 1))) as i32;
                        if (escapes == 1) {
                            if (report == 1) {
                                _zag_eprintln("znc script lifetime: Script-context value may escape through an untrusted helper, extern, or unknown call");
                            }
                            failures = failures + 1;
                        }
                    }
                }
                failures = failures + znc_script_call_escape_v2(c.args.data[j], env, decls, sums, report);
                j = j + 1;
            }
        }
        .bin => |x| {
            failures = (failures + znc_script_call_escape_v2(x.l, env, decls, sums, report)) + znc_script_call_escape_v2(x.r, env, decls, sums, report);
        }
        .un => |x| {
            failures = failures + znc_script_call_escape_v2(x.e, env, decls, sums, report);
        }
        .fld => |x| {
            failures = failures + znc_script_call_escape_v2(x.base, env, decls, sums, report);
        }
        .idx => |x| {
            failures = (failures + znc_script_call_escape_v2(x.base, env, decls, sums, report)) + znc_script_call_escape_v2(x.idx, env, decls, sums, report);
        }
        .cast_ => |x| {
            failures = failures + znc_script_call_escape_v2(x.expr, env, decls, sums, report);
        }
        .slice_ => |x| {
            failures = failures + znc_script_call_escape_v2(x.base, env, decls, sums, report);
        }
        .slit_ => |x| {
            let i: i32 = 0;
            while (i < len[FieldInit](x.fields)) {
                failures = failures + znc_script_call_escape_v2(get[FieldInit](x.fields, i).val, env, decls, sums, report);
                i = i + 1;
            }
        }
        .switch_ => |x| {
            failures = failures + znc_script_call_escape_v2(x.subject, env, decls, sums, report);
            let ai: i32 = 0;
            while (ai < len[SwitchArm](x.arms)) {
                failures = failures + znc_script_escape_body_v2(x.arms.data[ai].body, env, decls, sums, report);
                ai = ai + 1;
            }
            failures = failures + znc_script_escape_body_v2(x.els_body, env, decls, sums, report);
        }
        else => {
        }
    }
    return failures;
}

fn znc_script_store_target_local(n: *Node, env: ArrayList[ZTBind]) i32 {
    switch (n.*) {
        .id => |x| {
            return znc_script_env_tainted(env, x.name);
        }
        .idx => |x| {
            return znc_script_store_target_local(x.base, env);
        }
        .fld => |x| {
            return znc_script_store_target_local(x.base, env);
        }
        .cast_ => |x| {
            return znc_script_store_target_local(x.expr, env);
        }
        .un => |x| {
            if (@strEq(x.op, "*") || @strEq(x.op, "&")) {
                return znc_script_store_target_local(x.e, env);
            }
        }
        else => {
        }
    }
    return 0;
}

fn znc_script_escape_body_v2(body: ArrayList[*Node], env: ArrayList[ZTBind], decls: ArrayList[*Node], sums: ArrayList[ZScriptLifeSummary], report: i32) i32 {
    let failures: i32 = 0;
    let i: i32 = 0;
    while (i < body.len) {
        switch (body.data[i].*) {
            .let_ => |x| {
                if (x.has_init == 1) {
                    failures = failures + znc_script_call_escape_v2(x.expr, env, decls, sums, report);
                }
            }
            .ret => |x| {
                if (x.has_expr == 1) {
                    failures = failures + znc_script_call_escape_v2(x.expr, env, decls, sums, report);
                }
            }
            .estmt => |x| {
                failures = failures + znc_script_call_escape_v2(x.expr, env, decls, sums, report);
            }
            .assign => |x| {
                failures = (failures + znc_script_call_escape_v2(x.target, env, decls, sums, report)) + znc_script_call_escape_v2(x.expr, env, decls, sums, report);
            }
            .if_ => |x| {
                failures = ((failures + znc_script_call_escape_v2(x.cond, env, decls, sums, report)) + znc_script_escape_body_v2(x.then_body, env, decls, sums, report)) + znc_script_escape_body_v2(x.els_body, env, decls, sums, report);
            }
            .while_ => |x| {
                failures = (failures + znc_script_call_escape_v2(x.cond, env, decls, sums, report)) + znc_script_escape_body_v2(x.body, env, decls, sums, report);
            }
            .unsafe_ => |x| {
                failures = failures + znc_script_escape_body_v2(x.body, env, decls, sums, report);
            }
            .switch_ => |x| {
                failures = failures + znc_script_call_escape_v2(x.subject, env, decls, sums, report);
                let ai: i32 = 0;
                while (ai < len[SwitchArm](x.arms)) {
                    failures = failures + znc_script_escape_body_v2(x.arms.data[ai].body, env, decls, sums, report);
                    ai = ai + 1;
                }
                failures = failures + znc_script_escape_body_v2(x.els_body, env, decls, sums, report);
            }
            else => {
            }
        }
        i = i + 1;
    }
    return failures;
}

fn znc_script_lifetime_body_v2(body: ArrayList[*Node], env: *ArrayList[ZTBind], decls: ArrayList[*Node], sums: ArrayList[ZScriptLifeSummary], report: i32, returns: *i32) i32 {
    let failures: i32 = 0;
    let i: i32 = 0;
    while (i < body.len) {
        let n: *Node = body.data[i];
        switch (n.*) {
            .let_ => |x| {
                if (znc_script_env_has(env.*, x.name) == 0) {
                    push[ZTBind](env, ZTBind{ .name = x.name, .ty = "" });
                }
                if (x.has_init == 1) {
                    failures = failures + znc_script_call_escape_v2(x.expr, env.*, decls, sums, report);
                    let owned: i32 = znc_script_tainted_v2(x.expr, env.*, sums);
                    switch (x.expr.*) {
                        .call => |c| {
                            if ((x.has_dty == 0) || (znc_script_type_may_hold_address(x.dty) == 1)) {
                                if (znc_script_call_returns_script(decls, sums, callee_name(c.callee)) == 1) {
                                    owned = 1;
                                }
                            }
                        }
                        else => {
                        }
                    }
                    if (owned == 1) {
                        znc_script_env_mark(env, x.name);
                    }
                }
            }
            .ret => |x| {
                if (x.has_expr == 1) {
                    failures = failures + znc_script_call_escape_v2(x.expr, env.*, decls, sums, report);
                    if (znc_script_tainted_v2(x.expr, env.*, sums) == 1) {
                        returns.* = 1;
                    }
                }
            }
            .assign => |x| {
                failures = failures + znc_script_call_escape_v2(x.expr, env.*, decls, sums, report);
                if (znc_script_tainted_v2(x.expr, env.*, sums) == 1) {
                    let local: i32 = 0;
                    let local_name: []u8 = "";
                    switch (x.target.*) {
                        .id => |id| {
                            local = znc_script_env_has(env.*, id.name);
                            local_name = id.name;
                        }
                        else => {
                        }
                    }
                    if (local == 0) {
                        if (znc_script_store_target_local(x.target, env.*) == 0) {
                            if (report == 1) {
                                _zag_eprintln("znc script lifetime: Script-context value stored through a field, pointer, or nonlocal target");
                            }
                            failures = failures + 1;
                        }
                    } else {
                        znc_script_env_mark(env, local_name);
                    }
                }
            }
            .estmt => |x| {
                failures = failures + znc_script_call_escape_v2(x.expr, env.*, decls, sums, report);
            }
            .if_ => |x| {
                failures = ((failures + znc_script_call_escape_v2(x.cond, env.*, decls, sums, report)) + znc_script_lifetime_body_v2(x.then_body, env, decls, sums, report, returns)) + znc_script_lifetime_body_v2(x.els_body, env, decls, sums, report, returns);
            }
            .while_ => |x| {
                failures = (failures + znc_script_call_escape_v2(x.cond, env.*, decls, sums, report)) + znc_script_lifetime_body_v2(x.body, env, decls, sums, report, returns);
            }
            .unsafe_ => |x| {
                failures = failures + znc_script_lifetime_body_v2(x.body, env, decls, sums, report, returns);
            }
            .switch_ => |x| {
                failures = failures + znc_script_call_escape_v2(x.subject, env.*, decls, sums, report);
                let ai: i32 = 0;
                while (ai < len[SwitchArm](x.arms)) {
                    failures = failures + znc_script_lifetime_body_v2(x.arms.data[ai].body, env, decls, sums, report, returns);
                    ai = ai + 1;
                }
                failures = failures + znc_script_lifetime_body_v2(x.els_body, env, decls, sums, report, returns);
            }
            else => {
            }
        }
        i = i + 1;
    }
    return failures;
}

fn znc_script_lifetime_check(decls: ArrayList[*Node]) i32 {
    let sums: ArrayList[ZScriptLifeSummary] = make[ZScriptLifeSummary](16);
    let i: i32 = 0;
    while (i < decls.len) {
        switch (decls.data[i].*) {
            .fn_decl => |f| {
                if (f.is_extern == 0) {
                    push[ZScriptLifeSummary](&sums, ZScriptLifeSummary{ .name = f.name, .returns_script = 0, .escapes_script = 0, .param_count = f.params.len, .return_mask = 0, .escape_mask = 0 });
                }
            }
            else => {
            }
        }
        i = i + 1;
    }
    let pass: i32 = 0;
    while (pass <= sums.len) {
        i = 0;
        while (i < decls.len) {
            switch (decls.data[i].*) {
                .fn_decl => |f| {
                    if (f.is_extern == 0) {
                        let base: ArrayList[ZTBind] = make[ZTBind](f.params.len + 8);
                        let pi: i32 = 0;
                        while (pi < f.params.len) {
                            push[ZTBind](&base, ZTBind{ .name = f.params.data[pi].name, .ty = "" });
                            pi = pi + 1;
                        }
                        let base_ret: i32 = 0;
                        let base_esc: i32 = znc_script_lifetime_body_v2(f.body, &base, decls, sums, 0, &base_ret);
                        let si: i32 = 0;
                        while (si < sums.len) {
                            if (@strEq(sums.data[si].name, f.name)) {
                                if ((znc_script_type_may_hold_address(f.ret) == 1) && (base_ret == 1)) {
                                    sums.data[si].returns_script = 1;
                                }
                                if (base_esc > 0) {
                                    sums.data[si].escapes_script = 1;
                                }
                            }
                            si = si + 1;
                        }
                        pi = 0;
                        while (pi < f.params.len) {
                            if (znc_script_type_may_hold_address(f.params.data[pi].pty) == 1) {
                                let env: ArrayList[ZTBind] = make[ZTBind](f.params.len + 8);
                                let pj: i32 = 0;
                                while (pj < f.params.len) {
                                    let mark: []u8 = "";
                                    if (pj == pi) {
                                        mark = "script-lifetime";
                                    }
                                    push[ZTBind](&env, ZTBind{ .name = f.params.data[pj].name, .ty = mark });
                                    pj = pj + 1;
                                }
                                let ret: i32 = 0;
                                let escapes: i32 = znc_script_lifetime_body_v2(f.body, &env, decls, sums, 0, &ret);
                                let bit: i64 = znc_script_param_bit(pi);
                                si = 0;
                                while (si < sums.len) {
                                    if (@strEq(sums.data[si].name, f.name)) {
                                        if ((znc_script_type_may_hold_address(f.ret) == 1) && (ret == 1)) {
                                            sums.data[si].return_mask = sums.data[si].return_mask | bit;
                                        }
                                        if (escapes > 0) {
                                            sums.data[si].escape_mask = sums.data[si].escape_mask | bit;
                                            sums.data[si].escapes_script = 1;
                                        }
                                    }
                                    si = si + 1;
                                }
                            }
                            pi = pi + 1;
                        }
                    }
                }
                else => {
                }
            }
            i = i + 1;
        }
        pass = pass + 1;
    }
    i = 0;
    while (i < decls.len) {
        switch (decls.data[i].*) {
            .fn_decl => |f| {
                if (@strEq(f.name, "__zag_compiler_script_body_7f3a")) {
                    let env: ArrayList[ZTBind] = make[ZTBind](8);
                    let ret: i32 = 0;
                    return znc_script_lifetime_body_v2(f.body, &env, decls, sums, 1, &ret);
                }
            }
            else => {
            }
        }
        i = i + 1;
    }
    return 0;
}

fn znc_script_tainted(n: *Node, env: ArrayList[ZTBind], sums: ArrayList[ZScriptLifeSummary]) i32 {
    return znc_script_tainted_v2(n, env, sums);
}

fn znc_script_call_escape(n: *Node, env: ArrayList[ZTBind], decls: ArrayList[*Node], sums: ArrayList[ZScriptLifeSummary], report: i32) i32 {
    return znc_script_call_escape_v2(n, env, decls, sums, report);
}

fn znc_script_lifetime_body(body: ArrayList[*Node], env: *ArrayList[ZTBind], decls: ArrayList[*Node], sums: ArrayList[ZScriptLifeSummary], report: i32, returns: *i32) i32 {
    return znc_script_lifetime_body_v2(body, env, decls, sums, report, returns);
}

fn znc_ast_has_call_expr(n: *Node, name: []u8) i32 {
    switch (n.*) {
        .call => |x| {
            if (@strEq(callee_name(x.callee), name)) {
                return 1;
            }
            let i: i32 = 0;
            while (i < x.args.len) {
                if (znc_ast_has_call_expr(x.args.data[i], name) == 1) {
                    return 1;
                }
                i = i + 1;
            }
        }
        .bin => |x| {
            return znc_ast_has_call_expr(x.l, name) | znc_ast_has_call_expr(x.r, name);
        }
        .un => |x| {
            return znc_ast_has_call_expr(x.e, name);
        }
        .fld => |x| {
            return znc_ast_has_call_expr(x.base, name);
        }
        .idx => |x| {
            return znc_ast_has_call_expr(x.base, name) | znc_ast_has_call_expr(x.idx, name);
        }
        .cast_ => |x| {
            return znc_ast_has_call_expr(x.expr, name);
        }
        .slice_ => |x| {
            return znc_ast_has_call_expr(x.base, name) | znc_ast_has_call_expr(x.lo, name);
        }
        .slit_ => |x| {
            let i: i32 = 0;
            while (i < len[FieldInit](x.fields)) {
                if (znc_ast_has_call_expr(get[FieldInit](x.fields, i).val, name) == 1) {
                    return 1;
                }
                i = i + 1;
            }
        }
        else => {
        }
    }
    return 0;
}

fn znc_ast_body_has_call(body: ArrayList[*Node], name: []u8) i32 {
    let i: i32 = 0;
    while (i < body.len) {
        switch (body.data[i].*) {
            .let_ => |x| {
                if ((x.has_init == 1) && (znc_ast_has_call_expr(x.expr, name) == 1)) {
                    return 1;
                }
            }
            .ret => |x| {
                if ((x.has_expr == 1) && (znc_ast_has_call_expr(x.expr, name) == 1)) {
                    return 1;
                }
            }
            .estmt => |x| {
                if (znc_ast_has_call_expr(x.expr, name) == 1) {
                    return 1;
                }
            }
            .assign => |x| {
                if (znc_ast_has_call_expr(x.expr, name) == 1) {
                    return 1;
                }
            }
            .if_ => |x| {
                if (((znc_ast_has_call_expr(x.cond, name) == 1) || (znc_ast_body_has_call(x.then_body, name) == 1)) || (znc_ast_body_has_call(x.els_body, name) == 1)) {
                    return 1;
                }
            }
            .while_ => |x| {
                if ((znc_ast_has_call_expr(x.cond, name) == 1) || (znc_ast_body_has_call(x.body, name) == 1)) {
                    return 1;
                }
            }
            .unsafe_ => |x| {
                if (znc_ast_body_has_call(x.body, name) == 1) {
                    return 1;
                }
            }
            .switch_ => |x| {
                if (znc_ast_has_call_expr(x.subject, name) == 1) {
                    return 1;
                }
                let ai: i32 = 0;
                while (ai < len[SwitchArm](x.arms)) {
                    if (znc_ast_body_has_call(get[SwitchArm](x.arms, ai).body, name) == 1) {
                        return 1;
                    }
                    ai = ai + 1;
                }
                if (znc_ast_body_has_call(x.els_body, name) == 1) {
                    return 1;
                }
            }
            else => {
            }
        }
        i = i + 1;
    }
    return 0;
}

fn znc_script_unaccounted_alloc_call(name: []u8, helper: i32) i32 {
    if (@strEq(name, "make") || ((helper == 1) && @strEq(name, "new"))) {
        return 1;
    }
    if (((((((((((@strEq(name, "_zag_malloc") || @strEq(name, "_zag_realloc")) || @strEq(name, "_zag_strdup")) || @strEq(name, "_zag_str_concat")) || @strEq(name, "_zag_i64_to_str")) || @strEq(name, "_zag_u64_to_str")) || @strEq(name, "_zag_read_file")) || @strEq(name, "_zag_exec_capture")) || @strEq(name, "_zag_script_context_init")) || @strEq(name, "zalloc")) || @strEq(name, "zalloc_i")) || @strEq(name, "@cacheAlignedAlloc")) {
        return 2;
    }
    return 0;
}

fn znc_script_root_unaccounted_expr(n: *Node, helper: i32) i32 {
    switch (n.*) {
        .call => |x| {
            let found: i32 = znc_script_unaccounted_alloc_call(callee_name(x.callee), helper);
            let i: i32 = 0;
            while (i < x.args.len) {
                found = found | znc_script_root_unaccounted_expr(x.args.data[i], helper);
                i = i + 1;
            }
            return found;
        }
        .bin => |x| {
            return znc_script_root_unaccounted_expr(x.l, helper) | znc_script_root_unaccounted_expr(x.r, helper);
        }
        .un => |x| {
            return znc_script_root_unaccounted_expr(x.e, helper);
        }
        .fld => |x| {
            return znc_script_root_unaccounted_expr(x.base, helper);
        }
        .idx => |x| {
            return znc_script_root_unaccounted_expr(x.base, helper) | znc_script_root_unaccounted_expr(x.idx, helper);
        }
        .cast_ => |x| {
            return znc_script_root_unaccounted_expr(x.expr, helper);
        }
        .slice_ => |x| {
            let found: i32 = znc_script_root_unaccounted_expr(x.base, helper) | znc_script_root_unaccounted_expr(x.lo, helper);
            if (x.has_hi == 1) {
                found = found | znc_script_root_unaccounted_expr(x.hi, helper);
            }
            return found;
        }
        .slit_ => |x| {
            let found: i32 = 0;
            let i: i32 = 0;
            while (i < len[FieldInit](x.fields)) {
                found = found | znc_script_root_unaccounted_expr(get[FieldInit](x.fields, i).val, helper);
                i = i + 1;
            }
            return found;
        }
        .switch_ => |x| {
            let found: i32 = znc_script_root_unaccounted_expr(x.subject, helper);
            let ai: i32 = 0;
            while (ai < len[SwitchArm](x.arms)) {
                found = found | znc_script_root_unaccounted_body(get[SwitchArm](x.arms, ai).body, helper);
                ai = ai + 1;
            }
            found = found | znc_script_root_unaccounted_body(x.els_body, helper);
            return found;
        }
        else => {
        }
    }
    return 0;
}

fn znc_script_root_unaccounted_body(body: ArrayList[*Node], helper: i32) i32 {
    let found: i32 = 0;
    let i: i32 = 0;
    while (i < body.len) {
        switch (body.data[i].*) {
            .let_ => |x| {
                if (x.has_init == 1) {
                    found = found | znc_script_root_unaccounted_expr(x.expr, helper);
                }
            }
            .ret => |x| {
                if (x.has_expr == 1) {
                    found = found | znc_script_root_unaccounted_expr(x.expr, helper);
                }
            }
            .estmt => |x| {
                found = found | znc_script_root_unaccounted_expr(x.expr, helper);
            }
            .assign => |x| {
                found = found | znc_script_root_unaccounted_expr(x.expr, helper);
            }
            .if_ => |x| {
                found = ((found | znc_script_root_unaccounted_expr(x.cond, helper)) | znc_script_root_unaccounted_body(x.then_body, helper)) | znc_script_root_unaccounted_body(x.els_body, helper);
            }
            .while_ => |x| {
                found = (found | znc_script_root_unaccounted_expr(x.cond, helper)) | znc_script_root_unaccounted_body(x.body, helper);
            }
            .unsafe_ => |x| {
                found = found | znc_script_root_unaccounted_body(x.body, helper);
            }
            .switch_ => |x| {
                found = found | znc_script_root_unaccounted_expr(x.subject, helper);
                let ai: i32 = 0;
                while (ai < len[SwitchArm](x.arms)) {
                    found = found | znc_script_root_unaccounted_body(get[SwitchArm](x.arms, ai).body, helper);
                    ai = ai + 1;
                }
                found = found | znc_script_root_unaccounted_body(x.els_body, helper);
            }
            else => {
            }
        }
        i = i + 1;
    }
    return found;
}

fn znc_script_name_seen(names: ArrayList[[]u8], name: []u8) i32 {
    let i: i32 = 0;
    while (i < names.len) {
        if (@strEq(names.data[i], name)) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn znc_script_unaccounted_root_make(decls: ArrayList[*Node]) i32 {
    let reachable: ArrayList[[]u8] = make[[]u8](8);
    push[[]u8](&reachable, "__zag_compiler_script_body_7f3a");
    let cursor: i32 = 0;
    while (cursor < reachable.len) {
        let caller: []u8 = reachable.data[cursor];
        let fi: i32 = 0;
        while (fi < decls.len) {
            switch (decls.data[fi].*) {
                .fn_decl => |f| {
                    if (@strEq(f.origin, "<root>") && (znc_script_name_seen(reachable, f.name) == 0)) {
                        let ci: i32 = 0;
                        while (ci < decls.len) {
                            switch (decls.data[ci].*) {
                                .fn_decl => |owner| {
                                    if (@strEq(owner.name, caller) && (znc_ast_body_has_call(owner.body, f.name) == 1)) {
                                        push[[]u8](&reachable, f.name);
                                    }
                                }
                                else => {
                                }
                            }
                            ci = ci + 1;
                        }
                    }
                }
                else => {
                }
            }
            fi = fi + 1;
        }
        cursor = cursor + 1;
    }
    let i: i32 = 0;
    while (i < decls.len) {
        switch (decls.data[i].*) {
            .fn_decl => |f| {
                let root_body: i32 = @strEq(f.name, "__zag_compiler_script_body_7f3a");
                let root_helper: i32 = @strEq(f.origin, "<root>");
                if ((znc_script_name_seen(reachable, f.name) == 1) && ((root_body == 1) || (root_helper == 1))) {
                    let unaccounted: i32 = znc_script_root_unaccounted_body(f.body, root_body == 0);
                    if ((unaccounted & 2) != 0) {
                        if (root_body == 1) {
                            _zag_eprintln("znc script allocation: raw runtime allocator is not charged to ScriptContext; use script_alloc/list/string_builder or an explicit strict-Zag allocator");
                        } else {
                            _zag_eprintln(_zag_str_concat("znc script allocation: reachable Script helper `", _zag_str_concat(f.name, "` uses a raw runtime allocator outside ScriptContext; use script_alloc/list/string_builder or an explicit strict-Zag module")));
                        }
                        return 1;
                    }
                    if ((unaccounted & 1) != 0) {
                        if (root_body == 1) {
                            _zag_eprintln("znc script allocation: root make is not charged to ScriptContext; use list/string_builder/script_alloc or an explicit strict-Zag allocator");
                        } else {
                            _zag_eprintln(_zag_str_concat("znc script allocation: reachable Script helper `", _zag_str_concat(f.name, "` uses make or new outside ScriptContext; use script_alloc/list/string_builder or an explicit strict-Zag module")));
                        }
                        return 1;
                    }
                }
            }
            else => {
            }
        }
        i = i + 1;
    }
    return 0;
}

fn znc_script_std_origin_kind(origin: []u8) i32 {
    if (@strEq(origin, canon_path(resolve_import_path("std:process", ".")))) {
        return 1;
    }
    if (@strEq(origin, canon_path(resolve_import_path("std:script_io", ".")))) {
        return 2;
    }
    if (@strEq(origin, canon_path(resolve_import_path("std:script_input", ".")))) {
        return 3;
    }
    if (@strEq(origin, canon_path(resolve_import_path("std:script_string_builder", ".")))) {
        return 4;
    }
    if (@strEq(origin, canon_path(resolve_import_path("std:script_list", ".")))) {
        return 5;
    }
    if (@strEq(origin, canon_path(resolve_import_path("std:script_string", ".")))) {
        return 6;
    }
    if (@strEq(origin, canon_path(resolve_import_path("std:script_path", ".")))) {
        return 7;
    }
    if (@strEq(origin, canon_path(resolve_import_path("std:script_json", ".")))) {
        return 8;
    }
    if (@strEq(origin, canon_path(resolve_import_path("std:script_csv", ".")))) {
        return 9;
    }
    if (@strEq(origin, canon_path(resolve_import_path("std:script_map", ".")))) {
        return 10;
    }
    if (@strEq(origin, canon_path(resolve_import_path("std:script_set", ".")))) {
        return 11;
    }
    if (@strEq(origin, canon_path(resolve_import_path("std:script_range", ".")))) {
        return 12;
    }
    return 0;
}

fn znc_script_compiler_std_call(decls: ArrayList[*Node], name: []u8) i32 {
    let i: i32 = 0;
    while (i < decls.len) {
        switch (decls.data[i].*) {
            .fn_decl => |f| {
                if (((f.is_extern == 0) && @strEq(f.name, name)) && (znc_script_std_origin_kind(f.origin) > 0)) {
                    return 1;
                }
            }
            else => {
            }
        }
        i = i + 1;
    }
    return 0;
}

fn znc_script_owner_ends(owner: []u8, short: []u8) i32 {
    if (@strEq(owner, short)) {
        return 1;
    }
    if (owner.len < (short.len + 2)) {
        return 0;
    }
    let start: i32 = owner.len - short.len;
    if (@strEq(owner[start..owner.len], short) == 0) {
        return 0;
    }
    return ((owner[start - 2] == 95) && (owner[start - 1] == 95)) as i32;
}

fn znc_script_std_runtime_call(kind: i32, owner: []u8, name: []u8) i32 {
    if (((@strEq(name, "@sizeOf") || @strEq(name, "@alignOf")) || @strEq(name, "@offsetOf")) || @strEq(name, "@strEq")) {
        return 1;
