fn znc_harden_bit(value: i32) []u8 {
    if (value == 1) {
        return "1";
    }
    return "0";
}

fn znc_harden_explicit_header(config: PlannerConfig, resolved: PlannerResolution, root_try: i32) []u8 {
    let capability_bits: i64 = znc_script_capability_bits(config);
    let execution_policy: i64 = znc_script_execution_policy(resolved);
    let header: []u8 = "\n// Generated by znc harden. These declarations make the former Script runtime policy explicit.\nconst __zag_hardened_script_memory_limit: i64 = ";
    header = _zag_str_concat(header, _zag_i64_to_str(config.script_memory_bytes));
    header = _zag_str_concat(header, _zag_str_concat(";\nconst __zag_hardened_allow_filesystem_read: i32 = ", znc_harden_bit(config.allow_filesystem_read)));
    header = _zag_str_concat(header, _zag_str_concat(";\nconst __zag_hardened_allow_filesystem_write: i32 = ", znc_harden_bit(config.allow_filesystem_write)));
    header = _zag_str_concat(header, _zag_str_concat(";\nconst __zag_hardened_allow_process: i32 = ", znc_harden_bit(config.allow_process)));
    header = _zag_str_concat(header, _zag_str_concat(";\nconst __zag_hardened_capability_bits: i64 = ", _zag_i64_to_str(capability_bits)));
    header = _zag_str_concat(header, _zag_str_concat(";\n// allocator policy: ", resolved.choices.allocator));
    header = _zag_str_concat(header, _zag_str_concat("\nconst __zag_hardened_allocator_policy_id: i32 = ", _zag_i64_to_str(znc_script_allocator_policy_id(resolved.choices.allocator) as i64)));
    header = _zag_str_concat(header, _zag_str_concat(";\nconst __zag_hardened_execution_policy: i64 = ", _zag_i64_to_str(execution_policy)));
    header = _zag_str_concat(header, ";\nextern fn _zag_script_context_init(limit:i64, capabilities:i64, execution_policy:i64) *opaque\nextern fn _zag_script_context_shutdown(context:*opaque) void\n\nfn __zag_hardened_status_boundary(status:i32) i32 {\n    return status;\n}\n");
    if (root_try == 1) {
        header = _zag_str_concat(header, "\nfn __zag_hardened_uncaught(code:i32) i32 {\n    let code_text:[]u8 = _zag_i64_to_str(code as i64);\n    _zag_eprintln(\"uncaught Zag Script error code\");\n    _zag_eprintln(code_text);\n    _zag_str_free(code_text);\n    return 1;\n}\n\nfn __zag_hardened_script_body(__zag_script_context:*opaque) !i32 {\n");
    } else {
        header = _zag_str_concat(header, "\nfn __zag_hardened_script_body(__zag_script_context:*opaque) i32 {\n");
    }
    return header;
}

fn znc_harden_wrapper(root_try: i32) []u8 {
    if (root_try == 1) {
        return "\n}\n\nfn main() i32 {\n    let __zag_script_context:*opaque = _zag_script_context_init(__zag_hardened_script_memory_limit, __zag_hardened_capability_bits, __zag_hardened_execution_policy);\n    let __zag_hardened_status:i32 = __zag_hardened_script_body(__zag_script_context) catch |__zag_hardened_error_code| __zag_hardened_uncaught(__zag_hardened_error_code);\n    _zag_script_context_shutdown(__zag_script_context);\n    return __zag_hardened_status_boundary(__zag_hardened_status);\n}\n";
    }
    return "\n}\n\nfn main() i32 {\n    let __zag_script_context:*opaque = _zag_script_context_init(__zag_hardened_script_memory_limit, __zag_hardened_capability_bits, __zag_hardened_execution_policy);\n    let __zag_hardened_status:i32 = __zag_hardened_script_body(__zag_script_context);\n    _zag_script_context_shutdown(__zag_script_context);\n    return __zag_hardened_status_boundary(__zag_hardened_status);\n}\n";
}

struct ZHardenPrepared {
    valid: i32,
    source_snapshot: []u8,
    active: []u8,
    normalized: ZsNormalized,
    unit: CompilationUnit,
    config: PlannerConfig,
    input: PlannerChoices,
    resolution: PlannerResolution,
    marker: ZHardenScriptMarker,
    body_start: i32,
    declarations_len: i32,
    header_start: i32,
    header_end: i32,
    body_derived_start: i32,
    wrapper_start: i32,
    active_prefix: i32,
    candidate: []u8,
    bound_body: []u8,
    supported: i32,
    candidate_valid: i32,
    unresolved_prelude: i32,
    root_try: i32,
    late_declaration: i32,
    late_fn_declarations: []u8,
    reserved_conflict: i32,
}

fn znc_harden_prepared_bad(snapshot: []u8) ZHardenPrepared {
    let normalized: ZsNormalized = script_syntax_normalize_with_origins("");
    let unit: CompilationUnit = CompilationUnit{ .profile = ModuleProfile.strict, .decls = make[*Node](1), .modules = make[ResolvedModule](1), .imports = make[ResolvedImport](1), .resources = make[ResolvedResource](1), .origins = make[NodeOrigin](1), .registry_graph_edges = "", .registry_graph_complete = 0 };
    let config: PlannerConfig = planner_default_config();
    let input: PlannerChoices = planner_empty_choices();
    let resolution: PlannerResolution = planner_resolve(0, "", config, input, 0);
    return ZHardenPrepared{ .valid = 0, .source_snapshot = snapshot, .active = "", .normalized = normalized, .unit = unit, .config = config, .input = input, .resolution = resolution, .marker = ZHardenScriptMarker{ .start = -1, .end = -1, .valid = 0 }, .body_start = 0, .declarations_len = 0, .header_start = 0, .header_end = 0, .body_derived_start = 0, .wrapper_start = 0, .active_prefix = 0, .candidate = "", .bound_body = "", .supported = 0, .candidate_valid = 0, .unresolved_prelude = 0, .root_try = 0, .late_declaration = 0, .late_fn_declarations = "", .reserved_conflict = 0 };
}

fn znc_harden_prepare(path: []u8, source_snapshot: []u8) ZHardenPrepared {
    let bad: ZHardenPrepared = znc_harden_prepared_bad(source_snapshot);
    let active: []u8 = znc_activate_script_source(path, source_snapshot, 0);
    let normalized: ZsNormalized = script_syntax_normalize_with_origins(active);
    let src: []u8 = normalized.source;
    let unit: CompilationUnit = parse_compilation_unit_dir(active, dir_of(path));
    if (unit.profile != ModuleProfile.script) {
        _zag_eprintln("znc harden: source is already regular Zag; no script profile to expand");
        return bad;
    }
    if (znc_harden_has_closure_decl(unit.decls) == 1) {
        _zag_eprintln("znc explicit: closure literals are not yet supported by explicit expansion");
        return bad;
    }
    if (((znc_validate_script_defaults(path, unit) != 0) || (znc_configure_script_unit(&unit, path) != 0)) || (znc_validate_script_capabilities(path, unit) != 0)) {
        return bad;
    }
    if (((znc_script_std_body_check(unit.decls) != 0) || (znc_script_lifetime_check(unit.decls) != 0)) || (znc_script_unaccounted_root_make(unit.decls) != 0)) {
        return bad;
    }
    let config: PlannerConfig = znc_project_config(znc_project_root(dir_of(path)), 0);
    let input: PlannerChoices = znc_script_explicit_choices();
    let resolution: PlannerResolution = planner_resolve(1, "", config, input, 0);
    let marker: ZHardenScriptMarker = znc_harden_script_marker(src);
    if (marker.valid == 0) {
        _zag_eprintln("znc harden: script marker not found");
        return bad;
    }
    let cursor: i32 = marker.end;
    let declarations: []u8 = "";
    let body_start: i32 = cursor;
    let scanning: i32 = 1;
    while (scanning == 1) {
        let decl_start: i32 = znc_harden_space(src, cursor);
        if ((decl_start < src.len) && (znc_harden_decl_start(src, decl_start) == 1)) {
            let decl_end: i32 = znc_harden_decl_end(src, decl_start);
            if (decl_end < 0) {
                _zag_eprintln("znc harden: unterminated declaration");
                return bad;
            }
            declarations = _zag_str_concat(declarations, src[cursor..decl_end]);
            cursor = decl_end;
            body_start = cursor;
        } else {
            body_start = cursor;
            scanning = 0;
        }
    }
    let later: i32 = znc_harden_space(src, body_start);
    let late_declaration: i32 = 0;
    let late_fn_declarations: []u8 = "";
    let line: i32 = later;
    while (line < src.len) {
        let at: i32 = znc_harden_space(src, line);
        if ((((line == 0) || (src[line - 1] == 10)) && (at < src.len)) && (znc_harden_decl_start(src, at) == 1)) {
            let decl_end: i32 = znc_harden_decl_end(src, at);
            if (decl_end < 0) {
                _zag_eprintln("znc harden: unterminated trailing declaration");
                return bad;
            }
            if (((znc_harden_late_fn_decl(src, at) == 1) || (znc_harden_late_type_decl(src, at) == 1)) || (znc_harden_late_const_supported(src, at, decl_end, unit.decls) == 1)) {
                late_fn_declarations = _zag_str_concat(late_fn_declarations, _zag_str_concat(src[at..decl_end], "\n"));
            } else {
                late_declaration = 1;
            }
            line = decl_end;
            while ((line < src.len) && (src[line] != 10)) {
                line = line + 1;
            }
            if (line < src.len) {
                line = line + 1;
            }
        } else {
            while ((line < src.len) && (src[line] != 10)) {
                line = line + 1;
            }
            if (line < src.len) {
                line = line + 1;
            }
        }
    }
    let closure_declarations: []u8 = znc_harden_render_closure_declarations(unit.decls);
    late_fn_declarations = _zag_str_concat(late_fn_declarations, closure_declarations);
    let unresolved_prelude: i32 = 0;
    let root_try: i32 = 0;
    znc_harden_root_facts(unit.decls, &unresolved_prelude, &root_try);
    if (znc_harden_root_extra_prelude(unit.decls) == 1) {
        unresolved_prelude = 1;
    }
    let captured_closure: []u8 = "";
    let captured_binding: []u8 = "";
    let cdi: i32 = 0;
    while (cdi < unit.decls.len) {
        switch (unit.decls.data[cdi].*) {
            .fn_decl => |f| {
                if ((((f.is_extern == 0) && (f.caps > 0)) && starts_with(f.name, "__clos_")) && (znc_harden_capture_closure_decl_supported(unit.decls, f) == 1)) {
                    captured_closure = f.name;
                    let rdi: i32 = 0;
                    while (rdi < unit.decls.len) {
                        switch (unit.decls.data[rdi].*) {
                            .fn_decl => |root| {
                                if (@strEq(root.name, "__zag_compiler_script_body_7f3a")) {
                                    captured_binding = znc_harden_capture_closure_binding(root.body, f.name);
