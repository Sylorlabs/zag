// selfhost/native/znc.zag — the NATIVE-backend CLI driver.
//
//   znc <source.zag> [-o <out>] [--run]
//
// Compiles Zag source straight to a runnable native x86-64 ELF:
//
//   source ──parse──▶ AST ──ncodegen──▶ x86-64 instrs ──x86 encode──▶ machine
//   code ──elf──▶ ELF executable.
//
// There is NO cc / as / ld / libc / LLVM anywhere in this pipeline — every
// stage is Zag (this driver + ncodegen.zag + x86.zag + elf.zag). The emitted
// binary is statically linked, has no interpreter, and exits via a raw syscall.

@import("x86.zag")        // encode(ArrayList[Instr]) -> ArrayList[u8]
@import("elf.zag")        // write_elf_exec_data / write_elf_exec_data_lib
@import("elf_i686.zag")   // isolated literal-main ELF32/i386 milestone
@import("i386_codegen.zag") // validated AST -> integer IR -> i386 machine code
@import("elf_dynamic.zag") // explicit PT_INTERP/DT_NEEDED system ABI bridge
@import("regalloc.zag")   // regalloc(ArrayList[Instr]) -> ArrayList[Instr] (register promotion)
@import("optimize.zag")   // optimize(ArrayList[Instr]) -> ArrayList[Instr] (fold/stack-elim/DCE)
@import("peephole.zag")   // peephole(ArrayList[Instr]) -> ArrayList[Instr] (optimizer)
@import("ncodegen.zag")   // lower_program(decls, *errcount, *databuf) -> ArrayList[Instr]
@import("../sema.zag")    // analyze(decls)->eff  report_violations(decls,eff)->i32
@import("../typed.zag")   // shared declared-type authority for every target
@import("../v2_edition.zag") // edition-gated v2 syntax rejection before parse
@import("../analyze.zag") // run_analysis(decls, file, pedantic)->i32  leak + efficiency lints
@import("ar.zag")         // ar_symbol_table, ar_entry_data (GNU ar reader)
@import("elf_obj.zag")    // elf_obj_parse, merge_obj, apply_relocs, MergedLib
@import("zagmod.zag")     // zagmod_parse, ZagMod (zag.mod manifest reader)
@import("dwarf.zag")      // optional DWARF sections for --debug builds
@import("../fmt.zag")     // native Zag source formatter
@import("../version.zag") // zag_version / zag_edition
@import("../smt.zag")     // @total SMT discharge (kept out of sema.zag for lean bootstrap)
@import("../mlir.zag")    // GPU MLIR emitter (lean — no codegen.zag dependency)
@import("../gfx1010.zag") // deterministic validated RDNA1 kernel bundles
@import("../spirv.zag")   // SPIR-V binary encoder for Vulkan/OpenCL compat tier
@import("../msl.zag")     // Metal Shading Language encoder for Metal compat tier
@import("../glsl.zag")    // GLSL 430 compute shader encoder for OpenGL compat tier
@import("../cuda_ptx.zag") // NVIDIA PTX ISA encoder for CUDA compat tier
@import("../planner_authority.zag") // line-wise planner configuration authority
@import("../zagd_identity.zag") // PID-reuse-safe daemon singleton identity
@import("../zagd_profile.zag") // checksum-bound foreground profile metadata
@import("../semantic_manifest_publish.zag") // advisory sema identities for zagd
@import("wasm.zag")       // WASM binary emitter
@import("acodegen.zag")   // AArch64 lean codegen (--target arm64 only)

@import("aarch64.zag")   // AArch64 instruction encoder
@import("elf_arm64.zag")  // ELF64 AArch64 writer
@import("x86_cpu_profile.zag") // explicit Linux x86-64 baseline/native policy
@import("foreground_cache.zag") // revalidated whole-program machine-code reuse

extern fn _zag_raw_syscall(num: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64) i64
extern fn _zag_slice_ptr(s: []u8) *i8

// ── operator-contract lowering (pre-sema) ────────────────────────────────────
// Rewrites binary ops on user types to their decode fn calls BEFORE sema runs,
// so the effect checker sees `big_add(x, y)` instead of `x + y` and can
// correctly flag @realtime functions that use an allocating operator.
// Mirrors zagc.zag's lower_operators() call, but without pulling in codegen.zag.
struct LoEnv { name: []u8, ty: []u8 }
fn lo_env_get(env: ArrayList[LoEnv], name: []u8) []u8 {
    let i: i32 = 0;
    while (i < len[LoEnv](env)) {
        if (@strEq(get[LoEnv](env, i).name, name)) { return get[LoEnv](env, i).ty; }
        i = i + 1;
    }
    return "";
}
fn lo_id_ty(n: *Node, env: ArrayList[LoEnv], dl: ArrayList[*Node]) []u8 {
    switch (n.*) {
        .id  => |x| { return lo_env_get(env, x.name); }
        .fld => |f| {
            let base_ty: []u8 = lo_id_ty(f.base, env, dl);
            if (base_ty.len == 0) { return ""; }
            let si: i32 = 0;
            while (si < len[*Node](dl)) {
                switch (get[*Node](dl, si).*) {
                    .struct_ => |s| {
                        if (@strEq(s.name, base_ty)) {
                            let fi: i32 = 0;
                            while (fi < len[Param](s.fields)) {
                                let fp: Param = get[Param](s.fields, fi);
                                if (@strEq(fp.name, f.fname)) { return fp.pty; }
                                fi = fi + 1;
                            }
                        }
                    }
                    else => { }
                }
                si = si + 1;
            }
            return "";
        }
        else => { return ""; }
    }
}
fn lo_mk_call2(fname: []u8, a: *Node, b: *Node) *Node {
    let args: ArrayList[*Node] = make[*Node](2);
    push[*Node](&args, a);
    push[*Node](&args, b);
    return mk_call(mk_ident(fname), args);
}
fn lo_expr(n: *Node, env: ArrayList[LoEnv], dl: ArrayList[*Node]) void {
    switch (n.*) {
        .bin => |b| {
            lo_expr(b.l, env, dl);
            lo_expr(b.r, env, dl);
            if (@strEq(b.op, "+") || @strEq(b.op, "-") || @strEq(b.op, "*") || @strEq(b.op, "/")) {
                let lt: []u8 = lo_id_ty(b.l, env, dl);
                if (lt.len > 0) {
                    let decode: []u8 = op_contract_fn(dl, lt, b.op);
                    if (decode.len > 0) {
                        n.* = lo_mk_call2(decode, b.l, b.r).*;
                    }
                }
            }
        }
        .un    => |u| { lo_expr(u.e, env, dl); }
        .call  => |c| {
            lo_expr(c.callee, env, dl);
            let i: i32 = 0;
            while (i < len[*Node](c.args)) { lo_expr(get[*Node](c.args, i), env, dl); i = i + 1; }
        }
        .idx   => |x| { lo_expr(x.base, env, dl); lo_expr(x.idx, env, dl); }
        .fld   => |f| { lo_expr(f.base, env, dl); }
        .slit_ => |s| {
            let i: i32 = 0;
            while (i < len[FieldInit](s.fields)) { lo_expr(get[FieldInit](s.fields, i).val, env, dl); i = i + 1; }
        }
        else => { }
    }
}
fn lo_block(body: ArrayList[*Node], env: *ArrayList[LoEnv], dl: ArrayList[*Node]) void {
    let i: i32 = 0;
    while (i < len[*Node](body)) { lo_stmt(get[*Node](body, i), env, dl); i = i + 1; }
}
fn lo_stmt(n: *Node, env: *ArrayList[LoEnv], dl: ArrayList[*Node]) void {
    switch (n.*) {
        .let_   => |l| {
            lo_expr(l.expr, env.*, dl);
            // Track declared-type let bindings so we can resolve `x+y` when x is a let var.
            if (l.has_dty == 1 && l.dty.len > 0) {
                push[LoEnv](env, LoEnv{ .name = l.name, .ty = l.dty });
            }
        }
        .ret    => |r| { if (r.has_expr == 1) { lo_expr(r.expr, env.*, dl); } }
        .if_    => |x| { lo_expr(x.cond, env.*, dl); lo_block(x.then_body, env, dl); lo_block(x.els_body, env, dl); }
        .while_ => |w| { lo_expr(w.cond, env.*, dl); lo_block(w.body, env, dl); }
        .unsafe_ => |u| { lo_block(u.body, env, dl); }
        .assign => |a| { lo_expr(a.target, env.*, dl); lo_expr(a.expr, env.*, dl); }
        .switch_ => |sw| {
            lo_expr(sw.subject, env.*, dl);
            let i: i32 = 0;
            while (i < len[SwitchArm](sw.arms)) { lo_block(get[SwitchArm](sw.arms, i).body, env, dl); i = i + 1; }
            if (sw.has_els == 1) { lo_block(sw.els_body, env, dl); }
        }
        .estmt  => |e| { lo_expr(e.expr, env.*, dl); }
        else    => { }
    }
}
fn lo_build_env(params: ArrayList[Param]) ArrayList[LoEnv] {
    let env: ArrayList[LoEnv] = make[LoEnv](8);
    let i: i32 = 0;
    while (i < len[Param](params)) {
        let p: Param = get[Param](params, i);
        push[LoEnv](&env, LoEnv{ .name = p.name, .ty = p.pty });
        i = i + 1;
    }
    return env;
}
fn lo_operators(decls: ArrayList[*Node]) void {
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                // skip externs, generics, and operator-contract pseudo-fns
                if (f.is_extern == 0 && len[[]u8](f.tparams) == 0) {
                    let is_op: i32 = 0;
                    if (f.name.len >= 5) {
                        if (f.name[0] == '_' && f.name[1] == '_' && f.name[2] == 'o' && f.name[3] == 'p' && f.name[4] == '_') { is_op = 1; }
                    }
                    if (is_op == 0) {
                        let lenv: ArrayList[LoEnv] = lo_build_env(f.params);
                        lo_block(f.body, &lenv, decls);
                    }
                }
            }
            else => { }
        }
        i = i + 1;
    }
}

// ── library linking helpers ───────────────────────────────────────────────────

// Walk `decls`, collect any `.link_dir` node's `.lib` name into `link_libs`,
// and return a new list with all `.link_dir` nodes removed.
// ncodegen.zag's pass-1 switch would abort on unknown top-level nodes, so we
// must filter them out before calling lower_program.
fn znc_collect_links(decls: ArrayList[*Node], link_libs: *ArrayList[[]u8]) ArrayList[*Node] {
    let filtered: ArrayList[*Node] = make[*Node](len[*Node](decls));
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        let n: *Node = get[*Node](decls, i);
        switch (n.*) {
            .link_dir => |ld| { push[[]u8](link_libs, ld.lib); }
            else => { push[*Node](&filtered, n); }
        }
        i = i + 1;
    }
    return filtered;
}

// Append any `-lNAME` or `-l NAME` library names from argv into `link_libs`.
fn znc_argv_links(link_libs: *ArrayList[[]u8]) void {
    let i: i32 = 1;
    while (i < _zag_argc()) {
        let a: []u8 = _zag_arg(i);
        if (a.len > 2) {
            // "-lNAME" form
            if ((a[0] as i32) == 45 && (a[1] as i32) == 108) {
                push[[]u8](link_libs, a[2..a.len]);
            }
        }
        if (@strEq(a, "-l")) {
            if (i + 1 < _zag_argc()) {
                push[[]u8](link_libs, _zag_arg(i + 1));
                i = i + 1;
            }
        }
        i = i + 1;
    }
}

// Append any `-LPATH` or `-L PATH` search directories from argv into `lib_paths`.
fn znc_argv_paths(lib_paths: *ArrayList[[]u8]) void {
    let i: i32 = 1;
    while (i < _zag_argc()) {
        let a: []u8 = _zag_arg(i);
        if (a.len > 2) {
            // "-LPATH" form
            if ((a[0] as i32) == 45 && (a[1] as i32) == 76) {
                push[[]u8](lib_paths, a[2..a.len]);
            }
        }
        if (@strEq(a, "-L")) {
            if (i + 1 < _zag_argc()) {
                push[[]u8](lib_paths, _zag_arg(i + 1));
                i = i + 1;
            }
        }
        i = i + 1;
    }
}

// Read a `zag.mod` from `dir` and add any `link` and `path` fields from
// [deps] into `link_libs` and `lib_paths` respectively.
fn znc_load_zagmod(dir: []u8, link_libs: *ArrayList[[]u8], lib_paths: *ArrayList[[]u8]) void {
    let modpath: []u8 = join_path(dir, "zag.mod");
    if (_zag_file_exists(modpath) == 0) { return; }
    let src: []u8 = _zag_read_file(modpath);
    if (src.len < 0) { return; }
    let mod_: ZagMod = zagmod_parse(src);
    let i: i32 = 0;
    while (i < len[ZagDep](mod_.deps)) {
        let dep: ZagDep = get[ZagDep](mod_.deps, i);
        if (dep.link.len > 0) { push[[]u8](link_libs, dep.link); }
        if (dep.path.len > 0) { push[[]u8](lib_paths, dep.path); }
        i = i + 1;
    }
}

// Scan the filtered decls list for `extern fn` declarations and return their names.
// These are the symbols we need to pull in from static libraries.
fn collect_extern_syms(decls: ArrayList[*Node]) ArrayList[[]u8] {
    let syms: ArrayList[[]u8] = make[[]u8](8);
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                if (f.is_extern == 1) { push[[]u8](&syms, f.name); }
            }
            else => { }
        }
        i = i + 1;
    }
    return syms;
}

fn znc_fn_has_annot(f: FnDecl, annot: []u8) i32 {
    let i: i32 = 0;
    while (i < len[[]u8](f.annots)) {
        if (@strEq(get[[]u8](f.annots, i), annot)) { return 1; }
        i = i + 1;
    }
    return 0;
}

struct ZncObjectExport { name:[]u8, label:i32 }

// Pass-1 native labels are assigned in declaration order starting at one.
// Mirror only that deliberately stable compiler-internal contract here so the
// ET_REL writer can turn encoder label offsets into symbol values.
fn znc_x86_object_exports(decls:ArrayList[*Node])ArrayList[ZncObjectExport]{
    let out:ArrayList[ZncObjectExport]=make[ZncObjectExport](4);let label:i32=1;let i:i32=0;
    while(i<len[*Node](decls)){switch(get[*Node](decls,i).*){.fn_decl=>|f|{
        if(f.is_extern==0&&len[[]u8](f.tparams)==0&&len[*Node](f.body)>0&&starts_with(f.name,"__iface_")==0){
            if(znc_fn_has_annot(f,"@cabi_export")==1){push[ZncObjectExport](&out,ZncObjectExport{.name=f.name,.label=label});}
            label=label+1;
        }
    }else=>{}}i=i+1;}return out;
}

fn znc_dynamic_extern_syms(decls: ArrayList[*Node], v2_edition: i32) ArrayList[[]u8] {
    let syms: ArrayList[[]u8] = make[[]u8](8);
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                if (f.is_extern == 1 && starts_with(f.name, "_zag_") == 0 && (v2_edition == 0 || znc_fn_has_annot(f, "@cabi") == 1)) {
                    let found: i32 = 0;
                    let j: i32 = 0;
                    while (j < syms.len) {
                        if (@strEq(get[[]u8](syms, j), f.name)) { found = 1; }
                        j = j + 1;
                    }
                    if (found == 0) { push[[]u8](&syms, f.name); }
                }
            }
            else => { }
        }
        i = i + 1;
    }
    return syms;
}

// ET_REL direct imports are an explicit v2 C-ABI surface.  Do not let an
// otherwise-unused legacy `extern` declaration become silently acceptable
// merely because object mode has no call site to lower.
fn znc_object_externs_ok(decls:ArrayList[*Node])i32{
    let i:i32=0;
    while(i<len[*Node](decls)){
        switch(get[*Node](decls,i).*){
            .fn_decl=>|f|{
                if(f.is_extern==1&&starts_with(f.name,"_zag_")==0&&znc_fn_has_annot(f,"@cabi")==0){return 0;}
            }
            else=>{}
        }
        i=i+1;
    }
    return 1;
}

fn znc_needed_name_ok(s: []u8) i32 {
    if (s.len == 0 || s.len > 128) { return 0; }
    let i: i32 = 0;
    while (i < s.len) {
        let c: u8 = s[i];
        let ok: i32 = 0;
        if (c >= 'a' && c <= 'z') { ok = 1; }
        if (c >= 'A' && c <= 'Z') { ok = 1; }
        if (c >= '0' && c <= '9') { ok = 1; }
        if (c == '.' || c == '_' || c == '-' || c == '+') { ok = 1; }
        if (ok == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn znc_needed_libs() ArrayList[[]u8] {
    let libs: ArrayList[[]u8] = make[[]u8](4);
    let i: i32 = 1;
    while (i < _zag_argc()) {
        if (@strEq(_zag_arg(i), "--needed")) {
            if (i + 1 >= _zag_argc() || znc_needed_name_ok(_zag_arg(i + 1)) == 0) {
                _zag_eprintln("znc: --needed requires a safe shared-library SONAME");
                _zag_exit(1);
            }
            push[[]u8](&libs, _zag_arg(i + 1));
            i = i + 1;
        }
        i = i + 1;
    }
    return libs;
}

// Search for `lib{libname}.a` in the user-supplied paths then in standard
// system library directories.  Returns the full path on success, "" on failure.
fn find_library(libname: []u8, paths: ArrayList[[]u8]) []u8 {
    let fname: []u8 = _zag_str_concat("lib", _zag_str_concat(libname, ".a"));
    let i: i32 = 0;
    while (i < len[[]u8](paths)) {
        let full: []u8 = join_path(get[[]u8](paths, i), fname);
        if (_zag_file_exists(full) != 0) { return full; }
        i = i + 1;
    }
    // Fallback: standard Linux multiarch and legacy paths.
    let syspaths: ArrayList[[]u8] = make[[]u8](4);
    push[[]u8](&syspaths, "/usr/lib/x86_64-linux-gnu");
    push[[]u8](&syspaths, "/usr/lib");
    push[[]u8](&syspaths, "/lib/x86_64-linux-gnu");
    push[[]u8](&syspaths, "/lib");
    let j: i32 = 0;
    while (j < len[[]u8](syspaths)) {
        let full: []u8 = join_path(get[[]u8](syspaths, j), fname);
        if (_zag_file_exists(full) != 0) { return full; }
        j = j + 1;
    }
    return "";
}

// For each library in `libs`, find it, parse it as a GNU ar archive,
// and merge the object-file members that define symbols in `needed_syms`
// into a single MergedLib.  Then apply intra-library relocations.
//
// `text_base` — the virtual address where the merged library code will be
// placed (immediately after the main program code in the ELF text segment).
fn link_libraries(libs: ArrayList[[]u8], paths: ArrayList[[]u8], needed_syms: ArrayList[[]u8], text_base: i64) MergedLib {
    let ml: MergedLib = MergedLib{
        .text      = make[u8](256),
        .sym_addrs = make[SymAddr](8),
        .relocs    = make[PendingReloc](16),
        .text_base = text_base,
    };

    let i: i32 = 0;
    while (i < len[[]u8](libs)) {
        let libname: []u8 = get[[]u8](libs, i);
        let libpath: []u8 = find_library(libname, paths);
        if (libpath.len == 0) {
            _zag_print("znc: error: @link library '");
            _zag_print(libname);
            _zag_println("' not found in search paths (set ZAG_LIB_PATH or place library adjacent to source)");
            _zag_exit(1);
        }
        if (libpath.len > 0) {
            let buf: []u8 = _zag_read_file(libpath);
            if (buf.len > 0) {
                // Parse the GNU symbol table so we can look up which archive
                // member contains each needed symbol.
                let ar_syms: ArrayList[ArSymbol] = ar_symbol_table(buf);
                let ni: i32 = 0;
                while (ni < len[[]u8](needed_syms)) {
                    let sym: []u8 = get[[]u8](needed_syms, ni);
                    let file_off: i64 = 0 - 1;
                    let si2: i32 = 0;
                    while (si2 < len[ArSymbol](ar_syms)) {
                        let as_: ArSymbol = get[ArSymbol](ar_syms, si2);
                        if (@strEq(as_.name, sym)) { file_off = as_.entry_offset; }
                        si2 = si2 + 1;
                    }
                    if (file_off >= 0) {
                        let obj_data: []u8 = ar_entry_data(buf, file_off);
                        if (obj_data.len > 0) {
                            let obj: ObjFile = elf_obj_parse(obj_data);
                            merge_obj(&ml, obj, text_base);
                        }
                    }
                    ni = ni + 1;
                }
            }
        }
        i = i + 1;
    }

    // Apply intra-library relocations now that all sym_addrs are known.
    let empty_extern: ArrayList[SymAddr] = make[SymAddr](1);
    apply_relocs(&ml, empty_extern);

    return ml;
}

// ── gpu / wasm targets (mlir.zag + wasm.zag, linked above) ───────────────────
// mlir.zag is decoupled from codegen.zag so this driver can host GPU/WASM
// backends without blowing the self-hosting fixpoint budget.

fn starts_with(s: []u8, p: []u8) i32 {
    if (s.len < p.len) { return 0; }
    let i: i32 = 0;
    while (i < p.len) {
        if (s[i] != p[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

// "nvidia" / "amd" / "vulkan" when `--target gpu-*` is present, else "".
fn gpu_target() []u8 {
    let i: i32 = 0;
    while (i < _zag_argc()) {
        let a: []u8 = _zag_arg(i);
        if (@strEq(a, "--target")) {
            if (i + 1 < _zag_argc()) {
                let v: []u8 = _zag_arg(i + 1);
                if (starts_with(v, "gpu-") == 1) { return v[4..]; }
            }
        }
        if (starts_with(a, "--target=gpu-") == 1) { return a[13..]; }
        i = i + 1;
    }
    return "";
}

fn gfx1010_target() i32 {
    let i: i32 = 0;
    while (i < _zag_argc()) {
        let a: []u8 = _zag_arg(i);
        if (@strEq(a, "--target") && i + 1 < _zag_argc() &&
            @strEq(_zag_arg(i + 1), "amdgpu-gfx1010")) { return 1; }
        if (@strEq(a, "--target=amdgpu-gfx1010")) { return 1; }
        i = i + 1;
    }
    return 0;
}

// Compatibility-tier GPU targets: vulkan-compat, opencl-compat, metal-compat,
// opengl-compat, cuda-compat. These are non-certified fallback backends that
// emit SPIR-V/MSL/GLSL/PTX and use system API loaders. Returns the target
// name string (e.g. "vulkan-compat") or "" if no compat target is selected.
fn compat_target() []u8 {
    let i: i32 = 0;
    while (i < _zag_argc()) {
        let a: []u8 = _zag_arg(i);
        if (@strEq(a, "--target") && i + 1 < _zag_argc()) {
            let v: []u8 = _zag_arg(i + 1);
            if (@strEq(v, "vulkan-compat")) { return "vulkan-compat"; }
            if (@strEq(v, "opencl-compat")) { return "opencl-compat"; }
            if (@strEq(v, "metal-compat")) { return "metal-compat"; }
            if (@strEq(v, "opengl-compat")) { return "opengl-compat"; }
            if (@strEq(v, "cuda-compat")) { return "cuda-compat"; }
        }
        if (starts_with(a, "--target=") == 1) {
            let v: []u8 = a[9..];
            if (@strEq(v, "vulkan-compat")) { return "vulkan-compat"; }
            if (@strEq(v, "opencl-compat")) { return "opencl-compat"; }
            if (@strEq(v, "metal-compat")) { return "metal-compat"; }
            if (@strEq(v, "opengl-compat")) { return "opengl-compat"; }
            if (@strEq(v, "cuda-compat")) { return "cuda-compat"; }
        }
        i = i + 1;
    }
    return "";
}

fn compat_target_uses_spirv(target: []u8) bool {
    if (@strEq(target, "vulkan-compat")) { return true; }
    return false;
}

fn compat_target_uses_spirv_opencl(target: []u8) bool {
    if (@strEq(target, "opencl-compat")) { return true; }
    return false;
}

fn compat_target_uses_msl(target: []u8) bool {
    if (@strEq(target, "metal-compat")) { return true; }
    return false;
}

fn compat_target_uses_glsl(target: []u8) bool {
    if (@strEq(target, "opengl-compat")) { return true; }
    return false;
}

fn compat_target_uses_ptx(target: []u8) bool {
    if (@strEq(target, "cuda-compat")) { return true; }
    return false;
}

fn wasm_target() i32 {
    let i: i32 = 0;
    while (i < _zag_argc()) {
        let a: []u8 = _zag_arg(i);
        if (@strEq(a, "--target")) {
            if (i + 1 < _zag_argc()) {
                if (@strEq(_zag_arg(i + 1), "wasm")) { return 1; }
            }
        }
        if (@strEq(a, "--target=wasm")) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn arm64_target() i32 {
    let i: i32 = 0;
    while (i < _zag_argc()) {
        let a: []u8 = _zag_arg(i);
        if (@strEq(a, "--target")) {
            if (i + 1 < _zag_argc()) {
                let v: []u8 = _zag_arg(i + 1);
                if (@strEq(v, "arm64") || @strEq(v, "aarch64")) { return 1; }
            }
        }
        if (@strEq(a, "--target=arm64") || @strEq(a, "--target=aarch64")) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn i686_target() i32 {
    let i:i32=0;
    while(i<_zag_argc()) {
        let a:[]u8=_zag_arg(i);
        if (@strEq(a,"--target") && i+1<_zag_argc()) {
            let v:[]u8=_zag_arg(i+1);
            if (@strEq(v,"i686") || @strEq(v,"x86") || @strEq(v,"linux-i686")) { return 1; }
        }
        if (@strEq(a,"--target=i686") || @strEq(a,"--target=x86") || @strEq(a,"--target=linux-i686")) { return 1; }
        i=i+1;
    }
    return 0;
}

// The v2 `@cabi` contract currently has exactly one implemented lowering:
// outbound scalar/pointer imports in the native x86-64 dynamic ELF writer.
// Other target backends may happen to parse an extern declaration, but they do
// not share that ABI contract; reject before they can emit an object/binary
// whose public symbols would be mistaken for a supported v2 C boundary.
fn znc_decls_have_cabi(decls: ArrayList[*Node]) i32 {
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                let ai: i32 = 0;
                while (ai < len[[]u8](f.annots)) {
                    if (@strEq(get[[]u8](f.annots, ai), "@cabi")) { return 1; }
                    ai = ai + 1;
                }
            }
            else => { }
        }
        i = i + 1;
    }
    return 0;
}

fn znc_reject_v2_cabi_non_native(path: []u8) i32 {
    if (@strEq(v2_project_edition(path), "2027") == 0) { return 0; }
    let src: []u8 = _zag_read_file(path);
    if (src.len < 0) { return 0; } // target builder reports an ordinary read error
    let unit: CompilationUnit = parse_compilation_unit_dir(src, dir_of(path));
    if (znc_decls_have_cabi(unit.decls) == 1) {
        _zag_eprintln("znc: v2 @cabi imports are currently supported only for native x86-64 --dynamic output");
        _zag_eprintln("note: no v2 C ABI object, archive, WASM, ARM64, or GPU artifact was emitted");
        return 1;
    }
    return 0;
}

fn build_i686_minimal(path: []u8) i32 {
    let src:[]u8=_zag_read_file(path);
    if (src.len < 0) { _zag_eprintln("znc i686: cannot read source"); return 1; }
    if(has_flag("--link-i686")==1){let linked:[]u8=out_flag();if(linked.len==0){linked=default_out(path);}let inputs:ArrayList[[]u8]=make[[]u8](4);push[[]u8](&inputs,src);let ai:i32=2;while(ai<_zag_argc()){let a:[]u8=_zag_arg(ai);if(@strEq(a,"-o")||@strEq(a,"--target")){ai=ai+2;}else if(a.len>0&&a[0]=='-'){ai=ai+1;}else{let extra:[]u8=_zag_read_file(a);if(extra.len<0){_zag_eprintln(_zag_str_concat("znc i686: cannot read link input: ",a));return 1;}push[[]u8](&inputs,extra);ai=ai+1;}}if(write_i686_linked_objects(linked,inputs)!=0){return 1;}_zag_println(_zag_str_concat("znc: linked ELF32/i386 executable ",linked));return 0;}
    // Target selection must not bypass the language authorities shared by the
    // normal native, ARM64, WASM, and GPU paths.  Keep this before lowering and
    // artifact creation; only the target-specific backend remains isolated.
    if(v2_validate_source(path,src)!=0){return 1;}
    let unit:CompilationUnit=parse_compilation_unit_dir(src,dir_of(path));
    if(unit.profile==ModuleProfile.script) { _zag_eprintln("znc i686: unsupported construct: Zag Script runtime is not implemented"); return 1; }
    let decls:ArrayList[*Node]=unit.decls;
    lo_operators(decls);
    let aerrs:i32=znc_check_arity(decls);
    if(aerrs>0){_zag_println("znc: arity check FAILED");return 1;}
    let derrs:i32=znc_check_dups(decls);
    if(derrs>0){_zag_println("znc: duplicate-definition check FAILED");return 1;}
    if(typed_check_program(decls,path)>0){return 1;}
    let eff:map__StringMap[i32]=analyze(decls);
    let viols:i32=report_violations(decls,eff,src,path);
    if(viols>0){_zag_println("znc: capability check FAILED");return 1;}
    let object_mode:i32=((has_flag("--emit-obj")==1||has_flag("--emit-static")==1) as i32);
    let lower:I386Lower=I386Lower{.ir=make[I32IR](32),.locals=make[I386Local](8),.funcs=make[I386Fn](8),.structs=make[StructDecl](4),.strings=make[[]u8](4),.object_relocs=make[I686CodeReloc](4),.failed=0,.next_label=0,.next_slot=0,.break_label=-1,.continue_label=-1,.current_error_fn=0,.expected_ty="",.current_ret_ty="",.sret_target=-1,.object_mode=object_mode};
    if(lower_i386_i32_program(decls,&lower)!=0) { return 1; }
    let text:ArrayList[u8]=encode_i386_i32(&lower);
    let out:[]u8=out_flag();
    if (out.len==0) { out=default_out(path); }
    if(object_mode==1){let code:I686ObjectCode=i386_object_code(&lower,text);if(has_flag("--emit-obj")==1){if(write_i686_object_code(out,code)!=0){_zag_eprintln("znc i686: failed to write ELF32 object");return 1;}_zag_println(_zag_str_concat("znc: wrote ELF32/i386 object ",out));return 0;}if(write_i686_archive_code(out,code)!=0){_zag_eprintln("znc i686: failed to write static archive");return 1;}_zag_println(_zag_str_concat("znc: wrote ELF32/i386 archive ",out));return 0;}
    if (write_i686_text(out,text)!=0) { _zag_eprintln("znc i686: failed to write ELF32 executable"); return 1; }
    _zag_println(_zag_str_concat("znc: wrote ELF32/i386 i32 binary ",out));
    return 0;
}

fn stem_of(path: []u8) []u8 {
    let slash: i32 = 0 - 1;
    let i: i32 = 0;
    while (i < path.len) {
        if (path[i] == '/') { slash = i; }
        i = i + 1;
    }
    let base: []u8 = path;
    if (slash >= 0) { base = path[slash + 1..]; }
    let dot: i32 = 0 - 1;
    let j: i32 = 0;
    while (j < base.len) {
        if (base[j] == '.') { dot = j; }
        j = j + 1;
    }
    if (dot > 0) { return base[0..dot]; }
    return base;
}

// ── call-arity check ─────────────────────────────────────────────────────────
// Static pass: every call through a PLAIN top-level fn name must pass exactly
// as many arguments as the decl has params. Skips builtins, @-intrinsics,
// runtime externs, method sugar, and names shadowed by locals/params/captures
// (those are fn-values whose arity is not statically known here).

fn znc_arity_exempt(nm: []u8) i32 {
    if (nm.len == 0) { return 1; }
    if (nm[0] == '@') { return 1; }
    if (cg_starts_with(nm, "_zag_") == 1) { return 1; }
    if (cg_starts_with(nm, "__") == 1) { return 1; }
    if (@strEq(nm, "new") || @strEq(nm, "delete")) { return 1; }
    if (@strEq(nm, "print_int") || @strEq(nm, "print_i32") || @strEq(nm, "print_str")) { return 1; }
    if (@strEq(nm, "print_f64") || @strEq(nm, "print_f32") || @strEq(nm, "print_u64") || @strEq(nm, "print_i64")) { return 1; }
    if (@strEq(nm, "zalloc") || @strEq(nm, "zfree")) { return 1; }
    if (@strEq(nm, "sinf") || @strEq(nm, "cosf") || @strEq(nm, "sqrtf")) { return 1; }
    if (@strEq(nm, "sin") || @strEq(nm, "cos") || @strEq(nm, "sqrt")) { return 1; }
    return 0;
}

fn znc_arity_in(names: ArrayList[[]u8], nm: []u8) i32 {
    let i: i32 = 0;
    while (i < len[[]u8](names)) {
        if (@strEq(get[[]u8](names, i), nm)) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn znc_arity_locals(body: ArrayList[*Node], outn: *ArrayList[[]u8]) void {
    let i: i32 = 0;
    while (i < len[*Node](body)) {
        switch (get[*Node](body, i).*) {
            .let_ => |l| { push[[]u8](outn, l.name); }
            .if_ => |x| {
                if (x.has_cap == 1) { push[[]u8](outn, x.cap); }
                znc_arity_locals(x.then_body, outn);
                znc_arity_locals(x.els_body, outn);
            }
            .while_ => |w| {
                if (w.has_cap == 1) { push[[]u8](outn, w.cap); }
                znc_arity_locals(w.body, outn);
            }
            .unsafe_ => |u| { znc_arity_locals(u.body, outn); }
            .switch_ => |sw| {
                let ai: i32 = 0;
                while (ai < len[SwitchArm](sw.arms)) {
                    let arm: SwitchArm = get[SwitchArm](sw.arms, ai);
                    if (arm.has_cap == 1) { push[[]u8](outn, arm.cap); }
                    znc_arity_locals(arm.body, outn);
                    ai = ai + 1;
                }
                if (sw.has_els == 1) { znc_arity_locals(sw.els_body, outn); }
            }
            else => { }
        }
        i = i + 1;
    }
}

fn znc_arity_find(decls: ArrayList[*Node], nm: []u8) i32 {
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                if (@strEq(f.name, nm) && f.is_extern == 0) { return len[Param](f.params); }
            }
            else => { }
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn znc_arity_expr(n: *Node, fname: []u8, locals: ArrayList[[]u8], decls: ArrayList[*Node], errs: *i32) void {
    switch (n.*) {
        .call => |c| {
            switch (c.callee.*) {
                .id => |fnid| {
                    if (znc_arity_exempt(fnid.name) == 0 && znc_arity_in(locals, fnid.name) == 0) {
                        let want: i32 = znc_arity_find(decls, fnid.name);
                        if (want >= 0 && want != len[*Node](c.args)) {
                            _zag_eprintln(_zag_str_concat("znc: error: call to '", _zag_str_concat(fnid.name,
                                _zag_str_concat("' passes ", _zag_str_concat(_zag_i64_to_str(len[*Node](c.args) as i64),
                                _zag_str_concat(" argument(s), expected ", _zag_str_concat(_zag_i64_to_str(want as i64),
                                _zag_str_concat(" (in fn '", _zag_str_concat(fname, "')")))))))));
                            errs.* = errs.* + 1;
                        }
                    }
                }
                .fld => |mf| { znc_arity_expr(mf.base, fname, locals, decls, errs); }
                else => { }
            }
            let i: i32 = 0;
            while (i < len[*Node](c.args)) {
                znc_arity_expr(get[*Node](c.args, i), fname, locals, decls, errs);
                i = i + 1;
            }
        }
        .bin => |b| {
            znc_arity_expr(b.l, fname, locals, decls, errs);
            znc_arity_expr(b.r, fname, locals, decls, errs);
        }
        .un => |u| { znc_arity_expr(u.e, fname, locals, decls, errs); }
        .idx => |ix| {
            znc_arity_expr(ix.base, fname, locals, decls, errs);
            znc_arity_expr(ix.idx, fname, locals, decls, errs);
        }
        .fld => |f| { znc_arity_expr(f.base, fname, locals, decls, errs); }
        .cast_ => |cst| { znc_arity_expr(cst.expr, fname, locals, decls, errs); }
        .slit_ => |sl| {
            let i2: i32 = 0;
            while (i2 < len[FieldInit](sl.fields)) {
                znc_arity_expr(get[FieldInit](sl.fields, i2).val, fname, locals, decls, errs);
                i2 = i2 + 1;
            }
        }
        .slice_ => |sc| {
            znc_arity_expr(sc.base, fname, locals, decls, errs);
            znc_arity_expr(sc.lo, fname, locals, decls, errs);
            if (sc.has_hi == 1) { znc_arity_expr(sc.hi, fname, locals, decls, errs); }
        }
        else => { }
    }
}

fn znc_arity_block(body: ArrayList[*Node], fname: []u8, locals: ArrayList[[]u8], decls: ArrayList[*Node], errs: *i32) void {
    let i: i32 = 0;
    while (i < len[*Node](body)) {
        switch (get[*Node](body, i).*) {
            .let_ => |l| { if (l.has_init == 1) { znc_arity_expr(l.expr, fname, locals, decls, errs); } }
            .assign => |a| {
                znc_arity_expr(a.target, fname, locals, decls, errs);
                znc_arity_expr(a.expr, fname, locals, decls, errs);
            }
            .ret => |r| { if (r.has_expr == 1) { znc_arity_expr(r.expr, fname, locals, decls, errs); } }
            .if_ => |x| {
                znc_arity_expr(x.cond, fname, locals, decls, errs);
                znc_arity_block(x.then_body, fname, locals, decls, errs);
                znc_arity_block(x.els_body, fname, locals, decls, errs);
            }
            .while_ => |w| {
                znc_arity_expr(w.cond, fname, locals, decls, errs);
                znc_arity_block(w.body, fname, locals, decls, errs);
            }
            .unsafe_ => |u| { znc_arity_block(u.body, fname, locals, decls, errs); }
            .switch_ => |sw| {
                znc_arity_expr(sw.subject, fname, locals, decls, errs);
                let ai: i32 = 0;
                while (ai < len[SwitchArm](sw.arms)) {
                    znc_arity_block(get[SwitchArm](sw.arms, ai).body, fname, locals, decls, errs);
                    ai = ai + 1;
                }
                if (sw.has_els == 1) { znc_arity_block(sw.els_body, fname, locals, decls, errs); }
            }
            .estmt => |e| { znc_arity_expr(e.expr, fname, locals, decls, errs); }
            else => { }
        }
        i = i + 1;
    }
}

fn znc_check_arity(decls: ArrayList[*Node]) i32 {
    let errs: i32 = 0;
    let di: i32 = 0;
    while (di < len[*Node](decls)) {
        switch (get[*Node](decls, di).*) {
            .fn_decl => |f| {
                if (f.is_extern == 0 && len[*Node](f.body) > 0 && cg_starts_with(f.name, "__iface_") == 0) {
                    let locals: ArrayList[[]u8] = make[[]u8](8);
                    let pi: i32 = 0;
                    while (pi < len[Param](f.params)) {
                        push[[]u8](&locals, get[Param](f.params, pi).name);
                        pi = pi + 1;
                    }
                    // closure captures are locals too (may hold fn-values)
                    if (f.cap_names.len > 0) {
                        let cns: ArrayList[[]u8] = split_args(f.cap_names);
                        let ci: i32 = 0;
                        while (ci < len[[]u8](cns)) {
                            let cn: []u8 = get[[]u8](cns, ci);
                            if (cn.len > 0 && cn[0] == '*') { push[[]u8](&locals, cn[1..]); }
                            else { push[[]u8](&locals, cn); }
                            ci = ci + 1;
                        }
                    }
                    znc_arity_locals(f.body, &locals);
                    znc_arity_block(f.body, f.name, locals, decls, &errs);
                }
            }
            else => { }
        }
        di = di + 1;
    }
    return errs;
}


// ── duplicate-definition check ───────────────────────────────────────────────
// Two top-level definitions with one name silently shadow each other: calls
// resolve against one decl's signature while codegen may pick the other,
// which has miscompiled in the wild (segfaults, wrong-arity table lookups).
// Functions and types are checked in separate namespaces. Repeated extern
// declarations of the same name are tolerated (common across import graphs),
// as are body-less forward declarations (`fn foo() T;`) alongside one body.

fn znc_dup_report(kind: []u8, nm: []u8) void {
    _zag_eprintln(_zag_str_concat("znc: error: duplicate ", _zag_str_concat(kind,
        _zag_str_concat(" definition '", _zag_str_concat(nm, "'")))));
}

fn znc_check_dups(decls: ArrayList[*Node]) i32 {
    let fn_names: ArrayList[[]u8] = make[[]u8](64);
    let fn_kind: ArrayList[i32] = make[i32](64);   // 0=extern, 1=forward decl, 2=definition
    let ty_names: ArrayList[[]u8] = make[[]u8](64);
    let errs: i32 = 0;
    let di: i32 = 0;
    while (di < len[*Node](decls)) {
        switch (get[*Node](decls, di).*) {
            .fn_decl => |f| {
                let kind: i32 = 2;
                if (f.is_extern == 1) { kind = 0; }
                else if (len[*Node](f.body) == 0) { kind = 1; }
                let j: i32 = 0;
                let hit: i32 = 0 - 1;
                while (j < len[[]u8](fn_names)) {
                    if (@strEq(get[[]u8](fn_names, j), f.name)) { hit = j; }
                    j = j + 1;
                }
                if (hit >= 0) {
                    let prev: i32 = get[i32](fn_kind, hit);
                    let bad: i32 = 0;
                    if (prev == 0 && kind != 0) { bad = 1; }
                    if (prev != 0 && kind == 0) { bad = 1; }
                    if (prev == 2 && kind == 2) { bad = 1; }
                    if (bad == 1) {
                        znc_dup_report("fn", f.name);
                        errs = errs + 1;
                    } else if (kind > prev) {
                        set[i32](&fn_kind, hit, kind);
                    }
                } else {
                    push[[]u8](&fn_names, f.name);
                    push[i32](&fn_kind, kind);
                }
            }
            .struct_ => |s| {
                if (znc_arity_in(ty_names, s.name) == 1) {
                    znc_dup_report("type", s.name);
                    errs = errs + 1;
                } else {
                    push[[]u8](&ty_names, s.name);
                }
            }
            .enum_ => |e| {
                if (znc_arity_in(ty_names, e.name) == 1) {
                    znc_dup_report("type", e.name);
                    errs = errs + 1;
                } else {
                    push[[]u8](&ty_names, e.name);
                }
            }
            .union_ => |u| {
                if (znc_arity_in(ty_names, u.name) == 1) {
                    znc_dup_report("type", u.name);
                    errs = errs + 1;
                } else {
                    push[[]u8](&ty_names, u.name);
                }
            }
            else => { }
        }
        di = di + 1;
    }
    return errs;
}

fn znc_check_src(path: []u8, src: []u8) i32 {
    if (v2_validate_source(path, src) != 0) { return 1; }
    let unit: CompilationUnit = parse_compilation_unit_dir(src, dir_of(path));
    if (znc_validate_script_defaults(path, unit) != 0) { return 1; }
    if (znc_configure_script_unit(&unit, path) != 0) { return 1; }
    if (znc_validate_script_capabilities(path, unit) != 0) { return 1; }
    let decls: ArrayList[*Node] = unit.decls;
    lo_operators(decls);
    let aerrs: i32 = znc_check_arity(decls);
    if (aerrs > 0) {
        _zag_println("znc: arity check FAILED");
        return 1;
    }
    let derrs: i32 = znc_check_dups(decls);
    if (derrs > 0) {
        _zag_println("znc: duplicate-definition check FAILED");
        return 1;
    }
    if (typed_check_program(decls, path) > 0) { return 1; }
    let eff: map__StringMap[i32] = analyze(decls);
    let viols: i32 = report_violations(decls, eff, src, path);
    if (viols > 0) {
        _zag_println("znc: capability check FAILED");
        return 1;
    }
    if (run_analyzer(decls, path) != 0) { return 1; }
    let published:i32=znc_publish_semantics(path,src,unit,decls,eff);
    znc_maybe_regular_advisory(path,unit,published);
    return 0;
}

fn build_gpu(path: []u8, target: []u8) i32 {
    let src: []u8 = _zag_read_file(path);
    if (src.len < 0) { _zag_print("znc: cannot read "); _zag_println(path); return 1; }
    if (znc_check_src(path, src) != 0) { return 1; }
    let mbuf: ArrayList[u8] = emit_mlir_dir(src, dir_of(path), target);
    let mpath: []u8 = _zag_str_concat(stem_of(path), ".mlir");
    if (_zag_write_file(mpath, mbuf.data[0..mbuf.len]) != 0) {
        _zag_println("znc: failed to write MLIR");
        return 1;
    }
    _zag_print("znc: [gpu-");
    _zag_print(target);
    _zag_print("] wrote MLIR ");
    _zag_println(mpath);
    return 0;
}

fn build_gfx1010(path: []u8) i32 {
    let src: []u8 = _zag_read_file(path);
    if (src.len < 0) { _zag_print("znc: cannot read "); _zag_println(path); return 1; }
    if (znc_check_src(path, src) != 0) { return 1; }
    let errors: i32 = 0;
    let bundle: ArrayList[u8] = emit_gfx1010_bundle(src, dir_of(path), &errors);
    if (errors != 0) { return 1; }
    let out: []u8 = out_flag();
    if (out.len == 0) { out = _zag_str_concat(stem_of(path), ".zgk"); }
    if (_zag_write_file(out, bundle.data[0..bundle.len]) != 0) {
        _zag_println("znc: failed to write gfx1010 kernel bundle"); return 1;
    }
    _zag_print("znc: [amdgpu-gfx1010] wrote validated kernel bundle ");
    _zag_println(out);
    return 0;
}

fn build_compat(path: []u8, target: []u8) i32 {
    let src: []u8 = _zag_read_file(path);
    if (src.len < 0) { _zag_print("znc: cannot read "); _zag_println(path); return 1; }
    if (znc_check_src(path, src) != 0) { return 1; }
    let errors: i32 = 0;
    let bin: ArrayList[u8] = make[u8](0);
    if (compat_target_uses_spirv(target)) {
        bin = emit_spirv_dir(src, dir_of(path), &errors);
    } else if (compat_target_uses_spirv_opencl(target)) {
        bin = emit_spirv_opencl_dir(src, dir_of(path), &errors);
    } else if (compat_target_uses_msl(target)) {
        bin = emit_msl_dir(src, dir_of(path), &errors);
    } else if (compat_target_uses_glsl(target)) {
        bin = emit_glsl_dir(src, dir_of(path), &errors);
    } else if (compat_target_uses_ptx(target)) {
        bin = emit_ptx_dir(src, dir_of(path), &errors);
    } else {
        _zag_eprintln(_zag_str_concat("znc: compat target not yet implemented: ", target));
        return 1;
    }
    if (errors != 0) { return 1; }
    let out: []u8 = out_flag();
    if (out.len == 0) {
        if (@strEq(target, "vulkan-compat")) { out = _zag_str_concat(stem_of(path), ".spv"); }
        else if (@strEq(target, "opencl-compat")) { out = _zag_str_concat(stem_of(path), ".spv"); }
        else if (@strEq(target, "metal-compat")) { out = _zag_str_concat(stem_of(path), ".metal"); }
        else if (@strEq(target, "opengl-compat")) { out = _zag_str_concat(stem_of(path), ".glsl"); }
        else if (@strEq(target, "cuda-compat")) { out = _zag_str_concat(stem_of(path), ".ptx"); }
        else { out = _zag_str_concat(stem_of(path), ".compat"); }
    }
    if (_zag_write_file(out, bin.data[0..bin.len]) != 0) {
        _zag_println("znc: failed to write compat kernel"); return 1;
    }
    _zag_print("znc: [");
    _zag_print(target);
    _zag_print("] wrote ");
    if (compat_target_uses_spirv(target)) { _zag_print("SPIR-V binary "); }
    else if (compat_target_uses_spirv_opencl(target)) { _zag_print("SPIR-V binary (OpenCL) "); }
    else if (compat_target_uses_msl(target)) { _zag_print("Metal source "); }
    else if (compat_target_uses_glsl(target)) { _zag_print("GLSL source "); }
    else if (compat_target_uses_ptx(target)) { _zag_print("PTX source "); }
    else { _zag_print("compat output "); }
    _zag_println(out);
    return 0;
}

fn build_arm64(path: []u8) i32 {
    let src: []u8 = _zag_read_file(path);
    if (src.len < 0) { _zag_print("znc: cannot read "); _zag_println(path); return 1; }
    if (znc_check_src(path, src) != 0) { return 1; }

    let decls: ArrayList[*Node] = parse_program_dir(src, dir_of(path));
    lo_operators(decls);

    let link_libs: ArrayList[[]u8] = make[[]u8](4);
    let code_decls: ArrayList[*Node] = znc_collect_links(decls, &link_libs);

    let nerr: i32 = 0;
    let data: ArrayList[u8] = make[u8](16);
    let prog: ArrayList[AInstr] = aload_program(code_decls, &nerr, &data);
    if (nerr > 0) {
        _zag_println("znc: build aborted — unsupported constructs (see messages above)");
        return 1;
    }
    let code: ArrayList[u8] = aencode(prog);

    let out: []u8 = out_flag();
    if (out.len == 0) { out = default_out(path); }

    let rc: i32 = write_elf_arm64_data(out, code, 0, data);
    if (rc != 0) { _zag_println("znc: failed to write executable"); return 1; }
    _zag_print("znc: [arm64] wrote native binary ");
    _zag_print(out);
    _zag_print(" (");
    _zag_print(_zag_i64_to_str(code.len as i64));
    _zag_print(" bytes text, ");
    _zag_print(_zag_i64_to_str(data.len as i64));
    _zag_println(" bytes data, 0 external tools)");

    if (has_flag("--run") == 1) {
        let runcmd: []u8 = _zag_str_concat("qemu-aarch64-static ", out);
        let ec: i32 = _zag_exec_cmd(runcmd);
        _zag_print("znc: qemu exited ");
        _zag_println(_zag_i64_to_str(ec as i64));
    }
    return 0;
}

fn build_wasm(path: []u8) i32 {
    let src: []u8 = _zag_read_file(path);
    if (src.len < 0) { _zag_print("znc: cannot read "); _zag_println(path); return 1; }
    if (znc_check_src(path, src) != 0) { return 1; }
    let wbuf: ArrayList[u8] = emit_wasm_dir(src, dir_of(path));
    let out: []u8 = out_flag();
    if (out.len == 0) { out = _zag_str_concat(stem_of(path), ".wasm"); }
    if (_zag_write_file(out, wbuf.data[0..wbuf.len]) != 0) {
        _zag_println("znc: failed to write WASM");
        return 1;
    }
    _zag_print("znc: [wasm] wrote WASM ");
    _zag_println(out);
    if (has_flag("--run") == 1) {
        _zag_eprintln("E0800: WASM execution requires a pure-Zag runtime, which is not implemented");
        _zag_eprintln("note: the .wasm artifact was emitted, but no external runtime was invoked");
        return 1;
    }
    return 0;
}

// ── static analyzer (analyze.zag) driver glue ────────────────────────────────
// The leak + efficiency analyzer runs by default on every build/check.
//   --no-analyze       turn the analyzer off entirely
//   --analyze-strict   treat findings as errors (fail the build)
//   --analyze-pedantic also emit strength-reduction hints (E0103)
fn analysis_enabled() i32 {
    if (has_flag("--no-analyze") == 1) { return 0; }
    return 1;
}
fn analysis_pedantic() i32 { return has_flag("--analyze-pedantic"); }

// Run the analyzer (if enabled) and print a one-line summary. Returns 1 only
// when findings exist AND --analyze-strict was passed (so the caller aborts).
fn run_analyzer(decls: ArrayList[*Node], path: []u8) i32 {
    if (analysis_enabled() == 0) { return 0; }
    let issues: i32 = run_analysis(decls, path, analysis_pedantic());
    if (issues > 0) {
        let n: []u8 = _zag_i64_to_str(issues as i64);
        if (has_flag("--analyze-strict") == 1) {
            _zag_eprintln(_zag_str_concat("znc: analyzer found ", _zag_str_concat(n, " issue(s) — build FAILED (--analyze-strict)")));
            return 1;
        }
        _zag_eprintln(_zag_str_concat("znc: analyzer found ", _zag_str_concat(n, " issue(s) (warnings above; use --analyze-strict to fail the build, --no-analyze to silence)")));
    }
    return 0;
}

// Is `name` present anywhere in argv?
fn has_flag(name: []u8) i32 {
    let i: i32 = 0;
    while (i < _zag_argc()) {
        if (@strEq(_zag_arg(i), name)) { return 1; }
        i = i + 1;
    }
    return 0;
}

// First non-flag argument (the source path). Skips the optional `build`
// subcommand word so both `znc foo.zag` and `znc build --hot foo.zag` work.
fn src_arg() []u8 {
    let i: i32 = 1;
    while (i < _zag_argc()) {
        let a: []u8 = _zag_arg(i);
        if (@strEq(a, "-o") || @strEq(a, "-l") || @strEq(a, "-L") ||
            @strEq(a, "--cpu") || @strEq(a, "--target") || @strEq(a, "--needed") ||
            @strEq(a, "--format") || @strEq(a, "--output") ||
            @strEq(a, "--analyze-str-consumer")) {
            i = i + 2;
            continue;
        }
        if (a.len > 0) {
            if (a[0] != '-' && @strEq(a, "build") == 0 &&
                @strEq(a, "script") == 0 && @strEq(a, "explain") == 0 &&
                @strEq(a, "harden") == 0 && @strEq(a, "check") == 0) { return a; }
        }
        i = i + 1;
    }
    return "";
}

// True only when the first non-comment token is exactly `script;`.
fn source_starts_script(src: []u8) i32 {
    let i: i32 = 0;
    let scanning: i32 = 1;
    while (scanning == 1 && i < src.len) {
        while (i < src.len && (src[i] == ' ' || src[i] == '\n' || src[i] == '\r' || src[i] == '\t')) { i = i + 1; }
        if (i + 1 < src.len && src[i] == '/' && src[i + 1] == '/') {
            i = i + 2; while (i < src.len && src[i] != '\n') { i = i + 1; }
        } else if (i + 1 < src.len && src[i] == '/' && src[i + 1] == '*') {
            i = i + 2;
            while (i + 1 < src.len && !(src[i] == '*' && src[i + 1] == '/')) { i = i + 1; }
            if (i + 1 < src.len) { i = i + 2; }
        } else { scanning = 0; }
    }
    if (i + 6 >= src.len) { return 0; }
    if (src[i] == 's' && src[i + 1] == 'c' && src[i + 2] == 'r' &&
        src[i + 3] == 'i' && src[i + 4] == 'p' && src[i + 5] == 't' && src[i + 6] == ';') { return 1; }
    return 0;
}

fn source_path_is_zs(path:[]u8)i32 {
    if(path.len<3){return 0;}
    return @strEq(path[path.len-3..path.len],".zs") as i32;
}

fn contains_text(text:[]u8,needle:[]u8)i32 {
    if(needle.len==0){return 1;}
    let i:i32=0;
    while(i+needle.len<=text.len){
        if(@strEq(text[i..i+needle.len],needle)){return 1;}
        i=i+1;
    }
    return 0;
}

// `.zs` is an optional activation convenience, not a separate language or
// compiler. It selects the same ModuleProfile.script path as `script;` and
// `znc script`, and never rewrites the source file.
fn znc_activate_script_source(path:[]u8,src:[]u8,force:i32)[]u8 {
    if((force==1||source_path_is_zs(path)==1)&&source_starts_script(src)==0){
        return _zag_str_concat("script;\n",src);
    }
    return src;
}

fn flag_value(name: []u8) []u8 {
    let i: i32 = 1;
    while (i < _zag_argc()) {
        if (@strEq(_zag_arg(i), name) && i + 1 < _zag_argc()) { return _zag_arg(i + 1); }
        i = i + 1;
    }
    return "";
}

fn cpu_flag_value() []u8 {
    let paired: []u8 = flag_value("--cpu");
    if (paired.len > 0) { return paired; }
    let i: i32 = 1;
    while (i < _zag_argc()) {
        let a: []u8 = _zag_arg(i);
        if (a.len > 6 && a[0] == '-' && a[1] == '-' && a[2] == 'c' &&
            a[3] == 'p' && a[4] == 'u' && a[5] == '=') { return a[6..]; }
        i = i + 1;
    }
    return "generic";
}

fn cpu_flag_explicit() i32 {
    if (flag_value("--cpu").len > 0) { return 1; }
    let i: i32 = 1;
    while (i < _zag_argc()) {
        let a: []u8 = _zag_arg(i);
        if (a.len > 6 && starts_with(a, "--cpu=")) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn znc_script_explicit_choices() PlannerChoices {
    let input:PlannerChoices=planner_empty_choices();
    let allocator:[]u8=flag_value("--script-allocator");
    let device:[]u8=flag_value("--device");
    let layout:[]u8=flag_value("--layout");
    if(allocator.len>0){input.allocator=allocator;input.allocator_explicit=1;}
    if(device.len>0){input.device=device;input.device_explicit=1;}
    if(layout.len>0){input.layout=layout;input.layout_explicit=1;}
    if(cpu_flag_explicit()==1){input.cpu=cpu_flag_value();input.cpu_explicit=1;}
    return input;
}

// Script may inherit a project CPU default. A command-line CPU request is an
// explicit choice and always wins. Regular Zag never inherits Script defaults.
fn znc_effective_cpu(path: []u8, script_profile: i32) []u8 {
    if (cpu_flag_explicit() == 1 || script_profile == 0) { return cpu_flag_value(); }
    return znc_project_config(znc_project_root(dir_of(path)), 0).default_cpu;
}

fn validate_x86_cpu_flag() i32 {
    let p: X86CpuProfile = parse_x86_cpu_profile(cpu_flag_value());
    if (p.valid == 0) {
        _zag_eprintln(_zag_str_concat("znc: ", p.diagnostic));
        return 1;
    }
    return 0;
}

// Target validation must fail closed: an unknown target must never silently
// receive the host ELF/ABI.  i686 aliases are routed to the dedicated ELF32
// driver before this validator is reached, but remain accepted here so this
// shared validation helper does not publish a stale "not implemented" claim.
fn validate_x86_target_flag() i32 {
    let target: []u8 = flag_value("--target");
    let i: i32 = 1;
    let inline_target: []u8 = "";
    while (i < _zag_argc()) {
        let a: []u8 = _zag_arg(i);
        if (starts_with(a, "--target=") == 1) { inline_target = a[9..]; }
        i = i + 1;
    }
    let selected: []u8 = target;
    if (inline_target.len > 0) { selected = inline_target; }
    if (selected.len == 0 || @strEq(selected, "x86_64") ||
        @strEq(selected, "x86-64") || @strEq(selected, "linux-x86_64")) { return 0; }
    if (@strEq(selected, "i686") || @strEq(selected, "x86") ||
        @strEq(selected, "linux-i686")) { return 0; }
    _zag_eprintln(_zag_str_concat("znc: unsupported target: ", selected));
    return 1;
}

// The value following `-o`, else "".
fn out_flag() []u8 {
    let i: i32 = 1;
    while (i < _zag_argc()) {
        if (@strEq(_zag_arg(i), "-o")) {
            if (i + 1 < _zag_argc()) { return _zag_arg(i + 1); }
        }
        i = i + 1;
    }
    return "";
}

// Default output path: strip a trailing extension ("foo.zag" -> "foo"),
// else append ".out".
fn default_out(path: []u8) []u8 {
    let dot: i32 = 0 - 1;
    let i: i32 = 0;
    while (i < path.len) {
        if (path[i] == '.') { dot = i; }
        i = i + 1;
    }
    if (dot > 0) { return path[0..dot]; }
    return _zag_str_concat(path, ".out");
}

fn znc_fmt(fpath: []u8, in_place: i32) i32 {
    if (fpath.len == 0) { _zag_println("znc fmt: no source file"); return 1; }
    let src: []u8 = _zag_read_file(fpath);
    if (src.len < 0) {
        _zag_print("znc fmt: cannot read ");
        _zag_println(fpath);
        return 1;
    }
    // The formatter consumes the canonical grammar. Python-shaped Script is
    // normalized through the same frontend used by compilation; formatting a
    // `.zs` file therefore produces valid explicit Zag without introducing a
    // second formatter or parser.
    let format_src: []u8 = script_syntax_normalize(znc_activate_script_source(fpath, src, 0));
    if(source_path_is_zs(fpath)==1||@strEq(format_src,src)==0){
        if(in_place==1){
            let wrc:i32=_zag_write_file(fpath,format_src);
            if(wrc!=0){_zag_println("znc fmt: write failed");return 1;}
            _zag_print("znc fmt: normalized ");_zag_println(fpath);
        }else{_zag_print(format_src);}
        return 0;
    }
    let formatted: ArrayList[u8] = fmt_program(format_src);
    if (in_place == 1) {
        let wrc: i32 = _zag_write_file(fpath, formatted.data[0..formatted.len]);
        if (wrc != 0) { _zag_println("znc fmt: write failed"); return 1; }
        _zag_print("znc fmt: formatted ");
        _zag_println(fpath);
    } else {
        _zag_print(formatted.data[0..formatted.len]);
    }
    return 0;
}

fn znc_emit_total_cex(decls: ArrayList[*Node], eff: map__StringMap[i32]) void {
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                if (f.is_extern == 0 && has_annot(f.annots, "@total") == 1 && fn_total_safe(f, eff) == 0) {
                    let tout: SmtOutcome = smt_prove_fn(f);
                    if (tout.rc == 1 && tout.cex.len > 0) { _zag_println(tout.cex); }
                }
            }
            else => { }
        }
        i = i + 1;
    }
}

// These are exact compiler-bound Script-context value producers. Prefix
// matching is forbidden here: an ordinary user function such as
// `script_list_sink` must be analyzed from its body, not granted runtime
// authority because of its spelling.
fn znc_script_alloc_call(name:[]u8)i32{
    if(@strEq(name,"_zag_script_alloc")||@strEq(name,"_zag_script_new")||
       @strEq(name,"script_input")||@strEq(name,"script_read_file")||
       @strEq(name,"script_string_concat")||@strEq(name,"script_string_builder_new")||
       @strEq(name,"process_run_bounded_script")||@strEq(name,"script_args")||
       @strEq(name,"script_path_join")||@strEq(name,"script_path_basename")||
       @strEq(name,"script_path_dirname")||@strEq(name,"script_path_extension")||
       @strEq(name,"script_list_new")||@strEq(name,"script_list1")||
       @strEq(name,"script_list2")||@strEq(name,"script_list3")||
       @strEq(name,"script_list4")||@strEq(name,"script_list_append")||
       @strEq(name,"script_list_len")||@strEq(name,"script_list_get")||
       @strEq(name,"script_list_failed")){return 1;}
    return 0;
}
struct ZScriptLifeSummary{name:[]u8,returns_script:i32,escapes_script:i32}
fn znc_script_summary(sums:ArrayList[ZScriptLifeSummary],name:[]u8)ZScriptLifeSummary{let i:i32=0;while(i<sums.len){if(@strEq(sums.data[i].name,name)){return sums.data[i];}i=i+1;}return ZScriptLifeSummary{.name="",.returns_script=0,.escapes_script=1};}
fn znc_script_known_fn(decls:ArrayList[*Node],name:[]u8)i32{let i:i32=0;while(i<decls.len){switch(decls.data[i].*){.fn_decl=>|f|{if(@strEq(f.name,name)&&f.is_extern==0){return 1;}}else=>{}}i=i+1;}return 0;}
fn znc_script_any_decl(decls:ArrayList[*Node],name:[]u8)i32{let i:i32=0;while(i<decls.len){switch(decls.data[i].*){.fn_decl=>|f|{if(@strEq(f.name,name)){return 1;}}else=>{}}i=i+1;}return 0;}
fn znc_script_fn_origin(decls:ArrayList[*Node],name:[]u8,origin:[]u8)i32{
    let i:i32=0;
    while(i<decls.len){
        switch(decls.data[i].*){
            .fn_decl=>|f|{
                if(f.is_extern==0&&@strEq(f.name,name)&&@strEq(f.origin,origin)){return 1;}
            }
            else=>{}
        }
        i=i+1;
    }
    return 0;
}
// Standard Script helpers are trusted only when the resolver says that the
// declaration came from the compiler-owned std module. A project file with
// the same basename or function name receives no such authority.
fn znc_script_std_fn(decls:ArrayList[*Node],name:[]u8,module:[]u8)i32{
    let expected:[]u8=canon_path(resolve_import_path(module,"."));
    return znc_script_fn_origin(decls,name,expected);
}
fn znc_script_std_safe_consumer(decls:ArrayList[*Node],name:[]u8)i32{
    if(@strEq(name,"process_result_status")||@strEq(name,"process_result_state")||
       @strEq(name,"process_result_output")||@strEq(name,"process_result_new")||
       @strEq(name,"process_run_bounded")||@strEq(name,"process_run_bounded_script")){
        return znc_script_std_fn(decls,name,"std:process");
    }
    if(@strEq(name,"string_builder_from_buffer")||@strEq(name,"script_string_builder_new")||
       @strEq(name,"string_builder_append")||@strEq(name,"string_builder_len")||
       @strEq(name,"string_builder_failed")||@strEq(name,"string_builder_output")){
        return znc_script_std_fn(decls,name,"std:script_string_builder");
    }
    if(@strEq(name,"script_list_new")||@strEq(name,"script_list1")||
       @strEq(name,"script_list2")||@strEq(name,"script_list3")||
       @strEq(name,"script_list4")||@strEq(name,"script_list_append")||
       @strEq(name,"script_list_len")||@strEq(name,"script_list_get")||
       @strEq(name,"script_list_failed")||@strEq(name,"script_args")){
        return znc_script_std_fn(decls,name,"std:script_list");
    }
    if(@strEq(name,"script_read_file")){return znc_script_std_fn(decls,name,"std:script_io");}
    if(@strEq(name,"script_input")){return znc_script_std_fn(decls,name,"std:script_input");}
    if(@strEq(name,"script_string_concat")){return znc_script_std_fn(decls,name,"std:script_string");}
    if(@strEq(name,"script_path_join")||@strEq(name,"script_path_basename")||
       @strEq(name,"script_path_dirname")||@strEq(name,"script_path_extension")){
        return znc_script_std_fn(decls,name,"std:script_path");
    }
    return 0;
}
fn znc_script_runtime_safe_consumer(decls:ArrayList[*Node],name:[]u8)i32{
    if(@strEq(name,"@strEq")){return 1;}
    // Root helper bodies are intentionally not rewritten with the hidden
    // ScriptContext, but these context-free output conveniences retain their
    // ordinary prelude meaning. Any source declaration, including an extern,
    // wins and must be analyzed or rejected instead of receiving this trust.
    if(@strEq(name,"print")||@strEq(name,"println")||@strEq(name,"write_file")){
        return (znc_script_any_decl(decls,name)==0) as i32;
    }
    // These spellings are compiler-reserved synchronous output bridges. The
    // shipped `std:rt` necessarily declares them as externs, including in a
    // relocatable install; that declaration describes the bridge rather than
    // a user helper which could retain the argument. They may observe a
    // Script-context slice for the duration of the call but cannot retain it.
    if(@strEq(name,"_zag_print")||@strEq(name,"_zag_println")||
       @strEq(name,"_zag_eprintln")){return 1;}
    if(@strEq(name,"_zag_write_file")||@strEq(name,"_zag_script_alloc")||
       @strEq(name,"_zag_script_new")||@strEq(name,"_zag_script_alloc_used")){
        // A source definition wins over other backend spellings. This makes
        // direct runtime-name shadowing fail closed and lets its computed
        // summary decide whether a Script-context argument escapes.
        return (znc_script_any_decl(decls,name)==0) as i32;
    }
    return 0;
}
fn znc_script_safe_consumer(decls:ArrayList[*Node],name:[]u8)i32{
    if(znc_script_runtime_safe_consumer(decls,name)==1){return 1;}
    return znc_script_std_safe_consumer(decls,name);
}
// Script-context payloads are either bump-arena addresses or bounded-heap
// addresses after a compiler-owned ownership header. Neither exposed pointer
// is an ordinary native allocator pointer, so delete/_zag_free must never
// receive one. Generated Script shutdown owns policy-specific reclamation.
fn znc_script_foreign_free(name:[]u8)i32{return (@strEq(name,"delete")||@strEq(name,"_zag_free")) as i32;}
fn znc_script_env_has(env:ArrayList[ZTBind],name:[]u8)i32{let i:i32=0;while(i<env.len){if(@strEq(env.data[i].name,name)){return 1;}i=i+1;}return 0;}
fn znc_script_env_tainted(env:ArrayList[ZTBind],name:[]u8)i32{let i:i32=0;while(i<env.len){if(@strEq(env.data[i].name,name)&&@strEq(env.data[i].ty,"script-lifetime")){return 1;}i=i+1;}return 0;}
fn znc_script_env_mark(env:*ArrayList[ZTBind],name:[]u8)void{let i:i32=0;while(i<env.*.len){if(@strEq(env.*.data[i].name,name)){env.*.data[i].ty="script-lifetime";return;}i=i+1;}push[ZTBind](env,ZTBind{.name=name,.ty="script-lifetime"});}
fn znc_script_arm_value_tainted(body:ArrayList[*Node],env:ArrayList[ZTBind],sums:ArrayList[ZScriptLifeSummary])i32{if(body.len==0){return 0;}let last:*Node=body.data[body.len-1];switch(last.*){.estmt=>|x|{return znc_script_tainted(x.expr,env,sums);}.ret=>|x|{if(x.has_expr==1){return znc_script_tainted(x.expr,env,sums);}}else=>{}}return 0;}
fn znc_script_tainted(n:*Node,env:ArrayList[ZTBind],sums:ArrayList[ZScriptLifeSummary])i32{switch(n.*){.id=>|x|{return znc_script_env_tainted(env,x.name);}.call=>|x|{let name:[]u8=callee_name(x.callee);if(znc_script_alloc_call(name)==1){return 1;}let s:ZScriptLifeSummary=znc_script_summary(sums,name);if(s.name.len>0&&s.returns_script==1){let i:i32=0;while(i<x.args.len){if(znc_script_tainted(x.args.data[i],env,sums)==1){return 1;}i=i+1;}return 1;}}.bin=>|x|{return znc_script_tainted(x.l,env,sums)|znc_script_tainted(x.r,env,sums);}.un=>|x|{return znc_script_tainted(x.e,env,sums);}.fld=>|x|{return znc_script_tainted(x.base,env,sums);}.idx=>|x|{return znc_script_tainted(x.base,env,sums);}.cast_=>|x|{return znc_script_tainted(x.expr,env,sums);}.slice_=>|x|{return znc_script_tainted(x.base,env,sums);}.slit_=>|x|{let i:i32=0;while(i<len[FieldInit](x.fields)){if(znc_script_tainted(get[FieldInit](x.fields,i).val,env,sums)==1){return 1;}i=i+1;}}.switch_=>|x|{let i:i32=0;while(i<len[SwitchArm](x.arms)){if(znc_script_arm_value_tainted(get[SwitchArm](x.arms,i).body,env,sums)==1){return 1;}i=i+1;}if(x.has_els==1){return znc_script_arm_value_tainted(x.els_body,env,sums);}}else=>{}}return 0;}
fn znc_script_escape_body(body:ArrayList[*Node],env:ArrayList[ZTBind],decls:ArrayList[*Node],sums:ArrayList[ZScriptLifeSummary],report:i32)i32{let failures:i32=0;let i:i32=0;while(i<body.len){switch(body.data[i].*){.let_=>|x|{if(x.has_init==1){failures=failures+znc_script_call_escape(x.expr,env,decls,sums,report);}}.ret=>|x|{if(x.has_expr==1){failures=failures+znc_script_call_escape(x.expr,env,decls,sums,report);}}.estmt=>|x|{failures=failures+znc_script_call_escape(x.expr,env,decls,sums,report);}.assign=>|x|{failures=failures+znc_script_call_escape(x.target,env,decls,sums,report)+znc_script_call_escape(x.expr,env,decls,sums,report);}.if_=>|x|{failures=failures+znc_script_call_escape(x.cond,env,decls,sums,report)+znc_script_escape_body(x.then_body,env,decls,sums,report)+znc_script_escape_body(x.els_body,env,decls,sums,report);}.while_=>|x|{failures=failures+znc_script_call_escape(x.cond,env,decls,sums,report)+znc_script_escape_body(x.body,env,decls,sums,report);}.unsafe_=>|x|{failures=failures+znc_script_escape_body(x.body,env,decls,sums,report);}.switch_=>|x|{failures=failures+znc_script_call_escape(x.subject,env,decls,sums,report);let ai:i32=0;while(ai<len[SwitchArm](x.arms)){failures=failures+znc_script_escape_body(get[SwitchArm](x.arms,ai).body,env,decls,sums,report);ai=ai+1;}failures=failures+znc_script_escape_body(x.els_body,env,decls,sums,report);}else=>{}}i=i+1;}return failures;}
fn znc_script_call_escape(n:*Node,env:ArrayList[ZTBind],decls:ArrayList[*Node],sums:ArrayList[ZScriptLifeSummary],report:i32)i32{let failures:i32=0;switch(n.*){.call=>|c|{let name:[]u8=callee_name(c.callee);let may_escape:i32=0;if(znc_script_safe_consumer(decls,name)==0){if(znc_script_known_fn(decls,name)==0){may_escape=1;}else if(znc_script_summary(sums,name).escapes_script==1){may_escape=1;}}let j:i32=0;while(j<c.args.len){if(znc_script_tainted(c.args.data[j],env,sums)==1){if(znc_script_foreign_free(name)==1){if(report==1){_zag_eprintln(_zag_str_concat("znc script lifetime: `",_zag_str_concat(name,"` cannot deallocate a Script-context value; it is reclaimed only at generated Script shutdown")));}failures=failures+1;}else if(may_escape==1){if(report==1){_zag_eprintln(_zag_str_concat("znc script lifetime: Script-context value may escape through helper, extern, or unknown call to `",_zag_str_concat(name,"`")));}failures=failures+1;}}failures=failures+znc_script_call_escape(c.args.data[j],env,decls,sums,report);j=j+1;}}.bin=>|x|{failures=failures+znc_script_call_escape(x.l,env,decls,sums,report)+znc_script_call_escape(x.r,env,decls,sums,report);}.un=>|x|{failures=failures+znc_script_call_escape(x.e,env,decls,sums,report);}.fld=>|x|{failures=failures+znc_script_call_escape(x.base,env,decls,sums,report);}.idx=>|x|{failures=failures+znc_script_call_escape(x.base,env,decls,sums,report)+znc_script_call_escape(x.idx,env,decls,sums,report);}.cast_=>|x|{failures=failures+znc_script_call_escape(x.expr,env,decls,sums,report);}.slice_=>|x|{failures=failures+znc_script_call_escape(x.base,env,decls,sums,report);}.slit_=>|x|{let i:i32=0;while(i<len[FieldInit](x.fields)){failures=failures+znc_script_call_escape(get[FieldInit](x.fields,i).val,env,decls,sums,report);i=i+1;}}.switch_=>|x|{failures=failures+znc_script_call_escape(x.subject,env,decls,sums,report);let ai:i32=0;while(ai<len[SwitchArm](x.arms)){failures=failures+znc_script_escape_body(get[SwitchArm](x.arms,ai).body,env,decls,sums,report);ai=ai+1;}failures=failures+znc_script_escape_body(x.els_body,env,decls,sums,report);}else=>{}}return failures;}
fn znc_script_lifetime_body(body:ArrayList[*Node],env:*ArrayList[ZTBind],decls:ArrayList[*Node],sums:ArrayList[ZScriptLifeSummary],report:i32,returns:*i32)i32{let failures:i32=0;let i:i32=0;while(i<body.len){let n:*Node=body.data[i];switch(n.*){.let_=>|x|{if(znc_script_env_has(env.*,x.name)==0){push[ZTBind](env,ZTBind{.name=x.name,.ty=""});}if(x.has_init==1){failures=failures+znc_script_call_escape(x.expr,env.*,decls,sums,report);if(znc_script_tainted(x.expr,env.*,sums)==1){znc_script_env_mark(env,x.name);}}}.ret=>|x|{if(x.has_expr==1){failures=failures+znc_script_call_escape(x.expr,env.*,decls,sums,report);if(znc_script_tainted(x.expr,env.*,sums)==1){returns.*=1;}}}.assign=>|x|{failures=failures+znc_script_call_escape(x.expr,env.*,decls,sums,report);if(znc_script_tainted(x.expr,env.*,sums)==1){let local:i32=0;let local_name:[]u8="";switch(x.target.*){.id=>|id|{local=znc_script_env_has(env.*,id.name);local_name=id.name;}else=>{}}if(local==0){if(report==1){_zag_eprintln("znc script lifetime: Script-context value stored through a field, pointer, or nonlocal target");}failures=failures+1;}else{znc_script_env_mark(env,local_name);}}}.estmt=>|x|{failures=failures+znc_script_call_escape(x.expr,env.*,decls,sums,report);}.if_=>|x|{failures=failures+znc_script_call_escape(x.cond,env.*,decls,sums,report)+znc_script_lifetime_body(x.then_body,env,decls,sums,report,returns)+znc_script_lifetime_body(x.els_body,env,decls,sums,report,returns);}.while_=>|x|{failures=failures+znc_script_call_escape(x.cond,env.*,decls,sums,report)+znc_script_lifetime_body(x.body,env,decls,sums,report,returns);}.unsafe_=>|x|{failures=failures+znc_script_lifetime_body(x.body,env,decls,sums,report,returns);}.switch_=>|x|{failures=failures+znc_script_call_escape(x.subject,env.*,decls,sums,report);let ai:i32=0;while(ai<len[SwitchArm](x.arms)){failures=failures+znc_script_lifetime_body(get[SwitchArm](x.arms,ai).body,env,decls,sums,report,returns);ai=ai+1;}failures=failures+znc_script_lifetime_body(x.els_body,env,decls,sums,report,returns);}else=>{}}i=i+1;}return failures;}
fn znc_script_lifetime_check(decls:ArrayList[*Node])i32{let sums:ArrayList[ZScriptLifeSummary]=make[ZScriptLifeSummary](16);let i:i32=0;while(i<decls.len){switch(decls.data[i].*){.fn_decl=>|f|{if(f.is_extern==0){push[ZScriptLifeSummary](&sums,ZScriptLifeSummary{.name=f.name,.returns_script=0,.escapes_script=0});}}else=>{}}i=i+1;}let pass:i32=0;while(pass<=sums.len){i=0;while(i<decls.len){switch(decls.data[i].*){.fn_decl=>|f|{if(f.is_extern==0){let env:ArrayList[ZTBind]=make[ZTBind](f.params.len+8);let pi:i32=0;while(pi<f.params.len){push[ZTBind](&env,ZTBind{.name=f.params.data[pi].name,.ty="script-lifetime"});pi=pi+1;}let ret:i32=0;let escapes:i32=znc_script_lifetime_body(f.body,&env,decls,sums,0,&ret);let si:i32=0;while(si<sums.len){if(@strEq(sums.data[si].name,f.name)){if(ret==1){sums.data[si].returns_script=1;}if(escapes>0){sums.data[si].escapes_script=1;}}si=si+1;}}}else=>{}}i=i+1;}pass=pass+1;}i=0;while(i<decls.len){switch(decls.data[i].*){.fn_decl=>|f|{if(@strEq(f.name,"__zag_compiler_script_body_7f3a")){let env:ArrayList[ZTBind]=make[ZTBind](8);let ret:i32=0;return znc_script_lifetime_body(f.body,&env,decls,sums,1,&ret);}}else=>{}}i=i+1;}return 0;}
fn znc_ast_has_call_expr(n:*Node,name:[]u8)i32{switch(n.*){.call=>|x|{if(@strEq(callee_name(x.callee),name)){return 1;}let i:i32=0;while(i<x.args.len){if(znc_ast_has_call_expr(x.args.data[i],name)==1){return 1;}i=i+1;}}.bin=>|x|{return znc_ast_has_call_expr(x.l,name)|znc_ast_has_call_expr(x.r,name);}.un=>|x|{return znc_ast_has_call_expr(x.e,name);}.fld=>|x|{return znc_ast_has_call_expr(x.base,name);}.idx=>|x|{return znc_ast_has_call_expr(x.base,name)|znc_ast_has_call_expr(x.idx,name);}.cast_=>|x|{return znc_ast_has_call_expr(x.expr,name);}.slice_=>|x|{return znc_ast_has_call_expr(x.base,name)|znc_ast_has_call_expr(x.lo,name);}.slit_=>|x|{let i:i32=0;while(i<len[FieldInit](x.fields)){if(znc_ast_has_call_expr(get[FieldInit](x.fields,i).val,name)==1){return 1;}i=i+1;}}else=>{}}return 0;}
fn znc_ast_body_has_call(body:ArrayList[*Node],name:[]u8)i32{let i:i32=0;while(i<body.len){switch(body.data[i].*){.let_=>|x|{if(x.has_init==1&&znc_ast_has_call_expr(x.expr,name)==1){return 1;}}.ret=>|x|{if(x.has_expr==1&&znc_ast_has_call_expr(x.expr,name)==1){return 1;}}.estmt=>|x|{if(znc_ast_has_call_expr(x.expr,name)==1){return 1;}}.assign=>|x|{if(znc_ast_has_call_expr(x.expr,name)==1){return 1;}}.if_=>|x|{if(znc_ast_has_call_expr(x.cond,name)==1||znc_ast_body_has_call(x.then_body,name)==1||znc_ast_body_has_call(x.els_body,name)==1){return 1;}}.while_=>|x|{if(znc_ast_has_call_expr(x.cond,name)==1||znc_ast_body_has_call(x.body,name)==1){return 1;}}.unsafe_=>|x|{if(znc_ast_body_has_call(x.body,name)==1){return 1;}}.switch_=>|x|{if(znc_ast_has_call_expr(x.subject,name)==1){return 1;}let ai:i32=0;while(ai<len[SwitchArm](x.arms)){if(znc_ast_body_has_call(get[SwitchArm](x.arms,ai).body,name)==1){return 1;}ai=ai+1;}if(znc_ast_body_has_call(x.els_body,name)==1){return 1;}}else=>{}}i=i+1;}return 0;}
// Root executable statements are rewritten by script_bind_expr: `new` becomes
// _zag_script_new and is charged to ScriptContext. Ordinary root helpers do
// not have a hidden context parameter, so accepting raw `new` there would
// silently allocate outside the bounded script arena. Keep that boundary
// explicit until helpers can receive a context by an ordinary Zag signature.
// Result bits: 1 = ordinary make/new, 2 = allocating runtime/builtin that is
// not charged to the active ScriptContext. Keep this exact list aligned with
// the allocating sources in sema.zag; deallocators are intentionally absent.
fn znc_script_unaccounted_alloc_call(name:[]u8,helper:i32)i32{
    if(@strEq(name,"make")||(helper==1&&@strEq(name,"new"))){return 1;}
    if(@strEq(name,"_zag_malloc")||@strEq(name,"_zag_realloc")||
       @strEq(name,"_zag_strdup")||@strEq(name,"_zag_str_concat")||
       @strEq(name,"_zag_i64_to_str")||@strEq(name,"_zag_u64_to_str")||
       @strEq(name,"_zag_read_file")||@strEq(name,"_zag_exec_capture")||
       @strEq(name,"_zag_script_context_init")||@strEq(name,"zalloc")||
       @strEq(name,"zalloc_i")||@strEq(name,"@cacheAlignedAlloc")){return 2;}
    return 0;
}
fn znc_script_root_unaccounted_expr(n:*Node,helper:i32)i32{
    switch(n.*){
        .call=>|x|{
            let found:i32=znc_script_unaccounted_alloc_call(callee_name(x.callee),helper);
            let i:i32=0;
            while(i<x.args.len){found=found|znc_script_root_unaccounted_expr(x.args.data[i],helper);i=i+1;}
            return found;
        }
        .bin=>|x|{return znc_script_root_unaccounted_expr(x.l,helper)|znc_script_root_unaccounted_expr(x.r,helper);}
        .un=>|x|{return znc_script_root_unaccounted_expr(x.e,helper);}
        .fld=>|x|{return znc_script_root_unaccounted_expr(x.base,helper);}
        .idx=>|x|{return znc_script_root_unaccounted_expr(x.base,helper)|znc_script_root_unaccounted_expr(x.idx,helper);}
        .cast_=>|x|{return znc_script_root_unaccounted_expr(x.expr,helper);}
        .slice_=>|x|{
            let found:i32=znc_script_root_unaccounted_expr(x.base,helper)|znc_script_root_unaccounted_expr(x.lo,helper);
            if(x.has_hi==1){found=found|znc_script_root_unaccounted_expr(x.hi,helper);}
            return found;
        }
        .slit_=>|x|{
            let found:i32=0;let i:i32=0;
            while(i<len[FieldInit](x.fields)){found=found|znc_script_root_unaccounted_expr(get[FieldInit](x.fields,i).val,helper);i=i+1;}
            return found;
        }
        .switch_=>|x|{
            let found:i32=znc_script_root_unaccounted_expr(x.subject,helper);let ai:i32=0;
            while(ai<len[SwitchArm](x.arms)){found=found|znc_script_root_unaccounted_body(get[SwitchArm](x.arms,ai).body,helper);ai=ai+1;}
            found=found|znc_script_root_unaccounted_body(x.els_body,helper);
            return found;
        }
        else=>{}
    }
    return 0;
}
fn znc_script_root_unaccounted_body(body:ArrayList[*Node],helper:i32)i32{
    let found:i32=0;let i:i32=0;
    while(i<body.len){
        switch(body.data[i].*){
            .let_=>|x|{if(x.has_init==1){found=found|znc_script_root_unaccounted_expr(x.expr,helper);}}
            .ret=>|x|{if(x.has_expr==1){found=found|znc_script_root_unaccounted_expr(x.expr,helper);}}
            .estmt=>|x|{found=found|znc_script_root_unaccounted_expr(x.expr,helper);}
            .assign=>|x|{found=found|znc_script_root_unaccounted_expr(x.expr,helper);}
            .if_=>|x|{found=found|znc_script_root_unaccounted_expr(x.cond,helper)|znc_script_root_unaccounted_body(x.then_body,helper)|znc_script_root_unaccounted_body(x.els_body,helper);}
            .while_=>|x|{found=found|znc_script_root_unaccounted_expr(x.cond,helper)|znc_script_root_unaccounted_body(x.body,helper);}
            .unsafe_=>|x|{found=found|znc_script_root_unaccounted_body(x.body,helper);}
            .switch_=>|x|{
                found=found|znc_script_root_unaccounted_expr(x.subject,helper);let ai:i32=0;
                while(ai<len[SwitchArm](x.arms)){found=found|znc_script_root_unaccounted_body(get[SwitchArm](x.arms,ai).body,helper);ai=ai+1;}
                found=found|znc_script_root_unaccounted_body(x.els_body,helper);
            }
            else=>{}
        }
        i=i+1;
    }
    return found;
}
fn znc_script_name_seen(names:ArrayList[[]u8],name:[]u8)i32{let i:i32=0;while(i<names.len){if(@strEq(names.data[i],name)){return 1;}i=i+1;}return 0;}
fn znc_script_unaccounted_root_make(decls:ArrayList[*Node])i32{
    // Only declarations parsed from the Script root are subject to its implicit
    // allocator policy. Imported strict modules retain their explicit allocator
    // contracts and cannot be silently rewritten or charged to ScriptContext.
    let reachable:ArrayList[[]u8]=make[[]u8](8);push[[]u8](&reachable,"__zag_compiler_script_body_7f3a");let cursor:i32=0;
    while(cursor<reachable.len){let caller:[]u8=reachable.data[cursor];let fi:i32=0;while(fi<decls.len){switch(decls.data[fi].*){.fn_decl=>|f|{if(@strEq(f.origin,"<root>")&&znc_script_name_seen(reachable,f.name)==0){let ci:i32=0;while(ci<decls.len){switch(decls.data[ci].*){.fn_decl=>|owner|{if(@strEq(owner.name,caller)&&znc_ast_body_has_call(owner.body,f.name)==1){push[[]u8](&reachable,f.name);}}else=>{}}ci=ci+1;}}}else=>{}}fi=fi+1;}cursor=cursor+1;}
    let i:i32=0;while(i<decls.len){switch(decls.data[i].*){.fn_decl=>|f|{let root_body:i32=@strEq(f.name,"__zag_compiler_script_body_7f3a");let root_helper:i32=@strEq(f.origin,"<root>");if(znc_script_name_seen(reachable,f.name)==1&&(root_body==1||root_helper==1)){let unaccounted:i32=znc_script_root_unaccounted_body(f.body,root_body==0);if((unaccounted&2)!=0){if(root_body==1){_zag_eprintln("znc script allocation: raw runtime allocator is not charged to ScriptContext; use script_alloc/list/string_builder or an explicit strict-Zag allocator");}else{_zag_eprintln(_zag_str_concat("znc script allocation: reachable Script helper `",_zag_str_concat(f.name,"` uses a raw runtime allocator outside ScriptContext; use script_alloc/list/string_builder or an explicit strict-Zag module")));}return 1;}if((unaccounted&1)!=0){if(root_body==1){_zag_eprintln("znc script allocation: root make is not charged to ScriptContext; use list/string_builder/script_alloc or an explicit strict-Zag allocator");}else{_zag_eprintln(_zag_str_concat("znc script allocation: reachable Script helper `",_zag_str_concat(f.name,"` uses make or new outside ScriptContext; use script_alloc/list/string_builder or an explicit strict-Zag module")));}return 1;}}}else=>{}}i=i+1;}return 0;
}

// Compiler-owned Script helpers are part of the allocator authority boundary,
// not an opaque trusted blob. Resolve their exact std origins, walk their AST
// bodies, and reject any call outside the small synchronous runtime contract or
// another compiler-owned helper. This is deliberately independent of spelling:
// a project function with the same name never receives this authority.
fn znc_script_std_origin_kind(origin:[]u8)i32{
    if(@strEq(origin,canon_path(resolve_import_path("std:process",".")))){return 1;}
    if(@strEq(origin,canon_path(resolve_import_path("std:script_io",".")))){return 2;}
    if(@strEq(origin,canon_path(resolve_import_path("std:script_input",".")))){return 3;}
    if(@strEq(origin,canon_path(resolve_import_path("std:script_string_builder",".")))){return 4;}
    if(@strEq(origin,canon_path(resolve_import_path("std:script_list",".")))){return 5;}
    if(@strEq(origin,canon_path(resolve_import_path("std:script_string",".")))){return 6;}
    if(@strEq(origin,canon_path(resolve_import_path("std:script_path",".")))){return 7;}
    return 0;
}
fn znc_script_compiler_std_call(decls:ArrayList[*Node],name:[]u8)i32{
    let i:i32=0;
    while(i<decls.len){
        switch(decls.data[i].*){
            .fn_decl=>|f|{
                if(f.is_extern==0&&@strEq(f.name,name)&&
                    znc_script_std_origin_kind(f.origin)>0){return 1;}
            }
            else=>{}
        }
        i=i+1;
    }
    return 0;
}
fn znc_script_std_runtime_call(kind:i32,owner:[]u8,name:[]u8)i32{
    if(@strEq(name,"@sizeOf")||@strEq(name,"@strEq")){return 1;}
    if(@strEq(name,"_zag_eprintln")){return 1;}
    if(@strEq(name,"_zag_script_alloc")){
        if(kind==3||kind==4||kind==5||kind==6||kind==7){return 1;}
        if(kind==2&&@strEq(owner,"script_read_file")){return 1;}
        return (kind==1&&@strEq(owner,"process_alloc")) as i32;
    }
    if(kind==2){
        if(@strEq(owner,"script_read_file")&&
            (@strEq(name,"_zag_script_file_size")||
             @strEq(name,"_zag_script_read_file_into"))){return 1;}
        return 0;
    }
    if(kind==3){
        return (@strEq(name,"_zag_print")||@strEq(name,"_zag_read_fd")) as i32;
    }
    if(kind==5){
        if(@strEq(name,"_zag_argc")||@strEq(name,"_zag_arg")){return 1;}
        // A generic list getter has no error-return value. Its checked
        // out-of-bounds boundary reports and terminates instead of exposing a
        // raw pointer dereference through a corrupted ScriptList descriptor.
        return (@strEq(owner,"script_list_get")&&@strEq(name,"_zag_exit")) as i32;
    }
    if(kind==1){
        if(@strEq(name,"_zag_malloc")){
            return @strEq(owner,"process_alloc") as i32;
        }
        if(@strEq(name,"_zag_process_result_abi_new")||
            @strEq(name,"_zag_script_process_result_abi_new")){
            return @strEq(owner,"process_result_new") as i32;
        }
        if(@strEq(name,"_zag_raw_syscall")){
            return @strEq(owner,"process_run_bounded_internal") as i32;
        }
        if(@strEq(name,"_zag_argc")||@strEq(name,"_zag_arg")||
           @strEq(name,"_zag_exec_cmd")||@strEq(name,"_zag_exit")||
           @strEq(name,"_zag_clock_monotonic_ms")||
           @strEq(name,"_zag_process_result_status")||
           @strEq(name,"_zag_process_result_state")||
           @strEq(name,"_zag_process_result_output")||
           @strEq(name,"_zag_slice_ptr")){return 1;}
    }
    return 0;
}
fn znc_script_std_calls_expr(n:*Node,kind:i32,owner:[]u8,
    decls:ArrayList[*Node],report:i32)i32{
    let errors:i32=0;
    switch(n.*){
        .call=>|x|{
            let name:[]u8=callee_name(x.callee);
            if(znc_script_std_runtime_call(kind,owner,name)==0&&
                znc_script_compiler_std_call(decls,name)==0){
                if(report==1){
                    let shown:[]u8=name;if(shown.len==0){shown="<indirect>";}
                    _zag_eprintln(_zag_str_concat(
                        "znc script helper body: compiler-owned helper `",
                        _zag_str_concat(owner,_zag_str_concat(
                        "` calls an unapproved allocator, runtime, extern, or helper `",
                        _zag_str_concat(shown,"`")))));
                }
                errors=errors+1;
            }
            let i:i32=0;
            while(i<x.args.len){
                errors=errors+znc_script_std_calls_expr(x.args.data[i],kind,
                    owner,decls,report);
                i=i+1;
            }
        }
        .bin=>|x|{errors=errors+znc_script_std_calls_expr(x.l,kind,owner,decls,report)+znc_script_std_calls_expr(x.r,kind,owner,decls,report);}
        .un=>|x|{errors=errors+znc_script_std_calls_expr(x.e,kind,owner,decls,report);}
        .fld=>|x|{errors=errors+znc_script_std_calls_expr(x.base,kind,owner,decls,report);}
        .idx=>|x|{errors=errors+znc_script_std_calls_expr(x.base,kind,owner,decls,report)+znc_script_std_calls_expr(x.idx,kind,owner,decls,report);}
        .cast_=>|x|{errors=errors+znc_script_std_calls_expr(x.expr,kind,owner,decls,report);}
        .slice_=>|x|{
            errors=errors+znc_script_std_calls_expr(x.base,kind,owner,decls,report)+znc_script_std_calls_expr(x.lo,kind,owner,decls,report);
            if(x.has_hi==1){errors=errors+znc_script_std_calls_expr(x.hi,kind,owner,decls,report);}
        }
        .slit_=>|x|{let i:i32=0;while(i<x.fields.len){errors=errors+znc_script_std_calls_expr(x.fields.data[i].val,kind,owner,decls,report);i=i+1;}}
        .switch_=>|x|{
            errors=errors+znc_script_std_calls_expr(x.subject,kind,owner,decls,report);
            let ai:i32=0;while(ai<x.arms.len){errors=errors+znc_script_std_calls_body(x.arms.data[ai].body,kind,owner,decls,report);ai=ai+1;}
            errors=errors+znc_script_std_calls_body(x.els_body,kind,owner,decls,report);
        }
        else=>{}
    }
    return errors;
}
fn znc_script_std_calls_body(body:ArrayList[*Node],kind:i32,owner:[]u8,
    decls:ArrayList[*Node],report:i32)i32{
    let errors:i32=0;let i:i32=0;
    while(i<body.len){
        switch(body.data[i].*){
            .let_=>|x|{if(x.has_init==1){errors=errors+znc_script_std_calls_expr(x.expr,kind,owner,decls,report);}}
            .ret=>|x|{if(x.has_expr==1){errors=errors+znc_script_std_calls_expr(x.expr,kind,owner,decls,report);}}
            .estmt=>|x|{errors=errors+znc_script_std_calls_expr(x.expr,kind,owner,decls,report);}
            .assign=>|x|{errors=errors+znc_script_std_calls_expr(x.target,kind,owner,decls,report)+znc_script_std_calls_expr(x.expr,kind,owner,decls,report);}
            .if_=>|x|{errors=errors+znc_script_std_calls_expr(x.cond,kind,owner,decls,report)+znc_script_std_calls_body(x.then_body,kind,owner,decls,report)+znc_script_std_calls_body(x.els_body,kind,owner,decls,report);}
            .while_=>|x|{errors=errors+znc_script_std_calls_expr(x.cond,kind,owner,decls,report)+znc_script_std_calls_body(x.body,kind,owner,decls,report);}
            .unsafe_=>|x|{errors=errors+znc_script_std_calls_body(x.body,kind,owner,decls,report);}
            .switch_=>|x|{
                errors=errors+znc_script_std_calls_expr(x.subject,kind,owner,decls,report);
                let ai:i32=0;while(ai<x.arms.len){errors=errors+znc_script_std_calls_body(x.arms.data[ai].body,kind,owner,decls,report);ai=ai+1;}
                errors=errors+znc_script_std_calls_body(x.els_body,kind,owner,decls,report);
            }
            else=>{}
        }
        i=i+1;
    }
    return errors;
}
fn znc_script_call_count_expr(n:*Node,name:[]u8)i32{
    let count:i32=0;
    switch(n.*){
        .call=>|x|{if(@strEq(callee_name(x.callee),name)){count=count+1;}let i:i32=0;while(i<x.args.len){count=count+znc_script_call_count_expr(x.args.data[i],name);i=i+1;}}
        .bin=>|x|{count=count+znc_script_call_count_expr(x.l,name)+znc_script_call_count_expr(x.r,name);}
        .un=>|x|{count=count+znc_script_call_count_expr(x.e,name);}
        .fld=>|x|{count=count+znc_script_call_count_expr(x.base,name);}
        .idx=>|x|{count=count+znc_script_call_count_expr(x.base,name)+znc_script_call_count_expr(x.idx,name);}
        .cast_=>|x|{count=count+znc_script_call_count_expr(x.expr,name);}
        .slice_=>|x|{count=count+znc_script_call_count_expr(x.base,name)+znc_script_call_count_expr(x.lo,name);if(x.has_hi==1){count=count+znc_script_call_count_expr(x.hi,name);}}
        .slit_=>|x|{let i:i32=0;while(i<x.fields.len){count=count+znc_script_call_count_expr(x.fields.data[i].val,name);i=i+1;}}
        else=>{}
    }
    return count;
}
fn znc_script_call_count_body(body:ArrayList[*Node],name:[]u8)i32{
    let count:i32=0;let i:i32=0;
    while(i<body.len){
        switch(body.data[i].*){
            .let_=>|x|{if(x.has_init==1){count=count+znc_script_call_count_expr(x.expr,name);}}
            .ret=>|x|{if(x.has_expr==1){count=count+znc_script_call_count_expr(x.expr,name);}}
            .estmt=>|x|{count=count+znc_script_call_count_expr(x.expr,name);}
            .assign=>|x|{count=count+znc_script_call_count_expr(x.target,name)+znc_script_call_count_expr(x.expr,name);}
            .if_=>|x|{count=count+znc_script_call_count_expr(x.cond,name)+znc_script_call_count_body(x.then_body,name)+znc_script_call_count_body(x.els_body,name);}
            .while_=>|x|{count=count+znc_script_call_count_expr(x.cond,name)+znc_script_call_count_body(x.body,name);}
            .unsafe_=>|x|{count=count+znc_script_call_count_body(x.body,name);}
            .switch_=>|x|{count=count+znc_script_call_count_expr(x.subject,name);let ai:i32=0;while(ai<x.arms.len){count=count+znc_script_call_count_body(x.arms.data[ai].body,name);ai=ai+1;}count=count+znc_script_call_count_body(x.els_body,name);}
            else=>{}
        }
        i=i+1;
    }
    return count;
}
fn znc_script_read_file_stage_check(decls:ArrayList[*Node])i32{
    let i:i32=0;
    while(i<decls.len){
        switch(decls.data[i].*){
            .fn_decl=>|f|{
                if(@strEq(f.name,"script_read_file")&&
                    znc_script_std_origin_kind(f.origin)==2){
                    if(znc_script_call_count_body(f.body,"_zag_read_file")!=0||
                       znc_script_call_count_body(f.body,"_zag_free")!=0||
                       znc_script_call_count_body(f.body,
                           "_zag_script_file_size")!=1||
                       znc_script_call_count_body(f.body,
                           "_zag_script_read_file_into")!=1||
                       znc_script_call_count_body(f.body,
                           "_zag_script_alloc")!=1){
                        _zag_eprintln("znc script helper body: script_read_file must preflight and read directly into exactly one Script allocation without native full-file staging");
                        return 1;
                    }
                    return 0;
                }
            }
            else=>{}
        }
        i=i+1;
    }
    return 0;
}
fn znc_script_std_body_check(decls:ArrayList[*Node])i32{
    let errors:i32=0;let i:i32=0;
    while(i<decls.len){
        switch(decls.data[i].*){
            .fn_decl=>|f|{
                let kind:i32=znc_script_std_origin_kind(f.origin);
                if(kind>0&&f.is_extern==0){
                    errors=errors+znc_script_std_calls_body(f.body,kind,f.name,
                        decls,1);
                }
            }
            else=>{}
        }
        i=i+1;
    }
    errors=errors+znc_script_read_file_stage_check(decls);
    return errors;
}

fn znc_check(path: []u8) i32 {
    if (path.len == 0) { _zag_println("znc: no source file"); return 1; }
    let src: []u8 = _zag_read_file(path);
    if (src.len < 0) { _zag_print("znc: cannot read "); _zag_println(path); return 1; }
    src=znc_activate_script_source(path,src,0);
    if (v2_validate_source(path, src) != 0) { return 1; }
    let unit: CompilationUnit = parse_compilation_unit_dir(src, dir_of(path));
    if(znc_validate_script_defaults(path,unit)!=0){return 1;}
    if(znc_configure_script_unit(&unit,path)!=0){return 1;}
    if(znc_validate_script_capabilities(path,unit)!=0){return 1;}
    if(unit.profile==ModuleProfile.script&&(znc_script_std_body_check(unit.decls)!=0||znc_script_lifetime_check(unit.decls)!=0||znc_script_unaccounted_root_make(unit.decls)!=0)){return 1;}
    if (has_flag("--strict") == 1 && unit.profile == ModuleProfile.script) {
        _zag_eprintln("znc: strict check FAILED: generated script entry point remains implicit");
        let strict_choices:PlannerChoices=znc_script_explicit_choices();
        if(strict_choices.allocator_explicit==1){
            _zag_eprintln(_zag_str_concat("resolved: explicit Script allocator policy selected: ",
                strict_choices.allocator));
            _zag_eprintln("unresolved: Script allocator contract must still be expanded to an ordinary strict-Zag allocator");
        }else{
            _zag_eprintln("unresolved: implicit bounded Script allocator remains");
        }
        let di:i32=0;while(di<unit.decls.len){switch(unit.decls.data[di].*){.fn_decl=>|f|{if(@strEq(f.name,"__zag_compiler_script_body_7f3a")&&znc_ast_body_has_call(f.body,"make")==1){_zag_eprintln("unresolved: ordinary make allocation is not charged to the Script context");}}else=>{}}di=di+1;}
        if (znc_contains(src, "read_file(") == 1 || znc_contains(src, "write_file(") == 1) {
            _zag_eprintln("unresolved: filesystem capability has no explicit policy");
        }
        if (znc_contains(src, "script_alloc(") == 1) {
            _zag_eprintln("unresolved: temporary allocation remains tied to the script context");
        }
        if (znc_contains(src, "process_run_timeout(") == 1) {
            _zag_eprintln("unresolved: process capability policy remains implicit (timeout is explicit)");
        }
        if (znc_script_generated_calls(unit, "_zag_script_env_get") == 1) {
            _zag_eprintln("unresolved: environment capability has no explicit strict-Zag policy");
        }
        if (znc_contains(src, "list(") == 1 || znc_contains(src, "args(") == 1 || znc_contains(src, "string_builder(") == 1) {
            _zag_eprintln("unresolved: temporary collection remains tied to the Script context");
        }
        if (znc_contains(src, "path_join(") == 1 || znc_contains(src, "string_concat(") == 1) {
            _zag_eprintln("unresolved: hidden Script-lifetime string allocation remains");
        }
        if (znc_contains(src, "random") == 1 && znc_contains(src, "seed") == 0) {
            _zag_eprintln("unresolved: random seed is implicit");
        }
        _zag_eprintln("unresolved: CPU/device/layout defaults remain compiler-selected unless made explicit in strict Zag");
        _zag_eprintln("note: run `znc explain <file>` and `znc harden <file>` before promotion to strict Zag");
        return 1;
    }
    let decls: ArrayList[*Node] = unit.decls;
    lo_operators(decls);
    // `check` is a semantic authority, not a lighter advisory path. Keep it
    // aligned with every build target so type, ownership, arity, and duplicate
    // diagnostics cannot be bypassed by choosing this command.
    let aerrs:i32=znc_check_arity(decls);
    if(aerrs>0){_zag_println("znc: arity check FAILED");return 1;}
    let derrs:i32=znc_check_dups(decls);
    if(derrs>0){_zag_println("znc: duplicate-definition check FAILED");return 1;}
    if(typed_check_program(decls,path)>0){return 1;}
    let eff: map__StringMap[i32] = analyze(decls);
    let viols: i32 = report_violations(decls, eff, src, path);
    if (viols > 0) {
        znc_emit_total_cex(decls, eff);
        _zag_println("znc: capability check FAILED");
        return 1;
    }
    smt_report_proofs(decls, eff);
    if (run_analyzer(decls, path) != 0) { return 1; }
    let published:i32=znc_publish_semantics(path,src,unit,decls,eff);
    znc_maybe_regular_advisory(path,unit,published);
    _zag_println("znc: OK — all capability claims proven");
    return 0;
}

fn znc_format_json(value:[]u8)i32 { if (@strEq(value,"json")){return 1;}return 0; }
fn znc_format_text(value:[]u8)i32 { if (@strEq(value,"text")){return 1;}return 0; }
fn znc_json_bool(value:i32)[]u8{if(value==1){return "true";}return "false";}

// Explain must not retain a second whole-AST allocation map just to describe
// Script conveniences. This bounded streaming walk visits only the generated
// root Script body after its normal prelude binding. Statement spans are not
// represented by the AST, so location is explicitly unknown rather than
// guessed from a text search. Imported strict helpers are deliberately out of
// scope: their allocator contracts remain explicit library policy.
struct ZExplainOperation {
    operation: []u8,
    allocation: []u8,
    allocation_bytes: []u8,
    copy: []u8,
    copy_bytes: []u8,
}
struct ZExplainOperationState { json: i32, first: i32, emitted: i32, truncated: i32 }

fn znc_explain_operation(name: []u8) ZExplainOperation {
    if (@strEq(name, "_zag_script_alloc")) { return ZExplainOperation{.operation="script_alloc",.allocation="script_context",.allocation_bytes="unknown",.copy="zero",.copy_bytes="0"}; }
    if (@strEq(name, "script_input")) { return ZExplainOperation{.operation="input",.allocation="script_context",.allocation_bytes="4096",.copy="zero",.copy_bytes="0"}; }
    if (@strEq(name, "script_read_file")) { return ZExplainOperation{.operation="read_file",.allocation="script_context",.allocation_bytes="unknown",.copy="file_bytes_to_script_context",.copy_bytes="unknown"}; }
    if (@strEq(name, "script_string_concat")) { return ZExplainOperation{.operation="string_concat",.allocation="script_context",.allocation_bytes="unknown",.copy="both_input_slices",.copy_bytes="unknown"}; }
    if (@strEq(name, "script_string_builder_new")) { return ZExplainOperation{.operation="string_builder",.allocation="script_context",.allocation_bytes="unknown",.copy="zero",.copy_bytes="0"}; }
    if (@strEq(name, "string_builder_append")) { return ZExplainOperation{.operation="string_builder_append",.allocation="zero",.allocation_bytes="0",.copy="appended_bytes",.copy_bytes="unknown"}; }
    if (@strEq(name, "string_builder_output")) { return ZExplainOperation{.operation="string_builder_output",.allocation="zero",.allocation_bytes="0",.copy="zero",.copy_bytes="0"}; }
    if (@strEq(name, "process_run_bounded_script")) { return ZExplainOperation{.operation="process_run_timeout",.allocation="script_context",.allocation_bytes="unknown",.copy="command_bytes",.copy_bytes="unknown"}; }
    if (@strEq(name, "_zag_script_new")) { return ZExplainOperation{.operation="new",.allocation="script_context",.allocation_bytes="unknown",.copy="zero",.copy_bytes="0"}; }
    if (@strEq(name, "_zag_script_env_get")) { return ZExplainOperation{.operation="env",.allocation="zero",.allocation_bytes="0",.copy="zero",.copy_bytes="0"}; }
    if (@strEq(name, "script_args")) { return ZExplainOperation{.operation="args",.allocation="script_context",.allocation_bytes="unknown",.copy="argument_slice_descriptors",.copy_bytes="unknown"}; }
    if (@strEq(name, "script_path_join")) { return ZExplainOperation{.operation="path_join",.allocation="script_context",.allocation_bytes="unknown",.copy="both_input_slices",.copy_bytes="unknown"}; }
    if (@strEq(name, "script_path_basename")) { return ZExplainOperation{.operation="path_basename",.allocation="zero",.allocation_bytes="0",.copy="zero",.copy_bytes="0"}; }
    if (@strEq(name, "script_path_dirname")) { return ZExplainOperation{.operation="path_dirname",.allocation="zero",.allocation_bytes="0",.copy="zero",.copy_bytes="0"}; }
    if (@strEq(name, "script_path_extension")) { return ZExplainOperation{.operation="path_extension",.allocation="zero",.allocation_bytes="0",.copy="zero",.copy_bytes="0"}; }
    if (@strEq(name, "script_list1") || @strEq(name, "script_list2") || @strEq(name, "script_list3") || @strEq(name, "script_list4") || @strEq(name, "script_list_new")) { return ZExplainOperation{.operation="list",.allocation="script_context",.allocation_bytes="unknown",.copy="initial_elements",.copy_bytes="unknown"}; }
    if (@strEq(name, "script_list_append")) { return ZExplainOperation{.operation="list_append",.allocation="conditional_script_context",.allocation_bytes="unknown",.copy="conditional_existing_elements_on_growth",.copy_bytes="unknown"}; }
    if (@strEq(name, "script_list_len") || @strEq(name, "script_list_get") || @strEq(name, "script_list_failed") || @strEq(name, "_zag_script_alloc_used")) { return ZExplainOperation{.operation="collection_or_allocator_query",.allocation="zero",.allocation_bytes="0",.copy="zero",.copy_bytes="0"}; }
    return ZExplainOperation{.operation="",.allocation="",.allocation_bytes="",.copy="",.copy_bytes=""};
}

fn znc_explain_emit_operation(name: []u8, state: *ZExplainOperationState) void {
    let op: ZExplainOperation = znc_explain_operation(name);
    if (op.operation.len == 0) { return; }
    // A cap makes explain output and compiler memory predictable even for a
    // generated file with thousands of Script calls. The count is of emitted
    // witnesses, not a program-wide allocation total.
    if (state.*.emitted >= 64) { state.*.truncated = 1; return; }
    if (state.*.json == 1) {
        if (state.*.first == 0) { _zag_print(","); }
        _zag_print("{\"operation\":\"");_zag_print(op.operation);
        _zag_print("\",\"allocation\":{\"value\":\"");_zag_print(op.allocation);
        _zag_print("\",\"bytes\":\"");_zag_print(op.allocation_bytes);
        _zag_print("\",\"basis\":\"proven\"},\"copy\":{\"value\":\"");_zag_print(op.copy);
        _zag_print("\",\"bytes\":\"");_zag_print(op.copy_bytes);
        _zag_print("\",\"basis\":\"proven\"},\"source_location\":{\"value\":\"unavailable\",\"basis\":\"unknown\"},\"provenance\":\"proven\"}");
    } else {
        _zag_print("implicit operation: ");_zag_print(op.operation);
        _zag_print(" allocation=");_zag_print(op.allocation);
        _zag_print(" allocation_bytes=");_zag_print(op.allocation_bytes);
        _zag_print(" copy=");_zag_print(op.copy);
        _zag_print(" copy_bytes=");_zag_print(op.copy_bytes);
        _zag_println(" location=unavailable provenance=proven");
    }
    state.*.first = 0;
    state.*.emitted = state.*.emitted + 1;
}

fn znc_explain_operations_expr(n: *Node, state: *ZExplainOperationState) void {
    switch (n.*) {
        .call => |c| {
            znc_explain_operations_expr(c.callee, state);
            let i:i32=0;while(i<c.args.len){znc_explain_operations_expr(c.args.data[i],state);i=i+1;}
            znc_explain_emit_operation(callee_name(c.callee), state);
        }
        .bin => |x| { znc_explain_operations_expr(x.l,state); znc_explain_operations_expr(x.r,state); }
        .un => |x| { znc_explain_operations_expr(x.e,state); }
        .fld => |x| { znc_explain_operations_expr(x.base,state); }
        .idx => |x| { znc_explain_operations_expr(x.base,state); znc_explain_operations_expr(x.idx,state); }
        .cast_ => |x| { znc_explain_operations_expr(x.expr,state); }
        .slice_ => |x| { znc_explain_operations_expr(x.base,state); znc_explain_operations_expr(x.lo,state); if(x.has_hi==1){znc_explain_operations_expr(x.hi,state);} }
        .slit_ => |x| { let i:i32=0;while(i<x.fields.len){znc_explain_operations_expr(x.fields.data[i].val,state);i=i+1;} }
        .switch_ => |x| { znc_explain_operations_expr(x.subject,state); let i:i32=0;while(i<x.arms.len){znc_explain_operations_body(x.arms.data[i].body,state);i=i+1;}znc_explain_operations_body(x.els_body,state); }
        else => { }
    }
}

fn znc_explain_operations_body(body: ArrayList[*Node], state: *ZExplainOperationState) void {
    let i:i32=0;while(i<body.len){
        switch(body.data[i].*) {
            .let_ => |x| { if(x.has_init==1){znc_explain_operations_expr(x.expr,state);} }
            .ret => |x| { if(x.has_expr==1){znc_explain_operations_expr(x.expr,state);} }
            .estmt => |x| { znc_explain_operations_expr(x.expr,state); }
            .assign => |x| { znc_explain_operations_expr(x.target,state);znc_explain_operations_expr(x.expr,state); }
            .if_ => |x| { znc_explain_operations_expr(x.cond,state);znc_explain_operations_body(x.then_body,state);znc_explain_operations_body(x.els_body,state); }
            .while_ => |x| { znc_explain_operations_expr(x.cond,state);znc_explain_operations_body(x.body,state); }
            .unsafe_ => |x| { znc_explain_operations_body(x.body,state); }
            .switch_ => |x| { znc_explain_operations_expr(x.subject,state);let ai:i32=0;while(ai<x.arms.len){znc_explain_operations_body(x.arms.data[ai].body,state);ai=ai+1;}znc_explain_operations_body(x.els_body,state); }
            else => { }
        }
        i=i+1;
    }
}

fn znc_explain_script_operations(decls: ArrayList[*Node], state: *ZExplainOperationState) void {
    let i:i32=0;while(i<decls.len){switch(decls.data[i].*){.fn_decl=>|f|{if(@strEq(f.name,"__zag_compiler_script_body_7f3a")){znc_explain_operations_body(f.body,state);return;}}else=>{}}i=i+1;}
}

fn znc_explain(path: []u8) i32 {
    if (path.len == 0) { _zag_eprintln("znc explain: no source file"); return 1; }
    let src: []u8 = _zag_read_file(path);
    if (src.len < 0) { _zag_eprintln("znc explain: cannot read source file"); return 1; }
    src=znc_activate_script_source(path,src,0);
    if (v2_validate_source(path, src) != 0) { return 1; }
    let unit: CompilationUnit = parse_compilation_unit_dir(src, dir_of(path));
    if(znc_validate_script_defaults(path,unit)!=0){return 1;}
    if(znc_configure_script_unit(&unit,path)!=0){return 1;}
    let config: PlannerConfig = znc_project_config(znc_project_root(dir_of(path)), 0);
    let scripted: i32 = 0;
    if (unit.profile == ModuleProfile.script) { scripted = 1; }
    // Explain is inspection, not execution authority. Keep denied operations
    // visible in its report instead of refusing the report that tells the user
    // why a build/check will fail.
    let denied_read:i32=(scripted==1&&config.allow_filesystem_read==0&&
        znc_script_generated_calls(unit,"script_read_file")==1) as i32;
    let denied_write:i32=(scripted==1&&config.allow_filesystem_write==0&&
        znc_script_generated_calls(unit,"_zag_write_file")==1) as i32;
    let denied_process:i32=(scripted==1&&config.allow_process==0&&
        znc_script_generated_calls(unit,"process_run_bounded_script")==1) as i32;
    let denied_environment:i32=0;
    if(scripted==1){denied_environment=znc_script_env_violations(unit,config,0);}
    let denied_count:i32=denied_read+denied_write+denied_process+denied_environment;
    let planner_input: PlannerChoices = znc_script_explicit_choices();
    let resolution: PlannerResolution = planner_resolve(scripted, src, config, planner_input, 0);
    let allocator_basis:[]u8="derived";
    if(planner_input.allocator_explicit==1){allocator_basis="explicit";}
    let semantic_decls:ArrayList[*Node]=unit.decls;lo_operators(semantic_decls);
    let semantic_effects:map__StringMap[i32]=analyze(semantic_decls);
    let semantic_text:[]u8=smp_bounded_manifest(path,src,unit,semantic_effects);
    let semantic_detail:[]u8=smf_value(semantic_text,"detail_level");
    let semantic_witnesses:i32=(1-(@strEq(semantic_detail,"compact") as i32));
    let format: []u8 = flag_value("--format");
    if (format.len > 0 && @strEq(format, "text") == 0 && @strEq(format, "json") == 0) {
        _zag_eprintln("znc explain: --format must be text or json"); return 1;
    }
    let json: i32 = 0;
    if (@strEq(format, "json")) { json = 1; }
    if (json == 1) {
        if (scripted == 1) {
            let cap_policy:[]u8=",\"capability_policy\":{\"filesystem_read\":";
            cap_policy=_zag_str_concat(cap_policy,znc_json_bool(config.allow_filesystem_read));
            cap_policy=_zag_str_concat(cap_policy,",\"filesystem_write\":");cap_policy=_zag_str_concat(cap_policy,znc_json_bool(config.allow_filesystem_write));
            cap_policy=_zag_str_concat(cap_policy,",\"process\":");cap_policy=_zag_str_concat(cap_policy,znc_json_bool(config.allow_process));
            cap_policy=_zag_str_concat(cap_policy,",\"environment_lookup\":");cap_policy=_zag_str_concat(cap_policy,znc_json_bool(config.environment_allow.len>0));
            cap_policy=_zag_str_concat(cap_policy,",\"environment_allow\":\"");cap_policy=_zag_str_concat(cap_policy,znc_json_escape(config.environment_allow));
            cap_policy=_zag_str_concat(cap_policy,"\",\"network\":false,\"policy_satisfied\":");cap_policy=_zag_str_concat(cap_policy,znc_json_bool(denied_count==0));
            cap_policy=_zag_str_concat(cap_policy,",\"denied_operation_count\":");cap_policy=_zag_str_concat(cap_policy,_zag_i64_to_str(denied_count as i64));cap_policy=_zag_str_concat(cap_policy,",\"basis\":\"proven\"}");
            let prefix: []u8 = "{\"schema_version\":1,\"profile\":{\"value\":\"script\",\"basis\":\"proven\"},\"entry_point\":{\"value\":\"compiler-generated managed wrapper\",\"basis\":\"derived\"},\"allocator\":{\"value\":\"";
            prefix=_zag_str_concat(prefix,znc_json_escape(resolution.choices.allocator));
            prefix=_zag_str_concat(prefix,"\",\"basis\":\"");
            prefix=_zag_str_concat(prefix,allocator_basis);
            prefix=_zag_str_concat(prefix,"\"},\"script_memory_bytes\":{\"value\":");
            let before_ops:[]u8=",\"error_boundary\":{\"value\":\"named error diagnostic and nonzero exit\",\"basis\":\"derived\"},\"prelude\":{\"value\":[\"print\",\"println\",\"say\",\"input\",\"env\",\"read_file\",\"write_file\",\"args_len\",\"arg\",\"string_concat\",\"string_builder\",\"list\",\"process_run_timeout\",\"script_alloc\",\"script_alloc_used\"],\"basis\":\"proven\"},\"capabilities\":{\"filesystem\":\"derived from calls\",\"environment\":\"exact allowlist only\",\"process\":\"bounded shell execution when called\",\"network\":\"unsupported\"},\"effects\":{\"value\":\"declaration effects are embedded; expression-witness availability is explicit in semantic_facts\",\"basis\":\"proven\"},\"hidden_allocations\":{\"value\":\"per-operation root Script evidence follows; strict/imported library allocation is outside this report\",\"basis\":\"proven\"},\"hidden_copies\":{\"value\":\"per-operation root Script evidence follows; byte totals are unknown unless stated\",\"basis\":\"proven\"},\"implicit_operations\":{\"scope\":\"compiler_bound_root_script_calls\",\"items\":[";
            _zag_print(prefix);_zag_print(_zag_i64_to_str(config.script_memory_bytes));_zag_print(",\"basis\":\"derived\"}");_zag_print(cap_policy);_zag_print(before_ops);
            let operations:ZExplainOperationState=ZExplainOperationState{.json=1,.first=1,.emitted=0,.truncated=0};
            znc_explain_script_operations(unit.decls,&operations);
            _zag_print("],\"emitted\":");_zag_print(_zag_i64_to_str(operations.emitted as i64));
            _zag_print(",\"truncated\":");_zag_print(znc_json_bool(operations.truncated));
            _zag_print(",\"basis\":\"proven\",\"unclassified\":\"imported strict-library calls are outside compiler-bound Script operation evidence\"},\"execution_plan\":{\"cpu\":\"");_zag_print(znc_json_escape(resolution.choices.cpu));
            _zag_print("\",\"device\":\"");_zag_print(znc_json_escape(resolution.choices.device));
            _zag_print("\",\"layout\":\"");_zag_print(znc_json_escape(resolution.choices.layout));
            _zag_print("\",\"basis\":\"derived\"},\"semantic_facts\":{\"format\":\"zag-semantic-manifest-v1\",\"detail_level\":\"");_zag_print(semantic_detail);
            _zag_print("\",\"expression_witnesses_available\":");_zag_print(znc_json_bool(semantic_witnesses));_zag_print(",\"value\":\"");_zag_print(znc_json_escape(semantic_text));
            _zag_print("\",\"basis\":\"derived\"},\"reclamation\":{\"value\":\"");
            _zag_print(znc_json_escape(znc_script_allocator_reclamation(
                resolution.choices.allocator)));
            _zag_print("\",\"basis\":\"proven\"},\"unresolved\":[\"statement source spans unavailable\",\"strict-library allocation contracts remain explicit\"],\"source_changes\":false}");
            _zag_println("");
        } else {
            _zag_print("{\"schema_version\":1,\"profile\":{\"value\":\"strict\",\"basis\":\"proven\"},\"entry_point\":{\"value\":\"user-defined\",\"basis\":\"derived\"},\"allocator\":{\"value\":\"no script default\",\"basis\":\"proven\"},\"effects\":{\"value\":\"declaration effects are embedded; expression-witness availability is explicit in semantic_facts\",\"basis\":\"proven\"},\"hidden_copies\":{\"value\":\"none introduced by the profile\",\"basis\":\"proven\"},\"implicit_operations\":{\"scope\":\"not_script\",\"items\":[],\"emitted\":0,\"truncated\":false,\"basis\":\"proven\"},\"semantic_facts\":{\"format\":\"zag-semantic-manifest-v1\",\"detail_level\":\"");_zag_print(semantic_detail);_zag_print("\",\"expression_witnesses_available\":");_zag_print(znc_json_bool(semantic_witnesses));_zag_print(",\"value\":\"");_zag_print(znc_json_escape(semantic_text));_zag_println("\",\"basis\":\"proven\"},\"execution_plan\":{\"value\":\"generic x86-64-v1\",\"basis\":\"derived\"}}");
        }
        return 0;
    }
    _zag_print("profile: "); if (scripted == 1) { _zag_println("script [proven]"); } else { _zag_println("strict [proven]"); }
    if (scripted == 1) {
        _zag_println("entry point: compiler-generated managed wrapper; top-level statements run in source order [derived]");
        _zag_print("allocator: ");
        _zag_print(resolution.choices.allocator);
        if(@strEq(resolution.choices.allocator,"script_bounded_heap")){
            _zag_print(" payload-plus-header budget ");
            _zag_print(_zag_i64_to_str(config.script_memory_bytes));
            _zag_print(" bytes; each successful Script allocation charges payload plus its 16-byte ownership header and owns a tracked native block reclaimed at shutdown; native allocator class slack and ordinary make remain outside this Script budget [");
        }else{
            _zag_print(" requested-payload budget ");
            _zag_print(_zag_i64_to_str(config.script_memory_bytes));
            _zag_print(" bytes; root new, read_file results, and bounded process allocations are charged to one arena; ordinary make and allocator metadata remain outside [");
        }
        _zag_print(allocator_basis);_zag_println("]");
        _zag_println("implicit error boundary: numeric error code + root-operation diagnostic, then nonzero exit [derived]");
        _zag_println("prelude: print, println, say, input, env, read_file, write_file, args_len, arg, string_concat, string_builder, list, process_run_timeout, script_alloc, script_alloc_used [proven]");
        if (config.allow_filesystem_read==1) { _zag_println("filesystem read capability: allowed by project policy [proven]"); } else { _zag_println("filesystem read capability: denied by project policy [proven]"); }
        if (config.allow_filesystem_write==1) { _zag_println("filesystem write capability: allowed by project policy [proven]"); } else { _zag_println("filesystem write capability: denied by project policy [proven]"); }
        if (config.allow_process==1) { _zag_println("process capability: allowed only through bounded process API [proven]"); } else { _zag_println("process capability: denied by project policy [proven]"); }
        if(config.environment_allow.len>0){_zag_print("environment capability: exact read-only allowlist ");_zag_print(config.environment_allow);_zag_println(" [proven]");}else{_zag_println("environment capability: denied by empty project allowlist [proven]");}
        if(denied_read==1){_zag_println("policy conflict: read_file is used while filesystem read is denied [proven]");}
        if(denied_write==1){_zag_println("policy conflict: write_file is used while filesystem write is denied [proven]");}
        if(denied_process==1){_zag_println("policy conflict: process_run_timeout is used while process execution is denied [proven]");}
        if(denied_environment>0){_zag_println("policy conflict: env is used without an exact permitted environment_allow name [proven]");}
        _zag_println("network capability: no Script prelude API implemented [proven]");
    } else {
        _zag_println("entry point: user-defined; no script wrapper [derived]");
        _zag_println("allocator: no script default [proven]");
    }
    if(semantic_witnesses==1){_zag_println("expression types/effects: typed frontend and sema witnesses follow; unsupported forms are explicitly unknown [proven]");}
    else{_zag_println("expression types/effects: compact manifest omits per-expression witnesses; declaration effects and exact semantic graph remain available [proven]");}
    _zag_print("semantic declaration/type/effect facts (compiler manifest, detail-level=");_zag_print(semantic_detail);_zag_println(") [proven]:");
    _zag_print(semantic_text);
    _zag_println("hidden allocation: per-operation root Script evidence follows; imported strict-library allocation is outside this report [proven]");
    if(scripted==1){
        _zag_println("hidden copies: per-operation root Script evidence follows; byte totals are unknown unless stated [proven]");
        _zag_println("implicit operations: compiler-bound root Script calls only; location is unavailable because statement spans are not represented [proven]");
        let operations:ZExplainOperationState=ZExplainOperationState{.json=0,.first=1,.emitted=0,.truncated=0};
        znc_explain_script_operations(unit.decls,&operations);
        if(operations.emitted==0){_zag_println("implicit operations: zero classified root Script allocation/copy operations [proven]");}
        if(operations.truncated==1){_zag_println("implicit operations: output truncated after 64 witnesses [proven]");}
    }else{
        _zag_println("hidden copies: none introduced by the strict profile [proven]");
        _zag_println("implicit operations: zero; this is not a Script profile [proven]");
    }
    if(scripted==1){
        _zag_print("reclamation: ");
        _zag_print(znc_script_allocator_reclamation(resolution.choices.allocator));
        _zag_println(" [proven]");
    }else{
        _zag_println("reclamation: no Script runtime resources [proven]");
    }
    if(semantic_witnesses==1){_zag_println("unresolved: only expression forms tagged type_basis=unknown, ordinary make accounting [unknown]");}
    else{_zag_println("unresolved: compact manifest omits expression/value and local buffer-lifetime witnesses; ordinary make accounting remains unknown [unknown]");}
    if (scripted == 1) {
        _zag_print("execution plan: cpu="); _zag_print(resolution.choices.cpu);
        _zag_print(", device="); _zag_print(resolution.choices.device);
        _zag_print(", layout="); _zag_print(resolution.choices.layout);
        _zag_println(" [derived from project config unless explicit]");
    } else { _zag_println("execution plan: generic x86-64-v1 baseline [derived]"); }
    return 0;
}

fn znc_harden_space(src: []u8, start: i32) i32 {
    let i: i32 = start;
    while (i < src.len) {
        if (src[i] == ' ' || src[i] == '\t' || src[i] == '\r' || src[i] == '\n') { i = i + 1; }
        else if (i + 1 < src.len && src[i] == '/' && src[i + 1] == '/') {
            i = i + 2; while (i < src.len && src[i] != '\n') { i = i + 1; }
        } else { return i; }
    }
    return i;
}

fn znc_harden_decl_start(src: []u8, at: i32) i32 {
    let rest: []u8 = src[at..src.len];
    if (starts_with(rest, "fn ") || starts_with(rest, "pub fn ") ||
        starts_with(rest, "struct ") || starts_with(rest, "pub struct ") ||
        starts_with(rest, "enum ") || starts_with(rest, "pub enum ") ||
        starts_with(rest, "union ") || starts_with(rest, "pub union ") ||
        starts_with(rest, "error ") || starts_with(rest, "const ") ||
        starts_with(rest, "interface ") || starts_with(rest, "operator ") ||
        starts_with(rest, "extern fn ") || starts_with(rest, "@import")) { return 1; }
    return 0;
}

// Return one complete top-level declaration boundary. Strings and line comments
// do not contribute braces. A semicolon terminates imports, constants, and
// prototypes; a balanced outer brace terminates definition declarations.
fn znc_harden_decl_end(src: []u8, start: i32) i32 {
    let i: i32 = start;
    let depth: i32 = 0;
    let saw_brace: i32 = 0;
    let in_string: i32 = 0;
    while (i < src.len) {
        if (in_string == 1) {
            if (src[i] == '\\' && i + 1 < src.len) { i = i + 2; }
            else { if (src[i] == '"') { in_string = 0; } i = i + 1; }
        } else if (src[i] == '"') { in_string = 1; i = i + 1; }
        else if (i + 1 < src.len && src[i] == '/' && src[i + 1] == '/') {
            i = i + 2; while (i < src.len && src[i] != '\n') { i = i + 1; }
        } else {
            if (src[i] == '{') { depth = depth + 1; saw_brace = 1; }
            else if (src[i] == '}') {
                depth = depth - 1;
                if (saw_brace == 1 && depth == 0) { return i + 1; }
            } else if (src[i] == ';' && saw_brace == 0) { return i + 1; }
            i = i + 1;
        }
    }
    return 0 - 1;
}

struct ZHardenScriptMarker { start:i32, end:i32, valid:i32 }

fn znc_harden_token_offset(src:[]u8, token:Token) i32 {
    let line:i32=1;
    let at:i32=0;
    while(at<src.len&&line<token.line){if(src[at]=='\n'){line=line+1;}at=at+1;}
    if(line!=token.line||token.col<1){return -1;}
    let offset:i32=at+token.col-1;
    if(offset<0||offset>=src.len){return -1;}
    return offset;
}

// The compilation unit already carries the authoritative profile. This helper
// only recovers the lexer-confirmed source span needed to retain leading
// comments and declarations in the rendered candidate; it never treats a
// comment or string containing `script;` as a profile declaration. The end
// comes from the semicolon token rather than assuming the bytes are adjacent.
fn znc_harden_script_marker(src: []u8) ZHardenScriptMarker {
    let tokens:ArrayList[Token]=lex(src);
    let i:i32=0;
    while(i+1<tokens.len){
        let marker:Token=tokens.data[i];
        if(marker.kind==Tk.Ident&&@strEq(marker.val,"script")&&tokens.data[i+1].kind==Tk.Semi){
            let start:i32=znc_harden_token_offset(src,marker);
            let semi:i32=znc_harden_token_offset(src,tokens.data[i+1]);
            if(start>=0&&semi>=start){return ZHardenScriptMarker{.start=start,.end=semi+1,.valid=1};}
            return ZHardenScriptMarker{.start=-1,.end=-1,.valid=0};
        }
        i=i+1;
    }
    return ZHardenScriptMarker{.start=-1,.end=-1,.valid=0};
}

// Harden works from the normal Script-bound root body, not from a second
// parser or a substring heuristic. A bound convenience has an implicit
// context/capability contract that this conservative strict candidate cannot
// rewrite exactly yet, so it remains an explicit unsupported item.
fn znc_harden_bound_script_call(name: []u8) i32 {
    if (znc_script_alloc_call(name) == 1 || starts_with(name, "script_list") ||
        starts_with(name, "string_builder_")) { return 1; }
    if (@strEq(name, "_zag_print") || @strEq(name, "_zag_println") ||
        @strEq(name, "_zag_write_file") || @strEq(name, "_zag_argc") ||
        @strEq(name, "_zag_arg") || @strEq(name, "_zag_script_alloc") ||
        @strEq(name, "_zag_script_alloc_used")) { return 1; }
    return 0;
}

fn znc_harden_expr_has_try(n:*Node) i32 {
    switch(n.*) {
        .un => |x| { if(@strEq(x.op,"try")){return 1;}return znc_harden_expr_has_try(x.e); }
        .call => |x| { let i:i32=0;while(i<x.args.len){if(znc_harden_expr_has_try(x.args.data[i])==1){return 1;}i=i+1;}return znc_harden_expr_has_try(x.callee); }
        .bin => |x| { return znc_harden_expr_has_try(x.l)|znc_harden_expr_has_try(x.r); }
        .fld => |x| { return znc_harden_expr_has_try(x.base); }
        .idx => |x| { return znc_harden_expr_has_try(x.base)|znc_harden_expr_has_try(x.idx); }
        .cast_ => |x| { return znc_harden_expr_has_try(x.expr); }
        .slice_ => |x| { let found:i32=znc_harden_expr_has_try(x.base)|znc_harden_expr_has_try(x.lo);if(x.has_hi==1){found=found|znc_harden_expr_has_try(x.hi);}return found; }
        .slit_ => |x| { let i:i32=0;while(i<x.fields.len){if(znc_harden_expr_has_try(x.fields.data[i].val)==1){return 1;}i=i+1;} }
        .switch_ => |x| { if(znc_harden_expr_has_try(x.subject)==1){return 1;}let i:i32=0;while(i<x.arms.len){if(znc_harden_body_has_try(x.arms.data[i].body)==1){return 1;}i=i+1;}return znc_harden_body_has_try(x.els_body); }
        else => { }
    }
    return 0;
}

fn znc_harden_body_has_try(body:ArrayList[*Node]) i32 {
    let i:i32=0;while(i<body.len){switch(body.data[i].*) {
        .let_ => |x| { if(x.has_init==1&&znc_harden_expr_has_try(x.expr)==1){return 1;} }
        .ret => |x| { if(x.has_expr==1&&znc_harden_expr_has_try(x.expr)==1){return 1;} }
        .estmt => |x| { if(znc_harden_expr_has_try(x.expr)==1){return 1;} }
        .assign => |x| { if(znc_harden_expr_has_try(x.target)==1||znc_harden_expr_has_try(x.expr)==1){return 1;} }
        .if_ => |x| { if(znc_harden_expr_has_try(x.cond)==1||znc_harden_body_has_try(x.then_body)==1||znc_harden_body_has_try(x.els_body)==1){return 1;} }
        .while_ => |x| { if(znc_harden_expr_has_try(x.cond)==1||znc_harden_body_has_try(x.body)==1){return 1;} }
        .unsafe_ => |x| { if(znc_harden_body_has_try(x.body)==1){return 1;} }
        .switch_ => |x| { if(znc_harden_expr_has_try(x.subject)==1){return 1;}let ai:i32=0;while(ai<x.arms.len){if(znc_harden_body_has_try(x.arms.data[ai].body)==1){return 1;}ai=ai+1;}if(znc_harden_body_has_try(x.els_body)==1){return 1;} }
        else => { }
    }i=i+1;}return 0;
}

fn znc_harden_root_facts(decls:ArrayList[*Node], prelude:*i32, has_try:*i32) void {
    let i:i32=0;while(i<decls.len){switch(decls.data[i].*){.fn_decl=>|f|{if(@strEq(f.name,"__zag_compiler_script_body_7f3a")){if(znc_harden_body_has_try(f.body)==1){has_try.*=1;}let names:ArrayList[[]u8]=make[[]u8](29);push[[]u8](&names,"_zag_print");push[[]u8](&names,"_zag_println");push[[]u8](&names,"_zag_write_file");push[[]u8](&names,"_zag_argc");push[[]u8](&names,"_zag_arg");push[[]u8](&names,"_zag_script_alloc");push[[]u8](&names,"_zag_script_alloc_used");push[[]u8](&names,"_zag_script_env_get");push[[]u8](&names,"script_input");push[[]u8](&names,"script_read_file");push[[]u8](&names,"script_string_concat");push[[]u8](&names,"script_string_builder_new");push[[]u8](&names,"process_run_bounded_script");push[[]u8](&names,"_zag_script_new");push[[]u8](&names,"script_args");push[[]u8](&names,"script_path_join");push[[]u8](&names,"script_path_basename");push[[]u8](&names,"script_path_dirname");push[[]u8](&names,"script_path_extension");push[[]u8](&names,"script_list1");push[[]u8](&names,"script_list2");push[[]u8](&names,"script_list3");push[[]u8](&names,"script_list4");push[[]u8](&names,"script_list_new");push[[]u8](&names,"script_list_append");push[[]u8](&names,"string_builder_append");let ni:i32=0;while(ni<names.len){if(znc_ast_body_has_call(f.body,names.data[ni])==1){prelude.*=1;}ni=ni+1;}return;}}else=>{}}i=i+1;}
}

fn znc_harden_bit(value:i32)[]u8 { if(value==1){return "1";}return "0"; }
fn znc_harden_explicit_header(config:PlannerConfig)[]u8 {
    let resolved:PlannerResolution = planner_resolve(1, "", config,
        znc_script_explicit_choices(), 0);
    let capability_bits:i64 = znc_script_capability_bits(config);
    let execution_policy:i64 = znc_script_execution_policy(resolved);
    let header:[]u8="\n// Generated by znc harden. These declarations make the former Script runtime policy explicit.\nconst __zag_hardened_script_memory_limit: i64 = ";
    header=_zag_str_concat(header,_zag_i64_to_str(config.script_memory_bytes));
    header=_zag_str_concat(header,_zag_str_concat(";\nconst __zag_hardened_allow_filesystem_read: i32 = ",
        znc_harden_bit(config.allow_filesystem_read)));
    header=_zag_str_concat(header,_zag_str_concat(";\nconst __zag_hardened_allow_filesystem_write: i32 = ",
        znc_harden_bit(config.allow_filesystem_write)));
    header=_zag_str_concat(header,_zag_str_concat(";\nconst __zag_hardened_allow_process: i32 = ",
        znc_harden_bit(config.allow_process)));
    header=_zag_str_concat(header,_zag_str_concat(";\nconst __zag_hardened_capability_bits: i64 = ",
        _zag_i64_to_str(capability_bits)));
    header=_zag_str_concat(header,_zag_str_concat(";\n// allocator policy: ",
        resolved.choices.allocator));
    header=_zag_str_concat(header,_zag_str_concat("\nconst __zag_hardened_allocator_policy_id: i32 = ",
        _zag_i64_to_str(znc_script_allocator_policy_id(
            resolved.choices.allocator) as i64)));
    header=_zag_str_concat(header,_zag_str_concat(";\nconst __zag_hardened_execution_policy: i64 = ",
        _zag_i64_to_str(execution_policy)));
    // The public hardened candidate stays valid in frozen edition 2026. Its
    // context handle is an opaque byte pointer at the ABI boundary; `*opaque`
    // is reserved for edition-2027 raw-pointer syntax.
    header=_zag_str_concat(header,
        ";\nextern fn _zag_script_context_init(limit:i64, capabilities:i64, execution_policy:i64) *u8\nextern fn _zag_script_context_shutdown(context:*u8) void\n\nfn __zag_hardened_status_boundary(status:i32) i32 {\n    // No propagated Script error operation was present in this candidate.\n    return status;\n}\n\nfn __zag_hardened_script_body(__zag_hardened_context:*u8) i32 {\n");
    return header;
}

fn znc_harden_atomic_output(output:[]u8,text:[]u8) i32 {
    let temp:[]u8=_zag_str_concat(output,".harden.tmp");
    if(_zag_file_exists(temp)==1){_zag_eprintln(_zag_str_concat("znc harden: temporary output already exists: ",temp));return 0;}
    if(_zag_write_file(temp,text)!=0){return 0;}
    let a:ArrayList[u8]=make[u8](temp.len+1);let b:ArrayList[u8]=make[u8](output.len+1);let i:i32=0;while(i<temp.len){push[u8](&a,temp[i]);i=i+1;}push[u8](&a,0 as u8);i=0;while(i<output.len){push[u8](&b,output[i]);i=i+1;}push[u8](&b,0 as u8);
    let renamed:i64=_zag_raw_syscall(82,_zag_slice_ptr(a.data[0..a.len]) as i64,_zag_slice_ptr(b.data[0..b.len]) as i64,0,0,0,0);
    if(renamed!=0){let _cleanup:i64=_zag_raw_syscall(87,_zag_slice_ptr(a.data[0..a.len]) as i64,0,0,0,0,0);return 0;}
    return 1;
}

fn znc_harden_unsupported_items(prelude:i32, root_try:i32, late:i32, reserved:i32, invalid:i32)[]u8 {
    let out:[]u8="[";
    let first:i32=1;
    if(prelude==1){out=_zag_str_concat(out,"{\"kind\":\"script_prelude\",\"basis\":\"proven\",\"reason\":\"compiler-bound prelude call needs explicit API and policy translation\"}");first=0;}
    if(root_try==1){if(first==0){out=_zag_str_concat(out,",");}out=_zag_str_concat(out,"{\"kind\":\"error_boundary\",\"basis\":\"proven\",\"reason\":\"root try propagation needs an explicit strict error model\"}");first=0;}
    if(late==1){if(first==0){out=_zag_str_concat(out,",");}out=_zag_str_concat(out,"{\"kind\":\"declaration_order\",\"basis\":\"proven\",\"reason\":\"declaration follows executable top-level statement\"}");first=0;}
    if(reserved==1){if(first==0){out=_zag_str_concat(out,",");}out=_zag_str_concat(out,"{\"kind\":\"private_name_collision\",\"basis\":\"proven\",\"reason\":\"source uses reserved hardened wrapper prefix\"}");first=0;}
    if(invalid==1){if(first==0){out=_zag_str_concat(out,",");}out=_zag_str_concat(out,"{\"kind\":\"candidate_validation\",\"basis\":\"proven\",\"reason\":\"generated strict candidate failed compiler validation\"}");}
    return _zag_str_concat(out,"]");
}

fn znc_harden_text_unsupported(prelude:i32, root_try:i32, late:i32, reserved:i32, invalid:i32)void {
    if(prelude==1){_zag_println("unsupported: script_prelude [proven] compiler-bound prelude call needs explicit API and policy translation");}
    if(root_try==1){_zag_println("unsupported: error_boundary [proven] root try propagation needs an explicit strict error model");}
    if(late==1){_zag_println("unsupported: declaration_order [proven] declaration follows executable top-level statement");}
    if(reserved==1){_zag_println("unsupported: private_name_collision [proven] source uses reserved hardened wrapper prefix");}
    if(invalid==1){_zag_println("unsupported: candidate_validation [proven] generated strict candidate failed compiler validation");}
}

fn znc_harden(path: []u8) i32 {
    if (path.len == 0) { _zag_eprintln("znc harden: no source file"); return 1; }
    let source_snapshot: []u8 = _zag_read_file(path);
    if (source_snapshot.len < 0) { _zag_eprintln("znc harden: cannot read source file"); return 1; }
    let src:[]u8=script_syntax_normalize(znc_activate_script_source(path,source_snapshot,0));
    let unit: CompilationUnit = parse_compilation_unit_dir(src, dir_of(path));
    if (unit.profile != ModuleProfile.script) {
        _zag_eprintln("znc harden: source is already regular Zag; no script profile to expand");
        return 1;
    }
    if(znc_validate_script_defaults(path,unit)!=0){return 1;}
    if(znc_configure_script_unit(&unit,path)!=0){return 1;}
    if(znc_validate_script_capabilities(path,unit)!=0){return 1;}
    let config:PlannerConfig=znc_project_config(znc_project_root(dir_of(path)),0);
    let harden_input:PlannerChoices=znc_script_explicit_choices();
    let harden_resolution:PlannerResolution=planner_resolve(1,"",config,
        harden_input,0);
    let marker:ZHardenScriptMarker=znc_harden_script_marker(src);
    if (marker.valid == 0) { _zag_eprintln("znc harden: script marker not found"); return 1; }
    let cursor: i32 = marker.end;
    let declarations: []u8 = "";
    let body_start: i32 = cursor;
    let scanning: i32 = 1;
    while (scanning == 1) {
        let decl_start: i32 = znc_harden_space(src, cursor);
        if (decl_start < src.len && znc_harden_decl_start(src, decl_start) == 1) {
            let decl_end: i32 = znc_harden_decl_end(src, decl_start);
            if (decl_end < 0) { _zag_eprintln("znc harden: unterminated declaration"); return 1; }
            declarations = _zag_str_concat(declarations, src[cursor..decl_end]);
            cursor = decl_end; body_start = cursor;
        } else { body_start = cursor; scanning = 0; }
    }
    // Moving declarations that occur after execution could reorder observable
    // initialization. Reject them instead of guessing.
    let later: i32 = znc_harden_space(src, body_start);
    let late_declaration:i32=0;
    let line: i32 = later;
    while (line < src.len) {
        if ((line == 0 || src[line - 1] == '\n') && znc_harden_decl_start(src, znc_harden_space(src, line)) == 1) {
            late_declaration=1;
        }
        while (line < src.len && src[line] != '\n') { line = line + 1; }
        if (line < src.len) { line = line + 1; }
    }
    let unresolved_prelude:i32=0;
    let root_try:i32=0;
    znc_harden_root_facts(unit.decls,&unresolved_prelude,&root_try);
    // Names in this reserved private prefix would make the generated wrapper
    // ambiguous. Do not rename user symbols or silently take ownership of them.
    let reserved_conflict:i32=contains_text(src,"__zag_hardened_");
    let supported:i32=((unresolved_prelude==0&&root_try==0&&late_declaration==0&&reserved_conflict==0) as i32);
    let candidate:[]u8="";
    if(supported==1){
        let header:[]u8=znc_harden_explicit_header(config);
        candidate=_zag_str_concat(src[0..marker.start],declarations);
        candidate=_zag_str_concat(candidate,header);
        candidate=_zag_str_concat(candidate,src[body_start..src.len]);
        candidate=_zag_str_concat(candidate,"\n}\n\nfn main() i32 {\n    let __zag_hardened_context:*u8 = _zag_script_context_init(__zag_hardened_script_memory_limit, __zag_hardened_capability_bits, __zag_hardened_execution_policy) as *u8;\n    let __zag_hardened_status:i32 = __zag_hardened_script_body(__zag_hardened_context);\n    _zag_script_context_shutdown(__zag_hardened_context);\n    return __zag_hardened_status_boundary(__zag_hardened_status);\n}\n");
    }
    let output: []u8 = flag_value("--output");
    let report_format:[]u8=flag_value("--format");
    if (report_format.len>0&&znc_format_text(report_format)==0&&znc_format_json(report_format)==0){_zag_eprintln("znc harden: --format must be text or json");return 1;}
    if(output.len>0&&@strEq(output,path)){_zag_eprintln("znc harden: --output must not name the source file");return 1;}
    let candidate_valid:i32=supported;
    if(candidate_valid==1&&znc_check_src(path,candidate)!=0){candidate_valid=0;}
    if (has_flag("--apply")==1) {
        if(candidate_valid==0){_zag_eprintln("znc harden: apply refused: no semantics-preserving strict candidate is available; inspect the structured unsupported report");return 1;}
        let test_command:[]u8=flag_value("--test-command");
        if(test_command.len==0){_zag_eprintln("znc harden: --apply requires --test-command so behavioral parity is tested");return 1;}
        let current:[]u8=_zag_read_file(path);
        if(current.len<0||@strEq(current,source_snapshot)==0){_zag_eprintln("znc harden: source changed after snapshot; refusing apply");return 1;}
        let backup:[]u8=_zag_str_concat(path,".harden.bak");
        if(_zag_file_exists(backup)==1){_zag_eprintln(_zag_str_concat("znc harden: rollback file already exists: ",backup));return 1;}
        if(znc_check_src(path,candidate)!=0){_zag_eprintln("znc harden: generated candidate failed strict semantic checking");return 1;}
        if(_zag_write_file(backup,source_snapshot)!=0){_zag_eprintln("znc harden: failed to create rollback copy");return 1;}
        if(_zag_write_file(path,candidate)!=0){let _restore:i32=_zag_write_file(path,source_snapshot);_zag_eprintln("znc harden: apply write failed; source restored");return 1;}
        let test_rc:i32=_zag_exec_cmd(test_command);
        if(test_rc!=0){let restored:i32=_zag_write_file(path,source_snapshot);if(restored!=0){_zag_eprintln("znc harden: parity tests failed and automatic rollback failed");return 1;}_zag_eprintln("znc harden: parity tests failed; source restored from snapshot");return 1;}
        if(znc_format_json(report_format)==1){_zag_println(_zag_str_concat("{\"schema_version\":1,\"status\":\"applied\",\"source_modified\":true,\"rollback\":\"",_zag_str_concat(znc_json_escape(backup),"\",\"tests\":\"passed\"}")));}else{_zag_println(_zag_str_concat("harden applied; rollback copy: ",backup));}
        return 0;
    }
    if (output.len > 0 && candidate_valid==1) {
        if (znc_harden_atomic_output(output, candidate) == 0) { _zag_eprintln("znc harden: failed to atomically write candidate"); return 1; }
        if (znc_format_json(report_format)==0){_zag_println(_zag_str_concat("harden candidate written: ", output));}
    } else if (output.len==0 && candidate_valid==1 && znc_format_json(report_format)==0) {
        _zag_print(candidate);
    }
    if (znc_format_json(report_format)==1){
        let rendered:[]u8="";if(output.len==0&&candidate_valid==1){rendered=znc_json_escape(candidate);}
        let status:[]u8="unsupported";if(candidate_valid==1){status="preview";}
        let unsupported:[]u8=znc_harden_unsupported_items(unresolved_prelude,root_try,late_declaration,reserved_conflict,(supported==1&&candidate_valid==0) as i32);
        _zag_print("{\"schema_version\":2,\"status\":\"");_zag_print(status);
        _zag_print("\",\"candidate_compilable\":");_zag_print(znc_json_bool(candidate_valid));
        _zag_print(",\"candidate_checked\":");_zag_print(znc_json_bool(candidate_valid));
        _zag_print(",\"source_modified\":false,\"allocator_policy\":{\"value\":\"");
        _zag_print(znc_json_escape(harden_resolution.choices.allocator));
        _zag_print("\",\"id\":");_zag_print(_zag_i64_to_str(
            znc_script_allocator_policy_id(harden_resolution.choices.allocator) as i64));
        _zag_print(",\"basis\":\"");
        if(harden_input.allocator_explicit==1){_zag_print("explicit");}else{_zag_print("derived");}
        _zag_print("\",\"reclamation\":\"");
        _zag_print(znc_json_escape(znc_script_allocator_reclamation(
            harden_resolution.choices.allocator)));
        _zag_print("\"},\"output\":\"");_zag_print(znc_json_escape(output));
        _zag_print("\",\"candidate\":\"");_zag_print(rendered);
        _zag_print("\",\"assumptions\":[\"top-level source order is preserved inside explicit body\",\"Script memory and capability policy constants are explicit\",\"no propagated root error operation is present\"],\"parity_tests\":[\"stdout stderr and exit parity\",\"nonzero status parity\",\"filesystem/process capability denial\",\"allocation-limit behavior\"],\"unsupported\":");
        _zag_print(unsupported);_zag_println("}");
        return 0;
    }
    if(candidate_valid==0){
        _zag_println("harden status: unsupported; no strict candidate was written");
        znc_harden_text_unsupported(unresolved_prelude,root_try,late_declaration,reserved_conflict,(supported==1&&candidate_valid==0) as i32);
    }else{
        _zag_println("harden status: preview; explicit strict-Zag candidate passed compiler validation");
        _zag_println("harden report: conservative explicit context/allocator/capability expansion");
        _zag_println("assumptions: top-level source order and status return are preserved; no propagated root error operation is present");
        _zag_print("explicit policy: allocator=");
        _zag_print(harden_resolution.choices.allocator);
        _zag_print(" id=");
        _zag_print(_zag_i64_to_str(znc_script_allocator_policy_id(
            harden_resolution.choices.allocator) as i64));
        _zag_print("; ");
        _zag_print(znc_script_allocator_reclamation(
            harden_resolution.choices.allocator));
        _zag_println("; script memory and filesystem/process capability constants; context init/shutdown around root body");
        _zag_println("error boundary: explicit status boundary is identity because no root try propagation was present [proven]");
        _zag_println("tests required: stdout/stderr and exit parity; nonzero status parity; filesystem/process capability denial; allocation-limit behavior");
    }
    return 0;
}

fn znc_init() i32 {
    let modpath: []u8 = "zag.mod";
    if (_zag_file_exists(modpath) != 0) {
        _zag_println("znc init: zag.mod already exists");
        return 1;
    }
    let content: []u8 = "name = \"myproject\"\nversion = \"2026.07.0-dev\"\nedition = \"2026\"\n";
    let wrc: i32 = _zag_write_file(modpath, content);
    if (wrc != 0) { _zag_println("znc init: failed to write zag.mod"); return 1; }
    _zag_println("znc init: created zag.mod");
    return 0;
}

// First non-flag argv entry at or after `start` ("" if none).
fn first_nonflag_from(start: i32) []u8 {
    let i: i32 = start;
    while (i < _zag_argc()) {
        let a: []u8 = _zag_arg(i);
        if (a.len > 0 && a[0] != '-') { return a; }
        i = i + 1;
    }
    return "";
}

fn znc_parent_dir(path: []u8) []u8 {
    let end: i32 = path.len;
    while (end > 1 && path[end - 1] == '/') { end = end - 1; }
    let i: i32 = end - 1;
    while (i >= 0 && path[i] != '/') { i = i - 1; }
    if (i < 0) { return "."; }
    if (i == 0) { return "/"; }
    return path[0..i];
}

fn znc_cwd() []u8 {
    let buf: ArrayList[u8] = make[u8](4096);
    while (buf.len < 4096) { push[u8](&buf, 0 as u8); }
    let rc: i64 = _zag_raw_syscall(79, _zag_slice_ptr(buf.data[0..buf.len]) as i64, buf.len, 0, 0, 0, 0);
    if (rc <= 1) { return "."; }
    return buf.data[0..(rc as i32) - 1];
}

fn znc_absolute_dir(path: []u8) []u8 {
    if (path.len > 0 && path[0] == '/') { return path; }
    if (@strEq(path, ".")) { return znc_cwd(); }
    return _zag_str_concat(znc_cwd(), _zag_str_concat("/", path));
}

fn znc_project_root(start: []u8) []u8 {
    let cur: []u8 = znc_absolute_dir(start);
    let fallback: []u8 = cur;
    let steps: i32 = 0;
    while (steps < 64) {
        if (_zag_file_exists(_zag_str_concat(cur, "/zag.mod")) == 1) { return cur; }
        let parent: []u8 = znc_parent_dir(cur);
        if (@strEq(parent, cur)) { return fallback; }
        cur = parent;
        steps = steps + 1;
    }
    return fallback;
}

fn znc_project_relative(root:[]u8,path:[]u8)[]u8{
    let absolute:[]u8=path;if(path.len==0){return path;}if(path[0]!='/'){absolute=_zag_str_concat(znc_cwd(),_zag_str_concat("/",path));}
    if(absolute.len>root.len&&@strEq(absolute[0..root.len],root)&&absolute[root.len]=='/'){return absolute[root.len+1..];}
    return path;
}

fn znc_publish_semantics(path:[]u8,src:[]u8,unit:CompilationUnit,decls:ArrayList[*Node],eff:map__StringMap[i32])i32{
    let root:[]u8=znc_project_root(dir_of(path));let module_path:[]u8=znc_project_relative(root,path);return semantic_manifest_publish(root,module_path,src,unit,eff);
}

fn znc_contains(haystack: []u8, needle: []u8) i32 {
    if (needle.len == 0 || needle.len > haystack.len) { return 0; }
    let i: i32 = 0;
    while (i + needle.len <= haystack.len) {
        let j: i32 = 0;
        let same: i32 = 1;
        while (j < needle.len) { if (haystack[i + j] != needle[j]) { same = 0; } j = j + 1; }
        if (same == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn znc_project_config(root: []u8, warn_invalid: i32) PlannerConfig {
    let cfg: []u8 = _zag_read_file(_zag_str_concat(root, "/.zagd.conf"));
    if (cfg.len < 0) { return planner_default_config(); }
    let parsed: PlannerConfig = planner_parse_config(cfg);
    if (parsed.valid == 0) {
        if (warn_invalid == 1) {
            _zag_eprintln(_zag_str_concat("znc: warning: ", _zag_str_concat(parsed.diagnostic, "; using documented defaults")));
        }
        return planner_default_config();
    }
    return parsed;
}

fn znc_project_mode(root: []u8) []u8 {
    let parsed: PlannerConfig = znc_project_config(root, 1);
    if (@strEq(parsed.mode, "advisory")) { return "light"; }
    return parsed.mode;
}

fn znc_script_capability_bits(cfg:PlannerConfig) i64 {
    // Environment bit 3 is granted only when the project has an exact
    // allowlist. Network and device have no Script prelude API, so their
    // reserved bits remain zero instead of fabricating permissions.
    return (cfg.allow_filesystem_read as i64) +
        ((cfg.allow_filesystem_write as i64) * 2) +
        ((cfg.allow_process as i64) * 4) +
        (((cfg.environment_allow.len > 0) as i64) * 8);
}

fn znc_script_cpu_policy_id(name:[]u8) i32 {
    let profile:X86CpuProfile = parse_x86_cpu_profile(name);
    if (profile.valid == 0) { return 0; }
    if (profile.request_kind == 2) { return 2; }
    if (profile.request_kind == 4) { return 0; }
    return 1;
}

fn znc_script_allocator_policy_id(name:[]u8) i32 {
    if (@strEq(name, "script_process_arena")) { return 1; }
    if (@strEq(name, "script_bounded_heap")) { return 2; }
    return 0;
}

fn znc_script_allocator_reclamation(name:[]u8) []u8 {
    if (@strEq(name, "script_bounded_heap")) {
        return "all tracked bounded-heap blocks freed at generated shutdown";
    }
    return "one bounded Script arena unmapped at generated shutdown";
}

fn znc_script_execution_policy(resolved:PlannerResolution) i64 {
    let device_id:i32 = 0;
    let layout_id:i32 = 0;
    if (@strEq(resolved.choices.device, "cpu")) { device_id = 1; }
    if (@strEq(resolved.choices.layout, "compiler_owned")) { layout_id = 1; }
    return script_execution_policy_bits(
        znc_script_allocator_policy_id(resolved.choices.allocator),
        znc_script_cpu_policy_id(resolved.choices.cpu), device_id, layout_id);
}

fn znc_configure_script_unit(unit: *CompilationUnit, path: []u8) i32 {
    if (unit.*.profile != ModuleProfile.script) { return 0; }
    let root: []u8 = znc_project_root(dir_of(path));
    let cfg: PlannerConfig = znc_project_config(root, 0);
    let input: PlannerChoices = znc_script_explicit_choices();
    let resolved: PlannerResolution = planner_resolve(1, "", cfg, input, 0);
    // These are the only runtime choices implemented today. Rejecting other
    // configured values happens in the foreground build before codegen.
    let configured: i32 = compilation_unit_set_script_memory_limit(unit, cfg.script_memory_bytes);
    let runtime_policy:i32 = compilation_unit_set_script_runtime_policy(unit,
        znc_script_capability_bits(cfg), znc_script_execution_policy(resolved));
    let source_label: i32 = compilation_unit_set_script_source_label(unit, path);
    if(configured!=0||runtime_policy!=0||source_label!=0){
        _zag_eprintln("znc: internal error: could not configure compiler-owned Script entry policy");
        return 1;
    }
    return 0;
}


fn znc_validate_script_defaults(path: []u8, unit: CompilationUnit) i32 {
    if (unit.profile != ModuleProfile.script) { return 0; }
    let cfg: PlannerConfig = znc_project_config(znc_project_root(dir_of(path)), 1);
    let input: PlannerChoices = znc_script_explicit_choices();
    let r: PlannerResolution = planner_resolve(1, "", cfg, input, 0);
    if (r.diagnostic.len > 0) { _zag_eprintln(r.diagnostic); return 1; }
    if (znc_script_allocator_policy_id(r.choices.allocator) == 0 ||
        @strEq(r.choices.device, "cpu") == 0 ||
        @strEq(r.choices.layout, "compiler_owned") == 0) {
        _zag_eprintln("znc: unsupported Zag Script planner default; supported allocator=script_process_arena or script_bounded_heap, device=cpu, layout=compiler_owned");
        return 1;
    }
    let p: X86CpuProfile = parse_x86_cpu_profile(r.choices.cpu);
    if (p.valid == 0) { _zag_eprintln(_zag_str_concat("znc: ", p.diagnostic)); return 1; }
    if (znc_script_cpu_policy_id(r.choices.cpu) == 0) {
        _zag_eprintln("znc: unsupported Zag Script CPU policy; supported cpu=generic or cpu=native");
        return 1;
    }
    return 0;
}

fn znc_script_expr_calls(n:*Node,target:[]u8)i32{
    switch(n.*){
        .call=>|c|{if(@strEq(callee_name(c.callee),target)){return 1;}let i:i32=0;while(i<len[*Node](c.args)){if(znc_script_expr_calls(get[*Node](c.args,i),target)==1){return 1;}i=i+1;}return znc_script_expr_calls(c.callee,target);}
        .bin=>|b|{return znc_script_expr_calls(b.l,target)|znc_script_expr_calls(b.r,target);}
        .un=>|u|{return znc_script_expr_calls(u.e,target);}
        .idx=>|x|{return znc_script_expr_calls(x.base,target)|znc_script_expr_calls(x.idx,target);}
        .fld=>|f|{return znc_script_expr_calls(f.base,target);}
        .cast_=>|c|{return znc_script_expr_calls(c.expr,target);}
        .slice_=>|s|{let hit:i32=znc_script_expr_calls(s.base,target)|znc_script_expr_calls(s.lo,target);if(s.has_hi==1){hit=hit|znc_script_expr_calls(s.hi,target);}return hit;}
        .slit_=>|s|{let i:i32=0;while(i<len[FieldInit](s.fields)){if(znc_script_expr_calls(get[FieldInit](s.fields,i).val,target)==1){return 1;}i=i+1;}return 0;}
        .switch_=>|s|{if(znc_script_expr_calls(s.subject,target)==1){return 1;}let i:i32=0;while(i<len[SwitchArm](s.arms)){if(znc_script_block_calls(get[SwitchArm](s.arms,i).body,target)==1){return 1;}i=i+1;}return znc_script_block_calls(s.els_body,target);}
        else=>{return 0;}
    }
}
fn znc_script_block_calls(body:ArrayList[*Node],target:[]u8)i32{
    let i:i32=0;while(i<len[*Node](body)){
        let hit:i32=0;
        switch(get[*Node](body,i).*){
            .let_=>|l|{if(l.has_init==1){hit=znc_script_expr_calls(l.expr,target);}}
            .ret=>|r|{if(r.has_expr==1){hit=znc_script_expr_calls(r.expr,target);}}
            .estmt=>|e|{hit=znc_script_expr_calls(e.expr,target);}
            .assign=>|a|{hit=znc_script_expr_calls(a.target,target)|znc_script_expr_calls(a.expr,target);}
            .if_=>|x|{hit=znc_script_expr_calls(x.cond,target)|znc_script_block_calls(x.then_body,target)|znc_script_block_calls(x.els_body,target);}
            .while_=>|w|{hit=znc_script_expr_calls(w.cond,target)|znc_script_block_calls(w.body,target);}
            .unsafe_=>|u|{hit=znc_script_block_calls(u.body,target);}
            .switch_=>|s|{hit=znc_script_expr_calls(get[*Node](body,i),target);}
            else=>{}
        }
        if(hit==1){return 1;}i=i+1;
    }return 0;
}
fn znc_script_generated_calls(unit:CompilationUnit,target:[]u8)i32{let i:i32=0;while(i<len[*Node](unit.decls)){switch(get[*Node](unit.decls,i).*){.fn_decl=>|f|{if(@strEq(f.name,"__zag_compiler_script_body_7f3a")){return znc_script_block_calls(f.body,target);}}else=>{}}i=i+1;}return 0;}

// Environment is deliberately unlike a dynamic dictionary: every Script-root
// request must use a literal simple name that appears exactly in the project
// policy. Imported strict modules are not walked here and retain their own
// explicit APIs and authority.
fn znc_environment_allow_has(list:[]u8,name:[]u8)i32{
    let start:i32=0;let i:i32=0;
    while(i<=list.len){
        if(i==list.len||list[i]==','){
            if(@strEq(list[start..i],name)){return 1;}
            start=i+1;
        }
        i=i+1;
    }
    return 0;
}
fn znc_script_environment_literal(text:[]u8)[]u8{
    // AST string tokens retain their quotes. Environment policy deliberately
    // accepts only a plain ASCII identifier, so escaped/computed names have no
    // alternate spelling to decode here.
    if(text.len<2||text[0]!='"'||text[text.len-1]!='"'){return "";}
    let value:[]u8=text[1..text.len-1];
    let i:i32=0;while(i<value.len){if(value[i]=='\\'){return "";}i=i+1;}
    return value;
}
fn znc_script_env_expr_violations(n:*Node,cfg:PlannerConfig,report:i32)i32{
    let failures:i32=0;
    switch(n.*){
        .call=>|c|{
            let name:[]u8=callee_name(c.callee);
            if(@strEq(name,"_zag_getenv")){
                if(report==1){_zag_eprintln("znc script capability: direct _zag_getenv is unavailable in Zag Script; use env(\"NAME\") with environment_allow");}
                failures=failures+1;
            }
            if(@strEq(name,"_zag_script_env_get")){
                if(c.args.len!=2){
                    if(report==1){_zag_eprintln("znc script capability: env requires one literal simple variable name");}
                    failures=failures+1;
                }else{
                    switch(c.args.data[1].*){
                        .slit=>|s|{
                            let variable:[]u8=znc_script_environment_literal(s.text);
                            if(planner_environment_name_valid(variable)==0){
                                if(report==1){_zag_eprintln("znc script capability: env requires a literal simple variable name so environment_allow can be checked");}
                                failures=failures+1;
                            }else if(znc_environment_allow_has(cfg.environment_allow,variable)==0){
                                if(report==1){_zag_eprintln(_zag_str_concat("znc script capability: env(\"",_zag_str_concat(variable,"\") denied; add the exact name to environment_allow")));}
                                failures=failures+1;
                            }
                        }
                        else=>{if(report==1){_zag_eprintln("znc script capability: env requires a literal simple variable name so environment_allow can be checked");}failures=failures+1;}
                    }
                }
            }
            failures=failures+znc_script_env_expr_violations(c.callee,cfg,report);
            let i:i32=0;while(i<c.args.len){failures=failures+znc_script_env_expr_violations(c.args.data[i],cfg,report);i=i+1;}
        }
        .bin=>|x|{failures=failures+znc_script_env_expr_violations(x.l,cfg,report)+znc_script_env_expr_violations(x.r,cfg,report);}
        .un=>|x|{failures=failures+znc_script_env_expr_violations(x.e,cfg,report);}
        .fld=>|x|{failures=failures+znc_script_env_expr_violations(x.base,cfg,report);}
        .idx=>|x|{failures=failures+znc_script_env_expr_violations(x.base,cfg,report)+znc_script_env_expr_violations(x.idx,cfg,report);}
        .cast_=>|x|{failures=failures+znc_script_env_expr_violations(x.expr,cfg,report);}
        .slice_=>|x|{failures=failures+znc_script_env_expr_violations(x.base,cfg,report)+znc_script_env_expr_violations(x.lo,cfg,report);if(x.has_hi==1){failures=failures+znc_script_env_expr_violations(x.hi,cfg,report);}}
        .slit_=>|x|{let i:i32=0;while(i<x.fields.len){failures=failures+znc_script_env_expr_violations(x.fields.data[i].val,cfg,report);i=i+1;}}
        .switch_=>|x|{failures=failures+znc_script_env_expr_violations(x.subject,cfg,report);let i:i32=0;while(i<x.arms.len){failures=failures+znc_script_env_body_violations(x.arms.data[i].body,cfg,report);i=i+1;}failures=failures+znc_script_env_body_violations(x.els_body,cfg,report);}
        else=>{}
    }
    return failures;
}
fn znc_script_env_body_violations(body:ArrayList[*Node],cfg:PlannerConfig,report:i32)i32{
    let failures:i32=0;let i:i32=0;
    while(i<body.len){
        switch(body.data[i].*){
            .let_=>|x|{if(x.has_init==1){failures=failures+znc_script_env_expr_violations(x.expr,cfg,report);}}
            .ret=>|x|{if(x.has_expr==1){failures=failures+znc_script_env_expr_violations(x.expr,cfg,report);}}
            .estmt=>|x|{failures=failures+znc_script_env_expr_violations(x.expr,cfg,report);}
            .assign=>|x|{failures=failures+znc_script_env_expr_violations(x.target,cfg,report)+znc_script_env_expr_violations(x.expr,cfg,report);}
            .if_=>|x|{failures=failures+znc_script_env_expr_violations(x.cond,cfg,report)+znc_script_env_body_violations(x.then_body,cfg,report)+znc_script_env_body_violations(x.els_body,cfg,report);}
            .while_=>|x|{failures=failures+znc_script_env_expr_violations(x.cond,cfg,report)+znc_script_env_body_violations(x.body,cfg,report);}
            .unsafe_=>|x|{failures=failures+znc_script_env_body_violations(x.body,cfg,report);}
            .switch_=>|x|{failures=failures+znc_script_env_expr_violations(x.subject,cfg,report);let ai:i32=0;while(ai<x.arms.len){failures=failures+znc_script_env_body_violations(x.arms.data[ai].body,cfg,report);ai=ai+1;}failures=failures+znc_script_env_body_violations(x.els_body,cfg,report);}
            else=>{}
        }
        i=i+1;
    }
    return failures;
}
fn znc_script_env_violations(unit:CompilationUnit,cfg:PlannerConfig,report:i32)i32{
    let i:i32=0;while(i<unit.decls.len){switch(unit.decls.data[i].*){.fn_decl=>|f|{if(@strEq(f.name,"__zag_compiler_script_body_7f3a")){return znc_script_env_body_violations(f.body,cfg,report);}}else=>{}}i=i+1;}return 0;
}

fn znc_validate_script_capabilities(path:[]u8,unit:CompilationUnit)i32{
    if(unit.profile!=ModuleProfile.script){return 0;}
    let cfg:PlannerConfig=znc_project_config(znc_project_root(dir_of(path)),1);let violations:i32=0;
    if(cfg.allow_filesystem_read==0&&znc_script_generated_calls(unit,"script_read_file")==1){_zag_eprintln("znc script capability: read_file denied by allow_filesystem_read=false");violations=violations+1;}
    if(cfg.allow_filesystem_write==0&&znc_script_generated_calls(unit,"_zag_write_file")==1){_zag_eprintln("znc script capability: write_file denied by allow_filesystem_write=false");violations=violations+1;}
    if(cfg.allow_process==0&&znc_script_generated_calls(unit,"process_run_bounded_script")==1){_zag_eprintln("znc script capability: process_run_timeout denied by allow_process=false");violations=violations+1;}
    violations=violations+znc_script_env_violations(unit,cfg,1);
    return violations;
}

fn znc_parse_pid(value: []u8) i64 {
    let result: i64 = 0;
    let i: i32 = 0;
    while (i < value.len && value[i] >= '0' && value[i] <= '9') {
        result = result * 10 + ((value[i] as i64) - 48);
        i = i + 1;
    }
    return result;
}

// POSIX-shell single quoting. Every embedded quote becomes '\''; paths never
// become shell syntax even though the existing process primitive invokes sh.
fn znc_shell_quote(value: []u8) []u8 {
    let out: []u8 = "'";
    let i: i32 = 0;
    while (i < value.len) {
        if (value[i] == '\'') { out = _zag_str_concat(out, "'\\''"); }
        else { out = _zag_str_concat(out, value[i..i + 1]); }
        i = i + 1;
    }
    return _zag_str_concat(out, "'");
}

fn znc_sibling_zagd() []u8 { return _zag_str_concat(dir_of(_zag_arg(0)), "/zagd"); }

fn znc_mode_arg() []u8 {
    let i: i32 = 2;
    while (i < _zag_argc()) {
        if (@strEq(_zag_arg(i), "--mode")) {
            if (i + 1 >= _zag_argc()) { return ""; }
            return _zag_arg(i + 1);
        }
        i = i + 1;
    }
    return "light";
}

fn znc_valid_zagd_mode(mode: []u8) i32 {
    if (@strEq(mode, "off") || @strEq(mode, "light") ||
        @strEq(mode, "adaptive") || @strEq(mode, "deep")) { return 1; }
    return 0;
}

fn znc_zagd_exec_config(root: []u8, root_source:[]u8, mode: []u8, cfg: PlannerConfig, daemonize: i32) i32 {
    let binary: []u8 = znc_sibling_zagd();
    if (_zag_file_exists(binary) == 0) { return 127; }
    let command: []u8 = znc_shell_quote(binary);
    command=_zag_str_concat(command,_zag_str_concat(" --root ",znc_shell_quote(root)));
    if(root_source.len>0){command=_zag_str_concat(command,_zag_str_concat(" --root-source ",znc_shell_quote(root_source)));}
    command=_zag_str_concat(command,_zag_str_concat(" --mode ",znc_shell_quote(mode)));
    command=_zag_str_concat(command,_zag_str_concat(" --window-ms ",_zag_i64_to_str(cfg.stability_window_ms)));
    command=_zag_str_concat(command,_zag_str_concat(" --max-memory-bytes ",_zag_i64_to_str(cfg.max_memory_bytes)));
    command=_zag_str_concat(command,_zag_str_concat(" --max-cache-bytes ",_zag_i64_to_str(cfg.max_cache_bytes)));
    command=_zag_str_concat(command,_zag_str_concat(" --max-workers ",_zag_i64_to_str(cfg.max_workers as i64)));
    command=_zag_str_concat(command,_zag_str_concat(" --notifications ",znc_shell_quote(cfg.notifications)));
    if (daemonize == 1) { command = _zag_str_concat(command, " --daemonize >/dev/null 2>/dev/null"); }
    return _zag_exec_cmd(command);
}

fn znc_zagd_exec(root: []u8, mode: []u8, window_ms: i64, daemonize: i32) i32 {
    let cfg:PlannerConfig=znc_project_config(root,0);cfg.stability_window_ms=window_ms;
    return znc_zagd_exec_config(root,"",mode,cfg,daemonize);
}

fn znc_zagd_lock_alive(root: []u8) i32 {
    let record:[]u8=_zag_read_file(_zag_str_concat(root, "/.zagd.lock"));
    return zagd_lock_identity_alive(record,root);
}

// ── cache version stamp ──────────────────────────────────────────────────────
// The foreground machine-code cache and zagd advisory records are keyed by
// compiler identity, but a bootstrap or compiler update can leave stale files
// in `.zag-cache/` that pre-date the version check.  Before any build uses the
// cache, we stamp `.zag-cache/.cache-version` with the current compiler version.
// If the stamp is missing or differs, we purge the cache directory so that no
// stale machine code or semantic record can be served.  This is a one-shot
// defensive measure — the cache is rebuilt naturally by the next build.
fn znc_cache_purge(root: []u8) void {
    let base: []u8 = _zag_str_concat(root, "/.zag-cache");
    // Remove the two subdirectories that hold all cache artifacts.
    let zagd_dir: []u8 = _zag_str_concat(base, "/zagd");
    let fg_dir: []u8 = _zag_str_concat(base, "/foreground");
    znc_unlink_tree(zagd_dir);
    znc_unlink_tree(fg_dir);
    // Also remove stale control files from a previous daemon.
    let lock: []u8 = _zag_str_concat(root, "/.zagd.lock");
    let status: []u8 = _zag_str_concat(root, "/.zagd.status");
    let stop: []u8 = _zag_str_concat(root, "/.zagd.stop");
    let ready: []u8 = _zag_str_concat(root, "/.zagd.semantic-ready");
    let rescan: []u8 = _zag_str_concat(root, "/.zagd.rescan");
    let profile: []u8 = _zag_str_concat(root, "/.zagd.profile");
    let root_src: []u8 = _zag_str_concat(root, "/.zagd.root-source");
    _zag_raw_syscall(87, _zag_slice_ptr(lock) as i64, 0, 0, 0, 0, 0);
    _zag_raw_syscall(87, _zag_slice_ptr(status) as i64, 0, 0, 0, 0, 0);
    _zag_raw_syscall(87, _zag_slice_ptr(stop) as i64, 0, 0, 0, 0, 0);
    _zag_raw_syscall(87, _zag_slice_ptr(ready) as i64, 0, 0, 0, 0, 0);
    _zag_raw_syscall(87, _zag_slice_ptr(rescan) as i64, 0, 0, 0, 0, 0);
    _zag_raw_syscall(87, _zag_slice_ptr(profile) as i64, 0, 0, 0, 0, 0);
    _zag_raw_syscall(87, _zag_slice_ptr(root_src) as i64, 0, 0, 0, 0, 0);
}

// Remove a directory tree by unlinking all files within it.  We use getdents64
// to list the directory, unlink each entry, then rmdir the directory itself.
// This is a best-effort purge — if any file is locked or busy, it remains and
// the cache validation logic will reject it by checksum.
fn znc_unlink_tree(dir: []u8) void {
    let cdir: ArrayList[u8] = fc_cstring(dir);
    // O_DIRECTORY|O_CLOEXEC|O_RDONLY = 65536|524288|0 = 589824
    let fd: i64 = _zag_raw_syscall(257, _zag_slice_ptr(cdir.data[0..cdir.len]) as i64, 589824, 0, 0, 0, 0);
    free[u8](&cdir);
    if (fd < 0) { return; }
    let buf: ArrayList[u8] = make[u8](4096);
    let running: i32 = 1;
    while (running == 1) {
        let n: i64 = _zag_raw_syscall(217, fd, _zag_slice_ptr(buf.data[0..buf.len]) as i64, buf.len, 0, 0, 0);
        if (n <= 0) { running = 0; break; }
        let off: i32 = 0;
        while (off < n) {
            let reclen: i64 = fc_u32_at(buf.data[0..buf.len], off + 16);
            // getdents64 struct: ino(8), off(8), reclen(2), type(1), name[]
            let name_start: i32 = off + 19;
            // Extract null-terminated name
            let name_end: i32 = name_start;
            while (name_end < off + (reclen as i32) && buf.data[name_end] != 0) { name_end = name_end + 1; }
            let name: []u8 = buf.data[name_start..name_end];
            // Skip "." and ".."
            if (name.len == 1 && name[0] == '.') { off = off + (reclen as i32); continue; }
            if (name.len == 2 && name[0] == '.' && name[1] == '.') { off = off + (reclen as i32); continue; }
            if (name.len > 0) {
                let full: []u8 = _zag_str_concat(_zag_str_concat(dir, "/"), name);
                let cfull: ArrayList[u8] = fc_cstring(full);
                _zag_raw_syscall(87, _zag_slice_ptr(cfull.data[0..cfull.len]) as i64, 0, 0, 0, 0, 0);
                free[u8](&cfull);
                _zag_str_free(full);
            }
            off = off + (reclen as i32);
        }
    }
    free[u8](&buf);
    let _close: i64 = _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    // rmdir the now-empty directory
    let cdir2: ArrayList[u8] = fc_cstring(dir);
    _zag_raw_syscall(84, _zag_slice_ptr(cdir2.data[0..cdir2.len]) as i64, 0, 0, 0, 0, 0);
    free[u8](&cdir2);
}

fn znc_cache_version_check(root: []u8) void {
    if (has_flag("--no-foreground-cache") == 1 && has_flag("--no-zagd") == 1) { return; }
    let base: []u8 = _zag_str_concat(root, "/.zag-cache");
    let stamp_path: []u8 = _zag_str_concat(base, "/.cache-version");
    let current: []u8 = zag_version();
    let existing: []u8 = _zag_read_file(stamp_path);
    let matches: i32 = 0;
    if (existing.len >= 0) {
        matches = @strEq(existing, current) as i32;
        _zag_free(_zag_slice_ptr(existing));
    }
    if (matches == 0) {
        // Version mismatch (or first run) — purge stale cache and write stamp.
        znc_cache_purge(root);
        // Recreate the base directory and write the version stamp.
        let _mk: i32 = fc_mkdir(base);
        let _wr: i32 = _zag_write_file(stamp_path, current);
    }
    _zag_str_free(base);
    _zag_str_free(stamp_path);
}

fn znc_zagd_ensure(root: []u8, root_source:[]u8) void {
    // Foreground correctness and release-authority checks can opt out for one
    // invocation. Project policy remains unchanged and the next normal source
    // command resumes automatic monitoring.
    if (has_flag("--no-zagd") == 1) { return; }
    // A running daemon keeps the root source selected at its own launch.
    // Foreground commands must not mutate that authority through a shared
    // control file, or a small watched project can be redirected into a
    // self-host compiler check inside the daemon's memory budget.
    let config: PlannerConfig = znc_project_config(root, 1);
    let mode: []u8 = config.mode;
    if (@strEq(mode, "advisory")) { mode = "light"; }
    let lock_path: []u8 = _zag_str_concat(root, "/.zagd.lock");
    let alive: i32 = znc_zagd_lock_alive(root);
    if (@strEq(mode, "off")) {
        if (alive == 1) {
            let stopped: i32 = znc_zagd_exec(root, "off", config.stability_window_ms, 0);
            if (stopped != 0) {
                _zag_eprintln("znc: warning: could not stop zagd requested by mode=off; foreground compilation continues");
            }
        }
        return;
    }
    if (alive == 1) {
        let status: []u8 = _zag_read_file(_zag_str_concat(root, "/.zagd.status"));
        if (znc_contains(status, _zag_str_concat("mode=", _zag_str_concat(mode, "\n")))) { return; }
        let stopped: i32 = znc_zagd_exec(root, "off", config.stability_window_ms, 0);
        if (stopped != 0) {
            _zag_eprintln("znc: warning: could not change zagd mode; foreground compilation continues");
            return;
        }
    }
    let rc: i32 = znc_zagd_exec_config(root, root_source, mode, config, 1);
    if (rc != 0 && rc != 6) {
        _zag_eprintln("znc: warning: zagd unavailable; foreground compilation continues without background planning");
    }
}

fn znc_output_format() i32 {
    let i: i32 = 2;
    while (i < _zag_argc()) {
        if (@strEq(_zag_arg(i), "--format")) {
            if (i + 1 >= _zag_argc()) { return 0 - 1; }
            if (@strEq(_zag_arg(i + 1), "text")) { return 0; }
            if (@strEq(_zag_arg(i + 1), "json")) { return 1; }
            return 0 - 1;
        }
        i = i + 1;
    }
    return 0;
}

fn znc_json_escape(value: []u8) []u8 {
    let out: []u8 = "";
    let i: i32 = 0;
    while (i < value.len) {
        if (value[i] == '"') { out = _zag_str_concat(out, "\\\""); }
        else if (value[i] == '\\') { out = _zag_str_concat(out, "\\\\"); }
        else if (value[i] == '\n') { out = _zag_str_concat(out, "\\n"); }
        else if (value[i] == '\r') { out = _zag_str_concat(out, "\\r"); }
        else if (value[i] == '\t') { out = _zag_str_concat(out, "\\t"); }
        else { out = _zag_str_concat(out, value[i..i + 1]); }
        i = i + 1;
    }
    return out;
}

fn znc_watch() i32 {
    let root_source:[]u8="";let wi:i32=2;
    while(wi<_zag_argc()){
        let wa:[]u8=_zag_arg(wi);
        if((@strEq(wa,"--mode")||@strEq(wa,"--root-source"))&&wi+1<_zag_argc()){if(@strEq(wa,"--root-source")){root_source=_zag_arg(wi+1);}wi=wi+2;}
        else{if(wa.len>0&&wa[0]!='-'&&root_source.len==0){root_source=wa;}wi=wi+1;}
    }
    let root_base:[]u8=".";if(root_source.len>0){root_base=dir_of(root_source);}
    let root: []u8 = znc_project_root(root_base);
    if(root_source.len==0){if(_zag_file_exists(_zag_str_concat(root,"/main.zag"))==1){root_source="main.zag";}else if(_zag_file_exists(_zag_str_concat(root,"/app.zag"))==1){root_source="app.zag";}}
    let mode: []u8 = znc_mode_arg();
    if (znc_valid_zagd_mode(mode) == 0) {
        _zag_eprintln("znc watch: --mode must be off, light, adaptive, or deep");
        return 2;
    }
    let config: PlannerConfig = znc_project_config(root, 1);
    if (@strEq(mode, "off")) { return znc_zagd_exec(root, "off", config.stability_window_ms, 0); }
    // A mode change is explicit and deterministic: stop the old singleton,
    // then start one replacement. No source is rewritten.
    if (_zag_file_exists(_zag_str_concat(root, "/.zagd.lock")) == 1) {
        let stopped: i32 = znc_zagd_exec(root, "off", config.stability_window_ms, 0);
        if (stopped != 0) { return stopped; }
    }
    let rc: i32 = znc_zagd_exec_config(root, root_source, mode, config, 1);
    if (rc == 127) { _zag_eprintln("znc watch: sibling zagd executable is missing; run bootstrap.sh or make zagd"); }
    return rc;
}

fn znc_zagd_status() i32 {
    let root: []u8 = znc_project_root(".");
    let status: []u8 = _zag_read_file(_zag_str_concat(root, "/.zagd.status"));
    let active: i32 = znc_zagd_lock_alive(root);
    let json: i32 = znc_output_format();
    if (json < 0) { _zag_eprintln("znc status: --format must be text or json"); return 2; }
    if (status.len < 0) {
        if (json == 1) { _zag_println("{\"running\":false,\"status\":\"missing\"}"); }
        else { _zag_println("zagd status: not running (no status record)"); }
        return 1;
    }
    if (json == 1) {
        let running: []u8 = "false"; if (active == 1) { running = "true"; }
        _zag_println(_zag_str_concat("{\"running\":", _zag_str_concat(running,
            _zag_str_concat(",\"status_text\":\"", _zag_str_concat(znc_json_escape(status), "\"}")))));
    } else {
        if (active == 0) { _zag_println("zagd status: stale record; no active singleton lock"); }
        _zag_print(status);
    }
    if (active == 1) { return 0; }
    return 1;
}

fn znc_zagd_shutdown() i32 {
    let root: []u8 = znc_project_root(".");
    let config: PlannerConfig = znc_project_config(root, 0);
    let rc: i32 = znc_zagd_exec(root, "off", config.stability_window_ms, 0);
    if (rc == 127) { _zag_eprintln("znc shutdown: sibling zagd executable is missing"); }
    return rc;
}

fn znc_manifest_fact_count(text:[]u8,needle:[]u8)i32{if(semantic_manifest_decode(text).valid==0){return 0;}let count:i32=0;let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>8&&@strEq(line[0..8],"fact_fn=")&&smf_line_has(line,needle)){count=count+1;}start=i+1;}i=i+1;}return count;}
fn znc_manifest_value_unknown_count(text:[]u8)i32{if(semantic_manifest_decode(text).valid==0){return 0;}let count:i32=0;let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>11&&@strEq(line[0..11],"value_type=")&&smf_line_has(line,"\tbasis=unknown")){count=count+1;}start=i+1;}i=i+1;}return count;}
fn znc_manifest_path_safe(path:[]u8)i32{
    if(path.len==0||path[0]=='/'||path[path.len-1]=='/'||path[0]=='\\'){return 0;}
    let segment:i32=0;let i:i32=0;
    while(i<=path.len){
        if(i==path.len||path[i]=='/'){
            let part:[]u8=path[segment..i];
            if(part.len==0||@strEq(part,".")||@strEq(part,"..")){return 0;}
            segment=i+1;
        } else if(path[i]=='\\'||path[i]=='\n'||path[i]=='\r'||path[i]=='\t'){return 0;}
        i=i+1;
    }
    return 1;
}
fn znc_manifest_modules_current(root:[]u8,text:[]u8)i32{
    let manifest:SemanticManifestView=semantic_manifest_decode(text);if(manifest.valid==0){return 0;}
    let found:i32=0;let start:i32=0;let i:i32=0;
    while(i<=text.len){
        if(i==text.len||text[i]=='\n'){
            let line:[]u8=text[start..i];
            if(line.len>12&&@strEq(line[0..12],"module_node=")){
                let node:[]u8=line[12..];let tab:i32=0;while(tab<node.len&&node[tab]!='\t'){tab=tab+1;}
                if(tab==node.len){return 0;}
                let name:[]u8=node[0..tab];if(znc_manifest_path_safe(name)==0){return 0;}
                let path:[]u8=_zag_str_concat(root,_zag_str_concat("/",name));let bytes:[]u8=_zag_read_file(path);if(bytes.len<0){return 0;}
                let source:[]u8=bytes;let activated:i32=0;
                if(@strEq(name,manifest.module)&&source_path_is_zs(path)==1&&source_starts_script(bytes)==0){
                    source=_zag_str_concat("script;\n",bytes);activated=1;
                }
                let current:ZagdHash=zagd_content_hash(source);
                if(activated==1){_zag_free(_zag_slice_ptr(source));}
                _zag_free(_zag_slice_ptr(bytes));
                if(zagd_hash_equal(current,smf_hash(node[tab+1..]))==0){return 0;}
                found=found+1;
            }
            start=i+1;
        }
        i=i+1;
    }
    return (found>0) as i32;
}
// Exact module-source matching closes the race between a parsed foreground
// unit and the transactionally published semantic record. A concurrently
// published manifest for another root/import state is an optimization miss.
fn znc_profile_manifest_module_count(text:[]u8,name:[]u8,want:ZagdHash)i32{
    let matches:i32=0;let start:i32=0;let i:i32=0;
    while(i<=text.len){
        if(i==text.len||text[i]=='\n'){
            let line:[]u8=text[start..i];
            if(line.len>12&&@strEq(line[0..12],"module_node=")){
                let node:[]u8=line[12..];let tab:i32=0;while(tab<node.len&&node[tab]!='\t'){tab=tab+1;}
                if(tab<node.len&&@strEq(node[0..tab],name)&&zagd_hash_equal(smf_hash(node[tab+1..]),want)==1){matches=matches+1;}
            }
            start=i+1;
        }
        i=i+1;
    }
    return matches;
}
fn znc_profile_manifest_matches_unit(text:[]u8,src:[]u8,modules:ArrayList[ResolvedModule])i32{
    let view:SemanticManifestView=semantic_manifest_decode(text);
    if(view.valid==0||view.graph_complete!=1||zagd_hash_equal(view.source,zagd_content_hash(src))==0){return 0;}
    let node_count:i32=0;let start:i32=0;let i:i32=0;
    while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>12&&@strEq(line[0..12],"module_node=")){node_count=node_count+1;}start=i+1;}i=i+1;}
    if(node_count!=modules.len){return 0;}
    i=0;while(i<modules.len){
        let module:ResolvedModule=modules.data[i];let name:[]u8=module.path;
        if(@strEq(name,"<root>")){name=view.module;}
        if(znc_profile_manifest_module_count(text,name,zagd_content_hash(module.source))!=1){return 0;}
        i=i+1;
    }
    return 1;
}
struct ZncForegroundCacheSemantic { graph:ZagdHash, valid:i32 }
// Executable cache authority binds to the foreground compiler's just-published
// parsed/resolved semantic graph. The record is reread through the same bounded
// O_NOFOLLOW regular-file path used by machine payloads and must exactly match
// every module in this compilation. Incomplete/large advisory manifests simply
// disable executable caching; lowering remains authoritative.
fn znc_foreground_cache_semantic(root:[]u8,src:[]u8,modules:ArrayList[ResolvedModule],published:i32)ZncForegroundCacheSemantic{
    let bad:ZncForegroundCacheSemantic=ZncForegroundCacheSemantic{.graph=zagd_hash_empty(),.valid=0};if(published!=1){return bad;}
    let path:[]u8=_zag_str_concat(root,"/.zag-cache/zagd/semantic.record");let record:ForegroundBoundedRead=fc_read_bounded(path,8388608);if(record.ok==0){free[u8](&record.bytes);return bad;}
    let text:[]u8=record.bytes.data[0..record.bytes.len];let view:SemanticManifestView=semantic_manifest_decode(text);if(view.valid==0||view.graph_complete!=1||znc_profile_manifest_matches_unit(text,src,modules)==0){free[u8](&record.bytes);return bad;}
    let out:ZncForegroundCacheSemantic=ZncForegroundCacheSemantic{.graph=view.graph_identity,.valid=1};free[u8](&record.bytes);return out;
}
fn znc_foreground_profile_use(root:[]u8,src:[]u8,modules:ArrayList[ResolvedModule],
    compiler_bytes:[]u8,cpu:X86CpuProfile)ZagdForegroundProfileUse{
    if(has_flag("--no-zagd-profile")==1){return zpf_bad("disabled-by-command");}
    if(compiler_bytes.len<=0||cpu.valid==0){return zpf_bad("foreground-input-unavailable");}
    let semantic_text:[]u8=_zag_read_file(_zag_str_concat(root,"/.zag-cache/zagd/semantic.record"));
    if(semantic_text.len<=0){if(semantic_text.len>=0){_zag_free(_zag_slice_ptr(semantic_text));}return zpf_bad("missing-semantic-record");}
    if(znc_profile_manifest_matches_unit(semantic_text,src,modules)==0){
        _zag_free(_zag_slice_ptr(semantic_text));return zpf_bad("semantic-record-not-current-compilation");
    }
    let plan_text:[]u8=_zag_read_file(_zag_str_concat(root,"/.zag-cache/zagd/profile-plan.record"));
    let use:ZagdForegroundProfileUse=zagd_foreground_profile_consume(plan_text,semantic_text,
        zag_version(),zagd_content_hash(compiler_bytes),cpu.cache_key);
    if(plan_text.len>=0){_zag_free(_zag_slice_ptr(plan_text));}
    _zag_free(_zag_slice_ptr(semantic_text));return use;
}
// Return -1 for no valid current plan. A nonnegative result is the count of
// rows consumed through the same fail-closed metadata path used by builds.
fn znc_profile_plan_eligible(root:[]u8,manifest_text:[]u8)i32{
    let text:[]u8=_zag_read_file(_zag_str_concat(root,"/.zag-cache/zagd/profile-plan.record"));
    let compiler_bytes:[]u8=_zag_read_file("/proc/self/exe");let cpu:X86CpuProfile=parse_x86_cpu_profile("generic");
    let use:ZagdForegroundProfileUse=zagd_foreground_profile_consume(text,manifest_text,zag_version(),
        zagd_content_hash(compiler_bytes),cpu.cache_key);
    if(text.len>=0){_zag_free(_zag_slice_ptr(text));}if(compiler_bytes.len>=0){_zag_free(_zag_slice_ptr(compiler_bytes));}
    if(use.valid==0){return 0-1;}return use.eligible_regions;
}
fn znc_suggest_rec_json(id:[]u8,supported:i32,automatic:i32,confidence:i32,basis:[]u8,evidence:[]u8,action:[]u8,validity:[]u8,rejected:[]u8)[]u8{
    let out:[]u8="{\"id\":\"";out=_zag_str_concat(out,znc_json_escape(id));
    out=_zag_str_concat(out,_zag_str_concat("\",\"supported\":",znc_json_bool(supported)));
    out=_zag_str_concat(out,_zag_str_concat(",\"automatic\":",znc_json_bool(automatic)));
    out=_zag_str_concat(out,_zag_str_concat(",\"confidence\":",_zag_i64_to_str(confidence)));
    out=_zag_str_concat(out,_zag_str_concat(",\"evidence_basis\":\"",_zag_str_concat(znc_json_escape(basis),"\"")));
    out=_zag_str_concat(out,_zag_str_concat(",\"evidence\":\"",_zag_str_concat(znc_json_escape(evidence),"\"")));
    out=_zag_str_concat(out,_zag_str_concat(",\"action\":\"",_zag_str_concat(znc_json_escape(action),"\"")));
    out=_zag_str_concat(out,_zag_str_concat(",\"validity\":\"",_zag_str_concat(znc_json_escape(validity),"\"")));
    out=_zag_str_concat(out,_zag_str_concat(",\"rejected_reason\":\"",_zag_str_concat(znc_json_escape(rejected),"\"}")));
    return out;
}
fn znc_suggest_add(list:*[]u8,count:*i32,supported_count:*i32,supported:i32,item:[]u8)void{if(count.*>0){list.*=_zag_str_concat(list.*,",");}list.*=_zag_str_concat(list.*,item);count.*=count.*+1;if(supported==1){supported_count.*=supported_count.*+1;}}
fn znc_suggest_text_line(id:[]u8,supported:i32,automatic:i32,basis:[]u8,validity:[]u8,rejected:[]u8)void{
    let line:[]u8=_zag_str_concat("  ",_zag_str_concat(id,_zag_str_concat(": supported=",_zag_str_concat(znc_json_bool(supported),_zag_str_concat(" automatic=",_zag_str_concat(znc_json_bool(automatic),_zag_str_concat(" basis=",_zag_str_concat(basis,_zag_str_concat(" validity=",validity)))))))));
    if(rejected.len>0){line=_zag_str_concat(line,_zag_str_concat(" rejected_reason=",rejected));}
    _zag_println(line);
}
fn znc_script_default_supported(id:[]u8,value:[]u8)i32{
    if(@strEq(id,"script-default-allocator")){return (znc_script_allocator_policy_id(value)>0) as i32;}
    if(@strEq(id,"script-default-device")){return @strEq(value,"cpu") as i32;}
    if(@strEq(id,"script-default-layout")){return @strEq(value,"compiler_owned") as i32;}
    if(@strEq(id,"script-default-cpu")){return (znc_script_cpu_policy_id(value)>0) as i32;}
    return 0;
}
fn znc_supported_regular_advice_count(manifest_text:[]u8)i32{
    // Allocation-effect review is a real, supported human advisory. It does not
    // itself infer lifetime, non-overlap, byte size, or an executable
    // transformation. The separate buffer facts below have their own exact,
    // fail-closed AST proof and still grant no transformation authority.
    let count:i32=znc_manifest_fact_count(manifest_text,"\talloc=1");let buffers:SemanticBufferLifetimeFacts=semantic_manifest_buffer_lifetime_facts(manifest_text);if(buffers.valid==1){return count+buffers.pairs;}return count;
}
fn znc_maybe_regular_advisory(path:[]u8,unit:CompilationUnit,published:i32)void{
    if(published!=1||unit.profile==ModuleProfile.script||has_flag("--no-zagd")==1){return;}
    let root:[]u8=znc_project_root(dir_of(path));let cfg:PlannerConfig=znc_project_config(root,0);
    if(@strEq(cfg.notifications,"advisory")==0||znc_zagd_lock_alive(root)==0){return;}
    let manifest_text:[]u8=_zag_read_file(_zag_str_concat(root,"/.zag-cache/zagd/semantic.record"));
    if(manifest_text.len<0||znc_manifest_modules_current(root,manifest_text)==0){return;}
    let count:i32=znc_manifest_fact_count(manifest_text,"\talloc=1");
    if(count>0){_zag_eprintln(_zag_str_concat("znc: advisory: ",_zag_str_concat(_zag_i64_to_str(count),_zag_str_concat(" allocation-effect declaration(s) available for review; run `znc suggest` (no source changes)",""))));}
    let buffers:SemanticBufferLifetimeFacts=semantic_manifest_buffer_lifetime_facts(manifest_text);
    if(buffers.valid==1&&buffers.pairs>0){_zag_eprintln(_zag_str_concat("znc: advisory: ",_zag_str_concat(_zag_i64_to_str(buffers.pairs),_zag_str_concat(" AST-proven disjoint local raw-buffer pair(s) available for review; run `znc suggest` (no source changes)",""))));}
}

// `optimize --preview` deliberately has no transformation path. It exposes the
// same checksum-bound planner facts as `suggest`, but accepts only inspection
// flags so a typo cannot turn a normal advisory command into source mutation.
fn znc_optimize_preview() i32 {
    let preview: i32 = 0;
    let i: i32 = 2;
    while (i < _zag_argc()) {
        let arg: []u8 = _zag_arg(i);
        if (@strEq(arg, "--preview")) { preview = 1; i = i + 1; }
        else if (@strEq(arg, "--no-zagd")) { i = i + 1; }
        else if (@strEq(arg, "--format")) {
            if (i + 1 >= _zag_argc()) { _zag_eprintln("znc optimize: --format must be text or json"); return 2; }
            i = i + 2;
        }
        else if (@strEq(arg, "--apply") || @strEq(arg, "--in-place") ||
                 @strEq(arg, "--write") || @strEq(arg, "--output") ||
                 @strEq(arg, "-o") || @strEq(arg, "--replace")) {
            _zag_eprintln("znc optimize: mutation flags are unsupported; use --preview for a read-only advisory");
            return 2;
        }
        else {
            _zag_eprintln("znc optimize: only --preview, --format text|json, and --no-zagd are supported");
            return 2;
        }
    }
    if (preview == 0) { _zag_eprintln("znc optimize: only --preview is implemented; no automatic transformation exists"); return 2; }
    let json: i32 = znc_output_format();
    if (json < 0) { _zag_eprintln("znc optimize: --format must be text or json"); return 2; }
    // Preserve valid JSON as a single machine-readable object. Text gains a
    // short boundary statement before the existing suggestion rendering.
    if (json == 0) { _zag_println("znc optimize preview: read-only advisory; source_changes=false"); }
    return znc_zagd_suggest();
}

fn znc_zagd_suggest() i32 {
    let root: []u8 = znc_project_root(".");
    let status: []u8 = _zag_read_file(_zag_str_concat(root, "/.zagd.status"));
    let manifest_text:[]u8=_zag_read_file(_zag_str_concat(root,"/.zag-cache/zagd/semantic.record"));
    let manifest:SemanticManifestView=semantic_manifest_decode(manifest_text);
    let json: i32 = znc_output_format();
    if (json < 0) { _zag_eprintln("znc suggest: --format must be text or json"); return 2; }
    if (status.len < 0 || znc_zagd_lock_alive(root) == 0 || manifest.valid==0) {
        if (json == 1) { _zag_println("{\"advisory\":true,\"available\":false,\"source_changes\":false}"); }
        else { _zag_println("zagd suggest: no active snapshot; regular Zag remains unchanged"); }
        return 0;
    }
    if(znc_manifest_modules_current(root,manifest_text)==0){if(json==1){_zag_println("{\"advisory\":true,\"available\":false,\"reason\":\"stale-module-graph\",\"source_changes\":false}");}else{_zag_println("zagd suggest: semantic/module snapshot is stale; no recommendation used");}return 0;}
    let script:i32=(@strEq(smf_value(manifest_text,"profile"),"script")) as i32;let detail_level:[]u8=smf_value(manifest_text,"detail_level");if(detail_level.len==0){detail_level="legacy-full";}let detailed_witnesses:i32=(1-(@strEq(detail_level,"compact") as i32));let recs:[]u8="";let count:i32=0;let supported_count:i32=0;
    let constants:i32=semantic_manifest_constant_count(manifest_text);if(constants>0){znc_suggest_add(&recs,&count,&supported_count,0,znc_suggest_rec_json("constant-return-fold",0,0,100,"proven",_zag_str_concat(_zag_i64_to_str(constants)," constant-return declaration(s)"),"none; ordinary backend optimization remains independent","current semantic manifest and module graph","no planner-owned transformation and equivalence-revalidation pipeline"));}
    let leaves:i32=znc_manifest_fact_count(manifest_text,"\teffect_free=1\tleaf=1");if(leaves>0){znc_suggest_add(&recs,&count,&supported_count,0,znc_suggest_rec_json("pure-leaf-inline",0,0,100,"proven",_zag_str_concat(_zag_i64_to_str(leaves)," effect-free leaf declaration(s)"),"none; ordinary backend optimization remains independent","current semantic manifest and module graph","no planner-owned inline transformation and equivalence-revalidation pipeline"));}
    let allocs:i32=znc_manifest_fact_count(manifest_text,"\talloc=1");if(allocs>0){znc_suggest_add(&recs,&count,&supported_count,1,znc_suggest_rec_json("allocation-review",1,0,100,"proven",_zag_str_concat(_zag_i64_to_str(allocs)," allocation-effect declaration(s); no lifetime or byte-size inference"),"review explicit allocator and lifetime policy","current checksum-bound semantic manifest and module graph",""));}
    let buffer_lifetimes:SemanticBufferLifetimeFacts=semantic_manifest_buffer_lifetime_facts(manifest_text);if(buffer_lifetimes.valid==1&&buffer_lifetimes.pairs>0){let evidence:[]u8=_zag_str_concat(_zag_i64_to_str(buffer_lifetimes.pairs),_zag_str_concat(" statement-ordered disjoint local raw-buffer pair(s); largest exact shared capacity ",_zag_str_concat(_zag_i64_to_str(buffer_lifetimes.reusable_bytes)," byte(s)")));znc_suggest_add(&recs,&count,&supported_count,1,znc_suggest_rec_json("proven-buffer-lifetimes",1,0,100,"proven-foreground-ast",evidence,"review an explicit buffer-reuse refactor; no transform is applied","Linux x86-64 local []f32/[]i32 raw-word allocations with constant size, exactly one direct matching free, no shadow, alias, escape, whole-buffer call exposure, control-flow crossing, or use after free, and at most 64 candidates per function",""));}
    let unknown:i32=znc_manifest_value_unknown_count(manifest_text);if(unknown>0){znc_suggest_add(&recs,&count,&supported_count,1,znc_suggest_rec_json("explicit-value-types",1,0,100,"derived",_zag_str_concat(_zag_i64_to_str(unknown)," unresolved local type witness(es)"),"add explicit types before strict promotion","current checksum-bound semantic manifest and module graph",""));}
    let profile_eligible:i32=znc_profile_plan_eligible(root,manifest_text);if(profile_eligible>=0){znc_suggest_add(&recs,&count,&supported_count,0,znc_suggest_rec_json("profile-guided-hot-regions",0,0,100,"measured-and-derived",_zag_str_concat(_zag_i64_to_str(profile_eligible)," checksum-bound hot region(s) passed current declaration and generic-target validation"),"metadata consumed for reporting; foreground code generation remains unchanged","exact foreground compiler image, semantic source/graph, and generic CPU target","metadata-only consumer; no declaration-to-machine-region map"));}
    let script_allocator:i32=0;let script_device:i32=0;let script_layout:i32=0;let script_cpu:i32=0;
    if(script==1){
        let cfg:PlannerConfig=znc_project_config(root,0);let explicit:PlannerChoices=znc_script_explicit_choices();
        if(explicit.allocator_explicit==0){script_allocator=znc_script_default_supported("script-default-allocator",cfg.default_allocator);let rejected:[]u8="";if(script_allocator==0){rejected="configured allocator is not implemented by the current Script runtime";}znc_suggest_add(&recs,&count,&supported_count,script_allocator,znc_suggest_rec_json("script-default-allocator",script_allocator,script_allocator,100,"derived","allocator unspecified",_zag_str_concat("configured default ",cfg.default_allocator),"project configuration plus current Script runtime",rejected));}
        if(explicit.device_explicit==0){script_device=znc_script_default_supported("script-default-device",cfg.default_device);let rejected:[]u8="";if(script_device==0){rejected="configured device is not implemented by the current Script runtime";}znc_suggest_add(&recs,&count,&supported_count,script_device,znc_suggest_rec_json("script-default-device",script_device,script_device,100,"derived","device unspecified",_zag_str_concat("configured default ",cfg.default_device),"project configuration plus current Script runtime",rejected));}
        if(explicit.layout_explicit==0){script_layout=znc_script_default_supported("script-default-layout",cfg.default_layout);let rejected:[]u8="";if(script_layout==0){rejected="configured layout is not implemented by the current Script runtime";}znc_suggest_add(&recs,&count,&supported_count,script_layout,znc_suggest_rec_json("script-default-layout",script_layout,script_layout,100,"derived","layout unspecified",_zag_str_concat("configured default ",cfg.default_layout),"project configuration plus current Script runtime",rejected));}
        if(explicit.cpu_explicit==0){script_cpu=znc_script_default_supported("script-default-cpu",cfg.default_cpu);let rejected:[]u8="";if(script_cpu==0){rejected="configured CPU profile is not recognized or permitted";}znc_suggest_add(&recs,&count,&supported_count,script_cpu,znc_suggest_rec_json("script-default-cpu",script_cpu,script_cpu,100,"derived","CPU profile unspecified",_zag_str_concat("configured default ",cfg.default_cpu),"project configuration plus implemented x86 CPU profiles",rejected));}
    }
    if(json==1){_zag_println(_zag_str_concat("{\"advisory\":true,\"available\":true,\"profile\":\"",_zag_str_concat(smf_value(manifest_text,"profile"),_zag_str_concat("\",\"detail_level\":\"",_zag_str_concat(detail_level,_zag_str_concat("\",\"expression_witnesses_available\":",_zag_str_concat(znc_json_bool(detailed_witnesses),_zag_str_concat(",\"buffer_lifetime_witnesses_available\":",_zag_str_concat(znc_json_bool(detailed_witnesses),_zag_str_concat(",\"source_changes\":false,\"checksum_bound\":true,\"module_graph_current\":true,\"recommendation_count\":",_zag_str_concat(_zag_i64_to_str(count),_zag_str_concat(",\"supported_count\":",_zag_str_concat(_zag_i64_to_str(supported_count),_zag_str_concat(",\"recommendations\":[",_zag_str_concat(recs,"]}")))))))))))))));return 0;}
    _zag_println(_zag_str_concat("zagd suggestions: profile=",_zag_str_concat(smf_value(manifest_text,"profile"),_zag_str_concat(" detail-level=",_zag_str_concat(detail_level,_zag_str_concat(" checksum-bound=true module-graph-current=true source_changes=false count=",_zag_str_concat(_zag_i64_to_str(count),_zag_str_concat(" supported=",_zag_i64_to_str(supported_count)))))))));
    if(detailed_witnesses==0){_zag_println("  compact detail: expression/value/copy and local buffer-lifetime witnesses unavailable; no recommendation is inferred from their omission");}
    if(constants>0){znc_suggest_text_line("constant-return-fold",0,0,"proven","current semantic manifest and module graph","no planner-owned transformation and equivalence-revalidation pipeline");}
    if(leaves>0){znc_suggest_text_line("pure-leaf-inline",0,0,"proven","current semantic manifest and module graph","no planner-owned inline transformation and equivalence-revalidation pipeline");}
    if(allocs>0){znc_suggest_text_line("allocation-review",1,0,"proven","current checksum-bound semantic manifest and module graph","");}
    if(buffer_lifetimes.valid==1&&buffer_lifetimes.pairs>0){znc_suggest_text_line("proven-buffer-lifetimes",1,0,"proven-foreground-ast","Linux x86-64 local constant raw-word allocations with unique direct frees, no alias, escape, call exposure, control-flow crossing, or use after free, and at most 64 candidates per function","");}
    if(unknown>0){znc_suggest_text_line("explicit-value-types",1,0,"derived","current checksum-bound semantic manifest and module graph","");}
    if(profile_eligible>=0){znc_suggest_text_line("profile-guided-hot-regions",0,0,"measured-and-derived","exact foreground compiler image, semantic source/graph, and generic CPU target","metadata-only consumer; no declaration-to-machine-region map");}
    if(script==1){let cfg:PlannerConfig=znc_project_config(root,0);let explicit:PlannerChoices=znc_script_explicit_choices();if(explicit.allocator_explicit==0){let r:[]u8="";if(script_allocator==0){r="configured allocator is not implemented by the current Script runtime";}znc_suggest_text_line("script-default-allocator",script_allocator,script_allocator,"derived","project configuration plus current Script runtime",r);}if(explicit.device_explicit==0){let r:[]u8="";if(script_device==0){r="configured device is not implemented by the current Script runtime";}znc_suggest_text_line("script-default-device",script_device,script_device,"derived","project configuration plus current Script runtime",r);}if(explicit.layout_explicit==0){let r:[]u8="";if(script_layout==0){r="configured layout is not implemented by the current Script runtime";}znc_suggest_text_line("script-default-layout",script_layout,script_layout,"derived","project configuration plus current Script runtime",r);}if(explicit.cpu_explicit==0){let r:[]u8="";if(script_cpu==0){r="configured CPU profile is not recognized or permitted";}znc_suggest_text_line("script-default-cpu",script_cpu,script_cpu,"derived","project configuration plus implemented x86 CPU profiles",r);}}
    return 0;
}

// --hot build: record the code/data sizes for the hot-patch layout guard.
fn znc_write_hotlen(clen: i32, dlen: i32) void {
    let _a: i32 = _zag_write_file(".zag_hotlen", _zag_i64_to_str(clen as i64));
    let _b: i32 = _zag_write_file(".zag_hotdlen", _zag_i64_to_str(dlen as i64));
    _zag_println("znc: [--hot] recorded layout in .zag_hotlen — after edits run `znc hot-patch <src>`; the running program swaps it in live");
}

// `znc hot-patch <src>`: re-assemble the (edited) program and, if it keeps the
// same code+data layout as the --hot build, stage the new `.text` bytes in
// `.zag_hotpatch` for the running process to memcpy over its live code.
fn znc_hot_patch(path: []u8) i32 {
    if (path.len == 0) { _zag_println("znc hot-patch: no source file"); return 1; }
    let src: []u8 = _zag_read_file(path);
    if (src.len < 0) { _zag_print("znc hot-patch: cannot read "); _zag_println(path); return 1; }

    // Same front-end + codegen pipeline as the build path so that every
    // unchanged function assembles to byte-identical code at the same offset.
    let decls: ArrayList[*Node] = parse_program_dir(src, dir_of(path));
    lo_operators(decls);
    let link_libs: ArrayList[[]u8] = make[[]u8](4);
    let code_decls: ArrayList[*Node] = znc_collect_links(decls, &link_libs);
    let nerr: i32 = 0;
    let data: ArrayList[u8] = make[u8](16);
    let prog: ArrayList[Instr] = lower_program(code_decls, &nerr, &data);
    if (nerr > 0) { _zag_println("znc hot-patch: build failed — unsupported constructs (see messages above)"); return 1; }
    let hp_prog2: ArrayList[Instr] = regalloc(prog);
    let hp_prog3: ArrayList[Instr] = optimize(hp_prog2);
    let hp_opt: ArrayList[Instr] = peephole(hp_prog3);
    let code: ArrayList[u8] = encode(hp_opt);
    free[Instr](&prog);
    free[Instr](&hp_prog2);
    free[Instr](&hp_prog3);
    free[Instr](&hp_opt);

    // Layout guard: an in-place swap is only safe if the code (and the absolute-
    // addressed data blob) kept the same size as the running image.
    let want_c: []u8 = _zag_read_file(".zag_hotlen");
    if (want_c.len <= 0) {
        _zag_println("znc hot-patch: no .zag_hotlen found — build the program with `--hot` first");
        return 1;
    }
    let got_c: []u8 = _zag_i64_to_str(code.len as i64);
    if (@strEq(want_c, got_c) == 0) {
        _zag_println("znc hot-patch: edit changed the compiled code size — rebuild required (hot-patch only applies layout-preserving edits, e.g. changing a constant)");
        return 1;
    }
    let want_d: []u8 = _zag_read_file(".zag_hotdlen");
    let got_d: []u8 = _zag_i64_to_str(data.len as i64);
    if (want_d.len > 0 && @strEq(want_d, got_d) == 0) {
        _zag_println("znc hot-patch: edit changed the data/string layout — rebuild required");
        return 1;
    }

    let wrc: i32 = _zag_write_file(".zag_hotpatch", code.data[0..code.len]);
    if (wrc != 0) { _zag_println("znc hot-patch: failed to write .zag_hotpatch"); return 1; }
    _zag_print("znc hot-patch: staged ");
    _zag_print(got_c);
    _zag_println(" bytes → .zag_hotpatch (the running process swaps it in on its next zag_hot_wait())");
    return 0;
}

fn main() i32 {
    if (_zag_argc() < 2) {
        _zag_println("usage: znc <source.zag> [-o out] [-l lib] [-L path] [--run] [--debug]");
        _zag_println("       znc <source.zag> --dynamic --needed libNAME.so.N [-o out] [--run]");
        _zag_println("       znc <source.zag> --target gpu-nvidia|gpu-amd|gpu-vulkan|amdgpu-gfx1010");
        _zag_println("       znc <source.zag> --target vulkan-compat|opencl-compat|metal-compat|opengl-compat|cuda-compat");
        _zag_println("       znc <source.zag> --target wasm [-o out.wasm] [--run]");
        _zag_println("       znc <source.zag> --target arm64 [-o out] [--run]");
        _zag_println("       znc script <source.zag> [-o out] [--run]");
        _zag_println("         [--script-allocator script_process_arena|script_bounded_heap]");
        _zag_println("       znc explain <source.zag> [--format text|json]");
        _zag_println("       znc harden <source.zag> [--output candidate.zag]");
        _zag_println("       znc check <source.zag> [--strict]");
        _zag_println("       znc watch [--mode off|light|adaptive|deep]");
        _zag_println("       znc status | shutdown | suggest");
        _zag_println("       znc clean-cache [path]            (purge .zag-cache and stop daemon)");
        _zag_println("       znc optimize --preview [--format text|json]");
        _zag_println("       znc [build] --hot <source.zag> [-o out]   (hot-reloadable build)");
        _zag_println("       znc hot-patch <source.zag>                (stage a live code patch)");
        _zag_println("       znc fmt [--in-place] <source.zag>");
        _zag_println("       znc init");
        _zag_println("       znc version");
        _zag_println("  analyzer (leak + efficiency lints) runs by default:");
        _zag_println("    --no-analyze        disable the analyzer");
        _zag_println("    --no-zagd           skip background planning for this invocation");
        _zag_println("    --no-zagd-profile   skip advisory foreground profile metadata");
        _zag_println("    --profile-report    report profile metadata hit/miss and authority");
        _zag_println("    --no-foreground-cache force fresh backend lowering (recovery/testing)");
        _zag_println("    --cache-report      report validated hit/miss, lowering count, and substitution");
        _zag_println("    --analyze-strict    treat analyzer findings as errors");
        _zag_println("    --analyze-pedantic  also emit strength-reduction hints");
        _zag_println("    --analyze-str-consumer NAME  register an app helper that frees its");
        _zag_println("                        string args (repeatable; e.g. append_ff)");
        _zag_println("  compiles Zag to native x86-64 ELF — dynamic mode still uses no cc/as/ld");
        return 1;
    }

    let cmd: []u8 = _zag_arg(1);
    if (@strEq(cmd, "version") || @strEq(cmd, "--version") || @strEq(cmd, "-v")) {
        _zag_print("znc ");
        _zag_print(zag_version());
        _zag_print(" (edition ");
        _zag_print(zag_edition());
        _zag_println(")");
        return 0;
    }
    if (@strEq(cmd, "fmt")) {
        let in_place: i32 = has_flag("--in-place");
        let fpath: []u8 = "";
        let fi: i32 = 2;
        let finding: i32 = 1;
        while (finding == 1 && fi < _zag_argc()) {
            let arg: []u8 = _zag_arg(fi);
            if (arg.len > 0 && arg[0] != '-') { fpath = arg; finding = 0; }
            else { fi = fi + 1; }
        }
        return znc_fmt(fpath, in_place);
    }
    if (@strEq(cmd, "init")) { return znc_init(); }
    if (@strEq(cmd, "watch")) { return znc_watch(); }
    if (@strEq(cmd, "status")) { return znc_zagd_status(); }
    if (@strEq(cmd, "shutdown")) { return znc_zagd_shutdown(); }
    if (@strEq(cmd, "suggest")) { return znc_zagd_suggest(); }
    if (@strEq(cmd, "optimize")) { return znc_optimize_preview(); }
    if (@strEq(cmd, "hot-patch")) { return znc_hot_patch(first_nonflag_from(2)); }
    if (@strEq(cmd, "clean-cache")) {
        let cpath: []u8 = first_nonflag_from(2);
        if (cpath.len == 0) { cpath = "."; }
        let root: []u8 = znc_project_root(dir_of(cpath));
        znc_cache_purge(root);
        // Also stop any running daemon so it doesn't recreate stale files.
        let _stopped: i32 = znc_zagd_exec(root, "off", 100, 0);
        _zag_println("znc: cache purged");
        return 0;
    }
    if (@strEq(cmd, "explain")) {
        let epath: []u8 = first_nonflag_from(2);
        if (epath.len > 0) { znc_zagd_ensure(znc_project_root(dir_of(epath)),epath); }
        return znc_explain(epath);
    }
    if (@strEq(cmd, "harden")) {
        let hpath: []u8 = first_nonflag_from(2);
        if (hpath.len > 0) { znc_zagd_ensure(znc_project_root(dir_of(hpath)),hpath); }
        return znc_harden(hpath);
    }
    if (@strEq(cmd, "check")) {
        if (v2_validate_options() != 0) { return 1; }
        let cpath: []u8 = "";
        if (_zag_argc() >= 3) { cpath = _zag_arg(2); }
        if (cpath.len > 0) { znc_zagd_ensure(znc_project_root(dir_of(cpath)),cpath); }
        return znc_check(cpath);
    }

    if (v2_validate_options() != 0) { return 1; }

    let path: []u8 = src_arg();
    if (path.len == 0) { _zag_println("znc: no source file"); return 1; }

    znc_cache_version_check(znc_project_root(dir_of(path)));
    znc_zagd_ensure(znc_project_root(dir_of(path)),path);

    let gtarget: []u8 = gpu_target();
    let ctarget: []u8 = compat_target();
    if ((has_flag("--safety=checked") == 1 || has_flag("--sanitize=memory") == 1) &&
        (gtarget.len > 0 || gfx1010_target() == 1 || wasm_target() == 1 ||
         arm64_target() == 1 || i686_target() == 1 || ctarget.len > 0)) {
        _zag_eprintln("E0202: checked safety and --sanitize=memory are implemented only for the native x86-64 target");
        _zag_eprintln("note: the requested target has no checked raw-pointer or memory-sanitizer lowering; no executable was emitted");
        return 1;
    }
    if (gtarget.len > 0) { if (znc_reject_v2_cabi_non_native(path) != 0) { return 1; } return build_gpu(path, gtarget); }
    if (gfx1010_target() == 1) { if (znc_reject_v2_cabi_non_native(path) != 0) { return 1; } return build_gfx1010(path); }
    if (ctarget.len > 0) { if (znc_reject_v2_cabi_non_native(path) != 0) { return 1; } return build_compat(path, ctarget); }
    if (wasm_target() == 1) { if (znc_reject_v2_cabi_non_native(path) != 0) { return 1; } return build_wasm(path); }
    if (arm64_target() == 1) { if (znc_reject_v2_cabi_non_native(path) != 0) { return 1; } return build_arm64(path); }
    if (i686_target() == 1) { if (znc_reject_v2_cabi_non_native(path) != 0) { return 1; } return build_i686_minimal(path); }

    if (validate_x86_target_flag() != 0) { return 1; }
    if (validate_x86_cpu_flag() != 0) { return 1; }
    // The default native writer emits ET_EXEC with program headers only.  Do
    // not silently turn an x86-64 object/archive request into an executable:
    // there is no x86-64 ET_REL writer, section table, or public-symbol table
    // yet.  i686 handles these flags above through its separate proven path.
    if (has_flag("--emit-static") == 1) {
        _zag_eprintln("znc: native x86-64 --emit-obj/--emit-static is not implemented; no artifact was emitted");
        _zag_eprintln("note: current x86-64 output is ET_EXEC without a section or public-symbol table; use the separately bounded i686 object path only for its documented ABI");
        return 1;
    }

    let src: []u8 = _zag_read_file(path);
    if (src.len < 0) {
        _zag_print("znc: cannot read ");
        _zag_println(path);
        return 1;
    }

    // CLI activation is the same parser profile as an in-file `script;`
    // declaration. Prefixing is compilation-local and never rewrites source.
    src=znc_activate_script_source(path,src,(@strEq(cmd,"script")) as i32);

    if (v2_validate_source(path, src) != 0) { return 1; }

    // parse → apply configurable Script defaults → effect-check → lower → ELF
    let unit: CompilationUnit = parse_compilation_unit_dir(src, dir_of(path));
    if (znc_validate_script_defaults(path, unit) != 0) { return 1; }
    if (znc_configure_script_unit(&unit, path) != 0) { return 1; }
    if (znc_validate_script_capabilities(path, unit) != 0) { return 1; }
    if (unit.profile==ModuleProfile.script && (znc_script_std_body_check(unit.decls)!=0 || znc_script_lifetime_check(unit.decls)!=0 || znc_script_unaccounted_root_make(unit.decls)!=0)) { return 1; }
    let decls: ArrayList[*Node] = unit.decls;

    // Lower operator contracts (x + y → big_add(x, y)) so sema sees the real calls.
    lo_operators(decls);

    // Static call-arity check (also runs for arm64/wasm/gpu via znc_check_src).
    let aerrs: i32 = znc_check_arity(decls);
    if (aerrs > 0) {
        _zag_println("znc: arity check FAILED");
        return 1;
    }
    let derrs: i32 = znc_check_dups(decls);
    if (derrs > 0) {
        _zag_println("znc: duplicate-definition check FAILED");
        return 1;
    }

    // Native uses the same declared-type authority as ARM64, WASM, and GPU.
    // Reject before any backend can invent a layout for an unknown name.
    if (typed_check_program(decls, path) > 0) { return 1; }

    // Effect/capability check (sema.zag): reject @total/@realtime/@noalloc violations.
    let eff: map__StringMap[i32] = analyze(decls);
    let viols: i32 = report_violations(decls, eff, src, path);
    if (viols > 0) {
        znc_emit_total_cex(decls, eff);
        _zag_println("znc: capability check FAILED");
        return 1;
    }
    smt_report_proofs(decls, eff);

    // Leak + efficiency analysis (analyze.zag). On by default; --no-analyze to skip.
    if (run_analyzer(decls, path) != 0) { return 1; }
    let published:i32=znc_publish_semantics(path,src,unit,decls,eff);
    znc_maybe_regular_advisory(path,unit,published);

    // Collect @link directives and strip them from decls before codegen.
    // (ncodegen pass-1 aborts on unknown top-level node kinds.)
    let link_libs: ArrayList[[]u8] = make[[]u8](4);
    let lib_paths: ArrayList[[]u8] = make[[]u8](4);
    let code_decls: ArrayList[*Node] = znc_collect_links(decls, &link_libs);

    // Also accept -l/-L flags and zag.mod deps.
    znc_argv_links(&link_libs);
    znc_argv_paths(&lib_paths);
    znc_load_zagmod(dir_of(path), &link_libs, &lib_paths);

    // Collect `extern fn` names — the symbols we need from static libraries.
    let extern_syms: ArrayList[[]u8] = collect_extern_syms(code_decls);
    let dynamic_mode: i32 = has_flag("--dynamic");
    let sanitize_memory: i32 = has_flag("--sanitize=memory");
    let safety_checked: i32 = has_flag("--safety=checked") | sanitize_memory;
    // Edition 2027 (v2) enables ownership rules the x86 backend enforces
    // (e.g. failing closed on aggregate closure captures). Regular Zag
    // (edition 2026) stays source-preserving and matches the arm64 backend.
    let v2_edition: i32 = @strEq(v2_project_edition(path), "2027") as i32;
    let x86_object_mode:i32=has_flag("--emit-obj");
    if(x86_object_mode==1&&v2_edition==0){_zag_eprintln("znc: native x86-64 --emit-obj is implemented only for edition-2027 @cabi_export objects");return 1;}
    let needed_libs: ArrayList[[]u8] = znc_needed_libs();
    if (dynamic_mode == 0 && needed_libs.len > 0) {
        _zag_eprintln("znc: --needed requires explicit --dynamic mode");
        return 1;
    }
    if (dynamic_mode == 1 && needed_libs.len == 0) {
        _zag_eprintln("znc: --dynamic requires at least one --needed SONAME");
        return 1;
    }
    if (dynamic_mode == 1 && link_libs.len > 0) {
        _zag_eprintln("znc: dynamic and static archive linking cannot be mixed yet");
        return 1;
    }
    if (dynamic_mode == 1 && (has_flag("--debug") == 1 || has_flag("--hot") == 1)) {
        _zag_eprintln("znc: --dynamic does not yet support --debug or --hot");
        return 1;
    }

    let selected_cpu:X86CpuProfile=parse_x86_cpu_profile(znc_effective_cpu(path, (unit.profile==ModuleProfile.script) as i32));
    let data:ArrayList[u8]=make[u8](16);let code:ArrayList[u8]=make[u8](16);
    // /proc/self/exe follows PATH launches and symlinks to the exact running
    // compiler image, unlike argv[0], which may not be a readable path.
    let compiler_bytes:[]u8=_zag_read_file("/proc/self/exe");
    let project_root:[]u8=znc_project_root(dir_of(path));
    // This read is automatic but metadata-only. It validates the exact parsed
    // module set, compiler image, semantic graph and target; neither a hit nor
    // a miss changes lowering, optimization passes, cache keys, or ELF output.
    let foreground_profile_use:ZagdForegroundProfileUse=znc_foreground_profile_use(
        project_root,src,unit.modules,compiler_bytes,selected_cpu);
    let compiler_available:i32=(compiler_bytes.len>0) as i32;
    let compiler_identity:ZagdHash=zagd_hash_empty();
    if(compiler_available==1){compiler_identity=zagd_content_hash(compiler_bytes);}
    // Both consumers retain only the image hash. Do not keep a second full
    // compiler image resident through lowering, linking, debug emission, or
    // execution.
    if(compiler_bytes.len>=0){_zag_free(_zag_slice_ptr(compiler_bytes));}
    let cache_semantic:ZncForegroundCacheSemantic=znc_foreground_cache_semantic(
        project_root,src,unit.modules,published);
    let cache_hit:i32=0;let cache_stored:i32=0;
    // Kept only for the ET_REL path.  The executable path deliberately
    // continues to consume plain code bytes and does not expose label data.
    let object_labels:ArrayList[i32]=make[i32](1);
    // Direct foreign calls in an ET_REL object carry the encoder's byte
    // location and compiler-owned import index.  They never enter executable
    // emission, where a zero rel32 would be invalid machine code.
    let object_relocs:ArrayList[X86ObjectReloc]=make[X86ObjectReloc](1);
    let cache_expected_code:ZagdHash=zagd_hash_empty();let cache_expected_data:ZagdHash=zagd_hash_empty();
    let lower_calls:i64=0;
    // A bootstrap/recovery build must be able to force fresh lowering even
    // when this compiler's import graph changed. The foreground cache is
    // always an optimization, never an authority for self-hosting.
    // Checked safety instrumentation changes emitted code. Keep it outside the
    // existing foreground-cache identity until that identity carries the mode.
    if(compiler_available==1&&cache_semantic.valid==1&&has_flag("--no-foreground-cache")==0&&safety_checked==0&&x86_object_mode==0){
        let profile_text:[]u8="strict";if(unit.profile==ModuleProfile.script){profile_text="script";}
        let cache_config:PlannerConfig=znc_project_config(project_root,0);
        // CLI Script choices override project defaults and alter generated
        // runtime code. Bind the resolved policy, not merely .zagd.conf, so a
        // machine-code cache entry can never cross allocator/capability/limit
        // identities.
        let script_runtime_identity:[]u8="none";
        if(unit.profile==ModuleProfile.script){
            let cache_resolution:PlannerResolution=planner_resolve(1,"",
                cache_config,znc_script_explicit_choices(),0);
            script_runtime_identity=_zag_str_concat("limit=",
                _zag_i64_to_str(cache_config.script_memory_bytes));
            script_runtime_identity=_zag_str_concat(script_runtime_identity,
                _zag_str_concat("|capabilities=",_zag_i64_to_str(
                    znc_script_capability_bits(cache_config))));
            script_runtime_identity=_zag_str_concat(script_runtime_identity,
                _zag_str_concat("|execution=",_zag_i64_to_str(
                    znc_script_execution_policy(cache_resolution))));
        }
        // Dynamic mode changes call lowering and is part of the cached-blob
        // identity. Static -l/-L/zag.mod inputs are intentionally absent:
        // archive selection and relocation happen fresh below, after code/data
        // substitution. --debug likewise derives DWARF from the current AST
        // after writing a fresh ELF, and --hot only records current blob sizes.
        // Neither is allowed to make cached code/data authoritative for those
        // later steps.
        let abi_text:[]u8="sysv-x86_64-zag-abi-v2|pipeline=ncodegen-regalloc-optimize-peephole-encode";
        abi_text=_zag_str_concat(abi_text,"|dynamic=");
        abi_text=_zag_str_concat(abi_text,_zag_i64_to_str(dynamic_mode));
        let policy_text:[]u8=_zag_str_concat("profile=",profile_text);
        policy_text=_zag_str_concat(policy_text,"|script_runtime=");
        policy_text=_zag_str_concat(policy_text,script_runtime_identity);
        policy_text=_zag_str_concat(policy_text,_zag_str_concat("|edition=",v2_project_edition(path)));
        let cache_key:ForegroundCacheKey=fc_key_identity(compiler_identity,zag_version(),project_root,path,src,unit.modules,cache_semantic.graph,selected_cpu.cache_key,abi_text,policy_text);
        let cached:ForegroundCacheResult=foreground_cache_load(project_root,cache_key,cache_config.max_cache_bytes);
        if(cached.hit==1){free[u8](&code);free[u8](&data);code=cached.code;data=cached.data;cache_expected_code=zagd_content_hash(code.data[0..code.len]);cache_expected_data=zagd_content_hash(data.data[0..data.len]);cache_hit=1;}
        else{
            free[u8](&cached.code);free[u8](&cached.data);let nerr:i32=0;lower_calls=lower_calls+1;let prog:ArrayList[Instr]=lower_program_mode_cpu(code_decls,&nerr,&data,dynamic_mode,selected_cpu.features.popcnt,selected_cpu.features.bmi1,safety_checked,sanitize_memory,v2_edition,x86_object_mode);
            if(nerr>0){_zag_println("znc: build aborted — unsupported constructs (see messages above)");return 1;}
            let prog2:ArrayList[Instr]=regalloc(prog);let prog3:ArrayList[Instr]=optimize(prog2);let opt:ArrayList[Instr]=peephole(prog3);free[u8](&code);code=encode(opt);free[Instr](&prog);free[Instr](&prog2);free[Instr](&prog3);free[Instr](&opt);
            cache_stored=foreground_cache_store(project_root,cache_key,code,data,cache_config.max_cache_bytes);
        }
    }else{
        let nerr:i32=0;lower_calls=lower_calls+1;let prog:ArrayList[Instr]=lower_program_mode_cpu(code_decls,&nerr,&data,dynamic_mode,selected_cpu.features.popcnt,selected_cpu.features.bmi1,safety_checked,sanitize_memory,v2_edition,x86_object_mode);if(nerr>0){_zag_println("znc: build aborted — unsupported constructs (see messages above)");return 1;}let prog2:ArrayList[Instr]=regalloc(prog);let prog3:ArrayList[Instr]=optimize(prog2);let opt:ArrayList[Instr]=peephole(prog3);free[u8](&code);if(x86_object_mode==1){let encoded:X86Encoded=encode_with_labels(opt);code=encoded.text;object_labels=encoded.labels;object_relocs=encoded.relocs;}else{code=encode(opt);}free[Instr](&prog);free[Instr](&prog2);free[Instr](&prog3);free[Instr](&opt);
    }
    if(cache_hit==1&&(lower_calls!=0||zagd_hash_equal(cache_expected_code,zagd_content_hash(code.data[0..code.len]))==0||zagd_hash_equal(cache_expected_data,zagd_content_hash(data.data[0..data.len]))==0)){_zag_eprintln("znc: internal error: foreground cache hit did not preserve the validated code/data substitution boundary");return 1;}
    if(cache_hit==0&&lower_calls!=1){_zag_eprintln("znc: internal error: foreground cache miss did not execute exactly one authoritative lowering");return 1;}
    if(has_flag("--cache-report")==1){if(cache_hit==1){_zag_println(_zag_str_concat("znc cache: HIT revalidated machine code and data; codegen skipped; lowering_calls=0 payload_substituted=true code=",_zag_str_concat(fc_fields(cache_expected_code),_zag_str_concat(" data=",fc_fields(cache_expected_data)))));}else if(cache_stored==1){_zag_println(_zag_str_concat("znc cache: MISS stored machine code and data; lowering_calls=",_zag_i64_to_str(lower_calls)));}else{_zag_println(_zag_str_concat("znc cache: MISS cache unavailable; lowering_calls=",_zag_i64_to_str(lower_calls)));}}
    if(has_flag("--profile-report")==1){
        if(foreground_profile_use.valid==1){
            _zag_println(_zag_str_concat("znc profile: METADATA-HIT hot_regions=",
                _zag_str_concat(_zag_i64_to_str(foreground_profile_use.hot_regions as i64),
                _zag_str_concat(" eligible_regions=",_zag_str_concat(_zag_i64_to_str(foreground_profile_use.eligible_regions as i64),
                " codegen_effect=none cache_key_effect=none")))));
        }else{
            _zag_println(_zag_str_concat("znc profile: METADATA-MISS reason=",
                _zag_str_concat(foreground_profile_use.reason," codegen_effect=none cache_key_effect=none")));
        }
    }

    let out: []u8 = out_flag();
    if (out.len == 0) { out = default_out(path); }

    if(x86_object_mode==1){
        // ET_REL supports one deliberately narrow foreign boundary: direct
        // calls to declared v2 @cabi functions become R_X86_64_PLT32 records.
        // Shared libraries, archives, data/TLS imports, and dynamic-loader
        // state still fail closed rather than being guessed by this writer.
        if(dynamic_mode==1||needed_libs.len>0||link_libs.len>0||data.len>0){
            _zag_eprintln("znc: x86-64 --emit-obj does not support dynamic mode, libraries, or data sections");
            return 1;
        }
        if(znc_object_externs_ok(code_decls)==0){
            _zag_eprintln("znc: x86-64 --emit-obj accepts foreign declarations only as edition-2027 @cabi imports");
            return 1;
        }
        let exports:ArrayList[ZncObjectExport]=znc_x86_object_exports(code_decls);
        if(exports.len==0){_zag_eprintln("znc: x86-64 --emit-obj requires at least one pub fn annotated @cabi_export");return 1;}
        let syms:ArrayList[Elf64ObjectSymbol]=make[Elf64ObjectSymbol](exports.len);
        let oi:i32=0;while(oi<exports.len){let e:ZncObjectExport=get[ZncObjectExport](exports,oi);if(e.label<0||e.label>=object_labels.len){_zag_eprintln("znc: internal error: @cabi_export label was not encoded");return 1;}push[Elf64ObjectSymbol](&syms,Elf64ObjectSymbol{.name=e.name,.offset=get[i32](object_labels,e.label),.size=0});oi=oi+1;}
        if(object_relocs.len==0){
            if(write_elf_x86_64_object(out,code,syms)!=0){_zag_eprintln("znc: failed to write x86-64 ELF object");return 1;}
            _zag_println(_zag_str_concat("znc: wrote ELF64/x86-64 relocation-free C ABI object ",out));
            return 0;
        }
        let externs:ArrayList[[]u8]=znc_dynamic_extern_syms(code_decls,v2_edition);
        let imports:ArrayList[Elf64ObjectImport]=make[Elf64ObjectImport](externs.len);
        let ei:i32=0;while(ei<externs.len){push[Elf64ObjectImport](&imports,Elf64ObjectImport{.name=get[[]u8](externs,ei)});ei=ei+1;}
        let relocs:ArrayList[Elf64ObjectReloc]=make[Elf64ObjectReloc](object_relocs.len);
        oi=0;while(oi<object_relocs.len){let r:X86ObjectReloc=get[X86ObjectReloc](object_relocs,oi);if(r.import<0||r.import>=imports.len){_zag_eprintln("znc: internal error: external-call relocation import was not declared");return 1;}push[Elf64ObjectReloc](&relocs,Elf64ObjectReloc{.offset=r.offset,.import_index=r.import,.typ=4,.addend=0-4});oi=oi+1;}
        if(write_elf_x86_64_object_reloc(out,code,syms,imports,relocs)!=0){_zag_eprintln("znc: failed to write x86-64 ELF relocation object");return 1;}
        _zag_println(_zag_str_concat("znc: wrote ELF64/x86-64 C ABI object with direct call relocations ",out));
        return 0;
    }

    if (dynamic_mode == 1) {
        let dynamic_syms: ArrayList[[]u8] = znc_dynamic_extern_syms(code_decls, v2_edition);
        if (dynamic_syms.len == 0) {
            _zag_eprintln("znc: --dynamic program declares no non-runtime extern symbols");
            return 1;
        }
        let drc: i32 = write_elf_dynamic(out, code, 0, data, dynamic_syms, needed_libs);
        if (drc != 0) { _zag_eprintln("znc: failed to write dynamic executable"); return 1; }
        _zag_print("znc: wrote dynamic native binary ");
        _zag_print(out);
        _zag_print(" (");
        _zag_print(_zag_i64_to_str(dynamic_syms.len as i64));
        _zag_println(" explicit system ABI symbol(s), 0 external build tools)");
        if (has_flag("--run") == 1) {
            let drun: []u8 = out;
            if (out.len > 0) { if (out[0] != '/') { drun = _zag_str_concat("./", out); } }
            let dec: i32 = _zag_exec_cmd(drun);
            _zag_print("znc: program exited ");
            _zag_println(_zag_i64_to_str(dec as i64));
        }
        return 0;
    }

    // Static-link any requested libraries.
    // Library code goes right after the main program code in the text segment,
    // so text_base = VBASE() + HDRS2() + code.len.
    let text_base_i64: i64 = (VBASE() + HDRS2() + code.len) as i64;
    let ml: MergedLib = link_libraries(link_libs, lib_paths, extern_syms, text_base_i64);

    let rc: i32 = write_elf_exec_data_lib(out, code, 0, data, ml.text);
    if (rc == 0 && has_flag("--debug") == 1) {
        let elf_bytes: []u8 = _zag_read_file(out);
        if (elf_bytes.len > 0) {
            let elf_buf: ArrayList[u8] = make[u8](elf_bytes.len + 512);
            let ci: i32 = 0;
            while (ci < elf_bytes.len) { push[u8](&elf_buf, elf_bytes[ci]); ci = ci + 1; }
            let dbuilder: DwarfBuilder = dwarf_new(path);
            dwarf_build_abbrev(&dbuilder);
            dwarf_emit_compile_unit(&dbuilder);
            let di: i32 = 0;
            while (di < len[*Node](code_decls)) {
                switch (get[*Node](code_decls, di).*) {
                    .fn_decl => |f| { dwarf_emit_function(&dbuilder, f.name, f.line); }
                    else => { }
                }
                di = di + 1;
            }
            dwarf_finish(&dbuilder);
            dwarf_emit_line_program(&dbuilder);
            let sections: DwarfSections = dwarf_build(&dbuilder);
            dwarf_patch_elf(&elf_buf, sections);
            rc = _zag_write_file(out, elf_buf.data[0..elf_buf.len]);
        }
    }
    if (rc != 0) { _zag_println("znc: failed to write executable"); return 1; }
    _zag_print("znc: wrote native binary ");
    _zag_print(out);
    _zag_print(" (");
    _zag_print(_zag_i64_to_str(code.len as i64));
    _zag_print(" bytes main");
    if (ml.text.len > 0) {
        _zag_print(" + ");
        _zag_print(_zag_i64_to_str(ml.text.len as i64));
        _zag_print(" bytes libs");
    }
    _zag_println(", 0 external tools)");

    // --hot: record the code/data sizes so `znc hot-patch` can verify a later
    // patch keeps the same layout (see hot_rt.zag).
    if (has_flag("--hot") == 1) { znc_write_hotlen(code.len, data.len); }

    if (has_flag("--run") == 1) {
        let runcmd: []u8 = out;
        if (out.len > 0) {
            if (out[0] != '/') { runcmd = _zag_str_concat("./", out); }
        }
        let ec: i32 = _zag_exec_cmd(runcmd);
        _zag_print("znc: program exited ");
        _zag_println(_zag_i64_to_str(ec as i64));
    }
    return 0;
}
