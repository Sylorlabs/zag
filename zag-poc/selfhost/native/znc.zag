        return (((znc_script_owner_ends(owner, "script_list_get") == 1) || (znc_script_owner_ends(owner, "script_list_pop") == 1)) && @strEq(name, "_zag_exit")) as i32;
    }
    if (kind == 1) {
        if (@strEq(name, "_zag_malloc")) {
