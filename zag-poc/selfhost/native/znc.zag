    if (record_text.len >= 0) {
        _zag_free(_zag_slice_ptr(record_text));
    }
    if (semantic_text.len >= 0) {
        _zag_free(_zag_slice_ptr(semantic_text));
    }
    return ok;
}

fn znc_optimize_accept_zagd_finalist_matches(source: []u8, candidate_path: []u8) i32 {
    let root: []u8 = znc_project_root(dir_of(source));
    let record_text: []u8 = _zag_read_file(_zag_str_concat(root, "/.zag-cache/zagd/benchmark-policy.record"));
