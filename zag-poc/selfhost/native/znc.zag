        let a: []u8 = _zag_arg(i);
        if (@strEq(a, "--target")) {
            if ((i + 1) < _zag_argc()) {
                let v: []u8 = _zag_arg(i + 1);
                if (starts_with(v, "gpu-") == 1) {
                    return v[4..];
                }
            }
        }
        if (starts_with(a, "--target=gpu-") == 1) {
            return a[13..];
        }
        i = i + 1;
    }
    return "";
}

