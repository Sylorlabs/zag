    if (f.body.len != 1) {
        return 0;
    }
    switch (f.body.data[0].*) {
        .ret => |r| {
            if (r.has_expr == 0) {
                return 0;
            }
            if (bool_result == 1) {
                return znc_harden_closure_bool_expr(r.expr, f.params);
            }
            return znc_harden_closure_scalar_expr(r.expr, f.params, f.ret);
        }
        else => {
            return 0;
        }
    }
}

