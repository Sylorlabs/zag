        return 1;
    }
    if (@strEq(name, "_zag_script_alloc")) {
        if (((((((((kind == 3) || (kind == 4)) || (kind == 5)) || (kind == 6)) || (kind == 7)) || (kind == 8)) || (kind == 9)) || (kind == 10)) || (kind == 11)) {
            return 1;
        }
        if ((kind == 2) && (znc_script_owner_ends(owner, "script_read_file") == 1)) {
            return 1;
        }
        return ((kind == 1) && (znc_script_owner_ends(owner, "process_alloc") == 1)) as i32;
    }
    if (kind == 2) {
        if ((znc_script_owner_ends(owner, "script_read_file") == 1) && (@strEq(name, "_zag_script_file_size") || @strEq(name, "_zag_script_read_file_into"))) {
            return 1;
