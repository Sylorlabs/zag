fn znc_native_print_instr(ins: Instr, index: i32) void {
    _zag_print("// x86[");
    _zag_print(_zag_i64_to_str(index as i64));
    _zag_print("] ");
    _zag_print(znc_native_instr_name(ins.kind));
    _zag_print(" kind=");
    _zag_print(_zag_i64_to_str(ins.kind as i64));
    _zag_print(" dst=");
    _zag_print(_zag_i64_to_str(ins.dst as i64));
    _zag_print(" src=");
    _zag_print(_zag_i64_to_str(ins.src as i64));
    _zag_print(" imm=");
    _zag_print(_zag_i64_to_str(ins.imm));
    _zag_print(" disp=");
    _zag_print(_zag_i64_to_str(ins.disp as i64));
    _zag_print(" label=");
    _zag_println(_zag_i64_to_str(ins.lbl as i64));
}

fn znc_native_append_text(out: *ArrayList[u8], text: []u8) void {
    let i: i32 = 0;
    while (i < text.len) {
        push[u8](out, text[i]);
        i = i + 1;
    }
}

fn znc_native_append_i64(out: *ArrayList[u8], value: i64) void {
    let text: []u8 = _zag_i64_to_str(value);
    znc_native_append_text(out, text);
    _zag_str_free(text);
}

fn znc_native_append_instr(out: *ArrayList[u8], ins: Instr, index: i32) void {
    znc_native_append_text(out, "// x86[");
    znc_native_append_i64(out, index as i64);
    znc_native_append_text(out, "] ");
    znc_native_append_text(out, znc_native_instr_name(ins.kind));
    znc_native_append_text(out, " kind=");
    znc_native_append_i64(out, ins.kind as i64);
    znc_native_append_text(out, " dst=");
    znc_native_append_i64(out, ins.dst as i64);
    znc_native_append_text(out, " src=");
    znc_native_append_i64(out, ins.src as i64);
    znc_native_append_text(out, " imm=");
    znc_native_append_i64(out, ins.imm);
    znc_native_append_text(out, " disp=");
    znc_native_append_i64(out, ins.disp as i64);
    znc_native_append_text(out, " label=");
    znc_native_append_i64(out, ins.lbl as i64);
    znc_native_append_text(out, "\n");
}

fn znc_native_view(path: []u8, source: []u8, operation: []u8) i32 {
    if (v2_validate_options() != 0) {
        return 1;
    }
    if (znc_invalid_project_config(znc_project_root(dir_of(path)), operation) == 1) {
        return 1;
    }
    let active: []u8 = znc_activate_script_source(path, source, 0);
    if (znc_validate_compilation_source(path, active) != 0) {
        return 1;
    }
    if ((validate_x86_target_flag() != 0) || (validate_x86_cpu_flag() != 0)) {
        return 1;
    }
    let unit: CompilationUnit = parse_compilation_unit_dir(active, dir_of(path));
    if (((znc_validate_script_defaults(path, unit) != 0) || (znc_configure_script_unit(&unit, path) != 0)) || (znc_validate_script_capabilities(path, unit) != 0)) {
        return 1;
    }
    if ((unit.profile == ModuleProfile.script) && (((znc_script_std_body_check(unit.decls) != 0) || (znc_script_lifetime_check(unit.decls) != 0)) || (znc_script_unaccounted_root_make(unit.decls) != 0))) {
        return 1;
    }
    let decls: ArrayList[*Node] = unit.decls;
    lo_operators(decls);
    if (((znc_check_arity(decls) > 0) || (znc_check_dups(decls) > 0)) || (typed_check_program(decls, path) > 0)) {
        return 1;
    }
    let eff: map__StringMap[i32] = analyze(decls);
    if (report_violations(decls, eff, active, path) > 0) {
        return 1;
    }
    if (run_analyzer(decls, path) != 0) {
        return 1;
    }
    let links: ArrayList[[]u8] = make[[]u8](1);
    let code_decls: ArrayList[*Node] = znc_collect_links(decls, &links);
    let view_sanitize_memory: i32 = has_flag("--sanitize=memory");
    let view_safety_checked: i32 = has_flag("--safety=checked") | view_sanitize_memory;
    let view_transform: i32 = foreground_transform_requested();
    let view_automatic: i32 = znc_automatic_transform_requested(unit, path);
    let authority: ZirAuthority = zir_prepare_production_with_origins(code_decls, eff, unit.origins);
    if (view_transform == 1) {
        if (((unit.profile == ModuleProfile.script) || (view_safety_checked == 1)) || @strEq(v2_project_edition(path), "2027")) {
            _zag_eprintln("znc view: foreground transform requires regular unsanitized x86-64 Zag");
            return 1;
        }
        if (foreground_transform_is_bool() == 1) {
            authority = zir_prepare_const_bool_cmp_source_policy_with_origins(code_decls, eff, unit.origins, foreground_transform_policy(path, view_safety_checked, view_sanitize_memory));
        } else if (foreground_transform_is_neg() == 1) {
            authority = zir_prepare_const_i32_neg_source_policy_with_origins(code_decls, eff, unit.origins, foreground_transform_policy(path, view_safety_checked, view_sanitize_memory));
        } else if (foreground_transform_is_i64() == 1) {
            authority = zir_prepare_const_i64_add_source_policy_with_origins(code_decls, eff, unit.origins, foreground_transform_policy(path, view_safety_checked, view_sanitize_memory));
        } else {
            authority = zir_prepare_const_i32_add_source_policy_with_origins(code_decls, eff, unit.origins, foreground_transform_policy(path, view_safety_checked, view_sanitize_memory));
        }
        if (authority.transform_count != 1) {
            _zag_eprintln("znc view: requested foreground transform had no checked source match");
            return 1;
        }
    } else if (((view_automatic == 1) && (view_safety_checked == 0)) && (@strEq(v2_project_edition(path), "2027") == 0)) {
        if (unit.profile == ModuleProfile.script) {
            authority = znc_script_zagd_automatic_authority(path, active, unit, code_decls, eff, unit.origins, authority);
        } else {
            let candidate: ZirAuthority = zir_prepare_const_i32_add_source_policy_with_origins(code_decls, eff, unit.origins, foreground_transform_policy(path, view_safety_checked, view_sanitize_memory));
            if (znc_daemon_transform_proposal_present(path) == 1) {
                if (znc_daemon_transform_proposal_matches(path, unit, candidate) == 1) {
                    authority = candidate;
                }
            } else {
                authority = candidate;
            }
        }
    }
    if (authority.valid == 0) {
        _zag_eprintln(_zag_str_concat("znc view: Zag IR verification failed; errors=", _zag_i64_to_str(authority.verify_errors as i64)));
        return 1;
    }
    let selected: X86CpuProfile = parse_x86_cpu_profile(znc_effective_cpu(path, (unit.profile == ModuleProfile.script) as i32));
    if (selected.valid == 0) {
        _zag_eprintln(selected.diagnostic);
        return 1;
    }
    let data: ArrayList[u8] = make[u8](16);
    let errors: i32 = 0;
    let route: i32 = 0;
    let raw: ArrayList[Instr] = lower_zir_program_mode_cpu_with_route(authority, &errors, &data, 0, selected.features.popcnt, selected.features.bmi1, view_safety_checked, view_sanitize_memory, @strEq(v2_project_edition(path), "2027") as i32, 0, &route);
    if (errors > 0) {
        _zag_eprintln("znc view: native lowering failed");
        return 1;
    }
    let allocated: ArrayList[Instr] = regalloc(raw);
    let optimized: ArrayList[Instr] = optimize(allocated);
    let selected_instrs: ArrayList[Instr] = peephole(optimized);
    let bytes: ArrayList[u8] = encode(selected_instrs);
    let rendered: ArrayList[u8] = print_mlir(authority.module);
    let report: ArrayList[u8] = make[u8]((rendered.len + (selected_instrs.len * 96)) + 512);
    znc_native_append_text(&report, rendered.data[0..rendered.len]);
    znc_native_append_text(&report, "// native-target=linux-x86_64 cpu=");
    znc_native_append_text(&report, selected.canonical);
    znc_native_append_text(&report, " lowering=");
    if (route == 1) {
        znc_native_append_text(&report, "zir-direct");
    } else {
        znc_native_append_text(&report, "verified-ast-bridge");
    }
    znc_native_append_text(&report, " ir-verifier=");
    znc_native_append_text(&report, zir_ir_verifier_name());
    znc_native_append_text(&report, " artifact_ir_consumed=");
    znc_native_append_i64(&report, route as i64);
    znc_native_append_text(&report, "\n// semantic-transform-status=");
    znc_native_append_text(&report, authority.transform_status);
    znc_native_append_text(&report, " rule=");
    znc_native_append_text(&report, authority.transform_rule);
    znc_native_append_text(&report, " checker=");
    znc_native_append_text(&report, authority.transform_checker);
    znc_native_append_text(&report, " transform_count=");
    znc_native_append_i64(&report, authority.transform_count as i64);
    znc_native_append_text(&report, " artifact_transform_consumed=");
    znc_native_append_i64(&report, ((route == 1) && (authority.transform_count == 1)) as i32 as i64);
    znc_native_append_text(&report, "\n");
    znc_native_append_text(&report, "// zir-contract=valid=");
    znc_native_append_i64(&report, authority.contract_valid as i64);
    znc_native_append_text(&report, " errors=");
    znc_native_append_i64(&report, authority.contract_errors as i64);
    znc_native_append_text(&report, " checked_ops=");
    znc_native_append_i64(&report, authority.contract_checked_ops as i64);
    znc_native_append_text(&report, " checked_values=");
    znc_native_append_i64(&report, authority.contract_checked_values as i64);
    znc_native_append_text(&report, " type_complete=");
    znc_native_append_i64(&report, authority.contract_type_complete as i64);
    znc_native_append_text(&report, " effects_complete=");
    znc_native_append_i64(&report, authority.contract_effects_complete as i64);
    znc_native_append_text(&report, " ownership_complete=");
    znc_native_append_i64(&report, authority.contract_ownership_complete as i64);
    znc_native_append_text(&report, " alias_complete=");
    znc_native_append_i64(&report, authority.contract_alias_complete as i64);
    znc_native_append_text(&report, " lifetime_complete=");
    znc_native_append_i64(&report, authority.contract_lifetime_complete as i64);
    znc_native_append_text(&report, " layout_complete=");
    znc_native_append_i64(&report, authority.contract_layout_complete as i64);
    znc_native_append_text(&report, " origin_complete=");
    znc_native_append_i64(&report, authority.contract_origin_complete as i64);
    znc_native_append_text(&report, " reason=");
    znc_native_append_text(&report, authority.contract_reason);
    znc_native_append_text(&report, "\n");
    znc_native_append_text(&report, "// machine-pipeline=regalloc,optimize,peephole raw-instructions=");
    znc_native_append_i64(&report, raw.len as i64);
    znc_native_append_text(&report, " selected-instructions=");
    znc_native_append_i64(&report, selected_instrs.len as i64);
    znc_native_append_text(&report, " machine-code-bytes=");
    znc_native_append_i64(&report, bytes.len as i64);
    znc_native_append_text(&report, "\n");
    let i: i32 = 0;
    while (i < selected_instrs.len) {
        znc_native_append_instr(&report, selected_instrs.data[i], i);
        i = i + 1;
    }
    znc_native_append_text(&report, "// machine-code-hex=");
    let hex: []u8 = znc_hex_encode(bytes.data[0..bytes.len]);
    znc_native_append_text(&report, hex);
    znc_native_append_text(&report, "\n");
    let output: []u8 = flag_value("--output");
    if (output.len > 0) {
        if (znc_harden_atomic_output(output, report.data[0..report.len]) == 0) {
            free[u8](&report);
            free[u8](&bytes);
            free[Instr](&selected_instrs);
            free[Instr](&optimized);
            free[Instr](&allocated);
            free[Instr](&raw);
            free[u8](&data);
            free[u8](&rendered);
            _zag_eprintln("znc native view: failed to publish output without replacing an existing entry");
            return 1;
        }
        _zag_println(_zag_str_concat("znc native view: wrote ", output));
    } else {
        _zag_print(report.data[0..report.len]);
    }
    free[u8](&report);
    free[Instr](&selected_instrs);
    free[Instr](&optimized);
    free[Instr](&allocated);
    free[Instr](&raw);
    free[u8](&bytes);
    free[u8](&data);
    free[u8](&rendered);
    return 0;
}

fn znc_view(path: []u8) i32 {
    if (path.len == 0) {
        _zag_eprintln("znc view: no source file");
        return 1;
    }
    if (v2_validate_options() != 0) {
        return 1;
    }
    let level: []u8 = flag_value("--level");
    if (level.len == 0) {
        _zag_eprintln("znc view: --level simple|explained|explicit|native is required");
        return 1;
    }
    if ((foreground_transform_requested() == 1) && !@strEq(level, "native")) {
        _zag_eprintln("znc view: --foreground-transform is supported only with --level native");
        return 1;
    }
    if (@strEq(level, "simple")) {
        let read: ForegroundBoundedRead = fc_read_bounded(path, zdl_max_source_bytes());
        if (read.ok == 0) {
            free[u8](&read.bytes);
            _zag_eprintln("znc view: source is missing, unsafe, or exceeds the portable source bound");
            return 1;
        }
        _zag_print(read.bytes.data[0..read.bytes.len]);
        free[u8](&read.bytes);
        return 0;
    }
    if (@strEq(level, "explained")) {
        return znc_explain(path);
    }
    if (@strEq(level, "explicit")) {
        return znc_harden(path);
    }
    if (@strEq(level, "native")) {
        let read: ForegroundBoundedRead = fc_read_bounded(path, zdl_max_source_bytes());
        if (read.ok == 0) {
            free[u8](&read.bytes);
            _zag_eprintln("znc view: source is missing, unsafe, or exceeds the portable source bound");
            return 1;
        }
        let status: i32 = znc_native_view(path, read.bytes.data[0..read.bytes.len], "view");
        free[u8](&read.bytes);
        return status;
    }
    _zag_eprintln("znc view: --level must be simple, explained, explicit, or native");
    return 1;
}

fn znc_expand(path: []u8) i32 {
    let to: []u8 = flag_value("--to");
    if (to.len == 0) {
        _zag_eprintln("znc expand: --to simple|explained|explicit|native is required");
        return 1;
    }
    if ((foreground_transform_requested() == 1) && !@strEq(to, "native")) {
        _zag_eprintln("znc expand: --foreground-transform is supported only with --to native");
        return 1;
    }
    if (@strEq(to, "explicit")) {
        return znc_harden(path);
    }
    if (@strEq(to, "simple")) {
        let read: ForegroundBoundedRead = fc_read_bounded(path, zdl_max_source_bytes());
        if (read.ok == 0) {
            free[u8](&read.bytes);
            _zag_eprintln("znc expand: source is missing, unsafe, or exceeds the portable source bound");
            return 1;
        }
        let source: []u8 = read.bytes.data[0..read.bytes.len];
        let output: []u8 = flag_value("--output");
        if (output.len > 0) {
            let ok: i32 = znc_harden_atomic_output(output, source);
            free[u8](&read.bytes);
            if (ok == 0) {
                _zag_eprintln("znc expand: failed to publish output without replacing an existing entry");
                return 1;
            }
            _zag_println(_zag_str_concat("znc expand: wrote ", output));
            return 0;
        }
        _zag_print(source);
        free[u8](&read.bytes);
        return 0;
    }
    if (@strEq(to, "explained")) {
        let output: []u8 = flag_value("--output");
        if (output.len > 0) {
            return znc_explain_capture(path, output);
        }
        return znc_explain(path);
    }
    if (@strEq(to, "native")) {
        let read: ForegroundBoundedRead = fc_read_bounded(path, zdl_max_source_bytes());
        if (read.ok == 0) {
            free[u8](&read.bytes);
            _zag_eprintln("znc expand: source is missing, unsafe, or exceeds the portable source bound");
            return 1;
        }
        let status: i32 = znc_native_view(path, read.bytes.data[0..read.bytes.len], "expand");
        free[u8](&read.bytes);
        return status;
    }
    _zag_eprintln("znc expand: --to must be simple, explained, explicit, or native");
    return 1;
}

fn znc_promote(path: []u8) i32 {
    if (znc_ledger_runtime_enabled() == 0) {
        _zag_eprintln("znc promote: reversible ledger runtime integration is not release-enabled; no files changed");
        return 1;
    }
    if (path.len == 0) {
        _zag_eprintln("znc promote: source path is required");
        return 1;
    }
    let output: []u8 = flag_value("--output");
    let command: []u8 = flag_value("--test-command");
    if ((output.len == 0) || (command.len == 0)) {
        _zag_eprintln("znc promote: --output and --test-command are required");
        return 1;
    }
    if (@strEq(output, path) || (znc_path_absent_nofollow(output) == 0)) {
        _zag_eprintln("znc promote: output already exists or is not safe");
        return 1;
    }
    let sidecar_preflight: []u8 = _zag_str_concat(output, ".zsledger");
    if (znc_path_absent_nofollow(sidecar_preflight) == 0) {
        _zag_free(_zag_slice_ptr(sidecar_preflight));
        _zag_eprintln("znc promote: sidecar already exists or is not safe");
        return 1;
    }
    _zag_free(_zag_slice_ptr(sidecar_preflight));
    let source_read: ForegroundBoundedRead = fc_read_bounded(path, zdl_max_source_bytes());
    if (source_read.ok == 0) {
        free[u8](&source_read.bytes);
        _zag_eprintln("znc promote: source is missing, unsafe, or exceeds portable ledger bound");
        return 1;
    }
    let source_snapshot: []u8 = source_read.bytes.data[0..source_read.bytes.len];
    let prepared: ZHardenPrepared = znc_harden_prepare(path, source_snapshot);
    if ((prepared.valid == 0) || (prepared.candidate_valid == 0)) {
        _zag_eprintln("znc promote: no strict candidate is available");
        return 1;
    }
    if (znc_harden_snapshot_current(path, prepared) == 0) {
        _zag_eprintln("znc promote: source graph changed after snapshot; no files changed");
        return 1;
    }
    if (znc_harden_atomic_output(output, prepared.candidate) == 0) {
        _zag_eprintln("znc promote: failed to publish explicit candidate without replacing an existing entry");
        return 1;
    }
    let parity: i32 = _zag_exec_cmd(command);
    if (parity != 0) {
        _zag_eprintln("znc promote: parity tests failed; uncertain output left in place as ownership-uncertain");
        return 1;
    }
    if (znc_harden_snapshot_current(path, prepared) == 0) {
        _zag_eprintln("znc promote: source graph changed after parity; output left in place");
        return 1;
    }
    let ledger: []u8 = znc_derivation_ledger_v2(path, prepared, command);
    if (ledger.len == 0) {
        _zag_eprintln("znc promote: prepared-evidence ledger is unavailable; output left in place");
        return 1;
    }
    let sidecar: []u8 = _zag_str_concat(output, ".zsledger");
    if (znc_path_absent_nofollow(sidecar) == 0) {
        _zag_free(_zag_slice_ptr(ledger));
        _zag_free(_zag_slice_ptr(sidecar));
        _zag_eprintln("znc promote: foreign sidecar preserved; output left in place");
        return 1;
    }
    let side_ok: i32 = znc_harden_atomic_output(sidecar, ledger);
    _zag_free(_zag_slice_ptr(ledger));
    _zag_free(_zag_slice_ptr(sidecar));
    if (side_ok == 0) {
        _zag_eprintln("znc promote: failed to publish provenance without replacing an existing entry; output left in place");
        return 1;
    }
    _zag_println(_zag_str_concat("znc promote: published ", output));
    return 0;
}

fn znc_unexpand(path: []u8) i32 {
    if (znc_ledger_runtime_enabled() == 0) {
        _zag_eprintln("znc unexpand: reversible ledger runtime integration is not release-enabled");
        return 1;
    }
    if (path.len == 0) {
        _zag_eprintln("znc unexpand: promoted source path is required");
        return 1;
    }
    let sidecar: []u8 = _zag_str_concat(path, ".zsledger");
    let raw: ForegroundBoundedRead = fc_read_bounded(sidecar, 67108864);
    _zag_free(_zag_slice_ptr(sidecar));
    if (raw.ok == 0) {
        free[u8](&raw.bytes);
        _zag_eprintln("znc unexpand: invalid portable derivation ledger (sidecar unavailable or exceeds bound)");
        return 1;
    }
    let view: ZdlLedgerView = zdl_decode(raw.bytes.data[0..raw.bytes.len]);
    free[u8](&raw.bytes);
    if ((view.valid == 0) || ((view.version != 1) && (view.version != 2))) {
        _zag_eprintln("znc unexpand: invalid portable derivation ledger (sidecar failed bounded validation)");
        return 1;
    }
    let promoted: ForegroundBoundedRead = fc_read_bounded(path, zdl_max_source_bytes());
    if (promoted.ok == 0) {
        free[u8](&promoted.bytes);
        znc_free_ledger_view(&view);
        _zag_eprintln("znc unexpand: edited projection is unavailable or ambiguous");
        return 1;
    }
    let edited: []u8 = promoted.bytes.data[0..promoted.bytes.len];
    let projected: ZsProjection = script_projection(view.compact, view.derived, edited);
    if (projected.ok == 0) {
        free[u8](&promoted.bytes);
        znc_free_ledger_view(&view);
        _zag_eprintln("znc unexpand: structural projection conflict at derived bytes");
        return 1;
    }
    let output: []u8 = flag_value("--output");
    let target: []u8 = output;
    if (target.len == 0) {
        target = _zag_str_concat(path, ".unexpanded.zs");
    }
    if (znc_path_absent_nofollow(target) == 0) {
        if (@strEq(projected.reason, "unchanged") == 0) {
            free[u8](&projected.compact);
        }
        free[u8](&promoted.bytes);
        znc_free_ledger_view(&view);
        _zag_eprintln("znc unexpand: output already exists or is not safe");
        return 1;
    }
    let ok: i32 = znc_harden_atomic_output(target, projected.compact);
    if (@strEq(projected.reason, "unchanged") == 0) {
        free[u8](&projected.compact);
    }
    free[u8](&promoted.bytes);
    znc_free_ledger_view(&view);
    if (ok == 0) {
        _zag_eprintln("znc unexpand: failed to publish compact source");
        return 1;
    }
    _zag_println(_zag_str_concat("znc unexpand: restored ", target));
    return 0;
}

fn znc_init() i32 {
    let modpath: []u8 = "zag.mod";
    if (_zag_file_exists(modpath) != 0) {
        _zag_eprintln("znc init: zag.mod already exists; no files changed");
        return 1;
    }
    if (((((_zag_file_exists("src/main.zag") != 0) || (_zag_file_exists("tests/smoke.zag") != 0)) || (_zag_file_exists("deps/README.md") != 0)) || (_zag_file_exists("README.md") != 0)) || (_zag_file_exists(".gitignore") != 0)) {
        _zag_eprintln("znc init: a scaffold target already exists; no files changed");
        return 1;
    }
    let project_name: []u8 = flag_value("--name");
    if (project_name.len == 0) {
        project_name = stem_of(znc_cwd());
    }
    if (project_name.len == 0) {
        project_name = "myproject";
    }
    if (((fc_mkdir("src") == 0) || (fc_mkdir("tests") == 0)) || (fc_mkdir("deps") == 0)) {
        _zag_eprintln("znc init: could not create src/, tests/, and deps/");
        return 1;
    }
    let content: []u8 = _zag_str_concat("name = \"", _zag_str_concat(project_name, "\"\nversion = \"0.1.0\"\nedition = \"2026\"\n"));
    let main_source: []u8 = "script;\n\nprintln(\"Hello from Zag\");\nreturn 0;\n";
    let smoke_source: []u8 = "script;\n\nif (2 + 2 != 4) { return 1; }\nprintln(\"smoke: ok\");\nreturn 0;\n";
    let readme: []u8 = _zag_str_concat("# ", _zag_str_concat(project_name, "\n\nRun the app:\n\n```sh\nznc src/main.zag -o app --run\n```\n\nRun the starter smoke test:\n\n```sh\nznc tests/smoke.zag -o smoke --run\n```\n\nUseful commands:\n\n```sh\nznc check src/main.zag\nznc fmt --in-place src/main.zag\nznc --help\n```\n\n## Early systems language\n\nZag is an early systems language. Local and vendored dependencies work, and a\nreviewed local registry-index mode is available without network access; there is\nno public package registry yet. The bounded Linux x86-64 async surface supports\ncaptureless `async fn(i64) i64`, `await(handle)`, result polling, and explicit\ncancellation. Generic futures, automatic scheduler propagation, portable async\ntargets, RAII/destructors, and full memory safety are not available yet. See\n`docs/SUPPORT.md` in the Zag distribution for the exact target and language\nboundaries.\n"));
    let wrc: i32 = _zag_write_file(modpath, content);
    if ((((((wrc != 0) || (_zag_write_file("src/main.zag", main_source) != 0)) || (_zag_write_file("tests/smoke.zag", smoke_source) != 0)) || (_zag_write_file("deps/README.md", "# Vendored dependencies\n\nZag has no package registry or network resolver; a reviewed local registry-index mode is offline-only and does not fetch. Vendor reviewed `.zag` source here, pin it with version control, and import it with an explicit relative path. See the compiler support contract for the exact dependency boundary.\n") != 0)) || (_zag_write_file("README.md", readme) != 0)) || (_zag_write_file(".gitignore", ".zag-cache/\napp\nsmoke\n") != 0)) {
        _zag_eprintln("znc init: failed while writing the project scaffold");
        return 1;
    }
    _zag_println(_zag_str_concat("Initialized Zag project `", _zag_str_concat(project_name, "`.")));
    _zag_println("  Run:  znc src/main.zag -o app --run");
    _zag_println("  Test: znc tests/smoke.zag -o smoke --run");
    _zag_println("  Help: znc --help");
    _zag_println("  Note: early systems language - see README.md and docs/SUPPORT.md for boundaries");
    return 0;
}

fn first_nonflag_from(start: i32) []u8 {
    let i: i32 = start;
    while (i < _zag_argc()) {
        let a: []u8 = _zag_arg(i);
        if ((a.len > 0) && (a[0] != 45)) {
            return a;
        }
        i = i + 1;
    }
    return "";
}

fn znc_parent_dir(path: []u8) []u8 {
    let end: i32 = path.len;
    while ((end > 1) && (path[end - 1] == 47)) {
        end = end - 1;
    }
    let i: i32 = end - 1;
    while ((i >= 0) && (path[i] != 47)) {
        i = i - 1;
    }
    if (i < 0) {
        return ".";
    }
    if (i == 0) {
        return "/";
    }
    return path[0..i];
}

fn znc_cwd() []u8 {
    let buf: ArrayList[u8] = make[u8](4096);
    while (buf.len < 4096) {
        push[u8](&buf, 0 as u8);
    }
    let rc: i64 = _zag_raw_syscall(79, _zag_slice_ptr(buf.data[0..buf.len]) as i64, buf.len, 0, 0, 0, 0);
    if (rc <= 1) {
        return ".";
    }
    return buf.data[0..rc as i32 - 1];
}

fn znc_absolute_dir(path: []u8) []u8 {
    if ((path.len > 0) && (path[0] == 47)) {
        return path;
    }
    if (@strEq(path, ".")) {
        return znc_cwd();
    }
    return _zag_str_concat(znc_cwd(), _zag_str_concat("/", path));
}

fn znc_project_root(start: []u8) []u8 {
    let cur: []u8 = znc_absolute_dir(start);
    let fallback: []u8 = cur;
    let steps: i32 = 0;
    while (steps < 64) {
        if ((_zag_file_exists(_zag_str_concat(cur, "/zag.mod")) == 1) || (_zag_file_exists(_zag_str_concat(cur, "/.zagd.conf")) == 1)) {
            return cur;
        }
        let parent: []u8 = znc_parent_dir(cur);
        if (@strEq(parent, cur)) {
            return fallback;
        }
        cur = parent;
        steps = steps + 1;
    }
    return fallback;
}

fn znc_project_relative(root: []u8, path: []u8) []u8 {
    let absolute: []u8 = path;
    if (path.len == 0) {
        return path;
    }
    if (path[0] != 47) {
        absolute = _zag_str_concat(znc_cwd(), _zag_str_concat("/", path));
    }
    if (((absolute.len > root.len) && @strEq(absolute[0..root.len], root)) && (absolute[root.len] == 47)) {
        return absolute[root.len + 1..];
    }
    return path;
}

fn znc_publish_semantics(path: []u8, src: []u8, unit: CompilationUnit, decls: ArrayList[*Node], eff: map__StringMap[i32]) i32 {
    let root: []u8 = znc_project_root(dir_of(path));
    let module_path: []u8 = znc_project_relative(root, path);
    return semantic_manifest_publish(root, module_path, src, unit, eff);
}

fn znc_contains(haystack: []u8, needle: []u8) i32 {
    if ((needle.len == 0) || (needle.len > haystack.len)) {
        return 0;
    }
    let i: i32 = 0;
    while ((i + needle.len) <= haystack.len) {
        let j: i32 = 0;
        let same: i32 = 1;
        while (j < needle.len) {
            if (haystack[i + j] != needle[j]) {
                same = 0;
            }
            j = j + 1;
        }
        if (same == 1) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn znc_project_config_authoritative(root: []u8) PlannerConfig {
    let path: []u8 = _zag_str_concat(root, "/.zagd.conf");
    if (_zag_file_exists(path) == 0) {
        return planner_default_config();
    }
    let cfg: []u8 = _zag_read_file(path);
    if (cfg.len < 0) {
        let unreadable: PlannerConfig = planner_default_config();
        unreadable.valid = 0;
        unreadable.diagnostic = "planner config: .zagd.conf exists but could not be read";
        return unreadable;
    }
    return planner_parse_config(cfg);
}

fn znc_invalid_project_config(root: []u8, operation: []u8) i32 {
    let parsed: PlannerConfig = znc_project_config_authoritative(root);
    if (parsed.valid == 1) {
        return 0;
    }
    _zag_eprintln(_zag_str_concat("znc ", _zag_str_concat(operation, _zag_str_concat(": invalid .zagd.conf: ", parsed.diagnostic))));
    return 1;
}

fn znc_project_config(root: []u8, warn_invalid: i32) PlannerConfig {
    let parsed: PlannerConfig = znc_project_config_authoritative(root);
    if (parsed.valid == 0) {
        if (warn_invalid == 1) {
            _zag_eprintln(_zag_str_concat("znc: warning: ", _zag_str_concat(parsed.diagnostic, "; using documented defaults")));
        }
        return planner_default_config();
    }
    return parsed;
}

fn znc_project_mode(root: []u8) []u8 {
    let parsed: PlannerConfig = znc_project_config(root, 1);
    if (@strEq(parsed.mode, "advisory")) {
        return "light";
    }
    return parsed.mode;
}

fn znc_script_capability_bits(cfg: PlannerConfig) i64 {
    return ((cfg.allow_filesystem_read as i64 + (cfg.allow_filesystem_write as i64 * 2)) + (cfg.allow_process as i64 * 4)) + ((cfg.environment_allow.len > 0) as i64 * 8);
}

fn znc_script_cpu_policy_id(name: []u8) i32 {
    let profile: X86CpuProfile = parse_x86_cpu_profile(name);
    if (profile.valid == 0) {
        return 0;
    }
    if (profile.request_kind == 2) {
        return 2;
    }
    if (profile.request_kind == 4) {
        return 0;
    }
    return 1;
}

fn znc_script_allocator_policy_id(name: []u8) i32 {
    if (@strEq(name, "script_process_arena")) {
        return 1;
    }
    if (@strEq(name, "script_bounded_heap")) {
        return 2;
    }
    return 0;
}

fn znc_script_allocator_reclamation(name: []u8) []u8 {
    if (@strEq(name, "script_bounded_heap")) {
        return "all tracked bounded-heap blocks freed at generated shutdown";
    }
    return "one bounded Script arena unmapped at generated shutdown";
}

fn znc_script_execution_policy(resolved: PlannerResolution) i64 {
    let device_id: i32 = 0;
    let layout_id: i32 = 0;
    if (@strEq(resolved.choices.device, "cpu")) {
        device_id = 1;
    }
    if (@strEq(resolved.choices.layout, "compiler_owned")) {
        layout_id = 1;
    }
    return script_execution_policy_bits(znc_script_allocator_policy_id(resolved.choices.allocator), znc_script_cpu_policy_id(resolved.choices.cpu), device_id, layout_id);
}

fn znc_configure_script_unit(unit: *CompilationUnit, path: []u8) i32 {
    if (unit.*.profile != ModuleProfile.script) {
        return 0;
    }
    let root: []u8 = znc_project_root(dir_of(path));
    let cfg: PlannerConfig = znc_project_config(root, 0);
    let input: PlannerChoices = znc_script_explicit_choices();
    let resolved: PlannerResolution = planner_resolve(1, "", cfg, input, 0);
    let configured: i32 = compilation_unit_set_script_memory_limit(unit, cfg.script_memory_bytes);
    let runtime_policy: i32 = compilation_unit_set_script_runtime_policy(unit, znc_script_capability_bits(cfg), znc_script_execution_policy(resolved));
    let source_label: i32 = compilation_unit_set_script_source_label(unit, path);
    if (((configured != 0) || (runtime_policy != 0)) || (source_label != 0)) {
        _zag_eprintln("znc: internal error: could not configure compiler-owned Script entry policy");
        return 1;
    }
    return 0;
}

fn znc_validate_script_defaults(path: []u8, unit: CompilationUnit) i32 {
    if (unit.profile != ModuleProfile.script) {
        return 0;
    }
    let cfg: PlannerConfig = znc_project_config(znc_project_root(dir_of(path)), 1);
    let input: PlannerChoices = znc_script_explicit_choices();
    let r: PlannerResolution = planner_resolve(1, "", cfg, input, 0);
    if (r.diagnostic.len > 0) {
        _zag_eprintln(r.diagnostic);
        return 1;
    }
    if (((znc_script_allocator_policy_id(r.choices.allocator) == 0) || (@strEq(r.choices.device, "cpu") == 0)) || (@strEq(r.choices.layout, "compiler_owned") == 0)) {
        _zag_eprintln("znc: unsupported Zag Script planner default; supported allocator=script_process_arena or script_bounded_heap, device=cpu, layout=compiler_owned");
        return 1;
    }
    let p: X86CpuProfile = parse_x86_cpu_profile(r.choices.cpu);
    if (p.valid == 0) {
        _zag_eprintln(_zag_str_concat("znc: ", p.diagnostic));
        return 1;
    }
    if (znc_script_cpu_policy_id(r.choices.cpu) == 0) {
        _zag_eprintln("znc: unsupported Zag Script CPU policy; supported cpu=generic or cpu=native");
        return 1;
    }
    return 0;
}

fn znc_script_expr_calls(n: *Node, target: []u8) i32 {
    switch (n.*) {
        .call => |c| {
            if (@strEq(callee_name(c.callee), target)) {
                return 1;
            }
            let i: i32 = 0;
            while (i < len[*Node](c.args)) {
                if (znc_script_expr_calls(get[*Node](c.args, i), target) == 1) {
                    return 1;
                }
                i = i + 1;
            }
            return znc_script_expr_calls(c.callee, target);
        }
        .bin => |b| {
            return znc_script_expr_calls(b.l, target) | znc_script_expr_calls(b.r, target);
        }
        .un => |u| {
            return znc_script_expr_calls(u.e, target);
        }
        .idx => |x| {
            return znc_script_expr_calls(x.base, target) | znc_script_expr_calls(x.idx, target);
        }
        .fld => |f| {
            return znc_script_expr_calls(f.base, target);
        }
        .cast_ => |c| {
            return znc_script_expr_calls(c.expr, target);
        }
        .slice_ => |s| {
            let hit: i32 = znc_script_expr_calls(s.base, target) | znc_script_expr_calls(s.lo, target);
            if (s.has_hi == 1) {
                hit = hit | znc_script_expr_calls(s.hi, target);
            }
            return hit;
        }
        .slit_ => |s| {
            let i: i32 = 0;
            while (i < len[FieldInit](s.fields)) {
                if (znc_script_expr_calls(get[FieldInit](s.fields, i).val, target) == 1) {
                    return 1;
                }
                i = i + 1;
            }
            return 0;
        }
        .switch_ => |s| {
            if (znc_script_expr_calls(s.subject, target) == 1) {
                return 1;
            }
            let i: i32 = 0;
            while (i < len[SwitchArm](s.arms)) {
                if (znc_script_block_calls(get[SwitchArm](s.arms, i).body, target) == 1) {
                    return 1;
                }
                i = i + 1;
            }
            return znc_script_block_calls(s.els_body, target);
        }
        else => {
            return 0;
        }
    }
}

fn znc_script_block_calls(body: ArrayList[*Node], target: []u8) i32 {
    let i: i32 = 0;
    while (i < len[*Node](body)) {
        let hit: i32 = 0;
        switch (get[*Node](body, i).*) {
            .let_ => |l| {
                if (l.has_init == 1) {
                    hit = znc_script_expr_calls(l.expr, target);
                }
            }
            .ret => |r| {
                if (r.has_expr == 1) {
                    hit = znc_script_expr_calls(r.expr, target);
                }
            }
            .estmt => |e| {
                hit = znc_script_expr_calls(e.expr, target);
            }
            .assign => |a| {
                hit = znc_script_expr_calls(a.target, target) | znc_script_expr_calls(a.expr, target);
            }
            .if_ => |x| {
                hit = (znc_script_expr_calls(x.cond, target) | znc_script_block_calls(x.then_body, target)) | znc_script_block_calls(x.els_body, target);
            }
            .while_ => |w| {
                hit = znc_script_expr_calls(w.cond, target) | znc_script_block_calls(w.body, target);
            }
            .unsafe_ => |u| {
                hit = znc_script_block_calls(u.body, target);
            }
            .switch_ => |s| {
                hit = znc_script_expr_calls(get[*Node](body, i), target);
            }
            else => {
            }
        }
        if (hit == 1) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn znc_script_generated_calls(unit: CompilationUnit, target: []u8) i32 {
    let i: i32 = 0;
    while (i < len[*Node](unit.decls)) {
        switch (get[*Node](unit.decls, i).*) {
            .fn_decl => |f| {
                if (@strEq(f.name, "__zag_compiler_script_body_7f3a")) {
                    return znc_script_block_calls(f.body, target);
                }
            }
            else => {
            }
        }
        i = i + 1;
    }
    return 0;
}

fn znc_environment_allow_has(list: []u8, name: []u8) i32 {
    let start: i32 = 0;
    let i: i32 = 0;
    while (i <= list.len) {
        if ((i == list.len) || (list[i] == 44)) {
            if (@strEq(list[start..i], name)) {
                return 1;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return 0;
}

fn znc_script_environment_literal(text: []u8) []u8 {
    if (((text.len < 2) || (text[0] != 34)) || (text[text.len - 1] != 34)) {
        return "";
    }
    let value: []u8 = text[1..text.len - 1];
    let i: i32 = 0;
    while (i < value.len) {
        if (value[i] == 92) {
            return "";
        }
        i = i + 1;
    }
    return value;
}

fn znc_script_env_expr_violations(n: *Node, cfg: PlannerConfig, report: i32) i32 {
    let failures: i32 = 0;
    switch (n.*) {
        .call => |c| {
            let name: []u8 = callee_name(c.callee);
            if (@strEq(name, "_zag_getenv")) {
                if (report == 1) {
                    _zag_eprintln("znc script capability: direct _zag_getenv is unavailable in Zag Script; use env(\"NAME\") with environment_allow");
                }
                failures = failures + 1;
            }
            if (@strEq(name, "_zag_script_env_get")) {
                if (c.args.len != 2) {
                    if (report == 1) {
                        _zag_eprintln("znc script capability: env requires one literal simple variable name");
                    }
                    failures = failures + 1;
                } else {
                    switch (c.args.data[1].*) {
                        .slit => |s| {
                            let variable: []u8 = znc_script_environment_literal(s.text);
                            if (planner_environment_name_valid(variable) == 0) {
                                if (report == 1) {
                                    _zag_eprintln("znc script capability: env requires a literal simple variable name so environment_allow can be checked");
                                }
                                failures = failures + 1;
                            } else if (znc_environment_allow_has(cfg.environment_allow, variable) == 0) {
                                if (report == 1) {
                                    _zag_eprintln(_zag_str_concat("znc script capability: env(\"", _zag_str_concat(variable, "\") denied; add the exact name to environment_allow")));
                                }
                                failures = failures + 1;
                            }
                        }
                        else => {
                            if (report == 1) {
                                _zag_eprintln("znc script capability: env requires a literal simple variable name so environment_allow can be checked");
                            }
                            failures = failures + 1;
                        }
                    }
                }
            }
            failures = failures + znc_script_env_expr_violations(c.callee, cfg, report);
            let i: i32 = 0;
            while (i < c.args.len) {
                failures = failures + znc_script_env_expr_violations(c.args.data[i], cfg, report);
                i = i + 1;
            }
        }
        .bin => |x| {
            failures = (failures + znc_script_env_expr_violations(x.l, cfg, report)) + znc_script_env_expr_violations(x.r, cfg, report);
        }
        .un => |x| {
            failures = failures + znc_script_env_expr_violations(x.e, cfg, report);
        }
        .fld => |x| {
            failures = failures + znc_script_env_expr_violations(x.base, cfg, report);
        }
        .idx => |x| {
            failures = (failures + znc_script_env_expr_violations(x.base, cfg, report)) + znc_script_env_expr_violations(x.idx, cfg, report);
        }
        .cast_ => |x| {
            failures = failures + znc_script_env_expr_violations(x.expr, cfg, report);
        }
        .slice_ => |x| {
            failures = (failures + znc_script_env_expr_violations(x.base, cfg, report)) + znc_script_env_expr_violations(x.lo, cfg, report);
            if (x.has_hi == 1) {
                failures = failures + znc_script_env_expr_violations(x.hi, cfg, report);
            }
        }
        .slit_ => |x| {
            let i: i32 = 0;
            while (i < x.fields.len) {
                failures = failures + znc_script_env_expr_violations(x.fields.data[i].val, cfg, report);
                i = i + 1;
            }
        }
        .switch_ => |x| {
            failures = failures + znc_script_env_expr_violations(x.subject, cfg, report);
            let i: i32 = 0;
            while (i < x.arms.len) {
                failures = failures + znc_script_env_body_violations(x.arms.data[i].body, cfg, report);
                i = i + 1;
            }
            failures = failures + znc_script_env_body_violations(x.els_body, cfg, report);
        }
        else => {
        }
    }
    return failures;
}

fn znc_script_env_body_violations(body: ArrayList[*Node], cfg: PlannerConfig, report: i32) i32 {
    let failures: i32 = 0;
    let i: i32 = 0;
    while (i < body.len) {
        switch (body.data[i].*) {
            .let_ => |x| {
                if (x.has_init == 1) {
                    failures = failures + znc_script_env_expr_violations(x.expr, cfg, report);
                }
            }
            .ret => |x| {
                if (x.has_expr == 1) {
                    failures = failures + znc_script_env_expr_violations(x.expr, cfg, report);
                }
            }
            .estmt => |x| {
                failures = failures + znc_script_env_expr_violations(x.expr, cfg, report);
            }
            .assign => |x| {
                failures = (failures + znc_script_env_expr_violations(x.target, cfg, report)) + znc_script_env_expr_violations(x.expr, cfg, report);
            }
            .if_ => |x| {
                failures = ((failures + znc_script_env_expr_violations(x.cond, cfg, report)) + znc_script_env_body_violations(x.then_body, cfg, report)) + znc_script_env_body_violations(x.els_body, cfg, report);
            }
            .while_ => |x| {
                failures = (failures + znc_script_env_expr_violations(x.cond, cfg, report)) + znc_script_env_body_violations(x.body, cfg, report);
            }
            .unsafe_ => |x| {
                failures = failures + znc_script_env_body_violations(x.body, cfg, report);
            }
            .switch_ => |x| {
                failures = failures + znc_script_env_expr_violations(x.subject, cfg, report);
                let ai: i32 = 0;
                while (ai < x.arms.len) {
                    failures = failures + znc_script_env_body_violations(x.arms.data[ai].body, cfg, report);
                    ai = ai + 1;
                }
                failures = failures + znc_script_env_body_violations(x.els_body, cfg, report);
            }
            else => {
            }
        }
        i = i + 1;
    }
    return failures;
}

fn znc_script_env_violations(unit: CompilationUnit, cfg: PlannerConfig, report: i32) i32 {
    let i: i32 = 0;
    while (i < unit.decls.len) {
        switch (unit.decls.data[i].*) {
            .fn_decl => |f| {
                if (@strEq(f.name, "__zag_compiler_script_body_7f3a")) {
                    return znc_script_env_body_violations(f.body, cfg, report);
                }
            }
            else => {
            }
        }
        i = i + 1;
    }
    return 0;
}

fn znc_validate_script_capabilities(path: []u8, unit: CompilationUnit) i32 {
    if (unit.profile != ModuleProfile.script) {
        return 0;
    }
    let cfg: PlannerConfig = znc_project_config(znc_project_root(dir_of(path)), 1);
    let violations: i32 = 0;
    if ((cfg.allow_filesystem_read == 0) && (znc_script_generated_calls(unit, "script_read_file") == 1)) {
        _zag_eprintln("znc script capability: read_file denied by allow_filesystem_read=false");
        violations = violations + 1;
    }
    if ((cfg.allow_filesystem_write == 0) && (znc_script_generated_calls(unit, "_zag_write_file") == 1)) {
        _zag_eprintln("znc script capability: write_file denied by allow_filesystem_write=false");
        violations = violations + 1;
    }
    if ((cfg.allow_process == 0) && ((znc_script_generated_calls(unit, "process_run_bounded_script") == 1) || (znc_script_generated_calls(unit, "process_run_argv_bounded_script") == 1))) {
        _zag_eprintln("znc script capability: process API denied by allow_process=false");
        violations = violations + 1;
    }
    violations = violations + znc_script_env_violations(unit, cfg, 1);
    return violations;
}

fn znc_parse_pid(value: []u8) i64 {
    let result: i64 = 0;
    let i: i32 = 0;
    while (((i < value.len) && (value[i] >= 48)) && (value[i] <= 57)) {
        result = (result * 10) + (value[i] as i64 - 48);
        i = i + 1;
    }
    return result;
}

fn znc_shell_quote(value: []u8) []u8 {
    let out: []u8 = "'";
    let i: i32 = 0;
    while (i < value.len) {
        if (value[i] == 39) {
            out = _zag_str_concat(out, "'\\''");
        } else {
            out = _zag_str_concat(out, value[i..i + 1]);
        }
        i = i + 1;
    }
    return _zag_str_concat(out, "'");
}

fn znc_sibling_zagd() []u8 {
    return _zag_str_concat(dir_of(_zag_arg(0)), "/zagd");
}

fn znc_mode_arg() []u8 {
    let i: i32 = 2;
    while (i < _zag_argc()) {
        if (@strEq(_zag_arg(i), "--mode")) {
            if ((i + 1) >= _zag_argc()) {
                return "";
            }
            return _zag_arg(i + 1);
        }
        i = i + 1;
    }
    return "";
}

fn znc_valid_zagd_mode(mode: []u8) i32 {
    if (((@strEq(mode, "off") || @strEq(mode, "light")) || @strEq(mode, "adaptive")) || @strEq(mode, "deep")) {
        return 1;
    }
    return 0;
}

fn znc_bool_arg(value: i32) []u8 {
    if (value == 1) {
        return "true";
    }
    return "false";
}

fn znc_zagd_exec_config(root: []u8, root_source: []u8, mode: []u8, cfg: PlannerConfig, daemonize: i32) i32 {
    let binary: []u8 = znc_sibling_zagd();
    if (_zag_file_exists(binary) == 0) {
        return 127;
    }
    let command: []u8 = znc_shell_quote(binary);
    command = _zag_str_concat(command, _zag_str_concat(" --root ", znc_shell_quote(root)));
    if (root_source.len > 0) {
        command = _zag_str_concat(command, _zag_str_concat(" --root-source ", znc_shell_quote(root_source)));
    }
    command = _zag_str_concat(command, _zag_str_concat(" --mode ", znc_shell_quote(mode)));
    command = _zag_str_concat(command, _zag_str_concat(" --idle-deep ", znc_bool_arg(cfg.idle_deep)));
    command = _zag_str_concat(command, _zag_str_concat(" --difficulty ", znc_shell_quote(cfg.difficulty)));
    command = _zag_str_concat(command, _zag_str_concat(" --script-optimization ", znc_shell_quote(cfg.script_optimization)));
    command = _zag_str_concat(command, _zag_str_concat(" --regular-optimization ", znc_shell_quote(cfg.regular_optimization)));
    command = _zag_str_concat(command, _zag_str_concat(" --objective ", znc_shell_quote(cfg.objective)));
    command = _zag_str_concat(command, _zag_str_concat(" --trust-mode ", znc_shell_quote(cfg.trust_mode)));
    command = _zag_str_concat(command, _zag_str_concat(" --cpu ", znc_shell_quote(cfg.default_cpu)));
    command = _zag_str_concat(command, _zag_str_concat(" --window-ms ", _zag_i64_to_str(cfg.stability_window_ms)));
    command = _zag_str_concat(command, _zag_str_concat(" --max-memory-bytes ", _zag_i64_to_str(cfg.max_memory_bytes)));
    command = _zag_str_concat(command, _zag_str_concat(" --max-cache-bytes ", _zag_i64_to_str(cfg.max_cache_bytes)));
    command = _zag_str_concat(command, _zag_str_concat(" --max-workers ", _zag_i64_to_str(cfg.max_workers as i64)));
    command = _zag_str_concat(command, _zag_str_concat(" --notifications ", znc_shell_quote(cfg.notifications)));
    if (daemonize == 1) {
        command = _zag_str_concat(command, " --daemonize >/dev/null 2>/dev/null");
    }
    return _zag_exec_cmd(command);
}

fn znc_zagd_status_matches_config(status: []u8, mode: []u8, cfg: PlannerConfig) i32 {
    if (znc_contains(status, _zag_str_concat("mode=", _zag_str_concat(mode, "\n"))) == 0) {
        return 0;
    }
    if (znc_contains(status, _zag_str_concat("idle_deep=", _zag_str_concat(znc_bool_arg(cfg.idle_deep), "\n"))) == 0) {
        return 0;
    }
    if (znc_contains(status, _zag_str_concat("difficulty=", _zag_str_concat(cfg.difficulty, "\n"))) == 0) {
        return 0;
    }
    if (znc_contains(status, _zag_str_concat("script_optimization=", _zag_str_concat(cfg.script_optimization, "\n"))) == 0) {
        return 0;
    }
    if (znc_contains(status, _zag_str_concat("regular_optimization=", _zag_str_concat(cfg.regular_optimization, "\n"))) == 0) {
        return 0;
    }
    if (znc_contains(status, _zag_str_concat("objective=", _zag_str_concat(cfg.objective, "\n"))) == 0) {
        return 0;
    }
    if (znc_contains(status, _zag_str_concat("trust_mode=", _zag_str_concat(cfg.trust_mode, "\n"))) == 0) {
        return 0;
    }
    if (znc_contains(status, _zag_str_concat("cpu=", _zag_str_concat(cfg.default_cpu, "\n"))) == 0) {
        return 0;
    }
    if (znc_contains(status, _zag_str_concat("stability_window_ms=", _zag_str_concat(_zag_i64_to_str(cfg.stability_window_ms), "\n"))) == 0) {
        return 0;
    }
    if (znc_contains(status, _zag_str_concat("max_memory_bytes=", _zag_str_concat(_zag_i64_to_str(cfg.max_memory_bytes), "\n"))) == 0) {
        return 0;
    }
    if (znc_contains(status, _zag_str_concat("max_cache_bytes=", _zag_str_concat(_zag_i64_to_str(cfg.max_cache_bytes), "\n"))) == 0) {
        return 0;
    }
    if (znc_contains(status, _zag_str_concat("max_workers=", _zag_str_concat(_zag_i64_to_str(cfg.max_workers as i64), "\n"))) == 0) {
        return 0;
    }
    if (znc_contains(status, _zag_str_concat("notifications=", _zag_str_concat(cfg.notifications, "\n"))) == 0) {
        return 0;
    }
    return 1;
}

fn znc_zagd_exec(root: []u8, mode: []u8, window_ms: i64, daemonize: i32) i32 {
    let cfg: PlannerConfig = znc_project_config(root, 0);
    cfg.stability_window_ms = window_ms;
    return znc_zagd_exec_config(root, "", mode, cfg, daemonize);
}

fn znc_zagd_lock_alive(root: []u8) i32 {
    let record: []u8 = _zag_read_file(_zag_str_concat(root, "/.zagd.lock"));
    return zagd_lock_identity_alive(record, root);
}

fn znc_cache_purge(root: []u8) void {
    let base: []u8 = _zag_str_concat(root, "/.zag-cache");
    let zagd_dir: []u8 = _zag_str_concat(base, "/zagd");
    let fg_dir: []u8 = _zag_str_concat(base, "/foreground");
    znc_unlink_tree(zagd_dir);
    znc_unlink_tree(fg_dir);
    let lock: []u8 = _zag_str_concat(root, "/.zagd.lock");
    let status: []u8 = _zag_str_concat(root, "/.zagd.status");
    let stop: []u8 = _zag_str_concat(root, "/.zagd.stop");
    let ready: []u8 = _zag_str_concat(root, "/.zagd.semantic-ready");
    let rescan: []u8 = _zag_str_concat(root, "/.zagd.rescan");
    let profile: []u8 = _zag_str_concat(root, "/.zagd.profile");
    let root_src: []u8 = _zag_str_concat(root, "/.zagd.root-source");
    let c_lock: ArrayList[u8] = fc_cstring(lock);
    _zag_raw_syscall(87, _zag_slice_ptr(c_lock.data[0..c_lock.len]) as i64, 0, 0, 0, 0, 0);
    free[u8](&c_lock);
    let c_status: ArrayList[u8] = fc_cstring(status);
    _zag_raw_syscall(87, _zag_slice_ptr(c_status.data[0..c_status.len]) as i64, 0, 0, 0, 0, 0);
    free[u8](&c_status);
    let c_stop: ArrayList[u8] = fc_cstring(stop);
    _zag_raw_syscall(87, _zag_slice_ptr(c_stop.data[0..c_stop.len]) as i64, 0, 0, 0, 0, 0);
    free[u8](&c_stop);
    let c_ready: ArrayList[u8] = fc_cstring(ready);
    _zag_raw_syscall(87, _zag_slice_ptr(c_ready.data[0..c_ready.len]) as i64, 0, 0, 0, 0, 0);
    free[u8](&c_ready);
    let c_rescan: ArrayList[u8] = fc_cstring(rescan);
    _zag_raw_syscall(87, _zag_slice_ptr(c_rescan.data[0..c_rescan.len]) as i64, 0, 0, 0, 0, 0);
    free[u8](&c_rescan);
    let c_profile: ArrayList[u8] = fc_cstring(profile);
    _zag_raw_syscall(87, _zag_slice_ptr(c_profile.data[0..c_profile.len]) as i64, 0, 0, 0, 0, 0);
    free[u8](&c_profile);
    let c_root_src: ArrayList[u8] = fc_cstring(root_src);
    _zag_raw_syscall(87, _zag_slice_ptr(c_root_src.data[0..c_root_src.len]) as i64, 0, 0, 0, 0, 0);
    free[u8](&c_root_src);
}

fn znc_unlink_tree(dir: []u8) void {
    let cdir: ArrayList[u8] = fc_cstring(dir);
    let fd: i64 = _zag_raw_syscall(2, _zag_slice_ptr(cdir.data[0..cdir.len]) as i64, 589824, 0, 0, 0, 0);
    free[u8](&cdir);
    if (fd < 0) {
        return;
    }
    let buf: ArrayList[u8] = make[u8](4096);
    let running: i32 = 1;
    while (running == 1) {
        let n: i64 = _zag_raw_syscall(217, fd, _zag_slice_ptr(buf.data[0..buf.cap]) as i64, buf.cap, 0, 0, 0);
        if (n <= 0) {
            running = 0;
            break;
        }
        let off: i32 = 0;
        while (off < n) {
            let reclen: i32 = buf.data[off + 16] as i32 | (buf.data[off + 17] as i32 << 8);
            let dtype: i32 = buf.data[off + 18] as i32;
            let name_start: i32 = off + 19;
            let name_end: i32 = name_start;
            while ((name_end < (off + reclen)) && (buf.data[name_end] != 0)) {
                name_end = name_end + 1;
            }
            let name: []u8 = buf.data[name_start..name_end];
            if ((name.len == 1) && (name[0] == 46)) {
                off = off + reclen;
                continue;
            }
            if (((name.len == 2) && (name[0] == 46)) && (name[1] == 46)) {
                off = off + reclen;
                continue;
            }
            if (name.len > 0) {
                let full: []u8 = _zag_str_concat(_zag_str_concat(dir, "/"), name);
                if (dtype == 4) {
                    znc_unlink_tree(full);
                } else {
                    let cfull: ArrayList[u8] = fc_cstring(full);
                    _zag_raw_syscall(87, _zag_slice_ptr(cfull.data[0..cfull.len]) as i64, 0, 0, 0, 0, 0);
                    free[u8](&cfull);
                }
                _zag_str_free(full);
            }
            off = off + reclen;
        }
    }
    free[u8](&buf);
    let _close: i64 = _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    let cdir2: ArrayList[u8] = fc_cstring(dir);
    _zag_raw_syscall(84, _zag_slice_ptr(cdir2.data[0..cdir2.len]) as i64, 0, 0, 0, 0, 0);
    free[u8](&cdir2);
}

fn znc_cache_version_check(root: []u8) void {
    if ((has_flag("--no-foreground-cache") == 1) && (has_flag("--no-zagd") == 1)) {
        return;
    }
    let base: []u8 = _zag_str_concat(root, "/.zag-cache");
    let stamp_path: []u8 = _zag_str_concat(base, "/.cache-version");
    let current: []u8 = zag_version();
    let existing: []u8 = _zag_read_file(stamp_path);
    let matches: i32 = 0;
    if (existing.len >= 0) {
        matches = @strEq(existing, current) as i32;
        _zag_free(_zag_slice_ptr(existing));
    }
    if (matches == 0) {
        znc_cache_purge(root);
        let _mk: i32 = fc_mkdir(base);
        let _wr: i32 = _zag_write_file(stamp_path, current);
    }
    _zag_str_free(base);
    _zag_str_free(stamp_path);
}

fn znc_zagd_ensure(root: []u8, root_source: []u8, operation: []u8) i32 {
    if (znc_invalid_project_config(root, operation) == 1) {
        return 2;
    }
    if (has_flag("--no-zagd") == 1) {
        return 0;
    }
    let config: PlannerConfig = znc_project_config(root, 1);
    let mode: []u8 = config.mode;
    if (@strEq(mode, "advisory")) {
        mode = "light";
    }
    let lock_path: []u8 = _zag_str_concat(root, "/.zagd.lock");
    let alive: i32 = znc_zagd_lock_alive(root);
    if (@strEq(mode, "off")) {
        if (alive == 1) {
            let stopped: i32 = znc_zagd_exec(root, "off", config.stability_window_ms, 0);
            if (stopped != 0) {
                _zag_eprintln("znc: warning: could not stop zagd requested by mode=off; foreground compilation continues");
            }
        }
        return 0;
    }
    if (alive == 1) {
        let status: []u8 = _zag_read_file(_zag_str_concat(root, "/.zagd.status"));
        if (znc_zagd_status_matches_config(status, mode, config) == 1) {
            return 0;
        }
        let stopped: i32 = znc_zagd_exec(root, "off", config.stability_window_ms, 0);
        if (stopped != 0) {
            _zag_eprintln("znc: warning: could not change zagd mode; foreground compilation continues");
            return 0;
        }
    }
    let daemon_source: []u8 = root_source;
    let daemon_source_owned: i32 = 0;
    if ((root_source.len > 0) && (root_source[0] != 47)) {
        daemon_source = znc_absolute_dir(root_source);
        daemon_source_owned = 1;
    }
    let rc: i32 = znc_zagd_exec_config(root, daemon_source, mode, config, 1);
    if (daemon_source_owned == 1) {
        _zag_str_free(daemon_source);
    }
    if ((rc != 0) && (rc != 6)) {
        _zag_eprintln("znc: warning: zagd unavailable; foreground compilation continues without background planning");
    }
    return 0;
}

fn znc_output_format() i32 {
    let i: i32 = 2;
    while (i < _zag_argc()) {
        if (@strEq(_zag_arg(i), "--format")) {
            if ((i + 1) >= _zag_argc()) {
                return 0 - 1;
            }
            if (@strEq(_zag_arg(i + 1), "text")) {
                return 0;
            }
            if (@strEq(_zag_arg(i + 1), "json")) {
                return 1;
            }
            return 0 - 1;
        }
        i = i + 1;
    }
    return 0;
}

fn znc_json_escape(value: []u8) []u8 {
    // Build the escaped representation in one bounded growable buffer.  The
    // old implementation repeatedly concatenated an immutable slice for
    // every input byte, turning a linear JSON rendering into quadratic
    // allocation (large semantic manifests could exhaust the process before
    // explain returned any output).
    let out: ArrayList[u8] = make[u8](value.len + 1);
    let i: i32 = 0;
    while (i < value.len) {
        if (value[i] == 34) {
            push[u8](&out, 92 as u8);
            push[u8](&out, 34 as u8);
        } else if (value[i] == 92) {
            push[u8](&out, 92 as u8);
            push[u8](&out, 92 as u8);
        } else if (value[i] == 10) {
            push[u8](&out, 92 as u8);
            push[u8](&out, 110 as u8);
        } else if (value[i] == 13) {
            push[u8](&out, 92 as u8);
            push[u8](&out, 114 as u8);
        } else if (value[i] == 9) {
            push[u8](&out, 92 as u8);
            push[u8](&out, 116 as u8);
        } else {
            push[u8](&out, value[i]);
        }
        i = i + 1;
    }
    let rendered: []u8 = _zag_str_concat("", out.data[0..out.len]);
    free[u8](&out);
    return rendered;
}

fn znc_watch() i32 {
    let root_source: []u8 = "";
    let wi: i32 = 2;
    while (wi < _zag_argc()) {
        let wa: []u8 = _zag_arg(wi);
        if ((@strEq(wa, "--mode") || @strEq(wa, "--root-source")) && ((wi + 1) < _zag_argc())) {
            if (@strEq(wa, "--root-source")) {
                root_source = _zag_arg(wi + 1);
            }
            wi = wi + 2;
        } else {
            if (((wa.len > 0) && (wa[0] != 45)) && (root_source.len == 0)) {
                root_source = wa;
            }
            wi = wi + 1;
        }
    }
    let root_base: []u8 = ".";
    if (root_source.len > 0) {
        root_base = dir_of(root_source);
    }
    let root: []u8 = znc_project_root(root_base);
    if (znc_invalid_project_config(root, "watch") == 1) {
        return 2;
    }
    if (root_source.len == 0) {
        if (_zag_file_exists(_zag_str_concat(root, "/main.zag")) == 1) {
            root_source = "main.zag";
        } else if (_zag_file_exists(_zag_str_concat(root, "/app.zag")) == 1) {
            root_source = "app.zag";
        }
    }
    let config: PlannerConfig = znc_project_config(root, 1);
    let mode: []u8 = znc_mode_arg();
    if (mode.len == 0) {
        mode = config.mode;
        if (@strEq(mode, "advisory")) {
            mode = "light";
        }
    }
    if (znc_valid_zagd_mode(mode) == 0) {
        _zag_eprintln("znc watch: --mode must be off, light, adaptive, or deep");
        return 2;
    }
    if (@strEq(mode, "off")) {
        return znc_zagd_exec(root, "off", config.stability_window_ms, 0);
    }
    if (_zag_file_exists(_zag_str_concat(root, "/.zagd.lock")) == 1) {
        let stopped: i32 = znc_zagd_exec(root, "off", config.stability_window_ms, 0);
        if (stopped != 0) {
            return stopped;
        }
    }
    let rc: i32 = znc_zagd_exec_config(root, root_source, mode, config, 1);
    if (rc == 127) {
        _zag_eprintln("znc watch: sibling zagd executable is missing; run bootstrap.sh or make zagd");
    }
    return rc;
}

fn znc_zagd_status() i32 {
    let root: []u8 = znc_project_root(".");
    let status: []u8 = _zag_read_file(_zag_str_concat(root, "/.zagd.status"));
    let active: i32 = znc_zagd_lock_alive(root);
    let json: i32 = znc_output_format();
    if (json < 0) {
        _zag_eprintln("znc status: --format must be text or json");
        return 2;
    }
    if (status.len < 0) {
        if (json == 1) {
            _zag_println("{\"running\":false,\"status\":\"missing\"}");
        } else {
            _zag_println("zagd status: not running (no status record)");
        }
        return 1;
    }
    if (json == 1) {
        let running: []u8 = "false";
        if (active == 1) {
            running = "true";
        }
        _zag_println(_zag_str_concat("{\"running\":", _zag_str_concat(running, _zag_str_concat(",\"status_text\":\"", _zag_str_concat(znc_json_escape(status), "\"}")))));
    } else {
        if (active == 0) {
            _zag_println("zagd status: stale record; no active singleton lock");
        }
        _zag_print(status);
    }
    if (active == 1) {
        return 0;
    }
    return 1;
}

fn znc_zagd_shutdown() i32 {
    let root: []u8 = znc_project_root(".");
    let config: PlannerConfig = znc_project_config(root, 0);
    let rc: i32 = znc_zagd_exec(root, "off", config.stability_window_ms, 0);
    if (rc == 127) {
        _zag_eprintln("znc shutdown: sibling zagd executable is missing");
    }
    return rc;
}

fn znc_manifest_fact_count(text: []u8, needle: []u8) i32 {
    if (semantic_manifest_decode(text).valid == 0) {
        return 0;
    }
    let count: i32 = 0;
    let start: i32 = 0;
    let i: i32 = 0;
    while (i <= text.len) {
        if ((i == text.len) || (text[i] == 10)) {
            let line: []u8 = text[start..i];
            if (((line.len > 8) && @strEq(line[0..8], "fact_fn=")) && smf_line_has(line, needle)) {
                count = count + 1;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return count;
}

fn znc_manifest_value_unknown_count(text: []u8) i32 {
    if (semantic_manifest_decode(text).valid == 0) {
        return 0;
    }
    let count: i32 = 0;
    let start: i32 = 0;
    let i: i32 = 0;
    while (i <= text.len) {
        if ((i == text.len) || (text[i] == 10)) {
            let line: []u8 = text[start..i];
            if (((line.len > 11) && @strEq(line[0..11], "value_type=")) && smf_line_has(line, "\tbasis=unknown")) {
                count = count + 1;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return count;
}

fn znc_manifest_path_safe(path: []u8) i32 {
    if ((((path.len == 0) || (path[0] == 47)) || (path[path.len - 1] == 47)) || (path[0] == 92)) {
        return 0;
    }
    let segment: i32 = 0;
    let i: i32 = 0;
    while (i <= path.len) {
        if ((i == path.len) || (path[i] == 47)) {
            let part: []u8 = path[segment..i];
            if (((part.len == 0) || @strEq(part, ".")) || @strEq(part, "..")) {
                return 0;
            }
            segment = i + 1;
        } else if ((((path[i] == 92) || (path[i] == 10)) || (path[i] == 13)) || (path[i] == 9)) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

fn znc_manifest_modules_current(root: []u8, text: []u8) i32 {
    let manifest: SemanticManifestView = semantic_manifest_decode(text);
    if (manifest.valid == 0) {
        return 0;
    }
    let found: i32 = 0;
    let start: i32 = 0;
    let i: i32 = 0;
    while (i <= text.len) {
        if ((i == text.len) || (text[i] == 10)) {
            let line: []u8 = text[start..i];
            if ((line.len > 12) && @strEq(line[0..12], "module_node=")) {
                let node: []u8 = line[12..];
                let tab: i32 = 0;
                while ((tab < node.len) && (node[tab] != 9)) {
                    tab = tab + 1;
                }
                if (tab == node.len) {
                    return 0;
                }
                let name: []u8 = node[0..tab];
                if (znc_manifest_path_safe(name) == 0) {
                    return 0;
                }
                let path: []u8 = _zag_str_concat(root, _zag_str_concat("/", name));
                let bytes: []u8 = _zag_read_file(path);
                if (bytes.len < 0) {
                    return 0;
                }
                let source: []u8 = bytes;
                let activated: i32 = 0;
                if ((@strEq(name, manifest.module) && (source_path_is_zs(path) == 1)) && (source_starts_script(bytes) == 0)) {
                    source = _zag_str_concat("script;\n", bytes);
                    activated = 1;
                }
                let current: ZagdHash = zagd_content_hash(source);
                if (activated == 1) {
                    _zag_free(_zag_slice_ptr(source));
                }
                _zag_free(_zag_slice_ptr(bytes));
                if (zagd_hash_equal(current, smf_hash(node[tab + 1..])) == 0) {
                    return 0;
                }
                found = found + 1;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return (found > 0) as i32;
}

fn znc_profile_manifest_matches_unit(root: []u8, text: []u8, src: []u8, modules: ArrayList[ResolvedModule]) i32 {
    let compiler_cwd: []u8 = smp_cwd();
    let matches: i32 = semantic_manifest_matches_unit_inputs(root, compiler_cwd, text, src, modules);
    if (compiler_cwd.len > 0) {
        _zag_str_free(compiler_cwd);
    }
    return matches;
}

struct ZncForegroundCacheSemantic {
    graph: ZagdHash,
    valid: i32,
}

fn znc_foreground_cache_semantic(root: []u8, src: []u8, modules: ArrayList[ResolvedModule], published: i32) ZncForegroundCacheSemantic {
    let bad: ZncForegroundCacheSemantic = ZncForegroundCacheSemantic{ .graph = zagd_hash_empty(), .valid = 0 };
    if (published != 1) {
        return bad;
    }
    let path: []u8 = _zag_str_concat(root, "/.zag-cache/zagd/semantic.record");
    let record: ForegroundBoundedRead = fc_read_bounded(path, 8388608);
    if (record.ok == 0) {
        free[u8](&record.bytes);
        return bad;
    }
    let text: []u8 = record.bytes.data[0..record.bytes.len];
    let view: SemanticManifestView = semantic_manifest_decode(text);
    if (((view.valid == 0) || (view.graph_complete != 1)) || (znc_profile_manifest_matches_unit(root, text, src, modules) == 0)) {
        free[u8](&record.bytes);
        return bad;
    }
    let out: ZncForegroundCacheSemantic = ZncForegroundCacheSemantic{ .graph = view.graph_identity, .valid = 1 };
    free[u8](&record.bytes);
    return out;
}

fn znc_foreground_profile_use(root: []u8, src: []u8, modules: ArrayList[ResolvedModule], compiler_bytes: []u8, cpu: X86CpuProfile) ZagdForegroundProfileUse {
    if (has_flag("--no-zagd-profile") == 1) {
        return zpf_bad("disabled-by-command");
    }
    if ((compiler_bytes.len <= 0) || (cpu.valid == 0)) {
        return zpf_bad("foreground-input-unavailable");
    }
    let semantic_text: []u8 = _zag_read_file(_zag_str_concat(root, "/.zag-cache/zagd/semantic.record"));
    if (semantic_text.len <= 0) {
        if (semantic_text.len >= 0) {
            _zag_free(_zag_slice_ptr(semantic_text));
        }
        return zpf_bad("missing-semantic-record");
    }
    if (znc_profile_manifest_matches_unit(root, semantic_text, src, modules) == 0) {
        _zag_free(_zag_slice_ptr(semantic_text));
        return zpf_bad("semantic-record-not-current-compilation");
    }
    let plan_text: []u8 = _zag_read_file(_zag_str_concat(root, "/.zag-cache/zagd/profile-plan.record"));
    let use: ZagdForegroundProfileUse = zagd_foreground_profile_consume(plan_text, semantic_text, zag_version(), zagd_content_hash(compiler_bytes), cpu.cache_key);
    if (plan_text.len >= 0) {
        _zag_free(_zag_slice_ptr(plan_text));
    }
    _zag_free(_zag_slice_ptr(semantic_text));
    return use;
}

fn znc_profile_plan_eligible(root: []u8, manifest_text: []u8) i32 {
    let text: []u8 = _zag_read_file(_zag_str_concat(root, "/.zag-cache/zagd/profile-plan.record"));
    let compiler_bytes: []u8 = _zag_read_file("/proc/self/exe");
    let cpu: X86CpuProfile = parse_x86_cpu_profile("generic");
    let use: ZagdForegroundProfileUse = zagd_foreground_profile_consume(text, manifest_text, zag_version(), zagd_content_hash(compiler_bytes), cpu.cache_key);
    if (text.len >= 0) {
        _zag_free(_zag_slice_ptr(text));
    }
    if (compiler_bytes.len >= 0) {
        _zag_free(_zag_slice_ptr(compiler_bytes));
    }
    if (use.valid == 0) {
        return 0 - 1;
    }
    return use.eligible_regions;
}

fn znc_suggest_rec_json(id: []u8, supported: i32, automatic: i32, confidence: i32, basis: []u8, evidence: []u8, action: []u8, validity: []u8, rejected: []u8) []u8 {
    let out: []u8 = "{\"id\":\"";
    out = _zag_str_concat(out, znc_json_escape(id));
    out = _zag_str_concat(out, _zag_str_concat("\",\"supported\":", znc_json_bool(supported)));
    out = _zag_str_concat(out, _zag_str_concat(",\"automatic\":", znc_json_bool(automatic)));
    out = _zag_str_concat(out, _zag_str_concat(",\"confidence\":", _zag_i64_to_str(confidence)));
    out = _zag_str_concat(out, _zag_str_concat(",\"evidence_basis\":\"", _zag_str_concat(znc_json_escape(basis), "\"")));
    out = _zag_str_concat(out, _zag_str_concat(",\"evidence\":\"", _zag_str_concat(znc_json_escape(evidence), "\"")));
    out = _zag_str_concat(out, _zag_str_concat(",\"action\":\"", _zag_str_concat(znc_json_escape(action), "\"")));
    out = _zag_str_concat(out, _zag_str_concat(",\"validity\":\"", _zag_str_concat(znc_json_escape(validity), "\"")));
    out = _zag_str_concat(out, _zag_str_concat(",\"rejected_reason\":\"", _zag_str_concat(znc_json_escape(rejected), "\"}")));
    return out;
}

fn znc_suggest_add(list: *[]u8, count: *i32, supported_count: *i32, supported: i32, item: []u8) void {
    if (count.* > 0) {
        list.* = _zag_str_concat(list.*, ",");
    }
    list.* = _zag_str_concat(list.*, item);
    count.* = count.* + 1;
    if (supported == 1) {
        supported_count.* = supported_count.* + 1;
    }
}

fn znc_suggest_text_line(id: []u8, supported: i32, automatic: i32, basis: []u8, validity: []u8, rejected: []u8) void {
    let line: []u8 = _zag_str_concat("  ", _zag_str_concat(id, _zag_str_concat(": supported=", _zag_str_concat(znc_json_bool(supported), _zag_str_concat(" automatic=", _zag_str_concat(znc_json_bool(automatic), _zag_str_concat(" basis=", _zag_str_concat(basis, _zag_str_concat(" validity=", validity)))))))));
    if (rejected.len > 0) {
        line = _zag_str_concat(line, _zag_str_concat(" rejected_reason=", rejected));
    }
    _zag_println(line);
}

fn znc_script_default_supported(id: []u8, value: []u8) i32 {
    if (@strEq(id, "script-default-allocator")) {
        return (znc_script_allocator_policy_id(value) > 0) as i32;
    }
    if (@strEq(id, "script-default-device")) {
        return @strEq(value, "cpu") as i32;
    }
    if (@strEq(id, "script-default-layout")) {
        return @strEq(value, "compiler_owned") as i32;
    }
    if (@strEq(id, "script-default-cpu")) {
        return (znc_script_cpu_policy_id(value) > 0) as i32;
    }
    return 0;
}

fn znc_supported_regular_advice_count(manifest_text: []u8) i32 {
    let count: i32 = znc_manifest_fact_count(manifest_text, "\talloc=1");
    let buffers: SemanticBufferLifetimeFacts = semantic_manifest_buffer_lifetime_facts(manifest_text);
    if (buffers.valid == 1) {
        return count + buffers.pairs;
    }
    return count;
}

fn znc_maybe_regular_advisory(path: []u8, unit: CompilationUnit, published: i32) void {
    if (((published != 1) || (unit.profile == ModuleProfile.script)) || (has_flag("--no-zagd") == 1)) {
        return;
    }
    let root: []u8 = znc_project_root(dir_of(path));
    let cfg: PlannerConfig = znc_project_config(root, 0);
    if ((@strEq(cfg.notifications, "advisory") == 0) || (znc_zagd_lock_alive(root) == 0)) {
        return;
    }
    let manifest_text: []u8 = _zag_read_file(_zag_str_concat(root, "/.zag-cache/zagd/semantic.record"));
    if ((manifest_text.len < 0) || (znc_manifest_modules_current(root, manifest_text) == 0)) {
        return;
    }
    let count: i32 = znc_manifest_fact_count(manifest_text, "\talloc=1");
    if (count > 0) {
        _zag_eprintln(_zag_str_concat("znc: advisory: ", _zag_str_concat(_zag_i64_to_str(count), _zag_str_concat(" allocation-effect declaration(s) available for review; run `znc suggest` (no source changes)", ""))));
    }
    let buffers: SemanticBufferLifetimeFacts = semantic_manifest_buffer_lifetime_facts(manifest_text);
    if ((buffers.valid == 1) && (buffers.pairs > 0)) {
        _zag_eprintln(_zag_str_concat("znc: advisory: ", _zag_str_concat(_zag_i64_to_str(buffers.pairs), _zag_str_concat(" AST-proven disjoint local raw-buffer pair(s) available for review; run `znc suggest` (no source changes)", ""))));
    }
}

fn znc_optimize_accept_rule(id: []u8) i32 {
    return (((@strEq(id, "const-i32-add-v1") || @strEq(id, "const-i64-add-v1")) || @strEq(id, "const-i32-neg-v1")) || @strEq(id, "const-bool-cmp-v1")) as i32;
}

fn znc_optimize_accept_elf(path: []u8) i32 {
    let bytes: []u8 = _zag_read_file(path);
    if (bytes.len < 20) {
        if (bytes.len >= 0) {
            free[u8](&bytes);
        }
        return 0;
    }
    let ok: i32 = ((((((((((bytes[0] == 127) && (bytes[1] == 69)) && (bytes[2] == 76)) && (bytes[3] == 70)) && (bytes[4] == 2)) && (bytes[5] == 1)) && (bytes[16] == 2)) && (bytes[17] == 0)) && (bytes[18] == 62)) && (bytes[19] == 0)) as i32;
    free[u8](&bytes);
    return ok;
}

struct ZncOwnedPath {
    path: []u8,
    owned: i32,
}

fn znc_self_executable_path() ZncOwnedPath {
    let fallback: []u8 = _zag_arg(0);
    let cpath: ArrayList[u8] = fc_cstring("/proc/self/exe");
    let buf: ArrayList[u8] = make[u8](4096);
    while (buf.len < 4096) {
        push[u8](&buf, 0 as u8);
    }
    let rc: i64 = _zag_raw_syscall(89, _zag_slice_ptr(cpath.data[0..cpath.len]) as i64, _zag_slice_ptr(buf.data[0..buf.len]) as i64, buf.len, 0, 0, 0);
    free[u8](&cpath);
    if ((rc <= 0) || (rc > buf.len)) {
        free[u8](&buf);
        return ZncOwnedPath{ .path = fallback, .owned = 0 };
    }
    return ZncOwnedPath{ .path = buf.data[0..rc as i32], .owned = 1 };
}

fn znc_optimize_accept_publish(temp: []u8, output: []u8) i32 {
    let from: ArrayList[u8] = fc_cstring(temp);
    let to: ArrayList[u8] = fc_cstring(output);
    let rc: i64 = _zag_raw_syscall(316, 0 - 100, _zag_slice_ptr(from.data[0..from.len]) as i64, 0 - 100, _zag_slice_ptr(to.data[0..to.len]) as i64, 1, 0);
    free[u8](&from);
    free[u8](&to);
    if (rc != 0) {
        let _remove: i32 = fc_unlink(temp);
        return 0;
    }
    return 1;
}

fn znc_optimize_accept_bytes_equal(a_path: []u8, b_path: []u8) i32 {
    let a: []u8 = _zag_read_file(a_path);
    let b: []u8 = _zag_read_file(b_path);
    if ((a.len < 0) || (b.len < 0)) {
        if (a.len >= 0) {
            free[u8](&a);
        }
        if (b.len >= 0) {
            free[u8](&b);
        }
        return 0;
    }
    let equal: i32 = (a.len == b.len) as i32;
    let i: i32 = 0;
    while ((equal == 1) && (i < a.len)) {
        if (a[i] != b[i]) {
            equal = 0;
        }
        i = i + 1;
    }
    free[u8](&a);
    free[u8](&b);
    return equal;
}

fn znc_optimize_accept_source_matches(path: []u8, expected: []u8) i32 {
    let read: ForegroundBoundedRead = fc_read_bounded(path, expected.len as i64);
    if (read.ok == 0) {
        free[u8](&read.bytes);
        return 0;
    }
    let same: i32 = (read.bytes.len == expected.len) as i32;
    let i: i32 = 0;
    while ((same == 1) && (i < expected.len)) {
        if (read.bytes.data[i] != expected[i]) {
            same = 0;
        }
        i = i + 1;
    }
    free[u8](&read.bytes);
    return same;
}

fn znc_optimize_accept_run(executable: []u8, stdout_path: []u8, stderr_path: []u8) i32 {
    let command: []u8 = znc_shell_quote(executable);
    command = _zag_str_concat(command, _zag_str_concat(" > ", znc_shell_quote(stdout_path)));
    command = _zag_str_concat(command, _zag_str_concat(" 2> ", znc_shell_quote(stderr_path)));
    return _zag_exec_cmd(command);
}

fn znc_optimize_zagd_parse_samples(value: []u8, minimum: i32, maximum: i32, out: *ArrayList[i64]) i32 {
    let count: i32 = zstore_csv_count(value, minimum, maximum);
    if ((count < minimum) || (count > maximum)) {
        return 0;
    }
    let start: i32 = 0;
    let i: i32 = 0;
    while (i <= value.len) {
        if ((i == value.len) || (value[i] == 44)) {
            let parsed: i64 = zagd_parse_nonnegative(value[start..i]);
            if ((parsed < 1) || (parsed > 5000000000)) {
                return 0;
            }
            push[i64](out, parsed);
            start = i + 1;
        }
        i = i + 1;
    }
    return (out.*.len == count) as i32;
}

fn znc_optimize_zagd_selector_current(text: []u8, record: ZagdBenchmarkEvidenceRecord) i32 {
    let reference_warmups: ArrayList[i64] = make[i64](16);
    let finalist_warmups: ArrayList[i64] = make[i64](16);
    let noise_reference: ArrayList[i64] = make[i64](60);
    let noise_repeat: ArrayList[i64] = make[i64](60);
    let reference_runs: ArrayList[i64] = make[i64](60);
    let finalist_runs: ArrayList[i64] = make[i64](60);
    let valid: i32 = ((((((znc_optimize_zagd_parse_samples(zagd_record_value(text, "reference_warmups"), 3, 16, &reference_warmups) == 1) && (znc_optimize_zagd_parse_samples(zagd_record_value(text, "finalist_warmups"), 3, 16, &finalist_warmups) == 1)) && (znc_optimize_zagd_parse_samples(zagd_record_value(text, "noise_reference"), 30, 60, &noise_reference) == 1)) && (znc_optimize_zagd_parse_samples(zagd_record_value(text, "noise_repeat"), 30, 60, &noise_repeat) == 1)) && (znc_optimize_zagd_parse_samples(zagd_record_value(text, "reference_runs"), 30, 60, &reference_runs) == 1)) && (znc_optimize_zagd_parse_samples(zagd_record_value(text, "finalist_runs"), 30, 60, &finalist_runs) == 1)) as i32;
    let required: ArrayList[i32] = make[i32](1);
    push[i32](&required, 1);
    let workloads: ArrayList[ZagdBenchmarkWorkloadEvidence] = make[ZagdBenchmarkWorkloadEvidence](1);
    let candidates: ArrayList[ZagdBenchmarkCandidateEvidence] = make[ZagdBenchmarkCandidateEvidence](1);
    let workload: ZagdBenchmarkWorkloadEvidence = ZagdBenchmarkWorkloadEvidence{ .workload = 1, .reference_warmups = reference_warmups, .finalist_warmups = finalist_warmups, .noise_reference = noise_reference, .noise_repeat = noise_repeat, .reference_runs = reference_runs, .finalist_runs = finalist_runs };
    push[ZagdBenchmarkWorkloadEvidence](&workloads, workload);
    let candidate: ZagdBenchmarkCandidateEvidence = ZagdBenchmarkCandidateEvidence{ .kind = record.winner_kind, .valid = 1, .equivalent = 1, .peak_memory_bytes = record.peak_memory_bytes, .binary_size_bytes = record.binary_size_bytes, .workloads = workloads };
    push[ZagdBenchmarkCandidateEvidence](&candidates, candidate);
    let expected: ZagdBenchmarkPolicySelection = zagd_benchmark_select_99(candidates, required, 268435456);
    let expected_score: i64 = expected.runtime_score_ns;
    if (expected.status == zagd_benchmark_policy_no_win()) {
        expected_score = 0;
    }
    let ok: i32 = (((((((((valid == 1) && @strEq(zagd_benchmark_policy_status_name(expected.status), record.policy_status)) && (expected.winner_kind == record.winner_kind)) && (expected.evaluated == record.evaluated)) && (expected.eligible == record.eligible)) && (expected.confidence_percent == record.confidence_percent)) && (expected.no_regression == record.no_regression)) && (expected_score == record.runtime_score_ns)) && ((expected.status != zagd_benchmark_policy_selected()) || (expected.binary_size_bytes == record.binary_size_bytes))) as i32;
    free[i64](&workload.reference_warmups);
    free[i64](&workload.finalist_warmups);
    free[i64](&workload.noise_reference);
    free[i64](&workload.noise_repeat);
    free[i64](&workload.reference_runs);
    free[i64](&workload.finalist_runs);
    free[ZagdBenchmarkWorkloadEvidence](&workloads);
    free[ZagdBenchmarkCandidateEvidence](&candidates);
    free[i32](&required);
    return ok;
}

fn znc_script_zagd_winner_current(path: []u8, source: []u8, unit: CompilationUnit, authority: ZirAuthority) i32 {
    if (((((unit.profile != ModuleProfile.script) || (has_flag("--no-zagd") == 1)) || (authority.transform_count != 1)) || (authority.certificate.valid != 1)) || !((@strEq(authority.certificate.rule, "const-i32-add-v1") || @strEq(authority.certificate.rule, "const-i32-neg-v1")) || @strEq(authority.certificate.rule, "const-i64-add-v1")) || @strEq(authority.certificate.rule, "const-bool-cmp-v1")) {
        return 0;
    }
    let root: []u8 = znc_project_root(dir_of(path));
    let record_path: []u8 = _zag_str_concat(root, "/.zag-cache/zagd/benchmark-policy.record");
    let semantic_path: []u8 = _zag_str_concat(root, "/.zag-cache/zagd/semantic.record");
    let record_text: []u8 = _zag_read_file(record_path);
    let semantic_text: []u8 = _zag_read_file(semantic_path);
    let record: ZagdBenchmarkEvidenceRecord = zagd_benchmark_evidence_decode(record_text);
    let manifest: SemanticManifestView = semantic_manifest_decode(semantic_text);
    let cpu: X86CpuProfile = parse_x86_cpu_profile(znc_effective_cpu(path, 1));
    let source_hash: ZagdHash = zagd_content_hash(source);
    let expected_semantic: ZagdHash = zagd_profile_semantic_identity(semantic_text, zag_version(), cpu.cache_key);
    let target_identity: ZagdHash = zagd_content_hash(cpu.cache_key);
    let reference: []u8 = _zag_read_file(record.reference_path);
    let finalist: []u8 = _zag_read_file(record.finalist_path);
    let payload_ok: i32 = zagd_benchmark_evidence_payloads_current(record, reference, finalist);
    let selector_ok: i32 = znc_optimize_zagd_selector_current(record_text, record);
    let current: i32 = ((((((((((((((record.valid == 1) && @strEq(record.policy_status, "verified_best_measured")) && @strEq(record.transform, authority.certificate.rule)) && (record.winner_kind == 1)) && (manifest.valid == 1)) && (manifest.graph_complete == 1)) && (znc_manifest_modules_current(root, semantic_text) == 1)) && (cpu.valid == 1)) && (zagd_hash_equal(manifest.source, source_hash) == 1)) && @strEq(record.target_cache_key, cpu.cache_key)) && (zagd_hash_equal(record.target_identity, target_identity) == 1)) && (zagd_hash_equal(record.semantic_identity, expected_semantic) == 1)) && (payload_ok == 1)) && (selector_ok == 1)) as i32;
    if (reference.len >= 0) {
        _zag_free(_zag_slice_ptr(reference));
    }
    if (finalist.len >= 0) {
        _zag_free(_zag_slice_ptr(finalist));
    }
    if (record_text.len >= 0) {
        _zag_free(_zag_slice_ptr(record_text));
    }
    if (semantic_text.len >= 0) {
        _zag_free(_zag_slice_ptr(semantic_text));
    }
    return current;
}

fn znc_script_zagd_automatic_authority(path: []u8, source: []u8, unit: CompilationUnit, decls: ArrayList[*Node], eff: map__StringMap[i32], origins: ArrayList[NodeOrigin], raw: ZirAuthority) ZirAuthority {
    if ((unit.profile != ModuleProfile.script) || (has_flag("--no-zagd") == 1)) {
        return raw;
    }
    let root: []u8 = znc_project_root(dir_of(path));
    let text: []u8 = _zag_read_file(_zag_str_concat(root, "/.zag-cache/zagd/benchmark-policy.record"));
    let record: ZagdBenchmarkEvidenceRecord = zagd_benchmark_evidence_decode(text);
    let selected: ZirAuthority = raw;
    if ((record.valid == 1) && (record.winner_kind == 1)) {
        if (@strEq(record.transform, "const-i32-neg-v1")) {
            selected = zir_prepare_const_i32_neg_source_policy_with_origins(decls, eff, origins, foreground_transform_policy(path, 0, 0));
        } else if (@strEq(record.transform, "const-i64-add-v1")) {
            selected = zir_prepare_const_i64_add_source_policy_with_origins(decls, eff, origins, foreground_transform_policy(path, 0, 0));
        } else if (@strEq(record.transform, "const-bool-cmp-v1")) {
            selected = zir_prepare_const_bool_cmp_source_policy_with_origins(decls, eff, origins, foreground_transform_policy(path, 0, 0));
        } else if (@strEq(record.transform, "const-i32-add-v1")) {
            selected = zir_prepare_const_i32_add_source_policy_with_origins(decls, eff, origins, foreground_transform_policy(path, 0, 0));
        }
    }
    if (text.len >= 0) {
        _zag_free(_zag_slice_ptr(text));
    }
    if ((selected.transform_count == 1) && (znc_script_zagd_winner_current(path, source, unit, selected) == 1)) {
        return selected;
    }
    return raw;
}

fn znc_optimize_accept_zagd_current(rule: []u8, source: []u8, source_bytes: []u8) i32 {
