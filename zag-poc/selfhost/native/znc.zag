fn znc_harden_render_capture_literal(out: *ArrayList[u8], f: FnDecl, depth: i32) void {
    fmt_app(out, "fn[");
    fmt_app(out, f.cap_names);
    fmt_app(out, "](");
    let i: i32 = 0;
    while (i < f.params.len) {
        if (i > 0) {
            fmt_app(out, ", ");
        }
        let p: Param = f.params.data[i];
        fmt_app(out, p.name);
        fmt_app(out, ": ");
        fmt_app(out, p.pty);
        i = i + 1;
    }
    fmt_app(out, ") ");
    fmt_app(out, f.ret);
    fmt_app(out, " ");
    fmt_block_body(out, f.body, depth);
}

fn znc_harden_render_let_capture(out: *ArrayList[u8], l: Let, f: FnDecl, depth: i32) void {
}

fn znc_harden_render_captured_body(decls: ArrayList[*Node], closure: []u8, binding: []u8) []u8 {
    let out: ArrayList[u8] = make[u8](256);
    let i: i32 = 0;
    while (i < decls.len) {
        switch (decls.data[i].*) {
            .fn_decl => |root| {
                if (@strEq(root.name, "__zag_compiler_script_body_7f3a")) {
                    let ci: i32 = 0;
                    while (ci < root.body.len) {
                        let n: *Node = root.body.data[ci];
                        let is_capture_let: i32 = 0;
                        switch (n.*) {
                            .let_ => |l| {
                                if (l.has_init == 1) {
                                    switch (l.expr.*) {
                                        .id => |x| {
                                            if (@strEq(x.name, closure)) {
                                                is_capture_let = 1;
                                            }
                                        }
                                        else => {
                                        }
                                    }
                                }
                                if (is_capture_let == 1) {
                                    let found: i32 = 0;
                                    let di: i32 = 0;
                                    while (di < decls.len) {
                                        switch (decls.data[di].*) {
                                            .fn_decl => |f| {
                                                if (@strEq(f.name, closure)) {
                                                    znc_harden_render_let_capture(&out, l, f, 0);
                                                    found = 1;
                                                }
                                            }
                                            else => {
                                            }
                                        }
                                        di = di + 1;
                                    }
                                    if (found == 1) {
                                        ci = ci + 1;
                                        continue;
                                    }
                                }
                            }
                            else => {
                            }
                        }
                        if (ci == (root.body.len - 1)) {
                            switch (n.*) {
                                .ret => |r| {
                                    fmt_app(&out, "let __zag_hardened_closure_result: i32 = ");
                                    fmt_expr(&out, r.expr, 0);
                                    fmt_app(&out, ";\n");
                                    fmt_app(&out, "close(");
                                    fmt_app(&out, binding);
                                    fmt_app(&out, ");\n");
                                    fmt_app(&out, "return __zag_hardened_closure_result;\n");
                                    ci = ci + 1;
                                    continue;
                                }
                                else => {
                                }
                            }
                        }
                        fmt_stmt(&out, n, 0);
                        ci = ci + 1;
                    }
                    return out.data[0..out.len];
                }
            }
            else => {
            }
        }
        i = i + 1;
    }
    return out.data[0..out.len];
}

fn znc_harden_render_let_capture(out: *ArrayList[u8], l: Let, f: FnDecl, depth: i32) void {
    fmt_indent(out, depth);
    fmt_app(out, "let ");
    fmt_app(out, l.name);
    if (l.has_dty == 1) {
        fmt_app(out, ": ");
        fmt_app(out, l.dty);
    }
    fmt_app(out, " = ");
    znc_harden_render_capture_literal(out, f, depth);
    fmt_app(out, ";\n");
}

struct ZHardenScriptMarker {
    start: i32,
    end: i32,
    valid: i32,
}

fn znc_harden_token_offset(src: []u8, token: Token) i32 {
    let line: i32 = 1;
    let at: i32 = 0;
    while ((at < src.len) && (line < token.line)) {
        if (src[at] == 10) {
            line = line + 1;
        }
        at = at + 1;
    }
    if ((line != token.line) || (token.col < 1)) {
        return -1;
    }
    let offset: i32 = (at + token.col) - 1;
    if ((offset < 0) || (offset >= src.len)) {
        return -1;
    }
    return offset;
}

fn znc_harden_script_marker(src: []u8) ZHardenScriptMarker {
    let tokens: ArrayList[Token] = lex(src);
    let i: i32 = 0;
    while ((i + 1) < tokens.len) {
        let marker: Token = tokens.data[i];
        if (((marker.kind == Tk.Ident) && @strEq(marker.val, "script")) && (tokens.data[i + 1].kind == Tk.Semi)) {
            let start: i32 = znc_harden_token_offset(src, marker);
            let semi: i32 = znc_harden_token_offset(src, tokens.data[i + 1]);
            if ((start >= 0) && (semi >= start)) {
                return ZHardenScriptMarker{ .start = start, .end = semi + 1, .valid = 1 };
            }
            return ZHardenScriptMarker{ .start = -1, .end = -1, .valid = 0 };
        }
        i = i + 1;
    }
    return ZHardenScriptMarker{ .start = -1, .end = -1, .valid = 0 };
}

fn znc_harden_bound_script_call(name: []u8) i32 {
    if (((((znc_script_alloc_call(name) == 1) || starts_with(name, "script_list")) || starts_with(name, "script_map")) || starts_with(name, "script_range")) || starts_with(name, "string_builder_")) {
        return 1;
    }
    if ((((((@strEq(name, "_zag_print") || @strEq(name, "_zag_println")) || @strEq(name, "_zag_write_file")) || @strEq(name, "_zag_argc")) || @strEq(name, "_zag_arg")) || @strEq(name, "_zag_script_alloc")) || @strEq(name, "_zag_script_alloc_used")) {
        return 1;
    }
    return 0;
}

fn znc_harden_expr_has_try(n: *Node) i32 {
    switch (n.*) {
        .un => |x| {
            if (@strEq(x.op, "try")) {
                return 1;
            }
            return znc_harden_expr_has_try(x.e);
        }
        .call => |x| {
            let i: i32 = 0;
            while (i < x.args.len) {
                if (znc_harden_expr_has_try(x.args.data[i]) == 1) {
                    return 1;
                }
                i = i + 1;
            }
            return znc_harden_expr_has_try(x.callee);
        }
        .bin => |x| {
            return znc_harden_expr_has_try(x.l) | znc_harden_expr_has_try(x.r);
        }
        .fld => |x| {
            return znc_harden_expr_has_try(x.base);
        }
        .idx => |x| {
            return znc_harden_expr_has_try(x.base) | znc_harden_expr_has_try(x.idx);
        }
        .cast_ => |x| {
            return znc_harden_expr_has_try(x.expr);
        }
        .slice_ => |x| {
            let found: i32 = znc_harden_expr_has_try(x.base) | znc_harden_expr_has_try(x.lo);
            if (x.has_hi == 1) {
                found = found | znc_harden_expr_has_try(x.hi);
            }
            return found;
        }
        .slit_ => |x| {
            let i: i32 = 0;
            while (i < x.fields.len) {
                if (znc_harden_expr_has_try(x.fields.data[i].val) == 1) {
                    return 1;
                }
                i = i + 1;
            }
        }
        .switch_ => |x| {
            if (znc_harden_expr_has_try(x.subject) == 1) {
                return 1;
            }
            let i: i32 = 0;
            while (i < x.arms.len) {
                if (znc_harden_body_has_try(x.arms.data[i].body) == 1) {
                    return 1;
                }
                i = i + 1;
            }
            return znc_harden_body_has_try(x.els_body);
        }
        else => {
        }
    }
    return 0;
}

fn znc_harden_body_has_try(body: ArrayList[*Node]) i32 {
    let i: i32 = 0;
    while (i < body.len) {
        switch (body.data[i].*) {
            .let_ => |x| {
                if ((x.has_init == 1) && (znc_harden_expr_has_try(x.expr) == 1)) {
                    return 1;
