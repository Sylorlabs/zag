fn znc_explain_origin_valid(state: *ZExplainOperationState, origin: NodeOrigin) i32 {
    if ((((((((origin.stable_id <= 0) || (origin.module.len == 0)) || (origin.line <= 0)) || (origin.col <= 0)) || (origin.byte_start < 0)) || (origin.byte_end <= origin.byte_start)) || (origin.byte_end > state.*.source_len)) || ((origin.exact != 0) && (origin.exact != 1))) {
        return 0;
    }
    return 1;
}

fn znc_explain_emit_source_location_json(state: *ZExplainOperationState, node: *Node) void {
    let origin: NodeOrigin = node_origin_find(state.*.origins, node);
    if (znc_explain_origin_valid(state, origin) == 0) {
        _zag_print("\"source_location\":{\"value\":\"unavailable\",\"basis\":\"unknown\"}");
        return;
    }
    _zag_print("\"source_location\":{\"module\":\"");
    _zag_print(znc_json_escape(origin.module));
    _zag_print("\",\"line\":");
    _zag_print(_zag_i64_to_str(origin.line as i64));
    _zag_print(",\"col\":");
    _zag_print(_zag_i64_to_str(origin.col as i64));
    _zag_print(",\"byte_start\":");
    _zag_print(_zag_i64_to_str(origin.byte_start as i64));
    _zag_print(",\"byte_end\":");
    _zag_print(_zag_i64_to_str(origin.byte_end as i64));
    _zag_print(",\"stable_id\":");
    _zag_print(_zag_i64_to_str(origin.stable_id));
    _zag_print(",\"exact\":");
    _zag_print(znc_json_bool(origin.exact));
    if (origin.exact == 1) {
        _zag_print(",\"basis\":\"parser-origin\"}");
    } else {
        _zag_print(",\"basis\":\"projected-origin\"}");
    }
}

fn znc_explain_emit_source_location_text(state: *ZExplainOperationState, node: *Node) void {
    let origin: NodeOrigin = node_origin_find(state.*.origins, node);
    if (znc_explain_origin_valid(state, origin) == 0) {
        _zag_print(" location=unavailable provenance=proven");
        return;
    }
    _zag_print(" location=");
    _zag_print(origin.module);
    _zag_print(":");
    _zag_print(_zag_i64_to_str(origin.line as i64));
    _zag_print(":");
    _zag_print(_zag_i64_to_str(origin.col as i64));
    _zag_print(" bytes=");
    _zag_print(_zag_i64_to_str(origin.byte_start as i64));
    _zag_print("..");
    _zag_print(_zag_i64_to_str(origin.byte_end as i64));
    _zag_print(" stable_id=");
    _zag_print(_zag_i64_to_str(origin.stable_id));
    _zag_print(" exact=");
    _zag_print(znc_json_bool(origin.exact));
    if (origin.exact == 1) {
        _zag_println(" basis=parser-origin provenance=proven");
    } else {
        _zag_println(" basis=projected-origin provenance=proven");
    }
}

fn znc_explain_emit_operation(name: []u8, state: *ZExplainOperationState, node: *Node) void {
    let op: ZExplainOperation = znc_explain_operation(name);
    if (op.operation.len == 0) {
        return;
    }
    if (state.*.emitted >= 64) {
        state.*.truncated = 1;
        return;
    }
    if (state.*.json == 1) {
        if (state.*.first == 0) {
            _zag_print(",");
        }
        _zag_print("{\"operation\":\"");
        _zag_print(op.operation);
        _zag_print("\",\"allocation\":{\"value\":\"");
        _zag_print(op.allocation);
        _zag_print("\",\"bytes\":\"");
        _zag_print(op.allocation_bytes);
        _zag_print("\",\"basis\":\"proven\"},\"copy\":{\"value\":\"");
        _zag_print(op.copy);
        _zag_print("\",\"bytes\":\"");
        _zag_print(op.copy_bytes);
        _zag_print("\",\"basis\":\"proven\"},");
        znc_explain_emit_source_location_json(state, node);
        _zag_print(",\"provenance\":\"proven\"}");
    } else {
        _zag_print("implicit operation: ");
        _zag_print(op.operation);
        _zag_print(" allocation=");
        _zag_print(op.allocation);
        _zag_print(" allocation_bytes=");
        _zag_print(op.allocation_bytes);
        _zag_print(" copy=");
        _zag_print(op.copy);
        _zag_print(" copy_bytes=");
        _zag_print(op.copy_bytes);
        znc_explain_emit_source_location_text(state, node);
    }
    state.*.first = 0;
    state.*.emitted = state.*.emitted + 1;
}

fn znc_explain_operations_expr(n: *Node, state: *ZExplainOperationState) void {
    switch (n.*) {
        .call => |c| {
            znc_explain_operations_expr(c.callee, state);
            let i: i32 = 0;
            while (i < c.args.len) {
                znc_explain_operations_expr(c.args.data[i], state);
                i = i + 1;
            }
            znc_explain_emit_operation(callee_name(c.callee), state, n);
        }
        .bin => |x| {
            znc_explain_operations_expr(x.l, state);
            znc_explain_operations_expr(x.r, state);
        }
        .un => |x| {
            znc_explain_operations_expr(x.e, state);
        }
        .fld => |x| {
            znc_explain_operations_expr(x.base, state);
        }
        .idx => |x| {
            znc_explain_operations_expr(x.base, state);
            znc_explain_operations_expr(x.idx, state);
        }
        .cast_ => |x| {
            znc_explain_operations_expr(x.expr, state);
        }
        .slice_ => |x| {
            znc_explain_operations_expr(x.base, state);
            znc_explain_operations_expr(x.lo, state);
            if (x.has_hi == 1) {
                znc_explain_operations_expr(x.hi, state);
            }
        }
        .slit_ => |x| {
            let i: i32 = 0;
            while (i < x.fields.len) {
                znc_explain_operations_expr(x.fields.data[i].val, state);
                i = i + 1;
            }
        }
        .switch_ => |x| {
            znc_explain_operations_expr(x.subject, state);
            let i: i32 = 0;
            while (i < x.arms.len) {
                znc_explain_operations_body(x.arms.data[i].body, state);
                i = i + 1;
            }
            znc_explain_operations_body(x.els_body, state);
        }
        else => {
        }
    }
}

fn znc_explain_operations_body(body: ArrayList[*Node], state: *ZExplainOperationState) void {
    let i: i32 = 0;
    while (i < body.len) {
        switch (body.data[i].*) {
            .let_ => |x| {
                if (x.has_init == 1) {
                    znc_explain_operations_expr(x.expr, state);
                }
            }
            .ret => |x| {
                if (x.has_expr == 1) {
                    znc_explain_operations_expr(x.expr, state);
                }
            }
            .estmt => |x| {
                znc_explain_operations_expr(x.expr, state);
            }
            .assign => |x| {
                znc_explain_operations_expr(x.target, state);
                znc_explain_operations_expr(x.expr, state);
            }
            .if_ => |x| {
                znc_explain_operations_expr(x.cond, state);
                znc_explain_operations_body(x.then_body, state);
                znc_explain_operations_body(x.els_body, state);
            }
            .while_ => |x| {
                znc_explain_operations_expr(x.cond, state);
                znc_explain_operations_body(x.body, state);
            }
            .unsafe_ => |x| {
                znc_explain_operations_body(x.body, state);
            }
            .defer_ => |d| {
                znc_explain_operations_expr(d.expr, state);
            }
            .switch_ => |x| {
                znc_explain_operations_expr(x.subject, state);
                let ai: i32 = 0;
                while (ai < x.arms.len) {
                    znc_explain_operations_body(x.arms.data[ai].body, state);
                    ai = ai + 1;
                }
                znc_explain_operations_body(x.els_body, state);
            }
            else => {
            }
        }
        i = i + 1;
    }
}

fn znc_explain_script_operations(decls: ArrayList[*Node], state: *ZExplainOperationState) void {
    let i: i32 = 0;
    while (i < decls.len) {
        switch (decls.data[i].*) {
            .fn_decl => |f| {
                if (@strEq(f.name, "__zag_compiler_script_body_7f3a")) {
                    znc_explain_operations_body(f.body, state);
                    return;
                }
            }
            else => {
            }
        }
        i = i + 1;
    }
}

fn znc_explain(path: []u8) i32 {
    if (path.len == 0) {
        _zag_eprintln("znc explain: no source file");
        return 1;
    }
    if (znc_invalid_project_config(znc_project_root(dir_of(path)), "explain") == 1) {
        return 1;
    }
    let src: []u8 = _zag_read_file(path);
    if (src.len < 0) {
        _zag_eprintln("znc explain: cannot read source file");
        return 1;
    }
    src = znc_activate_script_source(path, src, 0);
    if (znc_validate_compilation_source(path, src) != 0) {
        return 1;
    }
    let unit: CompilationUnit = parse_compilation_unit_dir(src, dir_of(path));
    if (znc_validate_script_defaults(path, unit) != 0) {
        return 1;
    }
    if (znc_configure_script_unit(&unit, path) != 0) {
        return 1;
    }
    let config: PlannerConfig = znc_project_config(znc_project_root(dir_of(path)), 0);
    let scripted: i32 = 0;
    if (unit.profile == ModuleProfile.script) {
        scripted = 1;
    }
    let denied_read: i32 = (((scripted == 1) && (config.allow_filesystem_read == 0)) && (znc_script_generated_calls(unit, "script_read_file") == 1)) as i32;
    let denied_write: i32 = (((scripted == 1) && (config.allow_filesystem_write == 0)) && (znc_script_generated_calls(unit, "_zag_write_file") == 1)) as i32;
    let denied_process: i32 = (((scripted == 1) && (config.allow_process == 0)) && ((znc_script_generated_calls(unit, "process_run_bounded_script") == 1) || (znc_script_generated_calls(unit, "process_run_argv_bounded_script") == 1))) as i32;
    let denied_environment: i32 = 0;
    if (scripted == 1) {
        denied_environment = znc_script_env_violations(unit, config, 0);
    }
    let denied_count: i32 = ((denied_read + denied_write) + denied_process) + denied_environment;
    let planner_input: PlannerChoices = znc_script_explicit_choices();
    let resolution: PlannerResolution = planner_resolve(scripted, src, config, planner_input, 0);
    let allocator_basis: []u8 = "derived";
    if (planner_input.allocator_explicit == 1) {
        allocator_basis = "explicit";
    }
    let semantic_decls: ArrayList[*Node] = unit.decls;
    lo_operators(semantic_decls);
    let semantic_effects: map__StringMap[i32] = analyze(semantic_decls);
    let explain_root: []u8 = znc_project_root(dir_of(path));
    let explain_module: []u8 = znc_project_relative(explain_root, path);
    let semantic_text: []u8 = smp_bounded_manifest(explain_root, explain_module, src, unit, semantic_effects);
    let semantic_detail: []u8 = smf_value(semantic_text, "detail_level");
    let semantic_witnesses: i32 = 1 - @strEq(semantic_detail, "compact") as i32;
    let format: []u8 = flag_value("--format");
    if (((format.len > 0) && (@strEq(format, "text") == 0)) && (@strEq(format, "json") == 0)) {
        _zag_eprintln("znc explain: --format must be text or json");
        return 1;
    }
    let json: i32 = 0;
    if (@strEq(format, "json")) {
        json = 1;
    }
    if (json == 1) {
        if (scripted == 1) {
            let cap_policy: []u8 = ",\"capability_policy\":{\"filesystem_read\":";
            cap_policy = _zag_str_concat(cap_policy, znc_json_bool(config.allow_filesystem_read));
            cap_policy = _zag_str_concat(cap_policy, ",\"filesystem_write\":");
            cap_policy = _zag_str_concat(cap_policy, znc_json_bool(config.allow_filesystem_write));
            cap_policy = _zag_str_concat(cap_policy, ",\"process\":");
            cap_policy = _zag_str_concat(cap_policy, znc_json_bool(config.allow_process));
            cap_policy = _zag_str_concat(cap_policy, ",\"environment_lookup\":");
            cap_policy = _zag_str_concat(cap_policy, znc_json_bool(config.environment_allow.len > 0));
            cap_policy = _zag_str_concat(cap_policy, ",\"environment_allow\":\"");
            cap_policy = _zag_str_concat(cap_policy, znc_json_escape(config.environment_allow));
            cap_policy = _zag_str_concat(cap_policy, "\",\"network\":false,\"policy_satisfied\":");
            cap_policy = _zag_str_concat(cap_policy, znc_json_bool(denied_count == 0));
            cap_policy = _zag_str_concat(cap_policy, ",\"denied_operation_count\":");
            cap_policy = _zag_str_concat(cap_policy, _zag_i64_to_str(denied_count as i64));
            cap_policy = _zag_str_concat(cap_policy, ",\"basis\":\"proven\"}");
            let prefix: []u8 = "{\"schema_version\":1,\"profile\":{\"value\":\"script\",\"basis\":\"proven\"},\"entry_point\":{\"value\":\"compiler-generated managed wrapper\",\"basis\":\"derived\"},\"allocator\":{\"value\":\"";
            prefix = _zag_str_concat(prefix, znc_json_escape(resolution.choices.allocator));
            prefix = _zag_str_concat(prefix, "\",\"basis\":\"");
            prefix = _zag_str_concat(prefix, allocator_basis);
            prefix = _zag_str_concat(prefix, "\"},\"script_memory_bytes\":{\"value\":");
            let before_ops: []u8 = ",\"error_boundary\":{\"value\":\"named error diagnostic and nonzero exit\",\"basis\":\"derived\"},\"prelude\":{\"value\":[\"print\",\"println\",\"say\",\"input\",\"env\",\"read_file\",\"write_file\",\"args_len\",\"arg\",\"args\",\"path_join\",\"path_basename\",\"path_dirname\",\"path_extension\",\"string_concat\",\"string_builder\",\"list\",\"append\",\"set_at\",\"length\",\"len\",\"item_at\",\"pop\",\"clear\",\"map\",\"map_put\",\"map_get\",\"map_has\",\"map_len\",\"map_failed\",\"map_del\",\"map_clear\",\"text_map\",\"text_map_put\",\"text_map_get\",\"text_map_has\",\"text_map_len\",\"text_map_failed\",\"text_map_del\",\"text_map_clear\",\"set\",\"set_add\",\"set_has\",\"set_len\",\"set_failed\",\"set_del\",\"set_clear\",\"text_set\",\"text_set_add\",\"text_set_has\",\"text_set_len\",\"text_set_failed\",\"text_set_del\",\"text_set_clear\",\"range\",\"range_failed\",\"json_normalize\",\"json_int_array\",\"json_bool_array\",\"json_float_array\",\"json_string_array\",\"json_int_array_encode\",\"json_bool_array_encode\",\"json_float_array_encode\",\"json_string_array_encode\",\"json_string_map\",\"json_string_map_encode\",\"csv_normalize\",\"csv_first_column\",\"csv_rows\",\"csv_rows_encode\",\"process_run_timeout\",\"process_run_argv\",\"script_alloc\",\"script_alloc_used\",\"new\"],\"basis\":\"proven\"},\"capabilities\":{\"filesystem\":\"derived from calls\",\"environment\":\"exact allowlist only\",\"process\":\"bounded shell or direct argv execution when called\",\"network\":\"unsupported\"},\"effects\":{\"value\":\"declaration effects are embedded; expression-witness availability is explicit in semantic_facts\",\"basis\":\"proven\"},\"hidden_allocations\":{\"value\":\"per-operation root Script evidence follows; strict/imported library allocation is outside this report\",\"basis\":\"proven\"},\"hidden_copies\":{\"value\":\"per-operation root Script evidence follows; byte totals are unknown unless stated\",\"basis\":\"proven\"},\"implicit_operations\":{\"scope\":\"compiler_bound_root_script_calls\",\"items\":[";
            _zag_print(prefix);
            _zag_print(_zag_i64_to_str(config.script_memory_bytes));
            _zag_print(",\"basis\":\"derived\"}");
            _zag_print(cap_policy);
            _zag_print(before_ops);
            let operations: ZExplainOperationState = ZExplainOperationState{ .json = 1, .first = 1, .emitted = 0, .truncated = 0, .origins = unit.origins, .source_len = src.len };
            znc_explain_script_operations(unit.decls, &operations);
            _zag_print("],\"emitted\":");
            _zag_print(_zag_i64_to_str(operations.emitted as i64));
            _zag_print(",\"truncated\":");
            _zag_print(znc_json_bool(operations.truncated));
            _zag_print(",\"basis\":\"proven\",\"unclassified\":\"imported strict-library calls are outside compiler-bound Script operation evidence\"},\"execution_plan\":{\"cpu\":\"");
            _zag_print(znc_json_escape(resolution.choices.cpu));
            _zag_print("\",\"device\":\"");
            _zag_print(znc_json_escape(resolution.choices.device));
            _zag_print("\",\"layout\":\"");
            _zag_print(znc_json_escape(resolution.choices.layout));
            _zag_print("\",\"basis\":\"derived\"},\"semantic_facts\":{\"format\":\"zag-semantic-manifest-v1\",\"detail_level\":\"");
            _zag_print(semantic_detail);
            _zag_print("\",\"expression_witnesses_available\":");
            _zag_print(znc_json_bool(semantic_witnesses));
            _zag_print(",\"value\":\"");
            _zag_print(znc_json_escape(semantic_text));
            _zag_print("\",\"basis\":\"derived\"},\"reclamation\":{\"value\":\"");
            _zag_print(znc_json_escape(znc_script_allocator_reclamation(resolution.choices.allocator)));
            _zag_print("\",\"basis\":\"proven\"},\"unresolved\":[\"synthetic wrapper origins remain unavailable\",\"strict-library allocation contracts remain explicit\"],\"source_changes\":false}");
            _zag_println("");
        } else {
            _zag_print("{\"schema_version\":1,\"profile\":{\"value\":\"strict\",\"basis\":\"proven\"},\"entry_point\":{\"value\":\"user-defined\",\"basis\":\"derived\"},\"allocator\":{\"value\":\"no script default\",\"basis\":\"proven\"},\"effects\":{\"value\":\"declaration effects are embedded; expression-witness availability is explicit in semantic_facts\",\"basis\":\"proven\"},\"hidden_copies\":{\"value\":\"none introduced by the profile\",\"basis\":\"proven\"},\"implicit_operations\":{\"scope\":\"not_script\",\"items\":[],\"emitted\":0,\"truncated\":false,\"basis\":\"proven\"},\"semantic_facts\":{\"format\":\"zag-semantic-manifest-v1\",\"detail_level\":\"");
            _zag_print(semantic_detail);
            _zag_print("\",\"expression_witnesses_available\":");
            _zag_print(znc_json_bool(semantic_witnesses));
            _zag_print(",\"value\":\"");
            _zag_print(znc_json_escape(semantic_text));
            _zag_println("\",\"basis\":\"proven\"},\"execution_plan\":{\"value\":\"generic x86-64-v1\",\"basis\":\"derived\"}}");
        }
        return 0;
    }
    _zag_print("profile: ");
    if (scripted == 1) {
        _zag_println("script [proven]");
    } else {
        _zag_println("strict [proven]");
    }
    if (scripted == 1) {
        _zag_println("entry point: compiler-generated managed wrapper; top-level statements run in source order [derived]");
        _zag_print("allocator: ");
        _zag_print(resolution.choices.allocator);
        if (@strEq(resolution.choices.allocator, "script_bounded_heap")) {
            _zag_print(" payload-plus-header budget ");
            _zag_print(_zag_i64_to_str(config.script_memory_bytes));
            _zag_print(" bytes; each successful Script allocation charges payload plus its 16-byte ownership header and owns a tracked native block reclaimed at shutdown; native allocator class slack and ordinary make remain outside this Script budget [");
        } else {
            _zag_print(" requested-payload budget ");
            _zag_print(_zag_i64_to_str(config.script_memory_bytes));
            _zag_print(" bytes; root new, read_file results, and bounded process allocations are charged to one arena; ordinary make and allocator metadata remain outside [");
        }
        _zag_print(allocator_basis);
        _zag_println("]");
        _zag_println("implicit error boundary: numeric error code + root-operation diagnostic, then nonzero exit [derived]");
        _zag_println("prelude: print, println, say, input, env, read_file, write_file, args_len, arg, args, path_join, path_basename, path_dirname, path_extension, string_concat, string_builder, list, append, set_at, length, len, item_at, pop, clear, map/map_put/map_get/map_has/map_len/map_failed/map_del/map_clear, text_map/text_map_put/text_map_get/text_map_has/text_map_len/text_map_failed/text_map_del/text_map_clear, set/set_add/set_has/set_len/set_failed/set_del/set_clear, text_set/text_set_add/text_set_has/text_set_len/text_set_failed/text_set_del/text_set_clear, range/range_failed, json_normalize/json_int_array/json_bool_array/json_float_array/json_string_array and matching encode helpers plus json_string_map/json_string_map_encode, csv_normalize/csv_first_column/csv_rows/csv_rows_encode, process_run_timeout, process_run_argv, script_alloc, script_alloc_used, new [proven]");
        if (config.allow_filesystem_read == 1) {
            _zag_println("filesystem read capability: allowed by project policy [proven]");
        } else {
            _zag_println("filesystem read capability: denied by project policy [proven]");
        }
        if (config.allow_filesystem_write == 1) {
            _zag_println("filesystem write capability: allowed by project policy [proven]");
        } else {
            _zag_println("filesystem write capability: denied by project policy [proven]");
        }
        if (config.allow_process == 1) {
            _zag_println("process capability: allowed only through bounded process API [proven]");
        } else {
            _zag_println("process capability: denied by project policy [proven]");
        }
        if (config.environment_allow.len > 0) {
            _zag_print("environment capability: exact read-only allowlist ");
            _zag_print(config.environment_allow);
            _zag_println(" [proven]");
        } else {
            _zag_println("environment capability: denied by empty project allowlist [proven]");
        }
        if (denied_read == 1) {
            _zag_println("policy conflict: read_file is used while filesystem read is denied [proven]");
        }
        if (denied_write == 1) {
            _zag_println("policy conflict: write_file is used while filesystem write is denied [proven]");
        }
        if (denied_process == 1) {
            _zag_println("policy conflict: a bounded process API is used while process execution is denied [proven]");
        }
        if (denied_environment > 0) {
            _zag_println("policy conflict: env is used without an exact permitted environment_allow name [proven]");
        }
        _zag_println("network capability: no Script prelude API implemented [proven]");
    } else {
        _zag_println("entry point: user-defined; no script wrapper [derived]");
        _zag_println("allocator: no script default [proven]");
    }
    if (semantic_witnesses == 1) {
        _zag_println("expression types/effects: typed frontend and sema witnesses follow; unsupported forms are explicitly unknown [proven]");
    } else {
        _zag_println("expression types/effects: compact manifest omits per-expression witnesses; declaration effects and exact semantic graph remain available [proven]");
    }
    _zag_print("semantic declaration/type/effect facts (compiler manifest, detail-level=");
    _zag_print(semantic_detail);
    _zag_println(") [proven]:");
    _zag_print(semantic_text);
    _zag_println("hidden allocation: per-operation root Script evidence follows; imported strict-library allocation is outside this report [proven]");
    if (scripted == 1) {
        _zag_println("hidden copies: per-operation root Script evidence follows; byte totals are unknown unless stated [proven]");
        _zag_println("implicit operations: compiler-bound root Script calls carry parser-backed locations; synthetic wrappers remain unavailable [proven]");
        let operations: ZExplainOperationState = ZExplainOperationState{ .json = 0, .first = 1, .emitted = 0, .truncated = 0, .origins = unit.origins, .source_len = src.len };
        znc_explain_script_operations(unit.decls, &operations);
        if (operations.emitted == 0) {
            _zag_println("implicit operations: zero classified root Script allocation/copy operations [proven]");
        }
        if (operations.truncated == 1) {
            _zag_println("implicit operations: output truncated after 64 witnesses [proven]");
        }
    } else {
        _zag_println("hidden copies: none introduced by the strict profile [proven]");
        _zag_println("implicit operations: zero; this is not a Script profile [proven]");
    }
    if (scripted == 1) {
        _zag_print("reclamation: ");
        _zag_print(znc_script_allocator_reclamation(resolution.choices.allocator));
        _zag_println(" [proven]");
    } else {
        _zag_println("reclamation: no Script runtime resources [proven]");
    }
    if (semantic_witnesses == 1) {
        _zag_println("unresolved: only expression forms tagged type_basis=unknown, ordinary make accounting [unknown]");
    } else {
        _zag_println("unresolved: compact manifest omits expression/value and local buffer-lifetime witnesses; ordinary make accounting remains unknown [unknown]");
    }
    if (scripted == 1) {
        _zag_print("execution plan: cpu=");
        _zag_print(resolution.choices.cpu);
        _zag_print(", device=");
        _zag_print(resolution.choices.device);
        _zag_print(", layout=");
        _zag_print(resolution.choices.layout);
        _zag_println(" [derived from project config unless explicit]");
    } else {
        _zag_println("execution plan: generic x86-64-v1 baseline [derived]");
    }
    return 0;
}

fn znc_harden_space(src: []u8, start: i32) i32 {
    let i: i32 = start;
    while (i < src.len) {
        if ((((src[i] == 32) || (src[i] == 9)) || (src[i] == 13)) || (src[i] == 10)) {
            i = i + 1;
        } else if ((((i + 1) < src.len) && (src[i] == 47)) && (src[i + 1] == 47)) {
            i = i + 2;
            while ((i < src.len) && (src[i] != 10)) {
                i = i + 1;
            }
        } else {
            return i;
        }
    }
    return i;
}

fn znc_harden_type_prefix_end(src: []u8, at: i32) i32 {
    if ((at < 0) || (at >= src.len)) {
        return -1;
    }
    let i: i32 = at;
    let saw_prefix: i32 = 0;
    while (i < src.len) {
        i = znc_harden_space(src, i);
        if (i >= src.len) {
            return -1;
        }
        if ((((i + 3) <= src.len) && @strEq(src[i..i + 3], "pub")) && (((((i + 3) == src.len) || (src[i + 3] == 32)) || (src[i + 3] == 9)) || (src[i + 3] == 10))) {
            i = i + 3;
            saw_prefix = 1;
            continue;
        }
        if (src[i] != 64) {
            break;
        }
        let name_start: i32 = i;
