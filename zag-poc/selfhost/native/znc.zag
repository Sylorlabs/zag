extern fn _zag_raw_syscall(num: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64) i64;

extern fn _zag_slice_ptr(s: []u8) *i8;

struct LoEnv {
    name: []u8,
    ty: []u8,
}

fn lo_env_get(env: ArrayList[LoEnv], name: []u8) []u8 {
    let i: i32 = 0;
    while (i < len[LoEnv](env)) {
        if (@strEq(get[LoEnv](env, i).name, name)) {
            return get[LoEnv](env, i).ty;
        }
        i = i + 1;
    }
    return "";
}

fn lo_id_ty(n: *Node, env: ArrayList[LoEnv], dl: ArrayList[*Node]) []u8 {
    switch (n.*) {
        .id => |x| {
            return lo_env_get(env, x.name);
        }
        .fld => |f| {
            let base_ty: []u8 = lo_id_ty(f.base, env, dl);
            if (base_ty.len == 0) {
                return "";
            }
            let si: i32 = 0;
            while (si < len[*Node](dl)) {
                switch (get[*Node](dl, si).*) {
                    .struct_ => |s| {
                        if (@strEq(s.name, base_ty)) {
                            let fi: i32 = 0;
                            while (fi < len[Param](s.fields)) {
                                let fp: Param = get[Param](s.fields, fi);
                                if (@strEq(fp.name, f.fname)) {
                                    return fp.pty;
                                }
                                fi = fi + 1;
                            }
                        }
                    }
                    else => {
                    }
                }
                si = si + 1;
            }
            return "";
        }
        else => {
            return "";
        }
    }
}

fn lo_mk_call2(fname: []u8, a: *Node, b: *Node) *Node {
    let args: ArrayList[*Node] = make[*Node](2);
    push[*Node](&args, a);
    push[*Node](&args, b);
    return mk_call(mk_ident(fname), args);
}

fn lo_expr(n: *Node, env: ArrayList[LoEnv], dl: ArrayList[*Node]) void {
    switch (n.*) {
        .bin => |b| {
            lo_expr(b.l, env, dl);
            lo_expr(b.r, env, dl);
            if (((@strEq(b.op, "+") || @strEq(b.op, "-")) || @strEq(b.op, "*")) || @strEq(b.op, "/")) {
                let lt: []u8 = lo_id_ty(b.l, env, dl);
                if (lt.len > 0) {
                    let decode: []u8 = op_contract_fn(dl, lt, b.op);
                    if (decode.len > 0) {
                        n.* = lo_mk_call2(decode, b.l, b.r).*;
                    }
                }
            }
        }
        .un => |u| {
            lo_expr(u.e, env, dl);
        }
        .call => |c| {
            lo_expr(c.callee, env, dl);
            let i: i32 = 0;
            while (i < len[*Node](c.args)) {
                lo_expr(get[*Node](c.args, i), env, dl);
                i = i + 1;
            }
        }
        .idx => |x| {
            lo_expr(x.base, env, dl);
            lo_expr(x.idx, env, dl);
        }
        .fld => |f| {
            lo_expr(f.base, env, dl);
        }
        .slit_ => |s| {
            let i: i32 = 0;
            while (i < len[FieldInit](s.fields)) {
                lo_expr(get[FieldInit](s.fields, i).val, env, dl);
                i = i + 1;
            }
        }
        else => {
        }
    }
}

fn lo_block(body: ArrayList[*Node], env: *ArrayList[LoEnv], dl: ArrayList[*Node]) void {
    let i: i32 = 0;
    while (i < len[*Node](body)) {
        lo_stmt(get[*Node](body, i), env, dl);
        i = i + 1;
    }
}

fn lo_stmt(n: *Node, env: *ArrayList[LoEnv], dl: ArrayList[*Node]) void {
    switch (n.*) {
        .let_ => |l| {
            lo_expr(l.expr, env.*, dl);
            if ((l.has_dty == 1) && (l.dty.len > 0)) {
                push[LoEnv](env, LoEnv{ .name = l.name, .ty = l.dty });
            }
        }
        .ret => |r| {
            if (r.has_expr == 1) {
                lo_expr(r.expr, env.*, dl);
            }
        }
        .if_ => |x| {
            lo_expr(x.cond, env.*, dl);
            lo_block(x.then_body, env, dl);
            lo_block(x.els_body, env, dl);
        }
        .while_ => |w| {
            lo_expr(w.cond, env.*, dl);
            lo_block(w.body, env, dl);
        }
        .unsafe_ => |u| {
            lo_block(u.body, env, dl);
        }
        .defer_ => |d| {
            lo_expr(d.expr, env.*, dl);
        }
        .assign => |a| {
            lo_expr(a.target, env.*, dl);
            lo_expr(a.expr, env.*, dl);
        }
        .switch_ => |sw| {
            lo_expr(sw.subject, env.*, dl);
            let i: i32 = 0;
            while (i < len[SwitchArm](sw.arms)) {
                lo_block(get[SwitchArm](sw.arms, i).body, env, dl);
                i = i + 1;
            }
            if (sw.has_els == 1) {
                lo_block(sw.els_body, env, dl);
            }
        }
        .estmt => |e| {
            lo_expr(e.expr, env.*, dl);
        }
        else => {
        }
    }
}

fn lo_build_env(params: ArrayList[Param]) ArrayList[LoEnv] {
    let env: ArrayList[LoEnv] = make[LoEnv](8);
    let i: i32 = 0;
    while (i < len[Param](params)) {
        let p: Param = get[Param](params, i);
        push[LoEnv](&env, LoEnv{ .name = p.name, .ty = p.pty });
        i = i + 1;
    }
    return env;
}

fn lo_operators(decls: ArrayList[*Node]) void {
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                if ((f.is_extern == 0) && (len[[]u8](f.tparams) == 0)) {
                    let is_op: i32 = 0;
                    if (f.name.len >= 5) {
                        if (((((f.name[0] == 95) && (f.name[1] == 95)) && (f.name[2] == 111)) && (f.name[3] == 112)) && (f.name[4] == 95)) {
                            is_op = 1;
                        }
                    }
                    if (is_op == 0) {
                        let lenv: ArrayList[LoEnv] = lo_build_env(f.params);
                        lo_block(f.body, &lenv, decls);
                    }
                }
            }
            else => {
            }
        }
        i = i + 1;
    }
}

fn znc_collect_links(decls: ArrayList[*Node], link_libs: *ArrayList[[]u8]) ArrayList[*Node] {
    let filtered: ArrayList[*Node] = make[*Node](len[*Node](decls));
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        let n: *Node = get[*Node](decls, i);
        switch (n.*) {
            .link_dir => |ld| {
                push[[]u8](link_libs, ld.lib);
            }
            else => {
                push[*Node](&filtered, n);
            }
        }
        i = i + 1;
    }
    return filtered;
}

fn znc_argv_links(link_libs: *ArrayList[[]u8]) void {
    let i: i32 = 1;
    while (i < _zag_argc()) {
        let a: []u8 = _zag_arg(i);
        if (a.len > 2) {
            if ((a[0] as i32 == 45) && (a[1] as i32 == 108)) {
                push[[]u8](link_libs, a[2..a.len]);
            }
        }
        if (@strEq(a, "-l")) {
            if ((i + 1) < _zag_argc()) {
                push[[]u8](link_libs, _zag_arg(i + 1));
                i = i + 1;
            }
        }
        i = i + 1;
    }
}

fn znc_argv_paths(lib_paths: *ArrayList[[]u8]) void {
    let i: i32 = 1;
    while (i < _zag_argc()) {
        let a: []u8 = _zag_arg(i);
        if (a.len > 2) {
            if ((a[0] as i32 == 45) && (a[1] as i32 == 76)) {
                push[[]u8](lib_paths, a[2..a.len]);
            }
        }
        if (@strEq(a, "-L")) {
            if ((i + 1) < _zag_argc()) {
                push[[]u8](lib_paths, _zag_arg(i + 1));
                i = i + 1;
            }
        }
        i = i + 1;
    }
}

fn znc_load_zagmod(dir: []u8, link_libs: *ArrayList[[]u8], lib_paths: *ArrayList[[]u8]) void {
    let modpath: []u8 = join_path(dir, "zag.mod");
    if (_zag_file_exists(modpath) == 0) {
        return;
    }
    let src: []u8 = _zag_read_file(modpath);
    if (src.len < 0) {
        return;
    }
    let mod_: ZagMod = zagmod_parse(src);
    let i: i32 = 0;
    while (i < len[ZagDep](mod_.deps)) {
        let dep: ZagDep = get[ZagDep](mod_.deps, i);
        if (dep.link.len > 0) {
            push[[]u8](link_libs, dep.link);
        }
        if (dep.path.len > 0) {
            push[[]u8](lib_paths, dep.path);
        }
        i = i + 1;
    }
}

fn znc_fn_has_annot(f: FnDecl, annot: []u8) i32 {
    let i: i32 = 0;
    while (i < len[[]u8](f.annots)) {
        if (@strEq(get[[]u8](f.annots, i), annot)) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

struct ZncObjectExport {
    name: []u8,
    label: i32,
}

fn znc_x86_object_exports(decls: ArrayList[*Node]) ArrayList[ZncObjectExport] {
    let out: ArrayList[ZncObjectExport] = make[ZncObjectExport](4);
    let label: i32 = 1;
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                if ((((f.is_extern == 1) && (len[[]u8](f.tparams) == 0)) && (starts_with(f.name, "_zag_") == 0)) && (znc_fn_has_annot(f, "@cabi") == 1)) {
                    label = label + 1;
                } else if ((((f.is_extern == 0) && (len[[]u8](f.tparams) == 0)) && (len[*Node](f.body) > 0)) && (starts_with(f.name, "__iface_") == 0)) {
                    if (znc_fn_has_annot(f, "@cabi_export") == 1) {
                        push[ZncObjectExport](&out, ZncObjectExport{ .name = f.name, .label = label });
                    }
                    label = label + 1;
                }
            }
            else => {
            }
        }
        i = i + 1;
    }
    return out;
}

fn znc_dynamic_extern_syms(decls: ArrayList[*Node], v2_edition: i32) ArrayList[[]u8] {
    let syms: ArrayList[[]u8] = make[[]u8](8);
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                if ((((f.is_extern == 1) && (len[[]u8](f.tparams) == 0)) && (starts_with(f.name, "_zag_") == 0)) && ((v2_edition == 0) || (znc_fn_has_annot(f, "@cabi") == 1))) {
                    let found: i32 = 0;
                    let j: i32 = 0;
                    while (j < syms.len) {
                        if (@strEq(get[[]u8](syms, j), f.name)) {
                            found = 1;
                        }
                        j = j + 1;
                    }
                    if (found == 0) {
                        push[[]u8](&syms, f.name);
                    }
                }
            }
            else => {
            }
        }
        i = i + 1;
    }
    return syms;
}

fn znc_object_externs_ok(decls: ArrayList[*Node]) i32 {
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                if (((f.is_extern == 1) && (starts_with(f.name, "_zag_") == 0)) && (znc_fn_has_annot(f, "@cabi") == 0)) {
                    return 0;
                }
            }
            else => {
            }
        }
        i = i + 1;
    }
    return 1;
}

fn znc_driver_module_mode() i32 {
    return ((has_flag("--emit-driver-module") == 1) || (has_flag("--driver-module") == 1)) as i32;
}

fn znc_driver_kernel_series() i32 {
    let value: []u8 = flag_value("--driver-kernel");
    let inline: []u8 = "";
    let i: i32 = 0;
    while (i < _zag_argc()) {
        let arg: []u8 = _zag_arg(i);
        if (starts_with(arg, "--driver-kernel=") == 1) {
            inline = arg[16..];
        }
        i = i + 1;
    }
    let selected: []u8 = value;
    if (inline.len > 0) {
        selected = inline;
    }
    if ((@strEq(selected, "6.1") || @strEq(selected, "6_1")) || @strEq(selected, "61")) {
        return 61;
    }
    if ((@strEq(selected, "6.6") || @strEq(selected, "6_6")) || @strEq(selected, "66")) {
        return 66;
    }
    return 0;
}

fn znc_driver_target_tag(target: []u8) []u8 {
    if ((((target.len == 0) || @strEq(target, "x86_64")) || @strEq(target, "x86-64")) || @strEq(target, "linux-x86_64")) {
        return "x86_64";
    }
    if (@strEq(target, "arm64") || @strEq(target, "aarch64")) {
        return "arm64";
    }
    if ((@strEq(target, "i686") || @strEq(target, "x86")) || @strEq(target, "linux-i686")) {
        return "i686";
    }
    return "";
}

fn znc_driver_modinfo(series: i32, target: []u8) ArrayList[u8] {
    let out: ArrayList[u8] = make[u8](128);
    if (series == 61) {
        driver_elf_cstr(&out, "zag_kernel_series=6.1");
    } else {
        driver_elf_cstr(&out, "zag_kernel_series=6.6");
    }
    driver_elf_cstr(&out, _zag_str_concat("name=zag_driver_", target));
    driver_elf_cstr(&out, "license=GPL");
    driver_elf_cstr(&out, "description=Pure-Zag Linux driver module");
    driver_elf_cstr(&out, _zag_str_concat("zag_target=", target));
    driver_elf_cstr(&out, "depends=");
    return out;
}

fn znc_driver_entries_ok(decls: ArrayList[*Node], file: []u8) i32 {
    if (@strEq(v2_project_edition(file), "2027") == 0) {
        return 0;
    }
    let init_ok: i32 = 0;
    let exit_ok: i32 = 0;
    let i: i32 = 0;
    while (i < decls.len) {
        switch (decls.data[i].*) {
            .fn_decl => |f| {
                if ((((((@strEq(f.name, "init_module") && (f.is_pub == 1)) && (f.is_extern == 0)) && (znc_fn_has_annot(f, "@cabi_export") == 1)) && (znc_fn_has_annot(f, "@driver_init") == 1)) && (f.params.len == 0)) && @strEq(f.ret, "i32")) {
                    init_ok = 1;
                }
                if ((((((@strEq(f.name, "cleanup_module") && (f.is_pub == 1)) && (f.is_extern == 0)) && (znc_fn_has_annot(f, "@cabi_export") == 1)) && (znc_fn_has_annot(f, "@driver_teardown") == 1)) && (f.params.len == 0)) && @strEq(f.ret, "void")) {
                    exit_ok = 1;
                }
            }
            else => {
            }
        }
        i = i + 1;
    }
    if ((init_ok == 0) || (exit_ok == 0)) {
        _zag_eprintln("znc: driver module requires pub @cabi_export @driver_init init_module() i32 and pub @cabi_export @driver_teardown cleanup_module() void");
        return 0;
    }
    if (znc_object_externs_ok(decls) == 0) {
        _zag_eprintln("znc: driver module foreign declarations require explicit edition-2027 @cabi imports");
        return 0;
    }
    return 1;
}

fn znc_driver_debug(path: []u8, decls: ArrayList[*Node]) DwarfSections {
    let builder: DwarfBuilder = dwarf_new(path);
    dwarf_build_abbrev(&builder);
    dwarf_emit_compile_unit(&builder);
    let i: i32 = 0;
    while (i < decls.len) {
        switch (decls.data[i].*) {
            .fn_decl => |f| {
                dwarf_emit_function(&builder, f.name, f.line);
            }
            else => {
            }
        }
        i = i + 1;
    }
    dwarf_finish(&builder);
    dwarf_emit_line_program(&builder);
    return dwarf_build(&builder);
}

fn znc_driver_export_index(exports: ArrayList[ZncObjectExport], name: []u8) i32 {
    let i: i32 = 0;
    while (i < exports.len) {
        if (@strEq(exports.data[i].name, name)) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn znc_driver_mod_symbols(exports: ArrayList[ZncObjectExport], labels: ArrayList[i32], text_len: i32) ArrayList[DriverElfSymbol] {
    let out: ArrayList[DriverElfSymbol] = make[DriverElfSymbol](exports.len);
    let i: i32 = 0;
    while (i < exports.len) {
        let entry: ZncObjectExport = exports.data[i];
        if ((entry.label < 0) || (entry.label >= labels.len)) {
            return make[DriverElfSymbol](0);
        }
        push[DriverElfSymbol](&out, DriverElfSymbol{ .name = entry.name, .offset = labels.data[entry.label], .size = 0, .defined = 1, .section = 1, .bind = 1, .type_ = 2 });
        i = i + 1;
    }
    i = 0;
    while (i < out.len) {
        let next: i32 = text_len;
        let j: i32 = i + 1;
        while (j < out.len) {
            if ((out.data[j].offset > out.data[i].offset) && (out.data[j].offset < next)) {
                next = out.data[j].offset;
            }
            j = j + 1;
        }
        out.data[i].size = next - out.data[i].offset;
        i = i + 1;
    }
    return out;
}

fn znc_driver_data_anchor() ArrayList[u8] {
    let out: ArrayList[u8] = make[u8](8);
    let i: i32 = 0;
    while (i < 8) {
        push[u8](&out, 0);
        i = i + 1;
    }
    return out;
}

fn znc_driver_imports_from_x86(imports: ArrayList[[]u8]) ArrayList[[]u8] {
    let out: ArrayList[[]u8] = make[[]u8](imports.len);
    let i: i32 = 0;
    while (i < imports.len) {
        push[[]u8](&out, imports.data[i]);
        i = i + 1;
    }
    return out;
}

fn znc_driver_data_anchor32() ArrayList[u8] {
    let out: ArrayList[u8] = make[u8](4);
    let i: i32 = 0;
    while (i < 4) {
        push[u8](&out, 0);
        i = i + 1;
    }
    return out;
}

fn znc_driver_module_data(anchor: ArrayList[u8], source: ArrayList[u8]) ArrayList[u8] {
    let out: ArrayList[u8] = make[u8](anchor.len + source.len);
    let i: i32 = 0;
    while (i < anchor.len) {
        push[u8](&out, anchor.data[i]);
        i = i + 1;
    }
    i = 0;
    while (i < source.len) {
        push[u8](&out, source.data[i]);
        i = i + 1;
    }
    return out;
}

fn znc_driver_i686_symbol(code: I686ObjectCode, name: []u8) I686CodeSymbol {
    let i: i32 = 0;
    while (i < code.symbols.len) {
        if (@strEq(code.symbols.data[i].name, name)) {
            return code.symbols.data[i];
        }
        i = i + 1;
    }
    return I686CodeSymbol{ .name = "", .offset = -1, .size = 0, .defined = 0 };
}

fn znc_driver_i686_symbols(exports: ArrayList[ZncObjectExport], code: I686ObjectCode, text_len: i32) ArrayList[DriverElfSymbol] {
    let out: ArrayList[DriverElfSymbol] = make[DriverElfSymbol](exports.len);
    let i: i32 = 0;
    while (i < exports.len) {
        let source: I686CodeSymbol = znc_driver_i686_symbol(code, exports.data[i].name);
        if (((source.defined == 0) || (source.offset < 0)) || (source.offset > text_len)) {
            return make[DriverElfSymbol](0);
        }
        push[DriverElfSymbol](&out, DriverElfSymbol{ .name = source.name, .offset = source.offset, .size = source.size, .defined = 1, .section = 1, .bind = 1, .type_ = 2 });
        i = i + 1;
    }
    i = 0;
    while (i < out.len) {
        if (out.data[i].size == 0) {
            let next: i32 = text_len;
            let j: i32 = 0;
            while (j < out.len) {
                if (((j != i) && (out.data[j].offset > out.data[i].offset)) && (out.data[j].offset < next)) {
                    next = out.data[j].offset;
                }
                j = j + 1;
            }
            out.data[i].size = next - out.data[i].offset;
        }
        i = i + 1;
    }
    return out;
}

fn znc_driver_i686_import_index(imports: ArrayList[[]u8], name: []u8) i32 {
    let i: i32 = 0;
    while (i < imports.len) {
        if (@strEq(imports.data[i], name)) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn znc_driver_i686_imports(code: I686ObjectCode) ArrayList[[]u8] {
    let out: ArrayList[[]u8] = make[[]u8](4);
    let i: i32 = 0;
    while (i < code.relocs.len) {
        let name: []u8 = code.relocs.data[i].name;
        if (znc_driver_i686_import_index(out, name) < 0) {
            push[[]u8](&out, name);
        }
        i = i + 1;
    }
    return out;
}

fn znc_driver_i686_text_relocs(code: I686ObjectCode, exports: ArrayList[ZncObjectExport], imports: ArrayList[[]u8]) ArrayList[DriverElfReloc] {
    let out: ArrayList[DriverElfReloc] = make[DriverElfReloc](code.relocs.len);
    let i: i32 = 0;
    while (i < code.relocs.len) {
        let reloc: I686CodeReloc = code.relocs.data[i];
        let import_index: i32 = znc_driver_i686_import_index(imports, reloc.name);
        if ((import_index < 0) || (reloc.typ != 2)) {
            return make[DriverElfReloc](0);
        }
        push[DriverElfReloc](&out, DriverElfReloc{ .offset = reloc.offset, .symbol = (4 + exports.len) + import_index, .typ = 2, .addend = 0 });
        i = i + 1;
    }
    return out;
}

fn znc_needed_name_ok(s: []u8) i32 {
    if ((s.len == 0) || (s.len > 128)) {
        return 0;
    }
    let i: i32 = 0;
    while (i < s.len) {
        let c: u8 = s[i];
        let ok: i32 = 0;
        if ((c >= 97) && (c <= 122)) {
            ok = 1;
        }
        if ((c >= 65) && (c <= 90)) {
            ok = 1;
        }
        if ((c >= 48) && (c <= 57)) {
            ok = 1;
        }
        if ((((c == 46) || (c == 95)) || (c == 45)) || (c == 43)) {
            ok = 1;
        }
        if (ok == 0) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

fn znc_needed_libs() ArrayList[[]u8] {
    let libs: ArrayList[[]u8] = make[[]u8](4);
    let i: i32 = 1;
    while (i < _zag_argc()) {
        if (@strEq(_zag_arg(i), "--needed")) {
            if (((i + 1) >= _zag_argc()) || (znc_needed_name_ok(_zag_arg(i + 1)) == 0)) {
                _zag_eprintln("znc: --needed requires a safe shared-library SONAME");
                _zag_exit(1);
            }
            push[[]u8](&libs, _zag_arg(i + 1));
            i = i + 1;
        }
        i = i + 1;
    }
    return libs;
}

fn find_library(libname: []u8, paths: ArrayList[[]u8]) []u8 {
    let fname: []u8 = _zag_str_concat("lib", _zag_str_concat(libname, ".a"));
    let i: i32 = 0;
    while (i < len[[]u8](paths)) {
        let full: []u8 = join_path(get[[]u8](paths, i), fname);
        if (_zag_file_exists(full) != 0) {
            return full;
        }
        i = i + 1;
    }
    let syspaths: ArrayList[[]u8] = make[[]u8](4);
    push[[]u8](&syspaths, "/usr/lib/x86_64-linux-gnu");
    push[[]u8](&syspaths, "/usr/lib");
    push[[]u8](&syspaths, "/lib/x86_64-linux-gnu");
    push[[]u8](&syspaths, "/lib");
    let j: i32 = 0;
    while (j < len[[]u8](syspaths)) {
        let full: []u8 = join_path(get[[]u8](syspaths, j), fname);
        if (_zag_file_exists(full) != 0) {
            return full;
        }
        j = j + 1;
    }
    return "";
}

fn link_libraries(libs: ArrayList[[]u8], paths: ArrayList[[]u8], needed_syms: ArrayList[[]u8], text_base: i64) MergedLib {
    let ml: MergedLib = MergedLib{ .text = make[u8](256), .sym_addrs = make[SymAddr](8), .relocs = make[PendingReloc](16), .text_base = text_base };
    let i: i32 = 0;
    while (i < len[[]u8](libs)) {
        let libname: []u8 = get[[]u8](libs, i);
        let libpath: []u8 = find_library(libname, paths);
        if (libpath.len == 0) {
            _zag_print("znc: error: @link library '");
            _zag_print(libname);
            _zag_println("' not found in search paths (set ZAG_LIB_PATH or place library adjacent to source)");
            _zag_exit(1);
        }
        if (libpath.len > 0) {
            let buf: []u8 = _zag_read_file(libpath);
            if (buf.len > 0) {
                let ar_syms: ArrayList[ArSymbol] = ar_symbol_table(buf);
                if ((needed_syms.len > 0) && (ar_syms.len == 0)) {
                    _zag_eprintln("znc: static archive is missing a valid GNU symbol table");
                    _zag_exit(1);
                }
                let selected_offsets: ArrayList[i64] = make[i64](8);
                let ni: i32 = 0;
                while (ni < len[[]u8](needed_syms)) {
                    let sym: []u8 = get[[]u8](needed_syms, ni);
                    let file_off: i64 = 0 - 1;
                    let file_matches: i32 = 0;
                    let si2: i32 = 0;
                    while (si2 < len[ArSymbol](ar_syms)) {
                        let as_: ArSymbol = get[ArSymbol](ar_syms, si2);
                        if (@strEq(as_.name, sym)) {
                            file_off = as_.entry_offset;
                            file_matches = file_matches + 1;
                        }
                        si2 = si2 + 1;
                    }
                    if (file_matches > 1) {
                        _zag_eprintln(_zag_str_concat("znc: static archive symbol table contains duplicate definitions for `", _zag_str_concat(sym, "`")));
                        _zag_exit(1);
                    }
                    if (file_off >= 0) {
                        let already_selected: i32 = 0;
                        let oi: i32 = 0;
                        while (oi < selected_offsets.len) {
                            if (get[i64](selected_offsets, oi) == file_off) {
                                already_selected = 1;
                            }
                            oi = oi + 1;
                        }
                        if (already_selected == 0) {
                            push[i64](&selected_offsets, file_off);
                            let obj_data: []u8 = ar_entry_data(buf, file_off);
                            if (obj_data.len == 0) {
                                _zag_eprintln("znc: static archive symbol table references a malformed member");
                                _zag_exit(1);
                            }
                            let obj: ObjFile = elf_obj_parse(obj_data);
                            if (obj.valid == 0) {
                                _zag_eprintln("znc: static archive contains an unsupported or malformed ELF64/x86-64 member");
                                _zag_exit(1);
                            }
                            merge_obj(&ml, obj, text_base);
                        }
                    }
                    ni = ni + 1;
                }
            }
        }
        i = i + 1;
    }
    let empty_extern: ArrayList[SymAddr] = make[SymAddr](1);
    if (apply_relocs(&ml, empty_extern) != 0) {
        _zag_eprintln("znc: static archive contains an unresolved, ambiguous, unsupported, malformed, or out-of-range relocation");
        _zag_exit(1);
    }
    return ml;
}

fn znc_patch_static_calls(code: *ArrayList[u8], relocs: ArrayList[X86ObjectReloc], imports: ArrayList[[]u8], symbols: ArrayList[SymAddr], code_base: i64) i32 {
    let ri: i32 = 0;
    while (ri < relocs.len) {
        let reloc: X86ObjectReloc = get[X86ObjectReloc](relocs, ri);
        if (((((reloc.kind != 0) || (reloc.import < 0)) || (reloc.import >= imports.len)) || (reloc.offset < 0)) || (reloc.offset > (code.*.len - 4))) {
            _zag_eprintln("znc: malformed compiler-owned static call relocation");
            return 1;
        }
        let name: []u8 = get[[]u8](imports, reloc.import);
        let target: i64 = 0;
        let matches: i32 = 0;
        let si: i32 = 0;
        while (si < symbols.len) {
            let symbol: SymAddr = get[SymAddr](symbols, si);
            if (@strEq(symbol.name, name)) {
                target = symbol.addr;
                matches = matches + 1;
            }
            si = si + 1;
        }
        if (matches != 1) {
            _zag_eprintln(_zag_str_concat("znc: static archive did not resolve exactly one definition for `", _zag_str_concat(name, "`")));
            return 1;
        }
        let site: i64 = code_base + reloc.offset as i64;
        let displacement: i64 = target - (site + 4);
        if ((displacement < (0 - 2147483648)) || (displacement > 2147483647)) {
            _zag_eprintln(_zag_str_concat("znc: static archive call is out of rel32 range: ", name));
            return 1;
        }
        let value: i64 = displacement;
        let bi: i32 = 0;
        while (bi < 4) {
            let byte: i64 = value & 255;
            set[u8](code, reloc.offset + bi, byte as u8);
            value = (value - byte) / 256;
            bi = bi + 1;
        }
        ri = ri + 1;
    }
    return 0;
}

fn starts_with(s: []u8, p: []u8) i32 {
    if (s.len < p.len) {
        return 0;
    }
    let i: i32 = 0;
    while (i < p.len) {
        if (s[i] != p[i]) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

