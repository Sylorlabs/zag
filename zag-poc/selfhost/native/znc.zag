        .slice_ => |x| {
            count = (count + znc_script_call_count_expr(x.base, name)) + znc_script_call_count_expr(x.lo, name);
            if (x.has_hi == 1) {
                count = count + znc_script_call_count_expr(x.hi, name);
            }
        }
        .slit_ => |x| {
            let i: i32 = 0;
            while (i < x.fields.len) {
                count = count + znc_script_call_count_expr(x.fields.data[i].val, name);
                i = i + 1;
            }
        }
        else => {
        }
    }
    return count;
}

fn znc_script_call_count_body(body: ArrayList[*Node], name: []u8) i32 {
    let count: i32 = 0;
    let i: i32 = 0;
    while (i < body.len) {
        switch (body.data[i].*) {
            .let_ => |x| {
                if (x.has_init == 1) {
                    count = count + znc_script_call_count_expr(x.expr, name);
                }
            }
            .ret => |x| {
                if (x.has_expr == 1) {
                    count = count + znc_script_call_count_expr(x.expr, name);
                }
            }
            .estmt => |x| {
                count = count + znc_script_call_count_expr(x.expr, name);
            }
            .assign => |x| {
                count = (count + znc_script_call_count_expr(x.target, name)) + znc_script_call_count_expr(x.expr, name);
            }
            .if_ => |x| {
                count = ((count + znc_script_call_count_expr(x.cond, name)) + znc_script_call_count_body(x.then_body, name)) + znc_script_call_count_body(x.els_body, name);
            }
            .while_ => |x| {
                count = (count + znc_script_call_count_expr(x.cond, name)) + znc_script_call_count_body(x.body, name);
            }
