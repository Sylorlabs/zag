                count = count + znc_script_call_count_expr(x.args.data[i], name);
                i = i + 1;
            }
        }
        .bin => |x| {
            count = (count + znc_script_call_count_expr(x.l, name)) + znc_script_call_count_expr(x.r, name);
        }
        .un => |x| {
            count = count + znc_script_call_count_expr(x.e, name);
        }
        .fld => |x| {
