// selfhost/native/znc.zag — the NATIVE-backend CLI driver.
//
//   znc <source.zag> [-o <out>] [--run]
//
// Compiles Zag source straight to a runnable native x86-64 ELF:
//
//   source ──parse──▶ AST ──ncodegen──▶ x86-64 instrs ──x86 encode──▶ machine
//   code ──elf──▶ ELF executable.
//
// There is NO cc / as / ld / libc / LLVM anywhere in this pipeline — every
// stage is Zag (this driver + ncodegen.zag + x86.zag + elf.zag). The emitted
// binary is statically linked, has no interpreter, and exits via a raw syscall.

@import("x86.zag")        // encode(ArrayList[Instr]) -> ArrayList[u8]
@import("elf.zag")        // write_elf_exec_data / write_elf_exec_data_lib
@import("elf_i686.zag")   // isolated literal-main ELF32/i386 milestone
@import("i386_codegen.zag") // validated AST -> integer IR -> i386 machine code
@import("elf_dynamic.zag") // explicit PT_INTERP/DT_NEEDED system ABI bridge
@import("regalloc.zag")   // regalloc(ArrayList[Instr]) -> ArrayList[Instr] (register promotion)
@import("optimize.zag")   // optimize(ArrayList[Instr]) -> ArrayList[Instr] (fold/stack-elim/DCE)
@import("peephole.zag")   // peephole(ArrayList[Instr]) -> ArrayList[Instr] (optimizer)
@import("ncodegen.zag")   // lower_program(decls, *errcount, *databuf) -> ArrayList[Instr]
@import("../sema.zag")    // analyze(decls)->eff  report_violations(decls,eff)->i32
@import("../typed.zag")   // shared declared-type authority for every target
@import("../v2_edition.zag") // edition-gated v2 syntax rejection before parse
@import("../analyze.zag") // run_analysis(decls, file, pedantic)->i32  leak + efficiency lints
@import("ar.zag")         // ar_symbol_table, ar_entry_data (GNU ar reader)
@import("elf_obj.zag")    // elf_obj_parse, merge_obj, apply_relocs, MergedLib
@import("zagmod.zag")     // zagmod_parse, ZagMod (zag.mod manifest reader)
@import("dwarf.zag")      // optional DWARF sections for --debug builds
@import("../fmt.zag")     // native Zag source formatter
@import("../version.zag") // zag_version / zag_edition
@import("../smt.zag")     // @total SMT discharge (kept out of sema.zag for lean bootstrap)
@import("../mlir.zag")    // GPU MLIR emitter (lean — no codegen.zag dependency)
@import("../gfx1010.zag") // deterministic validated RDNA1 kernel bundles
@import("../planner_authority.zag") // line-wise planner configuration authority
@import("../semantic_manifest_publish.zag") // advisory sema identities for zagd
@import("wasm.zag")       // WASM binary emitter
@import("acodegen.zag")   // AArch64 lean codegen (--target arm64 only)

@import("aarch64.zag")   // AArch64 instruction encoder
@import("elf_arm64.zag")  // ELF64 AArch64 writer
@import("x86_cpu_profile.zag") // explicit Linux x86-64 baseline/native policy

extern fn _zag_raw_syscall(num: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64) i64
extern fn _zag_slice_ptr(s: []u8) *i8

// ── operator-contract lowering (pre-sema) ────────────────────────────────────
// Rewrites binary ops on user types to their decode fn calls BEFORE sema runs,
// so the effect checker sees `big_add(x, y)` instead of `x + y` and can
// correctly flag @realtime functions that use an allocating operator.
// Mirrors zagc.zag's lower_operators() call, but without pulling in codegen.zag.
struct LoEnv { name: []u8, ty: []u8 }
fn lo_env_get(env: ArrayList[LoEnv], name: []u8) []u8 {
    let i: i32 = 0;
    while (i < len[LoEnv](env)) {
        if (@strEq(get[LoEnv](env, i).name, name)) { return get[LoEnv](env, i).ty; }
        i = i + 1;
    }
    return "";
}
fn lo_id_ty(n: *Node, env: ArrayList[LoEnv], dl: ArrayList[*Node]) []u8 {
    switch (n.*) {
        .id  => |x| { return lo_env_get(env, x.name); }
        .fld => |f| {
            let base_ty: []u8 = lo_id_ty(f.base, env, dl);
            if (base_ty.len == 0) { return ""; }
            let si: i32 = 0;
            while (si < len[*Node](dl)) {
                switch (get[*Node](dl, si).*) {
                    .struct_ => |s| {
                        if (@strEq(s.name, base_ty)) {
                            let fi: i32 = 0;
                            while (fi < len[Param](s.fields)) {
                                let fp: Param = get[Param](s.fields, fi);
                                if (@strEq(fp.name, f.fname)) { return fp.pty; }
                                fi = fi + 1;
                            }
                        }
                    }
                    else => { }
                }
                si = si + 1;
            }
            return "";
        }
        else => { return ""; }
    }
}
fn lo_mk_call2(fname: []u8, a: *Node, b: *Node) *Node {
    let args: ArrayList[*Node] = make[*Node](2);
    push[*Node](&args, a);
    push[*Node](&args, b);
    return mk_call(mk_ident(fname), args);
}
fn lo_expr(n: *Node, env: ArrayList[LoEnv], dl: ArrayList[*Node]) void {
    switch (n.*) {
        .bin => |b| {
            lo_expr(b.l, env, dl);
            lo_expr(b.r, env, dl);
            if (@strEq(b.op, "+") || @strEq(b.op, "-") || @strEq(b.op, "*") || @strEq(b.op, "/")) {
                let lt: []u8 = lo_id_ty(b.l, env, dl);
                if (lt.len > 0) {
                    let decode: []u8 = op_contract_fn(dl, lt, b.op);
                    if (decode.len > 0) {
                        n.* = lo_mk_call2(decode, b.l, b.r).*;
                    }
                }
            }
        }
        .un    => |u| { lo_expr(u.e, env, dl); }
        .call  => |c| {
            lo_expr(c.callee, env, dl);
            let i: i32 = 0;
            while (i < len[*Node](c.args)) { lo_expr(get[*Node](c.args, i), env, dl); i = i + 1; }
        }
        .idx   => |x| { lo_expr(x.base, env, dl); lo_expr(x.idx, env, dl); }
        .fld   => |f| { lo_expr(f.base, env, dl); }
        .slit_ => |s| {
            let i: i32 = 0;
            while (i < len[FieldInit](s.fields)) { lo_expr(get[FieldInit](s.fields, i).val, env, dl); i = i + 1; }
        }
        else => { }
    }
}
fn lo_block(body: ArrayList[*Node], env: *ArrayList[LoEnv], dl: ArrayList[*Node]) void {
    let i: i32 = 0;
    while (i < len[*Node](body)) { lo_stmt(get[*Node](body, i), env, dl); i = i + 1; }
}
fn lo_stmt(n: *Node, env: *ArrayList[LoEnv], dl: ArrayList[*Node]) void {
    switch (n.*) {
        .let_   => |l| {
            lo_expr(l.expr, env.*, dl);
            // Track declared-type let bindings so we can resolve `x+y` when x is a let var.
            if (l.has_dty == 1 && l.dty.len > 0) {
                push[LoEnv](env, LoEnv{ .name = l.name, .ty = l.dty });
            }
        }
        .ret    => |r| { if (r.has_expr == 1) { lo_expr(r.expr, env.*, dl); } }
        .if_    => |x| { lo_expr(x.cond, env.*, dl); lo_block(x.then_body, env, dl); lo_block(x.els_body, env, dl); }
        .while_ => |w| { lo_expr(w.cond, env.*, dl); lo_block(w.body, env, dl); }
        .unsafe_ => |u| { lo_block(u.body, env, dl); }
        .assign => |a| { lo_expr(a.target, env.*, dl); lo_expr(a.expr, env.*, dl); }
        .switch_ => |sw| {
            lo_expr(sw.subject, env.*, dl);
            let i: i32 = 0;
            while (i < len[SwitchArm](sw.arms)) { lo_block(get[SwitchArm](sw.arms, i).body, env, dl); i = i + 1; }
            if (sw.has_els == 1) { lo_block(sw.els_body, env, dl); }
        }
        .estmt  => |e| { lo_expr(e.expr, env.*, dl); }
        else    => { }
    }
}
fn lo_build_env(params: ArrayList[Param]) ArrayList[LoEnv] {
    let env: ArrayList[LoEnv] = make[LoEnv](8);
    let i: i32 = 0;
    while (i < len[Param](params)) {
        let p: Param = get[Param](params, i);
        push[LoEnv](&env, LoEnv{ .name = p.name, .ty = p.pty });
        i = i + 1;
    }
    return env;
}
fn lo_operators(decls: ArrayList[*Node]) void {
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                // skip externs, generics, and operator-contract pseudo-fns
                if (f.is_extern == 0 && len[[]u8](f.tparams) == 0) {
                    let is_op: i32 = 0;
                    if (f.name.len >= 5) {
                        if (f.name[0] == '_' && f.name[1] == '_' && f.name[2] == 'o' && f.name[3] == 'p' && f.name[4] == '_') { is_op = 1; }
                    }
                    if (is_op == 0) {
                        let lenv: ArrayList[LoEnv] = lo_build_env(f.params);
                        lo_block(f.body, &lenv, decls);
                    }
                }
            }
            else => { }
        }
        i = i + 1;
    }
}

// ── library linking helpers ───────────────────────────────────────────────────

// Walk `decls`, collect any `.link_dir` node's `.lib` name into `link_libs`,
// and return a new list with all `.link_dir` nodes removed.
// ncodegen.zag's pass-1 switch would abort on unknown top-level nodes, so we
// must filter them out before calling lower_program.
fn znc_collect_links(decls: ArrayList[*Node], link_libs: *ArrayList[[]u8]) ArrayList[*Node] {
    let filtered: ArrayList[*Node] = make[*Node](len[*Node](decls));
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        let n: *Node = get[*Node](decls, i);
        switch (n.*) {
            .link_dir => |ld| { push[[]u8](link_libs, ld.lib); }
            else => { push[*Node](&filtered, n); }
        }
        i = i + 1;
    }
    return filtered;
}

// Append any `-lNAME` or `-l NAME` library names from argv into `link_libs`.
fn znc_argv_links(link_libs: *ArrayList[[]u8]) void {
    let i: i32 = 1;
    while (i < _zag_argc()) {
        let a: []u8 = _zag_arg(i);
        if (a.len > 2) {
            // "-lNAME" form
            if ((a[0] as i32) == 45 && (a[1] as i32) == 108) {
                push[[]u8](link_libs, a[2..a.len]);
            }
        }
        if (@strEq(a, "-l")) {
            if (i + 1 < _zag_argc()) {
                push[[]u8](link_libs, _zag_arg(i + 1));
                i = i + 1;
            }
        }
        i = i + 1;
    }
}

// Append any `-LPATH` or `-L PATH` search directories from argv into `lib_paths`.
fn znc_argv_paths(lib_paths: *ArrayList[[]u8]) void {
    let i: i32 = 1;
    while (i < _zag_argc()) {
        let a: []u8 = _zag_arg(i);
        if (a.len > 2) {
            // "-LPATH" form
            if ((a[0] as i32) == 45 && (a[1] as i32) == 76) {
                push[[]u8](lib_paths, a[2..a.len]);
            }
        }
        if (@strEq(a, "-L")) {
            if (i + 1 < _zag_argc()) {
                push[[]u8](lib_paths, _zag_arg(i + 1));
                i = i + 1;
            }
        }
        i = i + 1;
    }
}

// Read a `zag.mod` from `dir` and add any `link` and `path` fields from
// [deps] into `link_libs` and `lib_paths` respectively.
fn znc_load_zagmod(dir: []u8, link_libs: *ArrayList[[]u8], lib_paths: *ArrayList[[]u8]) void {
    let modpath: []u8 = join_path(dir, "zag.mod");
    if (_zag_file_exists(modpath) == 0) { return; }
    let src: []u8 = _zag_read_file(modpath);
    if (src.len < 0) { return; }
    let mod_: ZagMod = zagmod_parse(src);
    let i: i32 = 0;
    while (i < len[ZagDep](mod_.deps)) {
        let dep: ZagDep = get[ZagDep](mod_.deps, i);
        if (dep.link.len > 0) { push[[]u8](link_libs, dep.link); }
        if (dep.path.len > 0) { push[[]u8](lib_paths, dep.path); }
        i = i + 1;
    }
}

// Scan the filtered decls list for `extern fn` declarations and return their names.
// These are the symbols we need to pull in from static libraries.
fn collect_extern_syms(decls: ArrayList[*Node]) ArrayList[[]u8] {
    let syms: ArrayList[[]u8] = make[[]u8](8);
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                if (f.is_extern == 1) { push[[]u8](&syms, f.name); }
            }
            else => { }
        }
        i = i + 1;
    }
    return syms;
}

fn znc_dynamic_extern_syms(decls: ArrayList[*Node]) ArrayList[[]u8] {
    let syms: ArrayList[[]u8] = make[[]u8](8);
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                if (f.is_extern == 1 && starts_with(f.name, "_zag_") == 0) {
                    let found: i32 = 0;
                    let j: i32 = 0;
                    while (j < syms.len) {
                        if (@strEq(get[[]u8](syms, j), f.name)) { found = 1; }
                        j = j + 1;
                    }
                    if (found == 0) { push[[]u8](&syms, f.name); }
                }
            }
            else => { }
        }
        i = i + 1;
    }
    return syms;
}

fn znc_needed_name_ok(s: []u8) i32 {
    if (s.len == 0 || s.len > 128) { return 0; }
    let i: i32 = 0;
    while (i < s.len) {
        let c: u8 = s[i];
        let ok: i32 = 0;
        if (c >= 'a' && c <= 'z') { ok = 1; }
        if (c >= 'A' && c <= 'Z') { ok = 1; }
        if (c >= '0' && c <= '9') { ok = 1; }
        if (c == '.' || c == '_' || c == '-' || c == '+') { ok = 1; }
        if (ok == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn znc_needed_libs() ArrayList[[]u8] {
    let libs: ArrayList[[]u8] = make[[]u8](4);
    let i: i32 = 1;
    while (i < _zag_argc()) {
        if (@strEq(_zag_arg(i), "--needed")) {
            if (i + 1 >= _zag_argc() || znc_needed_name_ok(_zag_arg(i + 1)) == 0) {
                _zag_eprintln("znc: --needed requires a safe shared-library SONAME");
                _zag_exit(1);
            }
            push[[]u8](&libs, _zag_arg(i + 1));
            i = i + 1;
        }
        i = i + 1;
    }
    return libs;
}

// Search for `lib{libname}.a` in the user-supplied paths then in standard
// system library directories.  Returns the full path on success, "" on failure.
fn find_library(libname: []u8, paths: ArrayList[[]u8]) []u8 {
    let fname: []u8 = _zag_str_concat("lib", _zag_str_concat(libname, ".a"));
    let i: i32 = 0;
    while (i < len[[]u8](paths)) {
        let full: []u8 = join_path(get[[]u8](paths, i), fname);
        if (_zag_file_exists(full) != 0) { return full; }
        i = i + 1;
    }
    // Fallback: standard Linux multiarch and legacy paths.
    let syspaths: ArrayList[[]u8] = make[[]u8](4);
    push[[]u8](&syspaths, "/usr/lib/x86_64-linux-gnu");
    push[[]u8](&syspaths, "/usr/lib");
    push[[]u8](&syspaths, "/lib/x86_64-linux-gnu");
    push[[]u8](&syspaths, "/lib");
    let j: i32 = 0;
    while (j < len[[]u8](syspaths)) {
        let full: []u8 = join_path(get[[]u8](syspaths, j), fname);
        if (_zag_file_exists(full) != 0) { return full; }
        j = j + 1;
    }
    return "";
}

// For each library in `libs`, find it, parse it as a GNU ar archive,
// and merge the object-file members that define symbols in `needed_syms`
// into a single MergedLib.  Then apply intra-library relocations.
//
// `text_base` — the virtual address where the merged library code will be
// placed (immediately after the main program code in the ELF text segment).
fn link_libraries(libs: ArrayList[[]u8], paths: ArrayList[[]u8], needed_syms: ArrayList[[]u8], text_base: i64) MergedLib {
    let ml: MergedLib = MergedLib{
        .text      = make[u8](256),
        .sym_addrs = make[SymAddr](8),
        .relocs    = make[PendingReloc](16),
        .text_base = text_base,
    };

    let i: i32 = 0;
    while (i < len[[]u8](libs)) {
        let libname: []u8 = get[[]u8](libs, i);
        let libpath: []u8 = find_library(libname, paths);
        if (libpath.len == 0) {
            _zag_print("znc: error: @link library '");
            _zag_print(libname);
            _zag_println("' not found in search paths (set ZAG_LIB_PATH or place library adjacent to source)");
            _zag_exit(1);
        }
        if (libpath.len > 0) {
            let buf: []u8 = _zag_read_file(libpath);
            if (buf.len > 0) {
                // Parse the GNU symbol table so we can look up which archive
                // member contains each needed symbol.
                let ar_syms: ArrayList[ArSymbol] = ar_symbol_table(buf);
                let ni: i32 = 0;
                while (ni < len[[]u8](needed_syms)) {
                    let sym: []u8 = get[[]u8](needed_syms, ni);
                    let file_off: i64 = 0 - 1;
                    let si2: i32 = 0;
                    while (si2 < len[ArSymbol](ar_syms)) {
                        let as_: ArSymbol = get[ArSymbol](ar_syms, si2);
                        if (@strEq(as_.name, sym)) { file_off = as_.entry_offset; }
                        si2 = si2 + 1;
                    }
                    if (file_off >= 0) {
                        let obj_data: []u8 = ar_entry_data(buf, file_off);
                        if (obj_data.len > 0) {
                            let obj: ObjFile = elf_obj_parse(obj_data);
                            merge_obj(&ml, obj, text_base);
                        }
                    }
                    ni = ni + 1;
                }
            }
        }
        i = i + 1;
    }

    // Apply intra-library relocations now that all sym_addrs are known.
    let empty_extern: ArrayList[SymAddr] = make[SymAddr](1);
    apply_relocs(&ml, empty_extern);

    return ml;
}

// ── gpu / wasm targets (mlir.zag + wasm.zag, linked above) ───────────────────
// mlir.zag is decoupled from codegen.zag so this driver can host GPU/WASM
// backends without blowing the self-hosting fixpoint budget.

fn starts_with(s: []u8, p: []u8) i32 {
    if (s.len < p.len) { return 0; }
    let i: i32 = 0;
    while (i < p.len) {
        if (s[i] != p[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

// "nvidia" / "amd" / "vulkan" when `--target gpu-*` is present, else "".
fn gpu_target() []u8 {
    let i: i32 = 0;
    while (i < _zag_argc()) {
        let a: []u8 = _zag_arg(i);
        if (@strEq(a, "--target")) {
            if (i + 1 < _zag_argc()) {
                let v: []u8 = _zag_arg(i + 1);
                if (starts_with(v, "gpu-") == 1) { return v[4..]; }
            }
        }
        if (starts_with(a, "--target=gpu-") == 1) { return a[13..]; }
        i = i + 1;
    }
    return "";
}

fn gfx1010_target() i32 {
    let i: i32 = 0;
    while (i < _zag_argc()) {
        let a: []u8 = _zag_arg(i);
        if (@strEq(a, "--target") && i + 1 < _zag_argc() &&
            @strEq(_zag_arg(i + 1), "amdgpu-gfx1010")) { return 1; }
        if (@strEq(a, "--target=amdgpu-gfx1010")) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn wasm_target() i32 {
    let i: i32 = 0;
    while (i < _zag_argc()) {
        let a: []u8 = _zag_arg(i);
        if (@strEq(a, "--target")) {
            if (i + 1 < _zag_argc()) {
                if (@strEq(_zag_arg(i + 1), "wasm")) { return 1; }
            }
        }
        if (@strEq(a, "--target=wasm")) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn arm64_target() i32 {
    let i: i32 = 0;
    while (i < _zag_argc()) {
        let a: []u8 = _zag_arg(i);
        if (@strEq(a, "--target")) {
            if (i + 1 < _zag_argc()) {
                let v: []u8 = _zag_arg(i + 1);
                if (@strEq(v, "arm64") || @strEq(v, "aarch64")) { return 1; }
            }
        }
        if (@strEq(a, "--target=arm64") || @strEq(a, "--target=aarch64")) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn i686_target() i32 {
    let i:i32=0;
    while(i<_zag_argc()) {
        let a:[]u8=_zag_arg(i);
        if (@strEq(a,"--target") && i+1<_zag_argc()) {
            let v:[]u8=_zag_arg(i+1);
            if (@strEq(v,"i686") || @strEq(v,"x86") || @strEq(v,"linux-i686")) { return 1; }
        }
        if (@strEq(a,"--target=i686") || @strEq(a,"--target=x86") || @strEq(a,"--target=linux-i686")) { return 1; }
        i=i+1;
    }
    return 0;
}

fn build_i686_minimal(path: []u8) i32 {
    let src:[]u8=_zag_read_file(path);
    if (src.len < 0) { _zag_eprintln("znc i686: cannot read source"); return 1; }
    if(has_flag("--link-i686")==1){let linked:[]u8=out_flag();if(linked.len==0){linked=default_out(path);}if(write_i686_linked_object(linked,src)!=0){_zag_eprintln("znc i686: unsupported or corrupt Zag ELF32 object/archive");return 1;}_zag_println(_zag_str_concat("znc: linked ELF32/i386 executable ",linked));return 0;}
    let unit:CompilationUnit=parse_compilation_unit_dir(src,dir_of(path));
    if(unit.profile==ModuleProfile.script) { _zag_eprintln("znc i686: unsupported construct: Zag Script runtime is not implemented"); return 1; }
    let lower:I386Lower=I386Lower{.ir=make[I32IR](32),.locals=make[I386Local](8),.funcs=make[I386Fn](8),.structs=make[StructDecl](4),.failed=0,.next_label=0,.next_slot=0,.break_label=-1,.continue_label=-1,.current_error_fn=0};
    if(lower_i386_i32_program(unit.decls,&lower)!=0) { return 1; }
    let text:ArrayList[u8]=encode_i386_i32(&lower);
    let out:[]u8=out_flag();
    if (out.len==0) { out=default_out(path); }
    if(has_flag("--emit-obj")==1){if(write_i686_object(out,text)!=0){_zag_eprintln("znc i686: failed to write ELF32 object");return 1;}_zag_println(_zag_str_concat("znc: wrote ELF32/i386 object ",out));return 0;}
    if(has_flag("--emit-static")==1){if(write_i686_archive(out,text)!=0){_zag_eprintln("znc i686: failed to write static archive");return 1;}_zag_println(_zag_str_concat("znc: wrote ELF32/i386 archive ",out));return 0;}
    if (write_i686_text(out,text)!=0) { _zag_eprintln("znc i686: failed to write ELF32 executable"); return 1; }
    _zag_println(_zag_str_concat("znc: wrote ELF32/i386 i32 binary ",out));
    return 0;
}

fn stem_of(path: []u8) []u8 {
    let slash: i32 = 0 - 1;
    let i: i32 = 0;
    while (i < path.len) {
        if (path[i] == '/') { slash = i; }
        i = i + 1;
    }
    let base: []u8 = path;
    if (slash >= 0) { base = path[slash + 1..]; }
    let dot: i32 = 0 - 1;
    let j: i32 = 0;
    while (j < base.len) {
        if (base[j] == '.') { dot = j; }
        j = j + 1;
    }
    if (dot > 0) { return base[0..dot]; }
    return base;
}

// ── call-arity check ─────────────────────────────────────────────────────────
// Static pass: every call through a PLAIN top-level fn name must pass exactly
// as many arguments as the decl has params. Skips builtins, @-intrinsics,
// runtime externs, method sugar, and names shadowed by locals/params/captures
// (those are fn-values whose arity is not statically known here).

fn znc_arity_exempt(nm: []u8) i32 {
    if (nm.len == 0) { return 1; }
    if (nm[0] == '@') { return 1; }
    if (cg_starts_with(nm, "_zag_") == 1) { return 1; }
    if (cg_starts_with(nm, "__") == 1) { return 1; }
    if (@strEq(nm, "new") || @strEq(nm, "delete")) { return 1; }
    if (@strEq(nm, "print_int") || @strEq(nm, "print_i32") || @strEq(nm, "print_str")) { return 1; }
    if (@strEq(nm, "print_f64") || @strEq(nm, "print_f32") || @strEq(nm, "print_u64") || @strEq(nm, "print_i64")) { return 1; }
    if (@strEq(nm, "zalloc") || @strEq(nm, "zfree")) { return 1; }
    if (@strEq(nm, "sinf") || @strEq(nm, "cosf") || @strEq(nm, "sqrtf")) { return 1; }
    if (@strEq(nm, "sin") || @strEq(nm, "cos") || @strEq(nm, "sqrt")) { return 1; }
    return 0;
}

fn znc_arity_in(names: ArrayList[[]u8], nm: []u8) i32 {
    let i: i32 = 0;
    while (i < len[[]u8](names)) {
        if (@strEq(get[[]u8](names, i), nm)) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn znc_arity_locals(body: ArrayList[*Node], outn: *ArrayList[[]u8]) void {
    let i: i32 = 0;
    while (i < len[*Node](body)) {
        switch (get[*Node](body, i).*) {
            .let_ => |l| { push[[]u8](outn, l.name); }
            .if_ => |x| {
                if (x.has_cap == 1) { push[[]u8](outn, x.cap); }
                znc_arity_locals(x.then_body, outn);
                znc_arity_locals(x.els_body, outn);
            }
            .while_ => |w| {
                if (w.has_cap == 1) { push[[]u8](outn, w.cap); }
                znc_arity_locals(w.body, outn);
            }
            .unsafe_ => |u| { znc_arity_locals(u.body, outn); }
            .switch_ => |sw| {
                let ai: i32 = 0;
                while (ai < len[SwitchArm](sw.arms)) {
                    let arm: SwitchArm = get[SwitchArm](sw.arms, ai);
                    if (arm.has_cap == 1) { push[[]u8](outn, arm.cap); }
                    znc_arity_locals(arm.body, outn);
                    ai = ai + 1;
                }
                if (sw.has_els == 1) { znc_arity_locals(sw.els_body, outn); }
            }
            else => { }
        }
        i = i + 1;
    }
}

fn znc_arity_find(decls: ArrayList[*Node], nm: []u8) i32 {
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                if (@strEq(f.name, nm) && f.is_extern == 0) { return len[Param](f.params); }
            }
            else => { }
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn znc_arity_expr(n: *Node, fname: []u8, locals: ArrayList[[]u8], decls: ArrayList[*Node], errs: *i32) void {
    switch (n.*) {
        .call => |c| {
            switch (c.callee.*) {
                .id => |fnid| {
                    if (znc_arity_exempt(fnid.name) == 0 && znc_arity_in(locals, fnid.name) == 0) {
                        let want: i32 = znc_arity_find(decls, fnid.name);
                        if (want >= 0 && want != len[*Node](c.args)) {
                            _zag_eprintln(_zag_str_concat("znc: error: call to '", _zag_str_concat(fnid.name,
                                _zag_str_concat("' passes ", _zag_str_concat(_zag_i64_to_str(len[*Node](c.args) as i64),
                                _zag_str_concat(" argument(s), expected ", _zag_str_concat(_zag_i64_to_str(want as i64),
                                _zag_str_concat(" (in fn '", _zag_str_concat(fname, "')")))))))));
                            errs.* = errs.* + 1;
                        }
                    }
                }
                .fld => |mf| { znc_arity_expr(mf.base, fname, locals, decls, errs); }
                else => { }
            }
            let i: i32 = 0;
            while (i < len[*Node](c.args)) {
                znc_arity_expr(get[*Node](c.args, i), fname, locals, decls, errs);
                i = i + 1;
            }
        }
        .bin => |b| {
            znc_arity_expr(b.l, fname, locals, decls, errs);
            znc_arity_expr(b.r, fname, locals, decls, errs);
        }
        .un => |u| { znc_arity_expr(u.e, fname, locals, decls, errs); }
        .idx => |ix| {
            znc_arity_expr(ix.base, fname, locals, decls, errs);
            znc_arity_expr(ix.idx, fname, locals, decls, errs);
        }
        .fld => |f| { znc_arity_expr(f.base, fname, locals, decls, errs); }
        .cast_ => |cst| { znc_arity_expr(cst.expr, fname, locals, decls, errs); }
        .slit_ => |sl| {
            let i2: i32 = 0;
            while (i2 < len[FieldInit](sl.fields)) {
                znc_arity_expr(get[FieldInit](sl.fields, i2).val, fname, locals, decls, errs);
                i2 = i2 + 1;
            }
        }
        .slice_ => |sc| {
            znc_arity_expr(sc.base, fname, locals, decls, errs);
            znc_arity_expr(sc.lo, fname, locals, decls, errs);
            if (sc.has_hi == 1) { znc_arity_expr(sc.hi, fname, locals, decls, errs); }
        }
        else => { }
    }
}

fn znc_arity_block(body: ArrayList[*Node], fname: []u8, locals: ArrayList[[]u8], decls: ArrayList[*Node], errs: *i32) void {
    let i: i32 = 0;
    while (i < len[*Node](body)) {
        switch (get[*Node](body, i).*) {
            .let_ => |l| { if (l.has_init == 1) { znc_arity_expr(l.expr, fname, locals, decls, errs); } }
            .assign => |a| {
                znc_arity_expr(a.target, fname, locals, decls, errs);
                znc_arity_expr(a.expr, fname, locals, decls, errs);
            }
            .ret => |r| { if (r.has_expr == 1) { znc_arity_expr(r.expr, fname, locals, decls, errs); } }
            .if_ => |x| {
                znc_arity_expr(x.cond, fname, locals, decls, errs);
                znc_arity_block(x.then_body, fname, locals, decls, errs);
                znc_arity_block(x.els_body, fname, locals, decls, errs);
            }
            .while_ => |w| {
                znc_arity_expr(w.cond, fname, locals, decls, errs);
                znc_arity_block(w.body, fname, locals, decls, errs);
            }
            .unsafe_ => |u| { znc_arity_block(u.body, fname, locals, decls, errs); }
            .switch_ => |sw| {
                znc_arity_expr(sw.subject, fname, locals, decls, errs);
                let ai: i32 = 0;
                while (ai < len[SwitchArm](sw.arms)) {
                    znc_arity_block(get[SwitchArm](sw.arms, ai).body, fname, locals, decls, errs);
                    ai = ai + 1;
                }
                if (sw.has_els == 1) { znc_arity_block(sw.els_body, fname, locals, decls, errs); }
            }
            .estmt => |e| { znc_arity_expr(e.expr, fname, locals, decls, errs); }
            else => { }
        }
        i = i + 1;
    }
}

fn znc_check_arity(decls: ArrayList[*Node]) i32 {
    let errs: i32 = 0;
    let di: i32 = 0;
    while (di < len[*Node](decls)) {
        switch (get[*Node](decls, di).*) {
            .fn_decl => |f| {
                if (f.is_extern == 0 && len[*Node](f.body) > 0 && cg_starts_with(f.name, "__iface_") == 0) {
                    let locals: ArrayList[[]u8] = make[[]u8](8);
                    let pi: i32 = 0;
                    while (pi < len[Param](f.params)) {
                        push[[]u8](&locals, get[Param](f.params, pi).name);
                        pi = pi + 1;
                    }
                    // closure captures are locals too (may hold fn-values)
                    if (f.cap_names.len > 0) {
                        let cns: ArrayList[[]u8] = split_args(f.cap_names);
                        let ci: i32 = 0;
                        while (ci < len[[]u8](cns)) {
                            let cn: []u8 = get[[]u8](cns, ci);
                            if (cn.len > 0 && cn[0] == '*') { push[[]u8](&locals, cn[1..]); }
                            else { push[[]u8](&locals, cn); }
                            ci = ci + 1;
                        }
                    }
                    znc_arity_locals(f.body, &locals);
                    znc_arity_block(f.body, f.name, locals, decls, &errs);
                }
            }
            else => { }
        }
        di = di + 1;
    }
    return errs;
}


// ── duplicate-definition check ───────────────────────────────────────────────
// Two top-level definitions with one name silently shadow each other: calls
// resolve against one decl's signature while codegen may pick the other,
// which has miscompiled in the wild (segfaults, wrong-arity table lookups).
// Functions and types are checked in separate namespaces. Repeated extern
// declarations of the same name are tolerated (common across import graphs),
// as are body-less forward declarations (`fn foo() T;`) alongside one body.

fn znc_dup_report(kind: []u8, nm: []u8) void {
    _zag_eprintln(_zag_str_concat("znc: error: duplicate ", _zag_str_concat(kind,
        _zag_str_concat(" definition '", _zag_str_concat(nm, "'")))));
}

fn znc_check_dups(decls: ArrayList[*Node]) i32 {
    let fn_names: ArrayList[[]u8] = make[[]u8](64);
    let fn_kind: ArrayList[i32] = make[i32](64);   // 0=extern, 1=forward decl, 2=definition
    let ty_names: ArrayList[[]u8] = make[[]u8](64);
    let errs: i32 = 0;
    let di: i32 = 0;
    while (di < len[*Node](decls)) {
        switch (get[*Node](decls, di).*) {
            .fn_decl => |f| {
                let kind: i32 = 2;
                if (f.is_extern == 1) { kind = 0; }
                else if (len[*Node](f.body) == 0) { kind = 1; }
                let j: i32 = 0;
                let hit: i32 = 0 - 1;
                while (j < len[[]u8](fn_names)) {
                    if (@strEq(get[[]u8](fn_names, j), f.name)) { hit = j; }
                    j = j + 1;
                }
                if (hit >= 0) {
                    let prev: i32 = get[i32](fn_kind, hit);
                    let bad: i32 = 0;
                    if (prev == 0 && kind != 0) { bad = 1; }
                    if (prev != 0 && kind == 0) { bad = 1; }
                    if (prev == 2 && kind == 2) { bad = 1; }
                    if (bad == 1) {
                        znc_dup_report("fn", f.name);
                        errs = errs + 1;
                    } else if (kind > prev) {
                        set[i32](&fn_kind, hit, kind);
                    }
                } else {
                    push[[]u8](&fn_names, f.name);
                    push[i32](&fn_kind, kind);
                }
            }
            .struct_ => |s| {
                if (znc_arity_in(ty_names, s.name) == 1) {
                    znc_dup_report("type", s.name);
                    errs = errs + 1;
                } else {
                    push[[]u8](&ty_names, s.name);
                }
            }
            .enum_ => |e| {
                if (znc_arity_in(ty_names, e.name) == 1) {
                    znc_dup_report("type", e.name);
                    errs = errs + 1;
                } else {
                    push[[]u8](&ty_names, e.name);
                }
            }
            .union_ => |u| {
                if (znc_arity_in(ty_names, u.name) == 1) {
                    znc_dup_report("type", u.name);
                    errs = errs + 1;
                } else {
                    push[[]u8](&ty_names, u.name);
                }
            }
            else => { }
        }
        di = di + 1;
    }
    return errs;
}

fn znc_check_src(path: []u8, src: []u8) i32 {
    if (v2_validate_source(path, src) != 0) { return 1; }
    let unit: CompilationUnit = parse_compilation_unit_dir(src, dir_of(path));
    znc_configure_script_unit(&unit, path);
    if (znc_validate_script_defaults(path, unit) != 0) { return 1; }
    let decls: ArrayList[*Node] = unit.decls;
    lo_operators(decls);
    let aerrs: i32 = znc_check_arity(decls);
    if (aerrs > 0) {
        _zag_println("znc: arity check FAILED");
        return 1;
    }
    let derrs: i32 = znc_check_dups(decls);
    if (derrs > 0) {
        _zag_println("znc: duplicate-definition check FAILED");
        return 1;
    }
    if (typed_check_program(decls, path) > 0) { return 1; }
    let eff: map__StringMap[i32] = analyze(decls);
    let viols: i32 = report_violations(decls, eff, src, path);
    if (viols > 0) {
        _zag_println("znc: capability check FAILED");
        return 1;
    }
    if (run_analyzer(decls, path) != 0) { return 1; }
    znc_publish_semantics(path,src,unit,decls,eff);
    return 0;
}

fn build_gpu(path: []u8, target: []u8) i32 {
    let src: []u8 = _zag_read_file(path);
    if (src.len < 0) { _zag_print("znc: cannot read "); _zag_println(path); return 1; }
    if (znc_check_src(path, src) != 0) { return 1; }
    let mbuf: ArrayList[u8] = emit_mlir_dir(src, dir_of(path), target);
    let mpath: []u8 = _zag_str_concat(stem_of(path), ".mlir");
    if (_zag_write_file(mpath, mbuf.data[0..mbuf.len]) != 0) {
        _zag_println("znc: failed to write MLIR");
        return 1;
    }
    _zag_print("znc: [gpu-");
    _zag_print(target);
    _zag_print("] wrote MLIR ");
    _zag_println(mpath);
    return 0;
}

fn build_gfx1010(path: []u8) i32 {
    let src: []u8 = _zag_read_file(path);
    if (src.len < 0) { _zag_print("znc: cannot read "); _zag_println(path); return 1; }
    if (znc_check_src(path, src) != 0) { return 1; }
    let errors: i32 = 0;
    let bundle: ArrayList[u8] = emit_gfx1010_bundle(src, dir_of(path), &errors);
    if (errors != 0) { return 1; }
    let out: []u8 = out_flag();
    if (out.len == 0) { out = _zag_str_concat(stem_of(path), ".zgk"); }
    if (_zag_write_file(out, bundle.data[0..bundle.len]) != 0) {
        _zag_println("znc: failed to write gfx1010 kernel bundle"); return 1;
    }
    _zag_print("znc: [amdgpu-gfx1010] wrote validated kernel bundle ");
    _zag_println(out);
    return 0;
}

fn build_arm64(path: []u8) i32 {
    let src: []u8 = _zag_read_file(path);
    if (src.len < 0) { _zag_print("znc: cannot read "); _zag_println(path); return 1; }
    if (znc_check_src(path, src) != 0) { return 1; }

    let decls: ArrayList[*Node] = parse_program_dir(src, dir_of(path));
    lo_operators(decls);

    let link_libs: ArrayList[[]u8] = make[[]u8](4);
    let code_decls: ArrayList[*Node] = znc_collect_links(decls, &link_libs);

    let nerr: i32 = 0;
    let data: ArrayList[u8] = make[u8](16);
    let prog: ArrayList[AInstr] = aload_program(code_decls, &nerr, &data);
    if (nerr > 0) {
        _zag_println("znc: build aborted — unsupported constructs (see messages above)");
        return 1;
    }
    let code: ArrayList[u8] = aencode(prog);

    let out: []u8 = out_flag();
    if (out.len == 0) { out = default_out(path); }

    let rc: i32 = write_elf_arm64_data(out, code, 0, data);
    if (rc != 0) { _zag_println("znc: failed to write executable"); return 1; }
    _zag_print("znc: [arm64] wrote native binary ");
    _zag_print(out);
    _zag_print(" (");
    _zag_print(_zag_i64_to_str(code.len as i64));
    _zag_print(" bytes text, ");
    _zag_print(_zag_i64_to_str(data.len as i64));
    _zag_println(" bytes data, 0 external tools)");

    if (has_flag("--run") == 1) {
        let runcmd: []u8 = _zag_str_concat("qemu-aarch64-static ", out);
        let ec: i32 = _zag_exec_cmd(runcmd);
        _zag_print("znc: qemu exited ");
        _zag_println(_zag_i64_to_str(ec as i64));
    }
    return 0;
}

fn build_wasm(path: []u8) i32 {
    let src: []u8 = _zag_read_file(path);
    if (src.len < 0) { _zag_print("znc: cannot read "); _zag_println(path); return 1; }
    if (znc_check_src(path, src) != 0) { return 1; }
    let wbuf: ArrayList[u8] = emit_wasm_dir(src, dir_of(path));
    let out: []u8 = out_flag();
    if (out.len == 0) { out = _zag_str_concat(stem_of(path), ".wasm"); }
    if (_zag_write_file(out, wbuf.data[0..wbuf.len]) != 0) {
        _zag_println("znc: failed to write WASM");
        return 1;
    }
    _zag_print("znc: [wasm] wrote WASM ");
    _zag_println(out);
    if (has_flag("--run") == 1) {
        _zag_eprintln("E0800: WASM execution requires a pure-Zag runtime, which is not implemented");
        _zag_eprintln("note: the .wasm artifact was emitted, but no external runtime was invoked");
        return 1;
    }
    return 0;
}

// ── static analyzer (analyze.zag) driver glue ────────────────────────────────
// The leak + efficiency analyzer runs by default on every build/check.
//   --no-analyze       turn the analyzer off entirely
//   --analyze-strict   treat findings as errors (fail the build)
//   --analyze-pedantic also emit strength-reduction hints (E0103)
fn analysis_enabled() i32 {
    if (has_flag("--no-analyze") == 1) { return 0; }
    return 1;
}
fn analysis_pedantic() i32 { return has_flag("--analyze-pedantic"); }

// Run the analyzer (if enabled) and print a one-line summary. Returns 1 only
// when findings exist AND --analyze-strict was passed (so the caller aborts).
fn run_analyzer(decls: ArrayList[*Node], path: []u8) i32 {
    if (analysis_enabled() == 0) { return 0; }
    let issues: i32 = run_analysis(decls, path, analysis_pedantic());
    if (issues > 0) {
        let n: []u8 = _zag_i64_to_str(issues as i64);
        if (has_flag("--analyze-strict") == 1) {
            _zag_eprintln(_zag_str_concat("znc: analyzer found ", _zag_str_concat(n, " issue(s) — build FAILED (--analyze-strict)")));
            return 1;
        }
        _zag_eprintln(_zag_str_concat("znc: analyzer found ", _zag_str_concat(n, " issue(s) (warnings above; use --analyze-strict to fail the build, --no-analyze to silence)")));
    }
    return 0;
}

// Is `name` present anywhere in argv?
fn has_flag(name: []u8) i32 {
    let i: i32 = 0;
    while (i < _zag_argc()) {
        if (@strEq(_zag_arg(i), name)) { return 1; }
        i = i + 1;
    }
    return 0;
}

// First non-flag argument (the source path). Skips the optional `build`
// subcommand word so both `znc foo.zag` and `znc build --hot foo.zag` work.
fn src_arg() []u8 {
    let i: i32 = 1;
    while (i < _zag_argc()) {
        let a: []u8 = _zag_arg(i);
        if (@strEq(a, "-o") || @strEq(a, "-l") || @strEq(a, "-L") ||
            @strEq(a, "--cpu") || @strEq(a, "--target") || @strEq(a, "--needed") ||
            @strEq(a, "--format") || @strEq(a, "--output")) {
            i = i + 2;
            continue;
        }
        if (a.len > 0) {
            if (a[0] != '-' && @strEq(a, "build") == 0 &&
                @strEq(a, "script") == 0 && @strEq(a, "explain") == 0 &&
                @strEq(a, "harden") == 0 && @strEq(a, "check") == 0) { return a; }
        }
        i = i + 1;
    }
    return "";
}

// True only when the first non-comment token is exactly `script;`.
fn source_starts_script(src: []u8) i32 {
    let i: i32 = 0;
    let scanning: i32 = 1;
    while (scanning == 1 && i < src.len) {
        while (i < src.len && (src[i] == ' ' || src[i] == '\n' || src[i] == '\r' || src[i] == '\t')) { i = i + 1; }
        if (i + 1 < src.len && src[i] == '/' && src[i + 1] == '/') {
            i = i + 2; while (i < src.len && src[i] != '\n') { i = i + 1; }
        } else if (i + 1 < src.len && src[i] == '/' && src[i + 1] == '*') {
            i = i + 2;
            while (i + 1 < src.len && !(src[i] == '*' && src[i + 1] == '/')) { i = i + 1; }
            if (i + 1 < src.len) { i = i + 2; }
        } else { scanning = 0; }
    }
    if (i + 6 >= src.len) { return 0; }
    if (src[i] == 's' && src[i + 1] == 'c' && src[i + 2] == 'r' &&
        src[i + 3] == 'i' && src[i + 4] == 'p' && src[i + 5] == 't' && src[i + 6] == ';') { return 1; }
    return 0;
}

fn flag_value(name: []u8) []u8 {
    let i: i32 = 1;
    while (i < _zag_argc()) {
        if (@strEq(_zag_arg(i), name) && i + 1 < _zag_argc()) { return _zag_arg(i + 1); }
        i = i + 1;
    }
    return "";
}

fn cpu_flag_value() []u8 {
    let paired: []u8 = flag_value("--cpu");
    if (paired.len > 0) { return paired; }
    let i: i32 = 1;
    while (i < _zag_argc()) {
        let a: []u8 = _zag_arg(i);
        if (a.len > 6 && a[0] == '-' && a[1] == '-' && a[2] == 'c' &&
            a[3] == 'p' && a[4] == 'u' && a[5] == '=') { return a[6..]; }
        i = i + 1;
    }
    return "generic";
}

fn cpu_flag_explicit() i32 {
    if (flag_value("--cpu").len > 0) { return 1; }
    let i: i32 = 1;
    while (i < _zag_argc()) {
        let a: []u8 = _zag_arg(i);
        if (a.len > 6 && starts_with(a, "--cpu=")) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn znc_script_explicit_choices() PlannerChoices {
    let input:PlannerChoices=planner_empty_choices();
    let allocator:[]u8=flag_value("--script-allocator");
    let device:[]u8=flag_value("--device");
    let layout:[]u8=flag_value("--layout");
    if(allocator.len>0){input.allocator=allocator;input.allocator_explicit=1;}
    if(device.len>0){input.device=device;input.device_explicit=1;}
    if(layout.len>0){input.layout=layout;input.layout_explicit=1;}
    if(cpu_flag_explicit()==1){input.cpu=cpu_flag_value();input.cpu_explicit=1;}
    return input;
}

// Script may inherit a project CPU default. A command-line CPU request is an
// explicit choice and always wins. Regular Zag never inherits Script defaults.
fn znc_effective_cpu(path: []u8, script_profile: i32) []u8 {
    if (cpu_flag_explicit() == 1 || script_profile == 0) { return cpu_flag_value(); }
    return znc_project_config(znc_project_root(dir_of(path)), 0).default_cpu;
}

fn validate_x86_cpu_flag() i32 {
    let p: X86CpuProfile = parse_x86_cpu_profile(cpu_flag_value());
    if (p.valid == 0) {
        _zag_eprintln(_zag_str_concat("znc: ", p.diagnostic));
        return 1;
    }
    return 0;
}

// Native output is currently Linux ELF64 x86-64 only.  Rejecting unsupported
// target spellings here is essential: silently producing ELF64 for `i686`
// would make pointer width and ABI claims that the compiler cannot satisfy.
fn validate_x86_target_flag() i32 {
    let target: []u8 = flag_value("--target");
    let i: i32 = 1;
    let inline_target: []u8 = "";
    while (i < _zag_argc()) {
        let a: []u8 = _zag_arg(i);
        if (starts_with(a, "--target=") == 1) { inline_target = a[9..]; }
        i = i + 1;
    }
    let selected: []u8 = target;
    if (inline_target.len > 0) { selected = inline_target; }
    if (selected.len == 0 || @strEq(selected, "x86_64") ||
        @strEq(selected, "x86-64") || @strEq(selected, "linux-x86_64")) { return 0; }
    if (@strEq(selected, "i686") || @strEq(selected, "x86") ||
        @strEq(selected, "linux-i686")) {
        _zag_eprintln("znc: i686 is not implemented: ELF32, 32-bit pointers, i386 ABI, register allocation, and Linux syscalls remain required");
        return 1;
    }
    _zag_eprintln(_zag_str_concat("znc: unsupported target: ", selected));
    return 1;
}

// The value following `-o`, else "".
fn out_flag() []u8 {
    let i: i32 = 1;
    while (i < _zag_argc()) {
        if (@strEq(_zag_arg(i), "-o")) {
            if (i + 1 < _zag_argc()) { return _zag_arg(i + 1); }
        }
        i = i + 1;
    }
    return "";
}

// Default output path: strip a trailing extension ("foo.zag" -> "foo"),
// else append ".out".
fn default_out(path: []u8) []u8 {
    let dot: i32 = 0 - 1;
    let i: i32 = 0;
    while (i < path.len) {
        if (path[i] == '.') { dot = i; }
        i = i + 1;
    }
    if (dot > 0) { return path[0..dot]; }
    return _zag_str_concat(path, ".out");
}

fn znc_fmt(fpath: []u8, in_place: i32) i32 {
    if (fpath.len == 0) { _zag_println("znc fmt: no source file"); return 1; }
    let src: []u8 = _zag_read_file(fpath);
    if (src.len < 0) {
        _zag_print("znc fmt: cannot read ");
        _zag_println(fpath);
        return 1;
    }
    let formatted: ArrayList[u8] = fmt_program(src);
    if (in_place == 1) {
        let wrc: i32 = _zag_write_file(fpath, formatted.data[0..formatted.len]);
        if (wrc != 0) { _zag_println("znc fmt: write failed"); return 1; }
        _zag_print("znc fmt: formatted ");
        _zag_println(fpath);
    } else {
        _zag_print(formatted.data[0..formatted.len]);
    }
    return 0;
}

fn znc_emit_total_cex(decls: ArrayList[*Node], eff: map__StringMap[i32]) void {
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                if (f.is_extern == 0 && has_annot(f.annots, "@total") == 1 && fn_total_safe(f, eff) == 0) {
                    let tout: SmtOutcome = smt_prove_fn(f);
                    if (tout.rc == 1 && tout.cex.len > 0) { _zag_println(tout.cex); }
                }
            }
            else => { }
        }
        i = i + 1;
    }
}

fn znc_check(path: []u8) i32 {
    if (path.len == 0) { _zag_println("znc: no source file"); return 1; }
    let src: []u8 = _zag_read_file(path);
    if (src.len < 0) { _zag_print("znc: cannot read "); _zag_println(path); return 1; }
    if (v2_validate_source(path, src) != 0) { return 1; }
    let unit: CompilationUnit = parse_compilation_unit_dir(src, dir_of(path));
    znc_configure_script_unit(&unit, path);
    if (has_flag("--strict") == 1 && unit.profile == ModuleProfile.script) {
        _zag_eprintln("znc: strict check FAILED: generated script entry point remains implicit");
        _zag_eprintln("unresolved: implicit bounded process-lifetime allocator remains");
        if (znc_contains(src, "read_file(") == 1 || znc_contains(src, "write_file(") == 1) {
            _zag_eprintln("unresolved: filesystem capability has no explicit policy");
        }
        if (znc_contains(src, "script_alloc(") == 1) {
            _zag_eprintln("unresolved: temporary allocation remains tied to the script context");
        }
        _zag_eprintln("note: run `znc explain <file>` and `znc harden <file>` before promotion to strict Zag");
        return 1;
    }
    let decls: ArrayList[*Node] = unit.decls;
    lo_operators(decls);
    let eff: map__StringMap[i32] = analyze(decls);
    let viols: i32 = report_violations(decls, eff, src, path);
    if (viols > 0) {
        znc_emit_total_cex(decls, eff);
        _zag_println("znc: capability check FAILED");
        return 1;
    }
    smt_report_proofs(decls, eff);
    if (run_analyzer(decls, path) != 0) { return 1; }
    znc_publish_semantics(path,src,unit,decls,eff);
    _zag_println("znc: OK — all capability claims proven");
    return 0;
}

fn znc_explain(path: []u8) i32 {
    if (path.len == 0) { _zag_eprintln("znc explain: no source file"); return 1; }
    let src: []u8 = _zag_read_file(path);
    if (src.len < 0) { _zag_eprintln("znc explain: cannot read source file"); return 1; }
    if (v2_validate_source(path, src) != 0) { return 1; }
    let unit: CompilationUnit = parse_compilation_unit_dir(src, dir_of(path));
    znc_configure_script_unit(&unit, path);
    let config: PlannerConfig = znc_project_config(znc_project_root(dir_of(path)), 0);
    let scripted: i32 = 0;
    if (unit.profile == ModuleProfile.script) { scripted = 1; }
    let planner_input: PlannerChoices = znc_script_explicit_choices();
    let resolution: PlannerResolution = planner_resolve(scripted, src, config, planner_input, 0);
    let format: []u8 = flag_value("--format");
    if (format.len > 0 && @strEq(format, "text") == 0 && @strEq(format, "json") == 0) {
        _zag_eprintln("znc explain: --format must be text or json"); return 1;
    }
    let json: i32 = 0;
    if (@strEq(format, "json")) { json = 1; }
    if (json == 1) {
        if (scripted == 1) {
            let prefix: []u8 = "{\"schema_version\":1,\"profile\":{\"value\":\"script\",\"basis\":\"proven\"},\"entry_point\":{\"value\":\"compiler-generated managed wrapper\",\"basis\":\"derived\"},\"allocator\":{\"value\":\"script_process_arena\",\"basis\":\"derived\"},\"script_memory_bytes\":{\"value\":";
            let suffix: []u8 = ",\"basis\":\"derived\"},\"error_boundary\":{\"value\":\"numeric-code diagnostic and nonzero exit\",\"basis\":\"derived\"},\"prelude\":{\"value\":[\"print\",\"println\",\"read_file\",\"write_file\",\"args_len\",\"arg\",\"string_concat\",\"string_builder\",\"list\",\"process_run_timeout\",\"script_alloc\",\"script_alloc_used\"],\"basis\":\"proven\"},\"capabilities\":{\"filesystem\":\"derived from calls\",\"process\":\"bounded shell execution when called\",\"network\":\"unsupported\",\"device\":\"cpu\"},\"effects\":{\"value\":\"function effects analyzed during check; per-expression witnesses unavailable\",\"basis\":\"derived\"},\"hidden_allocations\":{\"value\":\"script lists, string_concat, read_file results, bounded process setup/capture/results, script_alloc payloads, and fixed builder capacity are charged; ordinary make/new remain outside the script budget\",\"basis\":\"proven\"},\"execution_plan\":{\"value\":\"generic x86-64-v1 CPU\",\"basis\":\"derived\"},\"unresolved\":[\"per-expression type witnesses\",\"ordinary make/new accounting\",\"automatic reclamation\"],\"source_changes\":false}";
            _zag_println(_zag_str_concat(prefix, _zag_str_concat(_zag_i64_to_str(config.script_memory_bytes), suffix)));
        } else {
            _zag_println("{\"schema_version\":1,\"profile\":{\"value\":\"strict\",\"basis\":\"proven\"},\"entry_point\":{\"value\":\"user-defined\",\"basis\":\"derived\"},\"allocator\":{\"value\":\"no script default\",\"basis\":\"proven\"},\"effects\":{\"value\":\"not yet reported per expression\",\"basis\":\"unknown\"},\"execution_plan\":{\"value\":\"generic x86-64-v1\",\"basis\":\"derived\"}}");
        }
        return 0;
    }
    _zag_print("profile: "); if (scripted == 1) { _zag_println("script [proven]"); } else { _zag_println("strict [proven]"); }
    if (scripted == 1) {
        _zag_println("entry point: compiler-generated managed wrapper; top-level statements run in source order [derived]");
        _zag_print("allocator: script_process_arena requested-payload budget ");
        _zag_print(_zag_i64_to_str(config.script_memory_bytes));
        _zag_println(" bytes; root new, read_file results, and bounded process allocations are charged; ordinary make and allocator metadata remain outside [derived]");
        _zag_println("implicit error boundary: numeric error code + root-operation diagnostic, then nonzero exit [derived]");
        _zag_println("prelude: print, println, read_file, write_file, args_len, arg, string_concat, string_builder, list, process_run_timeout, script_alloc, script_alloc_used [proven]");
        if (znc_contains(src, "read_file(") == 1 || znc_contains(src, "write_file(") == 1) { _zag_println("filesystem capability: used without an explicit policy [derived]"); }
        else { _zag_println("filesystem capability: no prelude file call found [derived]"); }
        if (znc_contains(src, "process_run_timeout(") == 1) { _zag_println("process capability: bounded shell execution with explicit timeout/output cap [derived]"); }
        else { _zag_println("process capability: no bounded process call found [derived]"); }
        _zag_println("network capability: no Script prelude API implemented [proven]");
    } else {
        _zag_println("entry point: user-defined; no script wrapper [derived]");
        _zag_println("allocator: no script default [proven]");
    }
    _zag_println("function effects: analyzed by check; per-expression type/effect witnesses unavailable [derived]");
    _zag_println("hidden allocation: root new, string_concat/list/builder/read_file results and bounded process allocations use script accounting; ordinary make remains outside [proven]");
    _zag_println("unresolved: per-expression type witnesses, ordinary make accounting, automatic reclamation [unknown]");
    if (scripted == 1) {
        _zag_print("execution plan: cpu="); _zag_print(resolution.choices.cpu);
        _zag_print(", device="); _zag_print(resolution.choices.device);
        _zag_print(", layout="); _zag_print(resolution.choices.layout);
        _zag_println(" [derived from project config unless explicit]");
    } else { _zag_println("execution plan: generic x86-64-v1 baseline [derived]"); }
    return 0;
}

fn znc_harden_space(src: []u8, start: i32) i32 {
    let i: i32 = start;
    while (i < src.len) {
        if (src[i] == ' ' || src[i] == '\t' || src[i] == '\r' || src[i] == '\n') { i = i + 1; }
        else if (i + 1 < src.len && src[i] == '/' && src[i + 1] == '/') {
            i = i + 2; while (i < src.len && src[i] != '\n') { i = i + 1; }
        } else { return i; }
    }
    return i;
}

fn znc_harden_decl_start(src: []u8, at: i32) i32 {
    let rest: []u8 = src[at..src.len];
    if (starts_with(rest, "fn ") || starts_with(rest, "pub fn ") ||
        starts_with(rest, "struct ") || starts_with(rest, "pub struct ") ||
        starts_with(rest, "enum ") || starts_with(rest, "pub enum ") ||
        starts_with(rest, "union ") || starts_with(rest, "pub union ") ||
        starts_with(rest, "error ") || starts_with(rest, "const ") ||
        starts_with(rest, "interface ") || starts_with(rest, "operator ") ||
        starts_with(rest, "extern fn ") || starts_with(rest, "@import")) { return 1; }
    return 0;
}

// Return one complete top-level declaration boundary. Strings and line comments
// do not contribute braces. A semicolon terminates imports, constants, and
// prototypes; a balanced outer brace terminates definition declarations.
fn znc_harden_decl_end(src: []u8, start: i32) i32 {
    let i: i32 = start;
    let depth: i32 = 0;
    let saw_brace: i32 = 0;
    let in_string: i32 = 0;
    while (i < src.len) {
        if (in_string == 1) {
            if (src[i] == '\\' && i + 1 < src.len) { i = i + 2; }
            else { if (src[i] == '"') { in_string = 0; } i = i + 1; }
        } else if (src[i] == '"') { in_string = 1; i = i + 1; }
        else if (i + 1 < src.len && src[i] == '/' && src[i + 1] == '/') {
            i = i + 2; while (i < src.len && src[i] != '\n') { i = i + 1; }
        } else {
            if (src[i] == '{') { depth = depth + 1; saw_brace = 1; }
            else if (src[i] == '}') {
                depth = depth - 1;
                if (saw_brace == 1 && depth == 0) { return i + 1; }
            } else if (src[i] == ';' && saw_brace == 0) { return i + 1; }
            i = i + 1;
        }
    }
    return 0 - 1;
}

fn znc_harden(path: []u8) i32 {
    if (path.len == 0) { _zag_eprintln("znc harden: no source file"); return 1; }
    let src: []u8 = _zag_read_file(path);
    if (src.len < 0) { _zag_eprintln("znc harden: cannot read source file"); return 1; }
    let unit: CompilationUnit = parse_compilation_unit_dir(src, dir_of(path));
    if (unit.profile != ModuleProfile.script) {
        _zag_eprintln("znc harden: source is already regular Zag; no script profile to expand");
        return 1;
    }
    let marker: i32 = -1;
    let i: i32 = 0;
    while (i + 7 <= src.len && marker < 0) {
        if (src[i] == 's' && @strEq(src[i..i + 7], "script;")) { marker = i; }
        i = i + 1;
    }
    if (marker < 0) { _zag_eprintln("znc harden: script marker not found"); return 1; }
    let cursor: i32 = marker + 7;
    let declarations: []u8 = "";
    let body_start: i32 = cursor;
    let scanning: i32 = 1;
    while (scanning == 1) {
        let decl_start: i32 = znc_harden_space(src, cursor);
        if (decl_start < src.len && znc_harden_decl_start(src, decl_start) == 1) {
            let decl_end: i32 = znc_harden_decl_end(src, decl_start);
            if (decl_end < 0) { _zag_eprintln("znc harden: unterminated declaration"); return 1; }
            declarations = _zag_str_concat(declarations, src[cursor..decl_end]);
            cursor = decl_end; body_start = cursor;
        } else { body_start = cursor; scanning = 0; }
    }
    // Moving declarations that occur after execution could reorder observable
    // initialization. Reject them instead of guessing.
    let later: i32 = znc_harden_space(src, body_start);
    let line: i32 = later;
    while (line < src.len) {
        if ((line == 0 || src[line - 1] == '\n') && znc_harden_decl_start(src, znc_harden_space(src, line)) == 1) {
            _zag_eprintln("znc harden: declaration after executable Script statement requires manual placement");
            return 1;
        }
        while (line < src.len && src[line] != '\n') { line = line + 1; }
        if (line < src.len) { line = line + 1; }
    }
    let candidate: []u8 = _zag_str_concat(src[0..marker], _zag_str_concat(declarations,
        _zag_str_concat("\nfn main() i32 {\n", _zag_str_concat(src[body_start..src.len], "\n}\n"))));
    let output: []u8 = flag_value("--output");
    if (output.len > 0) {
        if (_zag_write_file(output, candidate) != 0) { _zag_eprintln("znc harden: failed to write candidate"); return 1; }
        _zag_println(_zag_str_concat("harden candidate written: ", output));
    } else {
        _zag_print(candidate);
    }
    _zag_println("harden report: conservative statement-only expansion");
    _zag_println("assumptions: top-level return becomes process exit; native primitives remain explicit ordinary Zag declarations");
    _zag_println("tests required: stdout/stderr and exit parity; filesystem failure; allocation-limit behavior");
    _zag_println("unsupported conversions: declarations/imports, implicit allocator expansion, capability policy synthesis");
    return 0;
}

fn znc_init() i32 {
    let modpath: []u8 = "zag.mod";
    if (_zag_file_exists(modpath) != 0) {
        _zag_println("znc init: zag.mod already exists");
        return 1;
    }
    let content: []u8 = "name = \"myproject\"\nversion = \"2026.07.0-dev\"\nedition = \"2026\"\n";
    let wrc: i32 = _zag_write_file(modpath, content);
    if (wrc != 0) { _zag_println("znc init: failed to write zag.mod"); return 1; }
    _zag_println("znc init: created zag.mod");
    return 0;
}

// First non-flag argv entry at or after `start` ("" if none).
fn first_nonflag_from(start: i32) []u8 {
    let i: i32 = start;
    while (i < _zag_argc()) {
        let a: []u8 = _zag_arg(i);
        if (a.len > 0 && a[0] != '-') { return a; }
        i = i + 1;
    }
    return "";
}

fn znc_parent_dir(path: []u8) []u8 {
    let end: i32 = path.len;
    while (end > 1 && path[end - 1] == '/') { end = end - 1; }
    let i: i32 = end - 1;
    while (i >= 0 && path[i] != '/') { i = i - 1; }
    if (i < 0) { return "."; }
    if (i == 0) { return "/"; }
    return path[0..i];
}

fn znc_cwd() []u8 {
    let buf: ArrayList[u8] = make[u8](4096);
    while (buf.len < 4096) { push[u8](&buf, 0 as u8); }
    let rc: i64 = _zag_raw_syscall(79, _zag_slice_ptr(buf.data[0..buf.len]) as i64, buf.len, 0, 0, 0, 0);
    if (rc <= 1) { return "."; }
    return buf.data[0..(rc as i32) - 1];
}

fn znc_absolute_dir(path: []u8) []u8 {
    if (path.len > 0 && path[0] == '/') { return path; }
    if (@strEq(path, ".")) { return znc_cwd(); }
    return _zag_str_concat(znc_cwd(), _zag_str_concat("/", path));
}

fn znc_project_root(start: []u8) []u8 {
    let cur: []u8 = znc_absolute_dir(start);
    let fallback: []u8 = cur;
    let steps: i32 = 0;
    while (steps < 64) {
        if (_zag_file_exists(_zag_str_concat(cur, "/zag.mod")) == 1) { return cur; }
        let parent: []u8 = znc_parent_dir(cur);
        if (@strEq(parent, cur)) { return fallback; }
        cur = parent;
        steps = steps + 1;
    }
    return fallback;
}

fn znc_project_relative(root:[]u8,path:[]u8)[]u8{
    let absolute:[]u8=path;if(path.len==0){return path;}if(path[0]!='/'){absolute=_zag_str_concat(znc_cwd(),_zag_str_concat("/",path));}
    if(absolute.len>root.len&&@strEq(absolute[0..root.len],root)&&absolute[root.len]=='/'){return absolute[root.len+1..];}
    return path;
}

fn znc_publish_semantics(path:[]u8,src:[]u8,unit:CompilationUnit,decls:ArrayList[*Node],eff:map__StringMap[i32])void{
    let root:[]u8=znc_project_root(dir_of(path));let module_path:[]u8=znc_project_relative(root,path);let _published:i32=semantic_manifest_publish(root,module_path,src,unit,eff);
}

fn znc_contains(haystack: []u8, needle: []u8) i32 {
    if (needle.len == 0 || needle.len > haystack.len) { return 0; }
    let i: i32 = 0;
    while (i + needle.len <= haystack.len) {
        let j: i32 = 0;
        let same: i32 = 1;
        while (j < needle.len) { if (haystack[i + j] != needle[j]) { same = 0; } j = j + 1; }
        if (same == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn znc_project_config(root: []u8, warn_invalid: i32) PlannerConfig {
    let cfg: []u8 = _zag_read_file(_zag_str_concat(root, "/.zagd.conf"));
    if (cfg.len < 0) { return planner_default_config(); }
    let parsed: PlannerConfig = planner_parse_config(cfg);
    if (parsed.valid == 0) {
        if (warn_invalid == 1) {
            _zag_eprintln(_zag_str_concat("znc: warning: ", _zag_str_concat(parsed.diagnostic, "; using documented defaults")));
        }
        return planner_default_config();
    }
    return parsed;
}

fn znc_project_mode(root: []u8) []u8 {
    let parsed: PlannerConfig = znc_project_config(root, 1);
    if (@strEq(parsed.mode, "advisory")) { return "light"; }
    return parsed.mode;
}

fn znc_configure_script_unit(unit: *CompilationUnit, path: []u8) void {
    if (unit.*.profile != ModuleProfile.script) { return; }
    let root: []u8 = znc_project_root(dir_of(path));
    let cfg: PlannerConfig = znc_project_config(root, 0);
    let input: PlannerChoices = znc_script_explicit_choices();
    let resolved: PlannerResolution = planner_resolve(1, "", cfg, input, 0);
    // These are the only runtime choices implemented today. Rejecting other
    // configured values happens in the foreground build before codegen.
    let _configured: i32 = compilation_unit_set_script_memory_limit(unit, cfg.script_memory_bytes);
    let _source_label: i32 = compilation_unit_set_script_source_label(unit, path);
}


fn znc_validate_script_defaults(path: []u8, unit: CompilationUnit) i32 {
    if (unit.profile != ModuleProfile.script) { return 0; }
    let cfg: PlannerConfig = znc_project_config(znc_project_root(dir_of(path)), 1);
    let input: PlannerChoices = znc_script_explicit_choices();
    let r: PlannerResolution = planner_resolve(1, "", cfg, input, 0);
    if (r.diagnostic.len > 0) { _zag_eprintln(r.diagnostic); return 1; }
    if (@strEq(r.choices.allocator, "script_process_arena") == 0 ||
        @strEq(r.choices.device, "cpu") == 0 ||
        @strEq(r.choices.layout, "compiler_owned") == 0) {
        _zag_eprintln("znc: unsupported Zag Script planner default; supported allocator=script_process_arena, device=cpu, layout=compiler_owned");
        return 1;
    }
    let p: X86CpuProfile = parse_x86_cpu_profile(r.choices.cpu);
    if (p.valid == 0) { _zag_eprintln(_zag_str_concat("znc: ", p.diagnostic)); return 1; }
    return 0;
}

fn znc_parse_pid(value: []u8) i64 {
    let result: i64 = 0;
    let i: i32 = 0;
    while (i < value.len && value[i] >= '0' && value[i] <= '9') {
        result = result * 10 + ((value[i] as i64) - 48);
        i = i + 1;
    }
    return result;
}

// POSIX-shell single quoting. Every embedded quote becomes '\''; paths never
// become shell syntax even though the existing process primitive invokes sh.
fn znc_shell_quote(value: []u8) []u8 {
    let out: []u8 = "'";
    let i: i32 = 0;
    while (i < value.len) {
        if (value[i] == '\'') { out = _zag_str_concat(out, "'\\''"); }
        else { out = _zag_str_concat(out, value[i..i + 1]); }
        i = i + 1;
    }
    return _zag_str_concat(out, "'");
}

fn znc_sibling_zagd() []u8 { return _zag_str_concat(dir_of(_zag_arg(0)), "/zagd"); }

fn znc_mode_arg() []u8 {
    let i: i32 = 2;
    while (i < _zag_argc()) {
        if (@strEq(_zag_arg(i), "--mode")) {
            if (i + 1 >= _zag_argc()) { return ""; }
            return _zag_arg(i + 1);
        }
        i = i + 1;
    }
    return "light";
}

fn znc_valid_zagd_mode(mode: []u8) i32 {
    if (@strEq(mode, "off") || @strEq(mode, "light") ||
        @strEq(mode, "adaptive") || @strEq(mode, "deep")) { return 1; }
    return 0;
}

fn znc_zagd_exec_config(root: []u8, root_source:[]u8, mode: []u8, cfg: PlannerConfig, daemonize: i32) i32 {
    let binary: []u8 = znc_sibling_zagd();
    if (_zag_file_exists(binary) == 0) { return 127; }
    let command: []u8 = znc_shell_quote(binary);
    command=_zag_str_concat(command,_zag_str_concat(" --root ",znc_shell_quote(root)));
    if(root_source.len>0){command=_zag_str_concat(command,_zag_str_concat(" --root-source ",znc_shell_quote(root_source)));}
    command=_zag_str_concat(command,_zag_str_concat(" --mode ",znc_shell_quote(mode)));
    command=_zag_str_concat(command,_zag_str_concat(" --window-ms ",_zag_i64_to_str(cfg.stability_window_ms)));
    command=_zag_str_concat(command,_zag_str_concat(" --max-cache-bytes ",_zag_i64_to_str(cfg.max_cache_bytes)));
    command=_zag_str_concat(command,_zag_str_concat(" --max-workers ",_zag_i64_to_str(cfg.max_workers as i64)));
    command=_zag_str_concat(command,_zag_str_concat(" --notifications ",znc_shell_quote(cfg.notifications)));
    if (daemonize == 1) { command = _zag_str_concat(command, " --daemonize >/dev/null 2>/dev/null"); }
    return _zag_exec_cmd(command);
}

fn znc_zagd_exec(root: []u8, mode: []u8, window_ms: i64, daemonize: i32) i32 {
    let cfg:PlannerConfig=znc_project_config(root,0);cfg.stability_window_ms=window_ms;
    return znc_zagd_exec_config(root,"",mode,cfg,daemonize);
}

fn znc_zagd_lock_alive(root: []u8) i32 {
    let lock_pid: i64 = znc_parse_pid(_zag_read_file(_zag_str_concat(root, "/.zagd.lock")));
    if (lock_pid < 2) { return 0; }
    let probe: i64 = _zag_raw_syscall(62, lock_pid, 0, 0, 0, 0, 0);
    // ESRCH (-3) proves the process is gone. EPERM still proves it exists.
    if (probe == (0 - 3)) { return 0; }
    return 1;
}

fn znc_zagd_ensure(root: []u8, root_source:[]u8) void {
    // Foreground correctness and release-authority checks can opt out for one
    // invocation. Project policy remains unchanged and the next normal source
    // command resumes automatic monitoring.
    if (has_flag("--no-zagd") == 1) { return; }
    if(root_source.len>0){let _root_write:i32=_zag_write_file(_zag_str_concat(root,"/.zagd.root-source"),_zag_str_concat(root_source,"\n"));}
    let config: PlannerConfig = znc_project_config(root, 1);
    let mode: []u8 = config.mode;
    if (@strEq(mode, "advisory")) { mode = "light"; }
    let lock_path: []u8 = _zag_str_concat(root, "/.zagd.lock");
    let alive: i32 = znc_zagd_lock_alive(root);
    if (@strEq(mode, "off")) {
        if (alive == 1) {
            let stopped: i32 = znc_zagd_exec(root, "off", config.stability_window_ms, 0);
            if (stopped != 0) {
                _zag_eprintln("znc: warning: could not stop zagd requested by mode=off; foreground compilation continues");
            }
        }
        return;
    }
    if (alive == 1) {
        let status: []u8 = _zag_read_file(_zag_str_concat(root, "/.zagd.status"));
        if (znc_contains(status, _zag_str_concat("mode=", _zag_str_concat(mode, "\n")))) { return; }
        let stopped: i32 = znc_zagd_exec(root, "off", config.stability_window_ms, 0);
        if (stopped != 0) {
            _zag_eprintln("znc: warning: could not change zagd mode; foreground compilation continues");
            return;
        }
    }
    let rc: i32 = znc_zagd_exec_config(root, root_source, mode, config, 1);
    if (rc != 0 && rc != 6) {
        _zag_eprintln("znc: warning: zagd unavailable; foreground compilation continues without background planning");
    }
}

fn znc_output_format() i32 {
    let i: i32 = 2;
    while (i < _zag_argc()) {
        if (@strEq(_zag_arg(i), "--format")) {
            if (i + 1 >= _zag_argc()) { return 0 - 1; }
            if (@strEq(_zag_arg(i + 1), "text")) { return 0; }
            if (@strEq(_zag_arg(i + 1), "json")) { return 1; }
            return 0 - 1;
        }
        i = i + 1;
    }
    return 0;
}

fn znc_json_escape(value: []u8) []u8 {
    let out: []u8 = "";
    let i: i32 = 0;
    while (i < value.len) {
        if (value[i] == '"') { out = _zag_str_concat(out, "\\\""); }
        else if (value[i] == '\\') { out = _zag_str_concat(out, "\\\\"); }
        else if (value[i] == '\n') { out = _zag_str_concat(out, "\\n"); }
        else { out = _zag_str_concat(out, value[i..i + 1]); }
        i = i + 1;
    }
    return out;
}

fn znc_watch() i32 {
    let root_source:[]u8="";let wi:i32=2;
    while(wi<_zag_argc()){
        let wa:[]u8=_zag_arg(wi);
        if((@strEq(wa,"--mode")||@strEq(wa,"--root-source"))&&wi+1<_zag_argc()){if(@strEq(wa,"--root-source")){root_source=_zag_arg(wi+1);}wi=wi+2;}
        else{if(wa.len>0&&wa[0]!='-'&&root_source.len==0){root_source=wa;}wi=wi+1;}
    }
    let root_base:[]u8=".";if(root_source.len>0){root_base=dir_of(root_source);}
    let root: []u8 = znc_project_root(root_base);
    if(root_source.len==0){if(_zag_file_exists(_zag_str_concat(root,"/main.zag"))==1){root_source="main.zag";}else if(_zag_file_exists(_zag_str_concat(root,"/app.zag"))==1){root_source="app.zag";}}
    let mode: []u8 = znc_mode_arg();
    if (znc_valid_zagd_mode(mode) == 0) {
        _zag_eprintln("znc watch: --mode must be off, light, adaptive, or deep");
        return 2;
    }
    let config: PlannerConfig = znc_project_config(root, 1);
    if (@strEq(mode, "off")) { return znc_zagd_exec(root, "off", config.stability_window_ms, 0); }
    // A mode change is explicit and deterministic: stop the old singleton,
    // then start one replacement. No source is rewritten.
    if (_zag_file_exists(_zag_str_concat(root, "/.zagd.lock")) == 1) {
        let stopped: i32 = znc_zagd_exec(root, "off", config.stability_window_ms, 0);
        if (stopped != 0) { return stopped; }
    }
    if(root_source.len>0){let _root_write:i32=_zag_write_file(_zag_str_concat(root,"/.zagd.root-source"),_zag_str_concat(root_source,"\n"));}
    let rc: i32 = znc_zagd_exec_config(root, root_source, mode, config, 1);
    if (rc == 127) { _zag_eprintln("znc watch: sibling zagd executable is missing; run bootstrap.sh or make zagd"); }
    return rc;
}

fn znc_zagd_status() i32 {
    let root: []u8 = znc_project_root(".");
    let status: []u8 = _zag_read_file(_zag_str_concat(root, "/.zagd.status"));
    let active: i32 = znc_zagd_lock_alive(root);
    let json: i32 = znc_output_format();
    if (json < 0) { _zag_eprintln("znc status: --format must be text or json"); return 2; }
    if (status.len < 0) {
        if (json == 1) { _zag_println("{\"running\":false,\"status\":\"missing\"}"); }
        else { _zag_println("zagd status: not running (no status record)"); }
        return 1;
    }
    if (json == 1) {
        let running: []u8 = "false"; if (active == 1) { running = "true"; }
        _zag_println(_zag_str_concat("{\"running\":", _zag_str_concat(running,
            _zag_str_concat(",\"status_text\":\"", _zag_str_concat(znc_json_escape(status), "\"}")))));
    } else {
        if (active == 0) { _zag_println("zagd status: stale record; no active singleton lock"); }
        _zag_print(status);
    }
    if (active == 1) { return 0; }
    return 1;
}

fn znc_zagd_shutdown() i32 {
    let root: []u8 = znc_project_root(".");
    let config: PlannerConfig = znc_project_config(root, 0);
    let rc: i32 = znc_zagd_exec(root, "off", config.stability_window_ms, 0);
    if (rc == 127) { _zag_eprintln("znc shutdown: sibling zagd executable is missing"); }
    return rc;
}

fn znc_zagd_suggest() i32 {
    let root: []u8 = znc_project_root(".");
    let status: []u8 = _zag_read_file(_zag_str_concat(root, "/.zagd.status"));
    let json: i32 = znc_output_format();
    if (json < 0) { _zag_eprintln("znc suggest: --format must be text or json"); return 2; }
    if (status.len < 0 || znc_zagd_lock_alive(root) == 0) {
        if (json == 1) { _zag_println("{\"advisory\":true,\"available\":false,\"source_changes\":false}"); }
        else { _zag_println("zagd suggest: no active snapshot; regular Zag remains unchanged"); }
        return 0;
    }
    if (json == 1) {
        _zag_println(_zag_str_concat("{\"advisory\":true,\"available\":true,\"source_changes\":false,\"recommendations\":[],\"status_text\":\"",
            _zag_str_concat(znc_json_escape(status), "\"}")));
        return 0;
    }
    _zag_println("zagd suggestion [advisory]: content hashing and change tracking are active; no source transformation or execution-plan recommendation is currently available");
    _zag_print(status);
    return 0;
}

// --hot build: record the code/data sizes for the hot-patch layout guard.
fn znc_write_hotlen(clen: i32, dlen: i32) void {
    let _a: i32 = _zag_write_file(".zag_hotlen", _zag_i64_to_str(clen as i64));
    let _b: i32 = _zag_write_file(".zag_hotdlen", _zag_i64_to_str(dlen as i64));
    _zag_println("znc: [--hot] recorded layout in .zag_hotlen — after edits run `znc hot-patch <src>`; the running program swaps it in live");
}

// `znc hot-patch <src>`: re-assemble the (edited) program and, if it keeps the
// same code+data layout as the --hot build, stage the new `.text` bytes in
// `.zag_hotpatch` for the running process to memcpy over its live code.
fn znc_hot_patch(path: []u8) i32 {
    if (path.len == 0) { _zag_println("znc hot-patch: no source file"); return 1; }
    let src: []u8 = _zag_read_file(path);
    if (src.len < 0) { _zag_print("znc hot-patch: cannot read "); _zag_println(path); return 1; }

    // Same front-end + codegen pipeline as the build path so that every
    // unchanged function assembles to byte-identical code at the same offset.
    let decls: ArrayList[*Node] = parse_program_dir(src, dir_of(path));
    lo_operators(decls);
    let link_libs: ArrayList[[]u8] = make[[]u8](4);
    let code_decls: ArrayList[*Node] = znc_collect_links(decls, &link_libs);
    let nerr: i32 = 0;
    let data: ArrayList[u8] = make[u8](16);
    let prog: ArrayList[Instr] = lower_program(code_decls, &nerr, &data);
    if (nerr > 0) { _zag_println("znc hot-patch: build failed — unsupported constructs (see messages above)"); return 1; }
    let code: ArrayList[u8] = encode(peephole(optimize(regalloc(prog))));

    // Layout guard: an in-place swap is only safe if the code (and the absolute-
    // addressed data blob) kept the same size as the running image.
    let want_c: []u8 = _zag_read_file(".zag_hotlen");
    if (want_c.len <= 0) {
        _zag_println("znc hot-patch: no .zag_hotlen found — build the program with `--hot` first");
        return 1;
    }
    let got_c: []u8 = _zag_i64_to_str(code.len as i64);
    if (@strEq(want_c, got_c) == 0) {
        _zag_println("znc hot-patch: edit changed the compiled code size — rebuild required (hot-patch only applies layout-preserving edits, e.g. changing a constant)");
        return 1;
    }
    let want_d: []u8 = _zag_read_file(".zag_hotdlen");
    let got_d: []u8 = _zag_i64_to_str(data.len as i64);
    if (want_d.len > 0 && @strEq(want_d, got_d) == 0) {
        _zag_println("znc hot-patch: edit changed the data/string layout — rebuild required");
        return 1;
    }

    let wrc: i32 = _zag_write_file(".zag_hotpatch", code.data[0..code.len]);
    if (wrc != 0) { _zag_println("znc hot-patch: failed to write .zag_hotpatch"); return 1; }
    _zag_print("znc hot-patch: staged ");
    _zag_print(got_c);
    _zag_println(" bytes → .zag_hotpatch (the running process swaps it in on its next zag_hot_wait())");
    return 0;
}

fn main() i32 {
    if (_zag_argc() < 2) {
        _zag_println("usage: znc <source.zag> [-o out] [-l lib] [-L path] [--run] [--debug]");
        _zag_println("       znc <source.zag> --dynamic --needed libNAME.so.N [-o out] [--run]");
        _zag_println("       znc <source.zag> --target gpu-nvidia|gpu-amd|gpu-vulkan|amdgpu-gfx1010");
        _zag_println("       znc <source.zag> --target wasm [-o out.wasm] [--run]");
        _zag_println("       znc <source.zag> --target arm64 [-o out] [--run]");
        _zag_println("       znc script <source.zag> [-o out] [--run]");
        _zag_println("       znc explain <source.zag> [--format text|json]");
        _zag_println("       znc harden <source.zag> [--output candidate.zag]");
        _zag_println("       znc check <source.zag> [--strict]");
        _zag_println("       znc watch [--mode off|light|adaptive|deep]");
        _zag_println("       znc status | shutdown | suggest");
        _zag_println("       znc [build] --hot <source.zag> [-o out]   (hot-reloadable build)");
        _zag_println("       znc hot-patch <source.zag>                (stage a live code patch)");
        _zag_println("       znc fmt [--in-place] <source.zag>");
        _zag_println("       znc init");
        _zag_println("       znc version");
        _zag_println("  analyzer (leak + efficiency lints) runs by default:");
        _zag_println("    --no-analyze        disable the analyzer");
        _zag_println("    --no-zagd           skip background planning for this invocation");
        _zag_println("    --analyze-strict    treat analyzer findings as errors");
        _zag_println("    --analyze-pedantic  also emit strength-reduction hints");
        _zag_println("  compiles Zag to native x86-64 ELF — dynamic mode still uses no cc/as/ld");
        return 1;
    }

    let cmd: []u8 = _zag_arg(1);
    if (@strEq(cmd, "version") || @strEq(cmd, "--version") || @strEq(cmd, "-v")) {
        _zag_print("znc ");
        _zag_print(zag_version());
        _zag_print(" (edition ");
        _zag_print(zag_edition());
        _zag_println(")");
        return 0;
    }
    if (@strEq(cmd, "fmt")) {
        let in_place: i32 = has_flag("--in-place");
        let fpath: []u8 = "";
        let fi: i32 = 2;
        let finding: i32 = 1;
        while (finding == 1 && fi < _zag_argc()) {
            let arg: []u8 = _zag_arg(fi);
            if (arg.len > 0 && arg[0] != '-') { fpath = arg; finding = 0; }
            else { fi = fi + 1; }
        }
        return znc_fmt(fpath, in_place);
    }
    if (@strEq(cmd, "init")) { return znc_init(); }
    if (@strEq(cmd, "watch")) { return znc_watch(); }
    if (@strEq(cmd, "status")) { return znc_zagd_status(); }
    if (@strEq(cmd, "shutdown")) { return znc_zagd_shutdown(); }
    if (@strEq(cmd, "suggest")) { return znc_zagd_suggest(); }
    if (@strEq(cmd, "hot-patch")) { return znc_hot_patch(first_nonflag_from(2)); }
    if (@strEq(cmd, "explain")) {
        let epath: []u8 = first_nonflag_from(2);
        if (epath.len > 0) { znc_zagd_ensure(znc_project_root(dir_of(epath)),epath); }
        return znc_explain(epath);
    }
    if (@strEq(cmd, "harden")) {
        let hpath: []u8 = first_nonflag_from(2);
        if (hpath.len > 0) { znc_zagd_ensure(znc_project_root(dir_of(hpath)),hpath); }
        return znc_harden(hpath);
    }
    if (@strEq(cmd, "check")) {
        if (v2_validate_options() != 0) { return 1; }
        let cpath: []u8 = "";
        if (_zag_argc() >= 3) { cpath = _zag_arg(2); }
        if (cpath.len > 0) { znc_zagd_ensure(znc_project_root(dir_of(cpath)),cpath); }
        return znc_check(cpath);
    }

    if (v2_validate_options() != 0) { return 1; }

    let path: []u8 = src_arg();
    if (path.len == 0) { _zag_println("znc: no source file"); return 1; }

    znc_zagd_ensure(znc_project_root(dir_of(path)),path);

    let gtarget: []u8 = gpu_target();
    if (gtarget.len > 0) { return build_gpu(path, gtarget); }
    if (gfx1010_target() == 1) { return build_gfx1010(path); }
    if (wasm_target() == 1) { return build_wasm(path); }
    if (arm64_target() == 1) { return build_arm64(path); }
    if (i686_target() == 1) { return build_i686_minimal(path); }

    if (validate_x86_target_flag() != 0) { return 1; }
    if (validate_x86_cpu_flag() != 0) { return 1; }

    let src: []u8 = _zag_read_file(path);
    if (src.len < 0) {
        _zag_print("znc: cannot read ");
        _zag_println(path);
        return 1;
    }

    // CLI activation is the same parser profile as an in-file `script;`
    // declaration. Prefixing is compilation-local and never rewrites source.
    if (@strEq(cmd, "script") && source_starts_script(src) == 0) { src = _zag_str_concat("script;\n", src); }

    if (v2_validate_source(path, src) != 0) { return 1; }

    // parse → apply configurable Script defaults → effect-check → lower → ELF
    let unit: CompilationUnit = parse_compilation_unit_dir(src, dir_of(path));
    znc_configure_script_unit(&unit, path);
    if (znc_validate_script_defaults(path, unit) != 0) { return 1; }
    let decls: ArrayList[*Node] = unit.decls;

    // Lower operator contracts (x + y → big_add(x, y)) so sema sees the real calls.
    lo_operators(decls);

    // Static call-arity check (also runs for arm64/wasm/gpu via znc_check_src).
    let aerrs: i32 = znc_check_arity(decls);
    if (aerrs > 0) {
        _zag_println("znc: arity check FAILED");
        return 1;
    }
    let derrs: i32 = znc_check_dups(decls);
    if (derrs > 0) {
        _zag_println("znc: duplicate-definition check FAILED");
        return 1;
    }

    // Native uses the same declared-type authority as ARM64, WASM, and GPU.
    // Reject before any backend can invent a layout for an unknown name.
    if (typed_check_program(decls, path) > 0) { return 1; }

    // Effect/capability check (sema.zag): reject @total/@realtime/@noalloc violations.
    let eff: map__StringMap[i32] = analyze(decls);
    let viols: i32 = report_violations(decls, eff, src, path);
    if (viols > 0) {
        znc_emit_total_cex(decls, eff);
        _zag_println("znc: capability check FAILED");
        return 1;
    }
    smt_report_proofs(decls, eff);

    // Leak + efficiency analysis (analyze.zag). On by default; --no-analyze to skip.
    if (run_analyzer(decls, path) != 0) { return 1; }
    znc_publish_semantics(path,src,unit,decls,eff);

    // Collect @link directives and strip them from decls before codegen.
    // (ncodegen pass-1 aborts on unknown top-level node kinds.)
    let link_libs: ArrayList[[]u8] = make[[]u8](4);
    let lib_paths: ArrayList[[]u8] = make[[]u8](4);
    let code_decls: ArrayList[*Node] = znc_collect_links(decls, &link_libs);

    // Also accept -l/-L flags and zag.mod deps.
    znc_argv_links(&link_libs);
    znc_argv_paths(&lib_paths);
    znc_load_zagmod(dir_of(path), &link_libs, &lib_paths);

    // Collect `extern fn` names — the symbols we need from static libraries.
    let extern_syms: ArrayList[[]u8] = collect_extern_syms(code_decls);
    let dynamic_mode: i32 = has_flag("--dynamic");
    let needed_libs: ArrayList[[]u8] = znc_needed_libs();
    if (dynamic_mode == 0 && needed_libs.len > 0) {
        _zag_eprintln("znc: --needed requires explicit --dynamic mode");
        return 1;
    }
    if (dynamic_mode == 1 && needed_libs.len == 0) {
        _zag_eprintln("znc: --dynamic requires at least one --needed SONAME");
        return 1;
    }
    if (dynamic_mode == 1 && link_libs.len > 0) {
        _zag_eprintln("znc: dynamic and static archive linking cannot be mixed yet");
        return 1;
    }
    if (dynamic_mode == 1 && (has_flag("--debug") == 1 || has_flag("--hot") == 1)) {
        _zag_eprintln("znc: --dynamic does not yet support --debug or --hot");
        return 1;
    }

    let nerr: i32 = 0;
    let data: ArrayList[u8] = make[u8](16);
    let selected_cpu:X86CpuProfile=parse_x86_cpu_profile(znc_effective_cpu(path, (unit.profile==ModuleProfile.script) as i32));
    let prog:  ArrayList[Instr] = lower_program_mode_cpu(code_decls, &nerr, &data, dynamic_mode,selected_cpu.features.popcnt);
    if (nerr > 0) {
        _zag_println("znc: build aborted — unsupported constructs (see messages above)");
        return 1;
    }
    // register promotion, optimizer, peephole, encode
    let prog2: ArrayList[Instr] = regalloc(prog);
    let prog3: ArrayList[Instr] = optimize(prog2);
    let opt:   ArrayList[Instr] = peephole(prog3);
    let code:  ArrayList[u8]    = encode(opt);

    let out: []u8 = out_flag();
    if (out.len == 0) { out = default_out(path); }

    if (dynamic_mode == 1) {
        let dynamic_syms: ArrayList[[]u8] = znc_dynamic_extern_syms(code_decls);
        if (dynamic_syms.len == 0) {
            _zag_eprintln("znc: --dynamic program declares no non-runtime extern symbols");
            return 1;
        }
        let drc: i32 = write_elf_dynamic(out, code, 0, data, dynamic_syms, needed_libs);
        if (drc != 0) { _zag_eprintln("znc: failed to write dynamic executable"); return 1; }
        _zag_print("znc: wrote dynamic native binary ");
        _zag_print(out);
        _zag_print(" (");
        _zag_print(_zag_i64_to_str(dynamic_syms.len as i64));
        _zag_println(" explicit system ABI symbol(s), 0 external build tools)");
        if (has_flag("--run") == 1) {
            let drun: []u8 = out;
            if (out.len > 0) { if (out[0] != '/') { drun = _zag_str_concat("./", out); } }
            let dec: i32 = _zag_exec_cmd(drun);
            _zag_print("znc: program exited ");
            _zag_println(_zag_i64_to_str(dec as i64));
        }
        return 0;
    }

    // Static-link any requested libraries.
    // Library code goes right after the main program code in the text segment,
    // so text_base = VBASE() + HDRS2() + code.len.
    let text_base_i64: i64 = (VBASE() + HDRS2() + code.len) as i64;
    let ml: MergedLib = link_libraries(link_libs, lib_paths, extern_syms, text_base_i64);

    let rc: i32 = write_elf_exec_data_lib(out, code, 0, data, ml.text);
    if (rc == 0 && has_flag("--debug") == 1) {
        let elf_bytes: []u8 = _zag_read_file(out);
        if (elf_bytes.len > 0) {
            let elf_buf: ArrayList[u8] = make[u8](elf_bytes.len + 512);
            let ci: i32 = 0;
            while (ci < elf_bytes.len) { push[u8](&elf_buf, elf_bytes[ci]); ci = ci + 1; }
            let dbuilder: DwarfBuilder = dwarf_new(path);
            dwarf_build_abbrev(&dbuilder);
            dwarf_emit_compile_unit(&dbuilder);
            let di: i32 = 0;
            while (di < len[*Node](code_decls)) {
                switch (get[*Node](code_decls, di).*) {
                    .fn_decl => |f| { dwarf_emit_function(&dbuilder, f.name, f.line); }
                    else => { }
                }
                di = di + 1;
            }
            dwarf_finish(&dbuilder);
            dwarf_emit_line_program(&dbuilder);
            let sections: DwarfSections = dwarf_build(&dbuilder);
            dwarf_patch_elf(&elf_buf, sections);
            rc = _zag_write_file(out, elf_buf.data[0..elf_buf.len]);
        }
    }
    if (rc != 0) { _zag_println("znc: failed to write executable"); return 1; }
    _zag_print("znc: wrote native binary ");
    _zag_print(out);
    _zag_print(" (");
    _zag_print(_zag_i64_to_str(code.len as i64));
    _zag_print(" bytes main");
    if (ml.text.len > 0) {
        _zag_print(" + ");
        _zag_print(_zag_i64_to_str(ml.text.len as i64));
        _zag_print(" bytes libs");
    }
    _zag_println(", 0 external tools)");

    // --hot: record the code/data sizes so `znc hot-patch` can verify a later
    // patch keeps the same layout (see hot_rt.zag).
    if (has_flag("--hot") == 1) { znc_write_hotlen(code.len, data.len); }

    if (has_flag("--run") == 1) {
        let runcmd: []u8 = out;
        if (out.len > 0) {
            if (out[0] != '/') { runcmd = _zag_str_concat("./", out); }
        }
        let ec: i32 = _zag_exec_cmd(runcmd);
        _zag_print("znc: program exited ");
        _zag_println(_zag_i64_to_str(ec as i64));
    }
    return 0;
}
