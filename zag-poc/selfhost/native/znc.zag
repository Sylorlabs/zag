    let selector_ok: i32 = znc_optimize_zagd_selector_current(record_text, record);
    let ok: i32 = (((((((record.valid == 1) && @strEq(record.policy_status, "verified_best_measured")) && @strEq(record.transform, rule)) && (record.winner_kind == 1)) && (semantic_ok == 1)) && (payload_ok == 1)) && (selector_ok == 1)) as i32;
    if (reference.len >= 0) {
