            }
            if (@strEq(v, "cuda-compat")) {
                return "cuda-compat";
            }
        }
        if (starts_with(a, "--target=") == 1) {
            let v: []u8 = a[9..];
            if (@strEq(v, "vulkan-compat")) {
                return "vulkan-compat";
            }
            if (@strEq(v, "opencl-compat")) {
                return "opencl-compat";
            }
            if (@strEq(v, "metal-compat")) {
                return "metal-compat";
            }
            if (@strEq(v, "opengl-compat")) {
                return "opengl-compat";
            }
            if (@strEq(v, "cuda-compat")) {
                return "cuda-compat";
            }
        }
        i = i + 1;
    }
    return "";
}

