                    return 1;
                }
            }
            .assign => |x| {
                if ((znc_harden_expr_has_try(x.target) == 1) || (znc_harden_expr_has_try(x.expr) == 1)) {
                    return 1;
                }
            }
            .if_ => |x| {
                if (((znc_harden_expr_has_try(x.cond) == 1) || (znc_harden_body_has_try(x.then_body) == 1)) || (znc_harden_body_has_try(x.els_body) == 1)) {
                    return 1;
                }
            }
            .while_ => |x| {
                if ((znc_harden_expr_has_try(x.cond) == 1) || (znc_harden_body_has_try(x.body) == 1)) {
                    return 1;
                }
            }
            .unsafe_ => |x| {
                if (znc_harden_body_has_try(x.body) == 1) {
                    return 1;
                }
            }
            .defer_ => |d| {
                if (znc_harden_expr_has_try(d.expr) == 1) {
                    return 1;
                }
            }
            .switch_ => |x| {
                if (znc_harden_expr_has_try(x.subject) == 1) {
                    return 1;
                }
                let ai: i32 = 0;
                while (ai < x.arms.len) {
                    if (znc_harden_body_has_try(x.arms.data[ai].body) == 1) {
                        return 1;
                    }
                    ai = ai + 1;
                }
                if (znc_harden_body_has_try(x.els_body) == 1) {
                    return 1;
                }
            }
            else => {
            }
        }
        i = i + 1;
    }
    return 0;
