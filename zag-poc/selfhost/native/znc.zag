fn znc_optimize_accept() i32 {
    let rule: []u8 = "";
    let source: []u8 = "";
    let output: []u8 = "";
    let from_zagd: i32 = 0;
    let i: i32 = 2;
    while (i < _zag_argc()) {
        let arg: []u8 = _zag_arg(i);
        if (@strEq(arg, "--accept")) {
            if ((i + 1) >= _zag_argc()) {
                _zag_eprintln("znc optimize: --accept requires a rule id");
                return 2;
            }
            rule = _zag_arg(i + 1);
            i = i + 2;
        } else if (@strEq(arg, "-o") || @strEq(arg, "--output")) {
            if ((i + 1) >= _zag_argc()) {
                _zag_eprintln("znc optimize: -o/--output requires an artifact path");
                return 2;
            }
            output = _zag_arg(i + 1);
            i = i + 2;
        } else if (@strEq(arg, "--from-zagd")) {
            from_zagd = 1;
            i = i + 1;
        } else if (@strEq(arg, "--no-zagd")) {
            i = i + 1;
        } else if ((arg.len > 0) && (arg[0] == 45)) {
            _zag_eprintln("znc optimize: accept supports only --accept RULE, SOURCE, -o OUTPUT, --from-zagd, and --no-zagd");
            return 2;
        } else if (source.len == 0) {
            source = arg;
            i = i + 1;
        } else {
            _zag_eprintln("znc optimize: exactly one source path is required");
            return 2;
        }
    }
    if ((rule.len == 0) || (znc_optimize_accept_rule(rule) == 0)) {
        _zag_eprintln("znc optimize: --accept requires const-i32-add-v1, const-i32-neg-v1, const-i64-add-v1, or const-bool-cmp-v1");
        return 2;
    }
    if ((source.len == 0) || (output.len == 0)) {
        _zag_eprintln("znc optimize: --accept requires SOURCE and -o OUTPUT");
        return 2;
    }
    if (source_path_is_zs(source) == 1) {
        _zag_eprintln("znc optimize: reviewed foreground rules accept regular .zag source only");
        return 1;
    }
    if (@strEq(source, output)) {
        _zag_eprintln("znc optimize: source and artifact paths must differ");
        return 1;
    }
    if (znc_path_absent_nofollow(output) == 0) {
        _zag_eprintln("znc optimize: output already exists or is not safe");
        return 1;
    }
    if ((((((has_flag("--safety=checked") == 1) || (has_flag("--sanitize=memory") == 1)) || (has_flag("--target") == 1)) || (has_flag("--dynamic") == 1)) || (has_flag("--emit-obj") == 1)) || (has_flag("--emit-static") == 1)) {
        _zag_eprintln("znc optimize: reviewed foreground rules require unsanitized native x86-64 output");
        return 1;
    }
    let source_bytes: []u8 = _zag_read_file(source);
    if (source_bytes.len < 0) {
        _zag_eprintln("znc optimize: source cannot be read");
        return 1;
    }
    if ((source_starts_script(source_bytes) == 1) || @strEq(v2_project_edition(source), "2027")) {
        free[u8](&source_bytes);
        _zag_eprintln("znc optimize: reviewed foreground rules require regular edition-2026 Zag");
        return 1;
    }
    if ((from_zagd == 1) && (znc_optimize_accept_zagd_current(rule, source, source_bytes) == 0)) {
        free[u8](&source_bytes);
        _zag_eprintln("znc optimize: --from-zagd requires a current verified_best_measured const-i32-add-v1 record; no artifact published");
        return 1;
    }
    let temp: []u8 = fc_temp_path(output);
    let baseline: []u8 = _zag_str_concat(output, ".baseline");
    if ((((znc_path_absent_nofollow(temp) == 0) || (znc_write_new_staging(temp, "") == 0)) || (znc_path_absent_nofollow(baseline) == 0)) || (znc_write_new_staging(baseline, "") == 0)) {
        let _remove_temp: i32 = fc_unlink(temp);
        let _remove_baseline: i32 = fc_unlink(baseline);
        free[u8](&source_bytes);
        _zag_eprintln("znc optimize: temporary artifact path is not safe");
        return 1;
    }
    let self_path: ZncOwnedPath = znc_self_executable_path();
    let command: []u8 = znc_shell_quote(self_path.path);
    if (self_path.owned == 1) {
        _zag_free(_zag_slice_ptr(self_path.path));
    }
    let baseline_command: []u8 = _zag_str_concat(command, _zag_str_concat(" ", znc_shell_quote(source)));
    baseline_command = _zag_str_concat(baseline_command, _zag_str_concat(" -o ", znc_shell_quote(baseline)));
    baseline_command = _zag_str_concat(baseline_command, " --no-zagd --no-analyze --no-foreground-cache");
    let baseline_ec: i32 = _zag_exec_cmd(baseline_command);
    if ((baseline_ec != 0) || (znc_optimize_accept_elf(baseline) == 0)) {
        let _remove_temp: i32 = fc_unlink(temp);
        let _remove_baseline: i32 = fc_unlink(baseline);
        free[u8](&source_bytes);
        _zag_eprintln("znc optimize: baseline foreground validation failed; no artifact published");
        return 1;
    }
    if (znc_optimize_accept_source_matches(source, source_bytes) == 0) {
        let _remove_temp: i32 = fc_unlink(temp);
        let _remove_baseline: i32 = fc_unlink(baseline);
        free[u8](&source_bytes);
        _zag_eprintln("znc optimize: source changed during baseline validation; no artifact published");
        return 1;
    }
    command = _zag_str_concat(command, _zag_str_concat(" ", znc_shell_quote(source)));
    command = _zag_str_concat(command, _zag_str_concat(" -o ", znc_shell_quote(temp)));
    command = _zag_str_concat(command, _zag_str_concat(" --foreground-transform ", znc_shell_quote(rule)));
    command = _zag_str_concat(command, " --no-zagd --no-analyze --no-foreground-cache");
    let ec: i32 = _zag_exec_cmd(command);
    if (ec != 0) {
        let _remove: i32 = fc_unlink(temp);
        let _remove_baseline: i32 = fc_unlink(baseline);
        free[u8](&source_bytes);
        _zag_eprintln("znc optimize: accepted rule failed foreground validation; no artifact published");
        return 1;
    }
    if (znc_optimize_accept_elf(temp) == 0) {
        let _remove: i32 = fc_unlink(temp);
        let _remove_baseline: i32 = fc_unlink(baseline);
        free[u8](&source_bytes);
        _zag_eprintln("znc optimize: foreground command did not produce a native x86-64 ET_EXEC artifact");
        return 1;
    }
    if ((from_zagd == 1) && (znc_optimize_accept_zagd_finalist_matches(source, temp) == 0)) {
        let _remove: i32 = fc_unlink(temp);
        let _remove_baseline: i32 = fc_unlink(baseline);
        free[u8](&source_bytes);
        _zag_eprintln("znc optimize: daemon finalist bytes do not match the freshly checked foreground candidate; no artifact published");
        return 1;
    }
    if (znc_optimize_accept_source_matches(source, source_bytes) == 0) {
        let _remove_temp: i32 = fc_unlink(temp);
        let _remove_baseline: i32 = fc_unlink(baseline);
        free[u8](&source_bytes);
        _zag_eprintln("znc optimize: source changed during reviewed validation; no artifact published");
        return 1;
    }
    let baseline_stdout: []u8 = _zag_str_concat(baseline, ".stdout");
    let baseline_stderr: []u8 = _zag_str_concat(baseline, ".stderr");
    let candidate_stdout: []u8 = _zag_str_concat(temp, ".stdout");
    let candidate_stderr: []u8 = _zag_str_concat(temp, ".stderr");
    let baseline_run: i32 = znc_optimize_accept_run(baseline, baseline_stdout, baseline_stderr);
    let candidate_run: i32 = znc_optimize_accept_run(temp, candidate_stdout, candidate_stderr);
    let differential: i32 = (((baseline_run == candidate_run) && (znc_optimize_accept_bytes_equal(baseline_stdout, candidate_stdout) == 1)) && (znc_optimize_accept_bytes_equal(baseline_stderr, candidate_stderr) == 1)) as i32;
    if (differential == 0) {
        let _remove_temp: i32 = fc_unlink(temp);
        let _remove_baseline: i32 = fc_unlink(baseline);
        let _remove_bo: i32 = fc_unlink(baseline_stdout);
        let _remove_be: i32 = fc_unlink(baseline_stderr);
        let _remove_co: i32 = fc_unlink(candidate_stdout);
        let _remove_ce: i32 = fc_unlink(candidate_stderr);
        free[u8](&source_bytes);
        _zag_eprintln("znc optimize: reviewed rule failed baseline differential validation; no artifact published");
        return 1;
    }
    if (znc_optimize_accept_source_matches(source, source_bytes) == 0) {
        let _remove_temp: i32 = fc_unlink(temp);
        let _remove_baseline: i32 = fc_unlink(baseline);
        let _remove_bo: i32 = fc_unlink(baseline_stdout);
        let _remove_be: i32 = fc_unlink(baseline_stderr);
        let _remove_co: i32 = fc_unlink(candidate_stdout);
        let _remove_ce: i32 = fc_unlink(candidate_stderr);
        free[u8](&source_bytes);
        _zag_eprintln("znc optimize: source changed before reviewed publication; no artifact published");
        return 1;
    }
    let _remove_baseline: i32 = fc_unlink(baseline);
    let _remove_bo: i32 = fc_unlink(baseline_stdout);
    let _remove_be: i32 = fc_unlink(baseline_stderr);
    let _remove_co: i32 = fc_unlink(candidate_stdout);
    let _remove_ce: i32 = fc_unlink(candidate_stderr);
    if (znc_optimize_accept_publish(temp, output) == 0) {
        free[u8](&source_bytes);
        _zag_eprintln("znc optimize: artifact publication lost the create-only race; no existing output was replaced");
        return 1;
    }
    free[u8](&source_bytes);
    _zag_println(_zag_str_concat("znc optimize: accepted ", _zag_str_concat(rule, _zag_str_concat("; differential=baseline-exit-stdout-stderr; published ", _zag_str_concat(output, "; source unchanged")))));
    return 0;
}

fn znc_optimize_preview() i32 {
    if (has_flag("--accept") == 1) {
        return znc_optimize_accept();
    }
    let preview: i32 = 0;
    let i: i32 = 2;
    while (i < _zag_argc()) {
        let arg: []u8 = _zag_arg(i);
        if (@strEq(arg, "--preview")) {
            preview = 1;
            i = i + 1;
        } else if (@strEq(arg, "--no-zagd")) {
            i = i + 1;
        } else if (@strEq(arg, "--format")) {
            if ((i + 1) >= _zag_argc()) {
                _zag_eprintln("znc optimize: --format must be text or json");
                return 2;
            }
            i = i + 2;
        } else if (((((@strEq(arg, "--apply") || @strEq(arg, "--in-place")) || @strEq(arg, "--write")) || @strEq(arg, "--output")) || @strEq(arg, "-o")) || @strEq(arg, "--replace")) {
            _zag_eprintln("znc optimize: mutation flags are unsupported; use --preview for a read-only advisory");
            return 2;
        } else {
            _zag_eprintln("znc optimize: only --preview, --format text|json, and --no-zagd are supported");
            return 2;
        }
    }
    if (preview == 0) {
        _zag_eprintln("znc optimize: only --preview is implemented; no automatic transformation exists");
        return 2;
    }
    let json: i32 = znc_output_format();
    if (json < 0) {
        _zag_eprintln("znc optimize: --format must be text or json");
        return 2;
    }
    if (json == 0) {
        _zag_println("znc optimize preview: read-only advisory; source_changes=false");
    }
    return znc_zagd_suggest("optimize");
}

fn znc_package_lock_entry_less(a: PackageLockGeneratedEntry, b: PackageLockGeneratedEntry) i32 {
    let order: i32 = package_lock_compare(a.alias, b.alias);
    if (order != 0) {
        return (order < 0) as i32;
    }
    order = package_lock_compare(a.root, b.root);
    if (order != 0) {
        return (order < 0) as i32;
    }
    return (package_lock_compare(a.module, b.module) < 0) as i32;
}

fn znc_package_lock_entry_same(a: PackageLockGeneratedEntry, b: PackageLockGeneratedEntry) i32 {
    return ((@strEq(a.alias, b.alias) && @strEq(a.root, b.root)) && @strEq(a.module, b.module)) as i32;
}

fn znc_package_lock_entries_release(entries: *ArrayList[PackageLockGeneratedEntry]) void {
    let i: i32 = 0;
    while (i < entries.*.len) {
        package_lock_generated_release(&entries.*.data[i]);
        i = i + 1;
    }
    free[PackageLockGeneratedEntry](entries);
}

fn znc_package_lock_append_owned(base: *[]u8, piece: []u8) void {
    let prefix: []u8 = "";
    if (base.*.len > 0) {
        prefix = base.*;
    }
    let next: []u8 = _zag_str_concat(prefix, piece);
    if (base.*.len > 0) {
        _zag_str_free(base.*);
    }
    base.* = next;
}

fn znc_package_lock_entry_line(entry: PackageLockGeneratedEntry) []u8 {
    let line: []u8 = "";
    znc_package_lock_append_owned(&line, "entry=");
    znc_package_lock_append_owned(&line, entry.alias);
    znc_package_lock_append_owned(&line, "\t");
    znc_package_lock_append_owned(&line, entry.root);
    znc_package_lock_append_owned(&line, "\t");
    znc_package_lock_append_owned(&line, entry.module);
    znc_package_lock_append_owned(&line, "\t");
    let first: []u8 = _zag_i64_to_str(entry.checksum.first);
    let second: []u8 = _zag_i64_to_str(entry.checksum.second);
    let bytes: []u8 = _zag_i64_to_str(entry.checksum.bytes);
    znc_package_lock_append_owned(&line, first);
    _zag_str_free(first);
    znc_package_lock_append_owned(&line, ",");
    znc_package_lock_append_owned(&line, second);
    _zag_str_free(second);
    znc_package_lock_append_owned(&line, ",");
    znc_package_lock_append_owned(&line, bytes);
    _zag_str_free(bytes);
    znc_package_lock_append_owned(&line, "\n");
    return line;
}

fn znc_package_lock_render(entries: ArrayList[PackageLockGeneratedEntry]) []u8 {
    let out: []u8 = "";
    znc_package_lock_append_owned(&out, "format=zag-local-lock-v1\n");
    let i: i32 = 0;
    while (i < entries.len) {
        let best: i32 = i;
        let j: i32 = i + 1;
        while (j < entries.len) {
            if (znc_package_lock_entry_less(entries.data[j], entries.data[best]) == 1) {
                best = j;
            }
            j = j + 1;
        }
        if (best != i) {
            let swap: PackageLockGeneratedEntry = entries.data[i];
            entries.data[i] = entries.data[best];
            entries.data[best] = swap;
        }
        i = i + 1;
    }
    i = 0;
    while (i < entries.len) {
        let line: []u8 = znc_package_lock_entry_line(entries.data[i]);
        znc_package_lock_append_owned(&out, line);
        _zag_str_free(line);
        i = i + 1;
    }
    return out;
}

fn znc_package_lock_source_arg() []u8 {
    let i: i32 = 3;
    while (i < _zag_argc()) {
        let arg: []u8 = _zag_arg(i);
        if (@strEq(arg, "--output") || @strEq(arg, "-o")) {
            i = i + 2;
        } else if ((arg.len > 0) && (arg[0] == 45)) {
            i = i + 1;
        } else {
            return arg;
        }
    }
    return "";
}

fn znc_package_lock() i32 {
    let path: []u8 = znc_package_lock_source_arg();
    if (path.len == 0) {
        _zag_eprintln("znc package lock: source.zag is required");
        return 2;
    }
    let source: []u8 = _zag_read_file(path);
    if (source.len < 0) {
        _zag_eprintln("znc package lock: cannot read source");
        return 1;
    }
    let unit: CompilationUnit = parse_compilation_unit_dir(source, dir_of(path));
    let entries: ArrayList[PackageLockGeneratedEntry] = make[PackageLockGeneratedEntry](8);
    let total_bytes: i64 = 0;
    let i: i32 = 0;
    while (i < unit.imports.len) {
        let edge: ResolvedImport = unit.imports.data[i];
        if ((package_import_starts_with(edge.specifier, "pkg:") == 1) && (@strEq(edge.importer, "<root>") == 1)) {
            let entry: PackageLockGeneratedEntry = package_lock_generated_entry(edge.specifier, edge.importer);
            if (entry.valid == 0) {
                _zag_eprintln(_zag_str_concat("znc package lock: cannot collect locked import `", _zag_str_concat(edge.specifier, "` (dependency must be mode=vendor or mode=sibling and module bytes must exist)")));
                package_lock_generated_release(&entry);
                znc_package_lock_entries_release(&entries);
                package_import_free_read(source);
                return 1;
            }
            if ((entries.len >= 256) || ((total_bytes + entry.checksum.bytes) > 67108864)) {
                _zag_eprintln("znc package lock: generated graph exceeds the canonical 256-entry/64-MiB bound");
                package_lock_generated_release(&entry);
                znc_package_lock_entries_release(&entries);
                package_import_free_read(source);
                return 1;
            }
            let duplicate: i32 = 0;
            let j: i32 = 0;
            while (j < entries.len) {
                if (znc_package_lock_entry_same(entries.data[j], entry) == 1) {
                    if (package_raw_checksum_equal(entries.data[j].checksum, entry.checksum) == 0) {
                        _zag_eprintln("znc package lock: one package tuple resolved to different raw module bytes");
                        package_lock_generated_release(&entry);
                        znc_package_lock_entries_release(&entries);
                        package_import_free_read(source);
                        return 1;
                    }
                    duplicate = 1;
                }
                j = j + 1;
            }
            if (duplicate == 0) {
                push[PackageLockGeneratedEntry](&entries, entry);
                total_bytes = total_bytes + entry.checksum.bytes;
            } else {
                package_lock_generated_release(&entry);
            }
        }
        i = i + 1;
    }
    i = 0;
    while (i < unit.imports.len) {
        let edge: ResolvedImport = unit.imports.data[i];
        if (package_import_starts_with(edge.specifier, "pkg:") == 0) {
            let j: i32 = 0;
            while (j < entries.len) {
                let entry: PackageLockGeneratedEntry = package_lock_generated_relative_entry(edge.imported, entries.data[j]);
                if (entry.valid == 1) {
                    let duplicate: i32 = 0;
                    let k: i32 = 0;
                    while (k < entries.len) {
                        if (znc_package_lock_entry_same(entries.data[k], entry) == 1) {
                            if (package_raw_checksum_equal(entries.data[k].checksum, entry.checksum) == 0) {
                                _zag_eprintln("znc package lock: one transitive package tuple resolved to different raw module bytes");
                                package_lock_generated_release(&entry);
                                znc_package_lock_entries_release(&entries);
                                package_import_free_read(source);
                                return 1;
                            }
                            duplicate = 1;
                        }
                        k = k + 1;
                    }
                    if (duplicate == 0) {
                        if ((entries.len >= 256) || ((total_bytes + entry.checksum.bytes) > 67108864)) {
                            _zag_eprintln("znc package lock: generated graph exceeds the canonical 256-entry/64-MiB bound");
                            package_lock_generated_release(&entry);
                            znc_package_lock_entries_release(&entries);
                            package_import_free_read(source);
                            return 1;
                        }
                        push[PackageLockGeneratedEntry](&entries, entry);
                        total_bytes = total_bytes + entry.checksum.bytes;
                    } else {
                        package_lock_generated_release(&entry);
                    }
                    break;
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    i = 0;
    while (i < unit.resources.len) {
        let resource: ResolvedResource = unit.resources.data[i];
        let j: i32 = 0;
        while (j < entries.len) {
            let entry: PackageLockGeneratedEntry = package_lock_generated_resource_entry(resource.path, entries.data[j]);
            if (entry.valid == 1) {
                let duplicate: i32 = 0;
                let k: i32 = 0;
                while (k < entries.len) {
                    if (znc_package_lock_entry_same(entries.data[k], entry) == 1) {
                        if (package_raw_checksum_equal(entries.data[k].checksum, entry.checksum) == 0) {
                            _zag_eprintln("znc package lock: one vendored resource tuple resolved to different raw bytes");
                            package_lock_generated_release(&entry);
                            znc_package_lock_entries_release(&entries);
                            package_import_free_read(source);
                            return 1;
                        }
                        duplicate = 1;
                    }
                    k = k + 1;
                }
                if (duplicate == 0) {
                    if ((entries.len >= 256) || ((total_bytes + entry.checksum.bytes) > 67108864)) {
                        _zag_eprintln("znc package lock: generated graph exceeds the canonical 256-entry/64-MiB bound");
                        package_lock_generated_release(&entry);
                        znc_package_lock_entries_release(&entries);
                        package_import_free_read(source);
                        return 1;
                    }
                    push[PackageLockGeneratedEntry](&entries, entry);
                    total_bytes = total_bytes + entry.checksum.bytes;
                } else {
                    package_lock_generated_release(&entry);
                }
                break;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    if (entries.len == 0) {
        _zag_eprintln("znc package lock: source graph contains no explicit pkg: imports");
        znc_package_lock_entries_release(&entries);
        package_import_free_read(source);
        return 1;
    }
    let output: []u8 = flag_value("--output");
    let target: []u8 = "";
    if (output.len > 0) {
        target = output;
    } else {
        let manifest: []u8 = package_import_manifest(dir_of(path));
        if (manifest.len == 0) {
            _zag_eprintln("znc package lock: no ancestor zag.mod");
            znc_package_lock_entries_release(&entries);
            package_import_free_read(source);
            return 1;
        }
        target = package_import_join(package_import_dir(manifest), "zag.lock");
        _zag_str_free(manifest);
    }
    if (znc_path_absent_nofollow(target) == 0) {
        _zag_eprintln(_zag_str_concat("znc package lock: refusing to replace existing lock `", _zag_str_concat(target, "`")));
        if (output.len == 0) {
            _zag_str_free(target);
        }
        znc_package_lock_entries_release(&entries);
        package_import_free_read(source);
        return 1;
    }
    let lock: []u8 = znc_package_lock_render(entries);
    let published: i32 = znc_publish_new_file(target, lock);
    _zag_str_free(lock);
    if (output.len == 0) {
        _zag_str_free(target);
    }
    znc_package_lock_entries_release(&entries);
    package_import_free_read(source);
    if (published == 0) {
        _zag_eprintln("znc package lock: failed to publish create-only lock");
        return 1;
    }
    _zag_println("znc package lock: canonical locked entries written");
    return 0;
}

struct PackageRegistryLockGeneratedEntry {
    scope: []u8,
    alias: []u8,
    index_path: []u8,
    version: []u8,
    source: []u8,
    index_checksum: PackageRawChecksum,
    artifact_checksum: PackageRawChecksum,
    artifact_signature: []u8,
    valid: i32,
}

fn znc_package_registry_lock_generated_bad() PackageRegistryLockGeneratedEntry {
    return PackageRegistryLockGeneratedEntry{ .scope = "", .alias = "", .index_path = "", .version = "", .source = "", .index_checksum = PackageRawChecksum{ .first = 0, .second = 0, .bytes = 0 }, .artifact_checksum = PackageRawChecksum{ .first = 0, .second = 0, .bytes = 0 }, .artifact_signature = "", .valid = 0 };
}

fn znc_package_registry_lock_generated_release(entry: *PackageRegistryLockGeneratedEntry) void {
    if (entry.*.scope.len > 0) {
        _zag_str_free(entry.*.scope);
    }
    if (entry.*.alias.len > 0) {
        _zag_str_free(entry.*.alias);
    }
    if (entry.*.index_path.len > 0) {
        _zag_str_free(entry.*.index_path);
    }
    if (entry.*.version.len > 0) {
        _zag_str_free(entry.*.version);
    }
    if (entry.*.source.len > 0) {
        _zag_str_free(entry.*.source);
    }
    if (entry.*.artifact_signature.len > 0) {
        _zag_str_free(entry.*.artifact_signature);
    }
    entry.*.scope = "";
    entry.*.alias = "";
    entry.*.index_path = "";
    entry.*.version = "";
    entry.*.source = "";
    entry.*.artifact_signature = "";
    entry.*.valid = 0;
}

fn znc_package_registry_lock_generated_same(a: PackageRegistryLockGeneratedEntry, b: PackageRegistryLockGeneratedEntry) i32 {
    return (((((((@strEq(a.scope, b.scope) && @strEq(a.alias, b.alias)) && @strEq(a.index_path, b.index_path)) && @strEq(a.version, b.version)) && @strEq(a.source, b.source)) && @strEq(a.artifact_signature, b.artifact_signature)) && (package_raw_checksum_equal(a.index_checksum, b.index_checksum) == 1)) && (package_raw_checksum_equal(a.artifact_checksum, b.artifact_checksum) == 1)) as i32;
}

fn znc_package_registry_lock_generated_less(a: PackageRegistryLockGeneratedEntry, b: PackageRegistryLockGeneratedEntry) i32 {
    let order: i32 = package_lock_compare(a.scope, b.scope);
    if (order != 0) {
        return (order < 0) as i32;
    }
    order = package_lock_compare(a.alias, b.alias);
    if (order != 0) {
        return (order < 0) as i32;
    }
    order = package_lock_compare(a.index_path, b.index_path);
    if (order != 0) {
        return (order < 0) as i32;
    }
    return (package_semver_compare(package_semver_parse(a.version), package_semver_parse(b.version)) < 0) as i32;
}

fn znc_package_registry_lock_generated_release_all(entries: *ArrayList[PackageRegistryLockGeneratedEntry]) void {
    let i: i32 = 0;
    while (i < entries.*.len) {
        znc_package_registry_lock_generated_release(&entries.*.data[i]);
        i = i + 1;
    }
    free[PackageRegistryLockGeneratedEntry](entries);
}

fn znc_package_registry_lock_checksum_text(h: PackageRawChecksum) []u8 {
    let a: []u8 = _zag_i64_to_str(h.first);
    let b: []u8 = _zag_i64_to_str(h.second);
    let c: []u8 = _zag_i64_to_str(h.bytes);
    let ab: []u8 = _zag_str_concat(a, ",");
    ab = _zag_str_concat(ab, b);
    let abc: []u8 = _zag_str_concat(ab, ",");
    abc = _zag_str_concat(abc, c);
    _zag_str_free(a);
    _zag_str_free(b);
    _zag_str_free(c);
    _zag_str_free(ab);
    return abc;
}

fn znc_package_registry_lock_entry_line(entry: PackageRegistryLockGeneratedEntry, scoped: i32) []u8 {
    let line: []u8 = "entry=";
    if (scoped != 0) {
        line = _zag_str_concat(line, entry.scope);
        line = _zag_str_concat(line, "\t");
    }
    line = _zag_str_concat(line, entry.alias);
    line = _zag_str_concat(line, "\t");
    line = _zag_str_concat(line, entry.index_path);
    line = _zag_str_concat(line, "\t");
    let index_sum: []u8 = znc_package_registry_lock_checksum_text(entry.index_checksum);
    line = _zag_str_concat(line, index_sum);
    _zag_str_free(index_sum);
    line = _zag_str_concat(line, "\t");
    line = _zag_str_concat(line, entry.version);
    line = _zag_str_concat(line, "\t");
    line = _zag_str_concat(line, entry.source);
    line = _zag_str_concat(line, "\t");
    let artifact_sum: []u8 = znc_package_registry_lock_checksum_text(entry.artifact_checksum);
    line = _zag_str_concat(line, artifact_sum);
    _zag_str_free(artifact_sum);
    if (entry.artifact_signature.len > 0) {
        line = _zag_str_concat(line, "\t");
        line = _zag_str_concat(line, entry.artifact_signature);
    }
    line = _zag_str_concat(line, "\n");
    return line;
}

fn znc_package_registry_lock_render(entries: ArrayList[PackageRegistryLockGeneratedEntry]) []u8 {
    let scoped: i32 = 0;
    let i0: i32 = 0;
    while (i0 < entries.len) {
        if (!@strEq(entries.data[i0].scope, "root")) {
            scoped = 1;
        }
        i0 = i0 + 1;
    }
    let body: []u8 = "format=zag-registry-lock-v1\n";
    if (scoped != 0) {
        body = "format=zag-registry-lock-v2\n";
    }
    let i: i32 = 0;
    while (i < entries.len) {
        let best: i32 = i;
        let j: i32 = i + 1;
        while (j < entries.len) {
            if (znc_package_registry_lock_generated_less(entries.data[j], entries.data[best]) == 1) {
                best = j;
            }
            j = j + 1;
        }
        if (best != i) {
            let swap: PackageRegistryLockGeneratedEntry = entries.data[i];
            entries.data[i] = entries.data[best];
            entries.data[best] = swap;
        }
        i = i + 1;
    }
    i = 0;
    while (i < entries.len) {
        let line: []u8 = znc_package_registry_lock_entry_line(entries.data[i], scoped);
        body = _zag_str_concat(body, line);
        _zag_str_free(line);
        i = i + 1;
    }
    let sum: []u8 = znc_package_registry_lock_checksum_text(package_raw_checksum(body));
    let checksum_line: []u8 = _zag_str_concat("checksum=", sum);
    checksum_line = _zag_str_concat(checksum_line, "\n");
    let out: []u8 = _zag_str_concat(body, checksum_line);
    _zag_str_free(body);
    _zag_str_free(sum);
    _zag_str_free(checksum_line);
    return out;
}

fn znc_package_registry_lock_generated_entry(specifier: []u8, importer: []u8, root_manifest: []u8, target_canon: []u8) PackageRegistryLockGeneratedEntry {
    let bad: PackageRegistryLockGeneratedEntry = znc_package_registry_lock_generated_bad();
    if (package_import_starts_with(specifier, "pkg:") == 0) {
        return bad;
    }
    let slash: i32 = 4;
    while ((slash < specifier.len) && (specifier[slash] != 47)) {
        slash = slash + 1;
    }
    if (slash >= specifier.len) {
        return bad;
    }
    let alias: []u8 = specifier[4..slash];
    let module: []u8 = specifier[slash + 1..specifier.len];
    if ((package_import_safe_name(alias) == 0) || (package_import_module_safe(module) == 0)) {
        return bad;
    }
    let manifest: []u8 = package_import_manifest(package_import_dir(importer));
    if (manifest.len == 0) {
        return bad;
    }
    let manifest_id: []u8 = canon_path(manifest);
    let root_id: []u8 = canon_path(root_manifest);
    let same_manifest: i32 = @strEq(manifest_id, root_id) as i32;
    _zag_str_free(manifest_id);
    _zag_str_free(root_id);
    let manifest_read: PackageNoFollowRead = package_import_read_nofollow(manifest);
    if (manifest_read.ok == 0) {
        _zag_str_free(manifest);
        return bad;
    }
    let declared: PackageManifestDependency = package_manifest_dependency(manifest_read.bytes, alias);
    if ((((declared.valid == 0) || (declared.count != 1)) || !@strEq(declared.mode, "registry")) || (package_import_artifact_safe(declared.path) == 0)) {
        package_import_free_read(manifest_read.bytes);
        _zag_str_free(manifest);
        return bad;
    }
    if (same_manifest == 0) {
        if (declared.registry_lock.len == 0) {
            package_import_free_read(manifest_read.bytes);
            _zag_str_free(manifest);
            return bad;
        }
        let declared_lock: []u8 = package_import_join(package_import_dir(manifest), declared.registry_lock);
        let declared_lock_canon: []u8 = canon_path(declared_lock);
        let lock_matches: i32 = @strEq(declared_lock_canon, target_canon) as i32;
        _zag_str_free(declared_lock);
        _zag_str_free(declared_lock_canon);
        if (lock_matches == 0) {
            package_import_free_read(manifest_read.bytes);
            _zag_str_free(manifest);
            return bad;
        }
    } else if (declared.registry_lock.len > 0) {
        package_import_free_read(manifest_read.bytes);
        _zag_str_free(manifest);
        return bad;
    }
    let index_path: []u8 = package_import_join(package_import_dir(manifest), declared.path);
    if (package_import_path_no_symlink(index_path) == 0) {
        package_import_free_read(manifest_read.bytes);
        _zag_str_free(manifest);
        _zag_str_free(index_path);
        return bad;
    }
    let index_read: PackageNoFollowRead = package_import_read_nofollow(index_path);
    if (index_read.ok == 0) {
        package_import_free_read(manifest_read.bytes);
        _zag_str_free(manifest);
        _zag_str_free(index_path);
        return bad;
    }
    let signed_required: i32 = ((declared.registry_key.len > 0) && (declared.registry_signature.len > 0)) as i32;
    if (signed_required == 1) {
        let key_path: []u8 = package_import_join(package_import_dir(manifest), declared.registry_key);
        let signature_path: []u8 = package_import_join(package_import_dir(manifest), declared.registry_signature);
        let verified: i32 = (((package_import_path_no_symlink(key_path) == 1) && (package_import_path_no_symlink(signature_path) == 1)) && (package_registry_signed_index_verified(index_path, key_path, signature_path) == 1)) as i32;
        _zag_str_free(key_path);
        _zag_str_free(signature_path);
        if (verified == 0) {
            package_import_free_read(index_read.bytes);
            package_import_free_read(manifest_read.bytes);
            _zag_str_free(manifest);
            _zag_str_free(index_path);
            return bad;
        }
    }
    let selected: PackageRegistryIndexLookup = package_registry_index_select(index_read.bytes, alias, declared.version, signed_required);
    if ((selected.found == 0) || !@strEq(selected.source, module)) {
        package_import_free_read(index_read.bytes);
        package_import_free_read(manifest_read.bytes);
        _zag_str_free(manifest);
        _zag_str_free(index_path);
        return bad;
    }
    let module_path: []u8 = package_import_join(package_import_dir(index_path), selected.source);
    if (package_import_path_no_symlink(module_path) == 0) {
        package_import_free_read(index_read.bytes);
        package_import_free_read(manifest_read.bytes);
        _zag_str_free(manifest);
        _zag_str_free(index_path);
        _zag_str_free(module_path);
        return bad;
    }
    let module_read: PackageNoFollowRead = package_import_read_nofollow(module_path);
    let artifact_ok: i32 = ((module_read.ok == 1) && (package_raw_checksum_equal(package_raw_checksum(module_read.bytes), selected.checksum) == 1)) as i32;
    if (artifact_ok == 0) {
        if (module_read.ok == 1) {
            package_import_free_read(module_read.bytes);
        }
        package_import_free_read(index_read.bytes);
        package_import_free_read(manifest_read.bytes);
        _zag_str_free(manifest);
        _zag_str_free(index_path);
        _zag_str_free(module_path);
        return bad;
    }
    let scope: []u8 = package_registry_lock_scope(manifest, target_canon);
    if (scope.len == 0) {
        package_import_free_read(module_read.bytes);
        package_import_free_read(index_read.bytes);
        package_import_free_read(manifest_read.bytes);
        _zag_str_free(manifest);
        _zag_str_free(index_path);
        _zag_str_free(module_path);
        return bad;
    }
    let result: PackageRegistryLockGeneratedEntry = PackageRegistryLockGeneratedEntry{ .scope = _zag_str_concat("", scope), .alias = _zag_str_concat("", alias), .index_path = _zag_str_concat("", declared.path), .version = _zag_str_concat("", selected.version), .source = _zag_str_concat("", selected.source), .index_checksum = package_raw_checksum(index_read.bytes), .artifact_checksum = selected.checksum, .artifact_signature = _zag_str_concat("", selected.artifact_signature), .valid = 1 };
    package_import_free_read(module_read.bytes);
    package_import_free_read(index_read.bytes);
    package_import_free_read(manifest_read.bytes);
    _zag_str_free(manifest);
    _zag_str_free(index_path);
    _zag_str_free(module_path);
    _zag_str_free(scope);
    return result;
}

fn znc_package_registry_lock() i32 {
    let path: []u8 = znc_package_lock_source_arg();
    if (path.len == 0) {
        _zag_eprintln("znc package registry-lock: source.zag is required");
        return 2;
    }
    let source: []u8 = _zag_read_file(path);
    if (source.len < 0) {
        _zag_eprintln("znc package registry-lock: cannot read source");
        return 1;
    }
    let root_manifest: []u8 = package_import_manifest(dir_of(path));
    if (root_manifest.len == 0) {
        _zag_eprintln("znc package registry-lock: no ancestor zag.mod");
        package_import_free_read(source);
        return 1;
    }
    let output: []u8 = flag_value("--output");
    let target: []u8 = "";
    let target_owned: i32 = 0;
    if (output.len > 0) {
        target = output;
    } else {
        target = package_import_join(package_import_dir(root_manifest), "registry.lock");
        target_owned = 1;
    }
    let target_canon: []u8 = canon_path(target);
    let unit: CompilationUnit = parse_compilation_unit_dir(source, dir_of(path));
    let entries: ArrayList[PackageRegistryLockGeneratedEntry] = make[PackageRegistryLockGeneratedEntry](8);
    let total_bytes: i64 = 0;
    let i: i32 = 0;
    while (i < unit.imports.len) {
        let edge: ResolvedImport = unit.imports.data[i];
        if (package_import_starts_with(edge.specifier, "pkg:") == 1) {
            let entry: PackageRegistryLockGeneratedEntry = znc_package_registry_lock_generated_entry(edge.specifier, edge.importer, root_manifest, target_canon);
            if (entry.valid == 0) {
                _zag_eprintln("znc package registry-lock: graph contains an unsupported, nested, unlocked, or mismatched registry selection");
                znc_package_registry_lock_generated_release(&entry);
                znc_package_registry_lock_generated_release_all(&entries);
                _zag_str_free(target_canon);
                if (target_owned == 1) {
                    _zag_str_free(target);
                }
                _zag_str_free(root_manifest);
                package_import_free_read(source);
                return 1;
            }
            if ((entries.len >= 256) || ((total_bytes + entry.artifact_checksum.bytes) > 67108864)) {
                _zag_eprintln("znc package registry-lock: graph exceeds the canonical 256-entry/64-MiB bound");
                znc_package_registry_lock_generated_release(&entry);
                znc_package_registry_lock_generated_release_all(&entries);
                _zag_str_free(target_canon);
                if (target_owned == 1) {
                    _zag_str_free(target);
                }
                _zag_str_free(root_manifest);
                package_import_free_read(source);
                return 1;
            }
            let duplicate: i32 = 0;
            let j: i32 = 0;
            while (j < entries.len) {
                if ((@strEq(entries.data[j].scope, entry.scope) && @strEq(entries.data[j].alias, entry.alias)) && @strEq(entries.data[j].index_path, entry.index_path)) {
                    if (znc_package_registry_lock_generated_same(entries.data[j], entry) == 0) {
                        _zag_eprintln("znc package registry-lock: one registry tuple selected different bytes");
                        znc_package_registry_lock_generated_release(&entry);
                        znc_package_registry_lock_generated_release_all(&entries);
                        _zag_str_free(target_canon);
                        if (target_owned == 1) {
                            _zag_str_free(target);
                        }
                        _zag_str_free(root_manifest);
                        package_import_free_read(source);
                        return 1;
                    }
                    duplicate = 1;
                }
                j = j + 1;
            }
            if (duplicate == 0) {
                push[PackageRegistryLockGeneratedEntry](&entries, entry);
                total_bytes = total_bytes + entry.artifact_checksum.bytes;
            } else {
                znc_package_registry_lock_generated_release(&entry);
            }
        }
        i = i + 1;
    }
    if (entries.len == 0) {
        _zag_eprintln("znc package registry-lock: source graph contains no root-manifest registry imports");
        znc_package_registry_lock_generated_release_all(&entries);
        _zag_str_free(target_canon);
        if (target_owned == 1) {
            _zag_str_free(target);
        }
        _zag_str_free(root_manifest);
        package_import_free_read(source);
        return 1;
    }
    if (znc_path_absent_nofollow(target) == 0) {
        _zag_eprintln(_zag_str_concat("znc package registry-lock: refusing to replace existing lock `", _zag_str_concat(target, "`")));
        if (target_owned == 1) {
            _zag_str_free(target);
        }
        _zag_str_free(target_canon);
        znc_package_registry_lock_generated_release_all(&entries);
        _zag_str_free(root_manifest);
        package_import_free_read(source);
        return 1;
    }
    let lock: []u8 = znc_package_registry_lock_render(entries);
    let published: i32 = znc_publish_new_file(target, lock);
    _zag_str_free(lock);
    if (target_owned == 1) {
        _zag_str_free(target);
    }
    _zag_str_free(target_canon);
    znc_package_registry_lock_generated_release_all(&entries);
    _zag_str_free(root_manifest);
    package_import_free_read(source);
    if (published == 0) {
        _zag_eprintln("znc package registry-lock: failed to publish create-only lock");
        return 1;
    }
    _zag_println("znc package registry-lock: canonical local selections written");
    return 0;
}

fn znc_package_verify_index_arg() []u8 {
    let found: []u8 = "";
    let positional: i32 = 0;
    let i: i32 = 3;
    while (i < _zag_argc()) {
        let arg: []u8 = _zag_arg(i);
        if (@strEq(arg, "--key") || @strEq(arg, "--signature")) {
            i = i + 2;
        } else if ((arg.len > 0) && (arg[0] == 45)) {
            i = i + 1;
        } else {
            positional = positional + 1;
            if (positional == 1) {
                found = arg;
            }
            i = i + 1;
        }
    }
    if (positional != 1) {
        return "";
    }
    return found;
}

fn znc_package_verify_option(name: []u8) []u8 {
    let i: i32 = 3;
    while ((i + 1) < _zag_argc()) {
        if (@strEq(_zag_arg(i), name)) {
            return _zag_arg(i + 1);
        }
        i = i + 1;
    }
    return "";
}

fn znc_package_verify() i32 {
    let index: []u8 = znc_package_verify_index_arg();
    let key: []u8 = znc_package_verify_option("--key");
    let signature: []u8 = znc_package_verify_option("--signature");
    if (((index.len == 0) || (key.len == 0)) || (signature.len == 0)) {
        _zag_eprintln("znc package verify: usage is `znc package verify <index> --key <public.pem> --signature <signature.bin>`");
        return 2;
    }
    if (package_signature_verify_files(index, key, signature) == 0) {
        _zag_eprintln("znc package verify: detached Ed25519 signature or canonical signed index is invalid");
        return 1;
    }
    _zag_println("znc package verify: detached Ed25519 signature verified");
    return 0;
}

fn znc_zagd_suggest(operation: []u8) i32 {
    let root: []u8 = znc_project_root(".");
    if (znc_invalid_project_config(root, operation) == 1) {
        return 2;
    }
    let status: []u8 = _zag_read_file(_zag_str_concat(root, "/.zagd.status"));
    let manifest_text: []u8 = _zag_read_file(_zag_str_concat(root, "/.zag-cache/zagd/semantic.record"));
    let manifest: SemanticManifestView = semantic_manifest_decode(manifest_text);
    let json: i32 = znc_output_format();
    if (json < 0) {
        _zag_eprintln("znc suggest: --format must be text or json");
        return 2;
    }
    if (((status.len < 0) || (znc_zagd_lock_alive(root) == 0)) || (manifest.valid == 0)) {
        if (json == 1) {
            _zag_println("{\"advisory\":true,\"available\":false,\"source_changes\":false}");
        } else {
            _zag_println("zagd suggest: no active snapshot; regular Zag remains unchanged");
        }
        return 0;
    }
    if (znc_manifest_modules_current(root, manifest_text) == 0) {
        if (json == 1) {
            _zag_println("{\"advisory\":true,\"available\":false,\"reason\":\"stale-module-graph\",\"source_changes\":false}");
        } else {
            _zag_println("zagd suggest: semantic/module snapshot is stale; no recommendation used");
        }
        return 0;
    }
    let script: i32 = @strEq(smf_value(manifest_text, "profile"), "script") as i32;
    let detail_level: []u8 = smf_value(manifest_text, "detail_level");
    if (detail_level.len == 0) {
        detail_level = "legacy-full";
    }
    let detailed_witnesses: i32 = 1 - @strEq(detail_level, "compact") as i32;
    let recs: []u8 = "";
    let count: i32 = 0;
    let supported_count: i32 = 0;
    let constants: i32 = semantic_manifest_constant_count(manifest_text);
    if (constants > 0) {
        znc_suggest_add(&recs, &count, &supported_count, 0, znc_suggest_rec_json("constant-return-fold", 0, 0, 100, "proven", _zag_str_concat(_zag_i64_to_str(constants), " constant-return declaration(s)"), "none; ordinary backend optimization remains independent", "current semantic manifest and module graph", "no planner-owned transformation and equivalence-revalidation pipeline"));
    }
    let leaves: i32 = znc_manifest_fact_count(manifest_text, "\teffect_free=1\tleaf=1");
    if (leaves > 0) {
        znc_suggest_add(&recs, &count, &supported_count, 0, znc_suggest_rec_json("pure-leaf-inline", 0, 0, 100, "proven", _zag_str_concat(_zag_i64_to_str(leaves), " effect-free leaf declaration(s)"), "none; ordinary backend optimization remains independent", "current semantic manifest and module graph", "no planner-owned inline transformation and equivalence-revalidation pipeline"));
    }
    let allocs: i32 = znc_manifest_fact_count(manifest_text, "\talloc=1");
    if (allocs > 0) {
        znc_suggest_add(&recs, &count, &supported_count, 1, znc_suggest_rec_json("allocation-review", 1, 0, 100, "proven", _zag_str_concat(_zag_i64_to_str(allocs), " allocation-effect declaration(s); no lifetime or byte-size inference"), "review explicit allocator and lifetime policy", "current checksum-bound semantic manifest and module graph", ""));
    }
    let buffer_lifetimes: SemanticBufferLifetimeFacts = semantic_manifest_buffer_lifetime_facts(manifest_text);
    if ((buffer_lifetimes.valid == 1) && (buffer_lifetimes.pairs > 0)) {
        let evidence: []u8 = _zag_str_concat(_zag_i64_to_str(buffer_lifetimes.pairs), _zag_str_concat(" statement-ordered disjoint local raw-buffer pair(s); largest exact shared capacity ", _zag_str_concat(_zag_i64_to_str(buffer_lifetimes.reusable_bytes), " byte(s)")));
        znc_suggest_add(&recs, &count, &supported_count, 1, znc_suggest_rec_json("proven-buffer-lifetimes", 1, 0, 100, "proven-foreground-ast", evidence, "review an explicit buffer-reuse refactor; no transform is applied", "Linux x86-64 local []f32/[]i32 raw-word allocations with constant size, exactly one direct matching free, no shadow, alias, escape, whole-buffer call exposure, control-flow crossing, or use after free, and at most 64 candidates per function", ""));
    }
    let unknown: i32 = znc_manifest_value_unknown_count(manifest_text);
    if (unknown > 0) {
        znc_suggest_add(&recs, &count, &supported_count, 1, znc_suggest_rec_json("explicit-value-types", 1, 0, 100, "derived", _zag_str_concat(_zag_i64_to_str(unknown), " unresolved local type witness(es)"), "add explicit types before strict promotion", "current checksum-bound semantic manifest and module graph", ""));
    }
    let profile_eligible: i32 = znc_profile_plan_eligible(root, manifest_text);
    if (profile_eligible >= 0) {
        znc_suggest_add(&recs, &count, &supported_count, 0, znc_suggest_rec_json("profile-guided-hot-regions", 0, 0, 100, "measured-and-derived", _zag_str_concat(_zag_i64_to_str(profile_eligible), " checksum-bound hot region(s) passed current declaration and generic-target validation"), "metadata consumed for reporting; foreground code generation remains unchanged", "exact foreground compiler image, semantic source/graph, and generic CPU target", "metadata-only consumer; no declaration-to-machine-region map"));
    }
    let candidate_cfg: PlannerConfig = znc_project_config(root, 0);
    let candidate_cpu: X86CpuProfile = parse_x86_cpu_profile("generic");
    if (script == 1) {
        candidate_cpu = parse_x86_cpu_profile(candidate_cfg.default_cpu);
    }
    let candidate_record: []u8 = _zag_read_file(_zag_str_concat(root, "/.zag-cache/zagd/candidates.record"));
    let candidate_compiler: []u8 = _zag_read_file("/proc/self/exe");
    let candidate_use: ZagdForegroundCandidateUse = zcu_bad("candidate-record-not-current");
    if (((candidate_record.len > 0) && (candidate_compiler.len > 0)) && (candidate_cpu.valid == 1)) {
        candidate_use = zagd_foreground_candidate_consume(candidate_record, manifest_text, zag_version(), zagd_content_hash(candidate_compiler), candidate_cpu.cache_key);
    }
    if (candidate_use.valid == 1) {
        znc_suggest_add(&recs, &count, &supported_count, 0, znc_suggest_rec_json("daemon-script-default-cpu", 0, 0, 100, "daemon-source-bound", "current script-default-cpu proposal passed compiler, semantic graph, and target binding", "metadata consumed for review; foreground lowering remains unchanged", "checksummed candidate row 51, exact compiler image, current semantic source/graph, and target", "daemon candidate proposals do not yet authorize an executable transform"));
    }
    if (candidate_record.len >= 0) {
        _zag_free(_zag_slice_ptr(candidate_record));
    }
    if (candidate_compiler.len >= 0) {
        _zag_free(_zag_slice_ptr(candidate_compiler));
    }
    let script_allocator: i32 = 0;
    let script_device: i32 = 0;
    let script_layout: i32 = 0;
    let script_cpu: i32 = 0;
    if (script == 1) {
        let cfg: PlannerConfig = znc_project_config(root, 0);
        let explicit: PlannerChoices = znc_script_explicit_choices();
        if (explicit.allocator_explicit == 0) {
            script_allocator = znc_script_default_supported("script-default-allocator", cfg.default_allocator);
            let rejected: []u8 = "";
            if (script_allocator == 0) {
                rejected = "configured allocator is not implemented by the current Script runtime";
            }
            znc_suggest_add(&recs, &count, &supported_count, script_allocator, znc_suggest_rec_json("script-default-allocator", script_allocator, script_allocator, 100, "derived", "allocator unspecified", _zag_str_concat("configured default ", cfg.default_allocator), "project configuration plus current Script runtime", rejected));
        }
        if (explicit.device_explicit == 0) {
            script_device = znc_script_default_supported("script-default-device", cfg.default_device);
            let rejected: []u8 = "";
            if (script_device == 0) {
                rejected = "configured device is not implemented by the current Script runtime";
            }
            znc_suggest_add(&recs, &count, &supported_count, script_device, znc_suggest_rec_json("script-default-device", script_device, script_device, 100, "derived", "device unspecified", _zag_str_concat("configured default ", cfg.default_device), "project configuration plus current Script runtime", rejected));
        }
        if (explicit.layout_explicit == 0) {
            script_layout = znc_script_default_supported("script-default-layout", cfg.default_layout);
            let rejected: []u8 = "";
            if (script_layout == 0) {
                rejected = "configured layout is not implemented by the current Script runtime";
            }
            znc_suggest_add(&recs, &count, &supported_count, script_layout, znc_suggest_rec_json("script-default-layout", script_layout, script_layout, 100, "derived", "layout unspecified", _zag_str_concat("configured default ", cfg.default_layout), "project configuration plus current Script runtime", rejected));
        }
        if (explicit.cpu_explicit == 0) {
            script_cpu = znc_script_default_supported("script-default-cpu", cfg.default_cpu);
            let rejected: []u8 = "";
            if (script_cpu == 0) {
                rejected = "configured CPU profile is not recognized or permitted";
            }
            znc_suggest_add(&recs, &count, &supported_count, script_cpu, znc_suggest_rec_json("script-default-cpu", script_cpu, script_cpu, 100, "derived", "CPU profile unspecified", _zag_str_concat("configured default ", cfg.default_cpu), "project configuration plus implemented x86 CPU profiles", rejected));
        }
    }
    if (json == 1) {
        _zag_println(_zag_str_concat("{\"advisory\":true,\"available\":true,\"profile\":\"", _zag_str_concat(smf_value(manifest_text, "profile"), _zag_str_concat("\",\"detail_level\":\"", _zag_str_concat(detail_level, _zag_str_concat("\",\"expression_witnesses_available\":", _zag_str_concat(znc_json_bool(detailed_witnesses), _zag_str_concat(",\"buffer_lifetime_witnesses_available\":", _zag_str_concat(znc_json_bool(detailed_witnesses), _zag_str_concat(",\"source_changes\":false,\"checksum_bound\":true,\"module_graph_current\":true,\"recommendation_count\":", _zag_str_concat(_zag_i64_to_str(count), _zag_str_concat(",\"supported_count\":", _zag_str_concat(_zag_i64_to_str(supported_count), _zag_str_concat(",\"recommendations\":[", _zag_str_concat(recs, "]}")))))))))))))));
        return 0;
    }
    _zag_println(_zag_str_concat("zagd suggestions: profile=", _zag_str_concat(smf_value(manifest_text, "profile"), _zag_str_concat(" detail-level=", _zag_str_concat(detail_level, _zag_str_concat(" checksum-bound=true module-graph-current=true source_changes=false count=", _zag_str_concat(_zag_i64_to_str(count), _zag_str_concat(" supported=", _zag_i64_to_str(supported_count)))))))));
    if (detailed_witnesses == 0) {
        _zag_println("  compact detail: expression/value/copy and local buffer-lifetime witnesses unavailable; no recommendation is inferred from their omission");
    }
    if (constants > 0) {
        znc_suggest_text_line("constant-return-fold", 0, 0, "proven", "current semantic manifest and module graph", "no planner-owned transformation and equivalence-revalidation pipeline");
    }
    if (leaves > 0) {
        znc_suggest_text_line("pure-leaf-inline", 0, 0, "proven", "current semantic manifest and module graph", "no planner-owned inline transformation and equivalence-revalidation pipeline");
    }
    if (allocs > 0) {
        znc_suggest_text_line("allocation-review", 1, 0, "proven", "current checksum-bound semantic manifest and module graph", "");
    }
    if ((buffer_lifetimes.valid == 1) && (buffer_lifetimes.pairs > 0)) {
        znc_suggest_text_line("proven-buffer-lifetimes", 1, 0, "proven-foreground-ast", "Linux x86-64 local constant raw-word allocations with unique direct frees, no alias, escape, call exposure, control-flow crossing, or use after free, and at most 64 candidates per function", "");
    }
    if (unknown > 0) {
        znc_suggest_text_line("explicit-value-types", 1, 0, "derived", "current checksum-bound semantic manifest and module graph", "");
    }
    if (profile_eligible >= 0) {
        znc_suggest_text_line("profile-guided-hot-regions", 0, 0, "measured-and-derived", "exact foreground compiler image, semantic source/graph, and generic CPU target", "metadata-only consumer; no declaration-to-machine-region map");
    }
    if (candidate_use.valid == 1) {
        znc_suggest_text_line("daemon-script-default-cpu", 0, 0, "daemon-source-bound", "checksummed candidate row 51, exact compiler image, current semantic source/graph, and target", "daemon candidate proposals do not yet authorize an executable transform");
    }
    if (script == 1) {
        let cfg: PlannerConfig = znc_project_config(root, 0);
        let explicit: PlannerChoices = znc_script_explicit_choices();
        if (explicit.allocator_explicit == 0) {
            let r: []u8 = "";
            if (script_allocator == 0) {
                r = "configured allocator is not implemented by the current Script runtime";
            }
            znc_suggest_text_line("script-default-allocator", script_allocator, script_allocator, "derived", "project configuration plus current Script runtime", r);
        }
        if (explicit.device_explicit == 0) {
            let r: []u8 = "";
            if (script_device == 0) {
                r = "configured device is not implemented by the current Script runtime";
            }
            znc_suggest_text_line("script-default-device", script_device, script_device, "derived", "project configuration plus current Script runtime", r);
        }
        if (explicit.layout_explicit == 0) {
            let r: []u8 = "";
            if (script_layout == 0) {
                r = "configured layout is not implemented by the current Script runtime";
            }
            znc_suggest_text_line("script-default-layout", script_layout, script_layout, "derived", "project configuration plus current Script runtime", r);
        }
        if (explicit.cpu_explicit == 0) {
            let r: []u8 = "";
            if (script_cpu == 0) {
                r = "configured CPU profile is not recognized or permitted";
            }
            znc_suggest_text_line("script-default-cpu", script_cpu, script_cpu, "derived", "project configuration plus implemented x86 CPU profiles", r);
        }
    }
    return 0;
}

fn znc_write_hotlen(clen: i32, dlen: i32) void {
    let _a: i32 = _zag_write_file(".zag_hotlen", _zag_i64_to_str(clen as i64));
    let _b: i32 = _zag_write_file(".zag_hotdlen", _zag_i64_to_str(dlen as i64));
    _zag_println("znc: [--hot] recorded layout in .zag_hotlen — after edits run `znc hot-patch <src>`; the running program swaps it in live");
}

fn znc_hot_patch(path: []u8) i32 {
    if (path.len == 0) {
        _zag_println("znc hot-patch: no source file");
        return 1;
    }
    if (v2_validate_options() != 0) {
        return 1;
    }
    if (foreground_transform_requested() == 1) {
        _zag_eprintln("znc hot-patch: --foreground-transform is not supported for live text patches");
        return 1;
    }
    if (((i686_target() == 1) || (validate_x86_target_flag() != 0)) || (validate_x86_cpu_flag() != 0)) {
        return 1;
    }
    if (((has_flag("--dynamic") == 1) || (has_flag("--emit-obj") == 1)) || (has_flag("--emit-static") == 1)) {
        _zag_eprintln("znc hot-patch: dynamic, object, and archive output modes cannot be staged as a live native text patch");
        return 1;
    }
    if (znc_invalid_project_config(znc_project_root(dir_of(path)), "hot-patch") == 1) {
        return 1;
    }
    let src: []u8 = _zag_read_file(path);
    if (src.len < 0) {
        _zag_print("znc hot-patch: cannot read ");
        _zag_println(path);
        return 1;
    }
    src = znc_activate_script_source(path, src, 0);
    if (znc_validate_compilation_source(path, src) != 0) {
        return 1;
    }
    let unit: CompilationUnit = parse_compilation_unit_dir(src, dir_of(path));
    if (((znc_validate_script_defaults(path, unit) != 0) || (znc_configure_script_unit(&unit, path) != 0)) || (znc_validate_script_capabilities(path, unit) != 0)) {
        return 1;
    }
    if ((unit.profile == ModuleProfile.script) && (((znc_script_std_body_check(unit.decls) != 0) || (znc_script_lifetime_check(unit.decls) != 0)) || (znc_script_unaccounted_root_make(unit.decls) != 0))) {
        return 1;
    }
    let decls: ArrayList[*Node] = unit.decls;
    lo_operators(decls);
    if (znc_check_arity(decls) > 0) {
        _zag_println("znc: arity check FAILED");
        return 1;
    }
    if (znc_check_dups(decls) > 0) {
        _zag_println("znc: duplicate-definition check FAILED");
        return 1;
    }
    if (typed_check_program(decls, path) > 0) {
        return 1;
    }
    let eff: map__StringMap[i32] = analyze(decls);
    if (report_violations(decls, eff, src, path) > 0) {
        znc_emit_total_cex(decls, eff);
        _zag_println("znc: capability check FAILED");
        return 1;
    }
    smt_report_proofs(decls, eff);
    if (run_analyzer(decls, path) != 0) {
        return 1;
    }
    let link_libs: ArrayList[[]u8] = make[[]u8](4);
    let lib_paths: ArrayList[[]u8] = make[[]u8](4);
    let code_decls: ArrayList[*Node] = znc_collect_links(decls, &link_libs);
    znc_argv_links(&link_libs);
    znc_argv_paths(&lib_paths);
    znc_load_zagmod(dir_of(path), &link_libs, &lib_paths);
    if (link_libs.len > 0) {
        _zag_eprintln("znc hot-patch: static archive linking is not supported by raw live text patches");
        return 1;
    }
    let hot_zir_authority: ZirAuthority = zir_prepare_production_with_origins(code_decls, eff, unit.origins);
    if (hot_zir_authority.valid == 0) {
        _zag_eprintln(_zag_str_concat("znc hot-patch: Zag IR verification failed; errors=", _zag_i64_to_str(hot_zir_authority.verify_errors as i64)));
        return 1;
    }
    let selected_cpu: X86CpuProfile = parse_x86_cpu_profile(znc_effective_cpu(path, (unit.profile == ModuleProfile.script) as i32));
    if (selected_cpu.valid == 0) {
        _zag_eprintln(_zag_str_concat("znc: ", selected_cpu.diagnostic));
        return 1;
    }
    let sanitize_memory: i32 = has_flag("--sanitize=memory");
    let safety_checked: i32 = has_flag("--safety=checked") | sanitize_memory;
    let v2_edition: i32 = @strEq(v2_project_edition(path), "2027") as i32;
    let nerr: i32 = 0;
    let data: ArrayList[u8] = make[u8](16);
    let prog: ArrayList[Instr] = lower_zir_program_mode_cpu(hot_zir_authority, &nerr, &data, 0, selected_cpu.features.popcnt, selected_cpu.features.bmi1, safety_checked, sanitize_memory, v2_edition, 0);
    if (nerr > 0) {
        _zag_println("znc hot-patch: build failed — unsupported constructs (see messages above)");
        return 1;
    }
    let hp_prog2: ArrayList[Instr] = regalloc(prog);
    let hp_prog3: ArrayList[Instr] = optimize(hp_prog2);
    let hp_opt: ArrayList[Instr] = peephole(hp_prog3);
    let code: ArrayList[u8] = encode(hp_opt);
    free[Instr](&prog);
    free[Instr](&hp_prog2);
    free[Instr](&hp_prog3);
    free[Instr](&hp_opt);
    let want_c: []u8 = _zag_read_file(".zag_hotlen");
    if (want_c.len <= 0) {
        _zag_println("znc hot-patch: no .zag_hotlen found — build the program with `--hot` first");
        return 1;
    }
    let got_c: []u8 = _zag_i64_to_str(code.len as i64);
    if (@strEq(want_c, got_c) == 0) {
        _zag_println("znc hot-patch: edit changed the compiled code size — rebuild required (hot-patch only applies layout-preserving edits, e.g. changing a constant)");
        return 1;
    }
    let want_d: []u8 = _zag_read_file(".zag_hotdlen");
    let got_d: []u8 = _zag_i64_to_str(data.len as i64);
    if ((want_d.len > 0) && (@strEq(want_d, got_d) == 0)) {
        _zag_println("znc hot-patch: edit changed the data/string layout — rebuild required");
        return 1;
    }
    let wrc: i32 = _zag_write_file(".zag_hotpatch", code.data[0..code.len]);
    if (wrc != 0) {
        _zag_println("znc hot-patch: failed to write .zag_hotpatch");
        return 1;
    }
    _zag_print("znc hot-patch: staged ");
    _zag_print(got_c);
    _zag_println(" bytes → .zag_hotpatch (the running process swaps it in on its next zag_hot_wait())");
    return 0;
}

fn znc_print_help() void {
    _zag_println("usage: znc <source.zag> [-o out] [-l lib] [-L path] [--run] [--debug]");
    _zag_println("       znc <source.zag> --dynamic --needed libNAME.so.N [-o out] [--run]");
    _zag_println("       znc <source.zag> --target gpu-nvidia|gpu-amd|gpu-vulkan|amdgpu-gfx1010");
    _zag_println("       znc <source.zag> --target vulkan-compat|opencl-compat|metal-compat|opengl-compat|cuda-compat");
    _zag_println("       znc <source.zag> --target wasm [-o out.wasm] [--run]");
    _zag_println("       znc <source.zag> --target arm64 [-o out] [--run]");
    _zag_println("       znc <driver.zag> --emit-driver-module --driver-kernel 6.1|6.6 --target x86_64|arm64|i686 -o driver.o");
    _zag_println("       znc script <source.zag> [-o out] [--run]");
    _zag_println("         [--script-allocator script_process_arena|script_bounded_heap]");
    _zag_println("       znc explain <source.zag> [--format text|json]");
    _zag_println("       znc harden <source.zag> [--output candidate.zag]   # deprecated: compatibility alias for explicit expansion");
    _zag_println("       znc view <source.zs> --level simple|explained|explicit|native");
    _zag_println("       znc expand <source.zs> --to simple|explained|explicit|native [--output path]");
    _zag_println("       znc promote <source.zs> --to explicit --output path --test-command command");
    _zag_println("       znc unexpand <derived.zag> [--output compact.zs]");
    _zag_println("       znc package lock <source.zag> [--output zag.lock]   # create-only explicit vendor graph");
    _zag_println("       znc package registry-lock <source.zag> [--output registry.lock]   # create-only local registry selection");
    _zag_println("       znc check <source.zag> [--strict]");
    _zag_println("       znc watch [--mode off|light|adaptive|deep]");
    _zag_println("       znc status | shutdown | suggest");
    _zag_println("       znc verifier approve FIRST:SECOND:BYTES [--root project]");
    _zag_println("       znc clean-cache [path]            (purge .zag-cache and stop daemon)");
    _zag_println("       znc optimize --preview [--format text|json]");
    _zag_println("       znc optimize --accept const-i32-add-v1|const-i32-neg-v1|const-i64-add-v1|const-bool-cmp-v1 <source.zag> -o <artifact> [--from-zagd]");
    _zag_println("       znc [build] --hot <source.zag> [-o out]   (hot-reloadable build)");
    _zag_println("       znc hot-patch <source.zag>                (stage a live code patch)");
    _zag_println("       znc fmt [--in-place] <source.zag>");
    _zag_println("       znc init [--name project-name]");
    _zag_println("       znc version");
    _zag_println("  analyzer (leak + efficiency + bloat + agent-bug lints) runs by default:");
    _zag_println("    --no-analyze        disable the analyzer");
    _zag_println("    --no-zagd           skip background planning for this invocation");
    _zag_println("    --no-zagd-profile   skip advisory foreground profile metadata");
    _zag_println("    --profile-report    report profile metadata hit/miss and authority");
    _zag_println("    --no-foreground-cache force fresh backend lowering (recovery/testing)");
    _zag_println("    --cache-report      report validated hit/miss, lowering count, and substitution");
    _zag_println("    --foreground-transform const-i32-add-v1  explicitly opt into the checked i32-add rule");
    _zag_println("    --foreground-transform const-i32-neg-v1  explicitly opt into the checked i32 unary-negation rule");
    _zag_println("    --foreground-transform const-i64-add-v1  explicitly opt into the checked non-overflowing i64-add rule");
    _zag_println("    --foreground-transform const-bool-cmp-v1  explicitly opt into the checked pure bool predicate rule");
    _zag_println("    --analyze-strict    treat analyzer findings as errors");
    _zag_println("    --analyze-pedantic  also emit strength-reduction and tier-2 bloat/agent hints");
    _zag_println("    --analyze-str-consumer NAME  register an app helper that frees its");
    _zag_println("                        string args (repeatable; e.g. append_ff)");
    _zag_println("    --analyze-bloat=off disable bloat lints (B0xxx: dead code, verbose patterns)");
    _zag_println("    --analyze-agent=off disable agent-bug lints (A0xxx: off-by-one, ignored return)");
    _zag_println("    --analyze-deps      include imported dependency source in analyzer output");
    _zag_println("    --analyze-complexity=N  set B0115 complexity threshold (default 15)");
    _zag_println("    // znc:allow CODE   suppress a lint on this line (or znc:allow-file for file)");
    _zag_println("  compiles Zag to native x86-64 ELF — dynamic mode still uses no cc/as/ld");
    _zag_println("  start: znc init && znc src/main.zag -o app --run");
    _zag_println("  deps: explicit local/vendored @import paths; no package registry or network resolver; offline registry-index mode is bounded");
    _zag_println("  support: docs/SUPPORT.md in the Zag distribution defines exact target and language boundaries");
}

fn znc_source_path_command(cmd: []u8) i32 {
    if ((cmd.len > 3) && @strEq(cmd[cmd.len - 4..cmd.len], ".zag")) {
        return 1;
    }
    if ((cmd.len > 2) && @strEq(cmd[cmd.len - 3..cmd.len], ".zs")) {
        return 1;
    }
    return 0;
}

fn znc_policy_command_preflight(cmd: []u8) i32 {
    if (((((!@strEq(cmd, "view") && !@strEq(cmd, "expand")) && !@strEq(cmd, "promote")) && !@strEq(cmd, "suggest")) && !@strEq(cmd, "optimize")) && !@strEq(cmd, "watch")) {
        return 0;
    }
    let path: []u8 = first_nonflag_from(2);
    let root: []u8 = ".";
    if ((((path.len > 0) && !@strEq(cmd, "suggest")) && !@strEq(cmd, "optimize")) && !@strEq(cmd, "watch")) {
        root = znc_project_root(dir_of(path));
    } else {
        root = znc_project_root(".");
    }
    return znc_invalid_project_config(root, cmd);
}

fn znc_verifier_approve() i32 {
    if ((_zag_argc() < 4) || !@strEq(_zag_arg(2), "approve")) {
        _zag_eprintln("znc verifier: usage is `znc verifier approve FIRST:SECOND:BYTES [--root PROJECT]`");
        return 2;
    }
    let generation: []u8 = _zag_arg(3);
    let root: []u8 = znc_project_root(".");
    let i: i32 = 4;
    while (i < _zag_argc()) {
        if (@strEq(_zag_arg(i), "--root") && ((i + 1) < _zag_argc())) {
            root = _zag_arg(i + 1);
            i = i + 2;
        } else {
            _zag_eprintln(_zag_str_concat("znc verifier: unknown or incomplete argument: ", _zag_arg(i)));
            return 2;
        }
    }
    let daemon: []u8 = znc_sibling_zagd();
    if (_zag_file_exists(daemon) == 0) {
        _zag_eprintln("znc verifier: sibling zagd executable is missing");
        return 1;
    }
    let command: []u8 = znc_shell_quote(daemon);
    command = _zag_str_concat(command, _zag_str_concat(" --verifier-approve ", znc_shell_quote(generation)));
    command = _zag_str_concat(command, _zag_str_concat(" --root ", znc_shell_quote(root)));
    let rc: i32 = _zag_exec_cmd(command);
    if (rc != 0) {
        _zag_eprintln("znc verifier: reviewed approval was rejected; no execution authority was changed");
        return rc;
    }
    _zag_println("znc verifier: reviewed approval recorded; execution remains disabled");
    return 0;
}

fn main() i32 {
    if (_zag_argc() < 2) {
        znc_print_help();
        return 0;
    }
    let cmd: []u8 = _zag_arg(1);
    if ((@strEq(cmd, "help") || @strEq(cmd, "--help")) || @strEq(cmd, "-h")) {
        znc_print_help();
        return 0;
    }
    if ((@strEq(cmd, "version") || @strEq(cmd, "--version")) || @strEq(cmd, "-v")) {
        _zag_print("znc ");
        _zag_print(zag_version());
        _zag_print(" (edition ");
        _zag_print(zag_edition());
        _zag_println(")");
        return 0;
    }
    if (((((((foreground_transform_requested() == 1) && !@strEq(cmd, "view")) && !@strEq(cmd, "expand")) && !@strEq(cmd, "check")) && !@strEq(cmd, "script")) && !@strEq(cmd, "build")) && (znc_source_path_command(cmd) == 0)) {
        _zag_eprintln("znc: --foreground-transform is supported only for native foreground builds and native views/expansions");
        return 1;
    }
    if (znc_policy_command_preflight(cmd) != 0) {
        return 1;
    }
    if (@strEq(cmd, "fmt")) {
        let in_place: i32 = has_flag("--in-place");
        let fpath: []u8 = "";
        let fi: i32 = 2;
        let finding: i32 = 1;
        while ((finding == 1) && (fi < _zag_argc())) {
            let arg: []u8 = _zag_arg(fi);
            if ((arg.len > 0) && (arg[0] != 45)) {
                fpath = arg;
                finding = 0;
            } else {
                fi = fi + 1;
            }
        }
        return znc_fmt(fpath, in_place);
    }
    if (@strEq(cmd, "init")) {
        return znc_init();
    }
    if (@strEq(cmd, "watch")) {
        return znc_watch();
    }
    if (@strEq(cmd, "status")) {
        return znc_zagd_status();
    }
    if (@strEq(cmd, "shutdown")) {
        return znc_zagd_shutdown();
    }
    if (@strEq(cmd, "verifier")) {
        return znc_verifier_approve();
    }
    if (@strEq(cmd, "suggest")) {
        return znc_zagd_suggest("suggest");
    }
    if (@strEq(cmd, "optimize")) {
        return znc_optimize_preview();
    }
    if (@strEq(cmd, "view")) {
        return znc_view(first_nonflag_from(2));
    }
    if (@strEq(cmd, "expand")) {
        return znc_expand(first_nonflag_from(2));
    }
    if (@strEq(cmd, "promote")) {
        return znc_promote(first_nonflag_from(2));
    }
    if (@strEq(cmd, "unexpand")) {
        return znc_unexpand(first_nonflag_from(2));
    }
    if (@strEq(cmd, "package")) {
        if (_zag_argc() < 3) {
            _zag_eprintln("znc package: use `lock`, `registry-lock`, or `verify`");
            return 2;
        }
        if (@strEq(_zag_arg(2), "lock")) {
            return znc_package_lock();
        }
        if (@strEq(_zag_arg(2), "registry-lock")) {
            return znc_package_registry_lock();
        }
        if (@strEq(_zag_arg(2), "verify")) {
            return znc_package_verify();
        }
        _zag_eprintln("znc package: use `lock`, `registry-lock`, or `verify`");
        return 2;
    }
    if (@strEq(cmd, "hot-patch")) {
        return znc_hot_patch(first_nonflag_from(2));
    }
    if (@strEq(cmd, "clean-cache")) {
        let cpath: []u8 = first_nonflag_from(2);
        if (cpath.len == 0) {
            cpath = ".";
        }
        let root: []u8 = znc_project_root(cpath);
        znc_cache_purge(root);
        let _stopped: i32 = znc_zagd_exec(root, "off", 100, 0);
        _zag_println("znc: cache purged");
        return 0;
    }
    if (@strEq(cmd, "explain")) {
        let epath: []u8 = first_nonflag_from(2);
        if ((epath.len > 0) && (znc_zagd_ensure(znc_project_root(dir_of(epath)), epath, "explain") != 0)) {
            return 1;
        }
        return znc_explain(epath);
    }
    if (@strEq(cmd, "harden")) {
        let hpath: []u8 = first_nonflag_from(2);
        _zag_eprintln("warning: `harden` is deprecated; use `znc view/expand --to explicit` for compatibility-stable source expansion");
        if (znc_harden_legacy_apply_refused() == 1) {
            return 2;
        }
        if ((hpath.len > 0) && (znc_zagd_ensure(znc_project_root(dir_of(hpath)), hpath, "promotion") != 0)) {
            return 1;
        }
        return znc_harden(hpath);
    }
    if (@strEq(cmd, "check")) {
        if (foreground_transform_requested() == 1) {
            _zag_eprintln("znc check: --foreground-transform is a build/view option, not a check option");
            return 1;
        }
        if (v2_validate_options() != 0) {
            return 1;
        }
        let cpath: []u8 = "";
        if (_zag_argc() >= 3) {
            cpath = _zag_arg(2);
        }
        if ((cpath.len > 0) && (znc_zagd_ensure(znc_project_root(dir_of(cpath)), cpath, "source") != 0)) {
            return 1;
        }
        return znc_check(cpath);
    }
    if (v2_validate_options() != 0) {
        return 1;
    }
    let path: []u8 = src_arg();
    if (path.len == 0) {
        _zag_println("znc: no source file");
        return 1;
    }
    znc_cache_version_check(znc_project_root(dir_of(path)));
    if (znc_zagd_ensure(znc_project_root(dir_of(path)), path, "source") != 0) {
        return 1;
    }
    let gtarget: []u8 = gpu_target();
    let ctarget: []u8 = compat_target();
    if (((has_flag("--safety=checked") == 1) || (has_flag("--sanitize=memory") == 1)) && (((((gtarget.len > 0) || (gfx1010_target() == 1)) || (wasm_target() == 1)) || (i686_target() == 1)) || (ctarget.len > 0))) {
        _zag_eprintln("E0202: checked safety and --sanitize=memory are implemented only for the native x86-64 and arm64 targets");
        _zag_eprintln("note: the requested target has no checked raw-pointer or memory-sanitizer lowering; no executable was emitted");
        return 1;
    }
    if (gtarget.len > 0) {
        if (znc_reject_v2_cabi_non_native(path) != 0) {
            return 1;
        }
        return build_gpu(path, gtarget);
    }
    if (gfx1010_target() == 1) {
        if (znc_reject_v2_cabi_non_native(path) != 0) {
            return 1;
        }
        return build_gfx1010(path);
    }
    if (ctarget.len > 0) {
        if (znc_reject_v2_cabi_non_native(path) != 0) {
            return 1;
        }
        return build_compat(path, ctarget);
    }
    if (wasm_target() == 1) {
        if (znc_reject_v2_cabi_non_native(path) != 0) {
            return 1;
        }
        return build_wasm(path);
    }
    if (arm64_target() == 1) {
        if (znc_reject_v2_cabi_non_native(path) != 0) {
            return 1;
        }
        return build_arm64(path);
    }
    if (i686_target() == 1) {
        if (znc_reject_v2_cabi_non_native(path) != 0) {
            return 1;
        }
        return build_i686_minimal(path);
    }
    if (validate_x86_target_flag() != 0) {
        return 1;
    }
    if (validate_x86_cpu_flag() != 0) {
        return 1;
    }
    if (has_flag("--emit-static") == 1) {
        _zag_eprintln("znc: native x86-64 --emit-obj/--emit-static is not implemented; no artifact was emitted");
        _zag_eprintln("note: current x86-64 output is ET_EXEC without a section or public-symbol table; use the separately bounded i686 object path only for its documented ABI");
        return 1;
    }
    let src: []u8 = _zag_read_file(path);
    if (src.len < 0) {
        _zag_print("znc: cannot read ");
        _zag_println(path);
        return 1;
    }
    src = znc_activate_script_source(path, src, @strEq(cmd, "script") as i32);
    if (znc_validate_compilation_source(path, src) != 0) {
        return 1;
    }
