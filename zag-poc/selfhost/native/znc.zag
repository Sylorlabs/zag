        }
        return @strEq(name, "_zag_exit") as i32;
    }
    if (kind == 11) {
        return @strEq(name, "_zag_exit") as i32;
    }
    return 0;
}

fn znc_script_std_calls_expr(n: *Node, kind: i32, owner: []u8, decls: ArrayList[*Node], report: i32) i32 {
    let errors: i32 = 0;
    switch (n.*) {
        .call => |x| {
            let name: []u8 = callee_name(x.callee);
            if ((znc_script_std_runtime_call(kind, owner, name) == 0) && (znc_script_compiler_std_call(decls, name) == 0)) {
                if (report == 1) {
                    let shown: []u8 = name;
                    if (shown.len == 0) {
                        shown = "<indirect>";
                    }
                    _zag_eprintln(_zag_str_concat("znc script helper body: compiler-owned helper `", _zag_str_concat(owner, _zag_str_concat("` calls an unapproved allocator, runtime, extern, or helper `", _zag_str_concat(shown, "`")))));
                }
                errors = errors + 1;
            }
            let i: i32 = 0;
            while (i < x.args.len) {
                errors = errors + znc_script_std_calls_expr(x.args.data[i], kind, owner, decls, report);
                i = i + 1;
            }
        }
        .bin => |x| {
            errors = (errors + znc_script_std_calls_expr(x.l, kind, owner, decls, report)) + znc_script_std_calls_expr(x.r, kind, owner, decls, report);
        }
        .un => |x| {
            errors = errors + znc_script_std_calls_expr(x.e, kind, owner, decls, report);
        }
        .fld => |x| {
            errors = errors + znc_script_std_calls_expr(x.base, kind, owner, decls, report);
        }
        .idx => |x| {
            errors = (errors + znc_script_std_calls_expr(x.base, kind, owner, decls, report)) + znc_script_std_calls_expr(x.idx, kind, owner, decls, report);
        }
        .cast_ => |x| {
            errors = errors + znc_script_std_calls_expr(x.expr, kind, owner, decls, report);
        }
        .slice_ => |x| {
            errors = (errors + znc_script_std_calls_expr(x.base, kind, owner, decls, report)) + znc_script_std_calls_expr(x.lo, kind, owner, decls, report);
            if (x.has_hi == 1) {
                errors = errors + znc_script_std_calls_expr(x.hi, kind, owner, decls, report);
            }
        }
        .slit_ => |x| {
            let i: i32 = 0;
            while (i < x.fields.len) {
                errors = errors + znc_script_std_calls_expr(x.fields.data[i].val, kind, owner, decls, report);
                i = i + 1;
            }
        }
        .switch_ => |x| {
            errors = errors + znc_script_std_calls_expr(x.subject, kind, owner, decls, report);
            let ai: i32 = 0;
            while (ai < x.arms.len) {
                errors = errors + znc_script_std_calls_body(x.arms.data[ai].body, kind, owner, decls, report);
                ai = ai + 1;
            }
            errors = errors + znc_script_std_calls_body(x.els_body, kind, owner, decls, report);
        }
        else => {
        }
    }
    return errors;
}

fn znc_script_std_calls_body(body: ArrayList[*Node], kind: i32, owner: []u8, decls: ArrayList[*Node], report: i32) i32 {
    let errors: i32 = 0;
    let i: i32 = 0;
    while (i < body.len) {
        switch (body.data[i].*) {
            .let_ => |x| {
                if (x.has_init == 1) {
                    errors = errors + znc_script_std_calls_expr(x.expr, kind, owner, decls, report);
                }
            }
            .ret => |x| {
                if (x.has_expr == 1) {
                    errors = errors + znc_script_std_calls_expr(x.expr, kind, owner, decls, report);
                }
            }
            .estmt => |x| {
                errors = errors + znc_script_std_calls_expr(x.expr, kind, owner, decls, report);
            }
            .assign => |x| {
                errors = (errors + znc_script_std_calls_expr(x.target, kind, owner, decls, report)) + znc_script_std_calls_expr(x.expr, kind, owner, decls, report);
            }
            .if_ => |x| {
                errors = ((errors + znc_script_std_calls_expr(x.cond, kind, owner, decls, report)) + znc_script_std_calls_body(x.then_body, kind, owner, decls, report)) + znc_script_std_calls_body(x.els_body, kind, owner, decls, report);
            }
            .while_ => |x| {
                errors = (errors + znc_script_std_calls_expr(x.cond, kind, owner, decls, report)) + znc_script_std_calls_body(x.body, kind, owner, decls, report);
            }
            .unsafe_ => |x| {
                errors = errors + znc_script_std_calls_body(x.body, kind, owner, decls, report);
            }
            .switch_ => |x| {
                errors = errors + znc_script_std_calls_expr(x.subject, kind, owner, decls, report);
                let ai: i32 = 0;
                while (ai < x.arms.len) {
                    errors = errors + znc_script_std_calls_body(x.arms.data[ai].body, kind, owner, decls, report);
                    ai = ai + 1;
                }
                errors = errors + znc_script_std_calls_body(x.els_body, kind, owner, decls, report);
            }
            else => {
            }
        }
        i = i + 1;
    }
    return errors;
}

fn znc_script_call_count_expr(n: *Node, name: []u8) i32 {
    let count: i32 = 0;
    switch (n.*) {
        .call => |x| {
            if (@strEq(callee_name(x.callee), name)) {
                count = count + 1;
