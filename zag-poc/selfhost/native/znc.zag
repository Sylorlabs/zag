                while (ai < x.arms.len) {
                    count = count + znc_script_call_count_body(x.arms.data[ai].body, name);
                    ai = ai + 1;
                }
                count = count + znc_script_call_count_body(x.els_body, name);
            }
            else => {
            }
        }
        i = i + 1;
