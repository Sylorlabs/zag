fn znc_harden_captureless_closure_supported(f: FnDecl) i32 {
    if (((f.is_extern == 1) || (f.caps != 0)) || (f.cap_names.len != 0)) {
        return 0;
    }
    // The native indirect-call lowering handles System V stack arguments after
    // the six integer registers. Keep the explicit envelope bounded, but
    // admit one stack-passed scalar argument so the view is not artificially
    // limited to register-only closures.
    if (f.params.len > 7) {
        return 0;
    }
    let bool_result: i32 = @strEq(f.ret, "bool") as i32;
    if ((((bool_result == 0) && !@strEq(f.ret, "i32")) && !@strEq(f.ret, "i64")) && !@strEq(f.ret, "f64")) {
        return 0;
    }
    let pi: i32 = 0;
    while (pi < f.params.len) {
        if ((@strEq(f.params.data[pi].pty, f.ret) == 0) || (znc_harden_closure_scalar_param(f.params, f.params.data[pi].name, f.ret) == 0)) {
            return 0;
