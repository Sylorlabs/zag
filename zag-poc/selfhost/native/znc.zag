    return count;
}

fn znc_script_read_file_stage_check(decls: ArrayList[*Node]) i32 {
    let i: i32 = 0;
    while (i < decls.len) {
        switch (decls.data[i].*) {
            .fn_decl => |f| {
                if (@strEq(f.name, "script_read_file") && (znc_script_std_origin_kind(f.origin) == 2)) {
                    if (((((znc_script_call_count_body(f.body, "_zag_read_file") != 0) || (znc_script_call_count_body(f.body, "_zag_free") != 0)) || (znc_script_call_count_body(f.body, "_zag_script_file_size") != 1)) || (znc_script_call_count_body(f.body, "_zag_script_read_file_into") != 1)) || (znc_script_call_count_body(f.body, "_zag_script_alloc") != 1)) {
                        _zag_eprintln("znc script helper body: script_read_file must preflight and read directly into exactly one Script allocation without native full-file staging");
                        return 1;
                    }
                    return 0;
                }
            }
            else => {
            }
        }
        i = i + 1;
    }
    return 0;
}

fn znc_script_closure_scan_expr(n: *Node, env: ArrayList[ZTBind], decls: ArrayList[*Node], sums: ArrayList[ZScriptLifeSummary]) i32 {
    switch (n.*) {
        .id => |x| {
            if (znc_script_closure_capture_tainted(x.name, env, decls) == 1) {
                _zag_eprintln(_zag_str_concat("znc script lifetime: Script-context value captured by closure `", _zag_str_concat(x.name, "` and would outlive its Script scope")));
                return 1;
            }
        }
        .call => |x| {
            let errors: i32 = 0;
            let i: i32 = 0;
            while (i < x.args.len) {
                errors = errors + znc_script_closure_scan_expr(x.args.data[i], env, decls, sums);
                i = i + 1;
            }
            return errors;
        }
        .bin => |x| {
            return znc_script_closure_scan_expr(x.l, env, decls, sums) + znc_script_closure_scan_expr(x.r, env, decls, sums);
        }
        .un => |x| {
            return znc_script_closure_scan_expr(x.e, env, decls, sums);
        }
        .fld => |x| {
            return znc_script_closure_scan_expr(x.base, env, decls, sums);
        }
        .idx => |x| {
            return znc_script_closure_scan_expr(x.base, env, decls, sums) + znc_script_closure_scan_expr(x.idx, env, decls, sums);
        }
        .cast_ => |x| {
            return znc_script_closure_scan_expr(x.expr, env, decls, sums);
        }
        .slice_ => |x| {
            return znc_script_closure_scan_expr(x.base, env, decls, sums) + znc_script_closure_scan_expr(x.lo, env, decls, sums);
        }
        .slit_ => |x| {
            let errors: i32 = 0;
            let i: i32 = 0;
            while (i < x.fields.len) {
                errors = errors + znc_script_closure_scan_expr(x.fields.data[i].val, env, decls, sums);
                i = i + 1;
            }
            return errors;
        }
        .switch_ => |x| {
            let errors: i32 = znc_script_closure_scan_expr(x.subject, env, decls, sums);
            let i: i32 = 0;
            while (i < x.arms.len) {
                errors = errors + znc_script_closure_scan_body(x.arms.data[i].body, env, decls, sums);
                i = i + 1;
            }
            return errors + znc_script_closure_scan_body(x.els_body, env, decls, sums);
        }
        else => {
        }
    }
    return 0;
}

fn znc_script_closure_scan_body(body: ArrayList[*Node], env: *ArrayList[ZTBind], decls: ArrayList[*Node], sums: ArrayList[ZScriptLifeSummary]) i32 {
    let errors: i32 = 0;
    let i: i32 = 0;
    while (i < body.len) {
        switch (body.data[i].*) {
            .let_ => |x| {
                if (x.has_init == 1) {
                    errors = errors + znc_script_closure_scan_expr(x.expr, env.*, decls, sums);
                    if (znc_script_tainted(x.expr, env.*, sums) == 1) {
                        znc_script_env_mark(env, x.name);
                    }
                }
            }
            .ret => |x| {
                if (x.has_expr == 1) {
                    errors = errors + znc_script_closure_scan_expr(x.expr, env.*, decls, sums);
                }
            }
            .estmt => |x| {
                errors = errors + znc_script_closure_scan_expr(x.expr, env.*, decls, sums);
            }
            .assign => |x| {
                errors = (errors + znc_script_closure_scan_expr(x.target, env.*, decls, sums)) + znc_script_closure_scan_expr(x.expr, env.*, decls, sums);
                if (znc_script_tainted(x.expr, env.*, sums) == 1) {
                    switch (x.target.*) {
                        .id => |id| {
                            znc_script_env_mark(env, id.name);
                        }
                        else => {
                        }
                    }
                }
            }
            .if_ => |x| {
                errors = ((errors + znc_script_closure_scan_expr(x.cond, env.*, decls, sums)) + znc_script_closure_scan_body(x.then_body, env, decls, sums)) + znc_script_closure_scan_body(x.els_body, env, decls, sums);
            }
            .while_ => |x| {
                errors = (errors + znc_script_closure_scan_expr(x.cond, env.*, decls, sums)) + znc_script_closure_scan_body(x.body, env, decls, sums);
            }
            .unsafe_ => |x| {
                errors = errors + znc_script_closure_scan_body(x.body, env, decls, sums);
            }
            .switch_ => |x| {
                errors = errors + znc_script_closure_scan_expr(x.subject, env.*, decls, sums);
                let ai: i32 = 0;
                while (ai < x.arms.len) {
                    errors = errors + znc_script_closure_scan_body(x.arms.data[ai].body, env, decls, sums);
                    ai = ai + 1;
                }
                errors = errors + znc_script_closure_scan_body(x.els_body, env, decls, sums);
            }
            else => {
            }
        }
        i = i + 1;
    }
    return errors;
}

fn znc_script_closure_capture_check(decls: ArrayList[*Node]) i32 {
    let sums: ArrayList[ZScriptLifeSummary] = make[ZScriptLifeSummary](1);
    let env: ArrayList[ZTBind] = make[ZTBind](8);
    let i: i32 = 0;
    while (i < decls.len) {
        switch (decls.data[i].*) {
            .fn_decl => |f| {
                if (@strEq(f.name, "__zag_compiler_script_body_7f3a")) {
                    return znc_script_closure_scan_body(f.body, &env, decls, sums);
                }
            }
            else => {
            }
        }
        i = i + 1;
    }
    return 0;
}

fn znc_script_std_body_check(decls: ArrayList[*Node]) i32 {
    let errors: i32 = 0;
    let i: i32 = 0;
    while (i < decls.len) {
        switch (decls.data[i].*) {
            .fn_decl => |f| {
                let kind: i32 = znc_script_std_origin_kind(f.origin);
                if ((kind > 0) && (f.is_extern == 0)) {
                    errors = errors + znc_script_std_calls_body(f.body, kind, f.name, decls, 1);
                }
            }
            else => {
            }
        }
        i = i + 1;
    }
    errors = errors + znc_script_read_file_stage_check(decls);
    errors = errors + znc_script_closure_capture_check(decls);
    return errors;
}

fn znc_check(path: []u8) i32 {
    if (path.len == 0) {
        _zag_println("znc: no source file");
        return 1;
    }
    let src: []u8 = _zag_read_file(path);
    if (src.len < 0) {
        _zag_print("znc: cannot read ");
        _zag_println(path);
        return 1;
    }
    src = znc_activate_script_source(path, src, 0);
    if (znc_validate_compilation_source(path, src) != 0) {
        return 1;
    }
    let unit: CompilationUnit = parse_compilation_unit_dir(src, dir_of(path));
    if (znc_validate_script_defaults(path, unit) != 0) {
        return 1;
    }
    if (znc_configure_script_unit(&unit, path) != 0) {
        return 1;
    }
    if (znc_validate_script_capabilities(path, unit) != 0) {
        return 1;
    }
    if ((unit.profile == ModuleProfile.script) && (((znc_script_std_body_check(unit.decls) != 0) || (znc_script_lifetime_check(unit.decls) != 0)) || (znc_script_unaccounted_root_make(unit.decls) != 0))) {
        return 1;
    }
    if ((has_flag("--strict") == 1) && (unit.profile == ModuleProfile.script)) {
        _zag_eprintln("znc: strict check FAILED: generated script entry point remains implicit");
        let strict_choices: PlannerChoices = znc_script_explicit_choices();
        if (strict_choices.allocator_explicit == 1) {
            _zag_eprintln(_zag_str_concat("resolved: explicit Script allocator policy selected: ", strict_choices.allocator));
            _zag_eprintln("unresolved: Script allocator contract must still be expanded to an ordinary strict-Zag allocator");
        } else {
            _zag_eprintln("unresolved: implicit bounded Script allocator remains");
        }
        let di: i32 = 0;
        while (di < unit.decls.len) {
            switch (unit.decls.data[di].*) {
                .fn_decl => |f| {
                    if (@strEq(f.name, "__zag_compiler_script_body_7f3a") && (znc_ast_body_has_call(f.body, "make") == 1)) {
                        _zag_eprintln("unresolved: ordinary make allocation is not charged to the Script context");
                    }
                }
                else => {
                }
            }
            di = di + 1;
        }
        if ((znc_contains(src, "read_file(") == 1) || (znc_contains(src, "write_file(") == 1)) {
            _zag_eprintln("unresolved: filesystem capability has no explicit policy");
        }
        if (znc_contains(src, "script_alloc(") == 1) {
            _zag_eprintln("unresolved: temporary allocation remains tied to the script context");
        }
        if ((znc_contains(src, "process_run_timeout(") == 1) || (znc_contains(src, "process_run_argv(") == 1)) {
            _zag_eprintln("unresolved: process capability policy remains implicit (bounded process API is explicit)");
        }
        if (znc_script_generated_calls(unit, "_zag_script_env_get") == 1) {
            _zag_eprintln("unresolved: environment capability has no explicit strict-Zag policy");
        }
        if (((znc_contains(src, "list(") == 1) || (znc_contains(src, "args(") == 1)) || (znc_contains(src, "string_builder(") == 1)) {
            _zag_eprintln("unresolved: temporary collection remains tied to the Script context");
        }
        if ((znc_contains(src, "path_join(") == 1) || (znc_contains(src, "string_concat(") == 1)) {
            _zag_eprintln("unresolved: hidden Script-lifetime string allocation remains");
        }
        if ((znc_contains(src, "random") == 1) && (znc_contains(src, "seed") == 0)) {
            _zag_eprintln("unresolved: random seed is implicit");
        }
        _zag_eprintln("unresolved: CPU/device/layout defaults remain compiler-selected unless made explicit in strict Zag");
        _zag_eprintln("note: run `znc explain <file>` and `znc harden <file>` before promotion to strict Zag");
        return 1;
    }
    let decls: ArrayList[*Node] = unit.decls;
    lo_operators(decls);
    let aerrs: i32 = znc_check_arity(decls);
    if (aerrs > 0) {
        _zag_println("znc: arity check FAILED");
        return 1;
    }
    let derrs: i32 = znc_check_dups(decls);
    if (derrs > 0) {
        _zag_println("znc: duplicate-definition check FAILED");
        return 1;
    }
    if (typed_check_program(decls, path) > 0) {
        return 1;
    }
    let eff: map__StringMap[i32] = analyze(decls);
    let viols: i32 = report_violations(decls, eff, src, path);
    if (viols > 0) {
        znc_emit_total_cex(decls, eff);
        _zag_println("znc: capability check FAILED");
        return 1;
    }
    smt_report_proofs(decls, eff);
    if (run_analyzer(decls, path) != 0) {
        return 1;
    }
    let published: i32 = znc_publish_semantics(path, src, unit, decls, eff);
    znc_maybe_regular_advisory(path, unit, published);
    _zag_println("znc: OK — all capability claims proven");
    return 0;
}

fn znc_format_json(value: []u8) i32 {
    if (@strEq(value, "json")) {
        return 1;
    }
    return 0;
}

fn znc_format_text(value: []u8) i32 {
    if (@strEq(value, "text")) {
        return 1;
    }
    return 0;
}

fn znc_json_bool(value: i32) []u8 {
    if (value == 1) {
        return "true";
    }
    return "false";
}

struct ZExplainOperation {
    operation: []u8,
    allocation: []u8,
    allocation_bytes: []u8,
    copy: []u8,
    copy_bytes: []u8,
}

struct ZExplainOperationState {
    json: i32,
    first: i32,
    emitted: i32,
    truncated: i32,
    origins: ArrayList[NodeOrigin],
    source_len: i32,
}

