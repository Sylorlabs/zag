        if (((znc_script_owner_ends(owner, "script_json_float_spelling") == 1) || (znc_script_owner_ends(owner, "script_json_float_value_valid") == 1)) && @strEq(name, "@floatToInt")) {
            return 1;
        }
        return ((((((((((((((((((((@strEq(name, "json__json_parse_value_bounded") || @strEq(name, "json__json_parse_int_array_bounded")) || @strEq(name, "json__json_parse_bool_array_bounded")) || @strEq(name, "json__json_parse_float_array_bounded")) || @strEq(name, "json__json_parse_float")) || @strEq(name, "json__json_parse_string_array_bounded")) || @strEq(name, "json__json_parse_string_object_bounded")) || @strEq(name, "json__json_default_max_depth")) || @strEq(name, "json__json_default_max_bytes")) || @strEq(name, "json__json_default_max_values")) || @strEq(name, "json__json_stringify_value_bounded")) || @strEq(name, "json__json_default_max_output_bytes")) || @strEq(name, "json__json_encode_result_free")) || @strEq(name, "json__json_document_free")) || @strEq(name, "json__json_int_array_result_free")) || @strEq(name, "json__json_bool_array_result_free")) || @strEq(name, "json__json_float_array_result_free")) || @strEq(name, "json__json_string_array_result_free")) || @strEq(name, "json__json_string_object_result_free")) || @strEq(name, "json__json_utf8_valid")) || @strEq(name, "json__json_stringify_string_checked")) as i32;
    }
    if (kind == 9) {
