// Experimental constant-folder regression: nested regions have isolated SSA
// constant environments and rebuilding an op retains its effect/source data.
@import("../zir.zag")
@import("zopt.zag")

fn rs_val(name: []u8) ZVal { return ZVal{ .name=name, .ty="i64" }; }

fn rs_constant(name: []u8, value: []u8) ZOp {
    let op: ZOp = mk_op("arith.constant");
    push[ZVal](&op.results, rs_val(name));
    push[ZAttr](&op.attrs, ZAttr{ .key="value", .val=value });
    return op;
}

fn rs_add(name: []u8, lhs: []u8, rhs: []u8) ZOp {
    let op: ZOp = mk_op("arith.addi");
    push[ZVal](&op.results, rs_val(name));
    push[ZVal](&op.operands, rs_val(lhs));
    push[ZVal](&op.operands, rs_val(rhs));
    return op;
}

fn rs_check(ok: bool, why: []u8, failures: *i32) void {
    if (!ok) { _zag_eprintln(why); failures.* = failures.* + 1; }
}

fn main() i32 {
    let failures: i32 = 0;
    let root: ZBlock = one_block();
    push[ZOp](&root.ops, rs_constant("%parent", "4"));

    let first: ZBlock = one_block();
    push[ZOp](&first.ops, rs_constant("%child", "7"));
    push[ZOp](&first.ops, rs_add("%folded", "%parent", "%child"));
    let second: ZBlock = one_block();
    // Deliberately unbound in this sibling: folding must not invent a value
    // from an unrelated nested block, even for malformed input ZIR.
    push[ZOp](&second.ops, rs_add("%sibling", "%parent", "%child"));
    let reg: ZRegion = ZRegion{ .blocks=make[ZBlock](2) };
    push[ZBlock](&reg.blocks, first);
    push[ZBlock](&reg.blocks, second);
    let nested: ZOp = mk_op("scf.if");
    nested.effects = 3;
    nested.reads = "global";
    nested.writes = "global";
    nested.origin.line = 123;
    push[ZRegion](&nested.regions, reg);
    push[ZOp](&root.ops, nested);
    // Nested block constants also cannot escape into the parent scope.
    push[ZOp](&root.ops, rs_add("%post", "%parent", "%child"));

    let mod: ZModule = ZModule{ .funcs=make[ZFunc](1) };
    push[ZFunc](&mod.funcs, ZFunc{ .name="region_scope", .params=make[ZVal](1),
                                    .ret="void", .body=root });
    let optimized: ZBlock = get[ZFunc](opt_fold(mod).funcs, 0).body;
    let op: ZOp = get[ZOp](optimized.ops, 1);
    rs_check(@strEq(op.name, "scf.if") && op.effects == 3 &&
             @strEq(op.reads, "global") && @strEq(op.writes, "global") &&
             op.origin.line == 123,
             "region rebuild discarded effects or source metadata", &failures);
    let blocks: ArrayList[ZBlock] = get[ZRegion](op.regions, 0).blocks;
    let first_fold: ZOp = get[ZOp](get[ZBlock](blocks, 0).ops, 1);
    rs_check(@strEq(first_fold.name, "arith.constant") &&
             @strEq(opt_attr_val(first_fold, "value"), "11"),
             "parent constant did not propagate into nested block", &failures);
    let sibling: ZOp = get[ZOp](get[ZBlock](blocks, 1).ops, 0);
    rs_check(@strEq(sibling.name, "arith.addi"),
             "first region block leaked its constant into sibling", &failures);
    rs_check(@strEq(get[ZOp](optimized.ops, 2).name, "arith.addi"),
             "nested region leaked its constant into parent", &failures);

    if (failures != 0) { return 1; }
    _zag_println("zopt-region-scope: pass (nested folding, sibling isolation, metadata)");
    return 0;
}
