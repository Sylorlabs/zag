// Source-level regression for metadata carried from a generic struct template
// to its concrete monomorphized declaration.  Losing any of these fields can
// change visibility or layout after the compiler has already type-checked the
// template.
@import("ncodegen_generics.zag")

fn main() i32 {
    let annotations: ArrayList[[]u8] = make[[]u8](1);
    push[[]u8](&annotations, "metadata-sentinel");

    let type_params: ArrayList[[]u8] = make[[]u8](1);
    push[[]u8](&type_params, "T");
    let template_fields: ArrayList[Param] = make[Param](1);
    push[Param](&template_fields, Param{ .name = "value", .pty = "T" });

    let wrapper_fields: ArrayList[Param] = make[Param](1);
    push[Param](&wrapper_fields,
        Param{ .name = "box", .pty = "MetadataBox[i32]" });

    let decls: ArrayList[*Node] = make[*Node](2);
    push[*Node](&decls, new(Node{ .struct_ = StructDecl{
        .name = "MetadataBox", .fields = template_fields,
        .tparams = type_params, .annots = annotations,
        .is_pub = 1, .origin = "<metadata-test>", .repr_c = 1 } }));
    push[*Node](&decls, new(Node{ .struct_ = StructDecl{
        .name = "MetadataRoot", .fields = wrapper_fields,
        .tparams = make[[]u8](1), .annots = make[[]u8](1),
        .is_pub = 0, .origin = "<metadata-test>", .repr_c = 0 } }));

    let args: ArrayList[[]u8] = make[[]u8](1);
    push[[]u8](&args, "i32");
    let expected_name: []u8 = cg_mangle_generic_norm("MetadataBox", args);
    let expanded: ArrayList[*Node] = cg_expand_generics(decls);

    let i: i32 = 0;
    while (i < len[*Node](expanded)) {
        switch (get[*Node](expanded, i).*) {
            .struct_ => |s| {
                if (@strEq(s.name, expected_name)) {
                    if (s.is_pub != 1 || s.repr_c != 1) { return 1; }
                    if (len[[]u8](s.annots) != 1 ||
                        !@strEq(get[[]u8](s.annots, 0), "metadata-sentinel")) {
                        return 2;
                    }
                    if (len[[]u8](s.tparams) != 0 || len[Param](s.fields) != 1) {
                        return 3;
                    }
                    if (!@strEq(get[Param](s.fields, 0).pty, "i32")) { return 4; }
                    return 42;
                }
            }
            else => { }
        }
        i = i + 1;
    }
    return 5;
}
