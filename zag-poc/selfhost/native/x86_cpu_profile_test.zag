@import("x86_cpu_profile.zag")

fn expect(ok: i32, label: []u8, failures: *i32) void {
    if (ok == 1) { return; }
    _zag_print("FAIL x86 cpu profile: ");
    _zag_println(label);
    failures.* = failures.* + 1;
}

fn main() i32 {
    let failures: i32 = 0;
    let generic: X86CpuProfile = parse_x86_cpu_profile("generic");
    expect(generic.valid == 1, "generic resolves", &failures);
    expect(generic.request_kind == 1, "generic request kind", &failures);
    expect(@strEq(generic.canonical, "x86-64-v1"), "generic canonical name", &failures);
    expect(@strEq(generic.cache_key, "linux-x86_64|x86-64-v1|sse2"), "stable cache key", &failures);
    expect(generic.features.sse2 == 1, "baseline advertises encoder-supported SSE2", &failures);
    expect(generic.features.sse3 + generic.features.ssse3 + generic.features.sse41 +
        generic.features.sse42 + generic.features.popcnt + generic.features.avx +
        generic.features.avx2 + generic.features.fma + generic.features.bmi1 +
        generic.features.bmi2 + generic.features.avx512 == 0,
        "unsupported optional features remain disabled", &failures);

    let named: X86CpuProfile = parse_x86_cpu_profile("--cpu=x86-64-v1");
    expect(named.valid == 1 && named.request_kind == 3, "named profile parses", &failures);
    expect(@strEq(named.cache_key, generic.cache_key), "aliases share cache identity", &failures);
    expect(@strEq(x86_profile_report_json(named), x86_profile_report_json(generic)),
        "report is deterministic across aliases", &failures);

    // ── DECLARED LEVELS ──
    let v2: X86CpuProfile = parse_x86_cpu_profile("x86-64-v2");
    expect(v2.valid == 1 && v2.request_kind == 3, "v2 resolves", &failures);
    expect(@strEq(v2.canonical, "x86-64-v2"), "v2 canonical name", &failures);
    expect(@strEq(v2.detection, "declared"), "v2 records that it declares rather than detects", &failures);
    expect(v2.features.sse42 == 1 && v2.features.popcnt == 1,
        "v2 permits SSE4.2 and POPCNT", &failures);
    // v2 adds no vector width: it must still land on the 128-bit rung, which
    // `znc_vectorize_target` selects only when neither AVX bit is set.
    expect(v2.features.avx == 0 && v2.features.avx2 == 0 && v2.features.avx512 == 0,
        "v2 stays on the 128-bit rung", &failures);

    let v3: X86CpuProfile = parse_x86_cpu_profile("--cpu=x86-64-v3");
    expect(v3.valid == 1 && @strEq(v3.canonical, "x86-64-v3"), "v3 resolves from a flag", &failures);
    expect(v3.features.avx == 1 && v3.features.avx2 >= 1 && v3.features.fma == 1,
        "v3 permits AVX2 and FMA", &failures);
    expect(v3.features.avx512 == 0, "v3 does not reach the 512-bit rung", &failures);
    // The declared levels carry 2, not 1, for avx2. `znc_vectorize_target`
    // tests `>= 1`, so the rung widens, while `cg_allow_avx2` requires exactly 1
    // and so the bounded scalar `i32x4` path stays off. Asserting the exact
    // value keeps that distinction from being collapsed by a well-meaning edit.
    expect(v3.features.avx2 == 2, "v3 selects the vector rung without enabling scalar AVX2 lowering", &failures);

    let v4: X86CpuProfile = parse_x86_cpu_profile("x86-64-v4");
    expect(v4.valid == 1 && @strEq(v4.canonical, "x86-64-v4"), "v4 resolves", &failures);
    expect(v4.features.avx2 >= 1 && v4.features.avx512 >= 1,
        "v4 reaches the 512-bit rung", &failures);
    expect(v4.features.avx512 == 2, "v4 marks AVX-512 usable rather than detected", &failures);

    // Every rung must have a distinct cache identity. Sharing one would let a
    // cache hit serve v1 code for a v3 build, which is a silent wrong-answer.
    expect(generic.cache_key != v2.cache_key && generic.cache_key != v3.cache_key &&
        generic.cache_key != v4.cache_key && v2.cache_key != v3.cache_key &&
        v2.cache_key != v4.cache_key && v3.cache_key != v4.cache_key,
        "each rung has a distinct cache key", &failures);

    // A declared level must report itself, not the baseline it derived from.
    expect(@strEq(v3.canonical, "x86-64-v3") && !@strEq(v3.canonical, "x86-64-v1"),
        "declared level is not reported as v1", &failures);
    // Exact expected JSON. A report that silently fell through to the baseline
    // branch would still be valid JSON, so compare it in full.
    expect(@strEq(x86_profile_report_json(v3),
        "{\"target\":\"linux-x86_64\",\"profile\":\"x86-64-v3\",\"detection\":\"declared\",\"features\":[\"sse2\",\"sse42\",\"popcnt\",\"avx\",\"avx2\",\"fma\",\"bmi1\",\"bmi2\"],\"cache_key\":\"linux-x86_64|x86-64-v3|sse2,sse42,popcnt,avx,avx2,fma,bmi1,bmi2\"}"),
        "v3 report names the level, the declaration, and its features", &failures);
    expect(@strEq(x86_profile_report_json(v4),
        "{\"target\":\"linux-x86_64\",\"profile\":\"x86-64-v4\",\"detection\":\"declared\",\"features\":[\"sse2\",\"sse42\",\"popcnt\",\"avx\",\"avx2\",\"fma\",\"bmi1\",\"bmi2\",\"avx512\"],\"cache_key\":\"linux-x86_64|x86-64-v4|sse2,sse42,popcnt,avx,avx2,fma,bmi1,bmi2,avx512\"}"),
        "v4 report names the level and AVX-512", &failures);
    expect(!@strEq(x86_profile_report_json(v3), x86_profile_report_json(generic)),
        "declared level report differs from the baseline report", &failures);

    let fixture: []u8 = "processor : 0\nflags : fpu sse sse2 ssse3 avx avx2 lm\n";
    let native: X86CpuProfile = x86_native_profile_from_cpuinfo("native", fixture);
    expect(native.valid == 1 && native.request_kind == 2, "native resolves from Linux flags", &failures);
    expect(native.features.sse2 == 1 && native.features.ssse3 == 0 && native.features.avx == 0,
        "native permits only implemented encoder features", &failures);
    expect(@strEq(native.detection, "linux-proc-cpuinfo"), "native records discovery authority", &failures);
    expect(@strEq(native.cache_key, "linux-x86_64|native|permitted=sse2"),
        "native cache identity records permitted features", &failures);
    expect(x86_has_token(x86_cpuinfo_flags(fixture), "avx") == 1 &&
        x86_has_token(x86_cpuinfo_flags(fixture), "av") == 0,
        "feature matching uses complete tokens", &failures);
    let missing: X86CpuProfile = x86_native_profile_from_cpuinfo("native", "model name : test\n");
    expect(missing.valid == 0 && missing.features.sse2 == 0 && missing.cache_key.len == 0,
        "missing Linux flags fail closed", &failures);
    let weak: X86CpuProfile = x86_native_profile_from_cpuinfo("native", "flags : sse sse2\n");
    expect(weak.valid == 0, "missing long-mode baseline fails closed", &failures);

    let unknown: X86CpuProfile = parse_x86_cpu_profile("zen99");
    expect(unknown.valid == 0 && unknown.request_kind == 0, "unknown profile rejected", &failures);

    let hw_only: X86Detection = x86_gate_avx(1 << 28, 6, 1 << 5, 1 << 16);
    expect(hw_only.avx_usable == 0 && hw_only.avx2_usable == 0,
        "raw AVX hardware bit is insufficient without OSXSAVE", &failures);
    let no_ymm: X86Detection = x86_gate_avx((1 << 28) | (1 << 27), 2, 1 << 5, 1 << 16);
    expect(no_ymm.avx_usable == 0 && no_ymm.avx2_usable == 0,
        "OSXSAVE is insufficient without XCR0 YMM state", &failures);
    let qualified: X86Detection = x86_gate_avx((1 << 28) | (1 << 27), 6, 1 << 5, 0);
    expect(qualified.avx_usable == 1 && qualified.avx2_usable == 1,
        "AVX2 requires CPU AVX, OSXSAVE, XMM/YMM state, and AVX2", &failures);
    // AVX-512 needs AVX512F AND the ZMM/opmask half of the OS-saved state.
    let avx512_cpu_only: X86Detection = x86_gate_avx((1 << 28) | (1 << 27), 6, 1 << 5, 1 << 16);
    expect(avx512_cpu_only.avx512_usable == 0,
        "AVX512F without ZMM state fails closed", &failures);
    let avx512_no_cpu: X86Detection = x86_gate_avx((1 << 28) | (1 << 27), 6 | 224, 1 << 5, 0);
    expect(avx512_no_cpu.avx512_usable == 0,
        "ZMM state without AVX512F fails closed", &failures);
    let avx512_ok: X86Detection = x86_gate_avx((1 << 28) | (1 << 27), 6 | 224, 1 << 5, 1 << 16);
    expect(avx512_ok.avx512_usable == 1 && x86_can_use_avx512(avx512_ok) == 1,
        "AVX-512 requires CPU AVX512F, OSXSAVE, YMM state, and ZMM state", &failures);
    expect(x86_vector_width(avx512_ok) == 16 && x86_vector_width(qualified) == 8,
        "vector width ladder follows qualified capability", &failures);
    let live: X86Detection = x86_detect_raw();
    expect(live.available == 1, "raw CPUID discovery executes on x86-64", &failures);
    expect(live.avx2_usable <= live.avx_usable,
        "live AVX2 usability implies AVX usability", &failures);
    expect(live.avx512_usable <= live.avx2_usable,
        "live AVX-512 usability implies AVX2 usability", &failures);

    if (failures == 0) { _zag_println("x86 cpu profile: pass=31 fail=0"); }
    return failures;
}
