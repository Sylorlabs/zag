@import("x86.zag")
@import("elf.zag")
@import("ncodegen.zag")

fn build_script(path: []u8, src: []u8) i32 {
    let unit: CompilationUnit = parse_compilation_unit_dir(src, ".");
    if (unit.profile != ModuleProfile.script) { return 10; }
    let found_body: i32 = 0;
    let wrapper_order_ok: i32 = 0;
    let i: i32 = 0;
    while (i < len[*Node](unit.decls)) {
        switch (get[*Node](unit.decls, i).*) {
            .fn_decl => |f| {
                if (@strEq(f.name, "__zag_compiler_script_body_7f3a")) { found_body = 1; }
                if (@strEq(f.name, "main") && len[*Node](f.body) == 4) {
                    switch (get[*Node](f.body, 0).*) {
                        .let_ => |init| {
                            switch (init.expr.*) {
                                .call => |c0| { switch (c0.callee.*) { .id => |id0| {
                                    if (@strEq(id0.name, "_zag_script_context_init")) { wrapper_order_ok = 1; }
                                } else => { } } }
                                else => { }
                            }
                        }
                        else => { }
                    }
                    switch (get[*Node](f.body, 2).*) {
                        .estmt => |stop| { switch (stop.expr.*) { .call => |c2| { switch (c2.callee.*) {
                            .id => |id2| { if (@strEq(id2.name, "_zag_script_context_shutdown") == 0) { wrapper_order_ok = 0; } }
                            else => { wrapper_order_ok = 0; }
                        } } else => { wrapper_order_ok = 0; } } }
                        else => { wrapper_order_ok = 0; }
                    }
                }
            }
            else => { }
        }
        i = i + 1;
    }
    if (found_body == 0 || wrapper_order_ok == 0) { return 11; }
    let nerr: i32 = 0;
    let data: ArrayList[u8] = make[u8](16);
    let prog: ArrayList[Instr] = lower_program(unit.decls, &nerr, &data);
    if (nerr != 0) { return 12; }
    let code: ArrayList[u8] = encode(prog);
    return write_elf_exec_data(path, code, 0, data);
}

fn main() i32 {
    let rc1: i32 = build_script("/tmp/zag_script_top_return",
        "script; return 23;");
    if (rc1 != 0) { return rc1; }
    let rc2: i32 = build_script("/tmp/zag_script_uncaught",
        "script; error { Failure } fn fail() !i32 { return error.Failure; } let value: i32 = try fail(); return value;");
    if (rc2 != 0) { return rc2; }
    _zag_println("script lowering native generator: PASS");
    return 0;
}
