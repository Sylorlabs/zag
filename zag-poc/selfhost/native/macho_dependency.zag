// Bounded ARM64 Mach-O dependency inspection. All returned slices borrow the
// caller's immutable input snapshot; no loader or host linker is invoked.
@import("../../std/list.zag")
@import("../../std/rt.zag")

struct MdDependency {
    valid: i32, image: []u8, exports: []u8, install_name: []u8,
    symbols: i32, symbol_count: i32, strings: i32, string_size: i32,
    format: i32
}
struct MdTrieVisit { offset: i32, path_length: i32 }
fn mdep_range(bytes: []u8, offset: i64, size: i64) i32 {
    return (offset >= 0 && size >= 0 && offset <= (bytes.len as i64) && size <= (bytes.len as i64)-offset) as i32;
}
fn mdep_uint(bytes: []u8, offset: i32, width: i32, big: i32) i64 {
    if (mdep_range(bytes,offset as i64,width as i64) == 0 || width > 8) { return -1; }
    let value: i64 = 0; let i: i32 = 0;
    while (i < width) {
        let at: i32 = offset+width-1-i; if (big == 1) { at = offset+i; }
        if (value > 36028797018963967) { return -1; }
        value = value*256+(bytes[at] as i64); i = i+1;
    }
    return value;
}
fn mdep_end_string(bytes: []u8, offset: i32, end: i32) i32 {
    if (offset < 0 || end < offset || end > bytes.len) { return -1; }
    while (offset < end) { if (bytes[offset] == 0) { return offset; } offset = offset+1; }
    return -1;
}

fn mdep_text_starts(bytes: []u8, at: i32, needle: []u8) i32 {
    if (at < 0 || needle.len > bytes.len-at) { return 0; }
    let i: i32 = 0;
    while (i < needle.len) { if (bytes[at+i] != needle[i]) { return 0; } i = i+1; }
    return 1;
}
fn mdep_text_has(bytes: []u8, needle: []u8) i32 {
    if (needle.len == 0) { return 1; }
    let i: i32 = 0;
    while (i <= bytes.len-needle.len) {
        if (mdep_text_starts(bytes,i,needle) == 1) { return 1; }
        i = i+1;
    }
    return 0;
}
fn mdep_line_end(bytes: []u8, at: i32) i32 {
    while (at < bytes.len && bytes[at] != '\n') { at = at+1; }
    return at;
}
fn mdep_tbd_value(bytes: []u8, key: []u8) []u8 {
    let at: i32 = 0;
    while (at < bytes.len) {
        let end: i32 = mdep_line_end(bytes,at);
        let p: i32 = at;
        while (p < end && (bytes[p] == ' ' || bytes[p] == '\t')) { p = p+1; }
        if (mdep_text_starts(bytes,p,key) == 1) {
            p = p+key.len;
            while (p < end && (bytes[p] == ' ' || bytes[p] == '\t')) { p = p+1; }
            if (p >= end) { return ""; }
            if (bytes[p] == '\'' || bytes[p] == '"') {
                let quote: u8 = bytes[p]; p = p+1; let q: i32 = p;
                while (q < end && bytes[q] != quote) {
                    if (bytes[q] == '\\') { return ""; }
                    q = q+1;
                }
                if (q <= p || q >= end) { return ""; }
                return bytes[p..q];
            }
            let q: i32 = p;
            while (q < end && bytes[q] != ' ' && bytes[q] != '\t' && bytes[q] != '#') { q = q+1; }
            if (q <= p) { return ""; }
            return bytes[p..q];
        }
        at = end+1;
    }
    return "";
}
fn mdep_tbd_export_has(bytes: []u8, name: []u8) i32 {
    let at: i32 = 0; let in_exports: i32 = 0; let block_arm64: i32 = 0;
    while (at < bytes.len) {
        let end: i32 = mdep_line_end(bytes,at);
        let p: i32 = at;
        while (p < end && (bytes[p] == ' ' || bytes[p] == '\t')) { p = p+1; }
        let indent: i32 = p-at;
        if (indent == 0 && mdep_text_starts(bytes,p,"exports:") == 1) { in_exports = 1; block_arm64 = 0; }
        else if (indent == 0 && p < end && bytes[p] != '#' && bytes[p] != '-' &&
            mdep_text_starts(bytes,p,"---") == 0) { in_exports = 0; block_arm64 = 0; }
        else if (in_exports == 1) {
            let line: []u8 = bytes[p..end];
            if (mdep_text_starts(bytes,p,"- targets:") == 1) {
                block_arm64 = ((mdep_text_has(line,"arm64-macos") == 1 ||
                    mdep_text_has(line,"arm64e-macos") == 1) as i32);
            } else if (mdep_text_starts(bytes,p,"symbols:") == 0 &&
                (mdep_text_has(line,"arm64-macos") == 1 || mdep_text_has(line,"arm64e-macos") == 1)) {
                // TAPI commonly wraps a long target list onto continuation
                // lines before the direct symbol list.
                block_arm64 = 1;
            }
        }
        if (in_exports == 1 && mdep_text_starts(bytes,p,"symbols:") == 1) {
            let list: i32 = p+8;
            while (list < bytes.len && bytes[list] != '[' && bytes[list] != '\n') { list = list+1; }
            if (list >= bytes.len || bytes[list] != '[') { return -1; }
            let q: i32 = list+1;
            while (q < bytes.len) {
                while (q < bytes.len && (bytes[q] == ' ' || bytes[q] == '\t' || bytes[q] == '\r' || bytes[q] == '\n' || bytes[q] == ',')) { q = q+1; }
                if (q >= bytes.len) { return -1; }
                if (bytes[q] == ']') { break; }
                let start: i32 = q; let finish: i32 = q;
                if (bytes[q] == '\'' || bytes[q] == '"') {
                    let quote: u8 = bytes[q]; start = q+1; finish = start;
                    while (finish < bytes.len && bytes[finish] != quote) {
                        if (bytes[finish] == '\\') { return -1; }
                        finish = finish+1;
                    }
                    if (finish >= bytes.len) { return -1; }
                    q = finish+1;
                } else {
                    while (finish < bytes.len && bytes[finish] != ',' && bytes[finish] != ']' &&
                        bytes[finish] != ' ' && bytes[finish] != '\t' && bytes[finish] != '\r' && bytes[finish] != '\n') { finish = finish+1; }
                    q = finish;
                }
                if (block_arm64 == 1 && finish > start && @strEq(bytes[start..finish],name)) { return 1; }
                while (q < bytes.len && bytes[q] != ',' && bytes[q] != ']') {
                    if (bytes[q] != ' ' && bytes[q] != '\t' && bytes[q] != '\r' && bytes[q] != '\n') { return -1; }
                    q = q+1;
                }
                if (q < bytes.len && bytes[q] == ']') { break; }
            }
        }
        at = end+1;
    }
    return 0;
}
fn mdep_parse_tbd(bytes: []u8) MdDependency {
    let result: MdDependency = MdDependency{.valid=0,.image="",.exports="",.install_name="",
        .symbols=0,.symbol_count=0,.strings=0,.string_size=0,.format=2};
    if (bytes.len < 32 || bytes.len > 67108864 || mdep_text_has(bytes,"!tapi-tbd") == 0) { return result; }
    if (@strEq(mdep_tbd_value(bytes,"tbd-version:"),"4") == 0) { return result; }
    if (mdep_text_has(bytes,"arm64-macos") == 0 && mdep_text_has(bytes,"arm64e-macos") == 0) { return result; }
    let install: []u8 = mdep_tbd_value(bytes,"install-name:");
    if (install.len == 0 || install.len > 4096 || install[0] != '/') { return result; }
    // Validate every direct export symbol list before symbol lookup so a
    // malformed list cannot be treated as an ordinary search miss.
    if (mdep_tbd_export_has(bytes,"__zag_tbd_validation_probe__") < 0) { return result; }
    result.image = bytes; result.install_name = install; result.valid = 1; return result;
}
fn mdep_uleb(bytes: []u8, position: *i32, end: i32) i64 {
    let value: i64 = 0; let scale: i64 = 1; let count: i32 = 0;
    while (position.* >= 0 && position.* < end && end <= bytes.len && count < 9) {
        let byte: i64 = bytes[position.*] as i64; position.* = position.*+1;
        value = value+(byte%128)*scale;
        if (byte < 128) { return value; }
        count = count+1;
        if (count < 9) { scale = scale*128; }
    }
    return -1;
}
fn mdep_arm64_slice(bytes: []u8) []u8 {
    if (bytes.len < 32) { return ""; }
    let magic: i64 = mdep_uint(bytes,0,4,1);
    let wide: i32 = 0; let big: i32 = 1;
    if (magic == 0xcafebabf || magic == 0xbfbafeca) { wide = 1; }
    if (magic == 0xbebafeca || magic == 0xbfbafeca) { big = 0; }
    if (magic != 0xcafebabe && magic != 0xcafebabf && magic != 0xbebafeca && magic != 0xbfbafeca) { return bytes; }
    let count: i64 = mdep_uint(bytes,4,4,big);
    let stride: i32 = 20+12*wide;
    if (count < 1 || count > 64 || mdep_range(bytes,8,count*(stride as i64)) == 0) { return ""; }
    let answer: []u8 = ""; let i: i32 = 0;
    while ((i as i64) < count) {
        let at: i32 = 8+i*stride;
        let cpu: i64 = mdep_uint(bytes,at,4,big);
        let subtype: i64 = mdep_uint(bytes,at+4,4,big) & 0xffffff;
        let offset: i64 = mdep_uint(bytes,at+8,4+4*wide,big);
        let size: i64 = mdep_uint(bytes,at+12+4*wide,4+4*wide,big);
        let alignment: i64 = mdep_uint(bytes,at+16+8*wide,4,big);
        if (mdep_range(bytes,offset,size) == 0 || alignment < 0 || alignment > 31 || offset < 8+count*(stride as i64)) { return ""; }
        let multiple: i64 = 1; let bit: i64 = 0;
        while (bit < alignment) { multiple = multiple*2; bit = bit+1; }
        if (offset%multiple != 0) { return ""; }
        if (cpu == 0x100000c && subtype <= 1) {
            if (answer.len != 0) { return ""; }
            answer = bytes[offset as i32..(offset+size) as i32];
        }
        i = i+1;
    }
    return answer;
}
fn mdep_terminal_valid(trie: []u8, begin: i32, end: i32) i32 {
    let pos: i32 = begin;
    let flags: i64 = mdep_uleb(trie,&pos,end);
    if (flags < 0 || flags > 63 || (flags & 3) == 3 || mdep_uleb(trie,&pos,end) < 0) { return 0; }
    if ((flags & 8) != 0) {
        if ((flags & 16) != 0) { return 0; }
        let name_end: i32 = mdep_end_string(trie,pos,end);
        if (name_end < 0) { return 0; } pos = name_end+1;
    } else if ((flags & 16) != 0) {
        if (mdep_uleb(trie,&pos,end) < 0) { return 0; }
    }
    return (pos == end) as i32;
}
// Validate the entire reachable trie before resolving any one import. This
// detects malformed off-path nodes, cycles, aliases/overlaps, duplicate edges,
// and invalid terminal payloads instead of treating corrupt metadata as a miss.
fn mdep_trie_valid(trie: []u8) i32 {
    if (trie.len == 0) { return 1; }
    if (trie.len > 16777216) { return 0; }
    let marks: ArrayList[u8] = make[u8](trie.len);
    while (marks.len < trie.len) { push[u8](&marks,0); }
    let pending: ArrayList[MdTrieVisit] = make[MdTrieVisit](32);
    push[MdTrieVisit](&pending,MdTrieVisit{.offset=0,.path_length=0}); marks.data[0] = 1;
    let cursor: i32 = 0; let valid: i32 = 1;
    while (cursor < pending.len && valid == 1) {
        let visit: MdTrieVisit = pending.data[cursor];
        let pos: i32 = visit.offset;
        if ((marks.data[pos] & 2) != 0) { valid = 0; break; }
        let payload: i64 = mdep_uleb(trie,&pos,trie.len);
        if (payload < 0 || payload >= ((trie.len-pos) as i64)) { valid = 0; break; }
        let terminal_end: i32 = pos+(payload as i32);
        if (payload > 0 && (visit.path_length == 0 || mdep_terminal_valid(trie,pos,terminal_end) == 0)) { valid = 0; break; }
        pos = terminal_end;
        let children: i32 = trie[pos] as i32; pos = pos+1;
        let edges: ArrayList[[]u8] = make[[]u8](children);
        let i: i32 = 0;
        while (i < children && valid == 1) {
            let edge_end: i32 = mdep_end_string(trie,pos,trie.len);
            if (edge_end <= pos) { valid = 0; break; }
            let edge: []u8 = trie[pos..edge_end]; pos = edge_end+1;
            let other: i32 = 0;
            while (other < edges.len) {
                let common: i32 = edge.len;
                if (edges.data[other].len < common) { common = edges.data[other].len; }
                if (@strEq(edge[0..common],edges.data[other][0..common])) { valid = 0; }
                other = other+1;
            }
            let child: i64 = mdep_uleb(trie,&pos,trie.len);
            if (child < 0 || child >= (trie.len as i64) || pending.len >= 1048576 ||
                edge.len > 1048576-visit.path_length) { valid = 0; break; }
            if (marks.data[child as i32] != 0) { valid = 0; break; }
            marks.data[child as i32] = 1;
            push[MdTrieVisit](&pending,MdTrieVisit{.offset=child as i32,.path_length=visit.path_length+edge.len});
            push[[]u8](&edges,edge); i = i+1;
        }
        free[[]u8](&edges);
        let at: i32 = visit.offset;
        while (at < pos && valid == 1) {
            if ((marks.data[at] & 2) != 0 || (at != visit.offset && marks.data[at] == 1)) { valid = 0; }
            marks.data[at] = 2; at = at+1;
        }
        cursor = cursor+1;
    }
    free[u8](&marks); free[MdTrieVisit](&pending); return valid;
}
fn mdep_parse(bytes: []u8) MdDependency {
    let result: MdDependency = MdDependency{.valid=0,.image="",.exports="",.install_name="",.symbols=0,.symbol_count=0,.strings=0,.string_size=0,.format=1};
    let image: []u8 = mdep_arm64_slice(bytes);
    if (image.len < 32 || mdep_uint(image,0,4,0) != 0xfeedfacf ||
        mdep_uint(image,4,4,0) != 0x100000c || (mdep_uint(image,8,4,0) & 0xffffff) > 1 ||
        mdep_uint(image,12,4,0) != 6) { return result; }
    let count: i64 = mdep_uint(image,16,4,0);
    let size: i64 = mdep_uint(image,20,4,0);
    if (count < 1 || count > 8192 || mdep_range(image,32,size) == 0) { return result; }
    let end: i32 = 32+(size as i32); let at: i32 = 32; let i: i32 = 0;
    let platform: i32 = 0; let symbols_seen: i32 = 0;
    let exports_offset: i64 = 0; let exports_size: i64 = 0;
    while ((i as i64) < count) {
        if (at > end-8) { return result; }
        let command: i64 = mdep_uint(image,at,4,0);
        let length: i64 = mdep_uint(image,at+4,4,0);
        if (length < 8 || length%8 != 0 || length > ((end-at) as i64)) { return result; }
        if (command == 13) {
            if (length < 24 || result.install_name.len > 0) { return result; }
            let name: i64 = mdep_uint(image,at+8,4,0);
            if (name < 24 || name >= length) { return result; }
            let name_at: i32 = at+(name as i32);
            let name_end: i32 = mdep_end_string(image,name_at,at+(length as i32));
            if (name_end <= name_at) { return result; }
            result.install_name = image[name_at..name_end];
        } else if (command == 0x32) {
            if (length < 24 || mdep_uint(image,at+8,4,0) != 1) { return result; }
            platform = 1;
        } else if (command == 0x24) { if (length != 16) { return result; } platform = 1; }
        else if (command == 0x25 || command == 0x2f || command == 0x30) { return result; }
        else if (command == 2) {
            if (length != 24 || symbols_seen != 0) { return result; }
            symbols_seen = 1;
            let symbol_offset: i64 = mdep_uint(image,at+8,4,0);
            let symbol_count: i64 = mdep_uint(image,at+12,4,0);
            let strings: i64 = mdep_uint(image,at+16,4,0);
            let string_size: i64 = mdep_uint(image,at+20,4,0);
            if (mdep_range(image,symbol_offset,symbol_count*16) == 0 || mdep_range(image,strings,string_size) == 0) { return result; }
            result.symbols = symbol_offset as i32; result.symbol_count = symbol_count as i32;
            result.strings = strings as i32; result.string_size = string_size as i32;
        } else if (command == 0x22 || command == 0x80000022 || command == 0x80000033) {
            let field: i32 = 40;
            if (command == 0x80000033) { field = 8; }
            if (length != ((field+8) as i64)) { return result; }
            let offset: i64 = mdep_uint(image,at+field,4,0);
            let amount: i64 = mdep_uint(image,at+field+4,4,0);
            if (mdep_range(image,offset,amount) == 0) { return result; }
            if (amount > 0) {
                if (exports_size > 0 && (exports_offset != offset || exports_size != amount)) { return result; }
                exports_offset = offset; exports_size = amount;
            }
        } else if (command == 25) {
            if (length < 72) { return result; }
            let sections: i64 = mdep_uint(image,at+64,4,0);
            if (length != 72+80*sections || mdep_range(image,mdep_uint(image,at+40,8,0),mdep_uint(image,at+48,8,0)) == 0) { return result; }
        }
        at = at+(length as i32); i = i+1;
    }
    if (at != end || platform == 0 || result.install_name.len == 0) { return result; }
    result.image = image;
    result.exports = image[exports_offset as i32..(exports_offset+exports_size) as i32];
    if (mdep_trie_valid(result.exports) == 0) { return result; }
    result.valid = 1; return result;
}

// Return 1 for an exported symbol, 0 for an absent symbol, -1 for malformed
// metadata. A malformed dependency can never be treated as a search miss.
fn mdep_has_export(dependency: MdDependency, name: []u8) i32 {
    if (dependency.valid == 0 || name.len == 0) { return -1; }
    if (dependency.format == 2) { return mdep_tbd_export_has(dependency.image,name); }
    let trie: []u8 = dependency.exports;
    if (trie.len > 0) {
        let node: i32 = 0; let consumed: i32 = 0; let steps: i32 = 0;
        while (steps <= name.len) {
            let pos: i32 = node;
            let payload: i64 = mdep_uleb(trie,&pos,trie.len);
            if (payload < 0 || payload > ((trie.len-pos) as i64)) { return -1; }
            let payload_end: i32 = pos+(payload as i32);
            if (payload_end >= trie.len) { return -1; }
            if (consumed == name.len) {
                if (payload == 0) { return 0; }
                let flags: i64 = mdep_uleb(trie,&pos,payload_end);
                // Thread-local exports (KIND_THREAD_LOCAL=1) are ordinary
                // resolvable dependency symbols; their address names the TLV
                // descriptor that a consumer's TLVP slot must bind to.
                if (flags < 0 || flags > 63 || (flags & 3) == 3 || mdep_uleb(trie,&pos,payload_end) < 0) { return -1; }
                if ((flags & 8) != 0) {
                    let end: i32 = mdep_end_string(trie,pos,payload_end);
                    if (end < 0) { return -1; } pos = end+1;
                } else if ((flags & 16) != 0) {
                    if (mdep_uleb(trie,&pos,payload_end) < 0) { return -1; }
                }
                if (pos != payload_end) { return -1; }
                return 1;
            }
            pos = payload_end;
            if (pos >= trie.len) { return -1; }
            let children: i32 = trie[pos] as i32; pos = pos+1;
            let selected: i32 = -1; let selected_length: i32 = 0; let i: i32 = 0;
            while (i < children) {
                let edge_end: i32 = mdep_end_string(trie,pos,trie.len);
                if (edge_end <= pos) { return -1; }
                let edge: []u8 = trie[pos..edge_end]; pos = edge_end+1;
                let child: i64 = mdep_uleb(trie,&pos,trie.len);
                if (child < 0 || child >= (trie.len as i64)) { return -1; }
                if (edge.len <= name.len-consumed && @strEq(edge,name[consumed..consumed+edge.len])) {
                    if (selected >= 0) { return -1; }
                    selected = child as i32; selected_length = edge.len;
                }
                i = i+1;
            }
            if (selected < 0) { return 0; }
            node = selected; consumed = consumed+selected_length; steps = steps+1;
        }
        return -1;
    }
    let i: i32 = 0;
    while (i < dependency.symbol_count) {
        let at: i32 = dependency.symbols+i*16;
        let kind: i32 = dependency.image[at+4] as i32;
        if ((kind & 0xe0) == 0 && (kind & 1) == 1 && (kind & 0xe) != 0) {
            let offset: i64 = mdep_uint(dependency.image,at,4,0);
            if (offset < 0 || offset >= (dependency.string_size as i64)) { return -1; }
            let start: i32 = dependency.strings+(offset as i32);
            let end: i32 = mdep_end_string(dependency.image,start,dependency.strings+dependency.string_size);
            if (end < 0) { return -1; }
            if (@strEq(name,dependency.image[start..end])) { return 1; }
        }
        i = i+1;
    }
    return 0;
}
