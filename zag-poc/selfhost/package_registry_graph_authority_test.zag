@import("package_registry_graph_authority.zag")

extern fn _zag_allocator_live_bytes() i64

fn authority_check(ok: i32, label: []u8, failures: *i32) void {
    if (ok != 0) { _zag_print("ok  "); _zag_println(label); }
    else { failures.* = failures.* + 1; _zag_print("FAIL "); _zag_println(label); }
}

fn main() i32 {
    let failures: i32 = 0;
    let before: i64 = _zag_allocator_live_bytes();
    let body: []u8 = "format=zag-registry-index-v1\nauthority=local-file-v1\nsignature=none\nentry=alpha\t1.0.0\tsrc/alpha.zag\t1,2,3\nentry=alpha\t1.2.0\tsrc/alpha-new.zag\t4,5,6\nentry=beta\t2.0.0\tsrc/beta.zag\t7,8,9\n";
    let index: []u8 = package_registry_finalize(body);
    let edges: []u8 = "root\talpha\t^1.0.0\nroot\tbeta\t^2.0.0\nalpha\tbeta\t^2.0.0";
    let lock: PackageRegistryGraphLock =
        package_registry_graph_lock_create(index, edges);
    let authorized: PackageRegistryGraphAuthorizedLookup =
        package_registry_graph_lock_authorized_select(index, edges,
            lock.bytes, "alpha");
    authority_check(authorized.authorized == 1 && authorized.found == 1 &&
        @strEq(authorized.version, "1.2.0") &&
        @strEq(authorized.source, "src/alpha-new.zag") &&
        authorized.error == PackageRegistryGraphAuthorityError.none,
        "opt-in seam verifies lock before selecting the pinned package", &failures);

    let missing: PackageRegistryGraphAuthorizedLookup =
        package_registry_graph_lock_authorized_select(index, edges,
            lock.bytes, "missing");
    authority_check(missing.authorized == 0 &&
        missing.error == PackageRegistryGraphAuthorityError.invalid_query,
        "non-graph package cannot use the authority seam", &failures);

    let forged: []u8 = _zag_str_concat(lock.bytes, "x");
    let forged_result: PackageRegistryGraphAuthorizedLookup =
        package_registry_graph_lock_authorized_select(index, edges,
            forged, "alpha");
    authority_check(forged_result.authorized == 0 &&
        forged_result.error == PackageRegistryGraphAuthorityError.invalid_lock,
        "forged lock fails before package selection", &failures);
    _zag_str_free(forged);

    let reduced_edges: []u8 = "root\talpha\t^1.0.0";
    let reduced_lock: PackageRegistryGraphLock =
        package_registry_graph_lock_create(index, reduced_edges);
    let reduced_result: PackageRegistryGraphAuthorizedLookup =
        package_registry_graph_lock_authorized_select(index, edges,
            reduced_lock.bytes, "alpha");
    authority_check(reduced_result.authorized == 0 &&
        reduced_result.error == PackageRegistryGraphAuthorityError.lock_mismatch,
        "coverage mismatch fails closed before selection", &failures);

    let ordinary: PackageRegistryLookup = package_registry_lookup(index,
        "alpha", "^1.0.0");
    authority_check(ordinary.found == 1 && @strEq(ordinary.version, "1.2.0"),
        "ordinary lookup remains unchanged without the opt-in seam", &failures);

    if (lock.bytes.len > 0) { _zag_str_free(lock.bytes); }
    if (reduced_lock.bytes.len > 0) { _zag_str_free(reduced_lock.bytes); }
    _zag_str_free(index);
    authority_check(_zag_allocator_live_bytes() == before,
        "authority seam restores allocator baseline", &failures);
    if (failures == 0) { _zag_println("package registry graph authority: 6/6"); }
    return failures;
}
