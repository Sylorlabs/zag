@import("package_registry_transitive.zag")

// Explicit caller-owned admission for one already-resolved v2 registry
// artifact.  The default resolver is deliberately not changed.  The caller
// supplies the exact retained index/artifact bytes and filesystem paths for
// the existing no-follow Ed25519 helpers when a signed policy is requested.
enum PackageRegistryGraphV2AuthorityError {
    none,
    invalid_query,
    invalid_lock,
    lock_mismatch,
    checksum_mismatch,
    signature_mismatch,
}

struct PackageRegistryGraphV2AuthorityContext {
    index: []u8,
    edges: []u8,
    lock: []u8,
    scope: []u8,
    index_path: []u8,
    policy: PackageRegistryGraphLockV2Policy,
}

struct PackageRegistryGraphV2Authorized {
    authorized: i32,
    version: []u8,
    source: []u8,
    artifact_signature: []u8,
    error: PackageRegistryGraphV2AuthorityError,
}

fn package_registry_graph_v2_authority_bad(
    error: PackageRegistryGraphV2AuthorityError)
    PackageRegistryGraphV2Authorized {
    return PackageRegistryGraphV2Authorized{.authorized = 0, .version = "",
        .source = "", .artifact_signature = "", .error = error};
}

fn package_registry_graph_v2_lock_contains(lock: []u8, name: []u8,
    version: []u8, source: []u8, artifact_signature: []u8) i32 {
    let line_count: i32 = package_registry_graph_lock_v2_line_count(lock);
    let line_no: i32 = 2;
    while (line_no < line_count - 2) {
        let entry: PackageRegistryGraphLockV2Entry =
            package_registry_graph_lock_v2_entry(package_registry_line(lock,
                line_no));
        if (entry.valid == 1 && @strEq(entry.name, name) &&
            @strEq(entry.version, version) && @strEq(entry.source, source) &&
            @strEq(entry.artifact_signature, artifact_signature)) {
            return 1;
        }
        line_no = line_no + 1;
    }
    return 0;
}

// `index_fs_path`, `key_path`, and the detached signature paths are only used
// for signed policies.  The caller remains responsible for choosing paths
// rooted in its reviewed local registry; the existing helpers enforce bounded
// no-follow reads and detached Ed25519 verification.
fn package_registry_graph_v2_authorize(
    context: PackageRegistryGraphV2AuthorityContext,
    name: []u8, version: []u8, source: []u8, artifact_bytes: []u8,
    artifact_signature: []u8, index_fs_path: []u8, key_path: []u8,
    index_signature_path: []u8, artifact_signature_path: []u8)
    PackageRegistryGraphV2Authorized {
    if (package_import_safe_name(name) == 0 ||
        package_semver_parse(version).valid == 0 ||
        package_import_artifact_safe(source) == 0 ||
        package_registry_graph_lock_v2_policy_valid(context.policy) == 0) {
        return package_registry_graph_v2_authority_bad(
            PackageRegistryGraphV2AuthorityError.invalid_query);
    }
    let checked: PackageRegistryGraphLockV2Check =
        package_registry_graph_lock_v2_verify(context.index, context.edges,
            context.lock, context.scope, context.index_path, context.policy);
    if (checked.valid == 0) {
        let error: PackageRegistryGraphV2AuthorityError =
            PackageRegistryGraphV2AuthorityError.lock_mismatch;
        if (checked.error == PackageRegistryTransitiveError.invalid_lock) {
            error = PackageRegistryGraphV2AuthorityError.invalid_lock;
        }
        return package_registry_graph_v2_authority_bad(error);
    }
    let selected: PackageRegistryIndexLookup =
        package_registry_graph_lock_v2_select(context.index, name, "",
            context.policy);
    if (selected.found == 0 || package_registry_graph_v2_lock_contains(
            context.lock, name, version, source, artifact_signature) == 0 ||
        !@strEq(selected.version, version) ||
        !@strEq(selected.source, source) || !@strEq(
            selected.artifact_signature, artifact_signature)) {
        return package_registry_graph_v2_authority_bad(
            PackageRegistryGraphV2AuthorityError.lock_mismatch);
    }
    if (package_raw_checksum_equal(package_raw_checksum(artifact_bytes),
        selected.checksum) == 0) {
        return package_registry_graph_v2_authority_bad(
            PackageRegistryGraphV2AuthorityError.checksum_mismatch);
    }
    if (context.policy != PackageRegistryGraphLockV2Policy.unsigned) {
        // Bind the detached signature check to the exact retained index used
        // above.  The helper independently verifies the no-follow file; this
        // checksum witness prevents a different index from satisfying the
        // signature path while the caller authorizes the retained one.
        let index_read: PackageNoFollowRead =
            package_import_read_nofollow(index_fs_path);
        let index_same: i32 = index_read.ok == 1 &&
            package_raw_checksum_equal(package_raw_checksum(index_read.bytes),
                package_raw_checksum(context.index)) == 1;
        package_import_free_read(index_read.bytes);
        if (index_fs_path.len == 0 || key_path.len == 0 ||
            index_signature_path.len == 0 || index_same == 0 ||
            package_registry_signed_index_verified(index_fs_path, key_path,
                index_signature_path) == 0) {
            return package_registry_graph_v2_authority_bad(
                PackageRegistryGraphV2AuthorityError.signature_mismatch);
        }
    }
    if (context.policy == PackageRegistryGraphLockV2Policy.signed_artifact) {
        if (artifact_signature.len == 0 || artifact_signature_path.len == 0 ||
            package_registry_artifact_verified(artifact_bytes, key_path,
                artifact_signature_path) == 0) {
            return package_registry_graph_v2_authority_bad(
                PackageRegistryGraphV2AuthorityError.signature_mismatch);
        }
    }
    return PackageRegistryGraphV2Authorized{.authorized = 1,
        .version = selected.version, .source = selected.source,
        .artifact_signature = selected.artifact_signature,
        .error = PackageRegistryGraphV2AuthorityError.none};
}

// Resolver seam: admit only the exact registry result already retained by
// package_import_resolve.  This is a post-resolution caller opt-in; it does
// not alter resolver selection, perform network I/O, or publish parser state.
fn package_import_registry_graph_v2_authorize(
    result: *PackageImportResolution,
    context: PackageRegistryGraphV2AuthorityContext)
    PackageRegistryGraphV2AuthorityError {
    if (result.*.matched == 0 || result.*.registry_mode == 0 ||
        result.*.dependency.len == 0 || result.*.registry_version.len == 0 ||
        result.*.registry_source.len == 0 ||
        !@strEq(result.*.lockfile, context.index_path)) {
        result.*.graph_authorized = 0;
        result.*.error = PackageImportError.registry_lock_mismatch;
        return PackageRegistryGraphV2AuthorityError.invalid_query;
    }
    if (package_raw_checksum_equal(result.*.checksum,
        package_raw_checksum(result.*.module_source)) == 0) {
        result.*.graph_authorized = 0;
        result.*.error = PackageImportError.checksum_mismatch;
        return PackageRegistryGraphV2AuthorityError.checksum_mismatch;
    }
        let checked: PackageRegistryGraphV2Authorized =
        package_registry_graph_v2_authorize(context, result.*.dependency,
            result.*.registry_version, result.*.registry_source,
            result.*.module_source, result.*.registry_artifact_signature,
            result.*.lockfile, result.*.signature_key_path,
            result.*.signature_path, result.*.artifact_signature_path);
    if (checked.authorized == 0) {
        result.*.graph_authorized = 0;
        if (checked.error == PackageRegistryGraphV2AuthorityError.checksum_mismatch) {
            result.*.error = PackageImportError.checksum_mismatch;
        } else if (checked.error == PackageRegistryGraphV2AuthorityError.signature_mismatch) {
            result.*.error = PackageImportError.invalid_signature;
        } else {
            result.*.error = PackageImportError.registry_lock_mismatch;
        }
        return checked.error;
    }
    result.*.graph_authorized = 1;
    result.*.error = PackageImportError.none;
    return PackageRegistryGraphV2AuthorityError.none;
}
