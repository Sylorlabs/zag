// Persisted declaration fingerprints for zagd light mode. This cache is
// advisory only: malformed, stale, or unknown facts force conservative work.
@import("zagd.zag")

struct ZagdDeclFingerprint { name:[]u8, kind:i32, public:i32, parse:ZagdHash, signature:ZagdHash, layout:ZagdHash, body:ZagdHash, callers:ZagdHash, codegen_region:ZagdHash }
struct ZagdIncrementalFile { path:[]u8, content:ZagdHash, parse:ZagdHash, declarations:ArrayList[ZagdDeclFingerprint], root:ZagdHash, target:ZagdHash, valid:i32, advisory:i32, executable_authority:i32 }
struct ZagdIncrementalDecision { change:i32, reuse_parse:i32, invalidate_types:i32, invalidate_layouts:i32, invalidate_functions:i32, invalidate_callers:i32, invalidate_codegen:i32 }

fn zi_num(s:[]u8)i64{if(s.len==0){return 0-1;}let n:i64=0;let i:i32=0;while(i<s.len){if(s[i]<'0'||s[i]>'9'){return 0-1;}n=n*10+(s[i] as i64)-48;i=i+1;}return n;}
fn zi_value(text:[]u8,key:[]u8)[]u8{let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>key.len&&@strEq(line[0..key.len],key)&&line[key.len]=='='){return line[key.len+1..];}start=i+1;}i=i+1;}return "";}
fn zi_tab(line:[]u8,want:i32)[]u8{let f:i32=0;let start:i32=0;let i:i32=0;while(i<=line.len){if(i==line.len||line[i]=='\t'){if(f==want){return line[start..i];}f=f+1;start=i+1;}i=i+1;}return "";}
fn zi_hash_text(h:ZagdHash)[]u8{return _zag_str_concat(_zag_i64_to_str(h.first),_zag_str_concat("\t",_zag_str_concat(_zag_i64_to_str(h.second),_zag_str_concat("\t",_zag_i64_to_str(h.bytes)))));}
fn zi_hash(line:[]u8,at:i32)ZagdHash{return ZagdHash{.first=zi_num(zi_tab(line,at)),.second=zi_num(zi_tab(line,at+1)),.bytes=zi_num(zi_tab(line,at+2))};}
fn zi_safe(s:[]u8)i32{if(s.len==0){return 0;}let i:i32=0;while(i<s.len){if(s[i]=='\n'||s[i]=='\r'||s[i]=='\t'||s[i]=='='){return 0;}i=i+1;}return 1;}
fn zi_bad()ZagdIncrementalFile{return ZagdIncrementalFile{.path="",.content=zagd_hash_empty(),.parse=zagd_hash_empty(),.declarations=make[ZagdDeclFingerprint](1),.root=zagd_hash_empty(),.target=zagd_hash_empty(),.valid=0,.advisory=1,.executable_authority=0};}

fn zagd_incremental_encode(f:ZagdIncrementalFile)[]u8{
    if(f.valid!=1||f.advisory!=1||f.executable_authority!=0||zi_safe(f.path)==0){return "";}
    let body:[]u8="format=zagd-incremental-v1\nadvisory=true\nexecutable_authority=false\ncomplete=true\n";
    body=_zag_str_concat(body,_zag_str_concat("path=",_zag_str_concat(f.path,"\ncontent=")));body=_zag_str_concat(body,_zag_str_concat(zi_hash_text(f.content),"\nparse="));body=_zag_str_concat(body,_zag_str_concat(zi_hash_text(f.parse),"\nroot="));body=_zag_str_concat(body,_zag_str_concat(zi_hash_text(f.root),"\ntarget="));body=_zag_str_concat(body,_zag_str_concat(zi_hash_text(f.target),"\n"));
    let i:i32=0;while(i<f.declarations.len){let d:ZagdDeclFingerprint=f.declarations.data[i];if(zi_safe(d.name)==0){return "";}body=_zag_str_concat(body,"decl=");body=_zag_str_concat(body,d.name);body=_zag_str_concat(body,"\t");body=_zag_str_concat(body,_zag_i64_to_str(d.kind));body=_zag_str_concat(body,"\t");body=_zag_str_concat(body,_zag_i64_to_str(d.public));body=_zag_str_concat(body,"\t");body=_zag_str_concat(body,zi_hash_text(d.parse));body=_zag_str_concat(body,"\t");body=_zag_str_concat(body,zi_hash_text(d.signature));body=_zag_str_concat(body,"\t");body=_zag_str_concat(body,zi_hash_text(d.layout));body=_zag_str_concat(body,"\t");body=_zag_str_concat(body,zi_hash_text(d.body));body=_zag_str_concat(body,"\t");body=_zag_str_concat(body,zi_hash_text(d.callers));body=_zag_str_concat(body,"\t");body=_zag_str_concat(body,zi_hash_text(d.codegen_region));body=_zag_str_concat(body,"\n");i=i+1;}
    let sum:ZagdHash=zagd_content_hash(body);return _zag_str_concat(body,_zag_str_concat("checksum=",_zag_str_concat(zi_hash_text(sum),"\n")));
}

fn zagd_incremental_decode(text:[]u8)ZagdIncrementalFile{
    let out:ZagdIncrementalFile=zi_bad();if(!@strEq(zi_value(text,"format"),"zagd-incremental-v1")||!@strEq(zi_value(text,"advisory"),"true")||!@strEq(zi_value(text,"executable_authority"),"false")||!@strEq(zi_value(text,"complete"),"true")){return out;}
    let marker:[]u8="checksum=";let mark:i32=0-1;let i:i32=0;while(i+marker.len<=text.len){if((i==0||text[i-1]=='\n')&&@strEq(text[i..i+marker.len],marker)){mark=i;}i=i+1;}let checksum_text:[]u8=zi_value(text,"checksum");if(mark<0||mark+marker.len+checksum_text.len+1!=text.len){return out;}let want:ZagdHash=zi_hash(checksum_text,0);if(zagd_hash_equal(want,zagd_content_hash(text[0..mark]))==0){return out;}
    out.path=zi_value(text,"path");if(zi_safe(out.path)==0){return zi_bad();}out.content=zi_hash(zi_value(text,"content"),0);out.parse=zi_hash(zi_value(text,"parse"),0);out.root=zi_hash(zi_value(text,"root"),0);out.target=zi_hash(zi_value(text,"target"),0);
    let start:i32=0;i=0;while(i<=mark){if(i==mark||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>5&&@strEq(line[0..5],"decl=")){let p:[]u8=line[5..];let d:ZagdDeclFingerprint=ZagdDeclFingerprint{.name=zi_tab(p,0),.kind=zi_num(zi_tab(p,1)) as i32,.public=zi_num(zi_tab(p,2)) as i32,.parse=zi_hash(p,3),.signature=zi_hash(p,6),.layout=zi_hash(p,9),.body=zi_hash(p,12),.callers=zi_hash(p,15),.codegen_region=zi_hash(p,18)};if(zi_safe(d.name)==0||d.kind<0||d.public<0||d.public>1||d.parse.first<0||d.codegen_region.first<0){return zi_bad();}push[ZagdDeclFingerprint](&out.declarations,d);}start=i+1;}i=i+1;}out.valid=1;return out;
}

fn zagd_incremental_decide(old:ZagdIncrementalFile,new:ZagdIncrementalFile)ZagdIncrementalDecision{
    let d:ZagdIncrementalDecision=ZagdIncrementalDecision{.change=zagd_change_unknown(),.reuse_parse=0,.invalidate_types=1,.invalidate_layouts=1,.invalidate_functions=1,.invalidate_callers=1,.invalidate_codegen=1};
    if(old.valid!=1||new.valid!=1||old.advisory!=1||new.advisory!=1||old.executable_authority!=0||new.executable_authority!=0){return d;}
    if(zagd_hash_equal(old.target,new.target)==0){d.change=zagd_change_target_profile();return d;}if(zagd_hash_equal(old.root,new.root)==0){d.change=zagd_change_root_profile();return d;}
    if(zagd_hash_equal(old.content,new.content)==1){d.change=zagd_change_none();d.reuse_parse=1;d.invalidate_types=0;d.invalidate_layouts=0;d.invalidate_functions=0;d.invalidate_callers=0;d.invalidate_codegen=0;return d;}
    if(zagd_hash_equal(old.parse,new.parse)==1){d.change=zagd_change_nonsemantic();d.reuse_parse=1;d.invalidate_types=0;d.invalidate_layouts=0;d.invalidate_functions=0;d.invalidate_callers=0;d.invalidate_codegen=0;return d;}
    if(old.declarations.len!=new.declarations.len){d.change=zagd_change_public_shape();return d;}
    let private_body:i32=0;let i:i32=0;while(i<old.declarations.len){let a:ZagdDeclFingerprint=old.declarations.data[i];let b:ZagdDeclFingerprint=new.declarations.data[i];if(!@strEq(a.name,b.name)||a.kind!=b.kind||a.public!=b.public||zagd_hash_equal(a.signature,b.signature)==0||zagd_hash_equal(a.layout,b.layout)==0){d.change=zagd_change_public_shape();return d;}if(zagd_hash_equal(a.body,b.body)==0){if(a.public==1){d.change=zagd_change_public_shape();return d;}private_body=1;}i=i+1;}
    if(private_body==1){d.change=zagd_change_private_body();d.invalidate_types=0;d.invalidate_layouts=0;return d;}return d;
}
