// selfhost/opencl_c.zag — Zag → OpenCL C source emitter for OpenCL fallback.
//
// When an OpenCL device does not support SPIR-V IL upload (e.g., NVIDIA's
// OpenCL 3.0 driver), the OpenCL loader falls back to source compilation
// via clCreateProgramWithSource. This emitter produces OpenCL C source
// from the same fill kernel AST that the SPIR-V encoder consumes.
//
// The emitted OpenCL C is a simple text representation:
//   __kernel void fillKernel(__global int* out, int value, int count) {
//       int i = get_global_id(0);
//       if (i < count) { out[i] = value; }
//   }
//
// This is the simplest possible fallback — no SPIR-V, no IL, just C source
// that any OpenCL 1.2+ device can compile.

@import("parse.zag")

// ── kernel validation (mirrors spirv.zag) ───────────────────────────────────
fn ocl_is_id(n: *Node, want: []u8) bool {
    return switch (n.*) {
        .id => |x| @strEq(x.name, want),
        else => false,
    };
}

fn ocl_is_zero(n: *Node) bool {
    return switch (n.*) {
        .ilit => |x| @strEq(x.text, "0"),
        else => false,
    };
}

fn ocl_has_annot(f: *FnDecl, name: []u8) bool {
    let i: i32 = 0;
    while (i < len[[]u8](f.annots)) {
        if (@strEq(get[[]u8](f.annots, i), name)) { return true; }
        i = i + 1;
    }
    return false;
}

fn ocl_is_fill_kernel(f: *FnDecl) bool {
    if (!@strEq(f.name, "fillKernel")) { return false; }
    if (len[Param](f.params) != 3) { return false; }
    // out: []i32
    if (!@strEq(get[Param](f.params, 0).name, "out")) { return false; }
    // value: i32
    if (!@strEq(get[Param](f.params, 1).name, "value")) { return false; }
    // count: i32
    if (!@strEq(get[Param](f.params, 2).name, "count")) { return false; }
    return true;
}

fn ocl_find_profile(decls: ArrayList[*Node]) i32 {
    let found: i32 = 0;
    let kernels: i32 = 0;
    let i: i32 = 0;
    while (i < len[*Node](decls)) {
        switch (get[*Node](decls, i).*) {
            .fn_decl => |f| {
                if (ocl_has_annot(f, "@kernel") || ocl_has_annot(f, "@device")) {
                    kernels = kernels + 1;
                    if (ocl_is_fill_kernel(f)) { found = 1; }
                }
            }
            else => { }
        }
        i = i + 1;
    }
    if (kernels != 1) { return 0; }
    return found;
}

// ── OpenCL C text emission for the fill kernel ──────────────────────────────
fn ocl_emit_fill(out: *ArrayList[u8]) void {
    let src: []u8 = "__kernel void fillKernel(__global int* out, int value, int count) {\n    int i = get_global_id(0);\n    if (i < count) {\n        out[i] = value;\n    }\n}\n";
    let i: i32 = 0;
    while (i < src.len) { push[u8](out, src[i]); i = i + 1; }
}

// ── public entry point ──────────────────────────────────────────────────────
fn emit_opencl_c(src: []u8, errors: *i32) ArrayList[u8] {
    let decls: ArrayList[*Node] = parse_program(src);
    let out: ArrayList[u8] = make[u8](256);
    let profile: i32 = ocl_find_profile(decls);
    if (profile == 0) {
        _zag_println("znc[opencl-c]: unsupported kernel: require exactly one reviewed bounded fill @kernel");
        errors.* = errors.* + 1;
        return out;
    }
    if (profile == 1) {
        ocl_emit_fill(&out);
    } else {
        _zag_println("znc[opencl-c]: only the fill profile is implemented");
        errors.* = errors.* + 1;
        return out;
    }
    return out;
}

fn emit_opencl_c_dir(src: []u8, base_dir: []u8, errors: *i32) ArrayList[u8] {
    let decls: ArrayList[*Node] = parse_program_dir(src, base_dir);
    let out: ArrayList[u8] = make[u8](256);
    let profile: i32 = ocl_find_profile(decls);
    if (profile == 0) {
        _zag_println("znc[opencl-c]: unsupported kernel: require exactly one reviewed bounded fill @kernel");
        errors.* = errors.* + 1;
        return out;
    }
    if (profile == 1) {
        ocl_emit_fill(&out);
    } else {
        _zag_println("znc[opencl-c]: only the fill profile is implemented");
        errors.* = errors.* + 1;
        return out;
    }
    return out;
}
