@import("zagd_generation.zag")

fn expect(ok:i32,label:[]u8,fail:*i32)void{if(ok==1){return;}_zag_print("FAIL generation worker: ");_zag_println(label);fail.*=fail.*+1;}

fn main() i32 {
    let fail:i32=0;
    let generation:ZagdHash=zagd_content_hash("candidate-generation-v1");
    let safe:ZagdGenerationWorkerRequest=ZagdGenerationWorkerRequest{
        .generation=generation,.worker_id="worker-1",.memory_bytes=67108864,
        .timeout_ms=1000,.output_bytes=4096,.network=0,.devices=0,
        .source_writes=0,.verifier_writes=0};
    let admitted:ZagdGenerationWorkerAdmission=zagd_generation_worker_admit(safe);
    expect(admitted.valid==1&&admitted.metadata_admitted==1&&admitted.execution_enabled==0&&
        admitted.foreground_fallback==1&&admitted.memory_limit_bytes==536870912&&
        admitted.timeout_limit_ms==60000&&admitted.output_limit_bytes==65536,
        "safe request is metadata-admitted with execution disabled",&fail);
    let bad_generation:ZagdGenerationWorkerRequest=safe;bad_generation.generation=zagd_generation_bad_hash();
    expect(zagd_generation_worker_admit(bad_generation).valid==0,"missing generation identity rejects",&fail);
    let bad_memory:ZagdGenerationWorkerRequest=safe;bad_memory.memory_bytes=536870913;
    expect(zagd_generation_worker_admit(bad_memory).valid==0,"oversized memory rejects",&fail);
    let bad_timeout:ZagdGenerationWorkerRequest=safe;bad_timeout.timeout_ms=60001;
    expect(zagd_generation_worker_admit(bad_timeout).valid==0,"oversized timeout rejects",&fail);
    let bad_output:ZagdGenerationWorkerRequest=safe;bad_output.output_bytes=65537;
    expect(zagd_generation_worker_admit(bad_output).valid==0,"oversized output rejects",&fail);
    let bad_network:ZagdGenerationWorkerRequest=safe;bad_network.network=1;
    expect(zagd_generation_worker_admit(bad_network).valid==0,"network capability rejects",&fail);
    let bad_device:ZagdGenerationWorkerRequest=safe;bad_device.devices=1;
    expect(zagd_generation_worker_admit(bad_device).valid==0,"device capability rejects",&fail);
    let bad_write:ZagdGenerationWorkerRequest=safe;bad_write.source_writes=1;
    expect(zagd_generation_worker_admit(bad_write).valid==0,"source write capability rejects",&fail);
    if(fail==0){_zag_println("zagd generation worker: pass=8 fail=0");}return fail;
}
