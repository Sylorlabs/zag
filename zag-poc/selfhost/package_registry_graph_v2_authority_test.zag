@import("package_registry_graph_v2_authority.zag")

extern fn _zag_allocator_live_bytes() i64

fn authority_check(ok: i32, label: []u8, failures: *i32) void {
    if (ok != 0) { _zag_print("ok  "); _zag_println(label); }
    else { failures.* = failures.* + 1; _zag_print("FAIL "); _zag_println(label); }
}

fn authority_index(artifact: []u8, signed: i32, include_beta: i32) []u8 {
    let checksum: PackageRawChecksum = package_raw_checksum(artifact);
    let first: []u8 = _zag_i64_to_str(checksum.first);
    let second: []u8 = _zag_i64_to_str(checksum.second);
    let bytes: []u8 = _zag_i64_to_str(checksum.bytes);
    let signature: []u8 = "none";
    if (signed != 0) { signature = "ed25519"; }
    let body: []u8 = _zag_str_concat(
        "format=zag-registry-index-v1\nauthority=local-file-v1\nsignature=",
        signature);
    body = package_registry_transitive_append_owned(body,
        "\nentry=alpha\t1.0.0\tsrc/alpha.zag\t");
    body = package_registry_transitive_append_owned(body, first);
    body = package_registry_transitive_append_owned(body, ",");
    body = package_registry_transitive_append_owned(body, second);
    body = package_registry_transitive_append_owned(body, ",");
    body = package_registry_transitive_append_owned(body, bytes);
    body = package_registry_transitive_append_owned(body, "\n");
    if (include_beta != 0) {
        body = package_registry_transitive_append_owned(body,
            "entry=beta\t1.0.0\tsrc/beta.zag\t");
        body = package_registry_transitive_append_owned(body, first);
        body = package_registry_transitive_append_owned(body, ",");
        body = package_registry_transitive_append_owned(body, second);
        body = package_registry_transitive_append_owned(body, ",");
        body = package_registry_transitive_append_owned(body, bytes);
        body = package_registry_transitive_append_owned(body, "\n");
    }
    let result: []u8 = package_registry_finalize(body);
    _zag_str_free(body); _zag_str_free(first); _zag_str_free(second);
    _zag_str_free(bytes);
    return result;
}

fn authority_index_with_artifact_signature(artifact: []u8) []u8 {
    let checksum: PackageRawChecksum = package_raw_checksum(artifact);
    let first: []u8 = _zag_i64_to_str(checksum.first);
    let second: []u8 = _zag_i64_to_str(checksum.second);
    let bytes: []u8 = _zag_i64_to_str(checksum.bytes);
    let prefix: []u8 = _zag_str_concat(
        "format=zag-registry-index-v1\nauthority=local-file-v1\nsignature=none\nentry=alpha\t1.0.0\tsrc/alpha.zag\t",
        first);
    let with_second: []u8 = _zag_str_concat(prefix, ",");
    let with_bytes: []u8 = _zag_str_concat(with_second, second);
    let with_size: []u8 = _zag_str_concat(with_bytes, ",");
    let with_checksum: []u8 = _zag_str_concat(with_size, bytes);
    let complete: []u8 = _zag_str_concat(with_checksum,
        "\tsig/alpha.ed25519\n");
    let result: []u8 = package_registry_finalize(complete);
    _zag_str_free(prefix); _zag_str_free(with_second);
    _zag_str_free(with_bytes); _zag_str_free(with_size);
    _zag_str_free(with_checksum); _zag_str_free(first);
    _zag_str_free(second); _zag_str_free(bytes); _zag_str_free(complete);
    return result;
}

fn main() i32 {
    let failures: i32 = 0;
    let before: i64 = _zag_allocator_live_bytes();
    let artifact: []u8 = "artifact alpha\n";
    let index: []u8 = authority_index(artifact, 0, 0);
    let edges: []u8 = "root\talpha\t^1.0.0";
    let lock: PackageRegistryGraphLockV2 = package_registry_graph_lock_v2_create(
        index, edges, "root", "registry/index.zag",
        PackageRegistryGraphLockV2Policy.unsigned);
    let context: PackageRegistryGraphV2AuthorityContext =
        PackageRegistryGraphV2AuthorityContext{.index = index, .edges = edges,
            .lock = lock.bytes, .scope = "root",
            .index_path = "registry/index.zag",
            .policy = PackageRegistryGraphLockV2Policy.unsigned};

    let authorized: PackageRegistryGraphV2Authorized =
        package_registry_graph_v2_authorize(context, "alpha", "1.0.0",
            "src/alpha.zag", artifact, "", "", "", "", "");
    authority_check(authorized.authorized == 1 &&
        authorized.error == PackageRegistryGraphV2AuthorityError.none,
        "authority admits exact retained artifact under explicit unsigned policy",
        &failures);

    let resolved: PackageImportResolution = package_import_result("pkg:alpha");
    resolved.matched = 1; resolved.registry_mode = 1;
    resolved.dependency = "alpha"; resolved.registry_version = "1.0.0";
    resolved.registry_source = "src/alpha.zag"; resolved.module_source = artifact;
    resolved.checksum = package_raw_checksum(artifact);
    resolved.lockfile = "registry/index.zag";
    let resolved_error: PackageRegistryGraphV2AuthorityError =
        package_import_registry_graph_v2_authorize(&resolved, context);
    authority_check(resolved_error == PackageRegistryGraphV2AuthorityError.none &&
        resolved.graph_authorized == 1 && resolved.error == PackageImportError.none,
        "resolver result admission binds the retained module to the v2 graph",
        &failures);

    // The detached-signature pathname is a retained registry tuple field, not
    // the later resolved filesystem path.  Even unsigned policy must bind it
    // so a caller cannot silently authorize different index metadata.
    let signature_index: []u8 =
        authority_index_with_artifact_signature(artifact);
    let signature_edges: []u8 = "root\talpha\t^1.0.0";
    let signature_lock: PackageRegistryGraphLockV2 =
        package_registry_graph_lock_v2_create(signature_index, signature_edges,
            "root", "registry/index.zag",
            PackageRegistryGraphLockV2Policy.unsigned);
    let signature_context: PackageRegistryGraphV2AuthorityContext =
        PackageRegistryGraphV2AuthorityContext{.index = signature_index,
            .edges = signature_edges, .lock = signature_lock.bytes,
            .scope = "root", .index_path = "registry/index.zag",
            .policy = PackageRegistryGraphLockV2Policy.unsigned};
    let retained_signature: PackageImportResolution =
        package_import_result("pkg:alpha");
    retained_signature.matched = 1; retained_signature.registry_mode = 1;
    retained_signature.dependency = "alpha";
    retained_signature.registry_version = "1.0.0";
    retained_signature.registry_source = "src/alpha.zag";
    retained_signature.registry_artifact_signature = "sig/alpha.ed25519";
    retained_signature.module_source = artifact;
    retained_signature.checksum = package_raw_checksum(artifact);
    retained_signature.lockfile = _zag_str_concat("", "registry/index.zag");
    let retained_signature_error: PackageRegistryGraphV2AuthorityError =
        package_import_registry_graph_v2_authorize(&retained_signature,
            signature_context);
    authority_check(retained_signature_error ==
        PackageRegistryGraphV2AuthorityError.none &&
        retained_signature.graph_authorized == 1 &&
        retained_signature.error == PackageImportError.none,
        "resolver result admission binds the retained artifact signature tuple",
        &failures);
    retained_signature.registry_artifact_signature = "sig/forged.ed25519";
    let forged_signature_error: PackageRegistryGraphV2AuthorityError =
        package_import_registry_graph_v2_authorize(&retained_signature,
            signature_context);
    authority_check(forged_signature_error ==
        PackageRegistryGraphV2AuthorityError.lock_mismatch &&
        retained_signature.graph_authorized == 0 &&
        retained_signature.error == PackageImportError.registry_lock_mismatch,
        "resolver result admission rejects a forged artifact signature tuple",
        &failures);

    resolved.checksum = package_raw_checksum("stale module\n");
    let stale_result_error: PackageRegistryGraphV2AuthorityError =
        package_import_registry_graph_v2_authorize(&resolved, context);
    authority_check(stale_result_error == PackageRegistryGraphV2AuthorityError.checksum_mismatch &&
        resolved.graph_authorized == 0 &&
        resolved.error == PackageImportError.checksum_mismatch,
        "resolver result admission rejects stale retained checksum metadata",
        &failures);

    resolved.checksum = package_raw_checksum(artifact);
    resolved.registry_version = "2.0.0";
    let stale_result_tuple: PackageRegistryGraphV2AuthorityError =
        package_import_registry_graph_v2_authorize(&resolved, context);
    authority_check(stale_result_tuple == PackageRegistryGraphV2AuthorityError.lock_mismatch &&
        resolved.graph_authorized == 0 &&
        resolved.error == PackageImportError.registry_lock_mismatch,
        "resolver result admission rejects a stale selected version",
        &failures);

    let stale_artifact: PackageRegistryGraphV2Authorized =
        package_registry_graph_v2_authorize(context, "alpha", "1.0.0",
            "src/alpha.zag", "forged alpha\n", "", "", "", "", "");
    authority_check(stale_artifact.authorized == 0 &&
        stale_artifact.error == PackageRegistryGraphV2AuthorityError.checksum_mismatch,
        "authority rejects artifact bytes with a stale checksum", &failures);

    let stale_tuple: PackageRegistryGraphV2Authorized =
        package_registry_graph_v2_authorize(context, "alpha", "1.0.0",
            "src/other.zag", artifact, "", "", "", "", "");
    authority_check(stale_tuple.authorized == 0 &&
        stale_tuple.error == PackageRegistryGraphV2AuthorityError.lock_mismatch,
        "authority rejects a tuple that differs from the v2 lock", &failures);

    let expanded_index: []u8 = authority_index(artifact, 0, 1);
    let expanded_lock: PackageRegistryGraphLockV2 =
        package_registry_graph_lock_v2_create(expanded_index, edges, "root",
            "registry/index.zag", PackageRegistryGraphLockV2Policy.unsigned);
    let expanded_context: PackageRegistryGraphV2AuthorityContext =
        PackageRegistryGraphV2AuthorityContext{.index = expanded_index,
            .edges = edges, .lock = expanded_lock.bytes, .scope = "root",
            .index_path = "registry/index.zag",
            .policy = PackageRegistryGraphLockV2Policy.unsigned};
    let ungraphed: PackageRegistryGraphV2Authorized =
        package_registry_graph_v2_authorize(expanded_context, "beta", "1.0.0",
            "src/beta.zag", artifact, "", "", "", "", "");
    authority_check(ungraphed.authorized == 0 &&
        ungraphed.error == PackageRegistryGraphV2AuthorityError.lock_mismatch,
        "authority rejects an index package absent from the locked graph",
        &failures);

    let forged_lock: []u8 = _zag_str_concat(lock.bytes, "x");
    let forged_context: PackageRegistryGraphV2AuthorityContext =
        PackageRegistryGraphV2AuthorityContext{.index = index, .edges = edges,
            .lock = forged_lock, .scope = "root",
            .index_path = "registry/index.zag",
            .policy = PackageRegistryGraphLockV2Policy.unsigned};
    let invalid_lock: PackageRegistryGraphV2Authorized =
        package_registry_graph_v2_authorize(forged_context, "alpha", "1.0.0",
            "src/alpha.zag", artifact, "", "", "", "", "");
    authority_check(invalid_lock.authorized == 0 &&
        invalid_lock.error == PackageRegistryGraphV2AuthorityError.invalid_lock,
        "authority rejects a forged v2 lock envelope", &failures);
    _zag_str_free(forged_lock);

    let changed_body: []u8 =
        "format=zag-registry-index-v1\nauthority=local-file-v1\nsignature=none\nentry=alpha\t1.0.0\tsrc/alpha.zag\t0,0,0\nentry=beta\t1.0.0\tsrc/beta.zag\t0,0,0\n";
    let changed_index: []u8 = package_registry_finalize(changed_body);
    let changed_context: PackageRegistryGraphV2AuthorityContext =
        PackageRegistryGraphV2AuthorityContext{.index = changed_index,
            .edges = edges, .lock = lock.bytes, .scope = "root",
            .index_path = "registry/index.zag",
            .policy = PackageRegistryGraphLockV2Policy.unsigned};
    let changed: PackageRegistryGraphV2Authorized =
        package_registry_graph_v2_authorize(changed_context, "alpha", "1.0.0",
            "src/alpha.zag", artifact, "", "", "", "", "");
    authority_check(changed.authorized == 0 &&
        changed.error == PackageRegistryGraphV2AuthorityError.lock_mismatch,
        "authority rejects an index changed after lock creation", &failures);

    let signed_index: []u8 = authority_index(artifact, 1, 0);
    let signed_lock: PackageRegistryGraphLockV2 =
        package_registry_graph_lock_v2_create(signed_index, edges, "root",
            "registry/index.zag", PackageRegistryGraphLockV2Policy.signed_index);
    let signed_context: PackageRegistryGraphV2AuthorityContext =
        PackageRegistryGraphV2AuthorityContext{.index = signed_index, .edges = edges,
            .lock = signed_lock.bytes, .scope = "root",
            .index_path = "registry/index.zag",
            .policy = PackageRegistryGraphLockV2Policy.signed_index};
    let missing_signature: PackageRegistryGraphV2Authorized =
        package_registry_graph_v2_authorize(signed_context, "alpha", "1.0.0",
            "src/alpha.zag", artifact, "", "", "", "", "");
    authority_check(missing_signature.authorized == 0 &&
        missing_signature.error == PackageRegistryGraphV2AuthorityError.signature_mismatch,
        "signed opt-in fails closed when detached signature paths are absent",
        &failures);

    if (lock.bytes.len > 0) { _zag_str_free(lock.bytes); }
    if (expanded_lock.bytes.len > 0) { _zag_str_free(expanded_lock.bytes); }
    if (signed_lock.bytes.len > 0) { _zag_str_free(signed_lock.bytes); }
    if (signature_lock.bytes.len > 0) {
        _zag_str_free(signature_lock.bytes);
    }
    _zag_str_free(index); _zag_str_free(expanded_index);
    _zag_str_free(signed_index); _zag_str_free(changed_index);
    _zag_str_free(signature_index);
    package_import_resolution_release(&retained_signature);
    authority_check(_zag_allocator_live_bytes() == before,
        "authority restores allocator baseline", &failures);
    if (failures == 0) {
        _zag_println("package registry graph v2 authority: 12/12");
    }
    return failures;
}
