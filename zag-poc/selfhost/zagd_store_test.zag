@import("zagd_store.zag")
extern fn _zag_allocator_live_bytes() i64
fn zs(ok:i32,m:[]u8,f:*i32)void{if(ok==1){return;}_zag_println(m);f.*=f.*+1;}
fn zs_transaction_lifetime()i32{
    let temp:[]u8="/tmp/zagd_store_lifetime.tmp";
    let final:[]u8="/tmp/zagd_store_lifetime.final";
    zagd_unlink(temp);zagd_unlink(final);
    let base:i64=_zag_allocator_live_bytes();
    let i:i32=0;
    while(i<128){
        if(zagd_store_mkdir("/tmp")!=1){return 0;}
        if(zagd_store_transaction(temp,final,"ok")!=1){return 0;}
        if(zagd_store_transaction(temp,"/dev/null/final","fail")!=0){return 0;}
        if(_zag_file_exists(temp)!=0||_zag_allocator_live_bytes()!=base){return 0;}
        i=i+1;
    }
    zagd_unlink(final);
    return (_zag_allocator_live_bytes()==base) as i32;
}
fn zs_hash_text(out:*ArrayList[u8],h:ZagdHash)void{zagd_text_append_i64(out,h.first);zagd_text_append_byte(out,'\t');zagd_text_append_i64(out,h.second);zagd_text_append_byte(out,'\t');zagd_text_append_i64(out,h.bytes);}
fn zs_snapshot_record(compiler:[]u8,mode:[]u8,module:[]u8,source:ZagdHash,
        project:ZagdHash,graph:ZagdHash,graph_complete:i32,timestamp:i64,
        identity:ZagdHash,parent:ZagdHash,extra:[]u8)[]u8{
    let body:ArrayList[u8]=zagd_text(768);
    zagd_text_append(&body,"format=zagd-snapshot-v2\nadvisory=true\nexecutable_authority=false\ncomplete=true\nvalidity=valid\ncompiler=");
    zagd_text_append(&body,compiler);zagd_text_append(&body,"\ntarget=linux-x86_64-generic\nprofile=regular-or-script-root\nmode=");
    zagd_text_append(&body,mode);zagd_text_append(&body,"\nroot_module_present=");
    if(module.len>0){zagd_text_append(&body,"1\nroot_module=");zagd_text_append(&body,module);}
    else{zagd_text_append(&body,"0\nroot_module=<unspecified>");}
    zagd_text_append(&body,"\nroot_project=");zs_hash_text(&body,project);
    zagd_text_append(&body,"\nroot_source=");zs_hash_text(&body,source);
    zagd_text_append(&body,"\nsemantic_graph=");zs_hash_text(&body,graph);
    zagd_text_append(&body,"\nsemantic_graph_complete=");zagd_text_append_i64(&body,graph_complete);
    zagd_text_append(&body,"\ntimestamp_ms=");zagd_text_append_i64(&body,timestamp);
    zagd_text_append(&body,"\ntimestamp_basis=linux-monotonic-ms\ntimestamp_in_identity=false\nsnapshot_identity=");zs_hash_text(&body,identity);
    zagd_text_append(&body,"\nparent_identity=");zs_hash_text(&body,parent);
    zagd_text_append(&body,"\nfile_count=7\n");zagd_text_append(&body,extra);
    let sum:ZagdHash=zagd_content_hash(body.data[0..body.len]);
    zagd_text_append(&body,"checksum_first=");zagd_text_append_i64(&body,sum.first);
    zagd_text_append(&body,"\nchecksum_second=");zagd_text_append_i64(&body,sum.second);
    zagd_text_append_byte(&body,'\n');return body.data[0..body.len];
}
fn main()i32{let f:i32=0;zs(zs_transaction_lifetime()==1,"cache syscall path lifetimes",&f);let h:ZagdHash=zagd_content_hash("same");let key:ZagdStoreKey=ZagdStoreKey{.compiler=zagd_content_hash("c1"),.target=zagd_content_hash("x86"),.profile=zagd_content_hash("script"),.config=zagd_content_hash("light"),.snapshot=h};let r:ZagdStoreRecord=zagd_store_record(key,"payload",9);
zs(zagd_canonical_relative("src/a.zag")==1&&zagd_canonical_relative("../a")==0&&zagd_canonical_relative("/a")==0&&zagd_canonical_relative("a/./b")==0&&zagd_canonical_relative("a//b")==0&&zagd_canonical_relative("a/")==0&&zagd_canonical_relative("a\\b")==0,"canonical paths",&f);zs(zagd_store_accept(r,key,"payload",100)==1,"hit",&f);zs(zagd_store_accept(r,ZagdStoreKey{.compiler=zagd_content_hash("c2"),.target=key.target,.profile=key.profile,.config=key.config,.snapshot=key.snapshot},"payload",100)==0,"stale compiler",&f);zs(zagd_store_accept(r,ZagdStoreKey{.compiler=key.compiler,.target=zagd_content_hash("arm"),.profile=key.profile,.config=key.config,.snapshot=key.snapshot},"payload",100)==0,"stale target",&f);zs(zagd_store_accept(r,ZagdStoreKey{.compiler=key.compiler,.target=key.target,.profile=key.profile,.config=zagd_content_hash("deep"),.snapshot=key.snapshot},"payload",100)==0,"stale config",&f);zs(zagd_store_accept(r,key,"corrupt",100)==0,"corruption miss",&f);r.complete=0;zs(zagd_store_accept(r,key,"payload",100)==0,"incomplete miss",&f);zs(zagd_hash_equal(h,zagd_content_hash("same"))==1,"identical rewrite",&f);zs(zagd_classify_change(1,0,0,0,0,1)==zagd_change_nonsemantic()&&zagd_classify_change(1,1,0,0,0,1)==zagd_change_private_body()&&zagd_classify_change(1,1,1,0,0,1)==zagd_change_public_shape()&&zagd_classify_change(1,1,0,1,0,1)==zagd_change_root_profile()&&zagd_classify_change(1,1,0,0,1,1)==zagd_change_target_profile(),"invalidation classes",&f);zs(zagd_store_evict(5000000000,100,5000000000)==100&&zagd_store_evict(0,5000000001,5000000000)==(0-1),"bounded i64 eviction",&f);
let temp:[]u8="/tmp/zagd_store_tx_test.tmp";let final:[]u8="/tmp/zagd_store_tx_test.final";zagd_unlink(temp);zagd_unlink(final);zs(zagd_store_transaction(temp,final,"transaction-payload")==1&&@strEq(_zag_read_file(final),"transaction-payload")&&_zag_file_exists(temp)==0,"atomic transaction",&f);zagd_unlink(final);let badtemp:[]u8="/tmp/zagd_store_tx_fail.tmp";zagd_unlink(badtemp);zs(zagd_store_transaction(badtemp,"/tmp/zagd-store-missing-dir/final","x")==0&&_zag_file_exists(badtemp)==0,"failed rename cleans temp",&f);
let project:ZagdHash=zagd_content_hash("/project");let source:ZagdHash=zagd_content_hash("source");let graph:ZagdHash=zagd_content_hash("graph");let identity:ZagdHash=zagd_snapshot_begin(project,zagd_content_hash("app.zag"),source,graph,1);let parent:ZagdHash=zagd_content_hash("parent");
let encoded:[]u8=zs_snapshot_record("1.2.3","adaptive","app.zag",source,project,graph,1,100,identity,parent,"");let decoded:ZagdSnapshotRecord=zagd_snapshot_record_decode(encoded);
zs(decoded.valid==1&&zagd_hash_equal(decoded.identity,identity)==1&&zagd_hash_equal(decoded.parent,parent)==1&&@strEq(decoded.root_module,"app.zag")&&zagd_hash_equal(decoded.root_source,source)==1&&zagd_hash_equal(decoded.semantic_graph,graph)==1&&decoded.semantic_graph_complete==1&&decoded.timestamp_ms==100&&decoded.file_count==7,"snapshot v2 decode",&f);
zs(zagd_snapshot_record_decode(_zag_str_concat(encoded,"corrupt")).valid==0,"snapshot trailing corruption miss",&f);
let old:[]u8="advisory=true\nexecutable_authority=false\nsnapshot_first=12\nsnapshot_second=34\nparent_first=5\nfile_count=7\n";zs(zagd_snapshot_record_decode(old).valid==0,"snapshot v1 compatibility miss",&f);
let duplicate:[]u8=zs_snapshot_record("1.2.3","adaptive","app.zag",source,project,graph,1,100,identity,parent,"mode=deep\n");zs(zagd_snapshot_record_decode(duplicate).valid==0,"snapshot duplicate field miss",&f);
let unsafe_path_record:[]u8=zs_snapshot_record("1.2.3","adaptive","../app.zag",source,project,graph,1,100,identity,parent,"");zs(zagd_snapshot_record_decode(unsafe_path_record).valid==0,"snapshot unsafe root miss",&f);
let invalid_graph:[]u8=zs_snapshot_record("1.2.3","adaptive","app.zag",source,project,graph,0,100,identity,parent,"");zs(zagd_snapshot_record_decode(invalid_graph).valid==0,"snapshot incomplete graph binding miss",&f);
let later:[]u8=zs_snapshot_record("1.2.3","adaptive","app.zag",source,project,graph,1,200,identity,parent,"");zs(zagd_hash_equal(zagd_snapshot_record_decode(later).identity,decoded.identity)==1,"snapshot timestamp excluded from identity",&f);
zs(zagd_snapshot_record_compatible(encoded,"1.2.3","linux-x86_64-generic","adaptive","app.zag",source,project,graph,1).valid==1,"compatible snapshot v2 restart hit",&f);
zs(zagd_snapshot_record_compatible(encoded,"1.2.4","linux-x86_64-generic","adaptive","app.zag",source,project,graph,1).valid==0&&zagd_snapshot_record_compatible(encoded,"1.2.3","linux-x86_64-generic","deep","app.zag",source,project,graph,1).valid==0&&zagd_snapshot_record_compatible(encoded,"1.2.3","linux-x86_64-generic","adaptive","other.zag",source,project,graph,1).valid==0&&zagd_snapshot_record_compatible(encoded,"1.2.3","linux-x86_64-generic","adaptive","app.zag",zagd_content_hash("changed"),project,graph,1).valid==0&&zagd_snapshot_record_compatible(encoded,"1.2.3","linux-x86_64-generic","adaptive","app.zag",source,project,zagd_content_hash("changed-graph"),1).valid==0,"stale snapshot v2 binding miss",&f);
let ah:ZagdHash=zagd_content_hash("source");let ahs:[]u8=_zag_str_concat(_zag_i64_to_str(ah.first),_zag_str_concat("\t",_zag_str_concat(_zag_i64_to_str(ah.second),_zag_str_concat("\t",_zag_i64_to_str(ah.bytes)))));let abody:[]u8=_zag_str_concat("format=zagd-artifact-index-v2\nadvisory=true\nexecutable_authority=false\ncomplete=true\ncompiler=1\ntarget=x86\nsemantic_source=",_zag_str_concat(ahs,"\ngraph_identity=1\t2\t3\ngraph_complete=1\nartifact_identity=1\t2\t3\nforeground_machine_cache_link=3\t2\t1\nforeground_machine_cache_authority=false\n"));let asum:ZagdHash=zagd_content_hash(abody);let artifact:[]u8=_zag_str_concat(abody,_zag_str_concat("checksum_first=",_zag_str_concat(_zag_i64_to_str(asum.first),_zag_str_concat("\nchecksum_second=",_zag_str_concat(_zag_i64_to_str(asum.second),"\n")))));zs(zagd_artifact_record_decode(artifact,"1","x86",ah).valid==1&&zagd_artifact_record_decode(artifact,"2","x86",ah).valid==0&&zagd_artifact_record_decode(_zag_str_concat(artifact,"x"),"1","x86",ah).valid==0,"artifact cache validation",&f);
if(f==0){_zag_println("zagd store: pass=23 fail=0");}return f;}
