let compatible_body:[]u8="advisory=true\nexecutable_authority=false\ncompiler=1.2.3\ntarget=linux-x86_64-generic\nmode=adaptive\nsnapshot_first=12\nsnapshot_second=34\nparent_first=5\nfile_count=7\n";let compatible_sum:ZagdHash=zagd_content_hash(compatible_body);let compatible_text:[]u8=_zag_str_concat(compatible_body,_zag_str_concat("checksum_first=",_zag_str_concat(_zag_i64_to_str(compatible_sum.first),_zag_str_concat("\nchecksum_second=",_zag_str_concat(_zag_i64_to_str(compatible_sum.second),"\n")))));zs(zagd_snapshot_record_compatible(compatible_text,"1.2.3","linux-x86_64-generic","adaptive").valid==1,"compatible restart hit",&f);zs(zagd_snapshot_record_compatible(compatible_text,"1.2.4","linux-x86_64-generic","adaptive").valid==0&&zagd_snapshot_record_compatible(compatible_text,"1.2.3","linux-x86_64-generic","deep").valid==0,"stale restart miss",&f);
