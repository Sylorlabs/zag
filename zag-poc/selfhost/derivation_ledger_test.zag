@import("derivation_ledger.zag")

fn dlt_check(ok:i32,name:[]u8,fail:*i32)void{if(ok==1){_zag_println(name);}else{_zag_eprintln(name);fail.*=fail.*+1;}}
fn dlt_equal(a:[]u8,b:[]u8)i32{if(a.len!=b.len){return 0;}let i:i32=0;while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}return 1;}
fn dlt_hash_same(a:ZagdHash,b:ZagdHash)i32{return (a.first==b.first&&a.second==b.second&&a.bytes==b.bytes) as i32;}

fn dlt_record_checks(record:[]u8,evidence:ZdlPreparedEvidence)i32{
    let view:ZdlLedgerView=zdl_decode(record);let ok:i32=1;
    if(record.len<=0||view.recognized!=1||view.version!=2||view.valid!=1){ok=0;}
    if(dlt_equal(view.compact,evidence.compact)==0||dlt_equal(view.derived,evidence.derived)==0||dlt_equal(view.compact_path,evidence.compact_path)==0){ok=0;}
    if(view.module_count!=2||view.import_count!=1||view.resource_count!=1||view.choice_count!=10||view.transform_count!=3){ok=0;}
    if(dlt_hash_same(view.compact_hash,zagd_content_hash(evidence.compact))==0||dlt_hash_same(view.derived_hash,zagd_content_hash(evidence.derived))==0){ok=0;}
    if(dlt_hash_same(view.semantic_manifest,zagd_content_hash(evidence.semantic_manifest))==0){ok=0;}
    return ok;
}
fn dlt_decode_valid(record:[]u8)i32{let view:ZdlLedgerView=zdl_decode(record);return view.valid;}
fn dlt_prefix(line:[]u8,prefix:[]u8)i32{return (line.len>=prefix.len&&@strEq(line[0..prefix.len],prefix)==1) as i32;}
fn dlt_variant(record:[]u8,match:[]u8,replacement:[]u8,mode:i32)[]u8{
    let body:*u8=_zag_malloc((record.len as i64)+(replacement.len as i64)+128) as *u8;let n:i32=0;let start:i32=0;let i:i32=0;
    while(i<=record.len){if(i==record.len||record[i]==10){let line:[]u8=record[start..i];if(dlt_prefix(line,"record_checksum=")==0){let hit:i32=dlt_prefix(line,match);if(hit==1&&mode==0){}else{let source:[]u8=line;if(hit==1&&mode==2){let k:i32=0;while(k<replacement.len){body[n]=replacement[k];n=n+1;k=k+1;}let rest:i32=match.len;while(rest<source.len){body[n]=source[rest];n=n+1;rest=rest+1;}}else if(hit==1&&mode==3){let k:i32=0;while(k<replacement.len){body[n]=replacement[k];n=n+1;k=k+1;}}else{let k:i32=0;while(k<source.len){body[n]=source[k];n=n+1;k=k+1;}}
                    body[n]=10;n=n+1;if(hit==1&&mode==1){let k:i32=0;while(k<source.len){body[n]=source[k];n=n+1;k=k+1;}body[n]=10;n=n+1;}}}start=i+1;}i=i+1;}
    let hash:ZagdHash=zagd_content_hash(body[0..n]);let hash_text:[]u8=zdl_hash_text(hash);let line1:[]u8=_zag_str_concat("record_checksum=",hash_text);let suffix:[]u8=_zag_str_concat(line1,"\n");let out:*u8=_zag_malloc((n+suffix.len+1) as i64) as *u8;let j:i32=0;while(j<n){out[j]=body[j];j=j+1;}j=0;while(j<suffix.len){out[n+j]=suffix[j];j=j+1;}out[n+suffix.len]=0;let body_view:[]u8=body[0..((record.len+replacement.len+128) as i32)];_zag_free(_zag_slice_ptr(body_view));_zag_free(_zag_slice_ptr(hash_text));_zag_free(_zag_slice_ptr(line1));return out[0..n+suffix.len];
}
fn dlt_append(out:*ArrayList[u8],text:[]u8)void{let i:i32=0;while(i<text.len){push[u8](out,text[i]);i=i+1;}}
fn dlt_v1_record(e:ZdlPreparedEvidence)[]u8{
    let out:ArrayList[u8]=make[u8](1024);let c:[]u8=zdl_hex_encode(e.compact);let d:[]u8=zdl_hex_encode(e.derived);let p:[]u8=zdl_hex_encode(e.compact_path);let ch:[]u8=zdl_hash_text_v1(zagd_content_hash(e.compact));let dh:[]u8=zdl_hash_text_v1(zagd_content_hash(e.derived));
    dlt_append(&out,"format=zagscript-derivation-v1\ncompact_hex=");dlt_append(&out,c);dlt_append(&out,"\nderived_hex=");dlt_append(&out,d);dlt_append(&out,"\ncompact_path_hex=");dlt_append(&out,p);dlt_append(&out,"\ncompact_hash=");dlt_append(&out,ch);dlt_append(&out,"\nderived_hash=");dlt_append(&out,dh);dlt_append(&out,"\n");
    let result:*u8=_zag_malloc((out.len+1) as i64) as *u8;let i:i32=0;while(i<out.len){result[i]=out.data[i];i=i+1;}result[out.len]=0;let view:[]u8=result[0..out.len];free[u8](&out);_zag_free(_zag_slice_ptr(c));_zag_free(_zag_slice_ptr(d));_zag_free(_zag_slice_ptr(p));_zag_free(_zag_slice_ptr(ch));_zag_free(_zag_slice_ptr(dh));return view;
}

fn dlt_make_evidence()ZdlPreparedEvidence{
    let compact:[]u8="script;\nreturn 7;\n";let derived:[]u8="// policy\nreturn 7;\n";let ch:ZagdHash=zagd_content_hash(compact);let dh:ZagdHash=zagd_content_hash(derived);
    let modules:ArrayList[ZdlModuleEvidence]=make[ZdlModuleEvidence](2);push[ZdlModuleEvidence](&modules,ZdlModuleEvidence{.path="<root>",.source=compact});push[ZdlModuleEvidence](&modules,ZdlModuleEvidence{.path="lib.zag",.source="fn value() i32 { return 7; }\n"});
    let imports:ArrayList[ZdlImportEvidence]=make[ZdlImportEvidence](1);push[ZdlImportEvidence](&imports,ZdlImportEvidence{.importer="<root>",.imported="lib.zag"});
    let resources:ArrayList[ZdlResourceEvidence]=make[ZdlResourceEvidence](1);push[ZdlResourceEvidence](&resources,ZdlResourceEvidence{.path="assets/data.bin",.data="abc"});
    let origins:ArrayList[ZdlAstOriginEvidence]=make[ZdlAstOriginEvidence](1);push[ZdlAstOriginEvidence](&origins,ZdlAstOriginEvidence{.module="<root>",.stable_id=101,.node_kind=3,.line=2,.col=1,.byte_start=8,.byte_end=17,.exact=1});
    let segments:ArrayList[ZdlDerivedSegmentEvidence]=make[ZdlDerivedSegmentEvidence](1);push[ZdlDerivedSegmentEvidence](&segments,ZdlDerivedSegmentEvidence{.derived_start=0,.derived_end=derived.len,.module="<root>",.source=ch,.source_start=0,.source_end=compact.len,.origin_id=0,.origin_domain="derivation-root-v1",.exact=0,.generated=1,.basis="explicit-policy"});
    let choices:ArrayList[ZdlChoiceEvidence]=make[ZdlChoiceEvidence](10);push[ZdlChoiceEvidence](&choices,ZdlChoiceEvidence{.name="allocator",.value="script_process_arena",.basis="project-config-v1"});push[ZdlChoiceEvidence](&choices,ZdlChoiceEvidence{.name="device",.value="cpu",.basis="project-config-v1"});push[ZdlChoiceEvidence](&choices,ZdlChoiceEvidence{.name="layout",.value="compiler_owned",.basis="project-config-v1"});push[ZdlChoiceEvidence](&choices,ZdlChoiceEvidence{.name="cpu",.value="generic",.basis="cli-explicit-v1"});push[ZdlChoiceEvidence](&choices,ZdlChoiceEvidence{.name="script_memory_bytes",.value="67108864",.basis="project-config-v1"});push[ZdlChoiceEvidence](&choices,ZdlChoiceEvidence{.name="capability_bits",.value="7",.basis="resolved-policy-v1"});push[ZdlChoiceEvidence](&choices,ZdlChoiceEvidence{.name="execution_policy",.value="16843009",.basis="resolved-policy-v1"});push[ZdlChoiceEvidence](&choices,ZdlChoiceEvidence{.name="automatic_count",.value="3",.basis="planner-resolution-v1"});push[ZdlChoiceEvidence](&choices,ZdlChoiceEvidence{.name="unresolved_count",.value="0",.basis="planner-resolution-v1"});push[ZdlChoiceEvidence](&choices,ZdlChoiceEvidence{.name="provenance",.value="explicit choices preserved",.basis="planner-resolution-v1"});
    let transforms:ArrayList[ZdlTransformEvidence]=make[ZdlTransformEvidence](3);push[ZdlTransformEvidence](&transforms,ZdlTransformEvidence{.name="script-profile-activation-v1",.input=ch,.output=ch,.inverse="embedded-compact-snapshot-v1",.proof="deterministic-profile-activation-v1"});push[ZdlTransformEvidence](&transforms,ZdlTransformEvidence{.name="script-syntax-normalization-v1",.input=ch,.output=ch,.inverse="origin-map-plus-embedded-compact-v1",.proof="lossless-cst-origin-projection-v1"});push[ZdlTransformEvidence](&transforms,ZdlTransformEvidence{.name="explicit-policy-materialization-v1",.input=ch,.output=dh,.inverse="derived-segments-plus-embedded-compact-v1",.proof="strict-compiler-check-plus-user-command-v1"});
    let compilers:ArrayList[ZdlCompilerEvidence]=make[ZdlCompilerEvidence](1);push[ZdlCompilerEvidence](&compilers,ZdlCompilerEvidence{.generation="zag-test-generation",.image="compiler-image"});
    let verifiers:ArrayList[ZdlVerifierEvidence]=make[ZdlVerifierEvidence](1);push[ZdlVerifierEvidence](&verifiers,ZdlVerifierEvidence{.generation="zag-test-generation",.image="compiler-image",.independent=0});
    return ZdlPreparedEvidence{.compact_path="app.zs",.compact=compact,.derived=derived,.semantic_manifest="semantic-manifest-v1\n",.semantic_graph=zagd_content_hash("semantic-graph"),.semantic_graph_complete=1,.compiler_checked=1,.parity_command="true",.parity_exit_zero=1,.modules=modules,.imports=imports,.resources=resources,.ast_origins=origins,.derived_segments=segments,.choices=choices,.transforms=transforms,.compilers=compilers,.verifiers=verifiers};
}

fn main()i32{
    if(_zag_argc()>1&&@strEq(_zag_arg(1),"--emit-v1-fixture")){
        let fixture:ZdlPreparedEvidence=dlt_make_evidence();let legacy_fixture:[]u8=dlt_v1_record(fixture);_zag_print(legacy_fixture);_zag_free(_zag_slice_ptr(legacy_fixture));
        free[ZdlModuleEvidence](&fixture.modules);free[ZdlImportEvidence](&fixture.imports);free[ZdlResourceEvidence](&fixture.resources);free[ZdlAstOriginEvidence](&fixture.ast_origins);free[ZdlDerivedSegmentEvidence](&fixture.derived_segments);free[ZdlChoiceEvidence](&fixture.choices);free[ZdlTransformEvidence](&fixture.transforms);free[ZdlCompilerEvidence](&fixture.compilers);free[ZdlVerifierEvidence](&fixture.verifiers);return 0;
    }
    let fail:i32=0;let evidence:ZdlPreparedEvidence=dlt_make_evidence();
    let record:[]u8=zdl_encode_v2(evidence);if(dlt_record_checks(record,evidence)==1){_zag_println("v2 round trip and source binding");}else{fail=fail+1;}
    let record2:[]u8=zdl_encode_v2(evidence);if(dlt_equal(record,record2)==1){_zag_println("deterministic encoding");}else{fail=fail+1;}
    let saved:u8=record[0];record[0]=(saved as i32+1) as u8;let tampered:ZdlLedgerView=zdl_decode(record);record[0]=saved;if(tampered.valid==0){_zag_println("checksum tamper rejected");}else{fail=fail+1;}
    let trailing:[]u8=_zag_str_concat(record,"unknown_field=x\n");let trailing_view:ZdlLedgerView=zdl_decode(trailing);if(trailing_view.valid==0){_zag_println("trailing field rejected");}else{fail=fail+1;}
    evidence.semantic_graph_complete=0;let rejected:[]u8=zdl_encode_v2(evidence);if(rejected.len==0){_zag_println("incomplete graph fails closed");}else{fail=fail+1;}
    let bad_view:ZdlLedgerView=zdl_decode("format=alien\n");if(bad_view.recognized==0&&bad_view.valid==0){_zag_println("unknown schema rejected");}else{fail=fail+1;}
    let missing:[]u8=dlt_variant(record,"ast_origin_module_0=","",0);if(dlt_decode_valid(missing)==0){_zag_println("checksum-valid missing origin rejected");}else{fail=fail+1;}
    let duplicate:[]u8=dlt_variant(record,"choice_0=","",1);if(dlt_decode_valid(duplicate)==0){_zag_println("checksum-valid duplicate choice rejected");}else{fail=fail+1;}
    let renumbered:[]u8=dlt_variant(record,"derived_start_0=","derived_start_1=",2);if(dlt_decode_valid(renumbered)==0){_zag_println("checksum-valid renumbered segment rejected");}else{fail=fail+1;}
    let bad_span:[]u8=dlt_variant(record,"derived_end_0=","derived_end_0=0",3);if(dlt_decode_valid(bad_span)==0){_zag_println("checksum-valid noncontiguous span rejected");}else{fail=fail+1;}
    let bad_number:[]u8=dlt_variant(record,"ast_origin_line_0=","ast_origin_line_0=oops",3);if(dlt_decode_valid(bad_number)==0){_zag_println("checksum-valid malformed numeric origin rejected");}else{fail=fail+1;}
    let empty_manifest:[]u8=dlt_variant(record,"semantic_manifest_hex=","semantic_manifest_hex=",3);if(dlt_decode_valid(empty_manifest)==0){_zag_println("checksum-valid empty semantic manifest rejected");}else{fail=fail+1;}
    let bad_manifest_hash:[]u8=dlt_variant(record,"semantic_manifest_hash=","semantic_manifest_hash=0,0,1",3);if(dlt_decode_valid(bad_manifest_hash)==0){_zag_println("checksum-valid semantic manifest hash mismatch rejected");}else{fail=fail+1;}
    let legacy:[]u8=dlt_v1_record(evidence);let legacy_view:ZdlLedgerView=zdl_decode(legacy);if(legacy_view.valid==1&&legacy_view.version==1){_zag_println("v1 ledger read compatibility");}else{fail=fail+1;}
    _zag_free(_zag_slice_ptr(record));_zag_free(_zag_slice_ptr(record2));_zag_free(_zag_slice_ptr(rejected));_zag_free(_zag_slice_ptr(trailing));_zag_free(_zag_slice_ptr(missing));_zag_free(_zag_slice_ptr(duplicate));_zag_free(_zag_slice_ptr(renumbered));_zag_free(_zag_slice_ptr(bad_span));_zag_free(_zag_slice_ptr(bad_number));_zag_free(_zag_slice_ptr(empty_manifest));_zag_free(_zag_slice_ptr(bad_manifest_hash));_zag_free(_zag_slice_ptr(legacy));
    free[ZdlModuleEvidence](&evidence.modules);free[ZdlImportEvidence](&evidence.imports);free[ZdlResourceEvidence](&evidence.resources);free[ZdlAstOriginEvidence](&evidence.ast_origins);free[ZdlDerivedSegmentEvidence](&evidence.derived_segments);free[ZdlChoiceEvidence](&evidence.choices);free[ZdlTransformEvidence](&evidence.transforms);free[ZdlCompilerEvidence](&evidence.compilers);free[ZdlVerifierEvidence](&evidence.verifiers);
    if(fail==0){_zag_println("derivation-ledger pass=14 fail=0");return 0;}return 1;
}
