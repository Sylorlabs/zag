    let finalists:ArrayList[ZagdConcreteCandidate]=zagd_prune_dominated(prune_input,268435456,5,0);
    let selection:[]u8="unsupported-roadmap-alternatives";if(finalists.len==1&&finalists.data[0].kind==zagd_candidate_script_default_cpu()){selection="script-default-cpu";}
    let body:ArrayList[u8]=zagd_text(2048);zagd_text_append(&body,"format=zagd-candidates-v2\nadvisory=true\nexecutable_authority=false\nsource_changes=false\nsemantic_detail_level=");if(compact_manifest==1){zagd_text_append(&body,"compact");}else{zagd_text_append(&body,"full");}zagd_text_append(&body,"\nlifetime_analysis_available=");if(compact_manifest==1){zagd_text_append(&body,"false");}else{zagd_text_append(&body,"true");}zagd_text_append(&body,"\nlifetime_advice_supported=");if(proven_buffer_pairs>0){zagd_text_append(&body,"true");}else{zagd_text_append(&body,"false");}zagd_text_append(&body,"\nlifetime_advice_automatic=false\nlifetime_advice_source_changes=false\nlifetime_provenance=");if(compact_manifest==1){zagd_text_append(&body,"unavailable-compact-manifest");}else{zagd_text_append(&body,"proven-foreground-ast");}zagd_text_append(&body,"\nlifetime_pairs=");zagd_text_append_i64(&body,proven_buffer_pairs);zagd_text_append(&body,"\nlifetime_reusable_bytes=");zagd_text_append_i64(&body,proven_buffer_bytes);zagd_text_append(&body,"\nlifetime_analysis_bound=64\nlifetime_validity=");if(compact_manifest==1){zagd_text_append(&body,"unavailable-compact-manifest");}else{zagd_text_append(&body,"linux-x86_64-local-raw-word-zalloc-exactly-one-zfree-no-alias-escape-call-exposure");}zagd_text_append(&body,"\nselection=");zagd_text_append(&body,selection);zagd_text_append(&body,"\ncpu_profile=");zagd_text_append(&body,cpu.canonical);zagd_text_append(&body,"\ntarget_cache_key=");zagd_text_append(&body,cpu.cache_key);zagd_text_append(&body,"\nsource=");zagd_append_hash_fields(&body,view.source);zagd_text_append(&body,"\nsemantic_identity=");zagd_append_hash_fields(&body,semantic_identity);zagd_text_append(&body,"\ntarget=");zagd_append_hash_fields(&body,target);zagd_text_append(&body,"\ngenerated=");zagd_text_append_i64(&body,generated.len);zagd_text_append(&body,"\nfinalists=");zagd_text_append_i64(&body,finalists.len);zagd_text_append_byte(&body,'\n');
    let i:i32=0;while(i<generated.len){let c:ZagdConcreteCandidate=generated.data[i];zagd_text_append(&body,"candidate=");zagd_text_append_i64(&body,c.kind);zagd_text_append(&body,"\tautomatic=");zagd_text_append_i64(&body,c.automatic);zagd_text_append(&body,"\tsupported=");zagd_text_append_i64(&body,c.supported);zagd_text_append(&body,"\tequivalent=");zagd_text_append_i64(&body,c.equivalent);zagd_text_append(&body,"\tprovenance=");zagd_text_append(&body,zagd_provenance_name(c.provenance));zagd_text_append(&body,"\tevidence_basis=");zagd_text_append(&body,c.evidence_basis);zagd_text_append(&body,"\tvalidity=");zagd_text_append(&body,c.validity);zagd_text_append(&body,"\trejected_reason=");zagd_text_append(&body,c.rejected_reason);zagd_text_append(&body,"\truntime_ns=");zagd_text_append_i64(&body,c.runtime_ns);zagd_text_append(&body,"\tmemory_bytes=");zagd_text_append_i64(&body,c.memory_bytes);zagd_text_append_byte(&body,'\n');i=i+1;}
    let sum:ZagdHash=zagd_content_hash(body.data[0..body.len]);zagd_text_append(&body,"checksum_first=");zagd_text_append_i64(&body,sum.first);zagd_text_append_byte(&body,'\n');let temp:[]u8=zagd_join_path(dir,"candidates.record.tmp");let written:i32=zagd_store_transaction(temp,final,body.data[0..body.len]);free[u8](&body);free[ZagdConcreteCandidate](&generated);free[ZagdConcreteCandidate](&finalists);zagd_text_free(temp);zagd_text_free(final);zagd_text_free(dir);zagd_text_free(base);return written;
}
fn zagd_deep_control_path(root:[]u8,name:[]u8)[]u8{
    let control:[]u8=zagd_join_path(root,name);if(_zag_file_exists(control)==0){zagd_text_free(control);return "";}
    let raw:[]u8=_zag_read_file(control);zagd_text_free(control);if(raw.len<0){return "";}
    let value:[]u8=zagd_trim_line(raw);if(value.len==0){_zag_free(_zag_slice_ptr(raw));return "";}
    if(value[0]=='/'){return value;}
    let resolved:[]u8=zagd_join_path(root,value);_zag_free(_zag_slice_ptr(raw));return resolved;
}
fn zagd_deep_value_safe(value:[]u8)i32{if(value.len==0){return 0;}let i:i32=0;while(i<value.len){if(value[i]=='\n'||value[i]=='\r'||value[i]=='\t'){return 0;}i=i+1;}return 1;}
fn zagd_deep_semantics_current(root:[]u8,expected:ZagdHash,cpu:X86CpuProfile)i32{
    let base:[]u8=zagd_join_path(root,".zag-cache");let dir:[]u8=zagd_join_path(base,"zagd");let path:[]u8=zagd_join_path(dir,"semantic.record");zagd_text_free(dir);zagd_text_free(base);
    if(zagd_path_is_regular(path)==0){zagd_text_free(path);return 0;}
    let text:[]u8=_zag_read_file(path);zagd_text_free(path);if(text.len<=0){if(text.len>=0){_zag_free(_zag_slice_ptr(text));}return 0;}
    let current:ZagdHash=zagd_plan_semantic_identity(text,cpu);
    let valid:i32=(zagd_hash_equal(current,expected)==1&&zagd_manifest_modules_current(root,text)==1) as i32;
    _zag_free(_zag_slice_ptr(text));return valid;
}
fn zagd_persist_deep_measurement(root:[]u8,view:SemanticManifestView,semantic_identity:ZagdHash,cpu:X86CpuProfile,target:ZagdHash,reference:[]u8,finalist:[]u8,total_ms:i64,runs:i32)i32{
    if(zagd_deep_value_safe(reference)==0||zagd_deep_value_safe(finalist)==0||runs<1){return 0;}
    let body:ArrayList[u8]=zagd_text(1024);zagd_text_append(&body,"format=zagd-deep-measurement-v2\nadvisory=true\nexecutable_authority=false\nmode=deep\nexplicit=true\nforeground_consumption=false\nprovenance=measured\nequivalence=exact-output-stderr-exit-signal-state\ncpu_profile=");zagd_text_append(&body,cpu.canonical);zagd_text_append(&body,"\ntarget_cache_key=");zagd_text_append(&body,cpu.cache_key);zagd_text_append(&body,"\nsource=");zagd_append_hash_fields(&body,view.source);zagd_text_append(&body,"\nsemantic_identity=");zagd_append_hash_fields(&body,semantic_identity);zagd_text_append(&body,"\ntarget=");zagd_append_hash_fields(&body,target);zagd_text_append(&body,"\nreference=");zagd_text_append(&body,reference);zagd_text_append(&body,"\nfinalist=");zagd_text_append(&body,finalist);zagd_text_append(&body,"\nruns=");zagd_text_append_i64(&body,runs);zagd_text_append(&body,"\nruntime_ms_mean=");zagd_text_append_i64(&body,total_ms/(runs as i64));zagd_text_append_byte(&body,'\n');
    let sum:ZagdHash=zagd_content_hash(body.data[0..body.len]);zagd_text_append(&body,"checksum_first=");zagd_text_append_i64(&body,sum.first);zagd_text_append_byte(&body,'\n');
    let base:[]u8=zagd_join_path(root,".zag-cache");let dir:[]u8=zagd_join_path(base,"zagd");let temp:[]u8=zagd_join_path(dir,"deep-measurement.record.tmp");let final:[]u8=zagd_join_path(dir,"deep-measurement.record");let written:i32=zagd_store_transaction(temp,final,body.data[0..body.len]);zagd_text_free(final);zagd_text_free(temp);zagd_text_free(dir);zagd_text_free(base);free[u8](&body);return written;
}
fn zagd_execute_deep_controls(root:[]u8,mode:i32,semantic_text:[]u8,cpu:X86CpuProfile,stop_path:[]u8)i32{
    let base:[]u8=zagd_join_path(root,".zag-cache");let dir:[]u8=zagd_join_path(base,"zagd");let measurement_path:[]u8=zagd_join_path(dir,"deep-measurement.record");zagd_unlink(measurement_path);zagd_text_free(measurement_path);zagd_text_free(dir);zagd_text_free(base);
    let view:SemanticManifestView=semantic_manifest_decode(semantic_text);let semantic_identity:ZagdHash=zagd_plan_semantic_identity(semantic_text,cpu);
    if(mode!=zagd_mode_deep()||view.valid==0||semantic_identity.bytes<=0||
        zagd_deep_semantics_current(root,semantic_identity,cpu)==0){return 0;}
    let reference:[]u8=zagd_deep_control_path(root,".zagd.deep-reference");let finalist:[]u8=zagd_deep_control_path(root,".zagd.deep-finalist");
    if(reference.len==0||finalist.len==0||_zag_file_exists(reference)==0||_zag_file_exists(finalist)==0){if(reference.len>0){zagd_text_free(reference);}if(finalist.len>0){zagd_text_free(finalist);}return 0;}
    let target:ZagdHash=zagd_content_hash(cpu.cache_key);let req:ZagdBenchmarkRequest=ZagdBenchmarkRequest{.explicit=1,.mode=mode,.finalists=1,.timeout_ms=1000,.max_memory=67108864,.source=semantic_identity,.stable_source=semantic_identity,.target=target,.active_target=target,.cancelled=0,.network=0,.gpu=0,.source_writes=0};let decision:ZagdBenchmarkDecision=zagd_benchmark_decide(req);
    if(decision.allowed==0){zagd_text_free(reference);zagd_text_free(finalist);return 0;}
    let cancelled:i32=0;let total:i64=0;let run:i32=0;let valid:i32=1;
    while(run<3&&valid==1){
        if(_zag_file_exists(stop_path)==1||zagd_deep_semantics_current(root,semantic_identity,cpu)==0){cancelled=1;valid=0;}
        else{
            let baseline:ZagdExecutionResult=zagd_execute_finalist(reference,1000,67108864,1048576,&cancelled);
            if(zagd_deep_semantics_current(root,semantic_identity,cpu)==0){valid=0;zagd_execution_result_free(&baseline);}
            else{
                let candidate:ZagdExecutionResult=zagd_execute_finalist(finalist,1000,67108864,1048576,&cancelled);
                if(zagd_measurement_may_persist(decision,baseline,candidate)==0){valid=0;}
                else{total=total+candidate.elapsed_ms;run=run+1;}
                zagd_execution_result_free(&baseline);zagd_execution_result_free(&candidate);
            }
        }
    }
    let written:i32=0;if(valid==1&&run==3&&_zag_file_exists(stop_path)==0&&zagd_deep_semantics_current(root,semantic_identity,cpu)==1){written=zagd_persist_deep_measurement(root,view,semantic_identity,cpu,target,zagd_relative(root,reference),zagd_relative(root,finalist),total,3);}
    zagd_text_free(reference);zagd_text_free(finalist);return written;
}
fn zagd_cache_trim_name(outcome:i32)[]u8{if(outcome==0){return "semantic-invalidated";}if(outcome==2){return "trimmed";}return "within-limit";}
fn zagd_file_size(path:[]u8)i64{return zagd_path_size(path);}
fn zagd_cache_trim(root:[]u8,max_bytes:i64)ZagdCacheTrim{
    let base:[]u8=zagd_join_path(root,".zag-cache");let dir:[]u8=zagd_join_path(base,"zagd");
    let snapshot:[]u8=zagd_join_path(dir,"snapshot.record");let plan:[]u8=zagd_join_path(dir,"plan.record");let semantic:[]u8=zagd_join_path(dir,"semantic.record");let artifact:[]u8=zagd_join_path(dir,"artifact.record");let candidates:[]u8=zagd_join_path(dir,"candidates.record");let incremental:[]u8=zagd_join_path(dir,"incremental.record");let measurement:[]u8=zagd_join_path(dir,"deep-measurement.record");let profile_plan:[]u8=zagd_join_path(dir,"profile-plan.record");
    let foreground:[]u8=zagd_join_path(base,"foreground");let machine_record:[]u8=zagd_join_path(foreground,"machine.record");let machine_code:[]u8=zagd_join_path(foreground,"machine.code");let machine_data:[]u8=zagd_join_path(foreground,"machine.data");let foreground_bytes:i64=zagd_file_size(machine_record)+zagd_file_size(machine_code)+zagd_file_size(machine_data);
    let total:i64=zagd_file_size(snapshot)+zagd_file_size(plan)+zagd_file_size(semantic)+zagd_file_size(artifact)+zagd_file_size(candidates)+zagd_file_size(incremental)+zagd_file_size(measurement)+zagd_file_size(profile_plan)+foreground_bytes;let trimmed:i32=0;let before:i64=total;
    if(total>max_bytes&&zagd_file_size(measurement)>0){total=total-zagd_file_size(measurement);zagd_unlink(measurement);trimmed=1;}if(total>max_bytes&&zagd_file_size(profile_plan)>0){total=total-zagd_file_size(profile_plan);zagd_unlink(profile_plan);trimmed=1;}if(total>max_bytes&&zagd_file_size(candidates)>0){total=total-zagd_file_size(candidates);zagd_unlink(candidates);trimmed=1;}if(total>max_bytes&&zagd_file_size(artifact)>0){total=total-zagd_file_size(artifact);zagd_unlink(artifact);trimmed=1;}if(total>max_bytes&&zagd_file_size(plan)>0){total=total-zagd_file_size(plan);zagd_unlink(plan);trimmed=1;}if(total>max_bytes&&foreground_bytes>0){total=total-foreground_bytes;zagd_unlink(machine_record);zagd_unlink(machine_code);zagd_unlink(machine_data);trimmed=1;}if(total>max_bytes&&zagd_file_size(incremental)>0){total=total-zagd_file_size(incremental);zagd_unlink(incremental);trimmed=1;}
    if(total>max_bytes&&zagd_file_size(snapshot)>0){total=total-zagd_file_size(snapshot);zagd_unlink(snapshot);trimmed=1;}
    let outcome:i32=1;if(total>max_bytes&&zagd_file_size(semantic)>0){zagd_unlink(semantic);outcome=0;}else if(trimmed==1){outcome=2;}
    let after:i64=zagd_cache_bytes(root);zagd_text_free(machine_data);zagd_text_free(machine_code);zagd_text_free(machine_record);zagd_text_free(foreground);zagd_text_free(profile_plan);zagd_text_free(measurement);zagd_text_free(incremental);zagd_text_free(candidates);zagd_text_free(artifact);zagd_text_free(semantic);zagd_text_free(plan);zagd_text_free(snapshot);zagd_text_free(dir);zagd_text_free(base);return ZagdCacheTrim{.outcome=outcome,.bytes_before=before,.bytes_after=after};
}
// Status uses the same bounded record set as eviction. This is measured at
// publication time, never guessed from a configured cap.
fn zagd_file_size_join(root:[]u8,name:[]u8)i64{let path:[]u8=zagd_join_path(root,name);let size:i64=zagd_file_size(path);zagd_text_free(path);return size;}
fn zagd_cache_bytes(root:[]u8)i64{let base:[]u8=zagd_join_path(root,".zag-cache");let dir:[]u8=zagd_join_path(base,"zagd");let names:ArrayList[[]u8]=make[[]u8](8);push[[]u8](&names,"snapshot.record");push[[]u8](&names,"plan.record");push[[]u8](&names,"semantic.record");push[[]u8](&names,"artifact.record");push[[]u8](&names,"candidates.record");push[[]u8](&names,"incremental.record");push[[]u8](&names,"deep-measurement.record");push[[]u8](&names,"profile-plan.record");let total:i64=0;let i:i32=0;while(i<names.len){total=total+zagd_file_size_join(dir,names.data[i]);i=i+1;}free[[]u8](&names);let foreground:[]u8=zagd_join_path(base,"foreground");total=total+zagd_file_size_join(foreground,"machine.record");total=total+zagd_file_size_join(foreground,"machine.code");total=total+zagd_file_size_join(foreground,"machine.data");zagd_text_free(foreground);zagd_text_free(dir);zagd_text_free(base);return total;}
fn zagd_revalidate_index(records:ArrayList[ZagdFileState])i32{let i:i32=0;while(i<records.len){if(_zag_file_exists(records.data[i].path)==0){return 0;}let bytes:[]u8=_zag_read_file(records.data[i].path);let valid:i32=0;if(bytes.len>=0){valid=zagd_hash_equal(zagd_content_hash(bytes),records.data[i].hash);_zag_free(_zag_slice_ptr(bytes));}if(valid==0){return 0;}i=i+1;}return 1;}
fn zagd_seed_semantic_records(root:[]u8,text:[]u8,
    records:*ArrayList[ZagdFileState])void{
    if(semantic_manifest_decode(text).valid==0){return;}
    let start:i32=0;let i:i32=0;
    while(i<=text.len){if(i==text.len||text[i]=='\n'){
        let line:[]u8=text[start..i];let node:[]u8="";
        if(line.len>12&&@strEq(line[0..12],"module_node=")){
            node=line[12..line.len];
        }else{
            let prefix:[]u8="dependency_input_node=";
            if(line.len>prefix.len&&@strEq(line[0..prefix.len],prefix)){
                node=line[prefix.len..line.len];
            }
        }
        if(node.len>0){let tab:i32=0;while(tab<node.len&&node[tab]!='\t'){
            tab=tab+1;
        }if(tab<node.len){let name:[]u8=node[0..tab];let path:[]u8="";
            if(zagd_dependency_input_path_safe(name)==1){
                path=zagd_dependency_input_path(root,name);
            }
            // Snapshot records are project-relative by contract. External
            // absolute/leading-parent graph inputs are still revalidated
            // by zagd_manifest_modules_current, but are not inserted into the
            // persisted project index or presented as watched source modules.
            let in_project:i32=0;
            if(name.len>0&&name[0]=='/'){
                in_project=zagd_path_in_project(root,path);
            }else if(!@strEq(name,"..")&&
                !(name.len>3&&@strEq(name[0..3],"../"))){
                in_project=1;
            }
            if(path.len>0&&in_project==1&&
                _zag_file_exists(path)==1){
                let bytes:[]u8=_zag_read_file(path);if(bytes.len>=0){
                    let hash:ZagdHash=zagd_content_hash(bytes);
                    if(zagd_hash_equal(hash,smf_hash(node[tab+1..node.len]))==1){
                        let facts:ZagdSourceFacts=zagd_source_facts(bytes);
                        let _seed:i32=zagd_record_changed(records,path,hash,facts,1);
                    }_zag_free(_zag_slice_ptr(bytes));
                }
            }
            if(path.len>0){zagd_text_free(path);}
        }}start=i+1;
    }i=i+1;}
}

fn zagd_parse_pid(value: []u8) i64 {
    let result: i64 = 0;
    let i: i32 = 0;
    while (i < value.len && value[i] >= '0' && value[i] <= '9') {
        result = result * 10 + ((value[i] as i64) - 48);
        i = i + 1;
    }
    return result;
}

fn zagd_lock_record_after_start_window(lock_path:[]u8)[]u8{
    let record:[]u8=_zag_read_file(lock_path);if(zagd_parse_pid(record)>=2&&zli_lock_start(record).len>0){return record;}
    // An O_EXCL winner may not yet have written its record, or the write may
    // be briefly observed mid-flight. Bound the wait so a crash cannot wedge
    // the project, but do not tear down a normal concurrent starter instantly.
    let waits:i32=0;while(waits<50){zagd_sleep_ms(1);let reread:[]u8=_zag_read_file(lock_path);if(zagd_parse_pid(reread)>=2&&zli_lock_start(reread).len>0){if(record.len>=0){_zag_free(_zag_slice_ptr(record));}return reread;}if(record.len>=0){_zag_free(_zag_slice_ptr(record));}record=reread;waits=waits+1;}return record;
}

fn zagd_claim_singleton(lock_path: []u8, root: []u8) i64 {
    let fd: i64 = zagd_open_lock(lock_path);
    if (fd >= 0) { return fd; }
    let prior_record: []u8 = zagd_lock_record_after_start_window(lock_path);
    let prior: i64 = zagd_parse_pid(prior_record);
    if (prior < 2) { if(prior_record.len>=0){_zag_free(_zag_slice_ptr(prior_record));}zagd_unlink(lock_path);return zagd_open_lock(lock_path); }
    if (zagd_lock_identity_alive(prior_record, root) == 1) { _zag_free(_zag_slice_ptr(prior_record));return 0 - 1; }
    _zag_free(_zag_slice_ptr(prior_record));
    zagd_unlink(lock_path);
    return zagd_open_lock(lock_path);
}

fn zagd_watch_path(fd: i64, path: []u8, watches: *ArrayList[ZagdWatch]) i32 {
    let i: i32 = 0;
    while (i < watches.*.len) {
        if (@strEq(watches.*.data[i].path, path)) { return 1; }
        i = i + 1;
    }
    if (watches.*.len >= 4096) { return 0; }
    let wd: i64 = zagd_inotify_watch(fd, path);
    if (wd < 0) { return 0; }
    // The caller commonly passes a one-event joined path.  Watch ownership is
    // explicit so that the event buffer can always be released after dispatch.
    push[ZagdWatch](watches, ZagdWatch{ .wd = wd, .path = zagd_text_clone(path) });
    return 1;
}
fn zagd_free_watches(watches:*ArrayList[ZagdWatch])void{
    let i:i32=0;while(i<watches.*.len){zagd_text_free(watches.*.data[i].path);i=i+1;}
    free[ZagdWatch](watches);
}

fn zagd_scan_directories(fd: i64, root: []u8, watches: *ArrayList[ZagdWatch]) void {
    // Never follow a project-internal directory symlink into another tree.
    if(zagd_path_is_directory(root)==0){return;}
    if (zagd_watch_path(fd, root, watches) == 0) { return; }
    let dirfd: i64 = zagd_open_directory(root);
    if (dirfd < 0) { return; }
    let entries: ArrayList[u8] = make[u8](4096);
    let scanning: i32 = 1;
    while (scanning == 1) {
        let nread: i64 = zagd_getdents(dirfd, &entries);
        if (nread <= 0) { scanning = 0; }
        else {
            let off: i32 = 0;
            while (off + 19 <= nread) {
                let reclen: i32 = zagd_u16_at(entries.data[0..nread as i32], off + 16);
                if (reclen < 19 || off + reclen > nread) { off = nread as i32; }
                else {
                    let dtype: i32 = entries.data[off + 18] as i32;
                    let name: []u8 = zagd_event_name(entries.data[0..nread as i32], off + 19, reclen - 19);
                    if (@strEq(name, ".") == 0 && @strEq(name, "..") == 0 && zagd_ignored_name(name) == 0) {
                        let child:[]u8=zagd_join_path(root,name);
                        if(dtype==4||(dtype==0&&zagd_path_is_directory(child)==1)){
                            zagd_scan_directories(fd,child,watches);
                        }
                        zagd_text_free(child);
                    }
                    off = off + reclen;
                }
            }
        }
    }
    free[u8](&entries);
    zagd_close(dirfd);
}

fn zagd_watch_base(watches: *ArrayList[ZagdWatch], wd: i64) []u8 {
    let i: i32 = 0;
    while (i < watches.*.len) {
        if (watches.*.data[i].wd == wd) { return watches.*.data[i].path; }
        i = i + 1;
    }
    return "";
}

fn zagd_path_parent(path:[]u8)[]u8{let end:i32=path.len;while(end>1&&path[end-1]=='/'){end=end-1;}let slash:i32=0-1;let i:i32=0;while(i<end){if(path[i]=='/'){slash=i;}i=i+1;}if(slash<0){return ".";}if(slash==0){return "/";}return path[0..slash];}
fn zagd_path_name(path:[]u8)[]u8{let end:i32=path.len;while(end>1&&path[end-1]=='/'){end=end-1;}let slash:i32=0-1;let i:i32=0;while(i<end){if(path[i]=='/'){slash=i;}i=i+1;}return path[slash+1..end];}
fn zagd_unlink_project(root:[]u8,name:[]u8)void{let path:[]u8=zagd_join_path(root,name);zagd_unlink(path);zagd_text_free(path);}
fn zagd_publish_event(mask:i64)i32{return (zagd_mask_has(mask,zagd_in_close_write())==1||zagd_mask_has(mask,zagd_in_moved_to())==1||zagd_mask_has(mask,zagd_in_create())==1) as i32;}

fn zagd_record_changed(records: *ArrayList[ZagdFileState], path: []u8,
        hash: ZagdHash, facts:ZagdSourceFacts, exists: i32) i32 {
    let i: i32 = 0;
    while (i < records.*.len) {
        if (@strEq(records.*.data[i].path, path)) {
            if (records.*.data[i].exists == exists && zagd_hash_equal(records.*.data[i].hash, hash) == 1) { return 0-1; }
            let classification:i32=zagd_change_unknown();
            if(records.*.data[i].exists==1&&exists==1){classification=zagd_classify_sources(records.*.data[i].facts,facts,0);}
            records.*.data[i].hash = hash;
            records.*.data[i].facts = facts;
            records.*.data[i].exists = exists;
            return classification;
        }
        i = i + 1;
    }
    // A delete hint or ignored symlink for an untracked path changes no source
    // identity and must not create a phantom absent record.
    if(exists==0){return 0-1;}
    // Event names and directory joins are temporary buffers.  Keep an owned
    // copy only for a newly tracked file so a rapid event stream does not
    // retain one path allocation per notification.
    push[ZagdFileState](records, ZagdFileState{ .path = zagd_text_clone(path), .hash = hash, .facts=facts, .exists = exists });
    return zagd_change_unknown();
}
fn zagd_free_records(records:*ArrayList[ZagdFileState])void{
    let i:i32=0;while(i<records.*.len){zagd_text_free(records.*.data[i].path);i=i+1;}
    free[ZagdFileState](records);
}

struct ZagdSourceObservation {
    stable:i32,
    exists:i32,
    hash:ZagdHash,
    facts:ZagdSourceFacts,
}

struct ZagdStableRescan {
    stable:i32,
    records:ArrayList[ZagdFileState],
}

fn zagd_observe_source(path:[]u8)ZagdSourceObservation {
    let empty:ZagdHash=zagd_content_hash("");
    let absent:ZagdSourceObservation=ZagdSourceObservation{
        .stable=0,.exists=0,.hash=empty,.facts=zagd_source_facts("") };
    // lstat fail-closed: regular files are read; symlinks, directories and
    // vanished paths all have absent source identity.
    if(zagd_path_is_regular(path)==0){return absent;}
    let bytes:[]u8=_zag_read_file(path);
    if(bytes.len<0){return absent;}
    let observed:ZagdSourceObservation=ZagdSourceObservation{.stable=0,.exists=1,
        .hash=zagd_content_hash(bytes),.facts=zagd_source_facts(bytes)};
    _zag_free(_zag_slice_ptr(bytes));
    return observed;
}

fn zagd_observation_equal(a:ZagdSourceObservation,b:ZagdSourceObservation)i32 {
    if(a.exists!=b.exists){return 0;}
    if(a.exists==0){return 1;}
    return zagd_hash_equal(a.hash,b.hash);
}

fn zagd_observation_matches_record(records:ArrayList[ZagdFileState],path:[]u8,
        observed:ZagdSourceObservation)i32 {
    let i:i32=0;
    while(i<records.len){
        let record:ZagdFileState=records.data[i];
        if(@strEq(record.path,path)){
            if(record.exists!=observed.exists){return 0;}
            if(observed.exists==0){return 1;}
            return zagd_hash_equal(record.hash,observed.hash);
        }
        i=i+1;
    }
    return (observed.exists==0) as i32;
}

fn zagd_observe_source_stable(path:[]u8,window_ms:i64,
        records:ArrayList[ZagdFileState])ZagdSourceObservation {
    // A symlink event is not a deletion of a tracked source.  Treat it as a
    // stable ignored hint so an editor-created link cannot force the daemon
    // into `stabilizing`, invalidate semantic facts, or pull its target into a
    // snapshot. Actual deletions remain absent observations below.
    if(zagd_path_is_symlink(path)==1){
        let ignored:ZagdSourceObservation=ZagdSourceObservation{.stable=1,.exists=0,
            .hash=zagd_content_hash(""),.facts=zagd_source_facts("")};
        return ignored;
    }
    let prior:ZagdSourceObservation=zagd_observe_source(path);
    // A queued hint for bytes already in the published snapshot is safe to
    // discard immediately. This drains rapid-save event bursts without paying
    // one stability window per duplicate, while a genuinely new observation
    // still requires two equal complete reads below.
    if(zagd_observation_matches_record(records,path,prior)==1){
        prior.stable=1;
        return prior;
    }
    let tries:i32=0;
    while(tries<4){
        zagd_sleep_ms(window_ms);
        let next:ZagdSourceObservation=zagd_observe_source(path);
        if(zagd_observation_equal(prior,next)==1){next.stable=1;return next;}
        prior=next;
        tries=tries+1;
    }
    // The caller must invalidate analysis but retain its previous snapshot.
    prior.stable=0;
    return prior;
}

fn zagd_scan_source_tree(root:[]u8,out:*ArrayList[ZagdFileState],complete:*i32)void {
    if(complete.*==0||out.*.len>=4096){complete.*=0;return;}
    if(zagd_path_is_directory(root)==0){complete.*=0;return;}
    let dirfd:i64=zagd_open_directory(root);
    if(dirfd<0){complete.*=0;return;}
    let entries:ArrayList[u8]=make[u8](4096);
    let scanning:i32=1;
    while(scanning==1&&complete.*==1){
        let nread:i64=zagd_getdents(dirfd,&entries);
        if(nread==0){scanning=0;}
        else if(nread<0){complete.*=0;scanning=0;}
        else {
            let off:i32=0;
            while(off+19<=nread&&complete.*==1){
                let reclen:i32=zagd_u16_at(entries.data[0..nread as i32],off+16);
                if(reclen<19||off+reclen>nread){complete.*=0;off=nread as i32;}
                else {
                    let dtype:i32=entries.data[off+18] as i32;
                    let name:[]u8=zagd_event_name(entries.data[0..nread as i32],off+19,reclen-19);
                    if(@strEq(name,".")==0&&@strEq(name,"..")==0&&zagd_ignored_name(name)==0){
                        let full:[]u8=zagd_join_path(root,name);
                        if(dtype==4||(dtype==0&&zagd_path_is_directory(full)==1)){
                            zagd_scan_source_tree(full,out,complete);
                        } else if(zagd_source_name(name)==1&&zagd_path_is_regular(full)==1){
                            let bytes:[]u8=_zag_read_file(full);
                            if(bytes.len<0){complete.*=0;}
                            else if(out.*.len>=4096){_zag_free(_zag_slice_ptr(bytes));complete.*=0;}
                            else {
                                let hash:ZagdHash=zagd_content_hash(bytes);
                                push[ZagdFileState](out,ZagdFileState{.path=zagd_text_clone(full),.hash=hash,
                                    .facts=zagd_source_facts(bytes),.exists=1});
                                _zag_free(_zag_slice_ptr(bytes));
                            }
                        }
                        zagd_text_free(full);
                    }
                    off=off+reclen;
                }
            }
        }
    }
    free[u8](&entries);
    zagd_close(dirfd);
}

fn zagd_scan_sources_once(root:[]u8)ZagdStableRescan {
    let records:ArrayList[ZagdFileState]=make[ZagdFileState](32);
    let complete:i32=1;
    zagd_scan_source_tree(root,&records,&complete);
    return ZagdStableRescan{.stable=complete,.records=records};
}

fn zagd_record_sets_equal(a:ArrayList[ZagdFileState],b:ArrayList[ZagdFileState])i32 {
    if(a.len!=b.len){return 0;}
    let i:i32=0;
    while(i<a.len){
        let found:i32=0;
        let j:i32=0;
        while(j<b.len){
            if(@strEq(a.data[i].path,b.data[j].path)&&
                zagd_hash_equal(a.data[i].hash,b.data[j].hash)==1){found=1;}
            j=j+1;
        }
        if(found==0){return 0;}
        i=i+1;
    }
    return 1;
}

fn zagd_rescan_sources_stable(root:[]u8,window_ms:i64)ZagdStableRescan {
    let prior:ZagdStableRescan=zagd_scan_sources_once(root);
    let tries:i32=0;
    while(tries<4&&prior.stable==1){
        zagd_sleep_ms(window_ms);
        let next:ZagdStableRescan=zagd_scan_sources_once(root);
        if(next.stable==1&&zagd_record_sets_equal(prior.records,next.records)==1){
            next.stable=1;
            zagd_free_records(&prior.records);
            return next;
        }
        zagd_free_records(&prior.records);
        prior=next;
        tries=tries+1;
    }
    prior.stable=0;
    return prior;
}

fn zagd_incremental_from_records(records:ArrayList[ZagdFileState])ZagdIncrementalIndex {
    let index:ZagdIncrementalIndex=zi_index_bad();
    index.valid=1;index.advisory=1;index.executable_authority=0;
    let i:i32=0;
    while(i<records.len){
        let record:ZagdFileState=records.data[i];
        if(record.exists==1&&record.facts.valid==1){
            let bytes:[]u8=_zag_read_file(record.path);
            if(bytes.len>=0&&zagd_hash_equal(zagd_content_hash(bytes),record.hash)==1){
                let file:ZagdIncrementalFile=zagd_incremental_file(record.path,bytes,record.facts);
                if(file.valid==1){zagd_incremental_copy_names(&file);zagd_incremental_put_owned(&index,file);}
                else{free[ZagdDeclFingerprint](&file.declarations);}
            }
            if(bytes.len>=0){_zag_free(_zag_slice_ptr(bytes));}
        }
        i=i+1;
    }
    return index;
}

fn zagd_change_name(change:i32)[]u8{if(change==zagd_change_none()){return "none";}if(change==zagd_change_nonsemantic()){return "nonsemantic";}if(change==zagd_change_private_body()){return "private-body";}if(change==zagd_change_public_shape()){return "public-shape";}if(change==zagd_change_root_profile()){return "root-profile";}if(change==zagd_change_target_profile()){return "target-profile";}return "unknown";}

fn zagd_mode_name(mode: i32) []u8 {
    if (mode == zagd_mode_off()) { return "off"; }
    if (mode == zagd_mode_adaptive()) { return "adaptive"; }
    if (mode == zagd_mode_deep()) { return "deep"; }
    return "light";
}

fn zagd_parse_mode(value: []u8) i32 {
    if (@strEq(value, "off")) { return zagd_mode_off(); }
    if (@strEq(value, "adaptive")) { return zagd_mode_adaptive(); }
    if (@strEq(value, "deep")) { return zagd_mode_deep(); }
    if (@strEq(value, "light")) { return zagd_mode_light(); }
    return 0 - 1;
}

fn zagd_parse_window(value: []u8) i64 {
    if (value.len == 0) { return 0 - 1; }
    let result: i64 = 0;
    let i: i32 = 0;
    while (i < value.len) {
        let c: u8 = value[i];
        if (c < '0' || c > '9') { return 0 - 1; }
        result = result * 10 + ((c as i64) - 48);
        if (result > 60000) { return 0 - 1; }
        i = i + 1;
    }
    if (result < 1) { return 0 - 1; }
    return result;
}

fn zagd_semantic_validation_name(validation:i32,semantic:SemanticManifestView)[]u8{if(validation==1){return "validated";}if(validation==2){return "failed";}if(semantic.valid==1){return "restored";}return "unavailable";}
fn zagd_status_line(out:*ArrayList[u8],key:[]u8,value:[]u8)void{zagd_text_append(out,key);zagd_text_append_byte(out,'=');zagd_text_append(out,value);zagd_text_append_byte(out,'\n');}
fn zagd_status_i64(out:*ArrayList[u8],key:[]u8,value:i64)void{zagd_text_append(out,key);zagd_text_append_byte(out,'=');zagd_text_append_i64(out,value);zagd_text_append_byte(out,'\n');}
fn zagd_status_append(out:*ArrayList[u8],pid:i64,mode:i32,state:[]u8,file:[]u8,
        hash:ZagdHash,events:i64,snapshot:ZagdSnapshot,change:i32,cache_reused:i32,
        incremental_reused:i32,incremental_change:i32,semantic:SemanticManifestView,
        semantic_validation:i32,dependents:i32,affected_decls:i32,plan:ZagdPlannerRun,
        cancellations:i64,trim:ZagdCacheTrim,policy:PlannerConfig)void{
    zagd_text_append(out,"version=1\n");zagd_status_i64(out,"pid",pid);
    zagd_status_line(out,"mode",zagd_mode_name(mode));zagd_status_line(out,"state",state);
    if(policy.idle_deep==1){zagd_status_line(out,"idle_deep","true");}else{zagd_status_line(out,"idle_deep","false");}
    zagd_status_line(out,"difficulty",policy.difficulty);
    zagd_status_line(out,"script_optimization",policy.script_optimization);
    zagd_status_line(out,"regular_optimization",policy.regular_optimization);
    zagd_status_line(out,"objective",policy.objective);
    zagd_status_line(out,"trust_mode",policy.trust_mode);
    zagd_status_line(out,"cpu",policy.default_cpu);
    zagd_status_i64(out,"stability_window_ms",policy.stability_window_ms);
    zagd_status_i64(out,"max_memory_bytes",policy.max_memory_bytes);
    zagd_status_i64(out,"max_cache_bytes",policy.max_cache_bytes);
    zagd_status_i64(out,"max_workers",policy.max_workers as i64);
    zagd_status_line(out,"notifications",policy.notifications);
    zagd_status_line(out,"trust_mode_scope","policy-only");
    zagd_status_line(out,"optimizer_generation","unimplemented");
    zagd_text_append(out,"singleton=true\nnetwork=false\ngpu_background=false\n");
    if(cache_reused==1){zagd_text_append(out,"cache_reused=true\n");}else{zagd_text_append(out,"cache_reused=false\n");}
    if(incremental_reused==1){zagd_text_append(out,"incremental_cache_reused=true\n");}else{zagd_text_append(out,"incremental_cache_reused=false\n");}
    zagd_status_line(out,"incremental_invalidation",zagd_change_name(incremental_change));
    if(semantic.valid==1){
        zagd_text_append(out,"semantic_manifest=true\n");
        zagd_status_i64(out,"semantic_public_first",semantic.public_identity.first);
        zagd_status_i64(out,"semantic_effects_first",semantic.effect_identity.first);
        zagd_status_i64(out,"semantic_layouts_first",semantic.layout_identity.first);
        zagd_status_i64(out,"semantic_graph_first",semantic.graph_identity.first);
        zagd_status_i64(out,"semantic_graph_complete",semantic.graph_complete);
    }else{zagd_text_append(out,"semantic_manifest=false\n");}
    zagd_status_line(out,"semantic_validation",zagd_semantic_validation_name(semantic_validation,semantic));
    zagd_status_i64(out,"events",events);zagd_status_line(out,"last_change",zagd_change_name(change));
    zagd_status_i64(out,"affected_dependents",dependents);zagd_status_i64(out,"affected_declarations",affected_decls);
    zagd_status_i64(out,"planner_budget",plan.budget);zagd_status_i64(out,"planner_evaluated",plan.evaluated);
    zagd_status_i64(out,"planner_suggestions",plan.suggestions);zagd_status_i64(out,"planner_cancellations",cancellations);
    if(plan.cancelled==1){zagd_text_append(out,"planner_state=cancelled\n");}else if(plan.complete==1){zagd_text_append(out,"planner_state=complete\n");}else{zagd_text_append(out,"planner_state=running\n");}
    zagd_status_line(out,"cache_eviction",zagd_cache_trim_name(trim.outcome));
    zagd_status_i64(out,"cache_bytes_before_trim",trim.bytes_before);zagd_status_i64(out,"cache_bytes_after_trim",trim.bytes_after);
    // Logical allocator payload witnesses let the daemon diagnose its own
    // retained allocations. RSS and the cgroup/RLIMIT remain the hard safety
    // boundaries because allocator arenas and kernel pages are distinct.
    zagd_status_i64(out,"allocator_allocation_count",_zag_allocator_allocation_count());
    zagd_status_i64(out,"allocator_live_bytes",_zag_allocator_live_bytes());
    zagd_status_i64(out,"allocator_peak_live_bytes",_zag_allocator_peak_live_bytes());
    zagd_status_line(out,"last_file",file);zagd_status_i64(out,"content_hash_first",hash.first);
    zagd_status_i64(out,"content_hash_second",hash.second);zagd_status_i64(out,"snapshot_first",snapshot.identity.first);
    zagd_status_i64(out,"snapshot_second",snapshot.identity.second);zagd_status_i64(out,"snapshot_parent_first",snapshot.parent.first);
    zagd_status_i64(out,"snapshot_root_module_first",snapshot.root_module.first);
    zagd_status_i64(out,"snapshot_root_source_first",snapshot.root_source.first);
    zagd_status_i64(out,"snapshot_semantic_graph_first",snapshot.semantic_graph.first);
    zagd_status_i64(out,"snapshot_semantic_graph_complete",snapshot.semantic_graph_complete);
    zagd_status_i64(out,"snapshot_timestamp_ms",snapshot.timestamp_ms);
    zagd_status_i64(out,"snapshot_file_count",snapshot.file_count);
}

fn zagd_write_status(path: []u8, pid: i64, mode: i32, state: []u8,
        file: []u8, hash: ZagdHash, events: i64, snapshot:ZagdSnapshot, change:i32, cache_reused:i32, incremental_reused:i32, incremental_change:i32, semantic:SemanticManifestView, semantic_validation:i32, dependents:i32, affected_decls:i32, plan:ZagdPlannerRun, cancellations:i64, trim:ZagdCacheTrim,policy:PlannerConfig) i32 {
    let slash:i32=0-1;let i:i32=0;while(i<path.len){if(path[i]=='/'){slash=i;}i=i+1;}
    let root:[]u8=".";if(slash>0){root=path[0..slash];}
    let status:ArrayList[u8]=zagd_text(1024);
    zagd_status_append(&status,pid,mode,state,file,hash,events,snapshot,change,cache_reused,
        incremental_reused,incremental_change,semantic,semantic_validation,dependents,
        affected_decls,plan,cancellations,trim,policy);
    zagd_text_append(&status,"watcher=inotify\n");
    if(@strEq(state,"error-inotify-init")||@strEq(state,"error-inotify-watch")){zagd_text_append(&status,"watcher_health=error\n");}else{zagd_text_append(&status,"watcher_health=ok\n");}
    zagd_status_i64(&status,"cache_bytes",zagd_cache_bytes(root));
    let written:i32=_zag_write_file(path,status.data[0..status.len]);
    free[u8](&status);
    return written;
}

fn zagd_run(root: []u8, root_source:[]u8, mode: i32, window_ms: i64,max_cache_bytes:i64,cpu:X86CpuProfile,policy:PlannerConfig) i32 {
    zagd_set_low_priority();
    let status_path: []u8 = zagd_join_path(root, ".zagd.status");
    let stop_path: []u8 = zagd_join_path(root, ".zagd.stop");
    let lock_path: []u8 = zagd_join_path(root, ".zagd.lock");
    let pid: i64 = zagd_pid();
    let empty: ZagdHash = zagd_content_hash("");
    let snapshot: ZagdSnapshot = zagd_make_snapshot(empty,empty,zagd_content_hash(root),
        empty,empty,empty,0,0,0,1);
    let cache_reused:i32=0;
    let incremental_reused:i32=0;let incremental_change:i32=zagd_change_unknown();let incremental_index:ZagdIncrementalIndex=zi_index_bad();let incremental_owned:i32=1;
    let records: ArrayList[ZagdFileState] = make[ZagdFileState](32);
    let snapshot_path:[]u8=zagd_join_path(zagd_join_path(zagd_join_path(root,".zag-cache"),"zagd"),"snapshot.record");
    let semantic_path:[]u8=zagd_join_path(zagd_join_path(zagd_join_path(root,".zag-cache"),"zagd"),"semantic.record");
    let semantic_text:[]u8=_zag_read_file(semantic_path);
    let semantic_text_owned:i32=(semantic_text.len>=0) as i32;
    let semantic:SemanticManifestView=semantic_manifest_decode(semantic_text);
    if(semantic.valid==1&&zagd_manifest_modules_current(root,semantic_text)==0){semantic.valid=0;}
    let snapshot_root_module:[]u8=zagd_snapshot_root_module(root,root_source,semantic);
    let incremental_path:[]u8=zagd_incremental_path(root);
    if(_zag_file_exists(incremental_path)==1){
        let incremental_text:[]u8=_zag_read_file(incremental_path);
        if(incremental_text.len>=0){
            let decoded_index:ZagdIncrementalIndex=zagd_incremental_index_decode(incremental_text);
            if(decoded_index.valid==1&&zagd_incremental_index_reused(decoded_index,semantic)==1){
                let owned_index:ZagdIncrementalIndex=zagd_incremental_clone_owned(decoded_index);
                zagd_incremental_free_owned_index(&incremental_index);
                incremental_index=owned_index;incremental_reused=1;incremental_change=zagd_change_none();
            }
            zagd_incremental_free_borrowed_index(&decoded_index);
            _zag_free(_zag_slice_ptr(incremental_text));
        }
    }
    let semantic_validation:i32=0;
    let planner_cancellations:i64=0;
    let affected_dependents:i32=0;
    let affected_declarations:i32=0;
    let planner_run:ZagdPlannerRun=zagd_planner_start(mode,256);zagd_planner_step(&planner_run,semantic_manifest_decl_count(semantic_text),0);
    zagd_planner_accept_constants(&planner_run,semantic_manifest_constant_count(semantic_text));
    // Shared cache publication and eviction happen only after singleton
    // authority is established below. A losing concurrent starter may inspect
    // advisory state, but it must never unlink or replace the active daemon's
    // records before returning the duplicate-daemon diagnostic.
    let cache_trim:ZagdCacheTrim=ZagdCacheTrim{.outcome=1,.bytes_before=0,.bytes_after=0};
    if(_zag_file_exists(snapshot_path)==1){
        let saved:[]u8=_zag_read_file(snapshot_path);
        if(saved.len>=0){
            let expected_graph:ZagdHash=zagd_hash_empty();let expected_graph_complete:i32=0;
            if(semantic.valid==1&&semantic.graph_complete==1&&snapshot_root_module.len>0&&
                @strEq(semantic.module,snapshot_root_module)){expected_graph=semantic.graph_identity;expected_graph_complete=1;}
            let restored:ZagdSnapshotRecord=zagd_snapshot_record_compatible(saved,zag_version(),
                "linux-x86_64-generic",zagd_mode_name(mode),snapshot_root_module,
                zagd_snapshot_root_source_disk(root,snapshot_root_module),zagd_content_hash(root),
                expected_graph,expected_graph_complete);
            if(restored.valid==1&&zagd_restore_index(root,saved,&records)==restored.file_count&&
                zagd_revalidate_index(records)==1){
                let recomputed:ZagdSnapshot=zagd_snapshot_records(root,snapshot_root_module,
                    semantic,records,restored.parent);
                if(recomputed.valid==1&&zagd_hash_equal(recomputed.identity,restored.identity)==1&&
                    recomputed.file_count==restored.file_count){
                    recomputed.timestamp_ms=restored.timestamp_ms;snapshot=recomputed;cache_reused=1;
                }
            }
            if(cache_reused==0){zagd_free_records(&records);records=make[ZagdFileState](32);}
            _zag_free(_zag_slice_ptr(saved));
        }
    }
    if(semantic.valid==1){zagd_seed_semantic_records(root,semantic_text,&records);}
    if (mode == zagd_mode_off()) {
        if (_zag_file_exists(lock_path) == 1) {
            let owner_record:[]u8=zagd_lock_record_after_start_window(lock_path);
            let owner:i64=zagd_parse_pid(owner_record);
            let owner_alive:i32=0;if(owner>=2){owner_alive=zagd_lock_identity_alive(owner_record,root);}
            if(owner_record.len>=0){_zag_free(_zag_slice_ptr(owner_record));}
            if(owner<2||owner_alive==0){zagd_unlink(lock_path);}
            else {
                let _stop_write: i32 = _zag_write_file(stop_path, "stop\n");
                let waits: i32 = 0;
                while (waits < 2000 && _zag_file_exists(lock_path) == 1) {
                    zagd_sleep_ms(1);
                    waits = waits + 1;
                }
                if (_zag_file_exists(lock_path) == 1) {
                    _zag_eprintln("zagd: active daemon did not stop before timeout");
                    if(snapshot_root_module.len>0){zagd_text_free(snapshot_root_module);}
                    return 7;
                }
            }
        }
        cache_trim=zagd_cache_trim(root,max_cache_bytes);if(cache_trim.outcome==0){semantic.valid=0;}
        let _wr: i32 = zagd_write_status(status_path, pid, mode, "stopped", "", empty, 0, snapshot,zagd_change_none(),cache_reused,incremental_reused,incremental_change,semantic,semantic_validation,affected_dependents,affected_declarations,planner_run,planner_cancellations,cache_trim,policy);
        if(snapshot_root_module.len>0){zagd_text_free(snapshot_root_module);}
        return 0;
    }

    zagd_unlink(stop_path);

    let lock_fd: i64 = zagd_claim_singleton(lock_path, root);
    if (lock_fd < 0) {
        _zag_eprintln("zagd: project already has an active or starting daemon");
        if(snapshot_root_module.len>0){zagd_text_free(snapshot_root_module);}
        return 6;
    }
    let lock_record:[]u8=zagd_lock_record(pid);
    if(lock_record.len==0||_zag_write_file(lock_path,lock_record)!=0){
        if(lock_record.len>0){zagd_text_free(lock_record);}
        zagd_close(lock_fd);zagd_unlink(lock_path);
        _zag_eprintln("zagd: could not publish project singleton identity");
        if(snapshot_root_module.len>0){zagd_text_free(snapshot_root_module);}
        return 7;
    }
    zagd_text_free(lock_record);
    // A missing, corrupt, mode-incompatible, or source-stale snapshot must
    // never leave the watcher with an empty baseline.  Run this only after
    // acquiring the singleton lock: rebuilding advisory records before that
    // point would let a losing concurrent starter modify shared cache files.
    // The bounded two-read scan is a cache miss, never cache reuse; the
    // foreground semantic manifest remains the authority for graph facts.
    let selected_root_changed:i32=0;
    if(snapshot_root_module.len>0){
        if(semantic.valid==0||semantic.graph_complete!=1||@strEq(semantic.module,snapshot_root_module)==0){
            selected_root_changed=1;
        }
    }
    if(selected_root_changed==1){
        semantic.valid=0;semantic_validation=2;
        if(semantic_text_owned==1){_zag_free(_zag_slice_ptr(semantic_text));}
        semantic_text="";semantic_text_owned=0;
        cache_reused=0;
        incremental_reused=0;incremental_change=zagd_change_unknown();
        if(incremental_owned==1){zagd_incremental_free_owned_index(&incremental_index);}
        incremental_index=zi_index_bad();incremental_owned=1;
        zagd_unlink(semantic_path);
        zagd_unlink(incremental_path);
        zagd_unlink_project(root,".zagd.semantic-ready");
        let root_selected_ok:i32=zagd_semantic_check(root,root_source,semantic_path);
        if(root_selected_ok==1){
            let root_checked:[]u8=_zag_read_file(semantic_path);
            if(root_checked.len>=0){
                let checked_view:SemanticManifestView=semantic_manifest_decode(root_checked);
                if(checked_view.valid==1&&zagd_manifest_modules_current(root,root_checked)==1){
                    semantic_text=root_checked;semantic_text_owned=1;semantic=checked_view;semantic_validation=1;
                    zagd_incremental_bind_manifest(&incremental_index,semantic);
                    let _root_incremental_write:i32=zagd_persist_incremental(root,incremental_index);
                }else{
                    _zag_free(_zag_slice_ptr(root_checked));
                }
            }
        }
    }
    if(cache_reused==0){
        let initial_rescan:ZagdStableRescan=zagd_rescan_sources_stable(root,window_ms);
        if(initial_rescan.stable==1){
            zagd_free_records(&records);records=initial_rescan.records;
            let initial_parent:ZagdHash=snapshot.identity;
            snapshot=zagd_snapshot_records(root,snapshot_root_module,semantic,records,initial_parent);
            let _initial_snapshot_write:i32=zagd_persist_snapshot(root,snapshot_root_module,
                mode,snapshot,records);
            if(incremental_owned==1){zagd_incremental_free_owned_index(&incremental_index);}
            incremental_index=zagd_incremental_from_records(records);incremental_owned=1;
            incremental_reused=0;incremental_change=zagd_change_unknown();
            if(semantic.valid==1){zagd_incremental_bind_manifest(&incremental_index,semantic);}
            let _initial_incremental_write:i32=zagd_persist_incremental(root,incremental_index);
        }else{
            // `zagd_rescan_sources_stable` owns its returned record paths on
            // both success and failure; discard an unstable attempt rather
            // than retaining a half-written project view.
            zagd_free_records(&initial_rescan.records);
        }
    }
    let _initial_plan:i32=zagd_persist_plan(root,mode,semantic,planner_run,cpu);
    let initial_inv:SemanticInvalidation=SemanticInvalidation{.semantic_changed=1,.declaration_dependents=semantic_manifest_decl_count(semantic_text),.layout_changed=1,.codegen_invalidated=1,.comment_only=0};
    let _initial_artifacts:i32=zagd_persist_artifacts(root,semantic_text,initial_inv);
    let _initial_candidates:i32=zagd_persist_candidates(root,semantic_text,mode,cpu,policy);
    cache_trim=zagd_cache_trim(root,max_cache_bytes);if(cache_trim.outcome==0){semantic.valid=0;}
    // Finalists run only after this daemon owns the project singleton.
    let _initial_deep:i32=zagd_execute_deep_controls(root,mode,semantic_text,cpu,stop_path);

    let fd: i64 = zagd_inotify_open();
    if (fd < 0) {
        zagd_close(lock_fd); zagd_unlink(lock_path);
        let _wr: i32 = zagd_write_status(status_path, pid, mode, "error-inotify-init", "", empty, 0, snapshot,zagd_change_none(),cache_reused,incremental_reused,incremental_change,semantic,semantic_validation,affected_dependents,affected_declarations,planner_run,planner_cancellations,cache_trim,policy);
        if(snapshot_root_module.len>0){zagd_text_free(snapshot_root_module);}
        return 2;
    }
    let watches: ArrayList[ZagdWatch] = make[ZagdWatch](16);
    zagd_scan_directories(fd, root, &watches);
    let project_watch_count:i32=watches.len;
    // A directory's own inotify watch can be removed before its final
    // IN_DELETE_SELF is consumed during recursive removal. Watch its parent as
    // a second, stable lifecycle witness so temporary/generated projects cannot
    // leave an orphan daemon behind.
    let root_parent:[]u8=zagd_path_parent(root);let root_name:[]u8=zagd_path_name(root);
    if(@strEq(root_parent,root)==0){let _root_guard:i32=zagd_watch_path(fd,root_parent,&watches);}
    if (project_watch_count == 0) {
        zagd_close(fd);
        zagd_close(lock_fd); zagd_unlink(lock_path);
        let _wr: i32 = zagd_write_status(status_path, pid, mode, "error-inotify-watch", "", empty, 0, snapshot,zagd_change_none(),cache_reused,incremental_reused,incremental_change,semantic,semantic_validation,affected_dependents,affected_declarations,planner_run,planner_cancellations,cache_trim,policy);
        if(snapshot_root_module.len>0){zagd_text_free(snapshot_root_module);}
        return 3;
    }

    let _wr0: i32 = zagd_write_status(status_path, pid, mode, "idle", "", empty, 0, snapshot,zagd_change_none(),cache_reused,incremental_reused,incremental_change,semantic,semantic_validation,affected_dependents,affected_declarations,planner_run,planner_cancellations,cache_trim,policy);
    let buffer: ArrayList[u8] = make[u8](4096);
    // Adaptive mode is the only mode with an idle-deep policy.  Polling in
    // one-second bounded intervals gives the daemon a cancellation point and
    // keeps the kernel, rather than a userspace timer loop, responsible for
    // sleeping.  Any source event resets the clock and permits a later deep
    // attempt; one idle period produces at most one deep-control run.
    let idle_deep_elapsed_ms:i64=0;
    let idle_deep_triggered:i32=0;
