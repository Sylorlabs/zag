// zagd daemon entry. Build with:
//   ./znc selfhost/zagd_daemon.zag -o zagd
// Run foreground for supervision/tests, or pass --daemonize for auto-start.

@import("zagd.zag")
@import("zagd_linux.zag")
@import("zagd_store.zag")
@import("zagd_incremental.zag")
@import("zagd_benchmark.zag")
@import("zagd_profile.zag")
@import("planner_authority.zag")
@import("zagd_identity.zag")
@import("native/x86_cpu_profile.zag")
@import("semantic_manifest_format.zag")
@import("zagd_manifest_inputs.zag")
@import("version.zag")

extern fn _zag_read_file(path: []u8) []u8
extern fn _zag_write_file(path: []u8, content: []u8) i32
extern fn _zag_file_exists(path: []u8) i32
extern fn _zag_exec_cmd(command: []u8) i32
extern fn _zag_allocator_allocation_count() i64
extern fn _zag_allocator_live_bytes() i64
extern fn _zag_allocator_peak_live_bytes() i64

fn zagd_apply_memory_limit(bytes:i64)i32 {
    // Linux x86-64 setrlimit(RLIMIT_AS, &{soft,hard}). A daemon is advisory,
    // so it must be contained by the configured process address-space budget
    // instead of competing with foreground applications until the OOM killer
    // intervenes.
    let limits:ArrayList[i64]=make[i64](2);
    limits.data[0]=bytes;limits.data[1]=bytes;
    let applied:i32=(_zag_raw_syscall(160,9,limits.data as i64,0,0,0,0)==0) as i32;
    free[i64](&limits);
    return applied;
}

struct ZagdWatch { wd: i64, path: []u8 }
struct ZagdFileState { path: []u8, hash: ZagdHash, facts:ZagdSourceFacts, exists: i32 }
// Cache maintenance is advisory, but it must be observable: a missing
// advisory record must never be mistaken for a successful foreground result.
struct ZagdCacheTrim { outcome:i32, bytes_before:i64, bytes_after:i64 }

fn zagd_incremental_file(path:[]u8,source:[]u8,facts:ZagdSourceFacts)ZagdIncrementalFile{return zagd_incremental_extract(path,source,facts,"linux-x86_64-generic");}
fn zagd_incremental_copy_names(file:*ZagdIncrementalFile)void{file.*.path=zagd_text_clone(file.*.path);let i:i32=0;while(i<file.*.declarations.len){file.*.declarations.data[i].name=zagd_text_clone(file.*.declarations.data[i].name);i=i+1;}}
fn zagd_incremental_free_owned_file(file:*ZagdIncrementalFile)void{if(file.*.valid==1){zagd_text_free(file.*.path);let i:i32=0;while(i<file.*.declarations.len){zagd_text_free(file.*.declarations.data[i].name);i=i+1;}}free[ZagdDeclFingerprint](&file.*.declarations);}
fn zagd_incremental_put_owned(index:*ZagdIncrementalIndex,file:ZagdIncrementalFile)void{let found:i32=zagd_incremental_index_find(index.*,file.path);if(found<0){push[ZagdIncrementalFile](&index.*.files,file);}else{zagd_incremental_free_owned_file(&index.*.files.data[found]);index.*.files.data[found]=file;}}
fn zagd_incremental_remove_owned(index:*ZagdIncrementalIndex,path:[]u8)i32{let found:i32=zagd_incremental_index_find(index.*,path);if(found<0){return 0;}zagd_incremental_free_owned_file(&index.*.files.data[found]);let i:i32=found;while(i+1<index.*.files.len){index.*.files.data[i]=index.*.files.data[i+1];i=i+1;}index.*.files.len=index.*.files.len-1;return 1;}
fn zagd_incremental_free_owned_index(index:*ZagdIncrementalIndex)void{let i:i32=0;while(i<index.*.files.len){zagd_incremental_free_owned_file(&index.*.files.data[i]);i=i+1;}free[ZagdIncrementalFile](&index.*.files);}
// Decoded paths and declaration names borrow the record buffer, while their
// ArrayList backing buffers are independent allocations. Keep those ownership
// modes explicit: release borrowed container storage without touching text,
// or clone the complete index before it enters the mutable daemon state.
fn zagd_incremental_free_borrowed_index(index:*ZagdIncrementalIndex)void{let i:i32=0;while(i<index.*.files.len){free[ZagdDeclFingerprint](&index.*.files.data[i].declarations);i=i+1;}free[ZagdIncrementalFile](&index.*.files);}
fn zagd_incremental_clone_owned(index:ZagdIncrementalIndex)ZagdIncrementalIndex{
    let out:ZagdIncrementalIndex=zi_index_bad();out.graph_identity=index.graph_identity;out.graph_complete=index.graph_complete;out.valid=index.valid;out.advisory=index.advisory;out.executable_authority=index.executable_authority;
    let i:i32=0;while(i<index.files.len){let source:ZagdIncrementalFile=index.files.data[i];let copy:ZagdIncrementalFile=source;copy.path=zagd_text_clone(source.path);copy.declarations=make[ZagdDeclFingerprint](source.declarations.len+1);let j:i32=0;while(j<source.declarations.len){let decl:ZagdDeclFingerprint=source.declarations.data[j];decl.name=zagd_text_clone(decl.name);push[ZagdDeclFingerprint](&copy.declarations,decl);j=j+1;}push[ZagdIncrementalFile](&out.files,copy);i=i+1;}
    return out;
}
fn zagd_incremental_path(root:[]u8)[]u8{let base:[]u8=zagd_join_path(root,".zag-cache");let dir:[]u8=zagd_join_path(base,"zagd");let path:[]u8=zagd_join_path(dir,"incremental.record");zagd_text_free(dir);zagd_text_free(base);return path;}
fn zagd_persist_incremental(root:[]u8,index:ZagdIncrementalIndex)i32{let payload:[]u8=zagd_incremental_index_encode_compact(index);if(payload.len==0){return 0;}let final:[]u8=zagd_incremental_path(root);let suffix:[]u8=_zag_str_concat(final,".tmp");let written:i32=zagd_store_transaction(suffix,final,payload);zagd_text_free(payload);zagd_text_free(final);zagd_text_free(suffix);return written;}
fn zagd_incremental_bind_manifest(index:*ZagdIncrementalIndex,manifest:SemanticManifestView)void{index.*.graph_identity=zagd_hash_empty();index.*.graph_complete=0;if(manifest.valid==1){index.*.graph_identity=manifest.graph_identity;index.*.graph_complete=manifest.graph_complete;}}
fn zagd_incremental_index_reused(index:ZagdIncrementalIndex,manifest:SemanticManifestView)i32{if(index.valid!=1||index.advisory!=1||index.executable_authority!=0||index.files.len==0||index.graph_complete!=1||manifest.valid!=1||manifest.graph_complete!=1||zagd_hash_equal(index.graph_identity,manifest.graph_identity)==0){return 0;}let i:i32=0;while(i<index.files.len){let file:ZagdIncrementalFile=index.files.data[i];if(file.valid!=1||_zag_file_exists(file.path)==0){return 0;}let bytes:[]u8=_zag_read_file(file.path);let matches:i32=0;if(bytes.len>=0){matches=zagd_hash_equal(zagd_content_hash(bytes),file.content);_zag_free(_zag_slice_ptr(bytes));}if(matches==0){return 0;}i=i+1;}return 1;}

fn zagd_shell_quote(value:[]u8)[]u8{
    let out:ArrayList[u8]=zagd_text(value.len+8);zagd_text_append_byte(&out,'\'');let i:i32=0;
    while(i<value.len){if(value[i]=='\''){zagd_text_append(&out,"'\\''");}else{zagd_text_append_byte(&out,value[i]);}i=i+1;}
    zagd_text_append_byte(&out,'\'');return out.data[0..out.len];
}
fn zagd_exe_dir(path:[]u8)[]u8{let last:i32=0-1;let i:i32=0;while(i<path.len){if(path[i]=='/'){last=i;}i=i+1;}if(last<0){return ".";}if(last==0){return "/";}return path[0..last];}
fn zagd_is_zag_source(path:[]u8)i32{return path.len>=4&&@strEq(path[path.len-4..],".zag");}
fn zagd_trim_line(value:[]u8)[]u8{let n:i32=value.len;while(n>0&&(value[n-1]=='\n'||value[n-1]=='\r')){n=n-1;}return value[0..n];}
fn zagd_semantic_check(root:[]u8,root_source:[]u8,semantic_path:[]u8)i32{
    // An explicitly launched watcher owns its root module.  The control file
    // is only a compatibility fallback for older background launches; letting
    // it override an explicit root lets unrelated foreground builds redirect
    // this daemon into a much larger compilation unit.
    let selected:[]u8=root_source;let selected_owned:i32=0;let control:[]u8=zagd_join_path(root,".zagd.root-source");if(selected.len==0&&_zag_file_exists(control)==1){selected=zagd_trim_line(_zag_read_file(control));selected_owned=1;}zagd_text_free(control);
    if(selected.len==0){if(selected_owned==1){_zag_free(_zag_slice_ptr(selected));}return 0;}
    let source:[]u8=selected;let source_owned:i32=0;
    if(source.len>0&&source[0]!='/'&&@strEq(root,".")==0){source=zagd_join_path(root,source);source_owned=1;}
    if(_zag_file_exists(source)==0){zagd_unlink(semantic_path);if(source_owned==1){zagd_text_free(source);}if(selected_owned==1){_zag_free(_zag_slice_ptr(selected));}return 0;}
    // A prior manifest must never survive a failed check as apparent truth.
    zagd_unlink(semantic_path);
    zagd_unlink_project(root,".zagd.semantic-ready");
    let compiler:[]u8=zagd_join_path(zagd_exe_dir(_zag_arg(0)),"znc");
    if(_zag_file_exists(compiler)==0){zagd_text_free(compiler);if(source_owned==1){zagd_text_free(source);}if(selected_owned==1){_zag_free(_zag_slice_ptr(selected));}return 0;}
    // `znc check` publishes its semantic record relative to its working
    // directory. Run it in the watched project so the record lands beside
    // `semantic_path`; invoking the sibling compiler from the daemon's
    // launcher directory otherwise validates successfully but leaves the
    // daemon with no project manifest to consume.
    let command_source:[]u8=source;if(zagd_path_in_project(root,source)==1){command_source=zagd_relative(root,source);}
    let root_quote:[]u8=zagd_shell_quote(root);let compiler_quote:[]u8=zagd_shell_quote(compiler);let source_quote:[]u8=zagd_shell_quote(command_source);let command:ArrayList[u8]=zagd_text(root_quote.len+compiler_quote.len+source_quote.len+80);zagd_text_append(&command,"cd ");zagd_text_append(&command,root_quote);zagd_text_append(&command," && ");zagd_text_append(&command,compiler_quote);zagd_text_append(&command," check ");zagd_text_append(&command,source_quote);zagd_text_append(&command," --no-zagd --no-analyze >/dev/null 2>/dev/null");let ok:i32=(_zag_exec_cmd(command.data[0..command.len])==0) as i32;free[u8](&command);zagd_text_free(root_quote);zagd_text_free(compiler_quote);zagd_text_free(source_quote);zagd_text_free(compiler);if(source_owned==1){zagd_text_free(source);}if(selected_owned==1){_zag_free(_zag_slice_ptr(selected));}return ok;
}

fn zagd_path_less(a:[]u8,b:[]u8)i32{let n:i32=a.len;if(b.len<n){n=b.len;}let i:i32=0;while(i<n){if(a[i]<b[i]){return 1;}if(a[i]>b[i]){return 0;}i=i+1;}if(a.len<b.len){return 1;}return 0;}
fn zagd_relative(root:[]u8,path:[]u8)[]u8{if(path.len>root.len&&@strEq(path[0..root.len],root)&&path[root.len]=='/'){return path[root.len+1..];}return path;}
// The launcher may pass a project-relative root (`app.zag`) while inotify
// reports an absolute path.  Compare both identities without relying on the
// current working directory, so root-invalidity handling cannot silently miss
// a stable editor save.
fn zagd_is_selected_root(root:[]u8,root_source:[]u8,full:[]u8)i32{
    if(root_source.len==0){return 0;}
    if(@strEq(full,root_source)){return 1;}
    if(@strEq(zagd_relative(root,full),root_source)){return 1;}
    if(root_source[0]=='/'){return 0;}
    let joined:[]u8=zagd_join_path(root,root_source);let same:i32=(@strEq(full,joined) as i32);zagd_text_free(joined);return same;
}
fn zagd_path_in_project(root:[]u8,path:[]u8)i32{
    return (@strEq(root,path)||
        (path.len>root.len&&@strEq(path[0..root.len],root)&&path[root.len]=='/')) as i32;
}
fn zagd_source_path_is_zs(path:[]u8)i32{return path.len>=3&&@strEq(path[path.len-3..],".zs");}
fn zagd_source_starts_script(source:[]u8)i32{
    let i:i32=0;
    while(i<source.len){
        while(i<source.len&&(source[i]==' '||source[i]=='\t'||source[i]=='\n'||source[i]=='\r')){i=i+1;}
        if(i+1<source.len&&source[i]=='/'&&source[i+1]=='/'){
            while(i<source.len&&source[i]!='\n'){i=i+1;}
        } else {
            if(i+7<=source.len&&@strEq(source[i..i+7],"script;")){return 1;}
            return 0;
        }
    }
    return 0;
}
fn zagd_activation_source(path:[]u8,source:[]u8)[]u8{
    if(zagd_source_path_is_zs(path)==1&&zagd_source_starts_script(source)==0){
        return _zag_str_concat("script;\n",source);
    }
    return source;
}
// Resolve the selected root once and own the canonical project-relative text
// for the daemon lifetime. A later invalid semantic check must not erase or
// redirect the root identity of the watcher that was originally requested.
fn zagd_snapshot_root_module(root:[]u8,requested:[]u8,
        semantic:SemanticManifestView)[]u8{
    let selected:[]u8=requested;let selected_buffer:[]u8="";let selected_owned:i32=0;
    if(selected.len==0){
        let control:[]u8=zagd_join_path(root,".zagd.root-source");
        if(_zag_file_exists(control)==1){selected_buffer=_zag_read_file(control);if(selected_buffer.len>=0){selected=zagd_trim_line(selected_buffer);selected_owned=1;}}
        zagd_text_free(control);
    }
    if(selected.len==0&&semantic.valid==1){selected=semantic.module;}
    let rel:[]u8=zagd_relative(root,selected);let out:[]u8="";
    if(rel.len>0&&zagd_index_path_safe(rel)==1){out=zagd_text_clone(rel);}
    if(selected_owned==1){_zag_free(_zag_slice_ptr(selected_buffer));}
    return out;
}
fn zagd_snapshot_root_source_disk(root:[]u8,module:[]u8)ZagdHash{
    if(module.len==0){return zagd_hash_empty();}
    let path:[]u8=zagd_join_path(root,module);if(zagd_path_is_regular(path)==0){zagd_text_free(path);return zagd_hash_empty();}
    let source:[]u8=_zag_read_file(path);zagd_text_free(path);if(source.len<0){return zagd_hash_empty();}
    let hash:ZagdHash=zagd_content_hash(source);_zag_free(_zag_slice_ptr(source));return hash;
}
fn zagd_snapshot_records(root:[]u8,root_module:[]u8,semantic:SemanticManifestView,
        records:ArrayList[ZagdFileState],parent:ZagdHash)ZagdSnapshot{
    let order:ArrayList[ZagdFileState]=make[ZagdFileState](records.len);let i:i32=0;while(i<records.len){if(records.data[i].exists==1){push[ZagdFileState](&order,records.data[i]);}i=i+1;}
    i=0;while(i<order.len){let best:i32=i;let j:i32=i+1;while(j<order.len){if(zagd_path_less(order.data[j].path,order.data[best].path)==1){best=j;}j=j+1;}if(best!=i){let t:ZagdFileState=order.data[i];order.data[i]=order.data[best];order.data[best]=t;}i=i+1;}
    let root_hash:ZagdHash=zagd_content_hash(root);let module_hash:ZagdHash=zagd_content_hash(root_module);
    let source_hash:ZagdHash=zagd_hash_empty();let root_found:i32=(root_module.len==0) as i32;
    i=0;while(i<order.len){if(root_module.len>0&&@strEq(zagd_relative(root,order.data[i].path),root_module)){source_hash=order.data[i].hash;root_found=1;}i=i+1;}
    let graph:ZagdHash=zagd_hash_empty();let graph_complete:i32=0;
    if(semantic.valid==1&&semantic.graph_complete==1&&root_module.len>0&&@strEq(semantic.module,root_module)){graph=semantic.graph_identity;graph_complete=1;}
    let id:ZagdHash=zagd_snapshot_begin(root_hash,module_hash,source_hash,graph,graph_complete);
    i=0;while(i<order.len){id=zagd_snapshot_add(id,zagd_relative(root,order.data[i].path),order.data[i].hash);i=i+1;}
    let timestamp:i64=_zag_clock_monotonic_ms();if(timestamp<0){timestamp=0;}
    let snapshot:ZagdSnapshot=zagd_make_snapshot(id,parent,root_hash,module_hash,
        source_hash,graph,graph_complete,timestamp,order.len,root_found);
    free[ZagdFileState](&order);return snapshot;
}
fn zagd_index_path_safe(path:[]u8)i32{let i:i32=0;while(i<path.len){if(path[i]=='\n'||path[i]=='\r'||path[i]=='\t'){return 0;}i=i+1;}return zagd_canonical_relative(path);}
fn zagd_append_hash_fields(out:*ArrayList[u8],h:ZagdHash)void{zagd_text_append_i64(out,h.first);zagd_text_append_byte(out,'\t');zagd_text_append_i64(out,h.second);zagd_text_append_byte(out,'\t');zagd_text_append_i64(out,h.bytes);}
fn zagd_persist_snapshot(root:[]u8,root_module:[]u8,mode:i32,s:ZagdSnapshot,
        records:ArrayList[ZagdFileState]) i32 {
    if(s.valid!=1||s.timestamp_ms<0||s.semantic_graph_complete<0||s.semantic_graph_complete>1||
        (root_module.len>0&&zagd_index_path_safe(root_module)==0)||
        zagd_hash_equal(s.root_module,zagd_content_hash(root_module))==0){return 0;}
    let base:[]u8=zagd_join_path(root,".zag-cache");let dir:[]u8=zagd_join_path(base,"zagd");if(zagd_store_mkdir(base)==0||zagd_store_mkdir(dir)==0){zagd_text_free(base);zagd_text_free(dir);return 0;}
    let body:ArrayList[u8]=zagd_text(1280);zagd_text_append(&body,"format=zagd-snapshot-v2\nadvisory=true\nexecutable_authority=false\ncomplete=true\nvalidity=valid\ncompiler=");zagd_text_append(&body,zag_version());zagd_text_append(&body,"\ntarget=linux-x86_64-generic\nprofile=regular-or-script-root\nmode=");zagd_text_append(&body,zagd_mode_name(mode));zagd_text_append(&body,"\nroot_module_present=");if(root_module.len>0){zagd_text_append(&body,"1\nroot_module=");zagd_text_append(&body,root_module);}else{zagd_text_append(&body,"0\nroot_module=<unspecified>");}zagd_text_append(&body,"\nroot_project=");zagd_append_hash_fields(&body,s.root);zagd_text_append(&body,"\nroot_source=");zagd_append_hash_fields(&body,s.root_source);zagd_text_append(&body,"\nsemantic_graph=");zagd_append_hash_fields(&body,s.semantic_graph);zagd_text_append(&body,"\nsemantic_graph_complete=");zagd_text_append_i64(&body,s.semantic_graph_complete);zagd_text_append(&body,"\ntimestamp_ms=");zagd_text_append_i64(&body,s.timestamp_ms);zagd_text_append(&body,"\ntimestamp_basis=linux-monotonic-ms\ntimestamp_in_identity=false\nsnapshot_identity=");zagd_append_hash_fields(&body,s.identity);zagd_text_append(&body,"\nparent_identity=");zagd_append_hash_fields(&body,s.parent);zagd_text_append(&body,"\nfile_count=");zagd_text_append_i64(&body,s.file_count);zagd_text_append_byte(&body,'\n');
    let order:ArrayList[ZagdFileState]=make[ZagdFileState](records.len);let oi:i32=0;while(oi<records.len){if(records.data[oi].exists==1){push[ZagdFileState](&order,records.data[oi]);}oi=oi+1;}oi=0;while(oi<order.len){let best:i32=oi;let oj:i32=oi+1;while(oj<order.len){if(zagd_path_less(order.data[oj].path,order.data[best].path)==1){best=oj;}oj=oj+1;}if(best!=oi){let swap:ZagdFileState=order.data[oi];order.data[oi]=order.data[best];order.data[best]=swap;}oi=oi+1;}
    oi=0;while(oi<order.len){let rel:[]u8=zagd_relative(root,order.data[oi].path);if(zagd_index_path_safe(rel)==0){free[u8](&body);free[ZagdFileState](&order);zagd_text_free(base);zagd_text_free(dir);return 0;}let f:ZagdSourceFacts=order.data[oi].facts;zagd_text_append(&body,"file=");zagd_text_append(&body,rel);zagd_text_append_byte(&body,'\t');zagd_append_hash_fields(&body,order.data[oi].hash);zagd_text_append_byte(&body,'\t');zagd_append_hash_fields(&body,f.semantic);zagd_text_append_byte(&body,'\t');zagd_append_hash_fields(&body,f.public_shape);zagd_text_append_byte(&body,'\t');zagd_append_hash_fields(&body,f.root_profile);zagd_text_append_byte(&body,'\t');zagd_text_append_i64(&body,f.valid);zagd_text_append_byte(&body,'\n');oi=oi+1;}
    let sum:ZagdHash=zagd_content_hash(body.data[0..body.len]);zagd_text_append(&body,"checksum_first=");zagd_text_append_i64(&body,sum.first);zagd_text_append(&body,"\nchecksum_second=");zagd_text_append_i64(&body,sum.second);zagd_text_append_byte(&body,'\n');
    let final:[]u8=zagd_join_path(dir,"snapshot.record");let temp:[]u8=zagd_join_path(dir,"snapshot.record.tmp");let written:i32=zagd_store_transaction(temp,final,body.data[0..body.len]);free[u8](&body);zagd_text_free(final);zagd_text_free(temp);zagd_text_free(base);zagd_text_free(dir);free[ZagdFileState](&order);return written;
}

fn zagd_tab_field(line:[]u8,want:i32)[]u8{let field:i32=0;let start:i32=0;let i:i32=0;while(i<=line.len){if(i==line.len||line[i]=='\t'){if(field==want){return line[start..i];}field=field+1;start=i+1;}i=i+1;}return "";}
fn zagd_restore_index(root:[]u8,text:[]u8,records:*ArrayList[ZagdFileState])i32{
    let start:i32=0;let i:i32=0;let count:i32=0;
    while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];
        if(line.len>5&&@strEq(line[0..5],"file=")){
            let payload:[]u8=line[5..];let rel:[]u8=zagd_tab_field(payload,0);if(zagd_index_path_safe(rel)==0){return 0-1;}
            let nums:ArrayList[i64]=make[i64](13);let k:i32=1;let valid:i32=1;
            while(k<=13){let n:i64=zagd_parse_nonnegative(zagd_tab_field(payload,k));if(n<0){valid=0;k=14;}else{push[i64](&nums,n);k=k+1;}}
            if(valid==0){free[i64](&nums);return 0-1;}
            let content:ZagdHash=ZagdHash{.first=nums.data[0],.second=nums.data[1],.bytes=nums.data[2]};
            let facts:ZagdSourceFacts=ZagdSourceFacts{.content=content,.semantic=ZagdHash{.first=nums.data[3],.second=nums.data[4],.bytes=nums.data[5]},.public_shape=ZagdHash{.first=nums.data[6],.second=nums.data[7],.bytes=nums.data[8]},.root_profile=ZagdHash{.first=nums.data[9],.second=nums.data[10],.bytes=nums.data[11]},.valid=nums.data[12] as i32};
