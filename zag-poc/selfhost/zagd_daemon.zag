    // shutdown creates the stop file. If that happens before watches are
    // ready, no inotify event is queued for this descriptor. Honor the
    // already-published stop exactly once before the first blocking read.
    let running: i32 = (_zag_file_exists(stop_path)==0) as i32;
    let event_count: i64 = 0;
    while (running == 1) {
        let nread:i64=0;
        if(mode==zagd_mode_adaptive()&&policy.idle_deep==1){
            nread=zagd_read_events_timeout(fd,&buffer,1000);
            if(nread==(0-2)){
                if(idle_deep_elapsed_ms<30000){idle_deep_elapsed_ms=idle_deep_elapsed_ms+1000;}
                if(idle_deep_elapsed_ms>=30000&&idle_deep_triggered==0&&_zag_file_exists(stop_path)==0){
                    let _idle_deep:i32=zagd_execute_deep_controls(root,zagd_mode_deep(),semantic_text,cpu,stop_path);
                    idle_deep_triggered=1;
                }
                continue;
            }
        }else{
            // Blocking inotify read: unchanged light/deep projects consume no
            // polling CPU and retain the historical cancellation behavior.
            nread=zagd_read_events(fd, &buffer);
        }
        if (nread < 0) {
            running = 0;
        } else {
            idle_deep_elapsed_ms=0;
            idle_deep_triggered=0;
            let off: i32 = 0;
            while (off + 16 <= nread) {
                let event_wd: i64 = zagd_u32_at(buffer.data[0..nread as i32], off);
                let mask: i64 = zagd_u32_at(buffer.data[0..nread as i32], off + 4);
                let name_len: i32 = zagd_u32_at(buffer.data[0..nread as i32], off + 12) as i32;
                if (off + 16 + name_len > nread) {
                    off = nread as i32;
                } else {
                    let name: []u8 = zagd_event_name(buffer.data[0..nread as i32], off + 16, name_len);
                    let event_base:[]u8=zagd_watch_base(&watches,event_wd);
                    if(zagd_event_requires_rescan(mask)==1||(@strEq(name,".zagd.rescan")&&zagd_publish_event(mask)==1)){
                        // IN_Q_OVERFLOW means event history is incomplete. Treat
                        // it as global invalidation, then accept only two equal,
                        // bounded full-tree scans. `.zagd.rescan` exercises the
                        // same safe recovery path for supervision and tests.
                        let rescan_label:[]u8="<inotify-overflow-rescan>";
                        if(@strEq(name,".zagd.rescan")){
                            rescan_label="<explicit-rescan>";
                            zagd_unlink_project(root,".zagd.rescan");
                        }
                        let prior_declarations:i32=semantic_manifest_decl_count(semantic_text);
                        zagd_planner_step(&planner_run,0,1);
                        planner_cancellations=planner_cancellations+1;
                        semantic.valid=0;semantic_validation=2;if(semantic_text_owned==1){_zag_free(_zag_slice_ptr(semantic_text));semantic_text_owned=0;}semantic_text="";
                        incremental_reused=0;incremental_change=zagd_change_unknown();
                        if(incremental_owned==1){zagd_incremental_free_owned_index(&incremental_index);}incremental_index=zi_index_bad();incremental_owned=1;
                        zagd_unlink(semantic_path);
                        zagd_unlink(incremental_path);
                        zagd_unlink_project(root,".zagd.semantic-ready");
                        let rescanned:ZagdStableRescan=zagd_rescan_sources_stable(root,window_ms);
                        if(rescanned.stable==1){
                            zagd_free_records(&records);
                            records=rescanned.records;
                            cache_reused=0;
                            let prior_snapshot:ZagdHash=snapshot.identity;
                            event_count=event_count+1;
                            if(incremental_owned==1){zagd_incremental_free_owned_index(&incremental_index);}incremental_index=zagd_incremental_from_records(records);incremental_owned=1;
                            let _incremental_write:i32=zagd_persist_incremental(root,incremental_index);
                            let checked:i32=zagd_semantic_check(root,root_source,semantic_path);
                            if(checked==1){
                                let checked_text:[]u8=_zag_read_file(semantic_path);
                                let checked_view:SemanticManifestView=semantic_manifest_decode(checked_text);
                                if(checked_view.valid==1&&zagd_manifest_modules_current(root,checked_text)==1){if(semantic_text_owned==1){_zag_free(_zag_slice_ptr(semantic_text));}semantic_text=checked_text;semantic_text_owned=1;semantic=checked_view;semantic_validation=1;zagd_incremental_bind_manifest(&incremental_index,semantic);let _incremental_semantic_write:i32=zagd_persist_incremental(root,incremental_index);}else if(checked_text.len>=0){_zag_free(_zag_slice_ptr(checked_text));}
                            }
                            zagd_unlink_project(root,".zagd.semantic-ready");
                            snapshot=zagd_snapshot_records(root,snapshot_root_module,semantic,
                                records,prior_snapshot);
                            let _snapshot_write:i32=zagd_persist_snapshot(root,
                                snapshot_root_module,mode,snapshot,records);
                            affected_dependents=prior_declarations;
                            affected_declarations=prior_declarations;
                            planner_run=zagd_planner_start(mode,256);
                            zagd_planner_step(&planner_run,semantic_manifest_decl_count(semantic_text),0);
                            zagd_planner_accept_constants(&planner_run,semantic_manifest_constant_count(semantic_text));
                            let _plan_write:i32=zagd_persist_plan(root,mode,semantic,planner_run,cpu);
                            let conservative:SemanticInvalidation=SemanticInvalidation{.semantic_changed=1,
                                .declaration_dependents=prior_declarations,.layout_changed=1,
                                .codegen_invalidated=1,.comment_only=0};
                            let _artifact_write:i32=zagd_persist_artifacts(root,semantic_text,conservative);
                            let _candidate_write:i32=zagd_persist_candidates(root,semantic_text,mode,cpu,policy);
                            let rescan_trim:ZagdCacheTrim=zagd_cache_trim(root,max_cache_bytes);
                            if(rescan_trim.outcome==0){semantic.valid=0;}
                            let _rescan_status:i32=zagd_write_status(status_path,pid,mode,"idle",
                                rescan_label,empty,event_count,snapshot,zagd_change_unknown(),
                                cache_reused,incremental_reused,incremental_change,semantic,
                                semantic_validation,affected_dependents,affected_declarations,
                                planner_run,planner_cancellations,rescan_trim,policy);
                        } else {
                            zagd_free_records(&rescanned.records);
                            let rescan_trim:ZagdCacheTrim=zagd_cache_trim(root,max_cache_bytes);
                            let _rescan_status:i32=zagd_write_status(status_path,pid,mode,"stabilizing",
                                rescan_label,empty,event_count,snapshot,zagd_change_unknown(),
                                cache_reused,incremental_reused,incremental_change,semantic,
                                semantic_validation,prior_declarations,prior_declarations,
                                planner_run,planner_cancellations,rescan_trim,policy);
                        }
                    } else if (@strEq(event_base,root_parent)==1&&@strEq(name,root_name)==1&&
                        (zagd_mask_has(mask,zagd_in_delete())==1||zagd_mask_has(mask,zagd_in_moved_from())==1)) {
                        running=0;
                    } else if (zagd_mask_has(mask, zagd_in_delete_self()) == 1 ||
                        zagd_mask_has(mask, zagd_in_move_self()) == 1 ||
                        zagd_mask_has(mask, zagd_in_ignored()) == 1) {
                        // The watched project root vanished or was atomically
                        // replaced. It no longer has a stable source identity,
                        // so terminate instead of keeping an orphan daemon.
                        running = 0;
                    } else if (@strEq(name, ".zagd.stop")) {
                        running = 0;
                    } else if(@strEq(name,".zagd.semantic-ready")&&zagd_publish_event(mask)==1){
                        zagd_sleep_ms(window_ms);
                        let next_text:[]u8=_zag_read_file(semantic_path);
                        if(next_text.len>=0){
                            let next_semantic:SemanticManifestView=semantic_manifest_decode(next_text);
                            if(next_semantic.valid==1&&zagd_manifest_modules_current(root,next_text)==1){
                                let artifact_inv:SemanticInvalidation=semantic_manifest_invalidation(semantic_text,next_text);
                                affected_declarations=artifact_inv.declaration_dependents;
                                if(semantic_text_owned==1){_zag_free(_zag_slice_ptr(semantic_text));}
                                semantic_text=next_text;semantic_text_owned=1;semantic=next_semantic;semantic_validation=1;
                                zagd_incremental_bind_manifest(&incremental_index,semantic);
                                let _incremental_semantic_write:i32=zagd_persist_incremental(root,incremental_index);
                                let prior_ready_snapshot:ZagdHash=snapshot.identity;
                                snapshot=zagd_snapshot_records(root,snapshot_root_module,semantic,
                                    records,prior_ready_snapshot);
                                let _ready_snapshot_write:i32=zagd_persist_snapshot(root,
                                    snapshot_root_module,mode,snapshot,records);
                                zagd_planner_step(&planner_run,0,1);
                                planner_run=zagd_planner_start(mode,256);
                                zagd_planner_step(&planner_run,semantic_manifest_decl_count(semantic_text),0);
                                zagd_planner_accept_constants(&planner_run,semantic_manifest_constant_count(semantic_text));
                                let _plan_write:i32=zagd_persist_plan(root,mode,semantic,planner_run,cpu);
                                let _artifact_write:i32=zagd_persist_artifacts(root,semantic_text,artifact_inv);
                                let _candidate_write:i32=zagd_persist_candidates(root,semantic_text,mode,cpu,policy);
                                let _deep_write:i32=zagd_execute_deep_controls(root,mode,semantic_text,cpu,stop_path);
                                let ready_trim:ZagdCacheTrim=zagd_cache_trim(root,max_cache_bytes);
                                if(ready_trim.outcome==0){semantic.valid=0;}
                                event_count=event_count+1;
                                let _ready_status:i32=zagd_write_status(status_path,pid,mode,"idle",
                                    ".zagd.semantic-ready",zagd_content_hash(next_text),event_count,
                                    snapshot,zagd_change_none(),cache_reused,incremental_reused,
                                    incremental_change,semantic,semantic_validation,0,
                                    affected_declarations,planner_run,planner_cancellations,ready_trim,policy);
                            }else{_zag_free(_zag_slice_ptr(next_text));}
                        }
                        zagd_unlink_project(root,".zagd.semantic-ready");
                    // The watcher may observe every filesystem write in the
                    // project tree. Planner analysis is source-driven: never
                    // hash or parse compiler binaries, object files, editor
                    // databases, or other arbitrary payloads merely because
                    // they share a watched directory.
                    } else if (zagd_ignored_name(name) == 0 &&
                        zagd_mask_has(mask, zagd_in_isdir()) == 1 &&
                        (zagd_mask_has(mask, zagd_in_create()) == 1 || zagd_mask_has(mask, zagd_in_moved_to()) == 1)) {
                        let base: []u8 = zagd_watch_base(&watches, event_wd);
                        let full: []u8 = zagd_join_path(base, name);
                        // Directories do not have a source identity themselves.
                        // Add their recursive watches before accepting later file
                        // events, then leave source hashing to the .zag branch.
                        zagd_scan_directories(fd, full, &watches);
                        zagd_text_free(full);
                    } else if (zagd_ignored_name(name) == 0 &&
                        (zagd_source_name(name) == 1 ||
                        zagd_dependency_input_name(name) == 1)) {
