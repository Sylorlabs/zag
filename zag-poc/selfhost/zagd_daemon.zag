                                        if(previous_at>=0){let decision:ZagdIncrementalDecision=zagd_incremental_decide(incremental_index.files.data[previous_at],current_incremental);incremental_change=decision.change;if(incremental_change==zagd_change_unknown()){incremental_change=change;}incremental_reused=decision.reuse_parse;}
                                        zagd_incremental_put_owned(&incremental_index,current_incremental);
                                        incremental_index.valid=1;incremental_index.advisory=1;incremental_index.executable_authority=0;
                                        let _incremental_write:i32=zagd_persist_incremental(root,incremental_index);
