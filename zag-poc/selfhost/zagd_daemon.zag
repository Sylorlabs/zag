    let body:ArrayList[u8]=zagd_text(2304);zagd_text_append(&body,"format=zagd-profile-plan-v3\nadvisory=true\nexecutable_authority=false\nforeground_consumption=metadata-only\ncodegen_effect=none\nmode=deep\nsource_changes=false\ntarget=linux-x86_64\nprovenance=measured-profile-and-derived-validation\ncompiler=");zagd_text_append(&body,zag_version());zagd_text_append(&body,"\nforeground_compiler_identity=");zagd_append_hash_fields(&body,foreground_compiler_identity);zagd_text_append(&body,"\ncpu_profile=");zagd_text_append(&body,cpu.canonical);zagd_text_append(&body,"\ncpu_detection=");zagd_text_append(&body,cpu.detection);zagd_text_append(&body,"\ntarget_cache_key=");zagd_text_append(&body,cpu.cache_key);zagd_text_append(&body,"\nsemantic_source=");zagd_append_hash_fields(&body,view.source);zagd_text_append(&body,"\nsemantic_graph=");zagd_append_hash_fields(&body,view.graph_identity);zagd_text_append(&body,"\nsemantic_graph_complete=");zagd_text_append_i64(&body,view.graph_complete);zagd_text_append(&body,"\nprofile_source_identity=");zagd_append_hash_fields(&body,semantic_identity);zagd_text_append(&body,"\ntarget_identity=");zagd_append_hash_fields(&body,target);zagd_text_append(&body,"\nprofile_compiler_identity=");zagd_append_hash_fields(&body,compiler_identity);zagd_text_append(&body,"\nprofile_payload_identity=");zagd_append_hash_fields(&body,profile_identity);zagd_text_append(&body,"\nprofile_samples=");zagd_text_append_i64(&body,profile.samples.len);zagd_text_append(&body,"\nhot_regions=");zagd_text_append_i64(&body,hot.len);zagd_text_append(&body,"\nsemantic_identity=");zagd_append_hash_fields(&body,semantic_identity);zagd_text_append_byte(&body,'\n');
