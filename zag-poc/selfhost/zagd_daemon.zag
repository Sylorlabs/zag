    let compiler_identity:ZagdHash=zagd_content_hash(compiler_bytes);let target:ZagdHash=zagd_content_hash(cpu.cache_key);let profile_identity:ZagdHash=zagd_content_hash(profile_text);let profile:ZagdProfile=zagd_profile_decode(profile_text,compiler_identity,semantic_identity,target,256);
    if(profile.valid==0){free[ZagdProfileSample](&profile.samples);_zag_free(_zag_slice_ptr(foreground_compiler_bytes));_zag_free(_zag_slice_ptr(compiler_bytes));_zag_free(_zag_slice_ptr(profile_text));return 0;}
