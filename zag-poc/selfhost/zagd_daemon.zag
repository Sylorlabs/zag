fn zagd_persist_candidates(root:[]u8,semantic_text:[]u8,mode:i32,cpu:X86CpuProfile,cfg:PlannerConfig)i32{
    let base:[]u8=zagd_join_path(root,".zag-cache");let dir:[]u8=zagd_join_path(base,"zagd");let final:[]u8=zagd_join_path(dir,"candidates.record");zagd_unlink(final);
    let view:SemanticManifestView=semantic_manifest_decode(semantic_text);let semantic_identity:ZagdHash=zagd_plan_semantic_identity(semantic_text,cpu);
    if(view.valid==0||mode<zagd_mode_adaptive()||semantic_identity.bytes<=0||
        zagd_manifest_modules_current(root,semantic_text)==0){zagd_text_free(final);zagd_text_free(dir);zagd_text_free(base);return 0;}
    let _profile_plan:i32=zagd_persist_profile_plan(root,semantic_text,mode,cpu);
    // The AST-free decoder accepts only checksum-valid, compiler-produced
    // lifetime facts with the complete narrow proof boundary. They support a
    // human advisory record below, but never make the executable buffer-reuse
    // candidate supported: no transform or equivalence revalidation exists.
    // The sole supported executable decision remains the existing Script CPU
    // default when this daemon's resolved target exactly matches it.
    let compact_manifest:i32=(@strEq(smf_value(semantic_text,"detail_level"),"compact")) as i32;
    let buffer_lifetimes:SemanticBufferLifetimeFacts=semantic_manifest_buffer_lifetime_facts(semantic_text);
    let configured_cpu:X86CpuProfile=parse_x86_cpu_profile(cfg.default_cpu);let cpu_matches:i32=(configured_cpu.valid==1&&@strEq(configured_cpu.cache_key,cpu.cache_key)) as i32;
    let proven_buffer_bytes:i64=0;let proven_buffer_pairs:i32=0;if(buffer_lifetimes.valid==1){proven_buffer_bytes=buffer_lifetimes.reusable_bytes;proven_buffer_pairs=buffer_lifetimes.pairs;}
    let facts:ZagdPlanFacts=ZagdPlanFacts{.temporary_bytes=proven_buffer_bytes,.repeated_allocations=0,
        .non_overlapping_buffers=(proven_buffer_pairs>0) as i32,.cpu_loop=0,.explicit_allocator=0,.explicit_device=0,
        .script_cpu_unspecified=1,.script_cpu_target_compatible=cpu_matches};
    let target:ZagdHash=zagd_content_hash(cpu.cache_key);let generated:ArrayList[ZagdConcreteCandidate]=zagd_generate_candidates(facts,semantic_identity,target,(@strEq(smf_value(semantic_text,"profile"),"script")) as i32,5,0);
    // Pruning consumes and frees its input. Keep the generated list separately
    // owned because the record below publishes every generated candidate after
    // finalist selection; passing `generated` directly would serialize freed
    // storage and then double-free it during publisher cleanup.
