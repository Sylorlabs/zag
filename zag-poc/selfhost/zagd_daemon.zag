    let profile_text:[]u8=_zag_read_file(profile_path);zagd_text_free(profile_path);if(profile_text.len<=0){if(profile_text.len>=0){_zag_free(_zag_slice_ptr(profile_text));}return 0;}
    let compiler_bytes:[]u8=_zag_read_file("/proc/self/exe");if(compiler_bytes.len<=0){if(compiler_bytes.len>=0){_zag_free(_zag_slice_ptr(compiler_bytes));}_zag_free(_zag_slice_ptr(profile_text));return 0;}
