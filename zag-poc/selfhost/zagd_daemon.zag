    zagd_text_append(&body,"eligible_regions=");zagd_text_append_i64(&body,eligible);zagd_text_append_byte(&body,'\n');
    let sum:ZagdHash=zagd_content_hash(body.data[0..body.len]);zagd_text_append(&body,"checksum_first=");zagd_text_append_i64(&body,sum.first);zagd_text_append(&body,"\nchecksum_second=");zagd_text_append_i64(&body,sum.second);zagd_text_append(&body,"\nchecksum_bytes=");zagd_text_append_i64(&body,sum.bytes);zagd_text_append_byte(&body,'\n');
    let base:[]u8=zagd_join_path(root,".zag-cache");let dir:[]u8=zagd_join_path(base,"zagd");let temp:[]u8=zagd_join_path(dir,"profile-plan.record.tmp");let final:[]u8=zagd_join_path(dir,"profile-plan.record");zagd_unlink(final);let written:i32=zagd_store_transaction(temp,final,body.data[0..body.len]);
    zagd_text_free(final);zagd_text_free(temp);zagd_text_free(dir);zagd_text_free(base);free[u8](&body);free[ZagdBackendRegionPlan](&plans);free[ZagdProfileSample](&hot);free[ZagdProfileSample](&profile.samples);_zag_free(_zag_slice_ptr(foreground_compiler_bytes));_zag_free(_zag_slice_ptr(compiler_bytes));_zag_free(_zag_slice_ptr(profile_text));return written;
