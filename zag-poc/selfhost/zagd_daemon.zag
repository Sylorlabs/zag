// CPU selection is planner input, never build authority.  The shared profile
// module derives the semantic identity from this explicit target key so daemon
// production and foreground validation cannot drift.
fn zagd_plan_semantic_identity(text:[]u8,cpu:X86CpuProfile)ZagdHash{
    if(cpu.valid==0){return zagd_hash_empty();}
    return zagd_profile_semantic_identity(text,zag_version(),cpu.cache_key);
}
fn zagd_dependency_input_name(name:[]u8)i32{
    return (@strEq(name,"zag.mod")||@strEq(name,"zag.lock")) as i32;
}
fn zagd_persist_plan(root:[]u8,mode:i32,semantic:SemanticManifestView,run:ZagdPlannerRun,cpu:X86CpuProfile)i32{
    let base:[]u8=zagd_join_path(root,".zag-cache");let dir:[]u8=zagd_join_path(base,"zagd");
    if(zagd_store_mkdir(base)==0||zagd_store_mkdir(dir)==0){zagd_text_free(base);zagd_text_free(dir);return 0;}
    let body:ArrayList[u8]=zagd_text(512);
    zagd_text_append(&body,"advisory=true\nexecutable_authority=false\nbasis=proven-manifest-facts\nsource_changes=false\nperformance_benefit=unknown\nequivalence=canonical-literal-or-bounded-integer-arithmetic-return\nmode=");zagd_text_append(&body,zagd_mode_name(mode));zagd_text_append(&body,"\ncpu_profile=");zagd_text_append(&body,cpu.canonical);zagd_text_append(&body,"\ncpu_detection=");zagd_text_append(&body,cpu.detection);zagd_text_append(&body,"\ntarget_cache_key=");zagd_text_append(&body,cpu.cache_key);zagd_text_append(&body,"\nsemantic_source_first=");zagd_text_append_i64(&body,semantic.source.first);zagd_text_append(&body,"\nbudget=");zagd_text_append_i64(&body,run.budget);zagd_text_append(&body,"\nevaluated=");zagd_text_append_i64(&body,run.evaluated);zagd_text_append(&body,"\nsuggestions=");zagd_text_append_i64(&body,run.suggestions);zagd_text_append(&body,"\n");
    let sum:ZagdHash=zagd_content_hash(body.data[0..body.len]);zagd_text_append(&body,"checksum_first=");zagd_text_append_i64(&body,sum.first);zagd_text_append_byte(&body,'\n');
    let temp:[]u8=zagd_join_path(dir,"plan.record.tmp");let final:[]u8=zagd_join_path(dir,"plan.record");let written:i32=zagd_store_transaction(temp,final,body.data[0..body.len]);free[u8](&body);zagd_text_free(temp);zagd_text_free(final);zagd_text_free(base);zagd_text_free(dir);return written;
}
fn zagd_persist_artifacts(root:[]u8,semantic_text:[]u8,inv:SemanticInvalidation)i32{
    let view:SemanticManifestView=semantic_manifest_decode(semantic_text);if(view.valid==0){return 0;}
    let base:[]u8=zagd_join_path(root,".zag-cache");let dir:[]u8=zagd_join_path(base,"zagd");if(zagd_store_mkdir(base)==0||zagd_store_mkdir(dir)==0){zagd_text_free(base);zagd_text_free(dir);return 0;}
    let identity:ZagdHash=semantic_manifest_artifact_identity(semantic_text,zag_version(),"linux-x86_64-generic");let machine_link:ZagdHash=semantic_manifest_machine_cache_link(semantic_text,zag_version(),"linux-x86_64-generic");let body:ArrayList[u8]=zagd_text(768);
    zagd_text_append(&body,"format=zagd-artifact-index-v2\nadvisory=true\nexecutable_authority=false\ncomplete=true\ncompiler=");zagd_text_append(&body,zag_version());zagd_text_append(&body,"\ntarget=linux-x86_64-generic\nsemantic_source=");zagd_append_hash_fields(&body,view.source);zagd_text_append(&body,"\ngraph_identity=");zagd_append_hash_fields(&body,view.graph_identity);zagd_text_append(&body,"\ngraph_complete=");zagd_text_append_i64(&body,view.graph_complete);zagd_text_append(&body,"\nartifact_identity=");zagd_append_hash_fields(&body,identity);zagd_text_append(&body,"\nforeground_machine_cache_link=");zagd_append_hash_fields(&body,machine_link);zagd_text_append(&body,"\nforeground_machine_cache_authority=false\ndeclaration_dependents_invalidated=");zagd_text_append_i64(&body,inv.declaration_dependents);zagd_text_append(&body,"\nlayout_invalidated=");zagd_text_append_i64(&body,inv.layout_changed);zagd_text_append(&body,"\ncodegen_invalidated=");zagd_text_append_i64(&body,inv.codegen_invalidated);zagd_text_append(&body,"\ncomment_only=");zagd_text_append_i64(&body,inv.comment_only);zagd_text_append_byte(&body,'\n');
    let sum:ZagdHash=zagd_content_hash(body.data[0..body.len]);zagd_text_append(&body,"checksum_first=");zagd_text_append_i64(&body,sum.first);zagd_text_append(&body,"\nchecksum_second=");zagd_text_append_i64(&body,sum.second);zagd_text_append_byte(&body,'\n');
    let temp:[]u8=zagd_join_path(dir,"artifact.record.tmp");let final:[]u8=zagd_join_path(dir,"artifact.record");let written:i32=zagd_store_transaction(temp,final,body.data[0..body.len]);free[u8](&body);zagd_text_free(temp);zagd_text_free(final);zagd_text_free(base);zagd_text_free(dir);return written;
}
fn zagd_persist_profile_plan(root:[]u8,semantic_text:[]u8,mode:i32,cpu:X86CpuProfile)i32{
