                            }
                            let event_trim:ZagdCacheTrim=zagd_cache_trim(root,max_cache_bytes);if(event_trim.outcome==0){semantic.valid=0;}
                            let _wr: i32 = zagd_write_status(status_path, pid, mode,
                                "idle", full, hash, event_count, snapshot,change,cache_reused,incremental_reused,incremental_change,semantic,semantic_validation,affected_dependents,affected_declarations,planner_run,planner_cancellations,event_trim,policy);
                            }
                        }
                        }
                        zagd_text_free(full);
                    }
                    off = off + 16 + name_len;
                }
            }
        }
    }
    // A clean shutdown is also a persistence boundary. This covers a stop that
    // races the final stable event without making the cache authoritative.
    let _final_snapshot_write:i32=zagd_persist_snapshot(root,snapshot_root_module,
        mode,snapshot,records);
    zagd_close(fd);
    zagd_close(lock_fd);
    free[u8](&buffer);
    zagd_free_watches(&watches);
    zagd_free_records(&records);
    zagd_unlink(lock_path);
    zagd_unlink(stop_path);
    let _wr1: i32 = zagd_write_status(status_path, pid, mode, "stopped", "", empty, event_count, snapshot,zagd_change_none(),cache_reused,incremental_reused,incremental_change,semantic,semantic_validation,affected_dependents,affected_declarations,planner_run,planner_cancellations,cache_trim,policy);
    if(semantic_text_owned==1){_zag_free(_zag_slice_ptr(semantic_text));}
    if(incremental_owned==1){zagd_incremental_free_owned_index(&incremental_index);}
    if(snapshot_root_module.len>0){zagd_text_free(snapshot_root_module);}
    zagd_text_free(incremental_path);zagd_text_free(semantic_path);zagd_text_free(snapshot_path);zagd_text_free(lock_path);zagd_text_free(stop_path);zagd_text_free(status_path);
    return 0;
}

fn zagd_set_policy_arg(policy:*PlannerConfig,key:[]u8,value:[]u8)i32 {
    planner_set(policy,_zag_str_concat(key,_zag_str_concat("=",value)));
    if(policy.*.valid==0){_zag_eprintln(_zag_str_concat("zagd: ",policy.*.diagnostic));return 0;}
    return 1;
}

fn main() i32 {
    let root: []u8 = ".";
    let root_source:[]u8="";
    let policy:PlannerConfig=planner_default_config();
    let mode: i32 = zagd_parse_mode(policy.mode);
    let window_ms: i64 = policy.stability_window_ms;
    let daemonize: i32 = 0;
    let max_memory_bytes:i64=policy.max_memory_bytes;
    let max_cache_bytes:i64=policy.max_cache_bytes;
    let max_workers:i32=policy.max_workers;
    let notifications:[]u8=policy.notifications;
    let cpu_request:[]u8=policy.default_cpu;
    let i: i32 = 1;
    while (i < _zag_argc()) {
        let arg: []u8 = _zag_arg(i);
        if (@strEq(arg, "--daemonize")) { daemonize = 1; }
        else if (@strEq(arg, "--root") && i + 1 < _zag_argc()) { i = i + 1; root = _zag_arg(i); }
        else if (@strEq(arg, "--root-source") && i + 1 < _zag_argc()) { i=i+1;root_source=_zag_arg(i); }
        else if (@strEq(arg, "--mode") && i + 1 < _zag_argc()) {
            i = i + 1;
            mode = zagd_parse_mode(_zag_arg(i));
            if (mode < 0) { _zag_eprintln("zagd: mode must be off, light, adaptive, or deep"); return 4; }
            policy.mode=zagd_mode_name(mode);
        }
        else if (@strEq(arg,"--idle-deep") && i+1<_zag_argc()) {
            i=i+1;if(zagd_set_policy_arg(&policy,"idle_deep",_zag_arg(i))==0){return 4;}
        }
        else if (@strEq(arg,"--difficulty") && i+1<_zag_argc()) {
            i=i+1;if(zagd_set_policy_arg(&policy,"difficulty",_zag_arg(i))==0){return 4;}
        }
        else if (@strEq(arg,"--script-optimization") && i+1<_zag_argc()) {
            i=i+1;if(zagd_set_policy_arg(&policy,"script_optimization",_zag_arg(i))==0){return 4;}
        }
        else if (@strEq(arg,"--regular-optimization") && i+1<_zag_argc()) {
            i=i+1;if(zagd_set_policy_arg(&policy,"regular_optimization",_zag_arg(i))==0){return 4;}
        }
        else if (@strEq(arg,"--objective") && i+1<_zag_argc()) {
            i=i+1;if(zagd_set_policy_arg(&policy,"objective",_zag_arg(i))==0){return 4;}
        }
        else if (@strEq(arg,"--trust-mode") && i+1<_zag_argc()) {
            i=i+1;if(zagd_set_policy_arg(&policy,"trust_mode",_zag_arg(i))==0){return 4;}
        }
        else if (@strEq(arg, "--window-ms") && i + 1 < _zag_argc()) {
            i = i + 1;
            window_ms = zagd_parse_window(_zag_arg(i));
            if (window_ms < 0) { _zag_eprintln("zagd: --window-ms must be 1..60000"); return 4; }
            policy.stability_window_ms=window_ms;
        }
        else if (@strEq(arg,"--max-cache-bytes") && i+1<_zag_argc()) {
            i=i+1;max_cache_bytes=zagd_parse_nonnegative(_zag_arg(i));
            if(max_cache_bytes<1048576||max_cache_bytes>2147483648){_zag_eprintln("zagd: --max-cache-bytes must be 1048576..2147483648");return 4;}
            policy.max_cache_bytes=max_cache_bytes;
        }
        else if (@strEq(arg,"--max-memory-bytes") && i+1<_zag_argc()) {
            i=i+1;max_memory_bytes=zagd_parse_nonnegative(_zag_arg(i));
            if(max_memory_bytes<67108864||max_memory_bytes>2147483648){_zag_eprintln("zagd: --max-memory-bytes must be 67108864..2147483648");return 4;}
            policy.max_memory_bytes=max_memory_bytes;
        }
        else if (@strEq(arg,"--max-workers") && i+1<_zag_argc()) {
            i=i+1;let workers:i64=zagd_parse_nonnegative(_zag_arg(i));
            if(workers!=1){_zag_eprintln("zagd: this build supports exactly one quiet worker");return 4;}max_workers=1;policy.max_workers=1;
        }
        else if (@strEq(arg,"--cpu") && i+1<_zag_argc()) {
            i=i+1;cpu_request=_zag_arg(i);policy.default_cpu=cpu_request;
        }
        else if(arg.len>6&&@strEq(arg[0..6],"--cpu=")) { cpu_request=arg[6..];policy.default_cpu=cpu_request; }
        else if (@strEq(arg,"--notifications") && i+1<_zag_argc()) {
            i=i+1;notifications=_zag_arg(i);
            if(@strEq(notifications,"errors_only")==0&&@strEq(notifications,"advisory")==0){_zag_eprintln("zagd: --notifications must be errors_only or advisory");return 4;}
            policy.notifications=notifications;
        }
        else {_zag_eprintln(_zag_str_concat("zagd: unknown or incomplete argument: ",arg));return 4;}
        i = i + 1;
    }
    // `znc watch` may obtain its project root from getcwd with a trailing
    // separator. Canonicalize the boundary once so prefix checks, parent
    // guards, module paths, and content-addressed snapshots all describe the
    // same project rather than silently dropping every child event.
    while(root.len>1&&root[root.len-1]=='/'){root=root[0..root.len-1];}
    let cpu:X86CpuProfile=parse_x86_cpu_profile(cpu_request);
    if(cpu.valid==0){_zag_eprintln(_zag_str_concat("zagd: ",cpu.diagnostic));return 4;}
    if(zagd_apply_memory_limit(max_memory_bytes)==0){_zag_eprintln("zagd: could not apply process memory limit");return 7;}
    if (daemonize == 1) {
        let child: i64 = zagd_fork();
        if (child < 0) { _zag_eprintln("zagd: fork failed"); return 5; }
        if (child > 0) {
            // Do not report successful auto-start until the child owns and has
            // fully published the project lock. Mere path existence is not
            // enough: it may be a stale/malformed record that the child is
            // still replacing, or a partial record observed between O_EXCL and
            // publication. Require this exact child's PID, start token,
            // command line, and project root before returning success.
            let lock_path: []u8 = zagd_join_path(root, ".zagd.lock");
            let tries: i32 = 0;
            let child_owns: i32 = 0;
            while (tries < 1000 && child_owns == 0) {
                let record: []u8 = _zag_read_file(lock_path);
                if (record.len >= 0) {
                    if (zagd_parse_pid(record) == child &&
                        zagd_lock_identity_alive(record, root) == 1) {
                        child_owns = 1;
                    }
                    _zag_free(_zag_slice_ptr(record));
                }
                if (child_owns == 0) { zagd_sleep_ms(1); }
                tries = tries + 1;
            }
            zagd_text_free(lock_path);
            if (child_owns == 0) {
                _zag_eprintln("zagd: child did not publish a valid project singleton identity");
                return 6;
            }
            _zag_println(_zag_i64_to_str(child));
            return 0;
        }
        zagd_close(0); zagd_close(1); zagd_close(2);
    }
    return zagd_run(root, root_source, mode, window_ms,max_cache_bytes,cpu,policy);
}
