                        // derive identity from bytes rather than metadata.
                        let observed:ZagdSourceObservation=zagd_observe_source_stable(full,window_ms,records);
                        if(observed.stable==0){
                            // A half-written source is not a snapshot. Cancel
                            // analysis and fail closed until a later event yields
                            // two equal observations.
                            let prior_declarations:i32=semantic_manifest_decl_count(semantic_text);
                            zagd_planner_step(&planner_run,0,1);
                            planner_cancellations=planner_cancellations+1;
                            semantic.valid=0;semantic_validation=2;if(semantic_text_owned==1){_zag_free(_zag_slice_ptr(semantic_text));semantic_text_owned=0;}semantic_text="";
                            incremental_reused=0;incremental_change=zagd_change_unknown();
                            zagd_unlink(semantic_path);
                            zagd_unlink_project(root,".zagd.semantic-ready");
                            let unstable_trim:ZagdCacheTrim=zagd_cache_trim(root,max_cache_bytes);
                            let _unstable_status:i32=zagd_write_status(status_path,pid,mode,
                                "stabilizing",full,observed.hash,event_count,snapshot,
                                zagd_change_unknown(),cache_reused,incremental_reused,
                                incremental_change,semantic,semantic_validation,
                                prior_declarations,prior_declarations,planner_run,
                                planner_cancellations,unstable_trim,policy);
                        } else {
                            let exists:i32=observed.exists;
                            let hash:ZagdHash=observed.hash;
                            let facts:ZagdSourceFacts=observed.facts;
                            let change:i32=zagd_record_changed(&records, full, hash,facts, exists);
                            if (change >= 0) {
                            zagd_planner_step(&planner_run,0,1);planner_cancellations=planner_cancellations+1;planner_run=zagd_planner_start(mode,256);zagd_planner_step(&planner_run,0,0);
                            let relative_changed:[]u8=zagd_relative(root,full);affected_dependents=0;if(change==zagd_change_public_shape()){affected_dependents=semantic_manifest_transitive_dependents(semantic_text,full);if(affected_dependents==0){affected_dependents=semantic_manifest_transitive_dependents(semantic_text,relative_changed);}}
                            let root_changed:i32=zagd_is_selected_root(root,root_source,full);
                            let dependency_changed:i32=0;
                            if(semantic.valid==1){dependency_changed=((semantic_manifest_dependency_input_stale(semantic_text,full,hash)==1||semantic_manifest_dependency_input_stale(semantic_text,relative_changed,hash)==1) as i32);}
                            else if(zagd_dependency_input_name(name)==1){dependency_changed=1;}
                            let manifest_changed:i32=((semantic_manifest_module_stale(semantic_text,full,hash)==1||semantic_manifest_module_stale(semantic_text,relative_changed,hash)==1||dependency_changed==1) as i32);
                            if(semantic.valid==1&&manifest_changed==1){semantic.valid=0;}
                            let semantic_module_path:[]u8=zagd_join_path(root,semantic.module);
                            if(semantic.valid==1&&@strEq(full,semantic_module_path)&&zagd_hash_equal(hash,semantic.source)==0){semantic.valid=0;}
                            zagd_text_free(semantic_module_path);
                            // A `.zag` file outside the selected module graph
                            // is still observed and indexed, but it must not
                            // erase a valid semantic/artifact snapshot simply
                            // because it is an unfinished generated scratch
                            // file. Recheck only the selected root or a module
                            // proven to participate in the current manifest.
                            if((zagd_is_zag_source(full)==1&&
                                (root_changed==1||manifest_changed==1))||
                                dependency_changed==1){
                                let checked:i32=zagd_semantic_check(root,root_source,semantic_path);
                                if(checked==1){let checked_text:[]u8=_zag_read_file(semantic_path);let checked_view:SemanticManifestView=semantic_manifest_decode(checked_text);if(checked_view.valid==1&&zagd_manifest_modules_current(root,checked_text)==1){if(semantic_text_owned==1){_zag_free(_zag_slice_ptr(semantic_text));}semantic_text=checked_text;semantic_text_owned=1;semantic=checked_view;semantic_validation=1;zagd_incremental_bind_manifest(&incremental_index,semantic);}else{if(checked_text.len>=0){_zag_free(_zag_slice_ptr(checked_text));}semantic.valid=0;semantic_validation=2;if(root_changed==1){zagd_unlink(semantic_path);}}}
                                else{semantic.valid=0;semantic_validation=2;if(root_changed==1){zagd_unlink(semantic_path);}}
                                zagd_unlink_project(root,".zagd.semantic-ready");
                            }
                            event_count = event_count + 1;
                            let prior:ZagdHash=snapshot.identity;
                            snapshot=zagd_snapshot_records(root,snapshot_root_module,semantic,
                                records,prior);
                            // Persist only the latest content-addressed snapshot.
                            // The transactional writer replaces the prior
                            // record and releases all temporary containers, so
                            // rapid saves do not retain an in-memory event log.
                            let _cache_write:i32=zagd_persist_snapshot(root,
                                snapshot_root_module,mode,snapshot,records);
                            if(exists==1&&facts.valid==1&&zagd_is_zag_source(full)==1){
                                let stable_source:[]u8=_zag_read_file(full);
                                if(stable_source.len>=0){
                                    let current_incremental:ZagdIncrementalFile=zagd_incremental_file(full,stable_source,facts);
                                    if(current_incremental.valid==1){
