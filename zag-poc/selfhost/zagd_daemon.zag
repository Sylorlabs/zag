// zagd daemon entry. Build with:
//   ./znc selfhost/zagd_daemon.zag -o zagd
// Run foreground for supervision/tests, or pass --daemonize for auto-start.

@import("zagd.zag")
@import("zagd_linux.zag")
@import("zagd_store.zag")
@import("zagd_incremental.zag")
@import("zagd_benchmark.zag")
@import("zagd_profile.zag")
@import("semantic_manifest_format.zag")
@import("version.zag")

extern fn _zag_read_file(path: []u8) []u8
extern fn _zag_write_file(path: []u8, content: []u8) i32
extern fn _zag_file_exists(path: []u8) i32
extern fn _zag_exec_cmd(command: []u8) i32

struct ZagdWatch { wd: i64, path: []u8 }
struct ZagdFileState { path: []u8, hash: ZagdHash, facts:ZagdSourceFacts, exists: i32 }

fn zagd_incremental_file(path:[]u8,source:[]u8,facts:ZagdSourceFacts)ZagdIncrementalFile{return zagd_incremental_extract(path,source,facts,"linux-x86_64-generic");}
fn zagd_incremental_path(root:[]u8)[]u8{return zagd_join_path(zagd_join_path(zagd_join_path(root,".zag-cache"),"zagd"),"incremental.record");}
fn zagd_persist_incremental(root:[]u8,index:ZagdIncrementalIndex)i32{let payload:[]u8=zagd_incremental_index_encode(index);if(payload.len==0){return 0;}let final:[]u8=zagd_incremental_path(root);return zagd_store_transaction(_zag_str_concat(final,".tmp"),final,payload);}
fn zagd_incremental_index_reused(index:ZagdIncrementalIndex)i32{if(index.valid!=1||index.advisory!=1||index.executable_authority!=0){return 0;}let i:i32=0;while(i<index.files.len){let file:ZagdIncrementalFile=index.files.data[i];if(file.valid==1&&_zag_file_exists(file.path)==1&&zagd_hash_equal(zagd_content_hash(_zag_read_file(file.path)),file.content)==1){return 1;}i=i+1;}return 0;}

fn zagd_shell_quote(value:[]u8)[]u8{
    let out:[]u8="'";let i:i32=0;
    while(i<value.len){if(value[i]=='\''){out=_zag_str_concat(out,"'\\''");}else{out=_zag_str_concat(out,value[i..i+1]);}i=i+1;}
    return _zag_str_concat(out,"'");
}
fn zagd_exe_dir(path:[]u8)[]u8{let last:i32=0-1;let i:i32=0;while(i<path.len){if(path[i]=='/'){last=i;}i=i+1;}if(last<0){return ".";}if(last==0){return "/";}return path[0..last];}
fn zagd_is_zag_source(path:[]u8)i32{return path.len>=4&&@strEq(path[path.len-4..],".zag");}
fn zagd_trim_line(value:[]u8)[]u8{let n:i32=value.len;while(n>0&&(value[n-1]=='\n'||value[n-1]=='\r')){n=n-1;}return value[0..n];}
fn zagd_semantic_check(root:[]u8,root_source:[]u8,semantic_path:[]u8)i32{
    // An explicitly launched watcher owns its root module.  The control file
    // is only a compatibility fallback for older background launches; letting
    // it override an explicit root lets unrelated foreground builds redirect
    // this daemon into a much larger compilation unit.
    let selected:[]u8=root_source;let control:[]u8=zagd_join_path(root,".zagd.root-source");if(selected.len==0&&_zag_file_exists(control)==1){selected=zagd_trim_line(_zag_read_file(control));}
    if(selected.len==0){return 0;}
    let source:[]u8=selected;if(source[0]!='/'&&@strEq(root,".")==0){source=zagd_join_path(root,source);}
    if(_zag_file_exists(source)==0){zagd_unlink(semantic_path);return 0;}
    // A prior manifest must never survive a failed check as apparent truth.
    zagd_unlink(semantic_path);
    zagd_unlink(zagd_join_path(root,".zagd.semantic-ready"));
    let compiler:[]u8=zagd_join_path(zagd_exe_dir(_zag_arg(0)),"znc");
    if(_zag_file_exists(compiler)==0){return 0;}
    let command:[]u8=_zag_str_concat(zagd_shell_quote(compiler),_zag_str_concat(" check ",_zag_str_concat(zagd_shell_quote(source)," --no-zagd --no-analyze >/dev/null 2>/dev/null")));
    return _zag_exec_cmd(command)==0;
}

fn zagd_path_less(a:[]u8,b:[]u8)i32{let n:i32=a.len;if(b.len<n){n=b.len;}let i:i32=0;while(i<n){if(a[i]<b[i]){return 1;}if(a[i]>b[i]){return 0;}i=i+1;}if(a.len<b.len){return 1;}return 0;}
fn zagd_relative(root:[]u8,path:[]u8)[]u8{if(path.len>root.len&&@strEq(path[0..root.len],root)&&path[root.len]=='/'){return path[root.len+1..];}return path;}
fn zagd_snapshot_records(root:[]u8,records:ArrayList[ZagdFileState],parent:ZagdHash)ZagdSnapshot{
    let order:ArrayList[ZagdFileState]=make[ZagdFileState](records.len);let i:i32=0;while(i<records.len){if(records.data[i].exists==1){push[ZagdFileState](&order,records.data[i]);}i=i+1;}
    i=0;while(i<order.len){let best:i32=i;let j:i32=i+1;while(j<order.len){if(zagd_path_less(order.data[j].path,order.data[best].path)==1){best=j;}j=j+1;}if(best!=i){let t:ZagdFileState=order.data[i];order.data[i]=order.data[best];order.data[best]=t;}i=i+1;}
    let root_hash:ZagdHash=zagd_content_hash(root);let id:ZagdHash=zagd_snapshot_begin(root_hash);i=0;while(i<order.len){id=zagd_snapshot_add(id,zagd_relative(root,order.data[i].path),order.data[i].hash);i=i+1;}return zagd_make_snapshot(id,parent,root_hash,order.len,1);
}
fn zagd_index_path_safe(path:[]u8)i32{let i:i32=0;while(i<path.len){if(path[i]=='\n'||path[i]=='\r'||path[i]=='\t'){return 0;}i=i+1;}return zagd_canonical_relative(path);}
fn zagd_hash_fields(h:ZagdHash)[]u8{return _zag_str_concat(_zag_i64_to_str(h.first),_zag_str_concat("\t",_zag_str_concat(_zag_i64_to_str(h.second),_zag_str_concat("\t",_zag_i64_to_str(h.bytes)))));}
fn zagd_persist_snapshot(root:[]u8,mode:i32,s:ZagdSnapshot,records:ArrayList[ZagdFileState]) i32 {
    let base:[]u8=zagd_join_path(root,".zag-cache");let dir:[]u8=zagd_join_path(base,"zagd");if(zagd_store_mkdir(base)==0||zagd_store_mkdir(dir)==0){return 0;}
    let body:[]u8=_zag_str_concat("advisory=true\nexecutable_authority=false\ncompiler=",_zag_str_concat(zag_version(),_zag_str_concat("\ntarget=linux-x86_64-generic\nprofile=regular-or-script-root\nmode=",_zag_str_concat(zagd_mode_name(mode),_zag_str_concat("\nsnapshot_first=",_zag_str_concat(_zag_i64_to_str(s.identity.first),_zag_str_concat("\nsnapshot_second=",_zag_str_concat(_zag_i64_to_str(s.identity.second),_zag_str_concat("\nparent_first=",_zag_str_concat(_zag_i64_to_str(s.parent.first),_zag_str_concat("\nfile_count=",_zag_str_concat(_zag_i64_to_str(s.file_count),"\n"))))))))))));
    let order:ArrayList[ZagdFileState]=make[ZagdFileState](records.len);let oi:i32=0;while(oi<records.len){if(records.data[oi].exists==1){push[ZagdFileState](&order,records.data[oi]);}oi=oi+1;}oi=0;while(oi<order.len){let best:i32=oi;let oj:i32=oi+1;while(oj<order.len){if(zagd_path_less(order.data[oj].path,order.data[best].path)==1){best=oj;}oj=oj+1;}if(best!=oi){let swap:ZagdFileState=order.data[oi];order.data[oi]=order.data[best];order.data[best]=swap;}oi=oi+1;}
    oi=0;while(oi<order.len){let rel:[]u8=zagd_relative(root,order.data[oi].path);if(zagd_index_path_safe(rel)==0){return 0;}let f:ZagdSourceFacts=order.data[oi].facts;body=_zag_str_concat(body,_zag_str_concat("file=",_zag_str_concat(rel,_zag_str_concat("\t",_zag_str_concat(zagd_hash_fields(order.data[oi].hash),_zag_str_concat("\t",_zag_str_concat(zagd_hash_fields(f.semantic),_zag_str_concat("\t",_zag_str_concat(zagd_hash_fields(f.public_shape),_zag_str_concat("\t",_zag_str_concat(zagd_hash_fields(f.root_profile),_zag_str_concat("\t",_zag_str_concat(_zag_i64_to_str(f.valid),"\n")))))))))))));oi=oi+1;}
    let sum:ZagdHash=zagd_content_hash(body);let payload:[]u8=_zag_str_concat(body,_zag_str_concat("checksum_first=",_zag_str_concat(_zag_i64_to_str(sum.first),_zag_str_concat("\nchecksum_second=",_zag_str_concat(_zag_i64_to_str(sum.second),"\n")))));
    let final:[]u8=zagd_join_path(dir,"snapshot.record");let temp:[]u8=zagd_join_path(dir,"snapshot.record.tmp");return zagd_store_transaction(temp,final,payload);
}

fn zagd_tab_field(line:[]u8,want:i32)[]u8{let field:i32=0;let start:i32=0;let i:i32=0;while(i<=line.len){if(i==line.len||line[i]=='\t'){if(field==want){return line[start..i];}field=field+1;start=i+1;}i=i+1;}return "";}
fn zagd_restore_index(root:[]u8,text:[]u8,records:*ArrayList[ZagdFileState])i32{let start:i32=0;let i:i32=0;let count:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>5&&@strEq(line[0..5],"file=")){let payload:[]u8=line[5..];let rel:[]u8=zagd_tab_field(payload,0);if(zagd_index_path_safe(rel)==0){return 0-1;}let nums:ArrayList[i64]=make[i64](13);let k:i32=1;while(k<=13){let n:i64=zagd_parse_nonnegative(zagd_tab_field(payload,k));if(n<0){return 0-1;}push[i64](&nums,n);k=k+1;}let content:ZagdHash=ZagdHash{.first=nums.data[0],.second=nums.data[1],.bytes=nums.data[2]};let facts:ZagdSourceFacts=ZagdSourceFacts{.content=content,.semantic=ZagdHash{.first=nums.data[3],.second=nums.data[4],.bytes=nums.data[5]},.public_shape=ZagdHash{.first=nums.data[6],.second=nums.data[7],.bytes=nums.data[8]},.root_profile=ZagdHash{.first=nums.data[9],.second=nums.data[10],.bytes=nums.data[11]},.valid=nums.data[12] as i32};push[ZagdFileState](records,ZagdFileState{.path=zagd_join_path(root,rel),.hash=content,.facts=facts,.exists=1});count=count+1;}start=i+1;}i=i+1;}return count;}
fn zagd_persist_plan(root:[]u8,mode:i32,semantic:SemanticManifestView,run:ZagdPlannerRun)i32{let base:[]u8=zagd_join_path(root,".zag-cache");let dir:[]u8=zagd_join_path(base,"zagd");if(zagd_store_mkdir(base)==0||zagd_store_mkdir(dir)==0){return 0;}let body:[]u8="advisory=true\nexecutable_authority=false\nbasis=proven-manifest-facts\nsource_changes=false\nperformance_benefit=unknown\nequivalence=canonical-literal-or-bounded-integer-arithmetic-return\n";body=_zag_str_concat(body,_zag_str_concat("mode=",_zag_str_concat(zagd_mode_name(mode),"\n")));body=_zag_str_concat(body,_zag_str_concat("semantic_source_first=",_zag_str_concat(_zag_i64_to_str(semantic.source.first),"\n")));body=_zag_str_concat(body,_zag_str_concat("budget=",_zag_str_concat(_zag_i64_to_str(run.budget),"\n")));body=_zag_str_concat(body,_zag_str_concat("evaluated=",_zag_str_concat(_zag_i64_to_str(run.evaluated),"\n")));body=_zag_str_concat(body,_zag_str_concat("suggestions=",_zag_str_concat(_zag_i64_to_str(run.suggestions),"\n")));let sum:ZagdHash=zagd_content_hash(body);let payload:[]u8=_zag_str_concat(body,_zag_str_concat("checksum_first=",_zag_str_concat(_zag_i64_to_str(sum.first),"\n")));return zagd_store_transaction(zagd_join_path(dir,"plan.record.tmp"),zagd_join_path(dir,"plan.record"),payload);}
fn zagd_persist_artifacts(root:[]u8,semantic_text:[]u8,inv:SemanticInvalidation)i32{let view:SemanticManifestView=semantic_manifest_decode(semantic_text);if(view.valid==0){return 0;}let base:[]u8=zagd_join_path(root,".zag-cache");let dir:[]u8=zagd_join_path(base,"zagd");if(zagd_store_mkdir(base)==0||zagd_store_mkdir(dir)==0){return 0;}let identity:ZagdHash=semantic_manifest_artifact_identity(semantic_text,zag_version(),"linux-x86_64-generic");let body:[]u8="format=zagd-artifact-index-v1\nadvisory=true\nexecutable_authority=false\ncomplete=true\ncompiler=";body=_zag_str_concat(body,_zag_str_concat(zag_version(),"\ntarget=linux-x86_64-generic\n"));body=_zag_str_concat(body,_zag_str_concat("semantic_source=",_zag_str_concat(zagd_hash_fields(view.source),"\n")));body=_zag_str_concat(body,_zag_str_concat("artifact_identity=",_zag_str_concat(zagd_hash_fields(identity),"\n")));body=_zag_str_concat(body,_zag_str_concat("declaration_dependents_invalidated=",_zag_str_concat(_zag_i64_to_str(inv.declaration_dependents),"\n")));body=_zag_str_concat(body,_zag_str_concat("layout_invalidated=",_zag_str_concat(_zag_i64_to_str(inv.layout_changed),"\n")));body=_zag_str_concat(body,_zag_str_concat("codegen_invalidated=",_zag_str_concat(_zag_i64_to_str(inv.codegen_invalidated),"\n")));body=_zag_str_concat(body,_zag_str_concat("comment_only=",_zag_str_concat(_zag_i64_to_str(inv.comment_only),"\n")));let sum:ZagdHash=zagd_content_hash(body);let payload:[]u8=_zag_str_concat(body,_zag_str_concat("checksum_first=",_zag_str_concat(_zag_i64_to_str(sum.first),_zag_str_concat("\nchecksum_second=",_zag_str_concat(_zag_i64_to_str(sum.second),"\n")))));return zagd_store_transaction(zagd_join_path(dir,"artifact.record.tmp"),zagd_join_path(dir,"artifact.record"),payload);}
fn zagd_persist_profile_plan(root:[]u8,view:SemanticManifestView,mode:i32)i32{
    if(mode!=zagd_mode_deep()||view.valid==0){return 0;}let profile_text:[]u8=_zag_read_file(zagd_join_path(root,".zagd.profile"));if(profile_text.len<=0){return 0;}let compiler_bytes:[]u8=_zag_read_file("/proc/self/exe");if(compiler_bytes.len<=0){return 0;}let target:ZagdHash=zagd_content_hash("linux-x86_64-generic");let profile:ZagdProfile=zagd_profile_decode(profile_text,zagd_content_hash(compiler_bytes),view.source,target,256);if(profile.valid==0){return 0;}
    let hot:ArrayList[ZagdProfileSample]=zagd_select_hot_regions(profile,16);let plans:ArrayList[ZagdBackendRegionPlan]=zagd_backend_plan(hot,ZagdBackendFeatures{.popcnt=0,.bmi1=0,.packed_simd=0});let body:[]u8="format=zagd-profile-plan-v1\nadvisory=true\nexecutable_authority=false\nmode=deep\nsource_changes=false\ntarget=linux-x86_64-generic\n";body=_zag_str_concat(body,"hot_regions=");body=_zag_str_concat(body,_zag_i64_to_str(hot.len));body=_zag_str_concat(body,"\n");
    let i:i32=0;while(i<plans.len){let p:ZagdBackendRegionPlan=plans.data[i];body=_zag_str_concat(body,"region=");body=_zag_str_concat(body,p.region);body=_zag_str_concat(body,"\tkind=");body=_zag_str_concat(body,_zag_i64_to_str(p.kind));body=_zag_str_concat(body,"\tselected=");body=_zag_str_concat(body,_zag_i64_to_str(p.selected));body=_zag_str_concat(body,"\tsupported=");body=_zag_str_concat(body,_zag_i64_to_str(p.supported));body=_zag_str_concat(body,"\n");i=i+1;}
    let sum:ZagdHash=zagd_content_hash(body);let payload:[]u8=_zag_str_concat(body,_zag_str_concat("checksum_first=",_zag_str_concat(_zag_i64_to_str(sum.first),"\n")));let dir:[]u8=zagd_join_path(zagd_join_path(root,".zag-cache"),"zagd");return zagd_store_transaction(zagd_join_path(dir,"profile-plan.record.tmp"),zagd_join_path(dir,"profile-plan.record"),payload);
}
fn zagd_persist_candidates(root:[]u8,semantic_text:[]u8,mode:i32)i32{
    let view:SemanticManifestView=semantic_manifest_decode(semantic_text);if(view.valid==0||mode<zagd_mode_adaptive()){return 0;}
    let _profile_plan:i32=zagd_persist_profile_plan(root,view,mode);
    let allocs:i32=semantic_manifest_fact_count(semantic_text,"\talloc=1");let facts:ZagdPlanFacts=ZagdPlanFacts{.temporary_bytes=(allocs as i64)*4096,.repeated_allocations=allocs,.non_overlapping_buffers=(allocs>0) as i32,.cpu_loop=(semantic_manifest_decl_count(semantic_text)>0) as i32,.explicit_allocator=0,.explicit_device=0};
    let target:ZagdHash=zagd_content_hash("linux-x86_64-generic");let generated:ArrayList[ZagdConcreteCandidate]=zagd_generate_candidates(facts,view.source,target,(@strEq(smf_value(semantic_text,"profile"),"script")) as i32,4,0);let finalists:ArrayList[ZagdConcreteCandidate]=zagd_prune_dominated(generated,268435456,4,0);
    let body:[]u8="format=zagd-candidates-v1\nadvisory=true\nexecutable_authority=false\nsource_changes=false\n";body=_zag_str_concat(body,"source=");body=_zag_str_concat(body,zagd_hash_fields(view.source));body=_zag_str_concat(body,"\ntarget=");body=_zag_str_concat(body,zagd_hash_fields(target));body=_zag_str_concat(body,"\ngenerated=");body=_zag_str_concat(body,_zag_i64_to_str(generated.len));body=_zag_str_concat(body,"\nfinalists=");body=_zag_str_concat(body,_zag_i64_to_str(finalists.len));body=_zag_str_concat(body,"\n");
    let i:i32=0;while(i<finalists.len){let c:ZagdConcreteCandidate=finalists.data[i];body=_zag_str_concat(body,"candidate=");body=_zag_str_concat(body,_zag_i64_to_str(c.kind));body=_zag_str_concat(body,"\tautomatic=");body=_zag_str_concat(body,_zag_i64_to_str(c.automatic));body=_zag_str_concat(body,"\tprovenance=");body=_zag_str_concat(body,_zag_i64_to_str(c.provenance));body=_zag_str_concat(body,"\truntime_ns=");body=_zag_str_concat(body,_zag_i64_to_str(c.runtime_ns));body=_zag_str_concat(body,"\n");i=i+1;}
    let sum:ZagdHash=zagd_content_hash(body);let payload:[]u8=_zag_str_concat(body,_zag_str_concat("checksum_first=",_zag_str_concat(_zag_i64_to_str(sum.first),"\n")));let dir:[]u8=zagd_join_path(zagd_join_path(root,".zag-cache"),"zagd");return zagd_store_transaction(zagd_join_path(dir,"candidates.record.tmp"),zagd_join_path(dir,"candidates.record"),payload);
}
fn zagd_deep_control_path(root:[]u8,name:[]u8)[]u8{let value:[]u8=zagd_trim_line(_zag_read_file(zagd_join_path(root,name)));if(value.len==0){return "";}if(value[0]=='/'){return value;}return zagd_join_path(root,value);}
fn zagd_deep_value_safe(value:[]u8)i32{if(value.len==0){return 0;}let i:i32=0;while(i<value.len){if(value[i]=='\n'||value[i]=='\r'||value[i]=='\t'){return 0;}i=i+1;}return 1;}
fn zagd_deep_source_current(root:[]u8,view:SemanticManifestView)i32{let path:[]u8=view.module;if(path.len==0){return 0;}if(path[0]!='/'){path=zagd_join_path(root,path);}if(_zag_file_exists(path)==0){return 0;}return zagd_hash_equal(zagd_content_hash(_zag_read_file(path)),view.source);}
fn zagd_persist_deep_measurement(root:[]u8,view:SemanticManifestView,target:ZagdHash,reference:[]u8,finalist:[]u8,total_ms:i64,runs:i32)i32{if(zagd_deep_value_safe(reference)==0||zagd_deep_value_safe(finalist)==0){return 0;}let body:[]u8="format=zagd-deep-measurement-v1\nadvisory=true\nexecutable_authority=false\nmode=deep\nexplicit=true\nequivalence=exact-output-stderr-exit-signal-state\n";body=_zag_str_concat(body,_zag_str_concat("source=",_zag_str_concat(zagd_hash_fields(view.source),"\n")));body=_zag_str_concat(body,_zag_str_concat("target=",_zag_str_concat(zagd_hash_fields(target),"\n")));body=_zag_str_concat(body,_zag_str_concat("reference=",_zag_str_concat(reference,"\n")));body=_zag_str_concat(body,_zag_str_concat("finalist=",_zag_str_concat(finalist,"\n")));body=_zag_str_concat(body,_zag_str_concat("runs=",_zag_str_concat(_zag_i64_to_str(runs),"\n")));body=_zag_str_concat(body,_zag_str_concat("runtime_ms_mean=",_zag_str_concat(_zag_i64_to_str(total_ms/(runs as i64)),"\n")));let sum:ZagdHash=zagd_content_hash(body);let payload:[]u8=_zag_str_concat(body,_zag_str_concat("checksum_first=",_zag_str_concat(_zag_i64_to_str(sum.first),"\n")));let dir:[]u8=zagd_join_path(zagd_join_path(root,".zag-cache"),"zagd");return zagd_store_transaction(zagd_join_path(dir,"deep-measurement.record.tmp"),zagd_join_path(dir,"deep-measurement.record"),payload);}
fn zagd_execute_deep_controls(root:[]u8,mode:i32,view:SemanticManifestView,stop_path:[]u8)i32{
    let measurement_path:[]u8=zagd_join_path(zagd_join_path(zagd_join_path(root,".zag-cache"),"zagd"),"deep-measurement.record");zagd_unlink(measurement_path);
    if(mode!=zagd_mode_deep()||view.valid==0||zagd_deep_source_current(root,view)==0){return 0;}
    let reference:[]u8=zagd_deep_control_path(root,".zagd.deep-reference");let finalist:[]u8=zagd_deep_control_path(root,".zagd.deep-finalist");if(reference.len==0||finalist.len==0||_zag_file_exists(reference)==0||_zag_file_exists(finalist)==0){return 0;}
    let target:ZagdHash=zagd_content_hash("linux-x86_64-generic");let req:ZagdBenchmarkRequest=ZagdBenchmarkRequest{.explicit=1,.mode=mode,.finalists=1,.timeout_ms=1000,.max_memory=67108864,.source=view.source,.stable_source=view.source,.target=target,.active_target=target,.cancelled=0,.network=0,.gpu=0,.source_writes=0};let decision:ZagdBenchmarkDecision=zagd_benchmark_decide(req);if(decision.allowed==0){return 0;}
    let cancelled:i32=0;let total:i64=0;let run:i32=0;while(run<3){if(_zag_file_exists(stop_path)==1||zagd_deep_source_current(root,view)==0){cancelled=1;return 0;}let baseline:ZagdExecutionResult=zagd_execute_finalist(reference,1000,67108864,1048576,&cancelled);if(zagd_deep_source_current(root,view)==0){return 0;}let candidate:ZagdExecutionResult=zagd_execute_finalist(finalist,1000,67108864,1048576,&cancelled);if(zagd_measurement_may_persist(decision,baseline,candidate)==0){return 0;}total=total+candidate.elapsed_ms;run=run+1;}
    if(_zag_file_exists(stop_path)==1||zagd_deep_source_current(root,view)==0){return 0;}return zagd_persist_deep_measurement(root,view,target,zagd_relative(root,reference),zagd_relative(root,finalist),total,3);
}
fn zagd_cache_trim(root:[]u8,max_bytes:i64)i32{
    let dir:[]u8=zagd_join_path(zagd_join_path(root,".zag-cache"),"zagd");
    let snapshot:[]u8=zagd_join_path(dir,"snapshot.record");let plan:[]u8=zagd_join_path(dir,"plan.record");let semantic:[]u8=zagd_join_path(dir,"semantic.record");let artifact:[]u8=zagd_join_path(dir,"artifact.record");let candidates:[]u8=zagd_join_path(dir,"candidates.record");let incremental:[]u8=zagd_join_path(dir,"incremental.record");let measurement:[]u8=zagd_join_path(dir,"deep-measurement.record");let profile_plan:[]u8=zagd_join_path(dir,"profile-plan.record");
    let total:i64=0;if(_zag_file_exists(snapshot)==1){total=total+(_zag_read_file(snapshot).len as i64);}if(_zag_file_exists(plan)==1){total=total+(_zag_read_file(plan).len as i64);}if(_zag_file_exists(semantic)==1){total=total+(_zag_read_file(semantic).len as i64);}
    if(_zag_file_exists(artifact)==1){total=total+(_zag_read_file(artifact).len as i64);}if(_zag_file_exists(candidates)==1){total=total+(_zag_read_file(candidates).len as i64);}if(_zag_file_exists(incremental)==1){total=total+(_zag_read_file(incremental).len as i64);}if(_zag_file_exists(measurement)==1){total=total+(_zag_read_file(measurement).len as i64);}if(_zag_file_exists(profile_plan)==1){total=total+(_zag_read_file(profile_plan).len as i64);}if(total>max_bytes&&_zag_file_exists(measurement)==1){total=total-(_zag_read_file(measurement).len as i64);zagd_unlink(measurement);}if(total>max_bytes&&_zag_file_exists(profile_plan)==1){total=total-(_zag_read_file(profile_plan).len as i64);zagd_unlink(profile_plan);}if(total>max_bytes&&_zag_file_exists(candidates)==1){total=total-(_zag_read_file(candidates).len as i64);zagd_unlink(candidates);}if(total>max_bytes&&_zag_file_exists(artifact)==1){total=total-(_zag_read_file(artifact).len as i64);zagd_unlink(artifact);}if(total>max_bytes&&_zag_file_exists(plan)==1){total=total-(_zag_read_file(plan).len as i64);zagd_unlink(plan);}if(total>max_bytes&&_zag_file_exists(incremental)==1){total=total-(_zag_read_file(incremental).len as i64);zagd_unlink(incremental);}
    if(total>max_bytes&&_zag_file_exists(snapshot)==1){total=total-(_zag_read_file(snapshot).len as i64);zagd_unlink(snapshot);}
    if(total>max_bytes&&_zag_file_exists(semantic)==1){zagd_unlink(semantic);return 0;}return 1;
}
// Status uses the same bounded record set as eviction. This is measured at
// publication time, never guessed from a configured cap.
fn zagd_cache_bytes(root:[]u8)i64{let dir:[]u8=zagd_join_path(zagd_join_path(root,".zag-cache"),"zagd");let names:ArrayList[[]u8]=make[[]u8](8);push[[]u8](&names,"snapshot.record");push[[]u8](&names,"plan.record");push[[]u8](&names,"semantic.record");push[[]u8](&names,"artifact.record");push[[]u8](&names,"candidates.record");push[[]u8](&names,"incremental.record");push[[]u8](&names,"deep-measurement.record");push[[]u8](&names,"profile-plan.record");let total:i64=0;let i:i32=0;while(i<names.len){let path:[]u8=zagd_join_path(dir,names.data[i]);if(_zag_file_exists(path)==1){let bytes:[]u8=_zag_read_file(path);if(bytes.len>0){total=total+(bytes.len as i64);}}i=i+1;}return total;}
fn zagd_revalidate_index(records:ArrayList[ZagdFileState])i32{let i:i32=0;while(i<records.len){if(_zag_file_exists(records.data[i].path)==0){return 0;}let bytes:[]u8=_zag_read_file(records.data[i].path);if(zagd_hash_equal(zagd_content_hash(bytes),records.data[i].hash)==0){return 0;}i=i+1;}return 1;}
fn zagd_semantic_manifest(root:[]u8,path:[]u8)SemanticManifestView{let bad:SemanticManifestView=semantic_manifest_decode("");if(_zag_file_exists(path)==0){return bad;}let view:SemanticManifestView=semantic_manifest_decode(_zag_read_file(path));if(view.valid==0||zagd_index_path_safe(view.module)==0){return bad;}let source_path:[]u8=zagd_join_path(root,view.module);if(_zag_file_exists(source_path)==0||zagd_hash_equal(zagd_content_hash(_zag_read_file(source_path)),view.source)==0){return bad;}return view;}
fn zagd_seed_semantic_records(root:[]u8,text:[]u8,records:*ArrayList[ZagdFileState])void{let start:i32=0;let i:i32=0;while(i<=text.len){if(i==text.len||text[i]=='\n'){let line:[]u8=text[start..i];if(line.len>12&&@strEq(line[0..12],"module_node=")){let node:[]u8=line[12..];let tab:i32=0;while(tab<node.len&&node[tab]!='\t'){tab=tab+1;}if(tab<node.len){let name:[]u8=node[0..tab];let path:[]u8=name;if(name.len==0||name[0]!='/'){path=zagd_join_path(root,name);}if(_zag_file_exists(path)==1){let bytes:[]u8=_zag_read_file(path);let hash:ZagdHash=zagd_content_hash(bytes);if(zagd_hash_equal(hash,smf_hash(node[tab+1..]))==1){let facts:ZagdSourceFacts=zagd_source_facts(bytes);let _seed:i32=zagd_record_changed(records,path,hash,facts,1);}}}}start=i+1;}i=i+1;}}

fn zagd_parse_pid(value: []u8) i64 {
    let result: i64 = 0;
    let i: i32 = 0;
    while (i < value.len && value[i] >= '0' && value[i] <= '9') {
        result = result * 10 + ((value[i] as i64) - 48);
        i = i + 1;
    }
    return result;
}

fn zagd_claim_singleton(lock_path: []u8) i64 {
    let fd: i64 = zagd_open_lock(lock_path);
    if (fd >= 0) { return fd; }
    let prior: i64 = zagd_parse_pid(_zag_read_file(lock_path));
    if (prior < 2) { return 0 - 1; }
    if (zagd_pid_alive(prior) == 1) { return 0 - 1; }
    zagd_unlink(lock_path);
    return zagd_open_lock(lock_path);
}

fn zagd_watch_path(fd: i64, path: []u8, watches: *ArrayList[ZagdWatch]) i32 {
    let i: i32 = 0;
    while (i < watches.*.len) {
        if (@strEq(watches.*.data[i].path, path)) { return 1; }
        i = i + 1;
    }
    if (watches.*.len >= 4096) { return 0; }
    let wd: i64 = zagd_inotify_watch(fd, path);
    if (wd < 0) { return 0; }
    push[ZagdWatch](watches, ZagdWatch{ .wd = wd, .path = path });
    return 1;
}

fn zagd_scan_directories(fd: i64, root: []u8, watches: *ArrayList[ZagdWatch]) void {
    if (zagd_watch_path(fd, root, watches) == 0) { return; }
    let dirfd: i64 = zagd_open_directory(root);
    if (dirfd < 0) { return; }
    let entries: ArrayList[u8] = make[u8](4096);
    let scanning: i32 = 1;
    while (scanning == 1) {
        let nread: i64 = zagd_getdents(dirfd, &entries);
        if (nread <= 0) { scanning = 0; }
        else {
            let off: i32 = 0;
            while (off + 19 <= nread) {
                let reclen: i32 = zagd_u16_at(entries.data[0..nread as i32], off + 16);
                if (reclen < 19 || off + reclen > nread) { off = nread as i32; }
                else {
                    let dtype: i32 = entries.data[off + 18] as i32;
                    let name: []u8 = zagd_event_name(entries.data[0..nread as i32], off + 19, reclen - 19);
                    if (dtype == 4 && @strEq(name, ".") == 0 && @strEq(name, "..") == 0 && zagd_ignored_name(name) == 0) {
                        zagd_scan_directories(fd, zagd_join_path(root, name), watches);
                    }
                    off = off + reclen;
                }
            }
        }
    }
    zagd_close(dirfd);
}

fn zagd_watch_base(watches: *ArrayList[ZagdWatch], wd: i64) []u8 {
    let i: i32 = 0;
    while (i < watches.*.len) {
        if (watches.*.data[i].wd == wd) { return watches.*.data[i].path; }
        i = i + 1;
    }
    return "";
}

fn zagd_record_changed(records: *ArrayList[ZagdFileState], path: []u8,
        hash: ZagdHash, facts:ZagdSourceFacts, exists: i32) i32 {
    let i: i32 = 0;
    while (i < records.*.len) {
        if (@strEq(records.*.data[i].path, path)) {
            if (records.*.data[i].exists == exists && zagd_hash_equal(records.*.data[i].hash, hash) == 1) { return 0-1; }
            let classification:i32=zagd_change_unknown();
            if(records.*.data[i].exists==1&&exists==1){classification=zagd_classify_sources(records.*.data[i].facts,facts,0);}
            records.*.data[i].hash = hash;
            records.*.data[i].facts = facts;
            records.*.data[i].exists = exists;
            return classification;
        }
        i = i + 1;
    }
    push[ZagdFileState](records, ZagdFileState{ .path = path, .hash = hash, .facts=facts, .exists = exists });
    return zagd_change_unknown();
}

fn zagd_change_name(change:i32)[]u8{if(change==zagd_change_none()){return "none";}if(change==zagd_change_nonsemantic()){return "nonsemantic";}if(change==zagd_change_private_body()){return "private-body";}if(change==zagd_change_public_shape()){return "public-shape";}if(change==zagd_change_root_profile()){return "root-profile";}if(change==zagd_change_target_profile()){return "target-profile";}return "unknown";}

fn zagd_mode_name(mode: i32) []u8 {
    if (mode == zagd_mode_off()) { return "off"; }
    if (mode == zagd_mode_adaptive()) { return "adaptive"; }
    if (mode == zagd_mode_deep()) { return "deep"; }
    return "light";
}

fn zagd_parse_mode(value: []u8) i32 {
    if (@strEq(value, "off")) { return zagd_mode_off(); }
    if (@strEq(value, "adaptive")) { return zagd_mode_adaptive(); }
    if (@strEq(value, "deep")) { return zagd_mode_deep(); }
    if (@strEq(value, "light")) { return zagd_mode_light(); }
    return 0 - 1;
}

fn zagd_parse_window(value: []u8) i64 {
    if (value.len == 0) { return 0 - 1; }
    let result: i64 = 0;
    let i: i32 = 0;
    while (i < value.len) {
        let c: u8 = value[i];
        if (c < '0' || c > '9') { return 0 - 1; }
        result = result * 10 + ((c as i64) - 48);
        if (result > 60000) { return 0 - 1; }
        i = i + 1;
    }
    if (result < 1) { return 0 - 1; }
    return result;
}

fn zagd_status_text(pid: i64, mode: i32, state: []u8, file: []u8,
        hash: ZagdHash, events: i64, snapshot:ZagdSnapshot, change:i32, cache_reused:i32, incremental_reused:i32, incremental_change:i32, semantic:SemanticManifestView, dependents:i32, affected_decls:i32, plan:ZagdPlannerRun) []u8 {
    let out: []u8 = "version=1\n";
    out = _zag_str_concat(out, _zag_str_concat("pid=", _zag_str_concat(_zag_i64_to_str(pid), "\n")));
    out = _zag_str_concat(out, _zag_str_concat("mode=", _zag_str_concat(zagd_mode_name(mode), "\n")));
    out = _zag_str_concat(out, _zag_str_concat("state=", _zag_str_concat(state, "\n")));
    out = _zag_str_concat(out, "singleton=true\nnetwork=false\ngpu_background=false\n");
    if(cache_reused==1){out=_zag_str_concat(out,"cache_reused=true\n");}else{out=_zag_str_concat(out,"cache_reused=false\n");}
    if(incremental_reused==1){out=_zag_str_concat(out,"incremental_cache_reused=true\n");}else{out=_zag_str_concat(out,"incremental_cache_reused=false\n");}out=_zag_str_concat(out,_zag_str_concat("incremental_invalidation=",_zag_str_concat(zagd_change_name(incremental_change),"\n")));
    if(semantic.valid==1){out=_zag_str_concat(out,"semantic_manifest=true\n");out=_zag_str_concat(out,_zag_str_concat("semantic_public_first=",_zag_str_concat(_zag_i64_to_str(semantic.public_identity.first),"\n")));out=_zag_str_concat(out,_zag_str_concat("semantic_effects_first=",_zag_str_concat(_zag_i64_to_str(semantic.effect_identity.first),"\n")));out=_zag_str_concat(out,_zag_str_concat("semantic_layouts_first=",_zag_str_concat(_zag_i64_to_str(semantic.layout_identity.first),"\n")));}else{out=_zag_str_concat(out,"semantic_manifest=false\n");}
    out = _zag_str_concat(out, _zag_str_concat("events=", _zag_str_concat(_zag_i64_to_str(events), "\n")));
    out = _zag_str_concat(out, _zag_str_concat("last_change=", _zag_str_concat(zagd_change_name(change), "\n")));
    out = _zag_str_concat(out,_zag_str_concat("affected_dependents=",_zag_str_concat(_zag_i64_to_str(dependents),"\n")));
    out = _zag_str_concat(out,_zag_str_concat("affected_declarations=",_zag_str_concat(_zag_i64_to_str(affected_decls),"\n")));
    out=_zag_str_concat(out,_zag_str_concat("planner_budget=",_zag_str_concat(_zag_i64_to_str(plan.budget),"\n")));out=_zag_str_concat(out,_zag_str_concat("planner_evaluated=",_zag_str_concat(_zag_i64_to_str(plan.evaluated),"\n")));out=_zag_str_concat(out,_zag_str_concat("planner_suggestions=",_zag_str_concat(_zag_i64_to_str(plan.suggestions),"\n")));if(plan.cancelled==1){out=_zag_str_concat(out,"planner_state=cancelled\n");}else if(plan.complete==1){out=_zag_str_concat(out,"planner_state=complete\n");}else{out=_zag_str_concat(out,"planner_state=running\n");}
    out = _zag_str_concat(out, _zag_str_concat("last_file=", _zag_str_concat(file, "\n")));
    out = _zag_str_concat(out, _zag_str_concat("content_hash_first=", _zag_str_concat(_zag_i64_to_str(hash.first), "\n")));
    out = _zag_str_concat(out, _zag_str_concat("content_hash_second=", _zag_str_concat(_zag_i64_to_str(hash.second), "\n")));
    out = _zag_str_concat(out, _zag_str_concat("snapshot_first=", _zag_str_concat(_zag_i64_to_str(snapshot.identity.first), "\n")));
    out = _zag_str_concat(out, _zag_str_concat("snapshot_second=", _zag_str_concat(_zag_i64_to_str(snapshot.identity.second), "\n")));
    out = _zag_str_concat(out, _zag_str_concat("snapshot_parent_first=", _zag_str_concat(_zag_i64_to_str(snapshot.parent.first), "\n")));
    out = _zag_str_concat(out, _zag_str_concat("snapshot_file_count=", _zag_str_concat(_zag_i64_to_str(snapshot.file_count), "\n")));
    return out;
}

fn zagd_write_status(path: []u8, pid: i64, mode: i32, state: []u8,
        file: []u8, hash: ZagdHash, events: i64, snapshot:ZagdSnapshot, change:i32, cache_reused:i32, incremental_reused:i32, incremental_change:i32, semantic:SemanticManifestView, dependents:i32, affected_decls:i32, plan:ZagdPlannerRun) i32 {
    let slash:i32=0-1;let i:i32=0;while(i<path.len){if(path[i]=='/'){slash=i;}i=i+1;}let root:[]u8=".";if(slash>0){root=path[0..slash];}let status:[]u8=zagd_status_text(pid, mode, state, file, hash, events,snapshot,change,cache_reused,incremental_reused,incremental_change,semantic,dependents,affected_decls,plan);status=_zag_str_concat(status,"watcher=inotify\n");if(@strEq(state,"error-inotify-init")||@strEq(state,"error-inotify-watch")){status=_zag_str_concat(status,"watcher_health=error\n");}else{status=_zag_str_concat(status,"watcher_health=ok\n");}status=_zag_str_concat(status,_zag_str_concat("cache_bytes=",_zag_str_concat(_zag_i64_to_str(zagd_cache_bytes(root)),"\n")));return _zag_write_file(path,status);
}

fn zagd_run(root: []u8, root_source:[]u8, mode: i32, window_ms: i64,max_cache_bytes:i64) i32 {
    zagd_set_low_priority();
    let status_path: []u8 = zagd_join_path(root, ".zagd.status");
    let stop_path: []u8 = zagd_join_path(root, ".zagd.stop");
    let lock_path: []u8 = zagd_join_path(root, ".zagd.lock");
    let pid: i64 = zagd_pid();
    let empty: ZagdHash = zagd_content_hash("");
    let snapshot: ZagdSnapshot = zagd_make_snapshot(empty, empty, zagd_content_hash(root), 0, 1);
    let cache_reused:i32=0;
    let incremental_reused:i32=0;let incremental_change:i32=zagd_change_unknown();let incremental_index:ZagdIncrementalIndex=zi_index_bad();
    let records: ArrayList[ZagdFileState] = make[ZagdFileState](32);
    let snapshot_path:[]u8=zagd_join_path(zagd_join_path(zagd_join_path(root,".zag-cache"),"zagd"),"snapshot.record");
    let semantic_path:[]u8=zagd_join_path(zagd_join_path(zagd_join_path(root,".zag-cache"),"zagd"),"semantic.record");
    let incremental_path:[]u8=zagd_incremental_path(root);if(_zag_file_exists(incremental_path)==1){incremental_index=zagd_incremental_index_decode(_zag_read_file(incremental_path));if(incremental_index.valid==1&&zagd_incremental_index_reused(incremental_index)==1){incremental_reused=1;incremental_change=zagd_change_none();}else{incremental_index=zi_index_bad();}}
    let semantic_text:[]u8=_zag_read_file(semantic_path);
    let semantic:SemanticManifestView=zagd_semantic_manifest(root,semantic_path);
    let affected_dependents:i32=0;
    let affected_declarations:i32=0;
    let planner_run:ZagdPlannerRun=zagd_planner_start(mode,256);zagd_planner_step(&planner_run,semantic_manifest_decl_count(semantic_text),0);
    zagd_planner_accept_constants(&planner_run,semantic_manifest_constant_count(semantic_text));
    let _initial_plan:i32=zagd_persist_plan(root,mode,semantic,planner_run);
    let initial_inv:SemanticInvalidation=SemanticInvalidation{.semantic_changed=1,.declaration_dependents=semantic_manifest_decl_count(semantic_text),.layout_changed=1,.codegen_invalidated=1,.comment_only=0};let _initial_artifacts:i32=zagd_persist_artifacts(root,semantic_text,initial_inv);
    let _initial_candidates:i32=zagd_persist_candidates(root,semantic_text,mode);
    if(zagd_cache_trim(root,max_cache_bytes)==0){semantic.valid=0;}
    if(_zag_file_exists(snapshot_path)==1){let saved:[]u8=_zag_read_file(snapshot_path);let restored:ZagdSnapshotRecord=zagd_snapshot_record_compatible(saved,zag_version(),"linux-x86_64-generic",zagd_mode_name(mode));if(restored.valid==1&&zagd_restore_index(root,saved,&records)==restored.file_count&&zagd_revalidate_index(records)==1){snapshot.identity=restored.identity;snapshot.parent=restored.parent;snapshot.file_count=restored.file_count;cache_reused=1;}else{records.len=0;}}
    if(semantic.valid==1){zagd_seed_semantic_records(root,semantic_text,&records);}

    if (mode == zagd_mode_off()) {
        if (_zag_file_exists(lock_path) == 1) {
            let owner:i64=zagd_parse_pid(_zag_read_file(lock_path));
            if(owner<2||zagd_pid_alive(owner)==0){zagd_unlink(lock_path);}
            else {
                let _stop_write: i32 = _zag_write_file(stop_path, "stop\n");
                let waits: i32 = 0;
                while (waits < 2000 && _zag_file_exists(lock_path) == 1) {
                    zagd_sleep_ms(1);
                    waits = waits + 1;
                }
                if (_zag_file_exists(lock_path) == 1) {
                    _zag_eprintln("zagd: active daemon did not stop before timeout");
                    return 7;
                }
            }
        }
        let _wr: i32 = zagd_write_status(status_path, pid, mode, "stopped", "", empty, 0, snapshot,zagd_change_none(),cache_reused,incremental_reused,incremental_change,semantic,affected_dependents,affected_declarations,planner_run);
        return 0;
    }

    zagd_unlink(stop_path);

    let lock_fd: i64 = zagd_claim_singleton(lock_path);
    if (lock_fd < 0) {
        _zag_eprintln("zagd: project already has an active or starting daemon");
        return 6;
    }
    let _lock_write: i32 = _zag_write_file(lock_path, _zag_i64_to_str(pid));
    // Finalists run only after this daemon owns the project singleton.
    let _initial_deep:i32=zagd_execute_deep_controls(root,mode,semantic,stop_path);

    let fd: i64 = zagd_inotify_open();
    if (fd < 0) {
        zagd_close(lock_fd); zagd_unlink(lock_path);
        let _wr: i32 = zagd_write_status(status_path, pid, mode, "error-inotify-init", "", empty, 0, snapshot,zagd_change_none(),cache_reused,incremental_reused,incremental_change,semantic,affected_dependents,affected_declarations,planner_run);
        return 2;
    }
    let watches: ArrayList[ZagdWatch] = make[ZagdWatch](16);
    zagd_scan_directories(fd, root, &watches);
    if (watches.len == 0) {
        zagd_close(fd);
        zagd_close(lock_fd); zagd_unlink(lock_path);
        let _wr: i32 = zagd_write_status(status_path, pid, mode, "error-inotify-watch", "", empty, 0, snapshot,zagd_change_none(),cache_reused,incremental_reused,incremental_change,semantic,affected_dependents,affected_declarations,planner_run);
        return 3;
    }

    let _wr0: i32 = zagd_write_status(status_path, pid, mode, "idle", "", empty, 0, snapshot,zagd_change_none(),cache_reused,incremental_reused,incremental_change,semantic,affected_dependents,affected_declarations,planner_run);
    let buffer: ArrayList[u8] = make[u8](4096);
    let running: i32 = 1;
    let event_count: i64 = 0;
    while (running == 1) {
        // Blocking inotify read: unchanged projects consume no polling CPU.
        let nread: i64 = zagd_read_events(fd, &buffer);
        if (nread < 0) {
            running = 0;
        } else {
            let off: i32 = 0;
            while (off + 16 <= nread) {
                let event_wd: i64 = zagd_u32_at(buffer.data[0..nread as i32], off);
                let mask: i64 = zagd_u32_at(buffer.data[0..nread as i32], off + 4);
                let name_len: i32 = zagd_u32_at(buffer.data[0..nread as i32], off + 12) as i32;
                if (off + 16 + name_len > nread) {
                    off = nread as i32;
                } else {
                    let name: []u8 = zagd_event_name(buffer.data[0..nread as i32], off + 16, name_len);
                    if (@strEq(name, ".zagd.stop")) {
                        running = 0;
                    } else if(@strEq(name,".zagd.semantic-ready")){
                        zagd_sleep_ms(window_ms);let next_text:[]u8=_zag_read_file(semantic_path);let next_semantic:SemanticManifestView=zagd_semantic_manifest(root,semantic_path);if(next_semantic.valid==1){let artifact_inv:SemanticInvalidation=semantic_manifest_invalidation(semantic_text,next_text);affected_declarations=artifact_inv.declaration_dependents;semantic_text=next_text;semantic=next_semantic;zagd_planner_step(&planner_run,0,1);planner_run=zagd_planner_start(mode,256);zagd_planner_step(&planner_run,semantic_manifest_decl_count(semantic_text),0);zagd_planner_accept_constants(&planner_run,semantic_manifest_constant_count(semantic_text));let _plan_write:i32=zagd_persist_plan(root,mode,semantic,planner_run);let _artifact_write:i32=zagd_persist_artifacts(root,semantic_text,artifact_inv);let _candidate_write:i32=zagd_persist_candidates(root,semantic_text,mode);let _deep_write:i32=zagd_execute_deep_controls(root,mode,semantic,stop_path);if(zagd_cache_trim(root,max_cache_bytes)==0){semantic.valid=0;}event_count=event_count+1;let _ready_status:i32=zagd_write_status(status_path,pid,mode,"idle",".zagd.semantic-ready",zagd_content_hash(next_text),event_count,snapshot,zagd_change_none(),cache_reused,incremental_reused,incremental_change,semantic,0,affected_declarations,planner_run);}zagd_unlink(zagd_join_path(root,".zagd.semantic-ready"));
                    // The watcher may observe every filesystem write in the
                    // project tree. Planner analysis is source-driven: never
                    // hash or parse compiler binaries, object files, editor
                    // databases, or other arbitrary payloads merely because
                    // they share a watched directory.
                    } else if (zagd_ignored_name(name) == 0 && zagd_has_suffix(name, ".zag") == 1) {
                        let base: []u8 = zagd_watch_base(&watches, event_wd);
                        let full: []u8 = zagd_join_path(base, name);
                        if (zagd_mask_has(mask, zagd_in_isdir()) == 1 &&
                            (zagd_mask_has(mask, zagd_in_create()) == 1 || zagd_mask_has(mask, zagd_in_moved_to()) == 1)) {
                            zagd_scan_directories(fd, full, &watches);
                        }
                        // Events are hints. Wait, then read the complete file and
                        // derive identity from bytes rather than metadata.
                        zagd_sleep_ms(window_ms);
                        let exists: i32 = _zag_file_exists(full);
                        let hash: ZagdHash = empty;
                        let facts:ZagdSourceFacts=zagd_source_facts("");
                        if (exists == 1) {
                            let bytes: []u8 = _zag_read_file(full);
                            if (bytes.len >= 0) {
                                hash = zagd_content_hash(bytes);facts=zagd_source_facts(bytes);
                                // Coalesce queued partial/atomic saves by requiring
                                // bounded content stability, not merely one event delay.
                                let stable_tries:i32=0;let stable:i32=0;
                                while(stable==0&&stable_tries<4){zagd_sleep_ms(window_ms);let again:[]u8=_zag_read_file(full);let again_hash:ZagdHash=zagd_content_hash(again);if(zagd_hash_equal(hash,again_hash)==1){stable=1;}else{hash=again_hash;facts=zagd_source_facts(again);}stable_tries=stable_tries+1;}
                            }
                        }
                        let change:i32=zagd_record_changed(&records, full, hash,facts, exists);
                        if (change >= 0) {
                            zagd_planner_step(&planner_run,0,1);planner_run=zagd_planner_start(mode,256);zagd_planner_step(&planner_run,0,0);
                            let relative_changed:[]u8=zagd_relative(root,full);affected_dependents=0;if(change==zagd_change_public_shape()){affected_dependents=semantic_manifest_transitive_dependents(semantic_text,full);if(affected_dependents==0){affected_dependents=semantic_manifest_transitive_dependents(semantic_text,relative_changed);}}
                            if(semantic.valid==1&&(semantic_manifest_module_stale(semantic_text,full,hash)==1||semantic_manifest_module_stale(semantic_text,relative_changed,hash)==1)){semantic.valid=0;}
                            if(semantic.valid==1&&@strEq(full,zagd_join_path(root,semantic.module))&&zagd_hash_equal(hash,semantic.source)==0){semantic.valid=0;}
                            if(zagd_is_zag_source(full)==1){
                                let checked:i32=zagd_semantic_check(root,root_source,semantic_path);
                                if(checked==1){let checked_text:[]u8=_zag_read_file(semantic_path);let checked_view:SemanticManifestView=zagd_semantic_manifest(root,semantic_path);if(checked_view.valid==1){semantic_text=checked_text;semantic=checked_view;}}
                                else{semantic.valid=0;}
                                zagd_unlink(zagd_join_path(root,".zagd.semantic-ready"));
                            }
                            event_count = event_count + 1;
                            let prior:ZagdHash=snapshot.identity;
                            snapshot=zagd_snapshot_records(root,records,prior);
                            let _cache_write:i32=zagd_persist_snapshot(root,mode,snapshot,records);
                            if(exists==1&&facts.valid==1){let stable_source:[]u8=_zag_read_file(full);let current_incremental:ZagdIncrementalFile=zagd_incremental_file(full,stable_source,facts);let previous_incremental:ZagdIncrementalFile=zagd_incremental_index_get(incremental_index,full);let decision:ZagdIncrementalDecision=zagd_incremental_decide(previous_incremental,current_incremental);incremental_change=decision.change;if(incremental_change==zagd_change_unknown()){incremental_change=change;}incremental_reused=decision.reuse_parse;zagd_incremental_index_put(&incremental_index,current_incremental);incremental_index.valid=1;incremental_index.advisory=1;incremental_index.executable_authority=0;let _incremental_write:i32=zagd_persist_incremental(root,incremental_index);}else{incremental_change=zagd_change_unknown();incremental_reused=0;}
                            if(zagd_cache_trim(root,max_cache_bytes)==0){semantic.valid=0;}
                            let _wr: i32 = zagd_write_status(status_path, pid, mode,
                                "idle", full, hash, event_count, snapshot,change,cache_reused,incremental_reused,incremental_change,semantic,affected_dependents,affected_declarations,planner_run);
                        }
                    }
                    off = off + 16 + name_len;
                }
            }
        }
    }
    zagd_close(fd);
    zagd_close(lock_fd);
    zagd_unlink(lock_path);
    zagd_unlink(stop_path);
    let _wr1: i32 = zagd_write_status(status_path, pid, mode, "stopped", "", empty, event_count, snapshot,zagd_change_none(),cache_reused,incremental_reused,incremental_change,semantic,affected_dependents,affected_declarations,planner_run);
    return 0;
}

fn main() i32 {
    let root: []u8 = ".";
    let root_source:[]u8="";
    let mode: i32 = zagd_mode_light();
    let window_ms: i64 = 75;
    let daemonize: i32 = 0;
    let max_cache_bytes:i64=2147483648;
    let max_workers:i32=1;
    let notifications:[]u8="errors_only";
    let i: i32 = 1;
    while (i < _zag_argc()) {
        let arg: []u8 = _zag_arg(i);
        if (@strEq(arg, "--daemonize")) { daemonize = 1; }
        else if (@strEq(arg, "--root") && i + 1 < _zag_argc()) { i = i + 1; root = _zag_arg(i); }
        else if (@strEq(arg, "--root-source") && i + 1 < _zag_argc()) { i=i+1;root_source=_zag_arg(i); }
        else if (@strEq(arg, "--mode") && i + 1 < _zag_argc()) {
            i = i + 1;
            mode = zagd_parse_mode(_zag_arg(i));
            if (mode < 0) { _zag_eprintln("zagd: mode must be off, light, adaptive, or deep"); return 4; }
        }
        else if (@strEq(arg, "--window-ms") && i + 1 < _zag_argc()) {
            i = i + 1;
            window_ms = zagd_parse_window(_zag_arg(i));
            if (window_ms < 0) { _zag_eprintln("zagd: --window-ms must be 1..60000"); return 4; }
        }
        else if (@strEq(arg,"--max-cache-bytes") && i+1<_zag_argc()) {
            i=i+1;max_cache_bytes=zagd_parse_nonnegative(_zag_arg(i));
            if(max_cache_bytes<1048576||max_cache_bytes>2147483648){_zag_eprintln("zagd: --max-cache-bytes must be 1048576..2147483648");return 4;}
        }
        else if (@strEq(arg,"--max-workers") && i+1<_zag_argc()) {
            i=i+1;let workers:i64=zagd_parse_nonnegative(_zag_arg(i));
            if(workers!=1){_zag_eprintln("zagd: this build supports exactly one quiet worker");return 4;}max_workers=1;
        }
        else if (@strEq(arg,"--notifications") && i+1<_zag_argc()) {
            i=i+1;notifications=_zag_arg(i);
            if(@strEq(notifications,"errors_only")==0){_zag_eprintln("zagd: this build supports --notifications errors_only");return 4;}
        }
        i = i + 1;
    }
    if (daemonize == 1) {
        let child: i64 = zagd_fork();
        if (child < 0) { _zag_eprintln("zagd: fork failed"); return 5; }
        if (child > 0) {
            // Do not report successful auto-start until the child owns the
            // project lock. O_EXCL in the child arbitrates concurrent starters.
            let lock_path: []u8 = zagd_join_path(root, ".zagd.lock");
            let tries: i32 = 0;
            while (tries < 100 && _zag_file_exists(lock_path) == 0) {
                zagd_sleep_ms(1);
                tries = tries + 1;
            }
            if (_zag_file_exists(lock_path) == 0) {
                _zag_eprintln("zagd: child did not acquire project singleton");
                return 6;
            }
            _zag_println(_zag_i64_to_str(child));
            return 0;
        }
        zagd_close(0); zagd_close(1); zagd_close(2);
    }
    return zagd_run(root, root_source, mode, window_ms,max_cache_bytes);
}
