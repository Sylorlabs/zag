@import("parse.zag")
@import("sema.zag")
@import("semantic_manifest.zag")
@import("semantic_manifest_publish.zag")

fn graph_test(ok:i32,label:[]u8,failures:*i32)void{
    if(ok!=0){_zag_print("ok  ");_zag_println(label);}
    else{_zag_print("FAIL ");_zag_println(label);failures.*=failures.*+1;}
}

fn main()i32{
    let failures:i32=0;
    let source:[]u8="pub fn answer() i32 { return 42; }";
    let unit:CompilationUnit=parse_compilation_unit_dir(source,".");
    let effects:map.StringMap[i32]=analyze(unit.decls);
    unit.registry_graph_edges="root\tdep\t^1.0.0";
    unit.registry_graph_complete=1;
    let valid_text:[]u8=smp_bounded_manifest(".","app.zag",source,unit,effects);
    let valid_view:SemanticManifestView=semantic_manifest_decode(valid_text);
    unit.registry_graph_edges="root\tdep\t^2.0.0";
    let changed_text:[]u8=smp_bounded_manifest(".","app.zag",source,unit,effects);
    let changed_view:SemanticManifestView=semantic_manifest_decode(changed_text);
    graph_test(valid_view.valid==1&&valid_view.graph_complete==1&&
        sm_text_has(valid_text,"registry_graph_edge=root\tdep\t^1.0.0\n"),
        "valid registry graph edge is emitted in the checked manifest",&failures);
    graph_test(zagd_hash_equal(valid_view.graph_identity,changed_view.graph_identity)==0&&
        sm_text_has(changed_text,"registry_graph_edge=root\tdep\t^2.0.0\n"),
        "registry requirement mutation changes semantic graph identity",&failures);

    let malformed:*SemanticManifest=semantic_manifest_build_published_with_registry_graph(
        "app.zag",source,unit.profile,unit.decls,effects,unit.modules,unit.imports,
        unit.resources,"", "", "root\tdep\tinvalid",1);
    let incomplete:*SemanticManifest=semantic_manifest_build_published_with_registry_graph(
        "app.zag",source,unit.profile,unit.decls,effects,unit.modules,unit.imports,
        unit.resources,"", "", "root\tdep\t^1.0.0",0);
    graph_test(semantic_manifest_decode(malformed.*.text).valid==1&&
        semantic_manifest_decode(malformed.*.text).graph_complete==0&&
        sm_text_has(malformed.*.text,"registry_graph_edge=")==0,
        "malformed registry graph fails closed without partial records",&failures);
    graph_test(semantic_manifest_decode(incomplete.*.text).graph_complete==0,
        "parser-incomplete registry graph fails closed",&failures);
    if(failures==0){_zag_println("semantic manifest registry graph: 4/4");}
    return failures;
}
