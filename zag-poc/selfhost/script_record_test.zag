@import("parse.zag")
@import("typed.zag")
@import("fmt.zag")

fn main()i32{
    if(_zag_argc()>1){
        let source:[]u8=_zag_read_file(_zag_arg(1));
        let declarations:ArrayList[*Node]=parse_program(source);
        if(zt_check_expressions(declarations)!=0){return 1;}
        let output:ArrayList[u8]=make[u8](256);let i:i32=0;
        while(i<declarations.len){fmt_decl(&output,declarations.data[i]);i=i+1;}
        _zag_print(output.data[0..output.len]);return 0;
    }
    return 1;
}
