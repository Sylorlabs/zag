@import("zagd_generation.zag")
@import("version.zag")

fn main() i32 {
    if (_zag_argc() != 2) {
        _zag_eprintln("zagd verifier approval fixture: expected state root");
        return 2;
    }
    let root: []u8 = _zag_arg(1);
    let compiler: []u8 = zag_version();
    let base: ZagdGenerationRegistry = zagd_generation_initialize_stable(root, compiler);
    if (base.record_valid != 1 || base.execution_enabled != 0) { return 3; }
    let candidate_text: []u8 = zagd_generation_manifest_encode(compiler,
        base.selected, zagd_content_hash("reviewed-search-policy-v1"));
    let candidate: ZagdGenerationManifest = zagd_generation_manifest_decode(candidate_text);
    if (candidate.valid != 1 ||
        zagd_generation_install_manifest(root, candidate_text) == 0) { return 4; }
    let pointers: ZagdGenerationPointers = ZagdGenerationPointers{
        .current = candidate.identity, .last_known_good = base.selected, .valid = 1 };
    let canary: ZagdGenerationCanary = ZagdGenerationCanary{
        .generation = candidate.identity, .predecessor = base.selected,
        .successes = 0, .failures = 0, .consecutive_crashes = 0,
        .required_successes = zagd_generation_required_successes(),
        .session_clean = 1, .quarantined = 0, .valid = 1 };
    if (zagd_generation_persist(root, pointers, canary) == 0) { return 5; }
    let loaded: ZagdGenerationRegistry = zagd_generation_load(root, compiler);
    if (loaded.record_valid != 1 || zagd_hash_equal(loaded.selected, candidate.identity) == 0 ||
        loaded.execution_enabled != 0) { return 6; }
    let approval: []u8 = zagd_generation_approval_encode(compiler, candidate.identity);
    let decoded: ZagdGenerationApproval = zagd_generation_approval_decode(approval);
    if (decoded.valid != 1 || decoded.independent != 0 || decoded.execution_enabled != 0 ||
        zagd_hash_equal(decoded.generation, candidate.identity) == 0) { return 7; }
    let forged: []u8 = _zag_str_concat(approval, "forged");
    if (zagd_generation_approval_decode(forged).valid != 0) { return 8; }
    let truncated: []u8 = approval[0..approval.len - 1];
    if (zagd_generation_approval_decode(truncated).valid != 0) { return 9; }
    if (zagd_generation_approve(root, compiler, candidate.identity) == 0) { return 10; }
    let approval_path:[]u8=zagd_generation_approval_path(root);
    let approval_read:ZagdGenerationRead=zagd_generation_read_bounded(approval_path,4096);
    let approval_disk:ZagdGenerationApproval=zagd_generation_approval_decode(approval_read.text);
    zagd_generation_read_free(approval_read);zagd_text_free(approval_path);
    if (approval_disk.valid != 1 || approval_disk.execution_enabled != 0 ||
        approval_disk.independent != 0) { return 11; }
    let identity_text:[]u8=_zag_str_concat(_zag_i64_to_str(candidate.identity.first),
        _zag_str_concat(":",_zag_str_concat(_zag_i64_to_str(candidate.identity.second),
        _zag_str_concat(":",_zag_i64_to_str(candidate.identity.bytes)))));
    let parsed_identity:ZagdHash=zagd_generation_hash_parse(identity_text);
    if (zagd_hash_equal(parsed_identity,candidate.identity)==0 ||
        zagd_generation_hash_valid(zagd_generation_hash_parse("1:2:3:4")) != 0) { return 12; }
    _zag_print(_zag_i64_to_str(candidate.identity.first));_zag_print(":");
    _zag_print(_zag_i64_to_str(candidate.identity.second));_zag_print(":");
    _zag_println(_zag_i64_to_str(candidate.identity.bytes));
    return 0;
}
