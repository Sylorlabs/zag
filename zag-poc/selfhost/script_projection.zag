// Structural three-way projection for promoted ZagScript source.
//
// Generation 2 supports multiple separated edited regions when each region is
// bounded by uniquely occurring unchanged line anchors. This covers ordinary
// edits to several preserved source statements while still rejecting
// generated-wrapper edits, duplicate/ambiguous source contexts, and edits
// whose boundaries cannot be mapped without guessing. The caller retains the
// original compact and baseline-derived bytes in the portable ledger.

struct ZsProjection {
    ok: i32,
    compact: []u8,
    conflict_start: i32,
    conflict_end: i32,
    reason: []u8,
}

fn zsp_find_from(text:[]u8,needle:[]u8,start:i32)i32{
    if(needle.len==0){return 0-1;}
    let i:i32=start;
    while(i+needle.len<=text.len){if(@strEq(text[i..i+needle.len],needle)){return i;}i=i+1;}
    return 0-1;
}

fn zsp_unique_at(text:[]u8,needle:[]u8)i32{
    let first:i32=zsp_find_from(text,needle,0);
    if(first<0){return 0-1;}
    if(zsp_find_from(text,needle,first+1)>=0){return 0-2;}
    return first;
}

fn zsp_line_start(text:[]u8,at:i32)i32{
    let i:i32=at;if(i>text.len){i=text.len;}
    while(i>0&&text[i-1]!=10){i=i-1;}return i;
}

fn zsp_line_end(text:[]u8,at:i32)i32{
    let i:i32=at;if(i<0){i=0;}
    while(i<text.len&&text[i]!=10){i=i+1;}
    if(i<text.len){i=i+1;}return i;
}

fn zsp_conflict(start:i32,end:i32,reason:[]u8)ZsProjection;

// The ordinary prefix/suffix projector deliberately refuses source moves:
// without an origin map, a repeated line could be attached to the wrong
// compact statement.  This bounded helper admits only a stricter, line-level
// reorder proof.  Every compact line must be unique and present exactly once
// in both snapshots; every non-compact (generated) line must remain in the
// same relative sequence; and the edited source lines must be a permutation
// rather than changed text.  Thus no generated bytes or ambiguous occurrence
// can be projected into human-owned compact source.
fn zsp_line_count(text:[]u8)i32{
    let count:i32=0;let start:i32=0;let i:i32=0;
    while(i<text.len){if(text[i]==10){count=count+1;start=i+1;}i=i+1;}
    if(start<text.len){count=count+1;}return count;
}

fn zsp_line_at(text:[]u8,want:i32)[]u8{
    if(want<0){return "";}
    let line:i32=0;let start:i32=0;let i:i32=0;
    while(i<text.len){
        if(text[i]==10){
            if(line==want){let end:i32=i;if(end>start&&text[end-1]==13){end=end-1;}
                return text[start..end];}
            line=line+1;start=i+1;
        }
        i=i+1;
    }
    if(start<text.len&&line==want){let end:i32=text.len;if(end>start&&text[end-1]==13){end=end-1;}
        return text[start..end];}
    return "";
}

fn zsp_line_has_cr(text:[]u8)i32{
    let i:i32=0;while(i<text.len){if(text[i]==13){return 1;}i=i+1;}return 0;
}

fn zsp_line_occurrences(text:[]u8,needle:[]u8)i32{
    let count:i32=0;let i:i32=0;let lines:i32=zsp_line_count(text);
    while(i<lines){if(@strEq(zsp_line_at(text,i),needle)){count=count+1;}i=i+1;}
    return count;
}

// Return the compact line ordinal, -1 for a generated/unknown line, and -2
// when the compact source itself contains the line more than once.
fn zsp_compact_line_id(compact:[]u8,line:[]u8)i32{
    let found:i32=0-1;let i:i32=0;let lines:i32=zsp_line_count(compact);
    while(i<lines){if(@strEq(zsp_line_at(compact,i),line)){
        if(found>=0){return 0-2;}found=i;}
        i=i+1;}
    return found;
}

fn zsp_generated_count(text:[]u8,compact:[]u8)i32{
    let count:i32=0;let i:i32=0;let lines:i32=zsp_line_count(text);
    while(i<lines){if(zsp_compact_line_id(compact,zsp_line_at(text,i))<0){count=count+1;}i=i+1;}
    return count;
}

fn zsp_generated_line(text:[]u8,compact:[]u8,want:i32)[]u8{
    let seen:i32=0;let i:i32=0;let lines:i32=zsp_line_count(text);
    while(i<lines){let line:[]u8=zsp_line_at(text,i);
        if(zsp_compact_line_id(compact,line)<0){if(seen==want){return line;}seen=seen+1;}
        i=i+1;
    }
    return "";
}

fn zsp_source_reorder_projection(compact:[]u8,baseline:[]u8,edited:[]u8)ZsProjection{
    let compact_lines:i32=zsp_line_count(compact);
    let baseline_lines:i32=zsp_line_count(baseline);
    let edited_lines:i32=zsp_line_count(edited);
    if(compact_lines<2||compact_lines>2048||baseline_lines!=edited_lines||
       zsp_line_has_cr(compact)==1||zsp_line_has_cr(baseline)==1||zsp_line_has_cr(edited)==1){
        return zsp_conflict(0,baseline.len,"source reorder envelope is not line-aligned");
    }

    // Establish an exact one-to-one source-line set in both snapshots.  A
    // line shared by generated output is rejected as ambiguous even if its
    // textual value happens to be unique in compact source.
    let omitted_header:i32=0;
    let i:i32=0;while(i<compact_lines){let source_line:[]u8=zsp_line_at(compact,i);
        if(zsp_compact_line_id(compact,source_line)!=i){
            return zsp_conflict(0,baseline.len,"source reorder context is absent or ambiguous");
        }
        let baseline_occurrences:i32=zsp_line_occurrences(baseline,source_line);
        let edited_occurrences:i32=zsp_line_occurrences(edited,source_line);
        // `script;` is a compact-profile marker and is intentionally omitted
        // by the explicit generated wrapper. It remains fixed at compact
        // line zero; every other source line needs an exact derived origin.
        if(i==0&&@strEq(source_line,"script;")&&baseline_occurrences==0&&edited_occurrences==0){
            omitted_header=1;
        }else if(baseline_occurrences!=1||edited_occurrences!=1){
            return zsp_conflict(0,baseline.len,"source reorder context is absent or ambiguous");
        }
        i=i+1;
    }
    let generated_count:i32=zsp_generated_count(baseline,compact);
    if(generated_count!=zsp_generated_count(edited,compact)){
        return zsp_conflict(0,baseline.len,"generated line sequence changed");
    }
    let g:i32=0;while(g<generated_count){
        if(@strEq(zsp_generated_line(baseline,compact,g),zsp_generated_line(edited,compact,g))==0){
            return zsp_conflict(0,baseline.len,"generated line sequence changed");
        }
        g=g+1;
    }

    // Collect the edited source permutation and require the script marker to
    // remain first.  The output is constructed solely from exact compact
    // lines, never from generated text.
    let source_seen:i32=0;let changed:i32=0;let projected:[]u8="";
    if(omitted_header==1){projected=_zag_str_concat(projected,zsp_line_at(compact,0));}
    let e:i32=0;while(e<edited_lines){let line:[]u8=zsp_line_at(edited,e);
        let id:i32=zsp_compact_line_id(compact,line);
        if(id>=0){
            if(source_seen==0&&omitted_header==1&&id==0){
                return zsp_conflict(0,baseline.len,"script marker moved by source reorder");
            }
            if(id!=(source_seen+omitted_header)){changed=1;}
            if(source_seen>0||omitted_header==1){projected=_zag_str_concat(projected,"\n");}
            projected=_zag_str_concat(projected,line);source_seen=source_seen+1;
        }
        e=e+1;
    }
    if(source_seen+omitted_header!=compact_lines||changed==0){return zsp_conflict(0,baseline.len,"source line order is unchanged");}
    if(compact.len>0&&compact[compact.len-1]==10){projected=_zag_str_concat(projected,"\n");}
    return ZsProjection{.ok=1,.compact=projected,.conflict_start=0,.conflict_end=0,
        .reason="unique compact source line reorder"};
}

fn zsp_conflict(start:i32,end:i32,reason:[]u8)ZsProjection{
    return ZsProjection{.ok=0,.compact="",.conflict_start=start,
        .conflict_end=end,.reason=reason};
}

// `script_projection_single` reports offsets in the baseline slice it was
// given.  Multi-region projection deliberately passes such slices so that a
// generated-only or ambiguous region cannot be guessed around.  Rebase the
// diagnostic before returning it; otherwise a conflict in a later region can
// be reported against byte zero of the complete derived file, which is not a
// localized diagnostic and makes editor recovery choose the wrong span.
fn zsp_rebase_conflict(p:ZsProjection,baseline_offset:i32)ZsProjection{
    if(p.ok==1){return p;}
    let start:i32=p.conflict_start+baseline_offset;
    let end:i32=p.conflict_end+baseline_offset;
    return ZsProjection{.ok=0,.compact="",.conflict_start=start,
        .conflict_end=end,.reason=p.reason};
}

fn script_projection_single(compact:[]u8,baseline:[]u8,edited:[]u8)ZsProjection{
    if(@strEq(baseline,edited)){
        return ZsProjection{.ok=1,.compact=compact,.conflict_start=0,
            .conflict_end=0,.reason="unchanged"};
    }

    let prefix:i32=0;
    while(prefix<baseline.len&&prefix<edited.len&&baseline[prefix]==edited[prefix]){prefix=prefix+1;}
    let suffix:i32=0;
    while(suffix<baseline.len-prefix&&suffix<edited.len-prefix&&
        baseline[baseline.len-1-suffix]==edited[edited.len-1-suffix]){suffix=suffix+1;}

    let lo:i32=zsp_line_start(baseline,prefix);
    let hi:i32=zsp_line_end(baseline,baseline.len-suffix);
    let edited_hi:i32=edited.len-(baseline.len-hi);
    if(edited_hi<lo||edited_hi>edited.len){
        return zsp_conflict(prefix,baseline.len-suffix,"edited range does not align with baseline context");
    }

    let search_lo:i32=lo;let search_hi:i32=hi;let compact_at:i32=0-1;
    let searching:i32=1;
    while(searching==1){
        let candidate:[]u8=baseline[search_lo..search_hi];
        let found:i32=zsp_unique_at(compact,candidate);
        if(found>=0){compact_at=found;searching=0;}
        else{
            let next_lo:i32=search_lo;let next_hi:i32=search_hi;
            if(search_lo>0){next_lo=zsp_line_start(baseline,search_lo-1);}
            if(search_hi<baseline.len){next_hi=zsp_line_end(baseline,search_hi);}
            if(next_lo==search_lo&&next_hi==search_hi){
                let reason:[]u8="baseline context is absent from compact source";
                if(found==(0-2)){reason="baseline context is ambiguous in compact source";}
                return zsp_conflict(prefix,baseline.len-suffix,reason);
            }
            search_lo=next_lo;search_hi=next_hi;
        }
    }

    // Recompute the edited right edge after context expansion. Bytes before
    // the actual edit share indices; bytes after it are shifted by total delta.
    let projected_edited_hi:i32=edited.len-(baseline.len-search_hi);
    if(projected_edited_hi<search_lo||projected_edited_hi>edited.len){
        return zsp_conflict(prefix,baseline.len-suffix,"expanded context does not align with edited source");
    }

    // Textual origin matching is necessarily weaker than the compiler's
    // derived-byte origin map.  Refuse the one especially dangerous case
    // where both sides of a changed single-line region are distinct compact
    // lines: a generated wrapper line can otherwise happen to equal one
    // compact statement and be silently projected onto another.  A genuine
    // source edit to new text remains supported; two known compact statements
    // are ambiguous without origin metadata and must stay fail-closed.
    let base_line_end:i32=search_hi-((search_hi>search_lo&&baseline[search_hi-1]==10) as i32);
    let edit_line_end:i32=projected_edited_hi-((projected_edited_hi>search_lo&&edited[projected_edited_hi-1]==10) as i32);
    let base_line:[]u8=baseline[search_lo..base_line_end];
    let edit_line:[]u8=edited[search_lo..edit_line_end];
    let base_line_id:i32=zsp_compact_line_id(compact,base_line);
    let edit_line_id:i32=zsp_compact_line_id(compact,edit_line);
    if(zsp_find_from(base_line,"\n",0)<0&&zsp_find_from(edit_line,"\n",0)<0&&
       base_line_id>=0&&edit_line_id>=0&&base_line_id!=edit_line_id){
        return zsp_conflict(prefix,baseline.len-suffix,
            "changed context is ambiguous between generated and compact lines");
    }
    let replacement:[]u8=edited[search_lo..projected_edited_hi];
    let before:[]u8=compact[0..compact_at];
    let after_start:i32=compact_at+(search_hi-search_lo);
    let projected:[]u8=_zag_str_concat(before,
        _zag_str_concat(replacement,compact[after_start..compact.len]));
    return ZsProjection{.ok=1,.compact=projected,.conflict_start=0,
        .conflict_end=0,.reason="unique compact context"};
}

// The explicit view places a captureless parser-hoisted closure before the
// hardened Script wrapper.  Its declaration is generated, but a single
// `return` body still has an exact compact counterpart inside the original
// closure literal.  Project only that deliberately narrow shape: the
// declaration header, suffix, indentation, and return form must be unchanged,
// and the complete return statement must occur exactly once in compact source.
// All other generated-wrapper edits remain conflicts rather than being guessed.
fn zsp_captureless_closure_body_projection(compact:[]u8,baseline:[]u8,edited:[]u8)ZsProjection{
    if(baseline.len<10||edited.len<10||@strEq(baseline[0..10],"fn __clos_")==0||
       @strEq(edited[0..10],"fn __clos_")==0){
        return zsp_conflict(0,baseline.len,"generated closure context is not recognized");
    }
    let bhead_end:i32=zsp_line_end(baseline,0);let ehead_end:i32=zsp_line_end(edited,0);
    if(bhead_end<=0||ehead_end<=0||@strEq(baseline[0..bhead_end],edited[0..ehead_end])==0||
       baseline.len<=bhead_end||edited.len<=ehead_end){
        return zsp_conflict(0,baseline.len,"generated closure declaration changed");
    }
    let bbody_end:i32=zsp_line_end(baseline,bhead_end);let ebody_end:i32=zsp_line_end(edited,ehead_end);
    if(bbody_end<=bhead_end||ebody_end<=ehead_end){
        return zsp_conflict(bhead_end,bbody_end,"generated closure body is missing");
    }
    let bbody:[]u8=baseline[bhead_end..bbody_end];let ebody:[]u8=edited[ehead_end..ebody_end];
    let bcontent_end:i32=bbody.len;if(bcontent_end>0&&bbody[bcontent_end-1]==10){bcontent_end=bcontent_end-1;}
    let econtent_end:i32=ebody.len;if(econtent_end>0&&ebody[econtent_end-1]==10){econtent_end=econtent_end-1;}
    if(bcontent_end<12||econtent_end<12||bbody[0]!=' '||bbody[1]!=' '||bbody[2]!=' '||bbody[3]!=' '||
       ebody[0]!=' '||ebody[1]!=' '||ebody[2]!=' '||ebody[3]!=' '||
       @strEq(bbody[4..bcontent_end],ebody[4..econtent_end])==1){
        return zsp_conflict(bhead_end,bbody_end,"generated closure body is not one changed return");
    }
    let btext:[]u8=bbody[4..bcontent_end];let etext:[]u8=ebody[4..econtent_end];
    if(btext.len<8||etext.len<8||@strEq(btext[0..7],"return ")==0||@strEq(etext[0..7],"return ")==0||
       btext[btext.len-1]!=';'||etext[etext.len-1]!=';'){
        return zsp_conflict(bhead_end,bbody_end,"generated closure body is not one return statement");
    }
    if(@strEq(baseline[bbody_end..baseline.len],edited[ebody_end..edited.len])==0){
        return zsp_conflict(bbody_end,baseline.len,"generated closure suffix changed");
    }
    let compact_at:i32=zsp_unique_at(compact,btext);
    if(compact_at<0){
        return zsp_conflict(bhead_end,bbody_end,"captureless closure return is absent or ambiguous in compact source");
    }
    let closure_at:i32=zsp_find_from(compact,"fn[]",0);
    let closure_end:i32=-1;if(closure_at>=0){closure_end=zsp_find_from(compact,"};",closure_at);}
    if(closure_at<0||closure_at>compact_at||closure_end<0||compact_at+btext.len>closure_end){
        return zsp_conflict(bhead_end,bbody_end,"compact closure context is absent");
    }
    let before:[]u8=compact[0..compact_at];let after:[]u8=compact[compact_at+btext.len..compact.len];
    return ZsProjection{.ok=1,.compact=_zag_str_concat(before,_zag_str_concat(etext,after)),
        .conflict_start=0,.conflict_end=0,.reason="captureless closure body origin"};
}

// Bounded extension for a two-statement captureless closure: the local
// assignment is required to remain byte-identical and only the final return
// statement may change. This keeps the origin proof narrow while covering the
// common temporary-plus-return shape without admitting arbitrary body edits.
fn zsp_captureless_closure_two_body_projection(compact:[]u8,baseline:[]u8,edited:[]u8)ZsProjection{
    if(baseline.len<10||edited.len<10||@strEq(baseline[0..10],"fn __clos_")==0||
       @strEq(edited[0..10],"fn __clos_")==0){return zsp_conflict(0,baseline.len,
        "generated closure context is not recognized");}
    let bh:i32=zsp_line_end(baseline,0);let eh:i32=zsp_line_end(edited,0);
    if(bh<=0||eh<=0||@strEq(baseline[0..bh],edited[0..eh])==0){return zsp_conflict(0,bh,
        "generated closure declaration changed");}
    let b1:i32=zsp_line_end(baseline,bh);let e1:i32=zsp_line_end(edited,eh);
    let b2:i32=zsp_line_end(baseline,b1);let e2:i32=zsp_line_end(edited,e1);
    if(b2<=b1||e2<=e1){return zsp_conflict(bh,b2,"generated closure body is missing");}
    let first_b:[]u8=baseline[bh..b1];let first_e:[]u8=edited[eh..e1];
    if(first_b.len<5||first_e.len<5||first_b[0]!=' '||first_b[1]!=' '||first_b[2]!=' '||first_b[3]!=' '||
       first_e[0]!=' '||first_e[1]!=' '||first_e[2]!=' '||first_e[3]!=' '||
       @strEq(first_b[4..first_b.len-1],first_e[4..first_e.len-1])==0){
        return zsp_conflict(bh,b1,"generated closure local assignment changed");
    }
    let body_b:[]u8=baseline[b1..b2];let body_e:[]u8=edited[e1..e2];
    let bend:i32=body_b.len;if(bend>0&&body_b[bend-1]==10){bend=bend-1;}
    let eend:i32=body_e.len;if(eend>0&&body_e[eend-1]==10){eend=eend-1;}
    if(bend<12||eend<12||@strEq(body_b[0..4],"    ")==0||@strEq(body_e[0..4],"    ")==0||
       @strEq(body_b[4..11],"return ")==0||@strEq(body_e[4..11],"return ")==0||
       body_b[bend-1]!=';'||body_e[eend-1]!=';'||@strEq(body_b[4..bend],body_e[4..eend])==1){
        return zsp_conflict(b1,b2,"generated closure body is not one changed return");
    }
    if(@strEq(baseline[b2..baseline.len],edited[e2..edited.len])==0){return zsp_conflict(b2,baseline.len,
        "generated closure suffix changed");}
    let old_return:[]u8=body_b[4..bend];let new_return:[]u8=body_e[4..eend];
    let at:i32=zsp_unique_at(compact,old_return);if(at<0){return zsp_conflict(b1,b2,
        "captureless closure return is absent or ambiguous in compact source");}
    let ca:i32=zsp_find_from(compact,"fn[]",0);let ce:i32=-1;if(ca>=0){ce=zsp_find_from(compact,"};",ca);}
    if(ca<0||ca>at||ce<0||at+old_return.len>ce){return zsp_conflict(b1,b2,
        "compact closure context is absent");}
    return ZsProjection{.ok=1,.compact=_zag_str_concat(compact[0..at],_zag_str_concat(new_return,compact[at+old_return.len..compact.len])),
        .conflict_start=0,.conflict_end=0,.reason="captureless closure two-body origin"};
}

// Three-statement variant: both local-assignment lines are immutable anchors;
// only the final return is projectable. This deliberately does not generalize
// to arbitrary statement counts or reordered locals.
fn zsp_captureless_closure_three_body_projection(compact:[]u8,baseline:[]u8,edited:[]u8)ZsProjection{
    if(baseline.len<10||edited.len<10||@strEq(baseline[0..10],"fn __clos_")==0||
       @strEq(edited[0..10],"fn __clos_")==0){return zsp_conflict(0,baseline.len,"generated closure context is not recognized");}
    let bh:i32=zsp_line_end(baseline,0);let eh:i32=zsp_line_end(edited,0);
    if(bh<=0||eh<=0||@strEq(baseline[0..bh],edited[0..eh])==0){return zsp_conflict(0,bh,"generated closure declaration changed");}
    let b1:i32=zsp_line_end(baseline,bh);let e1:i32=zsp_line_end(edited,eh);
    let b2:i32=zsp_line_end(baseline,b1);let e2:i32=zsp_line_end(edited,e1);
    let b3:i32=zsp_line_end(baseline,b2);let e3:i32=zsp_line_end(edited,e2);
    if(b3<=b2||e3<=e2){return zsp_conflict(bh,b3,"generated closure body is missing");}
    let first_b:[]u8=baseline[bh..b1];let first_e:[]u8=edited[eh..e1];
    let second_b:[]u8=baseline[b1..b2];let second_e:[]u8=edited[e1..e2];
    if(first_b.len<5||first_e.len<5||second_b.len<5||second_e.len<5||
       @strEq(first_b[0..4],"    ")==0||@strEq(first_e[0..4],"    ")==0||
       @strEq(second_b[0..4],"    ")==0||@strEq(second_e[0..4],"    ")==0||
       @strEq(first_b[4..first_b.len-1],first_e[4..first_e.len-1])==0||
       @strEq(second_b[4..second_b.len-1],second_e[4..second_e.len-1])==0){
        return zsp_conflict(bh,b2,"generated closure local assignment changed");
    }
    let body_b:[]u8=baseline[b2..b3];let body_e:[]u8=edited[e2..e3];
    let bend:i32=body_b.len;if(bend>0&&body_b[bend-1]==10){bend=bend-1;}
    let eend:i32=body_e.len;if(eend>0&&body_e[eend-1]==10){eend=eend-1;}
    if(bend<12||eend<12||@strEq(body_b[0..4],"    ")==0||@strEq(body_e[0..4],"    ")==0||
       @strEq(body_b[4..11],"return ")==0||@strEq(body_e[4..11],"return ")==0||
       body_b[bend-1]!=';'||body_e[eend-1]!=';'||@strEq(body_b[4..bend],body_e[4..eend])==1){
        return zsp_conflict(b2,b3,"generated closure body is not one changed return");
    }
    if(@strEq(baseline[b3..baseline.len],edited[e3..edited.len])==0){return zsp_conflict(b3,baseline.len,"generated closure suffix changed");}
    let old_return:[]u8=body_b[4..bend];let new_return:[]u8=body_e[4..eend];
    let at:i32=zsp_unique_at(compact,old_return);if(at<0){return zsp_conflict(b2,b3,"captureless closure return is absent or ambiguous in compact source");}
    let ca:i32=zsp_find_from(compact,"fn[]",0);let ce:i32=-1;if(ca>=0){ce=zsp_find_from(compact,"};",ca);}
    if(ca<0||ca>at||ce<0||at+old_return.len>ce){return zsp_conflict(b2,b3,"compact closure context is absent");}
    return ZsProjection{.ok=1,.compact=_zag_str_concat(compact[0..at],_zag_str_concat(new_return,compact[at+old_return.len..compact.len])),
        .conflict_start=0,.conflict_end=0,.reason="captureless closure three-body origin"};
}

// Four-statement variant: three local-assignment lines are immutable anchors;
// only the final return is projectable.
fn zsp_captureless_closure_four_body_projection(compact:[]u8,baseline:[]u8,edited:[]u8)ZsProjection{
    if(baseline.len<10||edited.len<10||@strEq(baseline[0..10],"fn __clos_")==0||
       @strEq(edited[0..10],"fn __clos_")==0){return zsp_conflict(0,baseline.len,"generated closure context is not recognized");}
    let bh:i32=zsp_line_end(baseline,0);let eh:i32=zsp_line_end(edited,0);
    if(bh<=0||eh<=0||@strEq(baseline[0..bh],edited[0..eh])==0){return zsp_conflict(0,bh,"generated closure declaration changed");}
    let b1:i32=zsp_line_end(baseline,bh);let e1:i32=zsp_line_end(edited,eh);
    let b2:i32=zsp_line_end(baseline,b1);let e2:i32=zsp_line_end(edited,e1);
    let b3:i32=zsp_line_end(baseline,b2);let e3:i32=zsp_line_end(edited,e2);
    let b4:i32=zsp_line_end(baseline,b3);let e4:i32=zsp_line_end(edited,e3);
    if(b4<=b3||e4<=e3){return zsp_conflict(bh,b4,"generated closure body is missing");}
    let first_b:[]u8=baseline[bh..b1];let first_e:[]u8=edited[eh..e1];
    let second_b:[]u8=baseline[b1..b2];let second_e:[]u8=edited[e1..e2];
    let third_b:[]u8=baseline[b2..b3];let third_e:[]u8=edited[e2..e3];
    if(first_b.len<5||first_e.len<5||second_b.len<5||second_e.len<5||third_b.len<5||third_e.len<5||
       @strEq(first_b[0..4],"    ")==0||@strEq(first_e[0..4],"    ")==0||
       @strEq(second_b[0..4],"    ")==0||@strEq(second_e[0..4],"    ")==0||
       @strEq(third_b[0..4],"    ")==0||@strEq(third_e[0..4],"    ")==0||
       @strEq(first_b[4..first_b.len-1],first_e[4..first_e.len-1])==0||
       @strEq(second_b[4..second_b.len-1],second_e[4..second_e.len-1])==0||
       @strEq(third_b[4..third_b.len-1],third_e[4..third_e.len-1])==0){
        return zsp_conflict(bh,b3,"generated closure local assignment changed");
    }
    let body_b:[]u8=baseline[b3..b4];let body_e:[]u8=edited[e3..e4];
    let bend:i32=body_b.len;if(bend>0&&body_b[bend-1]==10){bend=bend-1;}
    let eend:i32=body_e.len;if(eend>0&&body_e[eend-1]==10){eend=eend-1;}
    if(bend<12||eend<12||@strEq(body_b[0..4],"    ")==0||@strEq(body_e[0..4],"    ")==0||
       @strEq(body_b[4..11],"return ")==0||@strEq(body_e[4..11],"return ")==0||
       body_b[bend-1]!=';'||body_e[eend-1]!=';'||@strEq(body_b[4..bend],body_e[4..eend])==1){
        return zsp_conflict(b3,b4,"generated closure body is not one changed return");
    }
    if(@strEq(baseline[b4..baseline.len],edited[e4..edited.len])==0){return zsp_conflict(b4,baseline.len,"generated closure suffix changed");}
    let old_return:[]u8=body_b[4..bend];let new_return:[]u8=body_e[4..eend];
    let at:i32=zsp_unique_at(compact,old_return);if(at<0){return zsp_conflict(b3,b4,"captureless closure return is absent or ambiguous in compact source");}
    let ca:i32=zsp_find_from(compact,"fn[]",0);let ce:i32=-1;if(ca>=0){ce=zsp_find_from(compact,"};",ca);}
    if(ca<0||ca>at||ce<0||at+old_return.len>ce){return zsp_conflict(b3,b4,"compact closure context is absent");}
    return ZsProjection{.ok=1,.compact=_zag_str_concat(compact[0..at],_zag_str_concat(new_return,compact[at+old_return.len..compact.len])),
        .conflict_start=0,.conflict_end=0,.reason="captureless closure four-body origin"};
}

// Five-statement variant: four local-assignment lines are immutable anchors;
// only the final return is projectable.
fn zsp_captureless_closure_five_body_projection(compact:[]u8,baseline:[]u8,edited:[]u8)ZsProjection{
    if(baseline.len<10||edited.len<10||@strEq(baseline[0..10],"fn __clos_")==0||
       @strEq(edited[0..10],"fn __clos_")==0){return zsp_conflict(0,baseline.len,"generated closure context is not recognized");}
    let bh:i32=zsp_line_end(baseline,0);let eh:i32=zsp_line_end(edited,0);
    if(bh<=0||eh<=0||@strEq(baseline[0..bh],edited[0..eh])==0){return zsp_conflict(0,bh,"generated closure declaration changed");}
    let b1:i32=zsp_line_end(baseline,bh);let e1:i32=zsp_line_end(edited,eh);
    let b2:i32=zsp_line_end(baseline,b1);let e2:i32=zsp_line_end(edited,e1);
    let b3:i32=zsp_line_end(baseline,b2);let e3:i32=zsp_line_end(edited,e2);
    let b4:i32=zsp_line_end(baseline,b3);let e4:i32=zsp_line_end(edited,e3);
    let b5:i32=zsp_line_end(baseline,b4);let e5:i32=zsp_line_end(edited,e4);
    if(b5<=b4||e5<=e4){return zsp_conflict(bh,b5,"generated closure body is missing");}
    let first_b:[]u8=baseline[bh..b1];let first_e:[]u8=edited[eh..e1];
    let second_b:[]u8=baseline[b1..b2];let second_e:[]u8=edited[e1..e2];
    let third_b:[]u8=baseline[b2..b3];let third_e:[]u8=edited[e2..e3];
    let fourth_b:[]u8=baseline[b3..b4];let fourth_e:[]u8=edited[e3..e4];
    if(first_b.len<5||first_e.len<5||second_b.len<5||second_e.len<5||
       third_b.len<5||third_e.len<5||fourth_b.len<5||fourth_e.len<5||
       @strEq(first_b[0..4],"    ")==0||@strEq(first_e[0..4],"    ")==0||
       @strEq(second_b[0..4],"    ")==0||@strEq(second_e[0..4],"    ")==0||
       @strEq(third_b[0..4],"    ")==0||@strEq(third_e[0..4],"    ")==0||
       @strEq(fourth_b[0..4],"    ")==0||@strEq(fourth_e[0..4],"    ")==0||
       @strEq(first_b[4..first_b.len-1],first_e[4..first_e.len-1])==0||
       @strEq(second_b[4..second_b.len-1],second_e[4..second_e.len-1])==0||
       @strEq(third_b[4..third_b.len-1],third_e[4..third_e.len-1])==0||
       @strEq(fourth_b[4..fourth_b.len-1],fourth_e[4..fourth_e.len-1])==0){
        return zsp_conflict(bh,b4,"generated closure local assignment changed");
    }
    let body_b:[]u8=baseline[b4..b5];let body_e:[]u8=edited[e4..e5];
    let bend:i32=body_b.len;if(bend>0&&body_b[bend-1]==10){bend=bend-1;}
    let eend:i32=body_e.len;if(eend>0&&body_e[eend-1]==10){eend=eend-1;}
    if(bend<12||eend<12||@strEq(body_b[0..4],"    ")==0||@strEq(body_e[0..4],"    ")==0||
       @strEq(body_b[4..11],"return ")==0||@strEq(body_e[4..11],"return ")==0||
       body_b[bend-1]!=';'||body_e[eend-1]!=';'||@strEq(body_b[4..bend],body_e[4..eend])==1){
        return zsp_conflict(b4,b5,"generated closure body is not one changed return");
    }
    if(@strEq(baseline[b5..baseline.len],edited[e5..edited.len])==0){return zsp_conflict(b5,baseline.len,"generated closure suffix changed");}
    let old_return:[]u8=body_b[4..bend];let new_return:[]u8=body_e[4..eend];
    let at:i32=zsp_unique_at(compact,old_return);if(at<0){return zsp_conflict(b4,b5,"captureless closure return is absent or ambiguous in compact source");}
    let ca:i32=zsp_find_from(compact,"fn[]",0);let ce:i32=-1;if(ca>=0){ce=zsp_find_from(compact,"};",ca);}
    if(ca<0||ca>at||ce<0||at+old_return.len>ce){return zsp_conflict(b4,b5,"compact closure context is absent");}
    return ZsProjection{.ok=1,.compact=_zag_str_concat(compact[0..at],_zag_str_concat(new_return,compact[at+old_return.len..compact.len])),
        .conflict_start=0,.conflict_end=0,.reason="captureless closure five-body origin"};
}

struct ZsAnchor {
    found:i32,
    baseline_start:i32,
    baseline_end:i32,
    edited_start:i32,
    edited_end:i32,
}

fn zsp_next_unique_anchor(baseline:[]u8,edited:[]u8,
    baseline_from:i32,edited_from:i32)ZsAnchor{
    let b:i32=zsp_line_start(baseline,baseline_from);
    while(b<baseline.len){
        let bend:i32=zsp_line_end(baseline,b);
        let line:[]u8=baseline[b..bend];
        let e:i32=zsp_unique_at(edited,line);
        if(e>=edited_from&&e==zsp_line_start(edited,e)){
            return ZsAnchor{.found=1,.baseline_start=b,.baseline_end=bend,
                .edited_start=e,.edited_end=zsp_line_end(edited,e)};
        }
        if(bend<=b){return ZsAnchor{.found=0,.baseline_start=0,.baseline_end=0,
            .edited_start=0,.edited_end=0};}
        b=bend;
    }
    return ZsAnchor{.found=0,.baseline_start=0,.baseline_end=0,
        .edited_start=0,.edited_end=0};
}

// Inline captured scalar closures have no printable hoisted declaration: the
// capture list must be retained. Project only one changed indented final
// return, with every other generated line unchanged and a unique `fn[` origin.
fn zsp_captured_closure_body_projection(compact:[]u8,baseline:[]u8,edited:[]u8)ZsProjection{
    let b:i32=0;let e:i32=0;let changes:i32=0;let cb:i32=0;let ce:i32=0;let old:[]u8="";let new:[]u8="";
    while(b<baseline.len||e<edited.len){
        let bend:i32=zsp_line_end(baseline,b);let eend:i32=zsp_line_end(edited,e);
        let bl:[]u8=baseline[b..bend];let el:[]u8=edited[e..eend];
        if(@strEq(bl,el)==0){
            changes=changes+1;cb=b;ce=bend;
            let bn:i32=bl.len;if(bn>0&&bl[bn-1]==10){bn=bn-1;}
            let en:i32=el.len;if(en>0&&el[en-1]==10){en=en-1;}
            if(bn<12||en<12||@strEq(bl[0..4],"    ")!=1||@strEq(el[0..4],"    ")!=1||
               @strEq(bl[4..11],"return ")!=1||@strEq(el[4..11],"return ")!=1||
               bl[bn-1]!=';'||el[en-1]!=';'){return zsp_conflict(b,bend,"captured closure body is not one changed return");}
            old=bl[4..bn];new=el[4..en];
        }
        b=bend;e=eend;
    }
    if(changes!=1){return zsp_conflict(cb,ce,"captured closure requires one changed return");}
    let at:i32=zsp_unique_at(compact,old);if(at<0){return zsp_conflict(cb,ce,"captured closure return is absent or ambiguous in compact source");}
    let ca:i32=zsp_find_from(compact,"fn[",0);if(ca<0||zsp_find_from(compact,"fn[",ca+3)>=0){return zsp_conflict(cb,ce,"captured closure context is absent or ambiguous");}
    let close:i32=zsp_find_from(compact,"]",ca+3);if(close<0||zsp_find_from(compact,"&",ca+3)>=0&&zsp_find_from(compact,"&",ca+3)<close){return zsp_conflict(cb,ce,"captured pointer closure is not projectable");}
    let end:i32=zsp_find_from(compact,"};",ca);if(end<0||at<ca||at+old.len>end){return zsp_conflict(cb,ce,"captured closure context is absent");}
    return ZsProjection{.ok=1,.compact=_zag_str_concat(compact[0..at],_zag_str_concat(new,compact[at+old.len..compact.len])),
        .conflict_start=0,.conflict_end=0,.reason="captured scalar closure body origin"};
}

fn script_projection(compact:[]u8,baseline:[]u8,edited:[]u8)ZsProjection{
    if(@strEq(baseline,edited)){
        return ZsProjection{.ok=1,.compact=compact,.conflict_start=0,
            .conflict_end=0,.reason="unchanged"};
    }

    // Preserve the original one-region behavior whenever it is sufficient.
    // The multi-region path below is only a fallback for edits separated by
    // generated or otherwise unmappable derived bytes.
    let single:ZsProjection=script_projection_single(compact,baseline,edited);
    if(single.ok==1){return single;}
    let closure:ZsProjection=zsp_captureless_closure_body_projection(compact,baseline,edited);
    if(closure.ok==1){return closure;}
    let closure_two:ZsProjection=zsp_captureless_closure_two_body_projection(compact,baseline,edited);
    if(closure_two.ok==1){return closure_two;}
    let closure_three:ZsProjection=zsp_captureless_closure_three_body_projection(compact,baseline,edited);
    if(closure_three.ok==1){return closure_three;}
    let closure_four:ZsProjection=zsp_captureless_closure_four_body_projection(compact,baseline,edited);
    if(closure_four.ok==1){return closure_four;}
    let closure_five:ZsProjection=zsp_captureless_closure_five_body_projection(compact,baseline,edited);
    if(closure_five.ok==1){return closure_five;}
    let captured:ZsProjection=zsp_captured_closure_body_projection(compact,baseline,edited);
    if(captured.ok==1){return captured;}
    let reorder:ZsProjection=zsp_source_reorder_projection(compact,baseline,edited);
    if(reorder.ok==1){return reorder;}

    let compact_work:[]u8=compact;
    let bpos:i32=0;let epos:i32=0;
    let left_b:i32=0;let left_e:i32=0;let changed:i32=0;
    while(bpos<baseline.len||epos<edited.len){
        let bend:i32=zsp_line_end(baseline,bpos);
        let eend:i32=zsp_line_end(edited,epos);
        if(bpos<baseline.len&&epos<edited.len&&
           @strEq(baseline[bpos..bend],edited[epos..eend])){
            bpos=bend;epos=eend;left_b=bpos;left_e=epos;continue;
        }
        let anchor:ZsAnchor=zsp_next_unique_anchor(baseline,edited,bpos,epos);
        if(anchor.found==0){
            if(changed==0){return single;}
            let tail:ZsProjection=script_projection_single(compact_work,
                baseline[left_b..baseline.len],edited[left_e..edited.len]);
            if(tail.ok==0){return zsp_rebase_conflict(tail,left_b);}
            return ZsProjection{.ok=1,.compact=tail.compact,.conflict_start=0,
                .conflict_end=0,.reason="multiple unique compact contexts"};
        }
        let base_chunk:[]u8=baseline[left_b..anchor.baseline_end];
        let edit_chunk:[]u8=edited[left_e..anchor.edited_end];
        if(@strEq(base_chunk,edit_chunk)){
            bpos=anchor.baseline_end;epos=anchor.edited_end;
            left_b=anchor.baseline_start;left_e=anchor.edited_start;continue;
        }
        let projected:ZsProjection=script_projection_single(compact_work,
            base_chunk,edit_chunk);
        if(projected.ok==0){return zsp_rebase_conflict(projected,left_b);}
        compact_work=projected.compact;changed=1;
        bpos=anchor.baseline_end;epos=anchor.edited_end;
        left_b=anchor.baseline_start;left_e=anchor.edited_start;
    }
    if(changed==0){return single;}
    return ZsProjection{.ok=1,.compact=compact_work,.conflict_start=0,
        .conflict_end=0,.reason="multiple unique compact contexts"};
}
